    skos:inScheme lev:aat ;
    skos:prefLabel "very dark reddish purple"@en .

aat:300130589 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of purple colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pale reddish purple"@en .

aat:300130593 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of purple colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grayish reddish purple"@en .

aat:300130602 a skos:Concept ;
    skos:definition "Color representing that portion of the spectrum that is intermediate between red and blue, with wavelengths between 380 and 420 nanometers. The term may refer to any of this group of colors that vary in lightness and saturation. Examples of violet color in nature are seen in certain plum fruits and in the bloom of the violet plant, Viola odorata. Violet is a secondary pigment color (made by combining blue and red). Spectral violet cannot be reproduced accurately in the RGB color model (used for computer screens)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violet"@en .

aat:300130603 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vivid violet"@en .

aat:300130612 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brilliant violet"@en .

aat:300130633 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep violet"@en .

aat:300130636 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light violet"@en .

aat:300130656 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "very light violet"@en .

aat:300130761 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moderate violet"@en .

aat:300130773 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark violet"@en .

aat:300130782 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pale violet"@en .

aat:300130790 a skos:Concept ;
    skos:definition "Range of blue violet colors corresponding to the Universal Color Language standard number 213."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "very pale violet"@en .

aat:300130799 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grayish violet"@en .

aat:300130813 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of gray colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light gray"@en .

aat:300130828 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of gray colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium gray"@en .

aat:300130854 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of gray colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark gray"@en .

aat:300130888 a skos:Concept ;
    skos:definition "Chinese ornamental gateways of one, three, or five openings, usually commemorative or triumphal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "p'ai-lous"@en .

aat:300130893 a skos:Concept ;
    skos:definition "Areas within city limits or closely linked to them by common use of public utilities or services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban areas"@en .

aat:300130920 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of blackish colors. More specifically, black is an achromatic color of maximum darkness, referring to objects having little or no hue owing to the absorption of almost all light in the visible spectrum. In the context of pigments, black is theoretically the mixture of all colors. In the context of colors of light, black is the absence of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black"@en .

aat:300130942 a skos:Concept ;
    skos:definition "A compound in which silver is combined with a halogen, typically silver chloride, bromide or iodide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver halide"@en .

aat:300130944 a skos:Concept ;
    skos:definition "A yellow, water-insoluble powder, AgBr, which darkens upon exposure to light, produced by the reaction of silver nitrate with a bromide. It was used chiefly in the manufacture of photographic emulsions from about 1875-1880."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver bromide"@en .

aat:300130947 a skos:Concept ;
    skos:definition "A pale-yellow, water-insoluble powder, AgI, which darken upon exposure to light, produced by the reaction of silver nitrate with an iodide. It was used chiefly in the manufacture of photographic emulsions from about 1875-1880."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver iodide"@en .

aat:300130948 a skos:Concept ;
    skos:definition "A starch obtained from the tubers of the Maranta arundinacea plant native to Florida, the West Indies and Central America. Arrowroot starch is used as a binder and adhesive. In the mid 1850s, arrowroot starch was used as a binder in salted photographic papers. It produced a bright image with a good density range and high resolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrowroot"@en .

aat:300130950 a skos:Concept ;
    skos:definition "Fully esterified cellulose acetate containing three acetyl groups per glucose unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulose triacetate"@en .

aat:300130953 a skos:Concept ;
    skos:definition "Refers generally to façades constructed to conceal the shape or size of the buildings to which they are attached, as by exceeding them in height or width; if the intention is to give a more imposing appearance, use \"false fronts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen façades"@en .

aat:300130954 a skos:Concept ;
    skos:definition "Gelatinous polysaccharide substance extracted from various species of Rhodophyceae red seaweed, that grow in the Pacific and Indian Oceans and the Japan Sea. Agar contains agarose and agaropectin. It is strongly hydrophilic and can absorb over 20 times its own weight in cold water. Agar dissolves in hot water and forms a stiff, clear jelly upon cooling. However, when agar films are desiccated, they shrink significantly. Most commonly used as a media for culturing bacteria and fungi, agar has also been used for sizing textiles and paper, as an emulsifying agent in foodstuffs, photographs, dental mold materials, cosmetics, and adhesives, to make an experimental synthetic gauzelike fabric in England. Agar is available in dried cakes, coarse granules, long strips, and thin sheets. The primary commercial sources for agar are Japan, New Zealand, Australia, Russia, and the United States. According to legend, agar was first discovered in the mid-17th century in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agar"@en .

aat:300130959 a skos:Concept ;
    skos:definition "Stress developed in a restricted material as a result of temperature changes when the material is unable to expand or contract accordingly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal stress"@en .

aat:300130963 a skos:Concept ;
    skos:definition "Clearly articulated, often towerlike, building appendages containing only stairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stair towers"@en .

aat:300130964 a skos:Concept ;
    skos:definition "A light brown or buff-colored dolostone that is well-cemented, free of jointing, and ideally suited for building purposes. It is often used as a building stone in Toronto, Canada as it is quarried in southern Ontario; Queenston limestone caps the Niagara Escarpment. Before a quarry operation was begun at Queenston in about 1840, Scottish settlers exploited the limestone beds for building materials; the present quarry is one of the oldest in Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Queenston limestone"@en .

aat:300130970 a skos:Concept ;
    skos:definition "Contemporary artists who specialize in works that are usually created outdoors and on a grand scale, typically incorporating features of the site itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental artists"@en .

aat:300131081 a skos:Concept ;
    skos:definition "Textile waterproofed with oil; often woven cotton, jute, or hemp, treated with oil and pigment. Typically used as a waterproof covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oilcloth"@en .

aat:300131087 a skos:Concept ;
    skos:definition "Secondary surfaces on which works, often drawings, photographs, or other works on paper supports, are pasted, taped, or otherwise attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounts"@en .

aat:300131091 a skos:Concept ;
    skos:definition "Photographic paper containing image dyes which is used to print directly from positive transparancies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reversal paper"@en .

aat:300131093 a skos:Concept ;
    skos:definition "Film used to produce a positive image from a positive, or a negative image from a negative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reversal film"@en .

aat:300131095 a skos:Concept ;
    skos:definition "Photographic film which is mounted on special disks, and used in compact disk cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disk film"@en .

aat:300131098 a skos:Concept ;
    skos:definition "A white, granular, water-insoluble powder, AgCl that darkens upon exposure to light produced by the reaction of silver nitrate with a chloride. It was used chiefly in the manufacture of photographic emulsions and antiseptic silver preparations from about 1895-1900."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver chloride"@en .

aat:300131099 a skos:Concept ;
    skos:definition "Material made to imitate ivory; usually consisting of celluloid, a synthetic resin, or, before 1881, ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial ivory"@en .

aat:300131101 a skos:Concept ;
    skos:definition "Artists who work in the genre of conceptual art, which is the genre of art in which the ideas or concepts that a work expresses or refers to are considered to be its defining characteristic, and the finished material result, if it exists at all, is regarded primarily as a form of documentation rather than as the art work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conceptual artists"@en .

aat:300131105 a skos:Concept ;
    skos:definition "A yellow powder, Ag3PO4, that turns brown when heated or exposed to light, soluble in acid and very slightly soluble in water. It was used in the manufacture of photographic emulsions and pharmaceuticals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver phosphate"@en .

aat:300131106 a skos:Concept ;
    skos:definition "Directors of commercial art galleries or public art museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallery directors"@en .

aat:300131111 a skos:Concept ;
    skos:definition "Refers to objects either that have become separated or disconnected from objects to which they were an integral part, as ticket stubs, or, especially with reference to buildings, that are standing apart with no walls in common with other structures. To refer to sculpture or architectural and infrastructural elements that stand alone, prefer \"freestanding.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detached"@en .

aat:300131495 a skos:Concept ;
    skos:definition "Use only to refer to buildings or other structures placed at the endpoints of bus routes; use \"bus stations\" only for intermediate stops along bus routes; use \"bus shelters\" for structures at bus stops affording weather protection but having no sales or service facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bus terminals"@en .

aat:300131648 a skos:Concept ;
    skos:definition "Colors which have hue. All colors have hue except for black, white, and shades of grey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromatic colors"@en .

aat:300131766 a skos:Concept ;
    skos:definition "Nonloadbearing partitions made of prefabricated sections that can be readily disassembled and relocated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demountable partitions"@en .

aat:300131814 a skos:Concept ;
    skos:definition "Continuous vertical sections of masonry, one unit in thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wythes"@en .

aat:300131875 a skos:Concept ;
    skos:definition "Buildings housing libraries that serve an academic institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic libraries"@en .

aat:300132035 a skos:Concept ;
    skos:definition "Structures whose shape changes with changes in the loading condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonrigid structures"@en .

aat:300132089 a skos:Concept ;
    skos:definition "Short, horizontal members projecting inward at the top of interior walls, attached to the foot of principal rafters in a roof and generally supporting arched roof braces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer beams"@en .

aat:300132112 a skos:Concept ;
    skos:definition "Vertical or return piping in plumbing systems; for vertical mains for soil, waste, or venting, use \"stacks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "risers"@en .

aat:300132129 a skos:Concept ;
    skos:definition "Flat floors, generally raised above an adjoining floor surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platforms"@en .

aat:300132180 a skos:Concept ;
    skos:definition "Official residences of sovereigns bearing the title of duke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ducal palaces"@en .

aat:300132206 a skos:Concept ;
    skos:definition "Small glazed openings in a shrine to afford a view of the relics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fenestellas"@en .

aat:300132217 a skos:Concept ;
    skos:definition "Tracery consisting in large part of netlike arrangements of repeated geometrical motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reticulated tracery"@en .

aat:300132226 a skos:Concept ;
    skos:definition "Drawings that are full broadside elevations of a ship and that show more detail than in a sheer plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outboard profiles"@en .

aat:300132229 a skos:Concept ;
    skos:definition "Drawings that are end elevations of ships, indicating curvature at certain points along the ship's length. When appearing with a half-breadth plan and a sheer plan, use \"lines drawings\" for the set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body plans"@en .

aat:300132231 a skos:Concept ;
    skos:definition "Drawings or works in another two-dimensional medium representing one longitudinal half of a ship as viewed from above and emphasizing the ship's lines. When appearing with a body plan and a sheer plan, use \"lines drawings\" for the set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-breadth plans"@en .

aat:300132233 a skos:Concept ;
    skos:definition "Drawings of a full longitudinal section of a ship, showing internal arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inboard profiles"@en .

aat:300132236 a skos:Concept ;
    skos:definition "Drawings representing a side elevation of a ship's sails, masts, spars, and standing rigging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sail plans"@en .

aat:300132238 a skos:Concept ;
    skos:definition "Drawings representing a side elevation of a ship and emphasizing the arrangement of the rigging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigging plans"@en .

aat:300132247 a skos:Concept ;
    skos:definition "European noblemen holding a duchy, ranking highest in the peerage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dukes"@en .

aat:300132249 a skos:Concept ;
    skos:definition "Buildings that house schools, usually associated with Christian churches and mainly for children, in which religious instruction is given on Sundays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sunday schools"@en .

aat:300132254 a skos:Concept ;
    skos:definition "Vessels of varying shape and size but which are usually taller than they are wide, varying greatly in actual form and use. For example, may refer to vessels for displaying flowers, or to ancient ceramic or metal vessel in a range of shapes and used to hold liquids, grain, or another substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vases"@en .

aat:300132256 a skos:Concept ;
    skos:definition "Ships propelled by steam engines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steamships"@en .

aat:300132264 a skos:Concept ;
    skos:definition "Sketches that emphasize light values and overall pictorial effect, often painted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pochades"@en .

aat:300132266 a skos:Concept ;
    skos:definition "Sketches representing an early step in the development of a pictorial composition or the design of a building, but more developed than a preliminary sketch. Used especially in the context of the École des Beaux-Arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "esquisses"@en .

aat:300132294 a skos:Concept ;
    skos:definition "Designates land and water areas where human effects, if present, are not ecologically significant to the area as a whole. Use to contrast with \"cultural landscapes,\" areas which are significantly altered or modified by human actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural landscapes"@en .

aat:300132301 a skos:Concept ;
    skos:definition "Depressions in the earth that are filled with water, smaller than an ocean or sea and ranging in size from just a few square meters to thousands of square kilometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacustrine bodies of water"@en .

aat:300132303 a skos:Concept ;
    skos:definition "Designates small mountain lakes, often with no apparent inlet, usually formed in a blocked bowl-shaped depression eroded by ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarns"@en .

aat:300132308 a skos:Concept ;
    skos:definition "Rooms used for the copying of manuscripts before the era of printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scriptoria"@en .

aat:300132312 a skos:Concept ;
    skos:definition "Bodies of flowing water moving in one direction, including streams and rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riverine bodies of water"@en .

aat:300132315 a skos:Concept ;
    skos:definition "Large inlets of the sea, usually more enclosed and more deeply indented than bays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gulfs"@en .

aat:300132316 a skos:Concept ;
    skos:definition "Denotes wide, open, curving indentations of a shoreline, larger than coves and smaller than gulfs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bays"@en .

aat:300132317 a skos:Concept ;
    skos:definition "Denotes small rounded indentations in a coastline, smaller than bays and generally characterized by a narrow entrance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coves"@en .

aat:300132319 a skos:Concept ;
    skos:definition "Floating masses of ice; detached portions of glaciers which have been carried out to sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icebergs"@en .

aat:300132320 a skos:Concept ;
    skos:definition "Large areas of thin sheets of floating ice driven together by wind or currents to form a mass covering the entire sea surface with little or no open water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pack ice"@en .

aat:300132322 a skos:Concept ;
    skos:definition "Designates waterlogged areas with pondweeds, reeds, and rushes and in which peat is accumulating but the water remains alkaline. Distinct from \"bogs,\" in which the peat has reached a higher acidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fens"@en .

aat:300132324 a skos:Concept ;
    skos:definition "Fractures in the crust of a planet, accompanied with a displacement of one side of the fracture compared with the other, usually in a parallel direction to the fracture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faults"@en .

aat:300132325 a skos:Concept ;
    skos:definition "Vents in the crust of the Earth or other planet or satellite, from which issue eruptions of molten rock, hot rock fragments, and hot gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volcanoes"@en .

aat:300132326 a skos:Concept ;
    skos:definition "Relatively long, narrow, winding ridges of mixed sand and gravel, deposited probably by streams of meltwater flowing through crevasses and tunnels in stagnant ice sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eskers"@en .

aat:300132327 a skos:Concept ;
    skos:definition "Mounds, knobs, or hillocks of poorly stratified drift left by retreating ice sheets. For sinuous ridges of fluvio-glacial origin, use \"eskers\"; for elongated hills of glacial origin, use \"drumlins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kames"@en .

aat:300132328 a skos:Concept ;
    skos:definition "Landforms which are the result of water moving over the earth's surface, shaped by erosional and depositional processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluvial landforms"@en .

aat:300132329 a skos:Concept ;
    skos:definition "Low ridges of stratified, unconsolidated sand and gravel created by the wave action of lakes or oceans and representing previous coastlines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach ridges"@en .

aat:300132330 a skos:Concept ;
    skos:definition "Regions of land, usually bordering rivers, streams, or lakes, which are subject to excessive rainfall and short-term flooding of flat portions. Regions of land, usually bordering rivers, streams, or lakes, which are subject to excessive rainfall and short-term flooding of flat portions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flood plains"@en .

aat:300132331 a skos:Concept ;
    skos:definition "Landforms whose constituents have been carried and laid down by air currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eolian landforms"@en .

aat:300132341 a skos:Concept ;
    skos:definition "Either used for long, narrow land depressions, especially on shores and largely parallel to coastlines, or for narrow, valleylike features formed where two slopes intersect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swales"@en .

aat:300132350 a skos:Concept ;
    skos:definition "Low-lying flat or level ground, usually associated with wetlands and river valleys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flats"@en .

aat:300132351 a skos:Concept ;
    skos:definition "Flat expanses of land which have been covered with a layer of salt, due to the evaporation of a body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt flats"@en .

aat:300132353 a skos:Concept ;
    skos:definition "Steep slopes in front of fortifications. Also, long, steep cliffs or slopes resulting from erosion, and which separate two comparatively level surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escarpments"@en .

aat:300132356 a skos:Concept ;
    skos:definition "Deviations from the horizontal or perpendicular, particularly stretches of rising or falling ground, including any portion of the earth's surface marked by a gradual ascent or descent, whether natural or artificial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slopes"@en .

aat:300132360 a skos:Concept ;
    skos:definition "Multicellular eukaryotic life forms characterized by photosynthesis, in which chemical energy is produced from water, minerals, and carbon dioxide with the aid of pigments and the radiant energy of the Sun. However, also included in the kingdom are plants that do not produce their food by photosynthesis, but rather are parasitic and live off of other living plants. Other plants are saprophytic, obtaining their food from dead organic matter. Plants have cells that contain cellulose in their walls and are therefore to some extent rigid. There is also an absence of organs of locomotion, resulting in a more or less stationary existence as well as no sensory and nervous systems. There are over 300,000 living species of plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plantae"@en .

aat:300132362 a skos:Concept ;
    skos:definition "Designates ornamental plants grown indoors, other than in greenhouses, and adapting to less than ideal environmental conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "houseplants"@en .

aat:300132372 a skos:Concept ;
    skos:definition "Term used to describe trees, shubs, and vines; plants that have lignified secondary xylem in their stems. Term used to describe trees, shubs, and vines; plants that have lignified secondary xylem in their stems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woody plants"@en .

aat:300132375 a skos:Concept ;
    skos:definition "Perennial plants which have no woody stem, and which can be divided into three types: annuals, biennials, and herbaceous perennials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbaceous plants"@en .

aat:300132376 a skos:Concept ;
    skos:definition "Designates plants that complete their cycle from seed to seed in a single year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annuals"@en .

aat:300132378 a skos:Concept ;
    skos:definition "The underground spheroidal portions of the stem of certain plants, such as an onion, lily, or other plant of analogous mode of growth. Although in popular language regarded as a kind of ‘root,’ bulbs are not roots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulbs"@en .

aat:300132384 a skos:Concept ;
    skos:definition "Built works used by, or in support of, institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "institutional buildings"@en .

aat:300132397 a skos:Concept ;
    skos:definition "Plants in the graminae family, and plants resembling those in appearance. Also, used generally to refer to herbage, especially herbage eaten by grazing animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grasses"@en .

aat:300132399 a skos:Concept ;
    skos:definition "The reproductive portions of any plant in the division Angiospermae, flowering plants. As popularly used, the term \"flower\" especially applies when part or all of the reproductive structure is distinctive in color and form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flowers"@en .

aat:300132404 a skos:Concept ;
    skos:definition "Plants which remain green and leafy throughout the year, usually with new herbaceous growth from perennating parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perennials"@en .

aat:300132406 a skos:Concept ;
    skos:definition "Trailing or twining plants, whose stems require support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vines"@en .

aat:300132407 a skos:Concept ;
    skos:definition "Low-growing, woody perennials characterized by several branches at the base and by a lack of conspicuous trunks; generally restricted to plants under 6 m high."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrubs"@en .

aat:300132410 a skos:Concept ;
    skos:definition "Woody, perennial plants usually with a single, long, self-supporting stem or trunk, and which grow to a considerable height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trees"@en .

aat:300132413 a skos:Concept ;
    skos:definition "Trees which seasonally shed leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deciduous trees"@en .

aat:300132417 a skos:Concept ;
    skos:definition "Trees which have green leaves throughout the year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evergreens"@en .

aat:300132421 a skos:Concept ;
    skos:definition "Trees which form an overhanging shade or shelter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canopy trees"@en .

aat:300132422 a skos:Concept ;
    skos:definition "Trees growing beneath the level of the tallest trees in a forest, therefore being somewhat sheltered from full sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "understory trees"@en .

aat:300132428 a skos:Concept ;
    skos:definition "Plants that spring and vegetate during one growing season, and flower then perish the next."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biennials"@en .

aat:300132436 a skos:Concept ;
    skos:definition "Nonwoody plants (perennials, biennials, or annuals) which produce seeds, but die down at the end of the growing season."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbs"@en .

aat:300132439 a skos:Concept ;
    skos:definition "Naturally occuring groups of plants that share a common environment and interact with each other, animal populations, and the physical environment. Plant communities tend to co-occur on the landscape due to shared environmental requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant communities"@en .

aat:300132443 a skos:Concept ;
    skos:definition "Land that is used to grow crops, or is suited to grow crops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cropland"@en .

aat:300132447 a skos:Concept ;
    skos:definition "Landscapes with densely built-up districts and settlement areas and with distinctive skylines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban landscapes"@en .

aat:300132448 a skos:Concept ;
    skos:definition "Town and country areas with heterogeneous patchy mixture of residential areas, commercial centers, cropland, managed vegetation, and natural areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suburban landscapes"@en .

aat:300132449 a skos:Concept ;
    skos:definition "Designates wild and uncultivated regions that have been left untouched in a natural state by humans, with no human control or interference; distinct from \"nature reserves\" in which plant and animal communities are protected and controlled; distinct from \"wilderness areas\" which are lands where natural growth is protected by legislation, and recreation and industrial use are restricted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wilderness"@en .

aat:300132451 a skos:Concept ;
    skos:definition "Tracts of land with trees, often acting as boundaries or barriers, but otherwise minimally utilized; smaller and less wild than forests. For landscapes dominated by trees and having various uses, prefer \"woodlands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woods"@en .

aat:300132453 a skos:Concept ;
    skos:definition "Forests comprised of the aggregate of all trees and associated vegatation found in and around a given urban area, including both individual street and park trees, and groupings of trees, whether on public lands such as greenways, or on private property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban forests"@en .

aat:300132457 a skos:Concept ;
    skos:definition "Lofty detached bell towers, particularly such towers found adjacent to certain Italian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaniles"@en .

aat:300132460 a skos:Concept ;
    skos:definition "Functions found in education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational functions"@en .

aat:300132462 a skos:Concept ;
    skos:definition "Functions or performances that are legal in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal functions"@en .

aat:300132463 a skos:Concept ;
    skos:definition "Functions or performances that are related to health care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health care functions"@en .

aat:300132464 a skos:Concept ;
    skos:definition "Functions or performances that are religious in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious functions"@en .

aat:300132466 a skos:Concept ;
    skos:definition "The industry providing facilities and services to people traveling for recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourism"@en .

aat:300132468 a skos:Concept ;
    skos:definition "Act of dismissing an employee from a position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firing"@en .

aat:300132469 a skos:Concept ;
    skos:definition "Naming to or placing in an office or position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appointing"@en .

aat:300132471 a skos:Concept ;
    skos:definition "Functions or performances that are related to communication or the communications industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communication functions"@en .

aat:300132472 a skos:Concept ;
    skos:definition "Openly expressing objection, disapproval, or dissent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protesting"@en .

aat:300132482 a skos:Concept ;
    skos:definition "Vertical structures that are monuments or memorials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumental pillars"@en .

aat:300132484 a skos:Concept ;
    skos:definition "Buildings that are used for public arts performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "performing arts buildings"@en .

aat:300132596 a skos:Concept ;
    skos:definition "Distinctive type of opus sectile (\"cut work\") technique, by which small triangles and rectangles of colored stones and glass mosaics are set into stone matrices or encrusted upon stone surfaces of floors, walls, or church fixtures; particularly as used in works with geometric patterns produced in Rome from the 12th to the 14th centuries. The name derives from the surname of a family of marbleworkers active in Rome, although all works of this type were not made by this one family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cosmati work"@en .

aat:300132618 a skos:Concept ;
    skos:definition "Settlement areas encompassing a central city and surrounding municipal or political jurisdictions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metropolitan areas"@en .

aat:300132652 a skos:Concept ;
    skos:definition "Buildings or complexes constructed for or serving businesses, merchants, and other commercial purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial complexes"@en .

aat:300132653 a skos:Concept ;
    skos:definition "Underground excavations made for the extraction of diamonds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond mines"@en .

aat:300132655 a skos:Concept ;
    skos:definition "Mines from which silver is obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver mines"@en .

aat:300132656 a skos:Concept ;
    skos:definition "Mines from which gold is obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold mines"@en .

aat:300132660 a skos:Concept ;
    skos:definition "Areas, used mainly for census and federal funding allocation, having a dominant central city with a combined minimum population of 50,000 and with a surrounding urbanized community that is economically and socially integrated with the central city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Standard Metropolitan Statistical Areas"@en .

aat:300132690 a skos:Concept ;
    skos:definition "Buildings that contain the centers of strategic control for the entire corporation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate headquarters"@en .

aat:300132705 a skos:Concept ;
    skos:definition "Refers to the period and style associated with the latter part of the reign of the house of the Palaeologi, particularly in the late 13th and early 14th centuries. The style is most evident in painting, but is also evident in ecclesiastical architecture of Constantinople during this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Palaeologan"@en .

aat:300132707 a skos:Concept ;
    skos:definition "Refers generally to the bolder and more extravagant flights of Rococo style as applied to the decorative arts, deriving from the ornate rockwork and shellwork used for fountains and grottoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rocaille"@en .

aat:300132708 a skos:Concept ;
    skos:definition "Refers to the trend in American interior design of the late 1960's, the term coined by Progressive Architecture magazine. The style is characterized by large, over-articulated design elements and the use of transparent, reflective, or synthetic materials often combined to achieve tromp l'oeil effects. During the 1970's, the term was extended to include certain trends in Post-Modern architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Supermannerist"@en .

aat:300132717 a skos:Concept ;
    skos:definition "Covered outdoor walkways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered walkways"@en .

aat:300132827 a skos:Concept ;
    skos:definition "Protection and improvement of community health by organized community effort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public health"@en .

aat:300132861 a skos:Concept ;
    skos:definition "Refers to a fine, openwork ornamental textile work formed by looping, interlacing, twisting, plaiting, or braiding threads of linen, cotton, silk, hair, metal, or another fiber to form designs or patterns. Lace may be made with a needle or with bobbins. Embroidery may be added. Modern lace may be made by machine. Openwork fabrics made on a loom and ornamental openwork knitting are generally not classified as lace. Lace is often white or monochromatic. True lace developed in the fourteenth century in Europe and the Middle East, although ornamented openwork fabrics were known in ancient cultures, including the Egyptian culture. Lace may be used as a border, edging, or insert on linens or apparel; it is also formed into large pieces of cloth used for hangings, draperies, apparel, or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace"@en .

aat:300132862 a skos:Concept ;
    skos:definition "Stout mohair or worsted cloth produced in the 18th and 19th centuries in closely woven plain weave with thicker weft than warp, giving it a slight rib that made it suitable for watering and embossing; in the 19th century, often woven with a cotton warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moreen"@en .

aat:300132867 a skos:Concept ;
    skos:definition "Wool textile with a rough, homespun surface effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tweed"@en .

aat:300132868 a skos:Concept ;
    skos:definition "Loosely woven wool or cotton tabby, finished with a long nap to imitate felt and dyed in solid colors. Used as a protective covering for furnishings, as well as for costume, especially the lining of outerwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baize"@en .

aat:300132869 a skos:Concept ;
    skos:definition "With \"needle lace,\" one of two primary types of handmade lace. It is characterized by being made by intertwisting threads that are wound on spools or bobbins and worked over a pillow on which the pattern is marked out by pins; the lace is worked with both hands moving the bobbins from side to side to form a twist, a braid, or a fabric called \"toile.\" Lead or bone weights are used. It probably was developed in the early 16th century in Flanders. Early bobbin lace was often used for ruffs and collars and is characterized by rows of deeply angled points on a narrow band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bobbin lace"@en .

aat:300132872 a skos:Concept ;
    skos:definition "Cotton textile, heavier than muslin, plain, dyed, or with patterns printed in one or more colors. In the 18th and 19th centuries, the term referred to printed, colored or plain cloth from India; now it refers generally to cotton prints with small, stylized patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calico"@en .

aat:300132876 a skos:Concept ;
    skos:definition "Originally an Indian patterned textile, usually cotton or linen, painted and/or printed in multiple stages of dyeing, mordanting, and resist-dyeing. Later imitated with industrial processes, usually cotton or linen, dyed in a number of colors and usually glazed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chintz"@en .

aat:300132879 a skos:Concept ;
    skos:definition "Trademarked name for the textile fiber made of polyethylene terephthalate. Originally manufactured and developed by Du Pont."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dacron (TM)"@en .

aat:300132883 a skos:Concept ;
    skos:definition "Cotton with corded stripes or check effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimity"@en .

aat:300132884 a skos:Concept ;
    skos:definition "Durable, closely woven textile of plain weave, made formerly of linen but now usually of cotton, made in various weights; very similar to canvas but finer and lighter. Common uses are for tents, belts, and clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duck"@en .

aat:300132886 a skos:Concept ;
    skos:definition "Soft twill with a slightly napped surface, made in various weights of wool or soft cotton yarn, often in combination with synthetic yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flannel"@en .

aat:300132887 a skos:Concept ;
    skos:definition "Strong cloth woven in a variety of patterns, in common use for bedding and lining for clothing from the 17th to the 19th century. Prior to the 17th century it was made of worsted, then pure cotton or mixes of cotton and linen became common; today generally a cotton twill with a short nap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fustian"@en .

aat:300132888 a skos:Concept ;
    skos:definition "Refers to needlework created by working a design between the prongs of a large hairpin or another implement shaped like a hairpin. Loops are passed around the prongs to hold the piece in place as it is created, and the piece is slipped off the hairpin when it is finished. It is characterized by having large open loops at the sides, and it may be tied together to form rosettes or attached to other pieces of hairpin lace. It is typically used to make edgings, trimmings, headwear, or other apparel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairpin lace"@en .

aat:300132889 a skos:Concept ;
    skos:definition "Synthetic yarn that will stretch under tension and contract when released; usually made from thermoplastic filaments, and used especially for hosiery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretch yarn"@en .

aat:300132890 a skos:Concept ;
    skos:definition "Lace originally manufactured in the town of Valenciennes, in northern France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Valenciennes"@en .

aat:300132896 a skos:Concept ;
    skos:definition "Lightweight silk of plain weave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese silk"@en .

aat:300132902 a skos:Concept ;
    skos:definition "Woven textile characterized by a basic binding system or weave with smooth, shiny surface formed by long warp floats. Generally, each warp end passes over four or more adjacent weft picks and under the next one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satin"@en .

aat:300132908 a skos:Concept ;
    skos:definition "Refers to the movement of the late 19th and early 20th centuries practiced by British and American artists such as George Inness, James McNeill Whistler, and Dwight Tryon. The movement defined a painting style similar to Impressionism, based on soft, diffused light, muted tones, and vague, nebulous outlines of objects; the movement diverged from Impressionism and expressed Symbolist tendencies in its use of neutral palettes, expressions of contemplative nature, and in its subjective style centered on establishing an atmosphere or mood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tonalist"@en .

aat:300132937 a skos:Concept ;
    skos:definition "Buildings housing devices for projecting celestial images onto the interior of a dome for public viewing; may also be used for the projecting mechanisms. For mechanical models of the solar system, use \"orreries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planetaria"@en .

aat:300132958 a skos:Concept ;
    skos:definition "Ceramic basins pressed into walls as ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bacini"@en .

aat:300132961 a skos:Concept ;
    skos:definition "Those who revise, redraft, update, or otherwise make authorized changes to drawings, plans, models, manuscripts, printed texts, or any form of document, visual or verbal, originally created by others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revisers"@en .

aat:300132977 a skos:Concept ;
    skos:definition "Refers to the style of art and architectural ornament seen primarily in the late 17th through late 18th centuries, principally in Spain and its American colonies. The style is named after the family of Madrid architects, particularly Jose de Churriguera, though other architects also contributed to the development and popularization of the style. The style is characterized by an abundance of ornament and detail, combining various elements from earlier Mannerist and Baroque art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Churrigueresque"@en .

aat:300132986 a skos:Concept ;
    skos:definition "Use only for vernacular British sheds for cattle, wagons, or farm equipment from the 16th to the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belfrys"@en .

aat:300132989 a skos:Concept ;
    skos:definition "Designates lines of dwellings situated on a sloping, terraced, or similar site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrace houses"@en .

aat:300132998 a skos:Concept ;
    skos:definition "Maps in which small, semipictorial symbols such as dots or lines are used over the area of the map to represent distribution of land utilization or vegetation, without indication of quantity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choroschematic maps"@en .

aat:300133002 a skos:Concept ;
    skos:definition "Chairs with back splats in the form of a lyre, a Regency period motif popularized by Adam, Hepplewhite, Sheraton, and Duncan Phyfe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyre-back chairs"@en .

aat:300133005 a skos:Concept ;
    skos:definition "Works of fine or decorative art, typically in the context of collectables and of relatively small size, rather than museum objects or large in size. In English, use of the French term \"objets d'art\" emphasizes this meaning. For fine art, generally prefer the term \"works of art\" rather than \"art objects,\" although usage overlaps. When referring to the study or practice of the fine arts or the fine and decorative arts together, use \"art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "objets d'art"@en .

aat:300133011 a skos:Concept ;
    skos:definition "The activity of directing the business affairs and human and material resources of an organization, project, or enterprise, involving primarily the formulation of policy. When the application rather than the formulation of policy is the primary aspect, use \"management.\" For directly overseeing the activities of an organization or enterprise, use \"supervising.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "administration"@en .

aat:300133015 a skos:Concept ;
    skos:definition "Semicircular niches which are covered with a semidome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conchs"@en .

aat:300133018 a skos:Concept ;
    skos:definition "Sacred or honorific gateways made of wood or stone, comprised of two uprights with one and three crosspieces, or arched, found in Hindu, Buddhist, and Jain architecture. Gateway; archiform gateway-pattern; auspicious garland-like motif; decorative arch-way/gateway (early Indian); decorative auspicious arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toranas"@en .

aat:300133024 a skos:Concept ;
    skos:definition "Areas equipped with distance markers, clubs, balls, and tees for practicing golf drives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driving ranges"@en .

aat:300133025 a skos:Concept ;
    skos:definition "Works of art in any medium, including performance art. A work of art may exist as a part of a larger object, e.g., a mural painting or a painting on a piece of furniture. When referring to the study or practice of the fine arts or the fine and decorative arts together, use \"art.\" In reference to pieces of fine or decorative arts as collectables rather than museum objects, in English use either \"art objects\" or the French term \"objets d'art,\" which emphasizes this meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "works of art"@en .

aat:300133032 a skos:Concept ;
    skos:definition "Solid figures contained by six equal squares and eight rectangular solid angles; regular hexahedrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cubes"@en .

aat:300133038 a skos:Concept ;
    skos:definition "Sequences or series of mathematical objects or quantities, in which each entry is determined from its predecessors by some algorithm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arithmetic progressions"@en .

aat:300133044 a skos:Concept ;
    skos:definition "Refers to the effect of suggesting pictorial depth by depicting more distant things with less clarity of outline and detail. Where color is involved, distant objects may be indicated by alteration of hue toward blue, and decrease of color saturation and value contrast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmospheric perspective"@en .

aat:300133046 a skos:Concept ;
    skos:definition "The habit, power, state, or faculty of being able to locate, gain entry to, and use something, such as a building or a database. In computer-based information retrieval, access is the method by which a computer refers to records in a file, dependent upon their arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "access"@en .

aat:300133073 a skos:Concept ;
    skos:definition "Paper slips or cards indicating that the holder has paid for or is entitled to entrance or admission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "admission tickets"@en .

aat:300133076 a skos:Concept ;
    skos:definition "Brocade done in high relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brocatelle"@en .

aat:300133085 a skos:Concept ;
    skos:definition "Parts or aspects of compositions, such as 'foreground' and 'background.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compositional elements"@en .

aat:300133087 a skos:Concept ;
    skos:definition "Elements in a pictorial composition that lead the eye step-by-step back into depth, such as side-pieces in a stage set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coulisses"@en .

aat:300133088 a skos:Concept ;
    skos:definition "An element placed in the immediate foreground of a pictorial composition to direct the spectator's eye into the picture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repoussoir"@en .

aat:300133089 a skos:Concept ;
    skos:definition "A fundamental dimensional quantity defined by a nonspatial continuum in which events occur in apparently irreversible succession from the past through the present to the future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time"@en .

aat:300133091 a skos:Concept ;
    skos:definition "The climatic divisions of the year, that are spring, summer, winter, and autumn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seasons"@en .

aat:300133092 a skos:Concept ;
    skos:definition "The interval of time between sunrise and sunset."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day"@en .

aat:300133093 a skos:Concept ;
    skos:definition "The season of the year which is the transition period from summer to winter, occurring as the sun approaches the winter solstice, its beginning marked by the autumnal equinox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autumn"@en .

aat:300133095 a skos:Concept ;
    skos:definition "The period between sunset and sunrise, especially the hours of darkness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night"@en .

aat:300133097 a skos:Concept ;
    skos:definition "The season between winter and summer during which the weather becomes warmer and plants revive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring"@en .

aat:300133099 a skos:Concept ;
    skos:definition "The usually warmest season of the year, occurring between spring and autumn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer"@en .

aat:300133101 a skos:Concept ;
    skos:definition "Usually the coldest season of the year, occurring between autumn and spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter"@en .

aat:300133118 a skos:Concept ;
    skos:definition "A very light, cellular concrete made by adding a prepared foam or by generating gas within the unhardened mixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foamed concrete"@en .

aat:300133138 a skos:Concept ;
    skos:definition "Refers to minute parts of a larger structure, object, or image. For architectural drawings of design or construction details, use \"detail drawings.\" For preparatory studies of pictorial or design details, use \"detail studies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "details"@en .

aat:300133146 a skos:Concept ;
    skos:definition "Assemblies of items that the creator intended to be kept or seen together, cuch as a tea set, a desk set, or a pair of terrestrial and celestial globes. A set differs from a collection in that it is typically smaller and it was intended by the creator to be grouped together. It is useful to catalog the set as a whole when the items in the set will not be cataloged separately or when there are characteristics of the whole set that may not be apparent in the individual records for the parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sets"@en .

aat:300133149 a skos:Concept ;
    skos:definition "Architectural materials reused; usually pieces built into a new fabric. A term used especially for ancient and Medieval instances of the practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spolia"@en .

aat:300133150 a skos:Concept ;
    skos:definition "Buildings housing institutions tasked to hold and detain members of the armed forces, in the U.S. particularly who have been convicted of violations of the Uniform Code of Military Justice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military prisons"@en .

aat:300133154 a skos:Concept ;
    skos:definition "Refers to open spaces, buildings, or other structures that are of historic or environmental significance and threatened with development or demolition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endangered places"@en .

aat:300133167 a skos:Concept ;
    skos:definition "Thermosetting plastic coating applied to metal, resulting in a hard and resistant finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder coating"@en .

aat:300133170 a skos:Concept ;
    skos:definition "Drawings that are broadside elevations of a ship, emphasizing the ship's lines. When appearing with a body plan and a half-breadth plan, use \"lines drawings\" for the set. For more detailed broadside elevations, use \"outboard profiles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheer plans"@en .

aat:300133172 a skos:Concept ;
    skos:definition "Use as a general designation for drawings that specify the structure or arrangement of a ship, whether plan views, elevations, or sections. May be construction drawings, to be used for constructing a ship, or measured drawings made after an existing ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships plans"@en .

aat:300133179 a skos:Concept ;
    skos:definition "Refers to drawings that show a ship's lines. It includes \"sheer plans,\" \"half-breadth plans,\" and \"body plans,\" often all drawn on one sheet. They should not be confused with \"line drawings,\" which are drawings of any subject in which forms are indicated primarily by lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lines drawings"@en .

aat:300133185 a skos:Concept ;
    skos:definition "In shipbuilding, drawings and works in other two-dimensional media showing the layouts of decks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deck plans"@en .

aat:300133187 a skos:Concept ;
    skos:definition "Drawings giving the information necessary for preparing a dry dock for reception of a ship. May include profiles and sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "docking plans"@en .

aat:300133202 a skos:Concept ;
    skos:definition "Finely ground chips used as a filler or abrasive in hand soaps and for casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marble dust"@en .

aat:300133203 a skos:Concept ;
    skos:definition "Copper-zinc alloy with a small amount of tin which improves corrosion resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin brass"@en .

aat:300133207 a skos:Concept ;
    skos:definition "Bronze that contains nickel, usually replacing part of the tin content, to produce a tough, fine-grained, corrosion-resistant metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickel bronze"@en .

aat:300133209 a skos:Concept ;
    skos:definition "Limestone containing many small, rounded particles, which are concentric layers of calcium carbonate deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oolitic limestone"@en .

aat:300133212 a skos:Concept ;
    skos:definition "Thermoplastic made by the esterification of cellulose with acetic acid and butyric acid in the presence of a catalyst; particularly valued for coatings, insulation, varnish, and lacquer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butyrate"@en .

aat:300133217 a skos:Concept ;
    skos:definition "Smooth, lemon yellow colored wood of the species Calycohyllum candidissimum, native to Cuba, Mexico, Columbia, and Venezuela. It is used for structures, millwork, carving, fishing rods, archery bows, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "degame"@en .

aat:300133219 a skos:Concept ;
    skos:definition "Wood of the species Terminalia superba, native to West Africa. It ranges in color from pale straw to dark irregular grey markings; it is used for making solid parts of furniture, paneling, inlay, and musical instruments, famously the Gibson guitar. It is prized for its workability, color, and finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limba"@en .

aat:300133223 a skos:Concept ;
    skos:definition "A translucent red or orange variety of chalcedony, containing iron impurities. An example of use is for seals and signet rings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnelian"@en .

aat:300133225 a skos:Concept ;
    skos:definition "A hard, durable wood from several species of the genus Dalbergia native to Central America, most often from species Dalbergia retusa. It has a medium fine texture and is usually a reddish brown color with dark wavy figuring. It is dense and difficult to cut or carve. The wood is primarily used for making knife handles and small carved items. Cocobolo wood is naturally resistant to decay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocobolo"@en .

aat:300133230 a skos:Concept ;
    skos:definition "General term referring to dark, tropical hardwoods of various species in several genera, including Dalbergia, Passiflora, Platymiscium, Miconia, and Brya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granadilla"@en .

aat:300133242 a skos:Concept ;
    skos:definition "White to bluish gray mineral,. It is used in the manufacture of brick and as an ore of magnesium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesite"@en .

aat:300133244 a skos:Concept ;
    skos:definition "Alloy composed of about 67% nickel, 28% copper, and 5% other elements such as iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monel (TM)"@en .

aat:300133246 a skos:Concept ;
    skos:definition "Wood from any of the various trees of the genus Prosopis, commonly found in arid regions of the southwestern United States, Mexico, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mesquite"@en .

aat:300133251 a skos:Concept ;
    skos:definition "Hard, golden-brown wood of the species Acacia koa, native to Hawaii. The color and grain pattern of koa wood changes with growing conditions and tree age. It is a lightweight, but durable wood, that is brittle with variations in density. Koa is difficult to work or plane but carves well and polishes to a high gloss, used for carvings, boats, dugout canoes, early surfboards, veneers, musical instruments, and furniture. It was the royal wood of the native Hawaiians and was used for everything that came in contact with the royal family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koa"@en .

aat:300133254 a skos:Concept ;
    skos:definition "Wood floating on water, or that has been cast ashore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driftwood"@en .

aat:300133261 a skos:Concept ;
    skos:definition "Inert noble gas with symbol Ar and atomic number of 18, used in metalworking and as a filler for electric incandescent and fluorescent light bulbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argon"@en .

aat:300133268 a skos:Concept ;
    skos:definition "Procedures by which light-sensitive materials are made to produce an image. For procedures related to how a photograph is taken or composed, or is manipulated during or after processing, use \"photographic techniques.\" For printing processes involving light-sensitivity at one stage, but creating a final print that was never itself light-sensitive, use \"photomechanical processes.\" For light-sensitive processes used especially to make reproductive prints of documents and technical drawings, use descriptors found under \"<light-sensitive reprographic processes>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic processes"@en .

aat:300133274 a skos:Concept ;
    skos:definition "Photographic processes in which albumen is used as the binder. Common for photographic prints and occasionally for lantern slides, but rarely used for negatives on glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albumen process"@en .

aat:300133280 a skos:Concept ;
    skos:definition "Refers loosely to various photographic processes employing silver chloride printing-out paper with either gelatin or collodion as the binder; popular from the late 1880s to the early 20th century. At one time a trade name, but the term fell into generic use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aristotype"@en .

aat:300133281 a skos:Concept ;
    skos:definition "A direct positive process to make photographic prints in which a physically developed, unfixed print containing exposed silver chloride is soaked in a solution of potassium iodide and is bleached in relation to exposure in the camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bayard's process"@en .

aat:300133289 a skos:Concept ;
    skos:definition "Refers to a number of closely related variants of the salted paper process in which the paper was made translucent by waxing before sensitizing. Do not use if a paper negative has been waxed after processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waxed-paper process"@en .

aat:300133299 a skos:Concept ;
    skos:definition "Photographic process that uses a collodion binder which must be coated on the support, exposed, and developed before the collodion has become dry. A silver halide is the light-sensitive agent, and the process may be used to produce positives or negatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet collodion process"@en .

aat:300133305 a skos:Concept ;
    skos:definition "A type of collodion process in which the binder was dried before exposure or contained a hygroscopic agent to retain sufficient moisture to allow processing after an extended period of time; an improvement on the wet collodion process because it alleviated the need for a portable darkroom. Used to produce negatives and lantern slides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry collodion process"@en .

aat:300133309 a skos:Concept ;
    skos:definition "Photographic process used primarily for instant or self-developing photographs in which the positive image is formed from undeveloped silver halides in the negative. The negative is placed in contact with a support in the presence of a developing agent, and the unexposed silver diffuses to the support to form the positive image. For making color instant camera photographs, it is dye couplers that are in the negative, in which case use \"dye diffusion transfer process\" or \"internal dye diffusion transfer process.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffusion transfer process"@en .

aat:300133319 a skos:Concept ;
    skos:definition "Processes in which a positive-image photograph is formed in the camera without an intermediate negative, or for positive-to-positive processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct positive processes"@en .

aat:300133322 a skos:Concept ;
    skos:definition "Process invented by J.N. de Niépce around 1825 in which bitumen that had been coated on glass or metal hardened in relation to exposure; by washing with oil of lavender left only the hardened image area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliography"@en .

aat:300133326 a skos:Concept ;
    skos:definition "Early color photographic process announced by Levi L. Hill in 1856 but thought until recently to be spurious, and still not fully understood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hillotype"@en .

aat:300133340 a skos:Concept ;
    skos:definition "William Henry Fox Talbot's process in which paper negatives were produced by printing out a silver image. Distinguished from \"calotype,\" in which the image is developed. In the mid-19th century, sometimes used as a synonym of photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogenic drawing"@en .

aat:300133364 a skos:Concept ;
    skos:definition "Photographic processes based on the photosensitivity of certain iron compounds. Usually require intense light and thus employ contact printing. Do not use when iron sulfate is used to develop a silver image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron processes"@en .

aat:300133379 a skos:Concept ;
    skos:definition "An iron process largely used for reproducing technical drawings; produces an image in black. The image is developed out with gallic acid and is fixed by washing in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrogallic process"@en .

aat:300133401 a skos:Concept ;
    skos:definition "Photographic process that is a variant of the platinum process in which citrate of mercury is introduced, giving sepia tones to the print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepia platinotype"@en .

aat:300133407 a skos:Concept ;
    skos:definition "A variant of the carbon process to produce contact prints; the image is formed from a pigment, usually carbon black, in a colloid suspension that has been made light-sensitive with bichromates. Marketed under the name Charbon Velours."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Artigue process"@en .

aat:300133414 a skos:Concept ;
    skos:definition "Printing process for color which was derived from the Heliochromes of inventor Louis Ducos du Hauron (1837-1920)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fresson"@en .

aat:300133430 a skos:Concept ;
    skos:definition "A subtractive color reversal process using a film with an integral tripack of black-and-white emulsions, each layer sensitized to a separate primary color. The film contains no dyes; the color developing agents and color couplers are supplied in development, each layer being dyed and bleached separately by carefully controlled processing through three machines, with separate drying between each machine. For Capstaff's two-color Kodachrome process, use \"two-color processes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kodachrome (TM)"@en .

aat:300133431 a skos:Concept ;
    skos:definition "A trademark of Eastman Kodak Company. A chromogenic process to produce subtractive-color negatives in an integral tripack. The process produces integral color masks, which give the film its characteristic orange color. First marketed in 1941, the Kodacolor process has been improved several times. All modern color negative processes are variants of the Kodacolor process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kodacolor (TM)"@en .

aat:300133448 a skos:Concept ;
    skos:definition "Photographic processes using two colors, usually red and green or orange and near-cyan, to synthesize the full color spectrum; may be additive or subtractive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-color processes"@en .

aat:300133464 a skos:Concept ;
    skos:definition "A photographic process to produce color images in a grainless silver halide emulsion by interference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lippmann process"@en .

aat:300133465 a skos:Concept ;
    skos:definition "A subtractive color photographic process in which dyes present in the emulsion are bleached, leaving only those dyes that correspond to the image color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver-dye bleach process"@en .

aat:300133470 a skos:Concept ;
    skos:definition "A subtractive color process for making photographic prints and transparencies using a silver-dye bleach process. Also marketed under the name Cilchrome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cibachrome (TM)"@en .

aat:300133492 a skos:Concept ;
    skos:definition "Photographic process in which the image is formed by dusting a pigment onto a surface of bichromated colloid that has been exposed through a transparency. Areas exposed to light lose their tackiness and hold less pigment. Generally for prints on glass or ceramic, where the pigment is fired as a glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dusting-on process"@en .

aat:300133493 a skos:Concept ;
    skos:definition "Bichromate photographic processes relying on the ability of an exposed emulsion that has been soaked in cold water to resist or accept greasy inks in relation to the amount of exposure. The original print may be the end product or may be used as a master for transferring the image to another support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil processes"@en .

aat:300133506 a skos:Concept ;
    skos:definition "Process of making photographic prints using a printing-out paper that has light-sensitive salts of uranium and silver in a collodion binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wothlytype"@en .

aat:300133529 a skos:Concept ;
    skos:definition "Dye transfer process invented by Dr. E. König where a single gelatin film can be treated to create multiple prints from the colored plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinatype"@en .

aat:300133532 a skos:Concept ;
    skos:definition "Process introduced by the Eastman Kodak Co. in the early 1930s for printing color images from gelatin matrices which are prepared by exposure to separation negatives. The process is seen as a prototype for the modern-day dye transfer process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastman Wash-off Relief (TM)"@en .

aat:300133562 a skos:Concept ;
    skos:definition "Process by which the color of a black-and-white image is altered by replacing the silver image with inorganic, metallic compounds (such as gold, sulfur, iron, or selenium)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallic toning"@en .

aat:300133676 a skos:Concept ;
    skos:definition "Refers to a variant of the dusting-on process in which pigment is a vitrifiable powder, available in a wide range of colors, that is fired onto porcelain, earthenware, china, or the like; more broadly refers to any process to form an image on porcelain, china, earthenware, or similar material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramic process"@en .

aat:300133704 a skos:Concept ;
    skos:definition "Collective term referring to interior areas that are enclosed by walls or defined by other divisions. Always used in the plural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rooms and spaces"@en .

aat:300133705 a skos:Concept ;
    skos:definition "A loose-weave cotton fabric, used especially to shade growing tobacco plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco cloth"@en .

aat:300133706 a skos:Concept ;
    skos:definition "Brass having a reddish tint due to a high copper content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red brass"@en .

aat:300133707 a skos:Concept ;
    skos:definition "A variety of gypsum occurring in transparent crystals or crystalline masses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selenite"@en .

aat:300133708 a skos:Concept ;
    skos:definition "Rubber made from silicone elastomers and characterized by its retention of flexibility, resilience, and tensile strength over a wide temperature range and its resistance to weathering and many chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicone rubber"@en .

aat:300133710 a skos:Concept ;
    skos:definition "General term referring to any of numerous species of stony corals (order Madreporaria or order Scleractinia) that are round or polygonal in shape and contain conspicuous radiating septa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "star coral"@en .

aat:300133711 a skos:Concept ;
    skos:definition "Warp pile weave, typically silk, with a short, soft dense pile produced by a supplementary warp that is raised in loops above the surface of the textile through the introduction of rods during the weaving; the loops may be cut or left uncut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velvet"@en .

aat:300133718 a skos:Concept ;
    skos:definition "Ordinary casting plaster of 100 parts solid and 45 parts water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrostone"@en .

aat:300133719 a skos:Concept ;
    skos:definition "General term for wood of certain species belonging to the genus Shorea native to north Borneo; not true mahogany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Borneo mahogany"@en .

aat:300133724 a skos:Concept ;
    skos:definition "Bronze with a smooth, reddish surface, generally composed of 7 to 10% tin, 1 to 3% lead, and the remainder copper; used, for example, to make statues, plaques, and hardware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statuary bronze"@en .

aat:300133725 a skos:Concept ;
    skos:definition "Wood of the species Khaya anthoteca, light in color and tinged with red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white mahogany"@en .

aat:300133732 a skos:Concept ;
    skos:definition "Gemstone that is considered more valuable than other types, especially diamond, sapphire, emerald, ruby, and sometimes pearl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precious stone"@en .

aat:300133735 a skos:Concept ;
    skos:definition "Lighting by fluorescent lamps. Lighting by fluorescent lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescent lighting"@en .

aat:300133739 a skos:Concept ;
    skos:definition "Alloy of copper and beryllium containing usually not more than 3% beryllium. The alloy has a bronzelike, crystalline structure and is unsurpassed in its ability to withstand fatigue, wear, and corrosion and in its electrical conductivity at high temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper-beryllium alloy"@en .

aat:300133746 a skos:Concept ;
    skos:definition "Removable locks with a shackle that can be passed through a staple or link and then secured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padlocks"@en .

aat:300133748 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Sn and atomic number 50; a soft, pliable, silvery white metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin"@en .

aat:300133751 a skos:Concept ;
    skos:definition "Any of various hard, strong, durable, malleable alloys of iron and carbon, often with other elements such as manganese, chromium, nickel, molybdenum, copper, tungsten, cobalt, or silicon; widely used as a structural material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel"@en .

aat:300133763 a skos:Concept ;
    skos:definition "High-back chairs with broad central splats, generally having leather-upholstered backs and seats; popular in 18th-century America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boston chairs"@en .

aat:300133771 a skos:Concept ;
    skos:definition "Light folding chairs, usually with canvas seats and backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camp chairs"@en .

aat:300133792 a skos:Concept ;
    skos:definition "Well-defined channels that carry flowing water and that have been artificially constructed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial water channels"@en .

aat:300133797 a skos:Concept ;
    skos:definition "Structures shaped like crosses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross monuments"@en .

aat:300133798 a skos:Concept ;
    skos:definition "Refers to the phase of Cubism that focuses primarily on the depiction of different aspects of the same object simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Analytical Cubist"@en .

aat:300133811 a skos:Concept ;
    skos:definition "Angular lawn chairs, similar in form to Adirondack chairs, but constructed of boards rather than slats and heavier and more amply proportioned; older than the classic Adirondack chairs, patented by Harry C. Brunnell, and manufactured between 1904 and 1930."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Westport chairs"@en .

aat:300133822 a skos:Concept ;
    skos:definition "Chairs with flat backs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-back chairs"@en .

aat:300133824 a skos:Concept ;
    skos:definition "Zoroastrian fire temples of the Sassanian period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chahar taqs"@en .

aat:300133839 a skos:Concept ;
    skos:definition "Chairs which have splats on their chair-backs, which are pierced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pierced splat-back chairs"@en .

aat:300133850 a skos:Concept ;
    skos:definition "Ancient Greek throne-like chairs, usually ornamented, having an elevated seat, often a high back and arms and either legs ending in animal feet, turned or rectangular legs, or with solid sides. Used by people of wealth or prominence and seen in depictions of the Greek gods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thronoi"@en .

aat:300133851 a skos:Concept ;
    skos:definition "Chairs having a primarily ceremonial or ritual purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial chairs"@en .

aat:300133860 a skos:Concept ;
    skos:definition "English type of upholstered armchair with wings and an arched top making a niche to screen the occupant from drafts; made from the mid-18th century onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porters' chairs"@en .

aat:300133868 a skos:Concept ;
    skos:definition "Reclining chairs with a spring concealed under the seat which allows the chairs to recline and then snap into place; attributed to the American Chair Company, Troy, NY, about 1850."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centripetal spring chairs"@en .

aat:300133874 a skos:Concept ;
    skos:definition "16th-century English and early 17th-century American stools, usually upholstered and covered with sumptuous fabric and fringe. Term also applied to a variety of small, low stools generally with socketed legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffet stools"@en .

aat:300133884 a skos:Concept ;
    skos:definition "Settles with boards across the tops of the side boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooded settles"@en .

aat:300133894 a skos:Concept ;
    skos:definition "A French type of small canape or large chair for two people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marquises"@en .

aat:300133901 a skos:Concept ;
    skos:definition "Settees with high backs and hinged arms that may be upright or sloped out from the seat, named after the unique early specimen at Knole Park, Kent; popular for rich suburban furnishings in England in the 1920s and 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Knole settees"@en .

aat:300133904 a skos:Concept ;
    skos:definition "Asymmetrical seating forms with gently curved backs and having one arm higher than the other; made especially during the French Empire period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "méridiennes"@en .

aat:300133908 a skos:Concept ;
    skos:definition "Buildings housing businesses specializing in drapery and dry goods, prevalent in the early 19th century, which, contrary to standard merchandising practices of the day, kept large stocks of goods on the premises, grouping related items together in departments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magasins de nouveautés"@en .

aat:300133909 a skos:Concept ;
    skos:definition "Popular name for low chests of drawers having handles on each end for lifting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign chests"@en .

aat:300134005 a skos:Concept ;
    skos:definition "Boxy tables or case pieces on tall legs, used for serving food. Characterized by having no lower shelf, and occasionally drawers. Originally used outdoors for serving hunting parties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huntboards"@en .

aat:300134010 a skos:Concept ;
    skos:definition "Writing tables often with a leather-covered slide and sometimes with an adjustable hinged panel for reading. Distinguished from \"bureaux plats\" by their much smaller size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables à écrire"@en .

aat:300134019 a skos:Concept ;
    skos:definition "Long dining tables popular 16th-17th centuries, so-called because they resemble tables used in a refectory, although they were not necessarily actually used in a refectory. Typical examples are oblong tables with four or six turned legs that may be expanded by leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refectory tables"@en .

aat:300134034 a skos:Concept ;
    skos:definition "Small, low tables with box stretchers and, generally, turned legs and overhanging tops; designed for a variety of domestic uses, not necessarily exclusively for taverns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tavern tables"@en .

aat:300134053 a skos:Concept ;
    skos:definition "Tables having single slab of marble as a top surface. The form was particularly popular in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marble slab tables"@en .

aat:300134066 a skos:Concept ;
    skos:definition "Precut furniture parts, made of wood generally used for crates, sold in kits to be assembled by the purchaser into tables, chairs, and bookcases at low cost. Designed by Gerrit Rietveld in 1934."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crate furniture"@en .

aat:300134084 a skos:Concept ;
    skos:definition "Refers to the style, culture, and period of the Persianate Sunni Turkoman tribal confederation that ruled 1378-1503, under an Islamic dynasty in eastern Anatolia, Iran, and Iraq. Rising to power by supporting Timur, Akkoyunlu princes were patrons of architecture, metalwork and book arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akkoyunlu"@en .

aat:300134098 a skos:Concept ;
    skos:definition "Refers to the Neolithic style and culture that was located in the Almerian lowlands of Spain, and named after the site at Los Millares, Andalucia. It is characterized by settlements placed within fortified walls, often on a promontory overlooking a river, burials in stone tombs, often with corbelled roofs, and possibly items, such as ostrich eggs, imported from Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Almerian"@en .

aat:300134101 a skos:Concept ;
    skos:definition "Refers to an abstract style of Euopean painting circa 1912 inspired by Cubism but demonstrating a greater interest in color and lyricism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orphist"@en .

aat:300134119 a skos:Concept ;
    skos:definition "Refers to the period in Mesoamerica from around 1200 CE to 1521 CE most associated with the ascendance of the Aztec empire. In pottery and ceramics, the period features polychrome vessels from the Cholula and Mixtec regions and animal effigy vessels decorated with emblems rather than narrative scenes. Sculptural styles of the period reveal near life-size, standing figures with softly modeled features and carved surface patterns indicating costumes, body paint or tattoos. Lapidary artistic innovations expand in the period, featuring jade, pearls, tecali vessels, footed rock-crystal cups, crystal and obsidian earspools, and turquoise jet, coral and amber ornaments in ritual ceremonies. Prominent use of hardstone carvings include ceremonial vessels ornamented by low relief and sculptures of humans, deities, animals, and plant forms comprised of jadeite and other greenstones, diorite, chalcedony and rock crystal. The Aztec also popularized turquoise mosaics and feather headdresses in this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Postclassic"@en .

aat:300134121 a skos:Concept ;
    skos:definition "Refers to the cultures of the continent of North America, which is bounded by the Atlantic Ocean, the Pacific Ocean, the Arctic Circle, and Central America. In classifications schemes based on physical geography, Central America, and North America are parts of the same continent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North American"@en .

aat:300134127 a skos:Concept ;
    skos:definition "Refers to the period that coincided with the rule of Koryo Dynasty in Korea, from 918-1391 CE. The dynasty's close ties with China during the Sung period (908-1279 CE, resulted in direct influences from Chinese culture. Most artifacts that have remained from this period include bronze temple bells, Buddhist sutras copied by monks in gold and silver on purple paper, and wood block engravings. The period is also known for its major acheivement in porcelain with a celeadon glaze, found buried along with the dead in tombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koryŏ"@en .

aat:300134131 a skos:Concept ;
    skos:definition "Refers to the style and period surrounding the kingdom of Malayu in Sumatra around the 14th century. The style is characterized by sculpture featuring Bhairava and other deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malayu"@en .

aat:300134134 a skos:Concept ;
    skos:definition "Art that presents a visual form with no specific reference to anything outside itself, in contrast to art that depicts subjects found in nature or elsewhere in the real world. To refer to the particular style of contemporary art displaying some of these characteristics, use \"Nonobjective.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonrepresentational art"@en .

aat:300134147 a skos:Concept ;
    skos:definition "Refers to the period in Egypt comprising the Nineteenth and Twentieth Dynasties from about 1292 to 1075 BCE. The period, named after the first king of the Nineteenth Dynasty, Ramses I, is characterized by a return to more traditional styles and subject matter after the end of the Amarna period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ramesside period"@en .

aat:300134149 a skos:Concept ;
    skos:definition "Refers specifically to Abstract art in which the forms have had no beginning or reference to nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nonobjective"@en .

aat:300134178 a skos:Concept ;
    skos:definition "Nonmotorized wheeled vehicles intended to be towed by a passenger automobile or small truck to provide a place to sleep while traveling, in some jurisdictions having dimensions designated by law as not exceeding 8 feet wide and 32 feet long."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel trailers"@en .

aat:300134334 a skos:Concept ;
    skos:definition "Use with regard to specialized procedures related to how a photograph is taken or composed, or is manipulated during or after processing. Use \"photographic processes\" for the procedures by which light-sensitive materials are made to produce an image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic techniques"@en .

aat:300134468 a skos:Concept ;
    skos:definition "Photographs taken of celestial bodies or astronomical phenomena. For photographs taken from beyond the earth's atmosphere, use \"space photographs.\" For photographs of the earth taken from aircraft, use \"aerial photographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrophotographs"@en .

aat:300134485 a skos:Concept ;
    skos:definition "Commercial card photographs whose mounts measure about 3 3/8 by 2 inches; primarily used for portraits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boudoir midget mounts"@en .

aat:300134506 a skos:Concept ;
    skos:definition "Refers to techniques used to record images of subjects located outside the atmosphere of the Earth and certain phenomena associated with the ionosphere, such as aurorae and meteor showers. For photography taken from beyond the Earth's atmosphere, use \"space photography.\" For photography of the Earth from aircraft in the Earth's atmosphere, use \"aerial photography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical photography"@en .

aat:300134512 a skos:Concept ;
    skos:definition "Buildings occupied by a club or commonly used for club activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clubhouses"@en .

aat:300134522 a skos:Concept ;
    skos:definition "Any built structure used as a lookout station that affords observation of a surrounding area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watchtowers"@en .

aat:300134547 a skos:Concept ;
    skos:definition "An approach to photography in which the subject is recorded with an emphasis on factual accuracy and with a high degree of objectivity by the photographer; often of a newsworthy event. May be intended to record, and ultimately influence, social conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary photography"@en .

aat:300134550 a skos:Concept ;
    skos:definition "A subtractive color reversal process using a film with an integral tripack, each layer containing dyes appropriate to the color sensitivity of the layer. The image is formed by the chromogenic process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ektachrome (TM)"@en .

aat:300134553 a skos:Concept ;
    skos:definition "Refers to the darkroom procedure in which a photographic image is magnified by being projected through an optical system; generally used for making prints from small negatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enlarging"@en .

aat:300134560 a skos:Concept ;
    skos:definition "A process to record the surface conduction characteristics of an object or material by placing it on photographic film, which is then exposed by the blue and ultraviolet light of a corona generated by a high-voltage, high-frequency power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kirlian photography"@en .

aat:300134568 a skos:Concept ;
    skos:definition "The technique and the activity of producing photographs in which the subject is the same size or larger than the original object, but not so magnified as with images taken with the aid of a microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macrophotography"@en .

aat:300134570 a skos:Concept ;
    skos:definition "The techniques or the activity of making psychic photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychic photography"@en .

aat:300134607 a skos:Concept ;
    skos:definition "The techniques or the activity of making spirit photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit photography"@en .

aat:300134613 a skos:Concept ;
    skos:definition "Use with regard to a photography style of the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Straight"@en .

aat:300134616 a skos:Concept ;
    skos:definition "Swinging couches or beds usually made of netting or canvas and slung by cords from supports at each end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammocks"@en .

aat:300134674 a skos:Concept ;
    skos:definition "Negatives produced by the wet collodion process.The glass plates remain wet with silver iodide droplets during exposure to light. These negatives are created by pouring collodion onto a clean piece of clear glass to produce an even coating. Before the ether and alcohol evaporates from the collodion, the plate is dipped into a solution of silver nitrate in a darkroom. The silver nitrate bonds with the potassium iodide in the collodion to produce light-sensitive silver iodide. After exposure the plates are developed in a solution of pyrogallic and acetic acids, washed, fixed, dried and varnished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet collodion negatives"@en .

aat:300134677 a skos:Concept ;
    skos:definition "Photographic prints made by the palladium process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palladium prints"@en .

aat:300134686 a skos:Concept ;
    skos:definition "A stereoscopic print or transparency in which a three-dimensional illusion is achieved through the use of alternating strips of images taken with a stereographic camera. The array of strips is covered by a grating that allows the right and left eye of the viewer the see only corresponding right or left image fragments, which creates the perceptual illusion of three dimensions. A stereoscopic print or transparency in which a three-dimensional illusion is achieved through the use of alternating strips of images taken with a stereographic camera. The array of strips is covered by a grating that allows the right and left eye of the viewer the see only corresponding right or left image fragments, which creates the perceptual illusion of three dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallax stereograms"@en .

aat:300134691 a skos:Concept ;
    skos:definition "Collodion positives transferred from the glass plate to another support, usually paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collodion transfers"@en .

aat:300134693 a skos:Concept ;
    skos:definition "Photographs of an individual person, printed in the specific size required for inclusion into a passport. Often these are taken with cameras built for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passport photographs"@en .

aat:300134695 a skos:Concept ;
    skos:definition "Photographs in which the image is near life-size or larger. Distinct from the term \"enlargements,\" which only indicates that a photograph has been produced from a smaller photograph. For photographs taken through a microscope use \"photomicrographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macrophotographs"@en .

aat:300134696 a skos:Concept ;
    skos:definition "Photographic prints having collodion as the binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collodion prints"@en .

aat:300134699 a skos:Concept ;
    skos:definition "Refers to combinations of photographic images, or photographic with other images, such as architectural drawings, usually arranged into a somewhat unified image. For photographs produced by printing two or more negatives as one unified image, use \"composite photographs.\" When pieces of photographs or other relatively flat materials are pasted together into less unified images, use \"collages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomontages"@en .

aat:300134705 a skos:Concept ;
    skos:definition "An assemblage of photographic prints pieced together to form a continuous panorama or aerial view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomosaics"@en .

aat:300134708 a skos:Concept ;
    skos:definition "Large photographic prints used as wall decorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomurals"@en .

aat:300134722 a skos:Concept ;
    skos:definition "Images produced by a radiation other than light, especially x-rays or gamma rays. Originally these were made on plates that were chemically developed, but the advent of digital technology has replaced these with digital detectors, the images captured are then stored electronically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiographs"@en .

aat:300134733 a skos:Concept ;
    skos:definition "Photographs that record movement or change in a series of images, regardless of the amount of time intervening. For a series of images capturing an action, as of a human figure or animal, use \"motion photographs.\" If photographs are arranged to be seen in a specified order, use \"sequences.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronophotographs"@en .

aat:300134745 a skos:Concept ;
    skos:definition "Photographs made with simple cameras without artistic pretensions or commercial considerations; beginning especially in 1888 with the appearance of the first roll film box camera. Snapshots thus are often recognizable in that they were processed not by the photographer but by a commercial concern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snapshots"@en .

aat:300134750 a skos:Concept ;
    skos:definition "Refers to the activity of taking of photographs from beyond the Earth's atmosphere. For photography specifically of celestial bodies or astronomical phenomena, use \"astronomical photography.\" For photography of the Earth from aircraft within the Earth's atmosphere, use \"aerial photography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space photography"@en .

aat:300134753 a skos:Concept ;
    skos:definition "Photographs that purport to be visual records of ectoplasmic or other manifestations of persons in a state of existence equivalent to or beyond death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit photographs"@en .

aat:300134759 a skos:Concept ;
    skos:definition "Photographs produced by the wet collodion process directly on lacquered metal, usually iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tintypes"@en .

aat:300134762 a skos:Concept ;
    skos:definition "Stereoscopic photographs on tissue paper mounted between sheets of glass or in a cardboard frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tissue stereographs"@en .

aat:300134769 a skos:Concept ;
    skos:definition "Photographic prints in which two or more negatives are printed as one unified image. For combinations of images, such as photographs with architectural drawings, use \"photomontages.\" When pieces of photographs or other relatively flat materials are pasted together into less unified images, use \"collages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite photographs"@en .

aat:300134775 a skos:Concept ;
    skos:definition "Three-dimensional images formed by exposing a negative image with monochromatic radiation from a laser while it is positioned in a second laser beam. The direct beam and the image scattered beam combine to form an interference pattern that is viewed as a three-dimensional image. The technique for making holograms was invented in 1947 by Dennis Gabor of Hungary, but was not widely used until after the laser was invented in 1960. Salvador Dali used holography to make works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holograms"@en .

aat:300134781 a skos:Concept ;
    skos:definition "Holograms made when both the object and reference beams strike the emulsion side of the image-recording plate. These are viewed by observing laser light transmitted through the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmission holograms"@en .

aat:300134783 a skos:Concept ;
    skos:definition "Holograms lit from the front, reflecting light toward the viewer, often imitating the effect of a painting or photograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflection holograms"@en .

aat:300134789 a skos:Concept ;
    skos:definition "Photographs converted to electrical signals, transmitted over wires, and then reformed into images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire photographs"@en .

aat:300134802 a skos:Concept ;
    skos:definition "Large folding screens to provide protection against drafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paravents"@en .

aat:300134811 a skos:Concept ;
    skos:definition "Blue-toned photographic prints produced by the blueprint process, not including reproductive prints of architectural or other technical drawings; for these, use \"blueprints\" or \"blueline prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyanotypes"@en .

aat:300134826 a skos:Concept ;
    skos:definition "Tripod, often tilt-top, circular tables whose top has a scalloped, molded rim resembling the edges of a pie."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piecrust tables"@en .

aat:300134877 a skos:Concept ;
    skos:definition "Photographic prints made by the diffusion transfer process from film packets that contain their own developing chemicals and are exposed in a special camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffusion transfer prints"@en .

aat:300134881 a skos:Concept ;
    skos:definition "Color instant camera photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dye diffusion transfer prints"@en .

aat:300134898 a skos:Concept ;
    skos:definition "Copies of images or objects on a larger scale, particularly enlarged prints with an image that has been optically magnified from an original, smaller negative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enlargements"@en .

aat:300134920 a skos:Concept ;
    skos:definition "Negatives that have a gelatin layer as a binder on a glass support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin dry plate negatives"@en .

aat:300134941 a skos:Concept ;
    skos:definition "Small tintypes, sometimes mounted in jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gem photographs"@en .

aat:300134949 a skos:Concept ;
    skos:definition "Photographic prints made by the gum bichromate process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gum bichromate prints"@en .

aat:300134956 a skos:Concept ;
    skos:definition "Negatives exposed through a line screen so that the image appears as a pattern of dots or squares of varying sizes. Used to make halftone photomechanical prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halftone negatives"@en .

aat:300134966 a skos:Concept ;
    skos:definition "Early photographs (beginning about 1860) that did not need long exposure times, thus being able to capture figures in motion; often showing city street scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instantaneous photographs"@en .

aat:300134972 a skos:Concept ;
    skos:definition "Photographic prints made to resemble miniature paintings on ivory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivorytypes"@en .

aat:300134977 a skos:Concept ;
    skos:definition "Transparent positive images made or mounted on glass for projection, usually but not necessarily photographic, measuring 3 1/4 to 3 1/2 by 4 inches for projection onto a screen by means of a specialized projector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lantern slides"@en .

aat:300134989 a skos:Concept ;
    skos:definition "Describes photographs that capture current events, human interest, or cultural or social issues that are timely or of immediate interest, and which are intended to be published in the context of a news periodical in any format. These are distinguished from documentary photographs, which represent general themes of ongoing human or natural activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "news photographs"@en .

aat:300134995 a skos:Concept ;
    skos:definition "Photographs showing successive phases of an action, usually a human figure or animal in motion; may be single exposure, composite, or a series of separate images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion photographs"@en .

aat:300134997 a skos:Concept ;
    skos:definition "Single photographic images taken from a motion picture film, resulting in still photographs of the action, actors, or production of a motion picture. For prints produced from a frame of motion picture film, use \"frame enlargements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film stills"@en .

aat:300135005 a skos:Concept ;
    skos:definition "Tone reversal in photographs caused by massive overexposure of the photographic emulsion to light. True solarization rarely occurs in modern emulsions, and is most commonly seen in early daguerreotypes. For the similar effect that occurs with exposure of negatives or emulsions to bright light during development, rather than at the moment of camera exposure, as was used by the Surrealists, use \"Sabattier effect.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solarization"@en .

aat:300135014 a skos:Concept ;
    skos:definition "The partial change from negative to positive of black-and-white or color images on a plate or film caused by exposure to strong light during the development process. Examples of such positives were exhibited in France by Armand Sabattier (1834-1910) as early as 1860, but most such images produced during the 19th century were simply the results of faulty processing. From the 20th century, artists used a range of techniques for producing such reversed images by exposing negatives or prints to calculated amounts of light during developing and printing. Man Ray and Lee Miller were the first photographers to employ these techniques for artistic effect. For the similar effect caused by overexposure at the time of camera exposure rather than during development, use \"solarization (photography).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sabattier effect"@en .

aat:300135016 a skos:Concept ;
    skos:definition "Photographic processing designed to preserve a print or negative for as long as possible by protecting it against deterioration due to chemical reactions. For activities involving the arrangement and description of archival materials use \"processing\" plus terms for the form of material being processed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival processing"@en .

aat:300135024 a skos:Concept ;
    skos:definition "Infrastructural elements of structures that are built to support the transport of goods and people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation elements"@en .

aat:300135036 a skos:Concept ;
    skos:definition "The process of inserting a single leaf, errata slip, or illustration into a book with a narrow edge of paste that binds it to the following page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tipping in"@en .

aat:300135321 a skos:Concept ;
    skos:definition "Term generally applied to small, portable tables designed to hold food or drink for one person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snack tables"@en .

aat:300135329 a skos:Concept ;
    skos:definition "Relatively small, covered containers for dry tea used on a tea table or other surface, in conjunction with a teapot and a kettle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea caddies"@en .

aat:300135332 a skos:Concept ;
    skos:definition "Refers to very tall stands, generally carved and gilt, intended to hold candelabras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torchères"@en .

aat:300135342 a skos:Concept ;
    skos:definition "Turned legs that resemble a trumpet standing on end; characteristic of William and Mary period furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trumpet legs"@en .

aat:300135375 a skos:Concept ;
    skos:definition "Books in which are recorded the minutes of a collective body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minute books"@en .

aat:300135410 a skos:Concept ;
    skos:definition "Construction employing a horizontally projecting member unsupported at one end. Cantilevers are employed extensively in building construction and in machines. In building, any beam built into a wall and with the free end projecting forms a cantilever. Longer cantilevers are incorporated in a building when clear space is required below, with the cantilevers carrying a gallery, roof, canopy, runway for an overhead travelling crane, or part of a building above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantilever construction"@en .

aat:300135455 a skos:Concept ;
    skos:definition "A photographic plate size, about 8 1/2 by 13 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double whole plate"@en .

aat:300135462 a skos:Concept ;
    skos:definition "A photographic plate size, usually 6 1/2 by 4 3/4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half plate"@en .

aat:300135469 a skos:Concept ;
    skos:definition "A photographic plate size, usually 18 by 21 inches, but may vary from 15 by 18 inches to 22 by 25 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mammoth plate"@en .

aat:300135472 a skos:Concept ;
    skos:definition "A photographic plate size, about 2 by 2 1/2 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ninth plate"@en .

aat:300135476 a skos:Concept ;
    skos:definition "A photographic plate size, about 3 1/4 by 4 1/4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter plate"@en .

aat:300135481 a skos:Concept ;
    skos:definition "A photographic plate size, about 1 3/8 by 1 5/8 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixteenth plate"@en .

aat:300135485 a skos:Concept ;
    skos:definition "A photograhic plate size, usually 2 3/4 by 3 1/4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixth plate"@en .

aat:300135491 a skos:Concept ;
    skos:definition "A photographic plate size, standard for daguerreotypes, 8 1/2 by 6 1/2 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whole plate"@en .

aat:300135620 a skos:Concept ;
    skos:definition "Devices for controlling the temperature, humidity, and sometimes the purity of the air in an interior space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air conditioners"@en .

aat:300135758 a skos:Concept ;
    skos:definition "A process employed in the darkroom to darken a portion of a print, by means of additional exposure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning in"@en .

aat:300135798 a skos:Concept ;
    skos:definition "Photography of fashionable apparel and accessories, especially for advertisement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion photography"@en .

aat:300135979 a skos:Concept ;
    skos:definition "In recent architectural theory, the consideration of loads and stresses in architectural designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tectonics"@en .

aat:300135982 a skos:Concept ;
    skos:definition "Divisions under the jurisdiction of a nation, not vested with the full authority of provinces or states, but having some degree of local governing and legislative power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "territories"@en .

aat:300135990 a skos:Concept ;
    skos:definition "Describes buildings surrounded by two rows of columns on all sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dipteral"@en .

aat:300135991 a skos:Concept ;
    skos:definition "Describes buildings surrounded by a single row of columns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peripteral"@en .

aat:300135992 a skos:Concept ;
    skos:definition "Describes buildings planned as dipteral but with the inner row of columns omitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudodipteral"@en .

aat:300135994 a skos:Concept ;
    skos:definition "Describes buildings having engaged columns or pilasters along the sides and rear and freestanding columns along the front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudoperipteral"@en .

aat:300136014 a skos:Concept ;
    skos:definition "Describes individually discrete things raised in relative position to other places or things, especially above the ground or other surface. For the form attribute describing something protruding above a surface to which it is attached or is a part, use \"raised\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elevated"@en .

aat:300136020 a skos:Concept ;
    skos:definition "Boards shaped to a tapered edge set into a frame and with a raised center section, field, or panel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fielded panels"@en .

aat:300136023 a skos:Concept ;
    skos:definition "Construction toys that are architectural or architectonic in form or purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural toys"@en .

aat:300136024 a skos:Concept ;
    skos:definition "Flat boards or boardlike game accessories marked such that the progress of play can be tracked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gameboards"@en .

aat:300136025 a skos:Concept ;
    skos:definition "Miniature scale houses or sets of rooms of various types, designed to display miniature furniture and furnishings, usually to be used in conjunction with like-sized dolls. Typically illustrate domestic interiors and activities. May be used as collectibles or childrens' toys; known since the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollhouses"@en .

aat:300136031 a skos:Concept ;
    skos:definition "Chests of drawers with a secretary drawer at the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butlers' desks"@en .

aat:300136325 a skos:Concept ;
    skos:definition "Designates vertical enclosures in buildings containing a stairway and having a fire endurance rating high enough to qualify as fire escapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire towers"@en .

aat:300136375 a skos:Concept ;
    skos:definition "Persons whose occupations are the handling, working, or navigating of ships or other large watercraft at sea or other large bodies of water, such as very large lakes. For those occupied or skilled in the handling of small watercraft, typically on smaller bodies of water than seas or very large lakes, use \"boatmen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seamen"@en .

aat:300136377 a skos:Concept ;
    skos:definition "Masters or commanders of nonmilitary ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipmasters"@en .

aat:300136379 a skos:Concept ;
    skos:definition "Desks or chests with a recessed center front which is usually flanked on each side by a set of drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kneehole desks"@en .

aat:300136380 a skos:Concept ;
    skos:definition "Persons who promote a political philosophy that rejects all state authority and compulsory government as both unnecessary and harmful."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anarchists"@en .

aat:300136385 a skos:Concept ;
    skos:definition "Persons who specialize in cooking by dry heat acting by conduction, and not by radiation, hence either in a closed space such as an oven, or on a heated surface. Their typical products include breads, cakes, cookies, and pastries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bakers"@en .

aat:300136387 a skos:Concept ;
    skos:definition "People who belong to the cabinet, comprising the confidential advisors and policy-makers of the head of state of a country, and who usually head government departments, as in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet officers"@en .

aat:300136390 a skos:Concept ;
    skos:definition "Synagogue officials who sing or chant liturgical music and lead the congregation in prayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantors"@en .

aat:300136401 a skos:Concept ;
    skos:definition "Persons who train others, either for athletic contests or for intellectual examinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaches"@en .

aat:300136405 a skos:Concept ;
    skos:definition "Limited function wholesalers who take custody of but not legal ownership of the goods handled as part of a business transaction. They are paid either directly by the owner or by a share of the sale proceeds. Distinct from \"brokers\" in that they take the actual physical possession of the goods while brokers do not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commission merchants"@en .

aat:300136406 a skos:Concept ;
    skos:definition "Public officers responsible for keeping the public peace and for certain petty judicial duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constables"@en .

aat:300136436 a skos:Concept ;
    skos:definition "Biologists trained or working in the field dealing with life forms that live in the sea and on shore and the features of their environment that affect them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine biologists"@en .

aat:300136437 a skos:Concept ;
    skos:definition "Zoologists who specialize in the scientific study of fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ichthyologists"@en .

aat:300136440 a skos:Concept ;
    skos:definition "Reporters for law reports and journals, who write summaries of the decisions of a court of record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law reporters"@en .

aat:300136442 a skos:Concept ;
    skos:definition "State officers next in rank to a governor, who take the governor's place in case of the latter's absence, disability, or death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lieutenant governors"@en .

aat:300136443 a skos:Concept ;
    skos:definition "Those engaged in the methodical breeding of cattle, for sale, farming or scientific purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livestock breeders"@en .

aat:300136445 a skos:Concept ;
    skos:definition "Refers to legislators of the United States who are elected to one of the two Houses of Congress as representatives of one of the states or of defined districts within a state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "members of Congress"@en .

aat:300136450 a skos:Concept ;
    skos:definition "Those employed to investigate criminal or other concealed activities by scientific method. Usually refers to members of a police force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detectives"@en .

aat:300136451 a skos:Concept ;
    skos:definition "Persons who study the human diet and make recommendations for its regulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dietitians"@en .

aat:300136452 a skos:Concept ;
    skos:definition "Servants or attendants who work in the household, often living in the same house as the family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domestics"@en .

aat:300136453 a skos:Concept ;
    skos:definition "Painters who paint the surfaces of industrial facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial painters"@en .

aat:300136455 a skos:Concept ;
    skos:definition "Public officials who enforce the game laws of a jurisdiction. For those privately employed, as on estates or game preserves, to provide an environment for game, prevent poaching, and assist the employers or other authorized persons in hunting, use \"gamekeepers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "game wardens"@en .

aat:300136457 a skos:Concept ;
    skos:definition "Those engaged in the breeding of horses for show, farming, sport, or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse breeders"@en .

aat:300136462 a skos:Concept ;
    skos:definition "Those who lecture or give formal discourses designed to instruct, usually in a college or university, but may be extended to professional people who give lectures for hire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lecturers"@en .

aat:300136464 a skos:Concept ;
    skos:definition "Persons who believe in pacifism or are opposed to war or violence of any kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pacifists"@en .

aat:300136466 a skos:Concept ;
    skos:definition "Those who advocate feminism, or the study of ideas related to women or female gender issues in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feminists"@en .

aat:300136468 a skos:Concept ;
    skos:definition "People who prepare the dead for burial. For people who arrange the funeral, use \"funeral directors.\" In small communities or former times, the arrangement of the funeral was also often done by the undertaker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undertakers"@en .

aat:300136471 a skos:Concept ;
    skos:definition "Persons who make or sell wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vintners"@en .

aat:300136474 a skos:Concept ;
    skos:definition "Persons who own or sail a yacht or are enthusiasts of yachting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yachtsmen"@en .

aat:300136476 a skos:Concept ;
    skos:definition "Married women who manage their own households, especially as their principal occupation. The more commonly accepted term for people of either sex performing this duty is the broader term \"homemakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housewives"@en .

aat:300136483 a skos:Concept ;
    skos:definition "Scientists who specialize in studying the physical and biological properties and phenomena of the oceans and seas, including their exploration, preservation, use, and interactions with air, dry land, and all life forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oceanographers"@en .

aat:300136486 a skos:Concept ;
    skos:definition "Officials in charge of post offices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postmasters"@en .

aat:300136491 a skos:Concept ;
    skos:definition "Public officials who institute legal proceedings against someone, particularly in a legal case against a defendant in a criminal court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public prosecutors"@en .

aat:300136495 a skos:Concept ;
    skos:definition "In the United States, refers to the chief law enforcement officers of a county or other subdivision of a state. Formerly, in England, referred to important civil officers in a shire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheriffs"@en .

aat:300136496 a skos:Concept ;
    skos:definition "Those who advocate the extension or granting of political suffrage to those lacking it, either universally or to specific groups within the population."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suffragists"@en .

aat:300136497 a skos:Concept ;
    skos:definition "Public officers charged with the duty of collecting taxes legally due to the government of the political administrative body they serve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tax collectors"@en .

aat:300136498 a skos:Concept ;
    skos:definition "Women advocates of female suffrage, primarily in Great Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suffragettes"@en .

aat:300136499 a skos:Concept ;
    skos:definition "Originally, a supporter of the international movement for the establishment of a Jewish nation in Palestine, and later for the State of Israel itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zionists"@en .

aat:300136571 a skos:Concept ;
    skos:definition "Photographic prints in which the tones or colors are reversed from their appearance in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negative prints"@en .

aat:300136578 a skos:Concept ;
    skos:definition "Photographic prints made by the original photographer or soon after the picture was taken, that is, of the same historical vintage as the original. For prints made much later from the same negative, use \"later prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vintage prints"@en .

aat:300136596 a skos:Concept ;
    skos:definition "Tall case pieces generally having seven or more drawers divided by a cornice into two sections with the lower section supported on raised legs. For the equivalent American pieces, use \"high chests of drawers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tallboys"@en .

aat:300136630 a skos:Concept ;
    skos:definition "Small racks with partitions intended to hold sheet music, books, or loose papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canterburies"@en .

aat:300136635 a skos:Concept ;
    skos:definition "18th-century term for English stands in the form of a deep partitioned tray on legs intended to be placed near a table to hold plates and cutlery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canterburies"@en .

aat:300136637 a skos:Concept ;
    skos:definition "Kneehole writing or dressing tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureau tables"@en .

aat:300136668 a skos:Concept ;
    skos:definition "Lists of additions to the holdings of a collection, usually in chronological order by date of receipt and giving the titles of the accessions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessions registers"@en .

aat:300136681 a skos:Concept ;
    skos:definition "Records of goods or cargo shipped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipping records"@en .

aat:300136683 a skos:Concept ;
    skos:definition "Lists of persons traveling on a ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships' passenger lists"@en .

aat:300136687 a skos:Concept ;
    skos:definition "Elevations that show the vertical elements of ships, either exterior or interior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship elevations"@en .

aat:300136689 a skos:Concept ;
    skos:definition "Series or lists of rates of duties imposed by a government on imported or exported goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tariff schedules"@en .

aat:300136713 a skos:Concept ;
    skos:definition "People who disagree with or take an opposing view to established, orthodox, or majority values or opinions, especially those of a church or political party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissenters"@en .

aat:300136719 a skos:Concept ;
    skos:definition "Those whose primary work is to repair or refinish shoes, boots, and other footwear, and other items such as handbags, luggage, and belts made from the materials commonly used in shoemaking and repair, such as leather, canvas, and plastic. For those who make and sometimes also design footwear as well as repair it, see \"shoemakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobblers"@en .

aat:300136723 a skos:Concept ;
    skos:definition "Reworking small areas of a painting or photographic negative usually to cover damage or to mask unwanted features. For similar work done on paintings by conservators, use \"inpainting\" or \"overpainting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retouching"@en .

aat:300136729 a skos:Concept ;
    skos:definition "Brass containing iron and manganese which, because of its hardness and crystalline structure, is named as a bronze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese bronze"@en .

aat:300136730 a skos:Concept ;
    skos:definition "Copper-nickel-zinc alloy, typically 20% zinc, 18% nickel, and the balance copper, used as a base metal for plated silverware, for springs and contacts in electrical equipment, and for corrosion-resistant objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German silver"@en .

aat:300136731 a skos:Concept ;
    skos:definition "A thermosetting plastic made of a cast phenol-formaldehyde resin and having high compressive strength and ready machinability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalin"@en .

aat:300136732 a skos:Concept ;
    skos:definition "Bronze of very high copper content, formulated for color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural bronze"@en .

aat:300136735 a skos:Concept ;
    skos:definition "Refers to distinctive glass made in Venice, Italy. It can refer to early glass made from about 450 CE when glass-makers from Aquileia fled there and were soon joined by others from Byzantium. In addition, the term is particularly used to refer to glass made on the Venetian island of Murano from before 1292 to the present day. It is generally a sodiac type of glass; soda glass is light in weight and highly ductile. Venetian glass incorporates a number of styles and techniques although Venetian glass-makers particularly excelled in the making of colored glass, agate glass, opaque white glass (lattimo), cristallo, filigrana, and millefiori. Engraving is rarely found while enameling and gilding are common, particularly in fifteenth- and sixteenth-century specimens. In order to protect their profits and the secrets of Venetian glass, the Venetians confined glassmakers under pain of death to the island of Murano; however, the techniques were eventually imitated in \"Altare glass\" and \"façon de Venise.\" For glass made exclusively on Murano, see \"Murano glass.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian glass"@en .

aat:300136737 a skos:Concept ;
    skos:definition "Rare and expensive wood figured with golden markings, from the species Dalbergia cearensis native to South America, mainly Brazil. The sapwood is white in color, with clearly defined variegated colored heartwood. It is varied from violet-brown to almost black, and streaked with violet brown, black, blackish-violet, or golden yellow. Because of the small size of the trees, its uses are restricted to decorative work, such as inlay and turnery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kingwood"@en .

aat:300136754 a skos:Concept ;
    skos:definition "People who appear often on television and are known to the public primarily through that medium. They include actors, announcers, hosts of shows, and religious leaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television personalities"@en .

aat:300136756 a skos:Concept ;
    skos:definition "Persons who circumcise male infants in accordance with Jewish ritual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mohels"@en .

aat:300136805 a skos:Concept ;
    skos:definition "Sheds or small barns constructed to house pigs. For large commercial facilities, use \"hog houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pig houses"@en .

aat:300136842 a skos:Concept ;
    skos:definition "Records, in law, having the legally recognized and judicially enforceable quality of establishing some fact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "official documents"@en .

aat:300136847 a skos:Concept ;
    skos:definition "General term for copies produced by photocopying, that is, in a machine employing a light-sensitive process, and usually at a one-to-one scale. In the early to mid-20th century, used regarding copies made by various specific processes; since the mid-20th century, most often refers to xerographic copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photocopies"@en .

aat:300136896 a skos:Concept ;
    skos:definition "The wood of evergreen shrubs or small trees of the genus Myrtus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "myrtle"@en .

aat:300136900 a skos:Concept ;
    skos:definition "Works presented in the form of a series of pictures carried on photographic film or video tape, presented to the eye in such rapid succession as to give the illusion of natural movement. For the study and practice of filmmaking and motion pictures as an art and form of expression, use \"film (performing arts).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion pictures"@en .

aat:300136907 a skos:Concept ;
    skos:definition "Family records of births, baptisms, marriages, and deaths written on blank or printed form-like pages of Bibles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bible records"@en .

aat:300136911 a skos:Concept ;
    skos:definition "Written agreements between masters and minors under which a minor agrees to work for a master for a stated period of time in return for instruction in a trade by a master."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "articles of apprenticeship"@en .

aat:300136915 a skos:Concept ;
    skos:definition "Soft reddish white wood from any of 15 species of the genus Corylus in the birch family. The wood is used generally for small objects such as handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filbert"@en .

aat:300136928 a skos:Concept ;
    skos:definition "Wood of the Himalayan tree Melia azedarach, widely grown as an ornamental and common in the southeastern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinaberry"@en .

aat:300136931 a skos:Concept ;
    skos:definition "A mineral of the mica group; it commonly occurs in rose- or lilac-colored masses made up of small scales, as in pegmatite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lepidolite"@en .

aat:300136936 a skos:Concept ;
    skos:definition "Foremen of gangs of laborers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gangers"@en .

aat:300136954 a skos:Concept ;
    skos:definition "Shape having a flattened curve between convex sections of similar flattened curves, particularly in reference to furniture pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blockfront"@en .

aat:300136959 a skos:Concept ;
    skos:definition "Having a rounded, outward bulging, or swelling curved form, particularly referring to furniture having sides and front of this form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombé"@en .

aat:300136962 a skos:Concept ;
    skos:definition "Records, usually public and in book form, showing the location, size, and owner's name for each plot of land in a stated area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plat books"@en .

aat:300136972 a skos:Concept ;
    skos:definition "Having a central section that projects in front of the side sections, especially used in reference to 18th-century bookcases or cabinets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breakfront"@en .

aat:300136975 a skos:Concept ;
    skos:definition "Having an arch in the middle, particularly with reference to desks and tables, where the arch is located over the space where the lap and knees of the seated person; also used with reference to other furniture, coach design, jewelry, architectural elements (such as porches and window design), and other works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular front"@en .

aat:300136977 a skos:Concept ;
    skos:definition "Having the shape of a semicircle or crescent, particularly as used with reference to furniture, battlements, and other works. Name refers to half-moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demi-lune"@en .

aat:300136979 a skos:Concept ;
    skos:definition "Having one convex and one concave curve, particularly with reference to furniture edges and sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-serpentine"@en .

aat:300136982 a skos:Concept ;
    skos:definition "A shape composed of two convex sections and a central concave section, for example with furniture pieces the fronts of which curve inward between outcurved ends and the center. Named for its resemblance to the bow-shaped piece of wood forming a collar for a yoked ox, with the upper ends fastened to the yoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxbow"@en .

aat:300136990 a skos:Concept ;
    skos:definition "Having a straight, uncurved and unbent front, particularly as used in reference to the fronts of case furniture, legs of furniture, and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight-front"@en .

aat:300137062 a skos:Concept ;
    skos:definition "Generally, constructing or composing a whole object or component by putting parts together; specifically refers to the construction of light forms of woodwork, including furniture constructed with dovetail or other joints, and features such as doors or staircases in buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joining"@en .

aat:300137129 a skos:Concept ;
    skos:definition "Lying, situated, or placed across; crossing from side to side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transverse"@en .

aat:300137140 a skos:Concept ;
    skos:definition "Workers occupied in preparing, transcribing, systematizing, and preserving written communications and records, distributing information, or collecting accounts, usually in an office environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clerical workers"@en .

aat:300137147 a skos:Concept ;
    skos:definition "Generally refers to those who perform clerical tasks such as correspondence and record keeping for another person, group, or corporate body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secretaries"@en .

aat:300137149 a skos:Concept ;
    skos:definition "Those who transcribe in shorthand, or who operate shorthand writing machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stenographers"@en .

aat:300137152 a skos:Concept ;
    skos:definition "Gouges of various designs used for woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking gouges"@en .

aat:300137161 a skos:Concept ;
    skos:definition "Special exemptions or provisions for businesses such as accelerated depreciation allowances, credits, and deductions, intended to encourage socially or economically desirable activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tax incentives"@en .

aat:300137165 a skos:Concept ;
    skos:definition "Architects designated to manage their firms' services related to given projects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "project architects"@en .

aat:300137181 a skos:Concept ;
    skos:definition "Lathes designed to work metal materials or objects. Metalworking lathes were introduced early in the Industrial Revolution, around 1800."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking lathes"@en .

aat:300137271 a skos:Concept ;
    skos:definition "Rasps of various designs for woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking rasps"@en .

aat:300137291 a skos:Concept ;
    skos:definition "Materials that are made to imitate different materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitative materials"@en .

aat:300137292 a skos:Concept ;
    skos:definition "Turkish hospices established for pilgrims and other travelers; in some contexts may also denote Turkish soup kitchens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imarets"@en .

aat:300137299 a skos:Concept ;
    skos:definition "Positive photographic transparencies used as an intermediate step in making copies of negatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interpositives"@en .

aat:300137305 a skos:Concept ;
    skos:definition "Color film formed of an integral, three-layer emulsion. For film with three separate emulsions bound in register, use \"tripack.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integral tripack"@en .

aat:300137308 a skos:Concept ;
    skos:definition "Color film formed from an integral, two-layer emulsion. For film with two separate emulsions bound together, use \"bipack.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integral bipack"@en .

aat:300137324 a skos:Concept ;
    skos:definition "A variant of the wet collodion process to produce a direct-positive camera original. The collodion is coated on glass, the image underexposed and then underdeveloped, the glass backed with black lacquer or black cloth, and the whole mounted in a case or frame. Occasionally, the image was made on ruby glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambrotype"@en .

aat:300137339 a skos:Concept ;
    skos:definition "Use broadly for the capture and transmission of information by detecting devices located at a distance from the receiving device and for the detection of information beyond the reach of normal human capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remote sensing"@en .

aat:300137340 a skos:Concept ;
    skos:definition "Locations where, usually very destructive, weapons are exploded distant from an observation point; also, where scientific field explorations or investigations are conducted, as in archaeology or geology. For complexes where weapons are tested under close scrutiny, use \"proving grounds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "test sites"@en .

aat:300137343 a skos:Concept ;
    skos:definition "Locations where nuclear devices are experimentally exploded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear test sites"@en .

aat:300137347 a skos:Concept ;
    skos:definition "Rooms or spaces in which bells are hung in a tower; for the entire tower structure, use \"bell towers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belfries"@en .

aat:300137375 a skos:Concept ;
    skos:definition "Those who sign documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signers"@en .

aat:300137376 a skos:Concept ;
    skos:definition "Medieval marine charts, used before compasses, and for Medieval navigation manuals, illustrated with charts and showing the location of ports and other navigational information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portolanos"@en .

aat:300137380 a skos:Concept ;
    skos:definition "Style and culture the African ethnic group of the same name living in northern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gonja"@en .

aat:300137400 a skos:Concept ;
    skos:definition "Photography of moving objects by repeated flashes or a pulsating light source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stroboscopic photography"@en .

aat:300137401 a skos:Concept ;
    skos:definition "Architects who guide, review, or approve the work of other architects, architectural design groups, or supervisory personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supervising architects"@en .

aat:300137408 a skos:Concept ;
    skos:definition "Branches of learning and professions related to psychology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychology-related disciplines"@en .

aat:300137409 a skos:Concept ;
    skos:definition "Branches of learning and professions related to history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history-related disciplines"@en .

aat:300137410 a skos:Concept ;
    skos:definition "Branches of learning and professions related to linguistics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linguistics-related disciplines"@en .

aat:300137425 a skos:Concept ;
    skos:definition "Culture and style of people in the Adamawa state of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ga'anda"@en .

aat:300137439 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the lagoon region of southeastern Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eotile"@en .

aat:300137451 a skos:Concept ;
    skos:definition "Style and culture of the Edo-speaking African people of the same name living in southern Nigeria, a subgroup of the Etsako."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Okpella"@en .

aat:300137461 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Sudan and Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toposa"@en .

aat:300137481 a skos:Concept ;
    skos:definition "Functions related to organizing or organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organizational functions"@en .

aat:300137483 a skos:Concept ;
    skos:definition "Ongoing activity of individuals receiving jobs and payment for their work. For the action of engaging the services of a person or persons for wages or other payment, use \"hiring.\" For the concept of the degree or extent of the provision or availability of paid work to the population, use \"employment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "employing"@en .

aat:300137495 a skos:Concept ;
    skos:definition "Providing direct material aid, most often monetary, to persons, groups, or enterprises, usually for the purpose of supporting or promoting the recipient."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subsidizing"@en .

aat:300137501 a skos:Concept ;
    skos:definition "General functions related to the administration of justice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judicial functions"@en .

aat:300137526 a skos:Concept ;
    skos:definition "Designates housing for people who are unable to purchase or rent homes through normal marketplace mechanisms; includes such options as low cost housing, low income housing, shelters for the homeless, or mobile homes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "affordable housing"@en .

aat:300137527 a skos:Concept ;
    skos:definition "Denotes semi-underground buildings forming self-contained structures without a built floor, common to England and northern Europe throughout the first millennium CE and used variously for such functions as houses, storehouses, and workshops; use \"pit dwellings\" for prehistoric houses whose floors are generally deeply set below ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunken huts"@en .

aat:300137540 a skos:Concept ;
    skos:definition "Refers in the aggregate to military, naval and air forces of any nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armed forces"@en .

aat:300137542 a skos:Concept ;
    skos:definition "Refers to large organized land forces armed for war and regimented in some manner for deployment. Applied both to independent organizations or to groups under the control of one nation or ruler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armies"@en .

aat:300137544 a skos:Concept ;
    skos:definition "Refers generally to the body of warships under the control of a ruler, state, or nation. Modern usage aggregates a regularly organized seagoing force including ships, personnel, and equipment. Modern navies may comprise a variety of attack, supply, and repair vessels, naval bases and ports, and large administrative and maintenance organizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navies"@en .

aat:300137545 a skos:Concept ;
    skos:definition "Refers generally to large bodies of military aircraft under the control of a ruler, state, or nation that is responsible for the conduct of air warfare. The term is extended to administrative and maintenance personnel in support of this force. Functions of air forces include control of airspace and support of land or seagoing military forces. Modern air forces of major nations have incorporated intercontinental ballistic missiles, long-range bombers, and aircraft both manned and un-manned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air forces"@en .

aat:300137546 a skos:Concept ;
    skos:definition "Examining the particulars in an attempt to learn the facts about something hidden, unique, or complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "investigation"@en .

aat:300137548 a skos:Concept ;
    skos:definition "Observing and collecting information about something over time or distance for some specific purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monitoring"@en .

aat:300137552 a skos:Concept ;
    skos:definition "Generally, giving an account. In the context of journalism, gathering and writing, or narrating by phone or broadcast, news events for newspapers, radio, or television."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reporting"@en .

aat:300137556 a skos:Concept ;
    skos:definition "Attempting to reach an agreement through discussion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negotiation"@en .

aat:300137559 a skos:Concept ;
    skos:definition "Authorizing entrance as in admission to an institution or program."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "admitting"@en .

aat:300137561 a skos:Concept ;
    skos:definition "Altering, deleting, or banning completely a report, document, art work, or any item bearing a message, information, or image that the censoring body wants to suppress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "censoring"@en .

aat:300137562 a skos:Concept ;
    skos:definition "Paying out money or provisions, especially from a public fund."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disbursement"@en .

aat:300137564 a skos:Concept ;
    skos:definition "Diverting or amusing someone; causing someone's time to pass agreeably."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entertaining"@en .

aat:300137566 a skos:Concept ;
    skos:definition "Function involving the showing or presenting works or other things to public view. For events at which works are exhibited, prefer \"exhibitions (events).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibiting"@en .

aat:300137570 a skos:Concept ;
    skos:definition "Recognizing or establishing someone or something as being a particular person or thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identification"@en .

aat:300137572 a skos:Concept ;
    skos:definition "The action or function of putting a person in a jail, prison, or other place of confinement, usually, but not always, according to legal procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imprisonment"@en .

aat:300137577 a skos:Concept ;
    skos:definition "Assuring against a loss by a contingent event on certain stipulated conditions or at a given rate or premium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insuring"@en .

aat:300137584 a skos:Concept ;
    skos:definition "Making available or supplying commodities or services, such as water or electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "providing"@en .

aat:300137587 a skos:Concept ;
    skos:definition "Discharging people from an institution, enterprise, or obligation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "releasing"@en .

aat:300137590 a skos:Concept ;
    skos:definition "Providing direct economic or financial aid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assistance"@en .

aat:300137593 a skos:Concept ;
    skos:definition "Identifying the condition of a person, object, or structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagnosis"@en .

aat:300137595 a skos:Concept ;
    skos:definition "Sending out or apportioning something from a central source to a group, community, or individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distribution"@en .

aat:300137599 a skos:Concept ;
    skos:definition "Ensuring compliance with laws or regulations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enforcing"@en .

aat:300137606 a skos:Concept ;
    skos:definition "Meetings or sessions in which testimony, evidence, or arguments are presented in a formal setting, usually before an official."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearings"@en .

aat:300137609 a skos:Concept ;
    skos:definition "Making or enacting legislation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legislating"@en .

aat:300137612 a skos:Concept ;
    skos:definition "Officially allowing a conditional release from prison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paroling"@en .

aat:300137616 a skos:Concept ;
    skos:definition "Acquisition of goods or services through purchase, lease, hiring, or trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "procurement"@en .

aat:300137619 a skos:Concept ;
    skos:definition "Disseminating information to the public about some product, company, institution, individual, cause, or project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publicizing"@en .

aat:300137621 a skos:Concept ;
    skos:definition "Providing patients with medical care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treating"@en .

aat:300137642 a skos:Concept ;
    skos:definition "Housing developed or maintained by government for individuals and families that earn less than a specified maximum income."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moderate income housing"@en .

aat:300137644 a skos:Concept ;
    skos:definition "Houses, common during the prehistoric periods of many cultures, whose floors are dug out deeply below the adjacent ground level. Use \"sunken huts\" for multipurpose buildings of the first millennium CE, found in England and throughout northern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pit dwellings"@en .

aat:300137658 a skos:Concept ;
    skos:definition "Characteristics related to color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color-related attributes"@en .

aat:300137660 a skos:Concept ;
    skos:definition "Made with light and dark shades of a single color or hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monochrome"@en .

aat:300137692 a skos:Concept ;
    skos:definition "Ceremonial namings of people, animals, or things, such as ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christenings"@en .

aat:300137717 a skos:Concept ;
    skos:definition "Seats that have been covered and stuffed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstered seats"@en .

aat:300137730 a skos:Concept ;
    skos:definition "The refuse, dross, or slag left after melting or smelting metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scoria"@en .

aat:300137731 a skos:Concept ;
    skos:definition "Wood from any fruit-bearing tree. Use a more specific term, if possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruitwood"@en .

aat:300137734 a skos:Concept ;
    skos:definition "General term for wood of any of several trees having either dark red wood, or having reddish wood and red sap, particularly including some belonging to the genus Eucalyptus from Australia, but also to trees of the genus Gordonia from Jamaica, the genus Lagerstroemia from India, or various genera from South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bloodwood"@en .

aat:300137775 a skos:Concept ;
    skos:definition "Representing and supporting the interest of a person, group, project, or program."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advocacy"@en .

aat:300137778 a skos:Concept ;
    skos:definition "Dividing and assigning according to some rule of proportional distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apportioning"@en .

aat:300137781 a skos:Concept ;
    skos:definition "Ceremonially immersing in or applying water to someone as an initiation rite or sacrament of the Christian church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptizing"@en .

aat:300137782 a skos:Concept ;
    skos:definition "Issuing a list of charges payable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billing"@en .

aat:300137784 a skos:Concept ;
    skos:definition "Consecrating or sanctifying by a holy rite; also, invoking God's favor upon a person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blessing"@en .

aat:300137786 a skos:Concept ;
    skos:definition "Placing under the conditions of a bond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonding"@en .

aat:300137790 a skos:Concept ;
    skos:definition "Engaging in or conducting a systematic course of aggressive activities for some special purpose. In the context of politics, working to promote one's own election to some public office, or the election of others, or the approval or rejection of some public question such as a referendum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaigning"@en .

aat:300137791 a skos:Concept ;
    skos:definition "Observing, honoring, or commemorating with ceremonies, festivities, or wide public praise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celebrating"@en .

aat:300137794 a skos:Concept ;
    skos:definition "Conveying awareness, knowledge, or information to others. For the science and technology of the transmission and reception of information, use \"communications.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communication"@en .

aat:300137796 a skos:Concept ;
    skos:definition "Proving, finding, or judging a person guilty of an offense or crime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convicting"@en .

aat:300137798 a skos:Concept ;
    skos:definition "Taking human life under judicial order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executing"@en .

aat:300137801 a skos:Concept ;
    skos:definition "Testing a hypothesis or model. In science and related fields, refers to testing systematically under controlled conditions in order to discover the qualities, behavior, or effects of the subject of the experiment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experimentation"@en .

aat:300137804 a skos:Concept ;
    skos:definition "Turning over a criminal suspect to another state or province in the country, the national government, or a foreign country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extraditing"@en .

aat:300137809 a skos:Concept ;
    skos:definition "Accusing a public official of misconduct in office before a competent tribunal, with the intent of removing that official."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impeaching"@en .

aat:300137812 a skos:Concept ;
    skos:definition "Formally accusing of an offense, crime, wrong, or fault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indicting"@en .

aat:300137815 a skos:Concept ;
    skos:definition "Committing funds to a project or enterprise in order to promote that project or to earn a return."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "investment"@en .

aat:300137818 a skos:Concept ;
    skos:definition "Sending out official or legal instruments and documents such as warrants, writs, and licenses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "issuing"@en .

aat:300137819 a skos:Concept ;
    skos:definition "General term for the gathering, organization, description, provision of access, storage, and overall maintenance of a collection of objects, documents, or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collections management"@en .

aat:300137823 a skos:Concept ;
    skos:definition "Enrolling, or admitting to membership and privileges, especially in a college or university."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matriculation"@en .

aat:300137825 a skos:Concept ;
    skos:definition "Providing religious guidance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ministering"@en .

aat:300137829 a skos:Concept ;
    skos:definition "Conveying property to a creditor as security for the repayment of a loan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortgaging"@en .

aat:300137830 a skos:Concept ;
    skos:definition "Activity or state of conferring or having conferred to an outsider the rights and privileges of a native subject or citizen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naturalization"@en .

aat:300137832 a skos:Concept ;
    skos:definition "Treating injuries, diseases, pathological conditions, deformities, and other disorders by operative manual and instrumental techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surgery"@en .

aat:300137836 a skos:Concept ;
    skos:definition "Absolving from the consequences of a fault or the punishment of a crime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pardoning"@en .

aat:300137837 a skos:Concept ;
    skos:definition "Establishing the authenticity or validity of a will."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "probating"@en .

aat:300137839 a skos:Concept ;
    skos:definition "Planning and establishing a sequence or system of actions, events, or instructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "programming"@en .

aat:300137841 a skos:Concept ;
    skos:definition "Imposing a penalty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punishing"@en .

aat:300137844 a skos:Concept ;
    skos:definition "Controlling according to rules, laws, or requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regulating"@en .

aat:300137847 a skos:Concept ;
    skos:definition "Serving in a legislative body by authority delegated by persons subject to the laws enacted by that body, usually by election, to represent their wishes and interests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "representing"@en .

aat:300137851 a skos:Concept ;
    skos:definition "Settling disputes by informal process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resolution"@en .

aat:300137854 a skos:Concept ;
    skos:definition "Condemning to penalty or punishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sentencing"@en .

aat:300137856 a skos:Concept ;
    skos:definition "Engaging in a temporary stoppage of work in order to bring about compliance with demands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking"@en .

aat:300137858 a skos:Concept ;
    skos:definition "Paying or exacting as payment a tenth part of income, crops, or other material resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tithing"@en .

aat:300137865 a skos:Concept ;
    skos:definition "Mass of any type of metal, cast into convenient shape for storage and transportation, to be rolled, forged, melted, or otherwise processed later. In some periods and cultures, such as in China, ancient Italy, and parts of Africa, they have been used as currency and as ceremonial objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ingot"@en .

aat:300137869 a skos:Concept ;
    skos:definition "Raised cushions, stools, or boards for kneeling, often attached to pews or having an elbow rest or desk attached. Kneelers are found in churches, but also in private chambers, including chapels, bedrooms, and studies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kneelers"@en .

aat:300137885 a skos:Concept ;
    skos:definition "Temporary stoppages of work by workers designed to enforce compliance with demands made on employers or government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strikes"@en .

aat:300137896 a skos:Concept ;
    skos:definition "Detached structures in domestic contexts containing one or more seats and a pit serving as toilets; distinguished from \"latrines\" which are similar structures in public contexts. For rooms that are within buildings and have such simple facilities, use \"privies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outhouses"@en .

aat:300137929 a skos:Concept ;
    skos:definition "Occurances and happenings related to one's occupation or status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupation-related events"@en .

aat:300137932 a skos:Concept ;
    skos:definition "Designates special play areas set aside for children, particularly pre-school age children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tot lots"@en .

aat:300137940 a skos:Concept ;
    skos:definition "The providing of advice and sometimes other services by professionals in the field of their special expertise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consulting"@en .

aat:300137941 a skos:Concept ;
    skos:definition "Actions or instances of deceit, trickery, or breach of confidence used to acquire unfair or dishonest advantage or material gain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraud"@en .

aat:300137947 a skos:Concept ;
    skos:definition "The creation or alteration of valued objects or documents with intent to deceive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forgery"@en .

aat:300137949 a skos:Concept ;
    skos:definition "A method of forming molten metal into long shapes narrow in cross-section, such as rods or sheets. Used particularly in the manufacture of steel for use in construction. Metal is passed between dual rollers revolving in opposite directions at uniform speed; the heat of the rollers increasing the plasticity of the metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-rolling"@en .

aat:300137953 a skos:Concept ;
    skos:definition "The evaluation of proposals for development or for changes to existing structures or spaces, typically by a board representing the community where the activity is to take place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design review"@en .

aat:300137966 a skos:Concept ;
    skos:definition "Branch of anthropology focusing on the origins, history, and development of human societies and social structure, including in its scope aspects of archaeology, ethnology, and ethnography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social anthropology"@en .

aat:300137970 a skos:Concept ;
    skos:definition "Science of the nature and properties of drugs, particularly their actions or effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharmacology"@en .

aat:300138008 a skos:Concept ;
    skos:definition "Inlaid works comprising an alloy of copper, lead, tin, and zinc, used as a ground for inlaying with gold and silver. The handicraft originated in Bidar, Karnataka, India in the 14th century CE, during the rule of the Bahamani Sultans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidriware"@en .

aat:300138010 a skos:Concept ;
    skos:definition "Any paint that glows in the dark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luminous paint"@en .

aat:300138065 a skos:Concept ;
    skos:definition "Events involving groups of people and friendly interaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social functions"@en .

aat:300138069 a skos:Concept ;
    skos:definition "Organized assistance provided by public or private agencies and organizations to individual community members. For essential on-going services provided by the government relating directly to the protection and maintenance of the lives and property of community members as a whole, use \"public services.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social services"@en .

aat:300138070 a skos:Concept ;
    skos:definition "Care of children or others unable to be left by themselves by persons other than their parents, family, or guardians on a partial or full day basis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day care"@en .

aat:300138074 a skos:Concept ;
    skos:definition "Organized public material assistance provided to financially needy individuals or families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "welfare services"@en .

aat:300138076 a skos:Concept ;
    skos:definition "Actions or procedures followed to produce some end, and for the actions or changes that take place in materials or objects. When emphasis is on the manner or method by which actions or procedures are performed, use \"techniques.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processes"@en .

aat:300138082 a skos:Concept ;
    skos:definition "The manner or method by which an activity is performed. Use \"processes\" when referring generally to the activities or procedures followed to produce some end, and for the actions or changes that take place in materials or objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "techniques"@en .

aat:300138085 a skos:Concept ;
    skos:definition "Photographs used as a means for a person to establish identity; also, photographs used to identify objects, for cataloging or insurance purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identification photographs"@en .

aat:300138088 a skos:Concept ;
    skos:definition "Areas of responsibility in which activities are conducted in order to accomplish a purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "functions"@en .

aat:300138091 a skos:Concept ;
    skos:definition "Agencies such as police, fire, or medical units prepared to respond to immediate and acute physical or sociological events that impact public health and safety."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency services"@en .

aat:300138095 a skos:Concept ;
    skos:definition "Carrying out the provisions of or compelling compliance with public laws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law enforcing"@en .

aat:300138112 a skos:Concept ;
    skos:definition "Multipurpose commodelike desks containing a set of drawers which could be mechanically raised from the back section of the piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secrétaires à la Bourgogne"@en .

aat:300138142 a skos:Concept ;
    skos:definition "Upholstered chairs with low seats and very high backs placed either beside or in front of the fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chauffeuses"@en .

aat:300138173 a skos:Concept ;
    skos:definition "Freedom from work or other obligatory activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leisure"@en .

aat:300138191 a skos:Concept ;
    skos:definition "Photographs in which the tones or colors correspond to (that is, are not reversed from) their appearance in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "positives"@en .

aat:300138214 a skos:Concept ;
    skos:definition "Small galleries like the boxes of a theater, often inserted into the choir wall of Baroque churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coretti"@en .

aat:300138219 a skos:Concept ;
    skos:definition "Thin wood poles used in modern Mayan building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cololches"@en .

aat:300138222 a skos:Concept ;
    skos:definition "Any material that is by its nature or context toxic, corrosive, flammable or combustible, an irritant, a strong sensitizer, or that generates pressure through decomposition, heat, or other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hazardous substance"@en .

aat:300138225 a skos:Concept ;
    skos:definition "Coats of arms and coat of arms elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coats of arms and coat of arms elements"@en .

aat:300138226 a skos:Concept ;
    skos:definition "Characteristic parts of coats of arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coat of arms elements"@en .

aat:300138227 a skos:Concept ;
    skos:definition "Shields, or shield-like surfaces upon which coats of arms are depicted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escutcheons"@en .

aat:300138231 a skos:Concept ;
    skos:definition "Motion pictures produced primarily for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's films"@en .

aat:300138233 a skos:Concept ;
    skos:definition "Indicating on a drawing the actual dimensions of whatever is represented in the drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimensioning"@en .

aat:300138239 a skos:Concept ;
    skos:definition "Amateur or professional photography that regards anything living and growing on the earth, generally with the exception of human beings. Subject matter is extended to plants, animals, and the places in which they live. Landscape and underwater photography may be considered distinct categories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nature photography"@en .

aat:300138242 a skos:Concept ;
    skos:definition "Accumulated goods and financial resources devoted to the production of other goods or to generating income."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capital"@en .

aat:300138244 a skos:Concept ;
    skos:definition "Beds having dome-shaped testers supported by rods, often of iron, curving up from the corners of the head boards, with the rods being hidden by the bed hangings. Developed in the 18th century, such beds were often meant to stand in a deep niche in the bedroom of the main apartment of a palace or mansion. In other installations, the bed are often placed with one side lengthwise flush against a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits à la polonaise"@en .

aat:300138247 a skos:Concept ;
    skos:definition "Magnificent state beds used in the ceremonial bedrooms of a noble or royal residence, coined in 18th-century French usage. Such beds were not intended to be used for routine sleeping, but for example, for the display of a royal newborn with his mother, of the sick or dying monarch, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits de parade"@en .

aat:300138251 a skos:Concept ;
    skos:definition "Beds with two ends of equal height, with each end overscrolled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits en bateau"@en .

aat:300138256 a skos:Concept ;
    skos:definition "Small tables containing several tiers of drawers and generally set on tall legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petites commodes"@en .

aat:300138292 a skos:Concept ;
    skos:definition "Photographs made by the Autochrome process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Autochromes"@en .

aat:300138319 a skos:Concept ;
    skos:definition "Hand-inked photographs produced by a bichromate process developed by G.E.H. Rawlins ca. 1904. A sheet of paper is coated with a thin layer of gelatin and sensitized with bichromate, dried in the dark and exposed under a negative. Exposure hardens the gelatin in the shadow areas and partially in mid-tones. Soaking in water subsequently removes sensitizer and causes the mid-tone and highlight areas to absorb moisture. Oil based inks are repelled in these areas, and remain to a greater or lesser degree in others. The plate is then allowed to dry or is transfer-printed to another sheet, then re-inked for more prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil prints"@en .

aat:300138324 a skos:Concept ;
    skos:definition "Prints made from the photographic process in which the developed silver in a gelatin print is used as a catalyst to tan the gelatin, and the untanned highlights are used as a resist to a greasy ink. The original plate may be the end product or may be used as a master for transferring the image to another support. Resulting prints resemble etchings or lithographs. Though the process was originally described ca. 1907, prints may be made in this way using modern enlarging papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bromoil prints"@en .

aat:300138328 a skos:Concept ;
    skos:definition "Compound used most frequently as a plastic in the production of motion picture film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulose diacetate"@en .

aat:300138331 a skos:Concept ;
    skos:definition "Photographic processes that record the effects of interference patterns of wavelengths of light as they interact with surfaces or filters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interference processes"@en .

aat:300138338 a skos:Concept ;
    skos:definition "Making photographic prints by placing a negative in contact with sensitized paper and exposing the sandwich to strong light, giving a print the same size as the negative. Many 19th-century printing processes employed contact printing because they required exposure to intense light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contact printing"@en .

aat:300138343 a skos:Concept ;
    skos:definition "Direct positive photographs produced by the process called Hillotype."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hillotypes"@en .

aat:300138411 a skos:Concept ;
    skos:definition "Elaborate mechanical tables that could sink or rise through the floor to be replenished with food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables volantes"@en .

aat:300138684 a skos:Concept ;
    skos:definition "A method of decorating surfaces with patterns or pictures composed of small, regularly-shaped pieces of colored durable material, such as stone or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosaic"@en .

aat:300138696 a skos:Concept ;
    skos:definition "A contemporary technique of creating a three-dimensional work of art by combining various elements, especially found objects; may include elements painted, carved, or modeled by the artist. Originally coined in 1953 by artist Jean Dubuffet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assemblage"@en .

aat:300138699 a skos:Concept ;
    skos:definition "Refers to the technique of making compositions in two dimensions or very low relief by gluing paper, fabrics, photographs, or other materials onto a flat surface. If heavy three-dimensional objects dominate, see \"assemblage (sculpture technique).\" If the constituent fragments form a somewhat unified image, see \"montage.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collage"@en .

aat:300138708 a skos:Concept ;
    skos:definition "Designing clothing, accessories, and ensembles for personal wear. For the design of clothing, accessories, and ensembles intended to create an appearance characteristic of a particular period, person, place, or thing, especially (but not exclusively) for theatrical performances, use \"costume design.\" For the concept of a prevailing, usually short lived custom, usage, or style in clothing, cars, restaurants, and other personal possessions and services, use \"fashion.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion design"@en .

aat:300138709 a skos:Concept ;
    skos:definition "Historians who study the histories of cities and towns, the urbanization of human life, and all aspects of urban life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban historians"@en .

aat:300138715 a skos:Concept ;
    skos:definition "Groups formed to study and disseminate information about the history of a place, usually a town, city, county, or state; such groups often maintain a museum or research institute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical societies"@en .

aat:300138724 a skos:Concept ;
    skos:definition "Institutional forms that function under a system of rules to achieve some goal and that maintains a technical and material organization, constitutions, staff, etc., and in which multiple nations cooperate, though these organizations are not necessarily sponsored by state or national government bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international organizations"@en .

aat:300138731 a skos:Concept ;
    skos:definition "Institutional forms that function under a system of rules to achieve some goal and that maintain a technical and material organization, constitutions, staff, etc., and that joins members that share citizenship of one nation, and some common interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national organizations"@en .

aat:300138741 a skos:Concept ;
    skos:definition "Long and narrow unshaped garments made from cloth or fur and used as a covering for the shoulders and arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoles"@en .

aat:300138750 a skos:Concept ;
    skos:definition "Representations of figures made of wood, cloth, papier-mâché, ceramic, paper, or another material, designed to be animated by human effort, including the use of strings, wires, sticks, or directly by the hand, usually before an audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puppets"@en .

aat:300138758 a skos:Concept ;
    skos:definition "Refers to coverings for all or part of the face, usually with openings for the eyes and sometimes the mouth. They are worn to hide or alter the identity of the wearer or for protection. Masks as cultural objects have been used throughout the world in all periods since the Stone Age. Masks are extremely varied in appearance, function, and fundamental meaning. They may be associated with ceremonies that have religious and social significance or are concerned with funerary customs, fertility rites, or curing sickness. They may be used on festive occasions or to portray characters in a dramatic performance and in re-enactments of mythological events. They may be used for warfare and as protective devices in certain sports. They are also employed as architectural ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masks"@en .

aat:300138790 a skos:Concept ;
    skos:definition "Practices and techniques used to take photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture-taking techniques"@en .

aat:300138800 a skos:Concept ;
    skos:definition "The activity of producing photographs that document or illustrate scientific phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific photography"@en .

aat:300138804 a skos:Concept ;
    skos:definition "The practice of picture taking in the service of manufacturing. The term is used broadly to include factory photography of processes, laboratory photography, studio photography of products, and field photography of activities such as procedures and testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial photography"@en .

aat:300138808 a skos:Concept ;
    skos:definition "Study and interpretation of ancient inscriptions, including writings, pictures, and random scratchings, incised on stone, clay, metal, or other hard surfaces. For the study of ancient modes of writing more generally, use \"paleography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epigraphy"@en .

aat:300138815 a skos:Concept ;
    skos:definition "Technique achieved by applying paint using the digits of the hand rather than a brush. Examples range from prehistoric image-making, modern art-making techniques, and children's art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger painting"@en .

aat:300138817 a skos:Concept ;
    skos:definition "Science and practice of controlled flight through the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautics"@en .

aat:300138818 a skos:Concept ;
    skos:definition "Branch of civil engineering dealing with the planning, design, and operation of facilities and systems used for the movement of persons and goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation engineering"@en .

aat:300138822 a skos:Concept ;
    skos:definition "Biological science which deals with the phenomena of heredity and the variation between progenitors and offspring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genetics"@en .

aat:300138823 a skos:Concept ;
    skos:definition "A school or style of painting and printmaking associated with Suzuki Harunobu, known for his calendar prints, and for further developing the multicolor print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suzuki School"@en .

aat:300138843 a skos:Concept ;
    skos:definition "Term used to describe a wide range of decorative painting techniques originally intended to replicate materials such as marble and wood with paint. Usage encompasses many other decorative finishes for walls and furniture, and is used broadly to describe various techniques in the context of domestic decor. For illusionistic painting in the context of fine art use \"trompe l'oeil.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faux finishing"@en .

aat:300138855 a skos:Concept ;
    skos:definition "Refers to persons who have withdrawn voluntarily from their native country, especially those who have renounced allegiance to it. For persons who have fled their native country or country of residence to escape danger or persecution, use \"refugees.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expatriates"@en .

aat:300138858 a skos:Concept ;
    skos:definition "Counseling people, particularly students, in choosing and preparing for appropriate careers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocational guidance"@en .

aat:300138861 a skos:Concept ;
    skos:definition "Data storage devices in disk form that use lasers to write and access data. The data may be stored in an analogue format such as a videodisc, or in a digital format such as a compact disk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical disks"@en .

aat:300138913 a skos:Concept ;
    skos:definition "Gratuitous grants or transfers of property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gifts"@en .

aat:300138919 a skos:Concept ;
    skos:definition "Refers to land that verges on a lake. In extended use the term is used to describe administrative regions or landmasses on or in the vicinity of a lake, or recreational areas that include lake access."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lakeshores"@en .

aat:300138975 a skos:Concept ;
    skos:definition "Bridgelike structures for pedestrians built to link one building with another across an alley or street; (RHDEL2) for the network of interconnecting walkways incorporating skybridges, use \"skywalks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skybridges"@en .

aat:300138992 a skos:Concept ;
    skos:definition "Levels in human populations distinguished by degree of wealth or privilege, modes of labor, way of life, or other social, economic, or cultural factors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social classes"@en .

aat:300139067 a skos:Concept ;
    skos:definition "Brief statements condensing substansive points in a longer document."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summaries"@en .

aat:300139095 a skos:Concept ;
    skos:definition "Areas of a site that have been landscaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscaped-site elements"@en .

aat:300139110 a skos:Concept ;
    skos:definition "Diffusion transfer process that uses dye couplers rather than silver and produces color instant camera photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dye diffusion transfer process"@en .

aat:300139114 a skos:Concept ;
    skos:definition "Refers to any of several photographic processes that use gelatin as the binder and silver as the final image material. Most commonly used on a paper support for prints, but may employ a glass plate (in which case use \"gelatin dry plate process\") or film as the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin silver process"@en .

aat:300139140 a skos:Concept ;
    skos:definition "Pictorial representations, which may be in various media, having as subject matter scenes or events from everyday life, familiar objects, or ordinary custom or incident that do not belong to any other class of painting such as history, portrait, animal, landscape, marine, fruit and flower, or still life, but which may incidentally exhibit elements of any of those."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genre pictures"@en .

aat:300139156 a skos:Concept ;
    skos:definition "Cameras with wide-angle lenses capable of producing oversized, wide-angle images of great depth and clarity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquet cameras"@en .

aat:300139215 a skos:Concept ;
    skos:definition "Soft camel hair brushes used in lab work, photography, and photoengraving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "background brushes"@en .

aat:300139222 a skos:Concept ;
    skos:definition "Cameras with a special horizontally scanning lens which rotates about its rear nodal point. It produces an image on a curved plate or film and can cover a very wide angle of view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panoramic cameras"@en .

aat:300139242 a skos:Concept ;
    skos:definition "The technique of printing one photograph using images from more than one negative. For the technique of recording more than one image on a single sheet or frame of film, use \"multiple exposure.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination printing"@en .

aat:300139249 a skos:Concept ;
    skos:definition "The technique in photography of recording more than one image on a single sheet or frame of film. For the technique of printing together images from more than one negative, use \"combination printing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiple exposure"@en .

aat:300139388 a skos:Concept ;
    skos:definition "Refers to English and European desks with a steeply sloping lid (usually a 45-degree angle) surmounted by a bookcase. For similar American examples use \"desks and bookcases.\" The furniture type developed from the bureau. In the early 18th century one form of bureau comrpised drawers below a sloping writing flap, resting on cabriole legs. Many bureaus of this period and earlier were surmounted by a bookcase, often enclosed by glazed or unglazed doors. Dutch furniture makers developed the form, creating the \"bureau-bookcase,\" which was often fitted with an ingenious combination of drawers and compartments. It became very popular, and spread to other parts of Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureau-bookcases"@en .

aat:300139419 a skos:Concept ;
    skos:definition "Ancient Roman couches, of a variety of forms, but generally having turned legs and often having both head and foot boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lecti"@en .

aat:300139435 a skos:Concept ;
    skos:definition "Folding stools having curved legs forming a wide X, no back, and low arms. They were originally easily transportable chairs for magisterial commanders in the field; over time, the seat developed a hieratic significance; Ancient Roman folding curule stools were used by senators and magistrates. Although often of luxurious construction, the Roman curule was meant to be uncomfortable, symbolizing that the official should carry out his duties in an efficient and timely manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curule chairs"@en .

aat:300139518 a skos:Concept ;
    skos:definition "The greasy liquid used with pen or brush in lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tusche"@en .

aat:300139525 a skos:Concept ;
    skos:definition "15th- and 16th-century groom's chests with a single large compartment; made only in the Catalana region of Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machos"@en .

aat:300139530 a skos:Concept ;
    skos:definition "15th- and 16th-century brides' chests constructed in the Catalonia region of Spain. At one side of its face is a door which conceals a set of drawers to hold small articles. Both inner and outer sides of the lid are decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hembras"@en .

aat:300139541 a skos:Concept ;
    skos:definition "Tall, three-storied cabinets consisting of a desk between two cupboards and typically decorated with inlay, built in Spain during the 17th century. The name refers to the spindled top story, which form a ventilated food cupboard for fruit, cheese, and bread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fresqueras"@en .

aat:300139709 a skos:Concept ;
    skos:definition "Refers to the first photographs produced by William Henry Fox Talbot. They were created with a printing-out process, some as photograms and others with a camera. Distinguished from \"calotypes\" which were produced by Talbot's later improved and patented developing-out process called \"calotype.\" In the mid-19th century, sometimes used as a synonym of photographs. For most prints made from these negatives, use \"salted paper prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogenic drawings"@en .

aat:300139717 a skos:Concept ;
    skos:definition "Strong chests, coffers, bins, boxes, close baskets, or similar tightly covered receptacles, generally made of wood and distinguished by having particularly strong, durable, and often water-tight construction. Used to store food or articles of great value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arks"@en .

aat:300139724 a skos:Concept ;
    skos:definition "Photographs that purport to show personal energy fields (auras), energy or personality extensions (astral projections), pre- or postcognitive mental images, or various other supranormal visual manifestations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychic photographs"@en .

aat:300139728 a skos:Concept ;
    skos:definition "Simple chests constructed of six boards butted, lapped, nailed, and hinged together; an economical alternative to joined chests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board chests"@en .

aat:300139737 a skos:Concept ;
    skos:definition "Registered trademark for a series of color film products made by Agfa of Germany. Originally used for color photographic plates manufactured in Berlin in 1916. Agfacolor plates were made with tiny dyed grains of gum arabic or shellac. The fine-grains gave an intense color. Agfacolor grain sheets were introduced as rolls and sheets in 1932. A slide film, called Agfacolor Neu (or Agfacolor new) was introduced in 1936. It uses the subtractive color process to produce color negatives. Agfacolor printing paper that used a multilayer negative-positive process was introduced in 1942."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agfacolor (TM)"@en .

aat:300139745 a skos:Concept ;
    skos:definition "Low tables, often with a raised rim around the edge, intended to support a cabinet, chest, or other piece of case furniture. Intended to stand against a wall, and thus usually undecorated on one side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet stands"@en .

aat:300139992 a skos:Concept ;
    skos:definition "Design which originally appeared in Chippendale's Director for garden tables with a top carved in the form of an open scallop shell; often silver gilt or painted to look like mother of pearl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grotto tables"@en .

aat:300139997 a skos:Concept ;
    skos:definition "Design which originally appeared in Chippendale's Director for chairs with a back in the form of an open scallop shell; often decorated in silver gilt or painted to look like mother of pearl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grotto chairs"@en .

aat:300140010 a skos:Concept ;
    skos:definition "Simple chairs consisting of a slab seat, four stick legs, and a plank back inserted into a slot in the seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board chairs"@en .

aat:300140021 a skos:Concept ;
    skos:definition "Paneled chests often used as cabinet stands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taquillónes"@en .

aat:300140023 a skos:Concept ;
    skos:definition "Small ladies writing desks with cabriole legs, mounted with drawers or compartments, and with a pull-out writing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux de dame"@en .

aat:300140027 a skos:Concept ;
    skos:definition "Pliants having a back with finials, which were often hooked forward and made to resemble parakeets (thus the name). Came into fashion in France in the early 17th century; principally used at dining tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perroquets"@en .

aat:300140114 a skos:Concept ;
    skos:definition "German variety of the board chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brettstuhls"@en .

aat:300140152 a skos:Concept ;
    skos:definition "Drawings of elevations arranged around a plan as if the walls had been laid flat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laid-out elevations"@en .

aat:300140153 a skos:Concept ;
    skos:definition "Wood of the genus Aesculus, native to North America, southeastern Europe, and eastern Asia. While primarily grown as an ornamental tree, horse chestnuts have light, soft, tough, fine-grained wood used for artificial limbs, splints, brush handles, boxes, crates, and paper pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse chestnut"@en .

aat:300140253 a skos:Concept ;
    skos:definition "French term of uncertain derivation denoting decorative candlestands; original type had a circular top and a central standard, often in the form of a Moor, or, as the taste for exoticism increased, of a negress or Indian. In Louis XV and Louis XVI periods guéridons became small movable tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guéridons"@en .

aat:300140296 a skos:Concept ;
    skos:definition "Fitted dressing tables. The most typical 18th-century form has three rising flaps, the center one being fitted with a mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coiffeuses"@en .

aat:300140644 a skos:Concept ;
    skos:definition "Documents that provide authorization or permission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permissions"@en .

aat:300140803 a skos:Concept ;
    skos:definition "Pottery with a porous body, fired below 1200 degrees Centigrade. It is not vitrified, and must be glazed to render it nonporous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthenware"@en .

aat:300140969 a skos:Concept ;
    skos:definition "Activity of taking portrait photographs as a livelihood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial portraiture"@en .

aat:300141151 a skos:Concept ;
    skos:definition "Term generally applied to a variety of different chairs with low seats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' chairs"@en .

aat:300141233 a skos:Concept ;
    skos:definition "Furniture legs in which the foot is formed by a continuation of the surfaces of a square leg in an outward flare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stump legs"@en .

aat:300141674 a skos:Concept ;
    skos:definition "Portuguese paneled cabinets on stands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contadores"@en .

aat:300141677 a skos:Concept ;
    skos:definition "Portuguese tester beds with turned elements and carvings on the headboard; generally having turned posts and either a plain or pagoda-shaped tester. Of a type made in the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camas de bilros"@en .

aat:300141681 a skos:Concept ;
    skos:definition "Castilian name for small writing tables with hidden places for jewels and other valuables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bufetillos"@en .

aat:300141687 a skos:Concept ;
    skos:definition "Small tables or supported planks dedicated to pork-salting or producing other pork products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tocineras"@en .

aat:300141693 a skos:Concept ;
    skos:definition "Records generated by a commercial or industrial enterprise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business records"@en .

aat:300141696 a skos:Concept ;
    skos:definition "Formal instruments attesting to the transfer of ownership of personal property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bills of sale"@en .

aat:300141790 a skos:Concept ;
    skos:definition "Pottery styles belonging to Central Italian Greek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Italian Greek pottery styles"@en .

aat:300141803 a skos:Concept ;
    skos:definition "Provincial styles belonging to Roman cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman provincial styles"@en .

aat:300141951 a skos:Concept ;
    skos:definition "Urban thoroughfares handling major portions of traffic, often larger than most streets and having medians; use primarily when referring to the flow of traffic within a transportation system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arterial streets"@en .

aat:300142154 a skos:Concept ;
    skos:definition "Small Spanish tables, usually in a woman's room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bufetes"@en .

aat:300142226 a skos:Concept ;
    skos:definition "Rooflike components generally cantilevered from the headboard as opposed to being supported by posts, and which extend over the whole area of the bed. Use \"half-testers\" for similar forms which only extend over the head half."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying testers"@en .

aat:300142324 a skos:Concept ;
    skos:definition "Rooflike components suspended over the head of a bed by means of a cord attached to the ceiling; usually a cone-shaped or domed bowl with a valance all around, and with two or three curtains long enough to reach and encompass the foot of the bed. Use \"testers\" for rooflike components supported above the bed by posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canopies"@en .

aat:300142552 a skos:Concept ;
    skos:definition "Ancient Roman couches, used for dining and therefore generally lacking head and foot boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triclinia"@en .

aat:300142594 a skos:Concept ;
    skos:definition "French beds meant to have a separate canopy overhead; of a type made in the late 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits à la romaine"@en .

aat:300142721 a skos:Concept ;
    skos:definition "Small tables with extending flaps supported on slender legs, or hinged brackets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly tables"@en .

aat:300142732 a skos:Concept ;
    skos:definition "Swing-leg, dropleaf tables with a very narrow central portion; of a type made in England from the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sutherland tables"@en .

aat:300142742 a skos:Concept ;
    skos:definition "Beds with suspended canopies, rectangular, cone-shaped, or domed, which support curtains that may encompass the head half or the full length of the bed. Use \"tester beds\" for beds having a rooflike component supported on posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canopy beds"@en .

aat:300142783 a skos:Concept ;
    skos:definition "Beds with a simple wooden framework, which supports the bed hangings so as to form a plain, rectangular box. No wooden components are visible, even the posts are encased in cloth. Use \"sleigh beds\" for beds with two ends of equal height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French beds"@en .

aat:300143325 a skos:Concept ;
    skos:definition "Refers to a type of Jewish mysticism characterized by an ascetic lifestyle, strict observance of the commandments, and ecstatic forms of worship and prayer. Its origins are usually traced back to Poland in the late 18th century and it was developed in opposition to rabbinic authority and certain Jewish traditions. Hasidism emphasizes prayer as a means of communicating with God as opposed to study of the Torah. As Hasidism spread throughout the world, it was eventually accepted as part of Orthodox Judaism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hasidism"@en .

aat:300143430 a skos:Concept ;
    skos:definition "Refers to the source of values, scholarly tradition, and social view inspired by the teachings of Confucius in the sixth century BCE in China. The belief system, based on understanding the past and conserving cultural traditions, exerted profound cultural influences in East Asia, dominating government, society, education, and family life in the region. It is characterized by its strong universal humanist philosophies; often, East Asians, in professing other religious affiliations such as Islam or Buddhism, seldom cease to be Confucians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Confucianism"@en .

aat:300143540 a skos:Concept ;
    skos:definition "Refers to the religion and philosophy founded in India in the sixth century BCE by Vardhamana, one of the religious figures who protested and repudiated the orthodox doctrines of the Vedic cult. It is characterized by an aversion to rites of sacrifice prevalent in Vedic traditions, by the belief in the ethical doctrine of ahimsa, advocating non-injury to all living creatures, and by the struggle for the consummate ideal of human perfection achieved through monastic and devout living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jainism"@en .

aat:300143629 a skos:Concept ;
    skos:definition "Refers to the religion based on devotion and worship to Mithra, the Iranian god of the sun, justice, contract, mediation, and war in pre-Zoroastrian Iran. Also refers to the religion in the Roman Empire during the second and third centuries centered around the worship of Mithras, the patron deity of loyalty to the emperor. This religious practice dissipated with the recognition of Christianity by emperor Constantine in the fourth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mithraism"@en .

aat:300143658 a skos:Concept ;
    skos:definition "Religious ideology based on numerous texts dealing with esoteric practices originally of some Indian sects. Among other practices, noted for sexual and meditative rituals and techniques concerned with divine creative energy (shakti) and supranormal mystical goals. Tantrism appears in both Buddhism and Hinduism and has also influenced a number of other religious movements and trends since the 5th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tantrism"@en .

aat:300143666 a skos:Concept ;
    skos:definition "Religion and philosophical tradition originating in China, generally emphasizing individual freedom and spontaneity, laissez-faire government and social primitivism, techniques of self-transformation, mystical experience, and individual and government ethical responsibility. It is founded on the texts of the Tao-te Ching, Chuang-tzu, and Lieh-tzu. Later, the tradition diverged, resulting in strictly philosophical Taoism on the one hand, and religious Taoism on the other. The governing principle of the latter is the struggle to reach a state of 'immortality' through a strict regimen of dietary restrictions, breath control, meditation and visualization of the gods that inhabit the body, sexual control and discipline, the practice of theoretical internal alchemy (nei-tan) used to energize the Yin and Yang forces within the body, and the use of magic talismans. Successful devotees were known as hsien (Immortals)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taoism"@en .

aat:300143670 a skos:Concept ;
    skos:definition "Designates the ancient pre-Islamic religion of Iran, founded by the Iranian prophet Zoroaster in the sixth century BCE, featuring both monotheistic and dualistic features that later influenced Judaism, Islam, and Christianity. The religious society is divided into a three-part class structure consisting of chiefs and priests; warriors; and husbandmen and cattle breeders. Gods or daivas are often associated with each class, though Zoroaster rejected the cults of all gods except the one of Ahura Mazda (the Wise Lord). Its characteristic principle is the belief that the origin of evil began in the exercise of free will at the nascent stage of creation in which the twin sons of Ahura Mazda, embittered in rivalry, chose different moral paths: Spent Mainyu (Bounteous Spirit) choose good; Angra Mainyu (Destructive Spirit) chose evil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zoroastrianism"@en .

aat:300143690 a skos:Concept ;
    skos:definition "Lady's writing desks fitted with an adjustable looking glass above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' cabinet dressing tables"@en .

aat:300143697 a skos:Concept ;
    skos:definition "Dressing tables with two drawers in the sides which swing out and provide mirrors on a quadrant so that a woman could see herself at any angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rudd tables"@en .

aat:300143716 a skos:Concept ;
    skos:definition "Cases for holding books generally having several shelves enclosed by doors; distinct from \"bookshelves\" which are open shelves for holding books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookcases"@en .

aat:300143751 a skos:Concept ;
    skos:definition "Semicircular tables, generally used as dining tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horseshoe tables"@en .

aat:300143761 a skos:Concept ;
    skos:definition "Writing tables with fire screens to protect the writer from the heat of the fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' screen writing tables"@en .

aat:300143781 a skos:Concept ;
    skos:definition "In modern usage, generally refers to small, portable writing desks that first appeared in 16th-century Europe, and were extremely popular in France in the 18th century. They are generally characterized by having a nest of drawers enclosed in a box, often with a sloping front that is hinged along the bottom edge and may be let down to provide a writing platform. An escritoire was placed on top of a table or had its own legs. Formerly, these small portable desks were also called \"secretaries\"; however, in modern usage, the term \"secretaries\" typically refers to larger pieces meant to be placed against a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escritoires"@en .

aat:300143809 a skos:Concept ;
    skos:definition "Small desks generally having a sloping surface for writing or for propping up books for reading; sometimes fitted with an inkwell or pounce box for sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable desks"@en .

aat:300144119 a skos:Concept ;
    skos:definition "Pivoting fire screens adjusted in position by a thumbscrew on a rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "écrans à pivot"@en .

aat:300144135 a skos:Concept ;
    skos:definition "Late-19th-century, richly upholstered armchairs with little or no frame exposed and usually mounted on a spring platform or having a spring back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkish chairs"@en .

aat:300144145 a skos:Concept ;
    skos:definition "Shallow desks with a slant front over a bookcase base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desks-over-bookcases"@en .

aat:300144148 a skos:Concept ;
    skos:definition "Glazed boxes, cases, or cabinets, of relatively small size, used for displaying and protecting items in a store, museum, home, or other location. For large, wooden cabinets with drawers, shelves, and doors or a fall front, designed for storing rare collections and popular in the 17th century, use \"display cabinets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "showcases"@en .

aat:300144780 a skos:Concept ;
    skos:definition "Type of French sofa with an undulating back; often made in matching pairs and placed on either side of the fireplace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veilleuses"@en .

aat:300145571 a skos:Concept ;
    skos:definition "Gardens laid out to imitate those in China, often including Chinese-style structures; especially popular in Europe during the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese gardens"@en .

aat:300145802 a skos:Concept ;
    skos:definition "Documents in which monies or goods received and paid or given out are recorded in order to permit periodic totaling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accounts"@en .

aat:300145807 a skos:Concept ;
    skos:definition "Refers to the period associated with the city Thonburi established in 1767 by the military leader Taskin after defeating invading armies and seizing political power. The style of this period is driven by the renewed sense of military might and political unification. In painting, the style features murals depicting Buddhist subject matter, Thai landscapes, and details showing the plans and construction of buildings. Wall paintings usually decorated the interiors of royal buildings or temples. In this period, temple and palace building programs prospered, featuring the Chakri Maha Prasat and the Wat Arun, a Chinese-inspired temple featuring bell towers and porcelain-covered tympana and also distinctively Thai details such as domestic teak dwellings for monks. In sculpture, the period is seen in large statues of Buddha in royal attire made of gilded and lacquered stucco and bronze and decorated with inlaid mother-of-pearl. Giant guardians such as mythical half-human, half-bird figures and apsarasas and Chinese stone statues embellish temple courtyards of this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thonburi"@en .

aat:300145809 a skos:Concept ;
    skos:definition "Refers to the movement and style of art based on the Spanish literary movement in the early 20th century adopted by writers such as Jorge Luis Borges and Pablo Neruda. The style is characterized by the use of intense imagery and symbolism that defies objective analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ultraist"@en .

aat:300145811 a skos:Concept ;
    skos:definition "In Greek theaters, the revolving triangular devices with differing scenery painted on each of the three faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periaktoi"@en .

aat:300145814 a skos:Concept ;
    skos:definition "Generally refers to people who makes use of a thing. Examples are people who use any product or service of the information industry, such as software, thesauri, or indexes, including those who themselves use such resources to provide information services to others. For clients or patrons of a library, information center, or information retrieval service, prefer the more specific term \"end users.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "users"@en .

aat:300145840 a skos:Concept ;
    skos:definition "Shallow decorative vessels in a variety of materials that often have ruffled or wavy edges, and usually set in a purpose-made stand, sometimes having a handle resembling a basket. These have evolved from the more ephemeral objects used at weddings to hold flowers or the bridal bouquet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bride's baskets"@en .

aat:300145852 a skos:Concept ;
    skos:definition "Covered, spouted vessels for preparing and serving hot chocolate, often similar in form to coffeepots but invariably having a provision for inserting a molinet and often having a handle placed at a right angle to the spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocolate pots"@en .

aat:300145966 a skos:Concept ;
    skos:definition "Ideas and notions that are fundamentally religious."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious concepts"@en .

aat:300145975 a skos:Concept ;
    skos:definition "Religious concepts related to doctrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doctrinal concepts"@en .

aat:300146236 a skos:Concept ;
    skos:definition "Collections owned and maintained by private individuals, outside of the public domain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private collections"@en .

aat:300146325 a skos:Concept ;
    skos:definition "Prayer leaders and officiating priests of Islamic mosques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imams"@en .

aat:300146597 a skos:Concept ;
    skos:definition "Degree to which air is polluted, such that air quality is deemed to be high when air pollution levels are low."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air quality"@en .

aat:300146616 a skos:Concept ;
    skos:definition "Chairs having interlaced ornamental backs, and that may be perforated or cut in low relief, usually in geometric patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fret-back chairs"@en .

aat:300146667 a skos:Concept ;
    skos:definition "Desks with a hinged one-piece round lid or cover that resembles a section of a cylinder and which rolls up into the desk top. For similar desks surmounted by a bookcase use \"cylinder desks and bookcases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder fall desks"@en .

aat:300147678 a skos:Concept ;
    skos:definition "Paint made from oil, resin, varnish, or a combination of these, mixed with finely ground pigment; usually giving a glossy finish, but sometimes giving a semigloss or flat finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enamel paint"@en .

aat:300147976 a skos:Concept ;
    skos:definition "Mineral occurring in igneous rocks such as basalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "augite"@en .

aat:300147980 a skos:Concept ;
    skos:definition "A magnesium iron silicate mineral characterized by an olive green color, occurring in igneous and metamorphic rocks. It has two compositional varieties: fayalite (iron rich) and forsterite (magnesium rich). The opaque variety of the stone was found in Egypt, in the lava of Vesuvius, and in the Eifel district of Germany. Transparent, gem quality stones are called peridot, and found in various locations around the world.Olivine beads have been found in pre-Dynastic Egyptian jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olivine"@en .

aat:300148033 a skos:Concept ;
    skos:definition "Christian religious societies or fraternities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian orders"@en .

aat:300148037 a skos:Concept ;
    skos:definition "Refers to several Christian monastic communities of the Byzantine Rite that follow the rule of St. Basil, their spiritual father; there are five major branches of the Order of St. Basil. The Basilian monastic community has been highly influential in the Byzantine community over the centuries, comparable to the Benedictine influence within the Western monastic community. St. Basil, theologian and archbishop of Caesarea in Cappadocia (modern Turkey), created his monastic rule between 358 and 364. St. Basil's simple yet strict rule asks followers to practice community living and advocates ascetic practices as a way to serve God more perfectly. His rule avoids the extreme asceticism of the desert hermits. Implied by St. Basil are vows of chastity and poverty, anticipating the later Western monastic systems, and aid to impoverished people is also called for. Attached to the monasteries should be schools for children in which the students can be tested for a possible religious vocation. St. Basil's rule was revised in the 9th century by St. Theodore of Studios. The Basilian order should not be confused with a Latin-rite congregation of the same name that was founded in France in 1822 but later active mainly in Canada; the members of this congregation devote themselves to educating children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basilian"@en .

aat:300148044 a skos:Concept ;
    skos:definition "A Christian religious order following the rule of St. Benedict of Nursia (ca. 480-547). St. Benedict's rule is a detailed guide for the government and spiritual and material welfare of a monastery. By the 7th century the rule was also being applied to women and by the early 9th century it had supplanted most other monastic styles in northern and western Europe. Benedictines hold to the well-rounded daily routine of prayer, manual labor, and study prescribed by St. Benedict. Stability, group prayer, and obedience to the abbot are emphasized. The order, which is composed of autonomous monasteries, has a long tradition of scholarship and teaching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Benedictine"@en .

aat:300148065 a skos:Concept ;
    skos:definition "A Roman Catholic monastic order founded by St. Bruno of Cologne in Chartreuse (north of Grenoble, France) in 1084. The Carthusians combine the solitary existence of hermits with a communal life within the monastery. The monks or nuns live in individual cells and only come together at specific times of the day and at special feasts; strict abstinence is practiced. The Carthusians spread slowly, but, by 1521, the order numbered 195 houses in every Catholic European country. They played an important role in the monastic-reform movement of the 11th and 12th centuries; it is itself, however, the one form of communal religious life that has not experienced reform. Houses are found in many parts of Europe although membership is relatively small. A famous liqueur is made at 'La Grande Chartreuse,' the order's mother-house, with profits donated to charity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carthusian"@en .

aat:300148071 a skos:Concept ;
    skos:definition "A Roman Catholic order formed in 1098 by Benedictine monks and led by St. Robert of Molesme in Citeaux, France. Cistercians abide by a strict interpretation of St. Benedict's rule and emphasize solitude, poverty, uniformity, and especially manual labor. The order was prominent during the Middle Ages, particularly under the leadership of St. Bernard of Clairvaux (1090-1153), with over 500 houses in Europe by the 13th century, but declined thereafter. The Cistercian's emphasis on manual labor, particularly farm labor, meant that the order played an important role in the economic progress of the 12th century and in the development of farming and marketing techniques. Reform movements occurred during the 16th and 17th centuries and the order ultimately divided into the Order of the Reformed Cistercians of the Strict Observance (often popularly called the Trappists) and the Cistercians of Common Observance. Today, there is a great amount of diversity among the monasteries of both orders and there has been a revival of literary work in both. Strict Observance is active in France, England and Poland while Common Observance is active in the United States and parts of Western Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cistercian"@en .

aat:300148084 a skos:Concept ;
    skos:definition "A Roman Catholic order founded by the Spanish St. Dominic in 1215 in southern France. The novelties of the new order were the obligation to pursue theological study and the mission to preach doctrine, a task previously regarded as the prerogative of bishops and their delegates alone. This mendicant order features a centralized government and organization and emphasizes missionary work and scholarship, thereby combining an active and a contemplative life. A member belongs to the order, not to any one autonomous house, and can be sent anywhere at any time. Famous Dominican scholars include Albertus Magnus and his pupil St. Thomas Aquinas. The system Aquinas developed was offically adopted by the order in 1278. There is an order of Dominican nuns that grew tremendously in the 19th and 20th centuries as well as a tertiary order of members not enclosed in a monastery. The order is noted for its continued orthodox following of Aquinas' teachings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dominican"@en .

aat:300148096 a skos:Concept ;
    skos:definition "Broad term for a Roman Catholic religious order comprising several divisions; founded by St. Francis of Assisi (1181-1226). The rule emphasizes the vow of poverty, theology, preaching, and aid to impoverished and sick people. Different schools of thought among followers developed over the years; St. Bonaventure (1257-1274) founded a moderate interpretation of St. Francis' rule that bridged many of the differences. The independent branches of the order are the First Order of Franciscans: the Observants, the Conventuals, and the Capuchins; the Second Order comprises nuns established by St. Clare under the guidance of St. Francis, known as the Poor Clares; and the Third Order comprising religious and lay men and women, including the Third Order Secular (living in the world without vows) and Third Order Regular (living in religious communities under vow)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Franciscan"@en .

aat:300148103 a skos:Concept ;
    skos:definition "A Roman Catholic order for men founded in 1540 by St. Ignatius of Loyola, a Spanish soldier who experienced a religious conversion while convalescing from a battle wound. It is a non-contemplative order requiring strict obedience, compliance with Ignatius' Spiritual Exercises, and special loyalty to the pope. The Jesuits abandoned many medieval practices including obligatory regular penances or fasts; a common dress; and the choral recitation of the liturgical office. Other innovations include their very centralized form of authority with life tenure for the head of the order; gradation of members; a probationary period of many years before final vows; and lack of a female branch. Jesuits carry out many kinds of missionary work with special emphasis on education; the order has founded many colleges and universities throughout the world. The Jesuits have been leading apologists for the Roman Catholic Church, particularly during the Counter-Reformation. In more recent times, the order has been highly influential in modernizing the Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jesuit"@en .

aat:300148110 a skos:Concept ;
    skos:definition "A Christian monastic order that resulted from 10th- and 11th-century reforms within the Benedictine order. The order is named after the town of Cluny in Burgundy, site of the celebrated abbey of the same name that was founded in 910 by Duke William the Pious of Aquitaine. The new order returned to strictly observing the rule of St. Benedict during a time of general monastic laxity. The Cluniac reforms were imitated by other monasteries and a succession of abbots gradually built up an impressive network of monasteries throughout western Europe that followed the strict Cluniac customs. The Cluniac order, free of feudal control itself, sought to eliminate feudal warfare; it supported the Truce of God and the Peace of God, which respectively restrict fighting and range of conduct. Cluniacs are also credited with integrating monks and society. The most important Cluniac abbots were St. Odon of Cluny (879-942) and St. Hugh of Cluny (Hugues de Semur; 1049-1109). St. Odo gained for Cluniac houses (called priories) exemption from all but papal authority, a centralization previously unknown in the Benedictine order. Under St. Hugh medieval monasticism reached its apogee and Cluny gained fame as a spiritual center of Western Christianity. While Hugh was abbot almost 2,000 more monasteries were founded in Italy, England, and Spain and in 1055 he founded the first Cluniac convent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cluniac"@en .

aat:300148696 a skos:Concept ;
    skos:definition "Ancient Greek and Roman storage vessels of many variations usually having a large oval body with a narrow neck and two or more handles extending from the mouth or neck to the shoulders on the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphorae"@en .

aat:300148705 a skos:Concept ;
    skos:definition "Mobile or fixed complete supports for artillery, generally consisting of a platform or vehicle and a gun mount."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun carriages"@en .

aat:300148722 a skos:Concept ;
    skos:definition "Art and practice of designing and building military fortifications and other installations, and building and maintaining lines of military communication and transportation. It includes providing utilities such as water and power to combat armies, design and construction of facilities to transport armies and weapons, particularly heavy artillery, the use or neutralization of conventional explosives, development of topographical maps and engineering intelligence, and the development of equipment necessary to carry out these operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military engineering"@en .

aat:300148821 a skos:Concept ;
    skos:definition "Coverings for the hand enclosing each finger separately, sometimes extending over the wrist and arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gloves"@en .

aat:300148823 a skos:Concept ;
    skos:definition "Wood from species Maclura pomifera; a hard, bright orange-colored wood that yields a dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Osage orange"@en .

aat:300149026 a skos:Concept ;
    skos:definition "Communication by means of a system that allows computer users to exchange messages in electronic format on a network, often but not always comprising messages from one individual to one or many others via telecommunications links between computers or terminals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic mail"@en .

aat:300149058 a skos:Concept ;
    skos:definition "The process of reheating glassware in order to impart a smooth or brilliant surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire polishing"@en .

aat:300149066 a skos:Concept ;
    skos:definition "Veneer made from tree excrescences that are typically in the form of flattened hemispheres. For example, one type of burl veneer is made from the stumps of walnut trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burl veneer"@en .

aat:300149370 a skos:Concept ;
    skos:definition "Moving people or things from one residence or fairly permanent location to another. An example of relocation is moving a sculpture from one site to another. May be used in the context of preserving or improving safety or well-being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relocating"@en .

aat:300150080 a skos:Concept ;
    skos:definition "Foundations, government agencies, institutions, or other organizations which give funds for a specific purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funding agencies"@en .

aat:300150095 a skos:Concept ;
    skos:definition "Associations of independent institutions, commonly financial or educational, formed to undertake an enterprise or project involving the sharing of resources such as funds, services, manpower, and markets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consortia"@en .

aat:300150114 a skos:Concept ;
    skos:definition "Groups consisting of a particular library's target clientele plus any others who actually use the collection or services of the library. Also, formal or informal groups of people who use a particular database or retrieval product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "user groups"@en .

aat:300150132 a skos:Concept ;
    skos:definition "Committees, usually of experts or specialists, formed for analyzing, investigating, or solving a specific problem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "task forces"@en .

aat:300150151 a skos:Concept ;
    skos:definition "Refers to chambers, rooms, buildings, vessels, receptacles, or other physical places in which works of art, specimens, curiosities, archives, documents, books, or other things are placed, deposited, or stored. In the context of art museums, the usage of the term often overlaps with \"repositories (institutions).\" For data storage and management destinations or mechanisms, use \"data repositories\" or \"digital repositories.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repositories"@en .

aat:300150168 a skos:Concept ;
    skos:definition "Organizations or agencies that serve as central bodies for the collection, organization, storage, and dissemination of information and documents. They may also perform referral services for researchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clearinghouses"@en .

aat:300150456 a skos:Concept ;
    skos:definition "Ministerial offices, branches of public employment, or bodies of public servants concerned with some particular kind of work or the supply of some particular need in a society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "services"@en .

aat:300150482 a skos:Concept ;
    skos:definition "In the Roman Catholic Church, the deceased who are considered to be in paradise, but who have not yet been granted the higher designation of \"saint.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beati"@en .

aat:300150492 a skos:Concept ;
    skos:definition "Refers to female sovereigns of empires, which are political units that comprise a number of territories or nations and are ruled by a single supreme authority. The term may also refer to the wives and widows of emperors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "empresses"@en .

aat:300150507 a skos:Concept ;
    skos:definition "Refers to the supreme rulers of ancient Egypt, who were considered kings and gods. The term is derived from the Egyptian \"per-aa,\" meaning \"great house,\" and originally referred to the royal palace. The term was used as a synonym or title of respect for the Egyptian king beginning in the New Kingdom, from the 18th dynasty (1539-1292 BCE) onwards. In modern usage, it generally is used as a title to refer to all ancient Egyptian kings, regardless of when they ruled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharaohs"@en .

aat:300150511 a skos:Concept ;
    skos:definition "Those who assume the position of head of a monarchy in the minority, absence, or disability of the monarch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regents"@en .

aat:300150555 a skos:Concept ;
    skos:definition "People recognized by others as holy persons; in various religions, the dead who are believed to be in Heaven. In the Roman and Eastern Catholic churches, people who are formally recognized by the Church as having had exceptional holiness of life and therefore an exalted station in heaven, and who have often been formally canonized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saints"@en .

aat:300150583 a skos:Concept ;
    skos:definition "Use with respect to air quality inside buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor air quality"@en .

aat:300150603 a skos:Concept ;
    skos:definition "Members of a governing legislative body called a Senate, in ancient Rome and other states in antiquity, in some cities of Europe from Medieval to modern times, and in some modern nations such as the United States, Canada, France, and Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senators"@en .

aat:300150615 a skos:Concept ;
    skos:definition "A contracting arrangement in which a person or organization assumes responsibility under a single contract for both the design and construction of a project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design-build"@en .

aat:300150684 a skos:Concept ;
    skos:definition "Organizations, either commercial or nonprofit, which provide information or documents (in any media), or facilitate access to them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information services"@en .

aat:300150698 a skos:Concept ;
    skos:definition "Information services which provide access to documents in a specific subject field or fields by means of abstracts and indexes issued periodically on paper, in microform, or as machine-readable databases, available by subscription or fee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abstracting and indexing services"@en .

aat:300150721 a skos:Concept ;
    skos:definition "Commercial or professional organizations established to provide supplies, equipment, software, and services to libraries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library service agencies"@en .

aat:300150744 a skos:Concept ;
    skos:definition "Automated information services which search for, locate, and retrieve data, either directly or in the form of citations to data sources, from electronically stored databases in response to users' queries. For specifically those services which provide direct answers to users' queries, or which provide direct access to sources of the needed information, prefer \"online reference services.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information retrieval services"@en .

aat:300150775 a skos:Concept ;
    skos:definition "Organizations or departments of organizations that provide direct answers to users' queries or refer them to sources of information that will satisfy the queries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reference services"@en .

aat:300150784 a skos:Concept ;
    skos:definition "Automated reference services which provide direct answers to users' queries, or provide direct access to electronically stored databases containing the needed information. For automated information services which provide data either directly or in the form of citations to data sources, use \"information retrieval services.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "online reference services"@en .

aat:300150791 a skos:Concept ;
    skos:definition "Refers to persons or agencies who offer goods and services for sale, especially those who create, market, and sell computers, software, automated systems, databases, and services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vendors"@en .

aat:300150833 a skos:Concept ;
    skos:definition "Optical instruments for viewing distant objects by means of the refraction of light rays through a lens or the reflection of light rays by mirrors, so that the rays enter an opening and converge to form an image seen through a magnifying eye piece, or by other electronic means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telescopes"@en .

aat:300150881 a skos:Concept ;
    skos:definition "Saws with extremely fine blades, as narrow as 1/32 inch, set in a frame or a file-style handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fretsaws"@en .

aat:300150908 a skos:Concept ;
    skos:definition "Sheets of insulating material used for mounting and interconnection of components in electronic equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circuit boards"@en .

aat:300151282 a skos:Concept ;
    skos:definition "Parks, usually over 20 acres in extent, offering a wider range of activities and considerably more open space than \"neighborhood parks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community parks"@en .

aat:300151343 a skos:Concept ;
    skos:definition "Object genre including visual works and other articles made of ceramic, which is any of various hard, brittle, heat-resistant and corrosion-resistant materials made by shaping and then firing a nonmetallic mineral, such as clay, at a high temperature. Ceramic ware, earthenware, porcelain ware, and brick products are examples of ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramics"@en .

aat:300151452 a skos:Concept ;
    skos:definition "Acrylic resin emulsion of the Rhom & Haas Company, used in paint, textile finish, and adhesive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhoplex resin (TM)"@en .

aat:300151836 a skos:Concept ;
    skos:definition "Cessation of life processes of all living organisms, but particularly refers to the act as it occurs in individual human beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deaths"@en .

aat:300152010 a skos:Concept ;
    skos:definition "One of the natural colorants extracted from madder roots and other Rubiaceae family plants. Purpurin forms a brilliant red color when mordanted with aluminum salts. It is not considered a permanent artists pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purpurin"@en .

aat:300152022 a skos:Concept ;
    skos:definition "Documents issued by the pope to a religious community or individual on matters of discipline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal briefs"@en .

aat:300152044 a skos:Concept ;
    skos:definition "Particular types of formal documents issued by the pope and sealed with a bulla (a round, usually leaden seal) or sealed with a red-ink imprint of the device on the bulla. Papal bulls were originally issued by the pope for many kinds of public communication, but since the 15th century have been reserved only for particular types of solemn written communication in which the pope refers to himself as \"episcopus servus servorum Dei,\" meaning \"Bishop, Servant of the Servants of God.\" Scholars may use the term to describe any elaborate historical papal document issued in the form of a decree, privilege, and sometimes in the form of a letter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulls"@en .

aat:300152219 a skos:Concept ;
    skos:definition "General term for pigments comprising any of various earthy oxides, often but not always tending toward yellow in color. Ocher pigments may be natural or synthetic. All ochers are very durable, inert, and lightfast. They have been used since ancient times as permanent pigments in all types of paint media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ocher"@en .

aat:300152257 a skos:Concept ;
    skos:definition "Designates multistory apartment or commercial buildings lacking elevators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walk-ups"@en .

aat:300152319 a skos:Concept ;
    skos:definition "Wells driven into rock from which petroleum is obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil wells"@en .

aat:300152327 a skos:Concept ;
    skos:definition "Wells sunk to extract water from a zone of saturation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water wells"@en .

aat:300152334 a skos:Concept ;
    skos:definition "Wells excavated by hand tools or dredging machinery as distinguished from ones put down by drills or augers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dug wells"@en .

aat:300152367 a skos:Concept ;
    skos:definition "Small books or pamphlets, usually cheaply printed and containing such texts as popular tales, treatises, ballads, or nursery rhymes, formerly peddled by chapmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapbooks"@en .

aat:300152373 a skos:Concept ;
    skos:definition "Children's primers consisting typically of a sheet of parchment or layer of paper mounted on a thin wooden board and protected by a sheet of transparent horn and having on it the alphabet and other rudiments such as the digits and often the Lord's Prayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornbooks"@en .

aat:300152441 a skos:Concept ;
    skos:definition "Events demonstrating grateful or happy satisfaction or honor, marked by festivities, refraining from ordinary business, or other deviations from accustomed routine. For events serving specifically to call someone or something to remembrance, use \"commemorations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celebrations"@en .

aat:300152583 a skos:Concept ;
    skos:definition "Naturally occurring material from which mineral can be extracted; the term is generally but not always used to refer to metalliferous material, and is often modified by the name of the valuable constituent, for example, iron ore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ore"@en .

aat:300152723 a skos:Concept ;
    skos:definition "Parts or components of utilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utilities components"@en .

aat:300153056 a skos:Concept ;
    skos:definition "Organizations that maintain large online bibliographic databases and offer cataloging support and related products to libraries and other customers who access those databases on an online, time-sharing basis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliographic utilities"@en .

aat:300153822 a skos:Concept ;
    skos:definition "A Christian denomination having both Protestant and Catholic aspects that originated with Henry VIII's break with the Roman Catholic Church (ca. 1532-34). As the official state Church of England, the monarch of England is still formally considered its head. While at first it remained mainly Catholic in character, reforms came under Edward IV and Elizabeth I who introduced doctrine that was more Protestant in nature, namely new editions of the Book of Common Prayer and the Thirty-nine Articles. Although an overall attitude of toleration exists in the modern Anglican Church, tension remains between its Protestant and Catholic inclinations as well as with newer liberal and evangelical influences. Anglicanism is based on episcopal authority and parish structure is fundamental to the organization of the church. The term is used with regard to the Church of England; with regard to the Episcopal Church in America, use \"Episcopal.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglican"@en .

aat:300153825 a skos:Concept ;
    skos:definition "Refers to a Protestant denomination centered around the belief that the sacrament of baptism should only be administered to adult members after a personal profession of belief in Jesus Christ. Baptism in this faith is usually done by full immersion. Emphasis is placed on biblical scripture and preaching. The Baptist denomination is primarily derived from early 17th-century England and Wales where it quickly spread although there are some links with the Anabaptists of the 16th century. Baptist churches very rapidly increased in the late 19th century in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baptist"@en .

aat:300153828 a skos:Concept ;
    skos:definition "Protestant denomination in which each member church is self-governing. Although Congregationalists believe that the Christian Church is essentially a gathered community of believers, their important ecumenical contribution is their insistence on the primacy of the local church. The movement came out of the Separatists of the 16th-century English Reformation. Persecution drove the Congregationalists to Holland and the United States (the Pilgrim Fathers in 1620). Emphasis is placed on church meetings, missionary work, and tolerance and freedom of religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Congregationalism"@en .

aat:300153831 a skos:Concept ;
    skos:definition "Autonomous church in the United States that is part of the Anglican Communion; it was formally organized in Philadelphia in 1789 as the successor to the Church of England in the American colonies. In points of doctrine, worship, and ministerial order, the church is descended from and has remained associated with the Church of England. With reference to the Church of England, use \"Anglican.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Episcopal"@en .

aat:300153842 a skos:Concept ;
    skos:definition "Refers to the Protestant body derived from the Reformation of Martin Luther (1483-1546). Lutheran doctrine recognizes three sacraments (baptism, Eucharist, and penance) and centers around the concepts of justification by faith alone and the preisthood of all believers. Like most other Protestant denominations, Lutheranism emphasizes the importance of scripture rather than church authority. The doctrine is based on the Augsburg Confession, the Apology, Luther's two Catechisms, and the Formula of Concord. Lutheran churches first flourished in Scandinavia and Germany, later spreading to other parts of Europe. Lutheranism spread to the United States after the 1740s through immigration and spread to Africa and Asia through Lutheran missionary work in the 19th century. Lutheranism is one of the three main branches of Protestantism (the other two being Anglican and Calvinist), and it is the oldest and largest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lutheran"@en .

aat:300153845 a skos:Concept ;
    skos:definition "Refers to a Protestant denomination that arose out of the 16th-century Anabaptists of Holland and Switzerland, particularly from the so-called Swiss Brethren. The name comes from one of their leaders, Menno Simons, a Dutch priest who consolidated and institutionalized the work begun by the moderate Anabaptists. Mennonite doctrine includes the practice of baptism upon confession of faith and adherence to the Confession of Dordrecht (1632) and the teachings of the New Testament. Mennonites, who are pacifists, have a policy against holding public office. Although Mennonites can be found in many parts of the world, most live in the United States and Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mennonite"@en .

aat:300153848 a skos:Concept ;
    skos:definition "A Protestant denomination emphasizing a close personal relationship with God, the importance of the Holy Spirit, and a strong belief in the historical doctrines of Christianity. A simple and egalitarian form of worship in which ministers and laymen cooperate is advocated, as is work done on behalf of impoverished people. Methodism was started as an evangelical movement within the Church of England by John Wesley in 1739 and it became a separate denomination in 1795. The movement flourished as Wesley and other evangelical leaders traveled in England and to the American colonies. The main Methodist doctrine is laid out in Wesley's sermons, his notes on the New Testament, and his Articles of Religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Methodist"@en .

aat:300153854 a skos:Concept ;
    skos:definition "One of the main Protestant groups that arose out of the 16th-century Reformation. Generally speaking, modern Presbyterian churches trace their origins to the Calvinist churches of the British Isles, the European counterparts of which came to be known by the more inclusive name of Reformed. The term presbyterian also denotes a collegiate type of church government led by pastors and lay leaders called elders or presbyters. Strictly speaking, all Presbyterian churches are a part of the Reformed, or Calvinist, tradition, although not all Reformed churches are presbyterian in their form of government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Presbyterianism"@en .

aat:300154222 a skos:Concept ;
    skos:definition "Consisting of or bounded by curved lines as opposed to straight lines. For furniture pieces having fronts with alternating concave and convex curves, use \"serpentine (shape).\" For arches or moldings composed of flowing, wavelike curves, use \"undulating.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curvilinear"@en .

aat:300154228 a skos:Concept ;
    skos:definition "The branch of forestry concerned with the planning, cultivation, protection, and management of urban forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban forestry"@en .

aat:300154236 a skos:Concept ;
    skos:definition "Groups of sovereign states and their dependencies associated by their own choice and linked with common objectives and interests. For the concept of nations or states, use \"nations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commonwealths"@en .

aat:300154308 a skos:Concept ;
    skos:definition "Those who write, invent, promote, investigate or propound a theory or theories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theorists"@en .

aat:300154314 a skos:Concept ;
    skos:definition "Three-dimensional space within which a structure is permitted to be built on a zoning lot; used especially in relation to zoning regulations concerned with land use and access to light and air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building envelopes"@en .

aat:300154319 a skos:Concept ;
    skos:definition "Settlement areas lying at the periphery of cities or suburbs where urban land uses meet rural land uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban fringes"@en .

aat:300154329 a skos:Concept ;
    skos:definition "Artists who create works in miniature, such as paintings, photographs, furniture, and other objects. For those who paint or draw pictures or other decorative forms in manuscripts, see \"illuminators.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniaturists"@en .

aat:300154331 a skos:Concept ;
    skos:definition "Married men who manage their own households, especially as their principal occupation. The more commonly accepted term for people of either sex performing this duty is the broader \"homemakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "househusbands"@en .

aat:300154337 a skos:Concept ;
    skos:definition "Partners in a marriage relationship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spouses"@en .

aat:300154341 a skos:Concept ;
    skos:definition "Male partners in a marriage relationship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "husbands"@en .

aat:300154343 a skos:Concept ;
    skos:definition "Female partners in a marriage relationship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wives"@en .

aat:300154345 a skos:Concept ;
    skos:definition "The immediate biological descendant of some one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offspring"@en .

aat:300154348 a skos:Concept ;
    skos:definition "Female offspring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daughters"@en .

aat:300154350 a skos:Concept ;
    skos:definition "Male offspring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sons"@en .

aat:300154355 a skos:Concept ;
    skos:definition "Photomechanical prints produced by photolithography in which the printing plate is prepared using a bichromate process, gelatin, and greasy ink, which is held in the characteristic wormlike patterns of cracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collotypes"@en .

aat:300154372 a skos:Concept ;
    skos:definition "Photomechanical prints, usually illustrations, characterized by having tonal gradation simulated by a pattern of small dots that vary in size. They are typically printed from a block in which the tones were broken up into dots of various sizes by the interposition of a glass screen, ruled with fine cross-lines, between the camera and the object, usually another photograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief halftones"@en .

aat:300154382 a skos:Concept ;
    skos:definition "Photomechanical prints produced by the process called photogravure, in which the metal printing plate is prepared using a bichromate process, leaving a gelatin resist of varying thickness. The plate is etched to form cells of varying depth able to hold different amounts of ink. If done with an aquatint grain, use \"photoaquatints.\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogravures"@en .

aat:300154386 a skos:Concept ;
    skos:definition "Photomechanical prints produced by photolithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photolithographs"@en .

aat:300154389 a skos:Concept ;
    skos:definition "Photomechanical prints produced by the process called Woodburytype."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Woodburytypes"@en .

aat:300154397 a skos:Concept ;
    skos:definition "People who are fully grown and developed, commonly considered to be those aged 18 years or older."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adults"@en .

aat:300154679 a skos:Concept ;
    skos:definition "Religious followings that are Christian. Distinguinshed from \"Christian orders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian sects"@en .

aat:300155050 a skos:Concept ;
    skos:definition "The suggestion of three-dimensional character using shading and highlights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modeling"@en .

aat:300155059 a skos:Concept ;
    skos:definition "Bending or twisting out of shape, such as that caused by drying, dampness, or heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warping"@en .

aat:300155077 a skos:Concept ;
    skos:definition "Any of several organic compounds composed of carbon, fluorine, chlorine, and hydrogen. Developed during the 1930s and manufactured under the trade name Freon, CFCs found wide application after World War II as aerosol-spray propellants, refrigerants, solvents, and foam-blowing agents. CFCs have been found to pose a serious environmental threat, greatly contributing to ozone depletion. In the stratosphere, the CFC molecules are broken down by the action of solar ultraviolet radiation and release their constituent chlorine atoms. These then react with the ozone molecules, resulting in their removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chlorofluorocarbon"@en .

aat:300155083 a skos:Concept ;
    skos:definition "Material such as shingle, siding, or flooring, applied as a final surface on or within a structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finishing"@en .

aat:300155098 a skos:Concept ;
    skos:definition "Punches used for making square holes in horseshoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fore punches"@en .

aat:300155103 a skos:Concept ;
    skos:definition "Any material serving as the final treatment or coating of a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finish"@en .

aat:300155110 a skos:Concept ;
    skos:definition "A sect of Islam that emerged in early Islamic history as a political faction that supported the rule of Ali, son-in-law of Muhammad and fourth caliph of the Muslim community. It This branch of Islam advocates the idea of rule in the Muslim world based on lineage; only descendants of Ali could rule. Adherents to this branch of are often associated with militant Islamic fundamentalism. It is distinguished from the larger Sunni branch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shi'a"@en .

aat:300155124 a skos:Concept ;
    skos:definition "Refers to the branch of Islam founded on the central tenet that divine love and knowledge can be attained through direct personal union with Allah. This branch is characterized by an aversion to traditional theological law and reason, advocating, instead, the scheme of antithetical categories to achieve the synthesis of the external and internal, by the establishment of dervish orders that emphasized intense emotionalism and spiritual rapturous states, and by the teaching of the spiritual technique of recitation known as dhikr based on phrases from the Qur'an. The branch is also known for the popularization of its mystical love poetry composed in the Persian, Turkish, and Urdu languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sufism"@en .

aat:300155139 a skos:Concept ;
    skos:definition "A school of Chinese Buddhism, founded by Hui Ssu (515-577 CE) and Chih I (538-597 CE), which emphasizes the importance of the 'Lotus Sutra,' one of the integral scriptures of the Mahayana tradition. The name comes from Mount Tien in China where Hui Ssu lived and lectured. Essential features of T'ien T'ia include the concept of the threefold truth of empty, temporary, and middle, implying that all things are both distinct and part of a whole at the same time. An extension of this concept is the T'ien T'ia belief that all beings, though distinct, share the same Buddha nature and are therefore able to reach Buddhahood eventually. While T'ien T'ia acknowledges all other schools of Buddhism, it sees Buddhism as divided in 5 periods culminating in the 'Lotus Sutra' as the crown of the religion. T'ien T'ia declined in China after the persecutions of 845 CE but became popular in Korea and Japan as Tendai."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "T'ien-T'ai"@en .

aat:300155140 a skos:Concept ;
    skos:definition "The evaluation of building performance in terms of technical and physical aspects of structures after construction, such as structural integrity, mechanical system performance, and properties of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building pathology"@en .

aat:300155148 a skos:Concept ;
    skos:definition "The evaluation of building performance in terms of client needs and goals, including such things as environmental design, comfort levels, and mechanical systems as they affect human occupancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post-occupancy evaluation"@en .

aat:300155207 a skos:Concept ;
    skos:definition "Techniques where images or designs are transferred from one material to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transferring techniques"@en .

aat:300155228 a skos:Concept ;
    skos:definition "Tells (artificial mounds resulting from layers of human habitation) found particularly in the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hüyüks"@en .

aat:300155241 a skos:Concept ;
    skos:definition "Refers to a female sovereign or ruler. It may also refer to certain female members of royal families, typically the wives of princes or the daughters and granddaughters of sovereigns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "princesses"@en .

aat:300155251 a skos:Concept ;
    skos:definition "Refers to people employed by a newspaper or broadcasting company to contribute regular news reports or interpretations from a location distant from the home office. For those people or organizations who communicate with others by correspondence, see \"correspondents (correspondence writers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "correspondents"@en .

aat:300155319 a skos:Concept ;
    skos:definition "Establishing, maintaining, and applying consistent spellings and forms of proper names and terms used as the descriptive and access language for collections of documents and objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authority control"@en .

aat:300155326 a skos:Concept ;
    skos:definition "Lending items from a collection to outside users and keeping records of such loans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circulation"@en .

aat:300155333 a skos:Concept ;
    skos:definition "Changing the representation of data in a database from one form to another, as for instance changing the storage medium, data format, or the code in which the data is held."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data conversion"@en .

aat:300155340 a skos:Concept ;
    skos:definition "Converting to machine-readable form data records from a manual or non-machine-readable file that are not converted in day-to-day processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retrospective conversion"@en .

aat:300155355 a skos:Concept ;
    skos:definition "Providing documents, published or unpublished, in hard copy or microform, upon request, either free of charge or for a fee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "document delivery"@en .

aat:300155365 a skos:Concept ;
    skos:definition "Publishing text or images in electronic machine-readable formats; included are databases, magazines, and other works published online or in other media, current or historical, including magnetic tapes, compact disks, floppy disks, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic publishing"@en .

aat:300155366 a skos:Concept ;
    skos:definition "Investigations to determine the practicability of instituting a larger study, program, or other proposed activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feasibility studies"@en .

aat:300155377 a skos:Concept ;
    skos:definition "Searching, locating, and accessing data from a file, database, book, or other body of material, such as data stored in a database."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information retrieval"@en .

aat:300155390 a skos:Concept ;
    skos:definition "Recording information in order to retain it for subsequent use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information storage"@en .

aat:300155399 a skos:Concept ;
    skos:definition "Examining the content of documents, either textual or pictorial, in order to determine what they are about or of."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject analysis"@en .

aat:300155406 a skos:Concept ;
    skos:definition "In management, the analysis of immediate problems and the projection of future ones that can be met with by the training and development of staff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needs assessment"@en .

aat:300155411 a skos:Concept ;
    skos:definition "Querying a file or collection for items about or representing particular topics, people, or things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject searching"@en .

aat:300155502 a skos:Concept ;
    skos:definition "Methods of decorating glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass decorating techniques"@en .

aat:300155533 a skos:Concept ;
    skos:definition "Persons knowledgeable in a specialized field, particularly people with the special skill or knowledge representing mastery of a particular subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experts"@en .

aat:300155631 a skos:Concept ;
    skos:definition "Photomechanical processes using an intaglio plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intaglio photomechanical processes"@en .

aat:300155632 a skos:Concept ;
    skos:definition "Photomechanical processes in which images are printed from flat surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planographic photomechanical processes"@en .

aat:300155634 a skos:Concept ;
    skos:definition "Photomechanical processes using relief printing surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief photomechanical processes"@en .

aat:300155640 a skos:Concept ;
    skos:definition "A reproductive process used primarily for photographs from the 1880s to the 1950s, utilizing small dots of variable size in relief to reproduce tone in the prints. The process involves re-photographing a photograph through a ruled screen, which creates a negative image made of dots of variable size. A relief halftone block is prepared by printing the negative face down on a copper plate coated with fish glue or bichromated gelatin. The unexposed areas remain soluble after development and are washed away; then the plate is acid etched and used in a printing press. From the end of the 19th century onwards, halftone was the principal means of reproducing photographs in printer's ink where long print runs are required and high quality is not of paramount importance. The principle was first suggested by William Henry Fox Talbot in 1852; it was developed commercially in the 1880s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief halftone"@en .

aat:300155665 a skos:Concept ;
    skos:definition "The points of brightest reflection of light off an object; use also for the areas of brightest value in a picture, whether achieved by brightening or by leaving white areas of the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "highlights"@en .

aat:300155835 a skos:Concept ;
    skos:definition "Transit systems, buses, trains, etc., that run on fixed routes at set times and may be used by any person, either free or subject to a fare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public transit"@en .

aat:300155846 a skos:Concept ;
    skos:definition "Networks or systems that support the public works of a country, state, or region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrastructural systems"@en .

aat:300155852 a skos:Concept ;
    skos:definition "Transit systems comprised of small, automated, self-propelled vehicles, usually with rubber wheels running on concrete rails, within their own separate guideways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal rapid transit"@en .

aat:300155865 a skos:Concept ;
    skos:definition "Public transportation systems that are comprised of freewheeled vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freewheeled transit systems"@en .

aat:300155866 a skos:Concept ;
    skos:definition "Transit systems that utilize buses on fixed routes, running on regular schedules to transport people in or around metropolitan areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bus transit systems"@en .

aat:300155876 a skos:Concept ;
    skos:definition "Designates rail systems operating on private but not necessarily exclusive right of way, at street level or grade separated, generally on electric power, at medium speeds (10-30 miles per hour), and generally making frequent stops at low platforms or directly at grade-level stations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light rail transit"@en .

aat:300155910 a skos:Concept ;
    skos:definition "Light rail transit in which cable cars or short trains are used to climb a steep incline by having vehicles raised or lowered by cables, simultaneously lowering or raising a second train on a parallel track in such a way that the two are counterbalanced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funicular railways"@en .

aat:300155914 a skos:Concept ;
    skos:definition "Tells (artificial mounds resulting from layers of human habitation) in Persia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tepes"@en .

aat:300155931 a skos:Concept ;
    skos:definition "Settlements whose inhabitants depend solely or chiefly on a single employer who also owns a substantial portion of the settlement's real estate and housing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "company towns"@en .

aat:300155942 a skos:Concept ;
    skos:definition "Designates industrial settlements purposely built by factory owners to attract workers to isolated or otherwise undesirable locations with a minimum of services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory villages"@en .

aat:300156034 a skos:Concept ;
    skos:definition "Free-wheeled transit systems consisting of buslike vehicles, whose power comes from overhead cables to which the trolleybuses are attached, and of routes that intermingle with general street traffic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trolleybus systems"@en .

aat:300156041 a skos:Concept ;
    skos:definition "Designates alternative nonrail transit systems, such as car pools, dial-a-rides, jitneys, and taxis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paratransit"@en .

aat:300156045 a skos:Concept ;
    skos:definition "Rapid rail transit systems linking suburban districts with central city terminals; generally not operating on exclusive rights of way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commuter railroads"@en .

aat:300156059 a skos:Concept ;
    skos:definition "Transit systems, usually of low average speed (under 15 miles per hour) and making frequent stops, located locally within portions of cities, towns, or neighborhoods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local transit"@en .

aat:300156065 a skos:Concept ;
    skos:definition "May include rail transit or free-wheeled systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban transit systems"@en .

aat:300156135 a skos:Concept ;
    skos:definition "Those who practice the curing of disease my manipulating the human body, particularly the spine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiropractors"@en .

aat:300156142 a skos:Concept ;
    skos:definition "Practitioners of nursing, especially those licensed or registered by the valid authorities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nurses"@en .

aat:300156146 a skos:Concept ;
    skos:definition "Licensed persons who assist others to regain or maintain mobility after disease or injury through a variety of means, most often based on physical exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical therapists"@en .

aat:300156270 a skos:Concept ;
    skos:definition "Religion of ancient India based in the more ancient Vedism. It is characterized by a strong veneration for the priestly class, the Brahmans, devotional worship (bhakti), and the popularity and prominence of the individual deities, Siva and Vishnu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brahmanism"@en .

aat:300156290 a skos:Concept ;
    skos:definition "European noblewomen holding a duchy, or who are the wives or widows of dukes, ranking highest in the peerage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duchesses"@en .

aat:300156319 a skos:Concept ;
    skos:definition "Nonmetallic element with symbol Se and atomic number 34, obtained chiefly as a by-product in copper refining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selenium"@en .

aat:300156332 a skos:Concept ;
    skos:definition "A compound of sulfur with another element (usually denoted by a qualifying term). Sulfide is used to describe any of three types of chemical compounds that contain sulfur: organic sulfides, inorganic sulfides, and phosphine sulfides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfide"@en .

aat:300156496 a skos:Concept ;
    skos:definition "In the United States, lawyers appointed or elected by a city or county as full-time, official defenders to represent financially disadvantaged citizens in criminal cases at public expense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public defenders"@en .

aat:300156801 a skos:Concept ;
    skos:definition "Large lathes used for turning heavy work such as locomotive and railroad car wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great wheel lathes"@en .

aat:300156904 a skos:Concept ;
    skos:definition "Benchplanes of intermediate length, usually 18 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fore planes"@en .

aat:300157059 a skos:Concept ;
    skos:definition "Tools used to smooth the surface of a hole or finish holes which have been drilled in either wood or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reamers"@en .

aat:300157134 a skos:Concept ;
    skos:definition "Small hand tools with a handle and a slightly bent bifurcated end for removing tacks or nails. For devices with jaws used for similar purposes, use \"nail pullers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tack pulls"@en .

aat:300157169 a skos:Concept ;
    skos:definition "Distinct vegetation landscapes dominated by trees, often used for grazing or hunting but not for timber or cultivation; for tracts of land with trees often acting as barriers or boundaries but otherwise minimally utilized, use \"woods;\" for timber-producing land or unmanaged wilderness of dense growth, use \"forests (cultural landscapes).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodlands"@en .

aat:300157246 a skos:Concept ;
    skos:definition "Refers to the religious and philosophical beliefs dominant in South India and based on the worship of the deity Siva as the supreme god. The primary doctrine of this religion is the devotional book of hymns called, Tirumurai, composed by Saiva saints from the fifth to the ninth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sivaism"@en .

aat:300157258 a skos:Concept ;
    skos:definition "Refers to the Indian religion that blends together Islamic and Hindu elements, founded by Nanak Sikhs, disciples of Nanak and his nine successors known as the Ten Gurus, in the Punjab region of India in the late 15th century. Its characteristic principles include the idea that there is one God, who is not represented by idols or images; the individual's responsibility in leading an obedient life dominated by prayer and the reading of the Granth; and the striving for transmigration where the individual exists in communion with God. Prominent features of this belief system are the lack of a professional priesthood and the eligibility of adults of either sex to conduct religious ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sikhism"@en .

aat:300157265 a skos:Concept ;
    skos:definition "Refers to the form of Hinduism that emerged from the cult of Vasudeva-Krishna. It is founded on the worship of the god Vishnu and of his incarnations, principally Rama and Krishna. The religion features an emphasis on devotional worship (bhakti) in which the ultimate goal of the devotee is to transcend the cycle of birth and death, with the help of divine grace, in order to join Vishnu in spiritual communion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vaisnavism"@en .

aat:300157276 a skos:Concept ;
    skos:definition "A Christian sect that arose in the mid-17th century in England and the American colonies, advocating direct inward apprehension of God, emphasizing the immediacy of Christ's teaching and guidance, and rejecting outward rites and an ordained ministry. The Quaker system of church government centers around the monthly meeting. The group has a long tradition of opposing war and actively working for peace. Quakerism represents the extreme left wing of the 17th-century Puritan movement. Despite the fact that the term \"Quaker\" was probably originally derisive, it is used by the Quakers themselves today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quaker"@en .

aat:300157289 a skos:Concept ;
    skos:definition "A Protestant denomination with evangelical beliefs stressing a Christ-centered philosophy and advocating non-violence. The Moravians believe strongly in missionary activity and, because hymns are important to Moravian worship, they printed the first Protestant hymnal in 1501. Its roots are found in an association of Brethren in Bohemia in 1457; this group was driven out of Bohemia in 1722 and they reformed in Saxony under the name 'Moravian.' The movement spread across Europe where it was influenced by pietism and later, in 1732, it was established in North America, where most of its current members reside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moravian"@en .

aat:300157309 a skos:Concept ;
    skos:definition "School of Tantric Buddhism in China. Its name is derived from the Indian Sanskrit word \"mantra\" meaning 'mystical world.The work of Shubhakarasimha brought about Chen-Yen in China in 716 CE and it was expanded by others such as Amoghavajra (705-774). Although it gained imperial favor for a time, it never became extremely popular in China. Instead, it flourished in Japan after Kukai brought back some Chen-Yen rituals and texts after his 804 trip to China; Kukai was responsible for founding the Shingon school of Chen-Yen in his native Japan. Chen-Yen received an infusion of life from Tibet during the Yuan dynasty (1279-1368) but the surviving school is as much Tibetan as it is Chinese and the intrinsic quality of Chen-Yen has declined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chen-Yen"@en .

aat:300157335 a skos:Concept ;
    skos:definition "Refers to the religious movement that emerged in Persia in the third century, founded by Mani the 'Apostle of Light' as an ecumenical and universal belief system integrating ideas from Buddhism, Christianity, Hinduism, Taoism, Islam, and Judaism. The religious movement is generally considered a type of Gnosticism, a system based on the attainment of salvation through knowledge of spiritual truth. It advocates self-knowledge and inner illumination as a defense against succumbing to the evil world of matter and as a path to salvation. Highly dualistic in philosophy, this movement is characterized by the belief in the antithetical substances of Light and Dark, Spirit and Matter, and Good and Evil. The religious community is divided into the elect, who embrace the rigorous, ascetic lifestyle, and into the hearers, who support the elect through works. Essentials of this religion include sacramental rites, almsgiving, fasting, confession, and the singing of hymns and the recitation of scriptural canon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manichaeism"@en .

aat:300157388 a skos:Concept ;
    skos:definition "Forests under supervision of a national government.These are tracts intended for purposes of conservation of water, plant and wildlife, and public recreation. In the United States, national forests are administered by the Forest Service in the Department of Agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national forests"@en .

aat:300157402 a skos:Concept ;
    skos:definition "Forests of cold-tolerant evergreen conifers with needle-like leaves, such as pine, fir, and spruce, located between 50 and 60 degrees north latitudes in the broad belt of Eurasia and North America, including Siberia, Scandinavia, Alaska, and Canada. They are characterized by seasons divided into short, moist, and moderately warm summers and long, cold, and dry winters. The length of the growing season in boreal forests is 130 days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boreal forests"@en .

aat:300157460 a skos:Concept ;
    skos:definition "Organizations that provide instruction and practice of fine arts, crafts, performing arts, or other physical discipline. In the context of the visual and decorative arts, refers to groups comprising a master artist or architect and his or her assistants. A studio typically includes a number of assistants and pupils, who were usually talented or adept artists who were honing their skills under the direction of the master. The term is typically applied to groups active in the 17th century and later. The meaning of the term overlaps with \"workshops (organizations),\" although there is often a subtle distinction in usage: \"Workshops (organizations)\" typically refers to groups active prior to the mid-17th century, where the emphasis is on organized collaboration, smooth teamwork, a division of labor, and where apprentices are learning a trade rather than being trained as \"artists\" in the modern sense of the term. \"Studios (organizations)\" typically refers to later groups in which the master artist or architect took on pupils rather than apprentices, and the emphasis of the pupil was on honing his native artistic skills rather than on learning a trade. The phrases \"studio of\" or \"workshop of\" are often used to signify a work produced by persons in an artist's studio or workshop, but without the direct participation of the master's hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studios"@en .

aat:300157724 a skos:Concept ;
    skos:definition "Study of religion using the methods and theories of anthropology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropology of religion"@en .

aat:300157767 a skos:Concept ;
    skos:definition "Systematically examining records in a file or collection for the purpose of locating specific data or records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "searching"@en .

aat:300157782 a skos:Concept ;
    skos:definition "In collections management, the act by which a library, museum, documentation center, archive, or other collection receive materials, including purchase, gift, exchange, or any other means. For the methods by which acquisitions are made, see narrrower contexts of \"methods of acquisition.\" The act of obtaining an asset or object by any means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acquisition"@en .

aat:300157797 a skos:Concept ;
    skos:definition "A dry, nonchemical photocopying process in which an electrostatic image remains after exposure and is developed by the deposition of toner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xerography"@en .

aat:300157803 a skos:Concept ;
    skos:definition "Creation of images by alteration to the electrical properties of the senstitive material as a result of the action of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrophotography"@en .

aat:300157838 a skos:Concept ;
    skos:definition "Use with regard to photography in war for the purposes of historical documentation. For military applications of photography, such as for mapping or training, use \"military photography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "war photography"@en .

aat:300157897 a skos:Concept ;
    skos:definition "Photomechanical process in which an intaglio plate is produced by the deposition of metal ions by electrical action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogalvanography"@en .

aat:300157920 a skos:Concept ;
    skos:definition "Refers to various photomechanical processes that use a daguerreotype to make the printing plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etched daguerreotype process"@en .

aat:300157950 a skos:Concept ;
    skos:definition "In oil painting, altering the pervading color by an overall glaze or scumble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toning"@en .

aat:300157968 a skos:Concept ;
    skos:definition "Generally used for processes of preparing a printing surface on a zinc plate, either for lithography or etched for letterpress printing. When possible, use two expressions: the specific process term, such as \"lithography,\" and \"zinc\" plus \"printing plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zincography"@en .

aat:300158008 a skos:Concept ;
    skos:definition "Method of obtaining a glossy surface on collodion prints by pressing them between rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnishing"@en .

aat:300158053 a skos:Concept ;
    skos:definition "Chisels that have a tapering hollow tang to receive a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socket chisels"@en .

aat:300158157 a skos:Concept ;
    skos:definition "Lathes designed especially for turning locomotive and railroad car wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel lathes"@en .

aat:300158250 a skos:Concept ;
    skos:definition "Plane figures having four angles and four sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrilaterals"@en .

aat:300158836 a skos:Concept ;
    skos:definition "Sense of ease and satisfaction of bodily wants, with freedom from pain and anxiety."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comfort"@en .

aat:300158845 a skos:Concept ;
    skos:definition "Devices in the form of a handle with jaws and an extendable shank, used for pulling nails out of wood. For handtools with a forked end used for similar purposes, use \"tack pulls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail pullers"@en .

aat:300159060 a skos:Concept ;
    skos:definition "Two-dimensional geometrical configurations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plane figures"@en .

aat:300159126 a skos:Concept ;
    skos:definition "Office furniture that is a hybrid of cabinet and desk manufactured by Wooton and Company in Indianapolis in the latter part of the 19th century. These are characterized by two locking doors that themselves carry drawers and compartments for storage. When opened, a fall extends to create a writing surface facing an interior of ranged compartments and drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wooton cabinet office secretaries"@en .

aat:300159130 a skos:Concept ;
    skos:definition "Desks invented by William S. Wooton in 1875, manufactured by the Wooten Desk Company, and characterized by either a flat or slanted writing surface and a single or double pedestal base; the base contains a hinged or pivoted caselike section which, when opened, reveals dozens of slots, shelves, and pigeonholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotary desks"@en .

aat:300159910 a skos:Concept ;
    skos:definition "Refers generally to any naturally occurring or manufactured building units composed of concrete, glass, stone, or other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry units"@en .

aat:300159932 a skos:Concept ;
    skos:definition "Complexes of schools, usually ranging from kindergarten through high school or two-year college, that draw students from a metropolitan area and are intended to minimize the effects of segregation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational parks"@en .

aat:300160008 a skos:Concept ;
    skos:definition "Divisions of states that elect representatives to the state legislature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legislative districts"@en .

aat:300160031 a skos:Concept ;
    skos:definition "Mining method in which surface soil and rock are removed in successive strips to reveal minerals beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strip mining"@en .

aat:300160084 a skos:Concept ;
    skos:definition "Refers generally to associations of persons carrying on commercial or industrial enterprises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "companies"@en .

aat:300160106 a skos:Concept ;
    skos:definition "Thin sheet metal used chiefly for wrapping, insulation, electrical applications, and as an ornamental surface treatment. For extremely thin sheet metal used exclusively for applied decoration, use \"leaf (metal).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foil"@en .

aat:300160118 a skos:Concept ;
    skos:definition "Groups of two or more persons contractually associated as joint principals in business. For business enterprises considered in law as legal persons, use \"corporations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partnerships"@en .

aat:300160279 a skos:Concept ;
    skos:definition "In the context of furniture, refers to cutting or shaping the edge or end of a material to form an angle that is not a right angle. In other contexts, prefer \"beveling.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamfering"@en .

aat:300160357 a skos:Concept ;
    skos:definition "Hotel or club employees who escort guests to rooms, assist them with luggage, and run errands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellpeople"@en .

aat:300160390 a skos:Concept ;
    skos:definition "Persons officially entrusted with guarding and keeping things, such as property, artifacts, or records, or with custody or guardianship of people, such as prisoners, inmates, or wards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "custodians"@en .

aat:300160648 a skos:Concept ;
    skos:definition "Blunt, rounded steel points used to lay open the ground when making an image on an etching plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etching needles"@en .

aat:300160680 a skos:Concept ;
    skos:definition "Gouges with a deep channel; used for making flutings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluters"@en .

aat:300160813 a skos:Concept ;
    skos:definition "Photomechanical prints of the mid-19th century made by an etched daguerreotype process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etched daguerreotype prints"@en .

aat:300160867 a skos:Concept ;
    skos:definition "Prints made by the process of photogalvanography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogalvanographs"@en .

aat:300161281 a skos:Concept ;
    skos:definition "Relatively buildings or sets of buildings containing a relatively small number of retail units with interconnecting walkways, generally having only one or a small number of stories, often located outdoors in a suburban area, and typically arranged in a single row facing a shared parking lot. For larger, more elaborate structures housing a larger number of retail units, often under a roof with indoor walkways, use \"shopping malls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shopping plazas"@en .

aat:300161338 a skos:Concept ;
    skos:definition "Adjustable apparatus, often made of metal, used to secure wood near the end of the workbench; usually used during planing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench stops"@en .

aat:300161360 a skos:Concept ;
    skos:definition "Branch of engineering that deals with the construction and operation of the power plant and other mechanical equipment of seagoing craft, docks, and harbor installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine engineering"@en .

aat:300161406 a skos:Concept ;
    skos:definition "General term for adzes used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking adzes"@en .

aat:300161407 a skos:Concept ;
    skos:definition "General term for augers used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking augers"@en .

aat:300161409 a skos:Concept ;
    skos:definition "Files, usually made of metal, intended for smoothing or othewise working wooden materials or objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking files"@en .

aat:300161413 a skos:Concept ;
    skos:definition "Tools that act as levers in order to force or pry open, out, or up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prying tools"@en .

aat:300161432 a skos:Concept ;
    skos:definition "Awls used to make holes in leather, typically to facilitate sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworking awls"@en .

aat:300161433 a skos:Concept ;
    skos:definition "Lathes used for working wooden materials or objects. In its early form, woodworking lathes consisted of two holding cemers with the suspended stock being rotated by an endless rope belt; one person pulled on the rope while a second person cut while holding a hand lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking lathes"@en .

aat:300161434 a skos:Concept ;
    skos:definition "Scissors, which comprise a pair of pivoted blades attached to handles, designed for tasks involved in sewing, including cutting thread and clipping seams. For scissors to cut lengths of fabric, use \"sewing shears.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing scissors"@en .

aat:300161435 a skos:Concept ;
    skos:definition "Reamers used for woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking reamers"@en .

aat:300161464 a skos:Concept ;
    skos:definition "Files, usually of metal, used for filing metal materials or objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking files"@en .

aat:300161475 a skos:Concept ;
    skos:definition "Hand-operated boring devices made up of a central steel tube containing a shaft. At one end is a handle and at the other a bit-holding chuck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand drills"@en .

aat:300161488 a skos:Concept ;
    skos:definition "The process of putting in place any apparatus, system, condition, object or set of objects in position for service, use, or viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "installing"@en .

aat:300161491 a skos:Concept ;
    skos:definition "Drills used to enlarge holes for the reception of a bolt or nut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterbores"@en .

aat:300161494 a skos:Concept ;
    skos:definition "Clamp-shaped tools used to put pressure on a drill when boring through metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drill clamps"@en .

aat:300161500 a skos:Concept ;
    skos:definition "Tools with a rounded bevel on both sides, and a cutting edge which is square or skewed; used for paring and smoothing wood turned on a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turning chisels"@en .

aat:300161505 a skos:Concept ;
    skos:definition "Pieces of hardwood against which a workman presses his breast in operating a breast drill or similar tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breastplates"@en .

aat:300161511 a skos:Concept ;
    skos:definition "High-melting brazing alloy, typically brass with silver, requiring temperatures ranging between 750 and 900 degrees Celsius to melt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard solder"@en .

aat:300161516 a skos:Concept ;
    skos:definition "Iron rods which terminate in a flat surface on which is a device or letter set in relief; used after heating to mark livestock, tools, or manufactured goods with indelible evidence of ownership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brands"@en .

aat:300161524 a skos:Concept ;
    skos:definition "Various iron braces used in conjunction with a drill when exceptional drilling pressure is needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smiths' braces"@en .

aat:300161533 a skos:Concept ;
    skos:definition "Small pocket knives, usually with only one blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penknives"@en .

aat:300161538 a skos:Concept ;
    skos:definition "Large pocket knives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackknives"@en .

aat:300161543 a skos:Concept ;
    skos:definition "Large pocket knives whose blade or blades fold or shut into the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clasp knives"@en .

aat:300161546 a skos:Concept ;
    skos:definition "Tools used in turning to remove irregularities in the wood quickly and to smooth hollows. Commonly used by wheelwrights to turn wheel hubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turning gouges"@en .

aat:300161551 a skos:Concept ;
    skos:definition "Gouges sharpened both outside and inside; the larger outside bevel is used for hardwoods, and the smaller inside bevel for softwoods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carving gouges"@en .

aat:300161561 a skos:Concept ;
    skos:definition "Files with rounded edges and tapered or parallel sides; used to clean and shape the spaces between gear wheel teeth and pinions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint files"@en .

aat:300161567 a skos:Concept ;
    skos:definition "Coarse rounded single-cut files used for cleaning out mortises and for shaping the bed and throat of a plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "float files"@en .

aat:300161571 a skos:Concept ;
    skos:definition "General-purpose tapered steel files used essentially in metalwork but also in working hardwood surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat files"@en .

aat:300161576 a skos:Concept ;
    skos:definition "Flat metal plates with one or more holes with a cutting edge for threading screws, pipes, or rods by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw plates"@en .

aat:300161581 a skos:Concept ;
    skos:definition "Cone-shaped or slightly tapered taps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taper taps"@en .

aat:300161586 a skos:Concept ;
    skos:definition "Wood or iron tools used to cut threads on wood screws or pegs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw boxes"@en .

aat:300161591 a skos:Concept ;
    skos:definition "Cylinder-shaped taps used for cutting internal screw threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plug taps"@en .

aat:300161595 a skos:Concept ;
    skos:definition "Name given to a group of saws which have a handle at one end and a wide blade which tapers in width from handle to toe; hand saws are never power saws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand saws"@en .

aat:300161596 a skos:Concept ;
    skos:definition "The discipline focused on selecting and organizing the surface coverings, draperies, furniture, and furnishings of architectural interiors, usually of existing spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior decoration"@en .

aat:300161603 a skos:Concept ;
    skos:definition "Thin, flat metal blades, bands, or stiff plates with cutting teeth along the edges that are attached to handles to create a saw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saw blades"@en .

aat:300161606 a skos:Concept ;
    skos:definition "Bookbinder's burnishers used heated to polish leathers, crush down leather grains, and eliminate blisters on cloth covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polishing irons"@en .

aat:300161609 a skos:Concept ;
    skos:definition "Planes with two blades which are used to cut a tongue. One of the blades may be covered so that the remaining blade cuts a groove into which the tongue will fit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tongue-and-groove planes"@en .

aat:300161620 a skos:Concept ;
    skos:definition "Planes with a notch in the center; used to cut a center ridge, or tongue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tongue planes"@en .

aat:300161638 a skos:Concept ;
    skos:definition "Prints composed using only black and white, usually black ink on white paper. For black-and-white photographs, use \"black-and-white prints (photographs).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-and-white prints"@en .

aat:300161700 a skos:Concept ;
    skos:definition "Short planes, often coffin-shaped; the last plane used on a wood surface to give it the utmost degree of smoothness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoothing planes"@en .

aat:300161706 a skos:Concept ;
    skos:definition "Planes with an adjustable fence which exposes the blade in proportion to the desired width of the cut; used to cut grooves on the side nearest the worker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving fillister planes"@en .

aat:300161711 a skos:Concept ;
    skos:definition "Planes with projecting arms, used to cut grooves on the side farthest from the worker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash fillister planes"@en .

aat:300161716 a skos:Concept ;
    skos:definition "Planes used to produce ovolo or quarter-round moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ovolo planes"@en .

aat:300161720 a skos:Concept ;
    skos:definition "Planes with the profile of ogee molding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ogee planes"@en .

aat:300161724 a skos:Concept ;
    skos:definition "Persons employed in keeping the premises of an apartment building, office, or other building clean and free of refuse, tending the heating system, and making minor repairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "janitors"@en .

aat:300161730 a skos:Concept ;
    skos:definition "Hollow planes which produce smooth long cylindrical surfaces; used to make stair rails, carriage-wheel spokes, large furniture moldings for case pieces, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forkstaffs"@en .

aat:300161742 a skos:Concept ;
    skos:definition "Planes whose blades cut a quarter of a circle, or a cove; used for cutting the under edge of a table leaf or to produce decorative moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cove planes"@en .

aat:300161747 a skos:Concept ;
    skos:definition "Planes as large as 5 to 6 feet in length which are turned upside down and mounted on legs. The wood to be planed is slid over the plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coopers' jointer planes"@en .

aat:300161751 a skos:Concept ;
    skos:definition "Pincers which remove old horseshoes before re-shoeing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farriers' pincers"@en .

aat:300161754 a skos:Concept ;
    skos:definition "Long-headed wooden mallets used for driving caulking irons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caulking mallets"@en .

aat:300161760 a skos:Concept ;
    skos:definition "Blades of various shapes without a cutting edge that are used for applying putty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "putty knives"@en .

aat:300161767 a skos:Concept ;
    skos:definition "Keys for adjusting the nuts and bolts of a bedstead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed keys"@en .

aat:300161772 a skos:Concept ;
    skos:definition "Clamps used to hold wire while it is filed and hammered into a rivet head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire vises"@en .

aat:300161775 a skos:Concept ;
    skos:definition "Vises used in metal- and woodworking for holding small objects or for grasping nuts or bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand vises"@en .

aat:300161785 a skos:Concept ;
    skos:definition "Tongs primarily used by clock- and watchmakers to hold pins, arbors, or other small objects while they are being filed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding tongs"@en .

aat:300161793 a skos:Concept ;
    skos:definition "Wheels consisting of layers of fabric impregnated with abrasive and adhesive for polishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polishing spindles"@en .

aat:300161798 a skos:Concept ;
    skos:definition "Blocks, usually of wood, that either are cut to print an image, whether on paper, fabric, or other material, or that support other materials that form the actual printing surface. Use a more specific term when possible. For metal printing surfaces, prefer \"printing plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing blocks"@en .

aat:300161802 a skos:Concept ;
    skos:definition "Pieces of linoleum, often mounted on a wooden block on which is cut an image to be printed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linoleum blocks"@en .

aat:300161807 a skos:Concept ;
    skos:definition "Wooden blocks used to hold metalworking stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holding blocks"@en .

aat:300161811 a skos:Concept ;
    skos:definition "Blocks having different-sized grooves for supporting wire while it is being filed. One example is hardened steel and cylindrical in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filing blocks"@en .

aat:300161823 a skos:Concept ;
    skos:definition "Strong heavy waist-high tables on which the work of mechanics, machinists, and carpenters is performed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workbenches"@en .

aat:300161830 a skos:Concept ;
    skos:definition "Axes used for lopping or cutting away the branches of trees after felling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lopping axes"@en .

aat:300161835 a skos:Concept ;
    skos:definition "Augers which terminate in a screw worm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral augers"@en .

aat:300161848 a skos:Concept ;
    skos:definition "Devices, usually metal, comprising vertical elements and often a horizontal bar, supported by legs, and used to support logs in a fireplace. May be used with a \"fireplace grate.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "andirons"@en .

aat:300161851 a skos:Concept ;
    skos:definition "Curved adzes with a strong blade; used for hollowing the insides of wheel rims or the curved parts of coach frames. May also be used for hammering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheelwrights' adzes"@en .

aat:300161859 a skos:Concept ;
    skos:definition "Short handled tools where the handle is often wedged into the head to lean sharply towards the blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coopers' adzes"@en .

aat:300161876 a skos:Concept ;
    skos:definition "Tools used to cut small toothed wheels, called pinions, by placing the tool over a metal rod and tapping it downwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinion cutters"@en .

aat:300161880 a skos:Concept ;
    skos:definition "Persons who keep official records, especially the officials at educational institutions who maintain students' personal and academic records, issue grade reports, and mail out calendars and other official publications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registrars"@en .

aat:300161881 a skos:Concept ;
    skos:definition "Ladles used in steelmaking to manage the volume differences between melting furnaces and the caster tundishes, which are shallow refractory-lined basins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melting ladles"@en .

aat:300161886 a skos:Concept ;
    skos:definition "Pieces of wood or another material, used to receive the blow of a hammer or other device for the purpose of producing sound. An example is the disk-shaped striking block used with a gavel (ceremonial mallet) in courts, as when a judge bangs a gavel to start a session."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking blocks"@en .

aat:300161891 a skos:Concept ;
    skos:definition "In blacksmithing and other metalworking, blocks of various designs used to guide or receive the impact of a punch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch blocks"@en .

aat:300161894 a skos:Concept ;
    skos:definition "Tools consisting of a long drill bit which pierces a spool-shaped object; used in conjunction with a bow to drill holes in brass, iron, and steel. Most often used by clock- and watchmakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel drills"@en .

aat:300161903 a skos:Concept ;
    skos:definition "Large clamps used to hold together the frame and panels of house doors, interior wall paneling, or the paneled doors of furniture pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel clamps"@en .

aat:300161907 a skos:Concept ;
    skos:definition "Clamps used in chair making to force slats to retain a curved shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slat-bending clamps"@en .

aat:300161912 a skos:Concept ;
    skos:definition "Saws used in large mills in which a heavy blade is tensioned in a sash frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gate saws"@en .

aat:300161919 a skos:Concept ;
    skos:definition "Upright supports or guides of a machine that are fastened at the bottom only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lathe puppets"@en .

aat:300161926 a skos:Concept ;
    skos:definition "Molding planes in matched pairs used for making rule joints on the flaps of folding tables or desks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table planes"@en .

aat:300161932 a skos:Concept ;
    skos:definition "Tools that consist of a bent elastic rod with ends connected by a string; used for various purposes, as for giving reciprocating motion to a drill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bows"@en .

aat:300161951 a skos:Concept ;
    skos:definition "Groups of people that have relationships based around descent, marriage, or ritual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinship groups"@en .

aat:300161986 a skos:Concept ;
    skos:definition "The application of paint to a surface primarily for protection or to apply a general color. For the application of pigments to a surface to create an expressive or communicative image, use \"painting (image-making).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting"@en .

aat:300162025 a skos:Concept ;
    skos:definition "Study and collection of postage stamps, revenue stamps, stamped envelopes, postmarks, post cards, covers, and similar materials relating to postal or fiscal history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philately"@en .

aat:300162030 a skos:Concept ;
    skos:definition "Refers to governors of large territories who have other, subordinate governors under their jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governors general"@en .

aat:300162051 a skos:Concept ;
    skos:definition "Trowels which are the exact reverse of inside corner trowels in construction; used for plastering outside corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outside corner trowels"@en .

aat:300162056 a skos:Concept ;
    skos:definition "The art or practice of taking and/or processing photographs whose images are composed of gray tones, black, and white, and sometimes one hue, which may result from toning or aging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-and-white photography"@en .

aat:300162075 a skos:Concept ;
    skos:definition "Chisels used in the debarking of timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barking chisels"@en .

aat:300162082 a skos:Concept ;
    skos:definition "Frameworks functioning as temporary supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horses"@en .

aat:300162086 a skos:Concept ;
    skos:definition "Ladders with sidepieces of rope and rungs of rope, wood, or metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rope ladders"@en .

aat:300162096 a skos:Concept ;
    skos:definition "Groups of people whose members have one or more social characteristics in common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social groups"@en .

aat:300162106 a skos:Concept ;
    skos:definition "Firemen's scaling ladders consisting of a pole with crossbars for rungs and a hook at one end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hook ladders"@en .

aat:300162111 a skos:Concept ;
    skos:definition "Any tools which are operated by and guided by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand tools"@en .

aat:300162118 a skos:Concept ;
    skos:definition "Monks who hold the office of superior of a monastery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbots"@en .

aat:300162124 a skos:Concept ;
    skos:definition "The process of stregthening or stabilizing by use of an inner layer, usually using paper or fabric. In conservation and other contexts, the process of reinforcing a work by applying a paper or fabric lining with an adhesive, sewing, or another method; examples include lining applied to the support of a paper or canvas support of a work of art, or the lining applied to a garment as an inner layer of cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lining"@en .

aat:300162131 a skos:Concept ;
    skos:definition "Those who perform on or play musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instrumentalists"@en .

aat:300162133 a skos:Concept ;
    skos:definition "Persons concerned with the acquisition, arrangement, description, preservation, interpretation, and making available for reference archival materials, which are public records and documents of historical significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archivists"@en .

aat:300162135 a skos:Concept ;
    skos:definition "General term used to group concepts revolving around human conventions and social practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culture-related concepts"@en .

aat:300162261 a skos:Concept ;
    skos:definition "Occurrences that are caused by and take place in the natural world, as opposed to events that are caused by human actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural events"@en .

aat:300162353 a skos:Concept ;
    skos:definition "Spanish Renaissance variation of vargueños, used for storing papers. They are usually smaller than vargueños and lack a writing lid; generally they have turned feet and may be bound with iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papeleras"@en .

aat:300162359 a skos:Concept ;
    skos:definition "Refers to recesses, in effect chapels, used for preparation of the Eucharist by the clergy, and located on the north side of the bema in Greek churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protheses"@en .

aat:300162376 a skos:Concept ;
    skos:definition "Photographic processes in which collodion is the binder. A silver halide is the light-sensitive agent, and the process may be used to produce positives (ambrotypes, tintypes) or negatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collodion processes"@en .

aat:300162380 a skos:Concept ;
    skos:definition "Vertical supports for a piece of furniture, typically used for longer supports of modified cylindrical, columnar, or pier-like form. For shorter vertical supports, use \"feet (object components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legs"@en .

aat:300162382 a skos:Concept ;
    skos:definition "Water or gas supply pipes which lead from supply sources to the buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service pipes"@en .

aat:300162386 a skos:Concept ;
    skos:definition "Heat pumps whose operation is at times supplemented by solar collector-storage systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar-assisted heat pumps"@en .

aat:300162391 a skos:Concept ;
    skos:definition "Generally, textile that is woven, felted, knit, pounded, or otherwise made into a flat piece. For textile in the form of continuous strands made from filaments of fiber by reeling, spinning, twisting, or throwing, see \"yarn.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth"@en .

aat:300162449 a skos:Concept ;
    skos:definition "Branch of aerospace engineering dealing with the design, development, and production of aircraft that function within the atmosphere, and their related systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical engineering"@en .

aat:300162474 a skos:Concept ;
    skos:definition "A thick paper formed from multiple sheets adhered with an adhesive then pressed to produce a hard, stiff board. Pasteboard was used for book boards and playing cards in Europe from the early 16th to the late 18th centuries. It is now primarily used for making boxes and cartons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pasteboard"@en .

aat:300162479 a skos:Concept ;
    skos:definition "Unplanned development of, usually commercial, buildings built side by side or adjoining, and stretching in continuous strings along both sides of a roadway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon development"@en .

aat:300162489 a skos:Concept ;
    skos:definition "Materials remaining after a part is taken, separated, or designated; or after the completion of a process or reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "residue materials"@en .

aat:300162511 a skos:Concept ;
    skos:definition "Water that contains a large amount of salt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt water"@en .

aat:300162526 a skos:Concept ;
    skos:definition "Water that does not contain a large amount of salt, as in ponds, lakes or streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fresh water"@en .

aat:300162547 a skos:Concept ;
    skos:definition "People whose profession is the selection and organization the surface coverings, draperies, furniture, and furnishings of architectural interiors, usually of existing spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior decorators"@en .

aat:300162562 a skos:Concept ;
    skos:definition "Photomechanical prints made by the dye transfer process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dye transfer prints"@en .

aat:300162569 a skos:Concept ;
    skos:definition "Dances involving rhythmical tapping of the toes and heels, in which a dancer wears shoes fitted with heel and toe taps that sound out audible beats when striking the floor or any other hard surface. Tap dances originated in the United States through the fusion of several ethnic percussive dances, primarily African tribal dances and Scottish, Irish, and English clog dances, hornpipes, and jigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tap dances"@en .

aat:300162658 a skos:Concept ;
    skos:definition "Cement made with lime mortar and pozzolana or other material containing active silica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pozzolan cement"@en .

aat:300162666 a skos:Concept ;
    skos:definition "Timber sawn into thin pieces, and having considerable extent of surface on two sides, with the other two sides being narrow. Usually reserved for rectangular pieces having much greater length than breadth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood board"@en .

aat:300162668 a skos:Concept ;
    skos:definition "Rough board reclaimed from barn structures or that resembles this either through natural weathering or manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barnboard"@en .

aat:300162676 a skos:Concept ;
    skos:definition "In ancient Greek architecture, the flat tile or pantile with a decorative nosing used on the eaves (with antefixes) as a substitute for the sima (terracotta or marble gutter of a building). In modern construction, tile, usually shorter or plainer than other roofing tile, used in the first course of tile along the eaves of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eaves tile"@en .

aat:300162681 a skos:Concept ;
    skos:definition "The tiles that bridge the open joint between rows of tiles in a roof. For example, in ancient Greek architecture, the roof tile (imbrex) of terracotta or marble, usually semicircular (Laconian) or triangular (Corinthian) in section, bridged the open joint between two rows of flat tiles or pantiles (tegulae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cover tile"@en .

aat:300162791 a skos:Concept ;
    skos:definition "Mechanical equipment specifically used for cutting materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting machinery"@en .

aat:300162792 a skos:Concept ;
    skos:definition "Equipment specifically used for boring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drilling equipment"@en .

aat:300162793 a skos:Concept ;
    skos:definition "Tools used for boring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drilling tools"@en .

aat:300162799 a skos:Concept ;
    skos:definition "Tools used for upkeep, such as cleaning tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maintenance tools"@en .

aat:300162800 a skos:Concept ;
    skos:definition "Mechanical equipment used for upkeep, such as equipment used for cleaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maintenance machinery"@en .

aat:300162803 a skos:Concept ;
    skos:definition "Equipment specifically used in the process of making images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image-making equipment"@en .

aat:300162811 a skos:Concept ;
    skos:definition "Refers to the penultimate stage in the formal process that leads to the canonization of a saint in the Roman Catholic Church. At this stage, the pope grants the title 'Blessed' to a Roman Catholic of exemplary faith and life who is considered worthy of public veneration after his or her death. After this stage, such a person can be locally honored. If there is evidence of two miracles then the canonization can proceed, leading to the person becoming a universally recognized saint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beatifications"@en .

aat:300162812 a skos:Concept ;
    skos:definition "Official placements of deceased persons within the canon of saints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canonizations"@en .

aat:300162813 a skos:Concept ;
    skos:definition "Christian sacrament or ritual consisting of the anointment with oil or chrism, along with other activities such as the sprinkling of holy water, reception of confession, blessings, and recitation of prayer. Originally in the Roman church it was administered by a priest to a person in imminent danger of dying. The modern sacrament is usually called the \"sacrament of the sick\" or other such name, and is available for all who are seriously ill or elderly, not only those who are at the point of death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extreme unction"@en .

aat:300162816 a skos:Concept ;
    skos:definition "Holidays established by legal authority and characterized by legal restrictions on work and transaction of official business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal holidays"@en .

aat:300162819 a skos:Concept ;
    skos:definition "Equipment and tools specifically used in metalwork, such as in the act or process of shaping things out of metal or of decorating with metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking equipment"@en .

aat:300162822 a skos:Concept ;
    skos:definition "In the Western Christian church, a period of penitential preparation for Easter that includes 40 weekdays extending from Ash-Wednesday to Easter-eve, observed as a time of fasting and penitence in imitation of Jesus Christ's fasting in the wilderness. In Eastern churches Lent begins Monday seven weeks before Easter and ends the Friday 9 days before Easter. This \"Great Lent\" allows that Saturdays and Sundays are relaxed fast days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lent"@en .

aat:300162823 a skos:Concept ;
    skos:definition "Holidays that are observed throughout a nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national holidays"@en .

aat:300162825 a skos:Concept ;
    skos:definition "Religious season in Islam, the ninth month of the Islamic year, marking the time during which the Qur'an was revealed to the Prophet. Muslims are enjoined to fast from dawn to dusk during this month and the observance of the Ramadan fast is one of the five 'pillars,' or basic duties, of Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ramadan"@en .

aat:300162826 a skos:Concept ;
    skos:definition "Sales of miscellaneous articles, old or new, as items contributed to raise money for charity, of unclaimed goods at a wharf or warehouse, or of odds and ends of merchandise at a shop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rummage sales"@en .

aat:300162867 a skos:Concept ;
    skos:definition "Courses of travel, having a beginning and end in space and time, and and taken as a whole. Extended to excursions, expeditions or tours."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "journeys"@en .

aat:300162872 a skos:Concept ;
    skos:definition "Refers to double pictures of the same scene that produce the effect of three dimensionality when viewed through a stereoscope. They were first envisioned in 1832 by the English physicist Charles Wheatstone, who described this as a uniquely photographic art form, since a draftsman could not draw two scenes in exact perspective from viewpoints separated only 2 1/2 inches, which is the normal distance between human eyes necessary for the three-dimensional effect. Wheatstone's mirror stereoscope was not practical for use with photographs, and the invention was not popular until the 1850s, when Sir David Brewster, a Scottish scientist, designed a simpler viewing instrument. The introduction of the collodion process, which simplified exposure and printing techniques, allowed three-dimensional photographs to become a popular craze. They may be daguerreotypes, negatives, or other forms of photographs. For images in the form of photographic prints on cards, use the more specific term \"stereographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereoscopic photographs"@en .

aat:300162902 a skos:Concept ;
    skos:definition "General term for any machinery used in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking machinery"@en .

aat:300162917 a skos:Concept ;
    skos:definition "Swimming pools usually found in the palaestra of large bathhouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natationes"@en .

aat:300162918 a skos:Concept ;
    skos:definition "General term for photographic equipment specifically used for viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photograph viewing equipment"@en .

aat:300162919 a skos:Concept ;
    skos:definition "Viewers in which pairs of stereoscopic images are mounted and appear as a single, three-dimensional image when viewed. Use for objects designed to view individual stereo cards, usually photographic prints. For the devices used to view wheels of mounted transparencies, marketed as a children's toy from the mid-20th century, use \"stereoviewers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereoscopes"@en .

aat:300162982 a skos:Concept ;
    skos:definition "Structures used in the context of railroad transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rail transportation structures"@en .

aat:300163013 a skos:Concept ;
    skos:definition "German municipal government buildings also housing public function rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rathäuser"@en .

aat:300163018 a skos:Concept ;
    skos:definition "Italian municipal buildings, often combining the housing of the local ruler and the offices of the community government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palazzi pubblichi"@en .

aat:300163023 a skos:Concept ;
    skos:definition "Having an empty space or cavity within; not filled in with matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow"@en .

aat:300163024 a skos:Concept ;
    skos:definition "Having an interior filled with matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid"@en .

aat:300163033 a skos:Concept ;
    skos:definition "Geometric figures having three dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solids"@en .

aat:300163037 a skos:Concept ;
    skos:definition "GGeometric solid figure having two ends comprising equal and parallel circles, and the intervening curved surface is such as would be traced out by a straight line moving parallel to itself with its ends in the circumferences of these circles. If the direction of this straight line is perpendicular to the planes of the circles, the figure is a right cylinder; if not, an oblique cylinder. In modern geometry, the term is used for the solid generated by a straight line moving always parallel to itself and describing any fixed curve, not necessarily a circle. Used in common language to refer to hollow forms as well as solid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinders"@en .

aat:300163048 a skos:Concept ;
    skos:definition "Plane curves of two equal branches, produced when cones are cut by planes that make a larger angle with the base than the side of the cone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyperbolas"@en .

aat:300163052 a skos:Concept ;
    skos:definition "Symmetrical open plane curves formed by the intersection of a cone with a plane parallel to its side, resembling the path of a projectile under the action of gravity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parabolas"@en .

aat:300163093 a skos:Concept ;
    skos:definition "Fretsaws having a very deep frame and a short blade; used for inlay work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buhl saws"@en .

aat:300163100 a skos:Concept ;
    skos:definition "Photographs produced from a frame of motion picture film. For other photographs of the action, actors, or production of a motion picture, use \"film stills.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame enlargements"@en .

aat:300163107 a skos:Concept ;
    skos:definition "Framed bow saws with a light blade and handles at both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web saws"@en .

aat:300163111 a skos:Concept ;
    skos:definition "Saws with a reversible handle and a blade which has teeth on either side; one set is fine and the other coarse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet saws"@en .

aat:300163114 a skos:Concept ;
    skos:definition "Plane curves that generally wind around a point while moving ever farther from the point. Many kinds of spiral are known, including the ancient Greek Archimedean spiral, described in On Spirals (ca. 225 BCE), and the logarithmic or equiangular spiral first described by René Descartes in 1638. The curves are observed in nature, and humans have used them in machines and in ornament, notably architecture, for example, the whorl in an Ionic capital. Prefer \"scrolls (motifs)\" or \"scrollwork\" for more complex forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirals"@en .

aat:300163117 a skos:Concept ;
    skos:definition "The two portions of a sphere cut off by a plane through its center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemispheres"@en .

aat:300163119 a skos:Concept ;
    skos:definition "Polyhedrons having one face (the base) that is a polygon of any number of sides, and the other faces are triangles with bases forming the sides of the polygon meet at a common vertex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramids"@en .

aat:300163124 a skos:Concept ;
    skos:definition "Plane figures that are halves of a circle divided by the diameter, or the halves of a circle's circumference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semicircles"@en .

aat:300163126 a skos:Concept ;
    skos:definition "Plane figures consisting of half of an ellipse bisected by one of its diameters (usually the transverse)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semiellipses"@en .

aat:300163133 a skos:Concept ;
    skos:definition "Screws with a hexagonal recess to receive an Allen wrench."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Allen screws"@en .

aat:300163137 a skos:Concept ;
    skos:definition "Type of compass saw with teeth at the heel edge that are set out at 90 degrees to the blade; used to cut corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square hole saws"@en .

aat:300163143 a skos:Concept ;
    skos:definition "Surface-mounted locks in addition to the main lock on a door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary rim locks"@en .

aat:300163146 a skos:Concept ;
    skos:definition "Special clips used on the back of gypsum board in certain applications, as in some demountable partitions, to hold the board in place by insertion into slots or other receptacles in the framing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back clips"@en .

aat:300163150 a skos:Concept ;
    skos:definition "Threaded nuts which help to create a watertight joint, as on the long thread of a pipe connector, and whose one dished side accepts a grommet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back nuts"@en .

aat:300163154 a skos:Concept ;
    skos:definition "Spherically shaped gate valves which provide a very tight shut-off for fluids in a high-pressure piping system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball valves"@en .

aat:300163155 a skos:Concept ;
    skos:definition "Valves controlled by a float in a chamber, such as the float valve in a tank for a toilet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "float valves"@en .

aat:300163156 a skos:Concept ;
    skos:definition "Float valves incorporating a spherical float; used to control the height of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball cocks"@en .

aat:300163165 a skos:Concept ;
    skos:definition "Diffusion transfer process in which color dyes migrate from the negative to a sealed film unit and residual materials used in the internal development are rendered harmless and invisible once processing is complete. Generic name for the Polaroid SX-70 (TM) process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internal dye diffusion transfer process"@en .

aat:300163174 a skos:Concept ;
    skos:definition "Any of a variety of small narrow planes 1 to 5 inches in length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumb planes"@en .

aat:300163188 a skos:Concept ;
    skos:definition "Heavy hand shears used for cutting bolts in two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolt clippers"@en .

aat:300163202 a skos:Concept ;
    skos:definition "The mechanism in a lock holding the bolt until operated by a key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumblers"@en .

aat:300163204 a skos:Concept ;
    skos:definition "Devices that transfer heat between two physically separated fluids; generally consists of a cylindrical shell with longitudinal tubes; one fluid flows inside, the other outside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat exchangers"@en .

aat:300163213 a skos:Concept ;
    skos:definition "Systematic bodies of ideas on economics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economic ideologies"@en .

aat:300163214 a skos:Concept ;
    skos:definition "Refers to English earthenware that is cream-colored with a transparent lead glaze dating from the second half of the 18th century; it also refers to imitations of this English ware. It was originally developed by Staffordshire potters, who were experimenting to find a substitute for Chinese porcelain. Around 1750 they created a a fine white earthenware with a rich yellowish glaze; the ware had a light body and clean glaze, making it desirable for domestic ware. At the time, the cream color was considered a fault; as an improvement, Wedgwood introduced a white to bluish white product called \"pearlware\" in 1779. It was produced for nearly a century. Creamware, however, continued to be made throughout the 19th century and later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creamware"@en .

aat:300163223 a skos:Concept ;
    skos:definition "Equipment used for the making of glass, or the working on or with glass or glass articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassworking equipment"@en .

aat:300163224 a skos:Concept ;
    skos:definition "General term for the tools, equipment, and supplies used to facilitate the preparation of materials made from fibers and woven fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile working equipment"@en .

aat:300163250 a skos:Concept ;
    skos:definition "A type of portland cement whose chemical composition has been altered so that little heat is produced during hardening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-heat cement"@en .

aat:300163288 a skos:Concept ;
    skos:definition "Equipment and machinery powered by hydraulics, which is the use of the motion of water or other liquids in motion to transmit energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic equipment"@en .

aat:300163290 a skos:Concept ;
    skos:definition "Equipment used for cutting materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting equipment"@en .

aat:300163292 a skos:Concept ;
    skos:definition "Objects, devices, and equipment used to produce or add heat in order to raise the temperature of an object, material, or surrounding environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating equipment"@en .

aat:300163295 a skos:Concept ;
    skos:definition "Woven figured textile with one warp and one weft in which the pattern is formed by a contrast of binding systems, and appears on the face and the back in reverse positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damask"@en .

aat:300163297 a skos:Concept ;
    skos:definition "Usually power-driven machines used for washing clothes and linens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washing machines"@en .

aat:300163322 a skos:Concept ;
    skos:definition "Equipment used for working wood into desired forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking equipment"@en .

aat:300163324 a skos:Concept ;
    skos:definition "Tools designed to carve, plane, or otherwise shape or work pieces of wood or wooden objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodworking tools"@en .

aat:300163332 a skos:Concept ;
    skos:definition "General term for woodworking tools used for striking, such as mallets and hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood-striking tools"@en .

aat:300163338 a skos:Concept ;
    skos:definition "Cords, strings, or other lines which, when used in conjunction with plumb bobs suspended from one end, are used to determine verticality or to aid in locating points on the ground during surveying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumb lines"@en .

aat:300163343 a skos:Concept ;
    skos:definition "The materials that are applied to a support in the making of a work of art, such as ink on paper or oil paint on canvas; often a particular technique or techniques are closely associated with the media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "media"@en .

aat:300163347 a skos:Concept ;
    skos:definition "Information indicator for any combination of a variety of materials plus the associated techniques, used in the making of a single work of art. In printmaking, use when more than one technique, such as both etching and engraving, are used in one print. For the painting technique of laying oil paint glazes over tempera paint or tempera paint glazes over oil paint, use \"mixed technique.\" For a general term for a variety of artistic or communicative forms used in a given work or works, such as contemporary works that employ both sculpture and music, use \"multimedia.\" For the concept that certain contemporary works merge known art forms to inaugurate a new type, use \"intermedia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed media"@en .

aat:300163365 a skos:Concept ;
    skos:definition "Sexuality characterized by romantic love or sexual desire toward members of the opposite sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heterosexuality"@en .

aat:300163397 a skos:Concept ;
    skos:definition "Sexuality characterized by romantic love or sexual desire toward members of either sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bisexuality"@en .

aat:300163404 a skos:Concept ;
    skos:definition "Sources intended primarily for consultation rather than for consecutive reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reference sources"@en .

aat:300163405 a skos:Concept ;
    skos:definition "Refers to the condition of urban areas characterized by general deterioration in the quality of existing buildings and infrastructural systems, often caused by adverse economic, environmental, or zoning forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban blight"@en .

aat:300163411 a skos:Concept ;
    skos:definition "Literary, oral, and performing arts genre dealing with or offering opinions or conjectures upon facts and realities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonfiction"@en .

aat:300163423 a skos:Concept ;
    skos:definition "Designing clothing, accessories, and ensembles intended to create an appearance characteristic of a particular period, person, place, or thing, especially (but not exclusively) for theatrical performances. For the design of clothing and accessories for personal wear, use \"fashion design.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume design"@en .

aat:300163428 a skos:Concept ;
    skos:definition "Persons engaged in designing clothing, accessories, and ensembles intended to create an appearance characteristic of a particular period, person, place, or thing, especially (but not exclusively) for theatrical performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume designers"@en .

aat:300163440 a skos:Concept ;
    skos:definition "Administration by local or regional authorities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local government"@en .

aat:300163451 a skos:Concept ;
    skos:definition "General term for science concepts related to heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-related concepts"@en .

aat:300163556 a skos:Concept ;
    skos:definition "Ladders which consist of a pair of side rails, usually parallel, connected together with cleats that are joined to the side rails at regular intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-cleat ladders"@en .

aat:300163592 a skos:Concept ;
    skos:definition "A property usually acquired by applying a finish to fabric or other substance that prevents the spread of flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire resistance"@en .

aat:300163597 a skos:Concept ;
    skos:definition "General term for engineering concepts that are related to the stress that physical structures can withstand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural analysis concepts"@en .

aat:300163601 a skos:Concept ;
    skos:definition "The pressure exerted by water, which is equal to the product of the density and depth at which the measurement is taken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water pressure"@en .

aat:300163605 a skos:Concept ;
    skos:definition "Building material comprising large, irregular blocks of stone fitted closely together. For masonry of this type laid of stones cut with straight sides that fit closely together, use \"polygonal masonry.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclopean masonry"@en .

aat:300163618 a skos:Concept ;
    skos:definition "Machines designed to smooth wood and remove saw or lathe marks and other imperfections; ranging in size from hand-held to large drums or belts capable of surfacing a full-size panel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanders"@en .

aat:300163622 a skos:Concept ;
    skos:definition "Documents describing the recurring records of an organization or administrative unit, specifying those records to be preserved as having archival value, and authorizing, on a continuing basis and after the lapse of specified retention periods and the occurrence of specified actions or events, the destruction of the remaining records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "records schedules"@en .

aat:300163644 a skos:Concept ;
    skos:definition "Books in which official copies of deeds are collected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deed books"@en .

aat:300163650 a skos:Concept ;
    skos:definition "Records schedules governing specified series of records common to several or all government agencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general records schedules"@en .

aat:300163664 a skos:Concept ;
    skos:definition "Documents that give expression to a legal act or agreement, for the purpose of creating, securing, modifying, or terminating a right, or for the purpose of furnishing evidence of a right. For documents having legal relevance in general, use \"legal documents.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal instruments"@en .

aat:300163674 a skos:Concept ;
    skos:definition "Documents that contain graphics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic document genres"@en .

aat:300163697 a skos:Concept ;
    skos:definition "Characteristics of building elevations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building elevation attributes"@en .

aat:300163706 a skos:Concept ;
    skos:definition "General term for artistic approaches, practices, or doctrines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forms of expression"@en .

aat:300163707 a skos:Concept ;
    skos:definition "Concepts that are found in more than one discipline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multidisciplinary concepts"@en .

aat:300163729 a skos:Concept ;
    skos:definition "Describes buildings, particularly classic Greek and Roman temples and buildings like them in structure, that have columns at the front and rear but none along the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphiprostyle"@en .

aat:300163730 a skos:Concept ;
    skos:definition "Describes buildings, particularly classic Greek and Roman temples and buildings like them in structure, having ten columns at one or both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decastyle"@en .

aat:300163731 a skos:Concept ;
    skos:definition "Describes buildings, particularly classic Greek and Roman temples and buildings like them in structure, that have two columns in front between antae, the piers formed by the extension and thickening of the side walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distyle in antis"@en .

aat:300163734 a skos:Concept ;
    skos:definition "Describes buildings, particularly classic Greek and Roman temples and buildings like them in structure, having a row or rows of nine columns at one or both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enneastyle"@en .

aat:300163739 a skos:Concept ;
    skos:definition "Describes buildings, particularly classic Greek and Roman temples and buildings like them in structure, having a row or rows of eight columns at one or both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octastyle"@en .

aat:300163741 a skos:Concept ;
    skos:definition "Of a building, particularly an ancient Greek or Roman temple, that has columns at the front but none at the rear and sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prostyle"@en .

aat:300163742 a skos:Concept ;
    skos:definition "Of buildings, particularly classic Greek and Roman temples and buildings like them in structure, having a row or rows of four columns at one or both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetrastyle"@en .

aat:300163743 a skos:Concept ;
    skos:definition "Brick whose nominal dimensions are 2 2/3 by 4 by 12 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norman brick"@en .

aat:300163757 a skos:Concept ;
    skos:definition "The process of making stable, or maintaining stability of an object, such as a ship or airplane, often by means of a stabilizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stabilizing"@en .

aat:300163807 a skos:Concept ;
    skos:definition "Built works whose purpose is centered around the housing of, and the dissemination of, information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information handling facilities"@en .

aat:300163812 a skos:Concept ;
    skos:definition "Persons atypical due to disabilities or giftedness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exceptional people"@en .

aat:300163820 a skos:Concept ;
    skos:definition "Those endowed with some natural faculty, ability, or talent. The talent may be a general intellectual one or a quite specific talent such as music or chess playing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gifted"@en .

aat:300163825 a skos:Concept ;
    skos:definition "People having no sight or very limited vision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people unable to see"@en .

aat:300163830 a skos:Concept ;
    skos:definition "People who do not have the functional use of the sense of hearing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people unable to hear"@en .

aat:300163832 a skos:Concept ;
    skos:definition "People unable to produce oral speech or to produce oral speech that is easily understood by others, due to physical, biological, or psychological condition, or because of choice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people unable to speak"@en .

aat:300163843 a skos:Concept ;
    skos:definition "Persons having no permanent place of residence or shelter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homeless persons"@en .

aat:300163862 a skos:Concept ;
    skos:definition "People in the transitional stage of development between childhood and adulthood, commonly considered as those of 13 to 17 years of age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adolescents"@en .

aat:300163881 a skos:Concept ;
    skos:definition "Climate characterized by very little precipitation and extreme hot to cold temperatures, with great changes in daily temperature except in coastal areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desert climate"@en .

aat:300163886 a skos:Concept ;
    skos:definition "Climate characterized by little precipitation in all seasons and consistently cold temperatures, with brief, chilly summers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polar climate"@en .

aat:300163894 a skos:Concept ;
    skos:definition "Climate characterized by variable, moderate temperatures, intermediate between polar and tropical types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate climate"@en .

aat:300163896 a skos:Concept ;
    skos:definition "Climate characterized by high temperatures and heavy precipitation, either throughout the year or alternating with dry seasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tropical climate"@en .

aat:300163920 a skos:Concept ;
    skos:definition "Networks of small light bars of wood, metal, or other material crossing at regular intervals, usually diagonally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lattices"@en .

aat:300163924 a skos:Concept ;
    skos:definition "Wood that has undergone a process that uses vacuum and pressure to force chemical preservatives into the wood. The goal of process is to protect the wood from termites or other insects and fungal decay; the wood has been found to contribute to environmental pollution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure-treated wood"@en .

aat:300163929 a skos:Concept ;
    skos:definition "Construction consisting of upright posts or stakes interwoven with twigs or tree branches and plastered with a mixture of clay and straw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wattle and daub"@en .

aat:300163933 a skos:Concept ;
    skos:definition "Material, such as plaster or mud, used with wattle as a building material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daub"@en .

aat:300163966 a skos:Concept ;
    skos:definition "Defined areas in which the stationing or concentrating of military forces, or the retention or establishment of military installations of any description, is prohibited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demilitarized zones"@en .

aat:300164014 a skos:Concept ;
    skos:definition "Distinguished from \"log cabins\" by being generally larger and better built of carefully hewn timbers neatly notched at the corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log houses"@en .

aat:300164023 a skos:Concept ;
    skos:definition "Towers used for electronic communication over long distances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telecommunications towers"@en .

aat:300164025 a skos:Concept ;
    skos:definition "Wood of any of several trees belonging to the genus Fraxinus, having distinctive growth rings with very large open pores beside small, tight pores. The wood is light in color, dense, elastic, and having a straight grain that is moderately durable but susceptible to insect attack and moisture degradation. The tough, heavy timber is used for ladders, tool handles, oars, poles, gymnasium equipment, and hockey sticks because it produces a smooth surface that rarely splinters. Ash was also popular for furniture (especially Colonial pieces), wheels, and carriage frames, and is used for decorative veneers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ash"@en .

aat:300164026 a skos:Concept ;
    skos:definition "General term for vernacular forms of construction using entire logs. One of the oldest known methods of construction, log construction has been used for dwellings, fortifications, churches, bridges. Log walls are produced by stacking logs and filled with mud or other insulating materials. Structures made of logs are characterized by corner joints that interlock with a cross-lap connection, or with dovetailing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log construction"@en .

aat:300164032 a skos:Concept ;
    skos:definition "Building technique using short firewood-sized logs set in piles perpendicular to the length of walls and held in place by mortar or wooden frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stovewood construction"@en .

aat:300164046 a skos:Concept ;
    skos:definition "Substance obtained from the fermentation of corn mash, used as a solvent for paints, fats, waxes, oils and resins; it is a stronger solvent than ethanol and can dissolve portions of oxidized oil films. It is also used in the manufacture of dyes, plastics, lacquers, rayon, and detergents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butanol"@en .

aat:300164058 a skos:Concept ;
    skos:definition "Hydraulic structures used for draining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drainage structures"@en .

aat:300164059 a skos:Concept ;
    skos:definition "Food processing plants specifically used to process meat, from slaughter to packaging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat processing plants"@en .

aat:300164060 a skos:Concept ;
    skos:definition "Areas reserved for the training and rapid deployment of military forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military installations"@en .

aat:300164113 a skos:Concept ;
    skos:definition "Military training camps for new recruits, where intensive and harshly disciplined training is carried out. Originally the term referred to United States Marine Corps training, but is extended to any United States Military initial training camp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boot camps"@en .

aat:300164117 a skos:Concept ;
    skos:definition "Military camps where army soldiers are stationed when training for, or fighting, a war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "army camps"@en .

aat:300164121 a skos:Concept ;
    skos:definition "Facilities established or used to transform, alter, or treat a product or other thing by using a special process or technique, including operating upon the thing mechanically or chemically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processing plants"@en .

aat:300164125 a skos:Concept ;
    skos:definition "Structures, establishments, or facilities, whether ownership is public or private, that are used by the public, examples include establishments that provide goods and services to the general public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public accommodations"@en .

aat:300164139 a skos:Concept ;
    skos:definition "Buildings housing businesses that sell animals to be kept as pets, as well as accessories and food for pets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pet shops"@en .

aat:300164207 a skos:Concept ;
    skos:definition "Refers to the final climactic day of Carnival festivities, occurring on the last day before Lent. In some places, such as New Orleans, the term is applied to the entire Carnival season."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mardi Gras"@en .

aat:300164243 a skos:Concept ;
    skos:definition "High-rise buildings usually in tower form with apartments or offices grouped around a central circulation core; use when distinguishing from \"slab blocks\" which are more like rectangular slabs in form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point blocks"@en .

aat:300164250 a skos:Concept ;
    skos:definition "Microwave communications stations capable of boosting an incoming weak signal for retransmission on another frequency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repeater stations"@en .

aat:300164259 a skos:Concept ;
    skos:definition "Portable stools with joined legs which, when opened, are bound by girth webbing which serves as a seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing stools"@en .

aat:300164260 a skos:Concept ;
    skos:definition "Adjustable highchairs which may be converted into a carriage or walker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage chairs"@en .

aat:300164268 a skos:Concept ;
    skos:definition "Term applied in the 1860s to furniture produced by firms which employed leading designers and architects. Designs tended toward simple forms with hand-carved and painted decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art furniture"@en .

aat:300164274 a skos:Concept ;
    skos:definition "Chairs of various form designed to be used in a seaside recreational context. These are often designed to be lightweight, incorporating fabric or wicker, and may have the ability to be broken down and carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach chairs"@en .

aat:300164276 a skos:Concept ;
    skos:definition "Trade term for mattresses made of half wool and half hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French mattresses"@en .

aat:300164278 a skos:Concept ;
    skos:definition "Seats suspended from a steel framework by links or springs; generally used on porches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gliders"@en .

aat:300164286 a skos:Concept ;
    skos:definition "Maps showing the existing uses of a given area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land use maps"@en .

aat:300164310 a skos:Concept ;
    skos:definition "Wall mirrors having hooks for hanging hats and other small items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hall mirrors"@en .

aat:300164316 a skos:Concept ;
    skos:definition "Benches, generally without padding and upholstery, often made en suite with chairs or hall mirrors and intended for use in halls and galleries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hall seats"@en .

aat:300164317 a skos:Concept ;
    skos:definition "Adjustable tables, with ledges at the back and sides, used by persons in bed, usually for eating or writing. Also may refer to tables at the side of a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed tables"@en .

aat:300164323 a skos:Concept ;
    skos:definition "Small stands or cabinets with zinc-lined compartments used to store smoking supplies. Distinct from \"smokers\" which are ashtrays mounted on a low pedestal stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoking stands"@en .

aat:300164327 a skos:Concept ;
    skos:definition "Box stools with a china bowl and cover. Use \"commode chairs\" for chairs having a chamber pot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bidets"@en .

aat:300164329 a skos:Concept ;
    skos:definition "Deception beds which fold into a dummy bookcase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookcase beds"@en .

aat:300164332 a skos:Concept ;
    skos:definition "Bookcases having solid, as opposed to glazed, doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book cupboards"@en .

aat:300164337 a skos:Concept ;
    skos:definition "Partitioned cases constructed to hold a specific number of square wine bottles, made especially during the late 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle cases"@en .

aat:300164343 a skos:Concept ;
    skos:definition "Deception beds that fold into dummy cabinets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet beds"@en .

aat:300164347 a skos:Concept ;
    skos:definition "Deception beds that fold into a piece of case furniture that looks like a chiffonier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiffonier beds"@en .

aat:300164351 a skos:Concept ;
    skos:definition "Form of late 19th-century commode chair, often associated with invalids, having a chamber pot concealed within a small cabinet under the seat; such cabinets usually have a door in the back so the chamber pot can be removed without disturbing the patient."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet chairs"@en .

aat:300164357 a skos:Concept ;
    skos:definition "Tables with a circular top that expands on an iron frame to allow eight extra leaves to be inserted. It was patented by Robert Jupe in 1835."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capstan tables"@en .

aat:300164361 a skos:Concept ;
    skos:definition "Small stands with a dished top intended to hold calling cards; of a type made in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card stands"@en .

aat:300164365 a skos:Concept ;
    skos:definition "Cradles with two front wheels for transport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage cradles"@en .

aat:300164367 a skos:Concept ;
    skos:definition "Stands with pegs, hooks, or other devices for hanging hats, often also with places for coats or umbrellas. More elaborate and more likely to be freestanding furniture than \"hat racks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat stands"@en .

aat:300164370 a skos:Concept ;
    skos:definition "Contemporary name for plain dressing or writing tables in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber tables"@en .

aat:300164372 a skos:Concept ;
    skos:definition "Movement of American figurative painting active from the 1920s to the 1940s, committed to the establishment of a genuinely American art by the realistic depiction of contemporary American life and the repudiation of contemporary nonrealist styles introduced by the Armory Show."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American Scene"@en .

aat:300164380 a skos:Concept ;
    skos:definition "Chests of drawers having a full-length mirror on one side and drawers on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheval dressers"@en .

aat:300164386 a skos:Concept ;
    skos:definition "Tall pieces of furniture typically having drawers on one side and a narrow closet or space for hanging clothes on the other. The term originated in the Southern United States, combining the words \"chiffonier\" and \"wardrobe,\" referring to the two functions of the chifforobe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chifforobes"@en .

aat:300164389 a skos:Concept ;
    skos:definition "Tables having semi-circular or \"U\" shaped surfaces, designed for and used while eating meals in large formal dining rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horseshoe dining tables"@en .

aat:300164390 a skos:Concept ;
    skos:definition "Racks on which wet laundry is hung for drying or airing, typically an upright wooden frame standing upon legs, with horizontal bars on which clothes are hung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothes horses"@en .

aat:300164398 a skos:Concept ;
    skos:definition "Large boxes with hinged lids intended for the storage of clothing, often with built-in or removeable trays used as dividers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothes chests"@en .

aat:300164406 a skos:Concept ;
    skos:definition "Small low table for resting glasses on in a domestic environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocktail tables"@en .

aat:300164409 a skos:Concept ;
    skos:definition "Dressing tables fitted with mirrors, compartments for cosmetics, and drawers or cabinets enclosed by doors for the storage of clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commode dressing tables"@en .

aat:300164411 a skos:Concept ;
    skos:definition "Wash basin stands meant to be situated in spaces where walls meet, and that have closed, rather than open support structures, sometimes fitted with doors for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner enclosed basin stands"@en .

aat:300164414 a skos:Concept ;
    skos:definition "Shelves designed to be mounted in the angle where walls meet. Common types are intended to hold small decorative objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner shelves"@en .

aat:300164415 a skos:Concept ;
    skos:definition "Relatively small tables, originally designed to seat customers in ice-cream parlors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream tables"@en .

aat:300164419 a skos:Concept ;
    skos:definition "Upright stands, typically resembling drying racks, with projecting arms or cross bars used to hold clothing in a dressing room or bedroom. The rack is designed so that clothing may be folded across the arms or bars. Pegs may also be included for hanging clothes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costumers"@en .

aat:300164421 a skos:Concept ;
    skos:definition "High stools that are usually one of a row of such stools fixed in front of a counter; often backless and having a revolving seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter stools"@en .

aat:300164425 a skos:Concept ;
    skos:definition "Wash basin stands that have closed, rather than open support structures, sometimes fitted with doors for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enclosed basin stands"@en .

aat:300164429 a skos:Concept ;
    skos:definition "Relatively small and narrow bookcases, often approximately 3 feet wide and 3 feet high, of the type used in the 18th and 19th century mercantile establishments for keeping account books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counting-house bookcases"@en .

aat:300164431 a skos:Concept ;
    skos:definition "Low tables or shelves meant to stand against a wall in the space between two windows, often surmounted with a mirror, and with a rail or shelf enclosing the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enclosed pier tables"@en .

aat:300164456 a skos:Concept ;
    skos:definition "Term generally applied to tables intended for use in kitchens, especially those having an ample work surface and drawers or bins for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen tables"@en .

aat:300164472 a skos:Concept ;
    skos:definition "Folding beds built into cabinets that incorporate shelving for books on either side of a mid-section covered by double doors, and which were intended to be used in a dining room to make an occasional extra bedroom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library press beds"@en .

aat:300164491 a skos:Concept ;
    skos:definition "Stands with a tall upright post and a sliding cross bar which can be adjusted at different heights and bears pins for suspending maps or charts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "map stands"@en .

aat:300164496 a skos:Concept ;
    skos:definition "Low bookcases deliberately designed so as to leave the wall above free for paintings or pier glasses; generally having open shelves or doors with open grilles, instead of solid or silk-paneled doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarf bookcases"@en .

aat:300164504 a skos:Concept ;
    skos:definition "Bedside table with a cabinet integrated beneath the table surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "somnoes"@en .

aat:300164508 a skos:Concept ;
    skos:definition "Small lightweight tiered stands, often folding and portable, intended to be used alongside a table for holding such light foods as muffins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muffin stands"@en .

aat:300164509 a skos:Concept ;
    skos:definition "Desks that resemble spinets, the keyed musical instruments which are closely related to harpsichords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinet desks"@en .

aat:300164515 a skos:Concept ;
    skos:definition "Chairs with adjustable backs, swivel seats, and commonly mounted with castors, designed to be used in the course of office work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office chairs"@en .

aat:300164516 a skos:Concept ;
    skos:definition "Cabinets with the interior divided into nests of small drawers for holding spices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice cabinets"@en .

aat:300164518 a skos:Concept ;
    skos:definition "Miniature cupboards, usually hanging, primarily intended to hold spices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice cupboards"@en .

aat:300164519 a skos:Concept ;
    skos:definition "Tables with very slender supports, sometimes of gate-leg design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spider-leg tables"@en .

aat:300164524 a skos:Concept ;
    skos:definition "Common term for removable stuffed seat cushions in the 17th and 18th centuries; term also seems to have been applied to large padded seats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squabs"@en .

aat:300164527 a skos:Concept ;
    skos:definition "Slant-front desks having a high writing surface, designed at a height to be used while standing; popular in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing desks"@en .

aat:300164529 a skos:Concept ;
    skos:definition "Type of upholstered armchair intended to be used as reading chairs in 19th-century dormitories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student chairs"@en .

aat:300164535 a skos:Concept ;
    skos:definition "Beds for infants that are mounted on pivots that allow for the cradle to swing from side to side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swinging cradles"@en .

aat:300164542 a skos:Concept ;
    skos:definition "Dual-purpose side tables having a hinged top and a front containing a folding bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table beds"@en .

aat:300164547 a skos:Concept ;
    skos:definition "Furniture designed specifically to support analog telephone sets. These usually include compartments or drawers for telephone directories, notepads, or writing utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephone tables"@en .

aat:300164558 a skos:Concept ;
    skos:definition "Drawers or boxes fitted in a larger piece of furniture; frequently found in Medieval chests and sometimes in 16th- and 17th-century cupboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tills"@en .

aat:300164562 a skos:Concept ;
    skos:definition "Tall chests of drawers with a mirror on top; common in late 19th and early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiffoniers"@en .

aat:300164567 a skos:Concept ;
    skos:definition "Chairs which served as models from which to work; frequently with arms or legs showing alternative forms and styles of decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern chairs"@en .

aat:300164579 a skos:Concept ;
    skos:definition "Cabinets with narrow shelves for holding piano rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pianola roll cabinets"@en .

aat:300164581 a skos:Concept ;
    skos:definition "Dining tables, or tables used for other purposes, having pillar and claw supports, with legs jutting from a pillar and with feet terminating into a claw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar and claw dining tables"@en .

aat:300164584 a skos:Concept ;
    skos:definition "Dropleaf tables of the Pembroke stye, having pillar and claw supports, with legs jutting from a pillar or columns, and with feet terminating into a claw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar and claw Pembroke tables"@en .

aat:300164591 a skos:Concept ;
    skos:definition "Chairs that are designed or used to serve as both a chair and a pulpit or lectern in a relgious setting; found in the context of Buddhism, Islam, Christianity, and other religions. Examples are chairs having a tall back surmounted by a lectern, so that the chair could be used as a pulpit at open-air services or worship conducted at local houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preaching chairs"@en .

aat:300164593 a skos:Concept ;
    skos:definition "Furniture consisting of a flat, slablike top mounted on legs, designed specifically to support large radio sets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio tables"@en .

aat:300164594 a skos:Concept ;
    skos:definition "Lightweight chairs, often with upholstered seats, which are meant to be used as informal seating for guests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reception chairs"@en .

aat:300164595 a skos:Concept ;
    skos:definition "Parts of a design reserved for ornament, which include decorations and embellishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornament areas"@en .

aat:300164599 a skos:Concept ;
    skos:definition "Distinct design elements that are plant-derived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant-derived motifs"@en .

aat:300164603 a skos:Concept ;
    skos:definition "Artistic concepts concerned with form, as opposed to content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formal concepts"@en .

aat:300164614 a skos:Concept ;
    skos:definition "Cabinets of varied design intended to store phonograph records. These may incorporate separators or other methods devised to aid organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record cabinets"@en .

aat:300164628 a skos:Concept ;
    skos:definition "Desks on long legs, generally taking the form of a table, with a folding top and writing surface that can enclose a drawer or cubbyholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rising-top writing tables"@en .

aat:300164649 a skos:Concept ;
    skos:definition "Sturdy tables, sometimes fitted with coasters or pockets, generally having a shelf under the top to hold glasses and steins so the top could remain clear for card playing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saloon tables"@en .

aat:300164653 a skos:Concept ;
    skos:definition "Book furniture composed of stackable modules in which the books are housed allowing the user to add more storage as needed. These modules or sections are often fitted with glass doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectional bookcases"@en .

aat:300164655 a skos:Concept ;
    skos:definition "Upholstered armchairs, often with a button-tufted back, having a single piece forming a high sloping back and a concave seat; of a type made in America in the mid-19th to early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sleepy Hollow chairs"@en .

aat:300164657 a skos:Concept ;
    skos:definition "Chairs with compartments for smoking equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoking chairs"@en .

aat:300164673 a skos:Concept ;
    skos:definition "Bidets made to rise out a chest. Use \"portable bidets\" for those with legs made to screw off and tops made to lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling bidets"@en .

aat:300164679 a skos:Concept ;
    skos:definition "Refers generally to three-legged supports of any kind. The word may be applied variously to objects such as stools, tables, light stands, stands for cameras, or pedestals. Ancient, antique, or classical forms are associated with religious or symbolic altars, or sacrificial vessels. The seat of the Delphic oracle was in the form of a tripod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripods"@en .

aat:300164698 a skos:Concept ;
    skos:definition "Low-back chairs with wide seats; intended to be used in the embrasure of a window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window chairs"@en .

aat:300164704 a skos:Concept ;
    skos:definition "Clothes presses flanked with additional drawers and storage areas on either side of the central carcass, coined in the late 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wing clothes presses"@en .

aat:300164726 a skos:Concept ;
    skos:definition "Fixed compensation paid regularly to employees for ongoing work or services, on the basis of periods longer than days. For such compensation paid on an hourly, daily, or piecework basis, use \"wages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salaries"@en .

aat:300164742 a skos:Concept ;
    skos:definition "Refers to members of the lower of the two Houses of Congress, the House of Representatives. They serve four-year terms representing defined districts within the states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Members of the House of Representatives"@en .

aat:300164755 a skos:Concept ;
    skos:definition "Gardens or landscapes designed for low water maintenance by plant selection, planting techniques, and irrigation systems tolerant of low water input."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xeriscapes"@en .

aat:300164762 a skos:Concept ;
    skos:definition "Buildings for repositories devoted to the art, history, and technology of motion pictures, television, and video."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museums of moving images"@en .

aat:300164767 a skos:Concept ;
    skos:definition "Air that contains harmful or poisonous substances within a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor air pollution"@en .

aat:300164777 a skos:Concept ;
    skos:definition "Generally, records of organizations which are vital to the continuity of a business in case of emergency or after a disaster. For public records of life events generated under government or other authority, use \"vital statistics records.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vital records"@en .

aat:300164785 a skos:Concept ;
    skos:definition "Documents certified by notaries that are sealed with a seal or stamp and that are recorded by the notary in a register or protocol permanently maintained for such purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notarial documents"@en .

aat:300164803 a skos:Concept ;
    skos:definition "Restricted to alleyways open only at one end; for larger thoroughfares having access at only one end, use \"dead-end streets\" or \"culs-de-sac.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind alleys"@en .

aat:300164811 a skos:Concept ;
    skos:definition "Houses that are generally two-story, one-room deep, and which have a thin profile. Prominent in England, they became particularly popular in the American mid-Atlantic states from 1700-1915, and symbolized rural prosperity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "I-houses"@en .

aat:300164837 a skos:Concept ;
    skos:definition "Gables at the sides of buildings, not over the front or rear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side gables"@en .

aat:300164838 a skos:Concept ;
    skos:definition "Moldings enriched with a series of starlike, raised pyramidal forms; common especially in Early English Gothic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogtooth moldings"@en .

aat:300164839 a skos:Concept ;
    skos:definition "Pendant ornament, such as on a furniture apron or rail, or within an arch and more loosely hanging than drop tracery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drops"@en .

aat:300164841 a skos:Concept ;
    skos:definition "In Italian cities and towns, open public spaces usually surrounded by buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piazzas"@en .

aat:300164890 a skos:Concept ;
    skos:definition "Records kept by public officials or other persons relating to their official duties, but not necessarily readily available to the public. For private documents belonging to individuals, use \"personal papers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office files"@en .

aat:300164902 a skos:Concept ;
    skos:definition "Stylized ornamental motif used especially in architecture and decorative arts, based on a characteristic Mediterranean plant with jagged leaves, Acanthus spinosus. It was first used by the Greeks in the 5th century BCE on temple roof ornaments, on wall friezes, and on the capital of the Corinthian column, such as at Temple of Olympian Zeus in Athens. Later the Romans used the motif in their Composite order, in which the capital of the column is a three-dimensional combination of spirals resembling rams' horns and full-bodied acanthus leaves. The acanthus leaf has been a popular motif in carved furniture decoration since the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acanthus"@en .

aat:300164923 a skos:Concept ;
    skos:definition "Generally refers to the activity of keeping people and things safe from harm or deterioration. For actions taken to prevent further changes or deterioration in objects, sites, or structures, use \"preservation\". When such actions are taken on buildings or other structures specifically for cultural, aesthetic, or historic reasons, use \"historic preservation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protection"@en .

aat:300164956 a skos:Concept ;
    skos:definition "Motif consisting of three- or four-petal flowers, usually nearly closed over a ball, frequently occurring in hollow moldings in English Gothic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballflower"@en .

aat:300164972 a skos:Concept ;
    skos:definition "Buildings or spaces for museums that are owned or administered by representatives of a nation, or that specializes in exhibitions from a given nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national museums"@en .

aat:300164976 a skos:Concept ;
    skos:definition "Ordinances that establish the permitted uses of the land in a particular district or zone and dictate such things as lot sizes and building placements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoning ordinances"@en .

aat:300164986 a skos:Concept ;
    skos:definition "Motif representing a round stylized rose with the central petals white and the outer petals red, combining a badge of the house of York with one of the house of Lancaster; the traditional floral heraldic emblem of England as adopted by Henry VII. It takes its name and origins from the Tudor dynasty, symbolizing the union of the houses of Lancaster and York in 1485."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tudor rose"@en .

aat:300164992 a skos:Concept ;
    skos:definition "Fluting in which the lower part of each groove is filled with a solid convex form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabled fluting"@en .

aat:300165019 a skos:Concept ;
    skos:definition "Motif particularly associated with a style of Romanesque and Early Gothic capital that is formed of broad, smooth leaf-shapes (typically four in number), unribbed except for a central fold, which curve upward and outward before curling over at the tips where they meet the square or octagonal abacus. The curled tip of the waterleaf may be small and neat or large and bulbous; it usually curves inward towards the abacus, but may occasionally turn outwards. Developed as a fanciful interpretation of the Corinthian order; the names refer to various types of leaves that the motif was thought to resemble: waterleaf plant, lily leaf, and hart's tongue fern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water leaf"@en .

aat:300165028 a skos:Concept ;
    skos:definition "Lines or bands composed of a series of chevrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zigzags"@en .

aat:300165036 a skos:Concept ;
    skos:definition "Ornamental bands decorated with human figures or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoophori"@en .

aat:300165040 a skos:Concept ;
    skos:definition "Carved geometrical patterns of intersecting lines, either pierced or in relief; in the late 19th century applied especially to openwork patterns carved out of thin pieces of wood with a fretsaw. For similar patterns confined to a continuous band, use \"frets (patterns).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fretwork"@en .

aat:300165041 a skos:Concept ;
    skos:definition "A type of openwork pattern originating in Chinese art and adapted to Chinoiserie in Europe in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese fretwork"@en .

aat:300165093 a skos:Concept ;
    skos:definition "Humorous designs in the margins of Medieval manuscripts or in inconspicuous parts of wood or stone carving in Medieval buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drolleries"@en .

aat:300165096 a skos:Concept ;
    skos:definition "Motifs of female masks having a ruff around the head and under the chin, popular in 18th-century French decorative arts, especially Régence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "espagnolettes"@en .

aat:300165104 a skos:Concept ;
    skos:definition "Foliate decoration, derived from leaflike forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foliation"@en .

aat:300165113 a skos:Concept ;
    skos:definition "Low often ornamental fences of iron or brass set before a hearth to confine coals and ash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fenders"@en .

aat:300165202 a skos:Concept ;
    skos:definition "Structures, generally enclosed, that are used or intended to be used for sheltering an activity or occupancy, and that are intended to be non-permanent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temporary buildings"@en .

aat:300165223 a skos:Concept ;
    skos:definition "Motif resembling a string of buds, wheat husks, or bell flowers nestled each against its neighbor to form a string or festoon. Examples include late 18th-century Neoclassical furniture, ceramics, and other works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "husk"@en .

aat:300165258 a skos:Concept ;
    skos:definition "Either of two motifs that are both based on types of waterlily, one originating in ancient Egypt and the other in India. Within Egyptian lotus motifs, two varieties occur from the beginning of the Dynastic period ca. 3000 BCE: If the flower-head has a curved outline, it is based on the white-flowered species Nymphaea lotus, while if the flower has a triangular outline, it is based on the blue-flowered species, Nymphaea caerulea. The Egyptian motif continued in Greek, Roman, and later European art. For the Indian lotus specifically, based on the species Nelumbo nucifera, use the narrower term \"padma.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lotus"@en .

aat:300165259 a skos:Concept ;
    skos:definition "Branch of Judaism that most staunchly adheres to traditional beliefs and practices, characterized by the belief in the immutability and supreme authority of the Written Law and Oral Law as the fundamental basis of religious observance, by resistance to modernization, by strict conformity to daily worship and dietary laws, by the regular study of the Torah, by the observance of the Sabbath, and by the separation of men and women in the synagogue. This branch of Judaism often disputes the legitimacy of other Jewish groups on the issues that transgress Orthodox Jewish law such as non-Orthodox marriages or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orthodox Judaism"@en .

aat:300165261 a skos:Concept ;
    skos:definition "Religious movement and Jewish branch espoused by Zacharias Frankel (1801-1875) that endeavors to preserve particular elements and customs of traditional Judaism while allowing for limited modernization such as the support of the secular Zionist movement. This branch of Judaism is governed by the idea that Judaism defines Jewish culture and national identity, and therefore, religious customs and traditions such as dietary laws, the study of Hebrew, and the observation of Sabbath, must be upheld."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Conservative Judaism"@en .

aat:300165264 a skos:Concept ;
    skos:definition "The religious movement that began in the early 19th century in Germany, championing views on modernization and adaptation through the abandonment of traditional Jewish beliefs and laws deemed antiquated and inappropriate in the social and political conditions of the modern world. This branch of Judaism challenged the absolute nature of ritual laws and customs established in the Torah and Talmud by advocating reform and liberalism. One important characteristic of this branch of Judaism is that men and women are allowed to worship together rather than in separate groups as promoted by Orthodox sects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reform Judaism"@en .

aat:300165270 a skos:Concept ;
    skos:definition "Crosses having four splayed arms; it is an eight-pointed cross comprising four deep V-shapes joined together at their apex, so that each arm has two points. The cross was originally the symbol of medieval Amalfi, a small Italian republic. The form has been in use since the First Crusade, when the eight points represented the eight facets of courage: loyalty, piety, honesty, bravery, honor, fearlessness, charity, and obedience to the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maltese crosses"@en .

aat:300165279 a skos:Concept ;
    skos:definition "Running ornament consisting of continuous winding lines, either angular or curving. Its name is taken from the river Meander in Turkey (ancient Asia Minor), which twists and turns upon itself like the ornamental motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meanders"@en .

aat:300165321 a skos:Concept ;
    skos:definition "Armchairs having open arms and padded rests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elbow chairs"@en .

aat:300165324 a skos:Concept ;
    skos:definition "Folding portable chairs usually with a wood frame and canvas seat and back originally used on the sets of motion pictures as seating for actors or directors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "directors' chairs"@en .

aat:300165347 a skos:Concept ;
    skos:definition "Ornament in the form of a continuous pattern that proceeds directionally, as in a band. For patterns that extend more broadly over a surface, use \"allover patterns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running ornament"@en .

aat:300165349 a skos:Concept ;
    skos:definition "Having a front that is convex in the center and concave at both ends, used with reference to case furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentine-front"@en .

aat:300165381 a skos:Concept ;
    skos:definition "Ornament in the form of a series of small convex curves; often used as an edging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scalloping"@en .

aat:300165387 a skos:Concept ;
    skos:definition "Refers to running or allover patterns in which stems and leaves coil, spiral, and branch out into further curves and spirals. For individual motifs consisting of scrolls with foliate forms, use \"leaf scrolls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrolling foliage"@en .

aat:300165426 a skos:Concept ;
    skos:definition "Crosses having two crossbars of which the lower is the longer and intersects the upright above or at its center, the upper bar representing the INRI inscription traditionally placed above Christ's head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patriarchal crosses"@en .

aat:300165443 a skos:Concept ;
    skos:definition "Use only for tall concrete, metal, or timber structures of various plans designed to carry power lines; for tall metal structures used to hold radio or television antennas, use \"radio towers\" or \"television towers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmission towers"@en .

aat:300165444 a skos:Concept ;
    skos:definition "Triangle-shaped figures formed of three interlaced arcs or loops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triquetras"@en .

aat:300165461 a skos:Concept ;
    skos:definition "Circles enclosing four-spoke crosses, an ancient sign from which Celtic crosses may derive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel crosses"@en .

aat:300165470 a skos:Concept ;
    skos:definition "Industrial buildings used for public services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utilities buildings"@en .

aat:300165482 a skos:Concept ;
    skos:definition "Long and sinuous S-curves, sometimes resembling plant tendrils, common in Art Nouveau designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiplash curves"@en .

aat:300165495 a skos:Concept ;
    skos:definition "Refers to patterns of scrolling stems and leaves, especially of acanthus and in classicizing decoration. For other leafy scrollwork, use \"scrolling foliage.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rinceaux"@en .

aat:300165496 a skos:Concept ;
    skos:definition "Descriptive term for a type of common chair, presumably with a fan-shaped splat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan-back chairs"@en .

aat:300165509 a skos:Concept ;
    skos:definition "Parts and components of decorative walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative wall components"@en .

aat:300165510 a skos:Concept ;
    skos:definition "Motifs consisting of a curved segment of a circle, often suggesting a crescent moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crescents"@en .

aat:300165516 a skos:Concept ;
    skos:definition "Motifs of a semicircle with projecting fanlike rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rising suns"@en .

aat:300165523 a skos:Concept ;
    skos:definition "French chaise longues characterized by the foot end that is surrounded on three sides by a low curving back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duchesses"@en .

aat:300165577 a skos:Concept ;
    skos:definition "Motifs depicting a heart pierced by one or more nails or edged weapons such as swords. In Western Christian art it symbolizes the sufferings of Christ on the cross and the sorrows of the Virgin Mary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pierced hearts"@en .

aat:300165579 a skos:Concept ;
    skos:definition "Open shelves for holding books; distinct from \"bookcases\" which generally have several shelves enclosed by doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookshelves"@en .

aat:300165644 a skos:Concept ;
    skos:definition "Documents about, or generated by, divisions under the jurisdiction of a nation that are not vested with the full authority of provinces or states, but that have some degree of local governing and legislative power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "territorial records"@en .

aat:300165757 a skos:Concept ;
    skos:definition "Beds designed for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's beds"@en .

aat:300165788 a skos:Concept ;
    skos:definition "Pieces of furniture consisting of risers and treads, typically used indoors in place of ladders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steps"@en .

aat:300165808 a skos:Concept ;
    skos:definition "Matched sets of furniture, especially those comprising the basic furniture necessary for one room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suites"@en .

aat:300165810 a skos:Concept ;
    skos:definition "Term generally applied to a great variety of furniture specially designed for use outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outdoor furniture"@en .

aat:300165819 a skos:Concept ;
    skos:definition "Bedsprings that consist of spiral springs attached to a foundation and enclosed in a cloth-covered frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box springs"@en .

aat:300165827 a skos:Concept ;
    skos:definition "Bidets with legs made to screw off and tops made to lock, popular in the 19th century. Use \"traveling bidets\" for those made to rise out of a chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable bidets"@en .

aat:300165831 a skos:Concept ;
    skos:definition "Refers to the culture created under the Saisunaga dynasty (ca. 642-413 BCE) and the Nanda dynasty (ca. 413-322 BCE) in India. Information about this culture is found in later Vedic literature; metalwork, ivory carving, storied buildings, and craft guilds are mentioned. Very little remains of pre-Maurya date; some cyclopean walls, tombs, and minor antiquities such as terracotta reliefs and glass have been found. The cutting and polishing of hard stones reached a level of accomplishment in the 4th and 5th centuries BCE that was not surpassed in later ancient Indian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saisunaga-Nanda"@en .

aat:300165847 a skos:Concept ;
    skos:definition "Boards, planks, or slabs of wood or any other rigid material fixed in a horizontal position to a wall or in a case, to hold books or other objects as in a bookcase or cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelves"@en .

aat:300165849 a skos:Concept ;
    skos:definition "Components that perform the action holding up or bearing the weight of something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supports"@en .

aat:300165852 a skos:Concept ;
    skos:definition "Small chests fitted for bottles and intended to hold medical supplies; of a type made in the 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine chests"@en .

aat:300165855 a skos:Concept ;
    skos:definition "Canvas chairs suspended from a tree limb, roof, or other structure; of a type made in the late 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammock chairs"@en .

aat:300165866 a skos:Concept ;
    skos:definition "Formal rites or observances in academia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic ceremonies"@en .

aat:300165903 a skos:Concept ;
    skos:definition "Steel bars that have a straight chisel point at one end, and are bent at the other end, which has a notch for pulling nails; used for general demolition work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claw bars"@en .

aat:300165940 a skos:Concept ;
    skos:definition "Ornamental cresting on the top of a screen or cornice, usually formed of leaves, Tudor flowers, or miniature battlements; found especially in English Late Gothic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brattishing"@en .

aat:300166116 a skos:Concept ;
    skos:definition "Photographic prints, either salted-paper or albumen, produced from bringing photosensitized paper in contact with a cliché-verre negative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clichés-verre"@en .

aat:300166391 a skos:Concept ;
    skos:definition "A manufactured object that serves as the working model for the production of subsequent copies. The term is most often associated with three-dimensional objects that are functional: furniture, buildings, and machines, and less often with painting, drawing, or sculpture. Usage is extended to paintings and drawings to describe conceptual affinities, rather than discrete objects. Use \"prototypes\" to describe sculpture only if the works conform to other completed works in size, shape, and detail. For small-scale three dimensional renderings for sculpture, use \"maquettes,\" and for more finely detailed sketches for sculpture or painting, use \"bozzetti.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prototypes"@en .

aat:300166844 a skos:Concept ;
    skos:definition "Designates squarish barns found in the northeast United States and characterized by one main floor, steeply pitched gables, primary entrances located under each gable end, wide central interior spaces spanned by massive anchor beams, and narrow flanking aisles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch barns"@en .

aat:300166926 a skos:Concept ;
    skos:definition "Rectangular, gable-roofed barns divided on the interior into three roughly equal bays arranged widthwise rather than lengthwise, the center bay comprising a passageway entered from the long sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English barns"@en .

aat:300167036 a skos:Concept ;
    skos:definition "Documents conveying formal statements intended to create, preserve, assert, or testify to a right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "declarations"@en .

aat:300167046 a skos:Concept ;
    skos:definition "Documents effecting the release of a right or obligation from its binding force; used especially in military and legal contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discharges"@en .

aat:300167054 a skos:Concept ;
    skos:definition "Songs of praise in honor of gods, countries, famous people, or other objects of high esteem, especially settings of metrical strophic nonbiblical texts intended to be sung at religious services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hymns"@en .

aat:300167056 a skos:Concept ;
    skos:definition "Musical compositions, generally short, containing words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "songs"@en .

aat:300167113 a skos:Concept ;
    skos:definition "Machinery used to saw wood, typically for sawing planks or boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawmills"@en .

aat:300167218 a skos:Concept ;
    skos:definition "Designates certain Native North American dwellings framed by heavy timbers and covered with earth or sod and a dome-shaped arrangement of branches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth lodges"@en .

aat:300167221 a skos:Concept ;
    skos:definition "Use with reference to 19th-century American painted furniture decorated in imitation of imported Neoclassical models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fancy"@en .

aat:300167386 a skos:Concept ;
    skos:definition "An ornamental motif, often carved as decoration in classical and classically influenced architecture, consisting of fruit, foliage, and flowers hung loosely from two points; often deployed on a frieze or panel. Distinct from \"swag,\" which refers to textiles similarly hung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festoon"@en .

aat:300167540 a skos:Concept ;
    skos:definition "Foams used to provide structure in packaging or for other applications such as furniture. Structural foams can be produced by injecting gases into a molten thermoplastic under pressure in an extruder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural foam"@en .

aat:300167570 a skos:Concept ;
    skos:definition "Refers to either a writing table incorporating drawers or a type of case furniture, generally a chest of drawers, with a hinged, fall-front writing surface. The first furniture types to be referred to by this term developed in France in the mid-17th century, the term having evolved from the medieval French word for a coarse linen cloth that was laid on a table to provide a surface for writing. In modern usage, in Europe a \"bureau\" is a writing desk, usually with a hinged writing flap that rests at a sloping angle when closed and, when opened, reveals a tier of pigeonholes, small drawers, and sometimes a small cupboard. In the United States, a \"bureau\" is typically synonymous with a \"chest of drawers,\" having lost the surface for writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaus"@en .

aat:300167577 a skos:Concept ;
    skos:definition "Refers to the parts of seating furniture that support sitters' backs. For the rearmost surfaces or portions of objects in general, use \"backs (portions).\" For supports that are used to rest one's back, either separate pieces of furniture or attachments to backless seating, use \"backrests.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backs"@en .

aat:300167585 a skos:Concept ;
    skos:definition "Term used by Chippendale for double-headed couches with a canopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couch beds"@en .

aat:300167586 a skos:Concept ;
    skos:definition "Open hanging shelves for displaying china, often with lattice work on the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "china shelves"@en .

aat:300167587 a skos:Concept ;
    skos:definition "Chippendale's term for high-backed easy chairs stuffed all over and upholstered in wool fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloath chairs"@en .

aat:300167588 a skos:Concept ;
    skos:definition "Fire screens constructed of two folding leaves; many, but not all designs allow sliding of the panels to adjust coverage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double fire screens"@en .

aat:300167589 a skos:Concept ;
    skos:definition "Term used by Chippendale for small painted chairs with rush seats used at general entertainments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rout chairs"@en .

aat:300167590 a skos:Concept ;
    skos:definition "Term used by Chippendale for low beds without any superstructure, generally used by servants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stump beds"@en .

aat:300167602 a skos:Concept ;
    skos:definition "Term used during the mid-18th century for armchairs with upholstered seats and backs, carved frames and cabriole legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French elbow chairs"@en .

aat:300167606 a skos:Concept ;
    skos:definition "Folding testers, such as those found on a press bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop testers"@en .

aat:300167625 a skos:Concept ;
    skos:definition "Heat-resistant polymer used commonly in films and coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoset polyimide"@en .

aat:300167627 a skos:Concept ;
    skos:definition "Polymers that continually soften upon heating and harden upon cooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoplastic polyimide"@en .

aat:300167629 a skos:Concept ;
    skos:definition "Heat-resistant resins or plastics made of polyester."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoset polyester"@en .

aat:300167631 a skos:Concept ;
    skos:definition "Melt-processible plastics made with polyester, such as beverage bottles and microwaveable food trays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoplastic polyester"@en .

aat:300167671 a skos:Concept ;
    skos:definition "Settlements of any size that are no longer inhabited, whether in ruins or with intact buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deserted settlements"@en .

aat:300167843 a skos:Concept ;
    skos:definition "Naval officers supervising the construction and repair of ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constructors"@en .

aat:300167846 a skos:Concept ;
    skos:definition "Devices for applying mechanical power, often for the purpose of replacing or assisting manual labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machines"@en .

aat:300167850 a skos:Concept ;
    skos:definition "Equipment and tools used specifically for painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting equipment"@en .

aat:300167855 a skos:Concept ;
    skos:definition "Large computers, often the hub of a system serving many users."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mainframes"@en .

aat:300167864 a skos:Concept ;
    skos:definition "Caryatids with baskets on their heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canephorae"@en .

aat:300167873 a skos:Concept ;
    skos:definition "Openings through which a gun can be fired, as in a fortification or on the side of a ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunports"@en .

aat:300167875 a skos:Concept ;
    skos:definition "Shell of a scallop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scallop shell"@en .

aat:300167884 a skos:Concept ;
    skos:definition "The process of constructing a thesaurus, which is a particular type of organized arrangement of terms and related information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thesaurus construction"@en .

aat:300167931 a skos:Concept ;
    skos:definition "Masks worn over the nose and mouth to protect from dust and other airborne particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust masks"@en .

aat:300167948 a skos:Concept ;
    skos:definition "Thin, rigid pieces of clear plastic or some other material, cut in a continuously curved or scroll shape; used as a guide for ruling curves through a series of points that are not on the arc of a circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French curves"@en .

aat:300167975 a skos:Concept ;
    skos:definition "Construction equipment used for moving materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transferring construction equipment"@en .

aat:300168055 a skos:Concept ;
    skos:definition "The first letter of a text or section of text when it is emphasized, usually by making it significantly larger than the following text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initials"@en .

aat:300168117 a skos:Concept ;
    skos:definition "Tool or machines for cutting screw-threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread cutters"@en .

aat:300168219 a skos:Concept ;
    skos:definition "Encompasses various tools involved in the creation of technical drawings, including drawing boards, T-squares, french curves, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting equipment"@en .

aat:300168233 a skos:Concept ;
    skos:definition "The study or practice of the analytical description, interpretation, and evaluation of visual art works and exhibitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art criticism"@en .

aat:300168235 a skos:Concept ;
    skos:definition "People who report on, write about, analyze, or evaluate works of art, usually contemporary works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art critics"@en .

aat:300168254 a skos:Concept ;
    skos:definition "Computer devices that can receive data and retain it for subsequent retrieval."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage devices"@en .

aat:300168260 a skos:Concept ;
    skos:definition "Any devices that convert the electrical signals representing information within a computer into a form that can exist or be sensed outside the computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "output devices"@en .

aat:300168267 a skos:Concept ;
    skos:definition "Any devices that transfer data, programs, or signals into a processor system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "input devices"@en .

aat:300168276 a skos:Concept ;
    skos:definition "Any devices that make use of mechanical impact to print characters or images onto paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impact printers"@en .

aat:300168279 a skos:Concept ;
    skos:definition "Printers that create each character from an array of dots that are usually formed by transferring ink by mechanical impact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dot matrix printers"@en .

aat:300168285 a skos:Concept ;
    skos:definition "Printers that form images by projecting droplets of ink onto paper or other media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkjet printers"@en .

aat:300168288 a skos:Concept ;
    skos:definition "Devices consisting of a vertically mounted shaft that can be pushed in any direction; used for generating signals that can cause the cursor or some other symbol to be moved rapidly about on a display screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joysticks"@en .

aat:300168291 a skos:Concept ;
    skos:definition "Small, button-operated computer devices that are moved around on a flat desktop or graphics tablet to control the movement of the cursor on the monitor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mice"@en .

aat:300168293 a skos:Concept ;
    skos:definition "Flat surfaces, usually consisting of a grid of wire set in a substrate, that can be placed on a desk and used together with a mouse or stylus for the input of data to a computer graphics system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphics tablets"@en .

aat:300168302 a skos:Concept ;
    skos:definition "Devices used to convert data to digital form for use in a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digitizers"@en .

aat:300168310 a skos:Concept ;
    skos:definition "Hand-held, pen-shaped computer devices which are light sensitive so that when they are held to a point on a video screen they allow the computer to modify data or drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light pens"@en .

aat:300168323 a skos:Concept ;
    skos:definition "Refers to clients or patrons of a library, information center, or information retrieval service. For persons who themselves use products or services of the information industry to provide information services to clients or patrons, prefer \"users.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end users"@en .

aat:300168339 a skos:Concept ;
    skos:definition "Computer components with a screen for viewing data at a computer terminal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monitors"@en .

aat:300168350 a skos:Concept ;
    skos:definition "Microcomputers so compact that they can be operated while resting on the user's lap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laptop computers"@en .

aat:300168394 a skos:Concept ;
    skos:definition "Concepts and devices used in artistic practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artistic concepts"@en .

aat:300168396 a skos:Concept ;
    skos:definition "The study of the history of book production and the description of books as physical objects, including study of the relationships of varying texts or multiple editions of a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analytical bibliography"@en .

aat:300168446 a skos:Concept ;
    skos:definition "Axes used to make rough cuts before an adz is used to produce a curved surface in wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beginning axes"@en .

aat:300168457 a skos:Concept ;
    skos:definition "People having occupations in religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people in religion"@en .

aat:300168471 a skos:Concept ;
    skos:definition "Components that result when sheets, as of paper, parchment, or other material, are folded to form leaves and pages, which then are usually gathered or bound together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gathered matter components"@en .

aat:300168481 a skos:Concept ;
    skos:definition "Iron tongs used for a variety of purposes, but usually used to hold heavy, round metal objects while they are being forged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pincer tongs"@en .

aat:300168485 a skos:Concept ;
    skos:definition "Concepts related to the ownership of land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "property-related concepts"@en .

aat:300168543 a skos:Concept ;
    skos:definition "Balanced arrangement of compositional units on either side of a central axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axial symmetry"@en .

aat:300168680 a skos:Concept ;
    skos:definition "Screwdrivers that are operated by the reciprocating motion of the handle which enables the user to drive a screw easily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratchet screwdrivers"@en .

aat:300168934 a skos:Concept ;
    skos:definition "Tax-supported, high-speed, multilane highways; can be expressways or throughways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freeways"@en .

aat:300168944 a skos:Concept ;
    skos:definition "Divided, multilane highways with full grade separation and total control of access; can be freeways or turnpikes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throughways"@en .

aat:300169122 a skos:Concept ;
    skos:definition "Wave scrolls when occurring in the context of classicizing styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitruvian scrolls"@en .

aat:300169170 a skos:Concept ;
    skos:definition "Security structures used by the military."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military towers"@en .

aat:300169215 a skos:Concept ;
    skos:definition "Buildings that house schools formed by the merging of two or more public schools, usually at the elementary level and often in rural areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consolidated schools"@en .

aat:300169222 a skos:Concept ;
    skos:definition "Buildings that house local places of detention for the poor, vagrants, or those awaiting trial; usually spefically for such structures used in Britain between the 11th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaols"@en .

aat:300169231 a skos:Concept ;
    skos:definition "Buildings that house prisons that house primarily non-violent offenders; the term is often used in the U.S. prison system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minimum-security prisons"@en .

aat:300169239 a skos:Concept ;
    skos:definition "Buildings that house prisons where the security level is less than maximum security; the inmates may sleep in dormitories and have other communal facilities, with generally less supervision over the internal movements than in a maximum-security prison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium-security prisons"@en .

aat:300169324 a skos:Concept ;
    skos:definition "Dwellings located in the country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural houses"@en .

aat:300169459 a skos:Concept ;
    skos:definition "Buildings that house colleges that are financially supported by a state government, either the government of a U.S. state or the national government of certain other nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state colleges"@en .

aat:300169486 a skos:Concept ;
    skos:definition "Buildings that house schools where equitation is taught; usually including an arena, seating, and housing for horses and equipment. For schools training horses, use \"manèges.\" For complexes offering training, board, and care, use \"equestrian centers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding schools"@en .

aat:300169513 a skos:Concept ;
    skos:definition "Open outdoor spaces adjacent to school buildings used for free or regimented play, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schoolyards"@en .

aat:300169524 a skos:Concept ;
    skos:definition "The process of hammering metal into shape without the use of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold-working"@en .

aat:300169606 a skos:Concept ;
    skos:definition "Buildings specifcally used for purposes related to railroad transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rail transportation buildings"@en .

aat:300169672 a skos:Concept ;
    skos:definition "General term for documents that have the function of declaring, setting forth, explaining, or affirming something, such as facts, laws, intentions, and many other topics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "declaratory documents"@en .

aat:300169784 a skos:Concept ;
    skos:definition "Structures comprising the buildings, machinery, apparatus, and fixtures required to shape or process metal into products on an industrial level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking plants"@en .

aat:300169850 a skos:Concept ;
    skos:definition "Documents giving permission for the use of an item requested."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "releases"@en .

aat:300169856 a skos:Concept ;
    skos:definition "Zodiac symbol of a water bearer, roughly based on the constellation of the same name. The zodiac signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aquarius symbols"@en .

aat:300169858 a skos:Concept ;
    skos:definition "Decorative patterns that are an intricate form of interlace involving knotlike forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knotwork"@en .

aat:300169868 a skos:Concept ;
    skos:definition "Zodiac symbol of a ram, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aries symbols"@en .

aat:300169870 a skos:Concept ;
    skos:definition "Zodiac symbol of a crab, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cancer symbols"@en .

aat:300169872 a skos:Concept ;
    skos:definition "Zodiac symbol of a goat, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capricorn symbols"@en .

aat:300169874 a skos:Concept ;
    skos:definition "Zodiac symbol of a pair of twins, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gemini symbols"@en .

aat:300169879 a skos:Concept ;
    skos:definition "Zodiac symbol of a lion, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leo symbols"@en .

aat:300169881 a skos:Concept ;
    skos:definition "Zodiac symbol of a pair of scales, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Libra symbols"@en .

aat:300169883 a skos:Concept ;
    skos:definition "Zodiac symbol of a fish, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pisces symbols"@en .

aat:300169885 a skos:Concept ;
    skos:definition "Zodiac symbol of an archer, often a centaur,, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sagittarius symbols"@en .

aat:300169887 a skos:Concept ;
    skos:definition "Zodiac symbol of a scorpion, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scorpio symbols"@en .

aat:300169890 a skos:Concept ;
    skos:definition "Zodiac symbol of a bull, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taurus symbols"@en .

aat:300169892 a skos:Concept ;
    skos:definition "Zodiac symbol of a young woman, roughly based on the constellation of the same name. The zodiak signs have survived from classical Greek and Roman decoration, were popular in Northern European Romanesque and Gothic churches, and often found in Medieval psalters and books of hours symbolizing each month in which the sun enters the related constellation. They have also been used as decoration on ceilings, maps, timepieces, and astronomical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Virgo symbols"@en .

aat:300170026 a skos:Concept ;
    skos:definition "Windsor chairs with a bowlike back comprised of three sawn pieces of wood containing a central vertical back splat, sometimes spindles; common in the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon-back Windsor chairs"@en .

aat:300170029 a skos:Concept ;
    skos:definition "Furniture leg components comprised of an inlaid or otherwise differentiated or decorated region appearing as a band or flange surrounding the leg a few inches above the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuffs"@en .

aat:300170031 a skos:Concept ;
    skos:definition "Windsor chairs having a back of medium height consisting of spindles contained within a bent bow that is anchored in the seat; may or may not have arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow-back Windsor chairs"@en .

aat:300170039 a skos:Concept ;
    skos:definition "Windsor armchairs having a back of medium height consisting of back spindles contained within a bent bow that continues forward to form arms; frequently with a back brace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous-bow Windsor armchairs"@en .

aat:300170046 a skos:Concept ;
    skos:definition "Windsor side chairs having a back of medium height, approximating a partially opened fan, with the back spindles crowned by a crest rail curved laterally to follow the outside curve of the seat back and supported at the ends by heavy turned back posts. The form sometimes has an extended back and arms terminating in the back post. Such chairs usually have a back brace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan-back Windsor chairs"@en .

aat:300170051 a skos:Concept ;
    skos:definition "Windsor chairs with sawn back posts of gunstock shape; common in the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunstock Windsor chairs"@en .

aat:300170054 a skos:Concept ;
    skos:definition "Tall Windsor armchairs with a horizontal U-shaped armrail and long back spindles crowned by a crest rail curved laterally to follow the outside curve of the seat back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-back Windsor chairs"@en .

aat:300170063 a skos:Concept ;
    skos:definition "Windsor armchairs with a low back that terminates at arm level and usually is comprised of a three-piece sawn arm rail that follows the outside curve of the seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-back Windsor chairs"@en .

aat:300170072 a skos:Concept ;
    skos:definition "Windsor armchairs with a horizontal U-shaped arm rail and back of medium height consisting of spindles contained within a curved bow anchored in the arm rail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sack-back Windsor chairs"@en .

aat:300170079 a skos:Concept ;
    skos:definition "Term generally applied to any Windsor chair, of square or round back, having a central vertical back splat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splat-back Windsor chairs"@en .

aat:300170083 a skos:Concept ;
    skos:definition "Term introduced in the 19th century for any Windsor chair, with or without arms, of a square or nearly square back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square-back Windsor chairs"@en .

aat:300170092 a skos:Concept ;
    skos:definition "Square-back Windsor chairs with narrow vertical lath instead of round spindles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lath-back Windsor chairs"@en .

aat:300170097 a skos:Concept ;
    skos:definition "Fancy Windsor chairs of square-back based on Sheraton's designs, and found in the region of Mendlesham, England in the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mendlesham chairs"@en .

aat:300170103 a skos:Concept ;
    skos:definition "Square-back Windsor chairs with a turned cross piece framed at the top of the back posts and accompanied by one or two horizontal cross slats at mid-back and sometimes with short spindles between the seat and lower slat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll-top Windsor chairs"@en .

aat:300170108 a skos:Concept ;
    skos:definition "Square-back Windsor chairs with a slat across the upper back framed between the back posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slat-back Windsor chairs"@en .

aat:300170112 a skos:Concept ;
    skos:definition "Square-back Windsor chairs with a single turned rod across the top usually capping the back posts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single rod-back Windsor chairs"@en .

aat:300170116 a skos:Concept ;
    skos:definition "Square-back Windsor chairs with two turned rods across the top, the upper rod either capping the back posts or framed between them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double rod-back Windsor chairs"@en .

aat:300170125 a skos:Concept ;
    skos:definition "Square-back Windsor chairs with a cross panel capping and usually extending beyond the top of the back posts. Such chairs can have backs consisting of long spindles, cross slats, one or more cross slats with short spindles, or a vertical back splat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablet-top Windsor chairs"@en .

aat:300170131 a skos:Concept ;
    skos:definition "Any Windsor chair having one shaped, flat leaf, in lieu of a standard arm, used as a writing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing-arm Windsor chairs"@en .

aat:300170137 a skos:Concept ;
    skos:definition "Stands usually having three legs braced with stretchers which socket directly into a small, usually round, top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windsor stands"@en .

aat:300170140 a skos:Concept ;
    skos:definition "Tables with a top, usually round, supported on legs which socket directly into the top; such tables have three legs braced by stretchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windsor tables"@en .

aat:300170143 a skos:Concept ;
    skos:definition "Any Windsor chair with the legs supported on bends for rocking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windsor rocking chairs"@en .

aat:300170149 a skos:Concept ;
    skos:definition "Stools of varied height consisting of a horizontal plank of varied shape supported on three or four turned or shaved legs, frequently braced by stretchers, which socket directly into the plank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windsor stools"@en .

aat:300170152 a skos:Concept ;
    skos:definition "Chairs with tall legs and a high seat, such as those used at counters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tall chairs"@en .

aat:300170163 a skos:Concept ;
    skos:definition "In late 13th- and early 14th-century Gothic tracery, lancet-shaped openings pointed at the foot, rounded or pointed at the head, and cusped inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daggers"@en .

aat:300170221 a skos:Concept ;
    skos:definition "Cantilever chairs that are considered a major development in modern furniture. Mart Stam created the first experimental models with gas pipes and flanges and developed the principle of cantilevering chair supports without four legs. Later innovations allowed the use of tubular steel. Others such as Marcel Breuer and Mies van der Rohe designed their own variations on the principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "S chairs"@en .

aat:300170227 a skos:Concept ;
    skos:definition "Chair designed by Ludwig Mies van der Rohe ca. 1929-1930 having a cantilevered construction of chromed steel and leather or parchment upholstery. Prized as an example of Bauhaus design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brno chairs"@en .

aat:300170233 a skos:Concept ;
    skos:definition "A chair designed by Marcel Breuer ca. 1925 that features a tubular chromed-steel structure and strips of leather used as seat, back, and arm support. This chair is often used as a prime example of the design aesthetic of the Bauhaus during this period, and of mid-20th century modernist design in general, due to the innovation of the use of tubular steel in its construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wassily chairs"@en .

aat:300170239 a skos:Concept ;
    skos:definition "Reclining chaise lounges framed in tubular aluminum. They have rocker bases and stretched canvas supports and were intended to be used indoors or outdoors. Designed by Bartolucci and Waldman in 1947, based on a previous lounge by Corbusier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barwa chairs"@en .

aat:300170242 a skos:Concept ;
    skos:definition "Upholstered fiberglass-shell armchairs designed by Joe Colombo in 1964 and manufactured by Comfort Italy from 1965. The 'Elda 1005' is considered to be the first large armchair made out of fiberglass. A large self-supporting shell rotates on a base, the inside of which is upholstered in leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elda 1005 upholstered chairs"@en .

aat:300170245 a skos:Concept ;
    skos:definition "Chair design by Mies van der Rohe for his German Pavilion at the Barcelona Exposition of 1929. Only two chairs were made for this purpose, but the design proved popular and has been in almost continuous production since 1929."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barcelona chairs"@en .

aat:300170249 a skos:Concept ;
    skos:definition "Chairs designed in Buenos Aires by Antonio Bonet, Juan Kurchan and Jorge Ferrari Hardoy, having steel frames and slinglike one-piece fabric or leather seats. Though commonly referred to as a butterfly chair because of the distinctive shape of its frame, the official name is the B.K.F. Chair, which credits its three designers. The lightweight and inexpensive chair became hugely popular in the U.S. from the 1950s, particularly on the West Coast, where it was frequently used as outdoor seating. The chair was produced by Artek-Pascoe from 1941 to 1948. Knoll Associates acquired U.S. rights to the design in the late 1940s. Unauthorized copies continue to be made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hardoy chairs"@en .

aat:300170256 a skos:Concept ;
    skos:definition "Modernist easy chair design created by Arne Jacobsen in 1958 for the SAS Royal Hotel in Copenhagen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg chairs"@en .

aat:300170262 a skos:Concept ;
    skos:definition "Modernist chair designed for Knoll International in 1952 by Harry Bertoia. The basic form of the chair is constructed from wire rods welded together. There are many variations in upholstery and finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond chairs"@en .

aat:300170271 a skos:Concept ;
    skos:definition "Modernist armchair design in beech and teak wood by Peter Hvidt and Orla Molgaard Nielsen, ca. 1947."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ax chairs"@en .

aat:300170274 a skos:Concept ;
    skos:definition "Refers to a specific design of folding chair first created by Giancarlo Piretti in the 1960s, characterized as a folding chair that could be easily stacked and opened with one hand, composed of a steel or aluminum frame with a press-molded transparent plastic backrest and seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plia folding chairs"@en .

aat:300170280 a skos:Concept ;
    skos:definition "Modernist folding chair with a polished alumnum structure and leather seat designed by Gian Carlo Piretti for Anonima Castelli ca. 1970."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plona folding armchairs"@en .

aat:300170285 a skos:Concept ;
    skos:definition "Cantilevered chair designed in 1928 by Marcel Breuer at the Bauhaus, Dessau. Constructed of bent chromed tubular steel, wood, and cane, it has proved one of the most popular modernist chair designs and remains in production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cesca chairs"@en .

aat:300170291 a skos:Concept ;
    skos:definition "Refers to a series of cantilevered chair designs by Ludwig Mies van der Rohe first realized ca. 1927. the structure is of tubular steel and is regarded as a prime example of this type of furniture design emerging from the Bauhaus in the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MR chairs"@en .

aat:300170297 a skos:Concept ;
    skos:definition "Wide, contoured chairs consisting of a molded plastic shell covered with foam rubber padding and wool cloth set on a tubular steel frame; designed by Eero Saarinen and introduced in the mid-1940s; usually accompanied by a matching upholstered footstool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "womb chairs"@en .

aat:300170301 a skos:Concept ;
    skos:definition "Modernist chair designed ca. 1958. The chair features a foam and upholstery-covered molded shell of synthetic material on an aluminum swivel base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swan chairs"@en .

aat:300170305 a skos:Concept ;
    skos:definition "Modernist chair designed by Hans J. Wegner ca. 1950, and manufactured by Carl Hansen. The frame is of beech and the seat is constructed of woven paper cord. Part of the backrest is in the form of the letter 'Y,' from which the chair derived its name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Y-chairs"@en .

aat:300170309 a skos:Concept ;
    skos:definition "Armchairs developed in the mid-twentieth century, with foam rubber upholstery on the back and seat, and a characteristic \"floating\" seat which rests on only the two front legs and a crossbar running between the side slats. The design originated with Danish architect and furniture designer, Finn Juhl (1912-1989)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "136 armchairs"@en .

aat:300170371 a skos:Concept ;
    skos:definition "Roman couches intended to seat two people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biclinia"@en .

aat:300170373 a skos:Concept ;
    skos:definition "A Roman seat or bench for two persons, though usually occupied by only one for festivals, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bisellia"@en .

aat:300170383 a skos:Concept ;
    skos:definition "Feet on carved furniture legs that flare out and flatten, resembling the tip of a shoe or hoof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointed shod feet"@en .

aat:300170413 a skos:Concept ;
    skos:definition "General concepts that are related to activities, statuses, or modes of actions, particularly as related to such activities, statuses, and actions having to do with fulfilling a purpose or having to do with basic, utilitarian functions. In this sense, references to functional concepts in the realm of art, architecture, and cultural heritage usually differ from physical attributes, many of which (such as \"weight\") are often considered functional concepts by certain disciplines in other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "functional concepts"@en .

aat:300170443 a skos:Concept ;
    skos:definition "Refers to religious or secular buildings characterized by an oblong plan divided into a nave with two or more side aisles, the former higher and wider than the latter and generally lit by clerestory windows; usually terminated by an apse. In Roman and Early Christian basilicas, the ground plan typically was a parallelogram in which the width was not greater than one-half of the length and not less than one-third of it. When there was more space in the length, porticoes were built on the short sides. The middle space was separated by columns from a lower ambulatory or portico; the width of the ambulatory equaled the height of the columns and measured one-third of the width of the central space. Vaulting could be used in the side aisles, but a flat roof was used for the very broad middle nave. Eventually basilicas were built with 5 and 7 aisles; a transept was often placed between the nave and the apse. The roofing of the transept together with the apse and portico produced variety in the exterior of basilicas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basilicas"@en .

aat:300170757 a skos:Concept ;
    skos:definition "Curving members which connect the front and back legs on an object, such as on a chair, cradle, or bench, allowing it to rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bends"@en .

aat:300170763 a skos:Concept ;
    skos:definition "Parts or components of drawers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawer components"@en .

aat:300170764 a skos:Concept ;
    skos:definition "Narrow strips applied to the bottom edge of a drawer to provide a good running surface on the framing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runners"@en .

aat:300170801 a skos:Concept ;
    skos:definition "Elevated stands with a sloping top and usually a ledge at the bottom of the slope designed to support a book or script in a convenient position for a reader standing before it. A lectern may be placed on a table or mounted on a pedestal. A lectern In a church is usually situated in the chancel, sometimes inside a rood screen or tribune."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lecterns"@en .

aat:300170813 a skos:Concept ;
    skos:definition "Tall wooden cupboards with holes for ventilation, originally referring to livery cupboards used for storing loaves of bread that were doled out to impoverished persons, often in churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dole cupboards"@en .

aat:300170824 a skos:Concept ;
    skos:definition "Half-chests of drawers, made for use in a small study or lobby."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lobby chests"@en .

aat:300170829 a skos:Concept ;
    skos:definition "Early form of footstool that was reproduced in great numbers during the 19th century. Thebes stools generally have concave tops, with flared legs and cross bracing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thebes stools"@en .

aat:300170858 a skos:Concept ;
    skos:definition "Specialized form of table at which one ate oysters; circular in form with a hole in the center, under which stood a basket for the empty shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster tables"@en .

aat:300170864 a skos:Concept ;
    skos:definition "Desks designed to be mounted on the surface of walls with no secondary support. These usually incorporate a folding or sliding work surface incorporated into a cabinet for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall desks"@en .

aat:300170867 a skos:Concept ;
    skos:definition "Cabinets for dentists, either free standing or fixed to a wall, that are meant for storage of instruments. 19th and early 20th century dental cabinets featured multiple drawers of varied sizes, and articulated or removeable trays for instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental cabinets"@en .

aat:300170870 a skos:Concept ;
    skos:definition "Cabinets that hold spools of thread on spindles. Holes are drilled in the fronts of the cabinets where thread can be pulled out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread cabinets"@en .

aat:300170882 a skos:Concept ;
    skos:definition "Embankments built along a river or sea and set at some distance from it to control or retain flood waters. For embankments built only to prevent flooding of low-lying land use \"levees.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dikes"@en .

aat:300170887 a skos:Concept ;
    skos:definition "Pieces of furniture used for serving food, often reserved for relatively small or portable sideboards. For tables used to serve food, use \"serving tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servers"@en .

aat:300170888 a skos:Concept ;
    skos:definition "Overnight public accommodations for motorists generally characterized by long low-rise buildings consisting of rows of attached individual sleeping quarters and having direct access between the rooms and parking spaces without an intervening lobby."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motels"@en .

aat:300170905 a skos:Concept ;
    skos:definition "Marble top tables intended primarily for confectionery work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry tables"@en .

aat:300170910 a skos:Concept ;
    skos:definition "Open-front cupboards on wheels, used in front of a fire to warm plates of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hasters"@en .

aat:300170938 a skos:Concept ;
    skos:definition "Folding stools used by worshippers to sit or kneel, especially those used by the sovereign during coronation. For chairs used by bishops or other prelates in the chancel of a church, use \"faldistories.\" For the French form of folding stool used at court or domestically after the 17th century, use \"pliants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faldstools"@en .

aat:300170998 a skos:Concept ;
    skos:definition "Door latches whose spring bolts are operated by one or more knobs, but whose dead bolts are actuated by a key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knob latches"@en .

aat:300171016 a skos:Concept ;
    skos:definition "Chairs with a low seat and a tall sloping back, used as a prayer seat or stool; the form was seen in the 17th century, but became particularly popular during the Gothic Revival of the 19th century. For kneelers of similar form having a support for elbows and bookshelf, but not in the form of a chair, use \"prie-dieus (benches).\" For chairs with a very similar design, particularly those dating to the 18th century, but intended for use by females watching card games, use \"voyeuses à genoux.\" Prie-dieu chairs may be made of humble materials, such as a wooden frame with a rattan seat-kneeler, or they may be upholstered; they may include a shelf for prayer books. They are found in private chambers and occasionally in churches. If they are part of a set, it is usually a bedroom set. Voyeuses à genoux are always upholstered, and are generally part of a larger set along with voyeuses intended for males to sit astride while watching card games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prie-dieu chairs"@en .

aat:300171523 a skos:Concept ;
    skos:definition "Rectangular bolts that slide into casings, mounted on the edges of doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box bolts"@en .

aat:300171528 a skos:Concept ;
    skos:definition "Door bolts with square cross sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square bolts"@en .

aat:300171549 a skos:Concept ;
    skos:definition "A light or dark green massive serpentinite, commonly with veinlets of calcium carbonate and magnesium carbonate. It is capable of being polished and is commercially considered a marble; it is also considered to be among the highest-quality serpentinites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verd antique"@en .

aat:300171580 a skos:Concept ;
    skos:definition "People who study or work in any of the disciplines dealing with the institutions and functioning of human society and with the interpersonal relationships of individuals as members of society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social scientists"@en .

aat:300171585 a skos:Concept ;
    skos:definition "Ornamental metal pieces attached to an article usually of another material, such as to glass, porcelain, wood, or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounts"@en .

aat:300171587 a skos:Concept ;
    skos:definition "Popular term for American slant-front desks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Governor Winthrop desks"@en .

aat:300171605 a skos:Concept ;
    skos:definition "Simple, wooden slat-back chairs with a seat usually of woven material, originating in Chiavari, Italy. Mass-produced chairs have been based on this design, including Gio Ponti's 'Superleggera' chair of the 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiavari chairs"@en .

aat:300171674 a skos:Concept ;
    skos:definition "Refers to a traditional Norwegian chair made from a solid log, produced by hollowing out a tree trunk so that the lower portion retains the cylindrical shape of the trunk. The kubbestol is typically decorated with traditional Norwegian painting and carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kubbestols"@en .

aat:300171702 a skos:Concept ;
    skos:definition "Angular armchairs with slatted seats and backs; not known to have originated in the Adirondacks. They are generally used outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adirondack chairs"@en .

aat:300171890 a skos:Concept ;
    skos:definition "Small pulleys or wheels which facilitate and direct the movement of a sliding barn (or other) door by rolling along a horizontal track or rail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barn-door stays"@en .

aat:300171920 a skos:Concept ;
    skos:definition "Figural decorative supports for various purposes that are in the stylized figure of a dolphin, originally developed in Hellenistic and Roman sculpture and revived as supports for furniture and decorative arts in later periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolphin supports"@en .

aat:300172061 a skos:Concept ;
    skos:definition "Knobs that attach to doors, but that do not turn and have no working parts. Often used on closet doors or double doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dummy knobs"@en .

aat:300172119 a skos:Concept ;
    skos:definition "Case furniture for a dining room having compartments or shelves for holding articles of table service below, and a surface for serving or preparing food. The term has been in use since the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffets"@en .

aat:300172137 a skos:Concept ;
    skos:definition "Eighteenth-century term referring to chairs, particularly those used by women, located in the dressing room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing chairs"@en .

aat:300172142 a skos:Concept ;
    skos:definition "Compact, fitted dressing chests intended to hold a gentleman's fashion accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentlemen's dressing stands"@en .

aat:300172148 a skos:Concept ;
    skos:definition "Screens on a writing or dressing table. Originally intended as a guard against heat from a nearby fireplace, while writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing fire screens"@en .

aat:300172163 a skos:Concept ;
    skos:definition "Oblong tables with simple tapered legs, often outfitted with one or more drawers beneath the tabletop and occasionally a leather pad inlaid in the writing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentlemen's writing tables"@en .

aat:300172167 a skos:Concept ;
    skos:definition "Cabinets of various form that are designed to be fixed to the surface of a wall, and that have no floor support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging cabinets"@en .

aat:300172172 a skos:Concept ;
    skos:definition "Fall-front desks that were intended for use by ladies, often of relatively delicate design and sometimes having a wide opening to accommodate ladies' voluminous skirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies' secretaries"@en .

aat:300172182 a skos:Concept ;
    skos:definition "Cupboards for storing clothes that are not as tall as standard clothes presses, often of shoulder height or shorter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low clothes presses"@en .

aat:300172207 a skos:Concept ;
    skos:definition "Fairly small bookcases, generally between three and four feet high, set on castors to facilitate their easy movement, of a style popular in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving libraries"@en .

aat:300172215 a skos:Concept ;
    skos:definition "Term applied to a number of small drawers framed together in the form of a box, or fitted into another piece of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nests of drawers"@en .

aat:300172232 a skos:Concept ;
    skos:definition "Refers to case furniture similar to sideboard or buffet and used for dressing food and for storing and displaying dishes, fine tableware, and eating and serving utensils. The dresser was used in England beginning in the Tudor period, when it developed as a side table that was often fitted with a row of drawers. In the late 17th century, a dresser typically included a low backboard and narrow shelves or drawers, sometimes used to display valuable dishes. Dressers of this type were very popular in the 19th century. In France and Germany, dressers were more elaborately carved, and often included a cupboard, with or without doors, and a pot board below. In America, the term \"dresser (chest of drawers)\" refers to a piece of bedroom furniture that is similar in form to the European \"dresser (cupboard).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressers"@en .

aat:300172285 a skos:Concept ;
    skos:definition "Chests of drawers having specially designed upper drawers that provide mirrors set on a quadrant, as on Rudd tables. Popular in the late 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rudd dressing chests"@en .

aat:300172364 a skos:Concept ;
    skos:definition "Settles having a hinged back so that it can be let down to rest on the arms and thereby forming a table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settle tables"@en .

aat:300172436 a skos:Concept ;
    skos:definition "Chests with continuous, low-relief carvings, often depicting Biblical scenes or the lives of the saints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilting chests"@en .

aat:300172439 a skos:Concept ;
    skos:definition "Planters for ferns. For structures or outdoor areas devoted primarily to ferns, use \"ferneries (greenhouses).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferneries"@en .

aat:300172449 a skos:Concept ;
    skos:definition "Pedestals designed as cupboards lined with tin and fitted with racks and a heater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate warmers"@en .

aat:300172457 a skos:Concept ;
    skos:definition "Seats, usually made of cast-iron and in period character, located in a garden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden seats"@en .

aat:300172465 a skos:Concept ;
    skos:definition "First proofs printed from type, usually meaning those printed before it is made up into pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galley proofs"@en .

aat:300172491 a skos:Concept ;
    skos:definition "Forming or paring something, especially wood, by cutting off bits with a knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whittling"@en .

aat:300172505 a skos:Concept ;
    skos:definition "Wood that is formed by bending rather than being cut into shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bentwood"@en .

aat:300172507 a skos:Concept ;
    skos:definition "Chests with deep storage space, at least one drawer, and a hinged lid. Frequently used for the storage of blankets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanket chests"@en .

aat:300172525 a skos:Concept ;
    skos:definition "Corners on tables or other furniture in which the normal angle is rendered as a quarter-round inversion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow corners"@en .

aat:300172528 a skos:Concept ;
    skos:definition "Chair or table feet fashioned to resemble the paws, and often forelegs of dogs. These are represented in some of Duncan Phyfe's furniture of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog's-paw feet"@en .

aat:300172549 a skos:Concept ;
    skos:definition "Stretchers which connect chair legs in a continuous line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box stretchers"@en .

aat:300172566 a skos:Concept ;
    skos:definition "Inserts or inlay surrounding keyholes. For larger plates surrounding keyholes, use \"escutcheons (hardware).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyhole surrounds"@en .

aat:300172704 a skos:Concept ;
    skos:definition "Nails of galvanized steel, aluminum alloy, or coated steel, often having a threaded shank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shingle nails"@en .

aat:300172719 a skos:Concept ;
    skos:definition "Remission of the punishment, including purgatorial atonement, due by divine justice for sins whose guilt has been pardoned by the reception of the sacrament of penance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indulgence"@en .

aat:300172721 a skos:Concept ;
    skos:definition "Tensile units adapted to holding concrete forms secure against the lateral pressure of unhardened concrete, with or without provision for removal of metal to a specified distance from the finished concrete surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ties"@en .

aat:300172736 a skos:Concept ;
    skos:definition "Bars that are mounted to a wall, counter, or other surface from which towels and washcloths are hung for access and to dry. For racks of various designs for drying towels, use \"towel racks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towel bars"@en .

aat:300172756 a skos:Concept ;
    skos:definition "Administrative and operational records of offices of upper level government officials, including presidents, premiers, senators, congressmen, ministers, deputy ministers, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executive records"@en .

aat:300172861 a skos:Concept ;
    skos:definition "Refers to the style of Western art that existed from the mid- through the late nineteenth century and developed in reaction to the Romantic style. It is characterized by subject matter, depictions of figures, and techniques that emphasize reality with precision and vividness of detail, including unpleasant characteristics, in contrast to what was considered the idealized, sanitized, and beautified Romantic view of the world. To indicate in a more general sense any phase of artistic tradition where the real is emphasized over the idealized, use \"realism (artistic form of expression).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Realist"@en .

aat:300172863 a skos:Concept ;
    skos:definition "Refers to the European movement affecting visual arts, literature, music, and to a lesser degree architecture from the mid-18th to the mid-19th centuries. Viewed as a reaction to Neoclassical formality, it stressed emotion and the right to individual expression. Works encompass a range of styles but in general are painterly, dynamic, and reflect an interest in color over line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romantic"@en .

aat:300172866 a skos:Concept ;
    skos:definition "Refers to the movement within American Scene painting, concentrated in the rural midwestern United States in the 1930s and capturing the flavor of life there in a literal painting style.(PDAT) For the concept of a general consciousness of and loyalty to a distinct subnational or supranational area, use \"regionalism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Regionalist"@en .

aat:300173481 a skos:Concept ;
    skos:definition "Refers to a Neolithic Chinese culture and period that flourished ca. 5000 to ca. 3000 BCE. The earliest known Neolithic Chinese culture, Yangshao culture is mainly characterized by its red and black painted pottery. It is named after a site at Yangshao cun in Henan province, discovered in 1921 by the Swedish archaeologist Johan Gunnar Andersson. Centered on the Wei River valley, it covered a large area from Baoji, Shaanxi province, eastwards into Henan province."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yangshao"@en .

aat:300173497 a skos:Concept ;
    skos:definition "Style of pottery from the northern and central Pre-Columbian Andes that uses negative painting technique, in which the design is reserved in unpainted areas against a colored background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negative"@en .

aat:300174016 a skos:Concept ;
    skos:definition "Preservationists engaged in maintaining, rehabilitating, and preserving landmark architecture, particularly in historic districts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic preservationists"@en .

aat:300174155 a skos:Concept ;
    skos:definition "Generally, refers to instruction in and study of one or more of the visual arts at any and all levels, including the teaching of both amateurs and professionals, and of art teachers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art education"@en .

aat:300174160 a skos:Concept ;
    skos:definition "The discipline of describing, interpreting, and evaluating literary works, including the exposition of principles, methods, and theories for the analysis of such works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary criticism"@en .

aat:300174173 a skos:Concept ;
    skos:definition "Study of literary trends and movements over time, as well as the development of various branches or genres of literature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary history"@en .

aat:300174209 a skos:Concept ;
    skos:definition "Bureaux with two tiers of drawers flanking a kneehole recess, some forms intended to be used as writing desks, others as dressing tables; of a type popular in France during the second half of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux Mazarins"@en .

aat:300174226 a skos:Concept ;
    skos:definition "Stone ribs running longitudinally, running lengthwise in or parallel to the long axis of the aisle or nave, across the top of a vault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longitudinal ridge ribs"@en .

aat:300174227 a skos:Concept ;
    skos:definition "Stone ribs running transversely, that is, spanning crosswise at right angles to the longitudinal (lengthwise) axis across the top of a vault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transverse ridge ribs"@en .

aat:300174232 a skos:Concept ;
    skos:definition "French form of standing desk, sometimes having a pupitre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux debout"@en .

aat:300174236 a skos:Concept ;
    skos:definition "Canapés whose backs gently curve forward and downward to form the arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canapés à corbeille"@en .

aat:300174254 a skos:Concept ;
    skos:definition "Russian art movement, active from about 1905 to 1920, which combined influences from Russian folk art with ideas borrowed from Cubism and Futurism.(THDAT) For the deliberately unsophisticated and unschooled approach to artistic creation, use \"primitivism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Primitivist"@en .

aat:300174275 a skos:Concept ;
    skos:definition "Pieces of furniture fitted with pigeonholes or compartments to hold paper; either resting on a specially made cabinet placed at one end of a bureau plat or on the top of the bureau plat itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serre papiers"@en .

aat:300174446 a skos:Concept ;
    skos:definition "Posts set at the head of a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headposts"@en .

aat:300174496 a skos:Concept ;
    skos:definition "Hinged flaps in a desk which pop up to provide a slant top reading or writing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pupitres"@en .

aat:300174509 a skos:Concept ;
    skos:definition "Small movable tables sometimes with a porcelain or marble top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables de salon"@en .

aat:300174552 a skos:Concept ;
    skos:definition "Periods related to East Javanese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Javanese periods"@en .

aat:300174553 a skos:Concept ;
    skos:definition "Periods related to Cham cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cham periods"@en .

aat:300174701 a skos:Concept ;
    skos:definition "Chairs that have backs that are rounded inward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concave-back chairs"@en .

aat:300174705 a skos:Concept ;
    skos:definition "Pulls, for drawers or doors, having a disk shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "button pulls"@en .

aat:300174708 a skos:Concept ;
    skos:definition "Support devices consisting of pieces of wood, metal, stone, or other material that project from or overhang a wall, arch, a beam, or shelf to carry weight, or for purely ornamental purposes. Brackets are sometimes worked into volutes, scrolls, or other motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brackets"@en .

aat:300174711 a skos:Concept ;
    skos:definition "Small pieces of wood, often wedge-shaped, nailed to joinery in order to strengthen it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleats"@en .

aat:300174713 a skos:Concept ;
    skos:definition "Racks, usually with pegs, knobs, or hooks, from which to hang hats; generally attached to walls or other pieces of furniture. Less elaborate and less likely to be free-standing and furniturelike than \"hat stands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat racks"@en .

aat:300174721 a skos:Concept ;
    skos:definition "Compact, fitted dressing chests which stand on four tapering legs, and are intended to hold cosmetics and jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing stands"@en .

aat:300174726 a skos:Concept ;
    skos:definition "General term for metal junctions between two edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal seams"@en .

aat:300174730 a skos:Concept ;
    skos:definition "Drawers with fronts that may be decorated but that feature no protruding hardware pulls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind drawers"@en .

aat:300174746 a skos:Concept ;
    skos:definition "Portable, lightweight beds or cots that can be folded for transport and carried with handles, resembling a suitcase. The beds may include attached light bedding, or may be only the bedframe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suitcase beds"@en .

aat:300174750 a skos:Concept ;
    skos:definition "Cabinets or chests of drawers with triangular bodies that are meant to occupy the juncture of two walls. They are made for display as well as storage and are often elaborately decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner commodes"@en .

aat:300174901 a skos:Concept ;
    skos:definition "Plates placed around the holes made for light switches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "switch plates"@en .

aat:300174966 a skos:Concept ;
    skos:definition "Plates, attached to the exterior side of a door, having an opening through which mail may be passed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter-box plates"@en .

aat:300174982 a skos:Concept ;
    skos:definition "Joints at the edges of wood boards, formed so that a corresponding indented and projecting V meet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-joints"@en .

aat:300174989 a skos:Concept ;
    skos:definition "General term for wood from any of several pines. In America, it refers to wood of several closely related species of North American pine with yellow tinted wood. In Great Britain, the term is used in the timber trade to refer to the wood of several additional pines as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow pine"@en .

aat:300175002 a skos:Concept ;
    skos:definition "Joints comprising the spaces between bricks, concrete blocks, or glass blocks, that are filled with mortar or grout. Mortar joints can be made in a series of different fashions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortar joints"@en .

aat:300175006 a skos:Concept ;
    skos:definition "Any joints that are flush with the adjacent surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush joints"@en .

aat:300175200 a skos:Concept ;
    skos:definition "Refers to the style of Japanese residential architecture designed for tea ceremonies, which reached its peak in the Momoyama period (1568-1600).The style is characterized by an emphasis on simple, austere interiors with almost no ornament, columns made of rough hewn tree trunks, and earthen walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sukiya"@en .

aat:300175240 a skos:Concept ;
    skos:definition "Refers broadly to the areas of activity that encompass both performing and visual arts. With reference more narrowly to the fine arts or the fine and decorative arts together, see \"art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arts"@en .

aat:300175242 a skos:Concept ;
    skos:definition "Sets of tools used to manage fires in fireplaces, hearths, or other domestic settings; may include tongs, shovels, pokers, and rakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firesets"@en .

aat:300175256 a skos:Concept ;
    skos:definition "Hangers made from thin strips of material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straphangers"@en .

aat:300175436 a skos:Concept ;
    skos:definition "Hinges made from two iron rods, usually attached to cupboards, chest lids, and table leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotter-pin hinges"@en .

aat:300175460 a skos:Concept ;
    skos:definition "Frames of a bed, including bedrails, headboard, and footboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedframes"@en .

aat:300175471 a skos:Concept ;
    skos:definition "Openings in a wall with sides flaring outward, as for a door or window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embrasures"@en .

aat:300175482 a skos:Concept ;
    skos:definition "Steep mounds, a main feature of certain 11th- and 12th-century castles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mottes"@en .

aat:300175495 a skos:Concept ;
    skos:definition "Methods by which masonry units, such as bricks or stones, are interlocked or joined through adhesion of mortar to the bricks. Bonds may be identified and referenced by the pattern on the surface of the masonry. For the process focusing on facing patterns, often in reference to ancient patterns, use children of \"masonry facing (process),\" although meaning overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonds"@en .

aat:300175500 a skos:Concept ;
    skos:definition "Technique of pattern bond in which a course of full-length headers occurs at regular intervals, usually every five or six courses; other courses are composed only of stretchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common bond"@en .

aat:300175506 a skos:Concept ;
    skos:definition "Technique of bond in which alternating courses of all headers and all stretchers are laid, with the headers centered on the stretchers and on the joints between stretchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English bond"@en .

aat:300175511 a skos:Concept ;
    skos:definition "Technique of bond in which headers and stretchers alternate horizontally and vertically, each header being centered with regard to the stretcher above and below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flemish bond"@en .

aat:300175515 a skos:Concept ;
    skos:definition "Technique of pattern bond using only stretchers and in which the vertical joints of one course fall midway between the joints of the courses above and below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running bond"@en .

aat:300175520 a skos:Concept ;
    skos:definition "Technique of purely pattern bond with no overlapping of units, so that all vertical joints are aligned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stack bond"@en .

aat:300175565 a skos:Concept ;
    skos:definition "Figures composed of more than five lobes or arcs, separated by cusps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multifoils"@en .

aat:300175575 a skos:Concept ;
    skos:definition "Writing tables with a pop-up reading stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaux en pupitre"@en .

aat:300175940 a skos:Concept ;
    skos:definition "The convex fillings of the lower part of some flutes of classical columns or pilasters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabling"@en .

aat:300176430 a skos:Concept ;
    skos:definition "Pierced wooden seats with removable containers underneath; used as a commode."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close-stools"@en .

aat:300176672 a skos:Concept ;
    skos:definition "Small breakfast tables, made in early 19th century, intended to be used in ladies' boudoirs or morning rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "déjeuner tables"@en .

aat:300176676 a skos:Concept ;
    skos:definition "Top rails of chairbacks that are shaped like yokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yokes"@en .

aat:300176703 a skos:Concept ;
    skos:definition "Certain picturesque, small rustic houses, primarily of the late 18th and early 19th centuries in England, with an asymmetrical plan and wood siding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottages ornés"@en .

aat:300176753 a skos:Concept ;
    skos:definition "Cabinets which stand at elbow height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meubles à hauteur d'appui"@en .

aat:300176901 a skos:Concept ;
    skos:definition "A form of door hardware that consists of a pair of knobs on opposite ends of a spindle used to release a door latch. Distinguished from \"closet knobs,\" which have a knob on one end of the spindle and a rose or plate on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorknobs"@en .

aat:300176953 a skos:Concept ;
    skos:definition "Refers to the style of ceramics produced by Johann Friedrich Böttger in the early 18th century. His works include a brown-red or black stoneware decorated with relief, incised, inset, engraved, or painted designs and a yellowish porcelain with a thick glaze and applied ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Böttger"@en .

aat:300177075 a skos:Concept ;
    skos:definition "Refers to a pottery style widely distributed in northern Mesopotamia during the Hassuna period from about 6200 to 5700 BCE. The style is characterized by a wide range of sizes which were covered with a thin cream slip and incised decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hassuna standard"@en .

aat:300177140 a skos:Concept ;
    skos:definition "Fink trusses with subdiagonals radiating outward from central points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan Fink trusses"@en .

aat:300177433 a skos:Concept ;
    skos:definition "Paintings made by the technique of fresco painting, which is a mural painting technique in which permanent pigments, dispersed in water, are painted on freshly laid lime plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frescoes"@en .

aat:300177435 a skos:Concept ;
    skos:definition "Paintings executed on an easel or other portable device, having either canvas or panel supports; generally restricted to those painted from the 16th century forward. The term implies not only physical aspects of creation, but also inherent concepts associated with the increased secular use of art from the 16th century and with the identification of paintings as objects of worth in their own right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "easel paintings"@en .

aat:300178226 a skos:Concept ;
    skos:definition "Use especially for sketches that are part of the underpainting and establish the tonal relationships of a painting; also, for a block of sculptural material at a stage where it has been worked to a rough form of the finished work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbozzi"@en .

aat:300178227 a skos:Concept ;
    skos:definition "Group portraits in a domestic or landscape setting in which the sitters are engaged in casual conversation or social activity; especially popular in Britain in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conversation pieces"@en .

aat:300178228 a skos:Concept ;
    skos:definition "Works comprising pairs of panels hinged together. They were used by the ancient Romans for writing tablets, often having images on the outer surfaces. In Medieval and later times, they were used primarily to support images for altarpieces and other purposes, most often composed of carved ivory or of painted wood panels, with the primary images on the interior surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diptychs"@en .

aat:300178234 a skos:Concept ;
    skos:definition "Paintings or carvings consisting of or mounted on three attached panels, often hinged so that the outer wings fold over the central portion; a common form for altarpieces. Also used for other works having three related images side by side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triptychs"@en .

aat:300178235 a skos:Concept ;
    skos:definition "Painted or carved works consisting of multiple panels. They are typically altarpieces, but may be objects with other functions as well. The polyptych normally consists of a central panel with an even number of side-panels, which are sometimes hinged to fold, and a predella. Although any object with two or more panels may technically be called a 'polyptych,' the word is typically reserved for anything larger than a triptych. In early usage, the Greek term 'polyptycha' referred to multiple-panel writing tablets and calendar icons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyptychs"@en .

aat:300178236 a skos:Concept ;
    skos:definition "Works of art submitted by the artist to an academy for approval as part of the requirements for admission to membership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reception pieces"@en .

aat:300178240 a skos:Concept ;
    skos:definition "Man-made objects that are venerated for the deity or spirit they embody and that are the center of a particular cult or religion. Cult images may be dressed, fed, or paraded in various rituals. Although their meanings overlap, a cult image differs from an \"idol\" in that it typically is a larger item that is uniquely the focus of a certain religion or cult, often particularly referring to religions of the ancient world. For objects used similarly but containing no images, use \"religious objects\" or \"cult objects.\" This term is generally used for non-Christian images; for Christian images that are themselves considered sacred, use \"icons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cult images"@en .

aat:300178241 a skos:Concept ;
    skos:definition "Images, either two-dimensional pictures or three-dimensional, used in private piety or other religious purposes in a place of worship or home, intended as recipients of prayer or aids to meditation; distinct from images that serve the liturgy or are primarily didactic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional images"@en .

aat:300178242 a skos:Concept ;
    skos:definition "Devotional images, especially from the Late Gothic and Renaissance periods, intended to inspire meditation and usually emphasizing subjects of grief and suffering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andachtsbilder"@en .

aat:300178243 a skos:Concept ;
    skos:definition "Relatively small images, either painted or sculpted in low relief or in the round, that are donated to a Christian church or pilgrimage site in the hope of or in gratitude to God, the Virgin Mary, or a saint for deliverance from illness or distress. The images may represent saints, other human figures, parts of human figures, or other living or inanimate things. The term comes from the Latin and Greek formulas that are often inscribed on the items, beginning with \"ex voto\" or its equivalent \"hyper euches.\" May also be used for pre-Christian and pre-Islamic cult and ritual items of similar or identical form from Asia Minor, North Africa, the Mediterranean, and west central Europe. May also be used for similar items developed via more recent traditions in the religions of India, Tibet, China, and Japan. For objects having this purpose but containing no images, use the term \"votive offerings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ex-votos"@en .

aat:300178244 a skos:Concept ;
    skos:definition "Objects or monuments donated by an individual for a public place or shrine, especially in gratitude for deliverance from distress. For those that are, or contain, images, use \"ex-votos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "votive offerings"@en .

aat:300178245 a skos:Concept ;
    skos:definition "Objects that are venerated within a particular system of worship; for those that are, or contain, images, use \"cult images.\" Use especially with regard to extinct cultures and religions; for objects venerated in still-living religions, prefer \"religious objects,\" and if those objects retain their sacredness in their present context, use \"sacred objects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cult objects"@en .

aat:300178246 a skos:Concept ;
    skos:definition "Hellenistic and Roman portrait heads or busts in round frames, connoting honor or heroization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clipei"@en .

aat:300178247 a skos:Concept ;
    skos:definition "Ivory diptychs with relief images presented by ancient Roman consuls to the emperor, Senate, and influential friends, to mark the commencement of their term of office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consular diptychs"@en .

aat:300178250 a skos:Concept ;
    skos:definition "Illusionistic ceiling painting composed as if they were framed easel paintings, usually within the context of a larger ceiling design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadri riportati"@en .

aat:300178263 a skos:Concept ;
    skos:definition "Areas of a fresco that are executed each in one day; usually these sections remain visibly divided by a seam in the finished piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giornate"@en .

aat:300178264 a skos:Concept ;
    skos:definition "Visual works in the medium of enamel, which is a semi-transparent or opaque vitreous, porcelain-like coating; enamels are typically set into a metalwork support. Often reserved for works that depict figures or scenes. For vessels and other objects that are coated with protective enamel but are generally not considered art works, use \"enamelware.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enamels"@en .

aat:300178308 a skos:Concept ;
    skos:definition "Paintings and other markings executed on the surface of the living rock in natural caves, especially during the Paleolithic period. For markings cut into the living rock, use \"rock engravings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cave paintings"@en .

aat:300178376 a skos:Concept ;
    skos:definition "Prints made using a process of planographic printing, in which the image is printed from a flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planographic prints"@en .

aat:300178447 a skos:Concept ;
    skos:definition "Parts or components of paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting components"@en .

aat:300178448 a skos:Concept ;
    skos:definition "Paint applied to a painting over already dry areas. Sometimes used to include the original artist's glazes and scumbles; sometimes, especially in conservation, used to mean only later restorers' work. For restoration work that only fills in lost areas without covering original paint, use \"inpainting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overpaint"@en .

aat:300178450 a skos:Concept ;
    skos:definition "Layers in a painting, usually an oil painting, that are between the ground or primer and any protective coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paint layers"@en .

aat:300178452 a skos:Concept ;
    skos:definition "In a painting, a colored glaze, size, or wash applied on top of a white ground, to provide the initial tone for the design layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imprimatura"@en .

aat:300178457 a skos:Concept ;
    skos:definition "A paint layer that is opaque yet allows the color underneath to show through by being applied either thinly or irregularly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scumbles"@en .

aat:300178459 a skos:Concept ;
    skos:definition "A preliminary layer in a painting in which drawing, composition, and tonal values are worked out, or an area in one color which is then to be worked with glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underpainting"@en .

aat:300178463 a skos:Concept ;
    skos:definition "Narrow lateral paintings often extending over many feet and viewed section by section; these are especially significant in Asian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handscrolls"@en .

aat:300178464 a skos:Concept ;
    skos:definition "Japanese handscrolls, containing text, artwork, or both, and displayed horizontally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emakimono"@en .

aat:300178473 a skos:Concept ;
    skos:definition "Imprints of the edges of the plate on intaglio prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate marks"@en .

aat:300178549 a skos:Concept ;
    skos:definition "In printing and print-making, the individual example produced by the printing of a block, plate, or type, etc., on a sheet of paper. Use when emphasizing the individual instance of printing. For printed images more generally, use \"prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impressions"@en .

aat:300178550 a skos:Concept ;
    skos:definition "Prints made from plaster casts of intaglio plates or the plaster casts themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaster prints"@en .

aat:300178561 a skos:Concept ;
    skos:definition "Walkways bordered by formally planted trees, clipped hedges, or shrubs; usually found in formal gardens or parks. For wide, straight, usually tree-lined roads or approaches, use \"avenues.\" For walkways or narrow streets between and behind buildings in an urban environment, use \"alleys (streets).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allées"@en .

aat:300178563 a skos:Concept ;
    skos:definition "Raising and care of trees and shrubs, usually in gardens or for ornamental purposes. For the cultivation and study of forest trees, use \"silviculture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arboriculture"@en .

aat:300178565 a skos:Concept ;
    skos:definition "Horticulturists that practices arboriculture, or the cultivation of shrubs and trees for the purposes of ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arborculturists"@en .

aat:300178567 a skos:Concept ;
    skos:definition "Use generally for various types of light portable firearms used in Europe from the 14th to the early 17th century, fitted with a stock which allowed them to be held against the cheek, chest, or shoulder. The first models had a hooklike projection on the underside of the barrel to absorb recoil, and were rested upon a surface when fired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harquebuses"@en .

aat:300178577 a skos:Concept ;
    skos:definition "Russian popular prints of the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lubki"@en .

aat:300178589 a skos:Concept ;
    skos:definition "Stairs, usually located outdoors, leading up to the entrances of large buildings, such as churches, public halls, or mansions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perrons"@en .

aat:300178591 a skos:Concept ;
    skos:definition "The concept emphasizes the autonomous value of art, and asserts that art does not need to serve an end, or need justification. It was a primary principle of the Aesthetic Movement of the late 19th century. Concept and phrase which was popularized, in French, as \"l'art por l'art,\" by French philosopher Victor Cousin, in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art for art's sake"@en .

aat:300178594 a skos:Concept ;
    skos:definition "Refers to the movement in England and the United States, from around 1890 into the early 20th century, which promoted various aesthetic approaches. Historically, has sometimes been applied to any photography whose intention is aesthetic, as distinguished from scientific, commercial, or journalistic; for this meaning, use \"photography.\" For discussion of photography as a fine art, use \"photography\" plus \"art theory.\" Regarding photography of art, use \"photography\" plus \"art objects\" or \"works of art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art photography"@en .

aat:300178609 a skos:Concept ;
    skos:definition "Printing technique in which color is applied to specific areas of the plate with a pad or rolled piece of felt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "à la poupée"@en .

aat:300178612 a skos:Concept ;
    skos:definition "Printmaking process for making relief engravings on metal, called dotted prints, using dots from punches of various shapes and sometimes including burin lines; common in the second half of the 15th century. For later, intaglio processes employing directly engraved flicks or dots for tonal areas, use \"stipple engraving.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dotted manner"@en .

aat:300178614 a skos:Concept ;
    skos:definition "Printing process in which the plate is etched, but unlike in most etching, the design is relief printed rather than intaglio printed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief etching"@en .

aat:300178615 a skos:Concept ;
    skos:definition "Lightly rubbing an intaglio printing plate with a soft rag, after it has been inked in the normal way, to produce a blurred, fuzzy effect in the print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retroussage"@en .

aat:300178616 a skos:Concept ;
    skos:definition "In etching, the condition where an area of the printing plate is too deeply bitten and lines fuse together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crevé"@en .

aat:300178619 a skos:Concept ;
    skos:definition "Condition in printing where each successive plate or block was positioned accurately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "in register"@en .

aat:300178621 a skos:Concept ;
    skos:definition "18th-century printmaking process that imitates the appearance of chalk lines; employs etching, with the ground having been marked with a roulette, and sometimes the addition of directly engraved stippling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crayon manner"@en .

aat:300178624 a skos:Concept ;
    skos:definition "Works of art designed to be produced so that there is more than one original, theoretically in unlimited numbers. The most common examples are works produced from plates or negatives, including engravings, etchings, lithographs, photographs, and other prints. A record for multiples typically includes general information about a printing plate and the prints made from it. This designation may also be used for sculptures and other works produced in multiples from a plate, mold, computer program, or other device or method. In cataloging, it is useful to catalog the group of multiples as a whole when the individual works will not be cataloged separately, or when there are characteristics of the whole multiples group that do not apply to each item in the group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiples"@en .

aat:300178625 a skos:Concept ;
    skos:definition "Coating selected areas of a surface to prevent them from being acted upon, as in etching or screen printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stopping out"@en .

aat:300178627 a skos:Concept ;
    skos:definition "Embossed marks or seals impressed into a print by printers, artists, print workshops, or publishers signifying where and by whom the print was made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chops"@en .

aat:300178636 a skos:Concept ;
    skos:definition "Refers to prints that, when originally issued, were intended for a popular audience, were generally inexpensive and produced in large numbers and in which an easily understood content was more important than aesthetic qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popular prints"@en .

aat:300178639 a skos:Concept ;
    skos:definition "Creating raised letters or designs without ink, foil, or other color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind embossing"@en .

aat:300178646 a skos:Concept ;
    skos:definition "Proofs of prints having an image, but before the addition of title, artist's name, or other alphabetical content has been added; relevant when such printed matter exists on a later state. Such proofs are usually rare and valuable and thus command high prices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proofs before letters"@en .

aat:300178672 a skos:Concept ;
    skos:definition "Refers to the technique of making compositions from portions of existing images, such as drawings or photographs, arranged into somewhat unified images. When pieces of various relatively flat materials are pasted together to form less unified images, use \"collage.\" Used also in film when two or more shots are superimposed to form a single image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "montage"@en .

aat:300178674 a skos:Concept ;
    skos:definition "The activity of painting relatively small paintings, originally using an easel or other device in the process. The term is used to refer to the process used by artists in the west, dating from the 16th century and later, when art was considered valuable in its own right, and to distinguish paintings on panel and canvas from mural paintings, manuscript illuminations, or decorative painting on objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "easel painting"@en .

aat:300178675 a skos:Concept ;
    skos:definition "Refers to the activity of painting portable paintings on wood from the painting of other types, such as mural paintings and manuscript illuminations, especially with reference to the Medieval and Early Renaissance periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel painting"@en .

aat:300178677 a skos:Concept ;
    skos:definition "The activity of composing and executing painted decorations or scenes that dominate a wall or ceiling surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mural painting"@en .

aat:300178679 a skos:Concept ;
    skos:definition "Painting technique in which the pigment is bonded with an extremely durable film of glassy silicates or silica. The end result can resemble either buon fresco or fresco a secco, depending on the exact method and choice of materials. The technique was apparently invented by alchemist Basilius Valentinus in the 15th century. It was rediscovered ca. 1818, and commercial paints were available until the 1960s in Germany. Silicon esters, in particular ethyl silicate, replaced water glass in modern silicate paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral painting"@en .

aat:300178684 a skos:Concept ;
    skos:definition "The art or practice of producing creative works in oil paint, which is pigment suspended in vegetal drying oils. It dates from at least the Middle Ages in Europe, and was widely adopted for easel painting by the fifteenth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil painting"@en .

aat:300178688 a skos:Concept ;
    skos:definition "Prints made by exclusively using the process of screen printing, whether originated by hand or photographically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen prints"@en .

aat:300178719 a skos:Concept ;
    skos:definition "A vegetable juice, red in its natural state, used in the Middle Ages as a coloring; probably obtained from the turnsole plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folium"@en .

aat:300178723 a skos:Concept ;
    skos:definition "The acid-resistant substance used for aquatint, made by dusting rosin particles onto a plate and heating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosin ground"@en .

aat:300178726 a skos:Concept ;
    skos:definition "Rosin or asphalt dissolved in a distilled spirit such as alcohol, which, when applied to a printing plate, dries to leave an acid-resistant ground for aquatint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit ground"@en .

aat:300178737 a skos:Concept ;
    skos:definition "The doctrine that mental and moral phenomena may be accounted for by association of ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "associationism"@en .

aat:300178739 a skos:Concept ;
    skos:definition "Self-propelled vehicles designed primarily to transport passengers over ordinary roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automobiles"@en .

aat:300178749 a skos:Concept ;
    skos:definition "Watercraft generally smaller and less seaworthy than ships and generally not designed to cross large open waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boats"@en .

aat:300178756 a skos:Concept ;
    skos:definition "An Italian marble which can either be dark cream, light cream with brown markings, or light brown with whitish patches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Botticino marble"@en .

aat:300178758 a skos:Concept ;
    skos:definition "Parts or components of vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vehicle components"@en .

aat:300178759 a skos:Concept ;
    skos:definition "Shelflike platforms or other similar sleeping spaces on board transportation vehicles, such as boats, trains, or travel trailers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berths"@en .

aat:300178762 a skos:Concept ;
    skos:definition "Mixture of mud, moss, and lime (often in the form of ground shells) used as infill between wall timbers, characteristic of French-influenced architecture of the southern United States, especially Louisiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bousillage"@en .

aat:300178763 a skos:Concept ;
    skos:definition "Structures with equipment and facilities for the washing, waxing, and polishing of motor vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "car washes"@en .

aat:300178768 a skos:Concept ;
    skos:definition "Temporary construction, usually of wood, over which arches and vaults are formed and held until they become self-supporting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centering"@en .

aat:300178783 a skos:Concept ;
    skos:definition "A type of small communal housing development, designed and managed by the occupants, in which each resident family owns a home and shares with the group common facilities, such as kitchens, child care centers, and laundry rooms, and their associated tasks. The modern method of cohousing originated in Denmark in the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cohousing"@en .

aat:300178785 a skos:Concept ;
    skos:definition "Rows of columns that serve primarily to separate interior spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columnar screens"@en .

aat:300178790 a skos:Concept ;
    skos:definition "Buildings that house schools whose facilities and programs are closely connected with the life and needs of, and may be shared by, the whole community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community schools"@en .

aat:300178794 a skos:Concept ;
    skos:definition "Pairs of portraits designed to be displayed together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "companion portraits"@en .

aat:300178799 a skos:Concept ;
    skos:definition "A weathering steel that has superior corrosion resistance over regular carbon steel because of a protective oxide film on the metal's surface. Its 50,000 minimum yield strength allows for cost reduction because lighter sections can be designed and built into structures; it is generally meant to be used in unpainted applications where a reduction in maintenance costs, such as painting, are desired. Cor-Ten is a brand name for corrosion resistant products that were developed by United States Steel; Cor-Ten has subsequently been licensed to be produced by other steel manufacturers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cor-Ten steel (TM)"@en .

aat:300178802 a skos:Concept ;
    skos:definition "The mode or fashion of personal attire and dress, including the way of wearing the hair, style of clothing, jewelry, crowns, scepters, and other accessories of personal adornment, belonging to a particular nation, class, period, or special occasion, including all items worn or carried by people for warmth, protection, embellishment, or symbolic purposes. In English, generally expressed in the singular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume"@en .

aat:300178814 a skos:Concept ;
    skos:definition "Designates horizontal tunnels constructed in order to listen for and intercept and destroy attackers' undermining efforts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countermines"@en .

aat:300178818 a skos:Concept ;
    skos:definition "Branch of psychology concerned with the mutually interactive relationship between the built environment and behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental psychology"@en .

aat:300178842 a skos:Concept ;
    skos:definition "Artists' books that exploit the book form or alter its physical structure as part of the content of the work. Also includes works where emphasis is on the fine crafting of the book. For sculptures that look like or incorporate books but do not communicate in the ways characteristic of books, use \"book objects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookworks"@en .

aat:300178868 a skos:Concept ;
    skos:definition "Housing for staff, provided by an educational institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faculty housing"@en .

aat:300178870 a skos:Concept ;
    skos:definition "Vessels that transport passengers, vehicles, or bulk goods across rivers, bays, or other small bodies of water, usually on regular schedules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferries"@en .

aat:300178877 a skos:Concept ;
    skos:definition "Refers to style and movement associated with a group of Polish painters and sculptors that worked between 1917 and 1922 and who were primarily known as Polish Expressionists from 1917 to 1919. The Formists exhibited works for the first time in Kraków in 1917, endeavoring to form a distinct national style in alliance with the ideologies behind Polish modernism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Formist"@en .

aat:300178881 a skos:Concept ;
    skos:definition "The insertion of stone chips into the joints of rough masonry to reduce the amount of mortar required, to wedge larger stones in position, or to add detail to the appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleting"@en .

aat:300178894 a skos:Concept ;
    skos:definition "Designates residential communities designed around golf courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf course communities"@en .

aat:300178900 a skos:Concept ;
    skos:definition "Designates roadside eateries serving a limited menu at low prices, generally over a counter or through a window; may range from slight architectural structures to freestanding buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food stands"@en .

aat:300178904 a skos:Concept ;
    skos:definition "Ribbons of protected lands and waters, primarily within or near cities, established to provide the public with access to open spaces that mitigate the hard edges and overdeveloped landscapes of urban areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenways"@en .

aat:300178907 a skos:Concept ;
    skos:definition "Theory according to which a whole cannot be analyzed without residue into the sum of its parts or reduced to discrete elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holism"@en .

aat:300178912 a skos:Concept ;
    skos:definition "A planar product manufactured from polymeric material used with soil, rock, earth, or any other geotechnical engineering related material, as an integral part of a man-made product, structure, or system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geosynthetic"@en .

aat:300178913 a skos:Concept ;
    skos:definition "Any permeable textile used with foundation, soil, rock, earth, or any other geotechnical engineering related material, as an integral part of a man-made product, structure, or system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geotextile"@en .

aat:300178918 a skos:Concept ;
    skos:definition "Type of brush strokes used in Chinese painting to indicate wrinkles, markings, and modeling on mountains, rocks, trees, and stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ts'un"@en .

aat:300178924 a skos:Concept ;
    skos:definition "Transferring or copying an image, texture, or design from a relief or incised surface to a material such as paper or cloth either by placing the material over the surface and applying pressure and friction with a medium such as chalk or pencil, or by inking the surface of the original work, placing the material, and applying pressure and friction through rubbing. The purpose may be to create a copy of the original work, or to create a design or texture for use in a new work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbing"@en .

aat:300178925 a skos:Concept ;
    skos:definition "Gold size composed of beaten egg white and vinegar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glair"@en .

aat:300178926 a skos:Concept ;
    skos:definition "Printing from raised and inked type, distinguished from lithographic or intaglio printing, particularly in the context of book and other text printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterpress printing"@en .

aat:300178973 a skos:Concept ;
    skos:definition "The style and culture of the people of the nation of Ecuador, or of earlier Quechua and other Amerindian people who lived in the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ecuadorian"@en .

aat:300179099 a skos:Concept ;
    skos:definition "The use in painting of oil paint glazes over tempera paint, or of tempera paint glazes over oil paint. For other combinations of materials and techniques, use \"mixed media.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed technique"@en .

aat:300179260 a skos:Concept ;
    skos:definition "Diamond-shaped tablets or panels exhibiting the coat of arms of a deceased person, displayed upon their death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatchments"@en .

aat:300179263 a skos:Concept ;
    skos:definition "Garden walls provided with heating channels, or flues, which create an artificial microclimate for assisting in the growth or ripening of fruit tress or shrubs trained against the walls; popular in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot walls"@en .

aat:300179268 a skos:Concept ;
    skos:definition "Dwellings that house humans and livestock under a single roof. Housebarns include rectangular buildings sheltering animals and people at opposite ends, often with a common entry, and two-story buildings with people living on the top story and livestock below. Such houses have been used since the Neolithic period, especially in the colder climates of Europe and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housebarns"@en .

aat:300179281 a skos:Concept ;
    skos:definition "The state, quality, or condition of being inaccurate, incomplete, defective and/or displeasing in some way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperfection"@en .

aat:300179282 a skos:Concept ;
    skos:definition "Systems whereby developers are granted concessions in exchange for providing amenities a community feels are desirable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incentive zoning"@en .

aat:300179285 a skos:Concept ;
    skos:definition "A nickel-chromium alloy, developed by the International Nickel Co., that is used for food and dairy equipment. It contains 79.5% nickel, 13% chromium, 6.5% iron, and 0.08% carbon, as well as small amounts of copper, manganese, and silicon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Inconel (TM)"@en .

aat:300179288 a skos:Concept ;
    skos:definition "Style of pottery, typically tea vessels, flower vases and sake containers produced in the town of Kasama, Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kasama"@en .

aat:300179295 a skos:Concept ;
    skos:definition "In general, refers to trees of the Arbutus genus. The term is also used specifically to refer to wood from only the North American members of the Arbutus genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madrona"@en .

aat:300179301 a skos:Concept ;
    skos:definition "A compact, semi-crystalline magnesian limestone from Minnesota, ranging in color from buff, cream, yellow, gray, pink, or reddish buff. It is commonly used for building as well as for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mankato stone"@en .

aat:300179304 a skos:Concept ;
    skos:definition "Pottery made in imitation of the surface appearance of colored marble by means of wedging tinted or colored clays, or by employing colored slips or glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbled ware"@en .

aat:300179305 a skos:Concept ;
    skos:definition "Domestic spaces, sometimes windowless, primarily designed or used to hold home entertainment systems as their focus, especially for viewing and listening to prerecorded or computer-based materials, such as videos, music, or games. For domestic spaces designed for high-end audio-video equipment to simulate a theaterlike environment, use \"home theaters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "media rooms"@en .

aat:300179349 a skos:Concept ;
    skos:definition "Nineteenth-century architectural style developed in Monterey, California, as a blend between local adobe structures and Yankee woodwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monterey Style"@en .

aat:300179358 a skos:Concept ;
    skos:definition "Blocks, strips, or pegs, usually made of wood, set into or onto construction, such as masonry or steel, to serve as surface into which nails may be driven. An example of use is to attach crown molding by nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nailing blocks"@en .

aat:300179372 a skos:Concept ;
    skos:definition "Refers to the concept of the physical world, including the forces at work in it and the nonhuman life inhabiting it, perceived by human beings as separate and independent from themselves, their activities, and civilization. For aggregates of physical things, conditions, and influences surrounding and affecting given organisms or communities of organisms at any time, use \"environments (object groupings).\" For the branch of biology dealing with the relations and interactions between organisms and their habitat, use \"ecology.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nature"@en .

aat:300179374 a skos:Concept ;
    skos:definition "Brand of strong vinyl-coated cloth made to look like leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Naugahyde (TM)"@en .

aat:300179376 a skos:Concept ;
    skos:definition "Masonry, usually brickwork or stone, used as nonstructural fill in the spaces between major wood wall members in timber construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nogging"@en .

aat:300179377 a skos:Concept ;
    skos:definition "Horizontal wood members between the principal timbers of half-timber construction for lateral support, especially when nogging is used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nogging pieces"@en .

aat:300179382 a skos:Concept ;
    skos:definition "Authors who write fictional prose narratives of considerable length and a certain complexity that deal imaginatively with human experience through a connected sequence of events involving a group of persons in a specific setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novelists"@en .

aat:300179384 a skos:Concept ;
    skos:definition "Safety concerned with the risks employees face in a work environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupational safety"@en .

aat:300179393 a skos:Concept ;
    skos:definition "Ornamental bands or borders, especially on an ecclesiastical vestment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orphreys"@en .

aat:300179400 a skos:Concept ;
    skos:definition "An expensive and difficult method of decorating porcelain in which designs are painted in successive layers of white porcelain slip applied in slight relief on vessels or plaques of unfired clay and lightly carved with metal instruments before first firing to achieve a cameo-like effect. The pieces are then glazed and fired again. The technique developed at Sèvres in the mid-19th century; it was most effectively practiced there and at the Minton factory by Marc-Louis-Emmanuel Solon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pâte-sur-pâte"@en .

aat:300179417 a skos:Concept ;
    skos:definition "Timber frame construction in which the upright posts are raised above damp ground on individual foundation blocks to avoid rotting the frame members and to facilitate replacement of foundation pieces without rebuilding the frame; common in the vernacular architecture of the Lower Mississippi Valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poteaux sur solle construction"@en .

aat:300179422 a skos:Concept ;
    skos:definition "Pairs of works of art that were designed, or purposefully chosen, to be displayed together, usually side by side. Examples would be portraits of a husband and wife, of the same size and scale, having the same or similar background, with the sitters arranged to face each other when hung on the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendants"@en .

aat:300179426 a skos:Concept ;
    skos:definition "The state, quality, or condition of being accurate, complete, without defect and/or delightful."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfection"@en .

aat:300179429 a skos:Concept ;
    skos:definition "Luminescence induced by the absorption of infrared radiation, visible light, or ultraviolet radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoluminescence"@en .

aat:300179430 a skos:Concept ;
    skos:definition "Colloidal vinyl resin dispersed in liquid plasticizer, which will form into a solid with the application of heat. Commonly used as a coating for metal or cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastisol"@en .

aat:300179434 a skos:Concept ;
    skos:definition "Groups of works brought together such as to exemplify the work of an artist or student. Also, groups of art works or other visual materials (often by one artist) such as photographs or prints, issued or housed together in a portfolio; they often include a loose title page or text introduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portfolios"@en .

aat:300179437 a skos:Concept ;
    skos:definition "The quarters assigned as working space for media personnel, as at sporting events and political conventions, and usually equipped with communications facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press boxes"@en .

aat:300179462 a skos:Concept ;
    skos:definition "Use in the context of aesthetic judgment for the concept of inherent merit, worthiness, or excellence in something. For the function of selecting quality standards for a project and monitoring the finished work to assure compliance with those standards, use \"quality control.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quality"@en .

aat:300179464 a skos:Concept ;
    skos:definition "Targets consisting of objects mounted on poles or on movable crossbars set on posts and used for lance practice or during tilting in the Medieval period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quintains"@en .

aat:300179466 a skos:Concept ;
    skos:definition "Highly reflective building materials with nonradiating properties, usually aluminum-foil-faced kraft paper or plastic film, placed in an airspace to block only radiant transfer from a heat-radiating surface, such as a hot roof, to a heat-absorbing surface, such as conventional attic insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiant barriers"@en .

aat:300179475 a skos:Concept ;
    skos:definition "A measure of the degree to which a surface reflects light usually expressed as the ratio of reflected light to the incident light of a reference surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflectance"@en .

aat:300179482 a skos:Concept ;
    skos:definition "Reflectance that is not specular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffuse reflectance"@en .

aat:300179485 a skos:Concept ;
    skos:definition "Designates artificial areas of water, usually of geometric shape, specifically designed and located so as to mirror buildings or other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflecting pools"@en .

aat:300179488 a skos:Concept ;
    skos:definition "The return of light, heat, or sound after striking a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflection"@en .

aat:300179490 a skos:Concept ;
    skos:definition "Reflection in which a significant portion of the light is reflected in many different directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffuse reflection"@en .

aat:300179493 a skos:Concept ;
    skos:definition "Nations in which political power resides in a body of citizens entitled to vote and is exercised by elected officers and representatives who are responsible to them and who govern according to law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "republics"@en .

aat:300179495 a skos:Concept ;
    skos:definition "Single-masted lightly armed cutters with fire lines built for governments expressly to prevent smuggling and to enforce customs regulations; in use mostly from the late 18th to the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revenue cutters"@en .

aat:300179500 a skos:Concept ;
    skos:definition "Style focusing on artistic iconoclasm and the breaking down of the traditional boundaries of academicians, abandoning realism in favor of methods intended to cause an intuitive response in the perceiver. The style was influenced by the philosophy of Henri Bergson, son of a Polish Jewish musician. The style in art, writing, and music was explored in the journal Rhythm, founded by John Middleton Murry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhythmist"@en .

aat:300179502 a skos:Concept ;
    skos:definition "Planning how to conduct affairs by assessing, minimizing, and preventing potential losses, injuries, or other damages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "risk management"@en .

aat:300179504 a skos:Concept ;
    skos:definition "Refers to the science of robot design, construction, and use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robotics"@en .

aat:300179505 a skos:Concept ;
    skos:definition "Style characterized by horizontally-oriented low buildings of one or two stories, flat roofs with little or no overhang, broad blank surfaces, few openings, components divided by small modules, materials of plaster, wood, brick, and tile, and colors in the ranges of reddish brown to cream. The style developed in Santa Fe, New Mexico, United States, as a statutory unified building style that incorporated synthesized elements of Pueblo Revival, Territorial, Native American, and American western styles, based on the Santa Fe Governor's Palace, Native American pueblos, and Spanish villages of the upper Rio Grande valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santa Fe Style"@en .

aat:300179506 a skos:Concept ;
    skos:definition "Buildings that house a variety of individual and family social, educational, and recreational facilities provided for recent immigrants or residents of underprivileged neighborhoods; especially in England and the United States since the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settlement houses"@en .

aat:300179513 a skos:Concept ;
    skos:definition "Refers to the work of a group of avant-garde artists and cultural theorists active in several European countries from 1957 to 1972. Known formally as the Internationale Situationniste, the group was influenced by Dada, Surrealism, Marxism, and anarchism. The movement was highly politicized and often defaced appropriated imagery and comic strips with revolutionary slogans. Founded by Guy Debord, Situationists were influential in the developments of the general strike in Paris, May 1968."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Situationist"@en .

aat:300179524 a skos:Concept ;
    skos:definition "Durable wood of the species Brosimum guianense, that is deep mahogany-red in color, heavy, with a fine uniform texture. Although the grain is straight, the wood has a distinct yellow, dark red, and brown mottled pattern that resembles snakeskin. It was particularly popular for veneers in the late 18th century. It is still used for veneers, walking sticks, modeling tools, and umbrella handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snakewood"@en .

aat:300179528 a skos:Concept ;
    skos:definition "Restaurants with counters at which soda water, ice cream, and light meals are served; may also be used to designate the dispensing equipment or counter itself, especially when found as fixtures in commercial buildings, such as drugstores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soda fountains"@en .

aat:300179533 a skos:Concept ;
    skos:definition "Art works, especially paintings and prints, designed for popular taste and marketed as home furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sofa art"@en .

aat:300179535 a skos:Concept ;
    skos:definition "Means of observing the way a substance transmits, emits, or responds to various wavelengths in the electromagnetic energy spectrum. To refer to measurement of wavelengths (rather than only looking at them) of a spectrum, and not necessarily wavelengths only of electromagnetic energy spectrum, use \"spectrometry.\" When the word is used in a bound compound term, it may form a synonym for spectrometry, as process of observing and measuring are not distinguished; examples are \"infrared spectrometry\" and \"infrared spectroscopy,\" which are considered synonyms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectroscopy"@en .

aat:300179538 a skos:Concept ;
    skos:definition "Spectroscopy technique concerned with the spectrum between the visible and the short-wavelength microwave. Infrared spectroscopy can detect the internal vibration of molecules. The field was traditionally broken into near-, mid-, and far-infrared spectroscopy, although with the development of Fourier-transform spectrometers, this distinction of areas has blurred and the more sophisticated instruments can cover from 10 to 25,000 cm-1 by an interchange of source, beam splitter, detector, and sample cell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared spectroscopy"@en .

aat:300179544 a skos:Concept ;
    skos:definition "Infrared spectroscopy having the range of 4,000-12,500 inverse centimeters [cm-1]."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "near-infrared spectroscopy"@en .

aat:300179632 a skos:Concept ;
    skos:definition "Industrial establishments where employees are underpaid and overworked usually under unsanitary or otherwise barely tolerable conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweatshops"@en .

aat:300179639 a skos:Concept ;
    skos:definition "Architectural style originating in the American Southwest, characterized by squared-off adobe construction, brick coping at the top of the structure, square beams rather than round vigas, and relatively formal Victorian-style windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Territorial Style"@en .

aat:300179654 a skos:Concept ;
    skos:definition "Parts of a lamp, usually an oil lamp or other lamp with liquid fuel, that support and permit adjustment of the wick and are the seat of fuel combustion that provides the light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burners"@en .

aat:300179659 a skos:Concept ;
    skos:definition "Burners with one or more thin, tapering wick tubes extending above the burner plate but cut off immediately below it to prevent conducting heat into the font containing highly volatile fuel (a mixture of alcohol and redistilled turpentine). When there is more than one tube, they diverge from base to top. Usually small caps are attached by chains to each tube for use in extinguishing the flame and to prevent evaporation of the fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning fluid burners"@en .

aat:300179667 a skos:Concept ;
    skos:definition "Burners for the combustion of kerosene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerosene burners"@en .

aat:300179668 a skos:Concept ;
    skos:definition "Burners using oil to produce heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil burners"@en .

aat:300179669 a skos:Concept ;
    skos:definition "Burners employing a circular wick mounted between two metal tubes through which a current of air rises to feed the inside of the wick; also used for gas burners with multiple holes arranged in a circle with a hollow center providing a central draft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Argand burners"@en .

aat:300179675 a skos:Concept ;
    skos:definition "Burners for oil lamps consisting of a thin metal disc mounted on a cork through which one or more wick tubes protrude."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cork disc burners"@en .

aat:300179679 a skos:Concept ;
    skos:definition "Metallic discs perforated by one or two wick tubes, which rest on the opening into the font; such burners often have a small tab on the edge by which they can be lifted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop burners"@en .

aat:300179682 a skos:Concept ;
    skos:definition "Tubular devices of glass, metal, or mica which extend upward from the rim of the burner and concentrate the hot air rising from the flame, thus producing a draft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimneys"@en .

aat:300179685 a skos:Concept ;
    skos:definition "Fuel containers that support the burner and receive the lower part of the wick and that are an integral part of the lamp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fonts"@en .

aat:300179687 a skos:Concept ;
    skos:definition "Clear glass devices fitted over a candle and resting on the socket to protect the flame from drafts, usually flaring outward at the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hurricane glasses"@en .

aat:300179708 a skos:Concept ;
    skos:definition "Drip catchers fitted to the sockets of candleholders; may be fixed or removable and are usually made of metal or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bobeches"@en .

aat:300179711 a skos:Concept ;
    skos:definition "Instruments comprising a long pole or handle to which is affixed a wick or other lighting mechanism, used to light the candles located above convenient reach in a church. A candle snuffer is sometimes attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlelighters"@en .

aat:300179720 a skos:Concept ;
    skos:definition "Irregular marking of a printing plate during biting as a result of faulty grounding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foul biting"@en .

aat:300179725 a skos:Concept ;
    skos:definition "The technique of dropping or painting acid onto an aquatint ground to allow localized and controlled biting. To control the acid application, traditionally, a clean brush was coated with saliva, dipped into nitric acid, and brushed onto the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spit biting"@en .

aat:300179733 a skos:Concept ;
    skos:definition "Technique of submerging a printing plate in acid in stages to produce subtle tonal gradations or other effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creeping bite"@en .

aat:300179734 a skos:Concept ;
    skos:definition "Exposing to acid relatively large, unbounded areas of a printing plate, as opposed to relatively small, restricted areas, such as lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open biting"@en .

aat:300179739 a skos:Concept ;
    skos:definition "Excessive biting of a printing plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overbiting"@en .

aat:300179742 a skos:Concept ;
    skos:definition "Insufficient biting of a printing plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underbiting"@en .

aat:300179751 a skos:Concept ;
    skos:definition "Images carved in low relief or inscribed into living rock with relatively linear incisions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock engravings"@en .

aat:300179876 a skos:Concept ;
    skos:definition "Lamps with fonts, either of metal or glass, which are high and narrow, generally tapering from top to bottom, and which have one to six diverging wick tubes that extend well beyond the height of the burner. Small metal caps attached by chains are furnished to extinguish the flame and retard evaporation of the volatile fuel (alcohol and redistilled turpentine or camphene)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning fluid lamps"@en .

aat:300179883 a skos:Concept ;
    skos:definition "Lamps equipped with containers for calcium carbide, a reservoir of water with a controlled drip, and a nozzle or burner for the combustion of the acetylene gas produced by bringing the water into contact with the calcium carbide; also lamps with acetylene burners connected to a central source of acetylene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetylene lamps"@en .

aat:300179904 a skos:Concept ;
    skos:definition "Devices with a wrought iron standard, often ornate, supporting a horizontal flat ring and spring for clamping whatever is placed within the ring. May have been intended for holding a torch or link rather than an ordinary candle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alpine candleholders"@en .

aat:300179947 a skos:Concept ;
    skos:definition "Devices holding two to four candles and made of gilt brass with an adjustable painted metal shade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouillotte lamps"@en .

aat:300179950 a skos:Concept ;
    skos:definition "Lamps fitted with from one to four lenses to concentrate and intensify light, most commonly made of pewter or of tinned sheet iron with a separate glass font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bull's eye lamps"@en .

aat:300179961 a skos:Concept ;
    skos:definition "Lanterns fitted with a lens or lenses, sometimes of knobbed or faceted glass to concentrate and intensify light. May be four-sided with lenses on three sides and a handle on the fourth, or have a lens on one side and a handle on the opposite side, or be cylindrical with a hinged door on which the lens or lenses are mounted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bull's eye lanterns"@en .

aat:300179976 a skos:Concept ;
    skos:definition "Lamps with single or multiple wick tubes mounted at the end of a pole for carrying in political parades and torchlight processions. The lamp fonts are often shaped like stars, eagles, top hats, or other political symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campaign torches"@en .

aat:300180019 a skos:Concept ;
    skos:definition "Beams of wood or iron between the chancel and the nave of a church upon which candles are placed, and on which the rood usually stands; the term also refers to any supports that resemble such beams in ecclesiastical settings; any T-shaped or horizontal beamlike or rail-like candle supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle beams"@en .

aat:300180022 a skos:Concept ;
    skos:definition "Supports for candles which attach to a wall; the supporting arm may be jointed or rigid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle brackets"@en .

aat:300180027 a skos:Concept ;
    skos:definition "Chandeliers made to hold candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle branches"@en .

aat:300180031 a skos:Concept ;
    skos:definition "Lamps using candles as the source of illumination and containing the candle within a vessel. For devices that hold a candle or candles from their bases use \"candleholders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle lamps"@en .

aat:300180041 a skos:Concept ;
    skos:definition "Tall standards usually meant to rest on the floor supporting arms or branches fitted with candle sockets; also shorter versions for use on tables or other raised surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlestands"@en .

aat:300180048 a skos:Concept ;
    skos:definition "Lamps with fonts that are pivoted so that, as fuel is consumed, the lamp will tilt, automatically or manually, feeding more fuel to the wick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canting lamps"@en .

aat:300180058 a skos:Concept ;
    skos:definition "Lamps which utilize Cardan's (1550) adaptation of the barometric feed principle which permits a large reservoir to feed the fuel as needed without recourse to canting or pumping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cardan lamps"@en .

aat:300180062 a skos:Concept ;
    skos:definition "Protected lamps or lanterns, fixed or removable, used on coaches or carriages. Commonly made of brass, they often were fitted with reflectors as well as red lenses to serve as tail lights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage lamps"@en .

aat:300180070 a skos:Concept ;
    skos:definition "Candleholders with a single candle socket set on a flat saucer or traylike base. For candleholders with a single candle socket mounted on a support with a widened base or foot, use \"candlesticks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chambersticks"@en .

aat:300180076 a skos:Concept ;
    skos:definition "Small metal or glass lamps frequently with a saucer base meant for use in the bedchamber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber lamps"@en .

aat:300180081 a skos:Concept ;
    skos:definition "Lighting devices fixed in place, such as those attached to a ceiling or wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting fixtures"@en .

aat:300180098 a skos:Concept ;
    skos:definition "Candles made of wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bougies"@en .

aat:300180112 a skos:Concept ;
    skos:definition "Ring-shaped attachments to lamps, usually of brass, which surround the opening of the font, and are threaded inside to receive the screw of the burner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collars"@en .

aat:300180115 a skos:Concept ;
    skos:definition "Hanging lights, typically suspended from the roof of a church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronas"@en .

aat:300180134 a skos:Concept ;
    skos:definition "Any lantern with means of closing off light without extinguishing the flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark lanterns"@en .

aat:300180138 a skos:Concept ;
    skos:definition "Mechanical lamps similar to Carcel lamps in that they contain a clockwork movement in the base actuating a pump which forces oil through a tube from the reservoir to the wick. The distinction between Diacon and Carcel lamps is unclear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diacon lamps"@en .

aat:300180144 a skos:Concept ;
    skos:definition "Crusies incorporating two pans, the upper pan to hold the fuel and wick and the lower pan to serve as a drip catcher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double crusies"@en .

aat:300180156 a skos:Concept ;
    skos:definition "Any lamp whose light is directed downwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downlights"@en .

aat:300180160 a skos:Concept ;
    skos:definition "Burners designed to hold two wicks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duplex burners"@en .

aat:300180170 a skos:Concept ;
    skos:definition "Night lamps having a base and shade of glass, burning a short, thick candle with a self-snuffing rush wick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fairy lamps"@en .

aat:300180175 a skos:Concept ;
    skos:definition "Lights which soften or eliminate the shadows created by strongly directional lighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fill lights"@en .

aat:300180179 a skos:Concept ;
    skos:definition "Lamps which burn fish oil, usually simple lamps such as pan lamps and crusies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish oil lamps"@en .

aat:300180183 a skos:Concept ;
    skos:definition "Torches of tow or cotton wicks saturated with resin, coated with wax; often four wicks were joined and coated again to increase the size of the torch. Also, torches carried for pyrotechnical display, as in public parades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flambeaux"@en .

aat:300180187 a skos:Concept ;
    skos:definition "Spout lamps, usually made of sheet brass, having a cylindrical reservoir with a domed or conical cover and a single wick tube with a drip-catching channel immediately below, mounted on a standard with a weighted base. Of a type detailed in a painting of the Flemish school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flemish spout lamps"@en .

aat:300180193 a skos:Concept ;
    skos:definition "Lamps with a wick supported on a small platform, such as cork or wood, which floats on the surface of the oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "float lamps"@en .

aat:300180196 a skos:Concept ;
    skos:definition "Lighting units consisting of one or more lamps in a metal hood with a reflector or inner reflecting surface; used to illuminate large areas diffusely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floodlights"@en .

aat:300180204 a skos:Concept ;
    skos:definition "Kerosene floor lamps consisting of a three- or four-legged stand supporting a vertical rod which can be adjusted for height. At the top of the rod is a bowl-shaped false font, containing the oil pot with its burner, chimney, and shade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano lamps"@en .

aat:300180215 a skos:Concept ;
    skos:definition "Set of striplights at the front edge of the stage platform used to soften face shadows cast by overhead lights and to add general toning lighting from below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footlights"@en .

aat:300180219 a skos:Concept ;
    skos:definition "Lighting fixtures fitted with gas burners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas fixtures"@en .

aat:300180232 a skos:Concept ;
    skos:definition "Chandeliers for gas lamps; the term is used especially for such fixtures dating to the early usage of electricity in homes, when distinguishing such chandeliers from chandeliers with electric lights or candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasoliers"@en .

aat:300180235 a skos:Concept ;
    skos:definition "Lamps supported on a contrivance that permits them to move freely in any direction yet remain upright; often used on ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gimbal lamps"@en .

aat:300180240 a skos:Concept ;
    skos:definition "Globular or hemispherical glasses used to protect the light source within, diffuse or redirect its light, or modify its color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globes"@en .

aat:300180244 a skos:Concept ;
    skos:definition "Lamps with a large globular glass shade open at the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globe lamps"@en .

aat:300180260 a skos:Concept ;
    skos:definition "Refers to shallow iron oblong dishes with handles used to heat tallow for use in coating the rushes used in rushlights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grissets"@en .

aat:300180264 a skos:Concept ;
    skos:definition "Lamps designed to be suspended in foyers or entries, often with the font and burner inside a shade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hall lamps"@en .

aat:300180268 a skos:Concept ;
    skos:definition "Lanterns hung from ceiling hooks to light a foyer, lobby, or antechamber, usually of glass with a fine decorative metal frame; often gilded or painted, and the glass may be clear or decorated by etching and painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hall lanterns"@en .

aat:300180271 a skos:Concept ;
    skos:definition "Small lamps in which the font usually forms the bottom of the lamp, and having one or more handles for carrying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand lamps"@en .

aat:300180280 a skos:Concept ;
    skos:definition "Mechanical lamps designed to burn without a chimney, having a spring-driven blower in the base to provide a draught. Patented by Robert Hitchcock in 1868."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hitchcock lamps"@en .

aat:300180284 a skos:Concept ;
    skos:definition "Candlesticks usually of sheet iron on a convex disc base with a straight tubular stem bearing a round drip catcher at the top. A slot in the side of the stem accommodates a finger grip for operating the candle adjuster and ejector, and a suspension hook sometimes extends from the drip catcher. The name is believed to be derived from a resemblance to the device used to scrape the bristles from butchered hogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hogscraper candlesticks"@en .

aat:300180294 a skos:Concept ;
    skos:definition "Electric lamps in which light is produced by a tungsten filament heated to incandescence by an electric current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incandescent lamps"@en .

aat:300180303 a skos:Concept ;
    skos:definition "Betty lamps supported on a standard or tidy top; of a type attributed to the Ipswich region of Massachusetts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ipswich betty lamps"@en .

aat:300180315 a skos:Concept ;
    skos:definition "Lamps with a drum-shaped font hung on two trunnions; of a type attributed to the Pennsylvania Germans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kettle lamps"@en .

aat:300180323 a skos:Concept ;
    skos:definition "Lighting devices with a lens or lens system which produces a concentrated, sharply defined beam of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spotlights"@en .

aat:300180332 a skos:Concept ;
    skos:definition "Lighting devices which emit strong directional light. Often used in photography and filmmaking to illuminate the subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key lights"@en .

aat:300180362 a skos:Concept ;
    skos:definition "Printed matter of any kind, or written works in digital form. Examples are tales and writings of a nation, region, period, or language, of a particular form or genre, on a particular subject, or for a particular audience. For the written works produced by an individual or specific group of individuals, use \"writings\". For the discipline of the humanities dealing with written or oral verbal literary works, use \"literary studies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literature"@en .

aat:300180375 a skos:Concept ;
    skos:definition "The practice of borrowing pre-existing forms or images to form a new art work, particularly when done in order to bring into question issues of originality in art, for example, in certain Post-modern art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appropriation"@en .

aat:300180393 a skos:Concept ;
    skos:definition "Inert gaseous element with symbol Ne and atomic number 10; used as the medium in some electric discharge lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neon"@en .

aat:300180396 a skos:Concept ;
    skos:definition "Development designed to ensure that the utilization of resources and the environment today does not damage prospects for their use by future generations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sustainable development"@en .

aat:300180400 a skos:Concept ;
    skos:definition "Toys that are generally inversely conical, pear-shaped, or faceted with a point on which they are made to spin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tops"@en .

aat:300180425 a skos:Concept ;
    skos:definition "Torches formed from lengths of rope or the like impregnated with wax, tallow, resin, or tar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "links"@en .

aat:300180427 a skos:Concept ;
    skos:definition "Spout lamps, usually of cast bronze, often having three or four wick tubes and a font adjustable for height on a vertical standard; of a type used in Mediterranean countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lucernas"@en .

aat:300180463 a skos:Concept ;
    skos:definition "Argand lamps usually of brass or bronze with one or two burners on arms connected by tubes to a reservoir that feeds fuel to the burners on the bird-fountain principle, often ornamented with prisms hung from rings around the reservoir and burners. The name derives from their common use singly or in sets of three on mantels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantel lamps"@en .

aat:300180477 a skos:Concept ;
    skos:definition "Candleholders with a hook and a spike so that they could either be hung or stuck in a timber or wall of a mine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miners' candlesticks"@en .

aat:300180485 a skos:Concept ;
    skos:definition "Lamps designed for use in mines; especially cast iron lamps often with a circular lidded font containing a single wick channel or tube and a D-shaped bail on pivots terminating in a spike or shallow pans with wick channels or supports and half bails terminating in hooks or spikes; also coffeepot-shaped spout lamps of tinned sheet iron worn on miners' caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miners' lamps"@en .

aat:300180493 a skos:Concept ;
    skos:definition "Mechanical lamps which have a spring-loaded piston in the reservoir which forces oil up through an elaborate control mechanism to the burner. These lamps may be identified by the large flat key below the burner used to compress the spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moderator lamps"@en .

aat:300180499 a skos:Concept ;
    skos:definition "Lamps consisting of exhausted glass tubes filled with neon gas that is ionized and conducts an electric current through the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neon lamps"@en .

aat:300180502 a skos:Concept ;
    skos:definition "Small lamps intended for use in the bedroom or sickroom. Originally glass float lamps; also includes miniature, especially glass, oil and kerosene lamps of the late 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "night lights"@en .

aat:300180509 a skos:Concept ;
    skos:definition "Devices that are a combination of a dark lantern, night light, heater for food, milk, or shaving water, candleholder (in handle), and tinder box, usually made of tinned sheet iron. Based on a patented design of William Howe of Boston, 1812. Use also for earlier European examples partially or wholly of ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursery lamps"@en .

aat:300180518 a skos:Concept ;
    skos:definition "Lamps employing the principle of hydrostatic balance to deliver oil to the wick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrostatic lamps"@en .

aat:300180523 a skos:Concept ;
    skos:definition "Lamps consisting of simple, open, shallow vessels into which fuel is placed. The wick rests in the fuel on the bottom of the pan; sometimes equipped with hangers so that they can be suspended from the ceiling, wall, or a lampstand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pan lamps"@en .

aat:300180533 a skos:Concept ;
    skos:definition "Small oil lamps consisting essentially of a font and burner with a short rounded stub on the bottom for insertion into a socket of a candlestick, sconce, or chandelier; usually of metal or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peg lamps"@en .

aat:300180540 a skos:Concept ;
    skos:definition "Globular or hemispherical fonts with, usually, whale-oil burners, supported on a truncated cone base with a carrying handle on one side. Within the base is attached a peg, tapering downward, for insertion into a candle socket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petticoat lamps"@en .

aat:300180551 a skos:Concept ;
    skos:definition "Lamps which consist of a horizontal cylinder, usually made of tin, set on short legs and having three large wick tubes along the top. Sometimes having tube caps, handle and a tray or spice burner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pig lamps"@en .

aat:300180554 a skos:Concept ;
    skos:definition "Candleholders with upright spikes for impaling the candle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prickets"@en .

aat:300180562 a skos:Concept ;
    skos:definition "Oil lamps which incorporate a spring-loaded pump mechanism to force oil from the reservoir in the base through a tube to the burner at its top when the tube is pushed down; usually pewter and of French manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pump lamps"@en .

aat:300180565 a skos:Concept ;
    skos:definition "Devices incorporated into the stems of candleholders for the purpose of adjusting the candle in the holder and ejecting the stub."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pushups"@en .

aat:300180572 a skos:Concept ;
    skos:definition "Devices with a reflecting surface, often of metal, glass, or fabric, used behind or in front of a light source to redirect light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflectors"@en .

aat:300180576 a skos:Concept ;
    skos:definition "Fuel containers which do not bear burners; for fuel containers that support burners, use \"fonts (lighting device components).\" Some lamps have both fonts and reservoirs, in which case fuel is supplied automatically or manually from the reservoir to the font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reservoirs"@en .

aat:300180580 a skos:Concept ;
    skos:definition "Lamps that burn rosin oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosin-oil lamps"@en .

aat:300180588 a skos:Concept ;
    skos:definition "Lamps with eight small oil fonts or candle sockets, one for each day of observance of the festival of Hanukkah, and a ninth oil font or candle socket, called the shamash or server, used for lighting the others. For the holy candelabra used in the Jewish Temple, use \"menorahs (temple lamps).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanukkah lamps"@en .

aat:300180638 a skos:Concept ;
    skos:definition "Sheet iron cylinders 8 to 10 inches in diameter and about a foot high, pierced all over with regularly spaced holes. Placed over burning rushlights or rush candles at night for safety."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rushlight shades"@en .

aat:300180642 a skos:Concept ;
    skos:definition "Lighting devices consisting of rush, with most of the outer skin or cortex peeled off, dried and saturated in hot grease or fat, and burned for light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rushlights"@en .

aat:300180646 a skos:Concept ;
    skos:definition "Wick channel hanging oil lamps with six or eight channels radiating from a central support, drip catcher suspended below, of brass or other metal; lighted in Jewish homes at the beginning of the Sabbath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sabbath lamps"@en .

aat:300180674 a skos:Concept ;
    skos:definition "Designates passive reflective or dynamic elements in the cultural landscape that incorporate water as the primary design feature; for naturally occurring areas of water use the descriptors under \"bodies of water.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water features"@en .

aat:300180681 a skos:Concept ;
    skos:definition "A type of fine white clay used to make tobacco pipes and fine earthenwares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe clay"@en .

aat:300180688 a skos:Concept ;
    skos:definition "Devices for pressing cheese curds in a mold or hoop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese presses"@en .

aat:300180699 a skos:Concept ;
    skos:definition "Ceramics styles belonging to modern Dutch cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern Dutch ceramics styles"@en .

aat:300180700 a skos:Concept ;
    skos:definition "Refers to the style of hard-paste porcelain produced by the factory of the same name from 1784 to 1820. The style is characterized by the use of high-quality styles copied from Meissen and painted in polychrome enamel, typically in brown or other tonal colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amstel"@en .

aat:300180706 a skos:Concept ;
    skos:definition "Objects, often valuables, deposited with a corpse, in or near a grave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave goods"@en .

aat:300180724 a skos:Concept ;
    skos:definition "The interdisciplinary study of the mutually adaptive interrelationship of individuals and their near environment; involves aspects of demographics, home economics, housing, design, social services, and family behavior. For the study of the broader spatial and organizational patterns of people across the landscape, use \"human geography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human ecology"@en .

aat:300180728 a skos:Concept ;
    skos:definition "Methods of design that are conscious of the ozone-depleting and polluting effects of building materials and processes, that encourage energy and natural resource conservation and recyclability, and are, on the whole, ecologically sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green design"@en .

aat:300180734 a skos:Concept ;
    skos:definition "Workspaces in the home set aside exclusively for income-producing businesses; for reading and writing spaces used for household accounting or recreational purposes, use \"studies (rooms).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home offices"@en .

aat:300180756 a skos:Concept ;
    skos:definition "In psychological studies, refers to the condition based on pseudo-hallucinations that occur when feelings of fear or anxiety are projected onto external objects and experiences, or are imagined, invented, or wrongly ascribed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illusion"@en .

aat:300180803 a skos:Concept ;
    skos:definition "Lamps incorporating any of various features designed to make the burning of volatile fuels safe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety lamps"@en .

aat:300180810 a skos:Concept ;
    skos:definition "Float lamps used especially in churches or temples, having a cup or vase-shaped reservoir of colored glass or metal. By tradition and eccliastical dictate, it is mandatory for Jewish temples and many Chrisitan churches to have a constantly burning oil lamp in the sanctuary, in the vicinity of the tabernacle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanctuary lamps"@en .

aat:300180813 a skos:Concept ;
    skos:definition "Devices which make it possible to burn the last inch of a candle. Includes small pans or short cylinders, usually metal, with one or more pins or adjustable arms at the top for holding a candle stub, and some with a peg to fit into a candleholder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "savealls"@en .

aat:300180818 a skos:Concept ;
    skos:definition "Lighting devices designed to produce an approximately parallel beam of light, mounted on a fixed or movable platform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "searchlights"@en .

aat:300180826 a skos:Concept ;
    skos:definition "Devices, usually glass, suspended above lighting devices with an open flame to protect the ceiling from soot deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoke bells"@en .

aat:300180842 a skos:Concept ;
    skos:definition "Hand lamps with very small fonts of blown glass with drop or cork disc burners, or of metal on saucer bases with slender whale oil burners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spark lamps"@en .

aat:300180853 a skos:Concept ;
    skos:definition "Heartwood of pine or other resinous wood cut into long slivers or splinters for burning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splints"@en .

aat:300180864 a skos:Concept ;
    skos:definition "Candlesticks consisting of a helix which is wound from a wrought iron strip or rod forming the stem of the candlestick mounted on a wooden base. A sufficient space is left between each turn of the spiral to allow a cup or disc containing the candle socket with a side projection to be raised or lowered by rotation within the spiral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral candlesticks"@en .

aat:300180874 a skos:Concept ;
    skos:definition "Devices in which the candle is enclosed in a metal tube with a wick hole at the top and a coiled spring at the base of the candle to push it up as it burns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring candleholders"@en .

aat:300180885 a skos:Concept ;
    skos:definition "Rows of small floodlights mounted on trough reflectors and used for theater borderlights, footlights, and general stage illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striplights"@en .

aat:300180952 a skos:Concept ;
    skos:definition "Brass or wrought iron pincers supported horizontally by a standard on a tripod, disc, or four-legged bases. The taper is coiled around the vertical shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taper jacks"@en .

aat:300180961 a skos:Concept ;
    skos:definition "Devices in which the taper is wound on reels or drums and unwound and pulled up through grips as needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taper reels"@en .

aat:300180966 a skos:Concept ;
    skos:definition "Slender wax candles; also long cords or wicks thinly coated with fat or wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapers"@en .

aat:300180972 a skos:Concept ;
    skos:definition "Candles used to mark or measure the passage of time, typically made in such a way as to burn down at a uniform rate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time candles"@en .

aat:300180982 a skos:Concept ;
    skos:definition "Candleholders, usually of painted sheet iron or brass, for one or two candles with shades mounted on a rod supported by a weighted base. The holders and shades are independently adjustable on the rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student candle lamps"@en .

aat:300180989 a skos:Concept ;
    skos:definition "Lamps with fonts or reservoirs marked to indicate the passage of time by the falling level of fuel, usually either pewter Cardan lamps with a glass reservoir, or small glass kerosene lamps with cylindrical fonts bearing the hour markings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time lamps"@en .

aat:300181014 a skos:Concept ;
    skos:definition "Tubular or frame holders to support a torch in a fixed position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torch holders"@en .

aat:300181021 a skos:Concept ;
    skos:definition "Adjustable devices used to raise or lower a crook at different heights over a fire; a cooking pot is typically suspended from the crook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trammels"@en .

aat:300181045 a skos:Concept ;
    skos:definition "Lamps with an Argand burner in which the central draft is introduced through a slit in the circular wick rather than up a tube, and which has a glass font to keep the heat of the flame away from the highly volatile camphene, which these lamps are designed to burn; the burner employs both solar and button deflectors. Developed by James Young in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vesta lamps"@en .

aat:300181051 a skos:Concept ;
    skos:definition "Burners having a domed deflector and a simple, collarlike perforated chimney-holder attached to the base plate; believed to be the earliest flat wick kerosene burner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vienna burners"@en .

aat:300181056 a skos:Concept ;
    skos:definition "Lenses, usually in the form of blown glass globes, which when filled with water and suspended before a light, act as a lens refractor to condense or concentrate light upon a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water lenses"@en .

aat:300181063 a skos:Concept ;
    skos:definition "Glass table lamps with twin fonts and burners on a single standard and base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding lamps"@en .

aat:300181080 a skos:Concept ;
    skos:definition "Burners consisting of metal discs with vent holes and one or two, sometimes three, tinned wick tubes 1/4 inch or less in diameter soldered upright and a wick slot in the side. The wick tubes extend farther below the disc, into the font, than above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whale oil burners"@en .

aat:300181090 a skos:Concept ;
    skos:definition "Shallow lamps with one or more grooves or channels projecting beyond the general outline of the pan, in which the wicks are placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wick channel lamps"@en .

aat:300181105 a skos:Concept ;
    skos:definition "Circular or flattened-ovoid tubes extending through the base plate of a lamp and housing the wick; combustion of fuel and wick takes place at the top of the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wick tubes"@en .

aat:300181108 a skos:Concept ;
    skos:definition "Those elements in lighting devices, usually cords, ribbons, or tubes of loosely woven, twisted, or braided fibers, that draw fuel to the flame by capillary action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wicks"@en .

aat:300181110 a skos:Concept ;
    skos:definition "Series of iron or brass rods, usually six, set upright in a circle into a wooden base, joined at the top by a flat iron ring. A lower ring with finger loop and candle socket slides vertically on the rods to adjust height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire candlesticks"@en .

aat:300181185 a skos:Concept ;
    skos:definition "Property ownership arrangement in which persons or groups of persons share ownership or rental, usually of vacation housing, and each owner holds title for a specified time each year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timesharing"@en .

aat:300181194 a skos:Concept ;
    skos:definition "Mixed-use communities designed to combine residential sections in close proximity to employment, retail, and entertainment facilities linked by pedestrian-oriented thoroughfares; often located in suburban contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban villages"@en .

aat:300181199 a skos:Concept ;
    skos:definition "Refers to the works of a group of photographer working in Western Europe in the 1950's who were influenced by the teaching of Professer Otto Steinert. Emphasizing experimentation and the creative impulses of the photographer, the style is characterized by the subordination of the subject matter and an emphasis on pattern and form, in a manner akin to graphic art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Subjective photography"@en .

aat:300181207 a skos:Concept ;
    skos:definition "Devices used with an electric discharge lamp to obtain and maintain the necessary circuit conditions, such as voltage, current, and wave form, for starting and operating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballasts"@en .

aat:300181212 a skos:Concept ;
    skos:definition "Ballasts specially constructed to have certain prescribed characteristics for use in testing electric discharge lamps and other ballasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reference ballasts"@en .

aat:300181215 a skos:Concept ;
    skos:definition "Lighting fixtures attached to or suspended from the ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling fixtures"@en .

aat:300181220 a skos:Concept ;
    skos:definition "Illuminated lamps that are attached to vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vehicle lights"@en .

aat:300181221 a skos:Concept ;
    skos:definition "Lighting devices mounted on a vehicle for the purpose of indicating the overall width and height of the vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clearance lamps"@en .

aat:300181228 a skos:Concept ;
    skos:definition "Incandescent lamps having a constant but not necessarily known luminous intensity against which other lamps are successively compared in a photometer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comparison lamps"@en .

aat:300181231 a skos:Concept ;
    skos:definition "Incandescent or fluorescent lamps whose artificial light aproximates daylight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daylight lamps"@en .

aat:300181255 a skos:Concept ;
    skos:definition "Lamps in which light, or radiant energy near the visible spectrum, is produced by the passage of an electric current through a vapor or a gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric discharge lamps"@en .

aat:300181267 a skos:Concept ;
    skos:definition "Lamps which radiate a significant portion of their radiative power in the ultraviolet part of the spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet lamps"@en .

aat:300181273 a skos:Concept ;
    skos:definition "Troughs serving as a base and reflector for a fluorescent lighting unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "troffers"@en .

aat:300181275 a skos:Concept ;
    skos:definition "Single opaque or translucent elements which shield a source from direct view at certain angles and absorb unwanted light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baffles"@en .

aat:300181282 a skos:Concept ;
    skos:definition "Transparent devices often of gelatin or glass which are placed in front of a light source and serve to diminish the intensity or alter the color of the light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filters"@en .

aat:300181306 a skos:Concept ;
    skos:definition "Powerful spotlights having a plano-convex lens thinned by reducing the convex side to a series of concentric rings of approximately the same focal length and producing a smooth, soft-edged beam of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fresnel spotlights"@en .

aat:300181314 a skos:Concept ;
    skos:definition "Any lights in a theater, especially those installed in the audience area (house), except exit lights or lights on or back of the stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house lights"@en .

aat:300181318 a skos:Concept ;
    skos:definition "Floodlights, usually fixed, consisting of a lamp in an ellipsoidal or paraboloidal reflector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scoops"@en .

aat:300181320 a skos:Concept ;
    skos:definition "Stage lights, usually spotlights or striplights, mounted at each side of the stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tormentor lights"@en .

aat:300181326 a skos:Concept ;
    skos:definition "Popular name for any powerful spotlight; formerly described high-intensity carbon arc spotlights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Klieglights (TM)"@en .

aat:300181334 a skos:Concept ;
    skos:definition "Narrow-beam lighting devices consisting of a high powered lamp; used as spotlights or directed floodlights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projectors"@en .

aat:300181344 a skos:Concept ;
    skos:definition "Projectors whose lamp may be moved toward or away from the reflector to vary the beam spread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beam projectors"@en .

aat:300181362 a skos:Concept ;
    skos:definition "Sets of adjustable flaps, usually two or four, that are attached to the front of a luminaire in order to partially control the shape and spread of the light beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barn doors"@en .

aat:300181372 a skos:Concept ;
    skos:definition "Lamps employing a reflector in order to project light in a particular direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projector lamps"@en .

aat:300181382 a skos:Concept ;
    skos:definition "Flash lamps consisting of a gas-filled tube activated by a discharge of electric current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic flashes"@en .

aat:300181395 a skos:Concept ;
    skos:definition "Lamps providing a brief, brilliant burst of light, synchronized with a camera's shutter activation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash lamps"@en .

aat:300181400 a skos:Concept ;
    skos:definition "Electrical lamps with increased voltage for sustained illumination while taking photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoflood lamps"@en .

aat:300181451 a skos:Concept ;
    skos:definition "Any lights designated for use during a power outage or other emergency; often required by municipal regulations in public buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency lights"@en .

aat:300181473 a skos:Concept ;
    skos:definition "Lights mounted on the front of a vehicle to provide illumination ahead of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headlights"@en .

aat:300181477 a skos:Concept ;
    skos:definition "General group of electric discharge lamps comprised of a discharge tube containing the high-pressure gas or vapor enclosed in a hermetically sealed outer envelope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-intensity discharge lamps"@en .

aat:300181483 a skos:Concept ;
    skos:definition "Case or covers, usually rigid, that enclose and protect mechanisms or apparatus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housings"@en .

aat:300181496 a skos:Concept ;
    skos:definition "Attachments to a lamp post or pole from which a lamp or lighting fixture is suspended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brackets"@en .

aat:300181504 a skos:Concept ;
    skos:definition "Sodium lamps in which light is produced by radiation from sodium vapor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-pressure sodium lamps"@en .

aat:300181510 a skos:Concept ;
    skos:definition "Mercury lamps which come in two types: those that use just mercury, and those that use a mixture of mercury and metal halides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-pressure mercury lamps"@en .

aat:300181530 a skos:Concept ;
    skos:definition "Lamps in which light is produced by an electric arc between two electrodes in an ionized mercury-vapor atmosphere; they give off a bluish-green light rich in ultraviolet radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercury lamps"@en .

aat:300181537 a skos:Concept ;
    skos:definition "High-intensity discharge lamps in which the major portion of the light is produced by radiation of metal halides and their products of dissociation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal halide lamps"@en .

aat:300181549 a skos:Concept ;
    skos:definition "Small lights on a vehicle used to indicate its presence when parked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parking lights"@en .

aat:300181555 a skos:Concept ;
    skos:definition "Lighting device components used to redirect the light from a source, primarily by the process of refraction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refractors"@en .

aat:300181557 a skos:Concept ;
    skos:definition "High-intensity discharge lamps, highly efficient in terms of lumens produced per watt of current consumed, with one-color light (orange) making them unsuitable for general use; often used for street and highway lighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium lamps"@en .

aat:300181563 a skos:Concept ;
    skos:definition "Electrical lamps that can be made to flash on and off rapidly and automatically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stroboscopic lamps"@en .

aat:300181579 a skos:Concept ;
    skos:definition "Gas-filled tungsten incandescent lamps containing a certain proportion of halogens in an inert gas whose pressure exceeds three atmospheres."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tungsten-halogen lamps"@en .

aat:300181587 a skos:Concept ;
    skos:definition "Pointed implements used to adjust the wicks of simple lamps; may be in the form of a short length of wire attached to the lamp or a separate wire mounted in a handle of wood or ivory fitted into a matching stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wick picks"@en .

aat:300181593 a skos:Concept ;
    skos:definition "Implements used to cut and shape the ends of wicks, particularly the ribbon wicks of kerosene lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wick trimmers"@en .

aat:300181600 a skos:Concept ;
    skos:definition "Visual aids to navigation displaying flashes of white or colored light or both, used to indicate the location of airports, landmarks, and certain points of the federal airways in mountainous terrain and to mark hazards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical beacons"@en .

aat:300181608 a skos:Concept ;
    skos:definition "Incandescent lamps, made in R and PAR shapes, which contain a reflective coating on the inside of the glass envelope, giving the entire lamps accurate light beam control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflector lamps"@en .

aat:300181613 a skos:Concept ;
    skos:definition "Lights indicating the presence and overall length of a vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sidelights"@en .

aat:300181617 a skos:Concept ;
    skos:definition "Aeronautical beacons used to indicate the location of an airport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airport beacons"@en .

aat:300181636 a skos:Concept ;
    skos:definition "Any light specially provided as an aid to air navigation, other than a light displayed on an aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical ground lights"@en .

aat:300181651 a skos:Concept ;
    skos:definition "Revolving aeronautical beacons of high intensity used to indicate the course of a runway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airway beacons"@en .

aat:300181654 a skos:Concept ;
    skos:definition "Aeronautical ground lights indicating a desirable line of approach to a landing area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "approach lights"@en .

aat:300181660 a skos:Concept ;
    skos:definition "Aircraft aeronautical lights forming the basic or internationally recognized navigational light system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "position lights"@en .

aat:300181670 a skos:Concept ;
    skos:definition "Aircraft aeronautical lights designed to illuminate a ground area from the aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landing lights"@en .

aat:300181676 a skos:Concept ;
    skos:definition "Aeronautical ground lights along the sides of a channel of a water airport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "channel lights"@en .

aat:300181680 a skos:Concept ;
    skos:definition "Aeronautical beacons used to indicate the location of natural or man-made landmarks used by pilots as an aid to navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landmark beacons"@en .

aat:300181683 a skos:Concept ;
    skos:definition "Aeronautical ground lights indicating the presence of an obstruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obstruction lights"@en .

aat:300181694 a skos:Concept ;
    skos:definition "Aeronautical ground lights arranged along a runway indicating its direction or boundaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runway lights"@en .

aat:300181709 a skos:Concept ;
    skos:definition "Aeronautical devices used to indicate visually the direction designated for landing and take-off."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landing direction indicators"@en .

aat:300181713 a skos:Concept ;
    skos:definition "Two or more lights in the same horizontal direction used as an aid to nautical or aeronautical navigation, such as those lights indicating a channel or marking the end of a runway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "range lights"@en .

aat:300181718 a skos:Concept ;
    skos:definition "Beacons marking an obstruction or hazard as an aid to navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obstruction beacons"@en .

aat:300181728 a skos:Concept ;
    skos:definition "Aeronautical ground lights delimiting the boundary of landing areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boundary lights"@en .

aat:300181731 a skos:Concept ;
    skos:definition "Runway lights placed to indicate the longitudinal limits of that portion of a runway, channel, or landing path usable for landing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "threshold lights"@en .

aat:300181758 a skos:Concept ;
    skos:definition "Lights shown at night by a vessel at anchor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor lights"@en .

aat:300181770 a skos:Concept ;
    skos:definition "Lighting devices which produce a uniform, diffuse illumination approaching a shadowless condition; may be supplemented by other lighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base lights"@en .

aat:300181777 a skos:Concept ;
    skos:definition "Aeronautical ground lights supplementing an airway beacon, used to indicate the direction of the airway and to identify by coded signal the location of the airway beacon with which it is associated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "course lights"@en .

aat:300181780 a skos:Concept ;
    skos:definition "Devices to redirect or scatter light from a source, primarily by the process of diffuse transmission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffusers"@en .

aat:300181782 a skos:Concept ;
    skos:definition "Devices used for reducing the brilliance of a light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimmers"@en .

aat:300181786 a skos:Concept ;
    skos:definition "Scissorlike devices, usually with flat disc-shaped ends, used for pinching out a flame. For scissorlike devices with a boxlike receptacle attached to one blade, use \"candle snuffers.\" For cone-shaped devices used to extinguish flames, use \"extinguishers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "douters"@en .

aat:300181798 a skos:Concept ;
    skos:definition "Colored lights on vehicles intended to diminish the effect of fog, dust, or smoke in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fog lights"@en .

aat:300181804 a skos:Concept ;
    skos:definition "Headlights in which the reflector and lens are hermetically sealed together with the filament in a single unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealed beam headlights"@en .

aat:300181811 a skos:Concept ;
    skos:definition "Lights, usually red, mounted at the rear of a vehicle to serve as a warning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taillights"@en .

aat:300181815 a skos:Concept ;
    skos:definition "Taillights that are illuminated as the driver of a vehicle steps on the brake pedal to slow down or stop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoplights"@en .

aat:300181888 a skos:Concept ;
    skos:definition "Cylinders into which the base of the candle can be inserted to keep it upright, either short to hold only the end of the candle or elongated, in the form of a tube, to hold the major part of a candle, with a lifting device to elevate the candle as it burns. Found on candleholders such as chambersticks and candlesticks, and on sconces and chandeliers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle sockets"@en .

aat:300181908 a skos:Concept ;
    skos:definition "Cased glass of two or more layers in contrasting colors. The outer layers are carved, cut, or engraved to produce a design which stands out from the background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cameo glass"@en .

aat:300181912 a skos:Concept ;
    skos:definition "Collages in which photographs dominate the composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photocollages"@en .

aat:300181918 a skos:Concept ;
    skos:definition "Creative works in the medium of acrylic paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic paintings"@en .

aat:300181922 a skos:Concept ;
    skos:definition "Creative works in the medium of encaustic paint, which is paint created by mixing dry pigments with molten, refined wax and resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encaustic paintings"@en .

aat:300181925 a skos:Concept ;
    skos:definition "Small paintings that depict peasant genre and street scenes, such as Roman street life, rustic taverns, travelers, street vendors, brigands, charlatans, and carnivals. Originally created in the 17th century by Northern artists living in Italy, who were known as the Bambocciati, after Pieter van Laer, who was nicknamed ‘Bamboccio.’"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bambocciate"@en .

aat:300181932 a skos:Concept ;
    skos:definition "Lamps having the wick enclosed in a tube, with a surrounding plate or disc that supports it in a vertical position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical wick lamps"@en .

aat:300181992 a skos:Concept ;
    skos:definition "Ornate kerosene table lamps with a high stem dating to the late 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquet lamps"@en .

aat:300181995 a skos:Concept ;
    skos:definition "Burner components consisting of discs, cones, or domes, usually of metal, that direct a current of air onto the flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deflectors"@en .

aat:300181997 a skos:Concept ;
    skos:definition "Disc-shaped wheels on lighting device burners at the outer end of a shaft by means of which the shaft and its wick wheel or wheels can be turned manually; in some burners a simple loop of the shaft replaces the wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumb wheels"@en .

aat:300182005 a skos:Concept ;
    skos:definition "Lamps or candleholders that are attached to, or suspended from, some form of bracket by which they can be hung on a wall or that is affixed to the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brackets"@en .

aat:300182272 a skos:Concept ;
    skos:definition "Sodium lamps in which light is produced by radiation from sodium vapor operating at a partial pressure of 01 to 1.5 Pa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-pressure sodium lamps"@en .

aat:300182284 a skos:Concept ;
    skos:definition "Ultraviolet lamps that radiate a significant portion of their radiative power in the UV-A and UV-B bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunlamps"@en .

aat:300182288 a skos:Concept ;
    skos:definition "High-intensity discharge lamps in which the partial pressure of the mercury vapor during operation does not exceed 100 Pa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low-pressure mercury lamps"@en .

aat:300182292 a skos:Concept ;
    skos:definition "High-powered incandescent lamps that yield a large amount of infrared radiation, used for heating purposes. These provide heat quickly, cheaply and efficiently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared lamps"@en .

aat:300182296 a skos:Concept ;
    skos:definition "Lamps that employ mechanics or machinery in their design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical lamps"@en .

aat:300182300 a skos:Concept ;
    skos:definition "Lamps having a holder or support for the wick, frequently a half tube, attached to the bottom of the reservoir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wick support lamps"@en .

aat:300182304 a skos:Concept ;
    skos:definition "Burners used for controlled burning of acetylene gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetylene burners"@en .

aat:300182319 a skos:Concept ;
    skos:definition "Chandeliers having a height-adjustable central burner which can be lowered to increase illumination when necessary, as at dinner or for reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "center-slide chandeliers"@en .

aat:300182329 a skos:Concept ;
    skos:definition "Devices used to control the flow of gas to a burner or lamp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocks"@en .

aat:300182337 a skos:Concept ;
    skos:definition "Burners for the combustion of gas, usually with various arrangements of holes through which gas issues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas burners"@en .

aat:300182341 a skos:Concept ;
    skos:definition "Gas burners where a circular row of small gas jets are emitted from a burner tip, and may be coalesced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockscomb burners"@en .

aat:300182345 a skos:Concept ;
    skos:definition "Gas burners that have three apertures and emit three jets of flame from a burner tip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockspur burners"@en .

aat:300182351 a skos:Concept ;
    skos:definition "Gas burners having a domical top pierced by a narrow slit across it, producing a fanlike sheet of flame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batswing burners"@en .

aat:300182361 a skos:Concept ;
    skos:definition "Lighting fixture allowing more than one method of illumination, typically gas and electric fixtures, gas and oil fixtures, or gas and candle fixtures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination fixtures"@en .

aat:300182372 a skos:Concept ;
    skos:definition "Gas burners in which two jets of gas issuing from two holes inclined toward each other meet to form a fan-shaped flame when ignited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishtail burners"@en .

aat:300182383 a skos:Concept ;
    skos:definition "Gas burners masked by ceramic or opaque glass sleeves to resemble candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas candles"@en .

aat:300182390 a skos:Concept ;
    skos:definition "Burners designed to assure an even flow of gas to the individual jet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governor burners"@en .

aat:300182397 a skos:Concept ;
    skos:definition "Gas burners having a single round hole, producing a long, slender flame. Used primarily in modified form as burners for gas candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rat-tail burners"@en .

aat:300182403 a skos:Concept ;
    skos:definition "Gas light chandeliers supported by one or more hollow rods, through which gas may be fed to the burners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rod-hung chandeliers"@en .

aat:300182413 a skos:Concept ;
    skos:definition "Fixtures (usually chandeliers) having devices allowing adjustment of height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slide fixtures"@en .

aat:300182417 a skos:Concept ;
    skos:definition "Hanging light fixtures, especially those designed to hang from the ceiling. Usually refers to such fixtures having only one to four lights; for suspended ceiling fixtures having a larger number of lights, use \"chandeliers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendants"@en .

aat:300182420 a skos:Concept ;
    skos:definition "In general terms, refers to the movement among architects and engineers, principally Daniel Burnham, William Le Baron Jenney, John Root, and the firm of Dankmar Adler and Louis Sullivan,during the late 19th century that ultimately led to the development of the skyscraper and a distinct modern style of architectural design featuring steel and iron skeletons clad with masonry, simple exterior decoration often in red brick or terracotta, the rejection of historical forms, and the use of blocky geometric volumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chicago School"@en .

aat:300182425 a skos:Concept ;
    skos:definition "Pendant lighting fixtures having a T-form rod suspended from the ceiling connected to two or more gas burners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas Ts"@en .

aat:300182540 a skos:Concept ;
    skos:definition "Lamps, often light bulbs set in a cylinder or other container, placed on the floor so that a beam of light is directed upwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uplights"@en .

aat:300182550 a skos:Concept ;
    skos:definition "Lamps designed to be used on a desk, usually having some means of adjusting the light source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desk lamps"@en .

aat:300182574 a skos:Concept ;
    skos:definition "The art or practice of producing creative works with acrylic paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic painting"@en .

aat:300182578 a skos:Concept ;
    skos:definition "Technique involving the working of the surface of certain areas of a painting or polychromed carved figure to imitate the color and shading of human flesh; usually referring to Caucasian flesh color. The term was first coined in reference to Spanish art, but may be applied to any western art; particularly in use prior to the early 1900s. In some cases, certain artists specialized in encarnacione, while other artists would paint drapery, landscape, and other areas of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encarnacione"@en .

aat:300182580 a skos:Concept ;
    skos:definition "Technique used in Spanish painting which involves working a painted surface to create a pattern; used to embellish the robes of carved and painted figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estofado"@en .

aat:300182603 a skos:Concept ;
    skos:definition "Kerosene burners with a spring-loaded lever to secure the chimney within the rim of the base plate and hold the loose dome-shaped deflector; of a type patented by Edward F. Jones in 1858."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jones burners"@en .

aat:300182716 a skos:Concept ;
    skos:definition "Distinctly vertical dwellings, built for defensive purposes, usually of stone and with at least three to four stories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower houses"@en .

aat:300182722 a skos:Concept ;
    skos:definition "Demarcated areas of the earth that are homogeneous in terms of natural, historic, economic, political, or cultural characteristics that distinguish them from other areas. Prefer the more specific terms found under \"administrative bodies,\" such as \"counties\" or \"nations,\" or under \"districts\" or \"landscapes (environments).\" For specifically the political divisions of the nation of Italy, use \"regions (administrative divisions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regions"@en .

aat:300182723 a skos:Concept ;
    skos:definition "Land masses of great size but smaller than those generally called continents; also large subdivisions of continents having a certain geographical independence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subcontinents"@en .

aat:300182732 a skos:Concept ;
    skos:definition "Refers to decorations in any medium that dominate a wall (or ceiling) surface; most often refers to works executed on the wall, but may also refer to works done separately and affixed to the wall. For paintings specifically, see \"mural paintings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "murals"@en .

aat:300182739 a skos:Concept ;
    skos:definition "A manner of composing pictorial narratives. The expression usually refers to Renaissance and Baroque paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "istoria"@en .

aat:300182745 a skos:Concept ;
    skos:definition "Refers to images composed by several persons where each participant is not allowed to see the previous contributions. This technique was popular among the Surrealists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadavres exquis"@en .

aat:300182748 a skos:Concept ;
    skos:definition "The application of a broad, thin film of highly diluted pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wash technique"@en .

aat:300182753 a skos:Concept ;
    skos:definition "Technique which involves the application of flat color over an area too large to be covered by a single brush stroke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat wash"@en .

aat:300182755 a skos:Concept ;
    skos:definition "Lateral parts or appendages of a work of art, such as those found on a triptych."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wings"@en .

aat:300182806 a skos:Concept ;
    skos:definition "Aeronautical lights specially provided on an aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft aeronautical lights"@en .

aat:300182830 a skos:Concept ;
    skos:definition "A hard fat obtained from animals, especially sheep, goats, and cattle, containing the fatty acids oleic acid, palmitic acid, stearic acid, linoleic acid, and myristic acid. Tallow is used in leather dressing and in the manufacture of soaps, lubricants, candles, and food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tallow"@en .

aat:300182834 a skos:Concept ;
    skos:definition "Periods related to modern North American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern North American periods"@en .

aat:300182848 a skos:Concept ;
    skos:definition "Style and culture of the Kauma people of East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kauma"@en .

aat:300182873 a skos:Concept ;
    skos:definition "Traditional Jewish marriage contracts, traditionally written in Aramaic and signed by witnesses, setting out reciprocal duties of husband and wife, including the husband's obligation to pay the wife a certain sum in the event of divorce, and the wife's property rights upon his death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ketubahs"@en .

aat:300182880 a skos:Concept ;
    skos:definition "Design competitions in which entry is available to all in a profession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open competitions"@en .

aat:300182885 a skos:Concept ;
    skos:definition "Design competitions available for students, sponsored usually by a school, foundation, or sector of the business community, for which prizes are awarded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "student competitions"@en .

aat:300182894 a skos:Concept ;
    skos:definition "Lightweight and economical cladding system for buildings composed of insulation and wet applied finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exterior insulation and finish system"@en .

aat:300182910 a skos:Concept ;
    skos:definition "Ecological or environmental areas that are inhabited by particular species of animals or plants and contain the materials and conditions necessary for their survival. For the aggregates of influences affecting organisms, use \"environments (object groupings).\" For areas set apart as protected for plants or animals, use \"wildlife refuges.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "habitat"@en .

aat:300182913 a skos:Concept ;
    skos:definition "Lamps in which a volatile liquid, such as alcohol, is burned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit lamps"@en .

aat:300182914 a skos:Concept ;
    skos:definition "Lamps that use as fuel pine oil, which is an essential oil that is obtained by steam distillation of pine wood. They may be made in a wide variety of shapes and sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pine oil lamps"@en .

aat:300182915 a skos:Concept ;
    skos:definition "Lamps that burn olive oil, which is oil extracted from the fruit of the olive tree. They are often characterized by being relatively small, portable, and on the top surface having an opening for adding the oil and a smaller opening from which a wick extends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive oil lamps"@en .

aat:300182917 a skos:Concept ;
    skos:definition "Lighting devices that employ calcium oxide (quicklime) heated to incandescence as the source of illumination; used especially in lighthouses and theater lighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limelights"@en .

aat:300182919 a skos:Concept ;
    skos:definition "Lamps employing incandescence as the method of illumination; may use electricity, gas, kerosene, or other means to produce the incandescence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incandescent lamps"@en .

aat:300182920 a skos:Concept ;
    skos:definition "Lamps designed to vaporize and burn gasoline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasoline lamps"@en .

aat:300182921 a skos:Concept ;
    skos:definition "Lighting devices comprised of a housing, ballast, and connection to electrical power that mount tubular electric discharge lamps, or 'bulbs,' in which ionization of mercury vapor produces radiation that activates the fluorescent coating on the inner surface of the glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescent lamps"@en .

aat:300182922 a skos:Concept ;
    skos:definition "Lamps in which electricty is the source of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric lamps"@en .

aat:300182923 a skos:Concept ;
    skos:definition "Electric lamps in which the current is made to traverse an air gap between two electrodes, usually of carbon. The air in the gap as well as the two electrodes become heated to a brilliant incandescence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arc lamps"@en .

aat:300182924 a skos:Concept ;
    skos:definition "Design competitions in which entry is restricted to a small number of participants specifically invited to offer solutions; usually for complex projects or projects for which particular technical expertise is required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invited competitions"@en .

aat:300182931 a skos:Concept ;
    skos:definition "Lamps which burn colza oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colza oil lamps"@en .

aat:300182933 a skos:Concept ;
    skos:definition "Lighting fixtures that use electricity to provide illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric fixtures"@en .

aat:300182934 a skos:Concept ;
    skos:definition "Lighting fixtures that may be converted from incandescent to florescent bulbs, or that may be converted in another way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convertible fixtures"@en .

aat:300182935 a skos:Concept ;
    skos:definition "Collectively, the physical elements that constitute an exhibition, including the exhibit design, graphics, lighting, labels, audiovisual components, and exhibit cases, as well as the objects on display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "installations"@en .

aat:300182939 a skos:Concept ;
    skos:definition "Sudden calamitous events producing great material damage, loss, or distress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disasters"@en .

aat:300182940 a skos:Concept ;
    skos:definition "Burners designed to hold a flat ribbon-shaped wick. Commonly used for burning kerosene but also found on some oil and lard lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat wick burners"@en .

aat:300182941 a skos:Concept ;
    skos:definition "Lamps, often set in rotating Fresnel lenses, in lighthouses. Early lighthouse lamps were powered by incandescent gas burners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighthouse lamps"@en .

aat:300182946 a skos:Concept ;
    skos:definition "Lamps in which a wire gauze is used to screen the flame to prevent explosions; usually cylindrical and often made of brass. Based on a lamp developed by Sir Humphrey Davy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miners' safety lamps"@en .

aat:300182947 a skos:Concept ;
    skos:definition "Betty lamps with integral stands; the form is believed to have originated in the Portsmouth, New Hampshire, area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portsmouth betties"@en .

aat:300182949 a skos:Concept ;
    skos:definition "Catastrophes caused by naturally occurring phenomena such a flood, hurricanes, or earthquakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural disasters"@en .

aat:300182953 a skos:Concept ;
    skos:definition "Catastrophes caused by man-made events such as war, explosions, terrorism, or airplane crashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "man-made disasters"@en .

aat:300182956 a skos:Concept ;
    skos:definition "Candles lit in recognition of a vow, prayer, or desire. Examples are those found in churches, often housed in glass containers. Any candles housed in glass containers that resemble the votive candles originally found primarily in churches and other religious contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "votive candles"@en .

aat:300183013 a skos:Concept ;
    skos:definition "Hanging lamps that have a mechanism such as a chain and pulley by which they may be raised or lowered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extension lamps"@en .

aat:300183018 a skos:Concept ;
    skos:definition "Lighting devices attached along a narrow wall- or ceiling-mounted track through which current is conducted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "track lights"@en .

aat:300183024 a skos:Concept ;
    skos:definition "Lamps used to inspect ovens, commonly either of tin with a long oval font and tubular handle at one end and a whale oil burner at the other, or a cast iron cup-shaped font with a wick channel, attached saucer base and usually a hinged lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bakers' lamps"@en .

aat:300183048 a skos:Concept ;
    skos:definition "Brackets that can be moved horizontally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swing brackets"@en .

aat:300183051 a skos:Concept ;
    skos:definition "Candle brackets having a base with a spike or peg positioned vertically so that the candle is held in place by pushing the spike into the bottom of the candle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stifted brackets"@en .

aat:300183056 a skos:Concept ;
    skos:definition "Transformers capable of stepping down the voltage of a current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step-down transformers"@en .

aat:300183059 a skos:Concept ;
    skos:definition "Transformers capable of increasing the voltage of a current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step-up transformers"@en .

aat:300183060 a skos:Concept ;
    skos:definition "Early cannons in use from the 14th to the 16th century, typically of large bore, made of wrought iron or cast bronze and firing stone cannonballs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombards"@en .

aat:300183063 a skos:Concept ;
    skos:definition "Lanterns used for signaling, usually employing a system of color-coded globes or semaphore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signal lanterns"@en .

aat:300183069 a skos:Concept ;
    skos:definition "Design competitions offering a compromise between open and invited competitions; entry is available only to a portion of a profession, for example only to those within a limited geographic area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limited competitions"@en .

aat:300183070 a skos:Concept ;
    skos:definition "Automatic switches forming part of the auxiliary circuit of some fluorescent lamps, which enables heat to travel to electrodes for a discharge to occur after a period of inactivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starters"@en .

aat:300183072 a skos:Concept ;
    skos:definition "Hollow cavities, parts, or pieces, usually long and narrow and of cylindrical or shaft form, constructed to receive an element and hold it in place; examples include sockets for candles or light bulbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light sockets"@en .

aat:300183077 a skos:Concept ;
    skos:definition "19th-century associations for promoting the arts, especially through the distribution of paintings and prints by lottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art unions"@en .

aat:300183080 a skos:Concept ;
    skos:definition "Glass or crystal pendant drops of triangular section used especially to ornament chandeliers or candelabras. For similar drops, smooth or faceted, and made in various forms, use \"lusters (lighting device components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prisms"@en .

aat:300183086 a skos:Concept ;
    skos:definition "Flexible cords from lamps, usually coated with rubber. They generally run through the base of a lamp, and connect at the socket where the bulb is screwed in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamp cords"@en .

aat:300183089 a skos:Concept ;
    skos:definition "Harp-shaped supports for hanging lamps or shades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harps"@en .

aat:300183093 a skos:Concept ;
    skos:definition "Light sockets designed so that a cylindrical termination of a bulb may be attached by rotating the bulb along helical or spiral threading lining the interior of the socket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw-in sockets"@en .

aat:300183096 a skos:Concept ;
    skos:definition "Light sockets having one or more parallel slits or L-shaped slots, a longer side parallel and the shorter side perpendicular to the axis of the socket, along which a projection from the bulb slides in such a way that when fully inserted, locks into place so the two parts cannot be separated by a simple longitudinal movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bayonet sockets"@en .

aat:300183105 a skos:Concept ;
    skos:definition "Holders for the slender wax candles known as tapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapersticks"@en .

aat:300183108 a skos:Concept ;
    skos:definition "Small candlesticks used for holding tapers to light candles, specifically for use on tea tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea candlesticks"@en .

aat:300183111 a skos:Concept ;
    skos:definition "Slide fixtures, usually for chandeliers, that adjust by sliding the rod in and out in overlapping cylindrical sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telescoping fixtures"@en .

aat:300183114 a skos:Concept ;
    skos:definition "Extension gas fixtures, usually for chandeliers, that use water to seal the joints. Various improvements to the fixtures were invented throughout the mid- to late 19th century, attempting to solve the problem of evaporation of the water, which caused gas leaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-slide fixtures"@en .

aat:300183119 a skos:Concept ;
    skos:definition "Candlesticks having one or more spherical or near-spherical shapes incorporated in the design of the stem of the candlestick or forming the body of the candlestick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball candlesticks"@en .

aat:300183120 a skos:Concept ;
    skos:definition "Candlesticks with an internal screw ejection mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw candlesticks"@en .

aat:300183122 a skos:Concept ;
    skos:definition "Candleholders with stems that slide in and out in overlapping cylindrical sections for height adjustment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telescopic candlesticks"@en .

aat:300183124 a skos:Concept ;
    skos:definition "Light sources of various design, intended to throw bright, even illumination for conducting work in a workshop or similar environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoplights"@en .

aat:300183125 a skos:Concept ;
    skos:definition "Lighting designed to provide illumination for workers inside factories; also includes exterior lighting of factories, particularly in the context of discussions surrounding environmental impact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory lights"@en .

aat:300183126 a skos:Concept ;
    skos:definition "Glass vessels of vase shape with a wide flaring neck, bulbous body having a flat base or trumpet-like stem hung for use in a mosque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosque lamps"@en .

aat:300183132 a skos:Concept ;
    skos:definition "Lighting devices designed for use over a billiard table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billiard lights"@en .

aat:300183142 a skos:Concept ;
    skos:definition "Lighting for gardens; modern garden lights are often solar powered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden lights"@en .

aat:300183149 a skos:Concept ;
    skos:definition "Small candleholders that are secured to a Christmas tree or other object by an attached clip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clip candleholders"@en .

aat:300183152 a skos:Concept ;
    skos:definition "Small, glass, cup-shaped containers that hold oil and a float wick or candles, used especially for outdoor decoration and illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucket lamps"@en .

aat:300183158 a skos:Concept ;
    skos:definition "Lamps formed from drinking glasses by the addition of pierced, domed covers and carrying handles and the insertion of a lamp or candleholder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumbler lamps"@en .

aat:300183163 a skos:Concept ;
    skos:definition "Floor lamps in which multiple lamp fixtures radiate from various positions on the pole. May also refer to lamp fixtures having a more realistic form of a tree, or to lamps hung from actual trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamp trees"@en .

aat:300183168 a skos:Concept ;
    skos:definition "Lamps produced by Tiffany Studios beginning in 1895 having shades made of various types of stained glass, sometimes set in intricate leaded patterns. Other lamps have shades resembling flowers made of iridescent glass. Lamps produced by Tiffany Studios beginning in 1895 having shades made of various types of stained glass, sometimes set in intricate leaded patterns. Other lamps have shades resembling flowers made of iridescent glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tiffany lamps"@en .

aat:300183171 a skos:Concept ;
    skos:definition "Argand lamps without a separate reservoir and with burners that have low dome deflectors with circular openings. The font, if not the entire lamp, is made of metal, commonly brass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar lamps"@en .

aat:300183174 a skos:Concept ;
    skos:definition "Lamps which are fixed to a spring-loaded, adjustable pole which fits between a ceiling and floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole lamps"@en .

aat:300183179 a skos:Concept ;
    skos:definition "Flashlights that resemble fountain pens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penlights"@en .

aat:300183182 a skos:Concept ;
    skos:definition "Terracotta oil lamps having a spout for the wick, an enclosed area for the oil, and often a handle. The term refers literally to ancient Greek lamps of this design, but may be applied to such lamps from any period or region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grecian lamps"@en .

aat:300183185 a skos:Concept ;
    skos:definition "A product line of lamps with bubble shapes, originally designed by George Nelson in 1947, and manufactured by Howard Miller from the early 1950s until 1979."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bubble lamps"@en .

aat:300183188 a skos:Concept ;
    skos:definition "Rod-hung chandeliers, often having glass lamp shades over the lighting elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lampoliers"@en .

aat:300183190 a skos:Concept ;
    skos:definition "Chandeliers in which the lights are electric; the term is used especially for such fixtures dating to the early usage of electricity in homes, when distinguishing such chandeliers from earlier gas and candle chandeliers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroliers"@en .

aat:300183192 a skos:Concept ;
    skos:definition "Lamps, usually portable, used to illuminate a workspace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work lights"@en .

aat:300183206 a skos:Concept ;
    skos:definition "Lamps used in an operating room for precision work. They are usually ceiling mounted and on mobile fixtures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operating lights"@en .

aat:300183215 a skos:Concept ;
    skos:definition "Lamps for use in galleries, usually set at 60-100 footcandles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallery lights"@en .

aat:300183220 a skos:Concept ;
    skos:definition "Lamps, usually mounted on the ceiling or on a dental chair, and for the purpose of illuminating the oral cavity for precision work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental lights"@en .

aat:300183223 a skos:Concept ;
    skos:definition "Lamps for use by architects to illuminate a work area, and which usually use a combination of incandescent and fluorescent bulbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architects' lamps"@en .

aat:300183230 a skos:Concept ;
    skos:definition "Plastic or glass elements used to change the direction of light by bending or refracting the rays in a specified pattern over an area, achieved by covering the surface of the lens with prisms that are arranged in a pattern designed to achieve the desired effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prismatic lenses"@en .

aat:300183233 a skos:Concept ;
    skos:definition "Plano-convex lenses thinned by reducing the convex side to a series of concentric rings of approximately the same focal length; when light passes through, it produces a smooth, soft-edged beam of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fresnel lenses"@en .

aat:300183240 a skos:Concept ;
    skos:definition "Argand lamps fitted with a rod terminated by a plate which is positioned so that the air passing through the tube surrounded by the wick is deflected against the flame causing it to spread and become globular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liverpool lamps"@en .

aat:300183243 a skos:Concept ;
    skos:definition "Lamps with standards that slide in and out in overlapping cylindrical sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telescoping lamps"@en .

aat:300183246 a skos:Concept ;
    skos:definition "Flexible lamps, usually mounted and equipped with brackets, which allow for movement of the lamp, and for adjustment of the direction of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swing-arm lamps"@en .

aat:300183249 a skos:Concept ;
    skos:definition "Electrical table or desk lamps with a flexible arm that permits the control of the focus of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gooseneck lamps"@en .

aat:300183252 a skos:Concept ;
    skos:definition "Desk or floor lamps employing a movable, projecting support or arm of great length to support the lighting element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantilever lamps"@en .

aat:300183264 a skos:Concept ;
    skos:definition "Astral lamps with burners that have solar deflectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar astral lamps"@en .

aat:300183274 a skos:Concept ;
    skos:definition "Enclosing devices of glass used to protect the light source within, diffuse or redirect its light, or modify its color; also such devices used to increase the draft to the flame in an open-flame lamp or candle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glasses"@en .

aat:300183276 a skos:Concept ;
    skos:definition "Specular louvers with reduced absorption of light and glare control. Preferable louvers for low ceilings or small spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parabolic louvers"@en .

aat:300183281 a skos:Concept ;
    skos:definition "Louvers which combine both horizontal and vertical shading, to control both high and low sun, and reflect daylight into the interior space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg-crate louvers"@en .

aat:300183317 a skos:Concept ;
    skos:definition "Glass or crystal pendant drops, smooth or faceted, and made in various forms, used especially to ornament chandeliers or candelabras. For similar drops of triangular section, use \"prisms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lusters"@en .

aat:300183392 a skos:Concept ;
    skos:definition "Architectural project management technique whereby construction is allowed to begin before the design and specifications are completed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fast-track method"@en .

aat:300183446 a skos:Concept ;
    skos:definition "Act or practice of manufacturing a variety of products, selling a variety of merchandise, or investing in a variety of securities, for example, so that failure in or economic slump affecting one of them will not be disastrous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diversification"@en .

aat:300183621 a skos:Concept ;
    skos:definition "Colorless-to-white crystalline potassium aluminum sulfate; has a wide range of uses, including in treatment of leather and textile, in sizing paper, as a mordant in dyeing, and as a water-purifying agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alum"@en .

aat:300183625 a skos:Concept ;
    skos:definition "Paper of silvery appearance coated with powdered aluminum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum paper"@en .

aat:300183627 a skos:Concept ;
    skos:definition "Any substance resulting from the combination of negative ions from acids and usually metal ions. For common table salt, or NaCl, use \"sodium chloride.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt"@en .

aat:300183629 a skos:Concept ;
    skos:definition "White crystalline powder used in electric batteries, in printing, as a soldering flux, and in making other compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium chloride"@en .

aat:300183632 a skos:Concept ;
    skos:definition "A hard, glossy coating of paint that is baked dry in an oven at 180 degrees. Baked enamel is usually used to coat metallic surfaces in industrial applications such as sign-making or the construction of household appliances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baked enamel"@en .

aat:300183634 a skos:Concept ;
    skos:definition "Fine, soft, sheer cloth of plain weave made of any of the principal types of fiber, such as cotton, linen, rayon, silk, or wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batiste"@en .

aat:300183635 a skos:Concept ;
    skos:definition "Pure linen that is a suitable choice for painters' canvas; Belgian linens are generally considered the finest of linen grades. Some types are especially woven or selected for artists' purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgian linen"@en .

aat:300183637 a skos:Concept ;
    skos:definition "Paint consisting of brass powders. Often used to create decorative surfaces, and in low-quality restorations of gilded objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze paint"@en .

aat:300183641 a skos:Concept ;
    skos:definition "Any metal, including copper alloy or aluminum, in fine flake form used as a pigment to give the appearance of a metallic surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze powder"@en .

aat:300183644 a skos:Concept ;
    skos:definition "Sharp, hard, artificial abrasive in solid or powdered form composed of silicon carbide. Available in several degrees of coarseness, it is often used for polishing by abrasion. The finest particles are useful for grinding glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carborundum (TM)"@en .

aat:300183647 a skos:Concept ;
    skos:definition "Wood pulp chipped and cooked with chemicals to dissolve out the lignin, used for the making of wallboard and newsprint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical pulp"@en .

aat:300183651 a skos:Concept ;
    skos:definition "Soft, thin, unsized, fine-textured, highly absorbent paper of bamboo fiber originating in China, usually of a pale yellow color. It is typically used for steel engraving, woodcut proofs, and as lithographic transfer paper, because it absorbs ink without smearing. Although it is also called \"Indian proof paper,\" it is distinct from \"India paper,\" which is softer and looser in its fiber bond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "China paper"@en .

aat:300183661 a skos:Concept ;
    skos:definition "Paper having a medium to rough finish created by running the sheets through a series of coated metal cylinders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold-pressed paper"@en .

aat:300183668 a skos:Concept ;
    skos:definition "Inexpensive colored paper suitable for crayon and ink drawings, watercolors, and for making paper cutouts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction paper"@en .

aat:300183670 a skos:Concept ;
    skos:definition "White-to-yellowish seed-hair fibers of several species of the genus Gossypium, native to most subtropical areas of the world; used especially for making textile, cord, padding, rag paper, and for cellulose used for plastic and rayon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotton"@en .

aat:300183678 a skos:Concept ;
    skos:definition "Cardboard consisting of a sheet of corrugated paper with an adherent flat board on one or both sides. It may be made of good quality paper or cheaper paper, which is intended for short term use or transport (e.g., used in box-making)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrugated board"@en .

aat:300183684 a skos:Concept ;
    skos:definition "Paper with a fibrous structure that will take and hold pastel, often coated with a dusting of pumice or sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastel paper"@en .

aat:300183686 a skos:Concept ;
    skos:definition "Cardboard made of either wood pulp or cotton fibers used as a backing or mat for prints and drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounting board"@en .

aat:300183688 a skos:Concept ;
    skos:definition "Board composed of purified cellulose pulp from wood where lignin has been removed and to which an alkaline buffer has been added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation board"@en .

aat:300183741 a skos:Concept ;
    skos:definition "Lightweight textile made of various types of fiber, having a crinkled surface obtained by using hard twisted thread or yarn, by printing with caustic soda, by weaving with varied tensions, or by embossing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crepe"@en .

aat:300183742 a skos:Concept ;
    skos:definition "Tempera made using the whole egg, with oils or resins added, having qualities of both egg tempera and oil paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg-oil tempera"@en .

aat:300183750 a skos:Concept ;
    skos:definition "Paint created by mixing dry pigments with molten wax, usually beeswax. Sometimes small amounts of natural resins, such as dammar or Venice turpentine, are added for hardness. Oils, such as linseed oil, are added for increased workability. Encaustic paint was used as early as the 4th and 5th centuries BCE in Greece. The paint was applied warm with a spatula or brush. It hardened quickly and fused to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encaustic paint"@en .

aat:300183758 a skos:Concept ;
    skos:definition "A solution of gum arabic and acid used in desensitizing lithographic plates and stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etch"@en .

aat:300183765 a skos:Concept ;
    skos:definition "An acid-resistant substance applied to a surface to stop out areas that are not to be etched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etching ground"@en .

aat:300183770 a skos:Concept ;
    skos:definition "A liquid silicate that hydrolyzes to form a colorless, transparent film of silica. Used, for example, as a source of colloidal silica in heat-resistant and acid-resistant coatings, as a protective coating for industrial buildings and castings, as a consolidant for stone, and as a bonding agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethyl silicate"@en .

aat:300183772 a skos:Concept ;
    skos:definition "Material used as an ingredient of mordants in the production of etchings rather than nitric acid due to its ability to produce more selectively vertical lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferric chloride"@en .

aat:300183795 a skos:Concept ;
    skos:definition "Handmade Japanese paper, made of 10% mitsumata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasenshi"@en .

aat:300183798 a skos:Concept ;
    skos:definition "Collectively used for decorative or additional material serving to finish, decorate, or complete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimming"@en .

aat:300183800 a skos:Concept ;
    skos:definition "Trimming consisting of small glittering objects or tiny glittering bits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glitter"@en .

aat:300183805 a skos:Concept ;
    skos:definition "Use with reference to projects sponsored by any of the United States government programs established under the New Deal administration and operating at various times between 1933 and 1943."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Deal"@en .

aat:300183808 a skos:Concept ;
    skos:definition "Thin transfer paper coated with graphite on one side; this type of transfer paper is often preferred by artists because its marks are erasable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphite paper"@en .

aat:300183810 a skos:Concept ;
    skos:definition "Etching ground which is applied to a warm printing plate and hardens upon drying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard ground"@en .

aat:300183813 a skos:Concept ;
    skos:definition "Thick, absorbent, handmade paper made primarily of kozo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosho"@en .

aat:300183815 a skos:Concept ;
    skos:definition "Paper having a smooth finish created by running the sheets through a series of heated metal cylinders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-pressed paper"@en .

aat:300183822 a skos:Concept ;
    skos:definition "Paint made specifically for branches of industry. Generally, industrial paint can be produced for architectural operations (building and construction, home repair), product coating operations (appliances, durable goods, the automobile industry), and special purpose operations (highway maintenance, military and industrial use)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial paint"@en .

aat:300183825 a skos:Concept ;
    skos:definition "Impure colorless to brown crystalline matter found in wood; from the secondary wall structural support in wood cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lignin"@en .

aat:300183826 a skos:Concept ;
    skos:definition "The short downy hairs or fuzz adhering to the cotton seeds (removed by a machine called a linter), which is unsuitable for spinning into yarn and is used as a source of celluloseu. Linter is useful in papermaking and upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linter"@en .

aat:300183830 a skos:Concept ;
    skos:definition "Lithographic solvent used as a substitute for turpentine because it is less irritating to the skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithotine"@en .

aat:300183831 a skos:Concept ;
    skos:definition "Inexpensive machine-made oriental paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masa"@en .

aat:300183833 a skos:Concept ;
    skos:definition "Wood that is ground into a pulp without any additional purification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical wood pulp"@en .

aat:300183841 a skos:Concept ;
    skos:definition "Paint in which the pigment is a metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallic paint"@en .

aat:300183843 a skos:Concept ;
    skos:definition "Paper so coated (as with lime, whiting, and size) that marks made on it with a metal point are indelible. Can also refer to either paper coated with finely flaked metal to give the appearance of a metallic surface or to paper to which a metallic foil has been laminated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallic paper"@en .

aat:300183845 a skos:Concept ;
    skos:definition "Delicate handmade paper made of kozo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moriki"@en .

aat:300183846 a skos:Concept ;
    skos:definition "Opaque white handmade paper made of kozo fiber. It is particularly suitable for woodcuts because it allows the production of bold, rich prints without heavy pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mulberry paper"@en .

aat:300183853 a skos:Concept ;
    skos:definition "Essential oil used for its effects on spirit varnish and for its ability to retard the drying of paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil of cedar"@en .

aat:300183857 a skos:Concept ;
    skos:definition "A yellow colored essential oil expressed from the rind of the lemon fruit. Lemon oil is used in flavoring, soaps, perfumes, cleaning, furniture polishes, and to secure gold leaf temporarily to the covering material of a book before blocking or tooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon oil"@en .

aat:300183861 a skos:Concept ;
    skos:definition "General term for any of several viscous hydrocarbon oils, including the oil pressed from paraffin wax. Paraffin oil is sold in several grades and ranges in color from brown to yellowish brown with a pronounced bluish bloom. Debloomed paraffin oil is pale gold in color and is used as higher-grade polishes and as household lubricating oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paraffin oil"@en .

aat:300183863 a skos:Concept ;
    skos:definition "Gelatin that is chemically purer and physically more refined than food-quality gelatin and is used as the binding medium in some photographic emulsions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic gelatin"@en .

aat:300183868 a skos:Concept ;
    skos:definition "Material in a plastic state used to seal narrow openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic cement"@en .

aat:300183871 a skos:Concept ;
    skos:definition "A thicker and slightly stiffer form of railroad board; six-ply and eight-ply are the common thicknesses. Poster board is typically covered on only one side with either white or colored paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poster board"@en .

aat:300183873 a skos:Concept ;
    skos:definition "A potassium carbonate in the form of a white alkaline granular powder. It is used in glass manufacture, soft soap, and wool washing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potash"@en .

aat:300183876 a skos:Concept ;
    skos:definition "Fine powders of various materials used to treat or protect the surface of a drawing or of parchment, or to transfer a design through a pricked drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounce"@en .

aat:300183883 a skos:Concept ;
    skos:definition "Cloth, usually cotton, that has been coated with compounded rubber and passed between rollers under pressure; the resulting cloth is waterproof and flexible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubberized cloth"@en .

aat:300183888 a skos:Concept ;
    skos:definition "A crystalline compound, NaCl, found as colorless, cubic crystals that naturally occur in ocean water at concentrations of 2.6% and in the mineral halite. Sodium chloride is widely used for flavoring and preservation of food, for curing hides and skins, in electrochemical reactions and mordanting, in the precipitation of photographic emulsions, and for many other purposes. For any substance resulting from the combination of negative ions from acids and usually metal ions, use \"salt (inorganic material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium chloride"@en .

aat:300183896 a skos:Concept ;
    skos:definition "Small ornament of shiny metal or plastic in any shape, but usually round, and having a hole in the middle for use in fastening to clothing to create decorative effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sequins"@en .

aat:300183897 a skos:Concept ;
    skos:definition "An anhydrous grayish-white, odorless, water-soluble powder, NA2CO3, usually obtained by the Solvay process and containing about 1 percent of impurities consisting of sulfates, chlorides, and bicarbonates. It is used in the manufacture of glass, ceramics, soaps, paper, petroleum products, as a cleanser, for bleaching, and in water treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium carbonate"@en .

aat:300183909 a skos:Concept ;
    skos:definition "Etching ground containing grease so that it does not harden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft ground"@en .

aat:300183911 a skos:Concept ;
    skos:definition "Strong, thick paper treated with wax or oil and used to make stencils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencil paper"@en .

aat:300183914 a skos:Concept ;
    skos:definition "Vegetable oil obtained from a tree cultivated in China valued for its drying properties and is probably the traditional material used by Chinese artist to grind vermillion. It was formerly used as an adulterant in Chinese tung oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stillingia oil"@en .

aat:300183918 a skos:Concept ;
    skos:definition "Varnish used for stopping out areas of a printing plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stopping-out varnish"@en .

aat:300183923 a skos:Concept ;
    skos:definition "Prepared paper pulp ready for use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuff"@en .

aat:300183925 a skos:Concept ;
    skos:definition "Oil to which an equal amount of water has been added, perhaps salt water, shaken, and exposed to the sun in a glass jar or tray for a few weeks. The vessels are typically loosely covered to exclude dirt, but permit air. The oil and water must be recombined every day for the first week. Length of exposure time to the sun varies according to the season and to the intended consistency and color desired. At the end of the treatment, the oil is separated from the water by means of a funnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun-refined oil"@en .

aat:300183931 a skos:Concept ;
    skos:definition "A sweet crystalline carbohydrate, white when pure, obtained from a great variety of plant juices, but chiefly from those of the sugar-cane and sugar-beet, and forming an important article of human food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar"@en .

aat:300183932 a skos:Concept ;
    skos:definition "Sheer, thin, heavily-sized open weave cotton, used for linings and as a wiping cloth in printmaking. Use also for a type of muslin brought from India to the United Kingdom in the 18th century, and produced in Scotland in the 19th century, commonly for ball gowns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarlatan"@en .

aat:300183933 a skos:Concept ;
    skos:definition "Refers to very thin plates or sheets, spangles, strips, or threads of gold or silver. It may also refer to imitations made of copper, brass, or a gold- or silver-colored alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinsel"@en .

aat:300183934 a skos:Concept ;
    skos:definition "Handmade Japanese paper made with 20% kozo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torinoko"@en .

aat:300183936 a skos:Concept ;
    skos:definition "In printmaking, a substance used to modify ink by increasing its transparency and workability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparent base"@en .

aat:300183938 a skos:Concept ;
    skos:definition "Paper typically used for typewriting; good-quality bond typewriter paper may consist of 80% white rags. Typewriter paper is sold by weight per ream, a ream usually consisting of 500 sheets of a specified size in inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriter paper"@en .

aat:300183941 a skos:Concept ;
    skos:definition "Paint based on a polyvinyl acetate medium. Diluted with water, but waterproof when dry, vinyl paint is highly opaque and is characterized by a matte finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl paint"@en .

aat:300183944 a skos:Concept ;
    skos:definition "Raw wool sheared from live sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virgin wool"@en .

aat:300183946 a skos:Concept ;
    skos:definition "Paint consisting of gypsum or whiting with some zinc oxide, with water as the vehicle and glue as the adhesion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-base paint"@en .

aat:300183955 a skos:Concept ;
    skos:definition "Paper without sizing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterleaf"@en .

aat:300183986 a skos:Concept ;
    skos:definition "Trademarked name for a vinyl resin used in the production of phonograph records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vinylite (TM)"@en .

aat:300183989 a skos:Concept ;
    skos:definition "Generic term used for various acid-free,100% cotton papers that are either of the Arches brand name or similar to those made under registered brand Arches. Although \"Arches\" is a registered trademark, the term has become generic through common usage. To indicate genuine paper of this band, prefer \"Arches paper (R).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arches paper"@en .

aat:300184090 a skos:Concept ;
    skos:definition "Paintings or carvings worked on living rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock art"@en .

aat:300184191 a skos:Concept ;
    skos:definition "Events, often used for fundraising or gambling, in which objects or prizes are distributed to the winners of a draw, who have paid for a chance to win them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lotteries"@en .

aat:300184196 a skos:Concept ;
    skos:definition "Designates security systems dependent on electronic devices, such as card readers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic security systems"@en .

aat:300184300 a skos:Concept ;
    skos:definition "Refers to series of visual works depicting events and unified by a common topic, not necessarily a sequence in a single story line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrative cycles"@en .

aat:300184312 a skos:Concept ;
    skos:definition "Parts or components on sites related to air flight or travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical site elements"@en .

aat:300184557 a skos:Concept ;
    skos:definition "Photographs taken of a scene or installation fabricated by the photographer specifically for the purpose of photographing it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staged photographs"@en .

aat:300184568 a skos:Concept ;
    skos:definition "Country or suburban retreats offering comfort and simplicity, combining the design of town houses with the needs of country living; less elaborate than châteaux; popular in 17th- and 18th-century France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maisons de plaisance"@en .

aat:300184570 a skos:Concept ;
    skos:definition "College buildings that house alumni associations, may have entertainment and assembly facilities for graduates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alumni centers"@en .

aat:300184573 a skos:Concept ;
    skos:definition "Formally arranged flower beds, planters, or boxed sections of gardens, often set with raised borders and in different shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parterres"@en .

aat:300184577 a skos:Concept ;
    skos:definition "Ancient Greek sculptures in which the extremities are made of stone and the torso is made of another material, usually wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acroliths"@en .

aat:300184579 a skos:Concept ;
    skos:definition "Reliefs found on the face of a voussoir or keystone, so-named because they resemble the shape of a clasp or badge (\"agrafe\" in French)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agrafes"@en .

aat:300184602 a skos:Concept ;
    skos:definition "Parts or components of sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture components"@en .

aat:300184603 a skos:Concept ;
    skos:definition "Assemblages of joined metal rods, tubes, wires or other materials such as wood that provides a structural framework for a sculpture and usually attaches to a base. Though generally internal, these may also include external supporting components that are eventually removed. In a lost-wax bronze, the armature is created to support the model, whether it is hollow or solid. In the case of a hollow cast, it will further help support the refractory mass of the core during the pour. Armatures may also be used in the assembly of a sculpture that was cast in parts, and in the repair of sculptures that have been structurally damaged. For the structural frames used to sustain or reinforce buildings or other structures, use \"armatures (structural frames).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armatures"@en .

aat:300184633 a skos:Concept ;
    skos:definition "Refers to sculpture executed in relatively shallow relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bas-reliefs"@en .

aat:300184644 a skos:Concept ;
    skos:definition "Sculpture used in or associated with the rites of burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary sculpture"@en .

aat:300184647 a skos:Concept ;
    skos:definition "Incised brass plates serving as memorials to the dead, typically found in Western art on tomb slabs or otherwise near burial sites, and often showing a portrait or coat of arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brasses"@en .

aat:300184720 a skos:Concept ;
    skos:definition "Figures carved as part of, and projecting from, columns. For supporting members fully in human form, use such terms as \"atlantes\" or \"caryatids.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "column figures"@en .

aat:300184735 a skos:Concept ;
    skos:definition "Sculpture that is constructed of metal using such processes as welding, hammering, and soldering as opposed to casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct metal sculpture"@en .

aat:300184750 a skos:Concept ;
    skos:definition "Supports below sculptured busts or heads, such as those found on terms or herms, which take the form of quadrangular pillars that narrow toward the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaines"@en .

aat:300184767 a skos:Concept ;
    skos:definition "Collectively, the class of sculptures, containers, and other objects and artifacts carved in jade, which is any of several varieties of fine-grained rock composed of jadeite, nephrite, serpentine, or other mineralogically related materials. Prominent examples of jades include carved jade objects produced in China from the Neolithic Period (ca. 3000–2000 BCE) onward. The Chinese have historically regarded carved-jade objects as intrinsically valuable, and they metaphorically equated jade with purity and indestructibility. In local the material term \"jade (rock)\" plus a more specific object name may be used, such as \"jade (rock)\" + \"figurines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jades"@en .

aat:300184782 a skos:Concept ;
    skos:definition "Refers to works in which half or more than half of the natural circumference of the modeled form projects from the surrounding surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high reliefs"@en .

aat:300184811 a skos:Concept ;
    skos:definition "Sculptured figures on the jambs or embrasures of a portal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jamb figures"@en .

aat:300184818 a skos:Concept ;
    skos:definition "Sculptures of the Archaic Greek period depicting standing draped female figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "korai"@en .

aat:300184865 a skos:Concept ;
    skos:definition "Small objects carved in wood, ivory, horn, or sometimes wrought in metal; used as toggles for Japanese kimonos or pouches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "netsukes"@en .

aat:300184867 a skos:Concept ;
    skos:definition "Ornamental works that are executed by the application of black metallic alloys, composed of sulfur and either copper, silver, or lead, to inlay designs incised in the surface of another metal. An example of niellos are small metal plates that were common in the Italian Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niellos"@en .

aat:300184881 a skos:Concept ;
    skos:definition "Sculptures of figures that are placed in reliquaries, and associated with the remembrance of ancestors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reliquary figures"@en .

aat:300184926 a skos:Concept ;
    skos:definition "Small Greek painted terracotta figurines of a type first found in Boeotian tombs of the 3rd and 4th centuries BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tanagra figurines"@en .

aat:300184947 a skos:Concept ;
    skos:definition "Poles carved and painted with a series of totemic symbols, erected before the homes of Native Americans of the northwestern coast of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "totem poles"@en .

aat:300184956 a skos:Concept ;
    skos:definition "Small ancient Egyptian figures of stone, wood, or clay that were placed in tombs, often in large numbers, for the purpose of serving the deceased in the afterlife. The term is derived from ancient Egyptian and is usually translated as \"answerer.\" During the New Kingdom (1539-1075 BCE) the figures were made to resemble the tomb owner by being fashioned in the form of a mummy bearing the owner's name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ushabti"@en .

aat:300184960 a skos:Concept ;
    skos:definition "Works from the mid-20th century and later that are sculptural and are installed on a wall surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall pieces"@en .

aat:300185097 a skos:Concept ;
    skos:definition "Sculptural works that involve the distribution of elements or modules in a manner that is, or appears to be, random or only partly controlled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scatter pieces"@en .

aat:300185153 a skos:Concept ;
    skos:definition "Mass-produced utilitarian objects which the artist transforms into works of art by placing them in an artistic context. The term is applied particularly to certain works of Marcel Duchamp, who pioneered the practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ready-mades"@en .

aat:300185188 a skos:Concept ;
    skos:definition "Contemporary works of art which involve wrapping, tying, or concealing an object; often used in the context of Christo's work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "empaquetages"@en .

aat:300185191 a skos:Concept ;
    skos:definition "General term for visual works that depend on technology, and have duration as a dimension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time-based works"@en .

aat:300185239 a skos:Concept ;
    skos:definition "Contemporary sculptural works that are composed of figures and objects arranged into a picturelike scene, which the viewer does not enter. For works that create surroundings that the viewer can enter, use \"environments (sculpture).\" For the silent, immobile arrangements of one or more costumed performers to reproduce a scene from art, drama, literature, history, or the imagination, use \"tableaux (performances).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tableaux"@en .

aat:300185245 a skos:Concept ;
    skos:definition "Contemporary sculptural works that create surroundings that the viewer can enter; most often indoor installations. For outdoor works that especially exploit or incorporate aspects of their sites and that may surround the viewer, use \"environmental art.\" For sculptural works that are composed of figures and objects arranged into a picturelike scene that the viewer does not enter, use \"tableaux (sculpture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environments"@en .

aat:300185251 a skos:Concept ;
    skos:definition "Non-professional painters, sculptors, or other artists who have not had formal training and are often self-taught; also, artists who are formally trained, but who create works in naive style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naive artists"@en .

aat:300185256 a skos:Concept ;
    skos:definition "A pair of circular stones used for grinding grain or other substances, which are typically fed through a central hole in the upper stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millstones"@en .

aat:300185263 a skos:Concept ;
    skos:definition "The interior, enclosed parts of Greek or Greco-Roman temples, usually containing the cult statue of the god and encompassing any sub-chambers within the solid wall, such as the vestibule, sanctuary or central chamber, and treasury. The term was later adopted to mean any of various small interior rooms, such as cells in a convent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellae"@en .

aat:300185269 a skos:Concept ;
    skos:definition "Cutting with blows of a heavy cutting instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hewing"@en .

aat:300185311 a skos:Concept ;
    skos:definition "Heatable devices usually with a flat metal base of some weight that are used to smooth, finish, or press cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irons"@en .

aat:300185319 a skos:Concept ;
    skos:definition "Parts or components of security systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "security system components"@en .

aat:300185320 a skos:Concept ;
    skos:definition "Automatic devices that give an alarm when such items as doors, windows, or safes are tampered with or opened without authorization, as by burglars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burglar alarms"@en .

aat:300185327 a skos:Concept ;
    skos:definition "Practices and techniques used in the printing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing techniques"@en .

aat:300185335 a skos:Concept ;
    skos:definition "Refers to horse-drawn wheeled vehicles designed primarily to convey people in some comfort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriages"@en .

aat:300185338 a skos:Concept ;
    skos:definition "Calendars of the Eastern Orthodox Church recording the festivals honoring saints and martyrs, together with brief accounts of their lives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menologions"@en .

aat:300185342 a skos:Concept ;
    skos:definition "Short, fictitious stories that illustrate a moral attitude or religious principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parables"@en .

aat:300185346 a skos:Concept ;
    skos:definition "Literary works emphasizing a story or sequence of events, given in order and with the establishing of connections between them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narratives"@en .

aat:300185352 a skos:Concept ;
    skos:definition "Books containing names and descriptions of herbs, or of plants in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbals"@en .

aat:300185378 a skos:Concept ;
    skos:definition "Layers of colored plaster in a casting mold that indicate the proximity of the cast surface; to prevent damage to the cast surface as the mold is chipped away from the cast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warning coats"@en .

aat:300185385 a skos:Concept ;
    skos:definition "Flat slabs of stone or metal that cover a tomb or coffin, typically in an interior space and often bearing sculpted images; often installed flush with the pavement of a building. For a vertical freestanding or horizontal memorial stone placed over a grave outdoors, use \"tombstone.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomb slabs"@en .

aat:300185396 a skos:Concept ;
    skos:definition "Fragments of pottery or stone containing inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ostraka"@en .

aat:300185409 a skos:Concept ;
    skos:definition "Direct, literal events carried out by artists, especially in Germany and Austria, attempting to destroy barriers between art and life; often brutal and obscene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actions"@en .

aat:300185430 a skos:Concept ;
    skos:definition "Use when, in printing, not all successive plates or blocks were positioned accurately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "out of register"@en .

aat:300185433 a skos:Concept ;
    skos:definition "Surface preparation techniques that involve biting, or corroding materials by the action of acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biting techniques"@en .

aat:300185434 a skos:Concept ;
    skos:definition "Marks made in paint by the action of the painter's brush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brush strokes"@en .

aat:300185447 a skos:Concept ;
    skos:definition "Works, dating from the 1960s, that incorporate people and usually movement but imply a close relation to static figure sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living sculpture"@en .

aat:300185470 a skos:Concept ;
    skos:definition "Works dating from the 1960s that eschew the traditional plinth and spread themselves across the gallery floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor pieces"@en .

aat:300185494 a skos:Concept ;
    skos:definition "Objects believed to be enchanted, or have magical power to aid or protect its owner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fetishes"@en .

aat:300185498 a skos:Concept ;
    skos:definition "Having a size greater than the size of life, or, with reference to visual representations of something, larger in size than the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "over life-size"@en .

aat:300185633 a skos:Concept ;
    skos:definition "Any of the three acids, orthophosphoric acid, H3PO4, metaphosphoric acid, HPO3, or pyrophosphoric acid, H4P2O7, derived from phosphorous pentoxide, P2O5, and various amounts of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphoric acid"@en .

aat:300185648 a skos:Concept ;
    skos:definition "Ornamental pottery produced by artists and craftsmen who emphasized the artistic nature of their work; of a type closely associated with the Arts and Crafts movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art pottery"@en .

aat:300185650 a skos:Concept ;
    skos:definition "Contemporary ceramics that were produced by an individual artist who was responsible for all steps in the design and execution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studio ceramics"@en .

aat:300185657 a skos:Concept ;
    skos:definition "Place or state of extreme or eternal suffering, usually inflicted as punishment upon the wicked or the nonbelieving, common to many belief systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hell"@en .

aat:300185658 a skos:Concept ;
    skos:definition "Place or state of eternal bliss and ideal relationship with God or the gods, usually accorded as the reward for virtue and true religious faith."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heaven"@en .

aat:300185659 a skos:Concept ;
    skos:definition "Education for handicapped or gifted students, who have intellectually, physically, emotionally, or socially different characteristics from those who can be taught through regular methods, facilities, or materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special education"@en .

aat:300185661 a skos:Concept ;
    skos:definition "Refers to factories in which gunpowder is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder mills"@en .

aat:300185678 a skos:Concept ;
    skos:definition "Generally refers to those belonging to an army, whether that of a sovereign state, a faction or division within a sovereign state, or of an individual leader. Specifically refers to military personnel of enlisted rank, as distinguished from commissioned officers. For those trained for or engaged in the physical combat of warfare and sanctioned in that function by the society or group for which they fight, irrespective of actual membership in an army, see \"warriors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soldiers"@en .

aat:300185680 a skos:Concept ;
    skos:definition "The act of freeing from restraint or bondage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emancipation"@en .

aat:300185684 a skos:Concept ;
    skos:definition "Narratives set in the distant past recounting events impossible in the real world, often magical and with fairies, but with humans as heroes and heroines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fairy tales"@en .

aat:300185689 a skos:Concept ;
    skos:definition "Use generally for occurrences of physical combat between or among people furnished with weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armed conflicts"@en .

aat:300185692 a skos:Concept ;
    skos:definition "Individual instances of armed conflict between two or more groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battles"@en .

aat:300185694 a skos:Concept ;
    skos:definition "Sheets or panels of material, designed to catch the wind and convert its energy, as to propel a sailing vessel or drive a windmill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sails"@en .

aat:300185696 a skos:Concept ;
    skos:definition "Emblems, symbols, or paraphernalia indicative of a royal state or of an office or membership in a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regalia"@en .

aat:300185707 a skos:Concept ;
    skos:definition "Generally used for narrow openings of rivers into riverbanks or lakes and seas into shores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inlets"@en .

aat:300185712 a skos:Concept ;
    skos:definition "Broad classifications for objects, which are material things that can be perceived by the senses; also includes electronic media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "object genres"@en .

aat:300185749 a skos:Concept ;
    skos:definition "Heavy woven textiles used for a variety of utilitarian purposes essentially in the form in which they left the loom. In Western societies they are used primarily as floor coverings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rugs"@en .

aat:300185756 a skos:Concept ;
    skos:definition "Rugs of some size whose primary use is to cover a flat surface; carpets constitute the largest and most familiar group of rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpets"@en .

aat:300185762 a skos:Concept ;
    skos:definition "Term of convenience for certain handwoven or hand-knotted pile rugs originally produced in certain regions of Asia, Africa, and Europe; prefer a more specific descriptor or the name of the place or culture of origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oriental rugs"@en .

aat:300185796 a skos:Concept ;
    skos:definition "Turkish term for flat-woven rugs with a particular supplementary weft structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cicims"@en .

aat:300185805 a skos:Concept ;
    skos:definition "Floor coverings handwoven in the town of Ghiordes, northeast of Izmir in western Anatolia, modern Turkey. Some of these rugs date from the last decades of the 18th century, borrowing elements from much earlier Ottoman court designs with fields of red or ivory. Many others were produced during the 19th century, using blue, green, and brown, and a field with small motifs. Areas of white pile in Ghiordes carpets are often knotted in cotton. After the 18th century, cotton was normally used for the weft and wool was used in the warp. The pile is generally of wool, but sometimes silk.The symmetrical knot is also known as the Ghiordes knot, after these textiles. The better quality rugs dating prior to the 20th century are highly prized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gördes"@en .

aat:300185837 a skos:Concept ;
    skos:definition "Floor coverings handwoven in or near the city of Konya in south-central Turkey. Early carpet fragments attributed to the 13th century ruling Seljuks in this style have been found in the Ala al-Din Mosque of Konya. More recently rugs from the region have used design motifs found widely distributed throughout the country. Often the Konya rug is of a fleecy wool with a loose weave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Konya"@en .

aat:300185882 a skos:Concept ;
    skos:definition "Ushak rugs with an oval medallion in the central field and a composite starlike medallion of 16 points which appears at the sides of the carpet. Both types of medallions are filled with compositions of arabesques and plant ornaments, with finials projecting from the ends or sides. The ground is covered with a pattern of stems, leaves, and flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medallion Ushaks"@en .

aat:300185890 a skos:Concept ;
    skos:definition "Ushak rugs characterized by a pattern composed of a large starlike motif of eight points and a smaller lozenge; these motifs are filled with arabesques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "star Ushaks"@en .

aat:300185898 a skos:Concept ;
    skos:definition "Small rugs which are approximately twice as long as they are wide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yastiks"@en .

aat:300185916 a skos:Concept ;
    skos:definition "A name of convenience for rugs with a specific, endless repeat pattern of hooked octagons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holbein carpets"@en .

aat:300185922 a skos:Concept ;
    skos:definition "A name of convenience for rugs with a geometrical design of octagons within rectangles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "large pattern Holbeins"@en .

aat:300185933 a skos:Concept ;
    skos:definition "A name of convenience used to designate rugs with a repeating pattern composed of two main elements: an octagon with an outline of angular interlace and a cross-shaped motif of arabesque forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small pattern Holbeins"@en .

aat:300185944 a skos:Concept ;
    skos:definition "Rugs with a large, complex star motif, so named because they appeared in a painting by the Italian Renaissance painter Carlo Crivelli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crivelli carpets"@en .

aat:300185946 a skos:Concept ;
    skos:definition "A name of convenience for rugs with a specific endless repeat pattern of arabesque forms, so called because they appear in a painting by the Italian Renaissance painter Lorenzo Lotto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lotto carpets"@en .

aat:300185969 a skos:Concept ;
    skos:definition "Rugs with a symmetrical design and an arch at both ends, thought to have been made in Anatolia but so-named because many were found in Transylvania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Transylvanian carpets"@en .

aat:300185986 a skos:Concept ;
    skos:definition "Oblong rugs designed to encircle a column or post in Lamaist temples, they have no side borders and their design is not complete unless the edges of the rug abut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar rugs"@en .

aat:300186007 a skos:Concept ;
    skos:definition "Pentagonal knotted-pile woven rugs made in pairs to decorate the flanks of a camel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asmalyks"@en .

aat:300186013 a skos:Concept ;
    skos:definition "Turkish woven squares used for wrapping or sewn into baglike containers with one side left unsewn, to be folded like an envelope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bokches"@en .

aat:300186029 a skos:Concept ;
    skos:definition "A type of rug that served as a door at the entrance to a Turkoman tent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engsis"@en .

aat:300186042 a skos:Concept ;
    skos:definition "Knotted pile weavings that hung around the door of a Turkoman tent; also may have served as an animal trapping for Turkoman marriage rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kapunuks"@en .

aat:300186050 a skos:Concept ;
    skos:definition "Small bags composed of a pile-woven front and weft-faced plain weave on the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mafrashes"@en .

aat:300186054 a skos:Concept ;
    skos:definition "Bags woven by central Asian nomads, intended to secure the tips of a bundle of strut poles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "okbashes"@en .

aat:300186091 a skos:Concept ;
    skos:definition "Covers for floors, intended to protect the floor from soiling or wear, to provide warmth or a more comfortable walking surface, or for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor coverings"@en .

aat:300186098 a skos:Concept ;
    skos:definition "Coverings laid under a table to catch crumbs and protect the carpet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crumbcloths"@en .

aat:300186101 a skos:Concept ;
    skos:definition "Coarse textiles which were used as inexpensive floor coverings by themselves or on top of a carpet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "druggets"@en .

aat:300186112 a skos:Concept ;
    skos:definition "Protective floor coverings, such as those made of a coarse material intended to protect the floor, or those made as a resilient or padded covering to protect athletes during practice or performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mats"@en .

aat:300186177 a skos:Concept ;
    skos:definition "Straw matting used as a floor covering in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tatamis"@en .

aat:300186178 a skos:Concept ;
    skos:definition "White-ground Anatolian rugs with an endless repeat of stylized angular leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird Ushaks"@en .

aat:300186184 a skos:Concept ;
    skos:definition "Turkish rugs with a design element consisting of a tomb and trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cemetery carpets"@en .

aat:300186202 a skos:Concept ;
    skos:definition "A name of convenience for rugs that incorporate design elements common in Mamluk rugs such as rows of small trees and plants and Turkish rugs such as a large central medallion surrounded by four small medallions. Like Mamluk rugs they are asymmetrically knotted; however, they differ in using Z-twist wool rather than S-twist, the yarn is almost three times as thick, and they are dyed red with madder instead of lac."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Para-Mamluk carpets"@en .

aat:300186208 a skos:Concept ;
    skos:definition "Manners of execution used in carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carving techniques"@en .

aat:300186209 a skos:Concept ;
    skos:definition "Technique in which stone is chiseled to the approximate shape of the finished work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boasted work"@en .

aat:300186214 a skos:Concept ;
    skos:definition "Techniques characterized by indentations or holes that are applied using punches, and forming texture or designs. Examples of punchwork are in leather items, wooden items such as altarpieces, metalwork, or paper crafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punchwork"@en .

aat:300186215 a skos:Concept ;
    skos:definition "A waxy, cloudy or powdery haze that appears on the surface of paint, varnish, leather, ink, metal, plastic, or other materials. Bloom may be due to the deposit of atmospheric pollutants such as ammonium sulfate; for varnish, it may be caused by trapped or condensed moisture often due to varnish application in humid conditions, or due to wax-based media; for paint it may be caused by exudation of organic salts formed by reactions of the oils components with pigments or driers; for plastic, rubber or ink, it may be caused by exudation of additives or unreacted monomers; for leather, it may be caused by ellagic acid crystallization after tanning with some pyrogallol type vegetable tannins; for metal, it may be caused by trace impurities that crystallize on the surface after casting; for a photographic plate, it may be caused by dried residues from tap water. It is distinguished from \"blanching\" which is the milky appearance of resinous or oily film following application of a solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bloom"@en .

aat:300186218 a skos:Concept ;
    skos:definition "Sculptural relief technique in which figures and objects project by about one-half their full roundness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezzo rilievo"@en .

aat:300186228 a skos:Concept ;
    skos:definition "Sculptural relief technique in which projection of the forms is extremely shallow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rilievo schiacciato"@en .

aat:300186231 a skos:Concept ;
    skos:definition "Technique of creating a design that is sunken into the surface, by carving or incising."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intaglio"@en .

aat:300186238 a skos:Concept ;
    skos:definition "Relief technique in which the surface of the block is allowed to remain as background and the figures are carved with positive projections within the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coelanaglyphic relief"@en .

aat:300186243 a skos:Concept ;
    skos:definition "Fastening together two pieces of wood by means of dowels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doweling"@en .

aat:300186399 a skos:Concept ;
    skos:definition "In general, refers to the styles and culture of Turkic people of central Asia, forming the basic population of Kazakhstan. Specifically, refers to the style of floor coverings woven by villagers living in western Azerbaijan and in a number of towns and villages in northern Armenia and the adjacent southern part of Georgia. Textiles are typically all wool, coarsely knotted in the symmetrical knot with a long, lustrous pile, and use strong red, blue, and ivory in bold combinations with relatively simple but dramatic designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kazak"@en .

aat:300186430 a skos:Concept ;
    skos:definition "Refers to any carpet made in India, Turkey, Iran, or elsewhere that copies the original carpets made for use at the Ardabil shrine; and any contemporary carpet made in the area of Ardabil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ardabil carpets"@en .

aat:300186588 a skos:Concept ;
    skos:definition "Sculpture made of or covered with gold and ivory; used especially for ancient Greek figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chryselephantine sculpture"@en .

aat:300186622 a skos:Concept ;
    skos:definition "The maximum ability of a material or object to withstand stresses of various kinds without breaking down or being distorted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical strength"@en .

aat:300186728 a skos:Concept ;
    skos:definition "Early Spanish rugs characterized by a woolen pile tied with Spanish knots to an undyed woolen foundation, generally somber in color, often with a red ground and geometrical design motifs reminiscent of Classic Anatolian rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alcaraz carpets"@en .

aat:300186739 a skos:Concept ;
    skos:definition "Early Spanish carpets with three major types of ornamentation derived from Persian or Anatolian rugs, an octagonal-hexagonal design, stepped lozenges design, and star and lozenge design; they are often embellished with coats of arms, and incorporate non-Islamic motifs such as animal or human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Admiral carpets"@en .

aat:300186755 a skos:Concept ;
    skos:definition "End panels of Turkmen bag faces and rugs which are located outside of the main borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elem"@en .

aat:300186759 a skos:Concept ;
    skos:definition "Rug components which consist of intertwined parts of one or more flexible bodies (such as ropes, cords, or strips), which form lumps or knobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knots"@en .

aat:300186765 a skos:Concept ;
    skos:definition "Knots of rugs tied on pairs of warp strands, looping under one strand and then over and around the other, the ends of the knot coming up individually between each single warp strand to form a pile. They can be tied so that the knot ends come up either to the right or to the left of the encircled warp strands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asymmetrical knots"@en .

aat:300186772 a skos:Concept ;
    skos:definition "The style and culture of the Nahuatl-speaking people of the area of Totolapan, in what is now the Mexican state of Morelos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Totolapan"@en .

aat:300186794 a skos:Concept ;
    skos:definition "Asymmetrical knots, woven over four warp threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jufti knots"@en .

aat:300186806 a skos:Concept ;
    skos:definition "Knots of rugs tied over two strands of warp with both ends of the knot coming up together between the two encircled strands to form a pile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symmetrical knots"@en .

aat:300186835 a skos:Concept ;
    skos:definition "Changing from a solid to a liquid state usually by the action of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melting"@en .

aat:300186842 a skos:Concept ;
    skos:definition "Mats placed before or just inside a door for wiping mud and dirt from shoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doormats"@en .

aat:300186846 a skos:Concept ;
    skos:definition "Small rugs commonly put near the hearth to protect the larger more expensive carpeting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearth rugs"@en .

aat:300186855 a skos:Concept ;
    skos:definition "Long, narrow runners used to protect stairs, typically characterized by fitting only the central portion of the stairway, leaving the wood of the treaders and risers visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stair carpets"@en .

aat:300186862 a skos:Concept ;
    skos:definition "Small rugs that can be randomly placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throw rugs"@en .

aat:300186869 a skos:Concept ;
    skos:definition "Weavings done as a sample to display types of borders, patterns, and colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vagirehs"@en .

aat:300186871 a skos:Concept ;
    skos:definition "Bruising the surface of stone by striking with a blunt tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stunning"@en .

aat:300186877 a skos:Concept ;
    skos:definition "Decorative rugs which define a living space in a room by providing an often colorful focus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "area rugs"@en .

aat:300186880 a skos:Concept ;
    skos:definition "Machine-made carpets woven on a wide loom, usually measuring 54 inches or wider."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadlooms"@en .

aat:300186885 a skos:Concept ;
    skos:definition "Carpets that cover the entire floor in an area and are tacked or otherwise attached to the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall-to-wall carpeting"@en .

aat:300186893 a skos:Concept ;
    skos:definition "A Persian term for long, relatively narrow rugs measuring approximately 6 by 4 feet, or 2 zars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dozars"@en .

aat:300186896 a skos:Concept ;
    skos:definition "Long, narrow, Persian carpets whose lengths are generally two to three times their widths; usually headpieces in the traditional carpet arrangement of Islamic rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kelleyehs"@en .

aat:300186901 a skos:Concept ;
    skos:definition "Two narrow carpets placed on either side of the mian farsh in the traditional carpet arrangement of an Islamic room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kenares"@en .

aat:300186903 a skos:Concept ;
    skos:definition "The principal or central rug as arranged in the traditional manner on the floor of the main chambers of important Islamic homes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mian farsh"@en .

aat:300186906 a skos:Concept ;
    skos:definition "Long, narrow floor coverings used especially in halls, narrow passages, and on stairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runners"@en .

aat:300186910 a skos:Concept ;
    skos:definition "Rugs with one or more mihrabs, arch-shaped designs, toward one end of the field; so called since many were intended for use by a Moslem for daily prayers. Commonly of small size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer rugs"@en .

aat:300186923 a skos:Concept ;
    skos:definition "Sculpture made from unaltered objects that are either natural or human-made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "found object sculpture"@en .

aat:300186925 a skos:Concept ;
    skos:definition "Prayer rugs with multiple niches or arch designs, used for family or group prayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safs"@en .

aat:300186933 a skos:Concept ;
    skos:definition "Small rugs of approximately 3 by 5 feet, often with a design that incorporates some depiction of a mihrab; originally intended for Islamic prayer, although some motifs and inscriptions indicate not all were made for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sejjadeh"@en .

aat:300186954 a skos:Concept ;
    skos:definition "Any of various rugs woven without a pile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flatweaves"@en .

aat:300186958 a skos:Concept ;
    skos:definition "Tapestry- or flat-woven rugs made in southern France, used as floor coverings or wall hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aubusson carpets"@en .

aat:300186972 a skos:Concept ;
    skos:definition "Tapestry-woven rugs produced in the Islamic lands of western Central Asia, the Middle East, the Balkans and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kilims"@en .

aat:300187008 a skos:Concept ;
    skos:definition "Hooked rugs popular in the early 20th century with designs inspired by Native American rug motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abnakee rugs"@en .

aat:300187021 a skos:Concept ;
    skos:definition "Late-17th- and 18-century rugs, thought to have originated in the Caucasus, frequently characterized by a depressed two-level natural wool warp, wool wefts often dyed red, and knotted with symmetrical knots; the field pattern consists of a drop repeat directional lattice pattern made up of jagged leaf forms enclosing stylized dragons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragon rugs"@en .

aat:300187042 a skos:Concept ;
    skos:definition "Pileless, handwoven floor coverings made in most of the rug-weaving areas of the Middle East, with usage of the term varying in different locations, including slit-tapestry kilims in the Caucasus, woven fabric in eastern Iran, and large rugs with a diamond grid and narrow borders as woven by the Turkmen Yomut, Tekke, and Ersari tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palas"@en .

aat:300187047 a skos:Concept ;
    skos:definition "Pileless loom-woven floor coverings made by simultaneously weaving and interweaving two cloths of different colors in such a way as to allow first one cloth and then the other to appear on the surface. The result is a smooth-faced reversible floor covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ingrain carpets"@en .

aat:300187048 a skos:Concept ;
    skos:definition "Designation given to many types of rugs of Anatolian, Iranian or Indian origin, based not on the style of rug but a descriptor of the animal motifs on the rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal carpets"@en .

aat:300187062 a skos:Concept ;
    skos:definition "Rugs that include rectangular compartments, each containing some floral or botanic motif, designs possibly representing the layout of Persian gardens with flower beds and streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden carpets"@en .

aat:300187076 a skos:Concept ;
    skos:definition "Flat-woven rugs from Turkey, elsewhere in the Caucasus, and surrounding areas; patterned by supplementary wrapping wefts. They are typically heavy and stiff; they may be distinguished by their pattern, which is visible from only from one side with the reverse often having threads of yarn left hanging on the back. The technique is one of the oldest known, identified among charred 7th-century-BCE fragments excavated at Gordion, near Ankara in Anatolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soumaks"@en .

aat:300187083 a skos:Concept ;
    skos:definition "High quality Kirman carpets characterized by a heavily ornamented field of large and small flowers with curving, intertwining stems and sometimes having patterns including vases. Warps are cotton and three shots of weft pass between each row of knots, the first and third of which are wool, the second cotton or silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vase carpets"@en .

aat:300187090 a skos:Concept ;
    skos:definition "Strip carpets having a worsted warp concealing the weft; usually striped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian carpets"@en .

aat:300187097 a skos:Concept ;
    skos:definition "Caucasian flat-woven rugs with dragon forms in the shape of the block letter S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernehs"@en .

aat:300187103 a skos:Concept ;
    skos:definition "Caucasian flat-woven rugs from Karabagh with weft-float brocading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zilis"@en .

aat:300187116 a skos:Concept ;
    skos:definition "Rugs having loops or tufts extending above the foundation or ground to form a raised, thick surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile-woven carpets"@en .

aat:300187132 a skos:Concept ;
    skos:definition "Knotted pile carpets originally produced in Axminster, Devon, England. They are woven in one piece with weaving of high quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Axminster carpets"@en .

aat:300187133 a skos:Concept ;
    skos:definition "Strictly speaking, floor or table carpets, rugs, and kilims of Turkish design; however, in historical sources the term may be used imprecisely to refer to any rugs having Oriental designs, not necessarily only those of Turkish manufacture or design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkey carpets"@en .

aat:300187147 a skos:Concept ;
    skos:definition "Carpets woven with loops like Brussels carpets but different from them in being heavier, having velvet cut piles, being generally of better materials and having designs adapted from Oriental rug patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wilton carpets"@en .

aat:300187157 a skos:Concept ;
    skos:definition "Machine-made floor coverings of a particular type, having the loops of the pile uncut. All colors run with the warp, concealed, and are brought above the foundation in loops to produce the pattern. The type is believed to have originated in or near Brussels; was popular in the first half of the 19th century. They differ from Wilton carpets, which are produced by a similar process but the loops are cut, producing a soft pile surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brussels carpets"@en .

aat:300187163 a skos:Concept ;
    skos:definition "High-pile, shaggy, handwoven Scandinavian rugs, often incorporating strong, colorful designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rya rugs"@en .

aat:300187165 a skos:Concept ;
    skos:definition "Pile carpets woven in the manner of a Wilton carpet but with yarn of lesser quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saxonies"@en .

aat:300187173 a skos:Concept ;
    skos:definition "Generic name for French pile carpets, usually large; not always made at the Savonnerie workshop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Savonnerie carpets"@en .

aat:300187174 a skos:Concept ;
    skos:definition "Rugs made by sewing yarn in a continuous running stitch through a closely woven foundation and leaving loops of yarn on the surface to form a pile; the loops are usually clipped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yarn-sewn rugs"@en .

aat:300187210 a skos:Concept ;
    skos:definition "Single rugs woven to represent the arrangement of four rugs often used in the main chambers of important Islamic houses, composed of the mian farsh, kelleyeh, and two kenares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audience rugs"@en .

aat:300187230 a skos:Concept ;
    skos:definition "Refers to prayer rugs with a columnar motif on either side of the mirhab."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupled-column rugs"@en .

aat:300187270 a skos:Concept ;
    skos:definition "Rugs characterized by a coarse, long pile and decorated with bold, abstract patterns; thought to have been made by nomads from the central Zagros Mountains. Commonly used as sleeping rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gabbehs"@en .

aat:300187275 a skos:Concept ;
    skos:definition "A machine-made, loop-pile rug which resembles an Axminster carpet in appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moquettes"@en .

aat:300187289 a skos:Concept ;
    skos:definition "Small Ushak rugs with opposed niches in the central field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-niche Ushaks"@en .

aat:300187307 a skos:Concept ;
    skos:definition "Rugs designed specifically to be used under or on top of a saddle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle rugs"@en .

aat:300187319 a skos:Concept ;
    skos:definition "Carpets created to look similar to the traditional body Brussels carpet, but produced by a cheaper method. For tapestry Brussels carpets, designs are printed on the warp yarns before the carpet is woven, rather than dyed-in-the-skein yarn used and the design produced in the weaving. Tapestry Brussels carpets may be machine printed or drum printed. One process to make these textiles involved a large cylinder or drum around which yarns were wound, then colored by a mechanism or by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry Brussels"@en .

aat:300187327 a skos:Concept ;
    skos:definition "Tapestry carpets of the type in which the loop has been cut so as to form an upright, velvety pile. The pile is typically slightly higher than a tapestry carpet. Velvet carpets may resemble Wilton carpets, but the pile of the velvet carpet is not so rich or thick as a Wilton carpet, and the two types of carpet are produced by different methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velvet carpets"@en .

aat:300187371 a skos:Concept ;
    skos:definition "Generally, inks formulated specifically for the process of printing from plates or blocks. These usually consist of pigment suspended in an oil vehicle, combined with resin, solvent, adhesive and a drier, but there are countless recipes for printing inks dependent on the purposes for which they are intended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing ink"@en .

aat:300187374 a skos:Concept ;
    skos:definition "Any of a group of astringent vegetable principles or compounds, chiefly complex glucosides of catechol and pyrogallol, used for their tanning properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tannin"@en .

aat:300187403 a skos:Concept ;
    skos:definition "Tibetan rugs with a length double the width, the primary function is for sleeping or sitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khadens"@en .

aat:300187410 a skos:Concept ;
    skos:definition "Rugs that incorporate into their field design the motif of tigers or tiger pelts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiger rugs"@en .

aat:300187434 a skos:Concept ;
    skos:definition "Karabagh rugs with a pattern which consists of one or more medallions containing motifs which resemble the cloud whisp motifs of Chinese art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloudband Kazaks"@en .

aat:300187539 a skos:Concept ;
    skos:definition "A type of flat-woven rug usually made of cotton, produced in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhurries"@en .

aat:300187549 a skos:Concept ;
    skos:definition "Containers for safeguarding or exhibiting relics, which are personal items or parts of items, or parts of a corpse of a holy person, saint, or deity. Reliquaries vary in small boxes to large objects, sometimes in the shape of the enclosed relic. For places in which devotion is paid to relics or holy objects, use \"shrines (structures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reliquaries"@en .

aat:300187567 a skos:Concept ;
    skos:definition "Large, deep wall bags, used primairly in tents, suspended from the trellis structure. The fronts are pile woven and the backs done in a weft-faced plain weave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuvals"@en .

aat:300187571 a skos:Concept ;
    skos:definition "Events that are held, or occur, in relation to politics and political activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political events"@en .

aat:300187586 a skos:Concept ;
    skos:definition "Woven trappings covering the chest of a camel during Turkoman marriage rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khalyks"@en .

aat:300187587 a skos:Concept ;
    skos:definition "Small wall bags, used primarily in tents, suspended from the trellis structure. The fronts are pile-woven and the backs done in a weft-faced plain weave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torbas"@en .

aat:300187624 a skos:Concept ;
    skos:definition "Individuals having a common parent or parents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siblings"@en .

aat:300187627 a skos:Concept ;
    skos:definition "Describes objects designed to bend over onto themselves into a compact form. For the activity of bending something over upon itself, use \"folding (process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding"@en .

aat:300187628 a skos:Concept ;
    skos:definition "Use to describe objects, including structures, or components of objects designed to perform a complete rotation around an axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolving"@en .

aat:300187629 a skos:Concept ;
    skos:definition "Use to describe things shaped like domes, or things having domes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domed"@en .

aat:300187630 a skos:Concept ;
    skos:definition "Use to describe things constructed in vault form or things covered or closed by a vault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaulted"@en .

aat:300187635 a skos:Concept ;
    skos:definition "Rugs made in India in the 17th century incorporating design motifs borrowed from 16th-century Persian rugs, such as elaborate vine-leaf floral palmettes and scrolling vines in the field design; typically made with a red ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-Herat carpets"@en .

aat:300187668 a skos:Concept ;
    skos:definition "Functions based around the use of technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technology-related functions"@en .

aat:300187670 a skos:Concept ;
    skos:definition "Parts or components of hearths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearth components"@en .

aat:300187728 a skos:Concept ;
    skos:definition "A name of convenience given to types of rugs thought to have been made in Isfahan or Kashan characterized by a silk pile, floral designs, and areas of gold or silver brocade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polonaise carpets"@en .

aat:300187737 a skos:Concept ;
    skos:definition "Anatolian prayer rugs that are characterized by two octagonal shapes that intrude into the field design at the bottom and top, from the border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "re-entrant rugs"@en .

aat:300187748 a skos:Concept ;
    skos:definition "Slabs of ink used in lithography to obtain soft tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbing ink"@en .

aat:300187750 a skos:Concept ;
    skos:definition "Ink used in the printing of lithographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic ink"@en .

aat:300187764 a skos:Concept ;
    skos:definition "Small rugs usually intended for use on tables or chests, typically not on the floor. They comprise circular patches, often of gradated sizes, cut from felt or discarded clothing; the circles were placed one on top of the other, with the smallest on top, to form a button-like form. The \"buttons\" were then sewn down to a strong foundation fabric. The rug may be embellished with embroidery. Button rugs were popular in the United States in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "button rugs"@en .

aat:300187775 a skos:Concept ;
    skos:definition "Elements of the cultural landscape designed for the convenience and safety of pedestrians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestrian facilities"@en .

aat:300187787 a skos:Concept ;
    skos:definition "In rug weaving, one knot to every two warp yarns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berber knots"@en .

aat:300187822 a skos:Concept ;
    skos:definition "Small Tibetan rugs usually smaller than 3 feet square placed as the top rug on a pile of rugs for sitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khagangmas"@en .

aat:300187841 a skos:Concept ;
    skos:definition "A name of convenience for a type of rug characterized by maritime scenes in the corners, so called because the ships appear to be European manned by seamen in Portuguese or Dutch style clothing; the rugs are made with a cotton foundation with asymmetrical and some jufti knotting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portuguese carpets"@en .

aat:300187857 a skos:Concept ;
    skos:definition "A name of convenience for a group of Persian rugs probably woven in Kirman at the beginning of the 17th century; motifs commonly include medallions, real and mythical animals, or human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sanguszko carpets"@en .

aat:300187936 a skos:Concept ;
    skos:definition "Knots made by using a temporary rod along the width of the carpet, placed in front of the warp; the long yarn is placed around two warp threads and then around the rod. When the weaver is done with the entire row of knots the loops around the rod are cut to create the knot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tibetan knots"@en .

aat:300187977 a skos:Concept ;
    skos:definition "Wax formed into an edge around a printing plate so that the plate may be bitten before immersion; used especially for extra-large plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bordering wax"@en .

aat:300187982 a skos:Concept ;
    skos:definition "People actively propelling themselves through the water by natural means. For people washing themselves with water, or immersed in water, use \"bathers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swimmers"@en .

aat:300187992 a skos:Concept ;
    skos:definition "Rugs with depictions of recognizable figures, objects, or scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial rugs"@en .

aat:300188001 a skos:Concept ;
    skos:definition "Irregularly shaped carpets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaped carpets"@en .

aat:300188009 a skos:Concept ;
    skos:definition "Embroidered rugs named after and made in Arraiolos, Portugal. The technique is herringbone or cross-stitch on a linen cloth foundation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arraiolos carpets"@en .

aat:300188014 a skos:Concept ;
    skos:definition "Refers to the assemblage of backdrops, constructions, props, lighting, and sound systems created to represent a setting used in a dramatic performance on stage, television, or film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sets"@en .

aat:300188489 a skos:Concept ;
    skos:definition "Rugs made with a rag or list weft, often woven in strips and sewn together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rag rugs"@en .

aat:300188519 a skos:Concept ;
    skos:definition "Women whose occupation is the washing and ironing of clothes and linen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundresses"@en .

aat:300188572 a skos:Concept ;
    skos:definition "People or corporate bodies who pay for or plan and carry out projects or activities, or otherwise assume primary responsibility for them. For those who support individuals, institutions, or causes but do not necessarily take primary responsibility for them, use \"patrons.\" For those who contribute volunteer work, money, or public expressions of support through membership in a voluntary association, use \"friends.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponsors"@en .

aat:300188575 a skos:Concept ;
    skos:definition "Rugs made of mats measuring about 2 feet square that have been sewn together; often placed between pillars in Buddhist temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temple rugs"@en .

aat:300188587 a skos:Concept ;
    skos:definition "Diplomats of the highest rank, sent by one sovereign or state to another or to an international organization as its chief representative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambassadors"@en .

aat:300188588 a skos:Concept ;
    skos:definition "Small rugs woven as part of a cottage industry system or for use by the weavers and their families, often made by former nomadic or pastoral tribal peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "village rugs"@en .

aat:300188589 a skos:Concept ;
    skos:definition "Rugs woven within a tribe or group, typically woven by nomadic or pastoral people for their personal use rather than for commercial purposes. They are characterized by the use of traditional geometric motifs, a lower knot count than the tightly woven rugs produced in urban centers, and often use of a wool foundation with plant based dyes and hand-spun wool thread; they were originally woven on wooden looms that could be dismantled for traveling and reassembled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribal rugs"@en .

aat:300188602 a skos:Concept ;
    skos:definition "People who ride horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equestrians"@en .

aat:300188603 a skos:Concept ;
    skos:definition "Those who ride horses in races."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jockeys"@en .

aat:300188606 a skos:Concept ;
    skos:definition "People who glide on skates (especially over ice) as a pastime, or as a means of exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skaters"@en .

aat:300188609 a skos:Concept ;
    skos:definition "Skaters who glide over ice, as a pastime or as a means of exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice skaters"@en .

aat:300188613 a skos:Concept ;
    skos:definition "Those whose occupation is to shave or trim the beard and to cut and dress the hair of their primarily male clientele."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbers"@en .

aat:300188618 a skos:Concept ;
    skos:definition "Those who subsist by asking for alms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beggars"@en .

aat:300188621 a skos:Concept ;
    skos:definition "People who are in love or who have sexual intercourse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lovers"@en .

aat:300188626 a skos:Concept ;
    skos:definition "People who feel or express grief or sorrow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourners"@en .

aat:300188634 a skos:Concept ;
    skos:definition "People washing themselves with water, or immersed in water. For people actively propelling themselves through the water by natural means, use \"swimmers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathers"@en .

aat:300188698 a skos:Concept ;
    skos:definition "Models that are intended to represent how something, as a building, a ship, or a city, looked at a previous time. For drawings or full-scale new objects or structures made with similar intent, use \"reconstructions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical models"@en .

aat:300188706 a skos:Concept ;
    skos:definition "People who have not had sexual intercourse; also, chaste, pious women accorded a special place in the Christian community, especially in the early church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virgins"@en .

aat:300188709 a skos:Concept ;
    skos:definition "Those who foretell future events, especially divinely inspired revelations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prophets"@en .

aat:300188714 a skos:Concept ;
    skos:definition "Those who sacrifice their lives for the sake of religion or principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martyrs"@en .

aat:300188718 a skos:Concept ;
    skos:definition "Hereditary Zoroastrian priests of the ancient Medes and Persians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magi"@en .

aat:300188720 a skos:Concept ;
    skos:definition "Female siblings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sisters"@en .

aat:300188723 a skos:Concept ;
    skos:definition "Male siblings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brothers"@en .

aat:300188725 a skos:Concept ;
    skos:definition "Refers to a type of decomposition of timber by fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry rot"@en .

aat:300188746 a skos:Concept ;
    skos:definition "Occasions of the severe damage or loss of a boat or ship at sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipwrecks"@en .

aat:300188750 a skos:Concept ;
    skos:definition "Class within the nobility consisting of those who are descended from or related to a monarch or line of monarchs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royalty"@en .

aat:300188765 a skos:Concept ;
    skos:definition "Housing built by a slow step-by-step process whereby building components are added or altered by owner-builders as money, time, or materials become available."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incremental housing"@en .

aat:300188783 a skos:Concept ;
    skos:definition "Short, concise sayings repeated colloquially expressing a general truth or observation about human life or behavior, often embodying the folk wisdom of a group or nation. Distinguished from \"aphorisms\" which are statements of principle or precepts, often of known authorship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proverbs"@en .

aat:300188789 a skos:Concept ;
    skos:definition "Acknowledging in writing the payment of a bill, or the delivery of money, articles, or goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "receipting"@en .

aat:300188791 a skos:Concept ;
    skos:definition "Making a formal written request to a higher authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petitioning"@en .

aat:300188795 a skos:Concept ;
    skos:definition "Photographic prints produced by photographing a two-dimensional work, such as a drawing or painting, or by rephotographing another photograph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copy prints"@en .

aat:300188801 a skos:Concept ;
    skos:definition "Self-help development practices where individuals, families, or cooperatives are provided with title and improved land on which buildings, usually housing, can be built."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sites and services"@en .

aat:300188807 a skos:Concept ;
    skos:definition "Photographs originally taken as one of a pair of stereoscopic photographs but then printed or mounted as a single image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half stereographs"@en .

aat:300188811 a skos:Concept ;
    skos:definition "Objects, such as blocks or plates, used to transfer images in the printing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing surfaces"@en .

aat:300188812 a skos:Concept ;
    skos:definition "Collections of psalms, anthems, or verses to be sung responsively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiphonaries"@en .

aat:300188820 a skos:Concept ;
    skos:definition "The actions, functions, or state of acquiring or imparting specific skills through instruction or practice. For directly instructing others in knowledge, attitudes, or skills, use \"teaching.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "training"@en .

aat:300188826 a skos:Concept ;
    skos:definition "Training or retraining designed to prepare individuals for gainful employment in recognized or new and emerging occupations, assist them in making occupational choices, and upgrade or update those already working in an occupational field. It encompasses both secondary and postsecondary programs, public or private, and usually involves both classroom and field work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocational training"@en .

aat:300188931 a skos:Concept ;
    skos:definition "Breaking into and entering any building belonging to another with the intent to commit theft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burglary"@en .

aat:300188975 a skos:Concept ;
    skos:definition "Illustrations, diagrams, etc. that are printed along with the text of a book for the purpose of clarifying or illustrating the text of a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figures"@en .

aat:300188990 a skos:Concept ;
    skos:definition "Pages covered with intricate ornament, sometimes with a central cross motif, as in certain Insular manuscripts, sometimes composed of minute script, as in certain Hebrew manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpet pages"@en .

aat:300189023 a skos:Concept ;
    skos:definition "People who sell their services as sexual partners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prostitutes"@en .

aat:300189129 a skos:Concept ;
    skos:definition "Keeping something undesirable from happening, or someone from doing something undesirable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preventing"@en .

aat:300189134 a skos:Concept ;
    skos:definition "Machines for writing in characters like those produced by printers' types, by which steel dies strike a paper through an inked ribbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriters"@en .

aat:300189136 a skos:Concept ;
    skos:definition "Officially correcting written text or recorded data by addition, deletion, or modification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amendment"@en .

aat:300189140 a skos:Concept ;
    skos:definition "Concluding or discontinuing an activity, program, or job position. For the act of dismissing an employee, use \"firing (managing).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terminating"@en .

aat:300189146 a skos:Concept ;
    skos:definition "The state of being physically or psychologically habituated to a substance or practice to such an extent that its cessation causes severe trauma. For the long term or excessive use or misuse of narcotics, alcohol, or other substances, use \"substance abuse.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "addiction"@en .

aat:300189153 a skos:Concept ;
    skos:definition "Addiction to alcoholic beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcoholism"@en .

aat:300189155 a skos:Concept ;
    skos:definition "Any aberrant or maladaptive patterns of behavior that are sufficiently severe to warrant the attention of counselors or therapists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "behavior disorders"@en .

aat:300189204 a skos:Concept ;
    skos:definition "Those who are addicted to an activity, habit, or substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "addicts"@en .

aat:300189207 a skos:Concept ;
    skos:definition "Concept having to do with the state or condition of habitual reliance upon a narcotic, opiate, or hallucinogen for psychotropic rather than medicinal purposes. For excessive use or misuse of drugs, use \"drug abuse.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drug addiction"@en .

aat:300189216 a skos:Concept ;
    skos:definition "Illustrations that are printed separately from the text they accompany, often on different paper; may be bound in with the text, tipped in, loose in a pocket, or bound in a separate volume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plates"@en .

aat:300189220 a skos:Concept ;
    skos:definition "Therapy which uses forms of work or creative activity as medical or psychiatric treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupational therapy"@en .

aat:300189223 a skos:Concept ;
    skos:definition "Paper treated with a coating of wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waxed paper"@en .

aat:300189226 a skos:Concept ;
    skos:definition "Broadly used for the written works by an individual or a specific group of individuals. For the body of writings of a particular nation, region, period, or language, of a particular form or genre, on a particular subject, or for a particular audience, use \"literature (writings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writings"@en .

aat:300189230 a skos:Concept ;
    skos:definition "The long term or excessive use or misuse of narcotics, alcohol, or other substances. For the state of being physically or psychologically habituated to a substance or practice to such an extent that its cessation causes severe trauma, use \"addiction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "substance abuse"@en .

aat:300189237 a skos:Concept ;
    skos:definition "Excessive use or misuse of drugs, causing physical, emotional, mental, or sensory injury or impairment. For addiction to narcotics or other drugs, use \"drug addiction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drug abuse"@en .

aat:300189245 a skos:Concept ;
    skos:definition "Those who are addicted to narcotics or other drugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drug addicts"@en .

aat:300189254 a skos:Concept ;
    skos:definition "Those who are addicted to alcoholic beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcoholics"@en .

aat:300189306 a skos:Concept ;
    skos:definition "Those whose work is occupational therapy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupational therapists"@en .

aat:300189309 a skos:Concept ;
    skos:definition "Condition manifested by subnormal intellectual functioning that originates during the developmental period. This has multiple potential etiologies, including genetic defects and perinatal insults. Intelligence quotient (IQ) scores are commonly used to determine whether an individual has an intellectual disability. IQ scores between 70 and 79 are in the borderline range; scores below 67 are in the disabled range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intellectual disability"@en .

aat:300189316 a skos:Concept ;
    skos:definition "People awaiting or under medical care and treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patients"@en .

aat:300189318 a skos:Concept ;
    skos:definition "Additional marks added to something to substantiate or supersede the information given by the first marks, as a second watermark on paper, a second hallmark on gold or silver, or a mark added to a coin after issue to denote a change of value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countermarks"@en .

aat:300189323 a skos:Concept ;
    skos:definition "Business of engaging in sexual activity for money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prostitution"@en .

aat:300189325 a skos:Concept ;
    skos:definition "Books containing rules and rubrics for the religious services of the Eastern Church year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typicons"@en .

aat:300189326 a skos:Concept ;
    skos:definition "Affixing one's signature to something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signing"@en .

aat:300189328 a skos:Concept ;
    skos:definition "Affixing the initials of one's name to something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initialing"@en .

aat:300189329 a skos:Concept ;
    skos:definition "Glassware, particularly that dating to the mid- to late 19th century, that was made for ornamental more than for utilitarian purposes and that was made of material that incorporated newly developed techniques for producing colors and surface textures. For the general concept of works made of glass, use \"glassware.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art glass"@en .

aat:300189331 a skos:Concept ;
    skos:definition "Photographic prints made for examination and reference, such as those done before an edition is produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "work prints"@en .

aat:300189333 a skos:Concept ;
    skos:definition "Expressing opinion or choice in a matter by some specific means, such as casting a ballot or raising a hand, among a group of other voters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voting"@en .

aat:300189335 a skos:Concept ;
    skos:definition "Those who vote in a group's elections and on other occasions of decision making, usually citizens of a community or otherwise members of the group. For the general term referring to people qualified and registered to vote, prefer \"electors (general, people by activity),\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voters"@en .

aat:300189477 a skos:Concept ;
    skos:definition "Study of and expertise in wines and wine making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oenology"@en .

aat:300189480 a skos:Concept ;
    skos:definition "Photographic prints made much later than the negative and usually not by the original photographer. For prints made by the original photographer relatively soon after the picture was taken, use \"vintage prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "later prints"@en .

aat:300189526 a skos:Concept ;
    skos:definition "Greek and Latin papyri that fall between the categories of documentary and literary papyri, such as magical texts and letters valued for their literary skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subliterary papyri"@en .

aat:300189528 a skos:Concept ;
    skos:definition "Greek and Latin papyri that contain text concerning aspects of everyday life, such as letters, contracts, and records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary papyri"@en .

aat:300189531 a skos:Concept ;
    skos:definition "Greek and Latin papyri that contain literary works or fragments thereof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary papyri"@en .

aat:300189534 a skos:Concept ;
    skos:definition "The discipline dealing with the translation, interpretation, and care of ancient documents written on papyrus, which is of prime importance in Egyptian, Middle Eastern, and Classical archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papyrology"@en .

aat:300189535 a skos:Concept ;
    skos:definition "Term applied to a group of Frank Lloyd Wright's small, single-family houses constructed during the late 1930s and early 1940s and generally characterized by low cost, natural materials, open planning, and a close relationship between the building and the site and climate. The term was coined by the architect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Usonian houses"@en .

aat:300189544 a skos:Concept ;
    skos:definition "Walkways constructed from wooden boards or planks, usually located in swampy areas or along shores, especially beaches. In extended use it may refer to any pedestrian walkway along beach frontage meant for recreational strolling; may be accompanied by small businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boardwalks"@en .

aat:300189548 a skos:Concept ;
    skos:definition "Horizontal members connecting and supporting the legs of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretchers"@en .

aat:300189557 a skos:Concept ;
    skos:definition "Referring to the sex that normally produces eggs or female germ cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "female"@en .

aat:300189559 a skos:Concept ;
    skos:definition "Referring to the sex that in reproduction normally produces sperm cells or male gametes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "male"@en .

aat:300189561 a skos:Concept ;
    skos:definition "Children in the earliest stage of their lives, before being able to walk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infants"@en .

aat:300189564 a skos:Concept ;
    skos:definition "Stages or time periods in the life cycle of an organism or species, or in the life of a single individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life stages"@en .

aat:300189565 a skos:Concept ;
    skos:definition "Those who are afflicted with illness or disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ill"@en .

aat:300189568 a skos:Concept ;
    skos:definition "Representations of unclothed human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nudes"@en .

aat:300189571 a skos:Concept ;
    skos:definition "People who have little or no money, goods, or other means of support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impoverished people"@en .

aat:300189588 a skos:Concept ;
    skos:definition "The earliest developmental stage of a living being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "childhood"@en .

aat:300189590 a skos:Concept ;
    skos:definition "Stage of early childhood, commonly considered to be the period before being able to walk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infancy"@en .

aat:300189595 a skos:Concept ;
    skos:definition "Transitional stage between childhood and adulthood in the physical and emotional development of a living being; in humans, it extends mainly over the teen years and terminates legally when the official age of majority is reached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adolescence"@en .

aat:300189598 a skos:Concept ;
    skos:definition "Stage at which a living being is fully grown or developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adulthood"@en .

aat:300189599 a skos:Concept ;
    skos:definition "Stage of adult life between young adulthood and old age; in humans, commonly defined as extending from 45 to 65."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle age"@en .

aat:300189603 a skos:Concept ;
    skos:definition "Final stage of the normal life span, now commonly considered to be the years after 65."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "old age"@en .

aat:300189604 a skos:Concept ;
    skos:definition "The individual leaves of a book or manuscript numbered on the recto only. The two sides of the folio are typically numbered using 'r' for recto, meaning the front or righ-hand page, and 'v' for verso, meaning the back or left-hand side. Reference to a folio is distinguished from reference to a \"page\" in that a page is numbered on both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folios"@en .

aat:300189621 a skos:Concept ;
    skos:definition "Use collectively to bring together works of art in which paper is the support, only when terms such as \"drawings\" or \"prints\" are not appropriate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "works on paper"@en .

aat:300189623 a skos:Concept ;
    skos:definition "Physical exercises by which muscular strength is called into play and increased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "athletics"@en .

aat:300189626 a skos:Concept ;
    skos:definition "Concepts that are related to the condition of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health-related concepts"@en .

aat:300189627 a skos:Concept ;
    skos:definition "Concepts related to the physical and mental growth of human beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developmental concepts"@en .

aat:300189628 a skos:Concept ;
    skos:definition "Psychological concepts related to behavior and mental disorders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "behavior and mental disorders"@en .

aat:300189630 a skos:Concept ;
    skos:definition "Prints collected and grouped together, and that are usually related in theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print groupings"@en .

aat:300189634 a skos:Concept ;
    skos:definition "Groups of prints related in theme or technique and usually issued together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suites"@en .

aat:300189645 a skos:Concept ;
    skos:definition "The field of study and practice of designing the specific appearance, integration, and function of cities, towns, and villages. It is an interdisciplinary field that works with many built environment professions, including urban planning, architecture, landscape architecture, and civil engineering. For the field concerned with long-term planning for additions and improvements to the spatial organization and content of urban areas, use “urban planning.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban design"@en .

aat:300189648 a skos:Concept ;
    skos:definition "Single pieces of paper, other than broadsides, used as a support with material written, printed, or drawn on one or both sides. The term is often used to refer to the support as contrasted to the image made on the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheets"@en .

aat:300189655 a skos:Concept ;
    skos:definition "Short allegorical dramatic entertainments performed by masked performers, popular in the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masques"@en .

aat:300189659 a skos:Concept ;
    skos:definition "Composite material made of fiber embedded in a matrix, as in some types of reinforced plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fibrous composite"@en .

aat:300189669 a skos:Concept ;
    skos:definition "State of carrying unborn young within the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pregnancy"@en .

aat:300189671 a skos:Concept ;
    skos:definition "Parabolic, dish-shaped reflectors for receiving primarily television or other video programming via satellite; often found on or near residences; may also be used in non-residential contexts and for some data and voice reception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite home antennas"@en .

aat:300189688 a skos:Concept ;
    skos:definition "Commercial buildings located regionally that combine large warehouse facilities with sales and office spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distribution centers"@en .

aat:300189701 a skos:Concept ;
    skos:definition "The concept that certain contemporary works merge already known art forms to inaugurate a new type. If the resulting art form gains currency and acquires a name, it becomes a new medium and is no longer intermedia. For works that employ several distinct art forms, such as sculpture and music, see \"multimedia works.\" To indicate that works are composed of a variety of materials, see \"mixed media.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermedia"@en .

aat:300189710 a skos:Concept ;
    skos:definition "Refers to those who hold a particular office, post, or place of authority in a hierarchical organization, including civil, governmental, or private administrative contexts. For those holding positions of authority or command in the armed forces, use \"military officers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "officers"@en .

aat:300189713 a skos:Concept ;
    skos:definition "Those who practice pharmacology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharmacologists"@en .

aat:300189719 a skos:Concept ;
    skos:definition "Functions based around business and business activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business-related functions"@en .

aat:300189750 a skos:Concept ;
    skos:definition "Designates local meeting places for members of the Order of Patrons of Husbandry, known as the Grange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granges"@en .

aat:300189755 a skos:Concept ;
    skos:definition "Devices informing users of a building or complex about the location of or directions to individuals, organizations, or services within that building or complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building directories"@en .

aat:300189759 a skos:Concept ;
    skos:definition "Designates the documents created or accumulated and used by a particular individual, organization, or other entity that are kept together within a larger collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fonds"@en .

aat:300189762 a skos:Concept ;
    skos:definition "Individuals who view exhibitions or individual works of art or architecture, television programs, or motion pictures. For those who are present at and observe live events, use \"spectators.\" For groups of spectators or viewers, use \"audiences.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viewers"@en .

aat:300189768 a skos:Concept ;
    skos:definition "Individuals who are present at and observe live events. For those who view exhibitions or individual works of art or architecture, television programs, or motion pictures, use \"viewers.\" For groups of spectators or viewers, use \"audiences.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectators"@en .

aat:300189775 a skos:Concept ;
    skos:definition "Alloy of mercury with another metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amalgam"@en .

aat:300189779 a skos:Concept ;
    skos:definition "Alloy of silver and mercury."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver amalgam"@en .

aat:300189785 a skos:Concept ;
    skos:definition "State of psychological well-being or adequate adjustment to society and the ordinary demands of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mental health"@en .

aat:300189787 a skos:Concept ;
    skos:definition "Those subject to psychiatric disabilities, psychiatric illnesses, emotional disorders, or mental disabilities,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "people with psychiatric illnesses"@en .

aat:300189799 a skos:Concept ;
    skos:definition "State of poor health, of being subject to a disease, disorder, or other malfunctioning of the mind or body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illness"@en .

aat:300189805 a skos:Concept ;
    skos:definition "The physical evidence of an artist's change of mind, apparent when areas of a painting that have been painted over become visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pentimenti"@en .

aat:300189808 a skos:Concept ;
    skos:definition "Representations of humans, animals, or mythical beasts, in any medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figures"@en .

aat:300189814 a skos:Concept ;
    skos:definition "Cases or structures that surround or enclose such items as works of art, mirrors, or documents, serving as support or protection or to call attention, while leaving the items visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frames"@en .

aat:300189839 a skos:Concept ;
    skos:definition "Turbines, typically with three or fewer blades, powered by the wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind turbines"@en .

aat:300189844 a skos:Concept ;
    skos:definition "People who are the subjects of portraits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sitters"@en .

aat:300189863 a skos:Concept ;
    skos:definition "Frames which incorporate architectural features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural frames"@en .

aat:300189864 a skos:Concept ;
    skos:definition "A sharp edge produced by the meeting of two curved or plane surfaces in an angle; as in the edges that are produced by fluting in a column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrises"@en .

aat:300189865 a skos:Concept ;
    skos:definition "Frames designed by artists, usually for specific works they have done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist-designed frames"@en .

aat:300189867 a skos:Concept ;
    skos:definition "Ornate frames, usually gilded, distinguished by curvilinear shapes resembling ears or earlobes; based on a style developed by silversmiths in the Netherlands ca. 1600; may include shapes of masks and marine life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auricular frames"@en .

aat:300189870 a skos:Concept ;
    skos:definition "Frames to which decorative carved moldings may be attached, often made of wood inferior in quality to that of the carved moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back frames"@en .

aat:300189895 a skos:Concept ;
    skos:definition "Frames with carved moldings and decorations of small mirrors and flowers interrupted by plain areas, named after the 18th-century Venetian painter Giovanni Antonio Canaletto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canaletto frames"@en .

aat:300189898 a skos:Concept ;
    skos:definition "Frames with simple lap-jointed back frames and entablature-derived moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassetta frames"@en .

aat:300189914 a skos:Concept ;
    skos:definition "Frames with protrusions, often disc-shaped, from the face at each corner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner-block frames"@en .

aat:300189929 a skos:Concept ;
    skos:definition "Frames with overlapping moldings and corner embellishment, often carved to imitate wood bark, popular in the 19th century and named for American artists Nathaniel Currier and James M. Ives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Currier and Ives frames"@en .

aat:300189932 a skos:Concept ;
    skos:definition "Frames with moldings which have undulating surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch ripple molding frames"@en .

aat:300189948 a skos:Concept ;
    skos:definition "Frames which have a structural, as well as decorative, function, in that they physically support the panels they surround and may serve to connect from two to dozens of panels in a larger structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engaged frames"@en .

aat:300189957 a skos:Concept ;
    skos:definition "Frames having simple flat moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat frames"@en .

aat:300189962 a skos:Concept ;
    skos:definition "Lamps in which the raising of the oil is effected by the pressure of a liquid of greater specific gravity acting through a column of air. Based on an adaptation of Hero's fountain (220 BCE). For lamps employing the bird-fountain principle use \"Cardan lamps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fountain lamps"@en .

aat:300189965 a skos:Concept ;
    skos:definition "Lamps with a ring-shaped reservoir with a burner or burners located in the center of the ring at the same level or below the level of the reservoir and connected to it by two tubes through which fuel is fed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annular lamps"@en .

aat:300189968 a skos:Concept ;
    skos:definition "Sockets of candlesticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nossels"@en .

aat:300189970 a skos:Concept ;
    skos:definition "Kerosene lamps employing a central draft burner and an incandescent mantel. Based on a 1909 patent, they are usually made of metal or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aladdin lamps"@en .

aat:300189973 a skos:Concept ;
    skos:definition "Shades which protect candles from drafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "India shades"@en .

aat:300190048 a skos:Concept ;
    skos:definition "Uniform frames selected by an owner so that all the works of art in the owner's collection might be framed alike. Such frames identified ownership and status and for this reason frequently changed, sometimes every generation, to keep up with fashionable styles and taste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallery frames"@en .

aat:300190057 a skos:Concept ;
    skos:definition "Moldings, often of metal, wood or fabric covered wood that are placed between the frame and painting when the painting has shrunk from the frame or the frame is slightly larger than the painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insets"@en .

aat:300190078 a skos:Concept ;
    skos:definition "A type of Dutch gilded frame with elaborate relieflike decorations in either an Auricular or naturalistic style or both. Named after the 17th-century silversmith Johannes Lutma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lutma frames"@en .

aat:300190096 a skos:Concept ;
    skos:definition "People confined, voluntarily or involuntarily, to an institutional facility. Use \"prisoners\" for those involuntarily confined in prison or kept in custody. Use \"convicts\" for those serving a prison sentence following conviction for a criminal offense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inmates"@en .

aat:300190100 a skos:Concept ;
    skos:definition "People serving a prison sentence following conviction for a criminal offense. For those involuntarily confined in prison or kept in custody, use \"prisoners.\" For those confined to an institutional facility voluntarily or involuntarily, use \"inmates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convicts"@en .

aat:300190105 a skos:Concept ;
    skos:definition "Convicts conditionally released from prison prior to the end of their sentence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parolees"@en .

aat:300190113 a skos:Concept ;
    skos:definition "A channel or groove in wood, stone, or other material that forms half of a joint, or allows something to close against it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbets"@en .

aat:300190116 a skos:Concept ;
    skos:definition "Unembellished areas between the carvings in center and corner frames, which, if gilded, are often more light-reflective than the curved parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reposes"@en .

aat:300190119 a skos:Concept ;
    skos:definition "Frames having their highest moldings on the sight edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverse frames"@en .

aat:300190127 a skos:Concept ;
    skos:definition "Frames which have a continuous ornament design, usually repeated foliage motifs, along the inner part of the molding. Of a type popular in the 17th and 18th centuries and named for the Italian painter Carlo Maratta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maratta frames"@en .

aat:300190136 a skos:Concept ;
    skos:definition "Frames with a profusion of overlapping and intertwining scrolls and volutes, popular during the 16th and 17th centuries and named for Venetian architect and sculptor Jacopo Sansovino."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sansovino frames"@en .

aat:300190143 a skos:Concept ;
    skos:definition "Moldings nearest the framed object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sight edges"@en .

aat:300190161 a skos:Concept ;
    skos:definition "Frames incorporating architectural elements consisting mainly of a pair of columns or pilasters that flank the object, support a frieze and pediment, and rest on a base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabernacle frames"@en .

aat:300190174 a skos:Concept ;
    skos:definition "Circular frames in which the dominant molding consists of a festoon that continues around the full circle, or of an ornamental fillet, often set off by a flat molding or decorative staves on the inside and outside edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tondo frames"@en .

aat:300190185 a skos:Concept ;
    skos:definition "Frames with fluted reed moldings, a trademark of 19th-century painter James Abbott McNeill Whistler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Whistler frames"@en .

aat:300190210 a skos:Concept ;
    skos:definition "The approach to social, cultural, scientific, ecological, or humanistic questions involving an orientation to the world as a single interacting system, and the placing of its interests above those of individual regions or nations. For the similar theory or belief discussed or applied specifically in the context of politics and political science, use \"internationalism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globalism"@en .

aat:300190219 a skos:Concept ;
    skos:definition "Natural sources of water, such as lakes, rivers, and ground water, available for use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water resources"@en .

aat:300190283 a skos:Concept ;
    skos:definition "A paste of wood flour or wood cellulose compounded with a synthetic resin used for filling cavities or seams in wood products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plastic Wood (TM)"@en .

aat:300190309 a skos:Concept ;
    skos:definition "Frames which combine two moldings that were finished separately and joined together. The inner molding is covered with gold leaf and meant to contrast with the outer molding. Of a type popular in the late 18th century and used for prints, maps, and the like. Named after the English painter William Hogarth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hogarth frames"@en .

aat:300190310 a skos:Concept ;
    skos:definition "Frames having moldings of S-shaped profile; especially popular in the mid- to late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ogee frames"@en .

aat:300190340 a skos:Concept ;
    skos:definition "Printing an image so that it extends to the edge of the paper or other printing surface. Distinguished from \"bleeding (trimming)\" which refers to trimming printed material so that portions of the illustration or text are removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleeding"@en .

aat:300190346 a skos:Concept ;
    skos:definition "Aquatint process in which a sugar solution is used to lift the ground, and expose the image areas so the plate can be etched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar-lift"@en .

aat:300190366 a skos:Concept ;
    skos:definition "One-hundredth anniversaries or their observances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centennials"@en .

aat:300190373 a skos:Concept ;
    skos:definition "Persons professing a special secret knowledge concerning ceramics, especially the making of porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcanists"@en .

aat:300190375 a skos:Concept ;
    skos:definition "Glass of a deep red color that is produced by a colloidal gold solution prepared by dissolving gold in aqua regia, sometimes including some tin or silver salts. Gold ruby glass was made by the ancient Egyptians and Romans; the ancient technique was lost until rediscovered in 17th-century Germany. Gold was also thought to be anti-toxic and to protect from poison anyone who drank from it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold ruby glass"@en .

aat:300190396 a skos:Concept ;
    skos:definition "Parts of components of architraves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architrave components"@en .

aat:300190405 a skos:Concept ;
    skos:definition "Prints, primarily 20th-century and later, in which the outline of the image is not one of the traditional shapes, that is, rectangular, circular, or oval."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaped prints"@en .

aat:300190463 a skos:Concept ;
    skos:definition "Art which makes use of the book format or the structure of the book; typically usage is limited to unique sculptural works that take the form of, or incorporate, books but that do not communicate in the ways characteristic of a conventional book, such as being experienced sequentially. For books made or conceived by visual artists, use \"artists' books\" or \"bookworks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book objects"@en .

aat:300190507 a skos:Concept ;
    skos:definition "Small cast metal reliefs, produced as multiples and used for a variety of decorative purposes; usually blank on the reverse; especially common in the Renaissance period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaquettes"@en .

aat:300190531 a skos:Concept ;
    skos:definition "Refers to the process of engraving for printing using copper plates. It was replaced in the early 19th century by the use of more durable plates, generally made of either steel or steel-faced copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper engraving"@en .

aat:300190536 a skos:Concept ;
    skos:definition "Printmaking process of engraving using plates of steel or steel-faced copper; replaced the use of less durable copper plates in the early 19th century. Steel engraving was introduced in 1792 by Jacob Perkins, an American inventor, originally for banknote printing. The process is often distinguished by the use of engraving, etching, and the roulette. For the engraving of steel plates for the production of documents requiring long runs with precise replication, use \"siderography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel engraving"@en .

aat:300190691 a skos:Concept ;
    skos:definition "General term for object parts, including both physical and illusional aspects of works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "object portions"@en .

aat:300190692 a skos:Concept ;
    skos:definition "Surfaces or portions of objects that are opposite to those regarded as fronts or to the most important or useful surfaces. For the adjective describing the location of something at or near the back of something, use \"rear.\" For the parts of seating furniture that supports sitters' backs, use \"backs (furniture components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backs"@en .

aat:300190695 a skos:Concept ;
    skos:definition "Refers to the lowest or deepest parts of objects. For the adjective describing the location of something at or near the bottom of something, use \"bottom (positional attribute).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottoms"@en .

aat:300190699 a skos:Concept ;
    skos:definition "Refers to the narrow surfaces showing the 'thickness' or smallest dimension, as distinguished from the broad surfaces of thin, flat objects. For ornamental areas of distinct pattern, material, color, or shape around the edge or boundary of something, see \"borders (ornament areas).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edges"@en .

aat:300190701 a skos:Concept ;
    skos:definition "The extremities of long, thin objects. For the adjective describing the location of something at or near the end of something, use \"end\" from the Attributes and Properties hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ends"@en .

aat:300190703 a skos:Concept ;
    skos:definition "Surfaces or portions of objects that face forward or are regarded as the most important or useful. For the adjective describing the location of something at or near the front of something, use \"front\" from the Attributes and Properties hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fronts"@en .

aat:300190706 a skos:Concept ;
    skos:definition "Surfaces of objects that are not fronts, backs, tops, or bottoms, but located on lateral ends. For the adjective describing the location of something at or near the side of something, use \"side\" from the Attributes and Properties hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sides"@en .

aat:300190708 a skos:Concept ;
    skos:definition "The outermost layers or areas of objects, such as the portions of the exterior in contact with the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surfaces"@en .

aat:300190710 a skos:Concept ;
    skos:definition "Indicates the highest or loftiest parts of objects. For the adjective describing the location of something at or near the top of something, use \"top\" from the Attributes and Properties hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tops"@en .

aat:300190772 a skos:Concept ;
    skos:definition "Use with reference to a type of ancient pottery lamp first made in northern Italy and later copied in Germany, France, and Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory lamps"@en .

aat:300190780 a skos:Concept ;
    skos:definition "Ancient pottery lamps having a frog in relief on the upper side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frog lamps"@en .

aat:300190784 a skos:Concept ;
    skos:definition "Projections by which an object may be held or supported; may have a small opening for a suspensory strap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lugs"@en .

aat:300190801 a skos:Concept ;
    skos:definition "Lamps of any kind lit in recognition of a vow, prayer, or desire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "votive lamps"@en .

aat:300190806 a skos:Concept ;
    skos:definition "Wax candles of exceptional size, usually fixed in a great candlestick, specially destined for use in liturgies of western churches during the Easter season. The tradition of paschal candles probably dates to the fourth century. A paschal candle is first lit with newly blessed fire during the Easter vigil service; it is traditionally marked with the sign of the cross, an alpha and an omega, and the year. After this service, the candle is lit during liturgical functions until the feasts of the Ascension. The lit paschal candle symbolizes the powers of darkness and death being driven away by the Resurrection of Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paschal candles"@en .

aat:300190811 a skos:Concept ;
    skos:definition "Refers to ancient pottery lamps formed by folding or pinching in the edges of a shallow bowl or plate as soon as it was thrown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocked-hat lamps"@en .

aat:300190936 a skos:Concept ;
    skos:definition "Rooms or areas equipped with several showerheads or shower stalls for use by a number of people at the same time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shower rooms"@en .

aat:300190947 a skos:Concept ;
    skos:definition "Parts or components of aerophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerophone components"@en .

aat:300191003 a skos:Concept ;
    skos:definition "Parts or components of percussion instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion instrument components"@en .

aat:300191055 a skos:Concept ;
    skos:definition "Selective or complete lists of motion pictures, typically by one director, actor, or on a specific subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filmographies"@en .

aat:300191065 a skos:Concept ;
    skos:definition "Poetic or prosaic literary forms derived from medieval narratives of love, legendary or heroic adventures, and chivalry. Extends to narratives about important religious figures, or fantastic or supernatural events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "romances"@en .

aat:300191071 a skos:Concept ;
    skos:definition "The function, act, and process of making a new, amended, improved, or up-to-date version of something, such as data, a document, building plan, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revising"@en .

aat:300191074 a skos:Concept ;
    skos:definition "Texts identifying or explaining, and printed in close proximity to, illustrations or other images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "captions"@en .

aat:300191079 a skos:Concept ;
    skos:definition "Lists of words, names, or phrases explaining or giving the value of conventions or symbols used on a map, chart, or other graphic document."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keys"@en .

aat:300191086 a skos:Concept ;
    skos:definition "Works of art, architecture, and any objects that occupy space, are perceived by the sense of sight, and are created or arranged, rather than naturally occurring. Of special interest are those objects conveying a symbolic or expressive meaning or an aesthetic experience, although visual works are not limited only to such works. Visual works generally exclude the intangible, however, designs for works never constructed may be included. Visual works include pictorial and sculptural works, as well as time-based works such as performance art. They also include utilitarian or ceremonial objects of the type collected or valued by museums, cultures, or individuals. Visual works do not include the performing arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual works"@en .

aat:300191092 a skos:Concept ;
    skos:definition "Divisions of the fingerboard, neck, or belly of a chordophone, indicating the points at which the strings are to be stopped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frets"@en .

aat:300191094 a skos:Concept ;
    skos:definition "Lengths of any material that can produce a musical sound when held stretched and then plucked, bowed, struck, or otherwise excited. Common materials used are gut, silk, wire, nylon, palm fiber, and plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strings"@en .

aat:300191118 a skos:Concept ;
    skos:definition "The quality of having a pH value greater than 7 or of having the properties of an alkali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkalinity"@en .

aat:300191122 a skos:Concept ;
    skos:definition "The cleansing quality or power of a substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detergency"@en .

aat:300191124 a skos:Concept ;
    skos:definition "The state or quality of being composed of or like crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystallinity"@en .

aat:300191126 a skos:Concept ;
    skos:definition "Condition of suffering severely or perishing from malnutrition or hunger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starvation"@en .

aat:300191128 a skos:Concept ;
    skos:definition "Those who have been awarded a bachelor's degree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bachelors"@en .

aat:300191131 a skos:Concept ;
    skos:definition "Designates extensive, flat, open spaces used for military exercises, marching, or riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parade grounds"@en .

aat:300191134 a skos:Concept ;
    skos:definition "Cultural landscapes that are significant in the history of landscape architecture or gardening or that were developed as a result of historic use of natural features; includes shaped areas of land and sometimes structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic landscapes"@en .

aat:300191137 a skos:Concept ;
    skos:definition "Style and culture of native Americans who were living along the Pearl River between Louisiana and Mississippi when Europeans arrived in 1702. Were gradually assimilated into the Houma and Bayogoula tribes in the mid-1700s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acolapissa"@en .

aat:300191139 a skos:Concept ;
    skos:definition "Refers most often to characteristics that suggest how a substance, or sometimes a grouping of items or entities, will respond under certain conditions. Often quantifiable, though often not apparent without analysis or testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "properties"@en .

aat:300191166 a skos:Concept ;
    skos:definition "Hanging oil lamps consisting of a flat metal ring suspended by three chains, the ring having apertures to hold a number (three to six) of light cups or cone-shaped beakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polycandela"@en .

aat:300191173 a skos:Concept ;
    skos:definition "Designates heavy metal wire welded together in a grid pattern and used as reinforcing in concrete slabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "welded wire fabric"@en .

aat:300191218 a skos:Concept ;
    skos:definition "The act of presenting a photosensitive surface to actinic rays or radiant energy, especially light; and the extent of radiant energy received in this context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exposure"@en .

aat:300191224 a skos:Concept ;
    skos:definition "Study and exercise of supernatural and natural powers for benevolent or malevolent ends, encompassing in varying degrees magic, psychic powers, herbalism, divination, and communication with good or evil spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "witchcraft"@en .

aat:300191227 a skos:Concept ;
    skos:definition "Sets composed of playing cards plus other items designed to be used together in games in which the primary activity during a round of play involves the use of the playing cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card games"@en .

aat:300191233 a skos:Concept ;
    skos:definition "Collecting, processing, recycling, and disposing of discarded or excess equipment, products, or material in any form, including solids, oils, chemicals, liquids, and gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waste management"@en .

aat:300191243 a skos:Concept ;
    skos:definition "Recovery and reuse of materials and energy from waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recycling"@en .

aat:300191265 a skos:Concept ;
    skos:definition "Small mesh bags used to dust aquatint plates with powdered rosin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust bags"@en .

aat:300191278 a skos:Concept ;
    skos:definition "Box constructions enabling the artist to control the even distribution of rosin particles onto the aquatint plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust boxes"@en .

aat:300191301 a skos:Concept ;
    skos:definition "Concussion idiophones consisting of two or more objects in the form of sticks, plaques, troughs, or vessels of wood, bone, ivory, shell or other hard sonorous material, sounded by striking together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clappers"@en .

aat:300191303 a skos:Concept ;
    skos:definition "Tongues of metal or wood in various types that are components of open bells which produce the sound by striking the side of the instrument; generally they take the form of a rod, or of a ball or pellet attached to a cord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clappers"@en .

aat:300191314 a skos:Concept ;
    skos:definition "System of lights arranged for decorative purposes, as in store window displays, on Christmas trees, or on bushes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative lighting"@en .

aat:300191318 a skos:Concept ;
    skos:definition "System of lights arranged to define the outline of architectural features, such as doors, windows, or rooflines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outline lighting"@en .

aat:300191321 a skos:Concept ;
    skos:definition "Written orders or promises to pay money that may be transferred from one person to another by delivery, with or without endorsement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negotiable instruments"@en .

aat:300191324 a skos:Concept ;
    skos:definition "Officially circulating media of exchange manufactured from paper; used in Asia from the 8th century and issued in Europe from the 17th century. Typically issued by a bank or public authority as fiat currency circulating as official currency. The bill is exchangeable without time limitation for metallic coins and is backed by its equivalent in precious metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper money"@en .

aat:300191339 a skos:Concept ;
    skos:definition "Written orders drawn on a bank or the Treasury of the United States to pay on demand a specified sum of money to a named person, to his order, or to bearer, out of money on deposit to the credit of the writer; must be endorsed to be transferred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checks"@en .

aat:300191340 a skos:Concept ;
    skos:definition "Short-term, usually three-to-six-month, negotiable instruments that arise from commercial, as opposed to speculative, investment, or real estate, and public or private transactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial paper"@en .

aat:300191341 a skos:Concept ;
    skos:definition "Credit instruments specifying the drawer's intention to pay at the date of maturity; generally applied to drafts and bills of exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acceptances"@en .

aat:300191350 a skos:Concept ;
    skos:definition "Collocates tokens minted due to specific local needs by private parties, companies, or local governments otherwise barred from minting coinage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monetary tokens"@en .

aat:300191352 a skos:Concept ;
    skos:definition "Collocates tokens that provide the right to goods or services but are not redeemable for cash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonmonetary tokens"@en .

aat:300191353 a skos:Concept ;
    skos:definition "Small tokens, of various metals and in various shapes, used as vouchers for members of a Christian denomination who had received confession or otherwise qualified for receiving the Christian sacrament of communion. Examples were found in the Lutheran, Calvinist, and other Christian traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion tokens"@en .

aat:300191354 a skos:Concept ;
    skos:definition "Collocates tokens of fixed value that are redeemable for cash, though often expressed in other terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semi-monetary tokens"@en .

aat:300191355 a skos:Concept ;
    skos:definition "Gaming counters used when playing poker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poker chips"@en .

aat:300191357 a skos:Concept ;
    skos:definition "Designates Roman coins of the 3rd century CE distinguished by a radiate crown on the depiction of the emperor; originally of silver and probably a double denarius, later debased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antoniniani"@en .

aat:300191358 a skos:Concept ;
    skos:definition "Use both for bronze coins of the Roman Republic and for copper coins used during the Roman Empire from the 1st century BCE through the 3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asses"@en .

aat:300191362 a skos:Concept ;
    skos:definition "Refers to certain Hellenistic silver coins, chiefly of Pergamon, minted in the 2nd and 1st centuries BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cistophori"@en .

aat:300191365 a skos:Concept ;
    skos:definition "Slips or sections of paper redeemable for specifically named articles, services, or funds and often attached as a group in book form or incorporated individually within larger printed matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupons"@en .

aat:300191366 a skos:Concept ;
    skos:definition "Silver Catalonian coins, a form of the gros tournois, struck between the late 13th and the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "croats"@en .

aat:300191368 a skos:Concept ;
    skos:definition "Ancient Persian gold coins possibly introduced by Darius I in the late 6th century BCE and in use until the early 4th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darics"@en .

aat:300191371 a skos:Concept ;
    skos:definition "United States gold coins issued between 1849 and 1933 and valued at twenty dollars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double eagles"@en .

aat:300191372 a skos:Concept ;
    skos:definition "Small, silver Greek coins originally equivalent to six obols and issued from the 6th century BCE; usage continued by the Parthians and Sassanians until the 7th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drachmas"@en .

aat:300191374 a skos:Concept ;
    skos:definition "United States gold coins issued between 1795 and 1933 and valued at ten dollars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eagles"@en .

aat:300191389 a skos:Concept ;
    skos:definition "Methods used in the arrangement or placement of lighting devices, for desired effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting techniques"@en .

aat:300191412 a skos:Concept ;
    skos:definition "Illumination from the side, generally used to enhance modeling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side lighting"@en .

aat:300191417 a skos:Concept ;
    skos:definition "Illumination of a subject from directly above; used to produce highlights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top lighting"@en .

aat:300191427 a skos:Concept ;
    skos:definition "Method of distributing light to produce sharply defined shadows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard light"@en .

aat:300191460 a skos:Concept ;
    skos:definition "Luminescence produced when a substance is bombarded with cathode rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathodoluminescence"@en .

aat:300191463 a skos:Concept ;
    skos:definition "The elements or parts of an entity and their interrelations, often with reference to the manner in which they are organized or constructed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structure"@en .

aat:300191464 a skos:Concept ;
    skos:definition "The structure of a material on a minute scale as revealed by a microscope or other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microstructure"@en .

aat:300191469 a skos:Concept ;
    skos:definition "Federally issued United States paper money authorized as legal tender since 1862, originally with dark green ink on the reverse and not backed by gold or silver on deposit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenbacks"@en .

aat:300191473 a skos:Concept ;
    skos:definition "Any of various German, then Central European, silver coins equivalent to groats and gros tournois and introduced in the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groschen"@en .

aat:300191479 a skos:Concept ;
    skos:definition "Silver or cupronickel coins valued at fifty cents and issued since 1794; found predominantly in the United States and Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half dollars"@en .

aat:300191480 a skos:Concept ;
    skos:definition "The first distinctive Australian coins, created by overstriking Pieces of Eight from which the center had been punched out; issued between 1813 and 1829 and valued at 5 shillings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holey dollars"@en .

aat:300191481 a skos:Concept ;
    skos:definition "Inscribed counters or tokens used for reckoning accounts since the 13th century; often copies of contemporary coins; used after the 16th century mostly as souvenir pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jettons"@en .

aat:300191484 a skos:Concept ;
    skos:definition "British silver coins of various denominations given as alms during Maundy Thursday ceremonies; issued since the early Medieval period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maundy money"@en .

aat:300191485 a skos:Concept ;
    skos:definition "Paper money issued as a substitute for standard money by, for example, businesses, military organizations, or local, rather than national, governments; normally in denominations less than the basic monetary unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrip"@en .

aat:300191487 a skos:Concept ;
    skos:definition "Wood blocks cut at a right angle to the grain and used for wood engraving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "end-grain blocks"@en .

aat:300191502 a skos:Concept ;
    skos:definition "Blocks used for printing color woodcuts, being the one block for a given image that carries the most detail and serves as a guide to register the other blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key blocks"@en .

aat:300191518 a skos:Concept ;
    skos:definition "Tickets authorizing free admission, as to events or transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passes"@en .

aat:300191519 a skos:Concept ;
    skos:definition "Silver, nickel, or cupronickel decimal coins, valued at 100 avos, of the Portuguese territory of Macao, in southern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patacas"@en .

aat:300191538 a skos:Concept ;
    skos:definition "General lighting providing uniform, diffuse illumination approaching a shadowless condition acceptable for the filming of motion pictures and television programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base lighting"@en .

aat:300191546 a skos:Concept ;
    skos:definition "Paper money issued by the French revolutionary government between 1789 and 1796."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assignats"@en .

aat:300191590 a skos:Concept ;
    skos:definition "Waste matter discharged from the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excrement"@en .

aat:300191597 a skos:Concept ;
    skos:definition "The ability of a material or object to resist mechanical wear or decay and to last over time. With regard to long-term situations or to nonmechanical properties existing over a long period of time without significant change, prefer \"permanence.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "durability"@en .

aat:300191598 a skos:Concept ;
    skos:definition "The quality of being easily broken, shattered, or damaged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fragility"@en .

aat:300191600 a skos:Concept ;
    skos:definition "Bodily waste discharged through the anus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feces"@en .

aat:300191607 a skos:Concept ;
    skos:definition "Remanence that is being examined or analyzed with regard to archaeological remains. When examined with regard to geologic materials, especially those predating human civilization, prefer \"paleomagnetism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeomagnetism"@en .

aat:300191608 a skos:Concept ;
    skos:definition "The tendency of a material to cause a ray of light to separate, or the degree to which the ray separates, into two unequally refracted, plane-polarized rays of orthogonal polarizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birefringence"@en .

aat:300191611 a skos:Concept ;
    skos:definition "Clear amber liquid (mammals, aquatic species) or grayish semisolid (birds, reptiles) excretion of metabolic waste from vertebrates. In mammals, urine is formed in the kidneys. It is a collection of water-soluble by-products of protein metabolism (urea, creatinine, uric acid, ammonia, etc.) mixed with salts and pigments. Urine has been used in cleaning, dyeing, and tanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urine"@en .

aat:300191613 a skos:Concept ;
    skos:definition "A manifestation of surface tension by which the portion of the surface of a liquid coming in contact with a solid is elevated or depressed, depending on the adhesive or cohesive properties of the liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capillarity"@en .

aat:300191614 a skos:Concept ;
    skos:definition "The emission of light by an atom or molecule that is in an excited state; also, the light so emitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemiluminescence"@en .

aat:300191618 a skos:Concept ;
    skos:definition "The state or quality of being very thin or slender, said for example of fibers or wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fineness"@en .

aat:300191619 a skos:Concept ;
    skos:definition "The earth's magnetic field and associated phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geomagnetism"@en .

aat:300191621 a skos:Concept ;
    skos:definition "Sweet viscous fluid produced by bees from the nectar collected from flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honey"@en .

aat:300191622 a skos:Concept ;
    skos:definition "White or yellowish white fluid secreted by the mammary glands of female mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk"@en .

aat:300191624 a skos:Concept ;
    skos:definition "The state or quality of having a strong affinity for water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrophilicity"@en .

aat:300191625 a skos:Concept ;
    skos:definition "Refers to the state or quality of having little or no affinity for water, especially on the molecular level. To describe materials or articles having surfaces resistant, but not impervious, to water, use \"water-repellent.\" To describe materials or surfaces impervious to water, use 'waterproof' (ALT of \"waterproofing\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrophobicity"@en .

aat:300191630 a skos:Concept ;
    skos:definition "Hardness of a substance measured by an indenter, such as a diamond point, that penetrates microscopic areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microhardness"@en .

aat:300191632 a skos:Concept ;
    skos:definition "In the general sense, describes substances containing carbon compounds, ultimately derived from living organisms. In a more specific sense, with reference to food and other consumer products, produced with no artificial materials, fertilizers, or additives, and, with regard to livestock, in a nonfactory setting with room to move around."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic"@en .

aat:300191633 a skos:Concept ;
    skos:definition "Materials not containing hydrocarbons or their derivatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic"@en .

aat:300191637 a skos:Concept ;
    skos:definition "The presence or manifestation of two opposite or contrasting principles or tendencies, as for example in electric batteries and in magnets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polarity"@en .

aat:300191639 a skos:Concept ;
    skos:definition "The quality or condition of tending to react, especially the tendency of a substance to undergo chemical reactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reactivity"@en .

aat:300191640 a skos:Concept ;
    skos:definition "The magnetic flux that remains in a magnetic circuit after an applied magnetomotive force has been removed. When remanence is examined and analyzed with regard to archaeological or ancient geologic materials, use \"archaeomagnetism\" or \"paleomagnetism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remanent magnetism"@en .

aat:300191642 a skos:Concept ;
    skos:definition "The power or property of resistance, especially the reciprocal of electrical conductivity. The opposition offered by an object to electrical flow; the degree to which something impedes passage through it of a current. In conservation, means of maximizing such resistance are sometimes sought to protect materials; as with highly impermeable resin coatings to steel in order to strengthen electrical resistance to current corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistivity"@en .

aat:300191643 a skos:Concept ;
    skos:definition "The capability of being changed back to a previous status or condition; the quality of being not irrevocably permanent, but of being easily and safely disassembled, for example to correct an error in conservation treatment or to replace worn components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reversibility"@en .

aat:300191644 a skos:Concept ;
    skos:definition "Small, thick, Anglo-Saxon silver coins of the 7th and 8th centuries; predecessors of the penny."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sceattas"@en .

aat:300191645 a skos:Concept ;
    skos:definition "The quality of being composed of or containing a salt or salts; also the concentration of a salt or salts in a solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salinity"@en .

aat:300191646 a skos:Concept ;
    skos:definition "The frequency, intensity, and distribution of earthquakes in a given area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismicity"@en .

aat:300191648 a skos:Concept ;
    skos:definition "Ancient Near Eastern coins, especially from Judea, issued during the 1st and 2nd centuries CE; also silver or cupronickel decimal coins of Israel. For Persian coins of the 6th and 5th centuries BCE, use \"sigloi\"; for coins issued in Sidon and Tyre from the 4th century BCE, prefer \"tetradrachms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shekels"@en .

aat:300191652 a skos:Concept ;
    skos:definition "English silver or cupronickel coins valued at twelve pence and minted from the mid-16th century until 1970."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shillings"@en .

aat:300191653 a skos:Concept ;
    skos:definition "The quality of being not likely to give way, deteriorate, decompose, or otherwise change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stability"@en .

aat:300191654 a skos:Concept ;
    skos:definition "English silver or cupronickel coins valued at six pennies or half of a shilling and issued from the 16th century until 1971."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixpence"@en .

aat:300191658 a skos:Concept ;
    skos:definition "The quality or state of having both viscous and elastic properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viscoelasticity"@en .

aat:300191659 a skos:Concept ;
    skos:definition "The property of a fluid that resists the force tending to cause the fluid to flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viscosity"@en .

aat:300191660 a skos:Concept ;
    skos:definition "Silver alloy coins of France minted in the 18th century primarily for circulation in French colonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sous marqués"@en .

aat:300191661 a skos:Concept ;
    skos:definition "British gold coins originally valued at 20 shillings, one pound sterling, and issued first in 1489; 21-shilling and 30-shilling versions appeared from the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sovereigns"@en .

aat:300191662 a skos:Concept ;
    skos:definition "The quality of a substance of tending to evaporate rapidly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volatility"@en .

aat:300191663 a skos:Concept ;
    skos:definition "Having a surface that resists but is not impervious to water. To describe materials or surfaces impervious to water, use 'waterproof' (ALT of \"waterproofing\"). For the state or quality of having little or no affinity for water, especially on the molecular level, use \"hydrophobicity.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-repellent"@en .

aat:300191664 a skos:Concept ;
    skos:definition "Capable of dissolving in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-soluble"@en .

aat:300191665 a skos:Concept ;
    skos:definition "The quality or state of being conditioned or constructed or fitted so tightly as to be impervious to water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watertightness"@en .

aat:300191666 a skos:Concept ;
    skos:definition "Refers to any of various electrum, gold, or silver coins primarily of the East Greek world in use from the 6th to the late 3rd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staters"@en .

aat:300191667 a skos:Concept ;
    skos:definition "The quality of a dye of being resistant to change on wetting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wetfastness"@en .

aat:300191668 a skos:Concept ;
    skos:definition "Large stone discs with central holes formerly used as money in Yap, a Caroline Island in the western Pacific."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone money"@en .

aat:300191669 a skos:Concept ;
    skos:definition "The quality of being, or the degree to which something is, receptive to moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wettability"@en .

aat:300191670 a skos:Concept ;
    skos:definition "Tokens bearing the name and often location of a business and exchangeable for specific goods or services at particular stores; popular especially in England and the United States since the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "store cards"@en .

aat:300191673 a skos:Concept ;
    skos:definition "Various large silver coins of Central Europe minted from the late 15th to the mid-19th century primarily for trade and commemorative purposes; the origin of \"dollars (coins).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talers"@en .

aat:300191674 a skos:Concept ;
    skos:definition "Stamps required to be affixed to certain products or documents before they change hands to indicate that a tax has been paid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tax stamps"@en .

aat:300191677 a skos:Concept ;
    skos:definition "Small squares of various hard materials used by the ancient Romans possibly for such purposes as reckoning and gaming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tesserae"@en .

aat:300191678 a skos:Concept ;
    skos:definition "United States silver or cupronickel coins valued at three cents and issued during the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-cent pieces"@en .

aat:300191680 a skos:Concept ;
    skos:definition "Use specifically for the United States, silver, dollar coins issued between 1873 and 1878 expressly for use in trade with Asian countries, and generally for other dollar-sized and -valued coins used for economic purposes beyond the national boundaries of the country of origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade dollars"@en .

aat:300191681 a skos:Concept ;
    skos:definition "Stamps with a certain value offered as a premium by retailers to customers, specified quantities of which are exchangeable for various goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trading stamps"@en .

aat:300191682 a skos:Concept ;
    skos:definition "Tokens used to pay a fare on public transportation, toll bridges, or toll roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation tokens"@en .

aat:300191683 a skos:Concept ;
    skos:definition "Small gold coins worth one third of a gold solidus and used in the Roman and Merovingian territories from the late 4th until the 7th or 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tremisses"@en .

aat:300191684 a skos:Concept ;
    skos:definition "Threaded beads made of shells and used as money by North American Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wampum"@en .

aat:300191687 a skos:Concept ;
    skos:definition "Treating sewage in order to remove its objectionable constituents and render it less offensive or dangerous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewage treatment"@en .

aat:300191694 a skos:Concept ;
    skos:definition "The state or quality of substances of being able to mix with other, usually specified, substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miscibility"@en .

aat:300191696 a skos:Concept ;
    skos:definition "Viscous, colorless, somewhat opalescent secretion that is usually slightly alkaline in reaction and which contains water, mucin, protein, salts, and often starch-splitting enzymes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saliva"@en .

aat:300191697 a skos:Concept ;
    skos:definition "Refers to the dried perspiration of sheep that is deposited on the wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suint"@en .

aat:300191700 a skos:Concept ;
    skos:definition "Secretions and excretions of protein fiber, of various compositions, from spiders and various insects. The fiber is used by the animals for cocoons, webs, transportation, nests, to catch or preserve prey, among other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silk"@en .

aat:300191704 a skos:Concept ;
    skos:definition "Webs that are spun by spiders, made of spider silk as interlaced threads of viscous protein fluid that solidify on exposure to air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spider webs"@en .

aat:300191730 a skos:Concept ;
    skos:definition "The white of an egg, which is the clear substance that surrounds the yolk; in the context of art materials, generally refers to whites of bird eggs. The whole egg, yolk, or white may be used sometimes mixed with oil and/or resin. Egg white, or glair, has been used as a medium for illuminated manuscripts. It is also used as a size for attaching gold leaf. For the egg white protein that is used in the food industry and in photographic emulsions, use \"albumen (egg white protein).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg white"@en .

aat:300191733 a skos:Concept ;
    skos:definition "The apparatus used for screen printing, consisting of a fabric screen stretched on a frame hinged to a baseboard of flat wood or other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen printing units"@en .

aat:300191749 a skos:Concept ;
    skos:definition "Use to describe things produced by human action, as opposed to by natural causes, usually those things intended to substitute for their natural counterparts. For things produced by human action but not substituting for natural counterparts, use \"man-made.\" For things produced specifically by synthesis, use \"synthetic.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial"@en .

aat:300191751 a skos:Concept ;
    skos:definition "The quality of existing or functioning for a long, indefinite period of time without significant change. Use especially with regard to situations and to nonmechanical properties of objects or materials, such as resistance of color to fading or resistance of paper to acid deterioration; regarding long-term resistance to mechanical wear, prefer \"durability.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanence"@en .

aat:300191763 a skos:Concept ;
    skos:definition "Characteristics related to the operation of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operational attributes"@en .

aat:300191766 a skos:Concept ;
    skos:definition "Use to describe materials having no stratification or crystalline structure, or, more generally, things having no pattern or structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amorphous"@en .

aat:300191771 a skos:Concept ;
    skos:definition "Parts of an animal or plant body that serve a particular physiological function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organs"@en .

aat:300191774 a skos:Concept ;
    skos:definition "The membraneous sacs of an animal that serves as a receptacle for fluid or gas. Historically sometimes removed from various animals and used by people to store liquid materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bladders"@en .

aat:300191778 a skos:Concept ;
    skos:definition "The bony frameworks or supports of an animal body considered as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeletons"@en .

aat:300191781 a skos:Concept ;
    skos:definition "The parts or components of skeletons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeleton components"@en .

aat:300191790 a skos:Concept ;
    skos:definition "Refers most often to characteristics of individual objects, items, or entities, mostly expressions used to describe the thing. Often readily apparent though not quantifiable by an established standard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attributes"@en .

aat:300191797 a skos:Concept ;
    skos:definition "In vertebrates, the lower part of the alimentary canal extending from the pylorus to the anus. In biology, may also refer to the whole alimentary canal from the mouth downward, especially in invertebrate animals. The intestines are the site of most chemical digestive processes and the place where digested food materials are either absorbed for use by the body or collected into feces for elimination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intestines"@en .

aat:300191799 a skos:Concept ;
    skos:definition "The masses of nerve tissue in the anterior end of organisms, such as in the cranium of humans. The brain integrates sensory information and directs motor responses; in higher vertebrates it is also the center of learning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brains"@en .

aat:300191817 a skos:Concept ;
    skos:definition "Characteristics related to fabrication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabrication attributes"@en .

aat:300191821 a skos:Concept ;
    skos:definition "Use to describe objects or structures when emphasizing that they have been designed by architects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architect-designed"@en .

aat:300191855 a skos:Concept ;
    skos:definition "The bone or bones of the lower jaw in mammals and other vertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandibles"@en .

aat:300191856 a skos:Concept ;
    skos:definition "Bony framework of the head, enclosing the brain and supporting the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skulls"@en .

aat:300191859 a skos:Concept ;
    skos:definition "Small calcareous or siliceous bodies occurring in and serving to stiffen and support the tissues of various invertebrates, particularly mollusks, soft coral, and sponges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spicules"@en .

aat:300191862 a skos:Concept ;
    skos:definition "Activities involved in deliberately conveying knowledge, skills, or social values to others. For the discipline that concerns the entire process of imparting such knowledge or values, use \"education.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educating"@en .

aat:300191879 a skos:Concept ;
    skos:definition "Intensely hard calcareous substance covering the dentin, that is, part or all of the crown of the tooth in mammals. Enamel, when mature, consists predominantly of apatite crystals containing calcium and phosphate. Enamel is the hardest tissue of the body; it is not living and contains no nerves. The thickness and density of enamel vary over the surface of the tooth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental enamel"@en .

aat:300191881 a skos:Concept ;
    skos:definition "Material comprising the primary, bone-like structure of a tooth. Dentin is hard calcareous material, with less porosity and less organic matter than bone. It is generally covered with a protective enamel layer. Layers of dentin cover animal teeth (whale, hippopotamus, boar, etc.) and tusks (ivory, elephant, walrus, etc.)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dentin"@en .

aat:300191893 a skos:Concept ;
    skos:definition "Material comprising or processed from the hard exterior covering of eggs, usually eggs of chickens or other birds. The thin, brittle shell from an egg is primarily composed of keratin and calcite. Eggshell may be decorated and valued intact or as a component of a cup or other object. Eggshell is also used as pigment and in grounds for silver point drawings. For preparation, the shells are washed, crushed and boiled in water with some quicklime. The sequence is repeated until the eggshells form a fine, white powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggshell"@en .

aat:300191908 a skos:Concept ;
    skos:definition "The pearl from freshwater mollusks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freshwater pearl"@en .

aat:300191918 a skos:Concept ;
    skos:definition "Money in the form of coins originating from Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asian coins"@en .

aat:300191925 a skos:Concept ;
    skos:definition "English bronze coins minted after 1971 and valued at 2.4 old pennies or one hundredth of an English pound. Prior to 1971, the pre-decimal penny (1d) was a coin worth 1/240 of a pound sterling, its symbol was \"d,\" from the Roman denarius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pence"@en .

aat:300191932 a skos:Concept ;
    skos:definition "English gold coins valued at 20 shillings or cupronickel coins issued after 1983 valued at 100 new pence; also gold coins of various Middle Eastern countries, such as Egypt, Syria, and Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounds"@en .

aat:300191997 a skos:Concept ;
    skos:definition "Subgroups within a larger cultural or social order that are distinguished from the majority and each other by their national, religious, linguistic, cultural, or sometimes racial background. For groups that are the objects of prejudice or discrimination from the majority, use \"minorities.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnic groups"@en .

aat:300192004 a skos:Concept ;
    skos:definition "Communicating information, particularly of facts or occurrences, to others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "informing"@en .

aat:300192028 a skos:Concept ;
    skos:definition "Advancing someone to a higher level in rank, position, grade or job level, or honor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promoting"@en .

aat:300192061 a skos:Concept ;
    skos:definition "Devices, as rods to which freely rotating pointers are attached, for indicating the direction of the wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weathervanes"@en .

aat:300192069 a skos:Concept ;
    skos:definition "Weathervanes in the form of roosters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weathercocks"@en .

aat:300192073 a skos:Concept ;
    skos:definition "Study of the origin, composition, distribution, and succession of strata or layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stratigraphy"@en .

aat:300192086 a skos:Concept ;
    skos:definition "Use generally for the ability to support, or high capacity for, combustion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flammability"@en .

aat:300192092 a skos:Concept ;
    skos:definition "Use generally for the ability to resist change, such as fading, due to light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lightfastness"@en .

aat:300192097 a skos:Concept ;
    skos:definition "The ratio of the amount of water vapor in the air to the amount which would be present at the same temperature were the atmosphere to be fully saturated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relative humidity"@en .

aat:300192156 a skos:Concept ;
    skos:definition "Designated periods of the year that have religious origins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious seasons"@en .

aat:300192157 a skos:Concept ;
    skos:definition "Christian religious season lasting from the fourth Sunday before Christmas until Christmas, observed by some as a period of prayer and fasting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Advent"@en .

aat:300192160 a skos:Concept ;
    skos:definition "Books containing mainly prayers for use in celebrating the mass in the Western Church; by the 13th century, generally folded into the missal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacramentaries"@en .

aat:300192162 a skos:Concept ;
    skos:definition "Balls at which those attending wear costumes departing from currently conventional style and usually representing fictional or historical characters, animals, particular occupations, or the fancy of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy dress balls"@en .

aat:300192167 a skos:Concept ;
    skos:definition "Culture, period, and styles in the British colonies, typically featuring a combination of British and native characteristics. For works produced in the British colonies of what is now the United States, \"American Colonial\" is generally used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Colonial"@en .

aat:300192174 a skos:Concept ;
    skos:definition "Affecting the actions, behavior, opinions, or work of others, possibly unconsciously. For the effect produced by someone or their work upon the creative thought or work of others, see \"influence.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "influencing"@en .

aat:300192176 a skos:Concept ;
    skos:definition "General term used to collocate terms for all paper currency of European origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European paper money"@en .

aat:300192177 a skos:Concept ;
    skos:definition "General term used to collocate terms for all paper currency of North American origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North American paper money"@en .

aat:300192234 a skos:Concept ;
    skos:definition "The process of receiving and interpreting sensory impressions attained by sight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual perception"@en .

aat:300192315 a skos:Concept ;
    skos:definition "People of long experience in some activity; with specific reference to military personnel, those who have served in war or who have retired from membership in the armed forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterans"@en .

aat:300192337 a skos:Concept ;
    skos:definition "Styles originating in or expressing ideals supported by the post-World War I review \"Zenit,\" which supported a strong ideology promising a brighter future, a new man, and a new society expressed in free artistic forms and Expressionism, including free verse and new typographic and graphic forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zenitist"@en .

aat:300192339 a skos:Concept ;
    skos:definition "Groups of objects, images, or data elements arranged in a specified order. For photographs taken in chronological order to record motion or change, use \"chronophotographs\" or \"motion photographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sequences"@en .

aat:300192345 a skos:Concept ;
    skos:definition "Works, particularly artistic or written works, produced relatively late in the maker's career."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "late works"@en .

aat:300192350 a skos:Concept ;
    skos:definition "Works, particularly artistic or written works, produced relatively early in the maker's career."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "early works"@en .

aat:300192547 a skos:Concept ;
    skos:definition "Greeting cards given at the time of the new year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Year cards"@en .

aat:300192556 a skos:Concept ;
    skos:definition "Display and study spaces providing artists, especially new, emerging artists, the opportunity to exhibit their works outside the traditional gallery and museum context. These are usually small-scale, independent areas administered by artists for the exhibition of work that is often experimental and outside mainstream art movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alternative spaces"@en .

aat:300192586 a skos:Concept ;
    skos:definition "The making of holes through an object; may be done purposefully, either when the object is made or later, or may be the result of natural processes. Having a hole, as a result of the drilling process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perforating"@en .

aat:300192630 a skos:Concept ;
    skos:definition "General term for types of groups of people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groups of people"@en .

aat:300192637 a skos:Concept ;
    skos:definition "General functions and processes that occur in agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural functions"@en .

aat:300192646 a skos:Concept ;
    skos:definition "Cards issued singly or in sets since the 19th century, primarily to be collected, bearing a wide variety of types of images, such as sports figures, movie stars, or flowers. If cards include advertising, use also \"advertising cards\"; if cards accompany a product, use also \"premiums.\" For cards bearing tradesmen's advertisements, and sometimes a variety of images, produced from the 17th through the 19th century, use also \"trade cards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collecting cards"@en .

aat:300192649 a skos:Concept ;
    skos:definition "Secret organizations resisting authority, especially in occupied countries; most applicable to the underground movement to resist the Axis forces during World War II."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistance movements"@en .

aat:300192655 a skos:Concept ;
    skos:definition "Refers to the style predominantly of sculpture that first appeared in an art exhibition in 1966. Named by critic Lucy Lippard, the style is characterized by a rejection of Minimalist formalism, with an emphasis on experimental form and the use of soft materials such as rubber, vinyl, plastic and polyester resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eccentric Abstraction"@en .

aat:300192656 a skos:Concept ;
    skos:definition "Describes a variety of processed animal hides or skins, though generally of a ray fish. Distinguished either by the rough, granular texture on the grain side of the leather or a similar pattern; frequently dyed green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shagreen"@en .

aat:300192670 a skos:Concept ;
    skos:definition "Tablets made for writing, usually of wood or bone, covered with wax which was written on with a stylus; used especially in ancient Rome and during the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wax tablets"@en .

aat:300192681 a skos:Concept ;
    skos:definition "The property by which a material is able to take up a liquid or a gas by capillary, osmotic, solvent, chemical, or other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absorbency"@en .

aat:300192703 a skos:Concept ;
    skos:definition "Postcards that have on one side an image produced with light-sensitive materials directly on the card."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic postcards"@en .

aat:300192708 a skos:Concept ;
    skos:definition "Refers to the rationalist model of the ideal building type based on the construction of the hypothetical first dwelling and its use of materials in response to function and climate; used as a basis for various architectural theories since the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primitive hut"@en .

aat:300192718 a skos:Concept ;
    skos:definition "Publications which exist and function as an alternative to those publications sanctioned by the establishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alternative publications"@en .

aat:300192731 a skos:Concept ;
    skos:definition "Designates cumbersome, heavy, bronze Roman cast coins, generally of the 3rd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aes grave"@en .

aat:300192760 a skos:Concept ;
    skos:definition "Membrane structures that act as roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rooflike enclosing structures"@en .

aat:300192793 a skos:Concept ;
    skos:definition "Groups of spectators, listeners, or viewers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiences"@en .

aat:300192795 a skos:Concept ;
    skos:definition "People who depart from their native or usual country or region to live elsewhere. For those who come into a country or region from another to settle there, use \"immigrants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emigrants"@en .

aat:300192799 a skos:Concept ;
    skos:definition "The use of physical force so as to kill, injure, damage, or abuse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violence"@en .

aat:300192800 a skos:Concept ;
    skos:definition "Public officers who examine publications, motion pictures, correspondence, or other forms of public or private communication for the purpose of suppressing any material in them deemed objectionable on moral, political, military, or other grounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "censors"@en .

aat:300192802 a skos:Concept ;
    skos:definition "Action, practice, or system of the operation of a farm, including the cultivation of the soil to produce crops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farming"@en .

aat:300192803 a skos:Concept ;
    skos:definition "An element with symbol P and atomic number 15."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphorus"@en .

aat:300192807 a skos:Concept ;
    skos:definition "People who advocate or practice socialism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socialists"@en .

aat:300192819 a skos:Concept ;
    skos:definition "Mounting or fastening with a hinge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinging"@en .

aat:300192821 a skos:Concept ;
    skos:definition "Refers to images cast on a surface or in space by optical means, generally by placing an object between a light source and the surface or a designated point in space. They include images created with slides or film, digital images or other computer files, or shadows cast from opaque objects; projections on surfaces may be cast from the front or the rear of the surface. They also include holograms cast onto a point in space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projections"@en .

aat:300192825 a skos:Concept ;
    skos:definition "Texts by artists, often brief, that state, for example, explanations of the artists' work or theoretical concepts on which their work is based."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' statements"@en .

aat:300192832 a skos:Concept ;
    skos:definition "Localized lighting technique designed to emphasize a particular object or area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accent lighting"@en .

aat:300192836 a skos:Concept ;
    skos:definition "A low-molecular-weight adhesive made from a solution of degraded or denatured collagen in water. The protein content in animal glue is less pure and darker in color than gelatin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal glue"@en .

aat:300192841 a skos:Concept ;
    skos:definition "Clearly defined geographical units, administrative cells, quarters or districts of traditional Islamic towns, each district characterized by a community related in religion, occupation, or ethnic or socio-cultural or tribal background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahallas"@en .

aat:300192850 a skos:Concept ;
    skos:definition "Supplementary lighting to reduce, soften, or eliminate shadows caused by the main source of illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fill light"@en .

aat:300192854 a skos:Concept ;
    skos:definition "Use to designate the apparent principal source of illumination of a subject or area, especially in relation to photography and film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key light"@en .

aat:300192871 a skos:Concept ;
    skos:definition "Gold coins in use in the Roman world from the time of Caesar to that of Constantine, but primarily from the later Roman Republic through the middle years of the Roman Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aurei"@en .

aat:300192883 a skos:Concept ;
    skos:definition "Denotes flexible, lightweight, faced or unfaced thermal or acoustical insulation formed in long continuous rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanket insulation"@en .

aat:300192896 a skos:Concept ;
    skos:definition "Prints made using the process of offset lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset lithographs"@en .

aat:300192900 a skos:Concept ;
    skos:definition "Printing method in which an image is created by lithographic technique, using the disaffinity of greasy and watery substances, and is then transferred from the stone or plate to an intermediary, such as a rubber blanket, and then offset onto the final surface. If this transfer process is used but the original image is other than lithographic, use the more general term \"offset printing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offset lithography"@en .

aat:300192906 a skos:Concept ;
    skos:definition "Denotes Chinese base-metal cast coins with a square hole in the center issued from the 7th to the 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cash"@en .

aat:300192907 a skos:Concept ;
    skos:definition "Impressing an image into a surface using a tool that is cut intaglio with a complete design, resulting in a relief image. In bookbinding, distinguished from \"blind blocking\" in which a machine is used instead of a hand tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind stamping"@en .

aat:300192914 a skos:Concept ;
    skos:definition "Proofs designated for the printer who produces an edition of prints, occasionally marked P.P. Sometimes the same as the bon a tirer proof for the edition. Printers' proofs are generally identical to impressions of the regular edition except for annotations identifying them as a proof. They can also be used as galley or page proofs on which printers and typographers can make queries and corrections for the client or artist to check, mark, and return; for this use such proofs are usually stamped \"MASTER PROOF\" or \"MARKED SET.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printers' proofs"@en .

aat:300192933 a skos:Concept ;
    skos:definition "Irregularly shaped and uneven gold or silver coins struck in various parts of the Spanish Empire between the 16th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobs"@en .

aat:300192945 a skos:Concept ;
    skos:definition "The calcium-binding protein in bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "osteocalcin"@en .

aat:300192948 a skos:Concept ;
    skos:definition "The fibrous, extracellular matrix protein in skin, muscles, tendons, ligaments, and bone. Collagen is composed of repeating units of glycine-proline-hydroxyproline that form linear polypeptide chains; three chains are then twisted and interlocked with hydrogen bonding to form a rigid helix structure. Collagen-containing materials, such as hides, bones and fish, have been used to make animal glues since ancient times. Collagen will irreversibly hydrolyze, or denature, in hot water, forming a water-soluble gelatin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collagen"@en .

aat:300192949 a skos:Concept ;
    skos:definition "Animal material, such as skin and tendon, that contains collagen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collagenous material"@en .

aat:300192952 a skos:Concept ;
    skos:definition "In the context of materials, material comprising a tendon taken out of an animal body and used for some purpose, especially as a cord or thread, as a string in a musical instrument, or for another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sinew"@en .

aat:300192955 a skos:Concept ;
    skos:definition "Part of hide or skin consisting of fibrous connective tissue. The layer of hide or skin from which leather is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corium"@en .

aat:300192961 a skos:Concept ;
    skos:definition "Insoluble, white, fibrous protein comprising the filaments of raw silk, secreted along with sericin by the insect. Unlike wool, silk is composed mainly of non-sulfur containing amino acids. The primary amino acids, glycine, alanine and serine, are contained in dense, highly crystalline regions of the fiber. The amorphous regions are composed of tryosine, tryptophane, histidine and phenylalanine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fibroin"@en .

aat:300192962 a skos:Concept ;
    skos:definition "Animal material that contains fibrin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fibroinous material"@en .

aat:300192965 a skos:Concept ;
    skos:definition "Silk fibers produced by any of several species of larvae of the genus Antheraea, primarily found in China and India. The filaments of tussah silk are coarser and stronger than silk fibers from cultivated silk worms. It is rarely weighted. Wild silk is brownish and more difficult to bleach, so it is usually dyed in dark colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tussah silk"@en .

aat:300192973 a skos:Concept ;
    skos:definition "Animal material that contains keratin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keratinous material"@en .

aat:300192974 a skos:Concept ;
    skos:definition "A horny keratinous material derived from the mouth of whales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baleen"@en .

aat:300192976 a skos:Concept ;
    skos:definition "Colorless, tough, protective natural substance composed of a nitrogen containing polysaccharide. Chitin is the principal component in seashells as well as the exoskeletons of crabs, lobsters, insects, and beetles. It is also found in the cell walls of some fungi, algae, and yeasts. Chitin is inelastic, thus growing arthropods must shed their exoskeletons periodically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chitin"@en .

aat:300192984 a skos:Concept ;
    skos:definition "The coat of wool that covers a sheep or similar animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fleece"@en .

aat:300192989 a skos:Concept ;
    skos:definition "Long, lustrous hair of the Angora goat, valued for its strength and excellent spinning qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mohair"@en .

aat:300192990 a skos:Concept ;
    skos:definition "Fine, soft, light wool from the undercoat of the Kashmir goat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cashmere"@en .

aat:300192998 a skos:Concept ;
    skos:definition "Soft, dense, light-brown wooly undercoat of the musk ox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qiviut"@en .

aat:300193002 a skos:Concept ;
    skos:definition "The inner deep or center part of a structure, such as of a hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medulla"@en .

aat:300193013 a skos:Concept ;
    skos:definition "Aerophones in which an air stream is directed against a reed, setting the reed in periodic vibration that interrupts the stream intermittently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reeds"@en .

aat:300193015 a skos:Concept ;
    skos:definition "Containers designed to serve as receptacles for a liquid or other substance, usually those of circular section and made of some durable material; especially containers of this nature in domestic use, employed in connection with the preparation or serving of food or drink, and usually of a size suitable for carrying by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vessels"@en .

aat:300193133 a skos:Concept ;
    skos:definition "Widely circulated small, silver French coins introduced in the mid-8th century; appear in debased form until the French Revolution. For comparable English coins, also derived from Roman denarii, use \"pennies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deniers"@en .

aat:300193147 a skos:Concept ;
    skos:definition "Tools used in printmaking for engraving metal plates or end-grain wood blocks, consisting of a small steel rod, of square or lozenge section, with a sharpened point, and having a half-round wood handle that fits in the palm of the hand. In the context of archaeology, a specialized flake or blade with a chisel edge; used to carve or engrave softer materials such as bone, wood, or antler. For various tools for chasing or engraving metal or wood, use \"gravers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burins"@en .

aat:300193162 a skos:Concept ;
    skos:definition "Artists' brushes made of hog, pig, or boar bristle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bristle brushes"@en .

aat:300193169 a skos:Concept ;
    skos:definition "Artists' brushes made of any flexible animal hair, such as red sable or squirrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair brushes"@en .

aat:300193182 a skos:Concept ;
    skos:definition "Devices used to project an image of an opaque object, such as a drawing or other graphic material, onto a flat surface for tracing or viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opaque projectors"@en .

aat:300193187 a skos:Concept ;
    skos:definition "Tools with thin, very flexible, tapered and sometimes diamond-shaped blades, used for applying paint, especially impasto, and for scraping paintings in progress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting knives"@en .

aat:300193195 a skos:Concept ;
    skos:definition "Artists' implements having a flattened surface of various forms and made of various materials; used by painters and other artists, particularly as used to mix, spread, or transfer ink or paint, or for other purposes. For spatulas comprising blades of flexible metal used in creating art, usage overlaps with \"palette knives (painting equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist's spatulas"@en .

aat:300193227 a skos:Concept ;
    skos:definition "Various coins that have cent values and denominations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cent pieces"@en .

aat:300193233 a skos:Concept ;
    skos:definition "Western World coins with dollar values."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollar coins"@en .

aat:300193234 a skos:Concept ;
    skos:definition "Coins originating from Oceania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oceanic coins"@en .

aat:300193242 a skos:Concept ;
    skos:definition "Events for relaxation and rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leisure events"@en .

aat:300193246 a skos:Concept ;
    skos:definition "Heavy silver Byzantine coins worth six scruples, one twelfth of a gold solidus, and issued from the early 7th to the early 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hexagrams"@en .

aat:300193254 a skos:Concept ;
    skos:definition "English coins valued at one half of a penny, introduced in silver in the 9th century and later issued in bronze or copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halfpennies"@en .

aat:300193259 a skos:Concept ;
    skos:definition "Small silver coins of Germany and German-speaking territories issued from at least the 13th century until the 19th century in Germany and then as a copper coin in Austria into the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hellers"@en .

aat:300193270 a skos:Concept ;
    skos:definition "Refers to the culture, style, and movement of Mexican Americans in the United States, particularly as beginning in the 19th century, characterized by artistic and political discussions addressing social issues relevant to Mexican and Chicano communities. The movement is driven by a rediscovery of Pre-Columbian indigenous styles, the development of mural painting, and by cultural studies focussed on bi-culturalism and ethnic heritage and identity. The movement also reveals strong regionalist elements, promoting vernacular forms and techniques to expound traditional and contemporary iconography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mexican American"@en .

aat:300193283 a skos:Concept ;
    skos:definition "English silver coins originally worth four pennies and issued between the 13th and 17th centuries, and occasionally later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groats"@en .

aat:300193287 a skos:Concept ;
    skos:definition "Animal material that has been preserved or has undergone a specialized treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processed animal material"@en .

aat:300193289 a skos:Concept ;
    skos:definition "Processed intestine used, for example, for making strings for musical instruments and tennis rackets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gut"@en .

aat:300193293 a skos:Concept ;
    skos:definition "Untanned skin or hide which has had the flesh and hair removed and allowed to dry into a desired shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rawhide"@en .

aat:300193298 a skos:Concept ;
    skos:definition "Works of the visual arts that are designed for specific locations, especially those that exploit or incorporate aspects of their sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site-specific works"@en .

aat:300193342 a skos:Concept ;
    skos:definition "Refers to the spaces on coins, tokens, or medals below the central design, often set off from it by a horizontal line and often containing the date; usually occurring on the reverse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exergues"@en .

aat:300193344 a skos:Concept ;
    skos:definition "Material comprising the hollow, sharp spines of a porcupine, echidna, or hedgehog. Used in Native American ornamental embroidery and other decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quill"@en .

aat:300193354 a skos:Concept ;
    skos:definition "Old style English coins, originally of silver, name derived from Roman denarii; issued from the late 8th to the 17th century; then of copper or bronze from the 18th century until 1967, when they were replaced by a new decimal bronze penny. For equivalent French silver coins introduced in the 8th century, use \"deniers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pennies"@en .

aat:300193359 a skos:Concept ;
    skos:definition "Strong, rigid leather used for durable items such as powder flasks, pots, or armor, made by tanning skin in a hot tanning solution and molding, pressing, or stamping it to shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuir bouilli"@en .

aat:300193361 a skos:Concept ;
    skos:definition "Leather tanned without removing the hair from the skins or hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair-on leather"@en .

aat:300193362 a skos:Concept ;
    skos:definition "Cattle- or horse-hide leather, one side of which is covered with a flexible waterproof film having a lustrous and highly glazed surface produced by successive coats of daub, varnish, and lacquer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patent leather"@en .

aat:300193368 a skos:Concept ;
    skos:definition "Leather finished by buffing on an emery wheel, usually on the flesh side to produce a napped surface. Distinct from \"rough calf\" which is always finished on the flesh side and not polished with an emery wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suede"@en .

aat:300193371 a skos:Concept ;
    skos:definition "Material comprising the hide or skin of an animal, usually a mammal, with the hair or wool left on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pelt"@en .

aat:300193374 a skos:Concept ;
    skos:definition "The skin of a sheep, with or without wool left on, prepared for any of various uses such as in garments, as leather or as parchment. The leather made from sheepskin is soft with little grain, and is not particularly durable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheepskin"@en .

aat:300193382 a skos:Concept ;
    skos:definition "Use only for gold coins struck in Venice from the late 13th through the 19th century and for similar Austrian and Czechoslovakian coins issued in the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ducats"@en .

aat:300193393 a skos:Concept ;
    skos:definition "Paper money made legal tender by government decree but that is not based on nor convertible into coin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiat money"@en .

aat:300193398 a skos:Concept ;
    skos:definition "Minor coins of the United States and certain other former British territories, generally composed of 25% nickel and 75% copper in the United States, and valued at one twentieth of a dollar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "five-cent pieces"@en .

aat:300193415 a skos:Concept ;
    skos:definition "Coins or paper money in denominations less than the basic monetary unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fractional currency"@en .

aat:300193448 a skos:Concept ;
    skos:definition "Thin silver coins issued by Constantine in the 320s, used until the late 4th century, and reintroduced during the Byzantine period between about 700 and the early 11th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miliarensia"@en .

aat:300193455 a skos:Concept ;
    skos:definition "Paper money issued as legal tender by specified national banks; also, certain paper currency of the United States issued between 1863 and 1935."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national bank notes"@en .

aat:300193457 a skos:Concept ;
    skos:definition "Emergency coins or paper money issued by authorities of a besieged town and thus cut off from the standard money supply."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siege pieces"@en .

aat:300193466 a skos:Concept ;
    skos:definition "Currency issued either during or immediately after a war by a country that is occupying another, usually produced in the language and denomination of the subject people; essentially a 20th-century phenomenon, particularly during the two world wars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupation currency"@en .

aat:300193496 a skos:Concept ;
    skos:definition "Coins struck more than once in place on planchets with special polished or matte surfaces, from specially prepared polished dies, and usually for presentation or for sale to collectors and not intended for circulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proof coins"@en .

aat:300193508 a skos:Concept ;
    skos:definition "Former United States paper money issued by the federal government for general circulation between 1865 and 1933 equal to and redeemable for gold at a stated value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold certificates"@en .

aat:300193514 a skos:Concept ;
    skos:definition "United States paper money issued between 1878 and 1963 in several denominations from 1 dollar to 1000 dollars, equal to and redeemable for silver at the stated value, replaced by Federal Reserve notes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver certificates"@en .

aat:300193518 a skos:Concept ;
    skos:definition "Wobbly, saucer-shaped coins; struck during the Byzantine period, especially in the 11th through the 13th centuries, and in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scyphate coins"@en .

aat:300193528 a skos:Concept ;
    skos:definition "Silver coins of ancient Persia equal to one twentieth of a daric and struck from about 515 to 331 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sigloi"@en .

aat:300193553 a skos:Concept ;
    skos:definition "Byzantine gold coins used between the 10th and 12th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetartera"@en .

aat:300193566 a skos:Concept ;
    skos:definition "Ancient Greek silver coins worth three drachmas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tridrachms"@en .

aat:300193569 a skos:Concept ;
    skos:definition "Refers to the dominant, usually central, images on either side of coins, medals, or tokens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "types"@en .

aat:300193573 a skos:Concept ;
    skos:definition "Coinlike objects made of wood, originally produced as emergency money then only for commemorative, souvenir, or advertising purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wooden money"@en .

aat:300193635 a skos:Concept ;
    skos:definition "British copper, bronze, or tin coins equal to one fourth of a British penny; introduced in the 13th century and withdrawn in 1961."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farthings"@en .

aat:300193636 a skos:Concept ;
    skos:definition "Ground or area on which patterns or other designs or images are located, as on rugs or flags; the ground of each division of armorial flags and shields on which the charges are placed; and the blank areas on either the obverse or reverse of coins, tokens, or medals not occupied by the central design or the legends or inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fields"@en .

aat:300193638 a skos:Concept ;
    skos:definition "English gold coins issued between 1663 and 1813 and valued at 20 or 21 shillings or 4 crowns; replaced by sovereigns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guineas"@en .

aat:300193641 a skos:Concept ;
    skos:definition "Emergency coinage of various denominations issued in 1689 and 1690 in Ireland by supporters of James II of England and made from any available brass or brasslike objects, including cannon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun money"@en .

aat:300193642 a skos:Concept ;
    skos:definition "Oval Japanese gold coins of various values issued from the 16th to the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kobans"@en .

aat:300193645 a skos:Concept ;
    skos:definition "Aluminum-bronze coins of the Soviet Union valued at one hundredth of a ruble and Russian silver or copper coins issued since 1534."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kopecks"@en .

aat:300193650 a skos:Concept ;
    skos:definition "Machine-struck gold coins of France issued in the reign of Louis XIII and subsequently till the time of Louis XVI, from 1640 to the mid-1790s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louis d'or"@en .

aat:300193651 a skos:Concept ;
    skos:definition "English gold coins introduced in the mid-1340s by Edward III and issued until the mid-15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nobles"@en .

aat:300193652 a skos:Concept ;
    skos:definition "Large, oval, Japanese gold coins used primarily for court transactions and issued with various values between the later 16th century and the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obans"@en .

aat:300193656 a skos:Concept ;
    skos:definition "Money issued under abnormal financial conditions, such as wartime or economic panic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency currency"@en .

aat:300193667 a skos:Concept ;
    skos:definition "Rugs of any design made by commission on royal or court looms, such as Moghul, Ottoman, or Safavid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court carpets"@en .

aat:300193683 a skos:Concept ;
    skos:definition "A natural fibrous protein that is the primary building block for epidermal tissue. Keratin contains all of the common amino acids, but has higher amounts of cystine than other fibrous structural proteins. Soft keratins are found in the external layers of skin, wool, hair, feathers, while hard keratins are the major components of tortoise shells, nails, hoofs, scales, bills, and claws. In addition to usage in their natural form, since the mid-1600s keratin has been molded into buttons, combs, and buckles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keratin"@en .

aat:300193690 a skos:Concept ;
    skos:definition "Rugs having a field divided into stripes, each ornamented with a pattern usually seen in borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "border-patterned rugs"@en .

aat:300193695 a skos:Concept ;
    skos:definition "A Persian term for a small rug measuring approximately 3 by 2 feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pushti"@en .

aat:300193696 a skos:Concept ;
    skos:definition "Persian rugs measuring approximately 5 by 7.5 feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sezar"@en .

aat:300193702 a skos:Concept ;
    skos:definition "Small pieces of carpeting with adhesive backing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpet tiles"@en .

aat:300193715 a skos:Concept ;
    skos:definition "Floor coverings handwoven in or around the city of Kayseri in central Turkey. The best-known rugs from this district are those produced in the 20th century, largely for sale to tourists and undiscriminating collectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kayseri"@en .

aat:300193756 a skos:Concept ;
    skos:definition "Carpeting that can be used either indoors, or outdoors where it will be exposed to weather conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor-outdoor carpets"@en .

aat:300193769 a skos:Concept ;
    skos:definition "Scandanavian closely tufted, handwoven rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flossas"@en .

aat:300193771 a skos:Concept ;
    skos:definition "Late-19th-century ingrain carpets which were woven in one piece, with border and fringe. They could be used as crumbcloths, and were easy to move and clean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art squares"@en .

aat:300193779 a skos:Concept ;
    skos:definition "Brussels carpets that are heavy and multiframed, with all of the colored worsted pattern yarns carried along with the body or structure of the carpet, to be picked up into the pattern as the design requires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body Brussels"@en .

aat:300193782 a skos:Concept ;
    skos:definition "Branch of aeronautics which includes the design, production, and operation of aircraft, particularly heavier-than-air aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aviation"@en .

aat:300193786 a skos:Concept ;
    skos:definition "A coarse variegated marble, quarried on the island of Proconnesus, present-day Marmara Adasi, Turkey, that is either gray, white, or white with gray stripes. Large quantities of this marble were imported to Greece to be carved into sarcophagi. Also called Cyzican marble because it was used extensively in Cyzicus, present-day Belkis, as it was in Constantinople as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proconnesian marble"@en .

aat:300193790 a skos:Concept ;
    skos:definition "Periods of time devoted to rest, relaxation, or recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacations"@en .

aat:300193794 a skos:Concept ;
    skos:definition "Tufted carpets with relatively few tufts per inch, of exceptionally long pile which falls at random in all directions to form the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shag carpets"@en .

aat:300193795 a skos:Concept ;
    skos:definition "Heavy knitted mats with a shaggy pile of short strips of fabric that are inserted as the knitting progresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluff mats"@en .

aat:300193796 a skos:Concept ;
    skos:definition "Generally, a period before a war. Specifically refers to a period or activity before the American Civil War (1861-1865)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antebellum"@en .

aat:300193856 a skos:Concept ;
    skos:definition "Diagonal lines formed in textiles by the meeting points of successive rows of discontinuous wefts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lazy lines"@en .

aat:300193857 a skos:Concept ;
    skos:definition "Unintentional variations in the color of a rug caused by irregular dyeing of the yarn, or by using yarn from a different dye lot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrash"@en .

aat:300193867 a skos:Concept ;
    skos:definition "Styles and cultures located in the highlands of Anatolia, the Caucasus, and the Armenian and Iranian highlands. Distinguished from the Middle East, which is sometimes known as \"Western Asia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Asian"@en .

aat:300193868 a skos:Concept ;
    skos:definition "Refers to the culture and styles of the Turks, who comprise various ethnic groups that historically lived a nomadic life on the vast Eurasian steppe and spoke Turkic languages, or Turkey, which is a nation in Asia Minor and southeastern Europe, having coastlines on the Aegean, Black, and Mediterranean seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkish"@en .

aat:300193871 a skos:Concept ;
    skos:definition "Built works erected at or near border crossings where persons or vehicles are halted for examination and clearance by government officials. Posts at international boundaries used for the regulation of movement of people and goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "border inspection stations"@en .

aat:300193895 a skos:Concept ;
    skos:definition "Trade name for small semi-antique west Anatolian rugs, often with a light ground and distinctive elaborate double-niche design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kis-Ghiordes"@en .

aat:300193926 a skos:Concept ;
    skos:definition "Large, fiddle-shaped, early form of the hurdy-gurdy, developed in 12th-century Europe, played set horizontally across two players' laps, one operating the tangents while the other turned the crank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organistrums"@en .

aat:300193935 a skos:Concept ;
    skos:definition "Instruments whose sound is produced essentially by the vibration of thin lamellae or tongues of metal, wood, or other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamellaphones"@en .

aat:300193942 a skos:Concept ;
    skos:definition "Rattles in which objects slide up and down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding rattles"@en .

aat:300193948 a skos:Concept ;
    skos:definition "Circulating paper money of the United States issued by Federal Reserve banks since 1914."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Federal Reserve notes"@en .

aat:300193949 a skos:Concept ;
    skos:definition "Silver or cupronickel British coins valued at two shillings sixpence; phased out of use after 1971."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half crowns"@en .

aat:300193951 a skos:Concept ;
    skos:definition "Postage stamps authorizing the delivery of mail by air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airmail stamps"@en .

aat:300193957 a skos:Concept ;
    skos:definition "General term used for stamps that are grouped, such as in panes or sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamp groupings"@en .

aat:300193959 a skos:Concept ;
    skos:definition "Refers to the group of stamps located in one corner of a pane that contains the plate number printed on the margin; may include as few as four stamps arranged two by two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate number blocks"@en .

aat:300193960 a skos:Concept ;
    skos:definition "Designates stamps that are affixed to mail at post offices when prepayment of postage is insufficient and that indicate the amount owed from the addressee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postage due stamps"@en .

aat:300193961 a skos:Concept ;
    skos:definition "Adhesive postage stamps already canceled in advance of mailing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precancels"@en .

aat:300193962 a skos:Concept ;
    skos:definition "Postage stamps with special designs, having a value indicating an extra fee in addition to regular postage, and affixed to mail to ensure special, usually speedier, delivery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special delivery stamps"@en .

aat:300193967 a skos:Concept ;
    skos:definition "Stamps used for the payment of charges on telegrams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telegraph stamps"@en .

aat:300193968 a skos:Concept ;
    skos:definition "Written, negotiable instruments that contain orders for payment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orders to pay"@en .

aat:300193969 a skos:Concept ;
    skos:definition "Written, negotiable documents that contain promises of payment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promises to pay"@en .

aat:300193970 a skos:Concept ;
    skos:definition "Unconditional written promises to pay on demand, or at a fixed or determined future time, a certain sum of money to, or to the order of, a specified person or to the bearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promissory notes"@en .

aat:300193971 a skos:Concept ;
    skos:definition "Negotiable documents other than paper money that are supported by coin reserves and provide evidence of current or long-term debt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credit instruments"@en .

aat:300193972 a skos:Concept ;
    skos:definition "Historically a form of paper currency used in Europe from the late Medieval to the early Modern period often as credit among merchants. Now refers to written orders to pay a specific sum of money on demand or at a specified future time; used with reference to foreign transactions; for similar orders to pay usually restricted to domestic transactions, use \"drafts (negotiable instruments).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bills of exchange"@en .

aat:300193974 a skos:Concept ;
    skos:definition "Checks that certify that the signature of the drawer is genuine and that the depositor has sufficient funds on deposit for payment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certified checks"@en .

aat:300193975 a skos:Concept ;
    skos:definition "Credit instruments ordering the payment of a specified amount of money, usually issued and payable at a bank or post office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "money orders"@en .

aat:300193976 a skos:Concept ;
    skos:definition "Interest-bearing certificates of public or private debt, usually offered in series, constituting promises to pay the lender a certain amount of money at a fixed future date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonds"@en .

aat:300193977 a skos:Concept ;
    skos:definition "Systems of posted signs arranged to communicate directions or essential information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signage"@en .

aat:300193990 a skos:Concept ;
    skos:definition "Divisions of the process of producing printed matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printed matter production stages"@en .

aat:300193993 a skos:Concept ;
    skos:definition "Public notices or paid announcements, especially those in print. For announcements paid for by an advertiser and broadcast on radio or television, use \"commercials.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertisements"@en .

aat:300193994 a skos:Concept ;
    skos:definition "Objects bearing special or distinctive marks and worn for decoration or to signify affiliation. Originally, badges were heraldic symbols worn as identifying marks by a knight and his retainers, e.g., a badge of arms. In later use, the term refers to any distinctive device, emblem, or mark worn to indicate a person's affiliation, rank, office, name, or membership in an organization or support for a cause, particularly objects that comprise small pieces of metal, card, plastic, etc., that bear a distinguishing design or words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badges"@en .

aat:300193997 a skos:Concept ;
    skos:definition "Plans prepared for or by printers to show the arrangement of the matter, type faces, sizes of type, and positions of illustrations and captions for pieces of printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "layouts"@en .

aat:300193998 a skos:Concept ;
    skos:definition "Printed headings on stationery, especially business stationery, and usually giving the name and address of the business or institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterheads"@en .

aat:300193999 a skos:Concept ;
    skos:definition "Refers to photographs or prints suitable for hanging on a wall and showing a glamorous or attractive person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinups"@en .

aat:300194009 a skos:Concept ;
    skos:definition "Drums having tubular shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubular drums"@en .

aat:300194015 a skos:Concept ;
    skos:definition "Afro-Cuban drums, generally single-headed and with nail tension, approximately cylindrical or barrel-shaped and open at the bottom; they are played with two drumsticks. For the snared double-headed cylindrical drums of the Yoruba people of Nigeria, see \"bembes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bembés"@en .

aat:300194022 a skos:Concept ;
    skos:definition "Harps with no forepillar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open harps"@en .

aat:300194023 a skos:Concept ;
    skos:definition "European harps composed of three sections: resonator, neck, and pillar. The pillar, by taking the tension of the strings, allows these harps to withstand far greater string tension than open harps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame harps"@en .

aat:300194036 a skos:Concept ;
    skos:definition "Style and culture of a subdivision of the Tlingit Indian people in Alaska, on the coast between Cape Fox and Yakutat Bay, known for blankets and other cultural works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chilkat"@en .

aat:300194090 a skos:Concept ;
    skos:definition "Idiophones made to vibrate by friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friction idiophones"@en .

aat:300194104 a skos:Concept ;
    skos:definition "Notched sticks, usually of bore or wood, sounded by scraping with another stick or other nonsonorous object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scraped sticks"@en .

aat:300194116 a skos:Concept ;
    skos:definition "Books containing accounts of such events as festivals, parades, or ceremonial entries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festival books"@en .

aat:300194188 a skos:Concept ;
    skos:definition "A number of different coins minted by countries formerly ruled by Spain; for trade coins of dollar size valued at eight reales and issued by Spain and Spanish America between about 1500 and 1900, use \"Pieces of Eight.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pesos"@en .

aat:300194194 a skos:Concept ;
    skos:definition "Sheets of stamps or large portions of sheets as issued for sale by a postal service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panes"@en .

aat:300194204 a skos:Concept ;
    skos:definition "Percussion membranophones having one or two drumheads stretched over a shallow frame or hoop, the depth of the shell being less than the radius of the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame drums"@en .

aat:300194214 a skos:Concept ;
    skos:definition "Musical instruments that incorporate electronic circuitry as an integral part of the sound-generating system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic instruments"@en .

aat:300194222 a skos:Concept ;
    skos:definition "Individual sides of a leaf, recto or verso; the individual sides of leaves resulting from folding a sheet, as of paper or parchment, whether blank or containing writing, printing, or other matter. Distinguished from a \"folio\" in that a folio is numbered on only the front side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pages"@en .

aat:300194225 a skos:Concept ;
    skos:definition "Parts or components of bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binding components"@en .

aat:300194226 a skos:Concept ;
    skos:definition "Groups of folded leaves suitable for arranging or arranged and fastened together to form a book. A gathering is each unit of folded leaves in sequential order comprising a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gatherings"@en .

aat:300194232 a skos:Concept ;
    skos:definition "Musical instruments that produce sound by means of rotating tone-wheels which themselves produce no acoustic sound but create a regular fluctuation in an electrical circuit which can be converted into an audio signal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electromechanical instruments"@en .

aat:300194246 a skos:Concept ;
    skos:definition "Musical instruments which produce audible sounds by acoustic methods and incorporate built-in microphones or pickups which amplify the vibrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroacoustic instruments"@en .

aat:300194262 a skos:Concept ;
    skos:definition "Subject area encompassing the history and contemporary social, political, and cultural situation of women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "women's studies"@en .

aat:300194293 a skos:Concept ;
    skos:definition "Style and culture of the Arabatchi tribe. Typical of the style are rugs characterized by a dark brown field, a part cotton weft and alternate warps which cause the back of the rugs to have a brown and white, speckled appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabatchi"@en .

aat:300194301 a skos:Concept ;
    skos:definition "Conventionalized pictures or symbols that stand for an idea or thing, and not precisely the thing pictured; often not corresponding to one particular word in the language written. Examples are Chinese characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ideograms"@en .

aat:300194303 a skos:Concept ;
    skos:definition "Writing signs that correspond to individual syllables of a spoken language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syllabic signs"@en .

aat:300194307 a skos:Concept ;
    skos:definition "Refers to the written or printed characters that denote units in a numerical sequence. For the abstract units belonging to a mathematical system and subject to specified laws of succession, addition, and other functions, use \"numbers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numerals"@en .

aat:300194308 a skos:Concept ;
    skos:definition "Symbols used first in the ancient Roman system of numerical notation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman numerals"@en .

aat:300194309 a skos:Concept ;
    skos:definition "The symbols 0, 1, 2, and so forth, derived from Arabic numerical notation in the late Middle Ages in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabic numerals"@en .

aat:300194334 a skos:Concept ;
    skos:definition "Groups or collections of bells that are used together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sets of bells"@en .

aat:300194341 a skos:Concept ;
    skos:definition "Photomechanical prints produced by the process called heliotype."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliotypes"@en .

aat:300194345 a skos:Concept ;
    skos:definition "A modified version of collotype in which the alum-hardened gelatin layer is transferred from glass to the metal plate; allows for the making of many more prints than ordinary collotype."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliotype"@en .

aat:300194347 a skos:Concept ;
    skos:definition "Genre of poetry employing words but designed also to have a visual impact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual poetry"@en .

aat:300194352 a skos:Concept ;
    skos:definition "Genre of pre-20th century poetry, in which letters, words, or lines are arranged on the page to form a shape or image, usually related to the meaning of the words. For works of poetry from the 20th century on, particularly of the concrete poetry movement of the 1950s and 1960s, in which language elements are freely arranged, not necessarily in linear syntax, and meaning is derived from the spatial, pictorial, and typographic characteristics of the work, as well as from the sense of the words, use \"concrete poetry.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern poetry"@en .

aat:300194361 a skos:Concept ;
    skos:definition "Refers to a series of intertwined or chained pools channeling falling water down stepped inclines; often elaborately sculpted, especially as found in Italian, 16th-century formal gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water chains"@en .

aat:300194372 a skos:Concept ;
    skos:definition "Life-size paintings of figures, usually people, occasionally animals, on thin panel cut out to give a lifelike effect; popular in the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dummy board figures"@en .

aat:300194373 a skos:Concept ;
    skos:definition "System of writing or printing for the use of the visually impaired in which combinations of dots or points are used to represent characters and are read by touch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braille"@en .

aat:300194389 a skos:Concept ;
    skos:definition "Sets of printed characters, comprised of alphabets, numerals, and other symbols, that share certain characteristics of style or design. For the rectangular pieces, usually metal, having a character on one side, from which text is composed and set to be printed, use \"type.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typefaces"@en .

aat:300194390 a skos:Concept ;
    skos:definition "Initials containing scenes or figures germane to the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historiated initials"@en .

aat:300194407 a skos:Concept ;
    skos:definition "Shortened forms of words, names, or phrases that are not words themselves but stand for the original; often created by the omission of letters or the replacement of several letters by a symbol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbreviations"@en .

aat:300194411 a skos:Concept ;
    skos:definition "A script developed in South Italy in the 8th century and in use until the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beneventan minuscule"@en .

aat:300194424 a skos:Concept ;
    skos:definition "A book hand characterized by rounded majuscules, developed from the older Roman cursive; used especially in Greek and Latin manuscripts of the 4th to the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncial"@en .

aat:300194430 a skos:Concept ;
    skos:definition "A book hand derived from later Roman cursive and used from the 5th to the 7th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half uncial"@en .

aat:300194434 a skos:Concept ;
    skos:definition "An angular Arabic script; it is a formal type of Arabic calligraphy used decoratively on buildings, textiles, pottery and other things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kufic"@en .

aat:300194439 a skos:Concept ;
    skos:definition "Matter or material rejected as useless and fit only to be thrown away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refuse"@en .

aat:300194441 a skos:Concept ;
    skos:definition "Animal or vegetable refuse from the shipping, processing, or preparation of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garbage"@en .

aat:300194443 a skos:Concept ;
    skos:definition "Used up, worn out, or broken things that are not garbage or ash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubbish"@en .

aat:300194448 a skos:Concept ;
    skos:definition "Scripts some of whose letters have ascenders or descenders above or below a general base line and top line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minuscule"@en .

aat:300194451 a skos:Concept ;
    skos:definition "Alphabetic scripts whose letters are confined between head and base lines with no ascenders or descenders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "majuscule"@en .

aat:300194460 a skos:Concept ;
    skos:definition "Typefaces that slant upward to the right rather than being erect, often having cursive features derived from humanistic cursive script. Most often designed to accompany a roman typeface but sometimes independent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "italic"@en .

aat:300194486 a skos:Concept ;
    skos:definition "Script used by the Minoan population of Crete in the period 2000 to 1500 BCE, not yet deciphered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linear A"@en .

aat:300194490 a skos:Concept ;
    skos:definition "Script used by the Mycenaeans after about 1500 or 1450 BCE, apparently recording an early form of the Greek language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linear B"@en .

aat:300194498 a skos:Concept ;
    skos:definition "Containers made of twigs, rushes, thin strips of wood, or other flexible material woven together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baskets"@en .

aat:300194500 a skos:Concept ;
    skos:definition "Ceremonial containers associated with or used in the rituals of public worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical containers"@en .

aat:300194509 a skos:Concept ;
    skos:definition "Containers or receptacles of leather, cloth, paper, or other flexible material, often capable of being closed at the mouth. For ladies' bags intended to carry personal articles, use \"bags (costume accessories).\" For large containers of cloth or plastic for carrying, transporting, or storing produce and other items, use \"sacks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bags"@en .

aat:300194514 a skos:Concept ;
    skos:definition "Cylindrical containers, usually wooden, with slightly bulging sides made of staves hooped together, and with flat, parallel ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrels"@en .

aat:300194515 a skos:Concept ;
    skos:definition "Barrel-shaped containers, especially those stronger and larger than barrels, made of staves, headings, and hoops usually closely fitted together so as to hold liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casks"@en .

aat:300194516 a skos:Concept ;
    skos:definition "Barrel-shaped containers used to hold liquids, up to 30 gallons, having a taphole on top and a bunghole in the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kegs"@en .

aat:300194517 a skos:Concept ;
    skos:definition "Boxes, usually cylindrical, of pasteboard or thin wood for holding light articles of attire such as ruffs, collars, and hats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandboxes"@en .

aat:300194527 a skos:Concept ;
    skos:definition "Large or strong containers used especially for transporting goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crates"@en .

aat:300194529 a skos:Concept ;
    skos:definition "Boxes used for depositing voting ballots. May also be utilized to draw lots, in which case small objects are drawn from it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballot boxes"@en .

aat:300194541 a skos:Concept ;
    skos:definition "Large containers used for holding or storing liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vats"@en .

aat:300194553 a skos:Concept ;
    skos:definition "Small or moderate size bags for carrying small articles, often having drawstrings, a flap, or closure hardware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pouches"@en .

aat:300194567 a skos:Concept ;
    skos:definition "Vessels used for drinking liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking vessels"@en .

aat:300194572 a skos:Concept ;
    skos:definition "Coins of the ancient Western world from the 6th century BCE until the financial restructuring undertaken by the Franks and Arabs in the 7th and 8th centuries CE; includes Greece, Rome, and the Near East through the Sassanians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Western World coins"@en .

aat:300194573 a skos:Concept ;
    skos:definition "Coins of the early Medieval through the modern period in the Western world, from the 7th or 8th century to the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Later Western World coins"@en .

aat:300194584 a skos:Concept ;
    skos:definition "Testing to determine the components of a material, as in the percentage of pure metal in a specimen of ore, bullion, or alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assaying"@en .

aat:300194586 a skos:Concept ;
    skos:definition "Early Roman copper coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "as coins"@en .

aat:300194590 a skos:Concept ;
    skos:definition "An alloy of silver mixed with an equal or greater amount of a base metal, usually copper. Alloy of gold or silver with a majority admixture of base metal, often copper or tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billon"@en .

aat:300194594 a skos:Concept ;
    skos:definition "Semifinished items prepared to be made into something else by further operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanks"@en .

aat:300194600 a skos:Concept ;
    skos:definition "Gold or silver considered in mass rather than in value, often in ingot or bar form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullion"@en .

aat:300194603 a skos:Concept ;
    skos:definition "Defacements made by authorities for the primary purpose of preventing reuse of postage stamps; for official marks bearing information about the time and place that a postal system accepted custody of a piece of mail, use \"postmarks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cancellations"@en .

aat:300194607 a skos:Concept ;
    skos:definition "Receipts from a bank certifying that a specified sum of money has been received for deposit, often for a specified length of time and at specified rates of interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates of deposit"@en .

aat:300194628 a skos:Concept ;
    skos:definition "Refers to marks or characters punched or stamped into previously made coins. They were often applied by a Chinese assayer to silver trade dollars and other precious metal coins as an indication that the coins had met his test for purity and weight. They were widely used between 1750 and 1920."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chop marks"@en .

aat:300194663 a skos:Concept ;
    skos:definition "Trimming or cutting away the edges of gold or silver coins in order to pilfer some of the precious metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clipping"@en .

aat:300194671 a skos:Concept ;
    skos:definition "Written orders drawn by one party ordering a second party to pay a specified sum of money to a third party (who may be the first party); usually restricted to domestic transactions. For similar orders to pay used for foreign transactions, prefer \"bills of exchange.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafts"@en .

aat:300194685 a skos:Concept ;
    skos:definition "Alloy of copper, nickel, iron, and manganese in which copper is dominant. Cupronickel is the metal of choice for contemporary coins, and is also used for condenser plates and heat exchangers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupronickel"@en .

aat:300194694 a skos:Concept ;
    skos:definition "General term for types of Ancient Greek and Roman coins in drachma denominations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drachma coins"@en .

aat:300194696 a skos:Concept ;
    skos:definition "Stamps, usually engraved, used for impressing a design upon a softer material, as in coining money, medals, and printing banknotes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dies"@en .

aat:300194731 a skos:Concept ;
    skos:definition "Containers, usually of metal, especially silver, that are hollow, such as drinking, serving, and display vessels, and that have significant depth, as distinguished from flatware and cutlery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollowware"@en .

aat:300194749 a skos:Concept ;
    skos:definition "Utilitarian or ornamental containers intended primarily for growing plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flowerpots"@en .

aat:300194762 a skos:Concept ;
    skos:definition "Ecclesiastical drinking vessels for eucharistic wine having a stem, often with a central knop, and a foot; often made of precious metals and usually accompanied by a paten. Use \"communion cups\" when referring to similar but generally less ornate ecclesiastical drinking vessels used in the Protestant Church during or after the Reformation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalices"@en .

aat:300194765 a skos:Concept ;
    skos:definition "Vessels, generally of ceramic, glass, metal, or plastic, that have a wide mouth with a broad lip and usually a handle at one side, but sometimes having two ears; includes those accompanied by a washbowl and used for personal hygiene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitchers"@en .

aat:300194779 a skos:Concept ;
    skos:definition "Individual written signs that correspond to separate speech sounds or to syllables in a spoken language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonetic signs"@en .

aat:300194782 a skos:Concept ;
    skos:definition "Methods of handwriting that use simplified strokes, abbreviations, or symbols to facilitate rapid writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shorthand"@en .

aat:300194822 a skos:Concept ;
    skos:definition "Tightly woven and relatively deep baskets seldom made larger than 2-quart size; most are a quart or less in capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berry baskets"@en .

aat:300194836 a skos:Concept ;
    skos:definition "Rectangular baskets with one side woven higher than the other and from which they were hung on a loom post to hold unused bobbins for the loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loom baskets"@en .

aat:300194850 a skos:Concept ;
    skos:definition "Lidded baskets, flat on one side and bulging on the other, intended primarily for holding fish, lobster, tackle, or the like; used especially with reference to those worn on the back or suspended from the shoulder by anglers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creels"@en .

aat:300194856 a skos:Concept ;
    skos:definition "Baskets, often coiled baskets, in which dough is set to rise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough baskets"@en .

aat:300194877 a skos:Concept ;
    skos:definition "Baskets having a cover which does not come off but which is slotted to slide up on a rigid handle; of a type intended primarily for holding feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feather baskets"@en .

aat:300194880 a skos:Concept ;
    skos:definition "Open baskets with upcurving sides to which is attached a large handle; of a type intended primarily for gathering flowers or herbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower baskets"@en .

aat:300194894 a skos:Concept ;
    skos:definition "Tall ovoid or egg-shaped baskets, often without handles; of a type traditionally used for holding geese while plucking their feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goose baskets"@en .

aat:300194897 a skos:Concept ;
    skos:definition "Baskets or basketlike containers intended primarily for carrying laundry; often oval or rectangular and generally with a pair of handles at the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundry baskets"@en .

aat:300194907 a skos:Concept ;
    skos:definition "Term generally applied to a variety of oval or rectangular open baskets with a single handle, intended primarily for taking products to the market or purchases home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market baskets"@en .

aat:300194913 a skos:Concept ;
    skos:definition "Baskets intended primarily for holding sewing notions; generally small, round, and usually with a cover. May have a cloth liner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing baskets"@en .

aat:300194928 a skos:Concept ;
    skos:definition "Baskets of varying form used to transport goods on animals or humans; includes those with one flattened side made to conform to the contour of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pack baskets"@en .

aat:300194938 a skos:Concept ;
    skos:definition "Covered baskets, usually with an ovoid mouth and rigid handle, intended primarily for transporting live pigeons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigeon baskets"@en .

aat:300194942 a skos:Concept ;
    skos:definition "Openwork, splint baskets used for making cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese baskets"@en .

aat:300194981 a skos:Concept ;
    skos:definition "Large, footed baskets, of a type thought to be used for the cleansing of raw wool prior to spinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wool-rinsing baskets"@en .

aat:300195087 a skos:Concept ;
    skos:definition "Aquatic recreation facilities with attractions based on fast-moving, rather than static, water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterparks"@en .

aat:300195111 a skos:Concept ;
    skos:definition "Techniques and process of covering the surface of pottery, ceramics, or a similar material with a vitreous substance, which is fixed by fusion, usually by heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery glazing"@en .

aat:300195119 a skos:Concept ;
    skos:definition "Use collectively for the parts of a book that follow the main text, including, for example, appendices, notes, or indexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back matter"@en .

aat:300195125 a skos:Concept ;
    skos:definition "Unprinted leaves in books, often placed at each end of a book by the printer or the binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blank leaves"@en .

aat:300195133 a skos:Concept ;
    skos:definition "Detachable, flexible coverings for books, usually of paper cut flush with the covers, folding around the binding with the ends tucked in between the cover boards and the free end paper. For attached outer sheets or boards, use \"covers (gathered matter components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book jackets"@en .

aat:300195146 a skos:Concept ;
    skos:definition "Bindings designed so that the book could be chained to a fixed feature such as a shelf or desk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chained bindings"@en .

aat:300195149 a skos:Concept ;
    skos:definition "Ornamental inside linings of book covers, sometimes leather, which take the place of the regular flyleaves or pastedowns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doublures"@en .

aat:300195150 a skos:Concept ;
    skos:definition "Refers to the leaf of a book's endleaves that is not pasted to the cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flyleaves"@en .

aat:300195160 a skos:Concept ;
    skos:definition "Graphic components of such items as pages, posters, signs, and other graphically designed surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "layout features"@en .

aat:300195161 a skos:Concept ;
    skos:definition "Areas on pages of printed or written matter, or on other sheets of text or images, between the information area and the outer edges of the page or sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "margins"@en .

aat:300195162 a skos:Concept ;
    skos:definition "Refers to the adjoining inner margins of two facing pages of type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gutters"@en .

aat:300195163 a skos:Concept ;
    skos:definition "Functional or ornamental bands of flexible material sewn or adhered to the back of a book's text block at head and tail, projecting slightly above and below the text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headbands"@en .

aat:300195168 a skos:Concept ;
    skos:definition "Words, phrases, sentences, single characters, sequences of characters, or other distinguishing names appearing on or in an item, naming the work for purposes of identification and reference. Examples are descriptive headings in books or legal documents. For titles as a general concept, particularly when assigned to a work, including works of art, but not necessarily appearing on it, prefer \"titles (general, names).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titles"@en .

aat:300195169 a skos:Concept ;
    skos:definition "Reeds in the form of a stretched band or ribbon, stretched taut between two points, against which an air stream is directed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon reeds"@en .

aat:300195173 a skos:Concept ;
    skos:definition "Headings in newspapers indicating subject matter and set in larger type than that of the copy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headlines"@en .

aat:300195174 a skos:Concept ;
    skos:definition "Use collectively for the parts of a book that precede the main text, including, for example, title pages, prefaces, or tables of contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preliminaries"@en .

aat:300195178 a skos:Concept ;
    skos:definition "Bindings decorated with a sovereign's arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal bindings"@en .

aat:300195187 a skos:Concept ;
    skos:definition "In written or printed works, a list of the work's parts in sequence, usually with a page number or other symbol indicating where each part begins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables of contents"@en .

aat:300195190 a skos:Concept ;
    skos:definition "Those parts of a book consisting of the stack of leaves or gatherings to be bound, exclusive of the materials, such as endpapers or boards, that are added in binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "text blocks"@en .

aat:300195195 a skos:Concept ;
    skos:definition "An Arabic cursive script from which modern Arabic writing descends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naskhī"@en .

aat:300195198 a skos:Concept ;
    skos:definition "Arabic cursive script first used in the 7th-8th century CE. Highly decorative, it is generally used for inscriptions and mosque decorations, as opposed to Korans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thuluth"@en .

aat:300195207 a skos:Concept ;
    skos:definition "A script of great clarity, used in both books and documents, that combined characteristics of cursive and half-uncial; developed in Carolingian centers in the late 8th century and then predominant throughout Europe until the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caroline minuscule"@en .

aat:300195214 a skos:Concept ;
    skos:definition "Flutes in which the air stream is directed through a narrow duct against the sharp edge of a lateral aperture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duct flutes"@en .

aat:300195226 a skos:Concept ;
    skos:definition "A group of scripts, including book hands and documentary scripts, and formal and cursive styles, predominant in Europe from the late 12th to the 16th century, and in some areas still later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic scripts"@en .

aat:300195234 a skos:Concept ;
    skos:definition "Multiple-necked plucked lutelike chordophones of Africa and Cuba, having from two to eight bowed necks of wood projecting from the back of the resonator, from each of which a string is stretched tautly to the front of the resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pluriarcs"@en .

aat:300195264 a skos:Concept ;
    skos:definition "Coffeepots in which boiling water rising through a tube is repeatedly deflected downward through a perforated basket containing ground beans to extract their essence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percolators"@en .

aat:300195273 a skos:Concept ;
    skos:definition "Earthenware vessels, with or without a cover, of cylindrical shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crocks"@en .

aat:300195275 a skos:Concept ;
    skos:definition "Covered vessels for boiling water, usually having a short pouring spout, a bail handle, and a broad, flat bottom. Often used with but different from a teapot, in which the tea leaves are brewed or steeped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teakettles"@en .

aat:300195279 a skos:Concept ;
    skos:definition "Teakettles made en suite with a stand which has a heating device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teakettles-on-stands"@en .

aat:300195311 a skos:Concept ;
    skos:definition "Wide, low containers originally made of wooden staves held together by hoops and sometimes having a lid or wire handles or both. Also, similar containers made of metal or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubs"@en .

aat:300195322 a skos:Concept ;
    skos:definition "Cylindrical or rectangular containers usually of lightweight metal, plastic, or laminated pasteboard used for holding dry products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canisters"@en .

aat:300195328 a skos:Concept ;
    skos:definition "Airtight or nearly airtight, box-like containers, of metal, wood, or plastic; used for storing bread and other baked goods to keep them fresh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread boxes"@en .

aat:300195341 a skos:Concept ;
    skos:definition "Bottles used for sprinkling scented water, spice, or pounce; often provided with devices which enable them to be suspended from chains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casting bottles"@en .

aat:300195347 a skos:Concept ;
    skos:definition "Deep, wide-mouthed vessels used for holding a variety of substances, usually without handles and generally cylindrical, although sometimes made in other shapes. For narrower-necked vessels, use \"bottles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jars"@en .

aat:300195349 a skos:Concept ;
    skos:definition "Vessels, commonly of metal, for boiling water or other liquids over a fire or other source of heat; includes covered metal vessels with a spout, used to boil water for domestic purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kettles"@en .

aat:300195356 a skos:Concept ;
    skos:definition "Instruments which produce sound when the main component turns rapidly on its axis, creating an air stream which is interrupted periodically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whirling aerophones"@en .

aat:300195357 a skos:Concept ;
    skos:definition "European zitherlike chordophones consisting of a heavy gut string attached at each end to a long wooden pole and passing over an inflated pig's bladder which serves as a resonator. They are sounded with a notched stick or horsehair bow, to provide a droning accompaniment to folksong or dance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bumbasses"@en .

aat:300195368 a skos:Concept ;
    skos:definition "Concussion idiophones made of hollowed-out objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concussion vessels"@en .

aat:300195371 a skos:Concept ;
    skos:definition "Instruments sounded by being struck either with a nonsonorous body, such as a stick or hand, or against a nonsonorous object, such as the human body or the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion idiophones"@en .

aat:300195372 a skos:Concept ;
    skos:definition "Idiophones consisting of sonorous sticks, used individually or in sets, sounded by being struck against a hard object or another stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion sticks"@en .

aat:300195373 a skos:Concept ;
    skos:definition "Idiophones composed of plaques of hard material, usually stone or metal, which are played by being struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion plaques"@en .

aat:300195374 a skos:Concept ;
    skos:definition "Idiophones consisting of sonorous tubes, usually of bamboo, wood, or metal, used individually or in sets, sounded by being struck by strikers or other hard objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion tubes"@en .

aat:300195376 a skos:Concept ;
    skos:definition "Rattles composed of small objects such as shells, seeds, or hoofs, strung on cords or tied in bundles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strung rattles"@en .

aat:300195377 a skos:Concept ;
    skos:definition "Rattles in which the rattling objects are mounted together and shaken to strike against each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspension rattles"@en .

aat:300195378 a skos:Concept ;
    skos:definition "Rattles in which the rattling objects are attached to a frame against which they strike."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame rattles"@en .

aat:300195379 a skos:Concept ;
    skos:definition "Instruments consisting of a series of rattling objects hung from a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendant rattles"@en .

aat:300195380 a skos:Concept ;
    skos:definition "Tubes, often made from an animal's horn, with notched or corrugated edges, sounded by scraping with a nonsonorous object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scraped tubes"@en .

aat:300195381 a skos:Concept ;
    skos:definition "Vessels having a notched or corrugated surface which is scraped by a nonsonorous object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scraped vessels"@en .

aat:300195382 a skos:Concept ;
    skos:definition "Scraped idiophones consisting of a cog wheel which is either revolved by means of a handle against one or more wood or metal tongues, or twirled so that the tongues strike the cogs of the wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cog rattles"@en .

aat:300195384 a skos:Concept ;
    skos:definition "Instruments in the shape of two springy arms connected at one end and touching at the other. The arms are forced apart by a little stick, to jingle or vibrate on recoil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split idiophones"@en .

aat:300195385 a skos:Concept ;
    skos:definition "Percussion instruments that consist of a series of tuned metal bars arranged in a single or double row."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallophones"@en .

aat:300195397 a skos:Concept ;
    skos:definition "General term for coins with a penny denomination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penny coins"@en .

aat:300195405 a skos:Concept ;
    skos:definition "Envelopes, postcards, or other postal items of reasonable size with a new stamp or stamps bearing the postally applied marking 'First Day of Issue' and indicating the date and place of first official issue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first day covers"@en .

aat:300195412 a skos:Concept ;
    skos:definition "Any of various coins issued in France and French-speaking territories since the mid-14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "francs"@en .

aat:300195422 a skos:Concept ;
    skos:definition "Certificates entitling the bearer to select merchandise of a specified cash value from a store, usually presented as a gift."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift certificates"@en .

aat:300195429 a skos:Concept ;
    skos:definition "General term for grouping flute aerophones without ducts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flutes without duct"@en .

aat:300195432 a skos:Concept ;
    skos:definition "General term for coins with a shilling denomination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shilling coins"@en .

aat:300195433 a skos:Concept ;
    skos:definition "Type of large upright piano invented by William Southwell of Dublin in 1807, remaining popular until the mid-19th century. It was from 6 to 6 1/2 feet in height with a large, open front panel covered with cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet pianos"@en .

aat:300195439 a skos:Concept ;
    skos:definition "The state or condition of having low moisture content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dryness"@en .

aat:300195449 a skos:Concept ;
    skos:definition "Sets of stationary hanging bells, normally for outdoor use in an open tower chamber or on a high frame, played manually from a keyboard, automatically by clockwork, or electronically by pneumatic mechanism. More extensive than chimes, their range covers two octaves or more, with all but the lowest notes forming a fully chromatic scale. They are typically played with a keyboard, by which keys mechanically activate levers and wires that connect to metal clappers that strike the inside of the bells. They are often housed in the bell tower of a church or other municipal building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carillons"@en .

aat:300195452 a skos:Concept ;
    skos:definition "Sets of tuned stationary bells, and struck to sound. They are less extensive than carillons, having a range limited to within two octaves. The term is always used in the plural. For a single bell, see \"cymbal.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimes"@en .

aat:300195455 a skos:Concept ;
    skos:definition "Class of physical phenomena associated with magnets and the fields of force produced by moving electric currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetism"@en .

aat:300195474 a skos:Concept ;
    skos:definition "Accumulations of objects purposely buried or otherwise hidden as a group; may contain artifacts of any material or of different materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoards"@en .

aat:300195482 a skos:Concept ;
    skos:definition "Creators of ornament, which includes decorative forms that are an integral part of a building or object but are not essential to its structure. The term is especially used to refer to those artists who specialize in engraved designs of ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornamentists"@en .

aat:300195487 a skos:Concept ;
    skos:definition "For the modern nation, use with reference to post-1948 things, people, and events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Israeli"@en .

aat:300195491 a skos:Concept ;
    skos:definition "Exhibiting neither acid nor alkaline qualities, having a pH value of 7.0."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutrality"@en .

aat:300195495 a skos:Concept ;
    skos:definition "Cup-shaped bells without handle or clapper, placed open side up on the palm of the hand or a cushion and struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resting bells"@en .

aat:300195496 a skos:Concept ;
    skos:definition "Bells that are suspended, often in a housing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspended bells"@en .

aat:300195504 a skos:Concept ;
    skos:definition "Small or miniature houses in which guardian or deceased spirits are invited to live. They may be set on wooden posts; they may exist in groups together in house compounds. The practice is common in several cutures, including among Native Americans, in Japan, in Thailand, and in other locations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit houses"@en .

aat:300195511 a skos:Concept ;
    skos:definition "Chambers encased in thick, fireproof vaults of clay, brick, or stone; particularly suited for baking bread. The bake oven was sometimes built in a separate structure, outside the living quarters of the home; some bake ovens were communal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bake ovens"@en .

aat:300195523 a skos:Concept ;
    skos:definition "An underlying intent or meaning in a work of visual or literary art; also a motif, subject, or idea repeated in a number of artistic works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theme"@en .

aat:300195535 a skos:Concept ;
    skos:definition "Small plates of concave form, usually circular, either for eating food or as a stand for a cup. Generally, those for use with a cup have a slight depression in the center in which to place the cup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saucers"@en .

aat:300195548 a skos:Concept ;
    skos:definition "Tall cups consisting of a bowl of varying form resting on a stem and usually having a cover; often used for ceremonial purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing cups"@en .

aat:300195552 a skos:Concept ;
    skos:definition "German goblets, usually made with a cover and often made of glass or silver, usually intended for presentation or other ceremonial purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pokals"@en .

aat:300195553 a skos:Concept ;
    skos:definition "Small cups indigenous to Scotland, with a bell-shaped bowl, the lower part of which is decorated with a calyx-type band of applied lobes giving them the appearance of a thistle; also includes a type of standing cup of which the bowl is in the form of a thistle, made in the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thistle cups"@en .

aat:300195568 a skos:Concept ;
    skos:definition "Standing cups, generally made in silver or gold, with a bowl made of a coconut shell. Of a type which dates from the 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coconut cups"@en .

aat:300195655 a skos:Concept ;
    skos:definition "Large or heavy typefaces used for such elements as headlines, title pages, or advertisements, often defined as type of 24 points or larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display types"@en .

aat:300195659 a skos:Concept ;
    skos:definition "Spacing out the letters of a word or line, spreading them slightly and uniformly, for visual effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterspacing"@en .

aat:300195663 a skos:Concept ;
    skos:definition "The reputation, essence, and impression imparted to the public and employees by a corporation, especially as shaped by public relations programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate image"@en .

aat:300195668 a skos:Concept ;
    skos:definition "Membranophones having a larger diameter at the middle than at the ends and a curvilinear body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrel drums"@en .

aat:300195678 a skos:Concept ;
    skos:definition "Pieces of cloth or other flexible material, usually attached along one side to a pole or cord, intended for such purposes as symbolizing a nation or organization, or as a means of signaling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flags"@en .

aat:300195679 a skos:Concept ;
    skos:definition "Pieces of cloth or other flexible material painted with signs or decorative designs and intended to be displayed by hanging or suspending. In heraldry, refers to square flags bearing heraldic devices. For other cloths intended to symbolize or to signal, use \"flags.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banners"@en .

aat:300195680 a skos:Concept ;
    skos:definition "Tapering flags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pennants"@en .

aat:300195685 a skos:Concept ;
    skos:definition "Reedpipes consisting of either two pipes joined together or a single piece of wood with two bores, whose air columns are set in vibration by an idioglot single reed; in some cases both pipes have fingerholes, in others only one does, the other serving as a drone; known since ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double clarinets"@en .

aat:300195705 a skos:Concept ;
    skos:definition "Devices specifically for measuring the space between two points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distance measuring devices"@en .

aat:300195706 a skos:Concept ;
    skos:definition "Devices for measuring portions or amounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quantity measuring devices"@en .

aat:300195708 a skos:Concept ;
    skos:definition "Instruments, machines, or other apparatus used for determining weight, which is the amount of force exerted on an object or substance by gravity or the amount of force needed to support it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weighing devices"@en .

aat:300195709 a skos:Concept ;
    skos:definition "Devices for measuring types of physical force or compression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure measuring devices"@en .

aat:300195710 a skos:Concept ;
    skos:definition "Devices for measuring forces in physical nature, such as gravity and magnetism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elemental forces measuring devices"@en .

aat:300195711 a skos:Concept ;
    skos:definition "Devices that measure electricity, such as those that measure current flow, electrical resistance, and electrical consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electricity measuring devices"@en .

aat:300195712 a skos:Concept ;
    skos:definition "Devices used for measuring atmospheric phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorological measuring devices"@en .

aat:300195756 a skos:Concept ;
    skos:definition "Devices used to measure electromagnetic radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light measuring devices"@en .

aat:300195757 a skos:Concept ;
    skos:definition "Photoelectric instruments equipped to measure the absorption of nearly monochromatic light in the visible range by a gas or liquid and so determine the concentration of the absorbing constituents in the gas or liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absorptiometers"@en .

aat:300195759 a skos:Concept ;
    skos:definition "Instruments for measuring, indicating, or recording accelerative forces, such as those imparted by gravity or aeronautical devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accelerometers"@en .

aat:300195760 a skos:Concept ;
    skos:definition "Instruments for determining the weight or density of air or other gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerometers"@en .

aat:300195761 a skos:Concept ;
    skos:definition "Devices used to measure the rate of flow of air or gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air meters"@en .

aat:300195764 a skos:Concept ;
    skos:definition "Devices used to measure the changing of place or location of any object, liquid, gas, or other substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movement measuring devices"@en .

aat:300195766 a skos:Concept ;
    skos:definition "Clocks with a bell or buzzer that can be set to sound at a particular time, as to awaken someone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alarm clocks"@en .

aat:300195768 a skos:Concept ;
    skos:definition "Instruments that measure and indicate the altitude of an object above a fixed level, such as sea level or ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altimeters"@en .

aat:300195769 a skos:Concept ;
    skos:definition "Precision balances with a sensitivity of 0.1 to 0.01 mg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "analytical balances"@en .

aat:300195770 a skos:Concept ;
    skos:definition "Devices of various kinds for measuring characteristics of the wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind measuring devices"@en .

aat:300195771 a skos:Concept ;
    skos:definition "Instruments that measure the inclination of the wind from the horizontal plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anemoclinometers"@en .

aat:300195772 a skos:Concept ;
    skos:definition "Instruments designed to measure the speed or force of the wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anemometers"@en .

aat:300195781 a skos:Concept ;
    skos:definition "Barometers that depend on neither hydrostatic equilibrium nor the laws of gases but instead on measurement of force exerted by the atmosphere on some component of the mechanical system; often calibrated for use as altimeters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aneroid barometers"@en .

aat:300195782 a skos:Concept ;
    skos:definition "Aneroid barometers equipped with an automatic recording mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aneroid barographs"@en .

aat:300195785 a skos:Concept ;
    skos:definition "Instruments designed to measure the numerical aperture of microscope objectives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apertometers"@en .

aat:300195790 a skos:Concept ;
    skos:definition "Instruments designed to observe the positions and measure the altitude of celestial bodies; used from the 2nd century BCE, until superseded by sextants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrolabes"@en .

aat:300195791 a skos:Concept ;
    skos:definition "Clocks that display astronomical phenomena, such as the phases of the moon, or clocks that show sidereal time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical clocks"@en .

aat:300195793 a skos:Concept ;
    skos:definition "Extremely accurate electronic clocks regulated by the resonance frequency of atoms or molecules, such as cesium or ammonia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atomic clocks"@en .

aat:300195796 a skos:Concept ;
    skos:definition "Graduated rings designed to fit over compasses, compass repeaters, or similar direction finders and often equipped with sighting vanes for measuring azimuths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azimuth circles"@en .

aat:300195799 a skos:Concept ;
    skos:definition "Detachable brackets in clocks and watches that carry the upper pivot of the axis of the balance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balance cocks"@en .

aat:300195800 a skos:Concept ;
    skos:definition "Parts or components of measuring devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring device components"@en .

aat:300195801 a skos:Concept ;
    skos:definition "Receptacles on scales designed to hold the weights or the objects or substances to be weighed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pans"@en .

aat:300195803 a skos:Concept ;
    skos:definition "Coiled springs that determine the time of vibration of balance wheels, with which they work to regulate the progress of the hands on timepieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balance springs"@en .

aat:300195805 a skos:Concept ;
    skos:definition "Scales with a horizontal bar pivoting about a central fulcrum, creating equal-length arms; suspended from the ends of the arms are pans or baskets, in one of which is placed the item being weighed and in the other, a premeasured weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balances"@en .

aat:300195806 a skos:Concept ;
    skos:definition "Devices used to measure the shapes formed by two line segments that meet at a common point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angle measuring devices"@en .

aat:300195808 a skos:Concept ;
    skos:definition "Instruments for measuring atmospheric pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barometers"@en .

aat:300195809 a skos:Concept ;
    skos:definition "Recording barometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barographs"@en .

aat:300195811 a skos:Concept ;
    skos:definition "Meteorological instruments that automatically record temperature and pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barothermographs"@en .

aat:300195812 a skos:Concept ;
    skos:definition "Instruments that automatically record graphically atmospheric pressure, temperature, and humidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barothermohygrographs"@en .

aat:300195813 a skos:Concept ;
    skos:definition "Oceanographic instruments for measuring the depth of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathometers"@en .

aat:300195814 a skos:Concept ;
    skos:definition "Household accessories, usually portable, meant for persons to stand on in order to ascertain their weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathroom scales"@en .

aat:300195824 a skos:Concept ;
    skos:definition "Oceanographic instruments that measure and record temperature at various depths in the ocean; often used by ships underway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathythermographs"@en .

aat:300195831 a skos:Concept ;
    skos:definition "Parts or components of scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scale components"@en .

aat:300195832 a skos:Concept ;
    skos:definition "Crossbars of balances, from the ends of which the pans or baskets are suspended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beams"@en .

aat:300195841 a skos:Concept ;
    skos:definition "Cylinders of hard material engraved in intaglio upon the curved surface, used especially in ancient Mesopotamia to roll an identifying impression on wet clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder seals"@en .

aat:300195848 a skos:Concept ;
    skos:definition "Proofs of copy prepared for printing, made on light-sensitive paper from negatives stripped and ready for platemaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bluelines"@en .

aat:300195850 a skos:Concept ;
    skos:definition "Scales with fixed counterweights at one end of a horizontal bar, a movable fulcrum which allows for changes in the ratio of the lengths of the arms, and a single hook from which to attach the item to be weighed; for scales of similar form, but with a fixed fulcrum and a movable counterweight, use \"steelyards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desemers"@en .

aat:300195853 a skos:Concept ;
    skos:definition "Various processes performed with type and typefaces, including setting type and creating layouts with type for printing. For the process of designing type used in the practice of typography, use \"type design.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typography"@en .

aat:300195855 a skos:Concept ;
    skos:definition "Methods and practices used in typography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typographic techniques"@en .

aat:300195856 a skos:Concept ;
    skos:definition "The spacing of words and letters within a line of type so that all full lines in a column have even margins on both the left and the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "justification"@en .

aat:300195862 a skos:Concept ;
    skos:definition "Type cast as individual, single-character units, capable of being combined into text, printed, and redistributed and reused. Use especially with regard to its invention, in Europe in the late 15th century and earlier in China and Korea, and in contrast to printing numerous characters and sometimes images from one block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movable type"@en .

aat:300195863 a skos:Concept ;
    skos:definition "Instruments that measure minute amounts of electromagnetic radiation by determining the changes in resistance of a conductor caused by the heating effect of the radiation; used in meteorology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolometers"@en .

aat:300195865 a skos:Concept ;
    skos:definition "Typefaces used for the body of the text of printed matter, often defined as type of 24 points or smaller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "text types"@en .

aat:300195872 a skos:Concept ;
    skos:definition "Mechanical pressure-measuring instruments employing as sensing elements a curved or twisted metal tube, flattened in cross-section and closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bourdon gauges"@en .

aat:300195881 a skos:Concept ;
    skos:definition "Group of typefaces of the roman style class having no serifs; first produced in the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sans serif"@en .

aat:300195882 a skos:Concept ;
    skos:definition "Watches that display, for example, the date of the month and day of the week, in addition to the time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calendar watches"@en .

aat:300195885 a skos:Concept ;
    skos:definition "Instruments consisting usually of a pair of adjustable pivoted legs and used for measuring, for example, thickness or diameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calipers"@en .

aat:300195886 a skos:Concept ;
    skos:definition "An elegant style of handwriting originally derived from cursive script engraved in copper with a burin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copperplate"@en .

aat:300195893 a skos:Concept ;
    skos:definition "Instruments for measuring heat quantities, such as the heat of combustion, specific heat, or vital heat in such processes as chemical reactions or changes of state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calorimeters"@en .

aat:300195894 a skos:Concept ;
    skos:definition "Conventional symbols or characters used in punctuation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punctuation marks"@en .

aat:300195902 a skos:Concept ;
    skos:definition "Signs composed of two or more letterforms joined into a single graphic configuration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ligatures"@en .

aat:300195903 a skos:Concept ;
    skos:definition "Small, portable clocks introduced in the 16th century for use when traveling; usually set in a brass, rectangular case with glass-paneled sides and having a hinged handle on top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage clocks"@en .

aat:300195919 a skos:Concept ;
    skos:definition "Large silver coins of northern Italy introduced in the late 15th century, and, later, various silver, bronze, or chrome steel coins of Italy, Malta, and Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lire"@en .

aat:300195922 a skos:Concept ;
    skos:definition "Various gold or silver coins or bullion with the value of a particular monetary unit, originally based on the value of a given weight, called a \"mark,\" of pure silver. The term refers to silver coins of Sweden and northern Germany issued since the 16th century; and since the late 19th century, to German coins of various metals and denominations. In England, it refers to a monetary unit equivalent in value to two-thirds of a troy pound of pure silver or two-thirds of a pound sterling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marks"@en .

aat:300195926 a skos:Concept ;
    skos:definition "Abbreviations, monograms, or symbols placed, usually unobtrusively, on coins to indicate the mint at which the coins were made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mintmarks"@en .

aat:300195944 a skos:Concept ;
    skos:definition "Ancient Greek silver or gold coins valued at eight drachmas and issued from around 500 BCE, in northern Greece, through the Hellenistic period, especially in Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octadrachms"@en .

aat:300195949 a skos:Concept ;
    skos:definition "Devices used primarily in reading levels of a liquid in a capillary tube to determine surface tension, or for determining the changes in the liquid level during a chemical reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathetometers"@en .

aat:300195954 a skos:Concept ;
    skos:definition "Automatic devices for measuring and recording cloud heights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceilometers"@en .

aat:300195960 a skos:Concept ;
    skos:definition "Clocks that audibly mark periods of time by striking or playing musical notes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiming clocks"@en .

aat:300195964 a skos:Concept ;
    skos:definition "Instruments for measuring the optical effects of color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromascopes"@en .

aat:300195965 a skos:Concept ;
    skos:definition "Instruments for measuring color perception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromatometers"@en .

aat:300195966 a skos:Concept ;
    skos:definition "Timepieces used to register the time of an event or graphically register specific time intervals, such as for the duration of events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronographs"@en .

aat:300195967 a skos:Concept ;
    skos:definition "Certain types of precision time pieces. Originally referred to strongly built precision timekeeping devices especially designed for use on ships; now also used for extremely accurate wrist watches or pocket watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronometers"@en .

aat:300195968 a skos:Concept ;
    skos:definition "Electronic devices for measuring extremely short intervals of time with great accuracy, such as for determining the velocity of projectiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronoscopes"@en .

aat:300195969 a skos:Concept ;
    skos:definition "Thermometers used to indicate mean temperature, consisting partly of a clock mechanism whose speed is a function of temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronothermometers"@en .

aat:300195973 a skos:Concept ;
    skos:definition "Survey instruments used in mining and construction that measure and record the deviation from the vertical of, for example, boreholes or well shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinographs"@en .

aat:300195974 a skos:Concept ;
    skos:definition "Any of various instruments for measuring vertical angles, as for inclination, slope, or elevation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinometers"@en .

aat:300195981 a skos:Concept ;
    skos:definition "Scales, in use predominantly from the 13th to the 18th century, for weighing coins to prevent the circulation of pieces that were light or clipped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coin scales"@en .

aat:300195985 a skos:Concept ;
    skos:definition "Letters on Roman and Byzantine coins indicating the particular workshop of a mint that produced the coins; used from the mid-3rd century to the early 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "officina marks"@en .

aat:300195994 a skos:Concept ;
    skos:definition "Brass (a copper-zinc alloy) that is rich in zinc; it is easy to cast, is ductile, and has a golden color. It was notably used by the ancient Greeks and Romans. According to legend, it was mined in Atlantis in ancient times. It used for jewelry and, according to Plato, to line the outer walls of the Temple to Poseidon on Atlantis. By Roman times, the alloy was used for coinage and jewelry. It is likely that references to the material have historically referred to various yellow metals or alloys, for example, perhaps to a naturally occurring alloy of copper and gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orichalcum"@en .

aat:300195997 a skos:Concept ;
    skos:definition "Stamping over old coins in a die rather than melting them down and recoining with fresh blanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overstriking"@en .

aat:300196006 a skos:Concept ;
    skos:definition "Instruments that measure color by comparing a given color to a standard color, a scale of colors, or certain combinations of primary colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colorimeters"@en .

aat:300196010 a skos:Concept ;
    skos:definition "That part of compasses on which the direction markings are placed, usually in the form of thin disks graduated in degrees clockwise from 0 to 360 and sometimes also indicating compass points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass cards"@en .

aat:300196014 a skos:Concept ;
    skos:definition "Any of various number of German coins issued since the 10th century, originally of silver and modeled after the French denier and English penny; later made of copper and steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pfennigs"@en .

aat:300196017 a skos:Concept ;
    skos:definition "A disc of metal, sometimes a previously struck coin, from which is struck a coin or medal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planchet"@en .

aat:300196034 a skos:Concept ;
    skos:definition "Refers to the compensating or counterbalancing weights on scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterpoises"@en .

aat:300196040 a skos:Concept ;
    skos:definition "Calibrated wooden rods with sliding crosspieces used for measuring the altitude of celestial bodies; forerunnners of modern sextants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-staffs"@en .

aat:300196043 a skos:Concept ;
    skos:definition "Thermometers for measuring low temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryometers"@en .

aat:300196047 a skos:Concept ;
    skos:definition "Official marks stamped on mail, sometimes serving as cancellations, that indicate the place, date, and sometimes the time that the postal system accepted custody of the item; use \"cancellations\" only for official defacements of postage stamps to prevent their reuse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postmarks"@en .

aat:300196048 a skos:Concept ;
    skos:definition "Instruments for measuring circular arcs or for recording the revolutions of a wheel and thus measuring the distance traversed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclometers"@en .

aat:300196050 a skos:Concept ;
    skos:definition "Automatic indicating scales in which the graduations are on a rotatable cylindrical chart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder scales"@en .

aat:300196054 a skos:Concept ;
    skos:definition "Instruments that measure optical density of materials or objects by measuring the intensity of transmitted or reflected light; used, for example, in photography to measure the opacity of images or to determine film speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "densitometers"@en .

aat:300196056 a skos:Concept ;
    skos:definition "Radar or ultrasonic instruments using echo location to measure the depth of the sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depth finders"@en .

aat:300196060 a skos:Concept ;
    skos:definition "Instruments consisting of a rule that slides through a crosspiece and is inserted to measure the depth of holes, grooves, or other similar small depressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depth gauges"@en .

aat:300196070 a skos:Concept ;
    skos:definition "Clocks that indicate the time by a display of figures rather than by a dial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital clocks"@en .

aat:300196085 a skos:Concept ;
    skos:definition "Instruments that measure and record the amount of exposure to nuclear radiation over a given period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dosimeters"@en .

aat:300196086 a skos:Concept ;
    skos:definition "Calipers that may be used as either inside or outside calipers or as dividers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double calipers"@en .

aat:300196095 a skos:Concept ;
    skos:definition "Instruments used to measure the amount of dew formed on a given surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drosometers"@en .

aat:300196105 a skos:Concept ;
    skos:definition "Instruments for the precise measurement of the absolute or differential boiling points of solutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ebulliometers"@en .

aat:300196110 a skos:Concept ;
    skos:definition "Small scales used for measuring the weight and therefore the market size of eggs, usually one by one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg scales"@en .

aat:300196115 a skos:Concept ;
    skos:definition "Devices that measure electricity by totalizing electrical quantities with time, such as watthour meters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric meters"@en .

aat:300196121 a skos:Concept ;
    skos:definition "Headings, initials, titles, catchwords, marginal index words, or other text printed or written in red (the remainder of the text being in black), or otherwise distinguished in lettering, as guides to the contents of pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubrics"@en .

aat:300196122 a skos:Concept ;
    skos:definition "A majuscule book hand developed in the 1st century CE, having condensed letters with pronounced shading and prominent serifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rustic capitals"@en .

aat:300196125 a skos:Concept ;
    skos:definition "Names, symbols, or devices used in the sale and advertising of services, usually registered with a governmental agency to assure exclusivity of use. For registered symbols or devices used to identify products use \"trademarks.\" For specific graphic images derived from service marks, use \"logotypes\" or \"logos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service marks"@en .

aat:300196130 a skos:Concept ;
    skos:definition "Clocks driven by tiny permanent-magnet synchronous motors and electronic circuitry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic clocks"@en .

aat:300196132 a skos:Concept ;
    skos:definition "Surveyors' measuring devices consisting of 1-inch-long steel links joined in a chain 100 feet long; succeeded surveyors' chains, but now obsolete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineers' chains"@en .

aat:300196134 a skos:Concept ;
    skos:definition "Devices for measuring the diameter of minute particles or fibers based on a measurement of the diffraction pattern produced by them in monochromatic light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eriometers"@en .

aat:300196136 a skos:Concept ;
    skos:definition "Instruments for measuring the rate of evaporation of water into the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmometers"@en .

aat:300196138 a skos:Concept ;
    skos:definition "Instruments designed to measure minute changes in distance between two reference points due to contraction, expansion, or deformation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extensometers"@en .

aat:300196144 a skos:Concept ;
    skos:definition "Instruments used to measure the flow rate, discharge rate, or pressure of liquids, gases, or vapors in a pipe or other contained vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flowmeters"@en .

aat:300196146 a skos:Concept ;
    skos:definition "Instruments for measuring magnetic flux."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluxmeters"@en .

aat:300196147 a skos:Concept ;
    skos:definition "Instruments for measuring the focal length of lenses or other optical systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "focometers"@en .

aat:300196148 a skos:Concept ;
    skos:definition "Rulers composed of light strips of wood joined so that the individual pieces fold and usually pivot in more than one plane; most commonly in 2-foot lengths with four folds. Historically superseded by zigzag rules, which are generally longer and have strips that all fold, zigzag fashion, in a single plane and by metal tape rules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding rules"@en .

aat:300196169 a skos:Concept ;
    skos:definition "Period term for lighting devices, such as chandeliers and candelabras, made of glass or ornamented with glass pendants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lusters"@en .

aat:300196190 a skos:Concept ;
    skos:definition "Instruments for measuring the frequency of alternating currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frequency meters"@en .

aat:300196198 a skos:Concept ;
    skos:definition "Devices for measuring the physiological effects of cooling by comparing results against effects on a copper sphere maintained at a constant temperature equal to the deep body temperature of humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frigorimeters"@en .

aat:300196199 a skos:Concept ;
    skos:definition "An alloy of a brassy nature generally containing 85 to 88% copper and 12 to 15% zinc, and sometimes arsenic; used for coins, buttons, jewelry, and gilding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tombac"@en .

aat:300196222 a skos:Concept ;
    skos:definition "Floor lamps having its source of lighting in a reflecting bowl that directs the light upward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torchères"@en .

aat:300196230 a skos:Concept ;
    skos:definition "Any instrument used to measure the intensity of radiant energy, especially of the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actinometers"@en .

aat:300196232 a skos:Concept ;
    skos:definition "Striplights hung upstage of a border for illuminating the stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borderlights"@en .

aat:300196240 a skos:Concept ;
    skos:definition "Supports for the shade of a lamp, consisting of a ring-shaped channel, a wire frame, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shade holders"@en .

aat:300196256 a skos:Concept ;
    skos:definition "Any device used to determine the strength of an acid. Refers to an electronic instrument in more recent use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acidimeters"@en .

aat:300196260 a skos:Concept ;
    skos:definition "Recording actinometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actinographs"@en .

aat:300196266 a skos:Concept ;
    skos:definition "Devices that measure the quantity of alcohol in a liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcoholometers"@en .

aat:300196268 a skos:Concept ;
    skos:definition "Devices for measuring either the quantity of alkali in a solid or liquid or the quantity of carbon dioxide formed in a reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkalimeters"@en .

aat:300196271 a skos:Concept ;
    skos:definition "Instruments for measuring the strength of electric current flow, amperage, in amperes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammeters"@en .

aat:300196285 a skos:Concept ;
    skos:definition "Instruments for measuring and recording the acuity of hearing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiometers"@en .

aat:300196293 a skos:Concept ;
    skos:definition "Instruments for determining the weight of objects or substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scales"@en .

aat:300196296 a skos:Concept ;
    skos:definition "Devices used for measuring distances on a vertical plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical distance measuring devices"@en .

aat:300196302 a skos:Concept ;
    skos:definition "Bowed lutelike chordophones, having a long neck which passes diametrically through the soundbox to protrude as a spike or stub at the lower end to which the strings are attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spike fiddles"@en .

aat:300196309 a skos:Concept ;
    skos:definition "Devices for measuring the amount of lime in soils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcimeters"@en .

aat:300196311 a skos:Concept ;
    skos:definition "Instruments for measuring the carbon content of steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbometers"@en .

aat:300196316 a skos:Concept ;
    skos:definition "Instruments for measuring the size of the skulls of living beings; for instruments that measure the skulls of deceased beings, use \"craniometers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cephalometers"@en .

aat:300196335 a skos:Concept ;
    skos:definition "Instruments for measuring the external dimensions of the skulls of deceased beings; for devices to measure the skulls of living beings, use \"cephalometers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craniometers"@en .

aat:300196338 a skos:Concept ;
    skos:definition "Thin glass globes used to measure the density of gases by weighing the globe in the gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dasymeters"@en .

aat:300196339 a skos:Concept ;
    skos:definition "Devices for measuring the direction of a magnetic field relative to astronomical or survey coordinates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "declinometers"@en .

aat:300196340 a skos:Concept ;
    skos:definition "Devices used for measuring the height and diameter of trees using principles based on the relation of the sides of similar triangles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dendrometers"@en .

aat:300196341 a skos:Concept ;
    skos:definition "Duct flutes having a fipple, a block housed within the mouthpiece. The duct, formed by the space between the surface of the fipple and the inner wall of the mouthpiece, directs the player's breath against the sharp edge of a hole in the wall of the flute below the fipple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fipple flutes"@en .

aat:300196352 a skos:Concept ;
    skos:definition "Open vessels meant to be filled with boiling water and into which other containers are placed to warm or cook food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bains-marie"@en .

aat:300196361 a skos:Concept ;
    skos:definition "Shallow bowls from 4 to 6 inches in diameter, with one flat handle usually flush with the rim, employed by barber-surgeons of the 17th and 18th centuries in bleeding a patient. In England the term is also sometimes applied to what in America is known as porringers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleeding bowls"@en .

aat:300196368 a skos:Concept ;
    skos:definition "Lidded vessels used for boiling or heating, usually oval or rectangular and often made of tin-lined copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boilers"@en .

aat:300196376 a skos:Concept ;
    skos:definition "Pans, often metal, intended primarily for baking bread; made in varying size and form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread pans"@en .

aat:300196387 a skos:Concept ;
    skos:definition "Any of several instruments that measure the density or specific gravity of liquids, solids, or gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "densimeters"@en .

aat:300196388 a skos:Concept ;
    skos:definition "Receptacles consisting of a tray upon which to rest a napkin and having along the rear end a box divided into two or more compartments for eating utensils and spices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caddinets"@en .

aat:300196391 a skos:Concept ;
    skos:definition "Pans, often metal, intended primarily for baking cake; made in varying size and form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake pans"@en .

aat:300196395 a skos:Concept ;
    skos:definition "Large, open vessels, especially those used over an open fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauldrons"@en .

aat:300196406 a skos:Concept ;
    skos:definition "Devices for measuring thermal expansion and dilation of liquids or solids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dilatometers"@en .

aat:300196416 a skos:Concept ;
    skos:definition "Dishes supplied with a heat source (such as a fuel lamp or candle) used for cooking or keeping food warm. The term is sometimes applied to vessels containing charcoal or other fuel and upon which another container with food may be placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chafing dishes"@en .

aat:300196430 a skos:Concept ;
    skos:definition "Wooden bowls in which food is chopped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopping bowls"@en .

aat:300196435 a skos:Concept ;
    skos:definition "Wooden trays in which food is chopped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopping trays"@en .

aat:300196440 a skos:Concept ;
    skos:definition "Small pails, generally made of metal, for holding or carrying coal, typically having a bail handle and one scooplike lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal hods"@en .

aat:300196453 a skos:Concept ;
    skos:definition "Containers for cream and other liquids in the form of a cow, with an opening in the back for filling, a spout in the form of a mouth, and a curved tail as a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cow creamers"@en .

aat:300196462 a skos:Concept ;
    skos:definition "Vessels made of a refractory material, such as clay, graphite, or porcelain, or a relatively infusible metal, that may vary in size and that are used for melting, calcining, or filtering a substance at high temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crucibles"@en .

aat:300196473 a skos:Concept ;
    skos:definition "Instruments calibrated to measure very low voltages without drawing appreciable current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrometers"@en .

aat:300196479 a skos:Concept ;
    skos:definition "Small, shallow platelike containers or mats, usually circular, used to protect a surface from being scratched or damaged by heat or moisture. Formerly referred to a low round tray or stand for a decanter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coasters"@en .

aat:300196487 a skos:Concept ;
    skos:definition "Containers suitable for deep frying; usually deep and often with a mesh or perforated compartment in which the food is exposed to the fat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep fryers"@en .

aat:300196492 a skos:Concept ;
    skos:definition "Plates for holding an individual portion of the dessert course of a meal, similar to but smaller than dinner plates. Distinguished from \"dessert dishes\" in that dessert dishes have shallow raised sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dessert plates"@en .

aat:300196500 a skos:Concept ;
    skos:definition "Receptacles with crossed arms, often adjustable and usually with a spirit lamp in the center, used to support dishes and keep them warm while protecting the surface below from the heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dish crosses"@en .

aat:300196506 a skos:Concept ;
    skos:definition "Cylindrical, or spool-shaped rings with pierced or openwork sides, or stands used to support hot dishes and protect the surface below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dish rings"@en .

aat:300196511 a skos:Concept ;
    skos:definition "Containers consisting of two pots, one of which fits partway into the other; water is boiled in the lower pot to warm, melt, or cook the substance in the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double boilers"@en .

aat:300196517 a skos:Concept ;
    skos:definition "Shallow metal pans used under roasting meats to catch the drippings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dripping pans"@en .

aat:300196523 a skos:Concept ;
    skos:definition "Two handled porringers: shallow, flat-bottomed bowls with vertical sides, having two lateral handles that are level with the rim, often with a cover, and sometimes a conforming stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "écuelles"@en .

aat:300196528 a skos:Concept ;
    skos:definition "Receptacles made of twisted wire for holding one or more eggs while boiling them and then serving them at the table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg stands"@en .

aat:300196541 a skos:Concept ;
    skos:definition "Refers to the religious belief systems practiced by any of several denominations and sects that base their beliefs on the Book of Mormon and the teachings and visionary experiences of Joseph Smith (1805-1844). The largest of the sects is the Church of Jesus Christ of Latter-Day Saints. Mormons believe that in 1822 the angel Moroni led Smith to gold tablets buried in 438 CE on a hill near Palmyra, New York. These tablets were inscribed with the Book of Mormon, which Smith translated. The Book of Mormon is an account of certain tribes of Israel that migrated to America before the birth of Christ; it also tells of a post-resurrection appearance of Christ in America. The authenticity of the texts has been questioned for a number of reasons, but it is not disputed by Mormons. Mormon doctrine is also derived from the King James Version of the Bible although Mormonism is very divergent from Christian doctrine. Perhaps most notably, Mormonism holds that the Trinity is three distinct beings. Mormons believe that Christian churches have apostasized but true Christianity has been restored by Smith. Mormonism contends that spiritual perfection or godhood can be attained through a process of spiritual evolution and daily practical guidance. Entry to Christ's kingdom is attained through repentance and baptism by immersion. Mormons believe in the coming of a millennium when Christ will rule from Jerusalem and Independence, Missouri. Mormonism is often associated with ideas such as collective ownership, tithing, polygamy (later abandoned), strong conformity, heavy church activism, and proselytization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mormonism"@en .

aat:300196545 a skos:Concept ;
    skos:definition "Tall pouring vessels which have a single handle and a hinged lid with a finial and thumbpiece. Usually without a lip or spout; intended to be used for serving wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flagons"@en .

aat:300196566 a skos:Concept ;
    skos:definition "Large casks or barrels; especially ones of a capacity between 63 and 140 gallons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hogsheads"@en .

aat:300196567 a skos:Concept ;
    skos:definition "Devices of various kinds for measuring size in various contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "size measuring devices"@en .

aat:300196569 a skos:Concept ;
    skos:definition "Devices used measure diameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diameter measuring devices"@en .

aat:300196571 a skos:Concept ;
    skos:definition "Devices for measurement between two opposite surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thickness measuring devices"@en .

aat:300196577 a skos:Concept ;
    skos:definition "Small, usually ceramic vessels with narrow mouths, especially ones used by apothecaries to hold medicines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallipots"@en .

aat:300196583 a skos:Concept ;
    skos:definition "Compact discs on which a large amount of digitized read-only data can be stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CD-ROMs"@en .

aat:300196592 a skos:Concept ;
    skos:definition "Broad, shallow, open tubs or vessels, especially ones used for cooling liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keelers"@en .

aat:300196600 a skos:Concept ;
    skos:definition "Large metal vessels, sometimes lined with white porcelain, used for boiling clothes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washboilers"@en .

aat:300196609 a skos:Concept ;
    skos:definition "Containers for holding matches; used especially with reference to wood or metal containers, sometimes lined with a fireproof plasterlike material, usually having a striking surface on one side and often made to be hung on the wall. For small boxes intended for holding matches in a pocket or purse, use \"matchboxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "match safes"@en .

aat:300196645 a skos:Concept ;
    skos:definition "Brand name for a board comprising polystyrene between two coated papers, often used for mounting or backing works of art. Manufactured by Monsanto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fome-Cor (R)"@en .

aat:300196648 a skos:Concept ;
    skos:definition "Circular baking dishes with low plain or fluted sides that angle out from the base to the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pie plates"@en .

aat:300196671 a skos:Concept ;
    skos:definition "Baking pans with four or more cuplike depressions used to bake muffins and similar foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muffin pans"@en .

aat:300196691 a skos:Concept ;
    skos:definition "Drinking vessels in the form of a wide, flat-bottomed, shallow bowl; originally of wood (especially maple) and often having silver or gilt mounts. Many have a central ornamental print on the interior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mazers"@en .

aat:300196694 a skos:Concept ;
    skos:definition "Bowls for mixing food or other substances, generally made of metal, glass, ceramic, or plastic. They are sometimes made in sets and then often graduated in size so as to nest together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixing bowls"@en .

aat:300196703 a skos:Concept ;
    skos:definition "Large circular or oval bowls with scalloped rims used to cool inverted wine glasses or punch cups, usually six or more. Often made of silver, but also of earthenware, porcelain, or other metals. Those with detachable, scalloped rims also served as punch bowls. For small vessels that hold one wine glass, use \"wine-glass coolers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monteiths"@en .

aat:300196707 a skos:Concept ;
    skos:definition "Instruments for measuring and indicating a horizontal reference direction relative to magnetic north."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compasses"@en .

aat:300196709 a skos:Concept ;
    skos:definition "Devices used for for measuring angles between lines on horizontal planes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizontal angle measuring devices"@en .

aat:300196710 a skos:Concept ;
    skos:definition "Devices used for for measuring angles between lines on vertical planes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical angle measuring devices"@en .

aat:300196711 a skos:Concept ;
    skos:definition "Devices used to measure the degree of heaviness of matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravity measuring devices"@en .

aat:300196712 a skos:Concept ;
    skos:definition "Devices that measure magnetic attraction or magnetic phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetism measuring devices"@en .

aat:300196713 a skos:Concept ;
    skos:definition "Devices used to measure energy existing in atomic nuclei, or energy produced during nuclear fission or fusion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear energy measuring devices"@en .

aat:300196714 a skos:Concept ;
    skos:definition "Light measuring devices specifically for measuring color and color properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color measuring devices"@en .

aat:300196715 a skos:Concept ;
    skos:definition "Devices that measure the absorption of electromagnetic radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light absorption measuring devices"@en .

aat:300196745 a skos:Concept ;
    skos:definition "Small, shallow, covered boxes, generally circular or oval, formerly used to contain patches worn on the face and fashionable in the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patch boxes"@en .

aat:300196768 a skos:Concept ;
    skos:definition "Drums consisting of a membrane stretched across a number of poles stuck in the ground and beaten with a stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground drums"@en .

aat:300196771 a skos:Concept ;
    skos:definition "Small, wooden vessels shaped like buckets but which have one extended stave to serve as a handle. Also glass, silver, or other dishes of this form, especially those used for butter, sugar, milk, or cream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piggins"@en .

aat:300196775 a skos:Concept ;
    skos:definition "A multipart tray, usually mirrored and having a gallery, intended to hold figurines, candlesticks, or vessels, and used as table centerpieces in the late 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plateaus"@en .

aat:300196792 a skos:Concept ;
    skos:definition "Covered pans for roasting meats or similar foods, often in the form of oval enameled pans with two handles on the side and a domed cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roasters"@en .

aat:300196797 a skos:Concept ;
    skos:definition "Small vessels for holding ink into which a pen can be dipped. For bottles in which ink is sold, see \"ink bottles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkwells"@en .

aat:300196804 a skos:Concept ;
    skos:definition "Stands for holding inkwells, pens, sand, and other writing equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkstands"@en .

aat:300196816 a skos:Concept ;
    skos:definition "Small dishes for serving, and sometimes also baking, an individual portion of custard or similar food. Generally made in sets; may have a cover or one or more handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "custard cups"@en .

aat:300196822 a skos:Concept ;
    skos:definition "Scottish drinking vessels in the form of a small, shallow bowl typically with two, but sometimes with three horizontal handles; generally made of wood, pewter or silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quaiches"@en .

aat:300196838 a skos:Concept ;
    skos:definition "Outer sheets or boards that are part of, or are attached to, groups of leaves, whether a substantial block or a single gathering; sometimes simply the first page of a document, as for example of a leaflet, if it is designed as distinct from the body of the document. Designed to protect the text block or gathering within, and often carrying information about it such as the title, and decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covers"@en .

aat:300196848 a skos:Concept ;
    skos:definition "Posters measuring approximately 27 by 41 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-sheet posters"@en .

aat:300196852 a skos:Concept ;
    skos:definition "Printed matter prepared to solicit trade or contributions and sent directly through the mail to individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct mail"@en .

aat:300196855 a skos:Concept ;
    skos:definition "Wood or metal discs, cylinders, or cup-shaped attachments located below the double reed in some European and most non-European double reed instruments, serving as a lip rest. The reed is taken into the player's mouth and the lips pressed against the pirouette."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pirouettes"@en .

aat:300196864 a skos:Concept ;
    skos:definition "Instruments that measure the angles at which x-rays, neutrons, or electrons are diffracted by matter; used to study atomic crystal structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffractometers"@en .

aat:300196866 a skos:Concept ;
    skos:definition "Devices consisting of a small drill or blunt indenter point under pressure and used to measure the hardness of materials, such as metals, rubber, and rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "durometers"@en .

aat:300196867 a skos:Concept ;
    skos:definition "Timepieces that indicate the difference between mean solar time and apparent time (usually based on Greenwich mean time)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equation clocks"@en .

aat:300196901 a skos:Concept ;
    skos:definition "Liurgical containers designed to serve as receptacles for a liquid or other substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical vessels"@en .

aat:300196932 a skos:Concept ;
    skos:definition "Drinking vessels in the shape of a cup for drinking brandy, similar to but usually larger than a dram cup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brandy bowls"@en .

aat:300196943 a skos:Concept ;
    skos:definition "Drinking glasses intended for cider, often having distinctive chevron or scale patterns, sometimes having engraved motifs of apple branches or apple blossoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cider glasses"@en .

aat:300196949 a skos:Concept ;
    skos:definition "Standing cups often having a trefoil foot, baluster-shaped stem, and an embossed cup; so named from their resemblance to the columbine flower."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columbine cups"@en .

aat:300196960 a skos:Concept ;
    skos:definition "Lidded containers of various forms and materials in which salt is kept. The term is used especially with reference to those which hang from the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt boxes"@en .

aat:300196975 a skos:Concept ;
    skos:definition "German type of stoneware tankards made from the 16th century in Siegburg in the Rhineland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schnellens"@en .

aat:300196983 a skos:Concept ;
    skos:definition "Boxes used for holding snuff, usually having a hinged lid and small enough to be carried in the pocket. For boxes for holding tobacco, often larger in size and sometimes having an unattached, fitted cover instead of a hinged lid, use \"tobacco boxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuffboxes"@en .

aat:300197007 a skos:Concept ;
    skos:definition "Small coffee cups for serving strong coffee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demitasses"@en .

aat:300197015 a skos:Concept ;
    skos:definition "Small drinking glasses for spirits, generally of 2- or 3-ounce capacity, with a funnel or conical bowl and a short rudimentary stem resting on a heavy foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dram glasses"@en .

aat:300197021 a skos:Concept ;
    skos:definition "Term applied to small short-stemmed ale glasses of 3- to 4-ounce capacity, especially those made in England from the early 17th until the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarf ale glasses"@en .

aat:300197039 a skos:Concept ;
    skos:definition "Standing cups having a shallow but broad bowl with vertical sides, low trumpet feet, and an almost flat cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "font-shaped cups"@en .

aat:300197042 a skos:Concept ;
    skos:definition "Drinking glasses, varying in shape, for serving gin. For similar but larger drinking glasses for serving wine, use \"wine glasses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gin glasses"@en .

aat:300197048 a skos:Concept ;
    skos:definition "Measures used in mixing drinks and holding usually one and one half ounces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jiggers"@en .

aat:300197053 a skos:Concept ;
    skos:definition "Lavishly decorated standing cups, generally made in silver or gold, having a bowl, and sometimes also a cover, made of an ostrich egg shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ostrich-egg cups"@en .

aat:300197059 a skos:Concept ;
    skos:definition "Armor pieces which are physical parts of or are affixed to other pieces and cannot function alone. For individual armor pieces which can be worn and function individually or in sets, see \"armor.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor components"@en .

aat:300197068 a skos:Concept ;
    skos:definition "Drinking glasses set on a short stem and having a large pear-shaped bowl which narrows at the top to intensify the aroma of brandy, liqueur, or the like. Some are accompanied by a metal rack that holds the glass over a flame for warming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snifters"@en .

aat:300197085 a skos:Concept ;
    skos:definition "Tall, thin wine glasses with a small conical bowl, a very thin stem, which can easily be snapped between the fingers, and a stemmed foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toasting glasses"@en .

aat:300197088 a skos:Concept ;
    skos:definition "Devices to measure properties of sound energy, such as levels and frequencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound measuring devices"@en .

aat:300197090 a skos:Concept ;
    skos:definition "Devices for measuring the velocity and attenuation of sound waves in a gas or liquid by studying the interference pattern set up by two waves generated from the same source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustic interferometers"@en .

aat:300197095 a skos:Concept ;
    skos:definition "Instruments for measuring the smoothness of surfaces by amplifying minute variations in vertical deviations of the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Profilometers (TM)"@en .

aat:300197097 a skos:Concept ;
    skos:definition "Instruments designed to measure noise and sound levels, usually consisting of microphone, amplifier, output meter, and frequency-weighting apparatus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound-level meters"@en .

aat:300197098 a skos:Concept ;
    skos:definition "Large, ceramic, muglike drinking vessels usually having two or four handles, but sometimes as many as twelve; use especially for those made in England in the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tygs"@en .

aat:300197100 a skos:Concept ;
    skos:definition "Tall, extremely narrow drinking glasses with a conical-shaped bowl that rests on a stem; typically used for drinking sparkling wine and historically also for beer. The form was developed in the 17th century in northern Europe, with some forms reaching up to a yard in height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flute glasses"@en .

aat:300197117 a skos:Concept ;
    skos:definition "Large, ornamental cups of varying form but generally with two or more handles, used for ceremonial drinking by assembled companions. Also, similar cups given as a prize, honor, or token of friendship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loving cups"@en .

aat:300197148 a skos:Concept ;
    skos:definition "Beakers characterized by having a stem or protrusion at one end but no foot, so that when they are empty they must rest on their side or on the rim like a rhyton or stirrup cup; of a type found in various forms in Germany and the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sturzbechers"@en .

aat:300197150 a skos:Concept ;
    skos:definition "Drinking glasses of apparently normal but actually minute capacity originally used by 18th-century toastmasters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toastmasters' glasses"@en .

aat:300197162 a skos:Concept ;
    skos:definition "A type of flute glass intended for drinking ratafia, a liqueur flavored with almonds and fruit kernels; of 1- to 1 1/2-ounce capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratafia glasses"@en .

aat:300197169 a skos:Concept ;
    skos:definition "Small, thick drinking glasses without a stem used for serving a measure (shot) of whiskey or other liquor. They traditionally contain 1 1/2 ounces of liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shot glasses"@en .

aat:300197197 a skos:Concept ;
    skos:definition "Receptacles or formed or flexible coverings designed to hold, store, or ship objects or substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "containers"@en .

aat:300197199 a skos:Concept ;
    skos:definition "Parts or components of containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "container components"@en .

aat:300197205 a skos:Concept ;
    skos:definition "Protruding ornaments, often globular, found on the stems of vessels or the shafts of objects such as candlesticks. For similar protruberances in terminal positions, use \"finials.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knops"@en .

aat:300197210 a skos:Concept ;
    skos:definition "Objects that are placed or that naturally overlie or overspread another object, with the purpose or effect of enclosing, hiding, or sheltering the second object or its contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covers"@en .

aat:300197215 a skos:Concept ;
    skos:definition "Container covers which are circular and have a dome-shaped profile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dome covers"@en .

aat:300197224 a skos:Concept ;
    skos:definition "Tubular protruberances through which the contents of a vessel may be poured or sometimes drunk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spouts"@en .

aat:300197226 a skos:Concept ;
    skos:definition "Arched handles in the form of a hoop or half-ring that extend over the top of a vessel or other container, and are either fixed or swivelling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bail handles"@en .

aat:300197240 a skos:Concept ;
    skos:definition "A type of valve or cock used to control the flow of liquid through a tap, as found on coffee urns, tea urns, wine fountains, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spigots"@en .

aat:300197245 a skos:Concept ;
    skos:definition "Projections on the hinged lids of some drinking vessels used to open the lid with the thumb while grasping the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumbpieces"@en .

aat:300197250 a skos:Concept ;
    skos:definition "Depressed portions of shallow vessels or other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wells"@en .

aat:300197258 a skos:Concept ;
    skos:definition "Slender parts of objects, such as the vertical support of a vessel which unites its bowl to its base or the tubelike portion of a pipe that fits snugly into the bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stems"@en .

aat:300197262 a skos:Concept ;
    skos:definition "Containers, racks, or other devices for holding, organizing, or storing items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caddies"@en .

aat:300197269 a skos:Concept ;
    skos:definition "Bottles covered with wicker, wood, or other protective material, of a 1- to 20-gallon capacity and intended to contain corrosive liquids such as acids, or distilled water. For similar large bottles covered with wicker and intended for noncorrosive liquids, use \"demijohns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carboys"@en .

aat:300197291 a skos:Concept ;
    skos:definition "Large baskets, usually having a cover or lid, for packing, storing, or transporting food, laundry, or other articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hampers"@en .

aat:300197294 a skos:Concept ;
    skos:definition "Devices or contrivances by which, or containers in which, something is held."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holders"@en .

aat:300197296 a skos:Concept ;
    skos:definition "Boxes intended primarily for packing goods for transport or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packing boxes"@en .

aat:300197303 a skos:Concept ;
    skos:definition "Drinking vessels consisting of a wide flat or shallow bowl supported on a stem with a central knop, made with or without handles and rarely with a cover; used especially with reference to 16th-century forms. For dishlike vessels set on a high stem and used for serving food or drink, use \"salvers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tazzas"@en .

aat:300197310 a skos:Concept ;
    skos:definition "Ecclesiastical drinking vessels; the term is particularly used in reference to those cups used by the Protestant churches since the Reformation. The communion cup may take the form of a goblet wine cup or beaker. For other ecclesiastical drinking vessels, particularly those used by the Catholic churches and often more ornate, use \"chalices (liturgical vessels)\" or \"communion bowls (vessels for wine).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion cups"@en .

aat:300197314 a skos:Concept ;
    skos:definition "Circular or oval, movable receptacles used alone or placed inside the baptismal stand or support, used to catch the runoff of holy water during the sacrament of baptism by aspersion. They may be ornamented or unornamented; they may have a hole for draining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal basins"@en .

aat:300197322 a skos:Concept ;
    skos:definition "Envelope-like cases formed from two squares of stiffened material or of cardboard lined with fabric; used to carry and hold the folded corporal (altar cloth). In Roman form the burse is ordinarily made of two juxtaposed pieces about twenty-five centimeters (or ten inches) square, bound together at three edges, leaving the fourth open to receive the corporal. The fabric of the case is of the liturgical color appropriate to the liturgical calendar. The use of the burse is relatively recent. When the corporal reached its present small dimensions, it was carried to the altar in the Missal or in a bag (burse) or box. For the larger box-like containers used to carry or store corporals, use \"corporal cases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burses"@en .

aat:300197324 a skos:Concept ;
    skos:definition "General term for various articles, usually of silver or gold, intended for ecclesiastical use. Examples include patens, chalices, alms dishes, censers, or any other items that are made of or plated with silver or gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church plate"@en .

aat:300197358 a skos:Concept ;
    skos:definition "Apparatus of glass or metal formerly used in distillation. They are in the shape of an inverted bowl with an internal gutter along the rim into which the condensed vapor descends and from which extends a long horizontally sloping tube to the receptacle for the distilled liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alembics"@en .

aat:300197360 a skos:Concept ;
    skos:definition "Containers for water, typically of metal or plastic and having a spout with a perforated nozzle, for watering or sprinkling plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watering cans"@en .

aat:300197361 a skos:Concept ;
    skos:definition "Bell-shaped glass jars or covers for protecting delicate instruments or natural or fabricated objects from dust or damage. Also, vessels for containing gases or a vacuum in chemical experiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell jars"@en .

aat:300197367 a skos:Concept ;
    skos:definition "Large rectangular coverings of thick but soft material, used especially for warmth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blankets"@en .

aat:300197370 a skos:Concept ;
    skos:definition "Blankets with an inner wiring system and thermostatic control, which provide constant warmth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric blankets"@en .

aat:300197378 a skos:Concept ;
    skos:definition "Coarse, heavy lap robes used by passengers aboard ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steamer rugs"@en .

aat:300197382 a skos:Concept ;
    skos:definition "Woolen blankets traded to Native North Americans in exchange for furs or other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade blankets"@en .

aat:300197388 a skos:Concept ;
    skos:definition "Trade blankets made for the Hudson's Bay Company, of various weights and colors, often patterned with broad weft bands and points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hudson's Bay blankets"@en .

aat:300197395 a skos:Concept ;
    skos:definition "Inexpensive, machine-woven blankets made by the Pendleton Woolen Mills in Oregon for trade with the Indians, designed especially to suit Native North American tastes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pendleton blankets"@en .

aat:300197404 a skos:Concept ;
    skos:definition "Style of textiles, particularly rugs, characterized by a higher pile than other Shirvan rugs. They are flat and tightly woven with a red ground color and the central field dominated by three large hooked octagons, the middle one of which is almost invariably white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chila"@en .

aat:300197414 a skos:Concept ;
    skos:definition "Simple, utilitarian blankets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility blankets"@en .

aat:300197421 a skos:Concept ;
    skos:definition "Blankets that are worn loosely draped on the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wearing blankets"@en .

aat:300197424 a skos:Concept ;
    skos:definition "Main garments for the upper and lower body consisting of long, rectangular pieces of cloth, often but not always of tartan; traditional costume of the Highlands of Scotland and later adopted by the Highland units of the British army as an item of uniform. For the patterned textile, prefer \"tartan.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaids"@en .

aat:300197427 a skos:Concept ;
    skos:definition "Blankets worn draped over the shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder blankets"@en .

aat:300197435 a skos:Concept ;
    skos:definition "Finely woven, often intricately patterned, Spanish American style blankets, woven longer than wide and worn wrapped about the shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarapes"@en .

aat:300197439 a skos:Concept ;
    skos:definition "Sarapes with slits in the center, allowing them to be slipped over the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poncho sarapes"@en .

aat:300197462 a skos:Concept ;
    skos:definition "Northwest Coast Native American blankets with totemic designs outlined in buttons, often of abalone shell or pearl, used ceremonially to indicate status and power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "button blankets"@en .

aat:300197471 a skos:Concept ;
    skos:definition "Hardened steel blocks having two flat, parallel surfaces with the parallel distance between the surfaces marked to a guaranteed accuracy of a few millionths of an inch; used in manufacturing processes as a precise measuring standard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gage blocks"@en .

aat:300197486 a skos:Concept ;
    skos:definition "Salish blankets, done in twill and weft-twined tapestry weaves, worn by the aristocracy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nobility blankets"@en .

aat:300197514 a skos:Concept ;
    skos:definition "Southwestern Native American blankets, woven wider than long, in white with indigo blue diamond-twill borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maiden shawls"@en .

aat:300197519 a skos:Concept ;
    skos:definition "Instruments for measuring small electric currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galvanometers"@en .

aat:300197524 a skos:Concept ;
    skos:definition "Flowmeters for measuring and recording the amount of gas moving through a pipe, as for calculating household consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas meters"@en .

aat:300197525 a skos:Concept ;
    skos:definition "Southwestern Native American blankets in the Rio Grande pattern of narrow brown, blue, and white weft bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moki blankets"@en .

aat:300197526 a skos:Concept ;
    skos:definition "Use generally for devices designed to measure or otherwise determine the size, state, or mechanical accuracy of something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauges"@en .

aat:300197541 a skos:Concept ;
    skos:definition "Radiation counters that use Geiger-Müller tubes in the appropriate circuitry to detect and measure ionizing particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Geiger counters"@en .

aat:300197549 a skos:Concept ;
    skos:definition "Accurate surveying instruments that use electronic-optical devices that measure distance on the basis of the velocity of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Geodimeters (TM)"@en .

aat:300197552 a skos:Concept ;
    skos:definition "Parts or components of timepieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timepiece components"@en .

aat:300197553 a skos:Concept ;
    skos:definition "Refers to the inclined plates or pins on sundials whose shadow indicates the time. These may be pillars, rods, or other objects which serve to indicate the time of day by casting a shadow upon a marked surface, including the pin or triangular plate used for this purpose in an ordinary sun-dial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gnomons"@en .

aat:300197554 a skos:Concept ;
    skos:definition "Kettledrums of the Western orchestra, consisting of a large bowl-shaped resonating shell, usually of copper, with a drumhead of calfskin or plastic, and some device for tightening or slackening the drumhead so as to tune it to a given note."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timpani"@en .

aat:300197555 a skos:Concept ;
    skos:definition "Objects of known mass for use on scales during weighing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weights"@en .

aat:300197556 a skos:Concept ;
    skos:definition "Instruments devised to measure angles, especially the angles of crystal faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goniometers"@en .

aat:300197557 a skos:Concept ;
    skos:definition "Photometers designed to measure the intensity of light reflected at various angles from a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goniophotometers"@en .

aat:300197559 a skos:Concept ;
    skos:definition "Cylindrical or tapering graduated vessels calibrated in fluid ounces or milliliters for measuring the volume of liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graduates"@en .

aat:300197563 a skos:Concept ;
    skos:definition "Instruments for measuring variations in the gravitational field of the earth by detecting small differences in the weight of an object of constant mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravimeters"@en .

aat:300197567 a skos:Concept ;
    skos:definition "North-seeking navigational devices containing a gyroscope and used as a vehicle's directional reference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gyrocompasses"@en .

aat:300197573 a skos:Concept ;
    skos:definition "Sets of levers or keys actuating the sounding mechanism of keyboard instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyboards"@en .

aat:300197576 a skos:Concept ;
    skos:definition "Containers having a primarily ceremonial or ritual purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial containers"@en .

aat:300197577 a skos:Concept ;
    skos:definition "Containers for use in a kitchen, or for cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary containers"@en .

aat:300197578 a skos:Concept ;
    skos:definition "Containers specifically used for written information in document form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "document containers"@en .

aat:300197579 a skos:Concept ;
    skos:definition "Ceremonial containers used in the context of funerals or burials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary containers"@en .

aat:300197580 a skos:Concept ;
    skos:definition "Containers used for the rearing or breeding of livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal husbandry containers"@en .

aat:300197581 a skos:Concept ;
    skos:definition "Containers used for the maintenance of a household."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housekeeping containers"@en .

aat:300197582 a skos:Concept ;
    skos:definition "General term for containers that store materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage containers"@en .

aat:300197585 a skos:Concept ;
    skos:definition "Boxes or chests in which a corpse is enclosed for burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffins"@en .

aat:300197595 a skos:Concept ;
    skos:definition "Baskets or basketlike containers for holding bread or rolls in temporary storage or for passing around the table at a meal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread baskets"@en .

aat:300197601 a skos:Concept ;
    skos:definition "Rectangular, flat containers made of flexible material that is folded to produce overlapping seams that are adhered together on two or three edges; often with a flag closure, and intended for small objects or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "envelopes"@en .

aat:300197602 a skos:Concept ;
    skos:definition "Folded sheets of light cardboard used to cover or hold papers, letters, or other flat documents, as in a file."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folders"@en .

aat:300197605 a skos:Concept ;
    skos:definition "Ornamental containers for holding and concealing a flowerpot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cachepots"@en .

aat:300197609 a skos:Concept ;
    skos:definition "Glass bowls intended primarily for the keeping of live fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishbowls"@en .

aat:300197614 a skos:Concept ;
    skos:definition "Containers for the disposal of dry waste or garbage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trash cans"@en .

aat:300197615 a skos:Concept ;
    skos:definition "Standing baskets or basketlike containers for wastepaper and small items of trash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wastebaskets"@en .

aat:300197626 a skos:Concept ;
    skos:definition "British pendulum wall clocks of the mid- to late 18th century, with large dials and wooden cases, generally made for public gathering places, such as inns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Act of Parliament clocks"@en .

aat:300197627 a skos:Concept ;
    skos:definition "Mechanisms in clocks and watches that measure beats and control the speed of the going trains thus controling the indication of the passage of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escapements"@en .

aat:300197628 a skos:Concept ;
    skos:definition "Escapements in which wedge-shaped pallets of an anchor-shaped component engage an escape wheel causing the wheel to recoil slightly at every release."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor escapements"@en .

aat:300197630 a skos:Concept ;
    skos:definition "Late-18th-century bracket clocks having a round upper portion, waisted central section, and a rectangular base, with or without small feet, vaguely resembling ascension balloons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon clocks"@en .

aat:300197635 a skos:Concept ;
    skos:definition "Term applied to a wide variety of bottles of different size and shape intended primarily for holding or dispersing perfume. Includes those made for sale to cosmetics manufacturers as well as those often decorative forms meant to be placed on the dressing table and sometimes part of a toilet set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfume bottles"@en .

aat:300197638 a skos:Concept ;
    skos:definition "Large Tibetan rugs that were woven on commission and used for a variety of purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sadens"@en .

aat:300197642 a skos:Concept ;
    skos:definition "Decorative wall clocks originating in France in the early 18th century; usually spring-driven and set in gilt-bronze or carved wooden frames coming to a point at the bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartel clocks"@en .

aat:300197643 a skos:Concept ;
    skos:definition "Rugs with an uncut loop pile often at different levels to give a sculpted effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "looped-pile carpets"@en .

aat:300197644 a skos:Concept ;
    skos:definition "Short cylinders with a serrated edge, resembling a crown, used as the escape wheel in verge escapements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown wheels"@en .

aat:300197645 a skos:Concept ;
    skos:definition "Escapements in which there is no recoil from the shock of contact among the locking parts; introduced in the early 18th century and best suited for expensive or precise timekeepers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deadbeat escapements"@en .

aat:300197647 a skos:Concept ;
    skos:definition "Plates, disks, faces, or other surfaces with markings or figures for indicating such information as time, measurement, or frequency, usually by means of pointing devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dials"@en .

aat:300197650 a skos:Concept ;
    skos:definition "Flat beveled or triangular straightedges, usually of wood or plastic, graduated in multiples of ten parts per inch allowing drawings to be drawn or measured to scale in decimal values."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineers' scales"@en .

aat:300197651 a skos:Concept ;
    skos:definition "Final wheels in the going trains of timepieces which interact directly with the escapement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escape wheels"@en .

aat:300197653 a skos:Concept ;
    skos:definition "Spirally grooved, conical pulley and chain arrangements in timepieces designed to counteract the diminishing power of uncoiling mainsprings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fusees"@en .

aat:300197654 a skos:Concept ;
    skos:definition "Weight-driven domestic versions of tower clocks with iron movements set in openwork cases having Gothic details; primarily produced in Germany, Austria, and Switzerland in the 15th and 16th centuries, and then introduced in the United States in the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic clocks"@en .

aat:300197658 a skos:Concept ;
    skos:definition "A low-expansion iron alloy containing about 36% nickel; used for precision surveying instruments and timepieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Invar (TM)"@en .

aat:300197662 a skos:Concept ;
    skos:definition "Clocks of great accuracy containing a deadbeat escapement and temperature-compensated pendulum used for the regulation of other timepieces; usually tall case clocks in form. These were initially used in observatories and clock and watch shops as the standard of accuracy during repairs, synchronization, and manufacturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regulators"@en .

aat:300197663 a skos:Concept ;
    skos:definition "Clocks designed so that as much of their movements as possible are visible; devised in France in the mid-18th century and popular in England during the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeleton clocks"@en .

aat:300197664 a skos:Concept ;
    skos:definition "Flexible steel tapelines or ribbons of steel used for accurate measurement of horizontal distances and which generally coil up into a special casing when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel tapes"@en .

aat:300197665 a skos:Concept ;
    skos:definition "Types of table clocks with a gallery and small cupola or in other ways in the form of two-level towers; popular in England and France from the mid-16th century into the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabernacle clocks"@en .

aat:300197693 a skos:Concept ;
    skos:definition "Early 19th-century American rugs woven in broad lengthwise stripes with a heavy homespun wool yarn, the width was suitable for stair coverings or they were seamed together to make room-sized rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striped rugs"@en .

aat:300197729 a skos:Concept ;
    skos:definition "Wearing blankets, generally worn over the shoulders, made by the Navajo tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Navajo wearing blankets"@en .

aat:300197730 a skos:Concept ;
    skos:definition "Navajo shoulder blankets, woven wider than long and worn horizontally, characterized by a simple weft-banded design in weft-faced tabby weave, perhaps with tapestry-woven rectangles or diamonds. Not associated with rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chief blankets"@en .

aat:300197742 a skos:Concept ;
    skos:definition "People who manage the financial and artistic resources of productions in the performing arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "producers"@en .

aat:300197770 a skos:Concept ;
    skos:definition "The study of the history and culture of ethnic groups within a larger cultural or social order. For the scientific, historic, or comparative study of the origins, characteristics, and functions of human cultures and societies, use \"ethnology.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnic studies"@en .

aat:300197774 a skos:Concept ;
    skos:definition "Soft, loosely woven, weft-banded Navajo shoulder blankets for everyday, all-purpose use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diyugis"@en .

aat:300197791 a skos:Concept ;
    skos:definition "Heavy, loosely woven, Navajo blankets made of coarse, handspun, aniline-dyed yarn, and sold to traders by the pound in the decades around 1900."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pound blankets"@en .

aat:300197798 a skos:Concept ;
    skos:definition "Finely made, intricately patterned, richly colored sarapes in tapestry weave, made in northern Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saltillo sarapes"@en .

aat:300197812 a skos:Concept ;
    skos:definition "Blankets with depictions of recognizable figures, objects, or scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial blankets"@en .

aat:300197817 a skos:Concept ;
    skos:definition "Blankets with a number of short bars called points woven in the corner to indicate size and weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point blankets"@en .

aat:300197824 a skos:Concept ;
    skos:definition "19th-century English or North American blankets embroidered with a circular motif in each corner, the significance of which is unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose blankets"@en .

aat:300197838 a skos:Concept ;
    skos:definition "Large mandolins of bass range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandocellos"@en .

aat:300197847 a skos:Concept ;
    skos:definition "Clocks whose recurring motion depends on mechanical, as opposed to electronic, devices, such as escapements, the swing of a pendulum, or the oscillation of a balance wheel and spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical clocks"@en .

aat:300197848 a skos:Concept ;
    skos:definition "Clock or watch movements in which the balance wheel is connected to the escapement by a lever attached to a roller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lever escapements"@en .

aat:300197849 a skos:Concept ;
    skos:definition "Apparatus for measuring gas and for calibrating other gas-measuring devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasometers"@en .

aat:300197850 a skos:Concept ;
    skos:definition "Instruments that record the duration of sunshine and provide qualitative measurements of the amount of sunshine by the action of the sun's rays on blueprint paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliographs"@en .

aat:300197853 a skos:Concept ;
    skos:definition "Bed coverings used as the topmost cover of a bed during the day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedcovers"@en .

aat:300197871 a skos:Concept ;
    skos:definition "Heavy ruglike bedcovers, done in a variety of techniques such as flat or pile weaves or needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed rugs"@en .

aat:300197889 a skos:Concept ;
    skos:definition "Term used from the mid-19th century onward for a variety of bedcovers, especially those which are large, lightweight cloths that cover the full bed and pillow and often extend to the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedspreads"@en .

aat:300197900 a skos:Concept ;
    skos:definition "Bedspreads, usually white and generally of cotton, with raised designs done either in weft loop weave or needlework, using a heavy thread resembling the wicks used by candlemakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlewick spreads"@en .

aat:300197910 a skos:Concept ;
    skos:definition "Bedspreads made of plain textile squares folded to frame smaller squares of colored or printed textile, the total effect being somewhat like stained glass windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedral windows"@en .

aat:300197916 a skos:Concept ;
    skos:definition "Lightweight bedcovers for warm weather, especially those which are similar to quilt tops but have bound edges and finished seams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summer spreads"@en .

aat:300197924 a skos:Concept ;
    skos:definition "Lightweight bedspreads composed of small fabric circles, slightly smaller than yo-yos, with turned edges gathered toward the center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yo-yo spreads"@en .

aat:300197942 a skos:Concept ;
    skos:definition "Warm, heavily wadded bedcovers usually consisting of three layers (top, backing, and filling) which are often tufted or tied rather than quilted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comforters"@en .

aat:300197952 a skos:Concept ;
    skos:definition "Comforters filled with the down of the eider duck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eiderdowns"@en .

aat:300197954 a skos:Concept ;
    skos:definition "Woven bedcovers, especially those made of a single piece of fabric, usually of wool and cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coverlets"@en .

aat:300197958 a skos:Concept ;
    skos:definition "All-white cotton coverlets with distinctive geometric designs in weft loop weave. Originally made in Bolton, England, and copied in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolton coverlets"@en .

aat:300197970 a skos:Concept ;
    skos:definition "Coverlets woven with a weft of recycled cloth strips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rag coverlets"@en .

aat:300197978 a skos:Concept ;
    skos:definition "Rag coverlets in the Scottish tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clouties"@en .

aat:300197990 a skos:Concept ;
    skos:definition "Bedcovers consisting of three layers (top, backing, and filling) joined by quilting, which is stitching that typically forms decorative patterns or designs. The term is also used loosely to refer to similar bedcovers joined by other means. Quilts are distinguished from \"comforters,\" which are warmer, heavily wadded bedcovers on which the design of the stitching is not as elaborate or decorative. In addition to serving as bedcovers, quilts may also be used as wall hangings or for another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilts"@en .

aat:300197995 a skos:Concept ;
    skos:definition "Quilts constructed of blocks, made and signed by a number of different people as a remembrance, as would be the pages of an autograph album. Often pieced or appliquéd with pictorial motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "album quilts"@en .

aat:300197998 a skos:Concept ;
    skos:definition "Knotted pile weaving suspended in a doorway from a rod about 10 inches above the threshold in order to keep out dust and animals; rug is up to 12 inches long by 35 inches wide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "germetch"@en .

aat:300198003 a skos:Concept ;
    skos:definition "Particularly fine album quilts made by a group of women living in the Baltimore area in the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baltimore album quilts"@en .

aat:300198016 a skos:Concept ;
    skos:definition "Quilts illustrating Bible stories or including scriptural quotations, adages, maxims, or proverbs conveying religious or moral precepts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bible quilts"@en .

aat:300198040 a skos:Concept ;
    skos:definition "Quilts made to commemorate events ranging from international to local significance, for example wars, political campaigns, or centennials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative quilts"@en .

aat:300198049 a skos:Concept ;
    skos:definition "Quilts made to commemorate a two-hundredth anniversary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicentennial quilts"@en .

aat:300198055 a skos:Concept ;
    skos:definition "Quilts made to commemorate a hundredth anniversary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centennial quilts"@en .

aat:300198059 a skos:Concept ;
    skos:definition "Quilts made for a young man by family or friends when he comes of age, completes his apprenticeship, or leaves home. Often decorated with patriotic symbols and subjects of manly interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freedom quilts"@en .

aat:300198062 a skos:Concept ;
    skos:definition "Quilts made as tokens of friendship, often for someone leaving the community. Often with signatures, dates, and locations embroidered or inked on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friendship quilts"@en .

aat:300198066 a skos:Concept ;
    skos:definition "Quilts made to raise money for favored causes, often by groups; often in the form of signature quilts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fundraising quilts"@en .

aat:300198082 a skos:Concept ;
    skos:definition "Quilts worked by the bereaved during a period of mourning, often black, white, or gray, with appropriate patterns or motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning quilts"@en .

aat:300198087 a skos:Concept ;
    skos:definition "Mourning quilts made from clothing of the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memory quilts"@en .

aat:300198091 a skos:Concept ;
    skos:definition "Quilts expressing patriotic sentiments, usually decorated with such elements as flags and other national symbols, portraits of national leaders, or political slogans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patriotic quilts"@en .

aat:300198100 a skos:Concept ;
    skos:definition "Quilts depicting flags or incorporating real flags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flag quilts"@en .

aat:300198105 a skos:Concept ;
    skos:definition "Patriotic Hawaiian quilts depicting the Hawaiian flag, sometimes with the royal coat of arms or other royal symbol at the center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hawaiian flag quilts"@en .

aat:300198116 a skos:Concept ;
    skos:definition "Quilts made for the Red Cross, often in times of war, either as fundraisers or as warm coverings for soldiers or others, often with the Red Cross design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Red Cross quilts"@en .

aat:300198119 a skos:Concept ;
    skos:definition "Quilts made by members of a community as a gift for a minister, teacher, or mayor who was retiring or moving away. Often in the form of album quilts or signature quilts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation quilts"@en .

aat:300198123 a skos:Concept ;
    skos:definition "Quilts consisting of a variety of patterns, the idea being to show as many as possible. Sometimes the work of a notable quilt maker who wished to pass on samples of her best or most difficult designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sampler quilts"@en .

aat:300198129 a skos:Concept ;
    skos:definition "Quilts made principally for warmth, not as show pieces. Made of anything from old clothing to feed sacks, often filled with homegrown cotton or wool, an old blanket, or a worn quilt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility quilts"@en .

aat:300198134 a skos:Concept ;
    skos:definition "Quilts composed of three-dimensional puffs, small silk squares slightly gathered and stuffed with batting, pieced together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puff quilts"@en .

aat:300198145 a skos:Concept ;
    skos:definition "Ancient single-string instruments, first mentioned in 5th century BCE Greece, used variously throughout history as a musical instrument, a device for measuring and demonstrating musical intervals, and an organ tuner's and piano tuner's adjunct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monochords"@en .

aat:300198146 a skos:Concept ;
    skos:definition "Aerophones in which free reeds fitted in pipes or chambers are sounded individually or in combination by the player's blowing or sucking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouth organs"@en .

aat:300198147 a skos:Concept ;
    skos:definition "Pieced quilts made of small scraps of leftover textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrap quilts"@en .

aat:300198158 a skos:Concept ;
    skos:definition "Scrap quilts theoretically composed of 999 different printed cottons, no two of which could be alike. Always done in one-patch designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charm quilts"@en .

aat:300198169 a skos:Concept ;
    skos:definition "Quilts in which the pattern is organized in strips running the length of the quilt. May consist only of unpieced strips, or of unpieced strips alternating with pieced strips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strip quilts"@en .

aat:300198175 a skos:Concept ;
    skos:definition "Quilts with tops made of a single textile, with neither pieced nor appliquéd designs, decorated solely with quilting. A different textile may be used as backing or border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wholecloth quilts"@en .

aat:300198186 a skos:Concept ;
    skos:definition "Quilts composed of pieces cut from many different textiles, often including rich velvets, satins, or brocades, usually in irregular shapes and sizes, and often embellished with fancy embroidery stitches. Done in press piecing, usually tied rather than quilted, and rarely contain batting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crazy quilts"@en .

aat:300198193 a skos:Concept ;
    skos:definition "Crazy quilts constructed of square blocks, long strips, stars, or diamonds, or having some other regular format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contained crazy quilts"@en .

aat:300198201 a skos:Concept ;
    skos:definition "Pieced quilts composed of blocks divided by one main horizontal and one main vertical seam to form a grid of four squares of equal or nearly equal size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "four-patch quilts"@en .

aat:300198208 a skos:Concept ;
    skos:definition "Rugs that are utilized as tablecloths or otherwise to protect the surface of a table or other furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sofrehs"@en .

aat:300198210 a skos:Concept ;
    skos:definition "Term of convenience for Polonaise carpets used in the ointment ceremonies of Danish kings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coronation carpets"@en .

aat:300198216 a skos:Concept ;
    skos:definition "Quilts, rarely of more than two colors, consisting of an allover symmetrical design cut from unpatterned folded cloth, appliquéd to the center of a plain background cloth, which is often white. Frequently made in Hawaii and in North America, especially by the Pennsylvania Germans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hawaiian quilts"@en .

aat:300198220 a skos:Concept ;
    skos:definition "Quilts made of blocks constructed of strips of fabric arranged in a way that simulates the construction of a log cabin; usually done by press piecing, tied rather than quilted, and rarely containing batting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log cabin quilts"@en .

aat:300198233 a skos:Concept ;
    skos:definition "Pieced quilts composed of blocks divided by two horizontal and two vertical seams into a grid of nine major areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nine-patch quilts"@en .

aat:300198243 a skos:Concept ;
    skos:definition "Pieced quilts composed of a single design unit of a given size set together in rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-patch quilts"@en .

aat:300198253 a skos:Concept ;
    skos:definition "Quilts with depictions of recognizable figures, objects, or scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial quilts"@en .

aat:300198268 a skos:Concept ;
    skos:definition "Quilts decorated with the letters of the alphabet, sometimes illustrated with appropriate objects, such as an apple with the letter A."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphabet quilts"@en .

aat:300198274 a skos:Concept ;
    skos:definition "Blunt hand saws which are played as musical instruments, one end being held between the player's knees while the other is grasped and flexed by the left hand; the edge is bowed with a violin or cello bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical saws"@en .

aat:300198281 a skos:Concept ;
    skos:definition "Quilts incorporating a large number of names, autographs or signatures. Often made in order to raise funds for a church or charity, with the subscriber paying a small fee to have his or her name embroidered or inked on the quilt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signature quilts"@en .

aat:300198282 a skos:Concept ;
    skos:definition "Vessels used to contain foods or seasonings that add additional flavor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condiment vessels"@en .

aat:300198293 a skos:Concept ;
    skos:definition "Quilts similar to log cabin quilts in design and technique, except for the use of irregular shapes and a more random design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "string quilts"@en .

aat:300198294 a skos:Concept ;
    skos:definition "Dishes used for presenting food, especially on a table for serving to people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving dishes"@en .

aat:300198299 a skos:Concept ;
    skos:definition "Pieced quilts composed of blocks divided into three parts by a horizontal, vertical or diagonal seam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-patch quilts"@en .

aat:300198305 a skos:Concept ;
    skos:definition "Pieced quilts composed of blocks divided into two equal or nonequal parts by a seam which may be horizontal, vertical, or diagonal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-patch quilts"@en .

aat:300198334 a skos:Concept ;
    skos:definition "Drinking vessels of varying form but usually bearing a Hebrew inscription, used for drinking wine in Jewish religious ceremonies, on special occasions such as weddings, or in the benediction before the evening meal preceding each Sabbath or holy festival."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiddush cups"@en .

aat:300198370 a skos:Concept ;
    skos:definition "Fiddles of Sweden, known since the 15th century, with keys set in a frame along the neck which players press with the left hand as they bow with the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nyckelharpas"@en .

aat:300198376 a skos:Concept ;
    skos:definition "European tenor oboes of the mid-18th century having a large open bell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oboes da caccia"@en .

aat:300198379 a skos:Concept ;
    skos:definition "Multicolored spotted rugs produced in ancient southwestern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banjis"@en .

aat:300198387 a skos:Concept ;
    skos:definition "Flutes with a globular body, made of clay, porcelain, wood, or a natural vessel-shaped object such as a gourd or coconut, in which the air stream is directed against the sharp edge of a round blowhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vessel flutes"@en .

aat:300198388 a skos:Concept ;
    skos:definition "The bottom margins of pages in Medieval manuscripts, often used when illuminations appear in that area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bas-de-pages"@en .

aat:300198389 a skos:Concept ;
    skos:definition "Books containing benedictions, which are solemn invocations of blessedness officially pronounced by an ecclesiastical functionary; often for liturgical use, especially by bishops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benedictionals"@en .

aat:300198390 a skos:Concept ;
    skos:definition "Concordance tables showing parallel passages from the four Gospels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canon tables"@en .

aat:300198395 a skos:Concept ;
    skos:definition "Use collectively for the copies of a literary work or other bibliographic item first printed and issued together, or use individually for one of those copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first editions"@en .

aat:300198397 a skos:Concept ;
    skos:definition "Books having an extra covering of leather allowing the book to be hung from the girdle and read while still attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girdle books"@en .

aat:300198398 a skos:Concept ;
    skos:definition "Initial letters that contain figures of human, animal, or hybrid creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inhabited initials"@en .

aat:300198407 a skos:Concept ;
    skos:definition "Ornament filling the ends of lines in illuminated manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line fillings"@en .

aat:300198409 a skos:Concept ;
    skos:definition "Refers to Roman majuscule letters used for monumental inscriptions and adapted as an early book hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square capitals"@en .

aat:300198412 a skos:Concept ;
    skos:definition "Books intended primarily for consultation rather than for consecutive reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reference books"@en .

aat:300198419 a skos:Concept ;
    skos:definition "Chromatic horns developed in the 19th century, incorporating several different lengths of tubing in the form of fixed crooks and various devices such as plungers, sliding shutters, and valves to bring any desired tube length into play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "omnitonic horns"@en .

aat:300198429 a skos:Concept ;
    skos:definition "Narrow-necked stoneware bottles, globular or pear-shaped, ornamented with a bearded mask and often a coat of arms; of a type made in the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellarmines"@en .

aat:300198438 a skos:Concept ;
    skos:definition "Individual copies of books or other publications, including prints, inscribed for presentation, usually by the author, sometimes presented by the publisher. For other articles inscribed for special presentation, especially silver, pottery, or specially struck coins or medals, use \"presentation pieces.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation copies"@en .

aat:300198439 a skos:Concept ;
    skos:definition "Lidless kettles intended primarily for boiling fruits and their syrup for preserves; made of tin, brass, or enameled ware, but never iron or aluminum as both metals are affected by the acid of the fruits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preserving kettles"@en .

aat:300198440 a skos:Concept ;
    skos:definition "Single-leaf forerunners of newspapers. For similar items consisting of more than one leaf, use \"newsbooks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corantos"@en .

aat:300198445 a skos:Concept ;
    skos:definition "Shallow dishes for candies or other sweets; may have a lid or stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonbon dishes"@en .

aat:300198452 a skos:Concept ;
    skos:definition "Receptacles, usually metal or terracotta, having a base designed to hold live coals, and sometimes with a grate or pierced top, used for heating a room or for heating or cooking food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braziers"@en .

aat:300198466 a skos:Concept ;
    skos:definition "Wooden staved tubs with close-fitting tops used for butter storage or sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter tubs"@en .

aat:300198471 a skos:Concept ;
    skos:definition "Trays that accommodate tea services. Some examples may be components of a tea table, detachable from the base or legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea trays"@en .

aat:300198489 a skos:Concept ;
    skos:definition "Shallow vessels made in the form of an open basket with a high, bail handle; presumably for serving cakes and cookies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake baskets"@en .

aat:300198495 a skos:Concept ;
    skos:definition "Bottles for serving wine or water at the table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carafes"@en .

aat:300198497 a skos:Concept ;
    skos:definition "Dishes of varying form intended primarily for serving dessert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dessert dishes"@en .

aat:300198502 a skos:Concept ;
    skos:definition "Jars, often ceramic but sometimes of silver or other materials, usually of ovoid shape with flattened shoulders, an upright collar, and a dome or cap cover; of a type traditionally used by the Chinese for preserving ginger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ginger jars"@en .

aat:300198507 a skos:Concept ;
    skos:definition "Containers intended primarily for storing or serving honey. They usually have a cover, may have an indentation for the handle of a serving spoon, and sometimes a saucerlike stand. Often made to resemble a beehive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honeypots"@en .

aat:300198514 a skos:Concept ;
    skos:definition "Utensils used to hold food out of its cooking liquid, usually oval, but sometimes circular, consisting of a pierced plate that rests in a deeper and wider serving dish. Often of silver with elaborate pierced work, sometimes depicting a net holding fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mazarines"@en .

aat:300198519 a skos:Concept ;
    skos:definition "Small plates intended primarily for serving an individual portion of salad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salad plates"@en .

aat:300198528 a skos:Concept ;
    skos:definition "Small dishes intended primarily for an individual serving of stewed fruit or similar foods made with a sauce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sauce dishes"@en .

aat:300198537 a skos:Concept ;
    skos:definition "Plates intended primarily for serving an individual portion of soup, having a shallow well and usually a wide rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soup plates"@en .

aat:300198544 a skos:Concept ;
    skos:definition "Bowls supported by a stem and foot; used especially with reference to those used for serving fruit or sweetmeats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing bowls"@en .

aat:300198548 a skos:Concept ;
    skos:definition "Hand-sized cups having a bowl shape, usually without a handle, used for drinking tea; sometimes accompanied by a matching saucer. Often, but not always, from Asia or having an Asian theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea bowls"@en .

aat:300198557 a skos:Concept ;
    skos:definition "Utensils, usually ceramic, and often decorative, in several parts used for keeping warm the contents of a bowl, teapot, or cup which rests on a hollow pedestal containing a heat source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veilleuses"@en .

aat:300198560 a skos:Concept ;
    skos:definition "Large bowl-shaped vessels used in cooking Chinese food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woks"@en .

aat:300198563 a skos:Concept ;
    skos:definition "Flattened, gourd-shaped bottles with one or two pairs of lugs at each side through which might be passed a strap whereby they could be slung over the shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrim bottles"@en .

aat:300198586 a skos:Concept ;
    skos:definition "Boxes or cases for holding cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese boxes"@en .

aat:300198591 a skos:Concept ;
    skos:definition "Air tight devices for quick cooking or preserving of foods by means of superheated steam under pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure cookers"@en .

aat:300198598 a skos:Concept ;
    skos:definition "Music boxes with two rows of free reeds worked by suction wind, two hand-cranked bellows, and strips of perforated paper fed by the cranks that actuate the bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchestral organettes"@en .

aat:300198625 a skos:Concept ;
    skos:definition "Pointers that indicate the hours on clocks or watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hour hands"@en .

aat:300198626 a skos:Concept ;
    skos:definition "Sandglasses for which one hour is required for the given quantity to fall from the upper to the lower vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hourglasses"@en .

aat:300198627 a skos:Concept ;
    skos:definition "Instruments for measuring the density or specific gravity of liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrometers"@en .

aat:300198628 a skos:Concept ;
    skos:definition "Instruments that measure the amount of water vapor in the air and thus indicate relative humidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hygrometers"@en .

aat:300198630 a skos:Concept ;
    skos:definition "Recording hygrometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hygrographs"@en .

aat:300198632 a skos:Concept ;
    skos:definition "Instruments for measuring atmospheric pressure, and thus sometimes altitude, by its effect on the boiling point of liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypsometers"@en .

aat:300198639 a skos:Concept ;
    skos:definition "Instruments that measure vertical angles by taking a sight and reading against a vertical pendulum or by measuring the angle between the earth's magnetic field vector and the horizontal plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inclinometers"@en .

aat:300198641 a skos:Concept ;
    skos:definition "Calipers whose legs turn outward to be used to measure inside dimensions, usually diameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inside calipers"@en .

aat:300198642 a skos:Concept ;
    skos:definition "Vessels used for funerals and burials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary vessels"@en .

aat:300198646 a skos:Concept ;
    skos:definition "Pulsed radar devices for measuring the vertical height of ionospheric layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ionosondes"@en .

aat:300198647 a skos:Concept ;
    skos:definition "Instruments for measuring temperature by utilizing the variation of the physical properties of substances according to their thermal states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermometers"@en .

aat:300198648 a skos:Concept ;
    skos:definition "Large-bulbed alcohol thermometers used to measure low air velocities or the cooling effect of particular atmospheric conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "katathermometers"@en .

aat:300198670 a skos:Concept ;
    skos:definition "Small metal clocks whose case is an openwork frame resembling lanterns; popular in England and France in the 17th century as successor to Gothic clocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lantern clocks"@en .

aat:300198675 a skos:Concept ;
    skos:definition "Copper-zinc-tin alloy, sometimes also including lead, made by melting ground calamine ore with charcoal and copper; used in the Medieval period for weights and utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latten"@en .

aat:300198676 a skos:Concept ;
    skos:definition "Straight poles graduated with numerical marks that are held upright and used with leveling instruments to measure heights and elevations, especially during surveying. For similar poles having numerical and various geometrical markings suited for measuring horizontal distances with other stadia equipment, use \"stadia rods.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leveling rods"@en .

aat:300198698 a skos:Concept ;
    skos:definition "Instruments used to measure the speed of ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logs"@en .

aat:300198699 a skos:Concept ;
    skos:definition "Instruments for measuring the amount of water-soluble matter in soil, as, for example, to test the percolation quality of ground water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lysimeters"@en .

aat:300198715 a skos:Concept ;
    skos:definition "In general, the term usually refers to a culture or style produced by people who were born in the Americas or nearby islands, but who were descended from colonists or slaves, as distinguished from people who arrived directly from Europe or Africa, or who were descended from aboriginal populations. It is used to refer to the cultures of different populations in the context of different regions; its usage is often contradictory from region to region. It refers to the culture and styles produced by white people who had Spanish parents and were born in the Spanish territories of North and South America in the sixteenth through eighteenth centuries; their culture and social position were distinguished from residents who had been born in Spain. In modern usage in the context of Latin America, it may refer to the culture of people born locally but of pure Spanish extraction or specifically to traditions of old-line families of predominantly Spanish descent. The term may also refer to the culture of early South American blacks born in America, as distinguished from blacks brought directly from Africa. In Louisiana in the United States it refers to the culture of either French-speaking white descendants of early French and Spanish settlers or of mulattos speaking a form of French and Spanish patois. It may also refer to the culture of people in the West Indies who were born and naturalized there, but were of Spanish, French, or African descent; in modern usage in the context of the Caribbean, it is often used to refer to Caribbean culture in general, including elements from European, African, Asian, and Amerindian sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Creole"@en .

aat:300198720 a skos:Concept ;
    skos:definition "Refers to the style in 19th-century European architecture and decorative arts characterized by Hispano-Moresque forms and motifs such as honey comb vaulting, arabesques, and horseshoe arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moorish Revival"@en .

aat:300198725 a skos:Concept ;
    skos:definition "Reports that comprehensively document and analyze immovable constructed works in terms of such factors as the evolution of their form, current condition, materials, and structural stability in order to establish priorities and costs for renovation or preservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic structure reports"@en .

aat:300198733 a skos:Concept ;
    skos:definition "Cases or coverings for the blade of a sword, dagger, or other instrument to which it fits closely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheaths"@en .

aat:300198740 a skos:Concept ;
    skos:definition "Small cheaply made high-pitched fipple flutes, usually made of metal or plastic and having six fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penny whistles"@en .

aat:300198744 a skos:Concept ;
    skos:definition "Small American reed organs with a single keyboard and one or two sets of reeds, activated by wind supplied by a suction bellows rather than pressure; they are often ornately decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melodeons"@en .

aat:300198749 a skos:Concept ;
    skos:definition "Containers used in the context of gardening and the cultivation of gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horticultural containers"@en .

aat:300198750 a skos:Concept ;
    skos:definition "Devices that measure horizontal distances or lengths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear distance measuring devices"@en .

aat:300198782 a skos:Concept ;
    skos:definition "Accurate surveying instruments that measure distances by using modulated, continuous-wave radio signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tellurometers"@en .

aat:300198791 a skos:Concept ;
    skos:definition "Trade term for vessels, generally of glass or crystal, usually having a bowl mounted on a footed stem; especially those used for serving beverages and desserts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stemware"@en .

aat:300198805 a skos:Concept ;
    skos:definition "Small, stoppered vessels for wine and water used in the celebration of the Eucharist. According to the regulations for the Roman Catholic service, two are always employed and it is recommended that they should be made of glass, although precious materials such as silver or gold may be employed if they are clearly marked to indicate which is water and which is wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar cruets"@en .

aat:300198813 a skos:Concept ;
    skos:definition "Vessels reserved for the eucharist, used to hold the hosts for distribution to the faithful during a liturgy; often taking the form of a cup with an arched cover. The term may also be used for vessels taking the form of a temple or tabernacle, sometimes suspended from the roof of ciboria (structures). For shallow or deeper bowls used to hold the hosts for distribution to the faithful in place of the ciborium, use \"communion bowls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciboria"@en .

aat:300198814 a skos:Concept ;
    skos:definition "Containers of various designs used for burning incense and distributing the scent; known in cultures globally, often for ceremonial use. Usually of metal or ceramic. May have perforated covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "censers"@en .

aat:300198816 a skos:Concept ;
    skos:definition "Relatively small vessel used in Christian contexts, containing the holy water used for sprinkling in ceremony and liturgy. The holy water bucket is always accompanied by an aspergillum, with which the water is sprinkled. When larger in size, shaped like an inverted cone or bucket, it is called a \"situla.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aspersoriums"@en .

aat:300198817 a skos:Concept ;
    skos:definition "A vessel or stand in or on which incense is burnt for the purpose of scenting a space, whether or not the action also has a ceremonial purpose. For containers, often in the form of a covered vase or sometimes in the form of a tripod, that hold perfumes or pastilles, use \"cassolettes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense burners"@en .

aat:300198818 a skos:Concept ;
    skos:definition "Boat-shaped containers, sometimes partly covered by a lid, for holding incense before it is placed in a censer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense boats"@en .

aat:300198819 a skos:Concept ;
    skos:definition "Large, circular, dishlike vessels upon which money, collected in church from the congregation in smaller containers, is assembled and presented at the altar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alms dishes"@en .

aat:300198820 a skos:Concept ;
    skos:definition "Ornamental or utilitarian containers in the form of a fanciful model of a ship; some were made as drinking vessels, while others were made as receptacles for salt, dining implements, or napkins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nefs"@en .

aat:300198821 a skos:Concept ;
    skos:definition "Hollow vessels shaped somewhat like a decanter with a long, thin neck and an aperture at both ends; used for transferring punch or similar beverages from a bowl to a cup or glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toddy lifters"@en .

aat:300198822 a skos:Concept ;
    skos:definition "Small or moderate-sized vessels mainly for medicinal and toilet preparations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vials"@en .

aat:300198823 a skos:Concept ;
    skos:definition "Refers to distinctive drug jars produced primarily in the Middle East, Spain, and Italy, generally between the 15th and 18th centuries. They were used to hold ointments and dry powders for medicinal use or for pigments for painting. They are typically around 7 or 8 inches tall, are often made of maiolica or faience, and are cylindrical in shape, but with concave or incurved sides to enable easy grasping; they are typically wide-mouthed for easy access. They occasionally have close-set handles, but were not intended to hold liquids and, therefore, do not have spouts, lips, handles, or convex forms. They typically do not have lids; instead, a piece of paper or parchment was tied around the rim to cover for the jar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albarelli"@en .

aat:300198824 a skos:Concept ;
    skos:definition "Small bottles or vials for holding smelling salts or perfume bottles filled with smelling salts or a scent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smelling bottles"@en .

aat:300198826 a skos:Concept ;
    skos:definition "Relatively large, deep, globular-shaped baskets, tightly twined and intended primarily for cooking food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking baskets"@en .

aat:300198827 a skos:Concept ;
    skos:definition "Circular and shallow all-purpose baskets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring baskets"@en .

aat:300198828 a skos:Concept ;
    skos:definition "Bottles covered with wicker and holding from 1 quart to 10 gallons; intended to contain noncorrosive and bland liquids. For similar large bottles covered with wicker, wood, or other protective material and intended for corrosive liquids, acids or distilled water, use \"carboys.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demijohns"@en .

aat:300198829 a skos:Concept ;
    skos:definition "Narrow trays designed or used for pens, often forming part of an inkstand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen trays"@en .

aat:300198830 a skos:Concept ;
    skos:definition "Small boxes with perforated lids formerly used to contain pounce or fine sand sprinkled on wet ink to blot it; sometimes made as a unit of an inkstand or desk set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounce boxes"@en .

aat:300198831 a skos:Concept ;
    skos:definition "Small pots with perforated covers used to contain pounce or fine sand sprinkled on wet ink to blot it; sometimes made as a unit of an inkstand or desk set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounce pots"@en .

aat:300198832 a skos:Concept ;
    skos:definition "Boxes for holding instruments and materials for work, especially needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workboxes"@en .

aat:300198833 a skos:Concept ;
    skos:definition "Boxes intended primarily for holding sewing notions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing boxes"@en .

aat:300198834 a skos:Concept ;
    skos:definition "Protective boxes with a hinged top, shaped like a thick book, for storing books, prints, pamphlets, and documents; developed in the 18th century for the storage of botanical specimens and later for the storage of books, prints, and documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solander boxes"@en .

aat:300198835 a skos:Concept ;
    skos:definition "Boxes or cases, usually lidded, in which tools are kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toolboxes"@en .

aat:300198836 a skos:Concept ;
    skos:definition "Bins, boxes, or the like, for storing wood fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodbins"@en .

aat:300198837 a skos:Concept ;
    skos:definition "Large baskets used for storage; used especially with reference to covered baskets with square or round bases and rims."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage baskets"@en .

aat:300198839 a skos:Concept ;
    skos:definition "Wash basins, often set into a decorative surround and often found in ceremonial contexts; may have more than one spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavaboes"@en .

aat:300198840 a skos:Concept ;
    skos:definition "Ancient Greek drinking vessels featuring a deep, footed bowl set on a tall footed stem and two vertical side handles extending from the bottom of the vessel to the rim. The kantharos is intimately associated with the wine god Dionysos, who is often depicted on vases holding a kantharos of type A or a rhyton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kantharoi"@en .

aat:300198841 a skos:Concept ;
    skos:definition "Vessels from Ancient Greece, eastern Europe, or the Middle East that were typically made as a closed form with two openings, one at the top for filling and one at the base so that liquid could stream out. They are often in the shape of a horn or an animal's head, and were typically used as a drinking cup or for pouring wine into another vessel. Drinking was done by holding the rhyton above the drinker's head and catching the stream of liquid in the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhyta"@en .

aat:300198842 a skos:Concept ;
    skos:definition "Ancient Greek drinking vessels in the form of a broad, shallow bowl set on a high foot or pedestal with two upcurving handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kylikes"@en .

aat:300198843 a skos:Concept ;
    skos:definition "Ancient Greek wide-mouthed vessels with slightly flaring sides and sometimes a spout on one side near the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalathoi"@en .

aat:300198844 a skos:Concept ;
    skos:definition "Ancient Greek or Roman vessels for water with three handles: two horizontal side handles for lifting and one vertical back handle for holding and pouring. Many hydriae were also made in bronze in addition to terracotta and, unlike the metal versions of other shapes, a good number survive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydriae"@en .

aat:300198846 a skos:Concept ;
    skos:definition "Refers to a type of hydria featuring a neck forming a continuous curve with the body. This shape also features a smaller mouth and narrower neck than the shoulder hydria. It was the most common form of hydria for red-figure. Although the kalpis was introduced after the invention of red-figure, there are some red-figure kapides. Many kalpides were also made in bronze in addition to terracotta and, unlike the metal versions of other shapes, a good number survive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalpides"@en .

aat:300198848 a skos:Concept ;
    skos:definition "Neck amphorae with splaying, conical necks, high bodies, and two flat strap handles extending from the shoulders and joined into the lip. They are known mostly in black-figure. The shape was adapted by the potter Nikosthenes from a native Etruscan shape. It is thought that nikosthenic amphorae were produced especially for the Etruscan market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nikosthenic amphorae"@en .

aat:300198849 a skos:Concept ;
    skos:definition "Neck amphorae with a relatively small neck and handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nolan amphorae"@en .

aat:300198850 a skos:Concept ;
    skos:definition "Term applied to amphorae in which the neck is offset from the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck amphorae"@en .

aat:300198852 a skos:Concept ;
    skos:definition "Amphorae in which the neck and body merge into a continous, unbroken curve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous curve amphorae"@en .

aat:300198853 a skos:Concept ;
    skos:definition "Ancient Greek storage vessels for wine, water, or oil, similar to amphorae but with a pointed bottom and characterized by two side handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diotae"@en .

aat:300198855 a skos:Concept ;
    skos:definition "Any of various large ancient Greek wide-mouthed vessels with two side handles, usually horizontal, generally used for mixing wine and water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kraters"@en .

aat:300198856 a skos:Concept ;
    skos:definition "Kraters with volute-shaped handles extending from the shoulders to above the rim. They are rare in black-figure but common in red-figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volute kraters"@en .

aat:300198857 a skos:Concept ;
    skos:definition "Red-figure kraters in the form of an inverted bell with handles placed high on the body. The rim is offset and the foot is stepped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell kraters"@en .

aat:300198858 a skos:Concept ;
    skos:definition "Kraters so named for their resemblance to a calyx flower. The form is said to have been developed by Exekias in black-figure; it is, however, more characteristically a red-figure shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calyx kraters"@en .

aat:300198859 a skos:Concept ;
    skos:definition "Kraters with columnlike handles extending from the shoulders to the rim. The feet are echinus shaped. This vessel type was especially popular in black-figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "column kraters"@en .

aat:300198862 a skos:Concept ;
    skos:definition "Ancient Greek vessels in the form of a shallow bowl with two horizontal handles and a lid. Such vessels are often depicted on vases in connection with weddings, as containers for articles used by women for dressing and grooming, and as containers for small items such as toys, spices, or thread. Lekanai were also used for serving food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lekanai"@en .

aat:300198863 a skos:Concept ;
    skos:definition "Small ancient Greek flasklike vessels with a circular body, wider than high, with a convex top and an arched handle extending from one side across the top to a spout on the other side; used for pouring perfumed oil. Askoi were often grave offerings and sometimes shaped like birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "askoi"@en .

aat:300198864 a skos:Concept ;
    skos:definition "Ancient Aegean vessels with a false spout rising on top to support two stirrup-shaped handles and having a narrow, easily sealed spout further down on the shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stirrup jars"@en .

aat:300198865 a skos:Concept ;
    skos:definition "Term used to describe ancient Mediterranean vessels in the form of heads or animals or groups that were partially formed in molds like terracotta statuettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic vases"@en .

aat:300198866 a skos:Concept ;
    skos:definition "Ancient Greek one-handled vessels used for ladling and pouring wine or water; made in a variety of jug- and pitcherlike forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai"@en .

aat:300198867 a skos:Concept ;
    skos:definition "Oinochoai with a continuous S-curved slender body and a high handle which extends above the round mouth. They were used for pouring wine or water. Olpai were popular at Corinth and also in Athens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olpai"@en .

aat:300198869 a skos:Concept ;
    skos:definition "Ancient Greek vessels used for cooling wine, having a body drawn in toward the base and set on a high pedestal or foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psykters"@en .

aat:300198870 a skos:Concept ;
    skos:definition "Pail-like or cone-shaped vessels, often having handles, made of bronze, silver, ceramic, glass, or another material. They were often decorated; used in the Iron Age, ancient Egypt, Asia, in the ancient Roman world, and in Christian religious rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "situlae"@en .

aat:300198871 a skos:Concept ;
    skos:definition "Ancient Greek containers in the form of a shallow bowl without handles, often with a base whose center is pushed up into the body. It is used for drinking or pouring libations of wine or olive oil in ancient Greek ritual; the libations were poured over an altar to honor the gods or a burial site to satisfy the souls of the deceased. For similar ancient Roman containers, use \"paterae (containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phialae"@en .

aat:300198873 a skos:Concept ;
    skos:definition "Small ancient Greek covered vessels with an inturned rim; they were used for cosmetics, oils, and perfumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kothona"@en .

aat:300198874 a skos:Concept ;
    skos:definition "Ancient Greek vessels set on a high foot or pedestal and with a bulbous body and a disk-shaped rim around the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lydia"@en .

aat:300198880 a skos:Concept ;
    skos:definition "Articles designed to serve as receptacles for keeping or storing liquid or other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage vessels"@en .

aat:300198881 a skos:Concept ;
    skos:definition "Ancient Greek vessels for the storage of liquids usually having an ovoid body with high shoulders, a short neck, wide mouth, two side handles, and sometimes a cover. Generally smaller than amphorae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamnoi"@en .

aat:300198882 a skos:Concept ;
    skos:definition "Large ancient Greek earthenware storage jars, spherical in form and having a wide mouth, for bulk storage of liquids and solids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pithoi"@en .

aat:300198883 a skos:Concept ;
    skos:definition "Ancient Greek pear-shaped storage vessels with a broad mouth forming a continuous curve with the body; introduced into Attic black-figure pottery at the end of the 6th century BCE, though painted primarily in the red-figure technique. They were principally used for storage of liquids although they were suitable for other commodities. From ca. 450 BCE, pelikai were also used as a container for the ashes of the dead. The shape is related to that of amphora type C."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pelikai"@en .

aat:300198884 a skos:Concept ;
    skos:definition "A form of broad-footed lekythoi common in red-figure painting, featuring a broad body and curving shoulders, lacking the sharp shoulder of the cylindrical type. It begins to be made late in the fifth century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squat lekythoi"@en .

aat:300198885 a skos:Concept ;
    skos:definition "Relatively small ancient Greek vessels with a globular body, a short neck, a flat disk-shaped mouth with a small orifice, and a handle (or sometimes two) extending from the shoulder to the rim; used for holding oils, perfumes, and ointments. They are usually made of terracotta. Uses of the aryballoi included in funeral rituals and by athletes who wore them on their wrists, suspended by thongs or strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aryballoi"@en .

aat:300198887 a skos:Concept ;
    skos:definition "Small ancient Greek or Roman vessels for holding oils, ointments, or perfumes; usually elongated in form, almost cylindrical, and rounded at the bottom. Some footed examples also exist. They either have no handles or one small handle at the side. Alabastra are small enough to be held in one hand or it could be carried by a string looped around its narrow neck or passed through smal lugs on the shoulder. The shape originated in Egypt, where it was made in glass, faience, or alabaster (it takes its name from this stone)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alabastra"@en .

aat:300198888 a skos:Concept ;
    skos:definition "Vessels with turned-in rim, high foot, and lid used for holding perfume for both personal use and religious rites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plemochoai"@en .

aat:300198889 a skos:Concept ;
    skos:definition "Relatively small, squat lidded boxlike vessels for holding cosmetics and toilet articles in ancient Greece. Generally cylindrical in shape. Often found in the graves of women and warriors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyxides"@en .

aat:300198891 a skos:Concept ;
    skos:definition "Shallow containers designed to be used for urination or defecation by persons confined to bed. For containers found in a bed chamber, but not necessarily designed for use in the bed, prefer \"chamber pots.\" For portable vessels for urine, prefer \"urinals (containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedpans"@en .

aat:300198892 a skos:Concept ;
    skos:definition "Small urinary containers for female use; design may be of compressed elliptical shape with an incurved rim on the front end. Generally made of ceramic or occasionally silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bourdalous"@en .

aat:300198893 a skos:Concept ;
    skos:definition "Portable bowls kept in a bedroom and used for the discharge of urine, excrement, etc., especially at night. Usually having shaped convex sides, a flat bottom, and a single loop or scroll handle; some have covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamber pots"@en .

aat:300198894 a skos:Concept ;
    skos:definition "Boxes, usually shallow and often round, for holding pills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillboxes"@en .

aat:300198895 a skos:Concept ;
    skos:definition "Small bottles for perfume made in a variety of forms and materials. They generally have a tiny orifice to retard the flow of perfume and usually have a stopper or screw cap. Sometimes made as double or triple bottles, each to contain a different perfume. May be part of a toilet set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scent bottles"@en .

aat:300198896 a skos:Concept ;
    skos:definition "Containers of various designs used to hold urine, usually portable as for travel, in a sick bed, or a bed chamber; may be appropriately shaped for male or female use. They may have a handle. For portable containers intended for both urine and excrement, and usually found in bed chambers, prefer \"chamber pots\"; for such containers found in sick beds, prefer \"bedpans (containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urinals"@en .

aat:300198897 a skos:Concept ;
    skos:definition "Receptacles for smokers' tobacco ashes, made in a great range of sizes and designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ashtrays"@en .

aat:300198898 a skos:Concept ;
    skos:definition "Airtight containers for cigars. For boxlike containers used to hold cigars use \"cigar boxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humidors"@en .

aat:300198899 a skos:Concept ;
    skos:definition "Small bottles or flasks with one or two handles, disk-like or globular in form. In ancient Egypt and Rome, used for perfumes, ointments, or serving drinks. In churches, shrines, coronations, etc. for holding water or other liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ampullae"@en .

aat:300198900 a skos:Concept ;
    skos:definition "Tall and slender vessels with an elongated neck and a flaring mouth, usually in the form of an amphora with two handles, but sometimes in the form of a hydria with three handles. It was often given as gifts at weddings since it held water used for a bride's ritual bath before her wedding. The term is Greek for \"bath bringer.\" Since many girls died before getting married, the loutrophoros symbolized the wedding that she missed and so was often used as a grave marker. The form was common in black-figure pottery of the late 6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loutrophoroi"@en .

aat:300198901 a skos:Concept ;
    skos:definition "Stone or ceramic jars in which the ancient Egyptians preserved the viscera of a deceased person usually for burial with the mummy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canopic jars"@en .

aat:300198902 a skos:Concept ;
    skos:definition "Vessels probably used for carrying water for bathing or washing, since the name is presumably derived from the Greek word for bath. Louterion also seems to be the ancient name for a laver or washbasin on a pedestal. Today the name is more commonly, although uncertainly, applied to two additional shapes. The first is a large, broad basin featuring a spout and two upright handles. It is primarily an early black-figure shape and is relatively rare. The second shape is known in black- and red-figure but is also rare. It is similar to a lebes gamikos but differs in its spouted rim and high, upright flat handles with looped adjuncts. The latter shape may be connected to funerary rites; it may have held water for an offering to the dead or for the ceremonial bathing of the corpse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louteria"@en .

aat:300198903 a skos:Concept ;
    skos:definition "Ancient Greek two-handled cups shaped like a woman's breast. The shape is principally known in black-figure and white-ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mastoi"@en .

aat:300198904 a skos:Concept ;
    skos:definition "Kylikes with a handle zone decorated with a chain of buds, the next zone usually decorated with upside down silhouettes of animals or other figures, and the base of the bowl decorated with rays and separated from the zone above by stripes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "droop cups"@en .

aat:300198905 a skos:Concept ;
    skos:definition "Black-figure kylikes characterized by the shape of their handles which resemble wishbones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merrythought cups"@en .

aat:300198906 a skos:Concept ;
    skos:definition "Black-figure kylikes whose bowl and lip are usually separated, often by a painted line creating two horizontal zones. They either have two separate types of decoration or decoration exists primarily in the lower zone but may overlap into the upper zone. Siana cups are named for the village on the Greek island of Rhodes. The siana cup was one of the forms to predominate in black-figure until about 540 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siana cups"@en .

aat:300198907 a skos:Concept ;
    skos:definition "A type of kylix characterized by a deep bowl, a lip that is not offset, and a short stem and foot. This form dominated black-figure vase painting after about 540 BCE but also continued in red-figure. The ordinary type A kylix is an eye cup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kylikes type A"@en .

aat:300198908 a skos:Concept ;
    skos:definition "Black-figure kylikes characterized by having a lip and body usually covered with simple patterned bands and often with rays above the foot; generally of the 6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassel cups"@en .

aat:300198910 a skos:Concept ;
    skos:definition "Black-figure kylikes characterized by decoration in a band, generally in the zone of the handles. The rest of the vessel is black. Decoration consists of figures, ornaments, or inscriptions, often the potter's signature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "band cups"@en .

aat:300198911 a skos:Concept ;
    skos:definition "Ancient Greek cups similar to mastoi but with a narrow flat foot, flaring lip, and one, two, or no handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mastoid cups"@en .

aat:300198912 a skos:Concept ;
    skos:definition "Kylikes with a lip which curves slightly outward and is clearly tooled off from the body. It also features a reserved bowl and black handles, stem, and foot. Figures were often painted on the lip and/or an inscription, often the potter's signature, is written in the zone between the handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lip cups"@en .

aat:300198913 a skos:Concept ;
    skos:definition "Black-figure kylikes with bandlike decorations, similar in form to siana cups, but differing in the size and profile of the lip; generally of the early to mid-6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gordion cups"@en .

aat:300198915 a skos:Concept ;
    skos:definition "Black-figure kylikes characterized by miniature decoration; generally of the 7th and early 6th centuries BCE. They also feature a slightly offset lip, a moderately deep bowl, and a very tall stem and foot. The little master cup was one of the forms to predominate in black-figure until about 540 BCE. Ther term comes from the English translation of the German word 'kleinmeister.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "little master cups"@en .

aat:300198916 a skos:Concept ;
    skos:definition "Ancient Greek chests, ossuaries, urns, or coffins, usually of terracotta and with painted decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larnakes"@en .

aat:300198917 a skos:Concept ;
    skos:definition "Reed pipes with single reeds, terminating in an upturned bell made of animal horn. They occur in various forms, some having fingerholes, or more than one pipe, or are furnished with a bag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornpipes"@en .

aat:300198918 a skos:Concept ;
    skos:definition "Bronze Age terracotta or earthenware vessels with a series of smal cuplike forms attached, either clustered in the center or around the upper edge of a bowl. The receptacles probably contained foodstuffs of various kinds or perhaps of flowers, intended for ritual offerings. Although the kernos was used in widely disparate regions during the prehistoric period, particularly impressive examples have come to light in the Cyclades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kernoi"@en .

aat:300198921 a skos:Concept ;
    skos:definition "Flat, flexible rectangular containers with a handle used for carrying books, papers, or the like, and often made of leather. For flat, rigid, rectangular containers use \"attaché cases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "briefcases"@en .

aat:300198922 a skos:Concept ;
    skos:definition "Traveling bags, especially ones made of or simulating carpeting; of a type and style popular in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpetbags"@en .

aat:300198923 a skos:Concept ;
    skos:definition "Small bags used especially by sailors to hold thread, needles, tape, or other small articles of gear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ditty bags"@en .

aat:300198924 a skos:Concept ;
    skos:definition "Large, often cylindrical bags; made of canvas, rubberized fabric, or other materials, used to carry personal belongings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duffel bags"@en .

aat:300198925 a skos:Concept ;
    skos:definition "Bags for garments on hangers while in storage or when traveling. Made of cloth, paper, or plastic, often with a zipper down the front and a closed bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garment bags"@en .

aat:300198926 a skos:Concept ;
    skos:definition "Small, medium, or large-sized soft or rigid receptacles, intended for carrying personal articles and usually used as ladies' costume accessories. A bag is closed in on all sides except at the top, where also it generally can be closed, and usually having handles or straps for carrying on the shoulder or in the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bags"@en .

aat:300198927 a skos:Concept ;
    skos:definition "Boxes intended primarily for holding hats while in storage. Also, pieces of hand luggage that are usually round and deep, have handles, and are designed especially for carrying hats, though are often used as traveling bags by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatboxes"@en .

aat:300198929 a skos:Concept ;
    skos:definition "Flat, portable containers used to carry papers, maps, or drawings, usually consisting of two covers joined together at the back and usually tied in the front and the ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portfolios"@en .

aat:300198931 a skos:Concept ;
    skos:definition "Covered containers in the shape of a vase or jar and characterized by pierced decorations on the shoulder or cover, or both. They were intended primarily for liquid or dried potpourri, which is a mixture of flower petals, spices, fruit juices, or other aromatic substances. For similar containers, often vaselike in form, in which aromatic pastilles may be burned or liquid perfumes evaporated, use \"cassolettes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potpourri vases"@en .

aat:300198932 a skos:Concept ;
    skos:definition "Strongly made, lockable boxes or chests for safeguarding valuable possessions, as money, jewels, or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strongboxes"@en .

aat:300198934 a skos:Concept ;
    skos:definition "Term generally applied to vessels, often of silver, having two vertical handles and generally resting on a footed base and sometimes having a cover with a finial. For small two-handled cups typically made of silver and intended for caudle, use \"caudle cups.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-handled cups"@en .

aat:300198935 a skos:Concept ;
    skos:definition "Early Bronze Age Aegean two-handled drinking cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depa"@en .

aat:300198937 a skos:Concept ;
    skos:definition "Large, tin, bowl-shaped vessels with a perforated lid; used to protect and cover bread dough while it rises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread raisers"@en .

aat:300198939 a skos:Concept ;
    skos:definition "Rubber bags or earthenware bottles for holding hot water; used for local application of warmth to the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-water bottles"@en .

aat:300198940 a skos:Concept ;
    skos:definition "Waterproof bags designed to hold ice and used for local application of cold to the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice bags"@en .

aat:300198941 a skos:Concept ;
    skos:definition "Large containers or structures for holding liquids or gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanks"@en .

aat:300198942 a skos:Concept ;
    skos:definition "Shallow saucer-shaped plates used in Christian liturgy on which the large host rests on the altar at times before and after consecration. For a dish or bowl used to hold the hosts during distribution to the faithful, use \"communion bowls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patens"@en .

aat:300198943 a skos:Concept ;
    skos:definition "Cases fitted closely to a swathed mummy usually having the face area modeled and the body portion covered with ritualistic emblems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummy cases"@en .

aat:300198945 a skos:Concept ;
    skos:definition "Small trays used as a receptacle for teaspoons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoon trays"@en .

aat:300198947 a skos:Concept ;
    skos:definition "Boxes intended primarily for holding spices; used especially with reference to boxes with two or more compartments or fitted with a number of drawers or small boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice boxes"@en .

aat:300198948 a skos:Concept ;
    skos:definition "Cake pans with a hinged or clamped side that can be unfastened to facilitate releasing the cake when done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springform pans"@en .

aat:300198949 a skos:Concept ;
    skos:definition "Cooking vessels with a perforated insert to hold food to be steamed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steamers"@en .

aat:300198951 a skos:Concept ;
    skos:definition "Any of various heat-resistant containers intended primarily for baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bakeware"@en .

aat:300198952 a skos:Concept ;
    skos:definition "Small flutes sounding an octave higher than regular orchestral flutes, having the same fingering and keywork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piccolos"@en .

aat:300198953 a skos:Concept ;
    skos:definition "Large pots in which stock for soup or sauce is made or kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stockpots"@en .

aat:300198954 a skos:Concept ;
    skos:definition "Boxes used for storing or carrying smoking or chewing tobacco; the covers may be unattached and fitted or hinged. For similar boxes intended for snuff, use \"snuffboxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco boxes"@en .

aat:300198955 a skos:Concept ;
    skos:definition "Circular cake pans having a hollow cone-shaped centerpiece; used for baking ring-shaped cakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tube pans"@en .

aat:300198964 a skos:Concept ;
    skos:definition "Instruments for measuring the magnitude and sometimes the direction of a magnetic field, especially that of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetometers"@en .

aat:300198971 a skos:Concept ;
    skos:definition "Instruments designed to measure the differences between two fluid pressures, generally consisting of two-legged columns of liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manometers"@en .

aat:300198973 a skos:Concept ;
    skos:definition "Navigational compasses consisting of a pivoted compass card, usually with 8, 16, or 32 equal divisions, set in a gimbal-mounted nonferrous metal bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mariners' compasses"@en .

aat:300198977 a skos:Concept ;
    skos:definition "Devices used for measuring bodies of matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass measuring devices"@en .

aat:300198978 a skos:Concept ;
    skos:definition "Instruments used to measure the masses of small, electrically charged particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass spectroscopes"@en .

aat:300198979 a skos:Concept ;
    skos:definition "Mass spectroscopes that record mass spectra on photographic plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass spectrographs"@en .

aat:300198980 a skos:Concept ;
    skos:definition "Mass spectroscopes that identify and record the kinds and intensities of particles in a given substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass spectrometers"@en .

aat:300198981 a skos:Concept ;
    skos:definition "Graduated cuplike vessels used for measuring ingredients, as for cooks or chemists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring cups"@en .

aat:300198982 a skos:Concept ;
    skos:definition "Graduated pitchers marked for measuring liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring pitchers"@en .

aat:300198983 a skos:Concept ;
    skos:definition "Spoons of different marked sizes, usually part of a set, for measuring small amounts of ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring spoons"@en .

aat:300198984 a skos:Concept ;
    skos:definition "Small thermometers used to measure accurately the temperature of the human body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinical thermometers"@en .

aat:300198985 a skos:Concept ;
    skos:definition "Barometers that measure atmospheric pressure by measuring the height of a column of mercury that the atmosphere will support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercury barometers"@en .

aat:300198986 a skos:Concept ;
    skos:definition "Instruments designed to measure and record automatically several meteorological elements, such as air pressure, temperature, and humidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorographs"@en .

aat:300198988 a skos:Concept ;
    skos:definition "Tubs for use in washing clothes, linens, and the like, often used with a washboard or mangle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washtubs"@en .

aat:300198990 a skos:Concept ;
    skos:definition "Precision instruments with a spindle moved by a finely threaded screw that touches the object to be measured, usually for recording thicknesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micrometers"@en .

aat:300198993 a skos:Concept ;
    skos:definition "Small oval cups that have a rim curved to fit the orbit of the eye. Used to bathe the eye or for applying liquid remedies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyecups"@en .

aat:300198996 a skos:Concept ;
    skos:definition "Instruments for determining the amount of water in materials, as timber or soil, commonly by measuring its electrical resistivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moisture meters"@en .

aat:300198997 a skos:Concept ;
    skos:definition "Clocks that play notes or tunes at set intervals or on request."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical clocks"@en .

aat:300198998 a skos:Concept ;
    skos:definition "Organ pipes with a flue or windway through which air is blown to issue in a flat sheet of wind striking the edge of the upper lip of the pipe mouth. The eddies of wind created at the mouth combine with the vibrating column of air in the pipe to create the tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flue pipes"@en .

aat:300199008 a skos:Concept ;
    skos:definition "Instruments carried aloft by free, unmanned balloons and equipped with devices for measuring temperature, pressure, and relative humidity and automatically able to transmit the data by radio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiosondes"@en .

aat:300199009 a skos:Concept ;
    skos:definition "Any of various optical or radio wave-based instruments for determining the distance from an observer to particular objects, as for sighting guns or focusing cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rangefinders"@en .

aat:300199012 a skos:Concept ;
    skos:definition "Thermometers whose sensing element is an electrical resister, the resistance of which is an accurately known function of temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistance thermometers"@en .

aat:300199017 a skos:Concept ;
    skos:definition "Instruments for measuring the rate of flow of liquids and consisting of a tapered tube into which a small float is forced until its weight balances the fluid force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotameters"@en .

aat:300199027 a skos:Concept ;
    skos:definition "End-blown flutes of ancient and modern South America, formerly made of bone, clay, gourd, wood, or metal, with up to eight fingerholes. The presentday instruments have five or six equidistant fingerholes and one rear thumbhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quenas"@en .

aat:300199033 a skos:Concept ;
    skos:definition "Farms primarily engaged in the keeping, feeding, or breeding of horses for by-products, livestock increase, or investment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse farms"@en .

aat:300199040 a skos:Concept ;
    skos:definition "Any of various instruments for measuring and recording vibrations in the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismographs"@en .

aat:300199045 a skos:Concept ;
    skos:definition "Instruments for measuring the direction, intensity, and duration of earth movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismometers"@en .

aat:300199056 a skos:Concept ;
    skos:definition "Brief, formal, written compositions, often designed for publication, generally presented orally at a public venue. Examples include writings on art historical, scientific, or historical topics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papers"@en .

aat:300199062 a skos:Concept ;
    skos:definition "Devices with a rubber printing surface that becomes coated by being pressed on an ink-saturated pad, used for imprinting by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubber stamps"@en .

aat:300199063 a skos:Concept ;
    skos:definition "Stopped panpipes of Romania, in raft form, composed of up to thirty pipes set into a curved pipe or stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nais"@en .

aat:300199129 a skos:Concept ;
    skos:definition "Woodwind instruments containing reeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed instruments"@en .

aat:300199176 a skos:Concept ;
    skos:definition "Thin elongated pieces of cane, wood, metal, plastic or other material, found in various musical instruments; they are set into vibration by the air stream created by the player's breath or by bellows, thus producing sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reeds"@en .

aat:300199238 a skos:Concept ;
    skos:definition "Upright bassoons developed in the early 19th century, made in three or four detachable sections, capped by a brass flared bell or painted dragon's head and furnished with a swan-neck crook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian bassoons"@en .

aat:300199272 a skos:Concept ;
    skos:definition "Medium-sized or small bells that were used in a Christian service, hung in a location where the bell might be heard by those outside as well as within the church. Examples of where the sanctus bell is hung include a bellcote, a chancel roof, a belfry, or window. The bell was rung to alert people outside and inside the church that the main portion of the Mass was beginning. At High Masses, the great church bell was rung instead of the sanctus bell. In modern services, the small altar bells are instead typically rung at the Sanctus portion of the Mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanctus bells"@en .

aat:300199282 a skos:Concept ;
    skos:definition "Handloomed coverlets with weft loop weave patterning, often in colored wools, in the French-Canadian tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boutonné coverlets"@en .

aat:300199635 a skos:Concept ;
    skos:definition "Sets of procedures leading to the production of printed images or text, usually each including its special techniques of preparation or transfer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing processes"@en .

aat:300199636 a skos:Concept ;
    skos:definition "Procedures used during the intaglio process, where images are printed from ink held in the recessed areas of plates or blocks, which have been cut or etched away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intaglio printing processes"@en .

aat:300199637 a skos:Concept ;
    skos:definition "Procedures used in the planographic process, where images are printed from flat surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planographic printing processes"@en .

aat:300199639 a skos:Concept ;
    skos:definition "Procedures used in the relief process, where the nonprinting areas of blocks or plates are carved, engraved, or etched away, leaving the original plane surfaces raised so that ink is deposited and transferred to paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief printing processes"@en .

aat:300199640 a skos:Concept ;
    skos:definition "Preparatory techniques used on printing surfaces, such as plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing surface preparation techniques"@en .

aat:300199644 a skos:Concept ;
    skos:definition "Thermometers having a bulb that is kept moistened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet-bulb thermometers"@en .

aat:300199647 a skos:Concept ;
    skos:definition "Calibrated instruments for measuring electric power in watts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wattmeters"@en .

aat:300199678 a skos:Concept ;
    skos:definition "Instruments for measuring, and often also recording, the amount of water passing a specified point in a piping system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water meters"@en .

aat:300199685 a skos:Concept ;
    skos:definition "Ancient devices for measuring the passage of time that depended upon the regular flow of water into or out of graduated vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water clocks"@en .

aat:300199700 a skos:Concept ;
    skos:definition "Calibrated instruments for measuring differences in electrical potential; usually graduated in volts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voltmeters"@en .

aat:300199701 a skos:Concept ;
    skos:definition "Small, movable, graduated scales running parallel to the fixed graduated scales of precision instruments, such as sextants or transits, and designed to measure a fractional part of the smallest divisions on the fixed scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verniers"@en .

aat:300199702 a skos:Concept ;
    skos:definition "Instruments for measuring the velocity of sound in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velocimeters"@en .

aat:300199703 a skos:Concept ;
    skos:definition "Instruments that measure the absolute gas pressure in vacuum systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum gauges"@en .

aat:300199704 a skos:Concept ;
    skos:definition "Generally, any process or method involving aging, seasoning, washing, drying, heating, smoking, or otherwise treating whereby a product is preserved, perfected, or readied for use. In the context of leather manufacture, use specifically for processes such as \"brining\", \"dry-salting\", and \"wet-salting\" done to prevent putrifaction or other damage to hides and skins before tanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curing"@en .

aat:300199709 a skos:Concept ;
    skos:definition "Surveying instruments designed primarily to measure horizontal and vertical angles and generally consisting of telescope, spirit level, graduated plates, verniers, various leveling screws, and often a compass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transits"@en .

aat:300199711 a skos:Concept ;
    skos:definition "Precision surveying instruments for measuring horizontal and sometimes vertical angles and consisting of a sighting telescope mounted so that it is free to rotate horizontally and vertically and accompanying graduated scales to measure the angle of rotation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theodolites"@en .

aat:300199712 a skos:Concept ;
    skos:definition "Instruments for measuring longitudinal stress, as in wires or beams, or for measuring the negative pressure, or surface tension, of liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tensiometers"@en .

aat:300199713 a skos:Concept ;
    skos:definition "Small vessels with two vertical handles and a thin upcurving spout near the bottom used for drinking posset and for feeding invalids. Typically made of ceramic or glass and sometimes having a cover. Formerly a term used in Britain for caudle cups or other ceramic cups with one or more vertical handles but no spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posset pots"@en .

aat:300199719 a skos:Concept ;
    skos:definition "Decanter wagons in the shape of a naval jolly boat resting on four wheels or small rollers and having two large circular recesses for decanters and sometimes two smaller recesses for stoppers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jolly-boat decanter wagons"@en .

aat:300199723 a skos:Concept ;
    skos:definition "Instruments that measure revolutions per minute or the angular speed of rotating shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tachometers"@en .

aat:300199725 a skos:Concept ;
    skos:definition "Traditionally, large pots heated by surrounding the pot with fuel, and placing hot coals on the lid; often made of cast iron, having a tight-fitting lid, and placed in an open fire. May have legs and two side handles as well as a bail handle, used for cooking or baking. The term is also used for modern pots having a similar design, but heated by placing in a conventional oven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch ovens"@en .

aat:300199729 a skos:Concept ;
    skos:definition "Boxes or troughs, which may have lids, in which dough is mixed and kneaded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough troughs"@en .

aat:300199742 a skos:Concept ;
    skos:definition "Receptacles for holding square decanters (or up to four such decanters placed in a line), having an overhead hinged frame that can be locked when vertical and swung sideways when unlocked to permit removal of the decanters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tantaluses"@en .

aat:300199747 a skos:Concept ;
    skos:definition "Flat-bottomed, cylindrical vessels usually with a pouring lip, especially those used by chemists and pharmacists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beakers"@en .

aat:300199751 a skos:Concept ;
    skos:definition "Small containers, usually of metal or plastic and with handles, for carrying one's lunch from home to school or work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunchboxes"@en .

aat:300199763 a skos:Concept ;
    skos:definition "Instruments for measuring the speed and direction of cloud motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nephoscopes"@en .

aat:300199764 a skos:Concept ;
    skos:definition "Containers in which aromatic pastilles may be burned or liquid perfumes evaporated. Often in the form of a covered vase with holes on the shoulder or cover, or with pierced or openwork decoration. Sometimes made in the form of a tripod, especially an athenienne. For other containers of varying form used to hold burning incense for the purpose of scenting a space, use \"incense burners.\" For covered vaselike containers intended primarily for potpourri, use \"potpourri vases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassolettes"@en .

aat:300199765 a skos:Concept ;
    skos:definition "Tools and other equipment used to prepare food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary equipment"@en .

aat:300199769 a skos:Concept ;
    skos:definition "Deep vessels of varying size and shape, and usually having a cover; used for serving soup, sauce, stew, or other such foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tureens"@en .

aat:300199777 a skos:Concept ;
    skos:definition "Reflecting navigational instruments used for measuring the altitude of celestial bodies and having an arc of 1/8 of a circle, but due to their reflecting properties can measure up to 90 degrees; invented in the 1730s and used into the 19th century when superseded by sextants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octants"@en .

aat:300199778 a skos:Concept ;
    skos:definition "Instruments attached to wheels for measuring distance traveled, as of vehicles or surveyors' instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odometers"@en .

aat:300199779 a skos:Concept ;
    skos:definition "Broad, flat forks with four or five tines used to serve hot or cold asparagus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asparagus forks"@en .

aat:300199780 a skos:Concept ;
    skos:definition "Large, bulbous, usually wide-mouthed earthenware or woven vessels used for holding water or food or for cooking; may have handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ollas"@en .

aat:300199785 a skos:Concept ;
    skos:definition "Instruments used when preparing and cooking food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooking utensils"@en .

aat:300199794 a skos:Concept ;
    skos:definition "Culinary utensils that have a cutting edge, especially various forms of knives used for cutting, carving, dividing, or serving food. Sometimes used to embrace all types of flat culinary utensils; however, prefer \"flatware\" when referring to forks, spoons, and similar culinary tools without a cutting edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutlery"@en .

aat:300199795 a skos:Concept ;
    skos:definition "Vaselike forms which are often made of glass but sometimes made of wood or bone and intended to hold spills, small pieces of wood or twisted paper used to light a fire. They resemble celery glasses in form although they were not intended for use on the dining table, but rather near a fireplace, oil lamp, or similar lighting device. For similar vaselike forms typically made of glass and used on the dining table for serving celery, use \"celery glasses.\" For vaselike forms with a scalloped rim and used on the dining table for holding spoons, use \"spoon holders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spill holders"@en .

aat:300199800 a skos:Concept ;
    skos:definition "Culinary utensils that are basically flat, such as forks and spoons, and have no cutting edge. Distinguished from \"hollowware\" such as drinking vessels and bowls. In modern usage the term embraces all types of flat culinary utensils with or without a cutting edge; however, prefer \"cutlery\" when referring to culinary utensils with a cutting edge, especially various forms of knives used for food. Flatware is now usually made in sets having on the handles similar or related decorative patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flatware"@en .

aat:300199807 a skos:Concept ;
    skos:definition "Implements used to cut clusters of grapes into small portions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grape shears"@en .

aat:300199809 a skos:Concept ;
    skos:definition "Forks for eating ice cream and similar foods and having a bowl or spoonlike end terminating with three or four small tines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream forks"@en .

aat:300199811 a skos:Concept ;
    skos:definition "Spoons distinguished by their bowls, which are either oblong or of conventional shape with a flat base; used to eat ice cream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream spoons"@en .

aat:300199814 a skos:Concept ;
    skos:definition "Spoons used to stir iced tea and similar beverages served in tall glasses, having a bowl similar in size to a teaspoon and an elongated handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iced-tea spoons"@en .

aat:300199815 a skos:Concept ;
    skos:definition "A type of German wine glass, typically having a spherical bowl and a wide, hollow stem. Generally made of greenish glass varying in shade from light to dark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roemers"@en .

aat:300199817 a skos:Concept ;
    skos:definition "Small tongs often with claw-shaped ends used for serving ice cubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice tongs"@en .

aat:300199821 a skos:Concept ;
    skos:definition "Saucers that have wells or frames to hold in place a cup of tea or coffee. The cup and saucer may both be ceramic, or ceramic cups may be paired with silver or other metal saucer components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trembleuses"@en .

aat:300199826 a skos:Concept ;
    skos:definition "Long, thin utensils used to extract marrow from a marrowbone, having one end channeled in the form of a long narrow scoop, but sometimes having both ends channeled and of two widths so as to fit different bone sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marrow scoops"@en .

aat:300199827 a skos:Concept ;
    skos:definition "Specialized utensils which have a long, narrow channel on one end and a scooplike bowl on the other; used to remove the marrow from bones, typically at table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marrow spoons"@en .

aat:300199829 a skos:Concept ;
    skos:definition "Pinlike utensils of wood or metal for fastening meat in a specific form while cooking. Also, similar but longer utensils used to pierce and hold food while cooking, as over a grill, or dipping in sauces, as fondue. Use \"spits\" for pointed rods for holding large pieces of meat and other food while cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skewers"@en .

aat:300199830 a skos:Concept ;
    skos:definition "Small, long-tined forks designed to pierce a strawberry, dip it into sugar or cream, and place it into one's mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strawberry forks"@en .

aat:300199831 a skos:Concept ;
    skos:definition "Tongs, usually silver, with claw-shaped or spoon-shaped ends for serving lumps of sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar tongs"@en .

aat:300199832 a skos:Concept ;
    skos:definition "Cast iron frying pans originally made with short feet to stand among coals on the hearth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiders"@en .

aat:300199833 a skos:Concept ;
    skos:definition "Spoons having a long handle and a large deep bowl used for basting food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basting spoons"@en .

aat:300199837 a skos:Concept ;
    skos:definition "Small spoons with a circular bowl used to consume bouillon and other clear soups. For larger spoons with a circular or oval bowl and used to consume soup use \"soup spoons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouillon spoons"@en .

aat:300199838 a skos:Concept ;
    skos:definition "Small knives with a wide but dull blade used as a place piece by an individual diner to spead butter on bread, rolls, or similar foods. For similar knives used as a serving piece to cut or serve butter from a butter dish use \"butter knives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter spreaders"@en .

aat:300199839 a skos:Concept ;
    skos:definition "Small spoons, often decorative, intended primarily for removing and measuring dry tea from a tea caddy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caddy spoons"@en .

aat:300199842 a skos:Concept ;
    skos:definition "Knives with a curved blade used for cutting cheese. For large spatulas used to break up the curd for cheesemaking, use \"cheese knives (food preparation tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese knives"@en .

aat:300199843 a skos:Concept ;
    skos:definition "Large spatulas used to break up the curd for cheesemaking. For knives with a curved blade used to cut and serve cheese, use \"cheese knives (serving utensils).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese knives"@en .

aat:300199844 a skos:Concept ;
    skos:definition "Pointed spoon-, spatula-, or shovel-like implements for scooping cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese scoops"@en .

aat:300199855 a skos:Concept ;
    skos:definition "Metal pots or skillets with three feet and a long straight handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posnets"@en .

aat:300199857 a skos:Concept ;
    skos:definition "Any ceramic or metal pots or utensils used in the slow cooking of food, such as beans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crockpots"@en .

aat:300199899 a skos:Concept ;
    skos:definition "Spoons designed for toddlers to feed themselves. The traditional design comprises a short-handled spoon with a well-balanced bowl that is broad and blunt. Another common design incorporates a curved or curled handle. For spoons designed for adults to feed babies, use \"pap spoons\" or \"feeding spoons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby spoons"@en .

aat:300199900 a skos:Concept ;
    skos:definition "Long-handled spoons, usually with the capacity of a teaspoon, used for measuring ingredients or mixing drinks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barspoons"@en .

aat:300199901 a skos:Concept ;
    skos:definition "Tools having a stretched wire used as a cutting edge, or trowel-like tools with a central slitlike blade, used to slice cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese slicers"@en .

aat:300199904 a skos:Concept ;
    skos:definition "Spoons designed for feeding infants or toddlers. Traditional designs include a small bowl and a handle that is longer than a spoon designed for a baby to feed itself. Modern designs incorporate rubber or plastic coating on the bowl to protect the infant's gums. For spoons designed for toddlers to feed themselves, use \"baby spoons.\" For spoons intended for feeding pap to infants, use \"pap spoons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feeding spoons"@en .

aat:300199905 a skos:Concept ;
    skos:definition "Small spoons, similar in size to chocolate spoons, used to stir coffee served in demitasses or small coffee cups; often ornamental and made in sets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee spoons"@en .

aat:300199906 a skos:Concept ;
    skos:definition "Kitchen tools, often having a swiveling, protected blade, for removing the peel or outer skin of a vegetable or fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peelers"@en .

aat:300199907 a skos:Concept ;
    skos:definition "Utensils having a handle and a concave, blunt pushing surface designed for use by toddlers to push food onto their forks or spoons. Popular in the 19th and early 20th century, often collected in a set with a pap spoon, baby spoon, and a baby fork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pushers"@en .

aat:300199908 a skos:Concept ;
    skos:definition "Spoons of teaspoon size having a bowl pierced in a decorative pattern and long handle with a pointed end. The bowls of mote spoons were used to strain tea and to skim leaf particles and dust motes from the surface of a cup of tea. The thin pointed handle was used to clear clogged spouts of pots. For spoons of similar size with pierced bowls but lacking pointed handles, used specifically to serve olives, use \"olive spoons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mote spoons"@en .

aat:300199909 a skos:Concept ;
    skos:definition "Small spoons intended primarily for serving jam, jelly, or preserves from a jam pot or jar. The handle may be decorated with images of fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jam spoons"@en .

aat:300199910 a skos:Concept ;
    skos:definition "Scissor-shaped tongs used to break a lump of sugar from a sugar loaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar nips"@en .

aat:300199911 a skos:Concept ;
    skos:definition "Cranked, but not necessarily geared, devices of wood or iron for mechanically paring apples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apple parers"@en .

aat:300199913 a skos:Concept ;
    skos:definition "Culinary tools used to remove hulls from grain, nuts, or fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hullers"@en .

aat:300199914 a skos:Concept ;
    skos:definition "Shaped devices, generally of sheet metal, used for cutting biscuits from rolled dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biscuit cutters"@en .

aat:300199915 a skos:Concept ;
    skos:definition "Small knives with a narrow blade used to remove bones from meat, fish, or similar foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boning knives"@en .

aat:300199916 a skos:Concept ;
    skos:definition "Compasses for measuring horizontal angles during surveying with reference to the direction of a magnetic needle; usually capable of fastening to tripods or other firm supports and equipped with sighting apparatus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveyors' compasses"@en .

aat:300199917 a skos:Concept ;
    skos:definition "Surveyors' measuring devices consisting of 100 steel links each 7.92 inches long joined in a chain 66 feet long; precursors of engineers' chains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveyors' chains"@en .

aat:300199918 a skos:Concept ;
    skos:definition "Instruments that measure the duration of direct sunshine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunshine recorders"@en .

aat:300199920 a skos:Concept ;
    skos:definition "Cloth bags in which flour or meal is shaken as a means of sifting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boultels"@en .

aat:300199921 a skos:Concept ;
    skos:definition "Knives with a long blade and a serrated or scalloped cutting edge. Similar in form to \"cake knives,\" but having larger teeth set further apart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread knives"@en .

aat:300199922 a skos:Concept ;
    skos:definition "Devices used to broil meat, fish, poultry, or other foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broilers"@en .

aat:300199923 a skos:Concept ;
    skos:definition "Large knives with a broad blade, sometimes curved at the tip, used to cut and trim uncooked meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butcher knives"@en .

aat:300199924 a skos:Concept ;
    skos:definition "Devices used to slice butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter cutters"@en .

aat:300199926 a skos:Concept ;
    skos:definition "Culinary tools used to form butter into decorative shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter molds"@en .

aat:300199930 a skos:Concept ;
    skos:definition "Triangular wooden trays with either a corrugated pin or wooden arm with a metal blade used to work butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter workers"@en .

aat:300199932 a skos:Concept ;
    skos:definition "Rectangular pieces of wood with one or several diagonal blades used to cut or shred cabbage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabbage cutters"@en .

aat:300199933 a skos:Concept ;
    skos:definition "Molds, usually of tin or pewter, for forming candies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candy molds"@en .

aat:300199936 a skos:Concept ;
    skos:definition "Wood or metal containers in which cheese curd is pressed to extract moisture and to create distinctive shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese molds"@en .

aat:300199938 a skos:Concept ;
    skos:definition "Thick, often large blocks of wood on which food is placed for cutting, trimming, chopping, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopping blocks"@en .

aat:300199939 a skos:Concept ;
    skos:definition "Tools with one to four blades connected to a handle used to mince and chop meat, vegetables, or other foods. Blades may be straight or curved, the latter for use in a chopping bowl or tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopping knives"@en .

aat:300199941 a skos:Concept ;
    skos:definition "Sharp, broad-bladed and often short-handled knives used for cutting large pieces of meat into joints or roasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleavers"@en .

aat:300199966 a skos:Concept ;
    skos:definition "Instruments used for measuring electrical resistance and calibrated in ohms or megohms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ohmmeters"@en .

aat:300199967 a skos:Concept ;
    skos:definition "Photoelectric instruments used for measuring the amount of sediment in liquids; often used in the process of papermaking, to gauge opacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opacimeters"@en .

aat:300199974 a skos:Concept ;
    skos:definition "Instruments used for measuring the length of curved lines, as on maps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opisometers"@en .

aat:300199983 a skos:Concept ;
    skos:definition "Instruments for measuring high temperatures by measuring the radiation emitted by hot objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrometers"@en .

aat:300199991 a skos:Concept ;
    skos:definition "Initial letters formed from figures of human, animal, or hybrid creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figure initials"@en .

aat:300199994 a skos:Concept ;
    skos:definition "Measuring devices for determining and graphically recording or indicating the waveforms of changing quantities of electrical energy. In general, these are considered the same instrument as an oscilloscope, except that the oscillograph may be capable of creating a permanent record of the measurements, while the oscilloscope provides only visual feedback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oscillographs"@en .

aat:300200001 a skos:Concept ;
    skos:definition "Group of typefaces based on Gothic bastarda script, especially common for, and surviving into the 20th century in, Germanic-language printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraktur"@en .

aat:300200003 a skos:Concept ;
    skos:definition "Calipers whose two legs turn inward toward each other used to measure exterior dimensions, as the diameter of an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outside calipers"@en .

aat:300200005 a skos:Concept ;
    skos:definition "Instruments used to measure the thickness of a material, as a sheet of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pachymeters"@en .

aat:300200006 a skos:Concept ;
    skos:definition "Instruments designed to measure all the angles necessary for determining elevations and distances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantometers"@en .

aat:300200009 a skos:Concept ;
    skos:definition "Straight lines drawn on paper as part of a layout or for guidance of the scribe; included are the plain or decorative linear elements on a manuscript or printed page, the lines of a stave of music, and other similar lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rules"@en .

aat:300200010 a skos:Concept ;
    skos:definition "Networks of horizontal and vertical lines used to guide the layout of graphic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grids"@en .

aat:300200011 a skos:Concept ;
    skos:definition "Typographical ornaments (as bullets or stars) used typically to call attention to an opening sentence or to make a break between paragraphs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dingbats"@en .

aat:300200012 a skos:Concept ;
    skos:definition "Vertical lists of items or vertical sections into which the text of a manuscript or printed page are divided, separated by rules or blank spaces. For texts written from side to side across the page, use \"long line format.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "columns"@en .

aat:300200028 a skos:Concept ;
    skos:definition "Calibrated devices for measuring the flow of liquids in open conduits by observing differences in the heads on opposite sides of a partial obstruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parshall flumes"@en .

aat:300200029 a skos:Concept ;
    skos:definition "Wing-shaped bowed zitherlike chordophones with a fingerboard along the left side and two strings stopped by means of buttons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solophones"@en .

aat:300200031 a skos:Concept ;
    skos:definition "Clocks designed each with its own pedestal, from which it is detachable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal clocks"@en .

aat:300200032 a skos:Concept ;
    skos:definition "Instruments that record the number of paces taken when walking or running and, when adjusted for an individual's pace length, can provide a rough measure of the distance traveled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedometers"@en .

aat:300200042 a skos:Concept ;
    skos:definition "Instruments used to measure the consistency or resistance of materials, such as soil, by measuring the depth to which a standard needle penetrates the materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penetrometers"@en .

aat:300200052 a skos:Concept ;
    skos:definition "Photometers that rely on the photoelectric effects of photocells, phototransmitters, or phototubes to measure light intensity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoelectric photometers"@en .

aat:300200053 a skos:Concept ;
    skos:definition "Devices that measure the intensity of light falling on a surface (illuminance), or reflected by a surface (luminance), or emitted by a light source (luminous flux or luminous intensity)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photometers"@en .

aat:300200055 a skos:Concept ;
    skos:definition "Instruments for measuring the pressure head of fluids, as of water in wells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piezometers"@en .

aat:300200056 a skos:Concept ;
    skos:definition "Instruments designed to measure the relative speed of fluids and consisting of a narrow tube, with one end facing upstream, connected to a pressure-indicating device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitot tubes"@en .

aat:300200057 a skos:Concept ;
    skos:definition "Devices for measuring the area of any plane surface by tracing the boundary of the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planimeters"@en .

aat:300200058 a skos:Concept ;
    skos:definition "Ladles similar to but smaller than punch ladles and used for serving hot toddy from punch bowls to drinking glasses. Term used especially with reference to those made in Scotland during the early and mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toddy ladles"@en .

aat:300200062 a skos:Concept ;
    skos:definition "Utensils with a trowel-like or otherwise shaped bowl, sometimes partially covered to form a receptacle, and used for cutting out portions of soft food or fruit or for serving up, dishing out, or conveying grains or mashed foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scoops"@en .

aat:300200080 a skos:Concept ;
    skos:definition "Rain gauges that automatically record the amount of precipitation collected as a function of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pluviographs"@en .

aat:300200088 a skos:Concept ;
    skos:definition "Watches meant to be carried in pockets, as opposed, for example to be worn on the wrist or carried on chains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket watches"@en .

aat:300200095 a skos:Concept ;
    skos:definition "Spoonlike utensils with a deep bowl and a relatively long handle used for lifting, conveying, or serving cream, soup, punch, or other liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladles"@en .

aat:300200096 a skos:Concept ;
    skos:definition "Instruments for measuring or indicating the polarization of light or for examining objects in polarized light; often used to study stresses and strains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polariscopes"@en .

aat:300200131 a skos:Concept ;
    skos:definition "Instruments for measuring differences in electrical potential."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potentiometers"@en .

aat:300200137 a skos:Concept ;
    skos:definition "Devices designed to measure the amount of rainfall, snowfall, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precipitation gauges"@en .

aat:300200140 a skos:Concept ;
    skos:definition "Instruments for measuring pressure, normally of gases or liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure gauges"@en .

aat:300200143 a skos:Concept ;
    skos:definition "Hygrometers that determine humidity by reading two thermometers, one with a wet bulb and the other with a dry bulb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychrometers"@en .

aat:300200148 a skos:Concept ;
    skos:definition "Containers whose volume is precisely known; used to measure the density or specific gravity of liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pycnometers"@en .

aat:300200159 a skos:Concept ;
    skos:definition "Small short-bladed knives for peeling fruits and vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paring knives"@en .

aat:300200160 a skos:Concept ;
    skos:definition "Tools used to reduce a large loaf or cone of sugar into suitable size pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar cutters"@en .

aat:300200161 a skos:Concept ;
    skos:definition "General term for culinary knives and other blades of various designs used specifically to slice vegetables or fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable slicers"@en .

aat:300200162 a skos:Concept ;
    skos:definition "Long-handled pair of iron palette tongs for baking wafers, often having a bed with a molded or engraved design that is impressed on the wafer batter in baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wafer irons"@en .

aat:300200164 a skos:Concept ;
    skos:definition "Devices for cooking waffles that consist of two metal parts hinged together so as to shut upon each other and impress square, round, or oval surface projections on the waffle in baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waffle irons"@en .

aat:300200165 a skos:Concept ;
    skos:definition "Any of various tools used in connection with fire, especially metal disks or plates heated and held over food (such as pastry or puddings) to brown the top of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salamanders"@en .

aat:300200170 a skos:Concept ;
    skos:definition "Long-handled forks used for cooking or toasting food over an open fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toasting forks"@en .

aat:300200171 a skos:Concept ;
    skos:definition "Large long-handled forks used to lift meat as from the pot or pan in which it was cooked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flesh forks"@en .

aat:300200172 a skos:Concept ;
    skos:definition "Mixing implements with some sort of stationary agitator with a long handle. The agitator is placed in the bottom of a bowl or glass of ingredients, then the handle is twirled between the palms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twirlers"@en .

aat:300200174 a skos:Concept ;
    skos:definition "Sticks knobbed or flattened at the end used to crush sugar and lemon when making toddy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toddy sticks"@en .

aat:300200177 a skos:Concept ;
    skos:definition "Pronged sticks or round or thin unpronged flat sticks made of wood, metal, or plastic and used to stir mixed drinks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swizzle sticks"@en .

aat:300200179 a skos:Concept ;
    skos:definition "Small hand-held devices for storing and grinding peppercorns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pepper mills"@en .

aat:300200180 a skos:Concept ;
    skos:definition "Knifelike utensils with one long straight edge shaped like a sharp-edged half-cylinder, or fitted with a friction-driven rotating brush inside a housing, used to remove crumbs from a tablecloth or similar surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crumbers"@en .

aat:300200181 a skos:Concept ;
    skos:definition "Simple, hand-operated mills consisting of two circular stones; used to grind grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "querns"@en .

aat:300200182 a skos:Concept ;
    skos:definition "Mechanical devices designed specifically for removing seeds from raisins or grapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raisin seeders"@en .

aat:300200186 a skos:Concept ;
    skos:definition "Large, broad four-tined forks used with a fish slice or with a serving knife to serve fish. For forks having three or four tines, generally used with a conforming fish knife, use \"fish forks (place forks).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish forks"@en .

aat:300200269 a skos:Concept ;
    skos:definition "Use to describe images, or other single graphic elements that cover a whole page, or nearly so."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-page"@en .

aat:300200294 a skos:Concept ;
    skos:definition "Generally, the overall configuration of the numbering in the book. The ordering of pages of a book, microimages on a microfilm, etc., by placing placing of consecutive numbers, one on each page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pagination"@en .

aat:300200296 a skos:Concept ;
    skos:definition "The placing of numerals on something, usually a series of like things given consecutive numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numbering"@en .

aat:300200341 a skos:Concept ;
    skos:definition "Protective containers or boxes designed to protect a book or other item by covering it but with one open end so that only the spine is exposed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipcases"@en .

aat:300200342 a skos:Concept ;
    skos:definition "Boxes, usually of medium to large size, intended for the storage of linens, clothing, books, food, artifacts, or any other item. They are usually lidded or have flaps that allow the box to be closed. They may be made of cardboard, wood, metal, plastic, wicker, or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage boxes"@en .

aat:300200347 a skos:Concept ;
    skos:definition "Distinctive German stave tankards mounted with pewter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pechkrüge"@en .

aat:300200350 a skos:Concept ;
    skos:definition "Ornamental containers of various designs, usually relatively squat, for holding or growing plants or flowers. For containers that are not particularly ornamental, use \"flowerpots.\" For ornamental containers for holding or concealing a flowerpot, use \"cachepots.\" .For vase-shaped containers for cut flowers, use \"flower vases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jardinières"@en .

aat:300200359 a skos:Concept ;
    skos:definition "Flat, rigid, rectangular containers with a handle used for carrying business papers or other relatively flat documents. For flat, flexible rectangular containers use \"briefcases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attaché cases"@en .

aat:300200366 a skos:Concept ;
    skos:definition "Refers to amphorae that were filled with olive oil from the sacred trees of Athena, given as prizes in the Panathenaic Games. They were neck amphorae with a large, broad body sharply tapering downward and a relatively thin neck. The standard decoration included images of Athena on one side and the contest at which the prize was won on the other, usually in the Black-figure technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panathenaic amphorae"@en .

aat:300200376 a skos:Concept ;
    skos:definition "Instrument components that detect a fluid pressure and then produce an electrical signal related to the pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure transducers"@en .

aat:300200380 a skos:Concept ;
    skos:definition "Instruments for measuring the total intensity of solar radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrheliometers"@en .

aat:300200381 a skos:Concept ;
    skos:definition "Instruments for measuring altitudes, usually consisting of a graduated arc of 90 degrees, a pair of sights, and a plumb bob."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrants"@en .

aat:300200392 a skos:Concept ;
    skos:definition "Equipment, containers, utensils, dishes, cookware, cutlery, and other items for kitchen use, excluding appliances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchenware"@en .

aat:300200397 a skos:Concept ;
    skos:definition "China, glassware, and silverware, used for table service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinnerware"@en .

aat:300200419 a skos:Concept ;
    skos:definition "Devices used for measuring energy that travels as electromagnetic waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiant energy measuring devices"@en .

aat:300200420 a skos:Concept ;
    skos:definition "Devices that specifically measure the speed, direction, intensity, and other aspects of the movement of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "object movement measuring devices"@en .

aat:300200421 a skos:Concept ;
    skos:definition "Devices that specifically measure the movement of liquid and gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquid or gas movement measuring devices"@en .

aat:300200423 a skos:Concept ;
    skos:definition "The writing, assembling, and design of publications using microcomputers and word processing, graphics, and page layout software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desktop publishing"@en .

aat:300200430 a skos:Concept ;
    skos:definition "Refers to the extra spacing between lines of metal type, in addition to that provided by the shoulders of type sorts. For the space allowed for each line of type when produced by means other than metal type, use \"line spacing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leading"@en .

aat:300200438 a skos:Concept ;
    skos:definition "Proofs printed from matter that has been composed into pages, usually after galley corrections have been made but before plates are made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "page proofs"@en .

aat:300200441 a skos:Concept ;
    skos:definition "In type, a set of capitals smaller than and distinct from the regular capitals of a font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small capitals"@en .

aat:300200443 a skos:Concept ;
    skos:definition "Rotary beaters operated by hand for aerating eggs or liquids such as cream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggbeaters"@en .

aat:300200453 a skos:Concept ;
    skos:definition "Small tools with a hinged cover and fitted with a rasp, used to store and grate nutmeg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nutmeg graters"@en .

aat:300200469 a skos:Concept ;
    skos:definition "Bowl-shaped or conical devices with perforated or pierced walls, used for draining and straining foods; usually set on a base or on legs. For other culinary tools used to filter foods, use \"strainers (culinary tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colanders"@en .

aat:300200472 a skos:Concept ;
    skos:definition "Devices for separating the yolk from the white of the egg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg separators"@en .

aat:300200477 a skos:Concept ;
    skos:definition "Sheet tin utensils with vertical sides and an inner and outer ring used to shape doughnuts, often with an attached handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doughnut cutters"@en .

aat:300200478 a skos:Concept ;
    skos:definition "Copy, either artwork or text, ready to be photographed for reproduction without further alteration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera-ready copy"@en .

aat:300200490 a skos:Concept ;
    skos:definition "Utensils consisting of an inverted cone with a narrow tube at the apex, used for conducting liquids or other substances from one container to another, usually with a narrower opening; sometimes combined with strainers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funnels"@en .

aat:300200493 a skos:Concept ;
    skos:definition "Tools with a pointed spiral piece of metal attached to a handle, used for drawing corks from bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corkscrews"@en .

aat:300200495 a skos:Concept ;
    skos:definition "Tools used for removing caps on bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle openers"@en .

aat:300200499 a skos:Concept ;
    skos:definition "Tools or devices for loosening screw lids of jars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jar openers"@en .

aat:300200510 a skos:Concept ;
    skos:definition "Unprinted, partially printed, or sketched samples of projected publications to suggest the appearance of the completed work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dummies"@en .

aat:300200511 a skos:Concept ;
    skos:definition "Preparatory procedures used in the printing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing preparation processes"@en .

aat:300200512 a skos:Concept ;
    skos:definition "Preparation of copy in a form suitable for printing or for making printing plates, whether by hand, by mechanical devices, or by computer, including casting off and the arranging of type, spacing, and other material. For the specific process of arranging type, use \"typesetting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition"@en .

aat:300200514 a skos:Concept ;
    skos:definition "Refers to the specific process of arranging type from copy for printing or making printing plates, whether by hand, by mechanical devices, or by inputting to computer. More generally, for the preparing of copy, casting off, arranging type, spacing, and other material, use \"composition (printing preparation).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typesetting"@en .

aat:300200516 a skos:Concept ;
    skos:definition "The composition of text, using electronic and photographic methods. Images of type characters are projected from a film or disk onto photosensitive film or paper; the resulting page is used to produce, usually, an offset plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photocomposition"@en .

aat:300200528 a skos:Concept ;
    skos:definition "The arrangement of type or image pages so that they will be in proper sequence when the sheet is printed and folded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imposition"@en .

aat:300200529 a skos:Concept ;
    skos:definition "Books issued in paper covers, having adhesive bindings and covers most often of heavier stock than the book's leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paperbacks"@en .

aat:300200533 a skos:Concept ;
    skos:definition "Instruments or devices for cracking the shells of nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nutcrackers"@en .

aat:300200542 a skos:Concept ;
    skos:definition "Small, sharp-pointed implements used for extracting the kernels from nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nutpicks"@en .

aat:300200567 a skos:Concept ;
    skos:definition "Books bound in stiff covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardcover books"@en .

aat:300200572 a skos:Concept ;
    skos:definition "Handmade books whose pages are folded in a variety of decorative ways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folded books"@en .

aat:300200612 a skos:Concept ;
    skos:definition "The arrangement of elements on a page or other graphic design area, for example, the plan of a publication showing general arrangement of text, illustrations, etc., with indication of type styles and sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "layout"@en .

aat:300200648 a skos:Concept ;
    skos:definition "Tools having various types of puncturing points and a cutting blade used for opening cans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "can openers"@en .

aat:300200657 a skos:Concept ;
    skos:definition "Thin, tapered sticks, often of wood or ivory, held in one hand between the thumb and fingers and used chiefly in China, Japan, and other Asian countries for food preparation or lifting food to the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopsticks"@en .

aat:300200658 a skos:Concept ;
    skos:definition "Scenes or figures appearing in the margins or decorative borders of a page of text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marginal illustrations"@en .

aat:300200661 a skos:Concept ;
    skos:definition "Group of typefaces characterized by heavy faces and angular outlines, based on Gothic hand-written scripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black letter"@en .

aat:300200662 a skos:Concept ;
    skos:definition "The placing of consecutive numbers one on each folio of a book; may also refer to the overall configuration of the numbering in the book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foliation"@en .

aat:300200668 a skos:Concept ;
    skos:definition "Those styles of handwriting designed for legibility and used in transcribing manuscript books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book hands"@en .

aat:300200690 a skos:Concept ;
    skos:definition "Long-handled, flat paddlelike utensils used chiefly by bakers to place and remove bread, pies, and similar foods in an oven. For utensils with two long prongs used to place or remove food in an oven, use \"pie lifters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peels"@en .

aat:300200699 a skos:Concept ;
    skos:definition "Devices, usually of sheet metal, for cutting shaped forms for cookies, such as circles or stars, from rolled dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cookie cutters"@en .

aat:300200712 a skos:Concept ;
    skos:definition "Kitchen utensils having several parallel wires bent in a semicircle and secured by a handle, used especially for cutting shortening into flour to make pastry dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry blenders"@en .

aat:300200718 a skos:Concept ;
    skos:definition "Utensils with two long prongs and a handle used to place or remove pies from an oven. For flat paddlelike tools also used to place and remove food in an oven use \"peels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pie lifters"@en .

aat:300200727 a skos:Concept ;
    skos:definition "Cylinders of wood or other materials, usually with short handles at each end, for rolling out dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling pins"@en .

aat:300200733 a skos:Concept ;
    skos:definition "Rolling pins with carved designs which are pressed to cookie dough to transfer their designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springerle rollers"@en .

aat:300200737 a skos:Concept ;
    skos:definition "Carved boards which are pressed into sheets of cookie dough to transfer their designs. The designs are then cut out from the dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springerle boards"@en .

aat:300200744 a skos:Concept ;
    skos:definition "Large flat pans on which cookies are baked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cookie sheets"@en .

aat:300200750 a skos:Concept ;
    skos:definition "Conical tubes with a simple hole or a patterned hole at one end, fitted onto a pastry bag or other reservoir of dough, icing, or other soft, creamy food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry tubes"@en .

aat:300200753 a skos:Concept ;
    skos:definition "Funnel-like bags which are squeezed to force soft food mixtures, such as icing, through a pastry tube making ornamental spreads and decorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry bags"@en .

aat:300200764 a skos:Concept ;
    skos:definition "Flat-headed wooden devices used to pack butter into storage containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter tamps"@en .

aat:300200769 a skos:Concept ;
    skos:definition "Small pair of paddles for making butter into balls or other fancy shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scotch hands"@en .

aat:300200784 a skos:Concept ;
    skos:definition "Culinary tools used to impress designs on butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter prints"@en .

aat:300200795 a skos:Concept ;
    skos:definition "Cooking appliances fitted with a spit on which food is rotated before or over a source of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotisseries"@en .

aat:300200798 a skos:Concept ;
    skos:definition "Electrically operated ovens using high-frequency electromagnetic waves, used to heat, cook, or thaw food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microwave ovens"@en .

aat:300200802 a skos:Concept ;
    skos:definition "Any of various utensils used in popping corn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn poppers"@en .

aat:300200811 a skos:Concept ;
    skos:definition "Shovel-like tools used to cut up and remove compacted mash and straw following cider pressing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cider cheese cutters"@en .

aat:300200824 a skos:Concept ;
    skos:definition "Refers to given sets of written works, together with a particular set of conventions for their use. Distinct from \"alphabets\" which are sets of characters or symbols with which a language is written, not including a set of conventions for their use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scripts"@en .

aat:300200828 a skos:Concept ;
    skos:definition "Those scripts developed in contexts of writing or transcribing documents, often tending toward cursive and informality and sometimes characterized by special stylization or ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary scripts"@en .

aat:300200832 a skos:Concept ;
    skos:definition "Flat, heated surfaces, especially on top of stoves, for cooking food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "griddles"@en .

aat:300200834 a skos:Concept ;
    skos:definition "Small balls of perforated metal or other material in which tea leaves are placed to be immersed in hot water to make tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea balls"@en .

aat:300200840 a skos:Concept ;
    skos:definition "Culinary tools with perforated containers which are filled with tea leaves, or sometimes coffee grounds, then placed within a cup or pot of water to brew the beverage. Prefer \"tea balls\" for small perforated balls in which tea leaves are placed to be immersed in hot water to make tea. For culinary tools used to catch the loose leaves or grounds as the beverage is poured, use \"tea strainers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea infusers"@en .

aat:300200841 a skos:Concept ;
    skos:definition "Strainers through which tea, or sometimes coffee, is poured in order to catch the loose leaves or grounds. For culinary tools which enclose tea leaves, or sometimes coffee grounds, within a cup or pot of water while the beverage brews, use \"tea infusers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea strainers"@en .

aat:300200859 a skos:Concept ;
    skos:definition "Double-headed drums from Provence in the form of a large tabor but with a long cylindrical body and a single snare on the upper head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tambourins"@en .

aat:300200862 a skos:Concept ;
    skos:definition "In the composition of pages, matter set apart from the text as a title or a summary of the text that follows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headings"@en .

aat:300200896 a skos:Concept ;
    skos:definition "Artifacts bearing information (such as symbols, marks, or printed information), that acts as identification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identifying artifacts"@en .

aat:300201014 a skos:Concept ;
    skos:definition "Literary works comprising light or amusing story lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comedies"@en .

aat:300201018 a skos:Concept ;
    skos:definition "Sheets or small books printed by printers, type founders, or publishers to show what types are available and their appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type specimens"@en .

aat:300201023 a skos:Concept ;
    skos:definition "Individual stories derived from a mythology; distinguished from historical accounts in that they are considered by current scholars to lack a determinable basis of fact or natural explanation; typically concerning a being, hero, deity, or event and explains some practice, rite, or phenomenon of nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "myths"@en .

aat:300201026 a skos:Concept ;
    skos:definition "Literary works of serious and dignified character that reach disastrous or sorrowful conclusions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tragedies"@en .

aat:300201028 a skos:Concept ;
    skos:definition "Dramatic or theatrical performances staged by actors before an audience; acted representations of an action or story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plays"@en .

aat:300201033 a skos:Concept ;
    skos:definition "Series of illustrations of an animated scene bound together in sequence so that an illusion of movement can be imparted by flipping them rapidly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flip books"@en .

aat:300201034 a skos:Concept ;
    skos:definition "Books, usually for children, in which elements of a picture spring out at the reader when the pages are opened or a tab is pulled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pop-up books"@en .

aat:300201053 a skos:Concept ;
    skos:definition "Emblems or devices with text added to the end of some manuscripts and incunabula by the author or scribe to provide the title of the work and the name or initials of its author or scribe. For similar closing statements in later printed books, use \"colophons.\" Explicits were eventually incorporated into or completely replaced by the colophon, which included information about the printer, printing materials, and typeface, and, often, the printer's emblem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "explicits"@en .

aat:300201054 a skos:Concept ;
    skos:definition "The individual sheets folded into two leaves that together form a gathering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bifolia"@en .

aat:300201056 a skos:Concept ;
    skos:definition "Books or other media containing collections of moralized fables, especially as written in the Middle Ages, about actual or mythical animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bestiaries"@en .

aat:300201058 a skos:Concept ;
    skos:definition "Limited edition books, traditionally handcrafted from fine materials, richly illustrated with original works of graphic art by well known artists. Often includes artists' visual counterparts to a piece of poetry or prose. The tradition began in France in the mid-nineteenth century and has spread elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livres de peintres"@en .

aat:300201063 a skos:Concept ;
    skos:definition "Written accounts of the lives of saints. For the genre regardless of medium, prefer \"hagiography (genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hagiographies"@en .

aat:300201079 a skos:Concept ;
    skos:definition "Posters intended to be placed in subway cars and buses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "car cards"@en .

aat:300201080 a skos:Concept ;
    skos:definition "Posters promoting election campaigns or other political publicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political posters"@en .

aat:300201081 a skos:Concept ;
    skos:definition "Implements for cutting dough, having a rotating wheel with a fluted, jagged, toothed, or otherwise shaped edge; used to cut, crimp, or decorate pastry or dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jagging wheels"@en .

aat:300201083 a skos:Concept ;
    skos:definition "Deep hemispherical pierced bowls having two long side handles or one long side handle and a hook at the other side in order to rest on the rim of a punch bowl. Used for straining orange or lemon juice squeezed directly into the punch bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch strainers"@en .

aat:300201084 a skos:Concept ;
    skos:definition "Devices for removing seeds, pits, or stones from fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitters"@en .

aat:300201085 a skos:Concept ;
    skos:definition "Devices or appliances used to brown breads or other foods by exposure to heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toasters"@en .

aat:300201086 a skos:Concept ;
    skos:definition "Utensils for toasting cheese on bread before an open fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese toasters"@en .

aat:300201087 a skos:Concept ;
    skos:definition "Utensils or devices used to retain or hold back solid pieces or particles while a liquid passes through. For bowl-shaped or conical devices with perforated or pierced walls used to drain or strain foods use \"colanders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strainers"@en .

aat:300201088 a skos:Concept ;
    skos:definition "Meshed or perforated devices or utensils through which dry loose material (as flour) is winnowed or refined, material containing liquid is strained, or soft solids (as hard-boiled eggs) are comminuted by forcing (as with a pestle)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sieves"@en .

aat:300201089 a skos:Concept ;
    skos:definition "Devices or utensils of fine mesh used for winnowing powdered or granulated substances and often with a contrivance, as a rotator, to aid the action of sifting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sifters"@en .

aat:300201090 a skos:Concept ;
    skos:definition "Any of various tools for grating, powdering or shredding food or other materials handled in a similar way, such as pressed blocks of tobacco or cosmetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graters"@en .

aat:300201091 a skos:Concept ;
    skos:definition "Culinary appliances with electrically heated elements for browning bread and similar food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric toasters"@en .

aat:300201092 a skos:Concept ;
    skos:definition "Tools used for beating, stirring, or whipping. Tools used to beat or mix food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaters"@en .

aat:300201093 a skos:Concept ;
    skos:definition "Specially designed curved or cylindrical knives or other circular multi-bladed devices for removing the core of a fruit or vegetable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corers"@en .

aat:300201094 a skos:Concept ;
    skos:definition "Sieves having a mesh woven of hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair sieves"@en .

aat:300201095 a skos:Concept ;
    skos:definition "Coarse-meshed sieves used for separating grains from straw and chaff or for mincing such cooked vegetables as potatoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riddles"@en .

aat:300201097 a skos:Concept ;
    skos:definition "Any of various culinary devices used for grinding food, such as grain, vegetables, or meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grinders"@en .

aat:300201098 a skos:Concept ;
    skos:definition "Mechanical grinders operated by crank handle or electricity used to cut, chop, or mince meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat grinders"@en .

aat:300201099 a skos:Concept ;
    skos:definition "Any of various culinary devices used for reducing to powder or meal such things as grain, coffee, bones, dried beans and peas, or whole spices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary mills"@en .

aat:300201100 a skos:Concept ;
    skos:definition "Tools used to mince, chop, or shred food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food choppers"@en .

aat:300201114 a skos:Concept ;
    skos:definition "Devices used for winnowing flour, often having a mechanical action for forcing flour through a mesh screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour sifters"@en .

aat:300201151 a skos:Concept ;
    skos:definition "Pointed rods for thrusting through and holding meat and other foods while cooking before or over a source of heat; sometimes made as a component part of rotisseries and other cooking and heating devices. Use \"skewers\" for long pinlike utensils used to hold small pieces of food while cooking or dipping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spits"@en .

aat:300201160 a skos:Concept ;
    skos:definition "Spits made with a central basket formed of thin iron strips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basket spits"@en .

aat:300201177 a skos:Concept ;
    skos:definition "Kitchen utensils designed for extruding food, especially cooked potatoes, by pressure through a perforated container so that the resulting product emerges as strings about the diameter of a grain of rice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ricers"@en .

aat:300201179 a skos:Concept ;
    skos:definition "Vessels having a single, high looped handle that function as ladles for serving wine out of a krater. The kyathos is teacup-shaped and thin-walled. It is primarily a black-figure form and was originally copied from an Etruscan shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kyathoi"@en .

aat:300201183 a skos:Concept ;
    skos:definition "Russian ceremonial drinking vessels, globular in form and sometimes having a cover and a low foot ring; usually of silver and sometimes richly enamelled or ornamented with gems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bratinas"@en .

aat:300201184 a skos:Concept ;
    skos:definition "Standing cups that are highly decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounted cups"@en .

aat:300201185 a skos:Concept ;
    skos:definition "Lavishly decorated standing cups, generally made in silver or gold, with a bowl made of nautilus shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nautilus shell cups"@en .

aat:300201215 a skos:Concept ;
    skos:definition "Drinking vessels that are designed to challenge the skill of the drinker, or make drinking impossible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trick drinking vessels"@en .

aat:300201253 a skos:Concept ;
    skos:definition "Term applied to various types of drinking vessels, usually made of wood, pewter or silver, the contents of which were drunk for wagers. Especially those in the form of a standing woman wearing a full skirt and having upraised arms which hold the side handles of a small swinging cup. When the piece was inverted, both the skirt and swinging cup could be filled with wine. The drinker was expected to empty the contents of both without spilling any wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wager cups"@en .

aat:300201255 a skos:Concept ;
    skos:definition "Term generally applied to a variety of drinking glasses designed to challenge the skill of the drinker to carefully manipulate the vessel and drink without spilling the contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trick glasses"@en .

aat:300201256 a skos:Concept ;
    skos:definition "Trumpet-shaped ale glasses about 3 feet in height and which hold approximately 1 pint of ale. Made either with a flat circular base or with a rounded hollow bulb. The latter were used as trick glasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yard-of-ale glasses"@en .

aat:300201259 a skos:Concept ;
    skos:definition "Flutes sounded by the player blowing against the sharp rim of a hole in the side of the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transverse flutes"@en .

aat:300201262 a skos:Concept ;
    skos:definition "Parts or components of information forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information form components"@en .

aat:300201267 a skos:Concept ;
    skos:definition "Early English version of the trombone, in use from Medieval times up to the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sackbuts"@en .

aat:300201279 a skos:Concept ;
    skos:definition "Containers intended primarily for cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cookware"@en .

aat:300201280 a skos:Concept ;
    skos:definition "Drums with two membranes, one of which is beaten, the other forming part of the lacing device. They are generally cylindro-conical in shape, with parallel straight sides on the upper part, the remainder taking the form of a truncated cone. They are common in Uganda and adjoining parts of East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uganda drums"@en .

aat:300201283 a skos:Concept ;
    skos:definition "Small guitars with four strings and a fretted neck, developed in Hawaii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ukuleles"@en .

aat:300201319 a skos:Concept ;
    skos:definition "Jugs with a perforated neck and from three to eight spouts along the rim that make ordinary drinking or pouring impossible. One can drink or pour without spilling only if certain holes along the rim and under the handles are covered with the fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puzzle jugs"@en .

aat:300201410 a skos:Concept ;
    skos:definition "Printed cards distributed to attract freight or passenger business especially for the clipper ships of the 1850s and 1860s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailing cards"@en .

aat:300201411 a skos:Concept ;
    skos:definition "Handbills put out in great numbers by lottery promoters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lottery puffs"@en .

aat:300201412 a skos:Concept ;
    skos:definition "Paper roundels inserted in pocketwatches as packing, advertising, or souvenirs. They were in general use from the late 18th century to the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watchpapers"@en .

aat:300201440 a skos:Concept ;
    skos:definition "Ceramic plaques pierced with holes to hang from wine barrels and inscribed with the names of the contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bin labels"@en .

aat:300201447 a skos:Concept ;
    skos:definition "Documents used in common carrier transportation, setting out the route of the vehicle, details of goods or passengers, and revenues received."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waybills"@en .

aat:300201452 a skos:Concept ;
    skos:definition "Documents certifying the official remission by the Church of the temporal punishment due for sins that have been forgiven; outlawed in 1567. Authoritative grants from the Church's treasury for the remission or payment in whole (plenary indulgences) or in part (partial indulgences), valid before God, of the debt of temporal punishment after the guilt of sin has been forgiven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indulgences"@en .

aat:300201497 a skos:Concept ;
    skos:definition "Mechanical arrangements of toothed metal lever and snail-shaped cam designed so that the hands of striking timepieces can be advanced without waiting for the striking to be completed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racks and snails"@en .

aat:300201498 a skos:Concept ;
    skos:definition "Toothed segments of circles pivoted to convert rotary motion into linear motion in such a way as to count the number of blows struck in striking or chiming clocks or repeater watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racks"@en .

aat:300201505 a skos:Concept ;
    skos:definition "Short-barrelled shotguns with a wide bore expanding gradually throughout its length, typically terminating in a flared or thickened muzzle, and often carrying a spring-activated bayonet that folded back along the barrel when not in use. They were designed to fire a quantity of shot at once against a mass of opponents, and were popular weapons for defending stage coaches, ships, and prisons from the 17th to the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blunderbusses"@en .

aat:300201511 a skos:Concept ;
    skos:definition "Early firearms resembling small smoothbore cannons mounted on a wood stock or shaft, loaded at the muzzle and requiring to be primed and loaded for every shot; used in Europe in the 14th and 15th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand cannons"@en .

aat:300201513 a skos:Concept ;
    skos:definition "Light, relatively short-barreled rifles and smoothbore long guns used by cavalry and lightly armed special troops, originating in Europe in the late 16th century and made in various sizes and with different firing mechanisms throughout their development down to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbines"@en .

aat:300201515 a skos:Concept ;
    skos:definition "Small single-shot muzzleloading percussion pocket pistols of large bore, first made by the Philadelphia gunsmith Henry Deringer in the 1840s and subsequently widely copied throughout the United States. Specifically for those actually made by Henry Deringer himself, use \"deringers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "derringers"@en .

aat:300201517 a skos:Concept ;
    skos:definition "Portable or transportable weapons that can discharge long burning streams of liquid or semiliquid fuel under pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flamethrowers"@en .

aat:300201521 a skos:Concept ;
    skos:definition "Instruments for detecting and measuring thermal radiation, especially at wavelengths longer than those of visible radiation, such as in the infrared or microwave regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiometers"@en .

aat:300201522 a skos:Concept ;
    skos:definition "Sensitive radiometers used to measure weak radiant energy and generally consisting of a thermopile supported on and connected directly to the moving coil of a galvanometer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiomicrometers"@en .

aat:300201525 a skos:Concept ;
    skos:definition "Curving metal bands attached to the underside of a rocket launcher or the stock of a firearm, vertically enclosing the trigger to prevent accidental discharge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trigger guards"@en .

aat:300201527 a skos:Concept ;
    skos:definition "Smoothbore spring air guns designed to fire BB shot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BB guns"@en .

aat:300201534 a skos:Concept ;
    skos:definition "Short-barrelled long guns, held at the shoulder or in the hands, using pistol ammunition and capable of fully automatic fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submachine guns"@en .

aat:300201536 a skos:Concept ;
    skos:definition "Combination weapons consisting of a small arm combined with either a different weapon or with some tool or article of everyday use, such as a walking stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination guns"@en .

aat:300201543 a skos:Concept ;
    skos:definition "Instruments designed to measure rain amount; includes recording, nonrecording, and rain-intensity gauges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rain gauges"@en .

aat:300201546 a skos:Concept ;
    skos:definition "Firearms for firing harpoons, usually furnished with a swiveling gun mount and typically used on whaling ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harpoon guns"@en .

aat:300201552 a skos:Concept ;
    skos:definition "Special guns or detachable accessories fitted to the muzzle of a gun, for the firing of grenades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grenade launchers"@en .

aat:300201554 a skos:Concept ;
    skos:definition "Short, light smoothbore muskets with a large bore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musketoons"@en .

aat:300201556 a skos:Concept ;
    skos:definition "Firearms, typically though not always pistols, having several barrels which revolve around a central axis and are fired separately. For single-barreled firearms with a revolving multichambered cylinder, use \"revolvers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pepperboxes"@en .

aat:300201558 a skos:Concept ;
    skos:definition "Short, light shoulder arms with a sharply downward curving stock designed to be braced against the chest when firing. They were used in the 16th and 17th centuries primarily by mounted horsemen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petronels"@en .

aat:300201580 a skos:Concept ;
    skos:definition "Heavy, long-range, muzzleloading rifles designed for use on the western frontier of the United States, approximately from 1800 to 1870. Typically they were unornamented, made with browned or dull metal that did not gleam in the light, and fitted with percussion locks and double-set triggers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plains rifles"@en .

aat:300201594 a skos:Concept ;
    skos:definition "Instruments used to measure the index of refraction of substances in any of several ways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refractometers"@en .

aat:300201599 a skos:Concept ;
    skos:definition "Heavy military swords with broad blades having a single cutting edge, a flattened back edge, and a well developed defense for the hand, usually a basket hilt or a shell guard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backswords"@en .

aat:300201604 a skos:Concept ;
    skos:definition "Clocks or watches with striking mechanisms that, upon request, will strike a sequence of bells, gongs, or chimes to indicate the time in hours, quarters, and sometimes, minutes. For watches that strike the hours in passing, use \"clock watches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repeaters"@en .

aat:300201606 a skos:Concept ;
    skos:definition "Pocket knives having a blade that is spring-operated so that pressure on a release catch causes it to emerge instantly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "switchblade knives"@en .

aat:300201608 a skos:Concept ;
    skos:definition "Military daggers from the 20th century on, having a strong, sharply pointed, double-edged stabbing blade and, in American models, a set of brass knuckles, designed for hand-to-hand fighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trench knives"@en .

aat:300201609 a skos:Concept ;
    skos:definition "Devices used to measure the diameters of circular objects to specified tolerances and consisting of cylindrical steel rings whose inside diameter matches either minimum or maximum allowable dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring gauges"@en .

aat:300201611 a skos:Concept ;
    skos:definition "Pikes with a long, spiked blade quadrangular in section and fitted with a disk at the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awl pikes"@en .

aat:300201630 a skos:Concept ;
    skos:definition "Instruments for measuring the amount of salt in a solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salimeters"@en .

aat:300201641 a skos:Concept ;
    skos:definition "Small percussive weapons typically consisting of a leather-covered piece of lead or other heavy material with a short flexible handle such as a strap or springy shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackjacks"@en .

aat:300201648 a skos:Concept ;
    skos:definition "Use specifically for European percussive weapons having a heavy head, typically with a blunt or cusped face and at least one blade or spike at the back of the head or on top of the staff, various forms of which were in use from the 13th to the 17th century. Also used very generally for hammers used as fighting weapons in nearly all parts of the world since the Stone Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "war hammers"@en .

aat:300201653 a skos:Concept ;
    skos:definition "Clubs used by various North American native peoples as weapons and ceremonial objects. Generally, in the Great Lakes regions they are flat and curved with a knobbed head; in the Plains region they are slender sticks with a stone fastened at one end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pogamoggans"@en .

aat:300201655 a skos:Concept ;
    skos:definition "Instruments used to determine the hardness of materials by measuring the pressure needed to scratch, indent, or pierce the materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sclerometers"@en .

aat:300201656 a skos:Concept ;
    skos:definition "Simple Irish clubs made from a piece of blackthorn or oak wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shillelaghs"@en .

aat:300201658 a skos:Concept ;
    skos:definition "Y-shaped sticks with a band of plastic, leather, or other elastic material attached between the prongs, used to propel small stones in hunting or play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slingshots"@en .

aat:300201661 a skos:Concept ;
    skos:definition "Cannons first manufactured at the Carron Iron Company at Falkirk, Scotland, around 1778 and continuing in use until the late 19th century. They were short and light in relation to their bore, had no trunnions, and were used mainly on ships for firing broadsides at short range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carronades"@en .

aat:300201675 a skos:Concept ;
    skos:definition "Sclerometers that measure the rebound of a standard ball dropped onto a material from a standard height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scleroscopes (TM)"@en .

aat:300201676 a skos:Concept ;
    skos:definition "Devices for measuring the major and minor diameters, lead, straightness, and thread angles of screw threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread gauges"@en .

aat:300201678 a skos:Concept ;
    skos:definition "Pointers or other indicators that mark off the seconds on clocks or watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second hands"@en .

aat:300201680 a skos:Concept ;
    skos:definition "Proportional measuring gauges consisting of two straight, metal bars hinged at one end and graduated for measuring; used in clockmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sectors"@en .

aat:300201685 a skos:Concept ;
    skos:definition "Watches that wind themselves through the movements of the wearer turning rotors, tipping weighted levers, or opening and shutting the case, or by electric motors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-winding watches"@en .

aat:300201686 a skos:Concept ;
    skos:definition "Clocks rewound automatically either by a system of weighted levers or by electric motors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-winding clocks"@en .

aat:300201687 a skos:Concept ;
    skos:definition "Astronomical instruments used for measuring angular distances, especially the altitude of celestial bodies, in order to determine the longitude and latitude of ships at sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sextants"@en .

aat:300201690 a skos:Concept ;
    skos:definition "Any of the adjustable screws, usually in sets of four, in the rim of watch balance wheels used to bring the watch to time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timing screws"@en .

aat:300201693 a skos:Concept ;
    skos:definition "Calipers with an attached vernier scale and adjusting screw or sliding scale for very fine measurement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernier calipers"@en .

aat:300201694 a skos:Concept ;
    skos:definition "Small metal projectiles, round, cylindro-conical, or pointed and streamlined in shape, usually consisting of a lead core in an envelope of some lighter metal and often but not always housed in cartridges, designed to be fired from small arms singly with each firing. For the small solid lead or steel pellets fired from shotguns in multiples with each firing, use \"shot (ammunition).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullets"@en .

aat:300201696 a skos:Concept ;
    skos:definition "Bullets designed to penetrate hard targets such as armored vehicles, generally consisting of a hard core inside a casing of softer metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor-piercing bullets"@en .

aat:300201700 a skos:Concept ;
    skos:definition "Soft-nosed bullets designed to expand their original diameter when they contact any solid resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expanding bullets"@en .

aat:300201702 a skos:Concept ;
    skos:definition "Small arms projectiles, including bullets and cartridges, containing a substance that ignites at the point of impact, designed to penetrate and set fire especially to aircraft, vehicles, buildings, and installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incendiary bullets"@en .

aat:300201704 a skos:Concept ;
    skos:definition "Muzzleloading rifle bullets with a conical head, cylindrical body, and a three-grooved hollow base which, upon firing, expanded to fill the barrel rifling. They were developed in the mid-19th century by Captain Claude-Étienne Minié, among others, but rapidly grew obsolete with the increasing use of breechloading firearms and practical fixed ammunition in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minié balls"@en .

aat:300201706 a skos:Concept ;
    skos:definition "Bullets containing a chemical mixture that ignites when the bullet is fired, producing a trail of colored flame or smoke, making the flight of the bullet visible. Their most common use is in machine gun ammunition, spaced at intervals with the regular ammunition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracer bullets"@en .

aat:300201708 a skos:Concept ;
    skos:definition "Spherical projectiles of stone or iron, usually solid, made to be fired from cannons. For the solid bullets of spherical or conical shape fired from small arms, use \"balls (bullets).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cannonballs"@en .

aat:300201712 a skos:Concept ;
    skos:definition "Shells, oval or round in shape, filled with combustible materials and fired from mortars, howitzers, or artillery guns, used in the late 17th and 18th centuries to set fire to buildings, ships, and fortifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carcasses"@en .

aat:300201714 a skos:Concept ;
    skos:definition "Cartridges lacking the conventional metal case; instead the propellant is mixed with a binder, thus becoming a hard block which is shaped as required, with the bullet recessed into the forward end and a combustible cap fitted into the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caseless cartridges"@en .

aat:300201718 a skos:Concept ;
    skos:definition "Inoperative cartridges or facsimiles used for training in the handling of firearms or to test a firearm's functioning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dummy cartridges"@en .

aat:300201722 a skos:Concept ;
    skos:definition "Bombs fired by ships or aircraft at underwater targets such as submarines, installations, and the underwater part of unarmored hulls, detonated by water pressure, on impact, or magnetically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depth charges"@en .

aat:300201724 a skos:Concept ;
    skos:definition "Mechanical or electronic devices in explosive projectiles and bombs that detonate the explosive charge of ordnance munitions. Spelled \"fuses\" for general use of device in explosive technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuzes"@en .

aat:300201726 a skos:Concept ;
    skos:definition "Clusters of small iron balls, usually nine in number, held together by means of cast iron circular plates at top and bottom with two rings and a central connecting rod, used as cannon shot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grapeshot"@en .

aat:300201732 a skos:Concept ;
    skos:definition "Grenades filled with an incendiary substance such as white phosphorus, designed to kindle fire at their objective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incendiary grenades"@en .

aat:300201735 a skos:Concept ;
    skos:definition "Use to distinguish any type of binding in which the covers are not stiff; may be of various materials, including vellum, paper, cloth, or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limp bindings"@en .

aat:300201737 a skos:Concept ;
    skos:definition "Covers, as of pamphlets, of the same paper as the inside leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self covers"@en .

aat:300201738 a skos:Concept ;
    skos:definition "Explosive weapons used in the 17th century and later, consisting of a large case, usually of bronze, filled with fine gunpowder and placed against a door or gate to blow it in, or against a wall to breach it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petards"@en .

aat:300201754 a skos:Concept ;
    skos:definition "Any devices or combinations of device and material which operate to set off the main igniting charge in an explosive device or firearm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primers"@en .

aat:300201760 a skos:Concept ;
    skos:definition "Shot for cannons, consisting of two spheres, hemispheres, or cylinders connected by a bar of iron, used primarily to destroy masts or rigging in naval combat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar shot"@en .

aat:300201765 a skos:Concept ;
    skos:definition "Cannon shot consisting usually of two balls linked by a length of chain or wire, or sometimes of a single ball with a length of chain attached on opposite sides, used from the 17th to the 19th century to inflict damage on fortifications and most especially on the sails and rigging of ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain shot"@en .

aat:300201767 a skos:Concept ;
    skos:definition "Missiles containing an explosive charge, designed to be launched from ships, submarines, or aircraft into water, where they are self-propelled and usually directable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torpedoes"@en .

aat:300201776 a skos:Concept ;
    skos:definition "Long shirts of mail protecting the arms, torso, and legs to mid-thigh, sometimes also covering the head. They were common in Europe from the 11th to the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hauberks"@en .

aat:300201780 a skos:Concept ;
    skos:definition "Sets of armor for the leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legharnesses"@en .

aat:300201788 a skos:Concept ;
    skos:definition "Gutterlike pauldrons used from the mid-14th century, consisting of a series of articulated semicircular lames protecting the point of the shoulder and upper arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spaudlers"@en .

aat:300201790 a skos:Concept ;
    skos:definition "Term applied to the ensemble of plate armor pieces for the arm below the shoulder, consisting of two cannons linked by a cowter, in use in Europe from the 14th to the 17th century. Also sometimes used to mean cannons worn on the forearm only, including such ancient Greek pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vambraces"@en .

aat:300201792 a skos:Concept ;
    skos:definition "Garments worn on the torso as protection against bullets. Contemporary bulletproof vests commonly incorporate plates of steel, aluminum, fiberglass, or ceramic, or numerous layers of heavy-weave polymer fiber cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulletproof vests"@en .

aat:300201794 a skos:Concept ;
    skos:definition "Protective garments consisting of overlapping plates of steel, aluminum, or bonded fiberglass attached within a nylon jacket. They were developed during the Second World War to protect aircraft crews against fragments from antiaircraft shells, and are now also widely used by ground combat personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flak jackets"@en .

aat:300201800 a skos:Concept ;
    skos:definition "Parts or components of firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firearm components"@en .

aat:300201802 a skos:Concept ;
    skos:definition "Graduated scales attached to the rear sights of firearms, most often rifles, by which the shooter adjusts the sight to allow for the effect of wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind gauges"@en .

aat:300201812 a skos:Concept ;
    skos:definition "Thermometers in which the heat-sensitive element is located at a distance from the temperature-indicating element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telethermometers"@en .

aat:300201842 a skos:Concept ;
    skos:definition "Standing clocks that are positioned on floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor clocks"@en .

aat:300201844 a skos:Concept ;
    skos:definition "Vessels decorated by undercutting so that the surface decoration stands free of the body of the glass, supported by struts. The vessels appear, therefore, to be enclosed in an openwork cage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cage-cups"@en .

aat:300201864 a skos:Concept ;
    skos:definition "Term generally applied to individual serving dishes made of glass and used for various types of desserts. In the 18th century the term also referred to large glass receptacles for serving sweetmeats and fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dessert glasses"@en .

aat:300201866 a skos:Concept ;
    skos:definition "Stemmed dessert glasses for serving various kinds of sweetmeats. Made in a variety of forms and styles, often following the fashions of contemporary drinking glasses. For dishes used for serving sweetmeats, use \"sweetmeat dishes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweetmeat glasses"@en .

aat:300201878 a skos:Concept ;
    skos:definition "Small sweetmeat glasses, usually about 4 inches high, used for serving dry sweetmeats or confections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comfit glasses"@en .

aat:300201911 a skos:Concept ;
    skos:definition "Special glasses introduced in the 18th century for drinking syllabub, which was made with milk curdled by the admixture of wine, cider, or other acid, and often sweetened and flavored. Early examples of these glasses have two handles and a spout; later examples have one or no handles and no spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syllabub glasses"@en .

aat:300201958 a skos:Concept ;
    skos:definition "Spanish guitars of the Renaissance, identical in structure to the standard present-day guitar, but having from five to seven courses of strings (usually six) which are tuned like a lute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vihuelas"@en .

aat:300201964 a skos:Concept ;
    skos:definition "Precious or semiprecious stone that can be cut, polished, or otherwise dressed for use as gems; distinguished from \"gems,\" which are made of gemstone that has been worked or other material such as pearl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gemstone"@en .

aat:300201984 a skos:Concept ;
    skos:definition "Spanish glass drinking vessels with a single long spout from which liquid (usually wine) may be poured into the drinker's mouth without the glass touching the lips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porrones"@en .

aat:300201985 a skos:Concept ;
    skos:definition "Vaselike containers, typically made of glass, intended to be used on the dining table for serving stalks of celery. For relatively low and narrow dishes intended for serving celery, use \"celery dishes.\" For similar vaselike forms also used on the dining table but which often have a scalloped rim and are intended to hold spoons, use \"spoon holders.\" For vaselike forms which are often made of glass but sometimes made of wood or bone and which are usually kept near a fireplace or oil lamp, use \"spill holders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celery glasses"@en .

aat:300201987 a skos:Concept ;
    skos:definition "Bottles consisting of two flattened oval bottles joined at the base and with two curved necks pointed in opposite directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gemel bottles"@en .

aat:300201988 a skos:Concept ;
    skos:definition "Flasks made to be carried in a pocket and therefore not having lugs for a carrying strap. Sometimes made of heavy glass reinforced with added strips of glass or later of glass in leather or metal casings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket flasks"@en .

aat:300201991 a skos:Concept ;
    skos:definition "Books of blank, mostly blank, or ruled pages, or of printed forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blankbooks"@en .

aat:300202113 a skos:Concept ;
    skos:definition "Tone in a halftone image in which dots are eliminated, thus printing white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dropout halftone"@en .

aat:300202115 a skos:Concept ;
    skos:definition "The effect attained when an image has been photographed through a cross hatched screen, breaking the image into small dots, which allows printing from plates or blocks containing tonal areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halftone"@en .

aat:300202119 a skos:Concept ;
    skos:definition "Use to describe an image, or to denote the effect itself, when the image is composed of a smooth gradation of tones. Often used to designate copy that will need to be photographed with a halftone screen in order to be printed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuous tone"@en .

aat:300202126 a skos:Concept ;
    skos:definition "Graphic material for reproduction composed of only black and white with no intermediate tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line copy"@en .

aat:300202250 a skos:Concept ;
    skos:definition "General term used to group instruments similar to, and including, violins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violin family instruments"@en .

aat:300202261 a skos:Concept ;
    skos:definition "Rolls containing texts for the celebration of Easter, including the Exultet hymn, and having illustrations, placed upside down in relation to the text; when the roll was draped over the lectern, the images appeared right side up to the congregation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exultet rolls"@en .

aat:300202271 a skos:Concept ;
    skos:definition "In bookbinding, method of holding pages of a book together with glue, using no stitching or sewing. The back of the volume is trimmed to produce a block of separate leaves, the back edges are roughened, adhesive is applied, and the case is attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfect binding"@en .

aat:300202274 a skos:Concept ;
    skos:definition "Method of adhesive binding used in the mid-19th century employing a rubber solution. The method was discontinued after some years because it was discovered that rubber turns brittle with age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caoutchouc binding"@en .

aat:300202279 a skos:Concept ;
    skos:definition "Those methods for bookbinding that rely on adhesives to hold together the leaves of the volume, so that single leaves are held together using an adhesive rather than a sewn attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesive binding process"@en .

aat:300202290 a skos:Concept ;
    skos:definition "Distinctive mechanical bookbinding process of sewing threads through punched signature folds to create a strong and durable spine, using a specialized machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Smyth sewing"@en .

aat:300202300 a skos:Concept ;
    skos:definition "Dessert glasses for serving an individual portion of custard, sometimes set on a stem and may have a single handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "custard glasses"@en .

aat:300202304 a skos:Concept ;
    skos:definition "Small glass vessels intended for salt or sweetmeats, usually with double ogee or cup-shaped bowls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonnet glasses"@en .

aat:300202317 a skos:Concept ;
    skos:definition "Method of bookbinding in which a hard cover is made wholly separate from the book and later is attached to it by gluing the endpapers to the inside of the boards of the case. Introduced in Great Britain in the 1820s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case binding"@en .

aat:300202324 a skos:Concept ;
    skos:definition "Bindings having a space between the spine of the text block and the spine of the cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow back bindings"@en .

aat:300202334 a skos:Concept ;
    skos:definition "Bindings in which the covering material is glued directly to the spine, or to a lining on the spine, of a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tight back bindings"@en .

aat:300202343 a skos:Concept ;
    skos:definition "Methods of fastening together single leaves of a book by punching them to receive a device to hold them together, such as a plastic comb or a spiral wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical binding"@en .

aat:300202344 a skos:Concept ;
    skos:definition "The process of binding books by hand, including sewing, forwarding, and finishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand binding"@en .

aat:300202350 a skos:Concept ;
    skos:definition "Long, fine, usually spiral, springs used to determine the time of oscillation of balance wheels of timepieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairsprings"@en .

aat:300202351 a skos:Concept ;
    skos:definition "Wheels that oscillate against the tension of balance springs to regulate the beats of clocks or watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balance wheels"@en .

aat:300202354 a skos:Concept ;
    skos:definition "Typefaces that imitate cursive handwriting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "script"@en .

aat:300202362 a skos:Concept ;
    skos:definition "Statements in books concerning the publication or printing of a book, usually printed on the title page, the back of the title page, or at the end of the text. Imprints may include the name of publisher, distributor, and manufacturer, and the place and date of publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imprints"@en .

aat:300202374 a skos:Concept ;
    skos:definition "Stock images used by graphic artists for decoration or illustration; traditionally on paper and clipped out with scissors to be pasted into layouts, more recently, electronic images that can be transferred into a computer application as needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clip art"@en .

aat:300202375 a skos:Concept ;
    skos:definition "The process of recording, transferring, storage, and manipulation of graphic information (such as maps) or images (such as art works) into electronic format for storage, retrieval, and use in computer and video systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic imaging"@en .

aat:300202376 a skos:Concept ;
    skos:definition "Use to describe an activity or something produced by an activity that employs a computer to expedite some of the steps or operations required. When programming generates automatically a relatively large number of the steps between what is input and what is produced, use \"computer-generated.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-assisted"@en .

aat:300202383 a skos:Concept ;
    skos:definition "Converting, sound, motion pictures, images, or other analog data to binary form to be stored or altered with a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digitizing"@en .

aat:300202389 a skos:Concept ;
    skos:definition "Use to describe something that is produced by a computer, especially when the programming generates automatically a relatively large number of the steps between what is input and what is produced; included are visible forms, audio forms, data, and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-generated"@en .

aat:300202390 a skos:Concept ;
    skos:definition "Percussion beaters consisting of a group of metal wires attached to a handle, used to strike drums and cymbals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire brushes"@en .

aat:300202391 a skos:Concept ;
    skos:definition "Typefaces that are a thicker version of the same typeface style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boldface"@en .

aat:300202423 a skos:Concept ;
    skos:definition "Signs or notices, usually of stiff paper or cardboard, posted in public or carried in public, for example by picketers or demonstrators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "placards"@en .

aat:300202470 a skos:Concept ;
    skos:definition "Silver standing cups of which the bowl and cover together are in the form of an acorn and generally with a trunklike stem; of a type made in England in the late 16th century and early 17th century. Acorn cups are similar to gourd cups and reflect the taste of the time for natural forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acorn cups"@en .

aat:300202481 a skos:Concept ;
    skos:definition "Accessory containers for serving food that are comprised of multiple components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite pieces"@en .

aat:300202482 a skos:Concept ;
    skos:definition "Large composite pieces used as a table centerpiece consisting of a tall glass stand, the top of which is a small container, having, at intervals down the stem, several curved arms from which hang small basketlike dishes for sweetmeats. For composite pieces consisting of an arrangement of sweetmeat glasses or jelly glasses on a glass salver, use \"pyramids (containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweetmeat stands"@en .

aat:300202483 a skos:Concept ;
    skos:definition "Composite pieces consisting of an arrangement of sweetmeat glasses or jelly glasses on a glass salver with a tall glass in the center. They were often made in three graduated tiers. For composite pieces consisting of a tall glass stand with small basketlike dishes suspended from branching arms, use \"sweetmeat stands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramids"@en .

aat:300202489 a skos:Concept ;
    skos:definition "Versions of written works produced by condensation and omission but with retention of the general meaning and manner of presentation of the original, often prepared by someone other than the author of the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abridgements"@en .

aat:300202501 a skos:Concept ;
    skos:definition "Visual works that are modifications of other works done for a purpose, use, or medium other than that for which the original was intended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adaptations"@en .

aat:300202507 a skos:Concept ;
    skos:definition "Literary works that employ allegory to express complex abstract ideas, for example works that employ symbolic, fictional figures and actions to express truths or generalizations about human conduct or experience. May be extended to refer to visual works or other creative works that have allegories as subject matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allegories"@en .

aat:300202510 a skos:Concept ;
    skos:definition "Books designed to display the letters of the alphabet, often with accompanying illustrations; may be used to teach the alphabet or as vehicles for an illustrator's art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphabet books"@en .

aat:300202515 a skos:Concept ;
    skos:definition "Words or phrases made by transposing the letters of other words or phrases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anagrams"@en .

aat:300202518 a skos:Concept ;
    skos:definition "Records of events arranged in yearly sequence, usually without comment or interpretation by the compiler. For more connected and full descriptions of events in chronological order, use \"chronicles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annals"@en .

aat:300202519 a skos:Concept ;
    skos:definition "Forms -- which are formulary documents that arrange particular information in a prescribed sequence and format -- that are created with blank spaces, lines, boxes, data entry fields, or other means to prompt users of the form to fill in the particular information. Blank forms may be handwritten, printed, typed, or online. When indexing, this term may be used for such forms whether or not they have been filled in by a user of the form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blank forms"@en .

aat:300202525 a skos:Concept ;
    skos:definition "Religious or contemplative songs of a particular type; may be monophonic and more or less extended (as Gregorian chant: see Gregorian, or else short and formulaic, usually harmonized, and adjusted to the syllables of a prose text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chants"@en .

aat:300202526 a skos:Concept ;
    skos:definition "Books outlining the education, conduct, duties, and training of noble or royal persons, or persons serving at court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtesy books"@en .

aat:300202527 a skos:Concept ;
    skos:definition "Shouts, cries, songs, and rhymes used by those selling wares on the street."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street cries"@en .

aat:300202531 a skos:Concept ;
    skos:definition "Works giving the computed positions of celestial bodies each day or other regular interval; used by navigators and astronomers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ephemerides"@en .

aat:300202533 a skos:Concept ;
    skos:definition "Short satiric poems or any similar pointed sayings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epigrams"@en .

aat:300202541 a skos:Concept ;
    skos:definition "Books, usually illustrated literary anthologies, intended to be given as gifts and often published annually; popular in the 19th century. For works produced to mark an occasion, use \"keepsakes (books).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift books"@en .

aat:300202542 a skos:Concept ;
    skos:definition "Works produced to mark the occasion of a gathering or event, distributed to those in attendance and not usually otherwise available. For 19th-century books intended to be given as gifts, usually illustrated literary anthologies, use \"gift books.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keepsakes"@en .

aat:300202543 a skos:Concept ;
    skos:definition "Periodicals of the type which first appeared at the end of the 19th century devoted to poetry or avant-garde thinking and usually of limited circulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "little magazines"@en .

aat:300202545 a skos:Concept ;
    skos:definition "Records in which are entered sequential data, especially about activities or transactions that occur in a system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logs"@en .

aat:300202559 a skos:Concept ;
    skos:definition "Narratives or histories autobiographical in nature or stressing the author's personal experience of the events. For works that are written daily or on a frequent basis, laying out a day's events and experiences, use \"diaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memoirs"@en .

aat:300202564 a skos:Concept ;
    skos:definition "Allegorical plays offering discourses in praise of morality between actors representing characters such as Charity, Faith, or Death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morality plays"@en .

aat:300202568 a skos:Concept ;
    skos:definition "Forerunners of newspapers, consisting of more than one leaf, published in the 16th and 17th centuries. For similar items consisting of one leaf, use \"corantos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newsbooks"@en .

aat:300202569 a skos:Concept ;
    skos:definition "Short prose tales popular in the Renaissance and for later prose narratives intermediate between novels and short stories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novellas"@en .

aat:300202580 a skos:Concept ;
    skos:definition "Invented prose narratives of considerable length and a certain complexity that deal imaginatively with human experience through a connected sequence of events involving a group of persons in a specific setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novels"@en .

aat:300202593 a skos:Concept ;
    skos:definition "Tales in rhymed verse for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursery rhymes"@en .

aat:300202595 a skos:Concept ;
    skos:definition "Works that record interviews conducted to preserve the recollections of persons whose experience or memories are representative or are of special historical or social significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oral histories"@en .

aat:300202600 a skos:Concept ;
    skos:definition "Reference sources detailing drugs, medicines, and their preparations, use, and dosage, especially those recognized as official or standard. For non-standard references setting out the ingredients and amounts to be used in pharmacological preparations but not including any recommendations for use and dosage, use \"formularies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharmacopoeias"@en .

aat:300202602 a skos:Concept ;
    skos:definition "Books containing the forms for sacraments and rites performed by a bishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pontificals"@en .

aat:300202604 a skos:Concept ;
    skos:definition "Works containing material for instruction and practice in reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "readers"@en .

aat:300202605 a skos:Concept ;
    skos:definition "Used broadly for books containing religious rites and sometimes hymns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service books"@en .

aat:300202607 a skos:Concept ;
    skos:definition "Relatively brief invented prose narratives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "short stories"@en .

aat:300202638 a skos:Concept ;
    skos:definition "Formal Gothic book hands, characterized by lateral compression, angularity, and the identical treatment of all vertical shafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textura"@en .

aat:300202668 a skos:Concept ;
    skos:definition "Representations of words or syllables by pictures of objects or by symbols whose names resemble the intended words or syllables in sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebuses"@en .

aat:300202819 a skos:Concept ;
    skos:definition "Stiff upper and lower covers of books comprising stiff, thick cardboard or other material, often covered with leather, cloth or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boards"@en .

aat:300202991 a skos:Concept ;
    skos:definition "Religious texts used for varied rites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical texts"@en .

aat:300203062 a skos:Concept ;
    skos:definition "Term traditionally used in the Western music tradition for instruments whose sound is produced by vibrating strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stringed instruments"@en .

aat:300203068 a skos:Concept ;
    skos:definition "Printed pieces such as notices or advertisements, usually in the form of single sheets or leaflets, intended for wide distribution to the general public. For similar pieces intended for distribution by hand and often doubling as posters, use \"handbills.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circulars"@en .

aat:300203079 a skos:Concept ;
    skos:definition "Method used in binding pamphlets of only one gathering in which wire staples are passed through the single fold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle stitching"@en .

aat:300203104 a skos:Concept ;
    skos:definition "Drinking cups designed with a lid that fits over the vessel. Usually refers to traditional cups of glass, ceramic, or metal, rather than to modern plastic or metal vessels with screw-on tops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered cups"@en .

aat:300203107 a skos:Concept ;
    skos:definition "Small to medium-sized, stemmed wine glasses of a distinctive type used particularly in the 18th-19th centuries, and intended for drinking claret, which was originally a Rosa wine from Bordeaux but gradually came to mean any red wine from Bordeaux. Claret glasses are typically made of colorless glass, and have a relatively short stem, a relatively small bowl, and a round foot. They are often, but not always, further distinguished by having a bowl that is cut or etched and sometimes flares at the lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claret glasses"@en .

aat:300203112 a skos:Concept ;
    skos:definition "Dishes of varying forms and materials used for serving sweetmeats; includes those suspended from the arms of sweetmeat stands. For stemmed dessert glasses used for serving sweetmeats, use \"sweetmeat glasses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweetmeat dishes"@en .

aat:300203159 a skos:Concept ;
    skos:definition "Recreation complexes that are meeting places for associations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "club complexes"@en .

aat:300203164 a skos:Concept ;
    skos:definition "Small, low, open vessels used to hold salt at the table; made in a variety of forms and may have a flat base or rest on legs or a stemmed foot. For tall vessels used to hold salt, use \"standing salts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saltcellars"@en .

aat:300203165 a skos:Concept ;
    skos:definition "Term applied to lavishly ornamented standing salts, such as those used on the high table at ceremonial banquets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great salts"@en .

aat:300203177 a skos:Concept ;
    skos:definition "Sequence of illustrations containing a story or stories (called \"comics,\" because some are humorous), often serialized, published in booklet form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comic books"@en .

aat:300203193 a skos:Concept ;
    skos:definition "The outer edges of a container, especially a vessel, as well as the adjacent narrow margin. A single object may have more than one rim; a goblet has rims on its bowl and its foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rims"@en .

aat:300203195 a skos:Concept ;
    skos:definition "Small masses of glass, often in the form of round blobs or tear-drop shapes, applied to the body of a glass object primarily for decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prunts"@en .

aat:300203200 a skos:Concept ;
    skos:definition "Generally, concealed vessels which fit snugly within others which isolates the contents from the holder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liners"@en .

aat:300203201 a skos:Concept ;
    skos:definition "Vessel rims usually pierced which extend horizontally a short distance outward from the vessel body then vertically upward, often providing a support for a cover which rests within."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleried rims"@en .

aat:300203202 a skos:Concept ;
    skos:definition "Protruding ledges or rings near the top of the neck of a bottle or jar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "string rims"@en .

aat:300203208 a skos:Concept ;
    skos:definition "Pouring projections formed by eversion of the rim of the mouth or spout of a vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lips"@en .

aat:300203210 a skos:Concept ;
    skos:definition "A type of lip on a container that extends to a point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaks"@en .

aat:300203283 a skos:Concept ;
    skos:definition "Rough place on a blown glass piece where the pontil rod has been broken away. May be ground or ground and polished to form a smooth circular depression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pontil marks"@en .

aat:300203289 a skos:Concept ;
    skos:definition "Type of spout that is attached to a pouring vessel by a horizontal bar or decorative ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridge spouts"@en .

aat:300203331 a skos:Concept ;
    skos:definition "Openings on objects such as vessels, through which the contents enter the cavity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mouths"@en .

aat:300203338 a skos:Concept ;
    skos:definition "Straight spouts with a horizontally cut opening and no lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snip spouts"@en .

aat:300203343 a skos:Concept ;
    skos:definition "Type of spout which has a lip rather than a cut off end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lip spouts"@en .

aat:300203354 a skos:Concept ;
    skos:definition "Footed vessels in the center of which is a column with a pierced gallery for the suspension of spoons. For vaselike containers with a scalloped rim in which spoons are held, use \"spoon holders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoon stands"@en .

aat:300203361 a skos:Concept ;
    skos:definition "Bowls, usually set on a high footed stem and sometimes having a cover, used to serve fruit, compotes, nuts, or sweets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compotes"@en .

aat:300203362 a skos:Concept ;
    skos:definition "Term used by tableware designers and glass manufacturers at the end of the 19th century for U-shaped dishes set on a high stem and intended to hold bananas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banana boats"@en .

aat:300203433 a skos:Concept ;
    skos:definition "Clocks that strike time according to the system of bells used on ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships' clocks"@en .

aat:300203434 a skos:Concept ;
    skos:definition "Astronomical clocks that indicate sidereal time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sidereal clocks"@en .

aat:300203437 a skos:Concept ;
    skos:definition "Object components which are used to cover or close a mouth or other openings on containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closures"@en .

aat:300203439 a skos:Concept ;
    skos:definition "Items that cover, protect, or close a container or other object, usually by fitting around a cylindrical rim or collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caps"@en .

aat:300203440 a skos:Concept ;
    skos:definition "Navigational devices that utilize the shadow of a pin and accompanying dial to facilitate use of the sun in measuring direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun compasses"@en .

aat:300203441 a skos:Concept ;
    skos:definition "Closures which are secured by friction and are usually low and flat-topped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap covers"@en .

aat:300203443 a skos:Concept ;
    skos:definition "Crimped metal bottle caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowns"@en .

aat:300203444 a skos:Concept ;
    skos:definition "Caps with interior threading which screw on and fit securely over the threaded finish of a vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw caps"@en .

aat:300203447 a skos:Concept ;
    skos:definition "Stoppers for the openings of casks where they are filled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bungs"@en .

aat:300203448 a skos:Concept ;
    skos:definition "Usually tapering or cylindrical pieces of cork used as stoppers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corks"@en .

aat:300203449 a skos:Concept ;
    skos:definition "Any of various mechanical instruments used to measure the depth of water and usually consisting of a reel of wire, a weight, and a recording device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sounding machines"@en .

aat:300203450 a skos:Concept ;
    skos:definition "Optical devices for measuring radiant intensities at various wavelengths or the deviation of refracted rays, as from the angles of prisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectrometers"@en .

aat:300203451 a skos:Concept ;
    skos:definition "Instruments on land or water vehicles that measure and indicate the rate of travel; usually graduated in miles, kilometers, or knots per hour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speedometers"@en .

aat:300203452 a skos:Concept ;
    skos:definition "Devices used to measure the curvature of spherical or other curved surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spherometers"@en .

aat:300203453 a skos:Concept ;
    skos:definition "Balances in which the weight of the sample or the exertion of a force is balanced and thus measured by the extension of a spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring balances"@en .

aat:300203454 a skos:Concept ;
    skos:definition "Detachable lengths of tubing inserted into aerophones, either permanently or for a specific playing occasion, for the purpose of either changing the sounding tube length, or to carry the mouthpiece where it is within easier reach of the player."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crooks"@en .

aat:300203455 a skos:Concept ;
    skos:definition "Scales in which measurement is based on the deformation of some elastic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring scales"@en .

aat:300203457 a skos:Concept ;
    skos:definition "Straight poles graduated with numerical and geometric marks that are held upright and used with transits or other surveying instruments equipped with stadia hairs to measure horizontal distances. For similar poles graduated with numerical marks for measuring heights or elevations, use \"leveling rods.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stadia rods"@en .

aat:300203458 a skos:Concept ;
    skos:definition "Slightly projecting rings on the bottoms of vessels on which they stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot rings"@en .

aat:300203461 a skos:Concept ;
    skos:definition "A type of base on a glass vessel made by applying an additional gathering of molten glass to the bottom and spreading it out to form a ring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pad bases"@en .

aat:300203463 a skos:Concept ;
    skos:definition "Encircling bands on containers and other objects. For flat, sharp-edged collars or knops on stemware, use \"mereses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collars"@en .

aat:300203464 a skos:Concept ;
    skos:definition "Relatively narrow, or constricted parts of containers, such as the slender portion of a bottle or vase between the mouth and the shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "necks"@en .

aat:300203465 a skos:Concept ;
    skos:definition "Steplike changes in the contour of an object, such as the transition part of a bottle between its narrow neck and wider body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulders"@en .

aat:300203467 a skos:Concept ;
    skos:definition "Those parts of containers that enclose the contents, as distinguished from accessory components such as covers, handles, and applied decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodies"@en .

aat:300203496 a skos:Concept ;
    skos:definition "Instruments for measuring the distance between an observer and an object of known height by measuring the angle subtended by the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stadimeters"@en .

aat:300203505 a skos:Concept ;
    skos:definition "Timepieces, with one or more sweephands that can be started and stopped at will, used for precise measurement of elapsed time. To refer to timepieces that tell the time of day in addition to these functions, use \"chronographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stopwatches"@en .

aat:300203506 a skos:Concept ;
    skos:definition "Devices that use changes in the electrical resistance of wire to measure pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strain gauges"@en .

aat:300203507 a skos:Concept ;
    skos:definition "The gears and related works that operate the striking mechanism of clocks or watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking trains"@en .

aat:300203539 a skos:Concept ;
    skos:definition "American 19th-century clocks generally resembling an acorn in outline and available in shelf, wall, and mantel styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acorn clocks"@en .

aat:300203548 a skos:Concept ;
    skos:definition "Vessels for holding pieces of ice, made in a variety of forms, sometimes having a cover or handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice buckets"@en .

aat:300203588 a skos:Concept ;
    skos:definition "Clocks that show the day, date, month, and usually also the phases of the moon, as well as time of day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calendar clocks"@en .

aat:300203596 a skos:Concept ;
    skos:definition "Rounded vessels that are generally wider than they are high, usually hemispherical or nearly so. A bowl may have a spreading base or foot ring and sometimes two handles or a cover. Distinguished from a cup, which is rather deep than wide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowls"@en .

aat:300203600 a skos:Concept ;
    skos:definition "Raised and usually ornamented borders of a plate or dish which extend from the well to the rim and are often almost parallel to the bottom of the well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marlis"@en .

aat:300203608 a skos:Concept ;
    skos:definition "Type of knop with flat sharp edges which occurs along the stem or which joins the bowl or foot to the stem of stemware. For other encircling rings on stemware or other vessels, use \"collars (container components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mereses"@en .

aat:300203625 a skos:Concept ;
    skos:definition "Watches that strike the hours in passing; for timepieces that strike the hours at any time upon request, use \"repeaters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock watches"@en .

aat:300203626 a skos:Concept ;
    skos:definition "Small wood caps with a blow hole on top, used to enclose and support the reed of some single or double reedpipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind caps"@en .

aat:300203630 a skos:Concept ;
    skos:definition "People who have legal title to something. For those who own specifically businesses or commercial establishments, use \"proprietors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "owners"@en .

aat:300203641 a skos:Concept ;
    skos:definition "Spurs furnished with a single spike for goading the horse, in common use from the pre-Christian era until the 13th century. Medieval European models generally have conical spikes or a raised molding or ball close to the point to prevent the spike from penetrating too far."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prick spurs"@en .

aat:300203645 a skos:Concept ;
    skos:definition "Parts or components of bevors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bevor components"@en .

aat:300203647 a skos:Concept ;
    skos:definition "Gears that drive the hands of timepieces or some other visual indicators of the time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "going trains"@en .

aat:300203648 a skos:Concept ;
    skos:definition "Ornaments made of feathers, silk, hair or other relatively delicate materials, worn or displayed as decoration or as symbols of honor or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumes"@en .

aat:300203650 a skos:Concept ;
    skos:definition "Raised ridges running from front to back over the top of the skulls of helmets, contributing to their strength and rigidity and providing a better glancing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combs"@en .

aat:300203653 a skos:Concept ;
    skos:definition "Small metal rods attached to the visor or the right side of the helmet to allow the visor to be raised, in use from the late 15th to the second quarter of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifting pegs"@en .

aat:300203657 a skos:Concept ;
    skos:definition "Metal tubes fitted to helmets and shaffrons, typically covered by a small decorative plate, rondel, or shield, to support a plume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plume holders"@en .

aat:300203658 a skos:Concept ;
    skos:definition "Frames of parallel metal bars used for broiling food over coals or an open fire. Also, wood gratings or racks for the same purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gridirons"@en .

aat:300203660 a skos:Concept ;
    skos:definition "Long-handled wood scoops used to remove butter from a churn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter scoops"@en .

aat:300203662 a skos:Concept ;
    skos:definition "Small mills for grinding spices, usually hand-operated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice mills"@en .

aat:300203675 a skos:Concept ;
    skos:definition "Mechanical presses for expressing juice from grapes; used to make wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine presses"@en .

aat:300203680 a skos:Concept ;
    skos:definition "Flat discs or strips of metal or wood between which are held the movements of clocks and watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plates"@en .

aat:300203684 a skos:Concept ;
    skos:definition "Flexible or removable devices used to obstruct or regulate vision or light consisting of flexible panels or of horizontal or vertical slats that can be opened or closed, often with the angle of the slats adjustable to admit varying amounts of light. For heavier coverings, often of wood, permanently affixed to buildings, use \"shutters.\" Prefer \"shades (coverings)\" for flexible screens, usually of paper, cloth, bamboo, or similar materials and sometimes mounted on a roller, used to obstruct or regulate vision or light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window blinds"@en .

aat:300203686 a skos:Concept ;
    skos:definition "Screens used to obstruct or regulate light passing through a window, or obstruct the view from within or without. Usually flexible and made of paper, cloth, bamboo, or similar materials; sometimes mounted on a roller. Prefer \"wndow blinds\" for flexible or removable devices used to obstruct or regulate vision or light consisting of horizontal or vertical slats that can be opened or closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window shades"@en .

aat:300203694 a skos:Concept ;
    skos:definition "Popular term for curtains raised or lowered by cords and rings, made in several variations and distinguished mainly by their bottom hem which, when the curtain is raised, billows in a series of graceful puffs suggesting balloons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon shades"@en .

aat:300203712 a skos:Concept ;
    skos:definition "Helmet components, constituting that part which directly covers and protects the cranium; they occur in various shapes and may be made from either a single piece of metal or two overlapping halves joined at the comb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skulls"@en .

aat:300203717 a skos:Concept ;
    skos:definition "Bevor components constituting the lower portion, protecting the chin and throat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lower bevors"@en .

aat:300203720 a skos:Concept ;
    skos:definition "Bevor components constituting the upper portion, covering the face from eye level to the chin where it overlapped the lower bevor; they often had small slots and holes for ventilation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper bevors"@en .

aat:300203725 a skos:Concept ;
    skos:definition "Short straight-hanging curtains, often in tiers, used to cover the lower and sometimes upper portions of a window or door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "café curtains"@en .

aat:300203726 a skos:Concept ;
    skos:definition "Weapons that are used to strike or hammer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussive weapons"@en .

aat:300203727 a skos:Concept ;
    skos:definition "Weapons that launch projectiles toward targets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projectile weapons"@en .

aat:300203729 a skos:Concept ;
    skos:definition "Open helmets characterized by an almond- or pear-shaped skull, usually topped by a short spike, and a narrow, flat brim. They differ from \"morions,\" which have a comb, shorter crown, and a wider brim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabassets"@en .

aat:300203734 a skos:Concept ;
    skos:definition "Leg armor made of mail, worn from the 11th to the 14th century, consisting either of a strip of mail over the front of the leg laced at the back and under the sole, or a full stocking of mail laced around the leg and secured under the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chausses"@en .

aat:300203739 a skos:Concept ;
    skos:definition "Staff weapons having a three-pronged head with a central triangular double-edged blade, often with a strong medial ridge, with two shorter blades radiating from its base or curving up like the prongs of a trident. They were used from the 15th to the 17th century, mainly in France and Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corsescas"@en .

aat:300203740 a skos:Concept ;
    skos:definition "French and English staff weapons used between the 12th and 14th centuries, having a pointed head with a scythelike blade and a fluke on the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauchards"@en .

aat:300203741 a skos:Concept ;
    skos:definition "Staff weapons having a large sharply pointed blade resembling that of a sword or dagger, often with a short false edge near the point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glaives"@en .

aat:300203743 a skos:Concept ;
    skos:definition "Medieval weapons consisting of a crescent-shaped blade mounted on a long staff, often with the lower tip or occasionally both tips of the edge attached to the staff, and a sharp thrusting spike on top of the staff. They were used by foot soldiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gisarmes"@en .

aat:300203745 a skos:Concept ;
    skos:definition "A combination of café curtains across the lower part of an opening and tieback curtains, usually ruffled, across the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottage curtains"@en .

aat:300203763 a skos:Concept ;
    skos:definition "Symmetrical pairs of curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divided curtains"@en .

aat:300203766 a skos:Concept ;
    skos:definition "Curtains characterized by soft, billowing, crescent-shaped folds produced either by pulling a single curtain straight up, or by pulling a single or divided curtain diagonally up and to the side, by means of rings and cords attached to the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festoon curtains"@en .

aat:300203767 a skos:Concept ;
    skos:definition "Curtains, often in pairs, made of straight pieces of cloth with rings and cords running diagonally on the back of each from bottom center to outer top. When the cords are pulled, the cloth is gathered up and to the side in two swags, with points or tails hanging down to either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double festoons"@en .

aat:300203770 a skos:Concept ;
    skos:definition "Curtains, especially long curtains of heavy fabric, usually hung in carefully arranged folds at the sides of openings, either in a straight or draped fashion, sometimes used over sheer curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draperies"@en .

aat:300203785 a skos:Concept ;
    skos:definition "Narrow curtains fixed at the side of an opening, used purely for decoration as they do not have enough width to be drawn across to cover the intervening space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress curtains"@en .

aat:300203817 a skos:Concept ;
    skos:definition "Light shotguns designed for hunting small game, especially birds, in use from the mid-16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fowling pieces"@en .

aat:300203828 a skos:Concept ;
    skos:definition "Refers to firearms that hinge open at the barrel breech to allow ammunition to be loaded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "break-open"@en .

aat:300203834 a skos:Concept ;
    skos:definition "Guns designed for use in hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting guns"@en .

aat:300203835 a skos:Concept ;
    skos:definition "Firearms designed for military use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martial arms"@en .

aat:300203836 a skos:Concept ;
    skos:definition "Guns that operate using the propulsive power of compressed air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air guns"@en .

aat:300203837 a skos:Concept ;
    skos:definition "Air guns having a pair of flat bellows in the butt which are squeezed together by a spring or springs when the trigger is pressed, producing a strong blast of air to propel the projectile. They were popular in southern Germany and Austria in the 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellows guns"@en .

aat:300203838 a skos:Concept ;
    skos:definition "Air guns embodying a reservoir of compressed air, filled by a pump, and a trigger mechanism that releases enough air to propel one shot at a time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pump-up air guns"@en .

aat:300203839 a skos:Concept ;
    skos:definition "Air guns in which the blast of compressed air is released by means of a spring-operated piston which must be recocked between shots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring air guns"@en .

aat:300203842 a skos:Concept ;
    skos:definition "Pocket pistols designed to be held in the palm of the hand and fired by closing the fist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palm pistols"@en .

aat:300203846 a skos:Concept ;
    skos:definition "Revolvers, generally breechloading, designed to fire cartridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartridge revolvers"@en .

aat:300203858 a skos:Concept ;
    skos:definition "Rugs intended for use as door curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door rugs"@en .

aat:300203863 a skos:Concept ;
    skos:definition "Valances consisting of lengths of fabric draped around or from a rod, pole, or mounting board; used either with curtains or alone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draped valances"@en .

aat:300203876 a skos:Concept ;
    skos:definition "Valances draped in soft, billowing, crescent-shaped folds, sometimes with tails at the ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festooned valances"@en .

aat:300203893 a skos:Concept ;
    skos:definition "Thin, flat-hanging curtains fitted against the glass of a window or door, or immediately over a shade, and usually kept drawn over the glass to soften the light and give privacy. For thin, often sheer curtains used under the main curtains to soften light, use \"undercurtains.\" For curtains made of any transparent or very lightweight material, often plain white and often used as undercurtains, use \"sheer curtains.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass curtains"@en .

aat:300203898 a skos:Concept ;
    skos:definition "Stiff, flat valances with decoratively shaped lower edges, often descending at either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lambrequins"@en .

aat:300203900 a skos:Concept ;
    skos:definition "Curtains that can be drawn to the side, especially those that slide back and forth on a rod or track through a system of cords and pulleys operated either by hand or electrically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draw curtains"@en .

aat:300203915 a skos:Concept ;
    skos:definition "Long curtains, reaching to the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor-length curtains"@en .

aat:300203927 a skos:Concept ;
    skos:definition "Blinds with narrow slats that become practically invisible when positioned horizontally, giving an unobstructed view to the outside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniblinds"@en .

aat:300203931 a skos:Concept ;
    skos:definition "Stage curtains that are lowered instead of drawn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop curtains"@en .

aat:300203933 a skos:Concept ;
    skos:definition "Sheer ruffled curtains hung on double rods so that one curtain overlaps the other; always with ruffled tiebacks, and often with matching ruffled valance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "priscilla curtains"@en .

aat:300203938 a skos:Concept ;
    skos:definition "Curtains hung in doorways or archways to separate spaces, prevent drafts, or serve as decorative elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portieres"@en .

aat:300203943 a skos:Concept ;
    skos:definition "Curtains that pull straight up by means of rings and cords attached to the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pull-up curtains"@en .

aat:300203949 a skos:Concept ;
    skos:definition "Rifles specially designed for particular target shooting matches in which artificial supports were not used, originating in Germany in the 15th century and popular in the United States from the early 19th century until the First World War. They are characterized by long, heavy octagonal barrels, often with extra weight at the muzzle, palm rests, double set triggers, thick stocks, and very high quality, accurate sights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schuetzen rifles"@en .

aat:300203952 a skos:Concept ;
    skos:definition "Window shades mounted on a roller at the top of a window frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller shades"@en .

aat:300203967 a skos:Concept ;
    skos:definition "Glass curtains, usually shirred, stretched taut between lightweight top and bottom rods, or sometimes hanging loose at the bottom; popular for doors, casement windows, and lower window sashes, which require curtains that will not interfere with their opening and closing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash curtains"@en .

aat:300203975 a skos:Concept ;
    skos:definition "Firearm ignition mechanisms in which a fulminate or gunpowder priming powder is struck and explodes, thereby detonating the propellant. The most developed versions feature a percussion cap, fitted over a nipple screwed into the breech and pierced by a small hole that connects with the propellant; when struck by the hammer, the cap sends a small jet of flame into the propellant, igniting it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion locks"@en .

aat:300203978 a skos:Concept ;
    skos:definition "In firearms, metal tubes closed at one end that hold the projectile and the propellant charge and, utilizing the explosive force of the charge, act as the path for the projectile. They may be smoothbore or rifled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrels"@en .

aat:300203988 a skos:Concept ;
    skos:definition "The combinations of frame and handle that contain or join together the various other components of a firearm so that it can be handled, aimed, and fired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stocks"@en .

aat:300203990 a skos:Concept ;
    skos:definition "Curtains made of any transparent or very lightweight material, usually plain white, often used as undercurtains. For sheer curtains fitted against the glass in an opening, use \"glass curtains.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheer curtains"@en .

aat:300203991 a skos:Concept ;
    skos:definition "Use specifically for the parts of the firing mechanisms of small arms that initiate firing when pressed or moved by the finger, typically a hinged metal lever acting on the sear in the lock. Use also in the general sense for any mechanical or electronic devices activating a firearm or crossbow by a press of the finger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triggers"@en .

aat:300203998 a skos:Concept ;
    skos:definition "Waterproof curtains, or curtains with waterproof liners, to be hung across a bathtub or shower stall opening to contain splashing water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shower curtains"@en .

aat:300203999 a skos:Concept ;
    skos:definition "Gun carriages consisting basically of a central beam flanked by two lateral supports, its back end resting on the ground and its front end attached to an axletree for the front wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel carriages"@en .

aat:300204001 a skos:Concept ;
    skos:definition "Gun mounts consisting of two small side panels, joined at the base to a center column which swivels on a fixed pedestal, enabling the weapon to be trained rapidly and to fire vertically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal mountings"@en .

aat:300204002 a skos:Concept ;
    skos:definition "Curtains that reach the window sill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sill-length curtains"@en .

aat:300204003 a skos:Concept ;
    skos:definition "Gun mounts featuring a block made of two rigidly joined triangular or trapezoidal side panels, supporting the trunnions on which the gun barrel rests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block mountings"@en .

aat:300204007 a skos:Concept ;
    skos:definition "Weapons that contain an explosive compound or agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "explosive weapons"@en .

aat:300204010 a skos:Concept ;
    skos:definition "Projectiles or stationary devices containing both a detonating mechanism and a harmful agent such as an explosive, poison gas, biological poison, or incendiary substance, set off by a time fuse or by impact. For the hollow projectiles containing shrapnel, explosives, incendiary or poisonous chemicals, or other harmful agents, designed to be fired from artillery, use \"shells (ammunition).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombs"@en .

aat:300204021 a skos:Concept ;
    skos:definition "Bombs in which the explosion results from the energy released by the splitting or combining of atomic nuclei."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear bombs"@en .

aat:300204022 a skos:Concept ;
    skos:definition "Bombs designed to be dropped from aircraft, first seriously developed during the First World War."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial bombs"@en .

aat:300204028 a skos:Concept ;
    skos:definition "Weapons consisting of a container fitted with a priming charge and a bursting charge, and filled with a destructive agent such as high explosives, gas, or incendiary chemicals, propelled from firearms or thrown by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grenades"@en .

aat:300204031 a skos:Concept ;
    skos:definition "Wallpapers decorated with only a single solid ground color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain papers"@en .

aat:300204032 a skos:Concept ;
    skos:definition "Wallpapers decorated with a pattern of alternating vignettes framed by vertical stripes, flowers, or foliage. Used also for the individual vignettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape figures"@en .

aat:300204033 a skos:Concept ;
    skos:definition "Hand or rifle grenades containing a filling which generates a gas or smoke that causes tears, sneezing, and nausea in the victims, used primarily for riot or crowd control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tear gas grenades"@en .

aat:300204034 a skos:Concept ;
    skos:definition "Hand or rifle grenades containing a smoke-producing chemical mixture, used for signaling or screening. Different types produce either white or colored smoke."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoke grenades"@en .

aat:300204035 a skos:Concept ;
    skos:definition "18th-century term for imported Chinese wallpapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "India papers"@en .

aat:300204036 a skos:Concept ;
    skos:definition "Grenades designed specifically for use against tanks or other armored vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antitank grenades"@en .

aat:300204037 a skos:Concept ;
    skos:definition "Wallpapers decorated with simple patterns or stripes, usually printed with only one or two colors and often lacking a ground color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common papers"@en .

aat:300204038 a skos:Concept ;
    skos:definition "Grenades specifically designed to explode into and scatter fragments, used against personnel rather than mechanized vehicles, installations, or structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antipersonnel grenades"@en .

aat:300204039 a skos:Concept ;
    skos:definition "Encased explosives detonated by contact, the passage of time, magnetic force, sound waves, or other means, designed to destroy or damage land vehicles, watercraft, or aircraft, or to wound or kill personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mines"@en .

aat:300204043 a skos:Concept ;
    skos:definition "Wallpapers with a washable surface, particularly such paper made in the late 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanitary papers"@en .

aat:300204045 a skos:Concept ;
    skos:definition "Wallpapers designed for use on ceilings, often with tiny repeating patterns or astronomical motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling papers"@en .

aat:300204047 a skos:Concept ;
    skos:definition "Mines placed on or just below the surface of the ground, designed to be detonated on command by electrical impulse or by the weight of vehicles or personnel passing over them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land mines"@en .

aat:300204052 a skos:Concept ;
    skos:definition "Curtains consisting of straight panels of cloth tacked to the top of the window frame or sometimes suspended from rods by rings or loops attached at the top of the curtain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight hanging curtains"@en .

aat:300204053 a skos:Concept ;
    skos:definition "Mines designed to be located underwater and exploded by means of propeller or engine vibration, magnetic attraction, contact, timer device, or remote control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater mines"@en .

aat:300204057 a skos:Concept ;
    skos:definition "Wallpapers used to cover the main portions of walls between borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fill papers"@en .

aat:300204060 a skos:Concept ;
    skos:definition "Wall coverings of various materials, including paper, which are characterized by embossed patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossed wall coverings"@en .

aat:300204069 a skos:Concept ;
    skos:definition "Curtains designed to be tied back in a partly open position, often with bands of the same material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tieback curtains"@en .

aat:300204075 a skos:Concept ;
    skos:definition "Blinds having overlapping horizontal slats that may be opened or closed, especially ones in which the slats may be raised and drawn together above the opening by pulling a cord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "venetian blinds"@en .

aat:300204076 a skos:Concept ;
    skos:definition "Blinds having overlapping vertical slats that may be opened or closed, and may be drawn together to one side of the opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical blinds"@en .

aat:300204078 a skos:Concept ;
    skos:definition "Hollow projectiles containing harmful agents such as shrapnel, explosives, or incendiary or poisonous chemicals, designed to be fired from artillery. For the explosive weapons, including both projectiles and stationary devices, which incorporate both a detonating mechanism and explosives or other harmful agents, use \"bombs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shells"@en .

aat:300204082 a skos:Concept ;
    skos:definition "Stage curtains that open in the center by being pulled diagonally up and to the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tableau curtains"@en .

aat:300204086 a skos:Concept ;
    skos:definition "Small pellets 0.175 or 0.18 inch in diameter, used in shotgun cartridges or for use in BB guns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BB shot"@en .

aat:300204087 a skos:Concept ;
    skos:definition "Cylindrical cases containing a charge of powder and a bullet or quantity of shot for a single shot from a firearm, first appearing in the late 16th century. Early types had cases of paper, pasteboard, or linen which were ignited externally, while more recent ones have metal or plastic cases holding their own means of ignition, such as a percussion cap, at one end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartridges"@en .

aat:300204093 a skos:Concept ;
    skos:definition "Curtains that hang below or under the main curtains, usually at a window. Examples are thin, often sheer or lace, curtains positioned under the main curtains to soften light and give privacy. For flat-hanging undercurtains fitted against the glass of a window or door, or immediately over a shade, use \"glass curtains.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undercurtains"@en .

aat:300204120 a skos:Concept ;
    skos:definition "Wallpapers made to be hung as window shades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain papers"@en .

aat:300204121 a skos:Concept ;
    skos:definition "Shades with narrow, sharply pleated folds, resembling the musical instrument. For shades that pull up in wide horizontal pleats, use \"Roman shades.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accordion shades"@en .

aat:300204122 a skos:Concept ;
    skos:definition "Curtains and other cloth hangings on or around a bed; used for decoration, privacy, control of light and drafts, or as protective coverings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed hangings"@en .

aat:300204124 a skos:Concept ;
    skos:definition "Curtains on or around a bed, that can be opened or closed for privacy, control of light and drafts, or protection against dust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed curtains"@en .

aat:300204127 a skos:Concept ;
    skos:definition "Horizontal cloth hangings fixed to the tester or canopy of a bed; generally used as decorative headings to conceal the tops of bed curtains and their hardware. For valances around the base of a bed, use \"base valances.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed valances"@en .

aat:300204128 a skos:Concept ;
    skos:definition "Crudely printed and hand-colored papers made by dominotiers and used as wallpapers, as endpapers in books, or to line boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domino papers"@en .

aat:300204129 a skos:Concept ;
    skos:definition "Papers produced or used for lining containers or storage spaces such as boxes, trunks, or drawers, often decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lining papers"@en .

aat:300204132 a skos:Concept ;
    skos:definition "Cartridges containing an explosive propellant but no projectile, designed to produce a loud noise on firing and used for signalling, training, firing salutes, or to mimic the effect of real gunfire in theatrical performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blank cartridges"@en .

aat:300204134 a skos:Concept ;
    skos:definition "Cartridges characterized by a detonating pin projecting from the base which, when struck by the hammer, detonated the priming powder in a small cap inside the cartridge case, thus setting off the main charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinfire cartridges"@en .

aat:300204139 a skos:Concept ;
    skos:definition "Valances hanging from the lower edge of a bed or bedcover; used decoratively to conceal the base of the bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base valances"@en .

aat:300204154 a skos:Concept ;
    skos:definition "Embossed paper wall coverings which were painted after being hung; made by a process patented by T. J. Palmer in 1887."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anaglypta"@en .

aat:300204155 a skos:Concept ;
    skos:definition "Use specifically for the subprojectiles, usually small lead or steel bars or balls, contained in certain artillery shells designed to explode in midair, scattering the contents in every direction. May also be used generally to include the fragments of the cases of exploding shells, antipersonnel grenades, mines, or bombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrapnel"@en .

aat:300204157 a skos:Concept ;
    skos:definition "Artillery shells designed to be fired from the ground at flying aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiaircraft shells"@en .

aat:300204159 a skos:Concept ;
    skos:definition "Artillery shells designed to penetrate hard targets such as armored vehicles and warships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor-piercing shells"@en .

aat:300204160 a skos:Concept ;
    skos:definition "Embossed wall covering made of molded canvas which provided a textured surface for paint and gilding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tynecastle canvas"@en .

aat:300204162 a skos:Concept ;
    skos:definition "Curtains at the foot of a bed that could be drawn either in two directions, to cover the lower half of the sides and meet in the center of the end, or to cover the lower half of the sides only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foot curtains"@en .

aat:300204163 a skos:Concept ;
    skos:definition "Bed curtains hung at the upper side ends of the bed, that could be drawn to cover the upper portion of each side. For stationary hangings at the head of a bed, use \"headcloths (bed hangings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "head curtains"@en .

aat:300204165 a skos:Concept ;
    skos:definition "Base valances with floor-length ruffles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust ruffles"@en .

aat:300204176 a skos:Concept ;
    skos:definition "Inner and outer bed valances which allow curtains to be drawn between them, thus concealing curtain hardware both to the interior and exterior of the bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double valances"@en .

aat:300204181 a skos:Concept ;
    skos:definition "The inner of two sets of bed valances, which conceals curtain hardware to the interior of the bed; often less richly decorated and perhaps shorter than the outer valances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inner valances"@en .

aat:300204185 a skos:Concept ;
    skos:definition "The outer of two sets of bed valances, which conceals curtain hardware to the exterior of the bed; often more richly decorated and perhaps a little longer than the inner valances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outer valances"@en .

aat:300204190 a skos:Concept ;
    skos:definition "Single stationary hangings at the head of a bed, generally matching the bed curtains. For side curtains at the upper end of a bed, use \"head curtains.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headcloths"@en .

aat:300204194 a skos:Concept ;
    skos:definition "Textile covering stretched over an open tester frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tester cloths"@en .

aat:300204197 a skos:Concept ;
    skos:definition "18th-century wall coverings made in Germany and neighboring areas of textile saturated in molten wax and oil then painted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wachstuchtapeten"@en .

aat:300204198 a skos:Concept ;
    skos:definition "Sets of wallpapers which consist of separate printed elements, including borders and plain or elaborate fill papers, used in combination to create the effect of panels on the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fresco papers"@en .

aat:300204220 a skos:Concept ;
    skos:definition "Coverings that are used for soft furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coverings for soft furnishings"@en .

aat:300204228 a skos:Concept ;
    skos:definition "Common soldiers' armor worn during the 15th and 16th centuries, typically sleeveless and of waist-length or slightly longer. One form had small overlapping iron or horn plates fixed inside between layers of fabric by trellis-pattern stitching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacks"@en .

aat:300204231 a skos:Concept ;
    skos:definition "Armored sleeveless jackets used by infantry from the mid-14th century to the beginning of the 17th century, consisting of small rectangular metal plates, overlapping in vertical strips, mounted on a fabric or hide support in parallel rows, the whole being sewn to a quilted jacket which gave the garments their final shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brigandines"@en .

aat:300204236 a skos:Concept ;
    skos:definition "Parts or components of vambraces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vambrace components"@en .

aat:300204238 a skos:Concept ;
    skos:definition "Gauntlets provided with articulated fingers, separated from each other to allow more independent movement of the individual fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fingered gauntlets"@en .

aat:300204343 a skos:Concept ;
    skos:definition "Small but heavy pieces of plate armor screwed onto the breastplate, shaped to the contour of the left shoulder and also covering the left side of the breast and upper arm, with the lower edge jutting out to partially protect the left forearm holding the reins. They served as double pieces for tilt armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilting targets"@en .

aat:300204360 a skos:Concept ;
    skos:definition "Oblong plates hung in pairs, one on each side, from under the saddle to protect the horse's flanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flanchards"@en .

aat:300204376 a skos:Concept ;
    skos:definition "Double pieces to reinforce the visor, consisting of a plate shaped to the lower half of the visor and to the chin, attached to the helmet by a strap around the neck and buckled at the back. Designed for armets and close helmets, they were used in jousts and tournaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrappers"@en .

aat:300204446 a skos:Concept ;
    skos:definition "Bayonets that are permanently attached to the firearm barrel, slid forward or unfolded for use by hand or some type of spring mechanism when needed, and retractable when not. They were widely used on pistols and blunderbusses in the 18th and 19th centuries and some 20th century and contemporary military rifles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "integral bayonets"@en .

aat:300204453 a skos:Concept ;
    skos:definition "Long, heavy single-edged Philippine knives similar to machetes, used as weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolos"@en .

aat:300204480 a skos:Concept ;
    skos:definition "Spears designed specifically for hunting, typically with wings on the blade or a crossbar just below it to prevent an impaled animal from running up the blade as well as to facilitate quick withdrawl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting spears"@en .

aat:300204481 a skos:Concept ;
    skos:definition "Long spears used in hunting bears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bear spears"@en .

aat:300204483 a skos:Concept ;
    skos:definition "Spears designed for use in hunting pigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pig spears"@en .

aat:300204490 a skos:Concept ;
    skos:definition "Dueling or fencing swords, heavier than foils or sabers, having a cup hilt and a deeply grooved three-sided blade with a sharply pointed end and no cutting edge; those used in fencing are blunted with a button."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "épées"@en .

aat:300204516 a skos:Concept ;
    skos:definition "Swords with relatively short, pointed, single-edged, curved or straight blades designed primarily for cutting. They served as all-purpose weapons, used by civilians, hunters, sailors, and infantry soldiers, from the 16th to the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangers"@en .

aat:300204526 a skos:Concept ;
    skos:definition "Fencing swords, lighter than épées, having a light, very flexible, quadrangular blade with a button on the end, generally used for practice or for recreational and competitive fencing. Since the 1930s, the button has been made as a spring-loaded contact device acting on pressure to score hits by means of electrical signals. Formerly, the term was used for all swords with blunted points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foils"@en .

aat:300204557 a skos:Concept ;
    skos:definition "Racks with vertical partitions for holding and serving several (usually four to eight) slices of toast on edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toast racks"@en .

aat:300204569 a skos:Concept ;
    skos:definition "Swords of honor presented by sovereigns, princes, popes, associations, or admirers in general to individuals as awards or tokens in recognition of achievements in war or political life, typically smallswords, dress swords, or sabers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation swords"@en .

aat:300204570 a skos:Concept ;
    skos:definition "Light swords worn by European and American military officers as part of dress uniform, beginning in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress swords"@en .

aat:300204571 a skos:Concept ;
    skos:definition "Swords carried during public ceremonies and rituals to signify the authority of the owner or wearer. They were often carried point up by a body guard or other attendant following the owner, rather than worn by him."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bearing swords"@en .

aat:300204572 a skos:Concept ;
    skos:definition "Swords designed primarily for cutting blows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting swords"@en .

aat:300204578 a skos:Concept ;
    skos:definition "Blunt swords designed specifically for the sport of fencing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fencing swords"@en .

aat:300204590 a skos:Concept ;
    skos:definition "Wallpapers with a shiny polished ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satin papers"@en .

aat:300204598 a skos:Concept ;
    skos:definition "Bed coverings of cotton, linen, or the like, commonly used in pairs so that one is immediately above and the other immediately below the sleeper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheets"@en .

aat:300204602 a skos:Concept ;
    skos:definition "Sheets for a bed, having boxed corners to fit the mattress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fitted sheets"@en .

aat:300204608 a skos:Concept ;
    skos:definition "Refers to the upper sheet for a bed, often with a decorative top border, which may be turned down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top sheets"@en .

aat:300204611 a skos:Concept ;
    skos:definition "Devices for launching rockets, typically consisting of a tube or cluster of tubes, braced during operation on a support such as a gun carriage, motor vehicle, or tripod, or held in the hands or on the shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocket launchers"@en .

aat:300204619 a skos:Concept ;
    skos:definition "Warm, thin, blanketlike sheets designed for use on a bed in winter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter sheets"@en .

aat:300204625 a skos:Concept ;
    skos:definition "Tentlike hangings designed to be suspended over a bed or cradle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sparvers"@en .

aat:300204635 a skos:Concept ;
    skos:definition "Artillery pieces installed on ships for attack or defense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval guns"@en .

aat:300204649 a skos:Concept ;
    skos:definition "Flat wedge- or fin-shaped appendages fixed to the rear of the shaft of an arrow or dart to enhance the range and accuracy of their flight. They have been made from a number of different materials, typically bird feathers but also parchment, cuir bouilli, wood, and plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feathers"@en .

aat:300204653 a skos:Concept ;
    skos:definition "Long, straight, poles of metal or wood, usually circular in section, that constitute the main bodies of staff weapons, serving as handles and to carry the heads. For the smaller objects of similar form constituting the main bodies of arrows, use \"shafts (tool components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staffs"@en .

aat:300204659 a skos:Concept ;
    skos:definition "Devices fixed to the handles of edged weapons to protect the user's hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guards"@en .

aat:300204661 a skos:Concept ;
    skos:definition "Simple hilts in which the grip and quillons, together with the blade of the weapon, form the outline of a Latin cross."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross hilts"@en .

aat:300204665 a skos:Concept ;
    skos:definition "Portable containers of wood, horn, metal, leather, or ceramic used to hold the priming powder or gunpowder for firearms. They normally terminated in a metal nozzle which also served as a powder measure, closed by a plug or spring cap, and are often highly decorated. Prefer \"powder horns\" for those made from the horn of a cow or oxen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder flasks"@en .

aat:300204666 a skos:Concept ;
    skos:definition "Devices for testing the strength of gunpowder by igniting a measured quantity, causing an indicator to move along a numbered scale against which the relative strength of the powder is read."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder testers"@en .

aat:300204668 a skos:Concept ;
    skos:definition "Rods of wood or metal used from the 15th century to drive the ball and powder charge into the breech of a firearm barrel or to clean it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramrods"@en .

aat:300204674 a skos:Concept ;
    skos:definition "Complete sets of horse armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bards"@en .

aat:300204697 a skos:Concept ;
    skos:definition "Lightweight textile coverings that are casually draped or laid over something, primarily as decoration but often also for warmth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throws"@en .

aat:300204700 a skos:Concept ;
    skos:definition "Knitted or crocheted throws composed of strips or squares sewn or crocheted together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "afghans"@en .

aat:300204722 a skos:Concept ;
    skos:definition "Tapestry-woven Navajo rugs depicting a center block joined to four corner blocks by zigzag lines, suggesting thunderbolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm pattern rugs"@en .

aat:300204729 a skos:Concept ;
    skos:definition "Tapestry-woven rugs depicting one of many Navajo ceremonial sand paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandpainting rugs"@en .

aat:300204744 a skos:Concept ;
    skos:definition "Quasi-ceremonial, tapestry-woven pictorial rugs featuring representations of the yei, the Navajo Holy People, as they were depicted in sand paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yei rugs"@en .

aat:300204756 a skos:Concept ;
    skos:definition "Tapestry-woven Navajo pictorial rugs depicting yeibichai, Navajo dancers impersonating the yei, or Holy People."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yeibichai rugs"@en .

aat:300204798 a skos:Concept ;
    skos:definition "Overshoes of rubber or other waterproof fabric, especially those that extend above the ankle and that often have buckles or other fasteners. Use \"rubbers\" for overshoes without buckles or fasteners that are cut below the ankle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galoshes"@en .

aat:300204851 a skos:Concept ;
    skos:definition "Originally a term for hangings behind or on the backs of either seats or altars. Today a term referring to curtains behind or on the backs of altars. For wall hangings above and behind an altar and containing religious images, use \"altarpieces.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dossals"@en .

aat:300204852 a skos:Concept ;
    skos:definition "Long, narrow, flexible strips of linen, steel, or wire-woven cloth graduated to measure distances and often stored coiled in a protective casing into which they can be rewound after use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape measures"@en .

aat:300204854 a skos:Concept ;
    skos:definition "Padded coverings for food or for containers containing food, used to retain heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cozies"@en .

aat:300204857 a skos:Concept ;
    skos:definition "Cloth or plastic coverings used to protect furniture and equipment, as during a period of nonuse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dust covers"@en .

aat:300204859 a skos:Concept ;
    skos:definition "Protective, sleeve- or mantlelike coverings for the Torah scroll; often richly embroidered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torah mantles"@en .

aat:300204864 a skos:Concept ;
    skos:definition "Cloth coverings for altars often with decorative edgings and individual embroidered motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar cloths"@en .

aat:300204865 a skos:Concept ;
    skos:definition "Consecrated, square white linen or hemp cloths upon which the chalice and paten are placed when the Eucharist is celebrated. The cloths were originally large enough to cover the surface of the altar, but since the 12th century, corporals have become smaller, only large enough to contain the chalice and host. According to liturgical rules, the cloth may be edged with fine lace, and a cross may be embroidered at the front edge, but it is not permitted to have any embroidery in its center in order to maintain an even surface to support the chalice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporals"@en .

aat:300204866 a skos:Concept ;
    skos:definition "Valancelike hangings at the front edge of an altar, often embroidered to match the altar frontal. For large superfrontals hung above and behind an altar and containing religious images, use \"altarpieces.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superfrontals"@en .

aat:300204870 a skos:Concept ;
    skos:definition "Self-recording thermometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermographs"@en .

aat:300204872 a skos:Concept ;
    skos:definition "Square textile coverings used to cover both chalice and paten before and after communion. A chalice veil is placed over the chalice, paten, and purificator when the vessels are prepared for the Eucharist and placed on the altar; it is removed before the Consecration. It may be embellished and of the same color as the liturgical vestments. For stiff squares covering just the top of the chalice, use \"palls (chalice covers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalice veils"@en .

aat:300204873 a skos:Concept ;
    skos:definition "Thermometers without scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoscopes"@en .

aat:300204874 a skos:Concept ;
    skos:definition "Large textile coverings used by the Orthodox Eastern Church to cover both chalice and paten together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great aëres"@en .

aat:300204875 a skos:Concept ;
    skos:definition "Small textile coverings used by the Orthodox Eastern Church to cover chalice and paten separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "little aëres"@en .

aat:300204877 a skos:Concept ;
    skos:definition "Devices for measuring the height of tides; may consist of a graduated rod for visual observation or elaborate electronic devices making a continuous graphic record over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tide gauges"@en .

aat:300204878 a skos:Concept ;
    skos:definition "Large veils decorated with the body of the crucified Christ which are used in Good Friday services in the Orthodox Eastern Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epitaphioi"@en .

aat:300204879 a skos:Concept ;
    skos:definition "Consecrated, relatively small stiffened squares of linen used to cover the top of the chalice. The purpose of the pall is to keep dust and insects from falling into the Eucharistic elements. For larger, softer coverings over both chalice and paten in transportation, use \"chalice veils.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palls"@en .

aat:300204880 a skos:Concept ;
    skos:definition "Textile coverings for the tabernacle, which holds the consecrated host and is located in, on, or near the high altar of a church. The tabernacle veil is often of a prescribed liturgical color, based on the period of the church calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabernacle veils"@en .

aat:300204882 a skos:Concept ;
    skos:definition "Textile coverings sized according to the tray and worked in any technique, so long as they are washable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tray cloths"@en .

aat:300204886 a skos:Concept ;
    skos:definition "Artifacts, often textiles, that are hung on walls, especially for protection, warmth or embellishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall hangings"@en .

aat:300204890 a skos:Concept ;
    skos:definition "Vertical arrangement of fabric with regular folds that appear to fall one over another, with a tapered lower hem falling in a broken diagonal to one side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tails"@en .

aat:300204891 a skos:Concept ;
    skos:definition "Decorative textiles hung loosely from two or more intervals to form soft, billowing, crescent-shaped folds. Distinct from \"festoons,\" which refers to flowers, fruit, or foliage similarly hung."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swags"@en .

aat:300204892 a skos:Concept ;
    skos:definition "Refers to the short vertical arrangement of draped fabric, with a tapered lower hem falling in a broken diagonal, often used as the center ornament of a festoon curtain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipes"@en .

aat:300204894 a skos:Concept ;
    skos:definition "Decorative strips or loops, as of cloth, cord, or metal, designed to hold a curtain or drapery back to one side, so that it is draped in a partially open position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiebacks"@en .

aat:300204895 a skos:Concept ;
    skos:definition "Parts or components of quilts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilt components"@en .

aat:300204896 a skos:Concept ;
    skos:definition "The basic unit of many quilt tops which, sewn together or to setting blocks or sashes, create the design. Blocks are composed of one or many patches, either pieced or appliquéd. Blocks are commonly square, but can also be in other geometric shapes such as hexagons or circles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blocks"@en .

aat:300204898 a skos:Concept ;
    skos:definition "Blocks of material sometimes used to join together the sections of a quilt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setting blocks"@en .

aat:300204899 a skos:Concept ;
    skos:definition "Component pieces of quilt blocks, either pieced or appliquéd."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patches"@en .

aat:300204900 a skos:Concept ;
    skos:definition "Individual shapes cut from a single piece of textile that are components of quilt patches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pieces"@en .

aat:300204901 a skos:Concept ;
    skos:definition "Refers to the top layer of a quilt, often left unfinished, without backing, filling, or quilting. Distinct from \"summer spreads,\" which have finished edges and seams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilt tops"@en .

aat:300204905 a skos:Concept ;
    skos:definition "Refers to the fixed soft coverings for furniture, especially seating and reclining furniture. Originally referred to all the textile components of a room supplied by upholsterers, including wall hangings, bed hangings, window curtains, and table coverings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery"@en .

aat:300204906 a skos:Concept ;
    skos:definition "Parts or components of upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery components"@en .

aat:300204907 a skos:Concept ;
    skos:definition "All upholstery components under the final top covers, including stuffing, springs, and other component parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery foundations"@en .

aat:300204911 a skos:Concept ;
    skos:definition "Elastic bodies, often strips or wires of steel coiled spirally, that recover their shape after being compressed, bent, or stretched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springs"@en .

aat:300204912 a skos:Concept ;
    skos:definition "Strong bands of tightly woven cloth, designed for bearing weight; commonly used as the first layer of support for seating furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "webbing"@en .

aat:300204914 a skos:Concept ;
    skos:definition "Small washable mats, often crocheted, used in the 19th century to protect the backs and arms of upholstered seating and reclining furniture from the stains caused by Macassar oil or other hair preparations. In the late 19th century, these were replaced by \"tidies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimacassars"@en .

aat:300204915 a skos:Concept ;
    skos:definition "Loose covers for furniture, often tailored and close fitting, but easily slipped on and off. Used to protect the finer upholstery materials beneath from soil or wear, to conceal shabby upholstery, or to enhance the decorative scheme of an interior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipcovers"@en .

aat:300204916 a skos:Concept ;
    skos:definition "Small ornamental mats used from the late 19th century onward to protect the backs and arms of upholstered seating and reclining furniture from wear or soil. For earlier similar mats, use \"antimacassars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tidies"@en .

aat:300204928 a skos:Concept ;
    skos:definition "Coverings, often textiles, laid on furniture for protection or decoration, used especially to keep heat or scratches from polished surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mats"@en .

aat:300204931 a skos:Concept ;
    skos:definition "Small mats, often crocheted, laid on furniture for protection or decoration, used especially to keep heat or scratches from polished surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doilies"@en .

aat:300204934 a skos:Concept ;
    skos:definition "Long, narrow textiles used as furniture coverings, to protect polished surfaces and as decoration. Shorter and narrower than scarves for furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runners"@en .

aat:300204936 a skos:Concept ;
    skos:definition "Long, broad textiles used as furniture coverings used either to protect surfaces or as decoration. Longer and wider than runners for furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarves"@en .

aat:300204944 a skos:Concept ;
    skos:definition "Curtains, occasionally embroidered, which cover the aumbry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aumbry veils"@en .

aat:300204946 a skos:Concept ;
    skos:definition "Textile coverings used to protect the tops of cupboards, typically embroidered, made of damask, or made of carpet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupboard cloths"@en .

aat:300204952 a skos:Concept ;
    skos:definition "Term generally applied to any textile used to cover a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed coverings"@en .

aat:300204953 a skos:Concept ;
    skos:definition "Decorative and protective textile coverings placed along the front of an upright piano."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano fronts"@en .

aat:300204962 a skos:Concept ;
    skos:definition "Heavy table covers of knotted pile, tapestry or needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table carpets"@en .

aat:300204964 a skos:Concept ;
    skos:definition "Small table mats on which individual place settings are laid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "placemats"@en .

aat:300204966 a skos:Concept ;
    skos:definition "Table pads, often of flannel or felt, used under a tablecloth on a dining table to protect the surface and deaden noise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silence cloths"@en .

aat:300204969 a skos:Concept ;
    skos:definition "Cloths for covering the top of a table, especially during a meal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablecloths"@en .

aat:300204970 a skos:Concept ;
    skos:definition "Small tablecloths for use on card tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridge cloths"@en .

aat:300204971 a skos:Concept ;
    skos:definition "Small tablecloths for use on tea tables, especially during a meal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea cloths"@en .

aat:300204973 a skos:Concept ;
    skos:definition "Sacklike removable and washable coverings for a bolster. If used on sleeping furniture, they often match pillowcases and sheets; if used on seating furniture, they often match other slipcovers. Textile coverings for long stuffed pillows or cushions used to support a sleeper's head in a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolster cases"@en .

aat:300204983 a skos:Concept ;
    skos:definition "Decorative coverings enclosing or laid over pillows when they are not in use. For sacklike coverings for pillows use \"pillowcases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillow shams"@en .

aat:300204985 a skos:Concept ;
    skos:definition "Sacklike removable and washable coverings for pillows, often matching bolster cases and sheets. For decorative coverings enclosing or laid over pillows use \"pillow shams.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillowcases"@en .

aat:300204989 a skos:Concept ;
    skos:definition "Quilts made of identical, repeating patterned units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "block quilts"@en .

aat:300204990 a skos:Concept ;
    skos:definition "Devices for measuring the air pressure in tires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tire pressure gauges"@en .

aat:300204991 a skos:Concept ;
    skos:definition "Instruments for measuring the frequencies of tones or exact pitch, as a set of graduated tuning forks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tonometers"@en .

aat:300204992 a skos:Concept ;
    skos:definition "Instruments designed to measure torque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torquemeters"@en .

aat:300204993 a skos:Concept ;
    skos:definition "Balances for measuring small gravitational, electrostatic, or magnetic forces by determining the amount of torsion on a slender twisted wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torsion balances"@en .

aat:300204995 a skos:Concept ;
    skos:definition "Small clocks or large watches mounted in folding cases and meant to be used when traveling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling clocks"@en .

aat:300205002 a skos:Concept ;
    skos:definition "Heavy, woven textiles used as wall hangings, curtains, upholstery, or to hang from windows or balconies. Tapestries are characterized by decoration that may include ornamental or pictorial subjects; they often have details that are painted or embroidered. They are usually of wool and hand-woven on a tapestry loom by a process that differs from cloth-weaving in that the weft travels only to the warp at the edge of a particular color or pattern in the design, rather traveling from edge to edge of the entire piece of fabric. Various techniques are used in mixing and overlaying colors to create shading and patterns. The term also refers to machine-woven imitations of hand-made hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestries"@en .

aat:300205009 a skos:Concept ;
    skos:definition "Artifacts, usually flexible, often textiles, used to cover or conceal interior spaces, surfaces, or furnishings, especially for protection, warmth, or embellishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coverings"@en .

aat:300205010 a skos:Concept ;
    skos:definition "Artifacts, usually flexible, often textiles, that are hung to cover or conceal interior spaces, surfaces, or furnishings, especially for protection, warmth, or embellishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangings"@en .

aat:300205011 a skos:Concept ;
    skos:definition "Parts or components of rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rug components"@en .

aat:300205015 a skos:Concept ;
    skos:definition "Refers to tapestries characterized by a design that is dominated by dense green foliage, particularly such tapestries created during the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verdures"@en .

aat:300205017 a skos:Concept ;
    skos:definition "Parts or components of sound devices, or instruments designed to make music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound device components"@en .

aat:300205019 a skos:Concept ;
    skos:definition "Sound devices that produce sound for the purpose of conveying information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound signaling devices"@en .

aat:300205021 a skos:Concept ;
    skos:definition "Descriptive and analytical study of musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organology"@en .

aat:300205024 a skos:Concept ;
    skos:definition "Groups of players of musical instruments and/or singers, ranging from two people to entire orchestras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ensembles"@en .

aat:300205034 a skos:Concept ;
    skos:definition "Decanters in the form of a jug with a long neck and a loop handle extending from the rim to the shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decanter jugs"@en .

aat:300205035 a skos:Concept ;
    skos:definition "Type of bottle that preceded the decanter and was used to bring wine to the table from the cask; made in a variety of forms and materials such as stoneware, delftware, and glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decanter bottles"@en .

aat:300205038 a skos:Concept ;
    skos:definition "Decanters with a pouring lip and handle used for wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claret jugs"@en .

aat:300205039 a skos:Concept ;
    skos:definition "Black- or green-glass bottles of quart and pint sizes, used primarily for beers, porter, cider, spring water, and other popular potables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junk bottles"@en .

aat:300205065 a skos:Concept ;
    skos:definition "Ensembles that either play related groups of instruments, such as all brass, or which serve a particular function, such as for rehearsals, dances, or parades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bands"@en .

aat:300205068 a skos:Concept ;
    skos:definition "Ensembles of Southeast Asia, consisting of various combinations of gongs, metallophones, xylophones, drums, bowed and plucked chordophones, flutes or double reed aerophones, small cymbals, and singers. They accompany dances and religious and ceremonial events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gamelan"@en .

aat:300205073 a skos:Concept ;
    skos:definition "Organized groups of instrumentalists consisting of players of bowed string instruments, to which may be added any number of wind and percussion instrument players; normally there is more than one player for each musical part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchestras"@en .

aat:300205139 a skos:Concept ;
    skos:definition "Open harps in which the neck makes a sharp angle with the resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angular harps"@en .

aat:300205162 a skos:Concept ;
    skos:definition "Wooden oboes with a straight body terminating in a bulb bell, and a conical bore considerably wider than that of the usual baritone oboes, which they resemble in tone and pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heckelphones"@en .

aat:300205163 a skos:Concept ;
    skos:definition "Low-pitched shawms developed in Europe between the 14th and 16th centuries, being long and slender with a narrow, slightly conical bore ending in a bottle-shaped or flared bell, six fingerholes in two groups of three, and, later in its development, at least one key."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombards"@en .

aat:300205166 a skos:Concept ;
    skos:definition "The most common type of cornett, made of a long section of wood, split in two and glued together after the conical tube was carved out, finished to an octagonal exterior cross-section, and covered in thin black leather. Usually the instruments curved to the right, accommodating right-handed players, but left-curving models were also made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curved cornetts"@en .

aat:300205209 a skos:Concept ;
    skos:definition "Finger-plucked banjos fitted with five strings, four of regular length plus a fifth one positioned below the lowest string, secured by a peg halfway up the neck, on which the melody is played with the thumb while the fingers play accompaniment on the others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "five-string banjos"@en .

aat:300205223 a skos:Concept ;
    skos:definition "Musical instruments designed for recording purposes by Augustus Stroh of London around 1901. The body consists of a long, narrow piece of wood or aluminum plate, the top of which serves as a fingerboard for the strings, and a flexible membrane to which a metal bell like that of an aerophone is attached, mounted at one side of the bridge; concert models occasionally have two bells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stroh violins"@en .

aat:300205243 a skos:Concept ;
    skos:definition "Upright pianos having the string length of a regular horizontal grand piano but with the strings running from below keyboard level upwards to the top of the case."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upright grand pianos"@en .

aat:300205252 a skos:Concept ;
    skos:definition "Upright grand pianos in the form of a truncated pyramid, developed in the 18th century and remaining popular until the early 19th."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramid pianos"@en .

aat:300205257 a skos:Concept ;
    skos:definition "Two-manual five-octave electronic organs made by the Hammond Organ Co., with electronic tone generation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hammond organs (TM)"@en .

aat:300205326 a skos:Concept ;
    skos:definition "Drums whose diameter is larger at the middle than at the ends and whose body is rectilinear with an angular profile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-conical drums"@en .

aat:300205348 a skos:Concept ;
    skos:definition "Tokens, often small round disks, that replace coins when games are in progress and which may be reconverted into cash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaming counters"@en .

aat:300205350 a skos:Concept ;
    skos:definition "Monophonic, nonimitative electronic instruments, invented by Maurice Martenot in 1928. The tone is generated by the heterodyne action between a fixed and a variable radio-frequency oscillator, the latter being controlled by a seven-octave keyboard and the relative proximity of the player's hand to a horizontally stretched cord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ondes Martenot"@en .

aat:300205359 a skos:Concept ;
    skos:definition "Use to describe a design or part of one, as on coins, that is rendered in intaglio rather than in relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incuse"@en .

aat:300205361 a skos:Concept ;
    skos:definition "Officials in charge of and responsible for coin production or content. For persons engaged in the physical production of coins, use \"minters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mintmasters"@en .

aat:300205362 a skos:Concept ;
    skos:definition "Persons engaged in the physical production of coins. For officials in charge of and responsible for coin production or content, use \"mintmasters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minters"@en .

aat:300205368 a skos:Concept ;
    skos:definition "Monetary tokens used in the United States, primarily in the 1930s and 1940s, to pay sales tax when coins of proper denomination were not available."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sales tax tokens"@en .

aat:300205387 a skos:Concept ;
    skos:definition "Parts or components of breastplates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breastplate components"@en .

aat:300205396 a skos:Concept ;
    skos:definition "Large clocks placed in towers, turrets, or in other prominent locations on public buildings. Usually the dials are set at a distance from the movements. Display of the time is viewable from long distances. These are usually also fixed with chimes that sound the hour, half-, or quarter-hours."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower clocks"@en .

aat:300205397 a skos:Concept ;
    skos:definition "Instruments for measuring vapor pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaporimeters"@en .

aat:300205406 a skos:Concept ;
    skos:definition "Clock and watch escapements in which the pallet axis is set at right angles to the axis of the escape wheel; probably the earliest type of escapement and now obsolete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verge escapements"@en .

aat:300205433 a skos:Concept ;
    skos:definition "Instruments for measuring the viscosity of liquids or fluids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viscometers"@en .

aat:300205435 a skos:Concept ;
    skos:definition "The cases or outer coverings for the works of watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watchcases"@en .

aat:300205438 a skos:Concept ;
    skos:definition "Watches attached to bands or straps and worn about the wrist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrist watches"@en .

aat:300205447 a skos:Concept ;
    skos:definition "Graduated sticks 1 yard long used for measuring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yardsticks"@en .

aat:300205494 a skos:Concept ;
    skos:definition "Small, short-necked lutelike chordophones of Medieval Europe, either having a rounded body with no clear division between body and neck, or flat-backed with a short but distinct neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gitterns"@en .

aat:300205500 a skos:Concept ;
    skos:definition "Musical glasses developed by Benjamin Franklin around 1761, in which glass bowls of graded size fitted concentrically on a horizontal rod are turned by a crank attached to a pedal as the player rubs the rims with slightly moistened or chalk-dusted fingers to produce sound. In a slightly later development, a shallow trough of water is fitted below the rod, which is mounted obliquely so that the bowls are moistened as they rotate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armonicas"@en .

aat:300205552 a skos:Concept ;
    skos:definition "French Renaissance shawms with a wind cap, six single fingerholes, one double fingerhole, and one rear thumbhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hautbois de Poitou"@en .

aat:300205592 a skos:Concept ;
    skos:definition "Lip-vibrated aerophones furnished with curved sliding crooks called inventions, inserted prior to play in the center of the body between the circular portions of the tube, making it possible to change pitch without changing the length of the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Inventionshorns"@en .

aat:300205681 a skos:Concept ;
    skos:definition "Long zithers with a slightly convex soundboard and flat bottom, having 13 silk or nylon strings each passing over its own movable, V-shaped bridge; it is considered the national instrument of Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koto"@en .

aat:300205706 a skos:Concept ;
    skos:definition "The protective and ornamental coverings that support and enclose a clock movement and dial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock cases"@en .

aat:300205729 a skos:Concept ;
    skos:definition "Wood friction idiophones of New Ireland, consisting of a curved block with three (rarely four or five) crosscut slits. The flat upper surface is thus divided into tongues; the player rubs the surface with rosined hands to produce tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livikas"@en .

aat:300205759 a skos:Concept ;
    skos:definition "Kettledrums whose tuning screws are operated simultaneously, by a pedal, a single master screw, or by rotation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine drums"@en .

aat:300205940 a skos:Concept ;
    skos:definition "Documents commending scholastic accomplishments and good behavior, awarded to pupils by teachers beginning in the late 18th century in the United States. The practice was most popular during the 19th century when printing techniques evolved to make them easily available; the documents are typically printed on a paper support using techniques of engraving, hand painting, or chromolithography, although some may be hand drawn. Early rewards of merit are usually religious, depicting the benefits of piety; in the early 19th century they gradually became more secular, rewarding grades, polite behavior, patriotic awareness, children's games, and other activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rewards of merit"@en .

aat:300205948 a skos:Concept ;
    skos:definition "Mandolins developed in Italy in the mid-18th century, with a pear-shaped body made of narrow ribs and very deeply vaulted at the lower end, with fretted neck, open circular or oblong sound hole, four pairs of steel strings, a flat rectangular peg disc set at an obtuse angle, rear pegs, and a low bridge glued to the belly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neapolitan mandolins"@en .

aat:300206140 a skos:Concept ;
    skos:definition "Glass, especially types invented in the 19th century, that incorporated newly developed techniques for producing colors and surface textures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art glass"@en .

aat:300206142 a skos:Concept ;
    skos:definition "Term used in the glass trade for a type of art glass first produced by the New England Glass Company in 1886, characterized by a glossy mottled surface created by first coating the object with metallic stain and then spattering it with a volatile liquid; the finish is fixed by a light firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agata glass"@en .

aat:300206149 a skos:Concept ;
    skos:definition "Decorative opaque glass made by mixing different colors in order to imitate natural semi-precious stones such as chalcedony, jasper, and onyx as well as agate. Agate glass was produced in ancient Rome and from the late 15th century onward was produced in Venice and Germany. It is similar in appearance to pâte de verre which is produced by a different process. The term also refers to a type of art glass developed by Tiffany that resembles agate stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agate glass"@en .

aat:300206163 a skos:Concept ;
    skos:definition "Term used in the glass trade for uncased art glass developed by the New England Glass Company in 1883, which varies in shading from light amber to deep ruby, the ruby areas result when part of the glass is reheated and the gold particles in the glass develop a ruby color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amberina glass"@en .

aat:300206172 a skos:Concept ;
    skos:definition "Term used in the glass trade for a type of art glass developed at the Steuben Glass Works with either a purplish, bluish, or golden metallic appearance created by spraying the glass at the fire with stannous chloride or lead chloride under controlled atmospheric conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aurene glass"@en .

aat:300206175 a skos:Concept ;
    skos:definition "Synthetic imitation of aventurine quartz crystals. Goldstone is made by embedding metallic flakes in quartz glass. It is used in costume jewelry. It is a translucent glass flecked with metallic particles to imitate the appearance of brownish aventurine quartz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aventurine glass"@en .

aat:300206177 a skos:Concept ;
    skos:definition "Term used in the glass trade for a type of art glass developed by the Mt. Washington Glass Company, shaded from pink to yellow with pink at the top caused by the presence of gold and uranium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burmese glass"@en .

aat:300206197 a skos:Concept ;
    skos:definition "Timepieces that measure equal periods of time by the motion of sand or other freely flowing, fine-grained substances through a narrow aperture between two triangular or conical glass bulbs arranged mouth to mouth; probably introduced in the early 14th century and used then especially for timekeeping aboard ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandglasses"@en .

aat:300206211 a skos:Concept ;
    skos:definition "A script of ancient Egypt consisting of abridged forms of hieroglyphics, used by the priests in their records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hieratic"@en .

aat:300206213 a skos:Concept ;
    skos:definition "A script of ancient Egypt, derived from hieratic and used from about 700 BCE to 500 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demotic"@en .

aat:300206217 a skos:Concept ;
    skos:definition "Words placed at the bottom of a page repeating the first word on the following page; used especially at the very end of a gathering to guide the binder in assembling the gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catchwords"@en .

aat:300206223 a skos:Concept ;
    skos:definition "Letters or numbers, or combinations of letters and numbers, printed at the foot of the first page, and sometimes on subsequent leaves of a gathering, as a guide to the binder in arranging them in their correct order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signatures"@en .

aat:300206230 a skos:Concept ;
    skos:definition "Matter prepared or to be prepared for printing, often referring to both text and images, sometimes to the text as distinguished from the images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copy"@en .

aat:300206232 a skos:Concept ;
    skos:definition "Books set in type larger than normal, generally over 16-point, usually for the benefit of readers with visual impairments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "large print books"@en .

aat:300206237 a skos:Concept ;
    skos:definition "Instruments for measuring the amount of dust in the air, as in mills or mines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "konimeters"@en .

aat:300206321 a skos:Concept ;
    skos:definition "Long straight trumpetlike aerophones of slightly conical bore, made of brass or silver with several joints, their junctions concealed by ornamental bosses, and a flared bell. They were used as heralds' trumpets in Medieval Europe and often bore the standard of a noble person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buisines"@en .

aat:300206339 a skos:Concept ;
    skos:definition "Devices for determining true horizontal or vertical angles by the centering of a bubble with a glass tube or circular case filled nearly to capacity with alcohol or ether."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit levels"@en .

aat:300206355 a skos:Concept ;
    skos:definition "Glassware with facets, grooves, and depressions produced by cutting with a rotating wheel of metal or stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut glass"@en .

aat:300206358 a skos:Concept ;
    skos:definition "Glass with very deep, complex, and polished cutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brilliant-cut glass"@en .

aat:300206359 a skos:Concept ;
    skos:definition "Trademark name for a type of glass developed by Tiffany and Company with an iridescent surface simulating that of excavated ancient Roman glass; this effect was produced by spraying the surface of the glass while hot with metallic salts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Favrile glass (TM)"@en .

aat:300206370 a skos:Concept ;
    skos:definition "A type of glass characterized by its mainly greenish, turquoise, yellow, brown-green, or smoky black color accented by air bubbles, streaks of pink and white, and speckles of aventurine. To produce Clutha glassware, a worker used a gather of pale ruby or pale yellow glass, then rolled it over a marver lightly sprinkled with bits of colored glass and mica flakes. The gather was reheated and blown and tooled into the finished product. It was originally made by James Couper & Sons, Glasgow. It is called \"Clutha\" from Gaelic for \"cloudy.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clutha glass"@en .

aat:300206372 a skos:Concept ;
    skos:definition "Glass with a ruby color due to the presence of various materials, including colloidal gold, cadmium selenide, or copper and zinc sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruby glass"@en .

aat:300206374 a skos:Concept ;
    skos:definition "Glass with a red color due to the presence of copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper ruby glass"@en .

aat:300206380 a skos:Concept ;
    skos:definition "Refers to a type of decorative glass that was invented in Venice during the 16th century. It is characterized by a surface that appears frosted or resembles cracked ice. It is produced either by plunging a gather of blown glass into a tub of water and then quickly reheating it, or by rolling the hot glass on a metal or clay surface covered with glass fragments that adhere to the gather, and then blowing the form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crackle glass"@en .

aat:300206392 a skos:Concept ;
    skos:definition "General term for Venetian glass often yellow or smoky gray in color unless formulated with the decolorizing agent manganese, which gives the glass the appearance of rock crystal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cristallo"@en .

aat:300206397 a skos:Concept ;
    skos:definition "Term used in the glass trade for an opal glass which has been acid finished and had various ornate designs embedded in the glass in shades of brown and beige. A type of art glass, developed by the Mt. Washington Glass Company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crown Milano"@en .

aat:300206418 a skos:Concept ;
    skos:definition "Scrap glass intended for reuse or recycling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cullet"@en .

aat:300206419 a skos:Concept ;
    skos:definition "Glass which appears to be a different color when viewed in transmitted or reflected light; often achieved by the addition of colloidal gold to the glass batch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dichromatic glass"@en .

aat:300206540 a skos:Concept ;
    skos:definition "Scales in which the balance pan for loads is a platform mounted on a balanced beam or series of levers; usually used for heavy goods, often in bulk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform scales"@en .

aat:300206541 a skos:Concept ;
    skos:definition "Synthetic arsenic trisulfide, made since the 18th century and valued because it is purer and less expensive than its natural counterpart, opriment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "king's yellow"@en .

aat:300206545 a skos:Concept ;
    skos:definition "Sets of armor, consisting of a field armor plus reinforcing and alternative pieces which could either be integrated with or substituted for the regular pieces in the basic set, thus converting it into various forms for use in warfare or tournaments. They were invariably made for important persons according to a precise design for specific types of events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garnitures"@en .

aat:300206569 a skos:Concept ;
    skos:definition "Coins generated through a minting error which produced the same design on the obverse and reverse, one in relief and the other incuse; the coins are created when a preceding coin remained in the die and consequently left its impression on the next coin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brokages"@en .

aat:300206570 a skos:Concept ;
    skos:definition "Any of various coins valued at one-hundredth part of the monetary unit of several Spanish-American and Portuguese-speaking territories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centavos"@en .

aat:300206571 a skos:Concept ;
    skos:definition "Any of various, usually copper or aluminum, coins issued since the late 18th century by several French-speaking countries and valued at one-hundredth part of their monetary unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centimes"@en .

aat:300206572 a skos:Concept ;
    skos:definition "Animal material, such as shell and bone, that is made out of both inorganic and organic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination inorganic/organic animal material"@en .

aat:300206575 a skos:Concept ;
    skos:definition "Any of a large class of natural polymers composed of chains of amino acids connected by peptide linkages. Proteins occur in the cells of all living organisms and in biological fluids. Their primary structure is determined by the order of their amino acids. Examples of soluble proteins include enzymes and antibodies. Insoluble proteins include keratin and collagen. Examples of protein containing compounds are leather, gelatin, albumen, animal glue, silk, ivory, egg, and casein."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protein"@en .

aat:300206576 a skos:Concept ;
    skos:definition "Refers to the lower of two dies between which coins are struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anvil dies"@en .

aat:300206577 a skos:Concept ;
    skos:definition "Earliest type of Roman money, essentially rough, unmade, or unfinished lumps of bronze of irregular weights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aes rude"@en .

aat:300206578 a skos:Concept ;
    skos:definition "Ancient Roman cast bronze coins, usually in the form of ingots, and in circulation before 300 BCE, preceding the aes grave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aes signatum"@en .

aat:300206579 a skos:Concept ;
    skos:definition "Material that is comprised of both organic and inorganic elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination inorganic/organic material"@en .

aat:300206581 a skos:Concept ;
    skos:definition "Refers to the entire process of producing coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minting"@en .

aat:300206582 a skos:Concept ;
    skos:definition "The first national paper money of the United States, authorized for issue in 1775."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Continental currency"@en .

aat:300206583 a skos:Concept ;
    skos:definition "Coins that are incorrectly struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misstruck coins"@en .

aat:300206584 a skos:Concept ;
    skos:definition "Coins that have two or more impressions of the same design on either the obverse or reverse, generally caused by movement of the coins in the die between successive hammer blows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-struck coins"@en .

aat:300206600 a skos:Concept ;
    skos:definition "Small, usually thick coins that may have been created by removing circular pieces from other, larger coins, as in the case of holey dollars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumps"@en .

aat:300206601 a skos:Concept ;
    skos:definition "Spanish gold coins issued beginning in the early 16th century; later, these and similar Portuguese coins; and, more recently, various coins of Spanish- and Portuguese- speaking countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escudos"@en .

aat:300206616 a skos:Concept ;
    skos:definition "Genoese gold coins struck from 1252 until the early 15th century; for similar coins issued in Florence at the same time, use \"florins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genovinos"@en .

aat:300206625 a skos:Concept ;
    skos:definition "Venetian large, silver coins issued from 1202 until the mid-15th century and valued as multiples of denari; later imitated throughout Europe as, for example, groats, gros tournoi, and groschen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grossi"@en .

aat:300206638 a skos:Concept ;
    skos:definition "Mouth-blown bagpipes of India, having one drone pipe and one chanter with beating reed, and a goatskin bag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mashaks"@en .

aat:300206687 a skos:Concept ;
    skos:definition "Emergency paper money issued during the first half of the 20th century, especially that issued by Germany and Austria during and shortly after the First World War."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notgelden"@en .

aat:300206688 a skos:Concept ;
    skos:definition "Coins manufactured with previously issued coins used as planchets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overstrikes"@en .

aat:300206690 a skos:Concept ;
    skos:definition "Coins the design, metal, or denomination of which has not yet been approved for issue and have been produced primarily for inspection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern coins"@en .

aat:300206692 a skos:Concept ;
    skos:definition "Roman copper or bronze coins valued at one fourth of an as and issued from the early Republic through at least the 2nd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrantes"@en .

aat:300206693 a skos:Concept ;
    skos:definition "Use both for German silver coins issued from the 15th through the mid-19th century and for certain Austrian coins of the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schillings"@en .

aat:300206694 a skos:Concept ;
    skos:definition "Roman bronze coins valued at one-half as and issued first as cast and then as struck coins from the Republic through the 2nd century CE, and then for gold coins valued at one-half solidus issued in the Eastern Empire from the 4th through the 8th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semisses"@en .

aat:300206695 a skos:Concept ;
    skos:definition "Several varieties of ancient Chinese cast bronze coins shaped roughly like spades and issued possibly as early as the 9th century BCE until the 3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spade money"@en .

aat:300206696 a skos:Concept ;
    skos:definition "Vessels intended to hold or dispense coffee, either urnlike or in the form of a coffeepot and having, instead of a spout, one or more taps and a spigot; usually supported on legs or a stand and may have a heating device. May be part of a coffee service. Prefer \"hot water urns\" for urnlike vessels intended to hold or dispense hot water in connection with the serving of coffee and which may also be part of a coffee service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee urns"@en .

aat:300206697 a skos:Concept ;
    skos:definition "Large casks of varying capacity, especially those used for wine, beer, or water, and formerly for salmon and shrimps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butts"@en .

aat:300206700 a skos:Concept ;
    skos:definition "Large casks for holding liquids, especially wine, ale, or beer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuns"@en .

aat:300206701 a skos:Concept ;
    skos:definition "Hollow, often decorative forms, where mixtures are placed and left to sit, in order for them to retain the shapes of the decorative forms. Hollow forms or matrices, often in decorative shapes into which food mixture is left to set to assume the shape of the mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary molds"@en .

aat:300206702 a skos:Concept ;
    skos:definition "Molds, often metal or earthenware, for baking cakes in distinctive shapes, such as in the form of animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake molds"@en .

aat:300206711 a skos:Concept ;
    skos:definition "Small dishes in which food can be baked and served."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramekins"@en .

aat:300206720 a skos:Concept ;
    skos:definition "Small metal drinking vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pannikins"@en .

aat:300206738 a skos:Concept ;
    skos:definition "Characteristics and qualities of musical ranges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical range attributes"@en .

aat:300206739 a skos:Concept ;
    skos:definition "Describes musical instruments, especially winds, that are the second highest in pitch among the members of their family. Alto instruments typically have a range about a 5th below that of the highest members of the family. With regard to human voices, describes a singer whose voice is pitched higher than a tenor but lower than a soprano."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alto"@en .

aat:300206740 a skos:Concept ;
    skos:definition "Term, chiefly of British usage, used to refer to children's voices and to certain older European musical instruments, such as viols and recorders, of the soprano range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treble"@en .

aat:300206741 a skos:Concept ;
    skos:definition "Describes musical instruments pitched highest, or, if there are piccolo versions, second highest in their families. With regard to human voices, describes the highest-pitched voice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soprano"@en .

aat:300206743 a skos:Concept ;
    skos:definition "Describes human voices and musical instruments pitched lower than baritone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bass"@en .

aat:300206745 a skos:Concept ;
    skos:definition "Describes human voices and occasionally musical instruments pitched lower than tenor, but higher than bass. For some instruments, such as the oboe, it refers to the deepest voice of the instrument family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baritone"@en .

aat:300206746 a skos:Concept ;
    skos:definition "Describes human voices and musical instruments pitched below alto but above baritone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenor"@en .

aat:300206747 a skos:Concept ;
    skos:definition "Of musical instruments, being the smallest and highest in pitch of their families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piccolo"@en .

aat:300206748 a skos:Concept ;
    skos:definition "Describes musical instruments pitched lower than bass. It does not exist for all families of instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contrabass"@en .

aat:300206749 a skos:Concept ;
    skos:definition "Hungarian reedpipes with a wood body and conical bore. Older types, traceable back to the 13th century, were played with a double reed and pirouette; the present day model is played with a single reed and clarinet-type mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tárogatós"@en .

aat:300206783 a skos:Concept ;
    skos:definition "Glass flasks with raised designs on one or both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figured flasks"@en .

aat:300206784 a skos:Concept ;
    skos:definition "Figured flasks depicting a variety of historical subjects such as portraits of presidents or other famous individuals, emblems, or slogans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical flasks"@en .

aat:300206785 a skos:Concept ;
    skos:definition "Figured flasks bearing purely decorative designs such as scrolls, cornucopia and sunbursts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial flasks"@en .

aat:300206819 a skos:Concept ;
    skos:definition "Four-sided bottles made to fit with others in compartments in a bottle case or box."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case bottles"@en .

aat:300206820 a skos:Concept ;
    skos:definition "Free-blown bottles so named for their form which ranges from an often flattened globular shape to a completely round globelike vessel; a type known in both German and American glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chestnut bottles"@en .

aat:300206821 a skos:Concept ;
    skos:definition "Bottles in which ink is sold. For small vessels usually sold empty and intended for holding ink into which a pen can be dipped, use \"inkwells.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink bottles"@en .

aat:300206825 a skos:Concept ;
    skos:definition "Struck drums that have a bowl shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowl-shaped drums"@en .

aat:300206829 a skos:Concept ;
    skos:definition "Asymmetrical pairs of small, tuned, handplayed drums of north and central India, Pakistan, and Bangladesh, consisting of a treble drum, its body a tapering wood cylinder, and a bass drum with a round, bowl-like body of clay or chromed copper. They constitute one of the most important instruments of modern classical Indian music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabla"@en .

aat:300206846 a skos:Concept ;
    skos:definition "Refers to the act of hitting of a blank in order to make an impression, as in making coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking"@en .

aat:300206852 a skos:Concept ;
    skos:definition "Bottles intended for poison, varying in shape, but often with a rough texture or other external features so as to be recognized by touch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poison bottles"@en .

aat:300206858 a skos:Concept ;
    skos:definition "The upper of two dies between which a coin is struck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trussells"@en .

aat:300206860 a skos:Concept ;
    skos:definition "Use both for Sicilian bronze coins valued at one twelfth litra and issued during the 5th century BCE and for later Roman, bronze struck coins equal to one twelfth as and issued during the Republic until the 2nd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unciae"@en .

aat:300206861 a skos:Concept ;
    skos:definition "Small bottles used for holding bitters and having a metal dropper. Also, bottles of varying form used for holding patent medicine or other medical products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitters bottles"@en .

aat:300206871 a skos:Concept ;
    skos:definition "Roman silver coins of uncertain value issued between roughly 211 and 170 BCE and characterized by a depiction on the reverse of Victory placing a wreath on a trophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "victoriati"@en .

aat:300206890 a skos:Concept ;
    skos:definition "Steel stamps with a positive impression of designs to be reproduced in reverse on dies to make coins or medals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hubs"@en .

aat:300206894 a skos:Concept ;
    skos:definition "Silver or copper coins, primarily of ancient India, struck with a variety of punches containing symbols rather than struck by regular obverse and reverse dies; in use at least between 500 BCE and CE 500."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch-marked coins"@en .

aat:300207024 a skos:Concept ;
    skos:definition "Light half armor worn by heavy infantry from the early 16th to the mid-17th century in Europe, at first comprised of a gorget, spaudlers, breastplate, backplate, tassets, vambraces, gauntlets, and an open helmet, but no legharness. In the 17th century, arm defenses were usually omitted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corslets"@en .

aat:300207041 a skos:Concept ;
    skos:definition "Spanish and Spanish-American dollar-sized silver coins valued at eight reales and produced approximately between 1500 and 1900; used predominantly as trade coins; generally for a number of coins minted by Spanish-speaking countries, use \"pesos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pieces of Eight"@en .

aat:300207247 a skos:Concept ;
    skos:definition "An Egyptian and Roman glass with a blood red color created by the dispersion of cuprous oxide crystals in black glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haematinum"@en .

aat:300207254 a skos:Concept ;
    skos:definition "Measuring device accessories used in surveying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveying accessories"@en .

aat:300207256 a skos:Concept ;
    skos:definition "Conspicuously painted poles, usually with alternating red and white bands, roughly 7 to 8 feet high with metal points at one end used by surveyors to mark points of reference. For similar devices marked with numbers, use \"leveling rods.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "range poles"@en .

aat:300207309 a skos:Concept ;
    skos:definition "Laminated armor pieces shaped like long, flared funnels, covering the body from waist to knees, a characteristic element of some types of foot-combat armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tonlets"@en .

aat:300207325 a skos:Concept ;
    skos:definition "Term used in the glass trade for a type of art glass that is amber or sometimes colorless glass molded with holly sprigs, developed by the Indian Tumbler and Bottle Company, in 1906."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holly amber glass"@en .

aat:300207332 a skos:Concept ;
    skos:definition "Ornaments or badges for wearing, as on a lapel, stamped or printed with designs or slogans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttons"@en .

aat:300207336 a skos:Concept ;
    skos:definition "Glass decorated with haphazard streaking of two or more colors to resemble marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbled glass"@en .

aat:300207341 a skos:Concept ;
    skos:definition "Term used in the glass trade for a glass made to resemble onyx either by the addition of metal and metallic oxide that impart a silver luster upon heating, or by mixing glass of contrasting colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onyx glass"@en .

aat:300207345 a skos:Concept ;
    skos:definition "Trade name for an art glass made to imitate the appearance of the peach-bloom glaze on Chinese porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peach blow glass"@en .

aat:300207352 a skos:Concept ;
    skos:definition "Glass made with slices of colored canes embedded in clear molten glass, usually creating flowerlike designs. Distinguish from \"mosaic glass\" which uses slices of colored canes as inlays for walls and furniture, beads, jewelry, and to form vessels when arranged in molds and fused together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millefiori glass"@en .

aat:300207360 a skos:Concept ;
    skos:definition "Images or texts designed to occupy two facing pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double spreads"@en .

aat:300207375 a skos:Concept ;
    skos:definition "Distinctive pressed glass of various colors produced by the Boston Sandwich Glass Company. For double-wall glass objects with inner decoration of engraved gold leaf, use \"gold glass (visual works),\" having the UF \"sandwich gold glass (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich glass"@en .

aat:300207378 a skos:Concept ;
    skos:definition "Glassware decorated with a matte finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satin glass"@en .

aat:300207379 a skos:Concept ;
    skos:definition "Adhesive-backed slips of paper or similar thin material, usually bearing messages or designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stickers"@en .

aat:300207383 a skos:Concept ;
    skos:definition "Term used in the glass trade for a type of art glass molded in ornate patterns, made in various shades of pink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pink-slag glass"@en .

aat:300207384 a skos:Concept ;
    skos:definition "Stickers intended to be placed on the bumpers of motor vehicles, usually bearing messages such as slogans, witticisms, or advertisements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bumper stickers"@en .

aat:300207391 a skos:Concept ;
    skos:definition "Cards that mark a place reserved for occupancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place cards"@en .

aat:300207397 a skos:Concept ;
    skos:definition "Term used in the glass trade for a type of art glass made by the New England Glass Company in 1885, consisting of clear glass enlarged by repeated mold blowing and decorated with a network of acid etched lines, or having a mottled surface created by rolling the vessel in an acid resistant substance and then acid bathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pomona glass"@en .

aat:300207402 a skos:Concept ;
    skos:definition "Large casks of varying capacity used especially for wine and oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipes"@en .

aat:300207414 a skos:Concept ;
    skos:definition "Small metal or earthenware straight-handled pots or pans used chiefly in cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipkins"@en .

aat:300207454 a skos:Concept ;
    skos:definition "Any of several types of devices, such as horns, rattles, or clappers, used to make noise. Examples of usage is at celebrations or other public occasions such as sports events or political rallies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noisemakers"@en .

aat:300207457 a skos:Concept ;
    skos:definition "Electric devices that, when activated, produce short, relatively high-pitched tones, at regular intervals over a period of time, as in portable pagers or animal tracking collars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beepers"@en .

aat:300207458 a skos:Concept ;
    skos:definition "Electric signaling devices that produce a buzzing sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buzzers"@en .

aat:300207459 a skos:Concept ;
    skos:definition "Devices for producing sounds, consisting essentially of a disk pierced with holes arranged in a circle, rotated over a stream of compressed air, steam, or fluid, so that the stream is alternately interrupted and allowed to pass; their uses include giving signals or warnings and producing musical tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sirens"@en .

aat:300207568 a skos:Concept ;
    skos:definition "Idiophones consisting of a lamella carved in the surface of a nut, fruit shell, or other globular object which serves as a resonator; the lamella is plucked by the player's thumb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clack idiophones"@en .

aat:300207592 a skos:Concept ;
    skos:definition "Leverlike mechanical devices attached to or forming an integral part of a musical instrument or other sound device, functioning either as part of the direct sound-producing mechanism, as when admitting air to a pipe or causing a string to be struck or plucked, or, when on a confined aerophone, as devices governing those tone-holes that are out of reach or too large for the unaided finger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keys"@en .

aat:300207610 a skos:Concept ;
    skos:definition "Large forks intended primarily for serving food from platters, bowls, or the like; sometimes made en suite with a serving spoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving forks"@en .

aat:300207612 a skos:Concept ;
    skos:definition "General term for items used in conjunction with accessory tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessory table equipment"@en .

aat:300207613 a skos:Concept ;
    skos:definition "Forks that are used as part of a place setting; all forks used for consuming at table and not for serving food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place forks"@en .

aat:300207614 a skos:Concept ;
    skos:definition "Knives that are used for cutting and spreading by a person while eating, rather than for serving at table; all knives used as part of a place setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place knives"@en .

aat:300207615 a skos:Concept ;
    skos:definition "All spoons used for eating and not for serving food at table; all spoons used as part of place settings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place spoons"@en .

aat:300207616 a skos:Concept ;
    skos:definition "Small printed sheets, and later cards, bearing tradesmen's advertisements, often including an engraved illustration; produced from the 17th through the 19th century. For cards made later, bearing the name and address of a business concern and the name of its representative, and intended more for information than for advertising, use \"business cards.\" For cards made later and distributed for advertisement, use \"advertising cards,\" and for those made later and issued primarily to be collected, with or without advertisements on them, use \"collecting cards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade cards"@en .

aat:300207627 a skos:Concept ;
    skos:definition "Portions of manuscripts loaned out for copying, used especially in the large universities in the 13th and 14th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peciae"@en .

aat:300207631 a skos:Concept ;
    skos:definition "Series of rounded notches cut into the fore edges of books and marked to direct the reader to sections of the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumb indexes"@en .

aat:300207633 a skos:Concept ;
    skos:definition "Tongs intended primarily for serving individual portions of asparagus; having either narrow or broad blades and made either as U-shaped sprung tongs or as scissorlike devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asparagus tongs"@en .

aat:300207638 a skos:Concept ;
    skos:definition "Term applied to a wide variety of special-purpose utensils designed to serve cake and similar foods, especially those with a flat wedge-shaped surface. May be accompanied by a cake knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake servers"@en .

aat:300207640 a skos:Concept ;
    skos:definition "Term applied to a wide variety of special-purpose utensils designed to serve cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese servers"@en .

aat:300207643 a skos:Concept ;
    skos:definition "Books of other than a conventional rectangular shape, such as circular, triangular, or irregularly polygonal books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaped books"@en .

aat:300207644 a skos:Concept ;
    skos:definition "Spoons having a hinged stem allowing them to be folded for storage or travel. Of a type made from the 15th century. Later often made in sets with knives and forks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding spoons"@en .

aat:300207645 a skos:Concept ;
    skos:definition "Small ladles intended primarily for serving gravy; generally larger than cream or sauce ladles and sometimes made as part of a flatware service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravy ladles"@en .

aat:300207651 a skos:Concept ;
    skos:definition "Term applied to a wide variety of special-purpose utensils designed to serve lemon slices, especially those which have an ornately pierced surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon servers"@en .

aat:300207652 a skos:Concept ;
    skos:definition "Utensils often with a flat triangular blade used for cutting and serving pies and pastries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pie servers"@en .

aat:300207656 a skos:Concept ;
    skos:definition "Small ladles intended primarily for serving sauces; generally smaller than gravy ladles and sometimes made as part of a flatware service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sauce ladles"@en .

aat:300207660 a skos:Concept ;
    skos:definition "Term used for serving utensils which are not knives, forks, spoons, tongs, or scoops. They generally have relatively large flat surfaces of varying shape and are used to serve solid food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servers"@en .

aat:300207661 a skos:Concept ;
    skos:definition "Highly detailed or finished layouts, especially for one-page pieces; for more extensive detailed layouts, including representation of the arrangement of pages, use \"dummies (printed matter).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comprehensives"@en .

aat:300207669 a skos:Concept ;
    skos:definition "Term applied to a wide variety of special-purpose utensils designed to serve tomatoes, especially those which have a flat and round surface which may or may not be pierced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomato servers"@en .

aat:300207672 a skos:Concept ;
    skos:definition "Spoons with a long, hollow handle used to stir and sip lemonade and similar drinks served in tall glasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemonade spoons"@en .

aat:300207674 a skos:Concept ;
    skos:definition "Long-handled spoons with a rounded bowl of a type patented in the late 19th century, designed for stirring sodas and ice cream floats that are served in tall glasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soda spoons"@en .

aat:300207675 a skos:Concept ;
    skos:definition "Rods with a flanged or shaped end inserted into chocolate pots through an aperture in the lid or cover and twirled so as to stir and froth the beverage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molinets"@en .

aat:300207676 a skos:Concept ;
    skos:definition "Utensils usually shaped like pestles for crushing and stirring, especially used for making mixed drinks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muddlers"@en .

aat:300207678 a skos:Concept ;
    skos:definition "Tools for cutting up either raw or cooked poultry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poultry shears"@en .

aat:300207679 a skos:Concept ;
    skos:definition "Scissorlike tools with one tip for digging out the eyes on a pineapple and the other tip for snipping them off."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pineapple snips"@en .

aat:300207683 a skos:Concept ;
    skos:definition "Tools for extracting juice from fruits and vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juicers"@en .

aat:300207687 a skos:Concept ;
    skos:definition "Juicers with a rigid and pointed cone upon which a fruit half is pressed to extract juice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juice reamers"@en .

aat:300207688 a skos:Concept ;
    skos:definition "Tools used to extract juice from fruit, usually citrus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon squeezers"@en .

aat:300207689 a skos:Concept ;
    skos:definition "Kitchen utensils used for crushing food by pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mashers"@en .

aat:300207691 a skos:Concept ;
    skos:definition "Any of several kitchen utensils used for crushing cooked potatoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potato mashers"@en .

aat:300207692 a skos:Concept ;
    skos:definition "Small spoons, similar in size to coffee spoons, having a rounded bowl; introduced in the late 19th century as an individual place piece. Sometimes made in sets and accompanied by a muddler (stirrer)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocolate spoons"@en .

aat:300207693 a skos:Concept ;
    skos:definition "Round-bowled spoons similar to but larger than bouillon spoons; intended to be used to consume cream soups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream soup spoons"@en .

aat:300207694 a skos:Concept ;
    skos:definition "Small long-handled forks usually with two short tines used to serve olives. For similar forks with three or four tines use \"pickle forks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive forks"@en .

aat:300207695 a skos:Concept ;
    skos:definition "Tools for peeling citrus fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange peelers"@en .

aat:300207696 a skos:Concept ;
    skos:definition "Utensils combining the functions of a fork and spoon having one end with tines and the other with a small shallow bowl. Of a type known in the 16th through 18th centuries and used for eating preserved fruits and sweetmeats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sucket forks"@en .

aat:300207697 a skos:Concept ;
    skos:definition "Books, usually for children, having mechanisms that move, or are moved by the reader."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movable books"@en .

aat:300207704 a skos:Concept ;
    skos:definition "Boards bearing signs, especially common as tavern and shop signs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signboards"@en .

aat:300207720 a skos:Concept ;
    skos:definition "Early spinning machines having more than one spindle, enabling a person to spin a number of yarns simultaneously. The characteristic feature of these devices is the fact the the spindles are fixed upon a stationary frame, rather than being placed on a moving portion of the machine. For an earlier type of spinning machine, involving a hand- or foot-pedaled wheel and a single spindle, use \"spinning wheels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning jennies"@en .

aat:300207734 a skos:Concept ;
    skos:definition "Type of spinning machine driven by water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water-frames"@en .

aat:300207740 a skos:Concept ;
    skos:definition "Pierced bowl-like strainers or specially designed pails used to strain milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk strainers"@en .

aat:300207741 a skos:Concept ;
    skos:definition "Wood of the species Samanea saman, of the legume family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monkeypod"@en .

aat:300207749 a skos:Concept ;
    skos:definition "Scales having a fixed fulcrum and a movable counterweight whose distance along a horizontal graduated beam is moved to balance an object suspended from a point, usually on a pan or hook, set off-center; for scales of similar form but with a fixed counterweight and movable fulcrum, use \"desemers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steelyards"@en .

aat:300207753 a skos:Concept ;
    skos:definition "Figures and ornaments made in plaster of Paris to imitate Staffordshire pottery and other works. The works were not fired but painted or left in their natural white color. The works were popular in the United States in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalkware"@en .

aat:300207761 a skos:Concept ;
    skos:definition "Receiving rights of tenancy or custody and use of an object or land from its owner in return for payment. The terms of such arrangements are generally set forth in a lease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "renting"@en .

aat:300207778 a skos:Concept ;
    skos:definition "Receptacles used in religious contexts that are considered in essence the dwelling-place of the deity, intended literally or symbolically. In Christian contexts, tabernacles often have an architectural character and are located near the high altar of a church, set into the wall or free-standing; their purpose is to hold the consecrated Host. The term is derived from Latin, meaning a small dwelling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabernacles"@en .

aat:300207793 a skos:Concept ;
    skos:definition "Small, usually wire kitchen implements used for hand beating of foods such as eggs, creams, or potatoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whisks"@en .

aat:300207795 a skos:Concept ;
    skos:definition "Small flat brushes used to coat pastry with butter, eggs, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry brushes"@en .

aat:300207796 a skos:Concept ;
    skos:definition "Flat pieces of stone, ceramic materials, or iron used for baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bakestones"@en .

aat:300207798 a skos:Concept ;
    skos:definition "Small mechanical devices for grinding coffee beans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee mills"@en .

aat:300207807 a skos:Concept ;
    skos:definition "Bowl-shaped strainers having one handle and a wire-mesh or perforated bottom; intended primarily for straining gravy or clarifying soup stock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravy strainers"@en .

aat:300207870 a skos:Concept ;
    skos:definition "Instruments or containers that measure, for example, extent, quantity, capacity, mass, or position in terms of a standard unit or fixed amount."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring devices"@en .

aat:300207871 a skos:Concept ;
    skos:definition "Regional style of temple architecture of 11th/13th-century Kalinga, which was a territorial subdivision of east-central India, corresponding to present-day northern Andhra Pradesh, most of Orissa, and a portion of Madhya Pradesh states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalinga"@en .

aat:300207872 a skos:Concept ;
    skos:definition "Physical formats, objects, or digital information that are used for correspondence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "correspondence artifacts"@en .

aat:300207873 a skos:Concept ;
    skos:definition "Paper for writing letters, often having a letterhead or decorative design, and often accompanied by matching envelopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stationery"@en .

aat:300207875 a skos:Concept ;
    skos:definition "Images made on paper specially treated so the image can be transferred to another surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decals"@en .

aat:300207878 a skos:Concept ;
    skos:definition "Those who follow the art or practice of foreseeing future events or obtaining secret knowledge through divine sources, omens, or oracles; it is based on the belief that revelations are offered to humans in extrarational forms of knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diviners"@en .

aat:300207879 a skos:Concept ;
    skos:definition "Art or practice of obtaining secret knowledge or foretelling future events by employing supernatural or magical sources, omens, or oracles; it is based on the belief that revelations are offered to humans in extrarational forms of knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divination"@en .

aat:300207888 a skos:Concept ;
    skos:definition "Firm, lightweight, fine-textured wood obtained from the species Tabebuia donnell-smithii native to Mexico and Central America. Although the tree is unrelated to true mahogany, the wood resembles it in being easy to work, lustrous, and free of tendency to warp. When first cut, it is pale yellow in color; upon exposure to air and light it darkens to a yellowish rose with streaks of red, orange, and brown. Primavera is used, either in thin lumber or veneer form, for paneling, furniture, veneers, inlaying, and cabinetmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primavera"@en .

aat:300207894 a skos:Concept ;
    skos:definition "Those who win things, such as contests, awards, honors, or games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winners"@en .

aat:300208276 a skos:Concept ;
    skos:definition "Tools used for blending food, especially culinary appliances consisting of a container with a fixed propellerlike blade at the bottom which rotates at different speeds to chop, mix, purée, or whip foods. For culinary utensils or appliances having one or more beaters used for mixing, use \"mixers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blenders"@en .

aat:300208278 a skos:Concept ;
    skos:definition "Culinary utensils or appliances having one or more beaters and used in mixing, beating, or creaming food. For tools used for blending food consisting of a container with a fixed propellerlike blade, use \"food processors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixers"@en .

aat:300208279 a skos:Concept ;
    skos:definition "Arrangements of type in which several lines are set in narrower measure than others in a column to accommodate, for example, an illustration or initial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runarounds"@en .

aat:300208281 a skos:Concept ;
    skos:definition "Culinary appliances with interchangeable blades or other rotating tools within a closed container into which food is inserted for mixing, slicing, shredding, mincing or otherwise processing at various speeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food processors"@en .

aat:300208335 a skos:Concept ;
    skos:definition "Historically, a collection of type consisting of all letters, numerals, punctuation marks, and other symbols belonging to a single design and point size, and not including other sets of characters such as the bold type of the same design family. In photocomposition and desktop publishing, a font is the set of characters and other symbols of one style available as a unit, such as through a strip of film or a program module."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fonts"@en .

aat:300208470 a skos:Concept ;
    skos:definition "Two connected posters or signboards that hang in front of and behind a person and usually bear a message such as an advertisement, notice, or exhortation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich boards"@en .

aat:300208587 a skos:Concept ;
    skos:definition "Cards containing advertisements displayed in store windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window cards"@en .

aat:300208593 a skos:Concept ;
    skos:definition "Cards displayed in movie theater lobbies to advertise motion pictures; usually 11 by 14 inches and issued in sets of eight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lobby cards"@en .

aat:300208615 a skos:Concept ;
    skos:definition "Scripts used for writing several languages of Asia and Africa, including Arabic, Persian, and Urdu. The Arabic script is written from right to left, in a cursive style, and includes 28 basic letters. Because all letters usually stand for consonants, it is classified as an abjad. After the Latin alphabet, it is the most widely used alphabet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabic scripts"@en .

aat:300208622 a skos:Concept ;
    skos:definition "Sheets of lightweight paper, bearing an official postal stamp imprint, that are folded to form their own envelopes and can be sent via airmail at a special, low rate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerogrammes"@en .

aat:300208775 a skos:Concept ;
    skos:definition "Refers to the leaf of a book's endleaves that is pasted to the cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastedowns"@en .

aat:300208803 a skos:Concept ;
    skos:definition "Self-propelled projectiles carrying a warhead containing biological or chemical agents, explosive or incendiary materials, or inert materials intended to inflict damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missiles"@en .

aat:300208990 a skos:Concept ;
    skos:definition "Parts or components of culinary tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary tool components"@en .

aat:300209168 a skos:Concept ;
    skos:definition "Fissures or systems of fissures without complete separation into pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cracks"@en .

aat:300209172 a skos:Concept ;
    skos:definition "The quality of being easily crumbled or reduced to a powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friability"@en .

aat:300209199 a skos:Concept ;
    skos:definition "Harps in which generally the strings are all tuned to the notes of a single key; often an extra string is inserted in each octave for a flat seventh or, less often, a sharp fourth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diatonic harps"@en .

aat:300209202 a skos:Concept ;
    skos:definition "Large four-stringed instruments of the violin class; a bass violin tuned an octave below violas. They are structurally similar to violins but differ in having relatively deeper ribs and a shorter neck. They are often referred to simply as 'cellos'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violoncellos"@en .

aat:300209214 a skos:Concept ;
    skos:definition "Use generally for any of several types of levers, operated by the foot and used on sound devices for a variety of purposes such as to change tuning, operate a bellows, strike a drum head, produce expressive effects, or function as keys in a pedalboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedals"@en .

aat:300209237 a skos:Concept ;
    skos:definition "Keyboards, usually of organs but also found on carillons, harpsichords, clavichords, and pianos, played by the feet and connected either to their own pipes, bells, or strings, or to those of the manual keyboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedalboards"@en .

aat:300209239 a skos:Concept ;
    skos:definition "Use to denote collectively the various mechanical contrivances devised to supplement the fingers in controlling the fingerholes of aerophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keywork"@en .

aat:300209241 a skos:Concept ;
    skos:definition "Keywork for the clarinet developed by the Belgian instrument maker Eugène Albert around 1860."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albert system"@en .

aat:300209242 a skos:Concept ;
    skos:definition "Keywork for the flute developed by Theobald Boehm in the 1830s, involving an improved placement of fingerholes and a key mechanism to provide full venting and bring all fingerholes within easy control of the fingers. Other instrument makers later adapted the system for the clarinet, oboe, bassoon, and other aerophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boehm system"@en .

aat:300209243 a skos:Concept ;
    skos:definition "Keywork in which each fingerhole is opened only for its own note, used in Europe for a limited number of instruments, such as ophicleides and certain bagpipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed system"@en .

aat:300209244 a skos:Concept ;
    skos:definition "Keywork in general use on European aerophones, in which the fingerholes stand open when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open system"@en .

aat:300209245 a skos:Concept ;
    skos:definition "Keywork developed for the flute in the 18th century, most often using eight keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simple system"@en .

aat:300209252 a skos:Concept ;
    skos:definition "Wedge- or barlike devices, usually of hardwood, inserted between the strings and soundboard of chordophones for the purpose of raising the strings to a required distance and of transmitting the vibrations of the strings to the soundboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridges"@en .

aat:300209253 a skos:Concept ;
    skos:definition "The projecting handles of chordophones such as lutes, violins, viols, and guitars, carrying the fingerboard and held by the player with one hand as the other plucks or bows the strings. They may be separate pieces attached by glue or nails, or integral to the body of the instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "necks"@en .

aat:300209254 a skos:Concept ;
    skos:definition "Boards attached to the upper surface of the necks of certain chordophones, varying in shape as the characteristics of specific instruments dictate, over which the strings are stretched and against which the fingers of the player's hand press down the strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fingerboards"@en .

aat:300209257 a skos:Concept ;
    skos:definition "Strings designed to sound by vibrating in sympathy with bowed or plucked strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sympathetic strings"@en .

aat:300209263 a skos:Concept ;
    skos:definition "Main layer of dress, usually exclusive of accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "main garments"@en .

aat:300209265 a skos:Concept ;
    skos:definition "Garments worn over other garments as the outer layer, especially those worn for protection from the natural elements. For garments worn for protection from dirt or danger, use descriptors listed under \"<protective wear>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outerwear"@en .

aat:300209266 a skos:Concept ;
    skos:definition "Garments worn for protection against dirt or danger. For garments worn for protection from weather, use \"outerwear\" or its narrower terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protective wear"@en .

aat:300209267 a skos:Concept ;
    skos:definition "Garments worn beneath main garments, usually next to the skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwear"@en .

aat:300209273 a skos:Concept ;
    skos:definition "Items that do not form the primary articles of clothing, but are instead the smaller articles of dress, such as shoes, gloves, hats, jewelry, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume accessories"@en .

aat:300209274 a skos:Concept ;
    skos:definition "Items that do not form the primary articles of clothing, but are instead the smaller articles of dress, and that are worn on the body, as opposed to being carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worn costume accessories"@en .

aat:300209275 a skos:Concept ;
    skos:definition "Items that do not form the primary articles of clothing, but are instead the smaller articles of dress, and that are carried, as opposed to worn on the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume accessories carried"@en .

aat:300209280 a skos:Concept ;
    skos:definition "Coverings for the feet that sometimes extend above the ankle; generally made of durable materials. Distinguished from \"hosiery,\" which is primarily leg coverings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footwear"@en .

aat:300209284 a skos:Concept ;
    skos:definition "Articles of costume worn about the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neckwear"@en .

aat:300209285 a skos:Concept ;
    skos:definition "Any covering for the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headgear"@en .

aat:300209286 a skos:Concept ;
    skos:definition "Ornaments such as bracelets, necklaces, and rings, of precious or semiprecious materials worn or carried on the person for adornment; also includes similar articles worn or carried for devotional or mourning purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry"@en .

aat:300209287 a skos:Concept ;
    skos:definition "Term generally applied to various types of ornaments, such as hairpins and combs, worn by men or women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair ornaments"@en .

aat:300209290 a skos:Concept ;
    skos:definition "Jewelry specifically worn around the neck, such as necklaces, or on the upper body, such as pectorals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry worn around the neck or on the upper body"@en .

aat:300209292 a skos:Concept ;
    skos:definition "Jewelry specifically worn on costume, as opposed to worn on the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry worn on costume"@en .

aat:300209294 a skos:Concept ;
    skos:definition "Ornamental bands, rings, or chains worn around the ankle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anklets"@en .

aat:300209295 a skos:Concept ;
    skos:definition "Decorative bar-shaped devices with a clasp designed to hold the hair in place, particularly such devices to hold long hair pulled to the back of the neck or a section of hair pulled to the top of the head, away from the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrettes"@en .

aat:300209297 a skos:Concept ;
    skos:definition "Ornamental chains, pins, or clasps usually worn at a woman's waist, to which trinkets, keys, purses, or other articles are attached. For ornaments and chains used for a pocket, usually of a man's garment, use \"fob chains\" and \"fobs (objects).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chatelaines"@en .

aat:300209298 a skos:Concept ;
    skos:definition "Short, narrow necklaces worn close to the throat. For wide ornamental bands worn tightly around the neck, use \"dog collars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chokers"@en .

aat:300209299 a skos:Concept ;
    skos:definition "Devices, often ornamental, used to secure the cuffs of a shirt, which is generally supplied with buttonholes or other openings to allow insertion of the cuff link. Forms include an ornamental disc or other shape attached to a toggle, or two linked ornamental buttons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuff links"@en .

aat:300209300 a skos:Concept ;
    skos:definition "Spool-shaped ear ornaments worn through an enlarged hole in the earlobe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earspools"@en .

aat:300209301 a skos:Concept ;
    skos:definition "Jewelry specifically worn on the head, such as ear ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry worn on the head"@en .

aat:300209302 a skos:Concept ;
    skos:definition "Thin browbands, gold or jeweled, worn across the forehead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferronnières"@en .

aat:300209303 a skos:Concept ;
    skos:definition "Pins used to fasten garments, resembling a large safety pin with an enlarged catch plate; often elaborately ornamented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fibulae"@en .

aat:300209306 a skos:Concept ;
    skos:definition "Ornamental clasps primarily for fastening a cope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morses"@en .

aat:300209307 a skos:Concept ;
    skos:definition "Long, straight pins with a decorative head and sometimes a sheath for encasing the point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stickpins"@en .

aat:300209308 a skos:Concept ;
    skos:definition "Ornamental pins, made with a wide variety of decorative heads, whose point pierces and holds a necktie to a shirt and fits into a receiving snap or button on the underside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie tacks"@en .

aat:300209357 a skos:Concept ;
    skos:definition "Units of usually two leaves, the flyleaf and the pastedown, placed in the front and back of a book between the covers and the text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endleaves"@en .

aat:300209377 a skos:Concept ;
    skos:definition "System of shorthand used in ancient Roman and early Medieval writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tironian notes"@en .

aat:300209428 a skos:Concept ;
    skos:definition "Complete lighting devices consisting of light source and ballast, where appropriate, together with accessories, such as globe, reflector, and housing and usually mounted on poles or posts by brackets along roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street lighting luminaires"@en .

aat:300209443 a skos:Concept ;
    skos:definition "Refers to complete lighting assemblies of pole or post, bracket, and street lighting luminaire; usually set in a series along roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street lighting units"@en .

aat:300209460 a skos:Concept ;
    skos:definition "Hand-operated kitchen devices that force foodstuffs through a pierced grate or grill, used for puréeing fruits and vegetables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food mills"@en .

aat:300209461 a skos:Concept ;
    skos:definition "Devices or receptacles designed for incubating yogurt cultures. These have a variety of designs, some powered and others using insulation to keep the incubated material at a uniform temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yogurt makers"@en .

aat:300209467 a skos:Concept ;
    skos:definition "Devices for roasting coffee beans, one type consisting of a cylindrical metal receptacle with sealable opening, attached to a long handled rod. This is placed over a fire to roast the coffee beans. For mechanized coffee roasters, typically electric, use \"coffee roasting machines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee roasters"@en .

aat:300209477 a skos:Concept ;
    skos:definition "Devices in which dough is inserted in a chamber and extruded by means of a plunger, through one of a number of interchangeable plates to form shaped cookies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cookie presses"@en .

aat:300209481 a skos:Concept ;
    skos:definition "Iron tools consisting of a long handle terminating in a ball-like or bulblike end that is heated to melt tar or to warm liquids. Most commonly used by shipbuilders to melt pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loggerheads"@en .

aat:300209503 a skos:Concept ;
    skos:definition "Devices used to press sausage meat into casings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sausage stuffers"@en .

aat:300209504 a skos:Concept ;
    skos:definition "Metal graters for making bread crumbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread graters"@en .

aat:300209511 a skos:Concept ;
    skos:definition "Tools with numerous small teeth used for grating cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese graters"@en .

aat:300209514 a skos:Concept ;
    skos:definition "Thick wooden planks, sometimes with a short one-legged support, on which cakes are baked before a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bannock boards"@en .

aat:300209519 a skos:Concept ;
    skos:definition "Large glass, plastic, or metal tubes having a rubber bulblike piece at one end to produce vacuum suction when squeezed and a small opening at the other, used for basting food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basters"@en .

aat:300209521 a skos:Concept ;
    skos:definition "Utensils, often wire or iron, which hold ears of corn for the process of drying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn dryers"@en .

aat:300209531 a skos:Concept ;
    skos:definition "Wire racks used for cooling baked foods such as bread and cakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooling racks"@en .

aat:300209532 a skos:Concept ;
    skos:definition "Strong short-bladed knives for opening the shells of oysters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster knives"@en .

aat:300209533 a skos:Concept ;
    skos:definition "Spoons having a fairly large carrying bowl and a rounded end, designed for feeding pap, which is liquid or semi-liquid grain meal moistened with water and suitable for babies or invalids. The pap is sipped from the bowl or poured from the bowl into the mouth. The bowl is somewhat larger than that of a baby spoon or feeding spoon, the bowls of which are designed to fit entirely within the baby's mouth. These spoons were popular in the 19th and early 20th centuries. They are often of silver and given as gifts, intended to be kept as a memento of infanthood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pap spoons"@en .

aat:300209534 a skos:Concept ;
    skos:definition "Tools of various forms used to cut soft curd into cubes to facilitate drainage of whey. Prefer \"cheese knives (food preparation tools)\" for large spatulas used to break up the curd for cheesemaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curd knives"@en .

aat:300209535 a skos:Concept ;
    skos:definition "Long-handled tools with a curved blade for taking potatoes out of the coals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potato rakes"@en .

aat:300209545 a skos:Concept ;
    skos:definition "Devices for crushing ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice crushers"@en .

aat:300209549 a skos:Concept ;
    skos:definition "Sharp-pointed tools for chipping or cutting ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice picks"@en .

aat:300209554 a skos:Concept ;
    skos:definition "Tubes, usually of paper, metal, or glass, for sucking up a beverage or other liquid from a container."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straws"@en .

aat:300209556 a skos:Concept ;
    skos:definition "Small tubes with a strainer at one end used in drinking maté."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombillas"@en .

aat:300209563 a skos:Concept ;
    skos:definition "Devices composed of two flat wood sticks attached at one end by a leather strap or metal hinge. Used to collect lard by compressing a cloth bag containing rendered fat between the two sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lard squeezers"@en .

aat:300209569 a skos:Concept ;
    skos:definition "Upper cylindrical or oblong hand-held stones used when grinding maize, or other food, dyes, and materials on metates, or grinding stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manos"@en .

aat:300209571 a skos:Concept ;
    skos:definition "Flat stones that have a shallow depression in the upper surface for holding maize or other grains to be ground with manos, of the type used by Native Americans, especially in areas conquered and colonized by the Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metates"@en .

aat:300209574 a skos:Concept ;
    skos:definition "Containers with a tight-fitting lid, and often an insert with separate wells, used to poach eggs. Also, various contrivances used to poach eggs, often consisting of a stand, with a long vertical handle and a number of smaller containers, meant to be placed in a pan or skillet of water. For vessels used coddling eggs, use \"egg coddlers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg poachers"@en .

aat:300209575 a skos:Concept ;
    skos:definition "Rectangular, sloping slabs to be placed under one end of a platter, so causing gravy to flow to the opposite end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platter tilters"@en .

aat:300209578 a skos:Concept ;
    skos:definition "Culinary tools used for cake decorating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icing syringes"@en .

aat:300209579 a skos:Concept ;
    skos:definition "Any of various instruments, similar to but smaller than a flat bladed oar, used for mixing, stirring, or beating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paddles"@en .

aat:300209580 a skos:Concept ;
    skos:definition "Vessels for cooking or coddling eggs. For containers with a tight-fitting lid, and often an insert with separate wells, used to poach eggs, use \"egg poachers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg coddlers"@en .

aat:300209581 a skos:Concept ;
    skos:definition "Perforated utensils, usually having a handle, used to skim liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skimmers"@en .

aat:300209582 a skos:Concept ;
    skos:definition "Skimmers specifically used to remove cream from the surface of milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream skimmers"@en .

aat:300209583 a skos:Concept ;
    skos:definition "Table or sideboard accessories used to keep dishes warm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dish warmers"@en .

aat:300209584 a skos:Concept ;
    skos:definition "Utensils of wood or metal used for pounding and thus tenderizing meat often in the form of a wooden mallet, and sometimes with large flat toothed or otherwise textured heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat tenderizers"@en .

aat:300209585 a skos:Concept ;
    skos:definition "Hand-held presses used to crush garlic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garlic presses"@en .

aat:300209587 a skos:Concept ;
    skos:definition "Culinary utensils with broad, flat usually flexible blades used to blend or spread soft food or to remove food from bowls and other utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen spatulas"@en .

aat:300209700 a skos:Concept ;
    skos:definition "The physical results of an action, process, physical circumstances, or spontaneous physical or chemical change, having to do with color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color-related effects"@en .

aat:300209712 a skos:Concept ;
    skos:definition "A white or colorless triclinic mineral of the feldspar group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albite"@en .

aat:300209715 a skos:Concept ;
    skos:definition "Any mineral that occurs as minute sheetlike or fibrous crystals in clay; it is a hydrated aluminosilicate having a layered crystal structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay mineral"@en .

aat:300209716 a skos:Concept ;
    skos:definition "A chain-lattice clay mineral, also a group name for lightweight fibrous clay minerals characterized by their bleaching and absorbent qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attapulgite"@en .

aat:300209720 a skos:Concept ;
    skos:definition "Any of a group of expanding-lattice clay minerals, the chief constituent of bentonite and fuller's earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smectite"@en .

aat:300209721 a skos:Concept ;
    skos:definition "A dioctohedral clay mineral of the smectite group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "montmorillonite"@en .

aat:300209722 a skos:Concept ;
    skos:definition "A material of white to light gray or light yellow color, extremely lightweight, absorbent, and compact, that is found in Asia Minor and is used for making tobacco pipes and ornamental carvings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepiolite"@en .

aat:300209724 a skos:Concept ;
    skos:definition "A common clay mineral of the kaolin group; hydrated aluminum silicate mineral which is the principal constituent of kaolin clay. Kaolinite crystals have a lamellar (plate-like) structure that gives the clay its slippery feel. It is a natural alteration product of aluminum silicate rocks, such as feldspar. Pure kaolinite is a primary clay; most secondary clays contain only a small percentage of kaolinite, although an exception is ball clay found in Wareham, England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaolinite"@en .

aat:300209728 a skos:Concept ;
    skos:definition "Common rock-forming mineral of the mica group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biotite"@en .

aat:300209729 a skos:Concept ;
    skos:definition "A common, bright brass-yellow mineral with a metallic luster and greenish or purplish iridescence, constituting the most important ore of copper and composed of copper iron sulfide. Chalcopyrite is mined in North and South America and in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalcopyrite"@en .

aat:300209731 a skos:Concept ;
    skos:definition "A type of white, gray, or greenish serpentine that is characterized as being hard with a silky, fibrous structure. Chrysotile found in Cyprus and Afghanistan was used for beads, amulets, seals, and inlays; it was often misnamed as jade. It was the most common source of asbestos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrysotile"@en .

aat:300209734 a skos:Concept ;
    skos:definition "The yellow variety of crystalline quartz, closely resembling topaz in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citrine"@en .

aat:300209738 a skos:Concept ;
    skos:definition "A white-to-dark gray monoclinic mineral of the amphibole group; it is a constituent of much commercial talc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tremolite"@en .

aat:300209739 a skos:Concept ;
    skos:definition "Comparatively rare rock-forming mineral related to feldspar but containing less silica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feldspathoid"@en .

aat:300209742 a skos:Concept ;
    skos:definition "An intense blue or violet-blue feldspathic mineral of the sodalite group; it is the principle constituent of lapis lazuli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lazurite"@en .

aat:300209745 a skos:Concept ;
    skos:definition "General term for particular kinds or classes of colors (such as 'primary colors')."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color types"@en .

aat:300209746 a skos:Concept ;
    skos:definition "Individual plates of glass in windows or other openings; for the compartments of windows or window sashes, use \"lights.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panes"@en .

aat:300209772 a skos:Concept ;
    skos:definition "A script in fluidly written capitals in use as the everyday Roman script into the 3rd century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "older Roman cursive"@en .

aat:300209773 a skos:Concept ;
    skos:definition "A deep orange red variety of chalcedony, similar to but darker than carnelian; used as a gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sard"@en .

aat:300209776 a skos:Concept ;
    skos:definition "A script of cursive minuscules in use as the everyday Roman script beginning in the 3rd century and persisting in some areas until the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "later Roman cursive"@en .

aat:300209778 a skos:Concept ;
    skos:definition "Children's picture books produced primarily in Britain in the mid-19th century. Typically comprising six or eight large, nearly square pages printed on one side only with color illustrations accompanied by a minimum of text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy books"@en .

aat:300209780 a skos:Concept ;
    skos:definition "The characteristic script of Spain from the 8th to the 12th century, developed from the later Roman cursive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Visigothic minuscule"@en .

aat:300209813 a skos:Concept ;
    skos:definition "Loose, sleeveless mantles traditionally worn by Arabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abas"@en .

aat:300209817 a skos:Concept ;
    skos:definition "Loose garments covering the entire body and having a veiled opening for the eyes; worn by Muslim women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burkas"@en .

aat:300209818 a skos:Concept ;
    skos:definition "Long, hooded cloaks woven in one piece worn by Arabs and monks. Also, similar cloaks worn by women at various periods in Europe and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnouses"@en .

aat:300209819 a skos:Concept ;
    skos:definition "Suits for small boys consisting of a shirt and shorts made of matching or coordinating fabric and held together by buttons at the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buster suits"@en .

aat:300209821 a skos:Concept ;
    skos:definition "Long, full, and usually hooded cloaks or overcoats made of a rough cloth or skins; use especially for those worn during the Middle Ages or later by travelers and soldiers as part of a military uniform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capotes"@en .

aat:300209824 a skos:Concept ;
    skos:definition "Tunics, short or long, and generally of linen, worn by men and women in ancient Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chitons"@en .

aat:300209825 a skos:Concept ;
    skos:definition "Short woolen mantles fastened on the right shoulder, worn by men of ancient Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chlamyses"@en .

aat:300209827 a skos:Concept ;
    skos:definition "Close-fitting short coats having a short skirt, flaps, or tails, including military coats and similar items of women's fashion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coatees"@en .

aat:300209829 a skos:Concept ;
    skos:definition "Close-fitting waist-length or hip-length garments with or without sleeves worn by men from the 15th to the 17th century and for similar garments reinforced by mail and worn under armor. Also refers to sleeved, hip-length garments worn as part of military uniforms by the Scottish units of the British army after 1855."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doublets"@en .

aat:300209837 a skos:Concept ;
    skos:definition "Type of ladies' garment that first developed in the 1670s in Europe; they were relatively loose, gown- or coat-like garments worn belted at the waist with a long train draped at the hips to reveal the front of the matching petticoat below. This style replaced the earlier stiff, constricting boned bodice-and-skirt style previously worn by women. As the style evolved, the pleats at the front were reduced in number and the bodice was opened, with the torso now covered by a stiffened piece of fabric known as a stomacher. Originally an informal style, the mantua gradually developed as formal dress and the skirt grew to extraordinary proportions. The mantua was thought to display silk designs to their best advantage, as they were draped rather than cut; as such, it is believed the garment was named after Mantua, Italy, where expensive silks were produced. However, it has also been suggested that the name derives from manteau, the French term for a coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantuas"@en .

aat:300209839 a skos:Concept ;
    skos:definition "Coats worn over a suit or other main garment; use especially for those worn in cold weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overcoats"@en .

aat:300209840 a skos:Concept ;
    skos:definition "Dresses worn over another, especially ones designed or draped to show an underdress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overdresses"@en .

aat:300209841 a skos:Concept ;
    skos:definition "Long sleeveless cloaks of ancient Rome, usually having hoods and sometimes front openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paenulas"@en .

aat:300209842 a skos:Concept ;
    skos:definition "Originally applied to various types of loose-fitting cloaks and coats for men and women. In the 19th century applied to women's fitted jackets worn over a garment with a crinoline or bustle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paletots"@en .

aat:300209843 a skos:Concept ;
    skos:definition "Voluminous squares of cloth draped around the body and worn by women of ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pallae"@en .

aat:300209844 a skos:Concept ;
    skos:definition "Complete costume, including garments and accessories, worn for a harmonious effect. Also, two or more garments or accessories designed to complement one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ensembles"@en .

aat:300209845 a skos:Concept ;
    skos:definition "Women's capes of cloth or fur with long pointed ends hanging in front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pelerines"@en .

aat:300209846 a skos:Concept ;
    skos:definition "Long cloaks, often with a wide, round collar, made of fur or lined or trimmed with fur and worn by men and women. Also, similar cloaks made of cotton or silk and worn by women and children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pelisses"@en .

aat:300209847 a skos:Concept ;
    skos:definition "Woolen garments worn by women of ancient Greece; often open on one side, and fastened on both shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peploses"@en .

aat:300209850 a skos:Concept ;
    skos:definition "Overcoats of waterproof or water-repellent material worn as protection from the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raincoats"@en .

aat:300209851 a skos:Concept ;
    skos:definition "Double- or single-breasted three-quarter length or full-length fitted overcoats with flared skirts, sometimes open in the front to reveal garments underneath, usually with large collars and lapels; worn especially by men and women during the 18th and 19th centuries, originally made with short shoulder cape. For dresses open in front to show an underskirt or with a front gore of contrasting material, use \"redingote (dresses).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redingotes"@en .

aat:300209852 a skos:Concept ;
    skos:definition "Long, loose garments that tend to be of one piece and to open down the front. Examples include ordinary wear for men and women, dating from the Middle Ages forward in the West and common yet today in Asian and African countries; and similar garments often of elegant style worn for ceremonial or official occasions or as a symbol of office or profession. For women’s dresses, use \"gowns.\" For loose-fitting garments, often wraparound and worn to the bath or informally around the house use \"bathrobes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robes"@en .

aat:300209855 a skos:Concept ;
    skos:definition "One-piece garments with gathered leg openings and buttons or snaps closing the crotch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rompers"@en .

aat:300209857 a skos:Concept ;
    skos:definition "Short, loose-fitting coats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sack coats"@en .

aat:300209858 a skos:Concept ;
    skos:definition "Main garments consisting of five to seven yards of lightweight cloth draped around the body so that one end forms a skirt and the other a head or shoulder covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saris"@en .

aat:300209860 a skos:Concept ;
    skos:definition "Small boy's suits with high-waisted trousers which button at the waist of the accompanying jacket or waistcoat; of a type worn in the late 18th and early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeleton suits"@en .

aat:300209861 a skos:Concept ;
    skos:definition "Loose-fitting raincoats; use especially for those of oilskin or rubberized fabric and often made in bright colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slickers"@en .

aat:300209862 a skos:Concept ;
    skos:definition "Close-fitting jackets of waist length or shorter, often trimmed with fur and worn by women and children in the 19th century. Also, similar outer garments without fur worn for warmth; use especially for those worn by men in the 18th and 19th centuries. Cropped, long-sleeved top coats, traditionally ornamented with military frogging, worn for both indoor and outside use predominately during the Regency era. Original invention is credited to George John Spencer, the 2nd Earl of Spencer, who supposedly introduced the style in the 1790s as a popular menswear trend after the tails of his coat were severed in an accident. A womanswear version of the coat was soon adapted to complement the high waistline of the chemise or round gowns so popular at the time. For cropped, spencer-style womenswear jackets worn with gowns in the Regency era, see \"canezous.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spencers"@en .

aat:300209863 a skos:Concept ;
    skos:definition "Sets of two or more garments made to harmonize or match in color. Also, any costume designed to be worn for a special purpose or under particular conditions, such as a space suit or a snowsuit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suits"@en .

aat:300209864 a skos:Concept ;
    skos:definition "One or two-piece garments designed to expose much of the body to the sun; worn for sunbathing or play by women and children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunsuits"@en .

aat:300209865 a skos:Concept ;
    skos:definition "Men's coats for civilian or military dress, having a shaped upper body of waist length in the front and from which longer tails extend at the back. The fashion is sometimes adopted for women's wear as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tail coats"@en .

aat:300209868 a skos:Concept ;
    skos:definition "Loose mantles of undyed woolen cloth worn by men and women of ancient Rome. Also, similar loose wraps made of various fabrics and worn in various historical periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "togas"@en .

aat:300209869 a skos:Concept ;
    skos:definition "Simple slip-on garments made with or without sleeves and usually knee-length or longer and belted at the waist; especially those worn by men and women of ancient Greece and Rome. Also, garments extending from the neckline to the waist or longer, usually high-necked and worn over other garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tunics"@en .

aat:300209871 a skos:Concept ;
    skos:definition "Wide ornamental underskirts of sumptuous cloth often supported by hoops. Worn from the late 15th to the 17th century, especially by Basque and Spanish women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basquines"@en .

aat:300209872 a skos:Concept ;
    skos:definition "Lightweight semi-tailored jackets usually made with a notched collar, patch pockets, and sometimes an insignia on the breast pocket. So called because originally made in brilliant colors or striped to distinguish schools, colleges, teams, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blazers"@en .

aat:300209874 a skos:Concept ;
    skos:definition "Originally, tight fitting, sleeveless garments for the torso and bust, quilted and strengthened with whalebone, worn chiefly by women, but also by men. Bodices were typically cross-laced at the side or back, and worn over a blouse or chemise. The term comes from \"a pair of bodies,\" the use of the plural referring to the fact that the garment was made in two pieces laced together. The term also now refers to the generally tight-fitting upper part of a woman's dress or to any tight-fitting outer vest or waistcoat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodices"@en .

aat:300209876 a skos:Concept ;
    skos:definition "Waist-length or shorter jackets, with or without sleeves, usually collarless, and worn open in the front; originally worn by men in Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boleros"@en .

aat:300209877 a skos:Concept ;
    skos:definition "Jackets, often made of leather with ribbed trim, resembling those worn by Second World War bomber crews."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bomber jackets"@en .

aat:300209879 a skos:Concept ;
    skos:definition "Women's short jackets extending to cover the spread of the panniers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caracos"@en .

aat:300209880 a skos:Concept ;
    skos:definition "Sweaters that open the full length of the center front, closing with buttons, snaps, or a zipper, and having a round or V-shaped, usually collarless, neckline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardigans"@en .

aat:300209882 a skos:Concept ;
    skos:definition "Short-sleeved blouses with a low neckline, and often cut to expose part of the midriff, especially those worn by Hindu women in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cholis"@en .

aat:300209884 a skos:Concept ;
    skos:definition "Men's or boys' shirts buttoning down the front and typically having long sleeves with barrel or french cuffs, and a soft or starched collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress shirts"@en .

aat:300209885 a skos:Concept ;
    skos:definition "Garments having a strap encircling the neck and supporting the front of the bodice, leaving shoulders and most of the back bare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halters"@en .

aat:300209887 a skos:Concept ;
    skos:definition "Close-fitting, hip-length jackets without sleeves, usually collarless and secured with a belt, especially those worn over a doublet during the 16th and 17th centuries. Use also for similar garments with closures made of woven or knitted cloth or leather and worn during the 20th century as protective outerwear or to carry equipment by military personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jerkins"@en .

aat:300209888 a skos:Concept ;
    skos:definition "Short, usually double-breasted and belted, coats or jackets made of a thick, woolen, often plaid, material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mackinaws"@en .

aat:300209889 a skos:Concept ;
    skos:definition "Raincoats of rubberized cloth; use especially for those made with India rubber following a technique invented by Charles Mackintosh (1766-1843)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mackintoshes"@en .

aat:300209890 a skos:Concept ;
    skos:definition "Very short mantles, often trimmed with lace or fringe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantelets"@en .

aat:300209892 a skos:Concept ;
    skos:definition "Men's close-fitting, formal or semiformal jackets extending to the waistline and partially or fully open at the front. Originally part of military uniforms, now worn by civilians as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mess jackets"@en .

aat:300209893 a skos:Concept ;
    skos:definition "Loose-fitting overblouses with a sailor collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middy blouses"@en .

aat:300209894 a skos:Concept ;
    skos:definition "Blouses meant to be worn outside the waistband, as opposed to those meant to be tucked in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overblouses"@en .

aat:300209895 a skos:Concept ;
    skos:definition "Blouses made of sheer and revealing material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peek-a-boo blouses"@en .

aat:300209896 a skos:Concept ;
    skos:definition "Pullover shirts with short or long sleeves and a turnover collar or a round banded neck. Usually made of a soft absorbent fabric, such as knitted cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polo shirts"@en .

aat:300209897 a skos:Concept ;
    skos:definition "Main garments, usually made without a placket or similar opening, that must be drawn over the head to be put on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pullovers"@en .

aat:300209901 a skos:Concept ;
    skos:definition "Loose-fitting garments for the upper body, often long-sleeved and collarless, of a soft, absorbent fabric such as cotton jersey, with ribbing at the collar, cuffs, and waistband. Made in pullover or cardigan style and sometimes hooded; often worn with sweat pants to form a sweat suit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweat shirts"@en .

aat:300209903 a skos:Concept ;
    skos:definition "Popular name for pullover shirts with short sleeves and a round or V-shaped collarless neck. Usually made of a lightweight machine-knit textile. For similar garments worn as underwear, use \"undershirts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "T-shirts"@en .

aat:300209912 a skos:Concept ;
    skos:definition "Fulls skirts gathered or pleated on a tight waistband. Also, similar parts of dresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dirndls"@en .

aat:300209915 a skos:Concept ;
    skos:definition "Heavy, oversized overcoats originally having fur lining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greatcoats"@en .

aat:300209916 a skos:Concept ;
    skos:definition "Very narrow skirts, narrower at the bottom than at the knee, causing the wearer to walk with short, mincing steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hobble skirts"@en .

aat:300209918 a skos:Concept ;
    skos:definition "Trousers of heavy, twilled fabric, especially cotton denim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jeans"@en .

aat:300209919 a skos:Concept ;
    skos:definition "Trousers cut full over the hips and thighs and tapering at the knee to become tightfitting from knee to ankle, especially those worn with boots for horseback riding or hiking. For trousers cut wide around the thighs and extending to the calf, use \"riding breeches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jodhpurs"@en .

aat:300209920 a skos:Concept ;
    skos:definition "Short, pleated, wraparound garments usually of tartan, developed in the mid-18th century in the Highlands of Scotland as a simplified version of a full plaid. Later adopted by the Highland regiments of the British army as an item of uniform. Worn by men and boys in Scotland as part of the national dress. Also, similar plaid skirts worn by women and girls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kilts"@en .

aat:300209923 a skos:Concept ;
    skos:definition "Cloths worn around the loins, often as the sole article of clothing in warm climates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loincloths"@en .

aat:300209925 a skos:Concept ;
    skos:definition "Skirts worn over other skirts and draped, usually to the side, to show the skirt below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overskirts"@en .

aat:300209926 a skos:Concept ;
    skos:definition "Calf-length trousers worn by women and girls, originally worn while bicycling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedal pushers"@en .

aat:300209927 a skos:Concept ;
    skos:definition "Underskirts, extending from the waist to usually just slightly shorter than the outside skirt, which provide fullness at some point. For similar skirtlike underwear which does not provide fullness use \"half slips.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petticoats"@en .

aat:300209928 a skos:Concept ;
    skos:definition "Main garments formed by wrapping a strip of cloth around the lower part of the body. Worn chiefly by men and women of the Malay Archipelago and the Pacific Islands. Also, similar often preformed garments worn by Western women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarongs"@en .

aat:300209930 a skos:Concept ;
    skos:definition "Exposed bifurcated garments extending from the waist or hip to any portion of the leg above the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shorts"@en .

aat:300209932 a skos:Concept ;
    skos:definition "Main garments of varying length extending from the waist or hip and covering a part of the lower body. Also, the lower part of a dress, coat, or other garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skirts"@en .

aat:300209934 a skos:Concept ;
    skos:definition "Term generally applied to trousers worn for informal wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slacks"@en .

aat:300209935 a skos:Concept ;
    skos:definition "Exposed bifurcated garments which extend from waist or hips to the ankle or sometimes to the knee or just below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trousers"@en .

aat:300209942 a skos:Concept ;
    skos:definition "A pearly sedimentary mineral composed of calcium-magnesium carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolomite"@en .

aat:300209945 a skos:Concept ;
    skos:definition "Loose-fitting knee-length or ankle-length garments, often tied with a belt, usually of a warm absorbent material, worn before and after bathing or informally around the house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathrobes"@en .

aat:300209946 a skos:Concept ;
    skos:definition "Waist-length jackets or capes worn in bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed jackets"@en .

aat:300209947 a skos:Concept ;
    skos:definition "Men's or women's loose, informal garments, often coat-like, worn when partly or fully undressed. Generally warm and often full-length; may be worn with a rope belt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing gowns"@en .

aat:300209949 a skos:Concept ;
    skos:definition "Hip- to knee-length garments made in jacket or mantle form, worn by women while dressing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing jackets"@en .

aat:300209952 a skos:Concept ;
    skos:definition "Loose shirtlike garments, often knee-length, worn for sleeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nightshirts"@en .

aat:300209957 a skos:Concept ;
    skos:definition "Small panels, usually attached at the neck, which cover the chest and are worn to protect a main garment when eating. Also, any similar part of a garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibs"@en .

aat:300209965 a skos:Concept ;
    skos:definition "Protective outerwear suits of jackets and trousers, made of oiled waterproof cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oilskins"@en .

aat:300209968 a skos:Concept ;
    skos:definition "Sealed and pressurized suits designed to allow the wearer to leave a pressurized cabin in outer space or at extremely high altitudes within the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space suits"@en .

aat:300209969 a skos:Concept ;
    skos:definition "Cone- or funnel-shaped decorative accessories for holding flowers in the hand, often with an attached finger ring; may also be pinned or hooked to a garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouquet holders"@en .

aat:300209970 a skos:Concept ;
    skos:definition "Devices used for producing or moving large volumes of air or gas with a low compression ratio; usually consisting of a rotating paddle wheel or airscrew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fans"@en .

aat:300209984 a skos:Concept ;
    skos:definition "Leg coverings, sometimes woven in one with panties, that extend to the ankle and usually cover the foot; generally knitted or woven, sheer or opaque, and of lightweight or heavy fabric. Distinguish from \"footwear\", which is primarily worn as coverings for the feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosiery"@en .

aat:300209985 a skos:Concept ;
    skos:definition "Footless leg coverings usually worn over tights, trousers, boots, or the like, for warmth or as a fashionable accessory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leg warmers"@en .

aat:300209987 a skos:Concept ;
    skos:definition "Sheer stockings woven in one with panties. For heavy, opaque stockings woven in one with panties use \"tights (opaque stockings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantyhose"@en .

aat:300209991 a skos:Concept ;
    skos:definition "Large pieces of square, oblong, or triangular cloth used as garments traditionally for women worn over the shoulders, covering the back, chest, and, sometimes, head. Shawls can be made from cotton or wool, and can be plain or patterned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shawls"@en .

aat:300209996 a skos:Concept ;
    skos:definition "Two supporting bands of elastic, leather, or cloth, worn across the shoulders and fastened at the waistline to trousers, a skirt, or a belt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspenders"@en .

aat:300209999 a skos:Concept ;
    skos:definition "Heavy, opaque stockings woven in one with panties. For sheer stockings woven in one with panties, use \"pantyhose.\" For one-piece, skin-tight combination garments, use \"leotards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tights"@en .

aat:300210002 a skos:Concept ;
    skos:definition "Flexible straps or bands generally encircling the waist or hips or passing over the shoulder and usually having some type of fastener, such as a buckle; worn for decoration, support, or to carry such items as weapons, tools, or money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belts"@en .

aat:300210005 a skos:Concept ;
    skos:definition "Wide sashes worn around the waist, often horizontally pleated; worn with tuxedoes and as part of miltary uniforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cummerbunds"@en .

aat:300210006 a skos:Concept ;
    skos:definition "Belts containing a concealed compartment for money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "money belts"@en .

aat:300210007 a skos:Concept ;
    skos:definition "Belts designed to carry a sword, generally worn around the waist or diagonally across the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sword belts"@en .

aat:300210008 a skos:Concept ;
    skos:definition "Belts worn to control a diver's buoyancy underwater onto which slotted lead weights can be slipped according to the diver's body size and weight and having a quick-release buckle for emergency discarding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight belts"@en .

aat:300210012 a skos:Concept ;
    skos:definition "Coverings for the hand enclosing four fingers in one section and the thumb in another section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mittens"@en .

aat:300210013 a skos:Concept ;
    skos:definition "Coverings for the hand which leave the fingers partially uncovered, especially those which extend to the elbow or above and which are made of lace, net, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitts"@en .

aat:300210014 a skos:Concept ;
    skos:definition "Tubular coverings for the hands, often open at both ends, worn for warmth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muffs"@en .

aat:300210015 a skos:Concept ;
    skos:definition "Sleeves worn usually hanging loosely over other sleeves, often of fur and sometimes made to match a collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oversleeves"@en .

aat:300210016 a skos:Concept ;
    skos:definition "Pleated or crimped cuffs or frills worn at wrist or forearm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeve ruffs"@en .

aat:300210017 a skos:Concept ;
    skos:definition "Bands on a sleeve, especially on a shirt sleeve, that cover the wrist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wristbands"@en .

aat:300210021 a skos:Concept ;
    skos:definition "Soft, socklike footwear, usually knitted or crocheted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bootees"@en .

aat:300210023 a skos:Concept ;
    skos:definition "Shoes decorated with rows of perforations, in imitation of untanned leather shoes from Scotland and Ireland originally fastened with thongs; may also be decorated with stitchings or pinkings and may have closed or open tabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brogues"@en .

aat:300210025 a skos:Concept ;
    skos:definition "High-heeled boots of leather or leatherlike material often having decorative stitching, trimming, or tooling, generally extending to mid-calf and usually having external boot straps. Traditionally worn by ranch hands, especially in the American West."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowboy boots"@en .

aat:300210027 a skos:Concept ;
    skos:definition "Coverings of cloth, leather, or similar material worn over the ankle and sometimes lower leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaiters"@en .

aat:300210029 a skos:Concept ;
    skos:definition "Traditional Japanese wooden clogs that are worn outdoors, with inverted V-straps that pass between the first two toes and with two transverse supports on the bottom of the sole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geta"@en .

aat:300210032 a skos:Concept ;
    skos:definition "Boots reaching to the hips, worn especially by fishermen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hip boots"@en .

aat:300210033 a skos:Concept ;
    skos:definition "Traditional Mexican sandals having the uppers made of interwoven leather strips and often held on the foot by loose heel straps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huaraches"@en .

aat:300210034 a skos:Concept ;
    skos:definition "Stiffened, or jacked, heavy leather boots of varying lengths, often worn for riding, especially by cavalry during the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackboots"@en .

aat:300210037 a skos:Concept ;
    skos:definition "Heelless footwear made entirely of soft leather, as deerskin, with the sole brought up to form part or all of the upper portion covering the foot, and with a back seam; worn originally by indigenous peoples of North America. Also, shoes of similar construction, with hard sole and heel attached, made of soft or hard leather or leatherlike material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moccasins"@en .

aat:300210038 a skos:Concept ;
    skos:definition "Soft boots of sealskin or other animal skins or hides, in moccasin construction, developed by indigenous peoples of the North American Arctic and Subarctic regions; use also for other similar boots, often of heavy-duty cotton, with a soft attached sole and worn with linings, adapted by other peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mukluks"@en .

aat:300210039 a skos:Concept ;
    skos:definition "Footwear worn over shoes for warmth or protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overshoes"@en .

aat:300210040 a skos:Concept ;
    skos:definition "Closed tab, usually laced shoes, with the front opening stitched under the vamp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxfords"@en .

aat:300210042 a skos:Concept ;
    skos:definition "Overshoes consisting of a sole, usually set on bands of iron, often ring-shaped, and fastened over footwear by tie straps, worn to elevate the foot for protection from mud, dirt, or wetness. For footwear with a thick sole usually of wood, but sometimes of leather or cork, use \"clogs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattens"@en .

aat:300210044 a skos:Concept ;
    skos:definition "Boots, usually pull-on and of dark leather or leatherlike material, worn for horseback riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding boots"@en .

aat:300210045 a skos:Concept ;
    skos:definition "Shoes made at least partially of wood, especially those carved from a single block of wood; worn originally by farmers and other workers in the Netherlands, France, and Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabots"@en .

aat:300210046 a skos:Concept ;
    skos:definition "Rigid boots securely fastened to the foot by various means such as laces, buckles, or hinges, and which lock into position in a ski binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski boots"@en .

aat:300210047 a skos:Concept ;
    skos:definition "Short gaiters worn over the instep and usually fastened under the foot with a strap; worn especially in the late 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spats"@en .

aat:300210049 a skos:Concept ;
    skos:definition "General term for various distinctive styles of writing of the pre-Carolingian hands of France that were derived from Latin cursive script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Merovingian scripts"@en .

aat:300210050 a skos:Concept ;
    skos:definition "A script developed in Luxeuil, in Burgundy, which was a particularly important center in the development of a Merovingian cursive style during the 7th and 8th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luxeuil script"@en .

aat:300210051 a skos:Concept ;
    skos:definition "A script developed by the early 7th century from the later Roman cursive and first known from charters issued by the Merovingian kings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Merovingian chancery script"@en .

aat:300210052 a skos:Concept ;
    skos:definition "Neckcloths with broad ends usually looped and tied under the chin and sometimes secured by a stickpin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ascots"@en .

aat:300210054 a skos:Concept ;
    skos:definition "Deep, capelike collars, often of lace or silk, worn about the shoulders by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berthas"@en .

aat:300210057 a skos:Concept ;
    skos:definition "Small neckties tied in a bow knot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow ties"@en .

aat:300210058 a skos:Concept ;
    skos:definition "Shaped articles worn at the neckline of a garment, either separate or attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collars"@en .

aat:300210059 a skos:Concept ;
    skos:definition "Formal neckcloths consisting of long strips of fine cloth wound around the neck and tied in front into a bow or knot. Ends may also tuck inside a coat. Worn especially from the end of the 17th century through the 19th century. For long, narrow lengths of cloth worn around the neck and usually under a collar, tied in a knot, loop, or bow, and often with two ends falling free vertically, use \"neckties.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cravats"@en .

aat:300210060 a skos:Concept ;
    skos:definition "Separate or detachable shirt fronts, often with a collar, worn under another garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dickeys"@en .

aat:300210061 a skos:Concept ;
    skos:definition "Long neckties tied in a slipknot with the ends left hanging vertically down front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fours-in-hand"@en .

aat:300210062 a skos:Concept ;
    skos:definition "Detachable, made-up cascades of soft fabric, often lace, worn at the center front of the neckline over other garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jabots"@en .

aat:300210063 a skos:Concept ;
    skos:definition "Heavy scarves worn around the neck, sometimes shaped and with an attached closure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mufflers"@en .

aat:300210068 a skos:Concept ;
    skos:definition "Rather long, narrow lengths of soft material worn about the neck, usually under a collar, tied in front into a knot, loop, or bow and often with the two ends falling free vertically. For neckcloths of fine cloth wound around the neck, usually over the shirt, and tied in front into a bow or knot, use \"cravats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neckties"@en .

aat:300210069 a skos:Concept ;
    skos:definition "General term for cloths of varying form worn at the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neckcloths"@en .

aat:300210071 a skos:Concept ;
    skos:definition "Ornamental pieces, often fur, which are worn at the neck; frequently trimmed with heads and tails of the fur-bearing animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neckpieces"@en .

aat:300210072 a skos:Concept ;
    skos:definition "Full, circular plaited collars worn in the 16th and 17th centuries by both men and women. Usually made of stiffened lace or linen or of muslin and frequently trimmed with lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruffs"@en .

aat:300210073 a skos:Concept ;
    skos:definition "Men's preformed neckcloths in the form of broad bands, soft or stiffened, usually fastened at the back. Also, similar neckcloths worn by men and women as part of formal riding attire and similar forms, sometimes made of leather, worn by military personnel as an item of uniform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stocks"@en .

aat:300210075 a skos:Concept ;
    skos:definition "Very narrow neckties usually tied in a bow knot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "string ties"@en .

aat:300210136 a skos:Concept ;
    skos:definition "The distinctive book hands employed in the British Isles and occasionally on the Continent between the 6th and the 9th centuries, for some texts to the 13th century, and for Gaelic texts to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Insular scripts"@en .

aat:300210143 a skos:Concept ;
    skos:definition "An Insular book hand derived from half uncial, characterized by a broad, round ductus, short ascenders and descenders, and wedge-shaped finials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Insular majuscule"@en .

aat:300210146 a skos:Concept ;
    skos:definition "An Insular script of angular, compressed, minuscule form, with pronounced pointed descenders, often incorporating cursive elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Insular minuscule"@en .

aat:300210180 a skos:Concept ;
    skos:definition "Refers to cursive Gothic scripts, developed first in the late 12th century in England and first for documentary use; later used sometimes as book hands and gradually somewhat formalized to become bastarda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic cursive"@en .

aat:300210195 a skos:Concept ;
    skos:definition "Gothic scripts employed especially in the 14th and 15th centuries that combine characteristics of the Gothic cursive and the more formal textura."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastarda"@en .

aat:300210204 a skos:Concept ;
    skos:definition "Scripts developed in 15th century Italy in humanist circles, largely to replace the Gothic scripts and revive features of Caroline minuscule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humanistic scripts"@en .

aat:300210205 a skos:Concept ;
    skos:definition "A cursive script developed in the 15th century in Italy taking some features from Caroline minuscule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humanistic cursive"@en .

aat:300210206 a skos:Concept ;
    skos:definition "A formal script developed in the 15th century in Italy based largely on Caroline minuscule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiqua"@en .

aat:300210275 a skos:Concept ;
    skos:definition "Metamorphic rock containing of serpentine (magnesium silicate) and calcite (calcium carbonate) cemented together with red iron oxide (ferrous oxide). Serpentine or ophicarbonate stones have fragments of red, white, and green colors, although the overall hue is typically greenish. The stones polish to a high gloss, which has led to them being occasionally mislabeled as marble; however, they are fragile and unsuited for sculpture. Its color and ability to take a high polish have made serpentinites popular with many civilizations over time for decorative and ornamental work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentinite"@en .

aat:300210288 a skos:Concept ;
    skos:definition "Scripts used for titles or other headings, especially when different from that used for the body of the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display scripts"@en .

aat:300210304 a skos:Concept ;
    skos:definition "The spiral shell of gastropods, often blown as sounding horns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conch"@en .

aat:300210311 a skos:Concept ;
    skos:definition "A liquid or semi-liquid preparation obtained by the combination of a solid with a solvent, to form a homogenous mixture of two or more finely divided substances in which the particles are present at a molecular scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solution"@en .

aat:300210312 a skos:Concept ;
    skos:definition "Clay possessing a high absorptive capacity; it is extensively used as an absorbent in refining and decolorizing oil and fat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuller's earth"@en .

aat:300210316 a skos:Concept ;
    skos:definition "A suspension in a liquid of relatively fine particles of matter, which have no particular propensity to dissolve or combine with the liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dispersion"@en .

aat:300210319 a skos:Concept ;
    skos:definition "Water from which dissolved ions have been removed by passing the water through cationic and anionic ion exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deionized water"@en .

aat:300210375 a skos:Concept ;
    skos:definition "Heavy basnets having a hinged visor with an eye slit, a long neck guard overlapping the top of the backplate and a wide bevor, so that the weight was borne on the shoulders rather than the head. They were in use from the late 14th to the early 16th century, becoming particularly heavy and long in the late 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great basnets"@en .

aat:300210387 a skos:Concept ;
    skos:definition "Clothing or other apparel having a primarily ceremonial or ritual purpose, or as a formal indication of station, rank, or membership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial costume"@en .

aat:300210388 a skos:Concept ;
    skos:definition "Stoles worn by a British king at his coronation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armillae"@en .

aat:300210394 a skos:Concept ;
    skos:definition "In historical western fashion, particularly in the 18th and 19th centuries, attire worn during the period of full mourning; generally refers to dress which is not only black but also of drab and lusterless materials. The term may also be applied to mourning costume of other cultures and time periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep mourning"@en .

aat:300210396 a skos:Concept ;
    skos:definition "In historical western fashion, particularly in the 18th and 19th centuries, attire worn during that period of mourning succeeding that of deep mourning; generally refers to dress lightened by the use of white, gray, or lavender."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half mourning"@en .

aat:300210414 a skos:Concept ;
    skos:definition "Costume associated with or used by officiates of the rituals of public worship, especially of the Christian religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical costume"@en .

aat:300210415 a skos:Concept ;
    skos:definition "Long, full, close-sleeved garments worn by Chrisitan clergy and as secular garments in Greco-Roman and later times, often white in color. Albs are worn by Christian priests and occasionally by consecrated kings, often beneath other vestments. They are white in the Western Church and of varying colors in the Eastern Church. Albs were sometimes decorated with richly embroidered apparels at the wrists and along the bottom. For loose, sleeveless or full-sleeved garments, prefer \"dalmatics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albs"@en .

aat:300210416 a skos:Concept ;
    skos:definition "Fur-lined hoods with two long ends meant to hang down in front; of a type originating in the Medieval period and worn especially by clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almuces"@en .

aat:300210417 a skos:Concept ;
    skos:definition "Rectangular pieces of white cloth, usually linen, worn around the neck and partly under the alb; designed to protect other vestments from perspiration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amices"@en .

aat:300210420 a skos:Concept ;
    skos:definition "Ecclesiastical caps, usually square-shaped and stiffened with a lining of heavier fabric, cardboard, or leather, worn with chancel vestments by members of the clergy who do not wear the miter; also worn as an ordinary headdress outside the church. It is topped by a tuft or a cord at the center of three, sometimes four, ridges or corners. The fabric used, its color (red, purple, or black), and its tuft correspond to the rank of the cleric who wears it, cardinal, bishop, or priest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birettas"@en .

aat:300210422 a skos:Concept ;
    skos:definition "Knitted or woven stockings worn during pontifical masses over ordinary stockings by prelates who enjoy pontifical priviledges. Over the centuries they were of various colors and decoration. After the Second Vatican Council, they have fallen out of common use along with revisions of the liturgy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical stockings"@en .

aat:300210423 a skos:Concept ;
    skos:definition "Ankle-length garments of various types, but usually having long, narrow sleeves; worn especially members of the clergy and others participating in church services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassocks"@en .

aat:300210424 a skos:Concept ;
    skos:definition "Sleeveless outer vestments in the form of a wide cloak or mantle that slips over the wearer's head and remains open at the sides. Chasubles are worn over the alb and stole by the celebrant at Mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chasubles"@en .

aat:300210425 a skos:Concept ;
    skos:definition "Outer, sleeveless, floor-length garments, cut simply in the front and full from a shoulder blade yoke in back; generally made of scarlet or black silk; always worn over a rochet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimeres"@en .

aat:300210427 a skos:Concept ;
    skos:definition "Cords, narrow bands, or the like worn at the waist, especially those worn as an ecclesiastical vestment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinctures"@en .

aat:300210428 a skos:Concept ;
    skos:definition "Purple bands which ornamented Roman tunics, running up and over each shoulder from hem to hem, and indicated the rank of the wearer. Also, bands of this type and color used on vestments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clavi"@en .

aat:300210429 a skos:Concept ;
    skos:definition "Long, semi-circular cloaklike garments fastened at the neck with a morse; worn by ecclesiastics in processions and on other ceremonial occasions. Also, similar garments worn as coronation or processional robes by laymen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copes"@en .

aat:300210430 a skos:Concept ;
    skos:definition "Short-sleeved, waist-length version of the surplice with a square-cut yoke at the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottas"@en .

aat:300210431 a skos:Concept ;
    skos:definition "Long, wide-sleeved tunics of the type worn as Christian liturgical vestments, or as secular dress in earlier periods, with or without a belt. In modern times it has been sometimes worn by kings or emperors. In the western church, the dalmatic is the outer liturgical vestment of the deacon, worn by bishops under the chasuble at solemn pontifical Masses, and by priests only with permission and on certain occasions; normally priests wear chasubles and subdeacons wear tunicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dalmatics"@en .

aat:300210432 a skos:Concept ;
    skos:definition "Large hooded cloaks; use especially for those with a mask covering the eyes and worn at masquerades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dominoes"@en .

aat:300210437 a skos:Concept ;
    skos:definition "Vestments comprising long, oblong veils or shawls used in the Roman rite, worn over the shoulders of the celebrant; generally made of silk. They are most often used during the Exposition and Benediction of the Blessed Sacrament. The ends of the humeral veil are used to envelop the hands of the celebrant when he holds up the monstrance, as a mark of respect for the sacred vessel. The item grew out of the tradition of sudaria cloths in ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humeral veils"@en .

aat:300210439 a skos:Concept ;
    skos:definition "Long, narrow ornamental bands generally with fringe at either end, worn over the left arm near the wrist by priests, deacons, and subdeacons. Originally it was a cloth of fine quality used to wipe away perspiration, or an ornamental handkerchief, generally carried in the hand as an ornament. Ornamental handkerchiefs or cloths of this kind were originally carried by people of rank in ordinary life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maniples"@en .

aat:300210441 a skos:Concept ;
    skos:definition "Long scarflike vestments worn by bishops of the Eastern Church during the celebration of Mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "omophoria"@en .

aat:300210445 a skos:Concept ;
    skos:definition "Ecclesiastical cloaks worn by clergy of the Eastern Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phelonions"@en .

aat:300210446 a skos:Concept ;
    skos:definition "Close-fitting white ecclesiastical vestments resembling a surplice usually with long close sleeves but sometimes winged or sleeveless that is worn especially by bishops and privileged prelates in some ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rochets"@en .

aat:300210447 a skos:Concept ;
    skos:definition "Vestments resembling a dalmatic worn by a bishop in the Eastern Orthodox Church during the liturgy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sakkoses"@en .

aat:300210448 a skos:Concept ;
    skos:definition "Loose, white vestments with long, full sleeves worn by priests for non-Eucharistic purposes, and commonly today over the cassock by both clergy and lay persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surplices"@en .

aat:300210450 a skos:Concept ;
    skos:definition "Garments worn by priests or other ecclesiastics during divine service, such as performing mass or other rituals, as appropriate to the rite and indicative of their hierarchical rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestments"@en .

aat:300210457 a skos:Concept ;
    skos:definition "Very abbreviated two-piece bathing suits with the bottom half cut below the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bikinis"@en .

aat:300210459 a skos:Concept ;
    skos:definition "Long, wraparound skirts worn by women for sidesaddle horseback riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding skirts"@en .

aat:300210460 a skos:Concept ;
    skos:definition "One- or two-piece costumes consisting of close-fitting trousers and a jacket made of a warm, lightweight, weather-resistant fabric. Sometimes made as an ensemble with a matching sweater, hat or cap, gloves, or other accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski suits"@en .

aat:300210463 a skos:Concept ;
    skos:definition "One-piece bathing suits, usually tight-fitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tank suits"@en .

aat:300210466 a skos:Concept ;
    skos:definition "Upright plumes of feathers of an egret or heron arranged as a hair ornament or in a turban. Also, similar ornaments, often jeweled, in the shape of feathers, especially those worn on the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aigrettes"@en .

aat:300210479 a skos:Concept ;
    skos:definition "Two buttons, one larger than the other, connected by a shank, inserted into shirt neck buttonholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar buttons"@en .

aat:300210488 a skos:Concept ;
    skos:definition "Any of various folds in the fabric or applied or detached bands that serve as a finish or trimming on the arms or legs of items of costume such as blouses, coats, trousers, gloves, or boots, or as costume accessories. Includes cuffs made as separate items in addition to those made as component parts of garments. In an example in a military context, sleeve cuffs may be employed to designate unit or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuffs"@en .

aat:300210502 a skos:Concept ;
    skos:definition "Finished edge of a cloth article, such as a skirt, sleeve, or curtain fashioned by rolling up or folding back an edge and stitching it down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hems"@en .

aat:300210503 a skos:Concept ;
    skos:definition "Inner soles of some footwear on which foot rests, usually covered or partly covered by the sock lining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insoles"@en .

aat:300210505 a skos:Concept ;
    skos:definition "The two parts of a garment folded back on the chest, especially a continuation of a coat collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapels"@en .

aat:300210515 a skos:Concept ;
    skos:definition "Beauty spots, sometimes in decorative shapes, applied to the face for ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patches"@en .

aat:300210517 a skos:Concept ;
    skos:definition "Flat pouchlike components stitched into or onto a garment, accessible through a finished opening typically convenient to the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pockets"@en .

aat:300210524 a skos:Concept ;
    skos:definition "Laces or strings used for fastening shoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoelaces"@en .

aat:300210527 a skos:Concept ;
    skos:definition "Pads, usually semicircular or triangular in shape, stitched or otherwise attached to the inside of a garment to shape, raise, or widen the shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder pads"@en .

aat:300210530 a skos:Concept ;
    skos:definition "Shaped coverings for the arm. Originally made separate from the main garment and attached by lacing through eyelets at the shoulder; later, often made as component parts of garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeves"@en .

aat:300210535 a skos:Concept ;
    skos:definition "Separate sleeves of light material worn under the sleeves of a main garment and visible through it or extending beyond it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersleeves"@en .

aat:300210537 a skos:Concept ;
    skos:definition "Drawers with full, loose legs gathered above or below the knee; worn by women and children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bloomers"@en .

aat:300210538 a skos:Concept ;
    skos:definition "Women's close-fitting underwear worn for bust support and varying greatly in style, ranging in width from a band to a waist-length bodice, made with or without cups or straps and often boned or wired for additional support or separation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brassieres"@en .

aat:300210539 a skos:Concept ;
    skos:definition "Snug-fitting underpants with leg openings, made in a variety of styles for men, women, and children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "briefs"@en .

aat:300210540 a skos:Concept ;
    skos:definition "Women's one-piece garments consisting of a camisole and bloomers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camiknickers"@en .

aat:300210541 a skos:Concept ;
    skos:definition "Women's underbodices usually worn over corsets or brassieres, reaching to or just below the waist. Usually cut straight across the bustline, with straps structurally separate from the garment body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camisoles"@en .

aat:300210542 a skos:Concept ;
    skos:definition "Loose-fitting, straight-hanging shirtlike underwear with or without sleeves, usually extending to the hip or knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemises"@en .

aat:300210544 a skos:Concept ;
    skos:definition "One-piece underwear garments combining an upper body covering, with or without sleeves, with a bifurcated lower body covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combinations"@en .

aat:300210545 a skos:Concept ;
    skos:definition "One-piece garments combining a brassiere and a corset or girdle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corselets"@en .

aat:300210547 a skos:Concept ;
    skos:definition "Underbodices worn over a corset with sleeves or built-up straps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corset covers"@en .

aat:300210554 a skos:Concept ;
    skos:definition "Petticoats originally made with a stiff, woven fabric of horsehair, linen, cotton, or wool. Later often used in conjunction with hoops of whalebone or steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crinolines"@en .

aat:300210555 a skos:Concept ;
    skos:definition "Bifurcated undergarments extending from the waist to the top of the knees or below. For similar garments with elastic or a band near the knees or below, use \"bloomers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawers"@en .

aat:300210557 a skos:Concept ;
    skos:definition "Supports in the form of hoops or padded rolls, worn beneath a skirt to add fullness; of a type worn in the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farthingales"@en .

aat:300210559 a skos:Concept ;
    skos:definition "Ties or bands worn to support stockings or socks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garters"@en .

aat:300210563 a skos:Concept ;
    skos:definition "Type of underpants for women and children extending from the waist or hip to any portion of the leg above the kneecap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panties"@en .

aat:300210564 a skos:Concept ;
    skos:definition "Underwear usually made the length of the garment under which it is to be worn, thereby taking the place of a lining. Usually applied to full slips with a bodice and shoulder straps made in dress length. Prefer \"half slips\" for skirtlike underwear extending from the waist to near the hemline of the garment with which it is worn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slips"@en .

aat:300210567 a skos:Concept ;
    skos:definition "Women's one-piece garments consisting of a chemise and underpants with loose-fitting legs or a snap crotch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teddies"@en .

aat:300210570 a skos:Concept ;
    skos:definition "Bodices worn next to the body or under other bodices or garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underbodices"@en .

aat:300210572 a skos:Concept ;
    skos:definition "Dresses worn beneath another; use especially for those underdresses designed to be seen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underdresses"@en .

aat:300210574 a skos:Concept ;
    skos:definition "Skirts worn beneath another; use especially for those underskirts designed to be seen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underskirts"@en .

aat:300210578 a skos:Concept ;
    skos:definition "Rectangular pads, generally filled with horsehair, stitched into the top back of the skirt to act as a bustle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bustle pads"@en .

aat:300210580 a skos:Concept ;
    skos:definition "Frames of varied construction worn at or below the waist in the back to distend the garment backward at the hips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bustles"@en .

aat:300210581 a skos:Concept ;
    skos:definition "Bell-shaped crinolines of whalebone or steel worn in the mid-19th century. Use \"hoops (shaping garments)\" for 18th-century shaping garments consisting of a series of concentric hoops of whalebone or bamboo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cage crinolines"@en .

aat:300210582 a skos:Concept ;
    skos:definition "Smoothly fitted undergarments extending from or below the bust down to the waist or below, stiffened by strips of steel or whalebone, or with casing for a busk, sometimes limbered by elastic goring, sometimes tightened by lacing, and fastened by hooks. It is usually worn by women for support and molding of the figure including the ribcage and possibly the hips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corsets"@en .

aat:300210585 a skos:Concept ;
    skos:definition "Women's underwear, often partly or entirely of elastic or boned, for supporting and shaping the appearance of the abdomen, hips, and buttocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girdles"@en .

aat:300210588 a skos:Concept ;
    skos:definition "Underbodices similar to stays but looser and without bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jumps"@en .

aat:300210591 a skos:Concept ;
    skos:definition "Generally, any garment or costume accessory that supports; use especially for bands and similar devices, usually of elastic or cotton webbing, worn to support a part of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supporters"@en .

aat:300210596 a skos:Concept ;
    skos:definition "Broad bands of cloth, such as those wound around a baby's waist to support the back and stomach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binders"@en .

aat:300210598 a skos:Concept ;
    skos:definition "Baglike wraps for infants which may be made with or without hood and structured sleeves but which always encase the lower body in one closed bag. May be made in one piece, or with closures at the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buntings"@en .

aat:300210601 a skos:Concept ;
    skos:definition "Complete outfits of clothing and equipment for a newborn infant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "layettes"@en .

aat:300210604 a skos:Concept ;
    skos:definition "Strips of cloth about 2 inches wide wound around an infant to keep the bed (swaddling garment) in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swaddling bands"@en .

aat:300210605 a skos:Concept ;
    skos:definition "Term for clothes worn by infants that restrict movement to some extent, including either clothing consisting of narrow strips of cloth used to swaddle an infant or an infant's long clothes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swaddling clothes"@en .

aat:300210700 a skos:Concept ;
    skos:definition "Systematic arrangement of visible energy rays by wavelength, seen as a band of rainbow colors when sunlight is passed through a prism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visible spectrum"@en .

aat:300210710 a skos:Concept ;
    skos:definition "Kerchiefs, triangular or folded triangularly, with two of the ends tied under the chin; often open at the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "babushkas"@en .

aat:300210711 a skos:Concept ;
    skos:definition "Heavy knitted or crocheted hoods that cover the head, neck and tops of the shoulders; worn especially by soldiers or mountaineers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balaclavas"@en .

aat:300210712 a skos:Concept ;
    skos:definition "Women's hats with a wide brim, generally of light material over a framework to create an inflated crown; named in commemoration of the pioneering balloon ascent of 1783."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon hats"@en .

aat:300210716 a skos:Concept ;
    skos:definition "Straw hats with a low crown and a wide brim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bergère hats"@en .

aat:300210717 a skos:Concept ;
    skos:definition "Close-fitting caps, often of mesh, worn by young children in the 16th and 17th centuries; also, soft caps worn by children and adults while sleeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biggins"@en .

aat:300210718 a skos:Concept ;
    skos:definition "Straw hats with a straight brim, flat crown and a ribbon band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boaters"@en .

aat:300210720 a skos:Concept ;
    skos:definition "Soft hats usually tied under the chin and having a front brim; formerly worn by women, but now mostly children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonnets"@en .

aat:300210721 a skos:Concept ;
    skos:definition "Soft caps worn for lounging or as nightwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boudoir caps"@en .

aat:300210723 a skos:Concept ;
    skos:definition "Large hoods supported by an arrangement of hoops and designed to be collapsible; worn by women in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calashes"@en .

aat:300210724 a skos:Concept ;
    skos:definition "Tall caps of black fur or feathers, with or without a plume or cockade and usually with a bag draped from the crown to the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "busbies"@en .

aat:300210731 a skos:Concept ;
    skos:definition "Flattened versions of the bicorne or tricorne adopted for court wear; intended to be carried under the arm and not worn on the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapeaux bras"@en .

aat:300210732 a skos:Concept ;
    skos:definition "Round, stuffed coverings for the head with wide streamers falling from the crown; worn in the 14th and 15th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaperons"@en .

aat:300210733 a skos:Concept ;
    skos:definition "Hats with a bell-shaped crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloches"@en .

aat:300210734 a skos:Concept ;
    skos:definition "Men's stiff, round-crowned hats, usually of felt, the large brim cocked or rolled up against the crown; worn from the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocked hats"@en .

aat:300210735 a skos:Concept ;
    skos:definition "Term applied to the tall lace headdresses worn by women in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commodes"@en .

aat:300210736 a skos:Concept ;
    skos:definition "Term applied to women's headdresses which vary in style from the 14th to the 18th century, but which are often of conical shape and usually made of delicate materials with lappets of lace or ribbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornets"@en .

aat:300210737 a skos:Concept ;
    skos:definition "Wide-brimmed hats with a large soft crown of the type worn by ranch hands in the American West."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowboy hats"@en .

aat:300210739 a skos:Concept ;
    skos:definition "Helmets worn by motorcyclists, air crews, automobile racers, and others, to protect the head in the event of an accident."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crash helmets"@en .

aat:300210740 a skos:Concept ;
    skos:definition "Soft, cloth caps with a gathered crown, worn indoors by women in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dormeuses"@en .

aat:300210742 a skos:Concept ;
    skos:definition "Small headscarves sometimes trimmed with lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanchons"@en .

aat:300210744 a skos:Concept ;
    skos:definition "Close-fitting, cone-shaped caps with a flat crown usually of felt and often trimmed with a long tassel; of a type originating in Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fezes"@en .

aat:300210746 a skos:Concept ;
    skos:definition "Round, wedge-shaped caps with low, flat, soft crowns, with a short visor in the front. These are usually made of wool or tweed, but can be found in a variety of fabrics, and slight variations in styling. These are thought to originate in 15th century Northern England, though versions appear elsewhere in Europe, with variations in shape. They were originally worn and were associated with working class men, and became popular in the United States from the 19th century, introduced by immigrants from Ireland and England. They have gone in and out of fashion to the present day, with both men and women in many social contexts. Usage of the term has been extended to include caps of various shapes and styles appearing in portraiture, but should be reserved for the modern style and its obvious historical antecedents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat caps"@en .

aat:300210759 a skos:Concept ;
    skos:definition "Tall headdresses, sometimes extending three feet above the head, often cone-shaped, but also horn- or heart-shaped, and generally having a small veil attached to the top. Worn by women in the 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hennins"@en .

aat:300210760 a skos:Concept ;
    skos:definition "Woolen bonnets, typically having a crease in the crown from front to back, short ribbon streamers at the back, and often a badge in the front; introduced for wear by the Highland units of the British army and then adopted for Scottish traditional dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glengarries"@en .

aat:300210761 a skos:Concept ;
    skos:definition "Men's felt hats with a soft crown dented lengthwise and a slightly rolled brim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homburgs"@en .

aat:300210763 a skos:Concept ;
    skos:definition "Caps with long visors, of the style worn by jockeys; also worn by light infantry from the mid-18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jockey caps"@en .

aat:300210764 a skos:Concept ;
    skos:definition "Tall, flat-topped, brimless hats worn by some clergy of the Eastern Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kamelaukions"@en .

aat:300210766 a skos:Concept ;
    skos:definition "Small military caps with a nearly horizontal visor and a rigid crown that slopes toward the front; most popular in the French and United States armies, later adopted for civilian use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kepis"@en .

aat:300210768 a skos:Concept ;
    skos:definition "Cocked hats with the front side pinched to form a peak; worn in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kevenhullers"@en .

aat:300210770 a skos:Concept ;
    skos:definition "Streamers, often of lace, ornamenting a headdress, cap, bonnet or the like, which either hung down or along the side of the face or which were pinned up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lappets"@en .

aat:300210771 a skos:Concept ;
    skos:definition "Long, pipelike extensions of the hood, worn in the 14th and 15th centuries by men. For long, narrow streamers of cloth attached to or part of a garment use \"tippets (costume accessories).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liripipes"@en .

aat:300210772 a skos:Concept ;
    skos:definition "Large, ornately trimmed hats as worn in the musical show The Merry Widow in 1907."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Merry Widow hats"@en .

aat:300210773 a skos:Concept ;
    skos:definition "Soft, cloth caps with a high, full crown, often tied under the chin and sometimes made with side lappets; worn indoors by women in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobcaps"@en .

aat:300210776 a skos:Concept ;
    skos:definition "Term applied to conical caps or bonnets with the peak bent or turned over in front. It originated in the ancient country of Phrygia in Asia Minor and is represented in ancient Greek art as the type of headdress worn by Orientals. In Rome the Phrygian cap was worn by emancipated slaves as a symbol of their freedom. During the 11th and 12th centuries, it was again extensively used. For similar caps worn in the French Revolution and identified with the cap of liberty, use \"liberty caps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phrygian caps"@en .

aat:300210778 a skos:Concept ;
    skos:definition "Type of skullcap, sometimes pointed, worn especially by ancient Greeks and Romans, and also by ecclesiastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilei"@en .

aat:300210780 a skos:Concept ;
    skos:definition "Small, cloth caps worn high on the head by women and sometimes young girls in the 17th and 18th centuries; early examples were made with lappets and later ones often were trimmed with ruffles or lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinners"@en .

aat:300210781 a skos:Concept ;
    skos:definition "Bonnets made with a wide brim slanting forward from a small crown to frame and shadow the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poke bonnets"@en .

aat:300210782 a skos:Concept ;
    skos:definition "Tall, cylindrical headdresses seen in ancient Greek representations of certain goddesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poloi"@en .

aat:300210785 a skos:Concept ;
    skos:definition "Women's hats with a soft, circular crown enclosed by a stiffened, turned up brim; worn in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pork pie hats"@en .

aat:300210787 a skos:Concept ;
    skos:definition "Headdresses of the later Egyptian pharaohs, combining the white crown of Upper Egypt with the red crown of Lower Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pschents"@en .

aat:300210788 a skos:Concept ;
    skos:definition "Small, indoor caps with a single or double frill as a border to the front only, ending at the ears; worn by women in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round-eared caps"@en .

aat:300210794 a skos:Concept ;
    skos:definition "Hats with a wide brim turned up at the sides and projecting to front and back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shovel hats"@en .

aat:300210796 a skos:Concept ;
    skos:definition "Men's felt hats with a round crown and a wide brim, sometimes turned up on one side; worn from the 18th century onward and adopted for military use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slouch hats"@en .

aat:300210797 a skos:Concept ;
    skos:definition "Substances composed by the chemical union of sodium with additional elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium compounds"@en .

aat:300210798 a skos:Concept ;
    skos:definition "High-crowned hats made of felt or straw with a very wide brim usually rolled at the edges, worn especially in the American Southwest and Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sombreros"@en .

aat:300210800 a skos:Concept ;
    skos:definition "Strips of fabric placed over the head of a swaddled baby and pinned to its shirt. Intended to keep the head straight and to support the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staybands"@en .

aat:300210801 a skos:Concept ;
    skos:definition "Substances composed by the chemical union of nitrogen with additional elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrogen compounds"@en .

aat:300210803 a skos:Concept ;
    skos:definition "Bonnets of fabric or straw having a wide brim to shade the face, often a ruffle around the front and sides, and sometimes a capelike extension in the back to protect the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunbonnets"@en .

aat:300210804 a skos:Concept ;
    skos:definition "Caps worn in Muslim countries, especially tall cone-shaped caps worn by dervishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tajes"@en .

aat:300210805 a skos:Concept ;
    skos:definition "Bonnets made with a tight-fitting headband and a very wide circular crown, usually with a pompon in the center. In British military usage, worn by Scottish ranks as field service headgear, from 1915."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tam-o'-shanters"@en .

aat:300210809 a skos:Concept ;
    skos:definition "Long, knitted caps, made from a bag tapered at both ends and having one end turned inside another; traditionally worn for winter sports by Canadians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuques"@en .

aat:300210812 a skos:Concept ;
    skos:definition "Small, brimless caps or hats worn by men or women in various different eras and countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toques"@en .

aat:300210814 a skos:Concept ;
    skos:definition "Scottish headdresses of linen or wool with flaps which extend to the shoulders; formerly worn by elderly women of the lower classes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toys"@en .

aat:300210819 a skos:Concept ;
    skos:definition "Navy blue, knitted caps worn in inclement weather by seamen in the U.S. Navy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watch caps"@en .

aat:300210820 a skos:Concept ;
    skos:definition "Substances composed by the chemical union of sulfur with additional elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfur compounds"@en .

aat:300210821 a skos:Concept ;
    skos:definition "Costume artifacts that are related but discrete and are treated as a unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume groupings"@en .

aat:300210826 a skos:Concept ;
    skos:definition "Pieces of horse armor protecting the chest and shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peytrals"@en .

aat:300210830 a skos:Concept ;
    skos:definition "Armors, typically of elaborate workmanship and highly decorated, made for wear in ceremonies, on state occasions, and at other special events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parade armors"@en .

aat:300210832 a skos:Concept ;
    skos:definition "Armors designed to be worn by humans mounted on horses. A primary use equestrian armors is for contestants in equestian-related tournaments. For armor worn by horses, use \"horse armor.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equestrian armors"@en .

aat:300210833 a skos:Concept ;
    skos:definition "Armors designed for the Gestech, a form of joust fought with rebated lances, in which one opponent tries to unhorse the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stechzeuge"@en .

aat:300210834 a skos:Concept ;
    skos:definition "Armors designed specifically for the Rennen, a form of joust fought with sharpened lances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rennzeuge"@en .

aat:300210842 a skos:Concept ;
    skos:definition "Pieces of armor protecting the front of the abdomen below the breastplate, made originaly of mail, later of plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faulds"@en .

aat:300210856 a skos:Concept ;
    skos:definition "Wigs with the bottom locks turned up into bobs or short curls; always intended to be worn for undress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bob wigs"@en .

aat:300210858 a skos:Concept ;
    skos:definition "Bands or fillets used to confine the hair; worn for functional or decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairbands"@en .

aat:300210861 a skos:Concept ;
    skos:definition "Open-meshed nets made of human hair, silk or synthetics, worn over the hair to keep it in place. Also includes those studded with pearl-like ornaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairnets"@en .

aat:300210864 a skos:Concept ;
    skos:definition "Term applied to wigs popularly worn from the 17th to the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perukes"@en .

aat:300210865 a skos:Concept ;
    skos:definition "Combs generally made in pairs, worn on each side of the head to hold the hair in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side combs"@en .

aat:300210866 a skos:Concept ;
    skos:definition "Wigs with a tied-back queue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie-wigs"@en .

aat:300210869 a skos:Concept ;
    skos:definition "Infants' soft hats with hood-shaped crown fitted to the head with a frilled surround, tied under the chin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby bonnets"@en .

aat:300210870 a skos:Concept ;
    skos:definition "Term coined in the 19th century for cocked hats with the brim turned up flat against the front and back to form two corners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicornes"@en .

aat:300210874 a skos:Concept ;
    skos:definition "Hats with a tall conical crown and a moderate brim, especially fashionable from 1560 to 1620."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copotains"@en .

aat:300210875 a skos:Concept ;
    skos:definition "Caps, often made of wool, with a visor in the front and in the back, and with earflaps usually raised and tied on the top of the hat; use especially for those worn as hunting caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deerstalker caps"@en .

aat:300210876 a skos:Concept ;
    skos:definition "Men's hats made from beaver-fur felt; worn from the 17th to the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demi-castors"@en .

aat:300210883 a skos:Concept ;
    skos:definition "Women's hats with small, dome-shaped crowns and down-turned brims, often made in one; of straw in the 19th and early 20th centuries and of felt in the 1930s and onward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mushroom hats"@en .

aat:300210886 a skos:Concept ;
    skos:definition "Wide-brimmed, low-crowned sun hats thought to be Thessalian origin, worn by ancient Greeks, Etruscans, and Romans; considered traveling hats. The style was revived during the early Medieval period. These hats are believed to have been made of wool felt, leather, or straw, with a floppy brim. The god Hermes/Mercury was originally portrayed with wide-brimmed traveling hats; when his depictions were changed to winged hats, these were also often called \"petasuses\" even if they were close-fitting caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petasuses"@en .

aat:300210888 a skos:Concept ;
    skos:definition "Military-style caps with a tall rigid crown and a visor, typically worn by soldiers and members of marching bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shakos"@en .

aat:300210892 a skos:Concept ;
    skos:definition "Women's low-crowned straw hats having a brim turned up behind and held in place by a bandeau, which is usually decorated with flowers; similar to hats depicted in paintings by Watteau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Watteau hats"@en .

aat:300210941 a skos:Concept ;
    skos:definition "Glassware produced when hot molten glass is poured into a mold and made to conform to it by means of a plunger; the interior form is independent of the exterior form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressed glass"@en .

aat:300210944 a skos:Concept ;
    skos:definition "An opaque glass that has the appearance of white porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opaque white glass"@en .

aat:300210969 a skos:Concept ;
    skos:definition "Pressed glass with an orange gold iridescence made with a colored spray rather than by the presence of metallic oxides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnival glass"@en .

aat:300210974 a skos:Concept ;
    skos:definition "A name given to a type of glass developed in 1864 by William Leighton as a substitute for lead glass in making inexpensive bottles. Calcined limestone, or lime, is used to produce a glass whose advantages are that it is inexpensive, lightweight, cools quickly, and is less resonant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime glass"@en .

aat:300210977 a skos:Concept ;
    skos:definition "Short, thick arrows fitted with flights and a head of any of various shapes, often square or blunt, designed to be shot by crossbows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolts"@en .

aat:300210980 a skos:Concept ;
    skos:definition "Inexpensive glass, commonly of greenish or brownish color, which is caused by the presence of impurities, notably iron. It is often used to make bottles or windows. The term is derived from its resemblance to forest glass, which is also called \"green glass.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green glass"@en .

aat:300210982 a skos:Concept ;
    skos:definition "Short swords, hangers, with short cross hilts, often elaborately decorated and made of fine materials such as carved bone or ivory or cast silver, sometimes with a chain linking the forward quillon to the pommel; some but not all were designed for hunting. They first appeared in the second quarter of the 17th century and became quite common in the 18th."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuttoes"@en .

aat:300210989 a skos:Concept ;
    skos:definition "Feldspar used in the manufacture of ceramics and glass, as well as gemstones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkali feldspar"@en .

aat:300210991 a skos:Concept ;
    skos:definition "Glassy form of orthoclase in which sodium may replace up to half of the potassium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanidine"@en .

aat:300210994 a skos:Concept ;
    skos:definition "Locks in which a spring-operated cock holding a piece of flint or pyrite strikes sparks from a piece of steel pivoted vertically over the pan of priming powder, igniting it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snaphances"@en .

aat:300210995 a skos:Concept ;
    skos:definition "A sodium potassium feldspar mixture containing albite and orthoclase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anorthoclase"@en .

aat:300210999 a skos:Concept ;
    skos:definition "Weapons consisting of a large, heavy, metal head studded with spikes that is either directly mounted on a shaft or attached to it by a length of chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morning stars"@en .

aat:300211001 a skos:Concept ;
    skos:definition "Parts or components of staff weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staff weapon components"@en .

aat:300211014 a skos:Concept ;
    skos:definition "Typefaces whose characters are especially narrow in proportion to their height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condensed typefaces"@en .

aat:300211017 a skos:Concept ;
    skos:definition "Typefaces whose characters are especially broad in proportion to their height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "expanded typefaces"@en .

aat:300211030 a skos:Concept ;
    skos:definition "Refers to old style typefaces based closely upon humanistic scripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humanist"@en .

aat:300211037 a skos:Concept ;
    skos:definition "Material objects contrived for amusement rather than for practical use by children or pets, or intended as collectibles by adults. Toys are generally miniature versions of real beings or objects that lend themselves to imaginative or imitative play. Toys may also be items for use in games. Among the earliest toys were dolls and balls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toys"@en .

aat:300211038 a skos:Concept ;
    skos:definition "Group of script typefaces based on Gothic cursive hand-written scripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civilité"@en .

aat:300211041 a skos:Concept ;
    skos:definition "Toys with an educational or teaching component."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational toys"@en .

aat:300211042 a skos:Concept ;
    skos:definition "Cubical objects of wood, plastic, or other material having letters of the alphabet on most or all sides and used as teaching toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphabet blocks"@en .

aat:300211043 a skos:Concept ;
    skos:definition "Small platforms designed to skim over the water when towed at high speed by motorboats and upon which riders stand during certain aquatic sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquaplanes"@en .

aat:300211062 a skos:Concept ;
    skos:definition "Sports and athletic equipment used in games that employ balls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball game equipment"@en .

aat:300211064 a skos:Concept ;
    skos:definition "Sports and athletic equipment used in conjunction with gymnastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gymnastic equipment"@en .

aat:300211065 a skos:Concept ;
    skos:definition "Narrow, and relatively long, wooden or steel beams set horizontally several feet above the floor and upon which performers demonstrate balancing acts and gymnastic moves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balance beams"@en .

aat:300211067 a skos:Concept ;
    skos:definition "The apparatus used in weightlifting, consisting generally of a bar with replaceable, disk-shaped weights fastened to the ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbells"@en .

aat:300211068 a skos:Concept ;
    skos:definition "Long, elongated, and usually wooden clubs of various sizes and shapes used to strike balls in certain sports, such as baseball and cricket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bats"@en .

aat:300211069 a skos:Concept ;
    skos:definition "The flat vertical surfaces at either end of basketball courts to which the baskets are attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backboards"@en .

aat:300211070 a skos:Concept ;
    skos:definition "Wheeled toys, usually meant to be pulled, in which bells or chimes ring as the wheels turn; popular since the 1860s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell toys"@en .

aat:300211071 a skos:Concept ;
    skos:definition "Long, usually wooden, sticks with various types of heads used to propel balls or disks in some games, such as billiards and shuffleboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cues"@en .

aat:300211072 a skos:Concept ;
    skos:definition "Lightweight solids, usually cubical and often of wood, plastic, or similar material, occurring in sets and designed as children's toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blocks"@en .

aat:300211073 a skos:Concept ;
    skos:definition "Sports and athletic equipment used in conjunction with winter sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winter sports equipment"@en .

aat:300211074 a skos:Concept ;
    skos:definition "Heavy, sturdy sleds having two pairs of runners, a brake, and steering mechanism that enables the front rider to direct the sled down steeply banked chutes; found in two- and four-rider versions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bobsleds"@en .

aat:300211075 a skos:Concept ;
    skos:definition "The club-shaped or candle-shaped wooden or plastic targets set up for the various games of bowling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowling pins"@en .

aat:300211077 a skos:Concept ;
    skos:definition "A variety of toy guns that utilize caps, which are small charges of gunpowder, to imitate the sound of real pistols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap pistols"@en .

aat:300211078 a skos:Concept ;
    skos:definition "Gameboards marked off into 64 squares of alternating dark and light colors arranged eight vertically by eight horizontally; like chessboards except that modern checkerboards tend to be black and red, whereas chess boards may be black and white, or any two of many possible contrasting colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkerboards"@en .

aat:300211079 a skos:Concept ;
    skos:definition "Special ropes, usually of four strands of selected manilla long fiber and about 1 1/2 inches in diameter, designed for gymnastic climbing or as practice for mountain climbing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climbing ropes"@en .

aat:300211080 a skos:Concept ;
    skos:definition "Boards, often long narrow rectangles of wood, for keeping score during the game of cribbage and having holes in the upper surface into which pegs are placed to mark the score and progress of the players."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cribbage boards"@en .

aat:300211081 a skos:Concept ;
    skos:definition "Wooden implements, generally with long handles and short striking heads set perpendicular at one end, used to hit balls in certain sports, such as croquet and polo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mallets"@en .

aat:300211082 a skos:Concept ;
    skos:definition "Various small hooplike, arched wire, or constructed rectilinear targets at which balls are aimed in such sports as croquet and cricket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wickets"@en .

aat:300211083 a skos:Concept ;
    skos:definition "Large, heavy, ellipsoidal stone or iron disks usually having one rough side and one smooth side with a hole in the center of each into which can be screwed a short gooseneck handle by which the disks are released across the ice in the game of curling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curling stones"@en .

aat:300211084 a skos:Concept ;
    skos:definition "Small polyhedral objects, usually cubes, that are marked on each face with dots, symbols, or numbers, used as game pieces, for casting lots, and for other purposes. An example is dice marked on each face distinctively with from one to six dots such that opposite faces add to seven; may also be used for similar cubes marked with other numbers or symbols specially created for gambling or certain other games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dice"@en .

aat:300211085 a skos:Concept ;
    skos:definition "Disk-shaped objects, over 7 inches in diameter, thicker at the center than at the edges and having a metal rim permanently attached to a wooden body and with a central weight; to be thrown for distance in a field event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discuses"@en .

aat:300211086 a skos:Concept ;
    skos:definition "Children's scale baby carriages for use with dolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doll carriages"@en .

aat:300211087 a skos:Concept ;
    skos:definition "Figurines representing humans or animals, including but not restricted to those intended as toys for children, usually girls, or as collectibles for adults. Dolls are commonly in the form of a baby or woman, often with changeable clothes; they may have moveable arms and legs. Doll may be made of cloth (rag dolls), wood, clay, porcelain, wax, paper, plastic, celluloid, corn husks, or other materials. Dolls may also be figurines used for ceremonial, religious, or decorative purposes. Archaeological evidence suggests that dolls were the first playthings; they have been found in Babylonian and Egyptian tombs from ca. 3000 BCE. In ancient Greece and Rome, maturing girls consecrated their childhood dolls to the goddesses. Cloth dolls in the form of animals are generally called \"stuffed toys.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolls"@en .

aat:300211088 a skos:Concept ;
    skos:definition "Accessories used in connection with doll-playing. Toys or miniature objects that accompany figurines representing humans or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doll-playing accessories"@en .

aat:300211090 a skos:Concept ;
    skos:definition "Flat, rectangular blocks, usually of bone, ivory, or wood and occurring in sets of 28, the top face of each being divided transversely into two equal parts by a line; each part is either blank or bears from one to six pips or dots, so as to present all the possible combinations from double blank to double six. Sometimes the pieces have more pips, and are more in number accordingly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dominoes"@en .

aat:300211091 a skos:Concept ;
    skos:definition "Four-sided tops with the Hebrew letters non, gimmel, hé, and shin one on each side and used in a children's game traditionally played during the Jewish festival of Hanukkah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dreidels"@en .

aat:300211093 a skos:Concept ;
    skos:definition "Weights consisting of two spherical ends firmly attached to a short bar serving as a handle; used as exercise and fitness apparatus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumbbells"@en .

aat:300211102 a skos:Concept ;
    skos:definition "Motorless heavier than air aircraft using air currents to soar from lower to higher altitudes and gravity to descend."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gliders"@en .

aat:300211105 a skos:Concept ;
    skos:definition "Metal spheres, weighing about 16 pounds, attached to a long handle of steel wire having a rigid grip at the other end; meant to be thrown for distance during a field event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammers"@en .

aat:300211106 a skos:Concept ;
    skos:definition "Puppets made of a hollow head secured to material that fits over the performer's hand concealing the thumb and fingers, which manipulate the puppets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand puppets"@en .

aat:300211107 a skos:Concept ;
    skos:definition "Sticks with a horse's head on one end, meant to be ridden by children; for riding toys consisting of animals mounted on rockers or springs, use \"rocking horses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hobbyhorses"@en .

aat:300211108 a skos:Concept ;
    skos:definition "Discs used in the game of ice hockey. Modern hockey pucks are black disks of vulcanized rubber with slightly beveled edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hockey pucks"@en .

aat:300211109 a skos:Concept ;
    skos:definition "Long flat pieces of wood with slightly curved heads at one end used as a striking implement in various hockey sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hockey sticks"@en .

aat:300211110 a skos:Concept ;
    skos:definition "Steel or wood bars, usually about 1 inch in diameter, held horizontally and suspended from 2 to 7 1/2 feet above the ground and used for various gymnastic exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizontal bars"@en .

aat:300211111 a skos:Concept ;
    skos:definition "Ladders fixed overhead in a horizontal position used for the development of arm and shoulder strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizontal ladders"@en .

aat:300211112 a skos:Concept ;
    skos:definition "Specially designed horseshoe-shaped objects made of various hard durable materials and used for the game of horseshoe pitching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horseshoes"@en .

aat:300211113 a skos:Concept ;
    skos:definition "In sports, portable, wooden or metal rectangular frames acting as barriers or fences, positioned in a way so that runners or other athletes must leap over them in certain track events. Similar devices are also used in competitions involving animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hurdles"@en .

aat:300211114 a skos:Concept ;
    skos:definition "Bottle-shaped, originally metal or wooden, clubs swung for arm exercise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian clubs"@en .

aat:300211115 a skos:Concept ;
    skos:definition "Toys consisting of boxes with hinged lids from which an enclosed figure springs out when a latch is released, as by turning a small crank on the outside of the box an appropriate number of revolutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jack-in-the-boxes"@en .

aat:300211116 a skos:Concept ;
    skos:definition "Refers to th small objects, often of metal and with six prongs, needed in the game of jacks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacks"@en .

aat:300211117 a skos:Concept ;
    skos:definition "Long, narrow, curved wicker baskets fitted to the end of a wooden handle with a glovelike compartment at the base used by players of jai alai to catch and throw the ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cestas"@en .

aat:300211118 a skos:Concept ;
    skos:definition "Jointed figures that can be made to jump, dance, or otherwise move by pulling a single string or stick attached to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jumping jacks"@en .

aat:300211119 a skos:Concept ;
    skos:definition "Toys that entertain the visual senses, as by demonstrating the theory of the persistance of vision or that operate using other principles of optics, projected images, or light as a fundamental feature; popular especially during the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical toys"@en .

aat:300211120 a skos:Concept ;
    skos:definition "Toys in which two or more mirrors at one end of a tube create, when rotated, ever-changing symmetrical patterns by reflecting bits of glass or metal contained within the tubes or other objects sighted outside the tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaleidoscopes"@en .

aat:300211122 a skos:Concept ;
    skos:definition "Long-handled wooden sticks with meshwork heads, generally 3 to 6 feet long and 7 to 12 inches wide across the head, for catching, carrying, and throwing balls during the game of lacrosse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses"@en .

aat:300211123 a skos:Concept ;
    skos:definition "One- or two-person low-slung sleds specially tailored to fit the rider, generally about 51 inches long and with a maximum weight of 44 pounds, and used to race down chutelike courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luges"@en .

aat:300211124 a skos:Concept ;
    skos:definition "Boxlike devices containing a lamp, reflectors to concentrate the light, and, usually, lenses to reduce or expand the light designed to project images painted on glass transparencies slowly drawn across the lens; first developed in the mid-17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magic lanterns"@en .

aat:300211125 a skos:Concept ;
    skos:definition "Little balls of various materials, such as glass, clay, agate, and porcelain, used in a variety of games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbles"@en .

aat:300211126 a skos:Concept ;
    skos:definition "Puppets manipulated from above by strings attached to their jointed limbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marionettes"@en .

aat:300211127 a skos:Concept ;
    skos:definition "Hand-held dolls or doll-like figures mounted on sticks with a covering, usually of cloth, concealing musical mechanisms underneath that play music when the sticks are twirled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marottes"@en .

aat:300211130 a skos:Concept ;
    skos:definition "Dolls with mechanical movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical dolls"@en .

aat:300211131 a skos:Concept ;
    skos:definition "Large, solid, heavy, leather-covered balls used for conditioning exercises, generally weighing 6 to 9 pounds, and measuring about 18 inches in diameter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine balls"@en .

aat:300211132 a skos:Concept ;
    skos:definition "Typefaces, in Latin or non-Latin characters, that exhibit some form of embellishment or decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornate"@en .

aat:300211170 a skos:Concept ;
    skos:definition "Animated peepshow machines based on the flip-book principle; popular from the 1890s until around 1910. These early motion picture devices, upright and typically coin-operated were designed for individual viewing. As the handle of the mutoscope is turned, photographs placed around a central hub inside the device flip to give the illusion of continuous motion. For the cylindrical slitted viewer, use zoetropes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutoscopes"@en .

aat:300211171 a skos:Concept ;
    skos:definition "Bowling pins similar to tenpins but used in the game of ninepins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ninepins"@en .

aat:300211172 a skos:Concept ;
    skos:definition "Typefaces that are within the large class of roman style typefaces and are the more upright, nonitalic characters. For the large class of roman typefaces, use \"roman (typeface style group).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roman"@en .

aat:300211178 a skos:Concept ;
    skos:definition "Use both for two-dimensional representations of human figures cut from paper or cardboard and for connected series of doll-like figures cut from folded paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper dolls"@en .

aat:300211179 a skos:Concept ;
    skos:definition "An apparatus consisting of two long, parallel wooden bars set on pairs of uprights adjustable in height and width and designed for vaulting, balancing, and swinging gymnastic exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel bars"@en .

aat:300211180 a skos:Concept ;
    skos:definition "Optical devices that give the illusion of depth and action when viewing two-dimensional images, by the use of one or more magnifying lenses or mirrors set in a boxlike enclosure and viewed through a small opening on one end. Usually used with special prints designed for the purpose, \"perspective view prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peepshows"@en .

aat:300211181 a skos:Concept ;
    skos:definition "Wooden tops with a wooden or metal peg at the bottom on which the top rotates; may be spun by hand or by pulling a wound string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peg tops"@en .

aat:300211182 a skos:Concept ;
    skos:definition "Toy blocks with separate pieces of a scene or image appearing on each side of the blocks and which then form complete pictures when assembled in the proper sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture blocks"@en .

aat:300211183 a skos:Concept ;
    skos:definition "Tablelike machines, usually with sloping glass tops and coin-operated, used to play the game of pinball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinball machines"@en .

aat:300211185 a skos:Concept ;
    skos:definition "Large group of typefaces based generally on 15th-century Italian letterforms, that is, using the Latin alphabet and neither black letter nor distinctly script forms. A roman typeface, in this sense, may include an accompanying italic face. For roman as the opposite of italic, use \"roman (upright typeface group).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roman"@en .

aat:300211186 a skos:Concept ;
    skos:definition "Long sticks with a pair of footrests about 1 foot from the bottom attached to a powerful spring at the bottom and used for standing on and leaping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pogo sticks"@en .

aat:300211187 a skos:Concept ;
    skos:definition "Optical toys that create moving images, consisting of a series of sequential drawings mounted on the inner wall of a revolving drum and facing the center where they are reflected by a many-sided drum containing a set of mirrors equal in number to the number of drawings and revolving in the opposite direction, the whole to be viewed through a special eyepiece; developed in the late 1870s as an improvement over zoetropes and phenakistoscopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "praxinoscopes"@en .

aat:300211195 a skos:Concept ;
    skos:definition "Loose covers for books, often of soft leather, having pockets into which the boards are inserted, used sometimes in the Middle Ages instead of binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemises"@en .

aat:300211196 a skos:Concept ;
    skos:definition "Group of typefaces, originating in France in 1698, characterized by such features as vertical emphasis, strong contrast between thin and thick strokes, and unbracketed serifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern"@en .

aat:300211202 a skos:Concept ;
    skos:definition "Group of typefaces, originating in the mid-18th century, characterized by such features as bracketed serifs, retained from old style, and the strong contrast of thin and thick strokes associated with modern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transitional"@en .

aat:300211203 a skos:Concept ;
    skos:definition "Toys designed to be pulled along the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pull toys"@en .

aat:300211206 a skos:Concept ;
    skos:definition "Large inflated or stuffed bags, usually of leather and suspended from a horizontal board, to be hit with fists to strengthen arm and shoulder muscles and practice specific boxing or martial arts moves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punching bags"@en .

aat:300211207 a skos:Concept ;
    skos:definition "Recreational artifacts designed as amusements or diversions by presenting constructional difficulties to be solved by ingenuity or patient effort. For word or number diversions to be solved, see under \"<word and number puzzles and games>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puzzles"@en .

aat:300211214 a skos:Concept ;
    skos:definition "Specially designed circular metal rings, usually with one surface rounded and the other surface flat, tossed in the game of quoits. Based on the ancient throwing weapom, \"cakras (weapons).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quoits"@en .

aat:300211216 a skos:Concept ;
    skos:definition "Toy horses or other animals mounted on rockers, gliders, or springs; for toys with a horse's head mounted at the end of a short stick for riding, use \"hobbyhorses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocking horses"@en .

aat:300211219 a skos:Concept ;
    skos:definition "Chess pieces designated to move as rooks may move during a chess game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rooks"@en .

aat:300211222 a skos:Concept ;
    skos:definition "Refers to the exercise apparatus consisting of a sliding seat, foot rests, and two oarlike handles attached to mechanisms whose resistance simulates that of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rowing machines"@en .

aat:300211225 a skos:Concept ;
    skos:definition "Receptacles for holding sand usually large enough for children to play in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandboxes"@en .

aat:300211227 a skos:Concept ;
    skos:definition "Toys with moving or mechanical parts set in motion as sand passes through them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand toys"@en .

aat:300211229 a skos:Concept ;
    skos:definition "Play apparatus consisting of a plank 10 to 14 feet long and supported and balanced in the middle upon which two children, one seated at each end, can ride up and down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seesaws"@en .

aat:300211230 a skos:Concept ;
    skos:definition "Flat puppets of leather or another material, often elaborately painted, originally developed in Java to cast shadows on white screens during dramatizations in shadow theater. They are often, but not always, animated with rods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shadow puppets"@en .

aat:300211232 a skos:Concept ;
    skos:definition "Heavy metal spheres propelled, or put, for distance in field competitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shots"@en .

aat:300211233 a skos:Concept ;
    skos:definition "Wooden or plastic disks, 6 inches in diameter and 1 inch thick, of various colors used in the game of shuffleboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shuffleboard disks"@en .

aat:300211235 a skos:Concept ;
    skos:definition "Cone-shaped objects, usually feathered and with rubber or cork tips, volleyed back and forth in badminton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shuttlecocks"@en .

aat:300211244 a skos:Concept ;
    skos:definition "Floor-supported gymnastic vaulting horses, for jumping across the width of the horse rather than the length. For the type with two graspable curved handles set a little distance apart along the top at right angles to the length, use the narrower term \"pommel horses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side horses"@en .

aat:300211245 a skos:Concept ;
    skos:definition "Oblong pieces of wood, plastic, or aluminum mounted on roller-skate wheels on which riders stand and propel themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skateboards"@en .

aat:300211246 a skos:Concept ;
    skos:definition "Smooth sloping boards or troughs down which children can slide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slides"@en .

aat:300211247 a skos:Concept ;
    skos:definition "Coin-operated gambling machines, activated by various mechanisms, usually a single lever or button, in which the final alignment of predesignated symbols determines the amount of payoff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slot machines"@en .

aat:300211249 a skos:Concept ;
    skos:definition "Batlike objects with long handles and oval or round heads containing tightly stretched netting for striking balls or shuttlecocks in various sports; for similar but smaller objects with solid heads for use in table tennis, use \"paddles (ball game equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rackets"@en .

aat:300211250 a skos:Concept ;
    skos:definition "Apparatus used for body strengthening and corrective exercises consisting of a series of normally wooden uprights about 8 feet high, secured to the wall at about 3-foot intervals, and joined by horizontal wooden bars set about 5 inches apart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stall bars"@en .

aat:300211251 a skos:Concept ;
    skos:definition "Long poles, usually in pairs with a foot rest, one for each foot per pole, enabling users to walk with their feet above the ground. Includes those used recreationally, as a means of reaching high things or crossing water, and as part of costume, as in African stilt masquerades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilts"@en .

aat:300211252 a skos:Concept ;
    skos:definition "Toys, most often animal representations or dolls, filled and covered with soft materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuffed toys"@en .

aat:300211253 a skos:Concept ;
    skos:definition "Long, wide buoyant boards, anywhere from 4 to 12 feet long and about 3 feet wide at the maximum point and usually having slight curves, especially in the front, used for riding surf. Originally constructed of wood, since the 1960s they have most often been made from synthetic foam covered in resin-coated fiberglass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surfboards"@en .

aat:300211254 a skos:Concept ;
    skos:definition "Any of various objects consisting usually of a seat or seats suspended from above, by ropes, chains, or poles, so as to swing freely, and designed for recreation, as those found in playgrounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swings"@en .

aat:300211256 a skos:Concept ;
    skos:definition "Nets or sheets of strong canvas supported by strings and tightly stretched across a metal frame mounted on legs, used as a springboard in gymnastics or acrobatics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trampolines"@en .

aat:300211257 a skos:Concept ;
    skos:definition "Apparatus consisting of a short horizontal bar attached to the ends of two suspended ropes and used in gymnastics and acrobatics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trapezes"@en .

aat:300211259 a skos:Concept ;
    skos:definition "Padded, somewhat cylindrical, floor-supported gymnastic apparatus resembling side horses but without the handles and used solely for vaulting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaulting horses"@en .

aat:300211262 a skos:Concept ;
    skos:definition "Toy guns that shoot streams of liquid, usually water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water pistols"@en .

aat:300211263 a skos:Concept ;
    skos:definition "Planks with the tip curled up that are generally wider and shorter than snow skis; worn on the feet and designed to plane over water when the wearer is towed at high speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water skis"@en .

aat:300211264 a skos:Concept ;
    skos:definition "Tops designed to be spun by slapping at them with whiplike objects, as opposed to tops meant to be spun by hand directly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whip tops"@en .

aat:300211265 a skos:Concept ;
    skos:definition "Any of various toys whose primary components spin or whirl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whirligigs"@en .

aat:300211266 a skos:Concept ;
    skos:definition "Spool-like toys consisting of two small thick disks connected at their centers by a short dowel around which a string is attached by which the yo-yos can be whirled; of ancient Far Eastern origin, popular in the West only from the 20th century on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yo-yos"@en .

aat:300211267 a skos:Concept ;
    skos:definition "Optical toys that create moving images, consisting of a revolving slitted drum with a paper band of successive images mounted within the drum and facing inward; developed in the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoetropes"@en .

aat:300211279 a skos:Concept ;
    skos:definition "Decorative items worn in, on, or about the ear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ear ornaments"@en .

aat:300211289 a skos:Concept ;
    skos:definition "Sports and athletic equipment used in conjunction with water sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water sports equipment"@en .

aat:300211294 a skos:Concept ;
    skos:definition "Cards made in sets of a designated number and marked for use as game accessories during play. The markings or designs may follow a standard suit or rank system or may be special and individualized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playing cards"@en .

aat:300211303 a skos:Concept ;
    skos:definition "Toy blocks capable of being stacked to make simple constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building blocks"@en .

aat:300211315 a skos:Concept ;
    skos:definition "Toys with or without interlocking pieces that are designed to be put together to create various structures or other forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction toys"@en .

aat:300211317 a skos:Concept ;
    skos:definition "Human figures or dolls created to illustrate or promote specific fashions in clothing, textiles, and hair styling; especially popular from the 16th to the 18th century in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion dolls"@en .

aat:300211320 a skos:Concept ;
    skos:definition "Black-faced grotesquely dressed male dolls with a shock of fuzzy hair, usually featuring pop eyes and a large red mouth; based on a character in children's books of the 1890s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golliwogs"@en .

aat:300211322 a skos:Concept ;
    skos:definition "Puzzles of irregularly shaped and tightly interlocking pieces of pasteboard or wood that when fitted together typically form pictures or designs; name derived in the 20th century from the type of saw used to create the intricate cutouts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jigsaw puzzles"@en .

aat:300211323 a skos:Concept ;
    skos:definition "Hopi, Pueblo, or Zuni dolls of various forms and materials that represent a dancer's ritual reenactment of a Kachina spirit, typically taking the form of animals, plants, objects, or persons; often given to children at the end of special ceremonies. Other tribes, such as the Navaho, produce kachina dolls as collectibles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kachina dolls"@en .

aat:300211324 a skos:Concept ;
    skos:definition "Very plump dolls with topknots based on a character in serialized magazine stories of the late 19th century and since around 1912 produced in numerous materials, most often in celluloid, bisque, or plaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kewpie dolls"@en .

aat:300211325 a skos:Concept ;
    skos:definition "Toys that have some mechanism or mechanical device as a primary design feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical toys"@en .

aat:300211327 a skos:Concept ;
    skos:definition "Dolls in the form of saleswomen hawking household items from their aprons or from tables and dressed in traditional working class costume; popular especially in England in the 18th century into the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedlar dolls"@en .

aat:300211329 a skos:Concept ;
    skos:definition "Recreation apparatus primarily designed for use by children in playgrounds or playgroundlike settings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playground equipment"@en .

aat:300211332 a skos:Concept ;
    skos:definition "Toys made of soft materials, such as stuffed animals, rag dolls, and rag books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft toys"@en .

aat:300211333 a skos:Concept ;
    skos:definition "Leather- or rubber-covered metal rings, about 7 to 10 inches in diameter, suspended from straps attached to the ceiling or portable frames so as to swing freely for use during gymnastic exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying rings"@en .

aat:300211334 a skos:Concept ;
    skos:definition "Stuffed toy bears, usually with a plush outer material, having an upright body and straight forearms; first appeared in 1903."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teddy bears"@en .

aat:300211340 a skos:Concept ;
    skos:definition "Small pendants, usually of gold but sometimes of leather, designed as containers for amulets; use especially for those of Etruscan origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullae"@en .

aat:300211360 a skos:Concept ;
    skos:definition "Jewelry for wear with current fashions usually made of inexpensive materials (metals, shells, plastic, wood) often set with imitation or semiprecious stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume jewelry"@en .

aat:300211392 a skos:Concept ;
    skos:definition "In bibliographic description, attached paper covers of books or pamphlets; originally temporary covers intended to be replaced by permanent bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrappers"@en .

aat:300211394 a skos:Concept ;
    skos:definition "Bindings having the centers of the boards stamped in relief, in imitation of antique gems or medals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cameo bindings"@en .

aat:300211403 a skos:Concept ;
    skos:definition "Bindings of a style originating in France in the late 17th century characterized by outside covers of austere plainness and elaborate doublures or inside covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jansenist style bindings"@en .

aat:300211412 a skos:Concept ;
    skos:definition "Bindings employed in the 15th and 16th centuries in France and Italy for Greek texts and translations from Greek, characterized by headbands projecting beyond the boards at the head and foot of the spine, thick wooden boards with grooved edges, and straps fastened to pins set in the grooves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek style bindings"@en .

aat:300211416 a skos:Concept ;
    skos:definition "Bindings of a style originating in Paris in the 16th century having a design of interlaced ribbons, defined by a double line on one side and a single one on the other, which divide the cover into symmetrical compartments that are sometimes filled with gold tooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanfare bindings"@en .

aat:300211424 a skos:Concept ;
    skos:definition "Especially strong and durable bindings on books intended to withstand heavy use; may be original or rebinding of a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library bindings"@en .

aat:300211428 a skos:Concept ;
    skos:definition "Bindings of the style associated with Jean Grolier generally characterized by geometric patterns and arabesques, sometimes colored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grolieresque bindings"@en .

aat:300211432 a skos:Concept ;
    skos:definition "The pieces used in the game of chess, in modern sets generally comprising kings, queens, bishops, knights, rooks, and pawns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chessmen"@en .

aat:300211436 a skos:Concept ;
    skos:definition "Bindings stamped with designs by means of relatively large engraved blocks or plates that require a mechanical press; popular in the 15th and 16th centuries and revived in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel stamp bindings"@en .

aat:300211456 a skos:Concept ;
    skos:definition "Balls thrown or batted in the game of the same name; usually 9 to 9 1/4 inches in circumference, weighing about 5 ounces, and consisting of a cork center wound round with twine and covered with white leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baseballs"@en .

aat:300211457 a skos:Concept ;
    skos:definition "Bindings in which the spine and the corners of the cover are of one material and the remainder of the sides of another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half bindings"@en .

aat:300211461 a skos:Concept ;
    skos:definition "Inflated spherical balls bounced or thrown in the game of the same name; generally about 30 inches in circumference and weighing 20 to 22 ounces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketballs"@en .

aat:300211465 a skos:Concept ;
    skos:definition "Bindings in which the spine is of a material different from that of the sides of the book cover and the spine material extends up to one-eighth of the width of the boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter bindings"@en .

aat:300211469 a skos:Concept ;
    skos:definition "Bindings that rely on adhesives to hold together the leaves of the volume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesive bindings"@en .

aat:300211472 a skos:Concept ;
    skos:definition "Adhesive bindings produced in the mid-19th century using a rubber solution to glue the leaves together. They ceased to be made years later when it was discovered that rubber turns brittle over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caoutchouc bindings"@en .

aat:300211475 a skos:Concept ;
    skos:definition "Bindings in which the back of a text block is trimmed to produce a block of separate leaves, an adhesive is applied to the area, and the cover is affixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfect bindings"@en .

aat:300211478 a skos:Concept ;
    skos:definition "Bindings in which the cover of the book is made completely before it is attached to the text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case bindings"@en .

aat:300211486 a skos:Concept ;
    skos:definition "Specially designed brooms used to sweep the ice in the game of curling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curling brooms"@en .

aat:300211487 a skos:Concept ;
    skos:definition "Bindings that hold pages together by such devices as spiral wire, plastic combs, or metal rods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical bindings"@en .

aat:300211489 a skos:Concept ;
    skos:definition "Combination umbrella and parasol for all weather, generally brightly colored but untrimmed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "en-tout-cases"@en .

aat:300211497 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living mainly in Burundi and Rwanda, including traditional crafts of weaving, pearl bead-making, and basketry. The Tutsi monarchy had rich traditions of dynastic poetry and courtly music. The Tutsi are an ethnic group of probable Nilotic origin who came into the area in the 14th or 15th century. They were nomadic herders and warriors who gradually dominated the resident Hutu through generally peaceful infiltration and the establishment of a feudal system headed by the Tutsi king and aristocracy, at the same time adopting the Hutu's Bantu languages. The European colonial period created tensions between the two groups that remain problematic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tutsi"@en .

aat:300211516 a skos:Concept ;
    skos:definition "Balls used in the game of American football, in the form of inflated prolate spheroids usually covered with leather having a laced seam where the edges of the cover meet; normally about 21 by 28 inches in circumference and weighing about 15 ounces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footballs"@en .

aat:300211517 a skos:Concept ;
    skos:definition "Inflated hard rubber balls, usually black, weighing 2.3 ounces and about 1 7/8 inches in diameter used during the game of handball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handballs"@en .

aat:300211525 a skos:Concept ;
    skos:definition "Decorative items worn inserted into a hole in or near the lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labrets"@en .

aat:300211528 a skos:Concept ;
    skos:definition "Popular name for small, delicate pendants which are suspended from a chain to form a necklace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavalieres"@en .

aat:300211532 a skos:Concept ;
    skos:definition "The balls used in the game of softball, generally in the form of spheres, softer and larger than baseballs and composed of a wound yarn core wrapped in kapok covered with smooth-seamed leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "softballs"@en .

aat:300211535 a skos:Concept ;
    skos:definition "Various articles of jewelry worn in memory of a deceased person during periods of mourning; especially such jewelry preserving hair of the deceased or bearing motifs such as a weeping willow, lyre, or broken column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning jewelry"@en .

aat:300211540 a skos:Concept ;
    skos:definition "Any of various objects marked in specific ways to be aimed at or hit in sporting events or contests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "targets"@en .

aat:300211543 a skos:Concept ;
    skos:definition "Long, narrow, flat-bottomed vehicles with upward and inward curving fronts used recreationally for coasting over snow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toboggans"@en .

aat:300211544 a skos:Concept ;
    skos:definition "Inflated, leather-covered, laceless balls used in the game of volleyball and generally 26 to 27 inches in circumference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volleyballs"@en .

aat:300211545 a skos:Concept ;
    skos:definition "Discontinuous, ring-shaped brooches with two terminals which are often flattened and highly decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penannular brooches"@en .

aat:300211548 a skos:Concept ;
    skos:definition "Fans without a leaf, comprised of flat, overlapping sticks which broaden towards the outer edge where they are secured, one to another, by a ribbon or cord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brisé fans"@en .

aat:300211554 a skos:Concept ;
    skos:definition "Fans which open to a circle or semicircle around a pivot set in the center rather than in the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockade fans"@en .

aat:300211556 a skos:Concept ;
    skos:definition "Plate-like usually rectangular brooches; may be ornamental or badges of honorary orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaques"@en .

aat:300211557 a skos:Concept ;
    skos:definition "Fans that do not fold or close, with a decorated area attached to a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed fans"@en .

aat:300211565 a skos:Concept ;
    skos:definition "Large circular boards, usually of cork and having numbered compartments, used as targets during the game of darts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dart boards"@en .

aat:300211567 a skos:Concept ;
    skos:definition "The inspissated, milky juice of various trees of the Sapodilla family native to the Malaysian peninsula. It is a tough, pliable, moldable rubber-like material, although it lacks the elasticity of rubber and becomes brittle on exposure to air and sunlight. Gutta-percha vulcanizes with sulfur into a hard, waterproof material. From the late 1840s, it was widely used for golf balls, imitation leather, joints in doll limbs, electrical insulation (especially underwater cables), and dental fillings. The name gutta-percha was sometimes used for any dark-colored molding material. It sets faster than \"caoutchouc,\" which must be heated far longer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gutta-percha"@en .

aat:300211569 a skos:Concept ;
    skos:definition "Parallel bars having the two bars set at different heights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uneven parallel bars"@en .

aat:300211572 a skos:Concept ;
    skos:definition "Glass decorated with coral-like sprays created with enamel and applied glass beads fused to the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coralene glass"@en .

aat:300211575 a skos:Concept ;
    skos:definition "A slender rod of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cane"@en .

aat:300211582 a skos:Concept ;
    skos:definition "Toy tops meant to be spun and not whipped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning tops"@en .

aat:300211584 a skos:Concept ;
    skos:definition "Finger rings that are engraved with a posy, a brief, sentimental expression. From the 17th century, often an engagement ring or wedding ring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posy rings"@en .

aat:300211595 a skos:Concept ;
    skos:definition "Toys that imitate the look and feel of weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy weapons"@en .

aat:300211598 a skos:Concept ;
    skos:definition "Toy guns in which pellets, often cork and attached to the gun by a string, are shot by compressed air, producing a loud pop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popguns"@en .

aat:300211604 a skos:Concept ;
    skos:definition "Clothing worn at night, especially garments worn to bed. For dress clothing intended to be worn to evening events, use \"evening wear.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nightwear"@en .

aat:300211628 a skos:Concept ;
    skos:definition "Jewelry or other decorative items worn in, on, or about the nose. Included are ornaments that cover larger portions of the face, but are attached at the nose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nose ornaments"@en .

aat:300211640 a skos:Concept ;
    skos:definition "Illustrated Biblical commentaries first produced in France in the 13th century, characterized by pairs of medallions containing depictions of the Biblical story and its moralization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bibles moralisées"@en .

aat:300211641 a skos:Concept ;
    skos:definition "Collections of homilies or sermons, which are discourses usually delivered from a pulpit, based upon a text of scripture, with the goal of giving religious instruction or exhortation. Homiliaries are often arranged according to the ecclesiastical year for reading at services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homiliaries"@en .

aat:300211648 a skos:Concept ;
    skos:definition "Toys, usually representing fat squatting figures, often clowns, that are rounded and weighted at the bottom so as to rock and right themselves when pushed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumblers"@en .

aat:300211649 a skos:Concept ;
    skos:definition "In the Roman Catholic Church, books of directions for all services throughout the year, without the actual texts. In the Church of England, service books for the consecration or ordination of clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordinals"@en .

aat:300211650 a skos:Concept ;
    skos:definition "Liturgical books containing the fixed musical chants of the mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kyriales"@en .

aat:300211651 a skos:Concept ;
    skos:definition "Inertial toys of skill consisting of a double-cone-shaped object and two sticks, one attached to each end of a length of string on which the double cone rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diabolos"@en .

aat:300211652 a skos:Concept ;
    skos:definition "Small pendants worn for luck or decoration, often in the shape of common objects, and sometimes affixed to bracelets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charms"@en .

aat:300211660 a skos:Concept ;
    skos:definition "Small seals or charms, intended to be worn from a watch chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breloques"@en .

aat:300211662 a skos:Concept ;
    skos:definition "Decorative items, similar in appearance to a brooch, but attached to a garment with a spring fastening. For jewelry made in a variety of forms fastened by a pin, uses \"brooches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clips"@en .

aat:300211667 a skos:Concept ;
    skos:definition "Small decorative or functional objects, typically attached to a chain or strap hanging from a pocket or within a purse, such as fobs for a watch or key. When decorative, they often serve as jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fobs"@en .

aat:300211673 a skos:Concept ;
    skos:definition "Set of books with directions to confessors in form of prayers, questions, and lists of sins with penance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penitentials"@en .

aat:300211674 a skos:Concept ;
    skos:definition "Optical toys consisting of disks with different images on each side which, when the disks are spun rapidly, tend to merge together as the strings on which the disks are mounted are pulled by the fingers; developed in the 1820s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thaumatropes"@en .

aat:300211675 a skos:Concept ;
    skos:definition "Books of responsories for religious service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "responsorials"@en .

aat:300211676 a skos:Concept ;
    skos:definition "Puzzles consisting usually of irregularly cut pieces of pasteboard or wood that when fitted together form complete pictures; historically, the images would not include maps nor would they purport to have an educational emphasis. For similar puzzles of maps, with an educational function, popular from the mid-18th to the early 19th century, use \"dissected maps.\" For puzzles with tightly interlocking pieces made with a jig or jigsaw, use \"jigsaw puzzles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture puzzles"@en .

aat:300211708 a skos:Concept ;
    skos:definition "Brief explanations, translations, comments, interpretations, or definitions of a word or passage, particularly those found in the margins of pages or between lines of text in a book or manuscript. Also used for any other explanation that serves the same function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glosses"@en .

aat:300211728 a skos:Concept ;
    skos:definition "A dense opaque glass of a red or black color made at the glassworks of Count von Buquoy in southern Bohemia in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyalith glass"@en .

aat:300211732 a skos:Concept ;
    skos:definition "Type of glass made from the inclusion of uranium in the batch and yellowish-green or greenish yellow in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uranium glass"@en .

aat:300211734 a skos:Concept ;
    skos:definition "Pressed glass made in the 1920s by automatic machines in factories in the American mid-west; it is thought to reflect the austerity of postwar life. Some patterns are reminiscent of 19th-century designs while others incorporate the sharp corners and precise lines of Art Deco styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depression glass"@en .

aat:300211737 a skos:Concept ;
    skos:definition "A type of art glass characterized by large air bubbles of various sizes combined with larger unsifted glass particles, and cased with heavier clear glass. Cluthra glassware is made from a lump of crystal glass on a blowing iron, which is rolled across a marver that had been sprinkled with powdered glass of any desired color. It was developed at Steuben Glass Works before 1930 as a variation on the very similar Clutha glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cluthra glass"@en .

aat:300211739 a skos:Concept ;
    skos:definition "Material derived from the horny covering that protects the end of the digits of certain animals such as horses or deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoof"@en .

aat:300211742 a skos:Concept ;
    skos:definition "Material derived from the bill of a bird or similar horny mouthpart in other animals, such as the squid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beak"@en .

aat:300211751 a skos:Concept ;
    skos:definition "Wind-up or battery-powered dolls that simulate walking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking dolls"@en .

aat:300211788 a skos:Concept ;
    skos:definition "Close-fitting dresses with a tight, straight skirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheath dresses"@en .

aat:300211799 a skos:Concept ;
    skos:definition "Windup toys using the mechanisms and workings of clocks to move all or parts of the toy; popular since the mid-19th century, especially in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clockwork toys"@en .

aat:300211802 a skos:Concept ;
    skos:definition "Iranian lutelike chordophones having a small pear-shaped body, long neck with movable frets and three or four metal strings. Originating from the 15th century or earlier, it had three strings until the mid-19th century, when a fourth was added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setars"@en .

aat:300211806 a skos:Concept ;
    skos:definition "Hebrew prayer books containing the Jewish liturgy for festivals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahzorim"@en .

aat:300211807 a skos:Concept ;
    skos:definition "Jewish prayer books containing both Hebrew and Aramaic prayers used chiefly in the daily liturgy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siddurim"@en .

aat:300211809 a skos:Concept ;
    skos:definition "Rabbinic homiletic commentary on a text from the Hebrew scriptures, characterized by non-literal interpretation and legendary illustration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "midrash"@en .

aat:300211825 a skos:Concept ;
    skos:definition "Small printed works consisting of one small-sized leaf of paper folded and not stitched or bound, containing printed matter, chiefly for gratuitous distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaflets"@en .

aat:300211840 a skos:Concept ;
    skos:definition "Toys designed to be ridden upon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding toys"@en .

aat:300211842 a skos:Concept ;
    skos:definition "Vehiclelike toys with pedals akin to bicycles; appeared in simple form in the late 19th century and by the early 20th century sometimes had more eleborate carlike accessories and actual working components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedal cars"@en .

aat:300211849 a skos:Concept ;
    skos:definition "Signs giving directions, warnings, or other information pertinent for vehicles or pedestrians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic signs"@en .

aat:300211851 a skos:Concept ;
    skos:definition "Signs that call attention to conditions that are potentially hazardous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warning signs"@en .

aat:300211856 a skos:Concept ;
    skos:definition "Signs that are intended to regulate behavior, displaying such information as prohibitions or rules of order or conduct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regulatory signs"@en .

aat:300211858 a skos:Concept ;
    skos:definition "Signs, emblems, designs, or motifs that guide users to destinations, or indicate way finding to a viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direction signs"@en .

aat:300211861 a skos:Concept ;
    skos:definition "Signs that confirm destinations; for smaller, less public identifying notices, use \"labels (identifying artifacts).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identification signs"@en .

aat:300211862 a skos:Concept ;
    skos:definition "Use broadly for signs identifying places of business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shop signs"@en .

aat:300211902 a skos:Concept ;
    skos:definition "Decorative ornaments worn on the breast; includes those sewn or pinned onto garments as well as those suspended by cords, beads, or the like, from the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pectorals"@en .

aat:300211910 a skos:Concept ;
    skos:definition "Pectoral medallions, suspended from the neck, bearing a sacred picture; worn by bishops of the Orthodox Eastern Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enkolpia"@en .

aat:300211922 a skos:Concept ;
    skos:definition "Serving vessels in which sauces are kept warm by hot water, or sometimes embers, contained in an internal chamber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "argyles"@en .

aat:300211926 a skos:Concept ;
    skos:definition "Term generally applied to a wide variety of baskets used for gathering or transporting food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gathering baskets"@en .

aat:300211954 a skos:Concept ;
    skos:definition "Deep, open baskets of varying form intended primarily for gathering or transporting eggs; used especially with reference to those with rib-type construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg baskets"@en .

aat:300211957 a skos:Concept ;
    skos:definition "A soft coal, usually dark brown, often having a distinct woodlike texture, and intermediate in density and carbon content between peat and bituminous coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lignite"@en .

aat:300211978 a skos:Concept ;
    skos:definition "Covered baskets, often with a hinged lid and two folding handles, intended primarily for carrying food and dining paraphernalia to a picnic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picnic baskets"@en .

aat:300211999 a skos:Concept ;
    skos:definition "Spheres surmounted by crosses, symbolizing kingly power and justice, sometimes held in the hand as part of regalia, or placed as an ornament on top of a scepter or crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orbs"@en .

aat:300212023 a skos:Concept ;
    skos:definition "Musical instruments specifically used for practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "practice instruments"@en .

aat:300212026 a skos:Concept ;
    skos:definition "Plucked harp lutes of the Manding linguistic and cultural family of Africa, having a long neck passing diametrically through a large gourd resonator covered with leather, 21 leather or nylon strings arranged in two parallel ranks perpendicular to the resonator on either side of a vertical notched bridge, and two handles, one on the outer side of each rank of strings. They are played only by male professional musicians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koras"@en .

aat:300212027 a skos:Concept ;
    skos:definition "Burmese arched harps, traditionally associated with the Buddhist royal dynasties, with a boat-shaped resonator covered with skin and lacquered, an arch made of a curved tree root, and 14 silk or nylon strings. They are held horizontally in the lap with the arch at the player's left when played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saùng-gauk"@en .

aat:300212029 a skos:Concept ;
    skos:definition "Wide, close-fitting necklaces worn tightly around the neck, often ornamented with precious or semiprecious stones. For short, narrow necklaces worn close to the throat use \"chokers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog collars"@en .

aat:300212030 a skos:Concept ;
    skos:definition "Mouth organs of Japan, descended from the Chinese \"sheng\", having a lacquered wood bowl for a windchest, a short mouthpiece, and 17 bamboo pipes arranged in a circle in symmetrical order, two of which are silent, with neither reed nor fingerhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sho"@en .

aat:300212031 a skos:Concept ;
    skos:definition "Mouth organs of China having a bowl-shaped windchest of wood or metal with a short blowpipe extending out from the side, and bamboo pipes of varying lengths, usually 17 in number, arranged in an incomplete circle and mounted through holes in the top of the windchest. A free-beating reed of copper or an alloy is attached at the bottom of each pipe within the windchest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheng"@en .

aat:300212032 a skos:Concept ;
    skos:definition "Motuh organs of Laos and Thailand, consisting of a set of bamboo pipes grouped in two rows and graduated from longest to shortest, held together by a windchest they pierce through. The reeds of copper or silver are mounted in the pipe walls within the windchest, and the fingerholes are cut in the pipes within fingers' reach above the windchest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khaen"@en .

aat:300212033 a skos:Concept ;
    skos:definition "Small floor-standing reed organs invented in England in the early 1830s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seraphines"@en .

aat:300212034 a skos:Concept ;
    skos:definition "Vertical rim-blown flutes of the Middle East, Iran, and Central Asia, originally made of reed, usually having from five to seven fingerholes and one thumbhole. Materials, length, and number of fingerholes vary from one region to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nays"@en .

aat:300212038 a skos:Concept ;
    skos:definition "Finger rings made in memory of a deceased person, often distributed at funerals, generally gold with black or of blue or white enamel, bearing the name of the deceased and birth and death dates, sometimes incorporating a lock of hair, portraits, or sentimental scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning rings"@en .

aat:300212062 a skos:Concept ;
    skos:definition "Clasps, often richly ornamented, used for various purposes. They are often in the form of a hook sewn to one side of a garment or armor, to be attached to a loop or ring sewn on the other side. Also, an agrafe may be a pin or badge worn -- often on a hat -- in recognition of a pilgrimage to a sacred site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agrafes"@en .

aat:300212066 a skos:Concept ;
    skos:definition "Archaeological term for bracelets or armlets, especially those worn by royalty and sometimes as part of the coronation regalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armillae"@en .

aat:300212078 a skos:Concept ;
    skos:definition "Wreaths or garlands worn on the head, especially those of metal, often embellished with gems or pearls, common from the 14th to the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaplets"@en .

aat:300212083 a skos:Concept ;
    skos:definition "Earrings with clip fasteners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ear clips"@en .

aat:300212084 a skos:Concept ;
    skos:definition "Toys consisting of a stick with a cuplike top and a ball attached to the stick by a string long enough for the ball to swing freely and be swung up and caught in the cup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup-and-ball toys"@en .

aat:300212092 a skos:Concept ;
    skos:definition "Rings in the form of a circular band set with a continuous row of gemstones, usually diamonds, of the same size and cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eternity rings"@en .

aat:300212101 a skos:Concept ;
    skos:definition "Finger rings that are composed of two, or sometimes three, separate hoops linked together, having the shank split lengthwise so that the hoops can be fitted together unnoticeably as one hoop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gimmel rings"@en .

aat:300212107 a skos:Concept ;
    skos:definition "Narrow straps, laces, or the like, used to fasten a shoe or sandal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latchets"@en .

aat:300212115 a skos:Concept ;
    skos:definition "Long neck chains worn loosely from the shoulders and usually extending below the waist. May have a pendant or tassel suspended at the bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sautoirs"@en .

aat:300212116 a skos:Concept ;
    skos:definition "Ornamental metal clasps that secure by tension the two ends of a necktie to a shirt front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie clasps"@en .

aat:300212145 a skos:Concept ;
    skos:definition "Artifacts in card form that contain information about, or related to, the cardholders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identifying cards"@en .

aat:300212147 a skos:Concept ;
    skos:definition "Artifacts that represent a person's position or condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symbols of office"@en .

aat:300212148 a skos:Concept ;
    skos:definition "Staffs, clubs, or truncheons carried as symbols of office or authority or used as weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batons"@en .

aat:300212149 a skos:Concept ;
    skos:definition "Staffs resembling shepherds' crooks borne by bishops, abbots, or abbesses, as symbols of the pastoral office. There were three early forms: The first was a rod of wood bent or crooked at the top and pointed at the lower end. This is the oldest form and was known as the pedum. The second had, instead of the crook, a knob which was often surmounted by a cross, and was called the ferula or cambuta. It was sometimes borne by popes. In the third form the top consisted of a crux decussata, or Greek T (tau), the arms of the cross being often so twisted as to represent two serpents opposed. The original material of the crosier was generally cypress-wood, often cased or inlaid with gold or silver. Later on the staffs were made of solid ivory, gold, silver, and enameled metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosiers"@en .

aat:300212151 a skos:Concept ;
    skos:definition "Cards distributed by merchants or manufacturers to advertise or promote their business or product; their use may have been as \"premiums.\" For small printed sheets or cards bearing tradesmen's advertisements from the 17th through the 19th century, use \"trade cards.\" For cards made later, bearing the name and address of a business concern and the name of its representative, and intended more for information than for advertising, use \"business cards.\" For cards made later and issued primarily to be collected, with or without advertisements on them, use \"collecting cards.\" For cards intended to be posted as public advertisements, use \"posters\" or its narrower terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising cards"@en .

aat:300212157 a skos:Concept ;
    skos:definition "Zitherlike chordophones having a long rectangular soundboard or tube resonator with a slightly arched surface and usually, though not always, movable bridges, played by plucking with the fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long zithers"@en .

aat:300212162 a skos:Concept ;
    skos:definition "Chinese long zithers having a rectangular soundboard with a convex surface and, usually, 25 strings, traditionally of silk, each of which is supported by a movable triangular bridge which functions as a fine tuning device, each positioned relative to adjoining bridges in a diagonal row across the soundboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "se"@en .

aat:300212165 a skos:Concept ;
    skos:definition "Chinese long zithers of great antiquity, consisting of a slightly convex, shallow, lacquered box over the length of which are stretched seven silk strings of equal length, each twisted from a different, fixed number of threads. Thirteen discs of ivory or mother-of-pearl are inlaid along one edge to indicate the string divisions. They are traditionally the most honored of Chinese musical instruments, having strong associations with court and Confucian ritual, philosophy, and scholarship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qin"@en .

aat:300212167 a skos:Concept ;
    skos:definition "Narrow Chinese long zithers with from 12 to 16 strings of silk or metal, each supported by a movable bridge that functions as a device for fine tuning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zheng"@en .

aat:300212168 a skos:Concept ;
    skos:definition "Korean long zithers with twelve strings of twisted silk, each supported by its own high, movable bridge. They are made in two basic sizes, the larger for court and aristocratic music, which has two fixed bridges in addition to the movable ones, and the smaller for folk and virtuosic music, having one fixed bridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kayagum"@en .

aat:300212170 a skos:Concept ;
    skos:definition "Flemish virginals having their keyboard placed off-center to the right; consequently the strings are centrally plucked for most of the instruments' range, giving them a distinctive flutelike tone unlike that of any other type of virginal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muselars"@en .

aat:300212174 a skos:Concept ;
    skos:definition "A white crystalline powder occurring naturally chiefly as the minerals calcite and aragonite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium carbonate"@en .

aat:300212176 a skos:Concept ;
    skos:definition "Glass to which cobalt oxide has been added in order to produce a very strong blue color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt glass"@en .

aat:300212179 a skos:Concept ;
    skos:definition "Concert pitch, nontransposing aerophones of conical bore, constructed in circular shape with three piston valves and the bell directed either upward or forward, usually played at 9 foot C pitch; invented around 1870 by one of the English Distin family, and intended for use by amateurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballad horns"@en .

aat:300212181 a skos:Concept ;
    skos:definition "18th-century small violas having five strings and played on the arm, in use from about 1725 to about 1770."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violas pomposa"@en .

aat:300212182 a skos:Concept ;
    skos:definition "Tempered steel instruments consisting of a stem with two prongs, producing a musical tone of definite constant pitch when struck and serving as a standard as when tuning musical instruments and performing acoustical experiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuning forks"@en .

aat:300212187 a skos:Concept ;
    skos:definition "Toys designed to be pushed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pushalong toys"@en .

aat:300212188 a skos:Concept ;
    skos:definition "General term for mineral inflammable substances that are native hydrocarbons, more or less oxygenated, that have been altered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modified bituminous material"@en .

aat:300212193 a skos:Concept ;
    skos:definition "Psalteries of the Near East, Turkey, North Africa, and parts of Asia and southeastern Europe, with from 50 to 100 strings of gut, metal, or nylon strung in courses of three over a shallow trapezoidal box, the belly of which is partially covered with animal skin. Some contemporary models have small brass levers controlling string tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qanuns"@en .

aat:300212195 a skos:Concept ;
    skos:definition "Hand-operated figures used by ventriloquists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ventriloquial figures"@en .

aat:300212198 a skos:Concept ;
    skos:definition "General term for natural, mineral inflammable substances that are native hydrocarbons, more or less oxygenated, and which have not been modified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural bituminous material"@en .

aat:300212205 a skos:Concept ;
    skos:definition "Books popular in the 18th and 19th centuries, originally often depicting harlequins, in which folded parts of pages are lifted to reveal new pictures, fitted neatly onto the remaining parts of the previous pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harlequinades"@en .

aat:300212209 a skos:Concept ;
    skos:definition "Pendants in the form of discs of thin, beaten gold or silver with stamped decoration based on Roman coin or medallion prototypes or with runic inscriptions. Suspended by means of a circular attachment and intended to be worn on a thong or other support around the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracteates"@en .

aat:300212249 a skos:Concept ;
    skos:definition "Dulcimers of Turkey, Iraq, Iran, the Caucasus, southeastern Europe, and South Asia, varying regionally but generally consisting of a trapezoidal hardwood box with the metal or nylon strings arranged in courses of three, four, or even five, passing over individual bridges and attached to the side of the box by tuning pegs. They are struck with two sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "santurs"@en .

aat:300212250 a skos:Concept ;
    skos:definition "Chinese dulcimers introduced there from the West, having a trapezoidal body, two sound holes, two bridges, and from 14 to 20 courses of two, three, or four strings, played with two springy bamboo hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yangqin"@en .

aat:300212266 a skos:Concept ;
    skos:definition "Use specifically for those signs consisting of symbols designed on the basis of the U.S. Department of Transportation system of regulatory, warning, and informational signs, for example a symbol of prohibited activity inside a red ring crossed by a red slash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symbol signs"@en .

aat:300212274 a skos:Concept ;
    skos:definition "Folded printed sheets, such as circulars or schedules, having printed matter that generally does not cross the folds. For sheets printed to be read unfolded, use \"broadsides.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folders"@en .

aat:300212279 a skos:Concept ;
    skos:definition "Grand pianos having a harp contour and open strings strung vertically from just below keyboard level up to the curving harplike neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harp pianos"@en .

aat:300212285 a skos:Concept ;
    skos:definition "Books containing the rites of the Latin church for the administration of the sacraments by parish priests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rituals"@en .

aat:300212298 a skos:Concept ;
    skos:definition "General term for a form of outerwear of differing lengths and having some shaping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantles"@en .

aat:300212299 a skos:Concept ;
    skos:definition "Double-breasted overcoats of a type originally worn by British army officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British warms"@en .

aat:300212300 a skos:Concept ;
    skos:definition "Xylophones of the Manding people of West Africa, having wood keys thinned on the ends and undersides for tuning and with a gourd resonator beneath each; they are played exclusively by male professional musicians, using a rubber-tipped hammer in each hand and often with bells strapped to their wrists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balos"@en .

aat:300212302 a skos:Concept ;
    skos:definition "High-pitched xylophones of Thailand and Cambodia with a range of three octaves, consisting of a boat-shaped trough resonator mounted on a pedestal, with usually 21 bars of bamboo or hardwood strung on cords suspended on hooks set into the end-boards of the resonator. Tuning paste is applied to the underside of the bars and they are struck with two beaters. For the Thai and Cambodian metallophones of the same range and tuning, use \"ranat ek lek.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranat ek"@en .

aat:300212304 a skos:Concept ;
    skos:definition "Women's hooded cloaks, usually three-quarters to full length, originally made in scarlet wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardinals"@en .

aat:300212305 a skos:Concept ;
    skos:definition "In brass instruments, U-shaped segments of cylindrical tubing fitted over two straight segments of tubing in such a way as to be able to slide easily in and out, thus changing the instrument's effective total length, and with it, its fundamental pitch during play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slides"@en .

aat:300212324 a skos:Concept ;
    skos:definition "Instruments for practicing violin playing, consisting of four strings stretched across a curved board with a normal violin fingerboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mute violins"@en .

aat:300212329 a skos:Concept ;
    skos:definition "Asphalt that has been mixed with additional materials, often non-natural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modified asphalt"@en .

aat:300212339 a skos:Concept ;
    skos:definition "Chess pieces that move as bishops are designated to move."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bishops"@en .

aat:300212340 a skos:Concept ;
    skos:definition "Women's hooded cloaks that resemble the habit of a Capuchin friar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capuchins"@en .

aat:300212342 a skos:Concept ;
    skos:definition "Chief game pieces of chess sets, the protection of which is the object of the game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kings"@en .

aat:300212345 a skos:Concept ;
    skos:definition "Chess pieces, in sets of eight of one color, moving as pawns are designated to move."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pawns"@en .

aat:300212348 a skos:Concept ;
    skos:definition "Optical toys that create moving images, consisting of a slotted disk featuring a series of images that appear to move when the disk is spun and viewed through the slots before a mirror. Its invention is attributed to Joseph Plateau in 1833. Distinct from \"stroboscopes,\" similar devices that employ two disks in place of the mirror."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phenakistoscopes"@en .

aat:300212349 a skos:Concept ;
    skos:definition "Chess pieces that move as queens are designated to move; the most powerful of chess pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "queens"@en .

aat:300212350 a skos:Concept ;
    skos:definition "Single- or double-breasted fly-front coats usually of dark plain woolen fabric and often having a velvet collar. Of a type first worn by men in the 18th century and adapted for women during the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chesterfields"@en .

aat:300212353 a skos:Concept ;
    skos:definition "Pins used in the game of skittles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skittles"@en .

aat:300212355 a skos:Concept ;
    skos:definition "Mechanical toys operated by springs or similar mechanisms that must be wound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "windup toys"@en .

aat:300212377 a skos:Concept ;
    skos:definition "A natural, solid, hydrocarbon substance, distinguishable from bitumen by being infusible and insoluble. When heated, however, pyrobitumens generate or transform into bitumen-like liquid or gaseous petroleum compounds. This class of natural bituminous material includes peat, lignite, and coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrobitumen"@en .

aat:300212378 a skos:Concept ;
    skos:definition "Any one of the naturally occurring black solid bitumens that are soluble in carbon disulphide and fuse above 230 degrees Fahrenheit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphaltite"@en .

aat:300212393 a skos:Concept ;
    skos:definition "Identifying garments or styles of dress worn by the members of a given profession, organization, or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uniforms"@en .

aat:300212480 a skos:Concept ;
    skos:definition "Mechanisms by means of which the strings or pipes of a keyboard instrument are sounded when a key is depressed, or, in harps, that alter the pitch of strings when a pedal is depressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actions"@en .

aat:300212494 a skos:Concept ;
    skos:definition "Vehicles that move along channels, tracks, or grooves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guideway vehicles"@en .

aat:300212499 a skos:Concept ;
    skos:definition "Generally refers to various types of main garments for the upper body, made with or without sleeves and worn over or tucked in the waistband of a skirt, trousers, or the like. Usually having a collar, which may be detachable, often a front opening, and sometimes pockets. Specifically often refers to an article of male attire with long sleeves terminating in wristbands or cuffs. It originally referred to undergarments for the upper part of the body, made of linen, calico, flannel, silk, or other washable material; originally always worn next to the skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirts"@en .

aat:300212502 a skos:Concept ;
    skos:definition "Resonators in keyboard string instruments, consisting of thin boards of wood or other material over which the strings are stretched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soundboards"@en .

aat:300212504 a skos:Concept ;
    skos:definition "Leather bifurcated garments, with either short or long legs, usually held up with suspenders; traditionally worn in Bavaria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lederhosen"@en .

aat:300212505 a skos:Concept ;
    skos:definition "Covered containers of varying form intended primarily for storing cookies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cookie jars"@en .

aat:300212525 a skos:Concept ;
    skos:definition "Large bass-range chordophones of the violin family, made in 19th-century New England primarily for accompanying church choirs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church basses"@en .

aat:300212527 a skos:Concept ;
    skos:definition "Vehicles that navigate through the air, either supported for flight by buoyancy or by the dynamic action of the air on their surfaces; usually designed to accommodate one or more persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft"@en .

aat:300212528 a skos:Concept ;
    skos:definition "Manned or unmanned vehicles designed to be placed in orbit about the earth or into a trajectory toward another celestial body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spacecraft"@en .

aat:300212548 a skos:Concept ;
    skos:definition "Collectively used for groups of rail vehicles, usually under a single ownership or operating entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling stock"@en .

aat:300212558 a skos:Concept ;
    skos:definition "A type of paste prepared by boiling rice starch in water, the resulting paste is white in color and dries to a film that is almost transparent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice starch paste"@en .

aat:300212564 a skos:Concept ;
    skos:definition "Adhesive made from flour containing 70% starch and 12% gluten. It is clear, and reversible with water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheat starch paste"@en .

aat:300212570 a skos:Concept ;
    skos:definition "Costume accessories specifically worn on the hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handwear"@en .

aat:300212571 a skos:Concept ;
    skos:definition "Adhesive that is thermoplastic, heated and applied in the molten state and forming a bond on cooling to a solid state. Used in many applications, including among the arts and crafts communities, for which it is usually available in the form of cylindrical sticks that fit into electronic glue guns for application. Distinguished from \"heat-seal adhesive\" which is already present in a thin layer on the adherends prior to the application of heat and pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-melt adhesive"@en .

aat:300212574 a skos:Concept ;
    skos:definition "A compound comprised of a metal attached directly to a carbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organometallic compound"@en .

aat:300212606 a skos:Concept ;
    skos:definition "Vessels built and armed for combat purposes"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warships"@en .

aat:300212607 a skos:Concept ;
    skos:definition "Vessels capable of continuous, extended underwater voyages under their own power without surfacing; often naval combatant vessels. For vessels capable of complete submersion for only limited amounts of time and which may or may not move under their own power, use \"submersibles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submarines"@en .

aat:300212608 a skos:Concept ;
    skos:definition "Warships acting as floating mobile air stations with facilities for the takeoff, landing, and servicing of aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft carriers"@en .

aat:300212609 a skos:Concept ;
    skos:definition "Fast moderately sized warships designed to provide fleet reconnaissance and protection, able to roam independently in search of enemy craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruisers"@en .

aat:300212610 a skos:Concept ;
    skos:definition "Light, fast warships designed to operate offensively as attack craft with antisubmarine weapons; originally developed at the end of the 19th century to counter torpedo boats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "destroyers"@en .

aat:300212611 a skos:Concept ;
    skos:definition "Use both for naval ships of the late 18th and early 19th centuries generally fully rigged on three masts and armed with guns on one or two decks and designed for various battle functions, and for a contemporary class of small, medium-speed warships designed primarily for escort duty and having antiair, antiship, and antisubmarine capabilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frigates"@en .

aat:300212612 a skos:Concept ;
    skos:definition "Structural components and external coverings of aircraft and missiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airframes"@en .

aat:300212614 a skos:Concept ;
    skos:definition "Parts or components of watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watercraft components"@en .

aat:300212618 a skos:Concept ;
    skos:definition "Emergency land vehicles designed and equipped for conveying the sick or injured to medical facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambulances"@en .

aat:300212625 a skos:Concept ;
    skos:definition "Land vehicles with armorplated bodies and extra strong doors, locks, and windows, such as trucks for carrying money and valuables or automobiles specially designed for dignitaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armored cars"@en .

aat:300212630 a skos:Concept ;
    skos:definition "Any of various wheeled vehicles designed primarily for carrying infants; may be pushed or pulled and are often wagonlike or carriagelike in appearance. For vehicles designed primarily for pushing small children sitting upright, prefer \"strollers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby carriages"@en .

aat:300212631 a skos:Concept ;
    skos:definition "Watercraft, usually highly decorated and propelled by oars or paddles, used for transporting important persons, either alive or dead, on state occasions or for ceremonial visits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barges"@en .

aat:300212632 a skos:Concept ;
    skos:definition "Vessels capable of complete submersion for a limited time; may or may not be able to move under their own power. For vessels capable of continuous, extended underwater voyages under their own power, use \"submarines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submersibles"@en .

aat:300212634 a skos:Concept ;
    skos:definition "Relatively small, navigable submersibles designed for exploring ocean depths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathyscaphes"@en .

aat:300212635 a skos:Concept ;
    skos:definition "Coaches hung on berlin undercarriages, employing two light perches instead of a single heavy one to connect the front transom with the rear axle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berlin coaches"@en .

aat:300212636 a skos:Concept ;
    skos:definition "Vehicles with two wheels in tandem propelled by the rider straddling a frame which holds the wheels and handlebars for steering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicycles"@en .

aat:300212639 a skos:Concept ;
    skos:definition "Nonrigid airships having several balloonlike compartments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blimps"@en .

aat:300212642 a skos:Concept ;
    skos:definition "Light four-wheeled carriages with simple bodies set on long elastic planks, instead of springs, attached to the axles and with seats mounted directly on the floorboards near their center; developed in the United States in the early 19th century; later modified versions may have springs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckboards"@en .

aat:300212646 a skos:Concept ;
    skos:definition "A moist, usually heated mass of a substance with a soft, absorbent, or pasty consistency, applied to the skin of a person or animal, or to another surface for the purpose of cleaning, drawing out abscesses, increasing circulation, or relieving swelling or pain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poultice"@en .

aat:300212647 a skos:Concept ;
    skos:definition "One of a group of complex organic substances formed in the living cells of plants and animals; it is a necessary catalyst for the chemical reactions of biological processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enzyme"@en .

aat:300212659 a skos:Concept ;
    skos:definition "Groups of armed fighting men who fight or maneuver on horseback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavalries"@en .

aat:300212666 a skos:Concept ;
    skos:definition "Groups of soldiers armed, trained, and equipped to fight on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infantries"@en .

aat:300212667 a skos:Concept ;
    skos:definition "Double-ended, log-bottom boats or later flat-bottom, shallow-draft boats of similar shape, but built plank-on-frame, with two masts raking aft carrying a jib and triangular sails; used for offshore fishing and general cargo transport in the Chesapeake Bay area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bugeyes"@en .

aat:300212672 a skos:Concept ;
    skos:definition "Light, simply constructed, four-wheeled carriages with or without collapsible tops and usually accommodating only one or two passengers; developed in England in the late 18th century; may also be used for early automobile designs with similar body styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buggies"@en .

aat:300212677 a skos:Concept ;
    skos:definition "Refers to large, motorized, public street vehicles for large numbers of persons, generally having long bodies and equipped with benches or seats for passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buses"@en .

aat:300212678 a skos:Concept ;
    skos:definition "Plucked lutelike chordophones of Japan having three strings of nylon or silk, a long unfretted neck, a bridge, and a small square soundbox covered with cat or dog skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shamisen"@en .

aat:300212686 a skos:Concept ;
    skos:definition "European two-wheeled carriages pulled by a single horse and having bodies resembling nautilus shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabriolets"@en .

aat:300212687 a skos:Concept ;
    skos:definition "Watercraft designed for use on canals generally long and narrow with bow and stern often nearly vertical for increased cargo capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canal boats"@en .

aat:300212688 a skos:Concept ;
    skos:definition "Lightly built, slender, open craft of shallow draft that are paddled and not rowed and normally double-ended; may have sails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canoes"@en .

aat:300212694 a skos:Concept ;
    skos:definition "Watercraft designed primarily to transport cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cargo vessels"@en .

aat:300212695 a skos:Concept ;
    skos:definition "Strong vehicles, having two or sometimes three wheels and without springs. Usually animal-drawn and built for utility purposes, used in farming operations, and for carrying heavy goods. Some varieties were designed as sporting vehicles or for personal transportation. For utility vehicles having four wheels, use \"wagons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carts"@en .

aat:300212696 a skos:Concept ;
    skos:definition "Refers to watercraft, usually sailing vessels, with two hulls of equal size held apart above the water deck by rigid structural members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catamarans"@en .

aat:300212699 a skos:Concept ;
    skos:definition "Ancient Mesopotamian, Egyptian, Greek, and Roman animal-drawn, wheeled vehicles with a wide range of uses and forms, usually driven from the standing position and most often with two wheels; probably developed in Mesopotamia around the early 3rd millenium and could be pulled by up to ten animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chariots"@en .

aat:300212700 a skos:Concept ;
    skos:definition "Artificial orbiting vehicles designed to reflect or relay electromagnetic signals among communications stations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communications satellites"@en .

aat:300212701 a skos:Concept ;
    skos:definition "Large, covered freight wagons distinguished by their curving boat-shaped profile with flaring endgates and side panels of planking with a series of short uprights; usually pulled by six horses and used between the mid-18th and mid-19th century in the areas of Ohio, Virginia, Maryland, and Pennsylvania. For similar wagons but characterized by mostly straight lines and linen tops and used across the western prairies and plains to carry freight and emigrants, use \"prairie schooners.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Conestoga wagons"@en .

aat:300212707 a skos:Concept ;
    skos:definition "A wide variety of lateen-rigged watercraft used for trading along the East African, Arabian, and Indian coasts; generally having long raking bows and fuller sterns. This is a European term derived from the Swahili and is not used by most of the people who sail such vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhows"@en .

aat:300212708 a skos:Concept ;
    skos:definition "Small open boats carried on or towed by larger watercraft as lifeboats, tenders, or workboats; may be rowed, sailed, or driven by outboard motors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinghies"@en .

aat:300212715 a skos:Concept ;
    skos:definition "Runnered vehicles pulled by dogs, especially those used by various Arctic peoples. For similar runnered vehicles operated by hand or by gravity, use \"sleds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogsleds"@en .

aat:300212716 a skos:Concept ;
    skos:definition "Relatively small simple boats with flat, rockered, keel-less bottoms, high bows, and flaring clinker or plywood sides, widely used by fishermen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dories"@en .

aat:300212729 a skos:Concept ;
    skos:definition "Specialized road vehicles designed with apparatus for emergency situations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency vehicles"@en .

aat:300212730 a skos:Concept ;
    skos:definition "Passenger vessels operated for excursions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excursion boats"@en .

aat:300212731 a skos:Concept ;
    skos:definition "Parts or components of land vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land vehicle components"@en .

aat:300212733 a skos:Concept ;
    skos:definition "Vessels equipped with pumps and other apparatus for fighting fires on or from the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireboats"@en .

aat:300212734 a skos:Concept ;
    skos:definition "Motor vehicles with apparatus for fighting fires on or from land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire engines"@en .

aat:300212738 a skos:Concept ;
    skos:definition "Two or more rail transit vehicles physically connected and operated as a unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trains"@en .

aat:300212739 a skos:Concept ;
    skos:definition "Railroad trains comprised of freight cars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freight trains"@en .

aat:300212740 a skos:Concept ;
    skos:definition "Refers to any of various motorized or nonmotorized wheeled vehicles designed to transport golfers or their equipment around golf courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf carts"@en .

aat:300212742 a skos:Concept ;
    skos:definition "Long, narrow, flat-bottomed, bilaterally asymmetrical boats having a tall ornamental stem, propelled by a single sculling oar and used as water taxis along the canals of Venice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gondolas"@en .

aat:300212743 a skos:Concept ;
    skos:definition "Small, four-wheeled rail vehicles used in conjunction with track inspection and repair to transport workers and equipment; originally open platforms with manually operated propulsion mechanisms, now usually gasoline- or electric-powered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handcars"@en .

aat:300212770 a skos:Concept ;
    skos:definition "Wheeled vehicles designed to carry bodies to gravesites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearses"@en .

aat:300212771 a skos:Concept ;
    skos:definition "Refers to various heavier than air aircraft characterized by large-diameter, powered, horizontally rotating wings or blades that can lift the craft vertically and sustain their position in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helicopters"@en .

aat:300212772 a skos:Concept ;
    skos:definition "Railroad trains capable of traveling at speeds greater than 200 km per hour on their own dedicated track."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-speed trains"@en .

aat:300212773 a skos:Concept ;
    skos:definition "Percussion idiophones made from the ends of oil drums, cut to a relatively shallow depth, made concave, subdivided by grooves, and hammered so as to create up to 30 segments, each of which produces a tuned pitch when struck with a rubber-headed stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel drums"@en .

aat:300212778 a skos:Concept ;
    skos:definition "Ensembles of voices and/or instruments in English music from about 1570 to 1720; also, present-day ensembles of like nature which play music of that period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consorts"@en .

aat:300212780 a skos:Concept ;
    skos:definition "Refers to any of various motorized watercraft fitted with planes or foils beneath their hull to lift the vessels clear of the water when traveling at high speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrofoils"@en .

aat:300212781 a skos:Concept ;
    skos:definition "Compact, low-hung coaches with the driver's perch outside, space for two or more passengers, and generally with a straight front; may also be used for early automobiles whose form borrowed the characteristic closed carriage-style body and open driver's area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broughams"@en .

aat:300212782 a skos:Concept ;
    skos:definition "Sailing vessels common especially to the seas of China and Java, having flat bottoms, high sterns with a square bow, and two or three masts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junks"@en .

aat:300212783 a skos:Concept ;
    skos:definition "Specifically used for single-seat native arctic North American canoes with watertight skin covers over a light wooden framework propelled by a double-bladed paddle, and generally for small boats resembling these made commercially of a variety of materials and used in sports. For similar North American skin boats but larger and seating more than one person, use \"umiaks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kayaks"@en .

aat:300212784 a skos:Concept ;
    skos:definition "Relatively heavy, four-wheeled carriages with coachlike lower bodies and tops constructed in two sections either of which could be lowered independently; may also be used for early carriage-style automobiles with convertible driver or passenger areas, and, by extension, for later sedanlike automobiles with a short folding rear top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landaus"@en .

aat:300212785 a skos:Concept ;
    skos:definition "Barges used for loading and unloading ships offshore or for transporting goods short distances in shallow waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighters"@en .

aat:300212787 a skos:Concept ;
    skos:definition "Artificial satellites that gather data about the earth's atmosphere and surface in order to aid meteorologists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorological satellites"@en .

aat:300212788 a skos:Concept ;
    skos:definition "Motorized vehicles larger and heavier than children's scooters and having a saddlelike seat mounted on the footboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motor scooters"@en .

aat:300212789 a skos:Concept ;
    skos:definition "Two-wheeled vehicles similar to bicycles but larger and heavier with engines set low on the frame; usually seating one or two riders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motorcycles"@en .

aat:300212791 a skos:Concept ;
    skos:definition "Oceangoing passenger ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ocean liners"@en .

aat:300212804 a skos:Concept ;
    skos:definition "Penetration of hides or skins with oil or other lipid-rich substances to produce a durable, soft-napped leather such as chamois."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil tanning"@en .

aat:300212805 a skos:Concept ;
    skos:definition "Treating hides or skins with vegetable tannins to produce leather; a treatment that leaves the leather susceptible to red rot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable tanning"@en .

aat:300212820 a skos:Concept ;
    skos:definition "Substances composed by the chemical union of potassium with additional elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium compounds"@en .

aat:300212821 a skos:Concept ;
    skos:definition "A naturally occurring metallic element with symbol K and atomic number 19. Potassium is a soft, silvery-white metal that rapidly oxidizes in moist air. It does not occur in nature in the free state because it is highly reactive. It is found mainly as potassium chloride (sylvite) and in clays (orthoclase, microcline). Major potassium salt deposits include the Great Salt Lake and Salduro Marsh in Utah and the Dead Sea between Israel and Jordan. Potassium salts are used to make fertilizer and hardened glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium"@en .

aat:300212822 a skos:Concept ;
    skos:definition "Mineral originally found on the Isle of Mull and used as refractory material for firebrick and furnace linings. It occurs naturally as fused argillaceous sediment inclusions in the mineral buchite, but this is rare, and as a result, it is produced artificially."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mullite"@en .

aat:300212825 a skos:Concept ;
    skos:definition "Any of various light, four-wheeled carriages generally characterized as seating two, having a folding top, and being owner-driven; popular sporting vehicles after their introduction in the mid-18th century; may also be used for automobiles of similar characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phaetons"@en .

aat:300212828 a skos:Concept ;
    skos:definition "Freight-carrying railroad cars consisting of a flat floor without sides or top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flatcars"@en .

aat:300212829 a skos:Concept ;
    skos:definition "Railroad flatcars designed and equipped to transport containers or truck trailers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piggyback cars"@en .

aat:300212830 a skos:Concept ;
    skos:definition "Boats that convey pilots to and from large ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilot boats"@en .

aat:300212831 a skos:Concept ;
    skos:definition "Wagons, trucks, or vans designed for various police functions, such as patroling or transporting prisoners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patrol wagons"@en .

aat:300212832 a skos:Concept ;
    skos:definition "Covered wagons of medium size carrying freight and emigrants across the western prairies and plains of the United States; generally characterized by mostly straight lines and linen tops; for similar wagons used predominantly east of the Mississippi River and having a boat-shaped profile with flaring ends, use \"Conestoga wagons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prairie schooners"@en .

aat:300212833 a skos:Concept ;
    skos:definition "Revolving shafts with radiating blades used to propel craft through air or water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propellers"@en .

aat:300212834 a skos:Concept ;
    skos:definition "Specially designed or modified automobiles for racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racing cars"@en .

aat:300212835 a skos:Concept ;
    skos:definition "Refers to a wide variety of watercraft that are essentially floating platforms, more or less rigid or stationary and buoyant, constructed without interior volume and in a way that cannot keep water out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rafts"@en .

aat:300212836 a skos:Concept ;
    skos:definition "Enclosed freight cars equipped with machinery to keep perishables chilled during transit; may sometimes also include heating equipment for protection in subfreezing weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refrigerator cars"@en .

aat:300212838 a skos:Concept ;
    skos:definition "Shallow-draft vessels for passage on rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riverboats"@en .

aat:300212839 a skos:Concept ;
    skos:definition "Automobiles with an open body, a single seat for two or three passengers, and a large trunk or rumbleseat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roadsters"@en .

aat:300212841 a skos:Concept ;
    skos:definition "Movable control surfaces used to impart direction to craft when in motion; usually located at the rear of vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rudders"@en .

aat:300212868 a skos:Concept ;
    skos:definition "Any of various small flat-bottomed craft of the Far East, propelled by a single sculling oar or sail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sampans"@en .

aat:300212869 a skos:Concept ;
    skos:definition "Specially designed unmanned spacecraft intended to maintain an orbit around a celestial body. For unmanned spacecraft designed for nonorbital missions, use \"space probes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial satellites"@en .

aat:300212870 a skos:Concept ;
    skos:definition "Buses used to transport students to and from school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school buses"@en .

aat:300212871 a skos:Concept ;
    skos:definition "Refers to fore-and-aft-rigged sailing vessels with two or more masts, especially those with only two masts in which the aftermast is taller than the foremast; for two-masted sailing vessels in which the aftermast is the shorter one, see \"ketches (fore-and-aft-rigged vessels)\" or \"yawls (sailing vessels).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schooners"@en .

aat:300212872 a skos:Concept ;
    skos:definition "Refers to any of various watercraft with flat-bottomed rectangular hulls often with sloping ends, with or without a means of propulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scows"@en .

aat:300212875 a skos:Concept ;
    skos:definition "Refers to a broad class of small sailing craft of the East Coast of the United States characterized by a flat cross-planked bottom, shallow draft, fine bow, and a straight stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sharpies"@en .

aat:300212878 a skos:Concept ;
    skos:definition "Extremely light and slender boats used for sculling and racing, generally consisting of a very thin shell or skin over a fragile framework with sliding seats for the rowers. Shells are not over 2 feet wide and usually have outriggers for the oars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shells"@en .

aat:300212879 a skos:Concept ;
    skos:definition "Single-masted sailing vessels built with deadrise construction, decked, with a cabin and generally carrying a triangular mainsail and jib, set on a sharply raking mast; a few two-masted, or three-sail examples were built; introduced onto the Chesapeake Bay in the mid-19th century and usually used for oyster dredging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skipjacks"@en .

aat:300212880 a skos:Concept ;
    skos:definition "Railroad cars equipped with special facilities allowing passengers to sleep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeping cars"@en .

aat:300212881 a skos:Concept ;
    skos:definition "Any of various boats small and light enough to be rowed or sailed by one person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skiffs"@en .

aat:300212882 a skos:Concept ;
    skos:definition "Light vehicles on parallel runners, usually having seats and usually open and horse-drawn, for carrying passengers over snow and ice. For similar, but simpler, vehicles for transporting goods or passengers by animal locomotion or gravity, use \"sleds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleighs"@en .

aat:300212884 a skos:Concept ;
    skos:definition "Motor vehicles with revolving treads in the rear and steerable skis in the front, for traveling over snow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snowmobiles"@en .

aat:300212886 a skos:Concept ;
    skos:definition "Large three-sided foresails set on the opposite side of the boom of fore-and-aft-rigged vessels when sailing before the wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinnakers"@en .

aat:300212888 a skos:Concept ;
    skos:definition "Coaches used for public transportation along scheduled routes having intermediary stops to change horses; in use by the mid-17th century. Forms having an oval body, outside driver's seat, and single door in each side were popular in the United States from the early 19th until the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stagecoaches"@en .

aat:300212889 a skos:Concept ;
    skos:definition "Gigs without tops, devised in the early 19th century; distinguished from \"tilburies\" by their suspension and the addition of extra luggage space under the seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stanhopes"@en .

aat:300212892 a skos:Concept ;
    skos:definition "Wheels used as the primary means of maneuvering vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steering wheels"@en .

aat:300212896 a skos:Concept ;
    skos:definition "Electrically powered rail rapid transit vehicles with a control cab at one or both ends, two or more double doors on each side, and designed to operate singly or in multiple units and for fast boarding at high-level platforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subway cars"@en .

aat:300212897 a skos:Concept ;
    skos:definition "Popular family carriages, with four wheels, drawn by one or two horses or ponies, and usually having a top; developed in the United States in a variety of styles during the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surreys"@en .

aat:300212899 a skos:Concept ;
    skos:definition "Railroad freight vehicles whose bodies are tanks for transporting liquids, gases, or granular solids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tank cars"@en .

aat:300212902 a skos:Concept ;
    skos:definition "Gigs of the 19th century similar to stanhopes but heavier, differing in suspension, and usually lacking the extra luggage space under the seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilburies"@en .

aat:300212903 a skos:Concept ;
    skos:definition "Cars, carriages, or other nonmotorized wheeled vehicles that include a chassis and are primarily intended to be towed by other vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trailers"@en .

aat:300212904 a skos:Concept ;
    skos:definition "Open, native arctic North American skin boats seating more than one person and used for transporting goods and passengers; for similar but smaller and covered skin boats seating only one, use \"kayaks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umiaks"@en .

aat:300212905 a skos:Concept ;
    skos:definition "Enclosed, boxlike vehicles with high sides originally intended for carrying light cargo or for trade use; motorized versions often have side and rear doors and may have seating for passengers; generally the driver, passengers, and cargo are all enclosed within the body. Use \"panel trucks\" for light delivery vehicles with high sides in which the driver's cab is separate from the cargo space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vans"@en .

aat:300212906 a skos:Concept ;
    skos:definition "Hand-operated utility vehicles usually fitted with a shallow, open receptacle, a wheel or wheels in front, and two unwheeled supports in back and lifted and pushed using two horizontal shafts extending outward from the rear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheelbarrows"@en .

aat:300212908 a skos:Concept ;
    skos:definition "Rigid airships consisting of a covered and trussed frame supported by compartments or cells filled with gas; developed in Germany around 1900."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zeppelins"@en .

aat:300212909 a skos:Concept ;
    skos:definition "Veils worn by Islamic women to cover the face in public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yashmaks"@en .

aat:300212910 a skos:Concept ;
    skos:definition "Vertical bamboo flutes of Japan with a notched lip, four finger holes, and one thumb hole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shakuhachi"@en .

aat:300212912 a skos:Concept ;
    skos:definition "Bands, originating in Trinidad and Tobago, featuring steel drums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel bands"@en .

aat:300212938 a skos:Concept ;
    skos:definition "Helmets worn by firefighters having a high domed crown and a brim extended at the rear to serve as a neck guard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire hats"@en .

aat:300212958 a skos:Concept ;
    skos:definition "Medieval headcloths for women usually consisting of a long linen or woolen cloth draped from one shoulder over the crown of the head, down and under the chin, and then around the back to the other shoulder, where it was left hanging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headrails"@en .

aat:300212968 a skos:Concept ;
    skos:definition "Vehicles for use over land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land vehicles"@en .

aat:300212970 a skos:Concept ;
    skos:definition "Equipment that is used in conjuction with land vehicles and land transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land vehicle equipment"@en .

aat:300212971 a skos:Concept ;
    skos:definition "The complete equipment by which draft animals are attached to vehicles of any kind; sometimes also used for riding accoutrements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harnesses"@en .

aat:300212972 a skos:Concept ;
    skos:definition "Seats made over a frame and placed on an animal's back for carrying riders; may also be used for similar, but smaller, seats used on some other vehicles, such as bicycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddles"@en .

aat:300212974 a skos:Concept ;
    skos:definition "Goffered headdresses, which, when laid over the top of the head, formed a wide frill. The goffering might only extend to the eartip, but sometimes was carried down as far as the chin. Worn by women during the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nebula headdresses"@en .

aat:300212975 a skos:Concept ;
    skos:definition "Equipment that is used in conjunction with watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watercraft equipment"@en .

aat:300212979 a skos:Concept ;
    skos:definition "Single-masted, fore-and-aft-rigged sailing vessels, with one or two headsails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sloops"@en .

aat:300212980 a skos:Concept ;
    skos:definition "Two-masted, fore-and-aft-rigged sailing vessels with the smaller, mizzen, mast set forward of the rudder post; in use since the mid-19th century. For similar craft, but square-rigged on both masts and in use from the late 17th century until the early 19th century, use \"ketches (square-rigged vessels).\" For similar fore-and-aft-rigged craft with the mizzen set abaft the rudder post, use \"yawls (sailing vessels).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ketches"@en .

aat:300212982 a skos:Concept ;
    skos:definition "Two-masted, fore-and-aft-rigged vessels in which the foremast is larger than the mizzen mast and is set abaft the rudder post; for similar fore-and-aft-rigged vessels, but with the smaller, mizzen, mast set forward of the rudder post, use \"ketches (fore-and-aft-rigged vessels).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yawls"@en .

aat:300212984 a skos:Concept ;
    skos:definition "Airplanes with two sets of wings, one above and usually slightly forward of the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biplanes"@en .

aat:300212985 a skos:Concept ;
    skos:definition "Airplanes propelled by engines that eject jets or streams of gas or fluids, obtaining all or most of their thrust by reaction to the ejection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jet aircraft"@en .

aat:300212986 a skos:Concept ;
    skos:definition "Airplanes capable of taking off from, landing on, and navigating on the surface of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seaplanes"@en .

aat:300212988 a skos:Concept ;
    skos:definition "Devices enabling the wearer to walk across deep snow without sinking and consisting generally of a light racket-shaped frame strung with a network of thong or hide straps and attached to the wearer's feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snowshoes"@en .

aat:300212989 a skos:Concept ;
    skos:definition "Three-wheeled vehicles, particularly of light open framework construction, usually powered by the rider via pedals and cranks, or occasionally by a motor; for similar lightweight manually powered vehicles, but without comfort- or speed-enhancing features, constructed prior to about 1870, prefer \"velocipedes.\" For three-wheeled automobiles, use either \"three-wheelers\" or \"cyclecars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tricycles"@en .

aat:300212992 a skos:Concept ;
    skos:definition "Two- or three-wheeled, simply constructed light vehicles propelled by the rider by pedals, treadles, levers, or with the feet directly on the ground, while seated astride a central bar; may or may not be steerable and the front wheel is often larger than the rear one(s); usually restricted to those vehicles built from the 1790s to around 1870. For similar lightweight vehicles provided with comfort- or speed-enhancing features and built after about 1870, prefer \"bicycles\" for those with two wheels in tandem or \"tricycles\" for three-wheeled versions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velocipedes"@en .

aat:300212996 a skos:Concept ;
    skos:definition "Refers to watercraft with a prominent central hull and flanking subsidiary hulls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimarans"@en .

aat:300212997 a skos:Concept ;
    skos:definition "Soft headcloths, especially of linen or silk, wrapped around the throat and passing under the chin from one side of the head to the other, and pinned to a band, hat or the hair. Of a type originating in the Medieval period and retained by nuns of various religions to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wimples"@en .

aat:300212998 a skos:Concept ;
    skos:definition "Parts or components of costumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume components"@en .

aat:300213000 a skos:Concept ;
    skos:definition "The parts of a hat or other headgear covering the crown of the head. For head-encircling devices signifying rank or used as ornament, but not part of a hat, use \"crowns (headdresses).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crowns"@en .

aat:300213001 a skos:Concept ;
    skos:definition "Tall, pointed crowns to hats, often cone-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steeple crowns"@en .

aat:300213002 a skos:Concept ;
    skos:definition "Material comprising fine, powdery, yellowish grains or spores, sometimes in masses, which are the fertilizing element of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pollen"@en .

aat:300213003 a skos:Concept ;
    skos:definition "Term generally applied to various cloth coverings for the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headcloths"@en .

aat:300213004 a skos:Concept ;
    skos:definition "A mixture of gases comprising the earth's atmosphere generally understood as that which is essential to the survival of land animals and plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air"@en .

aat:300213027 a skos:Concept ;
    skos:definition "Military aircraft designed to be used primarily against surface targets and equipped to carry and drop bombs, generally characterized by long range, low maneuverability, and large weapon-carrying capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bombers"@en .

aat:300213037 a skos:Concept ;
    skos:definition "Fast, highly maneuverable, and relatively short-range military aircraft designed to destroy air and surface targets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fighters"@en .

aat:300213040 a skos:Concept ;
    skos:definition "The hollow, main body of watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hulls"@en .

aat:300213048 a skos:Concept ;
    skos:definition "Boats propelled by inboard or outboard engines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motorboats"@en .

aat:300213053 a skos:Concept ;
    skos:definition "Arrangements of ropes, wires, and chains used for securing or supporting masts, yards, and for hoisting, lowering, or trimming the sails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nautical rigging"@en .

aat:300213068 a skos:Concept ;
    skos:definition "Denotes any wooden support for the rigging of a vessel, including the booms, gaffs, masts, and yards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spars"@en .

aat:300213077 a skos:Concept ;
    skos:definition "Long slender shafts, usually wood, shaped to a round handle or grip at one end and flat-tipped blade at the other; for rowing. For similar but shorter devices with round-tipped blades for propelling small boats, use \"paddles (watercraft equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oars"@en .

aat:300213080 a skos:Concept ;
    skos:definition "Relatively short, slender shafts,usually having with a handle at one end and a flat round-tipped blade at the other, used by people pushing the device through water in a vertical manner in order to propel small boats; may be double-ended; for longer but similar devices with flat-tipped blades, use \"oars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paddles"@en .

aat:300213081 a skos:Concept ;
    skos:definition "Pedal-driven devices with a single wheel and a seat mounted on an adjustable-height shaft ridden and steered by body balance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unicycles"@en .

aat:300213117 a skos:Concept ;
    skos:definition "White crystalline compound that is soluble in water and insoluble in alcohol. Its uses include: reducing agent in photography, oxidizing agent, antiseptic, soap manufacture, and desizing of textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium persulfate"@en .

aat:300213119 a skos:Concept ;
    skos:definition "A dark purple crystalline compound of composition KMnO4, used in deodorizers and dyes and as an oxidizing agent and disinfectant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium permanganate"@en .

aat:300213121 a skos:Concept ;
    skos:definition "A gray, crystalline mass that forms potassium hydroxide; it is soluble in water, alcohol, and ether. Toxic and corrosive to tissue, it used as a chemical reagent and intermediate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium oxide"@en .

aat:300213123 a skos:Concept ;
    skos:definition "White, highly deliquescent opaque crystals or powder that is soluble in water and alcohol and decomposed by heat. It has a low toxicity and a pungent saline taste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium hypophosphite"@en .

aat:300213125 a skos:Concept ;
    skos:definition "Colorless or white deliquescent crystals or powder that is soluble in water and glycerol and almost insoluble in alcohol. It is odorless but has a cooling saline taste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium citrate"@en .

aat:300213127 a skos:Concept ;
    skos:definition "A potassium salt of lactic acid used to treat leather to counteract acid present in the leather from manufacturing processes or from air pollution; it is also used to safeguard against future incursion of acid or acid-forming material. Some controversy exists over the possible discoloration potassium lactate may cause to leather as well as its overall effectiveness as a leather/acid buffer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium lactate"@en .

aat:300213140 a skos:Concept ;
    skos:definition "Posters of approximately 41 x 81 inches, corresponding to three of the original one-sheet posters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-sheet posters"@en .

aat:300213145 a skos:Concept ;
    skos:definition "Posters used in outdoor advertising and usually on billboards built for the purpose, that are approximately 9 by 20 feet, corresponding to 24 of the original one-sheet posters but today requiring fewer separate sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-four-sheet posters"@en .

aat:300213156 a skos:Concept ;
    skos:definition "Series of sketches or pictures and any accompanying text which visualize each topic or item in a work to be produced in an audio-visual format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storyboards"@en .

aat:300213176 a skos:Concept ;
    skos:definition "Advertising in publications such as magazines or newspapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print advertising"@en .

aat:300213177 a skos:Concept ;
    skos:definition "In a form that can be fed directly into a computer, such as electronic bits on a disk drive, diskette, or magnetic tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine-readable"@en .

aat:300213179 a skos:Concept ;
    skos:definition "The setting of type characters closer together than would normally or automatically be done; for visual effect, usually to close an unsightly gap. With metal type, the body of the type is cut for a closer fit; in photocomposition, minute increments of backspacing are used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerning"@en .

aat:300213180 a skos:Concept ;
    skos:definition "advertising via the broadcast media of radio or television."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadcast advertising"@en .

aat:300213181 a skos:Concept ;
    skos:definition "advertising via outdoor locations, such as on billboards or with posters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outdoor advertising"@en .

aat:300213183 a skos:Concept ;
    skos:definition "Advertising via locations seen by people in transit, as inside and on the outside of public transportation vehicles and in stations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transit advertising"@en .

aat:300213184 a skos:Concept ;
    skos:definition "Manuals provided to theater owners, especially in the 1930s and 1940s, advising them on how to promote a particular motion picture being shown in their theater. For books produced and published by private presses, use \"press books\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressbooks"@en .

aat:300213187 a skos:Concept ;
    skos:definition "Announcements paid for by an advertiser and broadcast on radio or television. For other public notices or paid announcements, especially those in print, use \"advertisements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercials"@en .

aat:300213204 a skos:Concept ;
    skos:definition "Bronze cuirasses of ancient Greece, typically consisting of two pieces hinged on one side and joined by metal pins or loops on the other, and characterized by an inward curve near the waist below which the lower rim curves strongly out. They were common until the late 6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell corslets"@en .

aat:300213235 a skos:Concept ;
    skos:definition "Helmets widely used in Europe during the period of Roman domination, having a hemispherical, slightly bulbous skull topped by a small knob, and cheekpieces hinged to the sides and tied under the chin. Originating in Gaul, they were adopted by the Romans in the 6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jockey cap helmets"@en .

aat:300213259 a skos:Concept ;
    skos:definition "Use to distinguish those signs that convey general information from those that are \"direction signs,\" \"identification signs,\" or \"regulatory signs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information signs"@en .

aat:300213305 a skos:Concept ;
    skos:definition "Promotional material located in, at, or on retail establishments that is provided by the manufacturer or their agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point-of-purchase displays"@en .

aat:300213328 a skos:Concept ;
    skos:definition "Merchandise offered in addition to or in combination with a product for the purpose of attracting purchasers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "premiums"@en .

aat:300213339 a skos:Concept ;
    skos:definition "Simple unpolymerized compounds, having low molecular weight as distinguished from dimers or polymers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monomers"@en .

aat:300213343 a skos:Concept ;
    skos:definition "Metal fabric consisting of iron or steel rings, riveted or pressed together, typically used in armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail"@en .

aat:300213346 a skos:Concept ;
    skos:definition "Thin pieces or plates of any substance, but often of metal. Examples are the relatively pliable metal plates often used in making armor pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lames"@en .

aat:300213348 a skos:Concept ;
    skos:definition "Small thin pliable lames or tongues of metal, used in a number of contexts, such as attached in overlapping rows onto leather or fabric supports to form armor, as yarn, and as the principal sounding element in lamellophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamellae"@en .

aat:300213350 a skos:Concept ;
    skos:definition "A white or colorless crystalline solid or powder of the composition KCl, used for molten salt baths, for the heat treatment of steels, for fertilizers, and in explosives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium chloride"@en .

aat:300213355 a skos:Concept ;
    skos:definition "A reddish powder composed of iron oxide and hydrated iron oxide that forms on the surface of iron and iron alloys. Rust is formed by the oxidation of iron in the presence of moisture. At least 40% humidity is required for the corrosion to occur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rust"@en .

aat:300213361 a skos:Concept ;
    skos:definition "A resinous mixture from tree buds (particularly buds of poplar and cone-bearing trees), sap flows, or other botanical sources, collected by honey bees for use, with beeswax, as a barrier at the hive entrance and as a sealant for unwanted open spaces in the hive. Humans have long used it as a paint binder, to treat and varnish wood (notably violins), in tanning, making candles, cosmetics, and as a medicinal antibacterial and antifungal agent. It was used by ancient Egyptians in mummification. Ancient Greeks, Assyrians, and Indians used it for healing wounds and treating abscesses. It is rarely collected directly from the trees, but instead is collected from beehives, and thus actually contains bee products along with the resins and volatiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propolis"@en .

aat:300213366 a skos:Concept ;
    skos:definition "Any substance capable in solution of neutralizing both acids and bases and thereby maintaining the original acidity or basicity of the solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffer"@en .

aat:300213433 a skos:Concept ;
    skos:definition "Close-fitting caps made in a variety of shapes and sizes and worn at various periods by men and women, sometimes surmounted by a hat or headdress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coifs"@en .

aat:300213460 a skos:Concept ;
    skos:definition "Long, tapering, knitted caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stocking caps"@en .

aat:300213472 a skos:Concept ;
    skos:definition "Headcloths of crochet work, lace, or the like, worn by women in the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fascinators"@en .

aat:300213473 a skos:Concept ;
    skos:definition "Roman term for slings consisting of straps of flax, leather, or horsehair, in the middle of which was a pocket or pouch to hold the missile, used both for hunting and in warfare. They were used by Roman and allied troops in Republican and Imperial times at least into the 5th century and continued in military use in Europe into the 14th century and occasionally later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fundae"@en .

aat:300213474 a skos:Concept ;
    skos:definition "Round, oval, or bilobated shields of Classical Greece and later, Doric in origin, made of layers of cow hide and large enough to protect most of the body. Early models were held in the hand; later versions had an armlet set diagonally, with a handle near the edge, and were carried on the arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aspes"@en .

aat:300213475 a skos:Concept ;
    skos:definition "Circular or oval shields of leather or bronze covered with metal plates or a sheet of bronze, used by Roman heavy cavalry from the late 8th to the 4th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clipei"@en .

aat:300213477 a skos:Concept ;
    skos:definition "General term for the short double-edged, pointed Roman swords, originally used for thrusting only and having practically no guard, used by the infantry. Over time, versions with longer blades and a small guard developed, and they were made to execute both thrusts and cuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gladii"@en .

aat:300213478 a skos:Concept ;
    skos:definition "Round shields of ancient Greece, developed in the 8th century BCE, of an evenly convex shape sharply offset at the rim, and having on the back a central armband and a hand grip near the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoplite shields"@en .

aat:300213479 a skos:Concept ;
    skos:definition "Single-edged pointed knifelike swords of ancient Greece and Egypt with concave curving blade, designed for delivering cutting blows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kopes"@en .

aat:300213480 a skos:Concept ;
    skos:definition "Generic term used for several types of cuirasses worn by Roman soldiers, made of leather, bronze, or iron plates or scales, or of mail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loricae"@en .

aat:300213481 a skos:Concept ;
    skos:definition "Single-edged pointed war knives of ancient Greece with a convex curving blade, used by both infantry and cavalry, as well as for slaying sacrificial victims and some domestic uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machairas"@en .

aat:300213482 a skos:Concept ;
    skos:definition "Round bronze shields furnished with a sturdy boss, used by Roman mounted troops from the 7th or 6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parmae"@en .

aat:300213494 a skos:Concept ;
    skos:definition "Leather thongs, Greco-Etruscan in origin and adopted by the Romans, attached to the shafts of javelins and used to throw them with more propulsion than was possible by hand alone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amenta"@en .

aat:300213495 a skos:Concept ;
    skos:definition "Greek and Latin term for light, crescent-shaped shields made of wicker and covered with leather; it was considered by the Greeks and Romans as the typical defensive weapon of barbarous peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peltae"@en .

aat:300213505 a skos:Concept ;
    skos:definition "Top hats made of beaver fur or of a fabric simulating this fur. Prefer \"castors (hats)\" for other men's hats of beaver fur made in varying form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beavers"@en .

aat:300213506 a skos:Concept ;
    skos:definition "Hats with a high crown and a brim turned up behind and rising to a peak at front; worn from the 14th to 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bycockets"@en .

aat:300213510 a skos:Concept ;
    skos:definition "Roman javelins of Etruscan origin, issued to Roman soldiers from the Republican period to the 4th or 5th century CE. Their form and weight varied over time, but usually they were characterized by a long, narrow head attached to the staff by a flange or socket, and a weight attached to the staff below the head to improve balance and trajectory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pila"@en .

aat:300213511 a skos:Concept ;
    skos:definition "Macedonian infantry pikes having a very long shaft of from 16 to 24 feet, a short leaf-shaped iron head, and an iron point on the butt end which could be plunged into the ground to withstand an enemy onrush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarissae"@en .

aat:300213512 a skos:Concept ;
    skos:definition "Long shields originating in Italy and used by Roman heavy infantry from the 8th century BCE to the 5th century CE. They were rectangular or oval in shape, originally of wood or wicker, later of leather-covered wood with a central metal boss and a longitudinal spine up the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scuta"@en .

aat:300213522 a skos:Concept ;
    skos:definition "Helmets used in Greece from about the mid-6th century BCE on, consisting of a skull with a short neck guard and two movable cheekpieces hinged to the skull. They were often highly decorated and surmounted by an elaborate crest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Attic helmets"@en .

aat:300213531 a skos:Concept ;
    skos:definition "Helmets consisting of a single plate of bronze, shaped to cover the cranium, nose, cheeks, and chin. The most widely used type of military helmet of Classical Greece, it had spread to Italy by the beginning of the 6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian helmets"@en .

aat:300213534 a skos:Concept ;
    skos:definition "Open-faced helmets with cheekpieces and a closely fitting skull, at first made of two and later of only one sheet of bronze. They originated in the Peloponnese in the early 7th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Illyrian helmets"@en .

aat:300213536 a skos:Concept ;
    skos:definition "Ancient Etruscan helmets derived from the widely used Corinthian helmets of Greece and Italy, with the skull covering the head to the eyes only, and having either a short tail at the back or a flared circular brim all round to protect the neck and cheeks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudo-Corinthian helmets"@en .

aat:300213571 a skos:Concept ;
    skos:definition "Reedpipes of ancient Greece, consisting of two separate slender cylindrical pipes of wood or metal each with a reed, single or double; the pipes were held at a divergent angle and both reeds held in the mouth together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auloi"@en .

aat:300213686 a skos:Concept ;
    skos:definition "19th-century women's bonnets, often with a soft gathered crown and a stiff brim with ribbons tied at the side or under the chin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capotes"@en .

aat:300213692 a skos:Concept ;
    skos:definition "Men's hats of varying form made of beaver fur; especially used for those worn from the 17th to 19th century. Prefer \"beavers\" for men's top hats made of beaver fur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castors"@en .

aat:300213697 a skos:Concept ;
    skos:definition "Side extensions to a cap which may be worn either turned up and secured to the crown or turned down to cover the ears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earflaps"@en .

aat:300213699 a skos:Concept ;
    skos:definition "A grayish-white element with symbol As and atomic number 33, having a metallic luster, vaporizing when heated, and forming poisonous compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arsenic"@en .

aat:300213700 a skos:Concept ;
    skos:definition "S-shaped crooks on bassoons and English horns that carry the mouthpiece and double reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bocals"@en .

aat:300213701 a skos:Concept ;
    skos:definition "Smaller or lesser crowns usually signifying a high rank below that of a sovereign."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coronets"@en .

aat:300213703 a skos:Concept ;
    skos:definition "Gongs that are used and played as an ensemble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sets of gongs"@en .

aat:300213706 a skos:Concept ;
    skos:definition "Melody pipes on bagpipes; they may be of conical or cylindrical bore and be fitted with either a single or a double reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chanters"@en .

aat:300213707 a skos:Concept ;
    skos:definition "Pipes that are constituent parts of other aerophones, have no fingerholes, and are used to sustain single notes. For Australian aboriginal instruments use \"didjeridus.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drone pipes"@en .

aat:300213708 a skos:Concept ;
    skos:definition "A chemical substance produced by microorganisms that has the capacity, in dilute solutions, to inhibit the growth of other microorganisms or destroy them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antibiotic"@en .

aat:300213709 a skos:Concept ;
    skos:definition "Components of helmets that protect the eyes, the entire face, sometimes including the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet visors"@en .

aat:300213740 a skos:Concept ;
    skos:definition "Material in the form of a thin soft pliable sheet or layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membrane"@en .

aat:300213746 a skos:Concept ;
    skos:definition "Heavy shoes with open side flaps, especially coarse leatherwork shoes reaching to the ankles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brogans"@en .

aat:300213845 a skos:Concept ;
    skos:definition "Mutes incorporated into the piano actions, consisting of felted blocks resting on the strings to keep them silent except when their keys are pressed or when the entire set is lifted by a pedal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dampers"@en .

aat:300213856 a skos:Concept ;
    skos:definition "Metallophones of Java and Bali, consisting of thin bronze bars suspended by horizontal cords over individual tube resonators. They are important instruments in the Javanese and Balinese gamelan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genders"@en .

aat:300213872 a skos:Concept ;
    skos:definition "Gong chimes of Southeast Asia, in which the gongs are arranged in double or single rows in L- or U-shaped frames. They constitute an important element of the gamelan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonang"@en .

aat:300213888 a skos:Concept ;
    skos:definition "During the 18th and 19th centuries, term used to describe soft crowns found on bonnets or caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauls"@en .

aat:300214029 a skos:Concept ;
    skos:definition "Small hand organs used in training song birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serinettes"@en .

aat:300214032 a skos:Concept ;
    skos:definition "Transverse bamboo flutes of China, having in addition to regular finger holes, an extra one next to the mouthpiece, covered by a membrane which vibrates during play, creating a characteristic buzzing timbre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dizi"@en .

aat:300214034 a skos:Concept ;
    skos:definition "Chinese spike fiddles having two strings, a long neck of hardwood with two tuning pegs at the upper end, and a tubular, hexagonal, or octagonal resonator covered at one end with snakeskin. They are played with a horsehair bow which passes between the two strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erhu"@en .

aat:300214048 a skos:Concept ;
    skos:definition "Japanese plucked lutelike chordophones having two pairs of strings, a flat body of wood, a short fretted neck with lateral pegs, and a metal lamella affixed to the interior of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gekkin"@en .

aat:300214073 a skos:Concept ;
    skos:definition "Chinese drums generally having the shape of a barrel, with a drumhead on either end, tacked rather than laced to the shell; only one drumhead is struck, by two beaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gu"@en .

aat:300214100 a skos:Concept ;
    skos:definition "Dresses which hang straight from the shoulders, sometimes tapering slightly at hips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemise dresses"@en .

aat:300214103 a skos:Concept ;
    skos:definition "Short cylindrical Japanese reedpipes with double reed and conical bore, having seven front fingerholes, two rear thumbholes, and a ring of cane guarding the reed. Originating in China and known in Japan since the 8th century, they were formerly made of hardwood, bone, or horn, but now usually of bamboo lacquered on the inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hichiriki"@en .

aat:300214143 a skos:Concept ;
    skos:definition "Events, often but not always ceremonious or celebratory in nature, serving to call someone or something to remembrance or to honor people or past events. For events demonstrating grateful or happy satisfaction or honor, use \"celebrations.\" For formal events conducted elaborately, solemnly, and as prescribed by ritual or protocol, use \"ceremonies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorations"@en .

aat:300214144 a skos:Concept ;
    skos:definition "Small Japanese barrel drums with two projecting heads of deerskin, mounted on hoops and laced to each other across the shell. They are set horizontally on a low stand and both heads are played with drumsticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kakko"@en .

aat:300214169 a skos:Concept ;
    skos:definition "Double-headed hourglass pressure drums of West Africa, principally of the Hausa people of Nigeria, held under the arm and beaten with a hooked stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalangus"@en .

aat:300214184 a skos:Concept ;
    skos:definition "Finger cymbals of the ancient and modern Islamic world, still played today in southeastern Europe and Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zils"@en .

aat:300214208 a skos:Concept ;
    skos:definition "Thin flat clappers of bone, ivory, or hardwood played in pairs, usually a pair in each hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bones"@en .

aat:300214211 a skos:Concept ;
    skos:definition "Pear-shaped, short-necked Japanese lutelike chordophones made of wood, commonly with four strings and a pegbox sharply angled back from the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biwa"@en .

aat:300214226 a skos:Concept ;
    skos:definition "Fiddles of Bengal made in one piece, with a pear-shaped resonator waisted at the front and covered with goatskin, a long neck covered by a concave wooden fingerboard with curved metal frets, and four main strings and fifteen sympathetic strings, all of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "esrajs"@en .

aat:300214236 a skos:Concept ;
    skos:definition "Double-headed hourglass pressure drums of the Yoruba people, held under the arm and beaten with a hooked stick. Use also for the sets of Yoruba hourglass pressure drums of which the dundun constitutes the largest member."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dunduns"@en .

aat:300214255 a skos:Concept ;
    skos:definition "Small, fretted, plucked lutelike instruments of the Andes region of South America, existing in many shapes and with differing numbers of strings; of the two main types, one is of wood and flat-backed, the other has a round back of armadillo shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charangos"@en .

aat:300214260 a skos:Concept ;
    skos:definition "Spanish and Latin American folk shawms made in treble and tenor sizes, having a short, triangular double reed with a wide opening, and usually a piroutette."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chirimías"@en .

aat:300214298 a skos:Concept ;
    skos:definition "Brazilian friction drums, whose membrane is perforated by a stick which is rubbed with either the player's wetted hand or a damp cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuícas"@en .

aat:300214308 a skos:Concept ;
    skos:definition "Bows, the shaft of which is composed of two or more organic materials, combined so as to enhance the elastic efficiency of each."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite bows"@en .

aat:300214311 a skos:Concept ;
    skos:definition "Early type of simple bow, of which the shaft is made from a single stave of one material, usually wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self bows"@en .

aat:300214314 a skos:Concept ;
    skos:definition "Large bronze gongs of Bali and Java, from about 34 to 40 inches in diameter, suspended by a rope from a wood frame and beaten softly and firmly on the central boss with a padded hammer to produce a low-pitched sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gong ageng"@en .

aat:300214333 a skos:Concept ;
    skos:definition "Javanese bronze gongs, about 15 to 20 inches in diameter, suspended from a frame and beaten with a padded mallet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kempul"@en .

aat:300214335 a skos:Concept ;
    skos:definition "High-pitched kettle gongs of Java with a high central boss, played resting on crossed cords in a wooden box; they are played in sets in the Javanese gamelan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kenong"@en .

aat:300214336 a skos:Concept ;
    skos:definition "Japanese spike fiddles having a long neck, square body, parchment belly and back, and from two to four strings. They are held vertically by the kneeling players and rotated to select the appropriate string to be sounded by the bow, which always follows the same path."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kokyu"@en .

aat:300214337 a skos:Concept ;
    skos:definition "Xylophones of southern Africa with gourd resonators, each having a hole in the side covered by a membrane; when the keys above are struck, the air in the gourds vibrates causing the membranes to sound a buzzing tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mbilas"@en .

aat:300214338 a skos:Concept ;
    skos:definition "Small kettledrums of Medieval Europe, more or less hemispherical in shape, usually played in pairs suspended from the player's waist in front and often furnished with snares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nakers"@en .

aat:300214339 a skos:Concept ;
    skos:definition "Use generally for plucked lutelike chordophones of Caucasus, Iran, and the Islamic cultures of southeastern Europe and Asia Minor, having a long neck with movable frets, a small pear-shaped body, and a variable number of strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saz"@en .

aat:300214342 a skos:Concept ;
    skos:definition "End-blown flutes of the Maori, made of wood, clay, or whale tooth, with conical bore, usually three fingerholes, and terminating in a short upturned snout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ngurus"@en .

aat:300214349 a skos:Concept ;
    skos:definition "Long-necked Chinese lutelike chordophones having a small oval, rectangular, or square soundbox with the belly and back covered by snakeskin, and three silk or nylon strings tuned by three lateral pegs. They are plucked with the fingernails or a plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanxian"@en .

aat:300214355 a skos:Concept ;
    skos:definition "Upright serpents developed by the Parisian maker Forveille around 1833, made of brass with a wood bell, and having two sharp U-shaped bends, six fingerholes, three or four keys, and a crook to carry the mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpents Forveilles"@en .

aat:300214363 a skos:Concept ;
    skos:definition "Long drawers decorated at the ankles, worn by women and children in the 19th century. Also, a pair of separate shaped pieces designed to tie onto the leg and reach the ankle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantalets"@en .

aat:300214365 a skos:Concept ;
    skos:definition "Bamboo duct flutes of Indonesia, open at the bottom and closed with a natural node at the top; a notch is cut in the node and in the tube just below it, and a narrow bamboo ring is tied over the upper end to guide the player's breath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suling"@en .

aat:300214366 a skos:Concept ;
    skos:definition "Girdles with a crotch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panty girdles"@en .

aat:300214424 a skos:Concept ;
    skos:definition "Cambodian spike fiddles with two strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tro u"@en .

aat:300214425 a skos:Concept ;
    skos:definition "Zitherlike plucked chordophones of ancient and modern India, composed of a hollow bamboo or wood tube to which one or more half-gourd resonators are attached, usually one at each end. Different regional types have varying numbers of frets and melody and drone strings. Medieval models had a single string supported by a rectangular bridge with a convex upper surface, which caused a buzzing effect when the string vibrated. The term is also used generically in India and other countries of southern Asia for chordophones of all kinds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinas"@en .

aat:300214558 a skos:Concept ;
    skos:definition "Loose-cut breeches banded at the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knickerbockers"@en .

aat:300214559 a skos:Concept ;
    skos:definition "Very full skirts, either short or long, traditionally made of net or tulle and worn by ballerinas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tutus"@en .

aat:300214561 a skos:Concept ;
    skos:definition "Large squares of cloth, often edged with lace or embroidery, which were wrapped around a swaddled baby during a baptism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bearing cloths"@en .

aat:300214627 a skos:Concept ;
    skos:definition "Any square or strip of linen or other material folded around the neck, often worn as part of a uniform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neckerchiefs"@en .

aat:300214655 a skos:Concept ;
    skos:definition "Skirtlike underwear extending from the waist to near the hemline of the outside skirt. For similar skirtlike underwear which provides fullness at some point use \"petticoats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half slips"@en .

aat:300214681 a skos:Concept ;
    skos:definition "Long cylindrical armor plates to protect the forearms and upper arms, either partially or completely encircling them; they were generally worn in pairs, linked at the elbows by cowters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cannons"@en .

aat:300214705 a skos:Concept ;
    skos:definition "Means of measuring wavelengths of the rays of a spectrum. To refer to the observance of how a substance transmits, emits, or responds to various wavelengths in the electromagnetic energy spectrum, use \"spectroscopy.\" When the word is used in a bound compound term, it may form a synonym for spectroscopy, because the process of observing is not distinguished from the process of measuring; examples are \"infrared spectrometry\" and \"infrared spectroscopy,\" which are considered synonyms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectrometry"@en .

aat:300214708 a skos:Concept ;
    skos:definition "Spectroscopy involving the study of radiant energy by free atoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atomic absorption spectroscopy"@en .

aat:300214718 a skos:Concept ;
    skos:definition "The technique accomplishing the measurement of quantities of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calorimetry"@en .

aat:300214721 a skos:Concept ;
    skos:definition "The separation of chemical substances by making use of differences in the rates at which the substances travel through or along a stationary medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromatography"@en .

aat:300214723 a skos:Concept ;
    skos:definition "Chromatography that depends on the reciprocal transfer of ions between a solution and a resin or other suitable solid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ion-exchange chromatography"@en .

aat:300214724 a skos:Concept ;
    skos:definition "Chromatography using two phases in contact with each other, the mobile phase being a liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquid chromatography"@en .

aat:300214726 a skos:Concept ;
    skos:definition "Chromatography in which glass plates coated with thin layers of alumina, silica gel, or cellulose are used as an adsorbent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thin layer chromatography"@en .

aat:300214729 a skos:Concept ;
    skos:definition "Inferring the date of one thing, as an artifact, a pollen deposit, or a tree ring, from the age of a similar one that has been more firmly dated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-dating"@en .

aat:300214730 a skos:Concept ;
    skos:definition "Joining, by comparatively short connecting units, neighboring chains of atoms in a complex chemical molecule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosslinking"@en .

aat:300214731 a skos:Concept ;
    skos:definition "The action of forming crystals, or a crystalline structure, through a purification process which takes place in many substances while cooling from a state of fusion or solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystallization"@en .

aat:300214735 a skos:Concept ;
    skos:definition "Dissolution into separate parts, used especially of organic materials or of such changes at a molecular level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decomposition"@en .

aat:300214737 a skos:Concept ;
    skos:definition "The act or process of removing or depriving of water; though other liquids may remain. For the process of making free, or nearly free, of liquids, use \"drying.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dehydration"@en .

aat:300214738 a skos:Concept ;
    skos:definition "The removal of minerals, usually from water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demineralization"@en .

aat:300214739 a skos:Concept ;
    skos:definition "A technique for observing the temperature, direction, and magnitude of thermally induced transitions in a material by heating or cooling a sample and comparing its temperature with that of an inert reference material under similar conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "differential thermal analysis"@en .

aat:300214742 a skos:Concept ;
    skos:definition "Act or process of making thinner, more liquid, or less concentrated, as by admixture of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dilution"@en .

aat:300214746 a skos:Concept ;
    skos:definition "Dissolution into separate parts, losing intactness or solidness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disintegration"@en .

aat:300214747 a skos:Concept ;
    skos:definition "The process or method of measuring the dosage of ionizing radiation received over a given period, whether by individuals or materials and whether to assess a health hazard or to date archaeological materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dosimetry"@en .

aat:300214748 a skos:Concept ;
    skos:definition "A white powdery crust formed by extraneous salts evolving on the surface of stone, plaster, ceramics, or another material as the result of water migration and subsequent evaporation. Typical efflorescence on masonry surfaces, mural paintings, and frescoes occurs when moisture dissolves water soluble salts, then migrates to the surface, where the water evaporates leaving a salt residue. Efflorescence crystal growth can result from fluctuations in water vapor pressure that occur with changing humidity and temperature. The salts most commonly found in efflorescence are sulfates, carbonates, and chlorides of sodium, potassium, magnesium, calcium, and iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "efflorescence"@en .

aat:300214750 a skos:Concept ;
    skos:definition "The passage of an electric current through an electrolyte with subsequent migration of positively and negatively charged ions to the negative and positive electrodes. In conservation used for cleaning off surface deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrolysis"@en .

aat:300214764 a skos:Concept ;
    skos:definition "Palls, usually of black, purple, or white velvet, used during the funeral ceremony to cover the coffin, hearse, or tomb. May be decorated with commemorative inscriptions or funerary portraits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral palls"@en .

aat:300214772 a skos:Concept ;
    skos:definition "Textile coverings for communion vessels, used in the Orthodox Eastern Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aëres"@en .

aat:300214816 a skos:Concept ;
    skos:definition "Textile bands used under Torah mantles to hold the scroll together. Among Ashkenazi Jews, the swaddling cloth used at a circumcision would be cut and sewn into a long strip, embroidered and appropriately inscribed, to be used later as a Torah binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torah binders"@en .

aat:300214819 a skos:Concept ;
    skos:definition "Parts or components of firearm locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firearm lock components"@en .

aat:300214839 a skos:Concept ;
    skos:definition "Zitherlike instruments of the White Mountain and San Carlos Apache of Arizona and the Diegueño of California, consisting of a hollowed out mescal or other stalk, either split lengthwise or whole, with one or two horsehair strings stretched over small rectangular bridges, one at each end. They are held horizontally with one end resting on the chest or abdomen, and played with a horsehair bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kízh kízh díhís"@en .

aat:300214840 a skos:Concept ;
    skos:definition "Upholstery that is built up over the seat rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "over-the-rail upholstery"@en .

aat:300214844 a skos:Concept ;
    skos:definition "Bass citterns in use chiefly in France and Germany in the 17th and 18th centuries, patterned on the theorbo, with two peg boxes, one for the on-board strings which were stopped by the fingers, and one for the off-board unstopped strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archcitterns"@en .

aat:300214855 a skos:Concept ;
    skos:definition "Curtains that hang in front of or behind the doors of the Torah ark in a synagogue, often richly embroidered. They are based on the curtains in the ancient Jewish temple, which were used to conceal the Holy of Holies from the people; no one was permitted to enter the area except the high priest once per year on the Day of Atonement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parokhets"@en .

aat:300214891 a skos:Concept ;
    skos:definition "Near Eastern double clarinets with one melody pipe with six fingerholes and one drone pipe, very much longer and with several detachable extensions to vary the pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arghuls"@en .

aat:300214904 a skos:Concept ;
    skos:definition "Pipes which are constituent parts of other aerophones, have fingerholes, and are used to play the melody."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melody pipes"@en .

aat:300214926 a skos:Concept ;
    skos:definition "Linen coverings for the credence, often matching the altar cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credence cloths"@en .

aat:300214961 a skos:Concept ;
    skos:definition "Textile coverings for loaves of bread (hallot), often baked in elaborate plaited forms, used for the Jewish Sabbath and festival meals. Often of linen, and embroidered with religious inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hallah covers"@en .

aat:300214974 a skos:Concept ;
    skos:definition "Textile coverings for the unleavened bread (matzah) eaten during the Jewish Passover festival. Often of linen or silk, and embroidered in silk and metal thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matzah covers"@en .

aat:300215011 a skos:Concept ;
    skos:definition "Refers to a piece of cloth in which a corpse is wrapped for burial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrouds"@en .

aat:300215026 a skos:Concept ;
    skos:definition "Textiles or other materials used as wrappings for parcels, gifts, or articles that need to be put away or carried from one place to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrappers"@en .

aat:300215044 a skos:Concept ;
    skos:definition "Metal whistles traditionally used on ships by boatswain's mates to relay orders or to pipe senior naval officers aboard; they were grasped in the hand when blown, the pitch rising or falling as the hand was opened or closed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boatswains' whistles"@en .

aat:300215061 a skos:Concept ;
    skos:definition "Square textiles used in Japan to wrap presents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fukusa"@en .

aat:300215072 a skos:Concept ;
    skos:definition "Rich pieces of cloth spread upon or over something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palls"@en .

aat:300215082 a skos:Concept ;
    skos:definition "Single-headed frame drums of Ireland, with a membrane of animal skin and a criss-cross arrangement of cord, sticks, or wire over the open end by which they are held with one hand; they are struck by the free hand or alternately by the knobs at each end of the stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodhráns"@en .

aat:300215091 a skos:Concept ;
    skos:definition "Relatively narrow tapestries designed for the space between two windows or doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrefenêtres"@en .

aat:300215142 a skos:Concept ;
    skos:definition "Long linen altar cloths, as wide as the altar top and hanging over the sides, upon which the eucharist is celebrated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fair linen cloths"@en .

aat:300215178 a skos:Concept ;
    skos:definition "Altar cloths used in the Orthodox Eastern Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endytis"@en .

aat:300215185 a skos:Concept ;
    skos:definition "Consecrated corporals of a kind used only in the Greek Rite, analogous to the portable altar of the Roman Rite. It is a linen or silk altar covering into which sacred relics have been sewn. It is required to place the antimension on the altar in Greek churches just as an altar stone is required in the Latin churches, and no Mass may be said upon an altar of that rite which has no antimension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimensia"@en .

aat:300215199 a skos:Concept ;
    skos:definition "Curtains hung on either side of an altar. For curtains hanging behind the altar, use \"dossals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riddels"@en .

aat:300215203 a skos:Concept ;
    skos:definition "Long linen coverings used to cover altar rails during the communion service. Formerly also a long linen towel held in front of the communicants at the celebration of the Eucharist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "houseling cloths"@en .

aat:300215207 a skos:Concept ;
    skos:definition "Huge textile coverings for the Ka‘ba at the Great Mosque in Mecca, used during the period of pilgrimage, with quotations from the Koran either inwoven or embroidered. Replaced each year, they are cut up after the ceremonies and their pieces distributed as relics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiswas"@en .

aat:300215214 a skos:Concept ;
    skos:definition "Large curtains hung in front of the altar during Lent to conceal it from the view of the congregation. The veils are often decorated, for example, stenciled or embroidered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lenten veils"@en .

aat:300215215 a skos:Concept ;
    skos:definition "Movable nuts or pressure bars used in fretted chordophones and pianos to exert downward pressure on some or all of the strings, thereby shortening their speaking length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capotastos"@en .

aat:300215220 a skos:Concept ;
    skos:definition "Antependia or textiles hanging from the front of a pulpit, usually embroidered with appropriate devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulpit falls"@en .

aat:300215225 a skos:Concept ;
    skos:definition "Single-reed reedpipes of conical bore, with the shape of a bassoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caledonicas"@en .

aat:300215230 a skos:Concept ;
    skos:definition "The topmost fixed cover of upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top covers"@en .

aat:300215239 a skos:Concept ;
    skos:definition "Parts or components of upholstery foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstery foundation components"@en .

aat:300215241 a skos:Concept ;
    skos:definition "Layer of coarsely woven, heavyweight textile used in upholstery, fixed over webbing to form a seat cavity and to keep the stuffing from falling through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base cloths"@en .

aat:300215250 a skos:Concept ;
    skos:definition "Loosely woven textile covers for upholstery foundations, used immediately under the top covers, usually to cover springs or layers of stuffing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undercovers"@en .

aat:300215259 a skos:Concept ;
    skos:definition "Firmly stuffed rolls attached to the edges of upholstered seats to make the edges more durable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge rolls"@en .

aat:300215261 a skos:Concept ;
    skos:definition "First layer of stuffing in double-stuffed upholstery foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first stuffing"@en .

aat:300215262 a skos:Concept ;
    skos:definition "Second layer of stuffing in double-stuffed upholstery foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second stuffing"@en .

aat:300215280 a skos:Concept ;
    skos:definition "Computer graphics employing pixels as the display elements, storing data regarding the component pixels for a given image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raster graphics"@en .

aat:300215281 a skos:Concept ;
    skos:definition "Computer graphics employing series of lines as the display elements, storing a list of the coordinates for the starting and ending points of each line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vector graphics"@en .

aat:300215284 a skos:Concept ;
    skos:definition "The use of computer graphics to make large amounts of complex data comprehensible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visualization"@en .

aat:300215301 a skos:Concept ;
    skos:definition "Computer-generated representations of three-dimensional objects by their edges only, often without elimination of lines that would be hidden if the surfaces of the object were opaque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wireframe drawings"@en .

aat:300215302 a skos:Concept ;
    skos:definition "Images created using a binary numerical system electronically stored in the form of encoded picture elements, or pixels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital images"@en .

aat:300215368 a skos:Concept ;
    skos:definition "Books produced by commercial publishers for sale to the general public primarily through bookstores, as distinguished from a textbook edition, subscription book, or a book meant for a limited public because of its technical nature, specialized appeal, or high price."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade books"@en .

aat:300215373 a skos:Concept ;
    skos:definition "Typefaces having relatively light, thin lines; used especially to distinguish from boldface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lightface"@en .

aat:300215389 a skos:Concept ;
    skos:definition "Periodicals containing articles, essays, poems, or other writings by different authors, usually on a variety of topics and intended for a general reading public or treating a particular area of interest for a popular audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magazines"@en .

aat:300215390 a skos:Concept ;
    skos:definition "Periodical publications, particularly those containing scholarly articles or otherwise disseminating information on developments in a particular subject field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "journals"@en .

aat:300215392 a skos:Concept ;
    skos:definition "Native American duct flutes traditionally made of wood or cane, in which the bore is blocked by a partition which forces the airstream out through a hole where an external block, normally of wood tied on to the tube, channels the air along the exterior of the tube to a second hole where it impinges on the voicing edge; traditionally used as a man's solo courting instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courting flutes"@en .

aat:300215446 a skos:Concept ;
    skos:definition "Use generally for single- or double-headed frame drums of the Near East, Central Asia, southern Europe, and parts of Africa, South Asia, and Latin America. The various types are round, square, or octagonal in shape, and may have jingles or snares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duffs"@en .

aat:300215458 a skos:Concept ;
    skos:definition "Single-headed goblet drums of the Islamic Near East and North Africa, made of pottery, wood, or metal, with the bottom open. They are played with the fingers and palms of both hands, held under the arm or resting on the thigh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darabukkas"@en .

aat:300215468 a skos:Concept ;
    skos:definition "Cardboard or plastic boxes used typically for storage or shipping, especially those which are relatively small and that when filled with merchandise are enclosed in a larger or stronger container for transport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartons"@en .

aat:300215479 a skos:Concept ;
    skos:definition "Single-string musical bows of the southern United States, consisting of a length of wire attached to the wall of a frame house, which acts as a resonator; a cotton reel is often used as a bridge. They are plucked with glass bottlenecks or nails. A more portable version replaces the house with a fence picket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diddley bows"@en .

aat:300215505 a skos:Concept ;
    skos:definition "Drinking vessels with usually one elongated spout, but sometimes more, used for feeding children or invalids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biberons"@en .

aat:300215510 a skos:Concept ;
    skos:definition "Coffeepots having separate containers, often in the form of a muslin bag, in which the coffee is immersed while being boiled and usually a stand with a heating device for keeping the coffee warm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biggins"@en .

aat:300215512 a skos:Concept ;
    skos:definition "Oval boxes of light wooden-splint construction used to hold delicate finery or trinkets. Popular in the 18th and 19th century, bride's boxes were given as a marriage gift to brides to hold small items in the bride's trousseau such as linens, lace, and ribbons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brideboxes"@en .

aat:300215516 a skos:Concept ;
    skos:definition "Rectangular trays with sides; one common design includes hinged sides of curved profile that may be folded up to form sides for the tray; may also have attached folding legs or an accompanying stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butler's trays"@en .

aat:300215521 a skos:Concept ;
    skos:definition "Small bags with secure closings intended primarily for holding coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coin purses"@en .

aat:300215522 a skos:Concept ;
    skos:definition "Ceramic griddles used to bake tortillas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comals"@en .

aat:300215523 a skos:Concept ;
    skos:definition "Footed dessert dishes having a wide but shallow bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupes"@en .

aat:300215524 a skos:Concept ;
    skos:definition "Small coupes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupettes"@en .

aat:300215526 a skos:Concept ;
    skos:definition "Small pail-like vessels used for holding and serving cream, generally made of porcelain or silver, the latter sometimes having a glass liner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream pails"@en .

aat:300215528 a skos:Concept ;
    skos:definition "Small boxes used especially by sailors to hold thread, needles, tape, or other small articles of gear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ditty boxes"@en .

aat:300215531 a skos:Concept ;
    skos:definition "Boxes in which papers, letters, or other documents are arranged in convenient order for storage or reference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "file boxes"@en .

aat:300215533 a skos:Concept ;
    skos:definition "Small trunks designed to be kept at the foot of a bed, especially to contain a soldier's personal effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footlockers"@en .

aat:300215540 a skos:Concept ;
    skos:definition "Small rectangular suitcases hinged to open into two compartments of equal size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gladstone bags"@en .

aat:300215543 a skos:Concept ;
    skos:definition "Rigid, boxlike containers, usually large and often reinforced, for packing clothing and other personal gear or articles for travel or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trunks"@en .

aat:300215545 a skos:Concept ;
    skos:definition "Bags carried by hand and designed to hold a traveler's clothes and other personal articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling bags"@en .

aat:300215547 a skos:Concept ;
    skos:definition "Large two-handled open-topped bags, often of canvas, used especially for carrying small packages. Also, handbags or luggage of leather or another material, having the same basic design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tote bags"@en .

aat:300215550 a skos:Concept ;
    skos:definition "Strong bags, usually paper or plastic, with handles, used to carry purchases or belongings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shopping bags"@en .

aat:300215553 a skos:Concept ;
    skos:definition "Any of various boxlike containers intended primarily for holding stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamp boxes"@en .

aat:300215554 a skos:Concept ;
    skos:definition "Bags for money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moneybags"@en .

aat:300215555 a skos:Concept ;
    skos:definition "Rectangular, usually leather, traveling bags with sides that come together and fasten at the top or open to the full width of the bag and with two straps that wrap around the bag to secure it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kit bags"@en .

aat:300215556 a skos:Concept ;
    skos:definition "Containers primarily intended for holding glue or in which glue is melted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gluepots"@en .

aat:300215558 a skos:Concept ;
    skos:definition "Containers for holding hair collected from the owner's hair brush, especially bowls with covers which have a hole in their center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair receivers"@en .

aat:300215560 a skos:Concept ;
    skos:definition "Drinking glass of a distinctive type, intended to be used for German white Rhine wines, which were called \"hock\" in Britain in the 19th century. The glasses have a round foot, tall stem, and small- to medium-sized bowl, often colored, and generally globular in shape with or without a flared lip. The most frequent bowl color is light green with gilt or cut decorations. Later examples have a clear bowl, but a colored stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hock glasses"@en .

aat:300215561 a skos:Concept ;
    skos:definition "Champagne glasses with hollow stems intended to keep the champagne bubbling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hollow stem champagnes"@en .

aat:300215562 a skos:Concept ;
    skos:definition "Trays with molds to be filled with water and then frozen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice cube trays"@en .

aat:300215567 a skos:Concept ;
    skos:definition "Tall drinking glasses intended primarily for lemonade; of a type which first appeared in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemonade glasses"@en .

aat:300215568 a skos:Concept ;
    skos:definition "A type of English drinking glass for drinking mead. The form of the glass is controversial, but the type traditionally but dubiously associated with mead drinking has a shallow globular bowl with a slightly inverted rim, set on a stemmed foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mead glasses"@en .

aat:300215571 a skos:Concept ;
    skos:definition "Iranian darabukkas, often carved from a single block of wood and decorated with an inlay design, constituting the principal percussion instrument in classical Iranian music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dombaks"@en .

aat:300215572 a skos:Concept ;
    skos:definition "Brazilian musical bows of African origin, with a single wire string and sometimes a coconut or gourd resonator, held against the chest during play. One hand holds the bow and occasionally applies a metal coin to the string to alter its pitch, while the other strikes it with a stick; normally the striking hand holds or has attached to it a rattle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berimbaus"@en .

aat:300215583 a skos:Concept ;
    skos:definition "Footed dishes with some type of holding device for retaining a halved orange for eating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange cups"@en .

aat:300215585 a skos:Concept ;
    skos:definition "Cups which attach to a painter's palette and are used for holding small quantities of medium or solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palette cups"@en .

aat:300215587 a skos:Concept ;
    skos:definition "Small pans for baking little pies, commonly referred to as patties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patty pans"@en .

aat:300215591 a skos:Concept ;
    skos:definition "Large casks of varying capacity, but usually 80 gallons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puncheons"@en .

aat:300215595 a skos:Concept ;
    skos:definition "Small kegs which originally held 18 gallons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rundlets"@en .

aat:300215604 a skos:Concept ;
    skos:definition "Covered boxes intended primarily for serving sardines; often of silver or silverplate with glass inserts, glass with silver or silverplate lids or frames, or ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sardine boxes"@en .

aat:300215608 a skos:Concept ;
    skos:definition "Cylindrical containers used in ancient Rome to hold papyrus rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrinia"@en .

aat:300215613 a skos:Concept ;
    skos:definition "Mugs, often with an interior divider to hold a shaving brush, intended primarily for use when shaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving mugs"@en .

aat:300215615 a skos:Concept ;
    skos:definition "Tall, multitiered vessels consisting of three globe-shaped bottles, each meant to be filled with a different colored liquid (usually water); set in windows or on the counters of apothecary shops in the 19th century to attract customers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "show globes"@en .

aat:300215616 a skos:Concept ;
    skos:definition "Large jars or pails for collecting household slop for disposal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slop jars"@en .

aat:300215617 a skos:Concept ;
    skos:definition "Dishlike containers for holding soap, especially bathroom or kitchen accessories or fixtures; may be lidded. For small boxes or perforated globular containers used to hold a ball or bar of soap, use \"soap boxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soap dishes"@en .

aat:300215618 a skos:Concept ;
    skos:definition "Large containers, often of metal, with a wide rim or a funnel-shaped mouth, serving as receptacles for spit, especially from chewing tobacco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spittoons"@en .

aat:300215619 a skos:Concept ;
    skos:definition "Ancient Japanese bronze bells of the Yayoi period, elliptical in cross-section with pointed ends, and in profile a tall trapezoid with a flat top, surmounted by a wide metal loop for suspension. They were cast in one piece, were highly decorated, and are believed to have served a ritual or symbolic rather than strictly musical function. A few surviving examples show signs of having held clappers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dotaku"@en .

aat:300215666 a skos:Concept ;
    skos:definition "Four-wheeled enclosed carriages characterized by roofs with fixed pillars, suspended bodies, and facing transverse seats accommodating four or six passengers; designed in the mid-15th century in Hungary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaches"@en .

aat:300215684 a skos:Concept ;
    skos:definition "Horse-drawn vehicles designed to transport people, that have four wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "four-wheeled carriages"@en .

aat:300215685 a skos:Concept ;
    skos:definition "Horse-drawn vehicles designed to transport people, that have two wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-wheeled carriages"@en .

aat:300215697 a skos:Concept ;
    skos:definition "Light, two-wheeled carriages generally pulled by a single horse, hung by braces from the springs and used for pleasure driving; mostly of the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gigs"@en .

aat:300215702 a skos:Concept ;
    skos:definition "Light one-horse sleighs with a single seatboard for two or three passengers; developed in the United States around 1800."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutters"@en .

aat:300215710 a skos:Concept ;
    skos:definition "Heavily constructed four-wheeled vehicles, usually designed to carry bulk commodities and heavy loads, primarily in agricultural and commercial contexts; generally characterized as boxes set on running gear and more substantial than carts. Known since the 3rd millennium BCE. During the early 19th century some versions were adapted for passenger travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wagons"@en .

aat:300215718 a skos:Concept ;
    skos:definition "Platters having a depressed well at one end for holding gravy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "well platters"@en .

aat:300215720 a skos:Concept ;
    skos:definition "Vessels intended to hold or dispense tea, of varying form but having a spigot rather than a spout; usually supported on legs or a stand and may have a heating device. May be part of a tea service. Prefer \"hot water urns\" for urnlike vessels intended to hold or dispense hot water in connection with the serving of tea and which also may be part of a tea service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea urns"@en .

aat:300215736 a skos:Concept ;
    skos:definition "Metal, often copper, urn-shaped vessels, with a spigot at the base and interior tubes for hot coals; used to boil water for tea. Term used especially with reference to Russian types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samovars"@en .

aat:300215737 a skos:Concept ;
    skos:definition "Toy banks in which a coin is deposited by a mechanical process that is usually activated by pushing a lever."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical banks"@en .

aat:300215738 a skos:Concept ;
    skos:definition "Containers used for ceremonial celebrations or eulogies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative containers"@en .

aat:300215739 a skos:Concept ;
    skos:definition "Silver or gold boxes or caskets, usually rectangular in form but sometimes circular or oval, which are given to a person granted the freedom of, for example, a city, town, or college. Usually engraved, chased, or enameled with the coat of arms of the recipient and donor, and often an appropriate inscription."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freedom boxes"@en .

aat:300215742 a skos:Concept ;
    skos:definition "Removable handles used to lift lids in a kitchen range or stove."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove lifters"@en .

aat:300215743 a skos:Concept ;
    skos:definition "Thick flexible pads, as for example of quilted or crocheted textile, used to protect the hands against hot cookware or utensils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potholders"@en .

aat:300215744 a skos:Concept ;
    skos:definition "Boards, usually wooden, on which dough is kneaded or rolled and bread is cooled and cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breadboards"@en .

aat:300215745 a skos:Concept ;
    skos:definition "Trays or gridded racks used for drying fruits or nuts; traditionally made of natural fibers or wooden slats woven with open spaces for air circulation, and may have a handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drying trays"@en .

aat:300215746 a skos:Concept ;
    skos:definition "Spoons with pierced bowls used to separate solids from liquids when serving or eating, or to skim liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strainer spoons"@en .

aat:300215747 a skos:Concept ;
    skos:definition "Spoons of various forms, designed to administer liquid medicine and having calibration or otherwise indicating the amount contained in the spoon. One common form is a handle having a bowl on both ends, one measuring a tablespoon and the other a teaspoon. Another form is a glass or porcelain oblong cup with a spout for pouring into the mouth and a handle. Modern forms may be of plastic, of various shapes and designs to allow deposit of the medicine in the mouth of a child or invalid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine spoons"@en .

aat:300215748 a skos:Concept ;
    skos:definition "Containers or spaces maintained at a low temperature by means of ice or mechanical apparatus for the purpose of preserving its contents, especially food or drink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refrigerators"@en .

aat:300215749 a skos:Concept ;
    skos:definition "Machines or rooms used for freezing and preserving items such as food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freezers"@en .

aat:300215751 a skos:Concept ;
    skos:definition "Mechanical pitters designed specifically to remove stones from cherries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherry stoners"@en .

aat:300215754 a skos:Concept ;
    skos:definition "Insulated cabinets or boxes having a compartment for ice and used for refrigeration of food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iceboxes"@en .

aat:300215755 a skos:Concept ;
    skos:definition "Devices intended primarily for mixing ingredients and kneading bread dough; used especially with reference to pail-like containers with large, hand-cranked kneading paddles or blades; also, for electrical devices that mix, knead, and bake bread dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread makers"@en .

aat:300215756 a skos:Concept ;
    skos:definition "Devices intended primarily for mixing cake batter; used especially with reference to manually operated mixers with hand-cranked gears attached across the top of a straight-sided container."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake mixers"@en .

aat:300215757 a skos:Concept ;
    skos:definition "Hand-held electrical appliances having one or more beaters and used in mixing, beating, or creaming food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand mixers"@en .

aat:300215822 a skos:Concept ;
    skos:definition "Men's loose-skirted wraps worn informally from the 17th to early 19th century; so called from their resemblance to similar garments worn by Banyans, a caste of Hindu merchants. Also refers to women's garments based on the men's banyan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banyans"@en .

aat:300215829 a skos:Concept ;
    skos:definition "Zitherlike chordophones of France having a long, slightly tapered shallow soundbox with one heart-shaped and one roseate sound hole and five strings, two of which are melody and three are drones. The melody strings, running over fixed frets, are stopped in unison by a small stick held in the left hand as the right hand strums all five strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "épinettes des Vosges"@en .

aat:300215853 a skos:Concept ;
    skos:definition "Those strings, among all those on an instrument, on which the melody of a piece of music is played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melody strings"@en .

aat:300215854 a skos:Concept ;
    skos:definition "Tools to make ice shavings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice shavers"@en .

aat:300215860 a skos:Concept ;
    skos:definition "Stiff panels, usually triangular in shape and often heavily decorated, inserted in an open bodice to cover the corset."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stomachers"@en .

aat:300215863 a skos:Concept ;
    skos:definition "Boards often of wood and sometimes of plastic or other synthetic material, used as firm surfaces for cutting food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting boards"@en .

aat:300215867 a skos:Concept ;
    skos:definition "Specialized garments intended for exercise, made in a variety of forms since the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gym suits"@en .

aat:300215869 a skos:Concept ;
    skos:definition "Coordinated costume for horseback riding, usually consisting of a jacket or coat, skirt or breeches or jodhpurs, and vest. Varies in degree of formality. Usually worn with stock-tied shirt, cap or hat, and riding boots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding habits"@en .

aat:300215870 a skos:Concept ;
    skos:definition "Very long, elliptical neckpieces made of feathers, fur, or similar fluffy materials, especially popular in the 1890s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boas"@en .

aat:300215879 a skos:Concept ;
    skos:definition "Strings which produce a single low tone when played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drone strings"@en .

aat:300215902 a skos:Concept ;
    skos:definition "Short-necked, bottle-shaped fiddles of Ossetia in the Caucasus, carved of a single piece of wood. There are two to three strings, and the neck may be fretted or not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fandurs"@en .

aat:300215911 a skos:Concept ;
    skos:definition "Flutes in use primarily in 18th-century Europe, ranging a minor third below the standard range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flûtes d'amour"@en .

aat:300215925 a skos:Concept ;
    skos:definition "Single-headed struck drums having legs or a projecting piece affixed to or cut from the body, most commonly found among the native peoples of North America, Africa, and Oceania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footed drums"@en .

aat:300215937 a skos:Concept ;
    skos:definition "One-piece, skin-tight combination garments with short or long legs and with or without sleeves that leave the wearer's legs either fully or partially exposed. Worn, for example, by acrobats and dancers. For heavy, opaque pantyhose, use \"tights (opaque stockings).\" Distinguished from \"cat suits\", which are designed for everyday wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leotards"@en .

aat:300215942 a skos:Concept ;
    skos:definition "Loose-fitting one- or two-piece garments consisting of short or long trousers and a shirt or pullover top, worn especially for sleeping or lounging around the house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pajamas"@en .

aat:300216024 a skos:Concept ;
    skos:definition "Half-sleeved or sleeveless tunics worn as ecclesiastical vestments before the 4th century. Also, similar garments worn by monks and by kings as coronation robes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colobia"@en .

aat:300216025 a skos:Concept ;
    skos:definition "Close-fitting underwear combining a shirt and drawers in one piece and often having a drop seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "union suits"@en .

aat:300216035 a skos:Concept ;
    skos:definition "Ties or laces, as of leather or ribbon, finished with metal tabs or aglets at the ends. Originally used to fasten together parts of costume; later, tied in bows and used for trimming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "points"@en .

aat:300216043 a skos:Concept ;
    skos:definition "Narrow bands or fillets, often of soft material, worn by women to bind the hair or as part of a head-dress, particularly when tied horizontally around the top of the head, across the forehead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandeaux"@en .

aat:300216045 a skos:Concept ;
    skos:definition "Indonesian xylophones, consisting of from 16 to 21 wood or bamboo slabs laid stepwise in pitch order on a cloth over a carved wood trough and held in place by metal pins. They are played with two padded hammers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gambang kayu"@en .

aat:300216049 a skos:Concept ;
    skos:definition "Close-fitting extensions of the hose which cover the leg below the kneecap; worn by men during the Elizabethan and Jacobean periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canions"@en .

aat:300216050 a skos:Concept ;
    skos:definition "Refers to loose garments, generally garments that cover the upper body, the term being derived from an old English word for shirt or chemise. It can refer to loose, outer garments designed to protect more valuable attire from soil or paint. It can also refer to loose undergarments, which were often gathered or embroidered at the neck and sleeves and were originally intended to protect more valuable outer garments from perspiration and other bodily soil and fluids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smocks"@en .

aat:300216052 a skos:Concept ;
    skos:definition "Semiformal evening suits consisting of a dinner jacket and trousers, the trousers having a stripe of material, such as silk or faille, down the outside of the legs. May also include a bow tie, cummerbund, and a shirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuxedoes"@en .

aat:300216053 a skos:Concept ;
    skos:definition "Close-fitting main garments extending to below the waistline. Usually front buttoning and sleeveless, but may have sleeves, especially garments from the 18th century. Worn over a shirt and under a coat or jacket. For close-fitting main garments extending to the waist or just below that are sleeveless and usually collarless, use \"vests (garments).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waistcoats"@en .

aat:300216054 a skos:Concept ;
    skos:definition "Small bags suspended from a belt or waistband; popular from the mid- to the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chatelaine bags"@en .

aat:300216057 a skos:Concept ;
    skos:definition "Costume comprised of one or more pieces of matching or coordinated fabrics, especially those designed for a particular activity or occasion, such as a tennis outfit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outfits"@en .

aat:300216063 a skos:Concept ;
    skos:definition "Aircraft that are supported by giving the surrounding air a momentum in the downward direction equal to the weight of the aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heavier than air aircraft"@en .

aat:300216066 a skos:Concept ;
    skos:definition "Aircraft weighing less than the air they displace, sustaining lift by displacing the air using aerostatic bouyancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighter than air aircraft"@en .

aat:300216073 a skos:Concept ;
    skos:definition "Yugoslavian fiddles with a skin belly and usually a single string, rarely two, of twisted horsehair which the player stops with his fingers from the side with lateral pressure, in the absence of a fingerboard. They are played held between the knees or in the lap, with a curved bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gusles"@en .

aat:300216076 a skos:Concept ;
    skos:definition "Aircraft with unpowered horizontally placed rotors which provide lift, akin to those on helicopters, and conventional engine-driven propellers that pull the vehicles forward, as on airplanes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autogiros"@en .

aat:300216079 a skos:Concept ;
    skos:definition "Thin strips, as of whalebone, steel, or wood, worn in front of a corset or stays for stiffening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "busks"@en .

aat:300216136 a skos:Concept ;
    skos:definition "Keyed monochords developed in France in the 1880s, having an oval body, 29 keys set on the neck, and a single string made of horsehair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monocordes à clavier"@en .

aat:300216149 a skos:Concept ;
    skos:definition "Classical drums of southern India, of elongated barrel shape with two heads of different diameters, fastened to hoops and laced to the body. The heads are tuned by tension wedges and the application of paste to the membranes, the larger, left head being tuned an octave below the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mrdangams"@en .

aat:300216195 a skos:Concept ;
    skos:definition "Pieces of cloth, usually square, varying in size and material, carried for usefulness or as a costume accessory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handkerchiefs"@en .

aat:300216264 a skos:Concept ;
    skos:definition "Belts, usually of leather, worn at the waist with an additional strap worn diagonally over the right shoulder. Worn originally as part of United States military uniforms to support a sword and carry a pistol holster and now also by other para-military officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sam Browne belts"@en .

aat:300216347 a skos:Concept ;
    skos:definition "Refers to the space allowed for each line of type on typewriters, typesetters, printers, or other devices not involving metal type. For the extra spacing between lines of metal type, use \"leading (spacing).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line spacing"@en .

aat:300216398 a skos:Concept ;
    skos:definition "Horse-drawn coaches available for public hire, usually seating between two and six passengers with the driver riding outside; in operation from the 17th to the late 19th century. For automobiles licensed to carry passengers for hire, use \"taxicabs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hackney coaches"@en .

aat:300216402 a skos:Concept ;
    skos:definition "Vehicles consisting of a platform mounted on parallel runners for transporting goods or passengers over snow or ice and usually pulled by animal locomotion or operating by gravity; for similar, but usually more elaborate, vehicles used primarily for the conveyance of passengers and normally pulled by horses, use \"sleighs\" or, if pulled by dogs, use \"dogsleds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleds"@en .

aat:300216559 a skos:Concept ;
    skos:definition "Upper surfaces of the soundboxes of chordophones over which the strings pass and which play a major part in transmitting the vibration of the strings to the surrounding atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellies"@en .

aat:300216564 a skos:Concept ;
    skos:definition "End-blown flutes of the Balkan region and Turkey, usually made of softwood or cane, with a cylindrical bore and a regionally varying number of fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kavals"@en .

aat:300216566 a skos:Concept ;
    skos:definition "Goblet drums of Bulgaria and Yugoslavia, with a shell of baked clay and a single head of animal skin attached with fine hemp string, usually held under the left arm and struck with the fingers of both hands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarabukas"@en .

aat:300216567 a skos:Concept ;
    skos:definition "General term for all double-headed laced drums, cylindrical or conical, of Java and Bali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kendhang"@en .

aat:300216572 a skos:Concept ;
    skos:definition "Upright grand pianos developed in the early 19th century, having the form of a classical lyre with symmetrically arched sides and ornamental gilt rods imitating the lyre strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyraflügels"@en .

aat:300216573 a skos:Concept ;
    skos:definition "Protective bed curtains, running on a separate outer rod, enclosing beds and their hangings when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "case curtains"@en .

aat:300216577 a skos:Concept ;
    skos:definition "Fiddles of India with the soundbox in the shape of a peacock, the long tail forming the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mayuris"@en .

aat:300216582 a skos:Concept ;
    skos:definition "Long tube zithers of Myanmar (formerly Burma) and Assam carved to represent a crocodile, made of wood and lacquered, with three metal strings and from eight to eleven movable frets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "migyaun"@en .

aat:300216584 a skos:Concept ;
    skos:definition "Chinese slit drums in the abstract shape of a fish, squat and wedge-shaped, carved from camphor wood and usually lacquered. They rest on the player's hand or a cushion and are struck with sticks during Buddhist or Taoist temple services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muyu"@en .

aat:300216586 a skos:Concept ;
    skos:definition "Vessels designed for the bulk transport of liquid cargo, particulary petroleum products, usually in large full-width compartments in the hull."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tankers"@en .

aat:300216587 a skos:Concept ;
    skos:definition "Small tsuzumi with relatively loose lacing, held by the left hand over the right shoulder during play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kotsuzumi"@en .

aat:300216588 a skos:Concept ;
    skos:definition "Large tsuzumi held at the left hip and struck with the fingers of the right hand during play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "otsuzumi"@en .

aat:300216589 a skos:Concept ;
    skos:definition "Five-string viols with a very high range, used primarily in the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pardessus de viole"@en .

aat:300216590 a skos:Concept ;
    skos:definition "End-blown fipple flutes of the Andes, made of cane, bone, or wood, with a regionally varying number of fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pincullos"@en .

aat:300216593 a skos:Concept ;
    skos:definition "Short-necked lutelike chordophones of China, with a pear-shaped body, four silk or nylon strings, and from ten to twenty-four frets on the neck and belly. They are held upright resting on the lap or thigh, and plucked with the fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipa"@en .

aat:300216604 a skos:Concept ;
    skos:definition "Side-blown ivory trumpets of the Democratic Republic of Congo and Angola, used for signalling in hunting and warfare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ponges"@en .

aat:300216605 a skos:Concept ;
    skos:definition "Double clarinets of India and Ceylon, consisting of two parallel pipes each with a single beating reed and a regionally variable number of fingerholes, fitted into a globular gourd made airtight with wax which acts as both blowpipe and wind chamber. Usually the right pipe serves as a melody pipe and the left as a drone pipe with its holes plugged as required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pungis"@en .

aat:300216608 a skos:Concept ;
    skos:definition "The ensembles of chessboard and chessmen needed to play the game of chess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chess sets"@en .

aat:300216610 a skos:Concept ;
    skos:definition "Gameboards of 64 squares arranged in eight vertical rows called files and eight horizontal rows called ranks. These squares alternate between two colors: one light, such as white or beige; and the other dark, such as black or green. The board is set between the two opponents so that each player has a light-colored square at the right-hand corner. Chessboards are identical to checkerboards except for the colors, which tend to be black and red in checkerboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chessboards"@en .

aat:300216611 a skos:Concept ;
    skos:definition "Period term referring to both bedcovers and bed hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed furniture"@en .

aat:300216616 a skos:Concept ;
    skos:definition "Linens used in setting a table for dining, such as tablecloths and napkins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table linens"@en .

aat:300216626 a skos:Concept ;
    skos:definition "Cloths used in the kitchen for washing dishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dishcloths"@en .

aat:300216632 a skos:Concept ;
    skos:definition "Rectangular pieces of cloth, paper, or other absorbent material, used for wiping or drying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towels"@en .

aat:300216634 a skos:Concept ;
    skos:definition "Large towels used to dry the body after bathing, typically made of an absorbent material such as heavy cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bath towels"@en .

aat:300216638 a skos:Concept ;
    skos:definition "Towels for drying dishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dish towels"@en .

aat:300216644 a skos:Concept ;
    skos:definition "Relatively small pieces of cloth or paper used for wiping the mouth and hands and protecting clothes while dining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napkins"@en .

aat:300216653 a skos:Concept ;
    skos:definition "Relatively small, rectangular linen cloths used by the celebrant for wiping the Eucharistic vessel after each communicant has drunk from it and to wipe the chalice and paten after the ablutions that follow Communion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purificators"@en .

aat:300216655 a skos:Concept ;
    skos:definition "Decorative, embroidered towels made to hang over everyday towels; produced by Pennsylvania Germanic women, primarily between 1820-1850."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "show towels"@en .

aat:300216691 a skos:Concept ;
    skos:definition "Covers, often made of cloth, used over tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table coverings"@en .

aat:300216697 a skos:Concept ;
    skos:definition "A Persian term for rugs measuring approximately 5 1/2 by 3 1/2 feet, or 1 1/2 zars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zaronims"@en .

aat:300216721 a skos:Concept ;
    skos:definition "Long, end-blown lip-vibrated aerophones of the Indian subcontinent, crescent- or S-shaped, with a conical bore, either a single or a double bell, and no fingerholes or valves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranasringas"@en .

aat:300216722 a skos:Concept ;
    skos:definition "End-blown trumpets of Tibet, made from a conch shell usually fitted with a metal mouthpiece and bell, commonly played in pairs during Buddhist rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dung-dkar"@en .

aat:300216724 a skos:Concept ;
    skos:definition "Electronic percussion instruments developed in the 1930s, involving a series of rotating wheels that interrupt beams of light to produce complex rhythms very precisely, controlled from a keyboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhythmicons"@en .

aat:300216728 a skos:Concept ;
    skos:definition "Japanese transverse flutes used in court music and some folk dances, made from a single tube of bamboo. They resemble the \"nokan\" in having seven equidistant fingerholes, a balancing weight in the upper end, a red-lacquered bore, and a wrapping of bark or twine, but are distinct in having a patch of ornament embroidered on a red ground on the upper end and in lacking the nokan's characteristic tube inserted into the bore between the mouth hole and nearest fingerhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ryuteki"@en .

aat:300216736 a skos:Concept ;
    skos:definition "A form of pajamas in which exposed panties match the fabric of a hip-length top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby doll pajamas"@en .

aat:300216737 a skos:Concept ;
    skos:definition "Containers of varying form but having a perforated top, used to contain and dispense the fine sand sprinkled on wet ink to blot it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanders"@en .

aat:300216738 a skos:Concept ;
    skos:definition "Women's scarves of some light fabric, often white and sheer, draped around the neck and shoulders and tied in a knot with ends hanging loosely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fichus"@en .

aat:300216739 a skos:Concept ;
    skos:definition "Flat pouches of fabric with a bound slit in the outer surface, which is worn suspended from ties which fasten around the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pockets"@en .

aat:300216740 a skos:Concept ;
    skos:definition "Frames or oval hoops worn to extend a woman's skirt at the side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panniers"@en .

aat:300216741 a skos:Concept ;
    skos:definition "Heeled shoes or slippers with only a vamp, or front portion, and no quarters or back portion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mules"@en .

aat:300216743 a skos:Concept ;
    skos:definition "Pullover sweaters with a high, close-fitting band collar, which is often rolled or turned down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turtleneck sweaters"@en .

aat:300216763 a skos:Concept ;
    skos:definition "Decorative attachments resembling suspenders, with shaped straps which pass over each shoulder, and sometimes connect to a matching waistband. The straps are sometimes connected by horizontal bands across the chest or back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bretelles"@en .

aat:300216766 a skos:Concept ;
    skos:definition "Short girdles, designed to accentuate a small waist, starting at the ribs and stopping above the hips, sometimes with attached supporters for stockings. For narrow elastic or fabric bands worn around the waist or hips with supporters for stockings use \"garter belts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waist cinchers"@en .

aat:300216830 a skos:Concept ;
    skos:definition "Child's one- or two-piece outer garments for cold weather, often consisting of heavily lined pants and jacket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snowsuits"@en .

aat:300216831 a skos:Concept ;
    skos:definition "Any of various garments, as loose blouses, jump suits, caftans, or sarongs, worn over a swimsuit, exercise clothing, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coverups"@en .

aat:300216832 a skos:Concept ;
    skos:definition "In general, refers to women's blouses having a center front button or stud placket opening, cuffs, and a collar, imitating the details of a man's shirt; may also have more feminine details, such as puffed sleeves, embroidery or lace, and other decoration. Specifically, refers to a particular type of ladies' bodice of a dress or a blouse having certain man-tailored details, in fashion from the early nineteenth century through the Edwardian period. Formerly the term referred to a similar garment worn by men and boys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirtwaists"@en .

aat:300216842 a skos:Concept ;
    skos:definition "Long, lightweight coatlike overgarments worn in the early 20th century to protect the wearer from dust, especially while riding in automobiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dusters"@en .

aat:300216844 a skos:Concept ;
    skos:definition "Full length, one piece main garments worn privately in the house instead of a dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrappers"@en .

aat:300216846 a skos:Concept ;
    skos:definition "Shaped pieces of absorbent and rubberized or plastic-coated materials often padded or occasionally filled with deodorizing herbs; attached to or placed inside a garment, as in the underarm of a dress or blouse, to prevent the garment from being soiled by perspiration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress shields"@en .

aat:300216863 a skos:Concept ;
    skos:definition "Small fabric inserts, worn with main dress to simulate a vest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestees"@en .

aat:300216864 a skos:Concept ;
    skos:definition "Refers to long bands or strips of fabric wrapped around the waist or worn over the shoulder or hips and typically tied, rather than secured with fasteners. They are worn as accessories, honorary symbols, or as part of a military uniform to denote rank or affiliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sashes"@en .

aat:300216871 a skos:Concept ;
    skos:definition "Sashes of varying widths and sometimes stiffened, tied around the waist in intricate patterns of bows and knots usually at the back, but also in front, worn over a kimono; also, similar sashes worn for fashionable dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obis"@en .

aat:300216936 a skos:Concept ;
    skos:definition "Ornamental or symbolic pendent scarves or veils attached to knights' helmets or ladies' headdresses such as hennins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cointises"@en .

aat:300216942 a skos:Concept ;
    skos:definition "Very small women's bags for carrying personal articles, often of soft materials or beadwork, originally with a drawstring closure and carried around the wrist or in the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reticules"@en .

aat:300216943 a skos:Concept ;
    skos:definition "Hexagonal leather pouches suspended by long straps from the sword belt of a cavalry officer; also, fashionable bags in a similar shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabrataches"@en .

aat:300216945 a skos:Concept ;
    skos:definition "Medium-sized bags suspended at the top corners from one or two long straps, designed to be suspended from one shoulder or across the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder bags"@en .

aat:300216947 a skos:Concept ;
    skos:definition "Circular bands of white wool with pendants of the same material in the front and the back; worn in the Latin rite by a pope and conferred by him on archbishops as a symbol of office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palliums"@en .

aat:300216948 a skos:Concept ;
    skos:definition "Closed-front, sometimes laced ankle boots introduced in the mid-19th century and characterized by the vamp wings being extended along either side to form a galosh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balmorals"@en .

aat:300216949 a skos:Concept ;
    skos:definition "Round, flat caps with the crown projecting on all sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balmorals"@en .

aat:300216950 a skos:Concept ;
    skos:definition "Very full, ankle-length petticoats of gray or white horsehair, worn to hold out the skirt before and in place of the cage crinoline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balmorals"@en .

aat:300216951 a skos:Concept ;
    skos:definition "Large, rectangular mantles worn by men in ancient Greece and Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palliums"@en .

aat:300216952 a skos:Concept ;
    skos:definition "Flowers or small bouquets worn, usually by a man, in the buttonhole of the lapel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boutonnieres"@en .

aat:300216953 a skos:Concept ;
    skos:definition "Petticoats of linen stiffened by gum or paste; worn in the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "criardes"@en .

aat:300216954 a skos:Concept ;
    skos:definition "Loose, ankle-length trousers that are gathered or otherwise relatively tight around the ankles. They are worn by both men and women in India and Southeast Asia; often worn with a tunic-like over-garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shalwar"@en .

aat:300216955 a skos:Concept ;
    skos:definition "Metal utensils for baking or roasting having one open side that is placed close to a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflector ovens"@en .

aat:300216956 a skos:Concept ;
    skos:definition "Reflector ovens specifically designed for roasting fowl, with hooks to hold the bird and a drip pan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird roasters"@en .

aat:300216957 a skos:Concept ;
    skos:definition "Reflector ovens equipped with a spit and, in the back, a door used to watch or tend to the meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin kitchens"@en .

aat:300216958 a skos:Concept ;
    skos:definition "Stands, supports, or flat devices, usually with long or short feet, often three, but sometimes with none and which may also have a handle, used to elevate a vessel in a hearth while cooking or to protect a surface, as of a table or counter, from being damaged by the heat of a hot object, such as a cooking vessel or flatiron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trivets"@en .

aat:300216960 a skos:Concept ;
    skos:definition "Machines consisting of a can within a tub used for making ice cream. The cream mixture is poured into the can then frozen and stirred as the can is rotated, either manually or by power, within the ice- and salt-filled tub."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream freezers"@en .

aat:300216962 a skos:Concept ;
    skos:definition "Earthenware or similar fireproof vessels in which food is baked and served."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrines"@en .

aat:300216963 a skos:Concept ;
    skos:definition "Small covered tureens, sometimes with a conforming stand, for serving sauce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sauce tureens"@en .

aat:300216964 a skos:Concept ;
    skos:definition "Large, covered tureens intended primarily for serving soup. Generally rests on a spreading foot or on three or four short legs, and is sometimes accompanied by a stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soup tureens"@en .

aat:300216965 a skos:Concept ;
    skos:definition "Shallow dishes placed alongside a dinner plate for the bones and other remains of an elaborate meal. Often included as part of a standard place setting in the 19th century; often having a crescent shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone dishes"@en .

aat:300216967 a skos:Concept ;
    skos:definition "Trays, of glass or ceramic, for serving ice cream; sometimes made in sets with matching shallow bowls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice cream trays"@en .

aat:300216968 a skos:Concept ;
    skos:definition "Drinking vessels distinguished by having two spouts: a short one for filling and a long one through which the liquid is poured into the mouth without the spout touching the lips of the drinker. Well known examples were developed in Catalonia, Spain; they are also known in former colonial areas of Spain in Latin America, and among indigenous people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantirs"@en .

aat:300216970 a skos:Concept ;
    skos:definition "Term applied to tinplate containers with a cover or lid used for packaging biscuits, crackers, tobacco, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tins"@en .

aat:300216971 a skos:Concept ;
    skos:definition "Shallow cuplike vessels with two side handles intended primarily for serving bouillon; often accompanied by a matching saucer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouillon cups"@en .

aat:300216972 a skos:Concept ;
    skos:definition "Artificial ponds or tanks, often with glass sides, in which aquatic plants and animals are kept alive for purposes of observation and study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquariums"@en .

aat:300217060 a skos:Concept ;
    skos:definition "Bamboo clappers of Hawaii made by cutting most of a length of bamboo into narrow longitudinal strips, stopping short of one end with a natural node which serves as a handle. They are struck against the palm of the free hand or other part of the body like a switch, struck in pairs against each other, or shaken like rattles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pu-ilus"@en .

aat:300217088 a skos:Concept ;
    skos:definition "Fiddles of northern India, Nepal, and Pakistan, with a short, thick, unfretted neck, waisted body with a skin belly, two or more bone bridges, three or four bowed strings, and a variable number of sympathetic strings. They are held upright when played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarangis"@en .

aat:300217113 a skos:Concept ;
    skos:definition "Small, shallow, Japanese-style charcoal braziers covered with a grill, usually for outdoor cooking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hibachis"@en .

aat:300217116 a skos:Concept ;
    skos:definition "Three-stringed fiddles of southern Afghanistan, India, Pakistan, and Bangladesh, having a short unfretted neck surmounted by a pegbox and a deeply waisted body of irregular shape with a skin belly over the lower part, on which rests a wood bridge. They are played held upright, with a heavy, curved bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarindas"@en .

aat:300217242 a skos:Concept ;
    skos:definition "Flat, stand-up collars, starched, wired, or otherwise stiffened, especially those commonly worn by men and women in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bands"@en .

aat:300217245 a skos:Concept ;
    skos:definition "Smaller version of any bag in fashion, usually beaded, sequinned, or embroidered, or of some glamorous fabric such as kid, silver, bronze, or gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening bags"@en .

aat:300217318 a skos:Concept ;
    skos:definition "Plucked lutelike chordophones of the northern Indian subcontinent with four or five melody strings, three to six drone strings, and 11 to 16 sympathetic strings, all of metal, a broad, unfretted metal-covered neck, and a bowl-shaped skin-covered soundbox; often a small second resonator of metal, wood, or gourd is fixed behind the pegbox. They are played with a triangular wood plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarods"@en .

aat:300217320 a skos:Concept ;
    skos:definition "Javanese metallophones consisting of thick bronze or iron slabs, usually six or seven but varying regionally, set on top of a wood trough or cradle, often elaborately carved, and struck with hammers of wood or horn. They exist in three sizes, and are important instruments in the Javanese gamelan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saron"@en .

aat:300217322 a skos:Concept ;
    skos:definition "Small casters intended primarily for sprinkling sugar, cinnamon, or other spices on hot muffins. They are typically historical objects. They may be part of a set with a small milk or cream pitcher designed to be set at table or on a breakfast tray when muffins are served, but they are usually not part of a larger set of casters in a special tray used at the formal dining table. They may be of cylindrical or baluster shape, or squatter, and made of metal, glass, or porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muffineers"@en .

aat:300217324 a skos:Concept ;
    skos:definition "Coasters for holding a bottle of wine on a table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine coasters"@en .

aat:300217460 a skos:Concept ;
    skos:definition "Upright serpents used in military bands in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpents militaires"@en .

aat:300217483 a skos:Concept ;
    skos:definition "Shawms of northern India, with the reed mounted on a conical metal staple, wrapped with string to make an airtight fit into the wood pipe, seven equidistant fingerholes, and a moderately flared brass bell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shanais"@en .

aat:300217500 a skos:Concept ;
    skos:definition "Pouch bags used as purses, worn hanging from a belt at center front; used especially with reference to those worn in Scottish Highland costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sporrans"@en .

aat:300217508 a skos:Concept ;
    skos:definition "Sarangis of the Langas of Rajasthan, smaller and higher in pitch than the classical version, with one drone and three melody strings and 23 sympathetic strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sindhi sarangis"@en .

aat:300217562 a skos:Concept ;
    skos:definition "Low-pitched single-octave gender of Java, played with one hammer only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slenthem"@en .

aat:300217578 a skos:Concept ;
    skos:definition "Chinese shawms introduced from Central Asia before the 16th century, made of wood with a widely flared metal bell, seven front fingerholes and one rear thumbhole, and a flat lip rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sona"@en .

aat:300217588 a skos:Concept ;
    skos:definition "Large, fairly broad-bladed knives of generally triangular profile with a sharply pointed end. Designed especially for use on cutting boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooks' knives"@en .

aat:300217610 a skos:Concept ;
    skos:definition "Wool mantles worn by women and men in ancient Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "himations"@en .

aat:300217618 a skos:Concept ;
    skos:definition "Resonators of plucked and bowed chordophones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soundboxes"@en .

aat:300217634 a skos:Concept ;
    skos:definition "Undergarments or garmets worn around the anatomical waist and up onto the chest, to which petticoats and drawers are buttoned. They are lightly boned or unboned, usually made of sturdy fabric, with shoulder straps and buttons at the side for attaching to a lower body garment; usually worn by children and women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waists"@en .

aat:300217658 a skos:Concept ;
    skos:definition "Shawl-like garments, often of wool or silk, with fringe at the four corners; worn around the shoulders by Jewish males usually during the morning service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tallitim"@en .

aat:300217674 a skos:Concept ;
    skos:definition "Pads, ruffles, or shaped inserts placed inside a corset or brassiere to fill out the bust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bust forms"@en .

aat:300217675 a skos:Concept ;
    skos:definition "Breast-shaped bust forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falsies"@en .

aat:300217765 a skos:Concept ;
    skos:definition "Tongs of various forms used for handling and serving food consisting of two members, or arms connected by a hinge, pivot, or spring, so that the lower ends are brought together to grasp and take up objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food tongs"@en .

aat:300217875 a skos:Concept ;
    skos:definition "Round or roundish objects having the general shape of a sphere, which is a geometric shape comprising all points equidistant from the center. Balls may be of various materials and sizes, inflated, soft, or solid used in many different contexts and applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balls"@en .

aat:300217912 a skos:Concept ;
    skos:definition "Game sets for activities that involve the moving of game pieces across a gameboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board games"@en .

aat:300217917 a skos:Concept ;
    skos:definition "Japanese barrel drums with two heads, only one of which is struck; the size and ratio of diameter to length vary greatly, and the membranes are either tacked to the body or laced on, sometimes lapped over metal rings and then laced. Taiko have a legendary origin in Japanese folklore, but historical records suggest they came to Japan in the 6th century CE through Korea and China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taiko"@en .

aat:300217923 a skos:Concept ;
    skos:definition "Refers to the aggregation of all playing cards employed in a game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packs of cards"@en .

aat:300217925 a skos:Concept ;
    skos:definition "Disc-like, saucer-shaped targets, about 4 1/2 inches in diameter and 1/2 inch thick hurled through the air from a trap in the sports of skeet and trapshooting; first developed in the 1860s and made of baked clay, now usually a mixture of river silt and pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay pigeons"@en .

aat:300217926 a skos:Concept ;
    skos:definition "Frameworks of horizontal and vertical bars or timbers specifically designed for children to climb and play on; originally devised in the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junglegyms"@en .

aat:300217928 a skos:Concept ;
    skos:definition "General term for ensembles of ball game artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball game sets"@en .

aat:300217929 a skos:Concept ;
    skos:definition "The ensembles of balls, mallets, and wickets needed to play the game of croquet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "croquet sets"@en .

aat:300217931 a skos:Concept ;
    skos:definition "Single-headed circular frame drums of the Near East, North Africa, and as far east as Malaysia, usually with metal jingles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tars"@en .

aat:300217933 a skos:Concept ;
    skos:definition "Long-necked plucked lutelike chordophones of Iran and the Caucasus with a deeply curved, figure-eight shaped soundbox with a belly of animal membrane, movable frets, and six strings in three courses of two; Caucasian models may have sympathetic strings as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tars"@en .

aat:300217935 a skos:Concept ;
    skos:definition "Short-necked, fretless lutelike chordophones of the Arab world, the direct ancestors of European lutes, strung in double courses and played with a plectrum. The large soundbox is built of ribs of lightweight wood with a strongly rounded back and flat belly, one large or two or three small sound holes, a bridge on the lower part of the belly, and a piece of fishskin, leather, or shell above the bridge to protect the belly from the strokes of the plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "'ūds"@en .

aat:300217949 a skos:Concept ;
    skos:definition "Vessel rattles of Hawaii made from a small gourd containing seeds or pebbles, fitted with a handle surmounted by a circular ruff of feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "̔ulī̔ulīs"@en .

aat:300217953 a skos:Concept ;
    skos:definition "Chinese gong chimes consisting of nine or ten small bronze gongs, suspended in a wood frame and struck with felt-padded sticks; the gongs are basin-shaped without bosses, and all of the same diameter though of different thicknesses to produce different tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yun lo"@en .

aat:300217996 a skos:Concept ;
    skos:definition "Double clarinets of the Near East, consisting of two parallel cylindrical pipes of the same length and having the same number of equidistant fingerholes, usually four to six."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zummaras"@en .

aat:300218011 a skos:Concept ;
    skos:definition "Shawms of the Arab world and areas of Europe and Asia influenced by Islam, taking many regional forms but commonly consisting of a wood pipe with conical bore, seven front fingerholes and one rear thumbhole, a flared bell, and a small reed with a metal pirouette below it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zurnas"@en .

aat:300218041 a skos:Concept ;
    skos:definition "American dulcimers which, like dulcimers worldwide, are played with hammers. For the American chordophones involving strings stretched over a soundbox, but played by plucking, use \"Appalachian dulcimers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammer dulcimers"@en .

aat:300218052 a skos:Concept ;
    skos:definition "White pigment containing CaCO3, made of carbonate of lime or limestone, and arragonite, as well as other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium carbonate white pigment"@en .

aat:300218059 a skos:Concept ;
    skos:definition "A pale yellow pigment often used as an extender for chrome yellow and in anticorrosive paints. It has good light and heat stability, but is a human carcinogen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium chromate"@en .

aat:300218130 a skos:Concept ;
    skos:definition "Large rings of iron, wood, or plastic rolled along the ground or twirled on the body as toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoops"@en .

aat:300218186 a skos:Concept ;
    skos:definition "Property of materials having a pH of 7 or higher when the concern is that there be little or no acid present to accelerate aging or deterioration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid-free"@en .

aat:300218193 a skos:Concept ;
    skos:definition "Thin, shaped strips of ivory, bone, wood, or plastic, or tapered sticks used in the game of jackstraws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackstraws"@en .

aat:300218199 a skos:Concept ;
    skos:definition "Use to describe things having the structure or appearance of a honeycomb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honeycomb"@en .

aat:300218213 a skos:Concept ;
    skos:definition "Elements that serve to stiffen or stabilize a member or a structure, long in relation to their width and usually set on a diagonal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stays"@en .

aat:300218244 a skos:Concept ;
    skos:definition "Toys in the form of human or animal figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figural toys"@en .

aat:300218246 a skos:Concept ;
    skos:definition "Firearms used for recreational purposes; for military projectile weapons, use terms found under \"<projectile weapons>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sporting firearms"@en .

aat:300218247 a skos:Concept ;
    skos:definition "Recreational rifles used for target shooting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "target rifles"@en .

aat:300218248 a skos:Concept ;
    skos:definition "Pistols used for target shooting, now usually semiautomatic and .22 caliber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "target pistols"@en .

aat:300218249 a skos:Concept ;
    skos:definition "Sporting firearms, often specially designed, for use in trapshooting; usually shotguns resembling rifles, 12-gauge, with a longer stock and long barrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trap guns"@en .

aat:300218250 a skos:Concept ;
    skos:definition "Specially designed ropes with handles at the ends used for exercise or in games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jump ropes"@en .

aat:300218276 a skos:Concept ;
    skos:definition "Low-pitched xylophones of Thailand and Cambodia with a range of just over two octaves, consisting of a rectangular box-shaped trough resonator mounted on very short legs, with usually 17 bars of bamboo or hardwood strung on cords suspended on hooks set into the end-boards of the resonator. Tuning paste is applied to the underside of the bars and they are struck with two beaters. For the Thai and Cambodian metallophones of the same range and tuning, use \"ranat thum lek.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranat thum"@en .

aat:300218286 a skos:Concept ;
    skos:definition "High-pitched metallophones of Thailand and Cambodia with a range of three octaves, consisting of a rectangular box-shaped trough resonator mounted on four short legs, with 21 iron or steel bars supported on narrow wood tracks along the tops of the sides of the resonator and tuned by filing away some of the metal on the underside. They are struck with two beaters, either hard or soft. For the Thai and Cambodian xylophones of the same range and tuning, use \"ranat ek.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranat ek lek"@en .

aat:300218287 a skos:Concept ;
    skos:definition "Low-pitched metallophones of Thailand and Cambodia with a range of just over two octaves, consisting of a rectangular box-shaped trough resonator mounted on four short legs, with 17 iron or steel bars supported on narrow wood tracks along the tops of the sides of the resonator, which are tuned by filing away some of the metal on the underside. They are struck with two beaters, either hard or soft. For the Thai and Cambodian xylophones of the same range and tuning, use \"ranat thum.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranat thum lek"@en .

aat:300218300 a skos:Concept ;
    skos:definition "High molecular weight compounds formed by the combination of one or more monomers, formed by the multiplication of molecules of the same species to produce a new compound with the same empirical formula but with higher molecular weight. Use \"copolymers\" for materials that combine molecules of differing chemical compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymers"@en .

aat:300218309 a skos:Concept ;
    skos:definition "Recreational devices for entertaining the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public entertainment devices"@en .

aat:300218522 a skos:Concept ;
    skos:definition "Those who act as intermediaries between the natural and supernatural worlds, serving as healers and priests, foretelling the future, and controlling spiritual forces for the welfare of the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shamans"@en .

aat:300218585 a skos:Concept ;
    skos:definition "Cleaning to such an extent that the original finish, patina, or surface layers of an object have been damaged or removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overcleaning"@en .

aat:300218588 a skos:Concept ;
    skos:definition "Property of materials, such as paper or mat board, or processing methods that are expected to allow items to be stored for extended periods of time without loss of quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival quality"@en .

aat:300218591 a skos:Concept ;
    skos:definition "The physicochemical makeup or constitution of a material or compound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition"@en .

aat:300218594 a skos:Concept ;
    skos:definition "A basic defect in glass caused by an imperfect proportion of ingredients, particularly an excess of alkali, and consisting of a fine network of cracks and the formation of moisture on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crizzling"@en .

aat:300218595 a skos:Concept ;
    skos:definition "Drawing or bending into folds or alternate furrows and ridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrugating"@en .

aat:300218678 a skos:Concept ;
    skos:definition "Term used to describe things produced by synthesis, the combining of elements, materials, or entities into a unified entity. Where the emphasis is a distinction from things natural, prefer \"artificial.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic"@en .

aat:300218721 a skos:Concept ;
    skos:definition "The temperature at which a eutectic alloy or mixture melts or solidifies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eutectic point"@en .

aat:300218726 a skos:Concept ;
    skos:definition "The state or quality of being composed of or bearing small grains or particles. Regarding paint layer structure, refers to paint that consists almost entirely of pigment particles with little or no vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granularity"@en .

aat:300218729 a skos:Concept ;
    skos:definition "The earliest form of greaves, dating back to the mid-13th century, being gutter-shaped tubes of metal or hide, open on one side and covering the shin from just above the ankle to just below the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schynbalds"@en .

aat:300218733 a skos:Concept ;
    skos:definition "Use to describe containers or spaces that are sealed so as to be airtight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hermetically sealed"@en .

aat:300218762 a skos:Concept ;
    skos:definition "Boat-shaped vessels, usually with a long pouring lip at one end and a handle at the other or two pouring lips and a central handle, used for serving sauces, gravies, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sauceboats"@en .

aat:300218777 a skos:Concept ;
    skos:definition "Light frames, usually wood, covered with a thin material to be flown in the wind at the end of a long string; known from at least the 3rd century BCE in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kites"@en .

aat:300218781 a skos:Concept ;
    skos:definition "Equipment and accessories used in any of a large array of activities that are engaged in for personal satisfaction or amusement during leisure time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreational artifacts"@en .

aat:300218792 a skos:Concept ;
    skos:definition "Refers to the physical form of a thing or a material, often regarding shapes and arrangements of parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morphology"@en .

aat:300218793 a skos:Concept ;
    skos:definition "Morphology on an extremely minute scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micromorphology"@en .

aat:300218794 a skos:Concept ;
    skos:definition "The structure of a molecule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molecular structure"@en .

aat:300218855 a skos:Concept ;
    skos:definition "Any of various short-handled objects with wide, rounded heads, usually primarily of wood designed for various ball games. For similar-shaped but usually larger objects with heads containing netting, use \"rackets (sports equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paddles"@en .

aat:300218960 a skos:Concept ;
    skos:definition "Term applied to a wide variety of special-purpose utensils designed to serve ice cream and similar foods, especially those with an oblong spadelike bowl. Often made as part of flatware services, particularly in the 19th century. For utensils with a hemispherical end used to serve ice cream, use \"ice-cream scoops.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream servers"@en .

aat:300218966 a skos:Concept ;
    skos:definition "Cups of various forms designed for drinking wine, made of glass, metal, or ceramic. The bowl may rest on a stem; the cup may have a lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine cups"@en .

aat:300218967 a skos:Concept ;
    skos:definition "Utensils with a hemispherical end used to serve ice cream and similar foods; may have a mechanism which moves a blade around the inside of the scoop to loosen ice cream from the sides. For utensils which have a relatively large flat surface of varying shape used to serve ice cream use \"ice-cream servers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice-cream scoops"@en .

aat:300219039 a skos:Concept ;
    skos:definition "Variety of porcelain material comprising a soft or hard paste, white, fine, and vitreous, often resembling statuary marble; developed in England in the 1840s and used for figurines, especially dolls, and for art objects, ornament, and tableware. For unglazed porcelain or earthenware that has been fired only once and used for similar types of objects, but producing a grainy texture, use \"biscuit (porcelain, material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parian"@en .

aat:300219050 a skos:Concept ;
    skos:definition "Characters used in certain ancient scripts, especially in Scandinavia and Britain, and in the Orkhon River area of Mongolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runes"@en .

aat:300219257 a skos:Concept ;
    skos:definition "General term used to collocate terms for groups of vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vehicle groupings"@en .

aat:300219258 a skos:Concept ;
    skos:definition "Refers broadly to devices or contrivances by which people, animals, or objects are conveyed or carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vehicles"@en .

aat:300219386 a skos:Concept ;
    skos:definition "Four-wheeled carriages generally characterized by high outside seats for the driver, passenger seats with either folding or fixed tops, and coachlike lower quarters and undercarriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barouches"@en .

aat:300219406 a skos:Concept ;
    skos:definition "Tactile and sometimes visual quality of a surface given to it by the size, shape, arrangement, and proportions of its minute parts, such as granules, particles, threads, or brushstrokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface texture"@en .

aat:300219407 a skos:Concept ;
    skos:definition "Elegant sleighs with enclosed bodies; term used in New England from the mid-18th century until the end of the carriage era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booby huts"@en .

aat:300219429 a skos:Concept ;
    skos:definition "Any of various devices dropped to the bottom of a body of water and designed to bury themselves there in order to restrict the movement of watercraft or other floating objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchors"@en .

aat:300219444 a skos:Concept ;
    skos:definition "Currently or actually existing, particularly, continuing to exist despite the passage of time and/or other circumstances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extant"@en .

aat:300219449 a skos:Concept ;
    skos:definition "Damage or deterioration occurring gradually as a result of continuing use or exposure, usually a gradual diminishing from such actions as rubbing, scraping, or washing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wear"@en .

aat:300219467 a skos:Concept ;
    skos:definition "An appearance or texture due to the arrangement and especially stratification of constituent particles or fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain"@en .

aat:300219502 a skos:Concept ;
    skos:definition "Totally enclosed boxlike freight cars, with floor, roof, sides, and ends, usually with large doors on the sides or sides and ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxcars"@en .

aat:300219527 a skos:Concept ;
    skos:definition "Generally, having a basis in the normal constitution and operation of things as found in nature unaffected or minimally affected by humans. Specifically with reference to aerophones, having no valves, keys, or other mechanical means of altering the pitch produced by the instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural"@en .

aat:300219528 a skos:Concept ;
    skos:definition "Parts of something that are folded, that is, where the object or material collapses onto itself. For ridges or grooves pressed into a material by folding, use \"creases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folds"@en .

aat:300219530 a skos:Concept ;
    skos:definition "Light, open, two-wheeled carriages drawn by a single horse, for one or two passengers, and with or without foldable hoods; popular in England and the United States during the 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaises"@en .

aat:300219531 a skos:Concept ;
    skos:definition "Four-wheeled half-coaches lighter and less expensive than full coaches; popular luxury vehicles from the mid-17th century until the development of broughams in the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chariots"@en .

aat:300219533 a skos:Concept ;
    skos:definition "Fast ocean-going sailing ships generally characterized by sharply raked stern, a long and low hull with the draft deeper aft than forward, an inclined, overhanging counter stern, and a large spread of canvas; developed in the mid-19th century as cargo vessels, but their speed lent the vessels to other uses; typically having three masts and square rigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clipper ships"@en .

aat:300219534 a skos:Concept ;
    skos:definition "Ordinary passenger-carrying railroad cars for daytime travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaches"@en .

aat:300219548 a skos:Concept ;
    skos:definition "Public coaches with sturdy, large, ovoid bodies with curved panels set on three-perch, throughbrace suspension and having large amounts of baggage space, seating six, nine, or twelve passengers, and often having additional seating on the roof; designed in the United States from the 1820s until the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concord coaches"@en .

aat:300219549 a skos:Concept ;
    skos:definition "Four-wheeled vehicles originally designed to carry bulk commodities and heavy loads, and which are covered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered wagons"@en .

aat:300219550 a skos:Concept ;
    skos:definition "Use both for groups of merchant or naval auxilliary ships traveling under armed escort and for groups of motor vehicles organized for the purpose of control and orderly movement, with or without escort protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convoys"@en .

aat:300219578 a skos:Concept ;
    skos:definition "Heavy, two- or four-wheeled, horse-drawn freight carriers, generally without sides, having flat, level floors or loading beds, with or without springs; primarily for use by industry in and around cities; distinguished from horse-drawn trucks by having straight and level loading areas and rear wheels smaller than trucks so that they fall below the floor level to allow the hauling of large items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drays"@en .

aat:300219625 a skos:Concept ;
    skos:definition "Any of a variety of animal-drawn, all-purpose wagons designed for farms and generally characterized by square-box bodies mounted without springs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farm wagons"@en .

aat:300219626 a skos:Concept ;
    skos:definition "Refers to a variety of formed components, often curved and of metal or wood, mounted or hung along the sides of land vehicles or watercraft, as over the wheels of road vehicles, to protect the vehicles and occupants from injury and splashing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fenders"@en .

aat:300219636 a skos:Concept ;
    skos:definition "Covering entirely or partially with a liquid, a foam, or sometimes dust by means of a sprayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spraying"@en .

aat:300219637 a skos:Concept ;
    skos:definition "Any of various nonaqueous cleaning methods such as the removal of surface dirt by brushing, using appropriate erasers on paper, or the use of nonaqueous organic solvents on fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry cleaning"@en .

aat:300219638 a skos:Concept ;
    skos:definition "Applied low-relief decoration made by free-hand brush application of gesso before gilding. Works with aggetti designs are commonly described as pastiglia, but the techniques are very different. Use aggetti for works designed using free-hand brush application. For works designed using the application of a mould, use \"pastiglia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aggetti"@en .

aat:300219639 a skos:Concept ;
    skos:definition "Biologically mediated loss of utilitarian or physical characteristics of a material caused by bacteria or other microorganisms. Biodeterioration includes only physical disintegration and cosmetic disfigurement. For deterioration that includes molecular changes to a material such that characteristic properties of the material are no longer evident, use 'biodegradation.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biodeterioration"@en .

aat:300219653 a skos:Concept ;
    skos:definition "Concave moldings that are similar to scotias but less deep; used especially with reference to frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "channel moldings"@en .

aat:300219656 a skos:Concept ;
    skos:definition "Straplike elements that encircle moldings, such as those applied to the center or corner of 17th-century frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clasps"@en .

aat:300219674 a skos:Concept ;
    skos:definition "Use primarily for large organizations of warships and associated forces under orders of a single commander, and, by extension, may be used for other large groups of vehicles under a single operator, such as large numbers of motor vehicles owned by one company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fleets"@en .

aat:300219680 a skos:Concept ;
    skos:definition "Wedges of wood set at the corners of frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keys"@en .

aat:300219681 a skos:Concept ;
    skos:definition "Moldings carved to resemble leaves separated by darts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaf-and-dart moldings"@en .

aat:300219696 a skos:Concept ;
    skos:definition "Moldings carved to resemble a ribbon spiraled around a stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon-and-stick moldings"@en .

aat:300219700 a skos:Concept ;
    skos:definition "Titanium ore found in igneous rock and supplies a major portion of the world's titanium; source for titanium white pigment and used in ceramic glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ilmenite"@en .

aat:300219710 a skos:Concept ;
    skos:definition "Medium to large seagoing sailing vessels of the late 16th and 17th centuries distinguished by high sterncastle, low forecastle, beakhead, fine ends, and full midships section; used as both merchant and fighting ships and formed the backbone of seagoing fleets for most European countries in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleons"@en .

aat:300219771 a skos:Concept ;
    skos:definition "Small utility carts drawn or pushed by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handcarts"@en .

aat:300219772 a skos:Concept ;
    skos:definition "Two-wheeled, one-horse, covered carriages originally having the driver's seat perched high on the roof, later with the seat set high at the rear and generally characterized by high wheels and low-hung bodies with easy front access for two passengers; distinguished from \"cabriolets (carriages)\" by the location of the driver and the much lower bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hansom cabs"@en .

aat:300219774 a skos:Concept ;
    skos:definition "Street railway cars drawn by horses, operating from the 1850s until the 1890s. For horse-drawn public street vehicles not operating on rails and generally accommodating fewer passengers than horsecars, use \"omnibuses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horsecars"@en .

aat:300219775 a skos:Concept ;
    skos:definition "Vessels specially designed with reinforced bow and powerful engines for breaking navigable channels through heavy ice, especially the pack ice of extreme northern latitudes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icebreakers"@en .

aat:300219882 a skos:Concept ;
    skos:definition "Vessels specially designed or adapted for clearing or destroying mines at sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minesweepers"@en .

aat:300219951 a skos:Concept ;
    skos:definition "Long, luxury automobiles distinguished by a larger than normal compartment for the passengers and typically a separate compartment for the driver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limousines"@en .

aat:300219954 a skos:Concept ;
    skos:definition "Refers to horse-drawn public street vehicles intended to carry a large number of passengers, generally having rear entry, longitudinal seats facing each other, and paneled sides; for horse-drawn rail vehicles usually accommodating more riders, see \"horsecars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "omnibuses"@en .

aat:300219955 a skos:Concept ;
    skos:definition "A dull, discolored surface film caused by chemical deterioration, such as the film of silver sulfide that commonly forms on silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarnish"@en .

aat:300219960 a skos:Concept ;
    skos:definition "Stabilizing degraded or weakened areas by introducing or attaching materials capable of holding them together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consolidation"@en .

aat:300220007 a skos:Concept ;
    skos:definition "Separation between layers, as between a paint or varnish film and other film layers, or between a film layer and its support, or separation along planes of weakness in crystalline materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleavage"@en .

aat:300220034 a skos:Concept ;
    skos:definition "Small trucks with enclosed drivers' areas and rectangular, open, low-sided bodies, capable of light hauling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickups"@en .

aat:300220047 a skos:Concept ;
    skos:definition "Boatlike vehicles equipped with, usually, three runners and propelled by sails over ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iceboats"@en .

aat:300220056 a skos:Concept ;
    skos:definition "High-purity water used by the semiconductor industry, containing no electrolytes other than hydrogen and hydroxide ions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultrapure water"@en .

aat:300220060 a skos:Concept ;
    skos:definition "Water of the highest purity that is available from a practical standpoint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reagent grade water"@en .

aat:300220065 a skos:Concept ;
    skos:definition "Land vehicles used for recreational purposes, sometimes equipped with living facilities, sometimes motorized, and sometimes for off-road use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreational vehicles"@en .

aat:300220066 a skos:Concept ;
    skos:definition "The maximum amount or number that can be received or contained, or the ability to receive or contain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capacity"@en .

aat:300220067 a skos:Concept ;
    skos:definition "The weight of a given molecule expressed in atomic weight units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molecular weight"@en .

aat:300220133 a skos:Concept ;
    skos:definition "Four-wheeled, covered carriages with either paneled or curtained sides, with or without perch, mounted on elliptic or platform springs, having a driver's seat included in the body proper and generally with a common roof projecting over the driver's area; could be drawn by one or two horses; popular in the United States in numerous body styles; introduced in the 1830s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rockaways"@en .

aat:300220134 a skos:Concept ;
    skos:definition "Quantity of a substance contained in a unit quantity sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concentration"@en .

aat:300220140 a skos:Concept ;
    skos:definition "The ability of a material to conduct electricity, heat, or sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conductivity"@en .

aat:300220157 a skos:Concept ;
    skos:definition "The tendency of a substance to absorb or attract water from the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hygroscopicity"@en .

aat:300220158 a skos:Concept ;
    skos:definition "The state or quality of materials of being incapable of being mixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immiscibility"@en .

aat:300220159 a skos:Concept ;
    skos:definition "Manned spacecraft designed for repetitive missions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reusable spacecraft"@en .

aat:300220160 a skos:Concept ;
    skos:definition "Foot-propelled vehicles with, usually, two wheels in tandem, a low footboard on which the rider stands set between the wheels, and a handlebar for steering, generally mounted on a vertical post; for similar, but larger and heavier, motorized vehicles, use \"motor scooters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scooters"@en .

aat:300220162 a skos:Concept ;
    skos:definition "The condition of moisture being taken up by buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rising damp"@en .

aat:300220163 a skos:Concept ;
    skos:definition "The quality or degree of being poisonous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toxicity"@en .

aat:300220231 a skos:Concept ;
    skos:definition "The act or process of making bricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brickmaking"@en .

aat:300220235 a skos:Concept ;
    skos:definition "The process or result of combining with oxygen; sometimes contributing to the degradation of a surface, such as in corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxidation"@en .

aat:300220236 a skos:Concept ;
    skos:definition "The volatilization or evaporation and subsequent condensation of a liquid, as when water is boiled and the steam is condensed, for such purposes as purification, concentration, or separation of substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distillation"@en .

aat:300220267 a skos:Concept ;
    skos:definition "The removal or reduction of acid content by neutralizing the acidic components in a material, often paper, and providing an alkaline buffer to counteract acidic build-up in the future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deacidification"@en .

aat:300220273 a skos:Concept ;
    skos:definition "In glass, the loss of transparency caused by crystallization or deposition of one or more of its ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devitrification"@en .

aat:300220293 a skos:Concept ;
    skos:definition "Pattern having the appearance of fine lines. An example is decoration done entirely of fine wire, chiefly to ornament gold and silver, or as openwork made of wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filigree"@en .

aat:300220318 a skos:Concept ;
    skos:definition "The complete central structures of aircraft, to which the wings, tail assemblies, and engines may be attached. In the early 20th century, the term was taken from French specifically to refer to the framework of the body of an airplane, particularly the girder-like backbone employed in airplane design; it has since come to mean the entire central structure of the aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuselages"@en .

aat:300220343 a skos:Concept ;
    skos:definition "Buses or buslike vehicles whose power comes from attachments linking them to overhead electrical wires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trolleybuses"@en .

aat:300220344 a skos:Concept ;
    skos:definition "The process of joining two or more molecules of the same kind to form a more complex molecule with different physical properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymerization"@en .

aat:300220358 a skos:Concept ;
    skos:definition "The phenomenon of weak linking between molecules, particularly water molecules or other molecules with a hydroxyl group, such as alcohols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogen bonding"@en .

aat:300220360 a skos:Concept ;
    skos:definition "The chemical reaction of water and any other compound substance to form two or more new substances. This involves ionization of the water molecules as well as splitting of the compound hydrolized. For example, when a salt is hydrolized, the result is a slightly acid or alkaline solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrolysis"@en .

aat:300220362 a skos:Concept ;
    skos:definition "The process by which electrons are lost from or transferred to neutral molecules or atoms to form positively or negatively charged particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ionization"@en .

aat:300220368 a skos:Concept ;
    skos:definition "The selective absorption of electromagnetic radiation by an atomic nucleus in the presence of a strong, static magnetic field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear magnetic resonance"@en .

aat:300220378 a skos:Concept ;
    skos:definition "The changing or bending of waves, especially sound and light waves, as they pass by and around obstacles in their path."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffraction"@en .

aat:300220380 a skos:Concept ;
    skos:definition "Fluctuation or vibration on each side of a mean value or position; or a swinging back and forth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oscillation"@en .

aat:300220384 a skos:Concept ;
    skos:definition "The process by which any substance is converted from a liquid state into a vapor or gaseous state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evaporation"@en .

aat:300220387 a skos:Concept ;
    skos:definition "The flipping back and forth between two spin directions of electrons in a magnetic field when electromagnetic radiation of the proper frequency is applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron spin resonance"@en .

aat:300220405 a skos:Concept ;
    skos:definition "Comics, usually serialized and composed of a few frames, and often syndicated for publication in newspapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comic strips"@en .

aat:300220415 a skos:Concept ;
    skos:definition "Aircraft designed or modified for specialized military operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military aircraft"@en .

aat:300220417 a skos:Concept ;
    skos:definition "Aircraft that derive lift from the motion of air over aerodynamically designed surfaces that are rigidly and permanently attached to the fuselage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed-wing aircraft"@en .

aat:300220418 a skos:Concept ;
    skos:definition "Aircraft supported in flight partially or wholly by rotating airfoils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotary-wing aircraft"@en .

aat:300220420 a skos:Concept ;
    skos:definition "The dimensional response of a material subject to crushing forces and the action that leads to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compression"@en .

aat:300220469 a skos:Concept ;
    skos:definition "Variants or special forms of documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "versions of documents"@en .

aat:300220493 a skos:Concept ;
    skos:definition "In photographic processing, the technique of combining auxiliary transparencies with the original negative or positive transparency to adjust contrast, tone, or color in the exposure, and the technique of covering parts of a negative while exposing it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masking"@en .

aat:300220504 a skos:Concept ;
    skos:definition "The removal of ions from a solution by ion exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deionization"@en .

aat:300220511 a skos:Concept ;
    skos:definition "Enumerating individual units out of a body of units to determine the total number of units concerned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counting"@en .

aat:300220513 a skos:Concept ;
    skos:definition "In chemistry, processes involving an acid and a base in which the net result is neither acid nor alkaline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutralization"@en .

aat:300220519 a skos:Concept ;
    skos:definition "General term for texts of religion, sacred beliefs, or related to religious beliefs and practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious texts"@en .

aat:300220523 a skos:Concept ;
    skos:definition "General term for information artifacts that can be processed or read by computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine-readable artifacts"@en .

aat:300220530 a skos:Concept ;
    skos:definition "A thick-soled boot reaching to the middle of the leg, worn by huntsmen and men of upperclasses in ancient Greece and Rome, also by tragic actors in Athenian drama. They often took the form of calf-high laced boots, sometimes with a cork wedge to increase the wearer's height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cothurni"@en .

aat:300220539 a skos:Concept ;
    skos:definition "Action or process of creating illumination, which comprises paintings and other adornments applied to books, scrolls, or other document types for the purpose of illustrating or decorating the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illumination"@en .

aat:300220569 a skos:Concept ;
    skos:definition "Formation of a concavity or cuplike hollow in a paint layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupping"@en .

aat:300220572 a skos:Concept ;
    skos:definition "Complete, nonperiodical printed works generally of fewer than 80 pages, often with a paper cover, sometimes short treatises on arguments or topics of current interest. For smaller printed works, of one sheet folded and not stitched or bound, use \"leaflets.\" An independent publication consisting of a few leaves of printed matter fastened together but not bound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pamphlets"@en .

aat:300220580 a skos:Concept ;
    skos:definition "Corrosion caused by pollutants in the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmospheric corrosion"@en .

aat:300220584 a skos:Concept ;
    skos:definition "A given space filled with a gas at pressure below atmospheric pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum"@en .

aat:300220593 a skos:Concept ;
    skos:definition "Air guns with rifled bore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air rifles"@en .

aat:300220684 a skos:Concept ;
    skos:definition "Filling the fibers of light leather, such as that used for gloves, with an emulsion of oils or grease and water to make the fibers water-repellent and flexible; distinguished from \"currying,\" which is introducing fatty substances into heavy leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fat-liquoring"@en .

aat:300220716 a skos:Concept ;
    skos:definition "A nonreversible condition whereby the fibrous structure of leather breaks down partially or completely, becoming extremely powdery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red rot"@en .

aat:300220720 a skos:Concept ;
    skos:definition "The destructive formation of a soft powdery mineral on copper or any of its alloys caused by the presence of chlorides and moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze disease"@en .

aat:300220733 a skos:Concept ;
    skos:definition "Treating hides or skins with mineral salts to produce a very durable and highly water-repellent leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral tanning"@en .

aat:300220740 a skos:Concept ;
    skos:definition "Garments worn next to the body and under main garments having leg openings or short or long legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underpants"@en .

aat:300220741 a skos:Concept ;
    skos:definition "Narrow belts, cords, sashes or the like, usually decorative and worn at the waist to fasten or confine garments or as a means of carrying small objects such as purses or keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girdles"@en .

aat:300220742 a skos:Concept ;
    skos:definition "Mantles with a sleeve cut all in one with the side piece and hanging loose; sometimes made in the form of a sling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolmans"@en .

aat:300220744 a skos:Concept ;
    skos:definition "Arrangements of flowers to be worn as costume accessories, as on the bodice or at the wrist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corsages"@en .

aat:300220745 a skos:Concept ;
    skos:definition "Term used in the 18th and 19th centuries for a woman's bodice or upper portion of a dress or garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corsages"@en .

aat:300220748 a skos:Concept ;
    skos:definition "Bell-shaped glass domes placed over delicate plants to protect them from the weather and to force their growth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell glasses"@en .

aat:300220749 a skos:Concept ;
    skos:definition "Small pads or rolls of hair or the like formerly worn by women underneath their natural hair to give the appearance of greater thickness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rats"@en .

aat:300220751 a skos:Concept ;
    skos:definition "Types of textual, graphic, electronic, or physical items having the primary and original purpose to record or convey specific information. For forms in the sense of a document having blanks to be filled in, use \"forms (documents).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information forms"@en .

aat:300220752 a skos:Concept ;
    skos:definition "Dome-shaped or cylindrical containers with a small opening at the top used to contain and dispense twine or string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twine holders"@en .

aat:300220753 a skos:Concept ;
    skos:definition "Containers or devices that hold and dispense something in small amounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dispensers"@en .

aat:300220755 a skos:Concept ;
    skos:definition "Small boxes or receptacles intended primarily for soap. Common examples made as spherical, perforated containers used to hold a ball of scented soap. May be part of a toilet set. For open containers used to hold a bar of soap, use \"soap dishes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soap boxes"@en .

aat:300220758 a skos:Concept ;
    skos:definition "Small receptacles to contain scented vinegar, formerly used by women, and sometimes men, to ward off faintness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinaigrettes"@en .

aat:300220784 a skos:Concept ;
    skos:definition "Costume accessories comprising circular bands of flowers, foilage, or ornamental work worn or bestowed as a mark of honor or victory or worn for purely decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wreaths"@en .

aat:300220790 a skos:Concept ;
    skos:definition "Spatulas with rubber, nylon, or similar synthetic blades, used especially for such tasks as removing soft foods from bowls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubber spatulas"@en .

aat:300220808 a skos:Concept ;
    skos:definition "Boxes intended for toilet articles and sometimes writing materials, often fitted with drawers, trays, or partitions and usually a mirror; often especially for travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing cases"@en .

aat:300220809 a skos:Concept ;
    skos:definition "Small cylindrical or flat bottles used to contain snuff, often carried on the person. Often highly decorative and made of a variety of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuff bottles"@en .

aat:300220810 a skos:Concept ;
    skos:definition "Bottles of varying size, shape, and style made to contain medicine, particularly those intended to be taken home by customers of an apothecary or sold elsewhere; examples include collectible patent medicine bottles. For bottles used to store larger quantities of medicine, as used in an apothecary and labeled with the names of standard medicines, use \"apothecary bottles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine bottles"@en .

aat:300220822 a skos:Concept ;
    skos:definition "Small containers for fragrant spices or perfumes originally intended to be carried to ward off infections. Perforated and usually globular, apple-shaped, or composed of fitted sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pomanders"@en .

aat:300220837 a skos:Concept ;
    skos:definition "Use to describe the location of something in its customary or unaltered place or position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "in situ"@en .

aat:300220841 a skos:Concept ;
    skos:definition "Close-fitting caps with a visor, generally having a gored crown with a button on top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baseball caps"@en .

aat:300220895 a skos:Concept ;
    skos:definition "Containers used in the context of a pharmacy, or the dispensing of compounds and drugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apothecary containers"@en .

aat:300220896 a skos:Concept ;
    skos:definition "Containers for keeping leeches, usually inscribed or labeled, and having some form of a pierced cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leech jars"@en .

aat:300220907 a skos:Concept ;
    skos:definition "Cages for confining birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birdcages"@en .

aat:300220908 a skos:Concept ;
    skos:definition "Containers for bones of the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ossuaries"@en .

aat:300220909 a skos:Concept ;
    skos:definition "Any of various containers for shaking cocktails in order to mix ingredients; usually lidded, made of glass or metal, and of a tall shape designed to be conveniently held and shaken by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocktail shakers"@en .

aat:300220910 a skos:Concept ;
    skos:definition "Bottles for holding pressurized water that is driven out through a siphon by the pressure of the gas when a valve in the tube is opened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siphon bottles"@en .

aat:300220911 a skos:Concept ;
    skos:definition "Banks, originally made from an orange-colored clay called pygg, usually used by children for saving coins. Often in the shape of a pig."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piggy banks"@en .

aat:300220919 a skos:Concept ;
    skos:definition "Relatively tall containers with a narrow mouth intended primarily for holding one or a few buds or flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bud vases"@en .

aat:300220920 a skos:Concept ;
    skos:definition "Containers, chiefly or wholly enclosed, for growing and displaying plants and/or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrariums"@en .

aat:300220939 a skos:Concept ;
    skos:definition "Attachments for a food processor or electric mixer, for kneading dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough hooks"@en .

aat:300220940 a skos:Concept ;
    skos:definition "A method of mounting a flexible support such as paper or textile onto a solid support such as a wall or panel, whether before painting or afterwards. May be extended to lining a painting with another canvas to strengthen it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marouflage"@en .

aat:300220956 a skos:Concept ;
    skos:definition "Boardlike trays for serving a variety of cheeses. Use \"cheese dishes\" for containers for storing or serving cheese, generally consisting of a flat dish with a dome cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheeseboards"@en .

aat:300220959 a skos:Concept ;
    skos:definition "Devices with a series of cutting wires held in a frame, used for slicing hard-boiled eggs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg slicers"@en .

aat:300220971 a skos:Concept ;
    skos:definition "Long, narrow, open receptacles, usually boxlike in shape. The term is used chiefly in the context of holding water or food for animals, but may be extended to any large tank or vat of similar shape used for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "troughs"@en .

aat:300220976 a skos:Concept ;
    skos:definition "A hard or brittle external coating or covering on a material or object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crust"@en .

aat:300220980 a skos:Concept ;
    skos:definition "Visual works composed of decorative arrangements of quills, usually porcupine quills and sometimes with bird feathers, on a leather or cloth support that is often an article of clothing. The works developed among Native North Americans. The term is also used to refer to such works produced by other cultures, including those of similar appearance but created by rolling or curling narrow strips of paper and affixing them to a surface to create decorative designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quillwork"@en .

aat:300220991 a skos:Concept ;
    skos:definition "Visual works or parts of works having a design or decoration made of the shells, which are the hard outer covering of invertebrate creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shellwork"@en .

aat:300220996 a skos:Concept ;
    skos:definition "Containers for holding and serving cream, especially a small pitcher that may be accompanied by a sugar bowl. Sometimes made as part of a tea or coffee service. For containers designed for holding and serving milk, especially medium-sized pitchers, use \"milk jugs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creamers"@en .

aat:300220999 a skos:Concept ;
    skos:definition "Large bowls or basins for washing one's hands and face, usually accompanied by a pitcher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washbowls"@en .

aat:300221001 a skos:Concept ;
    skos:definition "Any container with a tight-fitting lid used to poach food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poachers"@en .

aat:300221006 a skos:Concept ;
    skos:definition "Containers with one or more cylindrical channels for holding stacks of coins of identical size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coin holders"@en .

aat:300221010 a skos:Concept ;
    skos:definition "Flasklike vessels used to carry water or other liquids as by hikers or soldiers; typically made of metal and carried in a cloth jacket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canteens"@en .

aat:300221011 a skos:Concept ;
    skos:definition "Bags of distinctive shape used to store salt, grain, or the like; used especially with reference to woven bags used by nomads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt bags"@en .

aat:300221092 a skos:Concept ;
    skos:definition "Use to describe a material having a structure composed of cells, whether biological cells, as in wood, or open cavities otherwise generated, as in some bricks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellular"@en .

aat:300221137 a skos:Concept ;
    skos:definition "The proportion of pure precious metal in an alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fineness"@en .

aat:300221140 a skos:Concept ;
    skos:definition "The state or quality of being composed from dissimilar parts, elements, or characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heterogeneity"@en .

aat:300221142 a skos:Concept ;
    skos:definition "The state or quality of being composed from like parts, elements, or characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homogeneity"@en .

aat:300221144 a skos:Concept ;
    skos:definition "The strength or amount of a quality, condition, or phenomenon, such as of an electric field, magnetization, or radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intensity"@en .

aat:300221151 a skos:Concept ;
    skos:definition "The phenomenon, exhibited by and being a property of certain elements, of spontaneously emitting radiation resulting from changes in the nuclei of atoms of the element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radioactivity"@en .

aat:300221152 a skos:Concept ;
    skos:definition "Any volatile or volatilizable chemical compound used as a disinfectant or pesticide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fumigant"@en .

aat:300221154 a skos:Concept ;
    skos:definition "A tough, elastic, brown, water-insoluble, non-starchy protein substance remaining when the flour of wheat, corn, rice, or other cereal grain is washed to remove starch. Gluten is composed of a mixture of 18 plant proteins. It is hygroscopic and will form an elastic dough when mixed with water. Gluten must be removed to make starch paste. Dilute aqueous mixtures of gluten have been used as adhesives. Prior to the 19th century, the term was used to refer to any of several adhesive materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gluten"@en .

aat:300221155 a skos:Concept ;
    skos:definition "The metallic element having the symbol Co and atomic number 27; it is a hard, ductile, white metal, resembling nickel but with a bluish instead of a yellow tinge. Cobalt was first identified by Georg Brandt of Sweden in 1735. It has an abundance of 0.001-0.002% in the earth's crust and is found in the minerals smaltite, cobaltite, chloanthite, linnaetite, and erythrite. Metallic cobalt is added to alloys to increase hardness at high temperatures. It is also ferromagnetic. Cobalt oxides and salts are usually blue and they are used as pigments in paints, glass, and ceramic glazes"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt"@en .

aat:300221157 a skos:Concept ;
    skos:definition "A solid body having a characteristic internal structure and enclosed by systematically arranged plane surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystal"@en .

aat:300221165 a skos:Concept ;
    skos:definition "Use to describe materials, solutions, or treatments that involve water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aqueous"@en .

aat:300221167 a skos:Concept ;
    skos:definition "Use to describe things transported by or communicated by water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterborne"@en .

aat:300221168 a skos:Concept ;
    skos:definition "Weapons which are combinations of two or more different types. May also be used for weapons that are hidden in or appear to be articles of everyday use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination weapons"@en .

aat:300221183 a skos:Concept ;
    skos:definition "The quality of having different characteristics, as properties or dimensions, along different axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anisotropy"@en .

aat:300221184 a skos:Concept ;
    skos:definition "Use to describe materials capable of decaying through the action of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biodegradable"@en .

aat:300221185 a skos:Concept ;
    skos:definition "Culinary tools used to shape butter into fluted scrolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter curlers"@en .

aat:300221186 a skos:Concept ;
    skos:definition "Mechanical devices used for making pasta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pasta makers"@en .

aat:300221187 a skos:Concept ;
    skos:definition "Containers intended primarily for holding cigars, especially covered boxes of varying shape, similar to but larger than cigarette boxes, meant to be placed on a table, desk, or the like. For flat containers used to carry cigars, use \"cigar cases.\" For airtight containers for cigars, use \"humidors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar boxes"@en .

aat:300221188 a skos:Concept ;
    skos:definition "The state or quality of a substance of being incapable of being dissolved in another, usually specified, substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insolubility"@en .

aat:300221189 a skos:Concept ;
    skos:definition "The quality or state of lacking stability, of tending toward changeability, or of readily decomposing or changing chemically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instability"@en .

aat:300221190 a skos:Concept ;
    skos:definition "Flat, usually rectangular containers similar to but smaller than cigar cases, used to carry cigarettes. For covered boxes used as containers for cigarettes and meant to be placed on a table, desk, or the like, use \"cigarette boxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigarette cases"@en .

aat:300221191 a skos:Concept ;
    skos:definition "Covered boxes of varying shape, similar to but smaller than cigar boxes, meant to be placed on a table, desk, or the like to hold cigarettes. For flat containers used to carry cigarettes, use \"cigarette cases.\" For open cylindrical containers used to hold cigarettes, use \"cigarette holders (containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigarette boxes"@en .

aat:300221193 a skos:Concept ;
    skos:definition "Open, usually cylindrical containers used to hold cigarettes on a table, desk, or the like. For covered boxes used to hold cigarettes, use \"cigarette boxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigarette holders"@en .

aat:300221194 a skos:Concept ;
    skos:definition "Measurable properties that can be experienced through sight, sound, touch, taste, smell, or detected through a measuring tool, including color, brightness, length, height, width, mass, volume, density, hardness, solubility, ductility, malleability, heat conduction, melting and boiling points, electrical properties, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical properties"@en .

aat:300221195 a skos:Concept ;
    skos:definition "Flat, often rectangular cases, similar to but larger than cigarette cases, used to carry cigars. For covered boxes placed on a table, desk, or the like and used to hold cigars, use \"cigar boxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar cases"@en .

aat:300221196 a skos:Concept ;
    skos:definition "Bags hung on the wall, especially in tents, and used to store personal belongings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall bags"@en .

aat:300221198 a skos:Concept ;
    skos:definition "Flat-backed containers meant to be hung on the wall and used to hold plants, flowers or a variety of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall pockets"@en .

aat:300221199 a skos:Concept ;
    skos:definition "The structure of a cell revealed by electron microscopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultrastructure"@en .

aat:300221200 a skos:Concept ;
    skos:definition "Electromotive force or potential difference expressed in volts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voltage"@en .

aat:300221250 a skos:Concept ;
    skos:definition "Teapots that rest on a stand usually having a warming device such as a spirit lamp. Sometimes the stand is merely to support the teapot without a heating device; such a teapot may have a rounded bottom, as it rests on the stand rather than on a flat surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teapots with stands"@en .

aat:300221251 a skos:Concept ;
    skos:definition "Refers to those derringers actually made by Henry Deringer, the Philadelphia gunsmith who first developed the type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deringers"@en .

aat:300221252 a skos:Concept ;
    skos:definition "Low, flat utensils having short legs, upon which to rest a teapot in order to protect the surface below from the heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teapot stands"@en .

aat:300221261 a skos:Concept ;
    skos:definition "Circular dishes with vertical sides in which a soufflé is baked and served."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soufflé dishes"@en .

aat:300221263 a skos:Concept ;
    skos:definition "Shallow dishes with a series of shell-like depressions intended for serving oysters and similar shellfish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster plates"@en .

aat:300221264 a skos:Concept ;
    skos:definition "Vessels intended to hold or dispense hot water in connection with the serving of tea or coffee, often urnlike in form and having one or more taps and a spigot near the base; usually supported on legs or a stand and often having a heating device. May be part of a tea or coffee service. Prefer \"tea urns\" for similar vessels intended to hold or dispense tea and which may be part of a tea service. Prefer \"coffee urns\" for similar vessels intended to hold or dispense coffee and which may be part of a coffee service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot water urns"@en .

aat:300221265 a skos:Concept ;
    skos:definition "Bottles, usually glass and cylindrical, with sloping shoulders and a medium-length neck. They are designed to be plugged or capped, and intended to contain carbonated beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soda bottles"@en .

aat:300221266 a skos:Concept ;
    skos:definition "The quality or condition of accompanying or varying with particular seasons of the year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seasonality"@en .

aat:300221268 a skos:Concept ;
    skos:definition "Sticks held in the hand and used for support in walking, especially as a fashionable and often ornamental accessory when taking a walk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking sticks"@en .

aat:300221269 a skos:Concept ;
    skos:definition "Garments and accessories designed to be worn while engaged in a specific active sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports clothing"@en .

aat:300221270 a skos:Concept ;
    skos:definition "The quality of existing or functioning for a relatively short period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temporary"@en .

aat:300221274 a skos:Concept ;
    skos:definition "Close-fitting suits made of a material, such as sponge rubber, that water will go through but that retains body heat; worn by a water skier or diver, especially in cold water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wetsuits"@en .

aat:300221280 a skos:Concept ;
    skos:definition "Necklaces with graduated diamonds or gemstones of the same variety, usually individually set and without other ornamentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rivières"@en .

aat:300221286 a skos:Concept ;
    skos:definition "Personal articles of a bride, usually including clothing, accessories, and household linens; the term derives from an original meaning of \"bundle,\" referring to the manner in which the items were bound and carried to the bride's new home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trousseaux"@en .

aat:300221288 a skos:Concept ;
    skos:definition "The state of not being finished or completed. Includes the sense of intentionally not being brought to what is usually considered to be a final state of completion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unfinished"@en .

aat:300221290 a skos:Concept ;
    skos:definition "Dresses with an abbreviated bodice usually exposing the shoulders, arms, and back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sundresses"@en .

aat:300221294 a skos:Concept ;
    skos:definition "Medieval pouches or bags suspended from the girdle and worn by nobles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aulmonieres"@en .

aat:300221295 a skos:Concept ;
    skos:definition "Loose raincoats with a collar and belt and many pockets and flaps; usually double-breasted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trench coats"@en .

aat:300221385 a skos:Concept ;
    skos:definition "Mulelike footwear with a vamp and no quarters worn from the 15th into the 17th century and having two different functions, as slippers intended for indoor use and as overshoes with a thick sole, often of cork, intended for outdoor use. For women's shoes or overshoes with a mulelike upper and a high platform sole, use \"chopines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantofles"@en .

aat:300221386 a skos:Concept ;
    skos:definition "Triangular pieces of cloth worn across the forehead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forehead cloths"@en .

aat:300221387 a skos:Concept ;
    skos:definition "Type of ornamental headdress worn from the 14th to the 16th century, especially by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volupers"@en .

aat:300221388 a skos:Concept ;
    skos:definition "Scarflike strips of cloth or fur worn loosely around the neck with the ends left hanging in front; also, long narrow streamers of cloth attached to or part of a garment. For long pipelike extensions of a hood, use \"liripipes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tippets"@en .

aat:300221391 a skos:Concept ;
    skos:definition "Type of knitted briefs worn by men or boys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jockey shorts"@en .

aat:300221393 a skos:Concept ;
    skos:definition "Loose-fitting underpants for men, having short, trouserlike legs rather then leg openings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxer shorts"@en .

aat:300221437 a skos:Concept ;
    skos:definition "Scarflike capes of fur or cloth which fasten around the neck and hang down in front; includes those worn over vestments by clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tippets"@en .

aat:300221440 a skos:Concept ;
    skos:definition "Type of eyeglasses, often more decorative than functional, hand-held to the eye and usually mounted on a long ornamental handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lorgnettes"@en .

aat:300221442 a skos:Concept ;
    skos:definition "State of being a mother; also the qualities belonging to or associated with being a mother or being pregnant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maternity"@en .

aat:300221444 a skos:Concept ;
    skos:definition "Long sticks carried in the hand for support in walking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staffs"@en .

aat:300221446 a skos:Concept ;
    skos:definition "Low slung, usually close-fitting trousers that rest on the hips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hiphuggers"@en .

aat:300221447 a skos:Concept ;
    skos:definition "Term generally applied to very short and often tight-fitting shorts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "short shorts"@en .

aat:300221449 a skos:Concept ;
    skos:definition "Women's casual trousers with a tapered leg that ends above the ankle which often have a vertical slit at the outside bottom edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capri pants"@en .

aat:300221453 a skos:Concept ;
    skos:definition "Knee-length walking shorts worn by men and women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bermuda shorts"@en .

aat:300221454 a skos:Concept ;
    skos:definition "Neckties of thin cord fastened in front with an ornamental clasp or other device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolo ties"@en .

aat:300221455 a skos:Concept ;
    skos:definition "Pullover sweaters with a collarless neckline that fits snugly at the base of the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crew neck sweaters"@en .

aat:300221470 a skos:Concept ;
    skos:definition "Clothing intended for wear at the beach, possibly but not necessarily intended for sports. Beachwear could include bathing suits, coverups, sun hats, flip flops, and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beachwear"@en .

aat:300221546 a skos:Concept ;
    skos:definition "Men's two-piece casual suits consisting of trousers and a matching jacket styled like a shirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leisure suits"@en .

aat:300221555 a skos:Concept ;
    skos:definition "Type of small fork, usually with three tines, used to hold a piece of fruit while it is being pared or cut with a fruit knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit forks"@en .

aat:300221557 a skos:Concept ;
    skos:definition "Small cases, usually ornamental, meant to contain personal articles, such as bodkins and toothpicks. Formerly, also cases for surgical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etuis"@en .

aat:300221558 a skos:Concept ;
    skos:definition "Rims or bands that surround and hold a stone or other ornament, such as on a ring or snuff box, or a crystal, such as on a watch case or clock, or a glass or plastic covering, such as on a headlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bezels"@en .

aat:300221559 a skos:Concept ;
    skos:definition "The capacity or tendency of a material to respond to light or similar radiation. Examples include inks, dyes, paper, fabric, glass, and other materials that undergo physical changes when exposed to light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photosensitivity"@en .

aat:300221561 a skos:Concept ;
    skos:definition "Shallow, circular dessert dishes, usually made of silver, with a fluted, pierced, or scalloped border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strawberry dishes"@en .

aat:300221567 a skos:Concept ;
    skos:definition "Spherical containers used to hold cut roses and othe rflowers, sometimes having a pierced cover or a removable wire mesh through which the stems are inserted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose bowls"@en .

aat:300221575 a skos:Concept ;
    skos:definition "Term applied to a type of drinking vessel of varying size and form originating in Scotland and Northern England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoups"@en .

aat:300221576 a skos:Concept ;
    skos:definition "Smooth, flat boards of wood, stone, or plastic on which dough is rolled or kneaded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry boards"@en .

aat:300221577 a skos:Concept ;
    skos:definition "Pocket-size containers, such as bags or rolls of cloth, for carrying small articles such as thread, needles and scissors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housewives"@en .

aat:300221579 a skos:Concept ;
    skos:definition "Dispensers for rolls of tape, usually pressure-sensitive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape dispensers"@en .

aat:300221588 a skos:Concept ;
    skos:definition "Type of receptacle for a toilet sponge in the form of a sphere divided horizontally midway, the lower half resting on a spreading base and the upper half being a hinged lid having a pattern of pierced work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spongeboxes"@en .

aat:300221678 a skos:Concept ;
    skos:definition "Revolving dishlike devices that smoothly rotate on a central spindle and that have a series of equal-sized compartments on the inside made to catch a spinning ball during the game of roulette."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roulette wheels"@en .

aat:300221680 a skos:Concept ;
    skos:definition "Figural dolls that are used for play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreational dolls"@en .

aat:300221681 a skos:Concept ;
    skos:definition "Grenades designed to be thrown by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand grenades"@en .

aat:300221682 a skos:Concept ;
    skos:definition "Grenades designed to be fired by a small arm firearm with a special barrel or discharge cup, requiring a separate propelling device loaded separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rifle grenades"@en .

aat:300221683 a skos:Concept ;
    skos:definition "The feel of fabric or leather, especially its smoothness, flexibility, and softness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand"@en .

aat:300221684 a skos:Concept ;
    skos:definition "Cinctures or belts for the alb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cingula"@en .

aat:300221685 a skos:Concept ;
    skos:definition "Vestments resembling dalmatics worn by subdeacons over the alb (and also by bishops between the alb and dalmatic) at celebrations of the Eucharist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tunicles"@en .

aat:300221705 a skos:Concept ;
    skos:definition "Toys representing Noah's ark and associated pairs of animals; probably originated in Germany in the late 16th or early 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Noah's arks"@en .

aat:300221712 a skos:Concept ;
    skos:definition "Electric phenomena and properties of the earth; used in a broad sense, also includes atmospheric electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geoelectricity"@en .

aat:300221714 a skos:Concept ;
    skos:definition "The phenomena associated with electric and magnetic fields and their interactions with each other and with electric charges and currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electromagnetism"@en .

aat:300221715 a skos:Concept ;
    skos:definition "Long, loose robes, with or without sleeves, worn by Greek and Roman women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stolas"@en .

aat:300221716 a skos:Concept ;
    skos:definition "Ornamental embroidery or other decorative panels on certain ecclesiastical vestments. It is a medieval term that was revived in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apparels"@en .

aat:300221718 a skos:Concept ;
    skos:definition "Extra long skirts that usually extend to the ankle. Also, similar components of a dress, coat, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maxiskirts"@en .

aat:300221719 a skos:Concept ;
    skos:definition "Padding woven or inserted into the calves of stockings to produce the appearance of more rounded calves of the wearer; patented in 1788 and worn in the 17th, 18th and 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false calves"@en .

aat:300221720 a skos:Concept ;
    skos:definition "Wigs in which the backhair was enclosed in an ornamental bag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bagwigs"@en .

aat:300221724 a skos:Concept ;
    skos:definition "Coarse hairnets, often very decorative and used to confine the hair at the back of the neck or in a bun; sometimes attached to the back edge of a hat. For close-fitting netted caps or hairnets usually of gold, silver, silk, or wool thread worn during the 13th through the 16th century, use \"cauls (headgear).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snoods"@en .

aat:300221733 a skos:Concept ;
    skos:definition "Large silk or cotton handkerchiefs or scarves that usually have a solid ground of red or blue with simple figures or geometric forms in white or yellow resulting from a mode of dyeing in which the cloth is tied in different places, to prevent the parts from receiving the dye. From a Hindustani word for this process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandannas"@en .

aat:300221734 a skos:Concept ;
    skos:definition "Beltlike devices, worn by women especially in the Middle Ages, designed to prevent sexual intercourse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chastity belts"@en .

aat:300221735 a skos:Concept ;
    skos:definition "Hairpieces consisting of long locks of hair used to thicken or lengthen the look of one's own hair. Chiefly employed for down-hanging styles such as the long bob or pageboy bob."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falls"@en .

aat:300221737 a skos:Concept ;
    skos:definition "Necklaces composed of several rows of gold chains, beads, or jewels falling in festoons over the bosom; named for its resemblance to fetters used on enslaved people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "esclavages"@en .

aat:300221756 a skos:Concept ;
    skos:definition "Ecclesiastical vestments worn by bishops and priests consisting of a long narrow strip of silk, linen, or other cloth worn around the neck and falling from the shoulders to the knee or lower. In the Western church, the sides of the stole are crossed over the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stoles"@en .

aat:300221780 a skos:Concept ;
    skos:definition "Aerial bombs filled with incendiary substances, either liquid, jellied, or solid, and fitted with instantaneous fuzes, designed to kindle fire at their objective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incendiary bombs"@en .

aat:300221806 a skos:Concept ;
    skos:definition "The state or quality of having equal physical properties along all axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isotropy"@en .

aat:300221835 a skos:Concept ;
    skos:definition "Devices or assemblies of devices designed to support artillery and heavy small arms such as machine guns. They range from simple tripods to complex supporting, pivoting, and elevating mechanisms on gun carriages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun mounts"@en .

aat:300222035 a skos:Concept ;
    skos:definition "The use of two or more tanning processes, such as vegetable tanning and mineral tanning, to produce leather which possesses important characteristics of each method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination tannage"@en .

aat:300222048 a skos:Concept ;
    skos:definition "Use to describe objects embellished with precious or semi-precious stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jeweled"@en .

aat:300222050 a skos:Concept ;
    skos:definition "Dolls whose expressions, proportions, and dress mimic those of infants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby dolls"@en .

aat:300222053 a skos:Concept ;
    skos:definition "Folk or craft dolls of which the full figure or the head is handcrafted from cornhusks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornhusk dolls"@en .

aat:300222056 a skos:Concept ;
    skos:definition "Flat jumping jacks, usually of pasteboard, popular in France in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantins"@en .

aat:300222057 a skos:Concept ;
    skos:definition "Documents, of Pennsylvania German origin and common in the 18th and 19th centuries, often family records such as birth certificates, distinctive by a particular style of calligraphy and illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frakturs"@en .

aat:300222065 a skos:Concept ;
    skos:definition "Flexible inclined boards for springing from to increase the height of leaps in vaulting and tumbling exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springboards"@en .

aat:300222066 a skos:Concept ;
    skos:definition "Toys, usually wheeled, that are designed to be either pulled or pushed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "push-pull toys"@en .

aat:300222107 a skos:Concept ;
    skos:definition "Use only for puzzles consisting of maps mounted on pasteboard or wood and cut out into irregularly shaped pieces to be reassembled as an educational exercise; invented in the mid-18th century and popular through the early 19th century, especially in England and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissected maps"@en .

aat:300222115 a skos:Concept ;
    skos:definition "Optical devices consisting usually of two lanterns arranged so that one projected image appears to dissolve as the next image is forming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereopticons"@en .

aat:300222118 a skos:Concept ;
    skos:definition "Kettledrums of the Islamic world, the Caucasus, and Central Asia, made of silver, copper, brass, wood, or pottery with skin heads, usually though not always played in pairs tuned to different pitches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naqqāras"@en .

aat:300222119 a skos:Concept ;
    skos:definition "Shawms of southern Asia, particularly Kashmir, consisting of a wood pipe of conical bore with an integral bell, seven fingerholes and one thumbhole, a metal staple to carry the reed, and a pirouette. The reed is held in the mouth when played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surnais"@en .

aat:300222154 a skos:Concept ;
    skos:definition "Spike fiddles of Indonesia and Malaysia, with two or three strings and varying in size and shape of soundbox and length of neck from one region to another. In Java and Bali they are used in gamelan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebabs"@en .

aat:300222162 a skos:Concept ;
    skos:definition "Long-necked plucked lutelike chordophones of the Tadjiks, Uighurs, Kazaks, and Uzbeks of Central Asia, varying in size, shape, and materials from one group to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubabs"@en .

aat:300222189 a skos:Concept ;
    skos:definition "Refers to nonporous, flexible spherical or pear-shaped bags or envelope made of a lightweight material inflated with heated air or a gas that is lighter than air and designed to rise and float in the atmosphere, usually while carrying aloft passengers or scientific instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloons"@en .

aat:300222191 a skos:Concept ;
    skos:definition "Balloons anchored to the ground and grouped as protective screens to prevent or hinder operations by enemy aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrage balloons"@en .

aat:300222193 a skos:Concept ;
    skos:definition "Medium-sized end-blown straight brass trumpetlike aerophones of Tibet, of conical bore, used in pairs in Buddhist rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rag-dung"@en .

aat:300222194 a skos:Concept ;
    skos:definition "Fighters designed to identify and, if appropriate, engage enemy airborne objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interceptors"@en .

aat:300222195 a skos:Concept ;
    skos:definition "Long straight metal end-blown trumpetlike instruments of Tibet, of conical bore, made of several sections which can be telescoped together when not in use, and with a large bell which usually rests on the ground or some other support during play. They are traditionally played in pairs in Buddhist ritual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dung-chen"@en .

aat:300222196 a skos:Concept ;
    skos:definition "Military aircraft used to observe an enemy or potential adversary visually or by radar or photography; may be specifically designed or be modified fighters or bombers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reconnaissance aircraft"@en .

aat:300222202 a skos:Concept ;
    skos:definition "Manned spacecraft consisting generally of a reusable orbiter that touches down on a landing strip after each mission, reusable boosters, and an expendable fuel tank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space shuttles"@en .

aat:300222208 a skos:Concept ;
    skos:definition "Spacecraft without the physical presence of people in control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unmanned spacecraft"@en .

aat:300222209 a skos:Concept ;
    skos:definition "Unmanned spacecraft designed for nonorbital missions, such as flights to other planets or into deep space; for unmanned spacecraft designed for orbital missions, use \"artificial satellites.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space probes"@en .

aat:300222210 a skos:Concept ;
    skos:definition "Vehicles for transporting people or objects above the land, either in the atmosphere of the earth or above the atmosphere and in outer space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air and space transportation vehicles"@en .

aat:300222211 a skos:Concept ;
    skos:definition "Equipment, accessories, and instruments used in air and space transportation, not including vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerospace equipment"@en .

aat:300222212 a skos:Concept ;
    skos:definition "Auxiliary or initial propulsion systems for aircraft, missles, or spacecraft which may or may not separate from the parent craft when their fuel has been consumed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boosters"@en .

aat:300222213 a skos:Concept ;
    skos:definition "Aircraft, usually light aircraft, used for private business, sports, or recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general aviation aircraft"@en .

aat:300222214 a skos:Concept ;
    skos:definition "Boosters used to launch spacecraft into orbit or into space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "launch vehicles"@en .

aat:300222217 a skos:Concept ;
    skos:definition "Inert cartridges containing no explosive components, used in the armed forces for practice loading and manipulation of firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drill ammunition"@en .

aat:300222224 a skos:Concept ;
    skos:definition "Use to describe things perceptible by vision, usually to the unaided eye, but may be under other circumstances, such as through a microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visible"@en .

aat:300222225 a skos:Concept ;
    skos:definition "Use to describe things not perceptible by vision under given circumstances. They may become visible under different circumstances, for example through a microscope, by staining, or under different lighting conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invisible"@en .

aat:300222229 a skos:Concept ;
    skos:definition "Type of expanding bullet developed at the western Bengal town of Dum Dum, derived from a rifle cartridge. The metal envelope encasing the bullet is removed at the tip, exposing the interior lead which then expands upon impact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumdums"@en .

aat:300222278 a skos:Concept ;
    skos:definition "Use to refer to firearms that are fired from the shoulder, primarily rifles and shotguns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long guns"@en .

aat:300222280 a skos:Concept ;
    skos:definition "Mechanical puzzles consisting of plane or solid figures cut into various shapes, the goal of which is to reassemble the pieces into a prespecified form; known since the 3rd century BCE in Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissection puzzles"@en .

aat:300222281 a skos:Concept ;
    skos:definition "Solid geometric puzzles composed of interlocking notched rods of wood or plastic whose final assembled form is highly symmetrical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burr puzzles"@en .

aat:300222282 a skos:Concept ;
    skos:definition "Mechanical puzzles whose goal is assembling two- or three-dimensional pieces back together into a specified form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "put-together puzzles"@en .

aat:300222283 a skos:Concept ;
    skos:definition "Square arrays of integers arranged such that the sum of the integers in all rows, columns, and major diagonals add up to the same number; known for over 4000 years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magic squares"@en .

aat:300222284 a skos:Concept ;
    skos:definition "Puzzles composed of several parts that pose a problem for one person to solve by manipulation using logic, reasoning, insight, luck, or dexterity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical puzzles"@en .

aat:300222285 a skos:Concept ;
    skos:definition "Two-dimensional dissection puzzles consisting of five variously sized triangles, a square, and a rhomboid, which can be combined to form any of numerous other figures; probably originated in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tangrams"@en .

aat:300222339 a skos:Concept ;
    skos:definition "Containers or reservoirs in which ammunition is stored before loading, one charge at a time, into the firing chamber of a firearm; they may be detachable or an integral part of the weapon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magazines"@en .

aat:300222451 a skos:Concept ;
    skos:definition "Dolls made in the likeness of specific real people or human or humanoid fictional characters; use \"character toys\" for the broader category that includes these plus animal figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "character dolls"@en .

aat:300222454 a skos:Concept ;
    skos:definition "Parts or components of shields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shield components"@en .

aat:300222455 a skos:Concept ;
    skos:definition "Human figures outfitted in traditional national or ethnic dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costume dolls"@en .

aat:300222456 a skos:Concept ;
    skos:definition "Handles, usually of leather though very rarely of wood, riveted to the back of a shield and used to hold it. Commonly each shield has two, a fixed loop held with the hand, and an adjustable strap buckled around the arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enarmes"@en .

aat:300222460 a skos:Concept ;
    skos:definition "Metal bosses applied to the center of shields, serving to protect the handgrip. From ancient times they served as a reinforcement and sometimes as an offensive device to be used at close quarters; after the early Medieval period they tended to serve purely as decorative elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umbos"@en .

aat:300222481 a skos:Concept ;
    skos:definition "Figural toys made in the likeness of specific real persons or animals or human, humanoid, or animal fictional characters; use \"character dolls\" for the narrower category of figurines representing only specific real people or human or humanoid fictional characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "character toys"@en .

aat:300222484 a skos:Concept ;
    skos:definition "Miniature puppets fitting over and manipulated by one finger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger puppets"@en .

aat:300222490 a skos:Concept ;
    skos:definition "Buoyant boards held by the hands or arms of swimmers practicing kicking techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kickboards"@en .

aat:300222600 a skos:Concept ;
    skos:definition "Rifles used for recreational purposes, especially for hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sporting rifles"@en .

aat:300222661 a skos:Concept ;
    skos:definition "Magnetic domains within iron minerals that have been heated to above the Curie point and then cooled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoremanence"@en .

aat:300222685 a skos:Concept ;
    skos:definition "Firearms, usually shotguns, used in skeet shooting; normally autoloaders with more weight toward the front end of the gun than in field guns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeet guns"@en .

aat:300222725 a skos:Concept ;
    skos:definition "Games that involve a significant degree of individual skill and physical prowess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports"@en .

aat:300222728 a skos:Concept ;
    skos:definition "A game played on a court, typically indoor over a net with rackets and a shuttlecock. It is a combination of the children's game of battledore and shuttlecock. It is believed that the modern game was developed by British army officers in India, and was so name after a version of the game was played at Badminton House in 1873 by officers on leave, although there is no evidence of this. Versions of the game, however, were popular among the British in India by 1873."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badminton"@en .

aat:300222730 a skos:Concept ;
    skos:definition "Game of ancient origins in which two people with small rackets bat shuttlecocks from one to the other as many times as possible without allowing it to fall to the ground. Similar games with a shuttlecock existed in ancient Greece about 2000 years ago, and were later found in India, China, and Siam. In Europe it has been a children's game for several centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battledore and shuttlecock"@en .

aat:300222731 a skos:Concept ;
    skos:definition "A handball game played against a wall in a three or four-sided court, in both singles and doubles teams. The game originated in England, and there are many regional variations of play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fives"@en .

aat:300222732 a skos:Concept ;
    skos:definition "A game combining elements of tennis and handball, played on a court approximately half the size of a regular tennis court with a lower net, with a rubber ball and wooden or plastic paddles"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paddle tennis"@en .

aat:300222733 a skos:Concept ;
    skos:definition "A game of Spanish origin, played on a three -walled or enclosed court, in which two, four or six players catch and return the ball using either their bare hands or a basket-like rackets fastened to the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jai alai"@en .

aat:300222734 a skos:Concept ;
    skos:definition "A ball game for two players (or two pairs of players) occupying the same playing area in a four-walled court, in which the ball is directed with a racket against the front wall, points (in the modern game) being won by the server if the opponent is unable to return the ball successfully within the laws of the game. Rackets is distinguished from the more recent game, squash, in particular by the use of a solid, harder ball. Rackets is now played in covered indoor courts, but rackets is known to have been played in open outdoor courts before the 19th century, though the exact nature of the original game is uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rackets"@en .

aat:300222735 a skos:Concept ;
    skos:definition "A game similar to handball, played on a four-walled court with short-handled rackets and a larger, slightly softer ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racquetball"@en .

aat:300222736 a skos:Concept ;
    skos:definition "A game in which standing players push or shove wooden or plastic disks with a long cue toward numbered scoring sections marked on a board on a floor or deck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shuffleboard"@en .

aat:300222738 a skos:Concept ;
    skos:definition "Games played with playing cards, which are cards made in sets and marked in specific ways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card games"@en .

aat:300222739 a skos:Concept ;
    skos:definition "A gambling game of cards played by a banker and 2 or more punters or players who bet against the banker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baccarat"@en .

aat:300222740 a skos:Concept ;
    skos:definition "Variation of baccarat played by up to 12 players in which two hands are dealt and the winning hand is the one that comes closer to but does not exceed a count of nine on two or three cards. The name refers to the French railroad and is so called for its speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemin de fer"@en .

aat:300222741 a skos:Concept ;
    skos:definition "Card game for 2 or sometimes 3 or 4 players, in which the object is to make counting combinations for points that are scored on a cribbage board, a typically wooden board having holes into which pegs are inserted to mark the score and track the progress of the players."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cribbage"@en .

aat:300222742 a skos:Concept ;
    skos:definition "Card game for two or more persons in which the players bet on the value of the card in their hands, the winner taking the pool. There are many variations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poker"@en .

aat:300222743 a skos:Concept ;
    skos:definition "Games played with dice, which are a small polyhedral objects, usually cubes, that are marked with dots, symbols, or numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dice games"@en .

aat:300222744 a skos:Concept ;
    skos:definition "Games in which the pieces used to play are small rectangular pieces (tiles)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile games"@en .

aat:300222746 a skos:Concept ;
    skos:definition "Games, usually games of strategy such as checkers, chess, or backgammon, played by moving pieces on a board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board games"@en .

aat:300222747 a skos:Concept ;
    skos:definition "Board game played by two players in which counters, 15 per player, are moved on a specially-marked board or table; the object of the game is to race to a goal, with the movement of the counters being controlled by the throw of two dice. For the similar, older game of French origin, use \"tric-trac.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backgammon"@en .

aat:300222748 a skos:Concept ;
    skos:definition "Board game, held to be one of the oldest and most popular, played by two opponents on a checkered board with specially designed pieces of contrasting colors, commonly white and black. Players alternate turns in accordance with fixed rules, each player attempting to force the opponent's principal piece, the King, into checkmate, which is a position where it is unable to avoid capture. It first appeared in India in the 6th century CE; by the 10th century, it had spread from Asia to the Middle East and Europe. It remains popular and the focus of popular amateur and professional competitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chess"@en .

aat:300222750 a skos:Concept ;
    skos:definition "Game of chance using cards on which there is a printed grid of numbers, a row of which constitute a win when they have been chosen at random. The chosen numbers, usually up to 75 or 90, are called out by a \"banker,\" and the first player to achieve a card or a line in which all of the numbers have been called shouts \"bingo\" or \"house,\" and collects the entire stake money, usually less a specified percentage, whatever is permitted by local law. Other variations play a card in which the central square is free, and the first player on whose card five of the called numbers appear in a row, vertically, horizontally, or diagonally, is the winner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bingo"@en .

aat:300222751 a skos:Concept ;
    skos:definition "Board game in which a leader draws numbered disks at random and the players cover the corresponding numbers on pre-printed cards, the winner being the first to cover a complete row."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lotto"@en .

aat:300222752 a skos:Concept ;
    skos:definition "Games that are played on tables, either generic tables or tables designed specifically for play of a particular game."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table games"@en .

aat:300222753 a skos:Concept ;
    skos:definition "Game, probably of English origin, played with billiard cues and nine balls on an oblong board or table varying in size from 6 by 1.5 feet to 10 by 3 feet with nine numbered cups at its head, eight arranged in a circle and the ninth in its center. Of the nine balls used, one is black, four are red, and four are white. The black ball is placed upon a spot about 9 inches in front of hole number one. A line called the balk, is drawn across the board, from behind which any number of players shoot. Each player plays all eight balls up the table, with no until a ball has touched the black ball. The object of the game is to play as many balls as possible into the holes, the black ball counting double. The game is decided by the combined score made in an agreed number of rounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bagatelle"@en .

aat:300222754 a skos:Concept ;
    skos:definition "General term for a group of games that are played on a rectangular table with a designated number of small balls and a long stick called a cue. The table typically has a cushioned railing and is topped with a felt-like covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billiards"@en .

aat:300222755 a skos:Concept ;
    skos:definition "Athletic games played on a court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court games"@en .

aat:300222758 a skos:Concept ;
    skos:definition "Game similar to outdoor tennis played on a table with small paddles and a hollow celluloid or plastic ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table tennis"@en .

aat:300222759 a skos:Concept ;
    skos:definition "Sports or recreational activities that are pursued out of doors in an area of open land free of woods and buildings; often used for sports in which the field is marked and divided in a specific way for a particular sport. Also used for sports that have traditionally been played in outdoor areas, but the arenas and associated fields have been covered with large roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field sports"@en .

aat:300222760 a skos:Concept ;
    skos:definition "Game of ball between two nine-player teams usually played for nine innings on a diamond-shaped field with an infield, home plate, and three other bases 90 feet apart. This forms a circuit that must be completed by a base runner in order to score against the central offensive action, being the hitting of pitched balls with a wooden or metal bat, the winner being the team that scores the most runs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baseball"@en .

aat:300222761 a skos:Concept ;
    skos:definition "Team game played on a grass pitch, with bowling at a wicket defended by a batting player of the other team."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cricket"@en .

aat:300222762 a skos:Concept ;
    skos:definition "Sport resembling hockey, with two teams of four players each, played on horseback with long-handled mallets and the objective of propelling a wooden or plastic ball down a grass field and through a goal. It is said to be the oldest of equestrian sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polo"@en .

aat:300222763 a skos:Concept ;
    skos:definition "Physical activities that are performed in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial activities"@en .

aat:300222765 a skos:Concept ;
    skos:definition "The action or practice of ascending in balloons, which are flexible spherical bags made of a lightweight material inflated with heated air or a gas that is lighter than air. It is both a recreational activity and competitive sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballooning"@en .

aat:300222766 a skos:Concept ;
    skos:definition "Sports that involve moving along an area or path."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "course sports"@en .

aat:300222767 a skos:Concept ;
    skos:definition "Cross-country game in which a player strikes a small ball with various clubs from a series of starting points (teeing grounds) into a series of holes on a course. The player who holes his ball in the fewest strokes wins. Evidence suggests that early forms of golf were played first in the Netherlands and then in Scotland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf"@en .

aat:300222768 a skos:Concept ;
    skos:definition "Game played on a lawn, in which wooden balls are driven by means of wooden mallets through wickets or 'hoops' fixed in the ground in a particular order. The object is for a player to put the ball through as many wickets as possible before turning play over to the opponent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "croquet"@en .

aat:300222769 a skos:Concept ;
    skos:definition "Bowling sports played using a bowling alley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowling alley sports"@en .

aat:300222770 a skos:Concept ;
    skos:definition "Bowling game played on a standard tenpin lane but with slender, cylindrical pins about 15 inches tall and tapered at both ends. The ball is 4.5 inches in diameter and weighing 2 pounds, 7 ounces. Three balls are bowled in a frame but knocked down pins are not removed until the frame is completed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlepin bowling"@en .

aat:300222771 a skos:Concept ;
    skos:definition "Bowling game played on a standard tenpin lane but with pins that are 9.4 inches tall and a ball that is no larger than five inches in diameter and three pounds twelve ounces in weight with finger holes. Three balls may be rolled in each frame of the ten-frame game, but there is no bonus for knocking down all ten pins. A perfect game is 300, as it is in tenpin bowling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duckpin bowling"@en .

aat:300222772 a skos:Concept ;
    skos:definition "Game in which a heavy ball is rolled down a long, narrow lane called an alley toward ten pins, the aim being to knock down more pins than an opponent. The game is quite different from the sport of bowls, or lawn bowls, in which the aim is to bring the ball to rest near a stationary ball called the jack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenpin bowling"@en .

aat:300222773 a skos:Concept ;
    skos:definition "Bowling sports that are played on a green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowling green sports"@en .

aat:300222774 a skos:Concept ;
    skos:definition "Bowling game mostly popular in the United Kingdom and Canada that is played on an indoor carpeted rink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor bowls"@en .

aat:300222775 a skos:Concept ;
    skos:definition "Outdoor game in which a ball, called a bowl, is rolled toward a smaller stationary ball, called a jack, the object being to roll one's bowl closer the jack than that of an opponent. This is sometimes achieved by knocking aside an opponent's bowl or the jack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lawn bowls"@en .

aat:300222776 a skos:Concept ;
    skos:definition "Sports that are played on ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice sports"@en .

aat:300222777 a skos:Concept ;
    skos:definition "Game similar to lawn bowls, but played on ice, and consisting of two teams of four players, the lead, second, third, and skip. Each player slides a round stone, concave on the bottom and with a handle on the top, across a natural field or rink of ice toward the tee, or button, which is a fixed mark in the center of a circle, called the house, marked with concentric bands. The object of the game is for each side to get its stones closest to the center. A distinctive element of curling is the use of a brush, or broom, to clear the ice of debris in front of the sliding stone. The broom also provides balance for the curler during delivery of the stone and by the skip to direct aim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curling"@en .

aat:300222778 a skos:Concept ;
    skos:definition "Game between two teams of typically six players each, who wear skates and compete on an ice rink. The object is to propel a vulcanized rubber disk, called a puck, past a goal line and into a net guarded by a goaltender, or goalie, using a stick with a wooden blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice hockey"@en .

aat:300222780 a skos:Concept ;
    skos:definition "The activity of riding breaking waves toward the shore by means of a surfboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surfing"@en .

aat:300222781 a skos:Concept ;
    skos:definition "Recreation, sport, or mode of transportation that involves moving over snow by means of a pair of long, flat runners called skis, attached or bound to shoes or boots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skiing"@en .

aat:300222782 a skos:Concept ;
    skos:definition "Competitive athletic sport involving the skillful execution of physical exercises of strength, agility, and balance, involving apparatus such as mats, balance beams, parallel bars, vaulting horses, and flying rings. For the art of tumbling, balancing, and jumping presented as performance, use \"acrobatics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gymnastics"@en .

aat:300222788 a skos:Concept ;
    skos:definition "Card game in which players aim to avoid taking tricks that contain hearts. Four players each receive thirteen cards dealt one at a time from a standard 52-card deck. In the first deal, each player discards three cards and passes them facedown to the player to the left and then replaces them with the three passed by the right-hand player. In the second deal, three cards are similarly passed to the right, and in the third, they are passed to the player sitting opposite, and in the fourth there is no passing, and each person must play with their remaining cards. This four-deal cycle then repeats itself. The ultimate winner is the player with the lowest penalty score when one or more players have reached 100 penalty points. Penalties are scored at the rate of one point for each heart, and 13 points for the queen of spades in a trick, thus, there are 26 penalty points in each deal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearts"@en .

aat:300222790 a skos:Concept ;
    skos:definition "Dice game, played on a special table and layout, where all bets are made against the house. A player signifies his bet by placing chips or cash on the appropriate part of the layout before all rolls, and it is required that the dice be thrown in such a way that they strike a wall of the table and bounce back. In a version known as bank craps, the player or shooter, throwing the dice, or anyone wishing to bet that the shooter will win, places his bet \"on the line,\" in the areas marked \"Pass,\" \"Come,\" or \"Win.\" Anyone betting against the shooter, places his bet in the areas marked \"Don't Pass\" or \"Don't Come.\" The shooter is said to win if he throws seven or eleven on his first throw and lose if he instead throws two, three, or twelve (craps). Bets are then paid off. If the shooter's first throw is four, five, six, eight, nine, or ten, that number is his point, and he continues to throw until he rolls the same number again and wins or throws seven (misses out, or craps out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craps"@en .

aat:300222791 a skos:Concept ;
    skos:definition "Tile game of Chinese origin usually played by four players with 144 dominolike pieces or tiles marked in suites, counters, and dice, the object being to collect winning combinations of tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mah jongg"@en .

aat:300222793 a skos:Concept ;
    skos:definition "Game in which two opposing players or pairs of players use tautly strung rackets to hit a ball of regulated size, weight, and bounce over a net on a rectangular court. Points are awarded to the player or team whenever the opponent fails to correctly return the ball within the prescribed dimensions of the court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tennis"@en .

aat:300222794 a skos:Concept ;
    skos:definition "Game played by two teams, usually of six per side, in which players use their hands to bat a ball back and forth over a high net, trying to make the ball land in the opponents' court area before it can be returned. A team is allowed to touch the ball only three times ball before it must be returned over the net."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volleyball"@en .

aat:300222795 a skos:Concept ;
    skos:definition "Game played on a rectangular field with a nettled goal at each end, in which two teams of eleven players each compete to drive a small leather ball into each other's goal using a stick with a curved end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field hockey"@en .

aat:300222799 a skos:Concept ;
    skos:definition "Game, originated by Native Americans, in which two ten-member teams attempt to score by putting a small ball into each other's netted goal with a crosse, a stick with a netted pouch at the end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacrosse"@en .

aat:300222800 a skos:Concept ;
    skos:definition "Form of football played between two fifteen member teams, where players may carry the ball, block with hands and arms, and tackle, and is characterized by continuous play and no substitute players."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rugby"@en .

aat:300222801 a skos:Concept ;
    skos:definition "Football as played under Association rules, where two teams of 11 players each may use any part of their bodies except their hands and arms to maneuver a round ball into the opposing team's goal. Only the goalkeeper is permitted to handle the ball and may do so only within the penalty area surrounding the goal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soccer"@en .

aat:300222802 a skos:Concept ;
    skos:definition "Recreation, sport, or mode of transportation that involves moving over the ice by means of a pair shoes fitted with a metal blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice skating"@en .

aat:300222803 a skos:Concept ;
    skos:definition "Sport in which ice skaters, singly or in pairs, perform graceful movements of jumps, spins, and lifts. The name is derived from the patterns or figures skaters make on the ice, a required part of the sport until recently. There are various kinds of figure skating, including freestyle, pairs, and ice dancing. Rules of competition, as well as the moves and techniques of the skaters, vary for each category of skating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figure skating"@en .

aat:300222804 a skos:Concept ;
    skos:definition "Sport of racing on ice skates on an oval track against other competitors or the clock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speed skating"@en .

aat:300222807 a skos:Concept ;
    skos:definition "French ball game played between two players or teams, who take turns throwing or rolling a ball or boule, usually made of steel, as close as possible to the target ball, called the jack, or cochonnet. If necessary, the player will use his ball to knock the opponent's ball away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petanque"@en .

aat:300222808 a skos:Concept ;
    skos:definition "Activity of planing over the surface of the water while standing on skis, which are long, slender boardlike devices attached to the foot, while being towed by a motorboat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterskiing"@en .

aat:300222809 a skos:Concept ;
    skos:definition "Alpine ski racing for speed on a course marked by gates formed by paired poles, set at least 26 feet apart, through which the racer must pass. The racer who completes the course in the shortest time, without missing any gates or knocking down any poles, is the winner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downhill skiing"@en .

aat:300222810 a skos:Concept ;
    skos:definition "Type of skiing that came out of the hilly terrain of Norway and the other Scandinavian countries, it includes cross-country skiing and ski-jumping events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nordic skiing"@en .

aat:300222812 a skos:Concept ;
    skos:definition "Card game popular in the United States, Australia, and Great Britain. It was derived from the from a 19th-century Alsatian game called juckerspiel, from the fact that its two top trumps are Jucker, meaning \"jack,\" and in turn this word may influenced the term joker for the extra card that appears as the topmost trump in the American euchre in the 1860s. Euchre is played by two, three, or four persons, usually with 32, but sometimes 28 or 24 cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "euchre"@en .

aat:300222814 a skos:Concept ;
    skos:definition "American card game typically played by three players acting alone or four players in two partnerships. The name means \"eyeglasses,\" and refers to the scoring combination of the queen of spades and the jack of diamonds, because the game originated with a deck of cards in which these characters were depicted in profile, having one eye apiece and therefore two eyes in combination. Pinochle is played with 48 cards, with two cards of each rank and suit with aces high through ten, king, queen, jack, and nine low. Tricks as are taken and a table lists storable card combinations in simplified scoring system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinochle"@en .

aat:300222815 a skos:Concept ;
    skos:definition "Any number of various card games for two, three, or four players, each typically being dealt seven, nine, or ten cards, in which the object is to match cards into sets and sequences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rummy"@en .

aat:300222816 a skos:Concept ;
    skos:definition "Trick-taking card game developed in England, which is seen as a early form of bridge, only without bidding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whist"@en .

aat:300222817 a skos:Concept ;
    skos:definition "Game for from two to six players, derived from Halma, which is a checkers-type board game invented about 1880. In Chinese checkers, players attempt to move a number of pieces, usually 10 or 15 marbles, on a board in the shape of a six-pointed star that has holes instead of squares. It was introduced in the United States in the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese checkers"@en .

aat:300222818 a skos:Concept ;
    skos:definition "Indian board game for four players in opposing partnerships of two in which game pieces are moved around a cross-shaped track. Moves are determined by throws of cowrie shells or dice, and each player begins with four pieces, at the center and moves down the middle track counter clockwise around the outer track of the board. The partnership whose pieces first complete the course by returning to the centre space is the winner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pachisi"@en .

aat:300222819 a skos:Concept ;
    skos:definition "Board game for two players of East Asian origin, popular in China, Korea, and especially Japan. It is said to have originated in China about 4,000 years ago, and brought to Japan about 500 BCE. Traditionally, go is played with 181 black and 180 white, flat, round stones called go-ishi on a square, wooden board called a goban, checkered by 19 vertical lines and 19 horizontal lines to form 361 intersections. More recently it is played electronically. Each player takes turns, black moves first, conquering territory by completely enclosing vacant points with boundaries made of their own stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "go"@en .

aat:300222820 a skos:Concept ;
    skos:definition "Table game in which players take turns shooting discs across a circular playing surface marked with scoring regions, while also attempting to knock the discs of their opponents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crokinole"@en .

aat:300222822 a skos:Concept ;
    skos:definition "Sports that are played on racket courts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racket court sports"@en .

aat:300222823 a skos:Concept ;
    skos:definition "A casino and gambling game in which players place bets on the turning of a round roulette wheel which has 37 or 38 separately numbered red and black compartments in which a ball must land. \"Roulette\" is a French word meaning \"small wheel.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roulette"@en .

aat:300222826 a skos:Concept ;
    skos:definition "Characteristics and qualities that are related to the physical properties of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geophysical properties"@en .

aat:300222830 a skos:Concept ;
    skos:definition "Characteristics and qualities that are inherent in electric currents and magnetic fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electromagnetic properties"@en .

aat:300222980 a skos:Concept ;
    skos:definition "The degree to which an image is distinct in its details as a function of the spacing of individual optical elements, such as grains of light-sensitive chemicals in a photograph or pixels in an electronic image; an important factor affecting image quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resolution"@en .

aat:300222997 a skos:Concept ;
    skos:definition "Devices used to tune instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuning devices"@en .

aat:300222998 a skos:Concept ;
    skos:definition "Devices consisting of two or more musical instruments or of a musical instrument with another type of device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination instruments"@en .

aat:300223011 a skos:Concept ;
    skos:definition "Polls taken by sampling a cross section of the public in an effort to predict election results or establish public attitudes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public opinion polls"@en .

aat:300223016 a skos:Concept ;
    skos:definition "Metal rolled to any given thickness between 0.06 and 0.249 inches and cut into rectangular sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet metal"@en .

aat:300223022 a skos:Concept ;
    skos:definition "Portraits taken in a professional photographer's studio, often making use of backdrops or props."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studio portraits"@en .

aat:300223163 a skos:Concept ;
    skos:definition "Bathing suits consisting of a matching but separate top and bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-piece bathing suits"@en .

aat:300223188 a skos:Concept ;
    skos:definition "Parts and components of frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frame components"@en .

aat:300223191 a skos:Concept ;
    skos:definition "General term used for grouping concepts related to magnetism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetism-related concepts"@en .

aat:300223447 a skos:Concept ;
    skos:definition "A distinctive effect of weathering, often affecting stone, characterized by a pattern of small cavities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alveolar weathering"@en .

aat:300223464 a skos:Concept ;
    skos:definition "Properties relating to or resembling those of dielectrics, substances such as air, ceramics, or wax, that act as electrical insulators and can sustain an electric field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dielectric properties"@en .

aat:300223526 a skos:Concept ;
    skos:definition "Remanence that is being examined or analyzed with regard to geologic materials, such as sediments and lava flows, especially in periods preceding human civilization. When examined with regard to archaeological remains, prefer \"archaeomagnetism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleomagnetism"@en .

aat:300223724 a skos:Concept ;
    skos:definition "Analysis under dynamic conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamic analysis"@en .

aat:300223733 a skos:Concept ;
    skos:definition "The level corresponding to the surface of the sea at mean level between high and low tides, used as a standard for the measurement of heights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea level"@en .

aat:300223750 a skos:Concept ;
    skos:definition "Extraneous matter, especially of an inferior or contaminating nature, that is mixed with desirable matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impurities"@en .

aat:300223790 a skos:Concept ;
    skos:definition "Causing a liquid to spread over a given surface or to penetrate into a given material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wetting"@en .

aat:300223791 a skos:Concept ;
    skos:definition "The act of making or the process of becoming white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whitening"@en .

aat:300223793 a skos:Concept ;
    skos:definition "Refers to a method of drying materials or objects in a frozen state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freeze-drying"@en .

aat:300223800 a skos:Concept ;
    skos:definition "The removal of extraneous matter, especially of an inferior or contaminating nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purification"@en .

aat:300223809 a skos:Concept ;
    skos:definition "Addition of a structural element to something, usually in another material, for the purpose of improving its strength or stiffness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reinforcement"@en .

aat:300223820 a skos:Concept ;
    skos:definition "Substitution of one item or element for another, often something lost, worn out, destroyed, or otherwise no longer satisfactory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "replacement"@en .

aat:300223824 a skos:Concept ;
    skos:definition "The process of making free from living microorganisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sterilization"@en .

aat:300223828 a skos:Concept ;
    skos:definition "Process of comparing photometrically the relative intensities of the light in different parts of a spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectrophotometry"@en .

aat:300223830 a skos:Concept ;
    skos:definition "Describes objects that are or have been in the ground and covered with, often in direct contact with, earth. For structures intentionally built below the earth's surface, use \"underground structures.\" With regard to the effects of being buried, use \"underground environments.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buried"@en .

aat:300223930 a skos:Concept ;
    skos:definition "Mirrors contained in frames that have strong architectural features, often including side columns and pediments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural mirrors"@en .

aat:300223932 a skos:Concept ;
    skos:definition "Mirrors in which the center is closer to the object than the edges and that reflect reduced images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convex mirrors"@en .

aat:300223934 a skos:Concept ;
    skos:definition "Concave or convex mirrors designed to start fires by focusing rays of sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning mirrors"@en .

aat:300223935 a skos:Concept ;
    skos:definition "Mirrors in which the center is farther away from the object than the edges and that reflect enlarged or reduced images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concave mirrors"@en .

aat:300223936 a skos:Concept ;
    skos:definition "Modern term for mirrors with a carved eagle surmounting the frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Constitution mirrors"@en .

aat:300223940 a skos:Concept ;
    skos:definition "Term generally applied to mirrors that have flat reflective surfaces, as opposed to those with a convex or concave surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat mirrors"@en .

aat:300223942 a skos:Concept ;
    skos:definition "Mirrors believed to have magical properties, often made with special materials and under certain astrological conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magic mirrors"@en .

aat:300223948 a skos:Concept ;
    skos:definition "Chromatography of volatile substances existing in or converted to a vapor state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas chromatography"@en .

aat:300223968 a skos:Concept ;
    skos:definition "Mirrors designed to be hung on the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall mirrors"@en .

aat:300223972 a skos:Concept ;
    skos:definition "Exploring an area, especially in search of mineral deposits; for the examining of an area to achieve a comprehensive view of it, prefer \"surveying.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prospecting"@en .

aat:300223980 a skos:Concept ;
    skos:definition "An English variation of the Lutma frame, but having more pronounced ornamentation; named for Althorp Lord Sunderland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sunderland frames"@en .

aat:300223986 a skos:Concept ;
    skos:definition "Repairing holes or tears in woven fabric by adding supplemental threads to duplicate as nearly as possible the weave and tension of the original fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reweaving"@en .

aat:300223989 a skos:Concept ;
    skos:definition "The temperature at which a liquid begins to cloud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloud point"@en .

aat:300223990 a skos:Concept ;
    skos:definition "Statistical technique in which the spatial locations, distributions, and relations of designated factors are analyzed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spatial analysis"@en .

aat:300224038 a skos:Concept ;
    skos:definition "Photogrammetry using stereoscopic photographs taken under precisely controlled conditions or using a computer system to resolve and interpret any two or more photographs of the same location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereophotogrammetry"@en .

aat:300224104 a skos:Concept ;
    skos:definition "Sound devices that create atmospheric or natural sounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambient sound makers"@en .

aat:300224105 a skos:Concept ;
    skos:definition "Devices which do not produce sound themselves but modify the sound produced by something else, such as human breath. For equipment that transmits and reproduces sound, without necessarily modifying it, see \"sound transmitting and reproducing equipment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound modifying devices"@en .

aat:300224106 a skos:Concept ;
    skos:definition "Unavoidable dangers or risks, or things causing such dangers or risks, though often foreseeable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hazards"@en .

aat:300224116 a skos:Concept ;
    skos:definition "Large transverse flutes used in Hindustani or North Indian classical music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bansuris"@en .

aat:300224127 a skos:Concept ;
    skos:definition "Lip-vibrated aerophones of conical bore made from marine shells, usually conchs. They may be furnished with a mouthpiece, or simply have a hole bored in the tip, if end-blown, or in the spiraling part of the shell, if side-blown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine shell trumpets"@en .

aat:300224129 a skos:Concept ;
    skos:definition "Japanese transverse flutes of the No theater, made from three to six short lengths of bamboo joined together. They resemble the \"ryuteki\" in that they have seven fingerholes, a balancing weight in the upper end, a red-lacquered bore, and a wrapping of bark or twine, but are distinct from them in having a short tube inserted in the bore between the mouth hole and the nearest fingerhole, a metal ornament embedded in the upper end, and the inner red lacquer showing on the outside of the mouth hole and fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nokan"@en .

aat:300224132 a skos:Concept ;
    skos:definition "Vertical flutes of the Han Chinese, made of a bamboo tube with a notch cut into one end, against the edge of which the player blows. Known since ancient times, they have existed in various forms with differing numbers and arrangements of fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xiao"@en .

aat:300224146 a skos:Concept ;
    skos:definition "Taking away or getting rid of something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "removing"@en .

aat:300224161 a skos:Concept ;
    skos:definition "Fluorescence stimulated by x-rays; when the emissions are examined by spectrometry, useful in determining chemical composition of a substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray fluorescence"@en .

aat:300224192 a skos:Concept ;
    skos:definition "A broad class of chordophones having the plane of the strings running parallel to a soundbox and a neck that serves both as string bearer and as handle. Although this whole class is sometimes referred to as lutes, use \"lutes\" only for the particular plucked chordophones developed in the European Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lutelike chordophones"@en .

aat:300224193 a skos:Concept ;
    skos:definition "A broad class of chordophones consisting of a string bearer, typically a soundboard, one or more strings, and no neck. Although this whole class is sometimes referred to as zithers, use \"zithers\" only for the particular modern plucked chordophones developed in the Alpine region of Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zitherlike chordophones"@en .

aat:300224196 a skos:Concept ;
    skos:definition "Refers to the technique of exposing something to radiation, whether of x-rays, ultraviolet light, or other type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irradiation"@en .

aat:300224200 a skos:Concept ;
    skos:definition "Ancient manuscripts generally taking the form of the modern book: bound leaves of paper or parchment with information inscribed on both faces, attached at a center fold. For books that are printed rather than inscribed, before 1501, use 'incunabula.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codices"@en .

aat:300224206 a skos:Concept ;
    skos:definition "The washing of textile items, such as shirts and linens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundering"@en .

aat:300224209 a skos:Concept ;
    skos:definition "Two-stringed fiddles of North Africa, with a boat- or pear-shaped soundbox covered with skin, no frets, a pegbox, and little or no neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebabs"@en .

aat:300224226 a skos:Concept ;
    skos:definition "Costume indicative or characteristic of a calling, rank, or function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "habits"@en .

aat:300224227 a skos:Concept ;
    skos:definition "Manner of dressing required by custom or etiquette for formal or semiformal evening occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening dress"@en .

aat:300224228 a skos:Concept ;
    skos:definition "Dress for daytime social functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "afternoon dress"@en .

aat:300224229 a skos:Concept ;
    skos:definition "Dress appropriate for a ball, masquerade, or the like, usually characteristic of a particular period or place, class of persons, or a historical or fictional character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy dress"@en .

aat:300224230 a skos:Concept ;
    skos:definition "Walking sticks, especially those with a curved handle and made of cane or bamboo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canes"@en .

aat:300224233 a skos:Concept ;
    skos:definition "Rear flaps of a man's coat, such as on a tail coat, cutaway, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coattails"@en .

aat:300224238 a skos:Concept ;
    skos:definition "Bands encircling the crown of a hat; sometimes worn as a badge of mourning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatbands"@en .

aat:300224239 a skos:Concept ;
    skos:definition "Distinctive uniforms worn by servants or other classes of people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livery"@en .

aat:300224240 a skos:Concept ;
    skos:definition "Staffs tipped with metal used as a badge of office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tipstaffs"@en .

aat:300224242 a skos:Concept ;
    skos:definition "Feathery edge at the border of a sheet of hand- or mold-made paper, caused by the deckle or frame which confines the pulp to the mold; also on some machine-made papers, caused by the rubber deckle straps at the sides of the paper machine, or made by artificial means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deckle edges"@en .

aat:300224243 a skos:Concept ;
    skos:definition "Extended parts of a skirt, gown, or state robe that lie on the floor and trail behind the wearer, either separate or attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trains"@en .

aat:300224244 a skos:Concept ;
    skos:definition "Bands encircling the waist, especially as a part of a skirt or pair of trousers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waistbands"@en .

aat:300224269 a skos:Concept ;
    skos:definition "Long-necked, fretless, plucked lutelike instruments of the Indian subcontinent, with a round-backed resonator and, traditionally, four metal strings, used exclusively to provide a humming drone accompaniment to vocal and instrumental melodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tamburas"@en .

aat:300224275 a skos:Concept ;
    skos:definition "Techniques of dating where phases or objects can be put into a sequence relative to each other but cannot be tied to calendar years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relative dating"@en .

aat:300224276 a skos:Concept ;
    skos:definition "Techniques of dating which result in dates given in terms of calendar years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absolute dating"@en .

aat:300224283 a skos:Concept ;
    skos:definition "Zitherlike chordophones of Timor, the strings of which are either of copper, strung in pairs around the tubular bamboo or wood string bearer, or cut out and raised from the string bearer itself. The tube is surrounded by a palm leaf resonator. For similar chordophones from Madagascar, use \"valihas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sesandos"@en .

aat:300224285 a skos:Concept ;
    skos:definition "Grand pianos of the largest size, about 9 feet or more in length, adapted in volume, timbre, and brilliancy of tone to concert use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concert grand pianos"@en .

aat:300224294 a skos:Concept ;
    skos:definition "Parts or components that are used during keyboard actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyboard action components"@en .

aat:300224295 a skos:Concept ;
    skos:definition "In piano actions, a hammer is a slender wooden shank with a padded wooden head that strikes the strings when the corresponding key is pressed down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammers"@en .

aat:300224297 a skos:Concept ;
    skos:definition "Large double-conical drums of West Africa with a tubular open foot at the base, played upright, usually in pairs, each being of a different pitch; one of the pair often has a jingle suspended across the drum head. They serve as talking drums on ceremonial occasions, and as accompaniment to ritual singing and dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atumpans"@en .

aat:300224299 a skos:Concept ;
    skos:definition "Hourglass rattle drums of the Indian subcontinent, the Himalayas, and Mongolia, having a body usually made of wood or metal (in Tibet often of human skulls), with two thin skins wrapped around wooden hoops tightened by V-lacings and a central crosslacing. Two cords knotted at the ends or with pellets of wood, clay, or other hard material threaded on their ends, are attached to the central lacing; the knots or pellets strike the drum heads when the drum is twirled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damarus"@en .

aat:300224309 a skos:Concept ;
    skos:definition "Parts or components of keyboard instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyboard instrument components"@en .

aat:300224312 a skos:Concept ;
    skos:definition "Upright pieces of wood placed one per key at the inner end of every key in a keyboard action, communicating its action to the string by means of a quill, tangent, or hammer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacks"@en .

aat:300224314 a skos:Concept ;
    skos:definition "Small upright metal blades or pins placed one per key at the inner end of every key in a clavichord, that strike the strings to produce the tone and fix the pitch by damping the strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tangents"@en .

aat:300224316 a skos:Concept ;
    skos:definition "Thin flexible strips of wood that exert a pulling action and transmit motion from one place to another. In pipe organs, they are connected to and activate the valves beneath the pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trackers"@en .

aat:300224321 a skos:Concept ;
    skos:definition "Combination instruments featuring the hammer action of the piano with the plucking jacks of the harpsichord, developed in the early 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harpsichord pianos"@en .

aat:300224322 a skos:Concept ;
    skos:definition "Keyboard instruments combining a harpsichord with an organ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claviorgans"@en .

aat:300224323 a skos:Concept ;
    skos:definition "Instruments combining a piano controlled from one keyboard with an organ controlled from another, very popular in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piano organs"@en .

aat:300224399 a skos:Concept ;
    skos:definition "Light that falls across a surface at an acute angle, often revealing irregularities of the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raking light"@en .

aat:300224429 a skos:Concept ;
    skos:definition "Linings applied to the edge of a garment for ornament or strengthening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facings"@en .

aat:300224431 a skos:Concept ;
    skos:definition "Study of the relationship between the physical properties of substances and their chemical properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical chemistry"@en .

aat:300224439 a skos:Concept ;
    skos:definition "Providing statements of the meanings of words or phrases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "definition"@en .

aat:300224445 a skos:Concept ;
    skos:definition "Broad class of coating applied specifically to protect a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protective coating"@en .

aat:300224450 a skos:Concept ;
    skos:definition "Solvent that does not contain water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonaqueous solvent"@en .

aat:300224452 a skos:Concept ;
    skos:definition "Material which is an electrical insulator or in which an electric field can be sustained with a minimum of dissipation in power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dielectric"@en .

aat:300224504 a skos:Concept ;
    skos:definition "Objects, and sometimes animals or plants, closely associated with a specific person or deity and used in an image to identify that figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attributes"@en .

aat:300224524 a skos:Concept ;
    skos:definition "Very deep, turned-back cuffs on a man's coat; they frequently reached the bend of the elbow. Fashionable from 1727 to the 1740s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boot cuffs"@en .

aat:300224525 a skos:Concept ;
    skos:definition "Chest protectors of wool, flannel, or fur, which also served as bust-improvers. In use in the late 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bosom friends"@en .

aat:300224526 a skos:Concept ;
    skos:definition "Pieces of self-fabric pleated and puckered, such as on a gown, petticoat or scarf, in the form of a flounce or swag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furbelows"@en .

aat:300224529 a skos:Concept ;
    skos:definition "Riding habits, worn chiefly by women in the 18th century, which button all the way down the front and have a small collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "josephs"@en .

aat:300224533 a skos:Concept ;
    skos:definition "Strings which guide and support children who are learning to walk. Sometimes in the form of reinforced cloth attached to the shoulders and hanging to the ankles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leading strings"@en .

aat:300224534 a skos:Concept ;
    skos:definition "Plain or decorative strips of material worn to fill in a low neckline, especially on a dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modesties"@en .

aat:300224535 a skos:Concept ;
    skos:definition "Overdresses with a decoratively draped skirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polonaises"@en .

aat:300224536 a skos:Concept ;
    skos:definition "Long, loose greatcoats which have large buttons and one or more spreading collars called capes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surtouts"@en .

aat:300224537 a skos:Concept ;
    skos:definition "Narrow pieces of lace, lawn, or other soft cloth worn by women inside or around the neck opening when wearing a low-cut bodice, especially from the 17th to the early 19th century. For more shaped accessories or main garments made with or without sleeves and worn especially from the 19th to the early 20th century, use \"chemisettes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuckers"@en .

aat:300224538 a skos:Concept ;
    skos:definition "Dresses with a tight bodice and a sack-back consisting of two box pleats, popular in the 18th century. These can be attached at the shoulders and hang freely to the ground or be stitched down on each side of the back seam from the neckline to the waist of the full skirt. Typically worn with a fichu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacks"@en .

aat:300224540 a skos:Concept ;
    skos:definition "Rectangular pieces of cloth wrapped around an infant and pinned in place or bound with swaddling bands, to keep the arms fixed by the sides and the legs straight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beds"@en .

aat:300224541 a skos:Concept ;
    skos:definition "Informal or ordinary dress not usually worn in public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undress"@en .

aat:300224571 a skos:Concept ;
    skos:definition "Use to describe things pertaining to anodes, especially phenomena taking place in the vicinity of anodes or materials formed by such phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anodic"@en .

aat:300224572 a skos:Concept ;
    skos:definition "Use to describe things pertaining to cathodes, especially phenomena taking place in the vicinity of cathodes or materials formed by such phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathodic"@en .

aat:300224592 a skos:Concept ;
    skos:definition "Use to describe things produced by human action, as opposed to natural causes, but not intended to substitute for natural counterparts. For things produced by human action and intended to substitute for their natural counterparts, use \"artificial.\" For things produced specifically by synthesis, use \"synthetic.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "man-made"@en .

aat:300224619 a skos:Concept ;
    skos:definition "Jewels or ornaments attached to a long pin; also tufts or bunches of ribbon, velvet, flowers, or threads of silk, worn in the hair, on a cap, or dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pompons"@en .

aat:300224625 a skos:Concept ;
    skos:definition "End-blown marine shell trumpets of Japan, made of a conch shell either with a wood or metal mouthpiece fitted to the narrow end or with the pointed end snipped off and the hole polished smooth for blowing. They have been used since at least the 7th century in Buddhist ritual, and also for signalling troops in battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horagai"@en .

aat:300224633 a skos:Concept ;
    skos:definition "Tops containing reeds that vibrate and hum when the tops spin. Found worldwide, they are sometimes intended as children's toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humming tops"@en .

aat:300224636 a skos:Concept ;
    skos:definition "Loosely hanging sets of pieces of glass, metal, ceramic, wood, or other hard material that tinkle when the wind blows through them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind chimes"@en .

aat:300224706 a skos:Concept ;
    skos:definition "Chemical analysis on a minute scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microanalysis"@en .

aat:300224710 a skos:Concept ;
    skos:definition "Methods of analysis that characterize material by examining how it responds to heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal analysis"@en .

aat:300224742 a skos:Concept ;
    skos:definition "Printed pieces such as notices or advertisements intended for distribution by hand or by mail. For those intended for posting, use \"posters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fliers"@en .

aat:300224774 a skos:Concept ;
    skos:definition "Graphic images that are designed for ready recognition of a product, company, or organization and sometimes used as trademarks, and that are word- or letter-based, derived from the name. For those graphic images similarly used but more symbol- or picture-based, use \"logos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logotypes"@en .

aat:300224794 a skos:Concept ;
    skos:definition "Use to describe firearms with two barrels, one above the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "over-and-under"@en .

aat:300224800 a skos:Concept ;
    skos:definition "The greatest stress, especially in tension, that a material, such as a fiber, can withstand without rupture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breaking strength"@en .

aat:300224809 a skos:Concept ;
    skos:definition "Large, sliding rondels that protect the inside of the elbow, the armpit, or another joint. They are usually round or oval, attached by straps, rivets, or laces to upper body armor such as pauldrons, spaudlers, and vambraces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "besagews"@en .

aat:300224812 a skos:Concept ;
    skos:definition "Supplementary pieces of armor attached to pieces of a basic set in order to reinforce the protection and suit it for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double pieces"@en .

aat:300224814 a skos:Concept ;
    skos:definition "Photometers that measure the relative intensity of radiant energy of specified wavelengths that is transmitted or reflected by a given substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectrophotometers"@en .

aat:300224816 a skos:Concept ;
    skos:definition "Sets of armor generally consisting of a full field armor with double pieces; from this could be formed a half armor or a three-quarter armor for warfare, or an armor for tournament combat on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small garnitures"@en .

aat:300224817 a skos:Concept ;
    skos:definition "Sets of armor consisting of a full field armor plus a large number of double pieces to form sets for the tilt, barriers, and foot combat, with a full bard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great garnitures"@en .

aat:300224832 a skos:Concept ;
    skos:definition "Double pieces consisting of outward-curving flanges of plate metal, either riveted to the pauldrons or forged in one piece with the gardbraces, designed to provide extra protection for the neck. Used from the mid-15th to the mid-16th century by horsemen, often they were made removable for foot combat or the field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haute-pieces"@en .

aat:300224840 a skos:Concept ;
    skos:definition "Scales or balances designed for weighing the ingredients of medicinal and other formulas prescribed by physicians and dispensed by pharmacists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prescription scales"@en .

aat:300224845 a skos:Concept ;
    skos:definition "Weighing devices used in the process of determining components of a material, as in the percentage of pure metal in a specimen of ore, bullion, or alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assay scales"@en .

aat:300224846 a skos:Concept ;
    skos:definition "Balances in which the weighing surfaces are small flat platforms or shallow trays with little travel and set above the beam; used with conventional weights or a side weighing beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trip scales"@en .

aat:300224847 a skos:Concept ;
    skos:definition "Scales generally characterized as having a large dial on the front of a box containing the mechanism, on top of which is mounted the weighing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dial scales"@en .

aat:300224850 a skos:Concept ;
    skos:definition "Double pieces of plate armor for the pauldron, worn to reinforce the lower three-quarters of the front of the pauldron and attached to it by pins, pegs, or rivets; first appeared in the early 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gardbraces"@en .

aat:300224852 a skos:Concept ;
    skos:definition "Armored gauntlets of hourglass form, popular in the 14th and early 15th centuries, characterized by a short, flared cuff and a back consisting of a single plate embossed to the shape of the knuckles and the base of the thumb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hourglass gauntlets"@en .

aat:300224855 a skos:Concept ;
    skos:definition "Scales designed for use in market shops or marketplaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market scales"@en .

aat:300224856 a skos:Concept ;
    skos:definition "Weighing devices especially designed for weighing railway equipment, either empty or loaded, singly or coupled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "track scales"@en .

aat:300224857 a skos:Concept ;
    skos:definition "Tubular pieces of plate armor shaped to fit the lower arm, constituting part of the vambrace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lower cannons"@en .

aat:300224858 a skos:Concept ;
    skos:definition "Tubular pieces of plate armor shaped to cover the upper arm, constituting part of the vambrace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper cannons"@en .

aat:300224859 a skos:Concept ;
    skos:definition "Detachable reinforcing pieces of plate armor shaped to cover the bent left elbow. They served as double pieces for tilt armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pasguards"@en .

aat:300224861 a skos:Concept ;
    skos:definition "Pieces of plate armor attached to the breastplate, early in their development only to the lower half but later extending over the whole, doubling its thickness. They served as double pieces for both tournament and field armor, becoming increasingly common as firearms increased in power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plackarts"@en .

aat:300224862 a skos:Concept ;
    skos:definition "Large, heavy pieces of plate armor shaped like a wing or shell, attached to the lower cannon of the vambrace, worn with tilt armor to protect the elbow and armpit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poldermittons"@en .

aat:300224863 a skos:Concept ;
    skos:definition "Deep, one-piece sallets with a vision slit cut into them, sometimes furnished with a reinforced brow and a roller on their lower front edge, designed especially for the Rennen, the German style of joust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rennhüte"@en .

aat:300224865 a skos:Concept ;
    skos:definition "Conical helmets constructed of a number of segments and bands, known since Roman times and in use in a modified form until the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spangenhelme"@en .

aat:300224869 a skos:Concept ;
    skos:definition "Automatic rifles developed from submachine guns during the Second World War for use with cartridges intermediate in size and power between pistol and rifle cartridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assault rifles"@en .

aat:300224880 a skos:Concept ;
    skos:definition "Type of flintlock developed in Spain in the 17th century, involving an externally mounted heavy mainspring and cocking mechanism attached to the lock plate, which operates on the cock by pressing downward on its toe, or, more commonly, upward on its heel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miquelet locks"@en .

aat:300224888 a skos:Concept ;
    skos:definition "Miquelet locks in which the external mainspring operates on the cock by pressing downwards on its heel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian miquelets"@en .

aat:300224901 a skos:Concept ;
    skos:definition "The scattering of radiation, such as x-rays, in a direction approximately opposite to that of the incident radiation and due to reflection from particles of the medium traversed; sometimes produced and examined as a technique for analyzing materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backscattering"@en .

aat:300224908 a skos:Concept ;
    skos:definition "Pullover sweaters having a neckline following the curve of the collar bone; high in the front and back, wide at the sides, and ending in shoulder seams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boatneck sweaters"@en .

aat:300224923 a skos:Concept ;
    skos:definition "Small round coverings for a woman's nipples worn especially by a stripteaser."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pasties"@en .

aat:300224926 a skos:Concept ;
    skos:definition "Describes automatic and semiautomatic firearms in which the pressure of the propellant gas is used to force the barrel forward from a standing breech to open the action and eject the fired case. A spring brings the barrel back to firing position and also reloads and cocks the firearm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blow-forward action"@en .

aat:300224932 a skos:Concept ;
    skos:definition "Use to describe automatic and semiautomatic firearms in which the pressure of the propellant gas is used to force the bolt to the rear, independently of the barrel, which does not move relative to the receiver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blowback action"@en .

aat:300224935 a skos:Concept ;
    skos:definition "Strips of cloth passed from front to back between the legs, attached to and supported by a cord or band around the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "G-strings"@en .

aat:300224940 a skos:Concept ;
    skos:definition "Women's or girls' close-fitting, sleeveless tops, often elasticized and usually having boning or facing to give shape and bust support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bustiers"@en .

aat:300224943 a skos:Concept ;
    skos:definition "Athletic shoes specifically intended for use while running."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running shoes"@en .

aat:300224946 a skos:Concept ;
    skos:definition "Use to describe automatic and semiautomatic firearms that utilize part of the gas from the explosion in the barrel to unlock the bolt and actuate the loading mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas-operated"@en .

aat:300224947 a skos:Concept ;
    skos:definition "Use to describe automatic and semiautomatic firearms that utilize recoil to throw back or unlock the bolt or slide and actuate the loading mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recoil-operated"@en .

aat:300224949 a skos:Concept ;
    skos:definition "Sound having frequencies greater than 20,000 Hz; often applied in testing and therapy techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultrasound"@en .

aat:300224955 a skos:Concept ;
    skos:definition "The use of or investigation with an electron microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron microscopy"@en .

aat:300224957 a skos:Concept ;
    skos:definition "The activity of using a scanning electron microscope, which is designed for directly studying the surfaces of solid objects, utilizing a beam of focused electrons of relatively low energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scanning electron microscopy"@en .

aat:300224962 a skos:Concept ;
    skos:definition "The act or process of treating something, usually by adding or applying a substance, before proceeding with additional treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pretreatment"@en .

aat:300224965 a skos:Concept ;
    skos:definition "Measuring devices, usually in the form of flat sticks, bearing various scales for computing board feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board rules"@en .

aat:300224969 a skos:Concept ;
    skos:definition "Measures taken to prevent infestation and the health hazards caused by it and to prevent damage to materials and artifacts caused by unwanted creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pest control"@en .

aat:300224970 a skos:Concept ;
    skos:definition "Measuring devices combining rulers with calipers having one jaw fixed to or integral with a graduated straight bar on which the other jaw slides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caliper rules"@en .

aat:300224971 a skos:Concept ;
    skos:definition "Mechanisms for opening and closing the breech of a breech-loading firearm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breech mechanisms"@en .

aat:300224972 a skos:Concept ;
    skos:definition "Mechanisms on breechloading firearms featuring a manually operated cylindrical bolt with an external lever which the shooter pulls back to open the breech and extract the empty case of a fired cartridge and pushes forward to push a fresh cartridge into firing position and close the breech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolt actions"@en .

aat:300224979 a skos:Concept ;
    skos:definition "The act or process of reducing a gas or vapor to a liquid or solid form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condensation"@en .

aat:300224980 a skos:Concept ;
    skos:definition "Mechanisms on breechloading firearms in which a lever, usually an extension of the trigger guard, is used to open and close the breech. In repeaters, the lever also ejects spent cartridges, loads fresh ones, and cocks the firearm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lever actions"@en .

aat:300224985 a skos:Concept ;
    skos:definition "Mechanisms in breechloading firearms in which a sliding handgrip below the barrel is pulled back to open the breech and extract the case, and pushed forward to reload."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pump actions"@en .

aat:300224986 a skos:Concept ;
    skos:definition "The measuring of viscosity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viscometry"@en .

aat:300224987 a skos:Concept ;
    skos:definition "Chromatography with paper strips or sheets as the adsorbent through which the solution flows by gravity or is sucked up by capillarity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper chromatography"@en .

aat:300224997 a skos:Concept ;
    skos:definition "Parts or components of firearms barrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firearms barrel components"@en .

aat:300224999 a skos:Concept ;
    skos:definition "Rear sections of the barrels of firearms, containing the chamber in which the charge is ignited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breeches"@en .

aat:300225000 a skos:Concept ;
    skos:definition "The technique for dating that examines the relation between elapsed time and the degradation of amino acids in proteins, specifically the racemization of amino acids in collagen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amino acid dating"@en .

aat:300225001 a skos:Concept ;
    skos:definition "The tubular hollow interiors of the barrels of firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bores"@en .

aat:300225002 a skos:Concept ;
    skos:definition "Rules having graduated sliding attachments that are extendable for taking linear measurements and inside dimensions between objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extension rules"@en .

aat:300225003 a skos:Concept ;
    skos:definition "Movable metal blocks fitting into the breeches of firearms, serving to close and seal the breech opening of the barrel during firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breechblocks"@en .

aat:300225005 a skos:Concept ;
    skos:definition "Parts or components of breech mechanisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breech mechanism components"@en .

aat:300225006 a skos:Concept ;
    skos:definition "Sliding breechblocks incorporating a firing pin, cartridge case extractor, and one or more lugs to lock them into firing position, found in bolt action, automatic, and semiautomatic breechloading rifles, machine guns, and submachine guns with blowback action. They guide ammunition into the chamber and rotate to lock the breech mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolts"@en .

aat:300225007 a skos:Concept ;
    skos:definition "The making of radiographs on a minute or microscopic scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microradiography"@en .

aat:300225010 a skos:Concept ;
    skos:definition "Firearm locks in which the entire mechanism is either set into the stock or contained within a metal boxlike frame, rather than mounted on external side plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box locks"@en .

aat:300225016 a skos:Concept ;
    skos:definition "Radiography utilizing a specially coated plate that allows a picture to be developed without the use of liquid chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xeroradiography"@en .

aat:300225019 a skos:Concept ;
    skos:definition "Use to describe firearms, usually pistols or revolvers, in which a single pull of the trigger first cocks the firearm and then releases the hammer to fire it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double action"@en .

aat:300225020 a skos:Concept ;
    skos:definition "Use to describe firearms in which the firing mechanism, including the hammer, is completely inside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammerless"@en .

aat:300225038 a skos:Concept ;
    skos:definition "Very heavy pistols intended for use by big game hunters when attacked by wounded animals, and carried on a saddle or howdah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "howdah pistols"@en .

aat:300225056 a skos:Concept ;
    skos:definition "Measuring devices, usually in the form of flat sticks, 3 to 6 feet long, bearing various scales and tables for estimating the amount of sawn timber to be obtained from unsawn logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log rules"@en .

aat:300225067 a skos:Concept ;
    skos:definition "Small arms, especially short-barreled shotguns, often fitted with an attachment for a bayonet, used in guard duty or to disperse rioters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riot guns"@en .

aat:300225068 a skos:Concept ;
    skos:definition "Large bore, single-shot shotguns mounted on a punt or specially designed boat, used to shoot waterfowl sitting on the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punt guns"@en .

aat:300225076 a skos:Concept ;
    skos:definition "Hammerlike parts of percussion lock firearms and some other cartridge firearms, that by their fall or action fire the weapon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammers"@en .

aat:300225078 a skos:Concept ;
    skos:definition "Chemically treated cords that burn at a uniform rate, used to fire the powder charge in matchlock firearms and some cannons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slow-matches"@en .

aat:300225086 a skos:Concept ;
    skos:definition "Surveyors' distance measuring devices consisting of interconnected metal links of precise length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measuring chains"@en .

aat:300225115 a skos:Concept ;
    skos:definition "Woodworking rules graduated into eighths of an inch along one edge and sixteenths of an inch along the other edge and usually made of maple or hickory with brass tips; may also be metrically divided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bench rules"@en .

aat:300225117 a skos:Concept ;
    skos:definition "Wooden rules having extra large and bold numbers; produced during the first half of the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blindman's rules"@en .

aat:300225125 a skos:Concept ;
    skos:definition "Matchlocks in which a cock or serpentine, holding the match, is held pressed into the pan of priming powder by a spring. When the firearm is cocked, the match is held up from the pan; when fired, it snaps rapidly down, igniting the powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snap-matchlocks"@en .

aat:300225131 a skos:Concept ;
    skos:definition "Developed version of the snaphance, having a lug at the end of a combined sear and trigger lever, which projects through an opening in the lock plate inside in front of the cock to hold it at half cock. They are found most often on Scottish pistols of the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scottish snaphances"@en .

aat:300225133 a skos:Concept ;
    skos:definition "A type of snaphance incorporating the flintlock's combined steel and pan cover but with a laterally, not vertically, operating sear working on the cock through an opening in the lock plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English locks"@en .

aat:300225138 a skos:Concept ;
    skos:definition "Refers to schedules that show specific times at which certain events are expected or intended to occur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timetables"@en .

aat:300225141 a skos:Concept ;
    skos:definition "Percussion locks in which the priming powder is held in a bottle-shaped pivoting magazine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scent-bottle percussion locks"@en .

aat:300225146 a skos:Concept ;
    skos:definition "The striking arms holding the gunflint in flintlocks, snaphances, and miquelet locks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocks"@en .

aat:300225147 a skos:Concept ;
    skos:definition "Firearm safety catches found on dog locks, consisting of small pivoted hooks located behind the cock which engage in a notch in the cock's heel to hold it at half cock, enabling the firearm to be safely carried ready-loaded and primed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog catches"@en .

aat:300225150 a skos:Concept ;
    skos:definition "Those parts of firearm locks that engage the hammer to hold it at full or half cock, until released by the trigger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sears"@en .

aat:300225152 a skos:Concept ;
    skos:definition "Measuring devices usually about 2 feet long, used to measure human feet for shoes. They are roughly in the form of caliper gauges with one adjustable toe stop and a fixed heel stop, and calibrated either in shoe sizes or inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "size sticks"@en .

aat:300225153 a skos:Concept ;
    skos:definition "Graduated rules in which the divisions are slightly larger than standard units of measure so that patternmakers can oversize their patterns to allow for shrinkage during woodworking or metal casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrinkage rules"@en .

aat:300225154 a skos:Concept ;
    skos:definition "Wooden rods cut to the proposed clear height between finished floors and ceilings of buildings and often marked with subdivisions to aid in the laying out of, for example, door trims, masonry courses, or stair risers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "story rods"@en .

aat:300225157 a skos:Concept ;
    skos:definition "Wooden rods 1 inch square and 10 feet long marked along the length into feet and inches; used by builders and carpenters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ten-foot rods"@en .

aat:300225159 a skos:Concept ;
    skos:definition "Narrow rectangular wooden rods, varying in length from about 16 1/2 inches to 24 inches, with a small brass projection for positioning the rod in the bung hole of a cask, designed to measure the wantage or shortage of partially filled casks; usually calibrated with tables for casks of various capacities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wantage rods"@en .

aat:300225174 a skos:Concept ;
    skos:definition "Use to describe firearms having two barrels positioned one alongside the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side-by-side"@en .

aat:300225196 a skos:Concept ;
    skos:definition "The process or result of becoming yellow, such as in fabric or paper due to aging or environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellowing"@en .

aat:300225200 a skos:Concept ;
    skos:definition "Rules with proportioned graduations for measuring or making scale drawings. The term refers to a graduated strip of metal or wood used for measuring length as well as to a rule drawn or otherwise indicated on an architectural drawing, map, or other work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scales"@en .

aat:300225203 a skos:Concept ;
    skos:definition "Environments along shores of bodies of water, affected by factors of both the land and the water. Regarding the geology or geography of coastal areas, prefer \"shores (landforms)\" or \"coastlines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal environments"@en .

aat:300225204 a skos:Concept ;
    skos:definition "Environments located in oceans or other salt water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine environments"@en .

aat:300225205 a skos:Concept ;
    skos:definition "Environments completely or mainly under water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquatic environments"@en .

aat:300225207 a skos:Concept ;
    skos:definition "The conditions of atmosphere in a small area or confined space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microclimate"@en .

aat:300225246 a skos:Concept ;
    skos:definition "Alternative pieces of armor that could be exchanged with others in a set to adapt it for various purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pieces of exchange"@en .

aat:300225254 a skos:Concept ;
    skos:definition "Priming powder, especially for firearms ammunition, derived from fulminic acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fulminate"@en .

aat:300225356 a skos:Concept ;
    skos:definition "Small metal caps containing a priming powder, used to ignite the propellant in the developed version of the percussion lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussion caps"@en .

aat:300225390 a skos:Concept ;
    skos:definition "A method of detecting the presence of objects under water by means of sonic and ultrasonic waves that are reflected from the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sonar"@en .

aat:300225507 a skos:Concept ;
    skos:definition "The scattering of x-rays as they traverse a medium; sometimes produced and examined as a technique for analyzing materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray scattering"@en .

aat:300225551 a skos:Concept ;
    skos:definition "Rules for measuring the height of capital letters for copy fitting and layout, often of a transparent material and usually graduated in points, picas, and inches or centimeters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type gauges"@en .

aat:300225552 a skos:Concept ;
    skos:definition "Rules used to measure the distance from one base line of type to another and marked off in various units, usually point scales and picas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line gauges"@en .

aat:300225553 a skos:Concept ;
    skos:definition "Rules generally laid out in picas along one edge and graduated in inches along the other for measuring widths or margins or for centering of copy for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pica rulers"@en .

aat:300225635 a skos:Concept ;
    skos:definition "Sabatons with broad, blunt toe caps, popular in the mid-16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bear-paw sabatons"@en .

aat:300225636 a skos:Concept ;
    skos:definition "General term for fighting swords carried by mounted knights attached to the belt, used for both cutting and thrusting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arming swords"@en .

aat:300225637 a skos:Concept ;
    skos:definition "Rules comprised of short strips of wood joined at their ends by rivets so that the pieces are foldable, in a zigzag manner, in parallel planes; most usually the strips are in 6-inch or 1-foot lengths, and the rules are 6 feet or 8 feet long when open; also of similar lengths in metric units. Distinct from \"folding rules\" which tend to be shorter and have sections that usually pivot or fold in more than one plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zigzag rules"@en .

aat:300225638 a skos:Concept ;
    skos:definition "Long, straight-bladed swords with a grip long enough to allow them to be grasped by one hand plus two or three fingers of the other, used in the 15th and 16th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastard swords"@en .

aat:300225645 a skos:Concept ;
    skos:definition "Rules containing graduations and various data conversion tables for making measurements and calculations of use to carpenters; since about 1800 most commonly 2-foot, two-fold or four-fold rules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpenters' rules"@en .

aat:300225648 a skos:Concept ;
    skos:definition "Surveying instruments used to determine relative elevation, generally comprised of a telescope rigidly attached to a vertical spindle, thus capable of only horizontal rotary movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dumpy levels"@en .

aat:300225655 a skos:Concept ;
    skos:definition "Mechanical or optical devices on firearms, for aiming them or for positioning an artillery piece in position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sights"@en .

aat:300225664 a skos:Concept ;
    skos:definition "Devices attached to vehicles for hire to measure the horizontal distance traveled, and sometimes also time elapsed during motionless intervals, and to compute the fare due."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taximeters"@en .

aat:300225671 a skos:Concept ;
    skos:definition "Horn-shaped portable containers for carrying priming powder or gunpowder, especially those made from the horn of a cow or ox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder horns"@en .

aat:300225689 a skos:Concept ;
    skos:definition "Concepts related to the acknowledgement of status or merits, usually but not always positive recognition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social recognition"@en .

aat:300225692 a skos:Concept ;
    skos:definition "Things offered to be competed for, or sometimes won by chance; may include objects, privileges, money, honors, or tokens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prizes"@en .

aat:300225705 a skos:Concept ;
    skos:definition "People or organizations who communicate with others by correspondence. For people employed by a newspaper or broadcasting company to contribute regular news reports or interpretations from a location distant from the home office, use \"correspondents (reporters).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "correspondents"@en .

aat:300225709 a skos:Concept ;
    skos:definition "Cans having a long spout through which oil is poured or squirted, such as to lubricate machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oilcans"@en .

aat:300225740 a skos:Concept ;
    skos:definition "Examination with the naked eye, to distinguish from more technical modes of analysis employing tools or apparatus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual inspection"@en .

aat:300225748 a skos:Concept ;
    skos:definition "Testing techniques that do not damage or destroy the sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nondestructive testing"@en .

aat:300225763 a skos:Concept ;
    skos:definition "Processes involving changes in atomic nuclei."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear reaction"@en .

aat:300225767 a skos:Concept ;
    skos:definition "Processes by which minerals are introduced into other matter, such as into rock to form ore deposits or into organic components to form fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineralization"@en .

aat:300225771 a skos:Concept ;
    skos:definition "Chemical analysis aimed at determining the proportions of the substances present in a sample of a material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quantitative analysis"@en .

aat:300225774 a skos:Concept ;
    skos:definition "Chemical analysis aimed at examining the nature of a material's chemical constituents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qualitative analysis"@en .

aat:300225778 a skos:Concept ;
    skos:definition "A method of removing or reducing the acid content, usually of paper, utilizing alcohol or another nonaqueous solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonaqueous deacidification"@en .

aat:300225783 a skos:Concept ;
    skos:definition "The chemical analysis of materials by the separation of the constituents and their estimation by weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravimetric analysis"@en .

aat:300225795 a skos:Concept ;
    skos:definition "Fitted sleeves or covers worn on the forearm to protect a shirt sleeve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeve protectors"@en .

aat:300225799 a skos:Concept ;
    skos:definition "Light meters that convert measured data into readings that allow photographers to adjust lens apertures and shutter speeds on cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exposure meters"@en .

aat:300225809 a skos:Concept ;
    skos:definition "Close-fitting jackets with a standing, Mandarin-style collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nehru jackets"@en .

aat:300225816 a skos:Concept ;
    skos:definition "Light meters measuring in footcandles the intensity of visible light falling on surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footcandle meters"@en .

aat:300225839 a skos:Concept ;
    skos:definition "Photometers which measure the intensity of visible light falling upon surfaces or reflected by surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light meters"@en .

aat:300225852 a skos:Concept ;
    skos:definition "Light meters that measure in metric units called lux the intensity of visible light falling on surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luxmeters"@en .

aat:300225875 a skos:Concept ;
    skos:definition "Technique for measuring small absorptions, applied when small concentrations molecular species must be detected in the presence of other components at high pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoacoustic spectroscopy"@en .

aat:300225881 a skos:Concept ;
    skos:definition "Analytic technique by which chemical substances are identified by the sorting of gaseous ions in electric and magnetic fields according to their mass-to-charge ratio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass spectrometry"@en .

aat:300225890 a skos:Concept ;
    skos:definition "Refers to that portion of the electromagnetic spectrum beyond that visible to the human eye. Infrared radiation has waves longer than red light and shorter than the shortest microwaves. Though not visible, it may be detected as the sensation of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared radiation"@en .

aat:300225910 a skos:Concept ;
    skos:definition "Costume accessories worn in conjunction with hair on the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair accessories"@en .

aat:300225921 a skos:Concept ;
    skos:definition "Refers to the pointers or indicators of the passage of time on clocks and watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hands"@en .

aat:300225923 a skos:Concept ;
    skos:definition "Extremely accurate electronic clocks using the natural frequency of vibrations of quartz crystals to regulate the clock's movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz clocks"@en .

aat:300225925 a skos:Concept ;
    skos:definition "Slips with a foundation included in the bodice portion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bra slips"@en .

aat:300225926 a skos:Concept ;
    skos:definition "Boots made for winter wear, usually fur-trimmed and lined, often calf-high; originally worn by women over shoes or slippers to keep their feet warm as they rode in carriages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage boots"@en .

aat:300225927 a skos:Concept ;
    skos:definition "Very short jackets or sweaters with sleeves cut in one with the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrugs"@en .

aat:300225929 a skos:Concept ;
    skos:definition "Boxes intended primarily for the storage of handkerchiefs; often of fabric and quite decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handkerchief boxes"@en .

aat:300225930 a skos:Concept ;
    skos:definition "Bags used to protect shoes while in storage or when traveling. Often made in pairs and generally of a soft fabric with a drawstring closure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe bags"@en .

aat:300225931 a skos:Concept ;
    skos:definition "Boxes, usually long and narrow, for the storage of gloves when not in use. Sometimes contains a fitting on the interior of the lid for the storage of glove stretchers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glove boxes"@en .

aat:300225932 a skos:Concept ;
    skos:definition "Boxes, usually with round interior fittings, for the storage of collars and cuffs in a curved position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collar and cuff boxes"@en .

aat:300225933 a skos:Concept ;
    skos:definition "Small cases of varying form and material intended primarily for holding eyeglasses. May be quite decorative and sometimes suspended from a chain so they can be worn on the person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyeglass cases"@en .

aat:300225937 a skos:Concept ;
    skos:definition "Containers of varying form and size intended primarily for a traveler's belongings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luggage"@en .

aat:300226037 a skos:Concept ;
    skos:definition "Fine-grained powder, typically gunpowder or fulminate, used to ignite the propellant or main explosive in a firearm or explosive device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "priming powder"@en .

aat:300226127 a skos:Concept ;
    skos:definition "The process of cutting spiral grooves in the surface of a firearm projectile or the bore of a firearm barrel, also for the system of grooves so cut. The grooves impart a spinning motion to the projectile, thus equalizing its balance in flight and stabilizing its trajectory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rifling"@en .

aat:300226128 a skos:Concept ;
    skos:definition "Puppets operated, usually from below, by a main control rod with or without subsidiary rods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rod puppets"@en .

aat:300226130 a skos:Concept ;
    skos:definition "Mirrors having curved, rather than flat, reflective surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curved mirrors"@en .

aat:300226134 a skos:Concept ;
    skos:definition "Large usually rectangular boards at sports venues used primarily to display the score and other relevant facts, figures, or images of the game in progress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scoreboards"@en .

aat:300226136 a skos:Concept ;
    skos:definition "Exploring the floor of a body of water, by eye or with instruments, to achieve a comprehensive view, usually of its geological or archaeological features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater surveying"@en .

aat:300226146 a skos:Concept ;
    skos:definition "A geophysical technique of surveying involving the measurement of distortions of the earth's normal magnetic field; used in archaeology especially to locate buried remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic surveying"@en .

aat:300226162 a skos:Concept ;
    skos:definition "Recreational equipment that is used with games and activities that do not involve competition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noncompetitive play equipment"@en .

aat:300226163 a skos:Concept ;
    skos:definition "Method of dating by measuring the direction and intensity of the archaeomagnetism in materials and comparing the results to known records of fluctuations in the earth's magnetic field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeomagnetic dating"@en .

aat:300226168 a skos:Concept ;
    skos:definition "Dolls with bodies of cloth or cloth stuffed with various materials, as rags, sawdust, or papyrus leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth dolls"@en .

aat:300226175 a skos:Concept ;
    skos:definition "The making of precise reproductions in the same dimensions as the original. The term is often reserved for three-dimensional objects, often involving casting from a mold made directly from the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "replication"@en .

aat:300226182 a skos:Concept ;
    skos:definition "Study of the structure of metal and alloys, especially such study with the microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallography"@en .

aat:300226183 a skos:Concept ;
    skos:definition "Explanation of what is not immediately plain or explicit, as in suggesting what meaning is to be found in a set of data or in a visual work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interpretation"@en .

aat:300226216 a skos:Concept ;
    skos:definition "Scrutinizing a situation or object, usually in order to determine its nature, qualities, or current condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "examination"@en .

aat:300226220 a skos:Concept ;
    skos:definition "The systematic examination of land or water areas from aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial surveying"@en .

aat:300226228 a skos:Concept ;
    skos:definition "Surrounding, enclosing, or protecting something as if in a capsule; for example, in paper conservation, the sealing of an item between two sheets of polyester film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encapsulation"@en .

aat:300226229 a skos:Concept ;
    skos:definition "Sets or ensembles of containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "container groupings"@en .

aat:300226279 a skos:Concept ;
    skos:definition "Brooches made in the form of a flat disc, to the back of which is attached a fastening pin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disc brooches"@en .

aat:300226282 a skos:Concept ;
    skos:definition "Any of several types of compasses having the legs joined by a bow-shaped piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow compasses"@en .

aat:300226291 a skos:Concept ;
    skos:definition "Compact cameras made to resemble a variety of objects like books or opera glasses or made to be concealed in clothing; used for taking pictures unnoticed and often from unexpected angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detective cameras"@en .

aat:300226299 a skos:Concept ;
    skos:definition "Photographs made to sell clothing and accessories or show them to advantage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion photographs"@en .

aat:300226310 a skos:Concept ;
    skos:definition "Film that is sensitized to invisible infrared wavelengths. It is used in aerial photography to cut through atmospheric haze (which scatters blue light but not infrared rays) and for special purposes in scientific and forensic photography. First developed in 1919."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared film"@en .

aat:300226317 a skos:Concept ;
    skos:definition "The technique of taking photographs using a brief, brilliant burst of light, synchronized with the camera's shutter activation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash photography"@en .

aat:300226324 a skos:Concept ;
    skos:definition "The state of being secure against violation such as theft or vandalism, and for the precautions taken to assure such a state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "security"@en .

aat:300226325 a skos:Concept ;
    skos:definition "Any equipment or accessories used to provide a flash light for photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash equipment"@en .

aat:300226334 a skos:Concept ;
    skos:definition "Streams of electrons or positrons emitted from an atomic nucleus in a certain type of radioactive decay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beta rays"@en .

aat:300226345 a skos:Concept ;
    skos:definition "Making flat, as in removing wrinkles or folds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flattening"@en .

aat:300226349 a skos:Concept ;
    skos:definition "The application of a substance, as to textiles or stone, so that the substance interpenetrates, fills, or saturates the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impregnation"@en .

aat:300226357 a skos:Concept ;
    skos:definition "The process of raising the level of relative humidity in a closed environment, such as a building or room; use also for the treatment of items by making them moist, such as by the application of steam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humidification"@en .

aat:300226360 a skos:Concept ;
    skos:definition "The persistent presence of pests, especially in large numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infestation"@en .

aat:300226373 a skos:Concept ;
    skos:definition "Sleighs originally designed by James Gould of Albany, New York, and generally characterized by sweeping lines and rounded, or swelled, bodies; often with colorfully decorated panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albany cutters"@en .

aat:300226375 a skos:Concept ;
    skos:definition "Horse-drawn military vehicles used in the 19th century to transport tools and materials for repairing an artillery battery's equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battery wagons"@en .

aat:300226376 a skos:Concept ;
    skos:definition "Ancient war or racing chariots drawn by two horses abreast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bigas"@en .

aat:300226381 a skos:Concept ;
    skos:definition "Heavy driving vehicles with a high driving seat and no body designed for training horses for carriage driving or for exercising or breaking horses; not used for pleasure driving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breaks"@en .

aat:300226382 a skos:Concept ;
    skos:definition "Carriages developed in Poland and Austria in the early 19th century and eventually popular in England for long-distance travel since the interior seating compartment could be converted into sleeping quarters; often featuring a large rear-facing seat to accommodate servants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "britzkas"@en .

aat:300226411 a skos:Concept ;
    skos:definition "Intentionally loading with additional weight; with regard to fibers and textiles, the addition of a substance to increase the weight or bulk of the fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weighting"@en .

aat:300226421 a skos:Concept ;
    skos:definition "Various types of wagons, often horse-drawn, used by circuses to transport props, equipment, or animals; often richly decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circus wagons"@en .

aat:300226524 a skos:Concept ;
    skos:definition "Square, boxlike, unassuming buggies having two or more movable seatboards set at the same level as the driver's seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "democrat wagons"@en .

aat:300226536 a skos:Concept ;
    skos:definition "Four-wheeled carriages of simple construction in which passengers sit astride a narrow bench extending between axles; found primarily in Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "droshkies"@en .

aat:300226541 a skos:Concept ;
    skos:definition "Seaplanes supported on water by one or more floats, usually attached to the fuselage and/or wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "float planes"@en .

aat:300226542 a skos:Concept ;
    skos:definition "Seaplanes with a boatlike hull or fuselage providing buoyancy and the ability to plane across the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying boats"@en .

aat:300226545 a skos:Concept ;
    skos:definition "Small, light, two-wheeled wagonette-type carts with rounded or tub shape entered through a door in the rear and with bodies of wood or basketwork; usually drawn by ponies and considered safe for children to ride; developed in England in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governess carts"@en .

aat:300226546 a skos:Concept ;
    skos:definition "Light, two-wheeled carriages, open or hooded, akin to gigs and chaises but, instead of having shafts, equipped with traces and a center pole to be drawn by two horses abreast; popular in England and the United States from the mid-18th to the mid-19th century, although production continued into the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curricles"@en .

aat:300226553 a skos:Concept ;
    skos:definition "Firefighting vehicles in which water pumps are manually activated by parallel bars along the sides of the vehicle; often pulled or pushed manually, as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand pumpers"@en .

aat:300226562 a skos:Concept ;
    skos:definition "Vehicles designed to carry ladders and other gear that does not fit on the main firefighting engines, historically horse-drawn but now motor vehicles, usually tractor-trailers, equipped with long extensible ladders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hook and ladder trucks"@en .

aat:300226563 a skos:Concept ;
    skos:definition "Four-wheeled, usually horse-drawn, firefighting vehicles mounting large reels for carrying fire hoses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hose carriages"@en .

aat:300226564 a skos:Concept ;
    skos:definition "Any of various large- to medium-sized, horse-drawn vans or wagons designed to carry ice for sale on a street-delivery basis; generally enclosed boxlike vehicles, with roof overhangs, covered driver's seat, and platform springs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice wagons"@en .

aat:300226565 a skos:Concept ;
    skos:definition "Refers to cut-down versions of landaus seating two passengers facing forward and covered by a folding hood, and, by extension, for automobiles having a convertible top over the back seat, the front seat being either roofed or open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landaulets"@en .

aat:300226566 a skos:Concept ;
    skos:definition "Testing techniques that impose conditions on an object or material to cause it to age more rapidly than it would naturally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accelerated aging"@en .

aat:300226578 a skos:Concept ;
    skos:definition "Horse-drawn passenger wagons used in the American West for excursions into rugged terrain, fitted with multiple bench seats and heavy suspension; used from the mid-19th to the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain wagons"@en .

aat:300226579 a skos:Concept ;
    skos:definition "A technique for repairing paper by which paper pulp is pulled through areas of loss so as to fill the lacunae with freshly cast paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leafcasting"@en .

aat:300226583 a skos:Concept ;
    skos:definition "Weathering that has been caused to proceed at an unusually fast pace, whether by special environmental conditions or by intentionally imposed testing conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accelerated weathering"@en .

aat:300226588 a skos:Concept ;
    skos:definition "American sleighs with light angular bodies seating four passengers; developed in Portland, Maine, in the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portland cutters"@en .

aat:300226589 a skos:Concept ;
    skos:definition "Four-wheeled carriages carrying both passengers and mail; used during the 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post chaises"@en .

aat:300226590 a skos:Concept ;
    skos:definition "Weapons designed to cause combustion at a specific target or destination, including those composed of generally noncombustible materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incendiary weapons"@en .

aat:300226591 a skos:Concept ;
    skos:definition "Refers specifically to sets of armor pieces designed as a whole to possess particular physical characteristics, usually to suit a particular purpose. For the general meaning of all costume designed to be worn or carried to protect the body in combat, either entire sets or individual pieces, see \"armor.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armors"@en .

aat:300226596 a skos:Concept ;
    skos:definition "Suits incorporating a Norfolk jacket with either knickerbockers, trousers, or a skirt of matching fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norfolk suits"@en .

aat:300226600 a skos:Concept ;
    skos:definition "Jackets made with a box pleat on either side of the center front and a box pleat at center back, also having pockets on the hips and a self belt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norfolk jackets"@en .

aat:300226607 a skos:Concept ;
    skos:definition "Women's tight-fitting trousers that extend to just below the knee and are often made of velvet, silk, or the like; of a type traditionally worn by bullfighters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toreador pants"@en .

aat:300226610 a skos:Concept ;
    skos:definition "Bands of tape, webbing, or elasticized fabric arranged in an oblong panel which may be slightly curved over the bustline. Worn to compress the breasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bust reducers"@en .

aat:300226617 a skos:Concept ;
    skos:definition "Light carts for one or two passengers drawn by a single horse or pony; popular during the late 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "road carts"@en .

aat:300226626 a skos:Concept ;
    skos:definition "Detachable trailers for hauling freight with wheels at the rear and with the front end normally supported on the rear of a truck tractor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semitrailers"@en .

aat:300226629 a skos:Concept ;
    skos:definition "Short horizontal, usually wooden, bars attached to eveners or splinter bars or crossbar shafts of vehicles and to which the traces of draft animals are attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swingletrees"@en .

aat:300226630 a skos:Concept ;
    skos:definition "Four-wheeled pleasure carriages having two or three seats seating two or three passengers each, with or without doors, with or without a separate driver's seat, occasionally open or with an umbrella or half top; popular in the early to mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sociables"@en .

aat:300226631 a skos:Concept ;
    skos:definition "Gentlemen's light phaetons for pleasure or competitive show driving generally characterized by tilbury bodies set on four wheels, often having spindle-back seats and a skeleton rumble seat for grooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spider phaetons"@en .

aat:300226639 a skos:Concept ;
    skos:definition "Formal coaches used in Europe for ceremonial processions or state business by royalty, nobility, or persons in high official positions; usually elaborately decorated and drawn by six or more horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state coaches"@en .

aat:300226642 a skos:Concept ;
    skos:definition "High performance gliders designed for sustained flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailplanes"@en .

aat:300226643 a skos:Concept ;
    skos:definition "Light, two-wheeled, one-horse carriages, similar to chaises, but with space for only one person and generally driven by men; some varieties are used as exercise or show carts and in harness racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulkies"@en .

aat:300226724 a skos:Concept ;
    skos:definition "Wagons with closed bodies of medium height mounted on platform springs and outfitted with numerous shelves or compartments for carrying the wares of traveling merchants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peddlers' wagons"@en .

aat:300226788 a skos:Concept ;
    skos:definition "Thicknesses of some material laid, spread, or deposited onto a surface, or composing strata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "layers"@en .

aat:300226800 a skos:Concept ;
    skos:definition "Those materials that form an outermost coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface layers"@en .

aat:300226811 a skos:Concept ;
    skos:definition "Objects or parts of objects that are formed on a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turnery"@en .

aat:300226816 a skos:Concept ;
    skos:definition "Characteristics and qualities of form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "form attributes"@en .

aat:300226822 a skos:Concept ;
    skos:definition "Plain quilted or padded coats of textile or leather, often sleeveless, worn either under metal armor or as the sole protective garment, in use from at least the 12th to the early 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aketons"@en .

aat:300226832 a skos:Concept ;
    skos:definition "Coat armors of cloth or leather having metal plates riveted on the inside, widely used in 14th-century Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coats of plates"@en .

aat:300226833 a skos:Concept ;
    skos:definition "Protective garments of cloth or leather, covering the trunk and thighs, usually stuffed or quilted. Commonly used from the 12th to the 14th century in Europe, worn either over or under metal armor or as an independent defense. They were often made of rich fabric and embroidered with heraldic devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gambesons"@en .

aat:300226834 a skos:Concept ;
    skos:definition "Generally used for any type of quilted soft armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pourpoints"@en .

aat:300226835 a skos:Concept ;
    skos:definition "Flared and pleated skirts of cloth, often velvet or brocade, or of mail or plate metal, worn over or in place of tassets in early 16th-century Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bases"@en .

aat:300226836 a skos:Concept ;
    skos:definition "Sets or ensembles of visual works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual works groupings"@en .

aat:300226858 a skos:Concept ;
    skos:definition "Skeleton models of the celestial sphere, generally having the earth at the center, consisting of a framework of rings depicting the relative position of such astronomical elements as the celestial equator, the ecliptic, the zodiac, and the planets. They were first developed by the ancient Greeks and used especially during the 14th through 16th centuries as an aid to navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armillary spheres"@en .

aat:300226879 a skos:Concept ;
    skos:definition "Rails or parapets above and around a ship's stern, especially on sailing ships; often carved or otherwise decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taffrails"@en .

aat:300226882 a skos:Concept ;
    skos:definition "Vessels having a dish-shape and intended primarily for baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baking dishes"@en .

aat:300226883 a skos:Concept ;
    skos:definition "Pans intended primarily for baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baking pans"@en .

aat:300226956 a skos:Concept ;
    skos:definition "Incendiary liquid mixture known to the Byzantine Greeks, used especially to set fire to ships in naval warfare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek fire"@en .

aat:300226986 a skos:Concept ;
    skos:definition "Documentation of examinations or inspections conducted in order to achieve a comprehensive view, as of a place, a group of related items, or to ascertain condition or value. For detailed lists of items on hand, or of items in a given category, use \"inventories.\" For sets of questions submitted to a number of persons to obtain information, use \"questionnaires.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveys"@en .

aat:300227005 a skos:Concept ;
    skos:definition "A geophysical technique of surveying involving the measurement of the resistance of the earth to an electric current passing between metal electrodes; used in archaeology especially to locate buried remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resistivity surveying"@en .

aat:300227026 a skos:Concept ;
    skos:definition "Grills with metal racks on which food is broiled directly over a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbecue grills"@en .

aat:300227045 a skos:Concept ;
    skos:definition "A term derived from the Nahuatl for a device used to amplify the propulsive force of spears or darts used in both hunting and warfare across the North American continent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ahtlatls"@en .

aat:300227047 a skos:Concept ;
    skos:definition "Small containers often ornamental or mechanical for holding coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banks"@en .

aat:300227048 a skos:Concept ;
    skos:definition "Baking dishes, sometimes having a cover, in which food may be baked and served."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casseroles"@en .

aat:300227074 a skos:Concept ;
    skos:definition "Use to describe firearms which, after the initial firing, automatically eject the empty ammunition case and load the next round."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-loading"@en .

aat:300227076 a skos:Concept ;
    skos:definition "Parts or components of projectile weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projectile weapon components"@en .

aat:300227099 a skos:Concept ;
    skos:definition "Detergent that is polar but does not ionize in aqueous solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonionic detergent"@en .

aat:300227119 a skos:Concept ;
    skos:definition "Small, flat boxlike containers used to carry small cards, typically personal or business cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card cases"@en .

aat:300227154 a skos:Concept ;
    skos:definition "Pullover sweaters with a V-shaped neckline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-neck sweaters"@en .

aat:300227274 a skos:Concept ;
    skos:definition "The phenomenon whereby electron waves scattered by the regularly spaced atoms of a substance produce diffraction patterns characteristic of that substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron diffraction"@en .

aat:300227292 a skos:Concept ;
    skos:definition "Sets containing three or more condiment vessels; generally accompanied by a metal frame or stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castor sets"@en .

aat:300227293 a skos:Concept ;
    skos:definition "Services intended for use in serving coffee generally consisting of a coffeepot, creamer, sugar bowl, and often a matching tray. May also include matching cups and urn, saucers, or dessert plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee services"@en .

aat:300227294 a skos:Concept ;
    skos:definition "Sets of articles used for the eucharist or distribution of communion, including at minimum a chalice or communion cup and a paten. For sets smaller in scale than those used in a church, use the narrower term \"portable communion sets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion sets"@en .

aat:300227296 a skos:Concept ;
    skos:definition "Services intended for use at dinner by a number of diners, generally consisting of numerous dishes, plates, and cups of different sizes, and sometimes other vessels such as tureens, platters, casters, or decorative articles such as vases and épergnes, as well as flatware and glassware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinner services"@en .

aat:300227299 a skos:Concept ;
    skos:definition "Sets of vessels for serving drinking water, usually consisting of a pitcher and matching drinking vessels and sometimes a tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water sets"@en .

aat:300227367 a skos:Concept ;
    skos:definition "Shallow basins with the center of one side cut out in a semicircle so that they could be held close against a person's neck while being shaved by a barber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving basins"@en .

aat:300227406 a skos:Concept ;
    skos:definition "Incendiary substance developed for military purposes in 1943, consisting of gasoline thickened by a mixture of aluminum naphthenate and aluminum palmate to form a gel, used particularly in flamethrowers and incendiary bombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napalm"@en .

aat:300227408 a skos:Concept ;
    skos:definition "Solid bullets of spherical or conical shape, containing no propellant or explosive, fired from small arms. For the spherical projectiles made to be fired from cannons, use \"cannonballs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balls"@en .

aat:300227421 a skos:Concept ;
    skos:definition "Artillery ammunition in which the projectile is permanently attached to a case containing the primer and propellant, so that it is supplied ready for loading as a single unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixed ammunition"@en .

aat:300227424 a skos:Concept ;
    skos:definition "Artillery ammunition in which the case containing the primer and propellant is not permanently attached to the projectile; the two units are assembled into one at the time of loading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semifixed ammunition"@en .

aat:300227426 a skos:Concept ;
    skos:definition "Use to describe firearms that must be loaded by hand for each shot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-shot"@en .

aat:300227431 a skos:Concept ;
    skos:definition "Weapons consisting of a stout handle at the end of which are attached, by means of a chain, two or more iron-clad balls, a short iron-clad bar, or a wooden rod with iron spikes. They date back to at least the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flails"@en .

aat:300227435 a skos:Concept ;
    skos:definition "Caucasian rugs which depict eight large pointed stars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "star Kazaks"@en .

aat:300227452 a skos:Concept ;
    skos:definition "Formal contests in which the affirmative and negative sides of a proposition are advocated by opposing speakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "debates"@en .

aat:300227479 a skos:Concept ;
    skos:definition "Social groups sharing a common tie or interest such as a mode of life, activity, or social context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circles"@en .

aat:300227488 a skos:Concept ;
    skos:definition "Those who make tools for delicate or precision work. For those who make musical instruments, use \"musical instrument makers.\" For those who specifically make, design, or repair stringed instruments of the lute, harp, viol, and violin families, such as guitars, frame harps, violas da gamba, and violins, see \"luthiers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instrument makers"@en .

aat:300227495 a skos:Concept ;
    skos:definition "Photographic positives, usually a gelatin or carbon print, printed on or transferred to opaque, white glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opalotypes"@en .

aat:300227501 a skos:Concept ;
    skos:definition "Photographic prints made by the stabilization process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stabilization prints"@en .

aat:300227509 a skos:Concept ;
    skos:definition "Photographic process for making temporary black-and-white prints that can be processed through one or two solutions that quickly develop and stabilize the nonpermanent image. Used often by newspapers and news agencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stabilization process"@en .

aat:300227510 a skos:Concept ;
    skos:definition "Apparatuses invented by Carlo Ponti of Venice ca. 1870, for viewing large albumen photographs on thin paper, using a large lens to create the optical illusion of depth and perspective and having candles or kerosene lamps as a source of light. The photographs themselves were translucent, often colored and pierced with pinprick holes to create dramatic visual effects with backlighting, such as that of lights in a night scene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megalethoscopes"@en .

aat:300227525 a skos:Concept ;
    skos:definition "Leather made of the skin of a calf, used especially for bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calf"@en .

aat:300227530 a skos:Concept ;
    skos:definition "Small engraved or printed labels, usually found on the upper outside corner of one of the front flyleaves, giving the name and usually the address of the bookbinder; common in the 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binders' tickets"@en .

aat:300227537 a skos:Concept ;
    skos:definition "Attribute of firearms designed to fire several shots in succession without reloading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repeating"@en .

aat:300227567 a skos:Concept ;
    skos:definition "Persian term for covers made of assembled strips of warp faced fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jajims"@en .

aat:300227568 a skos:Concept ;
    skos:definition "Caucasian flat-woven rugs with supplementary weft patterning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shadda"@en .

aat:300227670 a skos:Concept ;
    skos:definition "Shaggy pile-woven rugs used as sleeping mats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yataks"@en .

aat:300227763 a skos:Concept ;
    skos:definition "Condition of fabrication for items made to an individual's specific order, often in referencing items of clothing. For items made for an individual request, but based on only a given set of possible designs, prefer \"made-to-order.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "custom-made"@en .

aat:300227764 a skos:Concept ;
    skos:definition "Textile forming the back of something, or placed at or attached to the back of something to support, strengthen, stiffen, or protect it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backing"@en .

aat:300227765 a skos:Concept ;
    skos:definition "Use to describe items of clothing made in advance for sale to any purchaser."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ready-to-wear"@en .

aat:300227768 a skos:Concept ;
    skos:definition "Use to describe items of clothing made by a tailor or having the appearance of being made by a good tailor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tailor-made"@en .

aat:300227769 a skos:Concept ;
    skos:definition "Use to describe items made, contrived, or assembled at home, or otherwise nonprofessionally, sometimes implying poorly done."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homemade"@en .

aat:300227774 a skos:Concept ;
    skos:definition "Type of embroidery beginning in the 19th century, usually worked in worsted yarns following a colored pattern drawn on a graphed chart; named as such because early major supplies of these patterns, yarns, and canvas came from Berlin. Primarily a Victorian phenomenon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berlin woolwork"@en .

aat:300227775 a skos:Concept ;
    skos:definition "A secondary warp that binds weft floats. In weft-faced compound woven textiles, the binding warp binds the weft. In woven textiles with more than one weft, the binding warp's primary function is to bind specifically the brocading weft or pattern weft, thus making a supplementary binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binding warp"@en .

aat:300227776 a skos:Concept ;
    skos:definition "A lozenge twill with a small weave unit which has an interlacing forming a spot in the center of each lozenge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird's-eye twill"@en .

aat:300227777 a skos:Concept ;
    skos:definition "Textile made for blankets and similar items, woven by the yard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanketing"@en .

aat:300227778 a skos:Concept ;
    skos:definition "A type of weft-loop weave in which uncut pile is used sparsely for patterning, sometimes in contrasting colors. Popular in many countries, especially for bed coverings and similar items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boutonné"@en .

aat:300227779 a skos:Concept ;
    skos:definition "Textile produced by brocading, typically richly figured and incorporating metal thread, often of silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brocade"@en .

aat:300227780 a skos:Concept ;
    skos:definition "A discontinuous supplementary weft which does not travel from selvage to selvage, but rather is limited to the area where it is required by the pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brocading weft"@en .

aat:300227782 a skos:Concept ;
    skos:definition "18th-century form of appliqué in which motifs such as flowers and animals are cut from cotton textiles, especially chintz, and stitched to a plain ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broderie perse"@en .

aat:300227785 a skos:Concept ;
    skos:definition "Any form of twill in which the diagonal lines have been deliberately broken. The binding points are not regularly set over by one end on each successive pick, but breaks occur at regular intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broken twill"@en .

aat:300227787 a skos:Concept ;
    skos:definition "Yarn produced by twisting together two or more strands of plied yarn; the final twist is opposite to that of the plied ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabled yarn"@en .

aat:300227789 a skos:Concept ;
    skos:definition "Transportation vehicles capable of travel equally well in water and on land, or in water and in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphibious vehicles"@en .

aat:300227792 a skos:Concept ;
    skos:definition "Embroidering technique in which designs are stitched on a woven unbleached cotton or linen cloth using heavily plied yarn which is looped on the surface then cut, creating a tufted effect; used especially for bedspreads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlewicking"@en .

aat:300227793 a skos:Concept ;
    skos:definition "Thick, loosely twisted, plied yarn, usually of cotton, used especially for embroidered bedspreads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlewick"@en .

aat:300227796 a skos:Concept ;
    skos:definition "Material woven by the yard to be made up into carpets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpeting"@en .

aat:300227801 a skos:Concept ;
    skos:definition "Tufted yarn made by cross weaving a textile with warp ends in groups, then cutting it into narrow strips along the length between the groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chenille"@en .

aat:300227802 a skos:Concept ;
    skos:definition "Any form of twill in which the direction of the diagonal lines is reversed over groups of picks, or over groups of ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevron twill"@en .

aat:300227803 a skos:Concept ;
    skos:definition "Velvet having a pattern formed by cut and uncut pile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciselé velvet"@en .

aat:300227804 a skos:Concept ;
    skos:definition "One of two or more sets of warp that are equally part of the basic weave structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "complementary warp"@en .

aat:300227805 a skos:Concept ;
    skos:definition "One of two more sets of weft that are equally part of the basic weave structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "complementary weft"@en .

aat:300227806 a skos:Concept ;
    skos:definition "Any form of twill woven using more than one binding system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite twill"@en .

aat:300227807 a skos:Concept ;
    skos:definition "Firm yarn produced by twisting together two or more single strands of yarn. For yarn produced by twisting together two or more plied strands of yarn, use \"cabled yarn.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cord yarn"@en .

aat:300227809 a skos:Concept ;
    skos:definition "Wheeled vehicles, particularly on four wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freewheeled vehicles"@en .

aat:300227811 a skos:Concept ;
    skos:definition "Freewheeled vehicles used for transporting freight or goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cargo vehicles"@en .

aat:300227812 a skos:Concept ;
    skos:definition "Fine, loosely twisted, two-ply, worsted yarn used in embroidering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crewel wool"@en .

aat:300227815 a skos:Concept ;
    skos:definition "Land-based, wheeled, military transport equipment; does not include aircraft, spacecraft, or watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military vehicles"@en .

aat:300227816 a skos:Concept ;
    skos:definition "Land vehicles whose primary purpose is to convey travelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passenger vehicles"@en .

aat:300227817 a skos:Concept ;
    skos:definition "Pile having cut ends instead of loops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut pile"@en .

aat:300227821 a skos:Concept ;
    skos:definition "Land vehicles that are fitted with runners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runnered vehicles"@en .

aat:300227822 a skos:Concept ;
    skos:definition "Velvet in which the loops formed by the pile warp are cut to form tufts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut velvet"@en .

aat:300227826 a skos:Concept ;
    skos:definition "Heavy textile consisting of two separate textiles woven simultaneously, one above the other. The warp is composed of two series of ends, and each interlaces with its own weft, or with a common weft which works with each series in turn. In patterned double weave, the two textiles change position as required by the pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double weave"@en .

aat:300227828 a skos:Concept ;
    skos:definition "Threads in textile weaving that form the warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp threads"@en .

aat:300227830 a skos:Concept ;
    skos:definition "Trimming consisting of long or short lengths of straight or twisted thread, cord, or tassel; often grouped or knotted in various designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fringe"@en .

aat:300227835 a skos:Concept ;
    skos:definition "Used in the 18th and early 19th century to mean a closely woven linen tabby, first manufactured in Holland. In the mid- and late 19th century, also came into use for a heavily glazed starched cotton cloth, commonly used for window shades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holland"@en .

aat:300227841 a skos:Concept ;
    skos:definition "Yarn with no apparent twist; the direction of its fibers correspond to the central bar of the letter I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twistless"@en .

aat:300227843 a skos:Concept ;
    skos:definition "Extra layer of material placed between a textile and its lining for strength, warmth, shaping, or to improve the hang of the finished product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interlining"@en .

aat:300227844 a skos:Concept ;
    skos:definition "Tapestry-woven textile of silk, or of silk and metal thread, woven in a pictorial design, commonly used for Chinese textiles. The term means \"cut silk,\" referring to the visual illusion that is created by distinct, unblended areas of color resembling cut threads. The earliest surviving examples date from the Tang dynasty (618-907); it was popular during China's Southern Song period (1127-1279), and from the Ming period (1368-1644) through the end of the Qing dynasty in 1912. The kesi technique was often used to copy famous paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kesi"@en .

aat:300227845 a skos:Concept ;
    skos:definition "Pile produced not by knotting, but by wrapping supplementary weft strands around the warp and then cutting them, so that they stand out above the ground of the textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knotted pile"@en .

aat:300227846 a skos:Concept ;
    skos:definition "Layer of material used to line the inner side or surface of something to reinforce or protect it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lining"@en .

aat:300227848 a skos:Concept ;
    skos:definition "Textile with linen warp and woolen weft, usually homespun and handwoven, and later also with a cotton warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linsey-woolsey"@en .

aat:300227849 a skos:Concept ;
    skos:definition "Twill in which the direction of the diagonals formed by the binding points is reversed over groups of ends, and also over groups of picks, to produce a woven lozenge pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lozenge twill"@en .

aat:300227851 a skos:Concept ;
    skos:definition "The principal, or only, warp in a textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "main warp"@en .

aat:300227852 a skos:Concept ;
    skos:definition "The principal, or only, weft in a textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "main weft"@en .

aat:300227854 a skos:Concept ;
    skos:definition "A double-woven textile with a quilted appearance, utilizing a wadding weft to increase the relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matelassé"@en .

aat:300227856 a skos:Concept ;
    skos:definition "Land vehicles pulled by horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse-drawn vehicles"@en .

aat:300227858 a skos:Concept ;
    skos:definition "The surface produced by raising the fibers on the face of a woven textile, especially by brushing. For the raised surface produced by supplementary warp or weft projecting from the ground of a woven textile, use \"pile (textile component).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nap"@en .

aat:300227860 a skos:Concept ;
    skos:definition "Any soft material or mass that serves to cushion, protect, fill out, or heighten."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padding"@en .

aat:300227861 a skos:Concept ;
    skos:definition "Large resist painted and dyed cotton panels made in India, often with the flowering tree pattern, used in Europe and America especially as bedcovers and hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palampores"@en .

aat:300227862 a skos:Concept ;
    skos:definition "Lightly armored, highly mobile, fully tracked vehicles primarily for transporting personnel on and off the battlefield; usually fitted with light armament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armored personnel carriers"@en .

aat:300227864 a skos:Concept ;
    skos:definition "The complete set of picks that, by varied interlacements with the warp, suffices to produce the weave unit in the full width of a woven textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pass"@en .

aat:300227865 a skos:Concept ;
    skos:definition "Warp supplementary to the main warp, which creates a pattern or texture in floats above the ground of the textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flushing warp"@en .

aat:300227866 a skos:Concept ;
    skos:definition "Weft supplementary to the main weft, passed from selvage to selvage to enrich the ground or to form a pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern weft"@en .

aat:300227867 a skos:Concept ;
    skos:definition "Individual weft strands carried by a single passage of the shuttle through the shed. For the set of lengthwise yarns, use \"warp threads.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pick"@en .

aat:300227868 a skos:Concept ;
    skos:definition "The raised surface produced by supplementary warp or weft projecting from the ground of a woven textile. For the surface produced by raising the fibers on the face of the textile, use \"nap.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile"@en .

aat:300227871 a skos:Concept ;
    skos:definition "Supplementary warp used to create a pile on a textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile warp"@en .

aat:300227872 a skos:Concept ;
    skos:definition "Woven textile in which a looped or tufted surface extends above the foundation or ground weave. The pile is formed by supplemental thread or yarn running in the direction of the length of the fabric or the width of the fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile weave"@en .

aat:300227873 a skos:Concept ;
    skos:definition "Supplementary weft used to create a pile on a textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile weft"@en .

aat:300227874 a skos:Concept ;
    skos:definition "Folds of definite, even width, made in a material such as textile or paper by doubling it upon itself; usually stitched, sometimes pressed in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleats"@en .

aat:300227875 a skos:Concept ;
    skos:definition "A cut velvet with very long pile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plush"@en .

aat:300227879 a skos:Concept ;
    skos:definition "Yarn deliberately raveled off of a finished textile for the purpose of being reused."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ravelling"@en .

aat:300227881 a skos:Concept ;
    skos:definition "Road vehicles licensed or registered to transport goods or materials, other than passengers, for gain or reward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commercial vehicles"@en .

aat:300227885 a skos:Concept ;
    skos:definition "Appliqué in which two or more layers of cloth are stacked one over the other, each layer being cut away in turn to reveal the one below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverse appliqué"@en .

aat:300227887 a skos:Concept ;
    skos:definition "Vegetable-tanned leather made originally of shaved cowhide, later of calfskin, goatskin, sheepskin or horse hide, tanned with willow and other types of bark, then curried on the flesh side with birch bark extract to give it a pleasant but relatively short-lived odor in imitation of Russia calf. Its uses included for upholstery and for binding blank books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russia leather"@en .

aat:300227889 a skos:Concept ;
    skos:definition "Buses with two levels of seating, one above the other, connected by one or two stairways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-deck buses"@en .

aat:300227890 a skos:Concept ;
    skos:definition "Yarn in which the twist of its component fiber follows the direction of the central bar of the letter S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "S-twist"@en .

aat:300227893 a skos:Concept ;
    skos:definition "The longitudinal edge of a piece of textile closed by weft loops, often distinguished by warp ends differing from those in the body of the textile and sometimes by a change in the binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selvage"@en .

aat:300227894 a skos:Concept ;
    skos:definition "Textile used for bed sheets, pillowcases, and similar items, woven by the yard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheeting"@en .

aat:300227895 a skos:Concept ;
    skos:definition "Velvet in which pile covers the entire surface of the ground of the textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid velvet"@en .

aat:300227905 a skos:Concept ;
    skos:definition "Commercial name for central Asian floral embroidered panels, usually large in size, used as hangings and bedcovers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suzani"@en .

aat:300227906 a skos:Concept ;
    skos:definition "Textile in which warp/weft pathways are over/under every other thread. Tabby weave textiles are woven by a method based on a unit of two ends and two picks, in which each end passes over one and under one pick; the binding points are set over one end on successive picks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabby"@en .

aat:300227909 a skos:Concept ;
    skos:definition "Warp pile weave with uncut loops on either one or both faces. Often in cotton or linen, and used for its absorbency in towels, bathrobes, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terry"@en .

aat:300227910 a skos:Concept ;
    skos:definition "Strong closely woven textile, traditionally woven in a striped cotton or linen twill, used for mattress and pillow covers, upholstery foundations, and, in lighter weights, for clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ticking"@en .

aat:300227911 a skos:Concept ;
    skos:definition "Road vehicles propelled by electric motors, drawing their current either from storage batteries or from overhead cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric vehicles"@en .

aat:300227912 a skos:Concept ;
    skos:definition "Textile made for towels and similar items, woven by the yard; usually made of absorbent fiber, such as cotton or linen, and woven in narrow widths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toweling"@en .

aat:300227913 a skos:Concept ;
    skos:definition "In some textiles woven on simple equipment, the transverse edge closed by warp loops. It resembles a true selvage and may occur at one or both ends of the textile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transverse selvage"@en .

aat:300227914 a skos:Concept ;
    skos:definition "Knotted pile textile woven with symmetrical knots in colored worsted yarns on hemp or linen warp, made in England from the late 16th to mid-18th century. Used especially for table carpets, floor carpets, upholstery, cushions, and, occasionally, hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turkeywork"@en .

aat:300227915 a skos:Concept ;
    skos:definition "Refers to a woven textile characterized by parallel diagonal ridges or ribs, produced by passing the weft threads over one and under two or more threads of the warp, instead of over and under in regular succession, as in plain weaving. Regular twill features a diagonal line that is repeated regularly, usually running from the left to right at a 45-degree angle and upward. The weave may be varied in several ways, including changing the angle or direction of the twill line, as exemplified in herringbone twill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twill"@en .

aat:300227916 a skos:Concept ;
    skos:definition "Self-patterned twill with a rectilinear pattern formed by the contrast of warp and weft faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twill diaper"@en .

aat:300227918 a skos:Concept ;
    skos:definition "Velvet in which the loops formed by the pile warp are left uncut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncut velvet"@en .

aat:300227920 a skos:Concept ;
    skos:definition "Motor vehicles in which the rear end is supported on caterpillar tracks and the front is supported on wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-track vehicles"@en .

aat:300227922 a skos:Concept ;
    skos:definition "Automobiles that are fully enclosed, as opposed to automobiles such as convertibles, that have open bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed automobiles"@en .

aat:300227923 a skos:Concept ;
    skos:definition "Automobiles that have open bodies, such as convertibles, as opposed to automobiles that are fully enclosed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open automobiles"@en .

aat:300227925 a skos:Concept ;
    skos:definition "Weft pile weave, often of cotton, with solid cut pile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velveteen"@en .

aat:300227926 a skos:Concept ;
    skos:definition "Regular production automobiles individually modified in their bodywork to give the appearance of increased power and in their engines for fast acceleration and increased speed for road use or racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot rods"@en .

aat:300227927 a skos:Concept ;
    skos:definition "Velvet having certain areas of the ground weave left free of pile. In these areas the pile warp is not lifted over the velvet rods but is woven in with the ground weave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voided velvet"@en .

aat:300227928 a skos:Concept ;
    skos:definition "A thick warp inserted into a textile to produce relief and give added weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wadding warp"@en .

aat:300227929 a skos:Concept ;
    skos:definition "A thick weft inserted into a textile to produce relief and give added weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wadding weft"@en .

aat:300227930 a skos:Concept ;
    skos:definition "In weaving, the threads that are extended lengthwise in the loom, usually twisted harder than the \"weft,\" with which these threads are crossed to form the web or piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp"@en .

aat:300227932 a skos:Concept ;
    skos:definition "Pile weave in which the pile is produced by a supplementary pile warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp pile weave"@en .

aat:300227933 a skos:Concept ;
    skos:definition "In current usage, refers to light two-wheeled motor vehicles with a small engine. designed to provide economical and relatively safe transport with minimal licensing requirements. Their features and capabilities are defined slightly differently in different licensing districts. For example, in English law, a moped must have weight not exceeding 550 pounds (250 kg), with a maximum speed not exceeding 30 mph, and an engine capacity of not more than 50 cc. The term originally referred to motorized pedaled bicycles; for that concept in current usage, prefer \"motorized bicycle.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mopeds"@en .

aat:300227934 a skos:Concept ;
    skos:definition "The aggregate of transverse strands of a textile, woven through the warp. Specifically for individual strands of weft, prefer \"picks (weft).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weft"@en .

aat:300227935 a skos:Concept ;
    skos:definition "Small lightweight motorcycles that are very similar to a bicycle, but propelled by an attached motor. The specific features and capacity may be defined differently in various legislative districts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motorized bicycles"@en .

aat:300227937 a skos:Concept ;
    skos:definition "Woven textile material with main or supplementary weft pulled up to form loops on the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weft loop weave"@en .

aat:300227939 a skos:Concept ;
    skos:definition "Pile weave in which the pile is produced by a supplementary pile weft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weft pile weave"@en .

aat:300227940 a skos:Concept ;
    skos:definition "Needlework done in white on a white ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whitework"@en .

aat:300227943 a skos:Concept ;
    skos:definition "Smooth compact yarn spun with average to hard twist from long wool fibers that have been carded and combed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worsted"@en .

aat:300227944 a skos:Concept ;
    skos:definition "Cloth woven in lengths, to be sold by the yard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yardage"@en .

aat:300227945 a skos:Concept ;
    skos:definition "Light trucks with fully enclosed bodies made from sheet metal panels and used generally for localized deliveries of small goods; the driver's cab is usually separate from the cargo space. For enclosed boxlike vehicles in which the drivers, passengers, and cargo share the same space and also intended for carrying light cargo, use \"vans.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel trucks"@en .

aat:300227948 a skos:Concept ;
    skos:definition "Automobiles used by police officers, usually equipped with radiotelephones for communication with headquarters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police cars"@en .

aat:300227949 a skos:Concept ;
    skos:definition "Yarn in which the twist of its component fibers follows the direction of the central bar of the letter Z."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Z-twist"@en .

aat:300227955 a skos:Concept ;
    skos:definition "Pile that is both cut and uncut, forming a pattern; produced by raising the pile warp threads over two wires, a cut and uncut pile wire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut-and-uncut pile"@en .

aat:300227965 a skos:Concept ;
    skos:definition "Lightly armed and armored reconaissance vehicles, either wheeled or half-track, without turrets, and adapted for high-speed operation on either hard roads or for cross-country missions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scout cars"@en .

aat:300227972 a skos:Concept ;
    skos:definition "Fully enclosed automobiles with two or four doors and seating four or more passengers in two ranges, one behind the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sedans"@en .

aat:300227981 a skos:Concept ;
    skos:definition "Land vehicles equipped with continuous roller belts over cogged wheels for moving across rough terrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracklaying vehicles"@en .

aat:300227982 a skos:Concept ;
    skos:definition "Small, light, open automobiles powered by motorcycle engines and usually with four wheels, although some had three wheels; for three-wheeled closed automobiles, usually with larger engines, use \"three-wheelers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclecars"@en .

aat:300227983 a skos:Concept ;
    skos:definition "Three-wheeled automobiles with closed bodies; for smaller, open automobiles with three or four wheels and powered by smaller engines, use \"cyclecars\"; for three-wheeled open vehicles of simple, light, open framework construction usually powered by the rider, but sometimes motorized, use \"tricycles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-wheelers"@en .

aat:300227990 a skos:Concept ;
    skos:definition "Most common type of European hunting rifle from the late 17th to the mid-19th century, typically with a short octagonal barrel of large bore, a heavy stock, and brass fittings. Originally fitted with flintlocks, after 1820 they commonly were fitted with percussion locks. They were popular in the American colonies until superseded by American long rifles after the Revolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jaeger rifles"@en .

aat:300227992 a skos:Concept ;
    skos:definition "Road vehicles equipped with mechanical apparatus for hoisting and pulling, used to tow other vehicles that have become disabled, stalled, or wrecked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wreckers"@en .

aat:300228029 a skos:Concept ;
    skos:definition "Self-propelled, heavily armored combat vehicles having a fully enclosed, revolving gun turret containing the vehicle's major weapon and having one or more machine guns; mounted on caterpillar treads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanks"@en .

aat:300228061 a skos:Concept ;
    skos:definition "Locking or cutoff devices which, when applied, prevent accidental discharge of firearms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety catches"@en .

aat:300228062 a skos:Concept ;
    skos:definition "The process of altering, injuring, or consuming something by fire or heat. For events where something is totally or partially consumed by fire, whether intentionally or by accident, use \"fires.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning"@en .

aat:300228069 a skos:Concept ;
    skos:definition "Main portions of land vehicles on or in which the passengers or loads are contained; excludes those components necessary to make the vehicles move. For similar main portions of watercraft, use \"hulls,\" and of aircraft, use \"fuselages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodies"@en .

aat:300228075 a skos:Concept ;
    skos:definition "The S- or Z-shaped moving arms in matchlocks which hold the slow-burning match and, when activated, lower it down to ignite the priming powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentines"@en .

aat:300228083 a skos:Concept ;
    skos:definition "A decay of wood caused by fungus that decomposes cellulose and the associated pentosans, leaving the lignin more or less unaltered; the resultant mass is powdery and occurs in various shades of brown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brown rot"@en .

aat:300228086 a skos:Concept ;
    skos:definition "A decay of wood caused by fungus that attacks both cellulose and lignin; the resultant mass is spongy or stringy, usually white, but sometimes yellow, tan, or light brown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white rot"@en .

aat:300228087 a skos:Concept ;
    skos:definition "Automobiles designed and built especially for straight line sprinting or drag racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragsters"@en .

aat:300228088 a skos:Concept ;
    skos:definition "Structural lower parts of motor vehicles that include the drive trains, exhaust systems, and steering, those components that make the vehicles move and that support the vehicle bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chassis"@en .

aat:300228089 a skos:Concept ;
    skos:definition "Automobiles with tops that may be removed or folded open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convertibles"@en .

aat:300228095 a skos:Concept ;
    skos:definition "Cargo vehicles designed to be towed by truck tractors or other motor vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truck trailers"@en .

aat:300228124 a skos:Concept ;
    skos:definition "Small, multipurpose rugged military vehicles with four-wheel drive and one-quarter ton capacity, introduced in 1941; after the Second World War produced for civilian use as a trademarked marque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jeeps"@en .

aat:300228142 a skos:Concept ;
    skos:definition "General term for articles or physical resources used to equip vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vehicle equipment"@en .

aat:300228276 a skos:Concept ;
    skos:definition "Flat metal plates on which the locks of firearms are carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lock plates"@en .

aat:300228304 a skos:Concept ;
    skos:definition "Laminated cuirasses first appearing in Italy in the first quarter of the 16th century, built up of horizontal overlapping lames joined by leather straps and sliding rivets on the inner side. They went out of fashion in western Europe by the end of the 16th century, but continued to be popular throughout the 17th century in eastern Europe, particularly in Hungary and Poland where they were used by heavy cavalry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animes"@en .

aat:300228310 a skos:Concept ;
    skos:definition "Pieces of mail to protect the genitals, worn attached to the center of the lower edge of a shirt of mail or appended to the fork of a plate armor skirt. They took various forms, including short skirts or breeches, and could incorporate a codpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brekes of mail"@en .

aat:300228328 a skos:Concept ;
    skos:definition "Metal plates on some sallets and armets, curving down over the skull to the line of the eyebrows and serving as extra protection for the forehead. Early forms first appearing before the middle of the 15th century consisted of a single heavy contoured plate, cusped and pointed, riveted to the skull; in the late 15th century a detachable form made of two plates was introduced and remained in use on German jousting helmets until the mid-16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brow reinforces"@en .

aat:300228329 a skos:Concept ;
    skos:definition "Trimming of cloth or leather worn on both civilian garments and armor from the mid-16th to the early 17th century. On armor it was worn at the edges of the metal plates where separate pieces overrode each other, serving to reduce noise and friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickadil"@en .

aat:300228335 a skos:Concept ;
    skos:definition "A process occurring in such materials as paper, paperboard, vellum, or cloth in which the material becomes wrinkled, puckered, warped, or rippled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockling"@en .

aat:300228339 a skos:Concept ;
    skos:definition "Simple, close-fitting metal helmets of the 17th century covering the crown of the head, typically worn under a felt hat, by civilians as well as soldiers. Generally made in one piece, a variation made of riveted strips of metal is also known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel skulls"@en .

aat:300228340 a skos:Concept ;
    skos:definition "Swellings on a surface, often bubble-shaped, frequently caused by nonadherence or by separation of an applied substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blisters"@en .

aat:300228341 a skos:Concept ;
    skos:definition "Small ridges or furrows in a formerly smooth surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrinkles"@en .

aat:300228342 a skos:Concept ;
    skos:definition "A pattern of crackle in paintings occurring after all layers have dried, often penetrating the ground as well, resulting from subtle movements in the support, such as from changes of temperature or humidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "age cracks"@en .

aat:300228345 a skos:Concept ;
    skos:definition "A network of fine fracture lines in a coating layer, such as a ground, paint layer, varnish, or glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crackle"@en .

aat:300228347 a skos:Concept ;
    skos:definition "A pattern of crackle in paintings produced by shrinkage in a rapidly drying upper layer over a slow drying lower layer, characterized by a complex branching in which apertures are abnormally wide and disfiguring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traction crackle"@en .

aat:300228348 a skos:Concept ;
    skos:definition "The actual quantity of water vapor present in a given volume of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absolute humidity"@en .

aat:300228350 a skos:Concept ;
    skos:definition "The process or condition of growing in bulk or size, as for example by inflation or accumulation of fluids. Refers also for the distended, protuberant, or thickened portion of something, such as the entasis of a column, the thickened portion of a gunstock, or the extra thickness on the back of the text block of a book caused by the sewing thread or extreme guarding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swelling"@en .

aat:300228352 a skos:Concept ;
    skos:definition "A decay of wood caused by bacteria or fungi characterized by a soft, even watery decay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft rot"@en .

aat:300228353 a skos:Concept ;
    skos:definition "Fracture lines in coating layers caused by localized, specific pressures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical cracks"@en .

aat:300228360 a skos:Concept ;
    skos:definition "Wide, sharply pressed pleats, arranged in a row, evenly spaced and all turned in the same direction. For narrow pleats of a similar nature, use \"knife pleats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accordion pleats"@en .

aat:300228368 a skos:Concept ;
    skos:definition "Wide double pleats, with the material folded under at each side. For wide double pleats having the flat fold turned in rather than out, use \"inverted pleats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box pleats"@en .

aat:300228369 a skos:Concept ;
    skos:definition "A stress system within a solid that is not dependent on external forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internal stress"@en .

aat:300228376 a skos:Concept ;
    skos:definition "Oxidation caused by the atmosphere or self-catalyzed and spontaneous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autoxidation"@en .

aat:300228379 a skos:Concept ;
    skos:definition "Imperial Roman cuirasses constructed of about two dozen curved iron lames held together by a complicated system of leather straps and buckles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loricae segmentatae"@en .

aat:300228380 a skos:Concept ;
    skos:definition "Loricae made of overlapping bronze or iron scales attached to a foundation of hide or strong cloth, typically arranged in horizontal rows and imbricated like roof tiles to avoid gaps. Their use was adopted by the Romans by at least the 4th century BCE and continued into the 4th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loricae squamatae"@en .

aat:300228409 a skos:Concept ;
    skos:definition "Guideway vehicles that do not operate on rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonrail guideway vehicles"@en .

aat:300228410 a skos:Concept ;
    skos:definition "Guideway vehicles that specifically operate on rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rail guideway vehicles"@en .

aat:300228411 a skos:Concept ;
    skos:definition "High-speed ground transportation vehicles traveling along guideways using superconducting devices of various configurations, generally with the aid of magnetic forces and linear induction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic levitation vehicles"@en .

aat:300228413 a skos:Concept ;
    skos:definition "Locomotives used for shifting or switching railroad cars from one place to another in yards or terminals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "switching locomotives"@en .

aat:300228416 a skos:Concept ;
    skos:definition "Railroad vehicles carrying passengers or hauled on passenger trains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passenger cars"@en .

aat:300228418 a skos:Concept ;
    skos:definition "Locomotives in which power is developed by oil-burning internal combustion engines driving electric generators that supply power to electric traction motors for propulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diesel-electric locomotives"@en .

aat:300228419 a skos:Concept ;
    skos:definition "Locomotives in which power developed by oil-burning internal combustion engines is delivered through hydraulic transmissions to driving rods and axles by means of shafts and gears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diesel-hydraulic locomotives"@en .

aat:300228420 a skos:Concept ;
    skos:definition "Locomotives powered by gas turbines to drive electric generators that supply current to electric traction motors on the axles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas-turbine locomotives"@en .

aat:300228422 a skos:Concept ;
    skos:definition "Locomotives powered by onboard internally fired boilers through which hot exhaust gases flow from a firebox in the rear to a smokebox and stack at the front and in which high-pressure steam expands within cylinders to drive two pistons; often having coal or water tenders coupled behind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam locomotives"@en .

aat:300228423 a skos:Concept ;
    skos:definition "Devices for throwing a spear or dart, consisting of a stick or board with a groove or hollow on their upper surface and a hook, thong, or projection at the rear end to hold the projectile in place until its release."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing-sticks"@en .

aat:300228430 a skos:Concept ;
    skos:definition "Small cylindrical pleats arranged in a row, thus resembling a military cartridge belt, used decoratively to give a military effect to costume and hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartridge pleats"@en .

aat:300228436 a skos:Concept ;
    skos:definition "Wide double pleats, with the material folded over at each side. For wide double pleats having the flat fold turned out rather than in, use \"box pleats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inverted pleats"@en .

aat:300228444 a skos:Concept ;
    skos:definition "Narrow, sharply pressed pleats arranged in a row, evenly spaced and all turned in the same direction. For wide pleats of a similar nature, use \"accordion pleats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife pleats"@en .

aat:300228460 a skos:Concept ;
    skos:definition "Narrow triple pleats having a center stitch drawn tight to make a pinched waist, pressed flat and produced at regular intervals in a row. For triple pleats which are not pressed flat, use \"French pleats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinch pleats"@en .

aat:300228472 a skos:Concept ;
    skos:definition "Generally, the lines of junction formed by the abutment or attachment of two edges, especially the edges of two portions of a single object, such as a garment or metal cylinder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seams"@en .

aat:300228475 a skos:Concept ;
    skos:definition "Textile weaving technique in which a pattern is formed or the ground enriched by the use of more than one series of warp ends; the patterning is done using either a supplementary or complementary warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp patterning"@en .

aat:300228482 a skos:Concept ;
    skos:definition "Banking machines capable of automatic processing of various transactions between depository institutions and customers; may be on or off the premises of the depository institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automated teller machines"@en .

aat:300228486 a skos:Concept ;
    skos:definition "Textile weaving technique in which a pattern is formed or the ground enriched by the use of more than one series of weft strands; the patterning is done using either a supplementary or complementary weft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weft patterning"@en .

aat:300228487 a skos:Concept ;
    skos:definition "Freight cars whose bodies can be tipped for discharging loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dump cars"@en .

aat:300228506 a skos:Concept ;
    skos:definition "Locomotives whose motive power source is electricity generated on board or obtained via overhead wires or a third rail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric locomotives"@en .

aat:300228510 a skos:Concept ;
    skos:definition "Tapestry weaving technique in which the weft threads of two adjacent areas are turned alternately around a common end in groups of two or more."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dovetailed tapestry"@en .

aat:300228512 a skos:Concept ;
    skos:definition "Tenement houses characteristic of Bombay and other industrial Indian cities; originally developed in the late 19th century to house migrant industrial workers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chawls"@en .

aat:300228517 a skos:Concept ;
    skos:definition "Specially constructed railroad passenger train cars designed for carrying express shipments; often with facilities for handling baggage or mail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "express cars"@en .

aat:300228521 a skos:Concept ;
    skos:definition "Open freight cars, commonly with low sides, for transporting bulk goods, as coal or steel, not requiring weather protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gondola cars"@en .

aat:300228522 a skos:Concept ;
    skos:definition "Tapestry weaving technique in which different color weft threads are turned back around adjacent warp ends; slits occur when several rows of adjacent wefts are turned back around the same warp ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slit tapestry"@en .

aat:300228524 a skos:Concept ;
    skos:definition "Freight cars, with open or closed tops, containing hoppers for transporting bulk cargo, as coal or grain, that can be quickly discharged through their bottoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hopper cars"@en .

aat:300228526 a skos:Concept ;
    skos:definition "Tapestry weaving technique in which the weft threads of two adjacent areas are linked together either around a common end, or more normally between adjacent ends in either a single or double lock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interlocked tapestry"@en .

aat:300228531 a skos:Concept ;
    skos:definition "Tapestry weaving technique in which different color weft threads are turned alternately around a common end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothed tapestry"@en .

aat:300228538 a skos:Concept ;
    skos:definition "Textile process involving twisting two or more active strands of the same set together as they interlace with another set of strands laid in parallel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twining"@en .

aat:300228544 a skos:Concept ;
    skos:definition "Textile weaving technique in which two or more ends of the warp twist around each other as they interlace with the weft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warp twining"@en .

aat:300228556 a skos:Concept ;
    skos:definition "Double folding a definite, even width of fabric and fixing it in place by sewing or pressing or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleating"@en .

aat:300228560 a skos:Concept ;
    skos:definition "Progressive encircling or wrapping of warp ends by the weft. If the weft, in addition to encircling one or more ends, passes through a loop of its own part, forming a knot, prefer \"knotting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weft wrapping"@en .

aat:300228561 a skos:Concept ;
    skos:definition "Rail guideway vehicles that are part of a transit system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transit railway vehicles"@en .

aat:300228566 a skos:Concept ;
    skos:definition "Transit railway vehicles used in an urban transit rail system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light rail transit vehicles"@en .

aat:300228568 a skos:Concept ;
    skos:definition "Vehicles used in an rapid transit railway system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rapid rail transit vehicles"@en .

aat:300228572 a skos:Concept ;
    skos:definition "The simplest form of weft wrapping technique in which weft elements repeatedly cross first over or under two or more warp ends, then back under or over half the number one or more, thus progressively encircling all warp ends one or more at a time. The technique is one of the oldest known, identified among charred 7th-century-BCE fragments excavated at Gordion, near Ankara in Anatolia. Widely associated with the flat woven rugs known as \"soumaks,\" although the term has come to be associated with this basic weft wrapping technique wherever found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soumak"@en .

aat:300228594 a skos:Concept ;
    skos:definition "Multilevel freight cars for carrying new automobiles and trucks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rack cars"@en .

aat:300228654 a skos:Concept ;
    skos:definition "Light, pointed projectiles resembling arrows or short javelins, often with flights on the butt of the shaft, hand-thrown or projected through blowguns. Use also for the small projectiles of similar form used in the game of darts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darts"@en .

aat:300228676 a skos:Concept ;
    skos:definition "Gradual loss of quality; can be without structural change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "degradation"@en .

aat:300228711 a skos:Concept ;
    skos:definition "The state or condition of having relatively high moisture content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wetness"@en .

aat:300228716 a skos:Concept ;
    skos:definition "Throwing axes with a short handle and a long arched blade widening toward the cutting edge and ending in a prominent point at the top back corner and often at the bottom one as well. They had become the characteristic national weapon of the Franks by the 6th century and were used by other European peoples at least into the 9th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "franciscas"@en .

aat:300228717 a skos:Concept ;
    skos:definition "Use to describe things excessively saturated with water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterlogged"@en .

aat:300228734 a skos:Concept ;
    skos:definition "Condition of a material such as metal, paper, or fiber leading to failure due to repeated cyclic loading, such as folding, at a stress well below the material's normal tensile strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fatigue"@en .

aat:300228751 a skos:Concept ;
    skos:definition "Developing a network of fine cracks in a coating layer, such as a ground, paint layer, varnish, or glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crackling"@en .

aat:300228797 a skos:Concept ;
    skos:definition "A condition of paper, paperboard, vellum, or cloth in which the material is wrinkled, puckered, warped, or rippled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockle"@en .

aat:300228802 a skos:Concept ;
    skos:definition "Ridges or grooves produced in flexible materials by, for example, folding or pressure against a hard edge. For the parts of something that fold onto themselves, use \"folds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creases"@en .

aat:300228803 a skos:Concept ;
    skos:definition "The process of creating a crease or creases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creasing"@en .

aat:300228873 a skos:Concept ;
    skos:definition "Railroad freight cars designed to carry livestock, generally equipped with slatted sides and doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock cars"@en .

aat:300228878 a skos:Concept ;
    skos:definition "French high-speed trains running on separate tracks and capable of speeds over 160 mph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "TGVs"@en .

aat:300228897 a skos:Concept ;
    skos:definition "Electric streetcars propelled by current through trolley systems connected to overhead wires or wires located between the rails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trolley cars"@en .

aat:300229002 a skos:Concept ;
    skos:definition "Environments affected by conditions characteristic of cities, including conditions of atmosphere, heavy use, and vandalism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban environments"@en .

aat:300229010 a skos:Concept ;
    skos:definition "Emissions, such as alpha and beta particles, or electromagnetic radiation, such as gamma rays, originating in the nuclei of atoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear radiation"@en .

aat:300229138 a skos:Concept ;
    skos:definition "Refers to the successors to streetcars, usually larger and faster electric rail transit vehicles capable of boarding and discharging passengers at either track or platform level; often composed of two cars permanently articulated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light rail vehicles"@en .

aat:300229156 a skos:Concept ;
    skos:definition "Passenger train cars for daytime travel having more comfortable seats and more amenities, such as smoking compartments, buffet bars, or tables, than coaches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lounge cars"@en .

aat:300229352 a skos:Concept ;
    skos:definition "Sites located under water, including both those that have been flooded and those that were originally underwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater sites"@en .

aat:300229355 a skos:Concept ;
    skos:definition "Settlement areas characterized by country life or agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural areas"@en .

aat:300229359 a skos:Concept ;
    skos:definition "Sites located under bodies of salt water, particularly in oceans or seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine sites"@en .

aat:300229366 a skos:Concept ;
    skos:definition "Branch of chemistry that deals with the chemical effects of radiation, chiefly visible and ultraviolet light, and with the direct production of radiation by chemical changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photochemistry"@en .

aat:300229369 a skos:Concept ;
    skos:definition "Collocates descriptors for concepts related to the development and modification of engines, machines, structures, or other complicated systems, typically for public or commercial use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineering concepts"@en .

aat:300229370 a skos:Concept ;
    skos:definition "Collocates descriptors for concepts related to the structure, properties, and processing of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "materials sciences concepts"@en .

aat:300229371 a skos:Concept ;
    skos:definition "Collocates descriptors for concepts related to the nature and properties of non-living matter and energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physics concepts"@en .

aat:300229373 a skos:Concept ;
    skos:definition "Collocates descriptors for concepts related to the nature and phenomena of electrical action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electricity-related concepts"@en .

aat:300229390 a skos:Concept ;
    skos:definition "Collocates descriptors for concepts related to producing or dissolving a state of safety."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety-related concepts"@en .

aat:300229399 a skos:Concept ;
    skos:definition "Conservation aimed at preventing future deterioration of materials or artifacts, including providing suitable environmental conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preventive conservation"@en .

aat:300229401 a skos:Concept ;
    skos:definition "The science concerned with the use of radiation, such as X-rays and radioactive materials in the diagnosis and treatment of disease. For the application of techniques producing radiographic images, use \"radiography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiology"@en .

aat:300229407 a skos:Concept ;
    skos:definition "Collocates descriptors for processes of physical and/or chemical change in a material or object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physicochemical processes"@en .

aat:300229410 a skos:Concept ;
    skos:definition "Collocates descriptors for processes that alter the condition of an object or structure; some descriptors collocated here are both such a process and the resultant effect on the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condition changing"@en .

aat:300229419 a skos:Concept ;
    skos:definition "Describes concepts related to resources located in or produced by the natural environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resources concepts"@en .

aat:300229421 a skos:Concept ;
    skos:definition "Describes processes that transform the color of an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color changes"@en .

aat:300229431 a skos:Concept ;
    skos:definition "Describes processes that change the volume or length of an object resulting from temperature, moisture, or other environmental condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "size-related changes"@en .

aat:300229438 a skos:Concept ;
    skos:definition "Describes processes that transform the surface or structure of an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface or structural changes"@en .

aat:300229481 a skos:Concept ;
    skos:definition "Hearth rugs which have conical formations at both ends of the central field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odjakliks"@en .

aat:300229483 a skos:Concept ;
    skos:definition "The processing of hides and skins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hide and skin processing"@en .

aat:300229488 a skos:Concept ;
    skos:definition "Collocates descriptors for methods of physical and/or chemical change in a material or object resulting from a shift in temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperature-related physicochemical processes"@en .

aat:300229534 a skos:Concept ;
    skos:definition "Describes equipment used for critical examination or evaluation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testing equipment"@en .

aat:300229535 a skos:Concept ;
    skos:definition "Measures taken to create desirable conditions and limit specific undesirable factors within a given, often a closed, environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental control"@en .

aat:300229600 a skos:Concept ;
    skos:definition "Shoelike devices or for platforms that attach to shoes that are fitted on the underside with metal blades, wheels, or rollers, in various configurations, for gliding across ice or other mostly smooth surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skates"@en .

aat:300229602 a skos:Concept ;
    skos:definition "Shoelike devices or platforms that attach to shoes, are fitted with a metal blade or blades, and are used for gliding across ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice skates"@en .

aat:300229605 a skos:Concept ;
    skos:definition "The pivoted steel plates from which sparks are struck by the flint in a snaphance. For the hand-held tools used to strike a piece of flint to produce sparks, use \"firesteels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steels"@en .

aat:300229608 a skos:Concept ;
    skos:definition "Slender poles or sticks, usually with a point at one end and a handle or loop for the hand at the other end and a disk near the lower end to prevent their sticking in the snow; used when skiing on snow to gain momentum, maintain balance, or execute certain jumps or turns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski poles"@en .

aat:300229617 a skos:Concept ;
    skos:definition "Woven Persian salt bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "namakdan"@en .

aat:300229631 a skos:Concept ;
    skos:definition "Wheel-less drags consisting of two or more poles framed into an A-shape, bridged by thongs, twigs, or plants, and hauled by a single person or animal; used by North American Native Americans for carrying goods or the sick or elderly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travois"@en .

aat:300229670 a skos:Concept ;
    skos:definition "Low, light, semi-open, four-wheeled carriages with an open perch in front for the driver and a seat for two passengers covered with a folding or half hood; developed in the second half of the 19th century and used mainly as park carriages. By extension, may also be used for semi-open touring automobiles with a folding top covering only the rear seat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "victorias"@en .

aat:300229702 a skos:Concept ;
    skos:definition "Describes a pair of rulers connected by two pivoting cross pieces of equal length set so that the rulers always remain parallel to each other; used as navigational tools for transferring parallel lines. For drafting tools used to draw parallel lines and affixed to and guided along drafting boards, use \"parallel rules.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel rulers"@en .

aat:300229715 a skos:Concept ;
    skos:definition "Architectural elements of sports facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports facilities fixtures"@en .

aat:300229940 a skos:Concept ;
    skos:definition "Decorative parts or areas that are attached or applied to the surface of an object after the object has been formed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "applied decoration"@en .

aat:300229946 a skos:Concept ;
    skos:definition "Four-wheeled pleasure carriages drawn by one or two horses, characterized by two longitudinal rear seats set facing each other behind the driving seat and entered through a door at the back, similar to omnibuses; designed in England in the mid-19th century and popular there and in North America later in the century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wagonettes"@en .

aat:300229949 a skos:Concept ;
    skos:definition "Applied decorative works made of cast paste or gesso applied to wooden moldings. Use pastiglia for works designed using the application of a mould. For works designed using free-hand brush application, use \"aggetti.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastiglia"@en .

aat:300229951 a skos:Concept ;
    skos:definition "Motion-picture technique using single-frame exposures to give the illusion of movement to inanimate articulated figures or to animated sequences or to give the illusion of sudden appearance or disappearance of objects or performers from a scene. It is an essential technique in model animation, cutout animation, pixillation, and special effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stop-motion photography"@en .

aat:300230031 a skos:Concept ;
    skos:definition "Damage caused by insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insect damage"@en .

aat:300230053 a skos:Concept ;
    skos:definition "Chaises of the lightest construction capable of rapid speed; rarely with tops, frequently without dashboards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiskeys"@en .

aat:300230057 a skos:Concept ;
    skos:definition "Material comprising stems, which are the ascending parts of a plant, supporting the leaf, flower or fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stem"@en .

aat:300230058 a skos:Concept ;
    skos:definition "Gilding on a surface coated with oil paint and size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil gilding"@en .

aat:300230069 a skos:Concept ;
    skos:definition "Applying fine-grain, sieved sand to create a textured surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanding"@en .

aat:300230122 a skos:Concept ;
    skos:definition "Long, slender boardlike devices attached to specially designed boots and used for gliding over snow; known for over 5000 years and originally of animal bone secured directly to footwear, now made of various hard, durable materials and with a taper and upturned forward tip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow skis"@en .

aat:300230251 a skos:Concept ;
    skos:definition "Soft, unctuous clays of various colors, used as pigments and in the ground for gold leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bole"@en .

aat:300230256 a skos:Concept ;
    skos:definition "Small, tight spirals on Corinthian capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helices"@en .

aat:300230262 a skos:Concept ;
    skos:definition "Gilding when the surface is not burnished or polished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mat gilding"@en .

aat:300230271 a skos:Concept ;
    skos:definition "Making a long, narrow cut or indentation in a surface, as the cut in a board to receive the tongue of another board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grooving"@en .

aat:300230275 a skos:Concept ;
    skos:definition "Notching or forming sawlike teeth on the edge of a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serrating"@en .

aat:300230277 a skos:Concept ;
    skos:definition "Decorating a surface with rough and irregular indentations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pebbling"@en .

aat:300230284 a skos:Concept ;
    skos:definition "Shieldlike motifs, often elaborated with strapwork, scrolls, and mantling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shields"@en .

aat:300230287 a skos:Concept ;
    skos:definition "Medieval European weapons consisting of a long staff of wood, from about 6 to 9 feet in length and round in section, often tipped with iron at both ends; they were wielded with both hands, one hand holding the middle and the other grasping the staff at one quarter of the whole length from the end. They were especially popular as civilian weapons in England. For weapons used for ceremonial purposes, use \"ceremonial staffs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarterstaffs"@en .

aat:300230292 a skos:Concept ;
    skos:definition "Plates for holding an individual serving of bread, similar to but smaller than dessert plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread-and-butter plates"@en .

aat:300230316 a skos:Concept ;
    skos:definition "Short, barbed spears used in bullfighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rejons"@en .

aat:300230425 a skos:Concept ;
    skos:definition "Physical formats, objects, digital information, or other non-material human constructs by which specific information may be recorded or conveyed. For example, books, leaflets, or audiotapes; or in computing, the primary components of an information artifact are information systems and procedures related to the artifact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information artifacts"@en .

aat:300230426 a skos:Concept ;
    skos:definition "Small pieces of hard material such as hardwood, horn, metal, or plastic, found at the rear tip of arrow shafts, the tips of bows, and on the center shaft of crossbows, that carry a notch for holding the bow string."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nocks"@en .

aat:300230429 a skos:Concept ;
    skos:definition "Light European staff weapons, about 6 1/2 feet in length and with a head that is usually more decoration than weapon, carried by infantry officers in the 16th and 17th centuries as an insignia of rank and to give signals when leading their men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leading staffs"@en .

aat:300230433 a skos:Concept ;
    skos:definition "In matchlocks, snaphances, and wheel locks, small, shallow receptacles for holding the priming powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pans"@en .

aat:300230563 a skos:Concept ;
    skos:definition "Plate metal or leather armor protecting a horse's hindquarters, in complete form consisting of three heavy oblong plates covering the top of the rump and sides and back of the hind legs. Lighter versions consist of several leather straps, often metal plated, which run along the spine to the tail guard, down either side of the horse's flanks, and horizontally below the root of the tail. For the leather straps looping around the root of a horse's tail and fastened to the saddle to keep it from slipping forward, use \"cruppers (tail straps).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruppers"@en .

aat:300230666 a skos:Concept ;
    skos:definition "A type of miner's lamp consisting of a shallow metal pan with an attached half bail terminating in a usually rounded hook; a shield is mounted at the point of attachment of the bail to the lamp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frog lamps"@en .

aat:300230756 a skos:Concept ;
    skos:definition "Long flat brushes with wide, straight-cut edges, used for lettering or producing clean, precise lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettering brushes"@en .

aat:300230760 a skos:Concept ;
    skos:definition "Artists' brushes with very long, fine hair usually of sable or squirrel, often used for painting stripes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stripers"@en .

aat:300230761 a skos:Concept ;
    skos:definition "Dolls with heads, and often necks, hands, feet, and occasionally the body, made of unglazed porcelain; produced since the mid-19th century. They are distinguished from glazed porcelain dolls in that the cheeks, eyes, and lips have color fired onto the bisque, however, the skin area is largely unglazed, producing a velvety surface that resembles natural skin more closely than shiny glazed porcelain dolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bisque dolls"@en .

aat:300230798 a skos:Concept ;
    skos:definition "Objects of precious materials and symbolic value, such as jeweled scepters or crowns, appendant to the office of a sovereign."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown jewels"@en .

aat:300230810 a skos:Concept ;
    skos:definition "Oil paint in crayon, or stick, form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil pastels"@en .

aat:300230813 a skos:Concept ;
    skos:definition "Three-dimensional representations or images of a beetle, much used among the ancient Egyptians, such as for seals and amulets. Scarabs were made of various materials, glazed steatite being most common, usually having bases that are inscribed or decorated with designs. Scarabs first appeared in the late Old Kingdom (ca. 2575-ca. 2130 BCE) as evolutions from the so-called button seals. They became common in the Middle Kingdom (1938-ca. 1630 BCE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarabs"@en .

aat:300230815 a skos:Concept ;
    skos:definition "Occurrences of prearranged combat between two people, fought with deadly weapons according to an accepted code or procedure, especially to settle a private quarrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duels"@en .

aat:300230818 a skos:Concept ;
    skos:definition "Objects consisting of meshed arrangements of threads, cords, or ropes that have been twisted, knotted, or woven together at regular intervals. For the open weave textile made of twine or strong thread or yarn, usually of silk, cotton, nylon, or rayon, with fine to coarse meshes of fixed dimension, used to make various items from veils and trimming on clothing to tennis nets and fish nets, use \"net (textile).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nets"@en .

aat:300230820 a skos:Concept ;
    skos:definition "Mock combats between two armored horsemen armed with lances who charge at each other, the goal being to unhorse the opponent or shatter his lance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jousts"@en .

aat:300230824 a skos:Concept ;
    skos:definition "Jousts developed in Germany that were fought with lances having a blunted, often pronged, head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gestech"@en .

aat:300230833 a skos:Concept ;
    skos:definition "Jousts developed in Germany, fought with lances furnished with sharp pointed heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scharfrennen"@en .

aat:300230836 a skos:Concept ;
    skos:definition "Containers with a spraying device used for atomizing liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atomizers"@en .

aat:300230852 a skos:Concept ;
    skos:definition "Free people who support themselves by tilling the soil, either as small landholders or hired laborers. For the social class comprised of these people, use \"peasantry.\" For those in a condition of servitude under feudalism, owing services to a lord and commonly attached to the lord's land, use \"serfs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peasants"@en .

aat:300230869 a skos:Concept ;
    skos:definition "Those who own, rent, or otherwise have a legal right to occupy land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landholders"@en .

aat:300230871 a skos:Concept ;
    skos:definition "Those who have legal title to land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landowners"@en .

aat:300230874 a skos:Concept ;
    skos:definition "Men typically of noble birth, who, under European feudalism, held their rank, privileges, and landed estates from higher ranking individuals, in return for service as armed and mounted warriors or for providing another to fulfill this service in their stead. Use also for those who receive the title as a mark of honor and social distinction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knights"@en .

aat:300230894 a skos:Concept ;
    skos:definition "Officials who inflict capital punishment in pursuance of a legal warrant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executioners"@en .

aat:300230899 a skos:Concept ;
    skos:definition "Those who are treated as the property of and are entirely subject to another person, whether by capture, purchase, or birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enslaved people"@en .

aat:300230900 a skos:Concept ;
    skos:definition "Under feudalism, people in a condition of servitude, required to render specified services to a lord, commonly attached to the lord's land, and their services transferred with it from one landholder to another. For free people who support themselves by tilling the soil, either as small landholders or hired laborers, use \"peasants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serfs"@en .

aat:300231044 a skos:Concept ;
    skos:definition "Flat artists' brushes with square corners, with bristles or hairs longer than those of brights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flats"@en .

aat:300231047 a skos:Concept ;
    skos:definition "Large round brushes that fan out to a flat end, used particularly in oil painting to soften or blend edges or textures; usually made of badger hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blenders"@en .

aat:300231107 a skos:Concept ;
    skos:definition "Quilting technique in which designs outlined with stitching are heavily stuffed from the back with filling to give a raised effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuffed quilting"@en .

aat:300231130 a skos:Concept ;
    skos:definition "Process of filling, especially by packing the contents closely together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuffing"@en .

aat:300231133 a skos:Concept ;
    skos:definition "Refers to the temporary joining of two or more pieces of fabric or another material by some slight or temporary fastening other than successive stitches using a continous thread or other filament. Tacking may be done using a few isolated stitches or by using glue or another adhesive. For temporary joining of material done by sewing with long loose stitches and a continuous piece of thread, use \"basting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tacking"@en .

aat:300231138 a skos:Concept ;
    skos:definition "Italian stuffed quilting technique worked in smaller and narrower areas, creating almost the appearance of corded quilting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trapunto"@en .

aat:300231150 a skos:Concept ;
    skos:definition "Leather or metal cases for carrying small firearms such as pistols, revolvers, or, originally, harquebuses, designed to be worn on a belt or shoulder harness or attached to a saddle. They are shaped to conform to the outlines of the firearm and are open at the top to facilitate quick withdrawl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holsters"@en .

aat:300231153 a skos:Concept ;
    skos:definition "Puncturing or perforating, as to create a decorative pattern by removing small pieces of the material, usually metal; original technique done with a chisel but later with a small saw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piercing"@en .

aat:300231157 a skos:Concept ;
    skos:definition "Making clusters of short threads for decorative effect, as in candlewicking, or as a finish to the tying or holding stitches of quilts and upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tufting"@en .

aat:300231168 a skos:Concept ;
    skos:definition "Technique of weaving and attaching strips of cloth, typically canvas, to the seats of furniture for support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "webbing"@en .

aat:300231169 a skos:Concept ;
    skos:definition "Self-patterned textile with a small rectilinear pattern formed by contrasting the weave's warp and weft faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaper"@en .

aat:300231196 a skos:Concept ;
    skos:definition "Fastening an upholstery covering and padding in place by the use of buttons, usually in a pattern such as a diamond or square for a decorative effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttoning"@en .

aat:300231203 a skos:Concept ;
    skos:definition "Upholstering technique in which nails are set close together to secure the edges of the top cover, also creating a decorative feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close nailing"@en .

aat:300231210 a skos:Concept ;
    skos:definition "Upholstery webbing that results in a tightly interlaced upholstery foundation component; often associated with French furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close webbing"@en .

aat:300231217 a skos:Concept ;
    skos:definition "Pleated tufting done in a diamond pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond tufting"@en .

aat:300231223 a skos:Concept ;
    skos:definition "Close nailing in which the nails are set in two parallel rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double nailing"@en .

aat:300231228 a skos:Concept ;
    skos:definition "Quilting technique in which layers of cloth with no filling between them are back-stitched together under sufficient tension so as to raise the ground very slightly, thus giving the impression of filling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false quilting"@en .

aat:300231237 a skos:Concept ;
    skos:definition "Bunching folds of textile together by pulling on a thread stitched through it for this purpose or on one or more of its constituent filaments, to create fullness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gathering"@en .

aat:300231245 a skos:Concept ;
    skos:definition "Upholstering technique in which furniture is provided with deep stuffed upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overstuffing"@en .

aat:300231250 a skos:Concept ;
    skos:definition "Joining small pieces of cloth together with a seam to form an overall pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piecing"@en .

aat:300231267 a skos:Concept ;
    skos:definition "Trimming or finishing edges or seams with tubular strips of textile or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piping"@en .

aat:300231272 a skos:Concept ;
    skos:definition "Quilting technique using a top of thin, translucent cloth and either colored yarn for the back stitching or some form of colored stuffing, which shows palely through the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shadow quilting"@en .

aat:300231282 a skos:Concept ;
    skos:definition "Gathering cloth by pulling it along two or more parallel lines of stitching or encased cords, by stitching it with elastic thread, or by weaving rubber threads under tension into it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirring"@en .

aat:300231286 a skos:Concept ;
    skos:definition "Fitting of upholstery foundations with springs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springing"@en .

aat:300231290 a skos:Concept ;
    skos:definition "Triple pleats which are not pressed flat, arranged at regular intervals in a row. For similar triple pleats which are pressed flat, use \"pinch pleats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French pleats"@en .

aat:300231323 a skos:Concept ;
    skos:definition "Mechanical figures or contrivances constructed to move as if by their own power, generally by intricate hidden mechanisms; known since at least the Hellenistic period, as toys, amusements, and in clocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automata"@en .

aat:300231333 a skos:Concept ;
    skos:definition "Parts and components of textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile components"@en .

aat:300231458 a skos:Concept ;
    skos:definition "Devices used to prevent wood panels from warping and cracking, consisting of a system of wooden ribs attached to the back of the panel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cradles"@en .

aat:300231557 a skos:Concept ;
    skos:definition "Wood frames for the support of canvas or other textile that do not have expandable corners. For similar frames having expandable corners, use \"stretchers (framing and mounting equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strainers"@en .

aat:300231565 a skos:Concept ;
    skos:definition "Materials produced by weaving, felting, knotting, twining, or otherwise processing natural or synthetic fibers so that they cohere into a form or unit; traditionally excludes fiberboard, paper, papier-mâché, and papyrus, which, though also fiber products, are considered as separate types of material. For generic reference to the genre, see \"textiles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile materials"@en .

aat:300231599 a skos:Concept ;
    skos:definition "Describes textiles produced and used for furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnishing textile materials"@en .

aat:300231608 a skos:Concept ;
    skos:definition "Textile made with cotton, silk, or linen warp and wool, mohair, alpaca, or some other glossy hair fiber as weft in order to produce a lustrous surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luster"@en .

aat:300231618 a skos:Concept ;
    skos:definition "Refers to large sheets of heavy linen or another fabric on which a design has been painted. They were originally used for tapestry cartoons in sixteenth-century France, and then hung as though they were tapestries. A large collection survives at Reims. The term also refers to eighteenth-century French cloth that is inspired by these painted designs, but created by printing with copperplate engravings. It may also refer to any fabric done in the style of 18th-century copperplate designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toile peinte"@en .

aat:300231627 a skos:Concept ;
    skos:definition "Refers to a type of bobbin lace created in Brussels, Belgium (formerly Flanders) in the 17th and 18th centuries that was very expensive and favored at court. It is characterized by a distinctive mesh composed of a hexagon with four twisted sides and two sides plaited four times. Alternatively, portions of the design may be joined by a background of bars, or brides. Designs typically comprise large curved forms, bold, sweeping floral and plant designs, and landscapes and figures in narrative scenes. Individual motifs or small sections of the pattern were sometimes made separately and joined to the net ground. It was noted for being made of high quality thread from local Brabant flax. The term also refers to imitations of Brussels lace made later and/or in other locations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brussels lace"@en .

aat:300231638 a skos:Concept ;
    skos:definition "Belgian lace pillow-lace worked with fine thread in large sprays. It is characterized by floral motifs that are bobbin-made and sometimes resemble tape motifs, joined by thread bars (brides). It was made from circa 1840 throughout the 19th century in Brussels and Bruges. Most examples are considered inferior to other lace produced in Brussels, however, it was inexpensive and commercially successful."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duchesse lace"@en .

aat:300231657 a skos:Concept ;
    skos:definition "Machine-made laces produced in Nottingham, England. In order to carry this designation, the lace may be of any variety of patterns, but it must be knitted, twisted or embroidered in the United Kingdom by a member of the British Lace Federation. The term originally referred to lace produced on the Nottingham-lace machines, which was an invention that was originally used primarily for coarse lace production, employing larger bobbins than other lace machines and using pattern threads that were wound independently on section spools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nottingham lace"@en .

aat:300231713 a skos:Concept ;
    skos:definition "Needle lace produced in Brussels since the 15th century. It was originally inspired by Spanish and Venetian lace. It is characterized by a fine flax thread produced in Brabant, and a simple open buttonhole background, generally without bars or brides, upon which was worked a thick cordonnet and other raised work in floral or other designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brussels lace"@en .

aat:300231732 a skos:Concept ;
    skos:definition "Describes textiles that are printed or stamped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printed textile materials"@en .

aat:300231734 a skos:Concept ;
    skos:definition "Figured woven textile having a damasklike appearance, with contrasting luster in the pattern and ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damassé"@en .

aat:300231742 a skos:Concept ;
    skos:definition "A simple form of damask having a rectilinear pattern formed by the contrast of warp and weft faces, with numerous warp floats on the surface as in satin; much used for simple linens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damask diaper"@en .

aat:300231747 a skos:Concept ;
    skos:definition "Refers to distinctive printed textiles manufactured by the Oberkampf manufactory in Jouy-en-Josas, near Versailles, France, from 1760 onward. The designs were originally printed on cotton or linen from woodblocks; later works were printed from copperplates as well. It is typically characterized by large-scale, monochromatic floral designs or figural scenes. It is often made into hangings or covers for furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toile de Jouy"@en .

aat:300231784 a skos:Concept ;
    skos:definition "Narrow ornamented band, tape, lace or braid, often with metal thread, and often with both edges scalloped, used as trimming or binding on costume and textile furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galloon"@en .

aat:300231992 a skos:Concept ;
    skos:definition "Provision of fixed soft coverings for furniture, especially seating and reclining furniture. Originally referred to the provision of all textile components of a room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstering"@en .

aat:300232012 a skos:Concept ;
    skos:definition "Quilting technique in which two parallel lines of stitching are made through two layers of cloth, then heavy yarn or soft cord is inserted between the layers within the lines of stitching, making a raised linear pattern on an otherwise flat ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cord quilting"@en .

aat:300232026 a skos:Concept ;
    skos:definition "Methods or practices used for upholstering furnishings or other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstering techniques"@en .

aat:300232038 a skos:Concept ;
    skos:definition "Form of buttoning originating in the Victorian period, producing deeply puckered, comfortable upholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep buttoning"@en .

aat:300232049 a skos:Concept ;
    skos:definition "Applying heat, pressure, and moisture to cause fiber to adhere and mat together. For the controlled shrinking of textile in order to make it thicker and more compact, use \"fulling.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "felting"@en .

aat:300232074 a skos:Concept ;
    skos:definition "Finishing process in textile manufacture using controlled shrinkage to produce a thicker, more compact, and firm cloth. In heavily fulled textile, both the structure and the individual component strands are entirely obscured, giving the appearance of felt. For the application of heat, pressure, and moisture to fiber to cause it to mat together, use \"felting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fulling"@en .

aat:300232088 a skos:Concept ;
    skos:definition "Twisting together two or more single strands of yarn, usually in a direction opposite to the direction of the spin or twist of the single strands employed, to make a thicker and stronger yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plying"@en .

aat:300232145 a skos:Concept ;
    skos:definition "A cabbage-shaped ornament similar to a fabric rosette, but usually larger, softer, and three-dimensional rather than flat; used to trim costume, coverings, and hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chou"@en .

aat:300232151 a skos:Concept ;
    skos:definition "Fancy trimming used on furnishings and costume, such as braid, cord, fringe, gimp, or tassel, often in combination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passementerie"@en .

aat:300232154 a skos:Concept ;
    skos:definition "Trimming made by twisting silk, worsted, or cotton thread around a core thread or wire, resulting in a flat openwork braid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gimp"@en .

aat:300232162 a skos:Concept ;
    skos:definition "Tubular strip of textile, usually bias-cut, which may or may not enclose a cord, used for trimming the edges and seams of costume, coverings, and hangings. May be of matching or contrasting fabric, sometimes also in leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piping"@en .

aat:300232185 a skos:Concept ;
    skos:definition "Pendant trimming, decoration, or garment, comprising loose strands. Before the 20th century, usually a wooden mold covered with strands of silk or worsted; now often merely a bunch of threads, cords, or other strands gathered together at the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tassel"@en .

aat:300232186 a skos:Concept ;
    skos:definition "A narrow trimming made by a variety of techniques such as tablet weaving or braiding. It comes in a variety of fibers and weights, but is heavier than ribbon and flatter than cord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braid"@en .

aat:300232189 a skos:Concept ;
    skos:definition "A traditional Québequois weaving technique that uses old cloth torn into rag strips as weft; used to create textiles for either beds or floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalogne"@en .

aat:300232219 a skos:Concept ;
    skos:definition "Weaving by means of warp twining on a tablet loom. Because the number of warp threads is limited by the number of tablets that can conveniently be operated, this method is normally used for narrow bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablet weaving"@en .

aat:300232237 a skos:Concept ;
    skos:definition "The process of using any soft material or mass to fill out or heighten, cushion, or protect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padding"@en .

aat:300232242 a skos:Concept ;
    skos:definition "The process of raising fibers on the surface of a textile to give a pilelike surface, especially for softness, warmth, and increased absorbency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "napping"@en .

aat:300232336 a skos:Concept ;
    skos:definition "Attachments of glass, metal, or fabric which surround the light source and reduce or deflect the light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shades"@en .

aat:300232418 a skos:Concept ;
    skos:definition "Administrative sections, of any administrative level, of larger nations, territories, or other districts as defined for political, religious, military, judicial, or other purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divisions"@en .

aat:300232420 a skos:Concept ;
    skos:definition "Political units, such as nations, that exercise and are recognized internationally as possessing sovereignty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sovereign states"@en .

aat:300232423 a skos:Concept ;
    skos:definition "Associations expressly formed for integrated joint action by two or more political powers, typically for a specific purpose such as mutual defense, trade, or the acquisition or sharing of power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alliances"@en .

aat:300232424 a skos:Concept ;
    skos:definition "Groups of states or societies with a central government, but each retaining control of its own internal affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federations"@en .

aat:300232664 a skos:Concept ;
    skos:definition "Fast, powerful seagoing watercraft, usually schooner- or brig-rigged, with fine entrance, long run, moderate to pronounced drag, and strong deadrise; built in the first half of the 19th century and often involved in illegal trades, either as smugglers or slavers, or as revenue vessels trying to catch smugglers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baltimore clippers"@en .

aat:300232665 a skos:Concept ;
    skos:definition "Large, seagoing ships of the 15th through 17th century, distinguished by high sterncastle, high, overhanging forecastle, and a low waist; could be used either as a merchant vessel or warship; usually square-rigged on the fore- and mainmast and lateen-rigged on the remaining one to three masts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carracks"@en .

aat:300232670 a skos:Concept ;
    skos:definition "Single-hulled watercraft especially when contrasting them to multihulled watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monohulls"@en .

aat:300232673 a skos:Concept ;
    skos:definition "Describes watercraft with a flat hull, often used to traverse shallow bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-bottomed watercraft"@en .

aat:300232674 a skos:Concept ;
    skos:definition "Capacious, flat-bottomed vessels, usually intended to be pushed or towed, primarily for transporting cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barges"@en .

aat:300232677 a skos:Concept ;
    skos:definition "Light, high-powered vessels, often with stepped hulls, designed to plane along the surface of the water at great speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydroplanes"@en .

aat:300232678 a skos:Concept ;
    skos:definition "Hydroplanes that ride on two forward sponsons and a point at the stern, which may be suspended by propellor alone; almost always raceboats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-point hydroplanes"@en .

aat:300232680 a skos:Concept ;
    skos:definition "Describes watercraft with a concaved V-shape hull."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-bottomed watercraft"@en .

aat:300232681 a skos:Concept ;
    skos:definition "Chesapeake Bay watercraft with V-bottom hulls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deadrise boats"@en .

aat:300232689 a skos:Concept ;
    skos:definition "Describes watercraft in which each end of the vessel is distinctly shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asymmetrical-ended watercraft"@en .

aat:300232690 a skos:Concept ;
    skos:definition "The motion and behavior of projectiles in flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballistics"@en .

aat:300232696 a skos:Concept ;
    skos:definition "Describes watercraft with a square-shaped stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square-sterned watercraft"@en .

aat:300232698 a skos:Concept ;
    skos:definition "Small to medium-sized vessels, with plain head and square stern, originally developed as lateen-rigged coastal fishing vessels in Medieval Portugal, but eventually used as exploratory vessels in Iberian voyages to the New World in the late 15th and early 16th centuries; vessels of exploration were often square-rigged for more efficient ocean-going travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caravels"@en .

aat:300232703 a skos:Concept ;
    skos:definition "Describes watercraft in which both ends of the vessel are symmetrically shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symmetrical-ended watercraft"@en .

aat:300232704 a skos:Concept ;
    skos:definition "Watercraft with both ends coming to a point or ending in a full stem and sternpost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-enders"@en .

aat:300232706 a skos:Concept ;
    skos:definition "Indonesian vessels with a very large triangular, usually lateen, sail and a substantial loadbearing outrigger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proas"@en .

aat:300232707 a skos:Concept ;
    skos:definition "Ancient Roman merchant vessels having a full hull with curved stem and sternpost; generally shorter and wider than \"pontones,\" the other major Roman merchant craft. Corbitae made regular voyages between ports in the Red Sea and the west coast of India, as well as regular Mediterranean routes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corbitae"@en .

aat:300232708 a skos:Concept ;
    skos:definition "Northern European seagoing ships of the 16th through 18th century, usually Dutch built and less than 700 tons burden, having a long, narrow hull with full ends, considerable tumblehome, ship rig, and a false transom or lute stern over a full sternpost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flutes"@en .

aat:300232709 a skos:Concept ;
    skos:definition "New England watercraft, usually of colonial or later date, having raking posts, moderate to fine ends, and bulwarks that extend outside and abaft the head of the sternpost in a pink stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinkys"@en .

aat:300232710 a skos:Concept ;
    skos:definition "Small craft, more or less canoe-shaped but wider, usually less than 6 m long, with round bilges, and exactly symmetrical ends; originated in New England but no longer confined to that region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peapods"@en .

aat:300232716 a skos:Concept ;
    skos:definition "Describes watercraft with symmetical square ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square-ended watercraft"@en .

aat:300232717 a skos:Concept ;
    skos:definition "Small craft with flat rockered bottoms, flat sides, and broad square ends, commonly but not exclusively found along the New Jersey coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garveys"@en .

aat:300232718 a skos:Concept ;
    skos:definition "Small craft, traditionally clinker-built but more recently of plywood, with flat panels at each end instead of conventional posts; the panel at the bow is usually smaller than the one at the stern. For flat-bottomed, flat-sided, hard-chined inland watercraft, use \"prams (bottom-based watercraft).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prams"@en .

aat:300232719 a skos:Concept ;
    skos:definition "Small, flat-bottomed boats with shallow draft and square ends propelled by poling along shallow rivers and streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punts"@en .

aat:300232722 a skos:Concept ;
    skos:definition "Any small pleasure or service watercraft, where the foredeck is raised to be flush with the top of the cabin in a conventional trunk cabin type. The flush deck is carried across the full width of the boat to the stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raised deck boats"@en .

aat:300232723 a skos:Concept ;
    skos:definition "Vessels with superstructures consisting of a poop or after castle, bridge or midcastle, and forecastle; generally used as cargo vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-island vessels"@en .

aat:300232724 a skos:Concept ;
    skos:definition "Vessels with tubular or rounded topsides, creating a convex deck which allowed seas to run freely over the hull; form originated on the Great Lakes in 1896."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whaleback vessels"@en .

aat:300232729 a skos:Concept ;
    skos:definition "Watercraft having a primarily ceremonial or ritual purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial watercraft"@en .

aat:300232732 a skos:Concept ;
    skos:definition "Vessels intended for or engaged in commercial hunting and fishing; for vessels used for recreational fishing, use \"sport fishing vessels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting and commercial fishing vessels"@en .

aat:300232733 a skos:Concept ;
    skos:definition "Watercraft engaged in fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing vessels"@en .

aat:300232735 a skos:Concept ;
    skos:definition "Describes fishing watercraft that engage in the capture of marine life through dredging, specifically digging or pulling out with a dredge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dredging vessels"@en .

aat:300232736 a skos:Concept ;
    skos:definition "Boats from the Chesapeake Bay rigged with hydraulic clam dredges; generally square-sterned deadrise motorboats, somewhat beamier than similar boats such as used in other Chesapeake fisheries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clam dredgers"@en .

aat:300232739 a skos:Concept ;
    skos:definition "Describes fishing watercraft that engage in the capture of marine life using lines, as opposed to nets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line fishing vessels"@en .

aat:300232740 a skos:Concept ;
    skos:definition "Describes fishing vessels used for handlining, where a fishing line is cast and held by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handlining vessels"@en .

aat:300232741 a skos:Concept ;
    skos:definition "Fishing craft in which handlining is carried out from dories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dory hand-liners"@en .

aat:300232743 a skos:Concept ;
    skos:definition "Vessels rigged for longlining, a mid-20th-century fishing technique, characterized by one or more winches or drums to handle the lines, often several miles long."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longliners"@en .

aat:300232744 a skos:Concept ;
    skos:definition "Describes fishing watercraft that engage in the capture of marine life using nets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "net fishing vessels"@en .

aat:300232745 a skos:Concept ;
    skos:definition "Boats used in fishing with seines, nets hung vertically in the water and having floats on their upper edges and sinkers on their lower edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seiners"@en .

aat:300232748 a skos:Concept ;
    skos:definition "Small otter trawlers of various types and sizes, which engage in shore fishing along the Atlantic Coast of the United States, usually within 50 miles of the coastline; introduced in the mid-20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draggers"@en .

aat:300232749 a skos:Concept ;
    skos:definition "Any of various vessels engaged in shoreline fishing with trawl nets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trawlers"@en .

aat:300232750 a skos:Concept ;
    skos:definition "Describes fishing watercraft that engage in the the capture of marine life using trapping devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trapping vessels"@en .

aat:300232751 a skos:Concept ;
    skos:definition "Small (under about 25 feet) V-bottomed boats, both power and sail, chiefly used for crabbing on Chesapeake Bay, with handliners or trotlines in summer; may be used for oyster tonging in winter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crabbing skiffs"@en .

aat:300232753 a skos:Concept ;
    skos:definition "Any of various types and styles of boats used for waterfowl hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunning boats"@en .

aat:300232754 a skos:Concept ;
    skos:definition "Dory-type waterfowling boats with wide stern found on the Susquehanna Flats of the upper Chesapeake Bay during the late 19th and early 20th centuries; generally having a hole in the transom for a sculling oar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bushwack boats"@en .

aat:300232755 a skos:Concept ;
    skos:definition "Late-19th- and early-20th-century light shallow-draft boats designed to be poled in marshes in pursuit of various Rallidae, usually flat-bottomed, both cross- and fore-and-aft-planked, and double-ended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rail skiffs"@en .

aat:300232756 a skos:Concept ;
    skos:definition "Large, usually round artists' brushes made with squirrel or badger hair, used for applying large amounts of watercolor and to blend and soften washes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mops"@en .

aat:300232757 a skos:Concept ;
    skos:definition "Waterfowling boats built to hide gunners inside and able to float partially submerged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sneak boxes"@en .

aat:300232758 a skos:Concept ;
    skos:definition "Vessels engaged in some aspect of whaling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whaling vessels"@en .

aat:300232759 a skos:Concept ;
    skos:definition "Whaling vessels specifically designed for processing whales as they are caught; usually accompanying whale catchers. For the facilities where whales are processed on shore, use \"whaling stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factory ships"@en .

aat:300232760 a skos:Concept ;
    skos:definition "Small, engine-powered ocean-going vessels used to hunt and kill whales; generally used in conjunction with whale-oil factory ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whale catchers"@en .

aat:300232761 a skos:Concept ;
    skos:definition "Open, double-ended, round-bottomed rowing boats usually also equipped with a sail, in the 25- to 35-foot range, designed originally for the harpooning of whales; often attached to larger ships but may operate from shore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whaleboats"@en .

aat:300232762 a skos:Concept ;
    skos:definition "Sailing vessels engaged in whaling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whaleships"@en .

aat:300232767 a skos:Concept ;
    skos:definition "Small open sailboats without any or with very limited accommodations designed primarily for day sailing, although many are also class boats used for racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daysailers"@en .

aat:300232769 a skos:Concept ;
    skos:definition "Watercraft engaged in recreational fishing; for vessels engaged in commercial hunting and fishing, use descriptors under \"<hunting and commercial fishing vessels>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sport fishing vessels"@en .

aat:300232770 a skos:Concept ;
    skos:definition "Open outboard-powered boats in the 15- to 18-foot range, configured especially for freshwater sport fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bassboats"@en .

aat:300232771 a skos:Concept ;
    skos:definition "Small rowing boats built for professional fishing guides to take customers fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guideboats"@en .

aat:300232772 a skos:Concept ;
    skos:definition "Light, bevel-lapped double-ended guideboats from New York State's Adirondack region, ranging from 13 to 18 feet long, fitted with a carrying yoke, having a flat bottom board, and planked over natural crook frames in the style of dories; planking is usually smooth or carvel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adirondack guideboats"@en .

aat:300232773 a skos:Concept ;
    skos:definition "Lapstrake boats 14 to 17 feet long, primarily designed for rowing and found on Maine's large western and southern lakes; examples from the 1870s to about 1910 were double-ended; later boats had transom sterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rangeley boats"@en .

aat:300232774 a skos:Concept ;
    skos:definition "Double-ended, lapstrake rowing boats, using a single thole pin and oar with hole to fit over it, ranging in length from 16 to 23 feet, originating in the mid-19th century on the St. Lawrence River; larger examples may have sailing rigs, and are sailed without rudders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "St. Lawrence River skiffs"@en .

aat:300232775 a skos:Concept ;
    skos:definition "High-speed planing powerboats, often with accommodations, capable of going offshore and specially equipped for rod and reel sport fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sportfishermen"@en .

aat:300232776 a skos:Concept ;
    skos:definition "Describes watercraft used for sporting or competitive activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "competition craft"@en .

aat:300232777 a skos:Concept ;
    skos:definition "Sailboats sufficiently alike or having differences under sufficient restrictions to enable them to race against each other as a class without the necessity of handicap allowances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "class boats"@en .

aat:300232778 a skos:Concept ;
    skos:definition "A class of sailing yachts built from a standard design and identical in construction and rig."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-designs"@en .

aat:300232779 a skos:Concept ;
    skos:definition "Racing sailboats built to a rule which allows hull and rig variations, but still allows boats built to the rule to race without handicap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "development class boats"@en .

aat:300232780 a skos:Concept ;
    skos:definition "Any powerboats designed for racing, generally built to restrictions similar to sailing development or restricted classes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raceboats"@en .

aat:300232781 a skos:Concept ;
    skos:definition "Watercraft engaged in commercial transport on oceans or large inland bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merchant vessels"@en .

aat:300232785 a skos:Concept ;
    skos:definition "Inland waterway vessels used to push groups of barges; for general assistance vessels employed at sea or in and around harbors, use \"tugboats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towboats"@en .

aat:300232789 a skos:Concept ;
    skos:definition "Vessels designed to carry dry bulk cargoes, such as grain, coal, or ore, loose in large compartments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulk carriers"@en .

aat:300232790 a skos:Concept ;
    skos:definition "Vessels either designed for or engaged in the trade of carrying coal in bulk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colliers"@en .

aat:300232794 a skos:Concept ;
    skos:definition "Vessels designed to carry cargo packed in standardized, sealable, and reusable containers, that are made to fixed dimensions (usually either 20 or 40 feet in length) and designed to stack and lock together. They are also characterized by the lack of cargo handling gear, which is located on shore terminals rather than aboard ship. Container ships require large hatches in the deck for stowing the cargo; belowdecks typically is a cellular grid of compartments opening to the weather deck and designed to receive the containers and hold them in place until unloading is achieved at the port of destination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "container ships"@en .

aat:300232798 a skos:Concept ;
    skos:definition "Watercraft used primarily to carry passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passenger vessels"@en .

aat:300232802 a skos:Concept ;
    skos:definition "Passenger ships taking extended cruises, often with intermediary stops along the way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruise ships"@en .

aat:300232807 a skos:Concept ;
    skos:definition "Ships belonging to shipping companies that carry passengers or cargo and passengers on regularly scheduled routes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liners"@en .

aat:300232809 a skos:Concept ;
    skos:definition "Cargo-carrying merchant vessels that do not work regular routes but carry goods to any port upon request."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tramps"@en .

aat:300232810 a skos:Concept ;
    skos:definition "Watercraft designed primarily for use in warfare, either in combat operations or to provide services and support for such operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval ships"@en .

aat:300232811 a skos:Concept ;
    skos:definition "Ships providing service and support to naval operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval auxiliary ships"@en .

aat:300232812 a skos:Concept ;
    skos:definition "Tankers carrying fuel oil and fitted out with pumps, hoses, and couplings to facilitate refueling warships at sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oilers"@en .

aat:300232813 a skos:Concept ;
    skos:definition "Unarmed ships staffed and equipped to provide hospitalization for wounded military personnel or to evacuate wartime casualties; marked according to standards of international law to allow for safe passage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospital ships"@en .

aat:300232815 a skos:Concept ;
    skos:definition "Collocates descriptors for vessels used to transport troops or horses to overseas locations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transport vessels"@en .

aat:300232817 a skos:Concept ;
    skos:definition "Vessels carrying large numbers of combat troops and associated military supplies; may be built for the purpose but are often converted passenger liners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transports"@en .

aat:300232819 a skos:Concept ;
    skos:definition "Naval vessels carrying war horses or cavalry mounts to overseas military campaigns; such vessels are usually specifically modified to stable, support, and feed horses, and may additionally be constructed for rapid loading and unloading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse transports"@en .

aat:300232825 a skos:Concept ;
    skos:definition "Warships assigned to protect single ships or convoys of transports or merchant vessels during wartime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escort vessels"@en .

aat:300232826 a skos:Concept ;
    skos:definition "Describes watercraft employed during combat to land and support ground forces entering enemy territory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphibious warships"@en .

aat:300232827 a skos:Concept ;
    skos:definition "Warships designed to transport and land troops, equipment, and supplies, often with the aid of helicopters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphibious assault ships"@en .

aat:300232828 a skos:Concept ;
    skos:definition "Describes combat watercraft that operate in mine warfare, such as laying, clearing, or destroying mines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mine warfare ships"@en .

aat:300232829 a skos:Concept ;
    skos:definition "Warships equipped or designed for laying mines in or under the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minelayers"@en .

aat:300232832 a skos:Concept ;
    skos:definition "Relatively light, fast, oared warships used by Roman navies of the Imperial period to patrol sea lanes and pursue pirates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liburnians"@en .

aat:300232835 a skos:Concept ;
    skos:definition "Steam-driven warships of the 19th and early 20th centuries equipped with an armored prow to be used as a primary weapon against other ships; for rowed warships equipped with ramming prows, use \"galleys (watercraft)\" or a descriptor under \"<multilevel rowed watercraft>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rams"@en .

aat:300232836 a skos:Concept ;
    skos:definition "Describes combat watercraft that transport projectile weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warships carrying projectile weapons"@en .

aat:300232839 a skos:Concept ;
    skos:definition "Sailing warships carrying one or more heavy mortars or howitzers mounted on specially constructed platforms or in heavily reinforced pits; often ketch-rigged to give mortars a clearer field of fire forward and used in bombarding coastal towns or fortresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bomb vessels"@en .

aat:300232843 a skos:Concept ;
    skos:definition "Large, Byzantine two-banked galleys, with one or two sails and usually equipped with flamethrowers for use with Greek fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dromons"@en .

aat:300232845 a skos:Concept ;
    skos:definition "Relatively small warships armed with one or more guns; such vessels are most commonly used for local defense and inland patrol, but gunboats of the late 19th and early 20th centuries could be quite substantial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunboats"@en .

aat:300232847 a skos:Concept ;
    skos:definition "Describes vessels built and armed for combat purposes and travel or transport below the water's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subsurface combatants"@en .

aat:300232850 a skos:Concept ;
    skos:definition "Naval submarines carrying ballistic missiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballistic missile submarines"@en .

aat:300232853 a skos:Concept ;
    skos:definition "German subsurface attack vessels developed during the First and Second World Wars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "U-boats"@en .

aat:300232856 a skos:Concept ;
    skos:definition "Long, slender, hair brushes that come to a shaped chisel tip, used for lettering and for precise lines or bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riggers"@en .

aat:300232857 a skos:Concept ;
    skos:definition "Ships built or operated for the purpose of teaching crew members or students seamanship or other subjects; many navies operate such vessels for their cadets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "training ships"@en .

aat:300232859 a skos:Concept ;
    skos:definition "Describes vessels that provide assistance or support to other watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assistance vessels"@en .

aat:300232860 a skos:Concept ;
    skos:definition "Relatively small powerful vessels used to tow ships at sea, to tow barges, or to assist in and around harbors, as during berthing; for merchant vessels employed to push groups of barges, use \"towboats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tugboats"@en .

aat:300232861 a skos:Concept ;
    skos:definition "Describes vessels used to service communications infrastructures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communications vessels"@en .

aat:300232863 a skos:Concept ;
    skos:definition "Vessels that provide assistance or relief during emergency situations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emergency vessels"@en .

aat:300232865 a skos:Concept ;
    skos:definition "Boats of various kinds, often double-ended and human-powered or having an auxiliary motor, used for rescue or lifesaving at sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifeboats"@en .

aat:300232872 a skos:Concept ;
    skos:definition "Vessels fitted with machinery for deepening or cleaning and improving waterways, especially harbors and river channels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dredgers"@en .

aat:300232875 a skos:Concept ;
    skos:definition "Round, stiff, artists' brushes with blunt tips used for stippling and stenciling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencil brushes"@en .

aat:300232876 a skos:Concept ;
    skos:definition "Describes vessels used by law enforcement individuals or administrative units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law enforcement vessels"@en .

aat:300232884 a skos:Concept ;
    skos:definition "Watercraft equipped or designed for oceanographic study or exploration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research vessels"@en .

aat:300232886 a skos:Concept ;
    skos:definition "Small vessels employed either to attend larger ones, as for taking ashore or bringing aboard passengers, goods, and stores, or to attend coastal facilities, such as lighthouses and canneries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenders"@en .

aat:300232888 a skos:Concept ;
    skos:definition "Boats that are carried on ships, especially those used to serve the ships; before the engine era, usually rigged for both oar and sail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships' boats"@en .

aat:300232890 a skos:Concept ;
    skos:definition "Ships' boats assigned to flag officers, especially since 1750; generally smaller and lighter than launches and longboats, usually having more than 10 oars, and often decorated and fitted out with accommodations for the assigned officer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barges"@en .

aat:300232892 a skos:Concept ;
    skos:definition "Long light ships' boats usually rowing six or fewer single banked oars and ranging up to about 30 feet in length; may also be shore based, used to row pilots out to ships and sometimes used for racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gigs"@en .

aat:300232895 a skos:Concept ;
    skos:definition "Refers to the largest of a ships' boats during the 19th and 20th centuries, typically heavily built, beamy, and carvel-planked, originally used for carrying cargo and men and usually 16 feet to 34 feet in length, with a beam about one-third the length, and with a relatively straight stem and square stern; has come to be used for motorized small boats of the same general size and shape. When referring to the largest ships' boats of the 18th century and earlier, use \"longboats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "launches"@en .

aat:300232896 a skos:Concept ;
    skos:definition "Ships' boats carried on stern davits of fishing vessels, especially coasters; became engine-powered in the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yawl boats"@en .

aat:300232897 a skos:Concept ;
    skos:definition "Small warships' boats, carvel-planked, 16 feet to 26 feet long, and rowing eight oars or fewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yawls"@en .

aat:300232898 a skos:Concept ;
    skos:definition "Small self-propelled boats fitted with tanks used in harbors for supplying fresh water to vessels and having pumps and hoses for discharging their cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water boats"@en .

aat:300232901 a skos:Concept ;
    skos:definition "Describes vessels that operate on the water's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface craft"@en .

aat:300232902 a skos:Concept ;
    skos:definition "Describes vessels designed to achieve buoyancy by displacing a volume of water equal to their weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "displacement vessels"@en .

aat:300232903 a skos:Concept ;
    skos:definition "Collocates vehicles retrofitted with planes or stepped hulls to lift the vessels above the water's surface when traveling at high speeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planing vessels"@en .

aat:300232909 a skos:Concept ;
    skos:definition "Semisubmersible torpedo boats built and used by Confederate forces during the American Civil War; steam driven, with a small, protected opening at the top of a long, spindle-shaped hull."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "davids"@en .

aat:300232911 a skos:Concept ;
    skos:definition "Small or medium-sized vessels engaged in coastwise navigation; generally merchant vessels maintaining trade and communication among smaller ports and between major entrepôts and the hinterland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coasters"@en .

aat:300232913 a skos:Concept ;
    skos:definition "Collocates descriptors for watercraft used on enclosed bodies of relatively protected water, such as rivers, lakes, and canals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inland vessels"@en .

aat:300232922 a skos:Concept ;
    skos:definition "Describes watercraft constructed with a bottom-based hull."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottom-based watercraft"@en .

aat:300232923 a skos:Concept ;
    skos:definition "Bottom-based merchant ships of the 13th to the 15th century, clinker-built with rounded bow and stern, fore and after castles, and very broad in the beam; occasionaly used as warships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cogs"@en .

aat:300232925 a skos:Concept ;
    skos:definition "Large, dorylike vessels with straight posts and flat sides; commmonly found in upper New England and Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bateaux"@en .

aat:300232927 a skos:Concept ;
    skos:definition "Flat-bottomed, double-ended, usually inland watercraft common to New England and Lower Canada since colonial times; built on a base of heavy bottom planks or logs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gundalows"@en .

aat:300232928 a skos:Concept ;
    skos:definition "Flat-bottomed, flat-sided, hard-chined inland watercraft common in northern Europe from the Middle Ages onward; sides usually clinker; similar in structure to dories. For small craft, traditionally clinker-built, use \"prams (square-based watercraft).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prams"@en .

aat:300232932 a skos:Concept ;
    skos:definition "Describes watercraft constructed by hollowing out the interior of a tree trunk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dugout-based watercraft"@en .

aat:300232935 a skos:Concept ;
    skos:definition "Small Chesapeake Bay sailing craft built up from three to five logs bolted together and carved to shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "log canoes"@en .

aat:300232936 a skos:Concept ;
    skos:definition "Small- to medium-sized watercraft built on a log bottom, either as extended dugouts or, less commonly, in log-canoe fashion, typically with an open central hold and propelled by sails, oars, or poling; common to the southeastern United States and South and Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periaguas"@en .

aat:300232940 a skos:Concept ;
    skos:definition "Watercraft constructed by stretching a flexible, waterproof membrane, such as skin or gut, over a light framework, typically of wood; some versions use cloth, which is waterproofed with an applied substance, such as pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin boats"@en .

aat:300232941 a skos:Concept ;
    skos:definition "Small, broad round or roundish skin boats of various constructions used for river or coastal transport in ports of the Near East and Great Britain in ancient and modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coracles"@en .

aat:300232942 a skos:Concept ;
    skos:definition "Vessels constructed of skin, or later of tarred canvas, over a substantial wooden frame and having a distinctive narrow shape, with the bottom rising forward and a definite knuckle or break in the sheer; sometimes as large as 10m long, built in Ireland, particularly on the west coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curraghs"@en .

aat:300232951 a skos:Concept ;
    skos:definition "Describes watercraft powered by human activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human-powered watercraft"@en .

aat:300232954 a skos:Concept ;
    skos:definition "Describes watercraft propelled by the rotation of oars in water and powered by human beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rowed watercraft"@en .

aat:300232955 a skos:Concept ;
    skos:definition "Describes watercraft propelled by oarsmen positioned on one level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single level rowed watercraft"@en .

aat:300232957 a skos:Concept ;
    skos:definition "Ancient Greek warships propelled by 25 pairs of oarsmen; such ships formed the backbone of early Greek naval fleets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penteconters"@en .

aat:300232958 a skos:Concept ;
    skos:definition "Small watercraft of conventional, not elongated, form, propelled by oars; may be used for work or recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulling boats"@en .

aat:300232961 a skos:Concept ;
    skos:definition "Ancient Greek warships propelled by fifteen pairs of oars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triaconters"@en .

aat:300232962 a skos:Concept ;
    skos:definition "Describes watercraft propelled by oarsmen positioned on two or more levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multilevel rowed watercraft"@en .

aat:300232963 a skos:Concept ;
    skos:definition "Ancient Mediterranean warships propelled by oarsmen arranged in two levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biremes"@en .

aat:300232967 a skos:Concept ;
    skos:definition "Ancient warships propelled by oarsmen grouped somehow into units of four on at least two levels; exact arrangement of oarsmen unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadriremes"@en .

aat:300232969 a skos:Concept ;
    skos:definition "Ancient warships propelled by oarsmen grouped somehow into units of five on at least two levels; exact arrangement of oarsmen unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quinqueremes"@en .

aat:300232972 a skos:Concept ;
    skos:definition "Describes watercraft powered and propelled by machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanically powered watercraft"@en .

aat:300232974 a skos:Concept ;
    skos:definition "Describes watercraft that can be powered by an external source, such as an internal combustion engine, added to the vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auxiliary powered watercraft"@en .

aat:300232976 a skos:Concept ;
    skos:definition "Vessels with smaller sail area than typical sailboats plus a motor as means of propulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motorsailers"@en .

aat:300232981 a skos:Concept ;
    skos:definition "Describes watercraft powered by a heat engine that derives its heat from fuel consumed outside the cylinder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "external combustion engine-powered watercraft"@en .

aat:300232982 a skos:Concept ;
    skos:definition "Watercraft powered by naphtha-burning engines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naphtha launches"@en .

aat:300232985 a skos:Concept ;
    skos:definition "Describes watercraft powered by the combustion of fuel with an oxidizer inside a combustion chamber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internal combustion engine-powered watercraft"@en .

aat:300232989 a skos:Concept ;
    skos:definition "Small motorized pleasure craft used for such activities as day fishing or recreational outings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runabouts"@en .

aat:300232995 a skos:Concept ;
    skos:definition "Steam-powered watercraft propelled by a pair of paddle wheels mounted amidships or by a single paddle wheel at the stern; developed in the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paddle steamers"@en .

aat:300232998 a skos:Concept ;
    skos:definition "Steam-powered vessels propelled by a single paddle wheel mounted at the stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stern-wheelers"@en .

aat:300232999 a skos:Concept ;
    skos:definition "Describes watercraft in which movement occurs from the rotation of two or more blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propeller-driven watercraft"@en .

aat:300233005 a skos:Concept ;
    skos:definition "Motorboats propelled by outboard motors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outboards"@en .

aat:300233021 a skos:Concept ;
    skos:definition "Describes watercraft rigged with fore-and-aft sails on their main masts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fore-and-aft-rigged vessels"@en .

aat:300233025 a skos:Concept ;
    skos:definition "Relatively small, decked sailing vessels similar to sloops, with a single mast and a bowsprit with, often two, headsails, but with the mast stepped farther aft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutters"@en .

aat:300233027 a skos:Concept ;
    skos:definition "Coastal transport and trading vessels of the Mediterranean, lateen-rigged on one or two masts and also having oars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feluccas"@en .

aat:300233031 a skos:Concept ;
    skos:definition "Two-masted vessels, square-rigged on both masts, with the mainmast forward of and taller than the mizzen; in use between the late 17th and early 19th centuries. For similar two-masted vessels, but with fore-and-aft rigs and in use since the mid-19th century, use \"ketches (fore-and-aft-rigged vessels).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ketches"@en .

aat:300233034 a skos:Concept ;
    skos:definition "Schooners having three masts, all nearly the same height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tern schooners"@en .

aat:300233035 a skos:Concept ;
    skos:definition "Refers to schooners, usually two-masted, carrying topsails on one or more masts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topsail schooners"@en .

aat:300233036 a skos:Concept ;
    skos:definition "Sailing vessels lateen-rigged on the mainmast and square-rigged on a smaller mizzenmast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bilanders"@en .

aat:300233039 a skos:Concept ;
    skos:definition "Sailing vessels on which the principal sails are set athwartships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square-rigged vessels"@en .

aat:300233040 a skos:Concept ;
    skos:definition "Square-rigged vessels having two masts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-masted square-rigged vessels"@en .

aat:300233041 a skos:Concept ;
    skos:definition "Two-masted vessels square-rigged on the foremast, but primarily fore-and-aft-rigged on the mainmast, although some vessels carried square topsails on the mainmast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brigantines"@en .

aat:300233042 a skos:Concept ;
    skos:definition "Two-masted vessels carrying a full set of square sails on each mast, although the mainmast also carries a gaff-rigged spanker or driver sail; the mainmast is taller than the foremast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brigs"@en .

aat:300233043 a skos:Concept ;
    skos:definition "Brigs having a gaff-rigged spanker or trysail set on a small auxiliary mast, called a spencer mast or trysail mast, just abaft the mainmast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snows"@en .

aat:300233046 a skos:Concept ;
    skos:definition "Sailing vessels of three or more masts, square-rigged on all but the aftermost mast, which is fore-and-aft-rigged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barks"@en .

aat:300233048 a skos:Concept ;
    skos:definition "Vessels of three or more masts, square-rigged on all masts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-rigged ships"@en .

aat:300233201 a skos:Concept ;
    skos:definition "Instruments or apparatuses that facilitate casting an image onto a surface or space by optical means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image-projecting equipment"@en .

aat:300233202 a skos:Concept ;
    skos:definition "Devices for projecting an image upon a surface by means of the transmission of light through a transparent slide or film or the reflection of light from an opaque object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projectors"@en .

aat:300233203 a skos:Concept ;
    skos:definition "Devices used for cleaning artists' brushes, or to prevent them from drying out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brush washers"@en .

aat:300233218 a skos:Concept ;
    skos:definition "Diffraction of x-rays by the regularly spaced atoms of a substance, useful for determining the arrangement of atoms and thereby the nature or composition of a substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray diffraction"@en .

aat:300233228 a skos:Concept ;
    skos:definition "18th-century term for ornamental trimming in the form of bands or stripes on a robe or gown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robing"@en .

aat:300233229 a skos:Concept ;
    skos:definition "Light warships, sometimes relatively small boats, stationed or patrolling around the periphery of an anchored fleet to provide advance warning of or to intercept intruders or attackers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picket boats"@en .

aat:300233230 a skos:Concept ;
    skos:definition "Any of a variety of small- to medium-sized double-ended craft of the 15th through 19th century in Europe and America, characterized by a narrow or overhanging stern, sometimes with a false transom called a pink stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinks"@en .

aat:300233277 a skos:Concept ;
    skos:definition "Vessels designed to carry cargo packed in road or rail vehicles that are loaded and unloaded under their own power, rolled on and rolled off, via a ramp built into one or both ends of the ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ro/Ros"@en .

aat:300233279 a skos:Concept ;
    skos:definition "Vessels engaged in transporting human beings for sale as slaves, sometimes designed specifically for the purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slavers"@en .

aat:300233315 a skos:Concept ;
    skos:definition "Instruments and apparatuses used for cultivating the soil, producing crops, and raising livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural equipment"@en .

aat:300233319 a skos:Concept ;
    skos:definition "Rings or bands, usually of metal, serving as fittings, adapters, or holders, as for example holding the bristles of a brush to the handle, or affixed to the body of a silver article for inserting a handle of another material, or on the handle of a utensil or tool into which is fitted the rest of the utensil or tool, or a plumbing fitting providing access to the pipe for maintenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrules"@en .

aat:300233378 a skos:Concept ;
    skos:definition "Chess pieces, frequently depicting all or part of a horse, designated to move as knights may move."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knights"@en .

aat:300233387 a skos:Concept ;
    skos:definition "Embedded air pockets used as decoration of glass, comprising large, intentionally created air bubbles or tears, arranged in a decorative pattern, often in criss-crossed diagonal rows or spirals. Often seen in the stems of 18th-century and later wine glasses, particularly English."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air traps"@en .

aat:300233389 a skos:Concept ;
    skos:definition "Heraldic motifs forming part of a coat of arms sometimes displayed or inscribed to indicate ownership; a crest may be common to more than one family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crests"@en .

aat:300233390 a skos:Concept ;
    skos:definition "Ornamentation on glass, as on wine decanters, consisting of narrow applied bands of glass forming parallel ribs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigaree"@en .

aat:300233393 a skos:Concept ;
    skos:definition "Engraving produced by short repetitive strokes of a cutting tool, especially on metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bright cutting"@en .

aat:300233394 a skos:Concept ;
    skos:definition "Process of plating with silver leaf on steel, iron, or occasionally brass, used especially on knives and scissors; patented in 1779 by Richard Ellis as a technique less expensive than French plating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "close plating"@en .

aat:300233397 a skos:Concept ;
    skos:definition "The process of shaping glass, making facets, grooves, and depressions, by grinding using rotating disks of various materials, sizes, and shapes and a stream of water with an abrasive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutting"@en .

aat:300233399 a skos:Concept ;
    skos:definition "Cutting, as metal or paper, with dies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "die cutting"@en .

aat:300233400 a skos:Concept ;
    skos:definition "The technique of making an exact facsimile of a model, sometimes a wax model but often an actual article of which reproductions are sought, by depositing a thin layer of a metal, such as copper or silver, by means of an electric current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroforming"@en .

aat:300233401 a skos:Concept ;
    skos:definition "The technique of engraving and decorating metal with an overall pattern of continuous, encircling, and contiguous narrow grooves, usually of a wavy character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engine turning"@en .

aat:300233402 a skos:Concept ;
    skos:definition "A type of chasing done to decorate a flat surface rather than to develop relief decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat chasing"@en .

aat:300233403 a skos:Concept ;
    skos:definition "A process of plating copper, also sometimes brass or iron, with silver leaf, as used by French platers from the early 18th century, and later by English platers, to repair imperfectly plated copper pieces or to refinish exposed copper on worn pieces. Similar to \"close plating\" but costlier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French plating"@en .

aat:300233404 a skos:Concept ;
    skos:definition "The process of creating a nonglossy finish by exposing annealed glass to acid fumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frosting"@en .

aat:300233405 a skos:Concept ;
    skos:definition "Producing indented marks or decorations on a surface by pressing with a shaped tool; used especially with reference to decorations created by pressing a shaped metal or wooden stamp or a coggle wheel into soft clay before firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impressing"@en .

aat:300233406 a skos:Concept ;
    skos:definition "The process of heating pieces or rods of manufactured glass over an open flame, then shaping them by blowing or tooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lampworking"@en .

aat:300233407 a skos:Concept ;
    skos:definition "A technique of laminating different colored metals and alloys together to produce a decorative effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mokume"@en .

aat:300233408 a skos:Concept ;
    skos:definition "The blowing and shaping of glass without the use of a mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "off-hand process"@en .

aat:300233409 a skos:Concept ;
    skos:definition "Use when only some areas of or ornaments on an object have been gilded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parcel gilding"@en .

aat:300233411 a skos:Concept ;
    skos:definition "Removing a substance from the surface of a liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skimming"@en .

aat:300233412 a skos:Concept ;
    skos:definition "Casting, as a hollow metal shape, by a process in which metal is poured into a metallic mold and immediately poured out leaving a thin solidified layer of the metal on the walls of the mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slush casting"@en .

aat:300233413 a skos:Concept ;
    skos:definition "The process of applying color or a glaze with a sponge to create a mottled effect; may be applied randomly or in a pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponging"@en .

aat:300233414 a skos:Concept ;
    skos:definition "Vessels, usually old warships or cargo vessels, converted for use as stationary work platforms, for accommodation, or for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hulks"@en .

aat:300233415 a skos:Concept ;
    skos:definition "Threads or strands applied to an object as decoration, used especially with reference to glass threads used principally to decorate the necks, stems, and rims of drinking glasses and other objects. Threading is distinguished from \"trailings\" in that threading creates an independent, partially free-standing, decoration attached to the vessel, whereas trailings are simple lines of decoration on the surface of the glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "threading"@en .

aat:300233419 a skos:Concept ;
    skos:definition "Mixture of the unmelted raw materials, such as sand and cullet, properly proportioned and ready for fusion into glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batch"@en .

aat:300233421 a skos:Concept ;
    skos:definition "A type of mold-blown glass blown in full-size molds that usually consist of three parts, but occasionally the term is used to describe glassware made in two-, four-, or five-part molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blown three-mold glass"@en .

aat:300233422 a skos:Concept ;
    skos:definition "An oxide of cobalt used chiefly in coloring glass and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt oxide"@en .

aat:300233425 a skos:Concept ;
    skos:definition "Refers to glass blown and shaped with a blowpipe and hand tools and without the use of a mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free-blown glass"@en .

aat:300233427 a skos:Concept ;
    skos:definition "Potters' term for pottery in a stage of the creation process where it has not yet been fired. For unfired clay as a medium that is not intended to be fired, use \"unfired clay.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenware"@en .

aat:300233429 a skos:Concept ;
    skos:definition "Collectors' term used to describe pressed glass with a stippled background and usually a scroll-and-flower design; made from the mid-1820s to the mid-1840s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacy glass"@en .

aat:300233430 a skos:Concept ;
    skos:definition "Transparent glaze containing lead oxide as flux."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead glaze"@en .

aat:300233434 a skos:Concept ;
    skos:definition "Mass-produced three-island vessels of 10,500 deadweight tons built to a specific design in the United States during the Second World War to carry general cargo and military supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liberty ships"@en .

aat:300233436 a skos:Concept ;
    skos:definition "Opaque glaze containing an oxide of tin or tin ashes and of a white color, unless other color has been added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin glaze"@en .

aat:300233437 a skos:Concept ;
    skos:definition "Term generally applied to ceramic products that are usually but not necessarily white, and which consist typically of clays, feldspar, potters' flint, and whiting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiteware"@en .

aat:300233438 a skos:Concept ;
    skos:definition "Earthenware dipped in a yellow glaze so that the surface, inside and outside, is entirely yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellowware"@en .

aat:300233439 a skos:Concept ;
    skos:definition "Implements comprising wheels, usually of metal or wood, having a decorative or fluted edge and mounted on a handle, used to impress decorative edges or designs in a soft surface, such as dough or clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coggles"@en .

aat:300233440 a skos:Concept ;
    skos:definition "Devices that shape materials by forcing them through a specially designed opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extruders"@en .

aat:300233443 a skos:Concept ;
    skos:definition "Cuplike devices with a quill spout through which slip is poured to produce trailed decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slip cups"@en .

aat:300233444 a skos:Concept ;
    skos:definition "Spring tools used instead of a pontil rod to hold a glass object during the finishing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snap cases"@en .

aat:300233445 a skos:Concept ;
    skos:definition "Marks on base metals, silver plate, and American silver in imitation of hallmarks; pseudohallmarks are not required by law and do not always have the same significance as true hallmarks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudohallmarks"@en .

aat:300233447 a skos:Concept ;
    skos:definition "Large, ancient Roman merchant vessels of the western Mediterranean having a curved sternpost, but a projecting, ramlike cutwater at the bow; such vessels tended to be longer and narrower than \"corbitae,\" the other major Roman merchant type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pontones"@en .

aat:300233466 a skos:Concept ;
    skos:definition "Cargo vessels or warships of the Middle Ages through the 16th century usually having a curved stem, straight sternpost after about 1200, clinker planking, and castles at the bow and stern; earlier vessels were relatively small, but 15th- and 16th-century examples could exceed 500 tons deadweight capacity; originally developed in northern Europe, but were eventually widespread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hulks"@en .

aat:300233468 a skos:Concept ;
    skos:definition "Boxes or cases made of refractory baked clay in which finer ceramic wares are enclosed and protected during firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saggers"@en .

aat:300233469 a skos:Concept ;
    skos:definition "Perforated metal plates through which clay is forced to mold it into a desired shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dods"@en .

aat:300233470 a skos:Concept ;
    skos:definition "Small German 19th to early 20th century porcelain ornaments, either of figures or in the form of a small box, usually depicting indelicate subjects and mass-produced for sale at fairs, bazaars, seaside stalls, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fairings"@en .

aat:300233471 a skos:Concept ;
    skos:definition "A type of fine, white porcellaneous stoneware, hard and compact, and sometimes slightly translucent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone china"@en .

aat:300233472 a skos:Concept ;
    skos:definition "Refers to earthenware covered with a transparent lead glaze in imitation of English creamware. The term is a misnomer because the ware is not faience, given that it is not tin-glazed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faïence fine"@en .

aat:300233473 a skos:Concept ;
    skos:definition "Material comprising hard paste porcelain modified by the addition of bone ash to the usual clay and feldspathic rock. It is characterized by being bright white in color. A patent was first taken out in the 1740s by Thomas Fry at Bow for the use of bone ash in china ware, but bone china in its present form was first introduced by Spode in 1796. Softer than hard-paste porcelain, more durable and economical than soft-paste, it became the standard English porcelain body in the 19th century and is still used today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone china"@en .

aat:300233474 a skos:Concept ;
    skos:definition "The process of rolling and shaping a gather of molten glass on a marver in order to make it symmetrical, to center it on the blowpipe or pontil, or to imbed applied threads into the surface as decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marvering"@en .

aat:300233475 a skos:Concept ;
    skos:definition "The state of the body of pottery and porcelain after it has partially hardened in consequence of the evaporation of the moisture content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leather-hard"@en .

aat:300233561 a skos:Concept ;
    skos:definition "Ship-rigged warships of the 17th through early 19th century, carrying many heavy cannon and intended to fight in a line-of-battle formation; in the Royal Navy, ships of the line were those warships carrying more than a minimum number of guns, rising from 30 in the 1650s to 80 in the 1840s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ships of the line"@en .

aat:300233609 a skos:Concept ;
    skos:definition "Describes apparatuses or tools used for preparing a printing plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing surface preparation equipment"@en .

aat:300233610 a skos:Concept ;
    skos:definition "Resources or machinery used for arranging characters comprised of alphabets, numerals, and other symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type composition equipment"@en .

aat:300233611 a skos:Concept ;
    skos:definition "Describes tools used for preparing a printing plate, including engraving, cleaning, and inking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing surface preparation tools"@en .

aat:300233612 a skos:Concept ;
    skos:definition "Describes apparatuses or tools used to produce an image transfer print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image transfer equipment"@en .

aat:300233613 a skos:Concept ;
    skos:definition "Metal frame used to hold and secure matter for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chases"@en .

aat:300233616 a skos:Concept ;
    skos:definition "Instruments or devices used to produce screen prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen printing equipment"@en .

aat:300233617 a skos:Concept ;
    skos:definition "Parts or components of printing presses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing press components"@en .

aat:300233619 a skos:Concept ;
    skos:definition "Describes tools that directly cause or facilitate the transfer of an image, such as to pull pigment through a screen or to form an impression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image transfer tools"@en .

aat:300233620 a skos:Concept ;
    skos:definition "Oblong trays with upright sides to hold set type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleys"@en .

aat:300233623 a skos:Concept ;
    skos:definition "Refers to any of numerous machines used to set type, beginning with those of the early and mid-19th century, and including those for strike-on composition as well as electronic and photographic devices and systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composing machines"@en .

aat:300233628 a skos:Concept ;
    skos:definition "Railroad trains consisting of passenger cars, primarily hauling passengers but may include cars for associated nonfreight items, such as baggage, mail, or express."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passenger trains"@en .

aat:300233629 a skos:Concept ;
    skos:definition "The rectangular pieces, usually metal, having on one side a letter or other character, from which text is composed and set to be printed. For sets of printed characters that share certain characteristics of style or design, use \"typefaces.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type"@en .

aat:300233630 a skos:Concept ;
    skos:definition "Type cast in relatively hard metal by type founders and sold to compositors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundry type"@en .

aat:300233631 a skos:Concept ;
    skos:definition "Hand-held trays in which type is assembled before transfer to the larger galley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composing sticks"@en .

aat:300233632 a skos:Concept ;
    skos:definition "Machines for composing type that do not employ hot-metal casting at the time of composition. Includes those that assemble foundry type mechanically and those that do strike-on composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold-metal machines"@en .

aat:300233633 a skos:Concept ;
    skos:definition "Those machines that cast type for printing as the matter is being composed, either by individual characters, such as Monotype (TM) machines, or by one-line slugs, such as Linotype (TM) machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-metal machines"@en .

aat:300233634 a skos:Concept ;
    skos:definition "Machines for strike-on composition of type that are essentially typewriters, sometimes with limited memory capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriter composing machines"@en .

aat:300233635 a skos:Concept ;
    skos:definition "Those composing machines that produce a hot-metal slug for each line of type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linecasting machines"@en .

aat:300233636 a skos:Concept ;
    skos:definition "High-speed passenger trains used on some routes in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullet trains"@en .

aat:300233641 a skos:Concept ;
    skos:definition "Persian flat-woven rugs of blue and white cotton used as inexpensive floor coverings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zilus"@en .

aat:300233649 a skos:Concept ;
    skos:definition "The composition of type in which characters are assembled and adjusted by hand, without machine assistance. Some photographically produced display type can be composed by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand composition"@en .

aat:300233650 a skos:Concept ;
    skos:definition "Generally, methods of character assembly for printing that employ a computer. Can be directed toward exposure of the characters on photosensitive film or paper, or output from a computer printer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computerized composition"@en .

aat:300233651 a skos:Concept ;
    skos:definition "Methods of type composition in which type is set by mechanical or electronic means, as opposed to by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine composition"@en .

aat:300233652 a skos:Concept ;
    skos:definition "Method of mechanical type composition in which type is cast as single full lines, each as one slug."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linecasting"@en .

aat:300233653 a skos:Concept ;
    skos:definition "Machine composition where type is cast from molten metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-metal composition"@en .

aat:300233654 a skos:Concept ;
    skos:definition "A term originating in the mid-20th century, originally to distinguish strike-on composition of type from hot-metal methods; later extended to include photographic methods. Use another term when possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold composition"@en .

aat:300233655 a skos:Concept ;
    skos:definition "Methods of composing type in which characters are set by direct impression, as with typewriter composing machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strike-on composition"@en .

aat:300233656 a skos:Concept ;
    skos:definition "Category of sciences that deal with beings, objects, energy, and processes observable in nature, and with objectively measurable phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural sciences"@en .

aat:300233660 a skos:Concept ;
    skos:definition "Philosophical theory that recognizes more than one ultimate reality or value, each capable of rational support and all appropriately included as options for individual choice. For the cultural movement promoting the full participation of diverse ethnic, racial, religious, or social groups within the larger community, use \"multiculturalism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pluralism"@en .

aat:300233662 a skos:Concept ;
    skos:definition "Cultural movement promoting the existence and full participation of a number of diverse ethnic, racial, religious, or social groups within the larger community. For the condition in which multiple cultures co-exist, use \"cultural pluralism.\" For the philosophical theory recognizing more than one ultimate reality or value, use \"pluralism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiculturalism"@en .

aat:300233668 a skos:Concept ;
    skos:definition "Typographical ornaments having a hole in the center in which an initial letter is printed; common in early printed books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factotum initials"@en .

aat:300233676 a skos:Concept ;
    skos:definition "The spread of cultural traits and institutions from one human community, society, or generation to another via contact and interaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural diffusion"@en .

aat:300233686 a skos:Concept ;
    skos:definition "General category of social issues perceived as directly concerning or strongly affected by societies' defined sex roles and the pattern of social relationships between genders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gender issues"@en .

aat:300233692 a skos:Concept ;
    skos:definition "In Medieval manuscripts and early printed books, small letters placed in spaces left blank for initials, to guide the illuminator or rubricator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guide letters"@en .

aat:300233712 a skos:Concept ;
    skos:definition "Passenger train cars in which travelers' luggage is carried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baggage cars"@en .

aat:300233713 a skos:Concept ;
    skos:definition "Railroad freight cars, usually flatcars or gondola cars, equipped to transport one or more standardized removable containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "container cars"@en .

aat:300233714 a skos:Concept ;
    skos:definition "Hopper cars with a permanent roof, roof hatches, and bottom openings for unloading bulk commodities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covered hopper cars"@en .

aat:300233715 a skos:Concept ;
    skos:definition "Flatcars having a portion of the floor set lower than the deck to accommodate special loads with oversized vertical dimensions; in use since the early 20th century. For flatcars in use since the mid-20th century with larger depressed central sections designed primarily to accommodate intermodal containers, use \"well cars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depressed center flatcars"@en .

aat:300233718 a skos:Concept ;
    skos:definition "Railroad passenger cars constructed with raised areas in the center of the car with a transparent roof for passenger observation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dome cars"@en .

aat:300233719 a skos:Concept ;
    skos:definition "Railroad passenger cars with seating areas on two levels, the upper of which may or may not extend the full length of the car."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bi-level cars"@en .

aat:300233720 a skos:Concept ;
    skos:definition "Railroad cars, usually those employed for track maintenance and right of way inspection, that do not generate income."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonrevenue cars"@en .

aat:300233721 a skos:Concept ;
    skos:definition "Any of various railroad cars used for inspecting track and right of way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inspection cars"@en .

aat:300233725 a skos:Concept ;
    skos:definition "Large, sturdy easels for use in artists' studios."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studio easels"@en .

aat:300233726 a skos:Concept ;
    skos:definition "Any of variously constructed small easels designed for use on a table, altar, desk, workbench, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table easels"@en .

aat:300233741 a skos:Concept ;
    skos:definition "Flatcars with large depressed central sections designed primarily to accommodate intermodal containers; used since the mid-20th century. For flatcars with smaller depressed central portions for oversized loads, in use since the early 20th century, use \"depressed center flatcars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "well cars"@en .

aat:300233842 a skos:Concept ;
    skos:definition "Inserting an extra space between words, usually in order to justify a line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wordspacing"@en .

aat:300233843 a skos:Concept ;
    skos:definition "Structural and decorative elements at the bottoms of columns upon which the columns are supported. Column bases may aggregate plinths, sub-plinths, and column mouldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "column bases"@en .

aat:300233844 a skos:Concept ;
    skos:definition "Parts or components of visual works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual works components"@en .

aat:300233846 a skos:Concept ;
    skos:definition "Vehicles capable of flight both within and outside the sensible atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerospace vehicles"@en .

aat:300233854 a skos:Concept ;
    skos:definition "Contemporary term for multiweapon bombers carrying non-nuclear payloads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attack aircraft"@en .

aat:300233876 a skos:Concept ;
    skos:definition "Light aircraft used for business, usually seating fewer than ten passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business aircraft"@en .

aat:300233884 a skos:Concept ;
    skos:definition "Aircraft used on the job as part of the job's required working equipment, as for forestry, agriculture, or ambulance service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility aircraft"@en .

aat:300233885 a skos:Concept ;
    skos:definition "Light aircraft specially equipped for agricultural applications, such as crop dusting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural aircraft"@en .

aat:300233886 a skos:Concept ;
    skos:definition "Spacecraft occupied by and capable of sustaining one or more persons, who normally have control over the vehicle's movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manned spacecraft"@en .

aat:300233887 a skos:Concept ;
    skos:definition "Balloons used to carry meteorological instruments, especially radiosondes, aloft; for balloons carrying self-registering instruments aloft for general atmospheric research, use \"sounding balloons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorological balloons"@en .

aat:300233895 a skos:Concept ;
    skos:definition "The manufacture of metal printing type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typefounding"@en .

aat:300233901 a skos:Concept ;
    skos:definition "Small free balloons carrying self-registering instruments aloft to record and transmit measurements for atmospheric research; for balloons carrying aloft instruments for recording weather-related data, use \"meteorological balloons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sounding balloons"@en .

aat:300233907 a skos:Concept ;
    skos:definition "Use generally for manned orbiting space probes and specifically for the portion of space shuttles containing the crew and payload."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orbiters"@en .

aat:300233909 a skos:Concept ;
    skos:definition "Tactical fighter planes of the era from the First World War to the Second World War designed for speed and maneuverability during air battles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pursuit planes"@en .

aat:300233910 a skos:Concept ;
    skos:definition "Bombers for large-scale missions carrying conventional or nuclear weapons used generally in the protection of national policy interests or specifically to attack and destroy enemy industry, economic bases, and civilian population centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strategic bombers"@en .

aat:300233911 a skos:Concept ;
    skos:definition "Refers to terminal elements on which objects rest and that are small in relation to the body of the object. For relatively massive elements at the bottoms of structures or objects upon which the upper parts are supported, use \"bases (components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feet"@en .

aat:300233918 a skos:Concept ;
    skos:definition "The lower parts of a piece of furniture that serve to support it, usually projecting at the base or at the end of a leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture feet"@en .

aat:300233925 a skos:Concept ;
    skos:definition "Handles on tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tool handles"@en .

aat:300233926 a skos:Concept ;
    skos:definition "Handles comprising hardware applied to finished products and often decorative as well as functional; particularly, but not exclusively, on furniture or cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardware handles"@en .

aat:300233927 a skos:Concept ;
    skos:definition "Knobs comprising hardware applied to finished products and often decorative as well as functional; particularly, but not exclusively, on furniture or cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardware knobs"@en .

aat:300233928 a skos:Concept ;
    skos:definition "Aircraft whose wings are so designed that they can be moved backward or forward in flight to optimize aerodynamic performance at widely differing speeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable-sweep aircraft"@en .

aat:300233940 a skos:Concept ;
    skos:definition "Fixed-wing aircraft capable of taking off and landing vertically and cruising at forward speeds comparable to conventional aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical take-off and landing aircraft"@en .

aat:300233943 a skos:Concept ;
    skos:definition "Vertical take-off and landing aircraft whose engine pods or rotors tilt 90 degrees from a horizontal position for horizontal flight to a downward position for vertical flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilt-rotor aircraft"@en .

aat:300233949 a skos:Concept ;
    skos:definition "Jet aircraft in which additional propulsive thrust is gained by extending a portion of the compressor or turbine blades outside the inner engine cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turbofan aircraft"@en .

aat:300233951 a skos:Concept ;
    skos:definition "Jet aircraft with turbine-driven propellers that produce the principal thrust augmented by the thrust of the jet exhausts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turboprop aircraft"@en .

aat:300233955 a skos:Concept ;
    skos:definition "Aircraft designed or equipped to carry cargo or passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transport aircraft"@en .

aat:300233956 a skos:Concept ;
    skos:definition "Aircraft designed or equipped primarily to transport cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cargo aircraft"@en .

aat:300233965 a skos:Concept ;
    skos:definition "Aircraft in which the horizontal stabilizers used for trim and control are positioned forward of the main wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canards"@en .

aat:300233966 a skos:Concept ;
    skos:definition "Textiles, often of Baluch style, sewn in the form of a grain or storage bag, often used as a cushion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balisht"@en .

aat:300233975 a skos:Concept ;
    skos:definition "Objects taken as spoils in war or in hunting, or awarded as prizes for victory in contests; typically include such things as armor and weapons taken from an opponent in battle, stuffed and mounted skins, heads or other portions of a slain animal, and elaborate silver pieces awarded as contest prizes. Distinct from \"trophies (monuments)\", which are monuments erected as permanent reminders of military victories, usually containing images of the spoils of battle,."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trophies"@en .

aat:300233979 a skos:Concept ;
    skos:definition "Articles intended to be given as a gift or on a special occasion, usually inscribed with information regarding the giver, the recipient and/or the occasion; often articles of silver, or pottery, or coins or medals specially struck. For copies of books or other publications, including prints, similarly intended and inscribed, use \"presentation copies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation pieces"@en .

aat:300233988 a skos:Concept ;
    skos:definition "Fixed-wing aircraft weighing no more than 254 pounds empty and having a maximum speed of 63 mph, generally for one person; may or may not be motor powered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultralight aircraft"@en .

aat:300233989 a skos:Concept ;
    skos:definition "Fixed-wing aircraft with one set of main supporting surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monoplanes"@en .

aat:300233998 a skos:Concept ;
    skos:definition "Projecting rims, collars, or rings, providing added strength or a place to attach something, as for example on a pipe, on a machine housing, or on a container or its lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flanges"@en .

aat:300234003 a skos:Concept ;
    skos:definition "Various types of small flaps, loops, or other devices projecting from an object, usually to facilitate identification, grasping, or fastening or that serve as decorative elements on the edges of costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabs"@en .

aat:300234006 a skos:Concept ;
    skos:definition "Refers to small objects, of any shape or material, pierced so that they may be strung or hung or attached, as by sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beads"@en .

aat:300234011 a skos:Concept ;
    skos:definition "Works in any medium, typically of relatively small size, and usually but not always cut, engraved, or inscribed with prayers, astrological signs, or magical symbols, intended to heal or keep the bearer from harm. For talismans or other objects worn on the person, with or without inscriptions, use \"amulets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talismans"@en .

aat:300234012 a skos:Concept ;
    skos:definition "Aircraft designed or equipped to train pilots, general air service personnel, and flight crews in the operation of aircraft or related equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "training aircraft"@en .

aat:300234015 a skos:Concept ;
    skos:definition "Fighters designed and equipped to remove hostile aircraft from a given volume of airspace and so establish control of the air without prohibitive interference from enemy aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air superiority fighters"@en .

aat:300234016 a skos:Concept ;
    skos:definition "Articles made of silver, especially tableware of silver used in serving and consuming food and drink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silverware"@en .

aat:300234022 a skos:Concept ;
    skos:definition "Aircraft designed or equipped to carry primarily passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passenger aircraft"@en .

aat:300234023 a skos:Concept ;
    skos:definition "Passenger aircraft operated by commercial airline companies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airliners"@en .

aat:300234024 a skos:Concept ;
    skos:definition "Small passenger aircraft operating either on a scheduled or nonscheduled basis, along short routes normally not serviced by airliners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commuter aircraft"@en .

aat:300234026 a skos:Concept ;
    skos:definition "Balloons of nonextensible material, usually spherical or pear-shaped, open on the bottom and held aloft by the introduction of heated air; they are designed to rise and travel into the atmosphere. Hot-air balloons typically have a container, usually a basket large enough to carry people, suspended below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot-air balloons"@en .

aat:300234027 a skos:Concept ;
    skos:definition "Composing machines that project images of type characters onto photosensitive film or paper, producing camera ready copy from which a printing plate is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photocomposition machines"@en .

aat:300234036 a skos:Concept ;
    skos:definition "Refers to a type of work made of thread or cord that is knotted, twisted, or tied. It developed in the Mediterranean area, probably from fish net. It was popular in 16th-century Italy, where decorative fringes were created by knotting, twisting, and tying without weights or bobbins. Early patterns were geometric, sometimes interspersed with schematic figures. It is thought that bobbin, or pillow, lace developed from this process when the threads came to be attached with lead weights and the design anchored on a pad, or pillow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punto a groppo"@en .

aat:300234043 a skos:Concept ;
    skos:definition "Documents containing numerical determinations, such as of quantities, distances, or amounts of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calculations"@en .

aat:300234049 a skos:Concept ;
    skos:definition "Parts or additional items, such as documents, separate from the main item but fastened to it in some way. The term is usually applied in the context of documents, but it may be used in other contexts as well. Examples are an appendix paperclipped to a main document, and a subsidiary electronic document linked to a primary document."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attachments"@en .

aat:300234056 a skos:Concept ;
    skos:definition "General aviation aircraft generally used for sport, recreation, or aerobatics and usually homebuilt, ultralight, or light aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private aircraft"@en .

aat:300234062 a skos:Concept ;
    skos:definition "Small, lightweight, low-cost, low-horsepower aircraft with a maximum take-off weight of 12,500 pounds; usually fixed-wing, single-pilot, privately owned aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light aircraft"@en .

aat:300234066 a skos:Concept ;
    skos:definition "Special purpose aircraft built for testing aerodynamic, avionic, structural, or propulsion systems or concepts before application to other aircraft designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research aircraft"@en .

aat:300234067 a skos:Concept ;
    skos:definition "Escapements, used especially in tower clocks, in which a constant impulse is given to the pendulum by a weight which is lifted and always falls through a constant distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravity escapements"@en .

aat:300234093 a skos:Concept ;
    skos:definition "Visually-based works created or used within religious contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious visual works"@en .

aat:300234098 a skos:Concept ;
    skos:definition "Broadly, objects associated with or used in public or private religious worship in any culture. For those specifically venerated, especially in an extinct culture or religion, see \"cult objects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious objects"@en .

aat:300234108 a skos:Concept ;
    skos:definition "Objects originating in any culture still living or known through relatively recent history when those objects are the concern of ethnographic or ethnological study. For objects from earlier periods found in contexts of archaeological research, prefer \"archaeological objects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnographic objects"@en .

aat:300234110 a skos:Concept ;
    skos:definition "Objects and other material culture found in contexts of archaeological research, typically reserved for those unearthed from periods before usually the 19th century and from extinct cultures. For objects originating in any culture still living or known through relatively recent history when those articles are the concern of ethnographic or ethnological study, prefer \"ethnographic objects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological objects"@en .

aat:300234117 a skos:Concept ;
    skos:definition "Refers broadly to articles associated with or used in the context of a ceremony, which includes formal acts conducted elaborately, solemnly, and as prescribed by the ritual or protocol of religious, state, court, social, or tribal procedure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial objects"@en .

aat:300234126 a skos:Concept ;
    skos:definition "Use broadly for objects associated with or used in funerary practices of any culture. Sometimes defined more narrowly as only those placed with individual human remains either at the time of death or later as part of a death rite or ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary objects"@en .

aat:300234130 a skos:Concept ;
    skos:definition "Use broadly for objects or types of objects about which people of the culture from which the objects originate have concerns about the objects' present and future use, care, and possession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culturally sensitive objects"@en .

aat:300234144 a skos:Concept ;
    skos:definition "Use broadly for articles associated with or used in private religious devotions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional objects"@en .

aat:300234147 a skos:Concept ;
    skos:definition "Refers generally to objects associated with or used in the rituals of public worship, especially of the Christian religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical objects"@en .

aat:300234152 a skos:Concept ;
    skos:definition "Visual works or portions of works fashioned in silver, especially fine, decorative work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silverwork"@en .

aat:300234157 a skos:Concept ;
    skos:definition "Book edges that have been smoothly cut with a guillotine or plough, so that they are flush with each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut edges"@en .

aat:300234159 a skos:Concept ;
    skos:definition "The folded or doubled edges of paper at the head, fore edge, or tail of the sheets of an uncut book; usually intended to be cut open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolts"@en .

aat:300234190 a skos:Concept ;
    skos:definition "Broadly, ceremonial objects that retain their sacredness in their present context. Sometimes defined more narrowly as only those needed by a present-day culture to practice their religion. For objects that are used primarily for a religious ceremony or function, but are not necessarily in themselves considered sacred, use \"religious objects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacred objects"@en .

aat:300234278 a skos:Concept ;
    skos:definition "Blocks of wood on which designs, words, or other images are cut to print, usually as relief images, whether on paper, fabric, or other material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood blocks"@en .

aat:300234311 a skos:Concept ;
    skos:definition "Plates used for color printing, being the one plate for a given image that carries the most detail and serves as a guide to register the other plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key plates"@en .

aat:300234322 a skos:Concept ;
    skos:definition "Metal printing plates made by using a mold of another printing surface, such as a wood engraving or set type, and electroplating with copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrotypes"@en .

aat:300234332 a skos:Concept ;
    skos:definition "Metal printing plates made by taking a mold of set type and/or relief block(s), and making a cast in type metal. The type and pictorial images were sometimes stereotyped together into a single plate (i.e. one page of a book)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereotypes"@en .

aat:300234338 a skos:Concept ;
    skos:definition "Blocks of wood cut parallel with the grain and used for woodcut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plank-grain blocks"@en .

aat:300234388 a skos:Concept ;
    skos:definition "Sharp steel points mounted in holders used to scratch crayon or tusche drawings on the lithographic stone in order to create white-line effects in the print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographers' needles"@en .

aat:300234452 a skos:Concept ;
    skos:definition "Forms that embody or infer linear elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear forms"@en .

aat:300234578 a skos:Concept ;
    skos:definition "Treating unhaired hides or skins with a solution of pigeon or hen manure in order to remove undesirable constituents and impart a quality of softness and flexibility to the final leather. For a similar process using dog manure, use \"puering.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bating"@en .

aat:300234581 a skos:Concept ;
    skos:definition "The removal, by chemical or mechanical means, of epidermal structures such as hair from flayed skin or hide; also serves to loosen and expand dermal fiber network and alters the swelling characteristics of the hide or skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depilation"@en .

aat:300234585 a skos:Concept ;
    skos:definition "The cleaning and leveling of the flesh side of hides and skins by the removal of inner membranes such as hypodermal and muscle tissue in preparation for further processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fleshing"@en .

aat:300234588 a skos:Concept ;
    skos:definition "Soaking freshly flayed hides and skins in alkaline solutions to remove lanolin and loosen epidermal structures in preparation for depilation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liming"@en .

aat:300234590 a skos:Concept ;
    skos:definition "The process of removing traces of hair debris, dirt, grease, and lime compounds from hide or skin after depilation and fleshing and before tanning. Traditionally done by hand with a curved, blunt-edged knife upon the skin or hide laid over a beam, today it is usually done by machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scudding"@en .

aat:300234596 a skos:Concept ;
    skos:definition "Devices that cause explosions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "explosive equipment"@en .

aat:300234598 a skos:Concept ;
    skos:definition "Treating hides or skins with alum to produce a material with the properties of leather as long as the alum is present; differentiated from \"tanning\" because the process is reversible by washing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tawing"@en .

aat:300234611 a skos:Concept ;
    skos:definition "Sovereign states consisting of a city and its contiguous dependent territories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city-states"@en .

aat:300234626 a skos:Concept ;
    skos:definition "Presses in which the type or the plates are held on a horizontal or vertical plane, and ink rollers and sheets of paper, carried by a cylinder, alternately pass over them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder presses"@en .

aat:300234633 a skos:Concept ;
    skos:definition "Cylinder presses in which the printing surface lies horizontally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-bed cylinder presses"@en .

aat:300234646 a skos:Concept ;
    skos:definition "Printing presses requiring hand operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand presses"@en .

aat:300234651 a skos:Concept ;
    skos:definition "Presses in which the printing plates are curved around a cylinder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotary presses"@en .

aat:300234656 a skos:Concept ;
    skos:definition "Printing presses into which paper is fed in a continuous roll."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web presses"@en .

aat:300234665 a skos:Concept ;
    skos:definition "The flat component of a platen press that brings the paper to the inked surface and presses them together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platens"@en .

aat:300234667 a skos:Concept ;
    skos:definition "The making of flat pieces of metal from which textual or pictorial images are printed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platemaking"@en .

aat:300234668 a skos:Concept ;
    skos:definition "The process of making printing plates by using a mold of another printing surface, such as a wood engraving or set type, and electroplating with copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrotyping"@en .

aat:300234669 a skos:Concept ;
    skos:definition "The process of making printing plates by taking a mold of set type and making a cast in type metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereotyping"@en .

aat:300234682 a skos:Concept ;
    skos:definition "Printing presses in which both the paper and the printing surface lie flat and come into direct contact with each other by closing and opening like a clamshell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platen presses"@en .

aat:300234707 a skos:Concept ;
    skos:definition "The part of a printing press on which the plate or block rests during printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press beds"@en .

aat:300234719 a skos:Concept ;
    skos:definition "Rectangles of piano felt or foam rubber used between the paper and the roller on a rolling press."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blankets"@en .

aat:300234750 a skos:Concept ;
    skos:definition "Engine-powered launches with high glass-sided cabins, which provide easy standing headroom and may be three feet or more higher than the basic hull."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabin launches"@en .

aat:300234769 a skos:Concept ;
    skos:definition "Small half-decked skipjacks in the 24- to 30-foot range, from the lower eastern shore of Chesapeake Bay; may also be used for recent motorized versions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crab scrapers"@en .

aat:300234798 a skos:Concept ;
    skos:definition "Method for bookbinding in which the entire text block is fastened together as a single unit by passing the fastening agent, usually wire staples, through the text block from front to back near the folds of the gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side stitching"@en .

aat:300234836 a skos:Concept ;
    skos:definition "A very strong method of sewing leaves or sections of books using stabbing and side sewing in which the sewing proceeds from one hole (often the center) to the next, then over the head and the tail of the spine. The sewing can also include sewing through the holes and around the back of the book. When complete, the leaves or sections are tied together with a flat knot on the outside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese sewing"@en .

aat:300234892 a skos:Concept ;
    skos:definition "Various styles and methods of binding performed for libraries utilizing machine or hand methods, or a combination, and executed to provide optimum durability. Included are the first-time hardcover binding of loose periodical issues, case binding of paperbound publications, the rebinding or repair of older volumes, and the prebinding of new publications specifically for high-volume circulation by public libraries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "library binding"@en .

aat:300234894 a skos:Concept ;
    skos:definition "The binding of identical books in quantity, using high-speed automatic equipment, usually for a publisher or distributor and usually case binding in hard covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edition binding"@en .

aat:300234900 a skos:Concept ;
    skos:definition "The process of securing the text block and attached endpapers into a case that was produced as a separate operation. For the process of attaching individual boards to the text block and end papers, if any, use \"board attachment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casing-in"@en .

aat:300234911 a skos:Concept ;
    skos:definition "Engraving tools powered by electricity, in contrast to engraving done by a hand-held burin. In the field of art, such tools are typically designed for and used for printmaking or metalworking; however, similar tools are used in other disciplines, such as dentistry, medicine, and archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric engravers"@en .

aat:300234922 a skos:Concept ;
    skos:definition "Engraving tool shaped like a club with sharp points projecting from the head, set in a long, round wood handle. Used to produce marks similar to chalk lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mattoirs"@en .

aat:300234927 a skos:Concept ;
    skos:definition "Very sensitive brayers for giving a smooth distribution of ink, having a surface of gelatin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin brayers"@en .

aat:300234936 a skos:Concept ;
    skos:definition "Engraving tools used in creating plates for printmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printmaking gravers"@en .

aat:300234937 a skos:Concept ;
    skos:definition "Various tools for making fine, delicate engraved lines, as to create a tonal area in intaglio or wood engraving techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tint tools"@en .

aat:300234942 a skos:Concept ;
    skos:definition "Fine-point tool used especially in wood engraving for making curved lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spitstickers"@en .

aat:300234948 a skos:Concept ;
    skos:definition "Tools constructed so as to allow a single motion to inscribe multiple lines at once, usually parallel lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiple gravers"@en .

aat:300234964 a skos:Concept ;
    skos:definition "Professional soldiers hired into service in a foreign or private armed force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercenaries"@en .

aat:300234981 a skos:Concept ;
    skos:definition "People who play keyboard instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keyboard instrumentalists"@en .

aat:300234983 a skos:Concept ;
    skos:definition "People who play stringed instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stringed instrumentalists"@en .

aat:300234984 a skos:Concept ;
    skos:definition "People who play wind instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind instrumentalists"@en .

aat:300234986 a skos:Concept ;
    skos:definition "Those who play on bagpipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bagpipers"@en .

aat:300234992 a skos:Concept ;
    skos:definition "Covering or enclosing entirely or to a great extent with a flexible material, especially by winding or folding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrapping"@en .

aat:300234996 a skos:Concept ;
    skos:definition "Bronze Age Aegean vessels generally made in a flat, open dishlike form with incising on one side. Their use is uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frying pans"@en .

aat:300235013 a skos:Concept ;
    skos:definition "Drains of perforated pipe covered with gravel or trenches filled with loose stones, fragments of brick, or gravel and covered with earth; often used for drainage around foundations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French drains"@en .

aat:300235014 a skos:Concept ;
    skos:definition "Those who play the harpsichord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harpsichordists"@en .

aat:300235015 a skos:Concept ;
    skos:definition "Those who play the organ, especially those engaged to play the organ at the services in a church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organists"@en .

aat:300235018 a skos:Concept ;
    skos:definition "Those who play the piano."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pianists"@en .

aat:300235019 a skos:Concept ;
    skos:definition "Those who play the banjo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banjoists"@en .

aat:300235020 a skos:Concept ;
    skos:definition "Intensive care units designed for newborn infants under the age of one month."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neonatal intensive care units"@en .

aat:300235030 a skos:Concept ;
    skos:definition "Technique using beamed, reflected, and timed radio waves for determining the distance to and direction of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radar"@en .

aat:300235037 a skos:Concept ;
    skos:definition "Specifically, those who play the double bass.Also refers generally for those who play bass instruments of any kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bassists"@en .

aat:300235042 a skos:Concept ;
    skos:definition "Those who play the guitar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guitarists"@en .

aat:300235043 a skos:Concept ;
    skos:definition "Those who play the lute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lutenists"@en .

aat:300235044 a skos:Concept ;
    skos:definition "Those who play the violin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violinists"@en .

aat:300235045 a skos:Concept ;
    skos:definition "Refers to both those who play the viola and those who play the viol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violists"@en .

aat:300235047 a skos:Concept ;
    skos:definition "Those who play the violoncello."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "violoncellists"@en .

aat:300235048 a skos:Concept ;
    skos:definition "Those who play the bugle, including those who use it to sound signals, as in an army."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buglers"@en .

aat:300235049 a skos:Concept ;
    skos:definition "Industrial parks whose facilities are devoted primarily to research and development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research parks"@en .

aat:300235053 a skos:Concept ;
    skos:definition "Those who play the flute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flutists"@en .

aat:300235057 a skos:Concept ;
    skos:definition "Those who play the harp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harpists"@en .

aat:300235059 a skos:Concept ;
    skos:definition "Enclosed chambers with gates at each end connecting higher and lower sections of artificial waterways for transferring watercraft from one level to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locks"@en .

aat:300235062 a skos:Concept ;
    skos:definition "Those who play the oboe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oboists"@en .

aat:300235064 a skos:Concept ;
    skos:definition "Those who play the trumpet, including those who use it to sound signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trumpeters"@en .

aat:300235068 a skos:Concept ;
    skos:definition "Those who play percussion instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percussionists"@en .

aat:300235069 a skos:Concept ;
    skos:definition "Those who play the drum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drummers"@en .

aat:300235070 a skos:Concept ;
    skos:definition "Those who play the kettledrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kettledrummers"@en .

aat:300235071 a skos:Concept ;
    skos:definition "Those who play the timpani in a Western orchestra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timpanists"@en .

aat:300235073 a skos:Concept ;
    skos:definition "Stencils used in screen printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screen printing stencils"@en .

aat:300235074 a skos:Concept ;
    skos:definition "Stencils cut from sheets of stencil film to be used for blocking out nonprinting areas in screen printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film stencils"@en .

aat:300235076 a skos:Concept ;
    skos:definition "Those who play games or musical instruments. For those who portray roles in dramatic productions, use \"actors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "players"@en .

aat:300235077 a skos:Concept ;
    skos:definition "Grease pencils made especially for lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic pencils"@en .

aat:300235087 a skos:Concept ;
    skos:definition "Administrative bodies subject to an archduke or archduchess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archduchies"@en .

aat:300235088 a skos:Concept ;
    skos:definition "Administrative bodies subject to a duke or duchess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duchies"@en .

aat:300235092 a skos:Concept ;
    skos:definition "The states or dominions of German prince-electors, who were the princes who voted for the Holy Roman Emperor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electorates"@en .

aat:300235093 a skos:Concept ;
    skos:definition "The constituent political and administrative divisions of the modern nation of Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governorates"@en .

aat:300235094 a skos:Concept ;
    skos:definition "Administrative bodies under the authority of an intendant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intendancies"@en .

aat:300235095 a skos:Concept ;
    skos:definition "Administrative bodies subject to a khan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khanates"@en .

aat:300235096 a skos:Concept ;
    skos:definition "Administrative bodies subject to a king or queen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kingdoms"@en .

aat:300235097 a skos:Concept ;
    skos:definition "In Germany and Scandinavia, administrative bodies subject to a landgrave, first created in the 12th century and existing into the 20th."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landgraviates"@en .

aat:300235098 a skos:Concept ;
    skos:definition "Administrative bodies subject to a margrave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "margraviates"@en .

aat:300235099 a skos:Concept ;
    skos:definition "Administrative bodies under the authority of a prefect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prefectures"@en .

aat:300235100 a skos:Concept ;
    skos:definition "Territories or administrative bodies subject to a palatine or count palatine, serving as secondary seats of power for the Holy Roman Emperor in the Early and High Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palatinates"@en .

aat:300235101 a skos:Concept ;
    skos:definition "Administrative bodies subject to a prince or princess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "principalities"@en .

aat:300235102 a skos:Concept ;
    skos:definition "Administrative bodies subject to a satrap, being divisions of ancient Persia under the Achaemenian Empire and later administrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satrapies"@en .

aat:300235104 a skos:Concept ;
    skos:definition "Administrative bodies in the Islamic Middle East, often subject to an emir, or, as in the United Arab Emirates, a sheikh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emirates"@en .

aat:300235105 a skos:Concept ;
    skos:definition "Administrative bodies in the Arab world subject to a sheikh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheikhdoms"@en .

aat:300235106 a skos:Concept ;
    skos:definition "Administrative bodies subject to a sultan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sultanates"@en .

aat:300235107 a skos:Concept ;
    skos:definition "Provinces or regions within Russia. Also used for administrative divisions within republics of the former Soviet Union."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblasts"@en .

aat:300235112 a skos:Concept ;
    skos:definition "Administrative bodies subject to a voivode, including semi-independent districts or provinces of Eastern European countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voivodeships"@en .

aat:300235113 a skos:Concept ;
    skos:definition "The constituent political and administrative divisions of the modern federal nation of Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Länder"@en .

aat:300235114 a skos:Concept ;
    skos:definition "Territories or other administrative bodies that are subject to the control of another nation, while yet remaining outside the official boundaries of that nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dependencies"@en .

aat:300235115 a skos:Concept ;
    skos:definition "Areas outside the boundaries of sovereign states in which they have settled communities of their own people and which remain subject to or closely connected with the parent state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonies"@en .

aat:300235116 a skos:Concept ;
    skos:definition "Politically dependent territories administered jointly by two or more foreign powers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condominiums"@en .

aat:300235117 a skos:Concept ;
    skos:definition "Colonies and other possessions in Africa and Asia of the defeated powers of the First World War, which were placed under the control of various different victor nations by the League of Nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandates"@en .

aat:300235118 a skos:Concept ;
    skos:definition "Areas outside the official boundaries of a sovereign nation but which are subject to and considered as the property of that nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "possessions"@en .

aat:300235119 a skos:Concept ;
    skos:definition "Dependent communities, nations, or territories, which, by international treaty, are placed under the protection or domination of a foreign power or group of powers, typically entailing loss of control over such matters as defense and foreign relations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protectorates"@en .

aat:300235120 a skos:Concept ;
    skos:definition "Under the Charter of the United Nations, non-self-governing territories, primarily former mandates and colonies of the defeated powers of the Second World War, placed under the administrative authority of U.N. members and subject to regular inpection by U.N. missions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trust territories"@en .

aat:300235121 a skos:Concept ;
    skos:definition "Countries that pay tribute to a conquering or stronger foreign power in acknowledgment of submission or as the price of protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tributaries"@en .

aat:300235122 a skos:Concept ;
    skos:definition "Administrative bodies under the authority of a president."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presidencies"@en .

aat:300235124 a skos:Concept ;
    skos:definition "Those who have entered into an alliance with others, including both individuals and organizations such as sovereign states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allies"@en .

aat:300235430 a skos:Concept ;
    skos:definition "Items produced, issued, or worn to commemorate a person, event, or occasion. For structures erected to preserve the memory of persons or events, use \"memorials.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemoratives"@en .

aat:300235440 a skos:Concept ;
    skos:definition "Trimming, furnishing, adorning, or covering textiles or objects with beads, or creating jewelry by stringing beads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beading"@en .

aat:300235443 a skos:Concept ;
    skos:definition "Visual works in the shape of two intersecting bars, usually an upright one traversed by a horizontal one, especially those used as Christian symbols. For motifs consisting of two intersecting lines, with many variations in the shapes of the arms, use \"crosses (motifs).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses"@en .

aat:300235475 a skos:Concept ;
    skos:definition "Stonecarvers' chisels having a straight cutting edge used for finishing rough areas to make smooth surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat chisels"@en .

aat:300235479 a skos:Concept ;
    skos:definition "Cameras used to prepare images for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "process cameras"@en .

aat:300235489 a skos:Concept ;
    skos:definition "Stonecarving tools having a single point, for use especially on dense stone, sometimes at right angles to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punches"@en .

aat:300235496 a skos:Concept ;
    skos:definition "An alloy for making printing type, consisting chiefly of lead and antimony, and sometimes small quantities of other metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type metal"@en .

aat:300235501 a skos:Concept ;
    skos:definition "Etching needles ground to an oblique face to obtain swelling lines; first used by 17th-century artist Jacques Callot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "echoppes"@en .

aat:300235505 a skos:Concept ;
    skos:definition "Sets of two individual things of the same or similar type that are associated or complementary in use, purpose, or position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pairs"@en .

aat:300235507 a skos:Concept ;
    skos:definition "Refers to any of various hard, brittle, heat-resistant and corrosion-resistant materials made by shaping and then firing a nonmetallic mineral, such as clay, at a high temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramic"@en .

aat:300235510 a skos:Concept ;
    skos:definition "Any items that communicate information primarily visually and are collected and made available as information resources. For items that communicate information primarily visually and are used as teaching aids, use \"visual aids.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual resources"@en .

aat:300235514 a skos:Concept ;
    skos:definition "Any items that communicate information primarily visually and are used as aids in teaching. For items that communicate information primarily visually and are collected and made available as information resources, use \"visual resources.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual aids"@en .

aat:300235537 a skos:Concept ;
    skos:definition "Landed estates or groups of estates belonging to a military religious order of knights and placed under the charge of a member of the order, titled a commander."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commanderies"@en .

aat:300235540 a skos:Concept ;
    skos:definition "Administrative bodies subject to a count or countess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countships"@en .

aat:300235576 a skos:Concept ;
    skos:definition "A specimen is an individual instance that represents a class. A good specimen shows the character of the thing or material, useful for close study and permitting exact identification. For parts of anything presented as evidence of quality or composition, prefer \"specimens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specimens"@en .

aat:300235577 a skos:Concept ;
    skos:definition "Ships' boats smaller than launches or longboats, usually the second boat in size when a number of boats are carried; ranged from to 24 feet to 37 feet, but most commonly under 30 feet; equipped with small steam engines in late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinnaces"@en .

aat:300235579 a skos:Concept ;
    skos:definition "Clinker built ships' boats, usually 24 to 36 feet long, generally rowed double banked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutters"@en .

aat:300235580 a skos:Concept ;
    skos:definition "Small open boats used for carrying supplies and provisions to sell to ships lying in harbor; also employed to take garbage ashore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bumboats"@en .

aat:300235612 a skos:Concept ;
    skos:definition "Halftone screens consisting of a grid of fine lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-line screens"@en .

aat:300235615 a skos:Concept ;
    skos:definition "Halftone screens having a random, rather than a regular, pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metzograph screens"@en .

aat:300235631 a skos:Concept ;
    skos:definition "Technique of decorating a surface with a pattern consisting of small depressions produced by use of punches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punching"@en .

aat:300235641 a skos:Concept ;
    skos:definition "Material made in thin strong sheets that may be easily cut to form detailed stencils; used for screen printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stencil film"@en .

aat:300235660 a skos:Concept ;
    skos:definition "A firm cloth usually of silk woven in various mesh sizes for various uses such as bolting flour or for use in screen printing or needleworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolting cloth"@en .

aat:300235692 a skos:Concept ;
    skos:definition "Creative works that depict scenes having to do with ships, shipbuilding, or harbors. For creative works depicting the ocean or other large body of water where the water itself dominates the scene, use \"seascapes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marines"@en .

aat:300235701 a skos:Concept ;
    skos:definition "Concepts related to the the transmission and reception of information, including but not limited to science and technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communications concepts"@en .

aat:300235719 a skos:Concept ;
    skos:definition "Sheets of paper inserted between printed sheets as they are printed to prevent offsets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipsheets"@en .

aat:300235725 a skos:Concept ;
    skos:definition "Devices used to protect image areas of a printing plate or stone from contact with the hand during drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridges"@en .

aat:300235731 a skos:Concept ;
    skos:definition "Describes the physical parts or components of a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer equipment"@en .

aat:300235732 a skos:Concept ;
    skos:definition "Parts or components of computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer components"@en .

aat:300235744 a skos:Concept ;
    skos:definition "Any of various devices used to assure that successive printing plates or blocks for the same image are positioned accurately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "register guides"@en .

aat:300235748 a skos:Concept ;
    skos:definition "Nonimpact computer-controlled printing in which tiny droplets of ink are projected from nozzles onto paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkjet printing"@en .

aat:300235749 a skos:Concept ;
    skos:definition "The art or practice of writing in minute characters, common in illuminated manuscripts of Jewish texts and the Koran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micrography"@en .

aat:300235759 a skos:Concept ;
    skos:definition "Devices used for reading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading equipment"@en .

aat:300235760 a skos:Concept ;
    skos:definition "Devices put between the leaves of books to mark a place. Distinguished from \"registers (book components),\" which are attached to books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookmarks"@en .

aat:300235765 a skos:Concept ;
    skos:definition "French registers, usually made of silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signets"@en .

aat:300235800 a skos:Concept ;
    skos:definition "Computerized process of accentuating or exaggerating forms in an image, often used to clarify indistinct forms, as for example in photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer enhancement"@en .

aat:300235833 a skos:Concept ;
    skos:definition "Program-controlled devices that read data from or write data onto a magnetic tape which moves past a read-write head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape drives"@en .

aat:300235838 a skos:Concept ;
    skos:definition "Devices that, using an access mechanism under program control, enable data to be read from or written on a spinning magnetic disk, magnetic disk pack, floppy disk, or optical disk media. \"Disk drives\" may be used to refer to devices that use either fixed or removable media. To refer specifically to fixed, large-capacity magnetic disk drives used to store computer data, use \"hard drives.\" To refer to the fixed disk itself, rather than the mechanism it is a part of, use \"hard disks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disk drives"@en .

aat:300235844 a skos:Concept ;
    skos:definition "Computer output devices consisting of flat drawing tables traversed by writing-tool assemblies which produce drawings on paper or film to high-standard accuracy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-bed plotters"@en .

aat:300235851 a skos:Concept ;
    skos:definition "The collection of software that directs a computer's operations, controlling and scheduling the execution of other programs, and managing storage, input/output, and communication resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operating systems"@en .

aat:300235934 a skos:Concept ;
    skos:definition "Contests of speed, such as in running, riding, swimming, driving, or sailing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "races"@en .

aat:300235937 a skos:Concept ;
    skos:definition "Supreme and independent authority of a political unit to make and apply laws within its own boundaries and to conduct international relations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sovereignty"@en .

aat:300235953 a skos:Concept ;
    skos:definition "A system of ecclesiastical law, especially of the Roman Catholic Church as promulgated in ecclesiastical councils and by the pope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canon law"@en .

aat:300235957 a skos:Concept ;
    skos:definition "Vessels constructed for travel or transport below the water's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subsurface watercraft"@en .

aat:300235959 a skos:Concept ;
    skos:definition "Resorts specializing primarily in snow skiing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski resorts"@en .

aat:300235963 a skos:Concept ;
    skos:definition "Hotel-like housing providing single, private, furnished rooms for short- or long-term rental at very low rates; usually offering shared bath and kitchen facilities, with or without housekeeping, linen, or front-desk services. For similar housing but providing larger rooms or sets of rooms, generally for long-term rental and providing a larger array of services, use \"apartment hotels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single room occupancy hotels"@en .

aat:300235975 a skos:Concept ;
    skos:definition "Refers to masses, usually long in relation to their width, suspended from a fixed point, and often having a weight on the free end, and able to swing in an arc back and forth by the actions of gravity and acquired momentum; sometimes used for regulating the speed of clock mechanisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendulums"@en .

aat:300235976 a skos:Concept ;
    skos:definition "Kazak rugs with a field consisting of a pattern of 5 X 3 rosettes with other rosettes set within polygons having four curled hooks to resemble a pinwheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinwheel Kazaks"@en .

aat:300235978 a skos:Concept ;
    skos:definition "Sundials, of several varieties, whose dial plate is tilted so as to lie parallel to the earth's equator and whose gnomon is perpendicular to the plate at its center, pointing to the north celestial pole; the layout of the hour lines is not dependent on latitude."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equatorial sundials"@en .

aat:300236003 a skos:Concept ;
    skos:definition "Nuns who hold the office of superior of a convent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbesses"@en .

aat:300236006 a skos:Concept ;
    skos:definition "Pieces of protective boards or other heavy paper with an opening or openings cut in order to reveal a two dimensional visual work. Mats typically comprise two pieces, the bottom piece supports the print or other work, and the top piece contains an opening through which the work may be viewed. The boards may be hinged together to form a protective folder. Mats are used for prints, watercolors, pastels, other works of art, documents, or other generally flat objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mats"@en .

aat:300236014 a skos:Concept ;
    skos:definition "Officers of the highest rank in a navy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "admirals"@en .

aat:300236016 a skos:Concept ;
    skos:definition "People who pursue hazardous, risky, unscrupulous, or questionable enterprises and activities, either to gain wealth, power, or social position, or for the sake of excitement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adventurers"@en .

aat:300236020 a skos:Concept ;
    skos:definition "Those who study or practice a form of chemistry and speculative philosophy practiced in Europe mainly in the Middle Ages and the Renaissance, and concerned principally with discovering methods for transmuting base metal into gold and with finding a universal solvent and an elixir of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alchemists"@en .

aat:300236021 a skos:Concept ;
    skos:definition "People of a society that are distinguished by birth or fortune, or by the political supremacy of a privileged order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aristocrats"@en .

aat:300236022 a skos:Concept ;
    skos:definition "Members of the nobility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nobles"@en .

aat:300236024 a skos:Concept ;
    skos:definition "Those who study or practice the art that assumes and attempts to interpret and foretell the influence of the stars, moon, and planets upon human affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrologers"@en .

aat:300236025 a skos:Concept ;
    skos:definition "People trained or gifted in activities or contests involving physical skill, agility, stamina, or strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "athletes"@en .

aat:300236026 a skos:Concept ;
    skos:definition "Use specifically for women who dance in classical ballet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballerinas"@en .

aat:300236029 a skos:Concept ;
    skos:definition "Refers to noblemen holding a barony, which is a large estate or a sizable section of a larger territory ruled by a sovereign and often originally awarded for military or other service. It typically refers to members of the European nobility who rank, in modern times, immediately below a viscount or a count in many countries, although the rank and status of a baron varies from country to country and in various historical periods. The term may also be used in its original sense, which in the early Middle Ages designated the tenant who held a tenure of a barony directly from the king, whatever the tenant's rank. It may also be used to refer to noblemen of low rank in Japan. The term may be used in a more general sense to signify a powerful personage or magnate. Barons are always male; female holders of a barony are \"baronesses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barons"@en .

aat:300236030 a skos:Concept ;
    skos:definition "Scientists trained or working in the chemistry of living organisms and the reactions and methods for identifying their chemical substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biochemists"@en .

aat:300236032 a skos:Concept ;
    skos:definition "Refers to state officers or servants, either of prominent households or individuals, who carry messages and announce proclamations, and often also keep the family's genealogical records and regulate the depiction of its coats of arms. Applies particularly to officials in Medieval and modern Europe who arranged ceremonial events, particularly tournaments, at which they had special charge of conveying challenges and regulating the use of coats of arms by combatants. From the 19th century onwards, the office's duties consist mainly of regulating a family's or organization's coat of arms and often of doing the blazonry of those arms as well. For visual artists whose works consists solely of depicting coats of arms, see \"blazoners.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heralds"@en .

aat:300236033 a skos:Concept ;
    skos:definition "Those who depict coats of arms in proper form and color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blazoners"@en .

aat:300236043 a skos:Concept ;
    skos:definition "Small, heavy objects of glass, metal, or the like placed on papers to keep them from scattering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paperweights"@en .

aat:300236054 a skos:Concept ;
    skos:definition "Matching sets of containers, such as cups and dishes, or utensils, such as flatware or cutlery, needed to serve a meal for a specified number of persons for general table use or for a particular use, such as for breakfast or tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "services"@en .

aat:300236071 a skos:Concept ;
    skos:definition "Describes functional and decorative moveable objects in dwellings, places or business, or other public or private spaces that are made of soft materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft furnishings"@en .

aat:300236072 a skos:Concept ;
    skos:definition "Long, often cylindrical, pillows or cushions that are used to support the head of a person lying on a bed, couch, or similar form of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolsters"@en .

aat:300236073 a skos:Concept ;
    skos:definition "Bags or similar containers made typically of cloth, leather, or rubber stuffed with a resilient material and used to give support or ease to the body while sitting, reclining, or kneeling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cushions"@en .

aat:300236074 a skos:Concept ;
    skos:definition "Bags or similar containers typically made of cloth that are filled with feathers, down, sponge, or other soft materials and which are used to support the head during sleep or rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillows"@en .

aat:300236098 a skos:Concept ;
    skos:definition "Sets of vessels intended for use on a washstand generally including a basin and ewer, but may also include a soap dish and chamber pot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet sets"@en .

aat:300236102 a skos:Concept ;
    skos:definition "Sets of two to five cruets generally accompanied by a cruet stand or a small tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruet sets"@en .

aat:300236112 a skos:Concept ;
    skos:definition "The constituent political and administrative divisions of the modern nation of Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regions"@en .

aat:300236137 a skos:Concept ;
    skos:definition "Sticks with which the conductor of an orchestra or similar ensemble beats the time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batons"@en .

aat:300236153 a skos:Concept ;
    skos:definition "Administrative sections of larger nations, territories, or other districts as defined for religious purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious divisions"@en .

aat:300236157 a skos:Concept ;
    skos:definition "Administrative sections of larger nations, territories, or other districts as defined for political purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political divisions"@en .

aat:300236161 a skos:Concept ;
    skos:definition "Those whose occupation is brewing beer and other malt liquors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brewers"@en .

aat:300236163 a skos:Concept ;
    skos:definition "Screens used in the photographic process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic screens"@en .

aat:300236164 a skos:Concept ;
    skos:definition "Grids of fine opaque lines or other fine opaque patterns through which images are photographed to break up tonal areas into fine patterns for creating tonal areas in printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halftone screens"@en .

aat:300236171 a skos:Concept ;
    skos:definition "Officers in the military whose specific rank and extent of authority varies from one institution to another but who generally are in charge of a company of men or area of action, such as a ship, aircraft, or station. For officers of public services and institutions holding the same title, use \"captains (public officers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "captains"@en .

aat:300236191 a skos:Concept ;
    skos:definition "Sets of implements, vessels, and other articles intended for use at one's toilet; generally including a variety of small boxes and bottles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet sets"@en .

aat:300236195 a skos:Concept ;
    skos:definition "Packets of promotional materials for distribution to the press, as at a press conference. For official or authoritative statements distributed to the press typically by a public relations firm or government agency, use \"press releases.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press kits"@en .

aat:300236204 a skos:Concept ;
    skos:definition "Those who delineate, chart, or survey the topography of a geographic area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topographers"@en .

aat:300236210 a skos:Concept ;
    skos:definition "Those who hold a position of authority or command in the armed forces, specifically those holding it by commission. For those holding positions of trust and authority within a civil, governmental, or private context, see \"officers (administrators).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military officers"@en .

aat:300236211 a skos:Concept ;
    skos:definition "Shaping something, as a gem, glass, or ceramics, so that it has a series of relatively small, regular, flat surfaces that reflect light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faceting"@en .

aat:300236227 a skos:Concept ;
    skos:definition "Creative works that depict settlements that may be considered towns or villages. For creative works depicting settlements that may be considered cities, use \"cityscapes.\" For images that seem more documentary than creative, prefer \"views.\" To designate the actual built forms of towns or cities as perceived visually and aesthetically, use \"townscapes (built environment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "townscapes"@en .

aat:300236229 a skos:Concept ;
    skos:definition "Refers to officers of this title in public services and institutions, their rank and extent of authority varying with the specific context, but generally holding authority over a group or area of activity. For military officers holding the same title, see \"captains (military officers).\" For captains of ships, see \"shipmasters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "captains"@en .

aat:300236236 a skos:Concept ;
    skos:definition "Small, usually hand-held electrical appliances that dry hair by emitting a stream of warm air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blow dryers"@en .

aat:300236259 a skos:Concept ;
    skos:definition "Hollow cylindrical devices used to hold a cigarette while it is being smoked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigarette holders"@en .

aat:300236262 a skos:Concept ;
    skos:definition "Fighting men on horseback, typically of upper class background, especially those who fought on the side of the Royalist party in 17th-century Great Britain's civil war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavaliers"@en .

aat:300236264 a skos:Concept ;
    skos:definition "General term for a variety of mechanical devices for clipping or cutting, having two sharp edges that meet. For scissors-like implements with crossing blades, prefer \"scissors\" or \"shears,\" although usage may overlap with \"clippers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clippers"@en .

aat:300236284 a skos:Concept ;
    skos:definition "Originally, those who managed the property and domestic concerns of a large household; now, by extension, applied to those who manage matters concerning personal service, stores, and catering for a variety of organizations and commercial businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stewards"@en .

aat:300236290 a skos:Concept ;
    skos:definition "Originally, high stewards of a sovereign or member of the nobility, having particular charge of the sovereign's or noble's private living quarters. Now used also as the title of officials serving as treasurers for public corporations or offices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chamberlains"@en .

aat:300236293 a skos:Concept ;
    skos:definition "Those duly qualified to operate the controls of aircraft or ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilots"@en .

aat:300236294 a skos:Concept ;
    skos:definition "Those trained in or who practice navigation, especially on ships or aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navigators"@en .

aat:300236302 a skos:Concept ;
    skos:definition "Thin lenses of glass or plastic which fit over the cornea and correct vision defects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contact lenses"@en .

aat:300236306 a skos:Concept ;
    skos:definition "Powders, lotion, lipstick, rouge, or other preparations to be applied to the human body for the beautifying, preserving, or altering the appearance of a person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetics"@en .

aat:300236308 a skos:Concept ;
    skos:definition "Staffs or supports to assist a lame or infirm person in walking, especially those with a cross-piece at one end to fit under the armpit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crutches"@en .

aat:300236310 a skos:Concept ;
    skos:definition "Any of various pins, clasps, rollers, or appliances on which locks of hair are wound or clamped for curling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curlers"@en .

aat:300236323 a skos:Concept ;
    skos:definition "Artificial replacements of one, several, or all of the natural teeth especially ones not permanently anchored in the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dentures"@en .

aat:300236347 a skos:Concept ;
    skos:definition "Small mechanical devices for clipping fingernails or toenails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail clippers"@en .

aat:300236361 a skos:Concept ;
    skos:definition "The degree of height or depth of a musical tone or other sound, depending upon the relative rapidity of the vibrations by which it is produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitch"@en .

aat:300236365 a skos:Concept ;
    skos:definition "Reinforcement or prolongation of sound by supplementary vibration that is either sympathetic or mechanically induced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resonance"@en .

aat:300236367 a skos:Concept ;
    skos:definition "Arranging or regulating something to bring it into a proper state or position or to put it in good working order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjusting"@en .

aat:300236371 a skos:Concept ;
    skos:definition "Adjusting a musical instrument or other sound device to the correct or desired standard of pitch, or an audio signal receiver to the frequency of the desired signal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuning"@en .

aat:300236397 a skos:Concept ;
    skos:definition "Implements having a row of teeth on one or both edges or sides, used for adjusting, distangling, or cleaning the hair. For such tools that are intended primarily to be decorative and displayed in the hair, use \"combs (hair ornaments).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combs"@en .

aat:300236406 a skos:Concept ;
    skos:definition "Refers to officials carrying this title serving in various administrative, judical, or secretarial capacities in various contexts, such as noble and royal houses, governments, the judiciary, churches, and universities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chancellors"@en .

aat:300236409 a skos:Concept ;
    skos:definition "Eyeglasses kept in place by sidepieces passing over the ears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectacles"@en .

aat:300236410 a skos:Concept ;
    skos:definition "Commissioned officers in the armed forces; generally they rank as the superior officers of regiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonels"@en .

aat:300236418 a skos:Concept ;
    skos:definition "The inhabitants of a colony, either those who moved there or were born there. For those who take part in the initial founding of a colony, use \"colonists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonials"@en .

aat:300236419 a skos:Concept ;
    skos:definition "Protective coverings for the eyes having special lenses with shields at the sides and sometimes projecting rims or eye tubes; may consist of two lenses or a single frame and either held in place by two sidepieces extending around the ears or a strap that passes around the back of the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goggles"@en .

aat:300236421 a skos:Concept ;
    skos:definition "Those who take part in the initial founding of a colony. For those who inhabit a colony, either those who moved there or were born there, use \"colonials.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonists"@en .

aat:300236426 a skos:Concept ;
    skos:definition "Cosmetics applied to the lips that are composed of a fatty base containing waxes, oils, or emollients combined with color provided by pigments, often reds, or titanium dioxide for brightness and cover. Usually the material is formed into a stick, and is housed in a protective tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lipsticks"@en .

aat:300236427 a skos:Concept ;
    skos:definition "Small files of metal or cardboard, for trimming, smoothing, or shaping the fingernails and sometimes having a point for removing the dirt from under them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail files"@en .

aat:300236438 a skos:Concept ;
    skos:definition "Sharp-edged instruments, manually or electrically powered, used especially for shaving the face and legs or trimming hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "razors"@en .

aat:300236440 a skos:Concept ;
    skos:definition "Small bags or packets, especially small bags containing a perfumed powder that is used to scent costume as in drawers, closets, or trunks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sachets"@en .

aat:300236442 a skos:Concept ;
    skos:definition "Short, cylindrical brushes, with long, soft bristles, used to lather the face before shaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving brushes"@en .

aat:300236453 a skos:Concept ;
    skos:definition "Eyeglasses with colored or tinted lenses that protect the eyes from the glare of sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunglasses"@en .

aat:300236465 a skos:Concept ;
    skos:definition "Small brushes, with long handles, for cleaning the teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothbrushes"@en .

aat:300236468 a skos:Concept ;
    skos:definition "Slender pointed implements used after eating to remove bits of food lodged between the teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothpicks"@en .

aat:300236472 a skos:Concept ;
    skos:definition "Commissioned officers in various navies, ranking immediately below captains. For chief officers in command of a military force, place, or station, see \"commanding officers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commanders"@en .

aat:300236474 a skos:Concept ;
    skos:definition "Chief officers in command of a military force, place, or station. For commissioned officers in the American and British navies ranking immediately below captains, see \"commanders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commanding officers"@en .

aat:300236477 a skos:Concept ;
    skos:definition "The letter of the alphabet stamped on silver to indicate the year in which it was made or assayed, especially in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "date letters"@en .

aat:300236479 a skos:Concept ;
    skos:definition "Engraved inscriptions inside rings, often short poems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posies"@en .

aat:300236481 a skos:Concept ;
    skos:definition "Scientists trained or working in the science of the phenomena related to computers, including the construction, operation, programming, and applications of computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer scientists"@en .

aat:300236484 a skos:Concept ;
    skos:definition "Tablets, sometimes of silver, or boards, usually decorated with a Christian religious representation, that is kissed first by the priest and then by members of the congregation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paxes"@en .

aat:300236487 a skos:Concept ;
    skos:definition "Tibetan scrolls or fabric temple banners bearing religious images, usually painted but sometimes embroidered or appliquéd; they are hung in temples or carried in processions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tankas"@en .

aat:300236493 a skos:Concept ;
    skos:definition "Commanders of private bands of mercenaries who sell their services to warring states or rulers, especially those active in Italy and other regions of Europe from the 14th to the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condottieri"@en .

aat:300236517 a skos:Concept ;
    skos:definition "Those who take part in a conspiracy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conspirators"@en .

aat:300236518 a skos:Concept ;
    skos:definition "Term originating in the 16th century for those who sought to describe and map the overall features of the universe, both the heavens and the earth, encompassing those who are now termed astronomers, geographers, and geologists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmographers"@en .

aat:300236519 a skos:Concept ;
    skos:definition "The collective body of courtiers, family members, counselors, officers, and attendants constituting the retinue of a sovereign or high dignitary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courts"@en .

aat:300236520 a skos:Concept ;
    skos:definition "Those who engage in aggressive movements or enterprises against some public evil or some institution or group considered an evil. Includes specifically those who take part in wars or fighting expeditions instigated and blessed by the Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crusaders"@en .

aat:300236521 a skos:Concept ;
    skos:definition "Prostitutes who draw their clientele from a court or from the upper classes, and whose services often include social entertaining as well as sexual activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtesans"@en .

aat:300236522 a skos:Concept ;
    skos:definition "Those who make, sell, or repair knives and other cutting implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutlers"@en .

aat:300236547 a skos:Concept ;
    skos:definition "Men of noble birth or rank. For female counterparts, use \"noblewomen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noblemen"@en .

aat:300236548 a skos:Concept ;
    skos:definition "Women of noble birth or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noblewomen"@en .

aat:300236578 a skos:Concept ;
    skos:definition "Individuals who specialize in daguerreotypes, which are created by using an early photographic process (invented by L.J.M. Daguerre) that produces a direct positive image on a silver-coated copper plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daguerreotypists"@en .

aat:300236589 a skos:Concept ;
    skos:definition "Metalworkers who make metal objects shiny or lustrous by rubbing with a tool that compacts or smooths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnishers"@en .

aat:300236593 a skos:Concept ;
    skos:definition "Women who engage in business as their primary occupation or function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "businesswomen"@en .

aat:300236596 a skos:Concept ;
    skos:definition "Officials of ancient Rome and later Italian states who were elected in times of crisis and invested with absolute authority for the duration of the emergency. In modern usage, rulers who exercise absolute, unrestricted power over the government of a nation or state. It often refers to non-hereditary rulers. For ancient Greek rulers, or modern rulers who exercise their power cruelly, oppressively, or unjustly, see \"tyrants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictators"@en .

aat:300236616 a skos:Concept ;
    skos:definition "Rulers who exercise power oppressively, cruelly, or unjustly. Examples include in ancient Greece and Sicily, where tyrants usurped power from the legal authorities or inherited such power, but often with popular support. In modern contexts, examples include rulers who hold supreme political power and exercise it oppressively. For non-hereditary rulers who exercise absolute power over the government of a nation, whether or not cruelly or unjustly, see \"dictators.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tyrants"@en .

aat:300236674 a skos:Concept ;
    skos:definition "Any of various devices used for polishing or buffing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffers"@en .

aat:300236688 a skos:Concept ;
    skos:definition "Small, pointed instruments for making eyelet holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilettos"@en .

aat:300236713 a skos:Concept ;
    skos:definition "Brushes for smoothing and styling the hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairbrushes"@en .

aat:300236724 a skos:Concept ;
    skos:definition "Any of various gas or electrical appliances intended to dry hair by emitting heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair dryers"@en .

aat:300236735 a skos:Concept ;
    skos:definition "Delicate, sharp-pointed scissors, sometimes curved at the point, used for cutting nails and cuticles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manicure scissors"@en .

aat:300236748 a skos:Concept ;
    skos:definition "People who are abnormally small in stature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarfs"@en .

aat:300236749 a skos:Concept ;
    skos:definition "Those who study pharaonic Egypt, spanning the period around 4500 BCE to 641 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptologists"@en .

aat:300236750 a skos:Concept ;
    skos:definition "Those who do descriptive study, based on direct observation, of the culture and way of life of particular societies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnographers"@en .

aat:300236751 a skos:Concept ;
    skos:definition "Those who perform exorcisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exorcists"@en .

aat:300236752 a skos:Concept ;
    skos:definition "Those who believe in or sympathize with fascism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fascists"@en .

aat:300236753 a skos:Concept ;
    skos:definition "Those who engage in the sport of fencing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fencers"@en .

aat:300236757 a skos:Concept ;
    skos:definition "Those privately employed, as on an estate or private game preserve, to provide a natural environment conducive to the health and propagation of game, prevent poaching, and assist the employers or other authorized persons in hunting. For public officials who enforce the game laws of a jurisdiction, use \"game wardens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gamekeepers"@en .

aat:300236762 a skos:Concept ;
    skos:definition "In the armed forces of various nations, commissioned officers of the highest rank or of second or third highest rank overall, varying from one nation or organization to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "generals"@en .

aat:300236775 a skos:Concept ;
    skos:definition "Foot-shaped devices inserted in shoes to maintain their shape when they are not being worn. Also, machines in factories or workshops that force wooden parts into shoes to smooth out wrinkles during finishing. Distinguished from \"lasts (shoemaking tools),\" which may be similar in appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe trees"@en .

aat:300236781 a skos:Concept ;
    skos:definition "Those who believe in or practice gnosticism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gnostics"@en .

aat:300236782 a skos:Concept ;
    skos:definition "Chief officers so designated in various organizations, such as military orders of knighthood, fraternal orders such as the Freemasons, and trade unions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand masters"@en .

aat:300236786 a skos:Concept ;
    skos:definition "Those hired to lead or accompany others, such as travelers, tourists, and hunters, through areas unknown or unfamiliar to them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guides"@en .

aat:300236788 a skos:Concept ;
    skos:definition "Eyeglasses kept in place by a spring that grips the nose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pince-nez"@en .

aat:300236795 a skos:Concept ;
    skos:definition "Founders or leaders of heresies or heretical sects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heresiarchs"@en .

aat:300236796 a skos:Concept ;
    skos:definition "Those who choose to live in seclusion and solitude. Examples are those who do so for religious motives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hermits"@en .

aat:300236801 a skos:Concept ;
    skos:definition "Men who in the opinion of others have performed heroic acts or services and are regarded as ideals or role models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heroes"@en .

aat:300236808 a skos:Concept ;
    skos:definition "Women who in the opinion of others have performed heroic acts or services and are regarded as ideals or role models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heroines"@en .

aat:300236809 a skos:Concept ;
    skos:definition "Military leaders of the Cossacks; originally the Polish title for commanders in chief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hetmans"@en .

aat:300236851 a skos:Concept ;
    skos:definition "People who coat the surfaces of walls, furniture, vehicles, or other things with paint, which is pigment suspended in liquid, with the primary goal of protecting or giving simple color to the surface. For people who apply paint to a surface to create an expressive or communicative image, see \"painters (artists).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painters"@en .

aat:300236862 a skos:Concept ;
    skos:definition "Those who believe in or practice humanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humanists"@en .

aat:300236866 a skos:Concept ;
    skos:definition "Those who are trained or work in hygiene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hygienists"@en .

aat:300236867 a skos:Concept ;
    skos:definition "Those who produce live public entertainments, especially operas, ballets, and concerts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impresarios"@en .

aat:300236886 a skos:Concept ;
    skos:definition "Those who set fire to buildings, vehicles, or other property with criminal intent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arsonists"@en .

aat:300236907 a skos:Concept ;
    skos:definition "Those versed in the law, such as scholars, professors, writers, or practitioners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jurists"@en .

aat:300236992 a skos:Concept ;
    skos:definition "Artists who produce landscape images, which are outdoor scenes in which the primary subject is the land, bodies of water, or other natural elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscapists"@en .

aat:300236993 a skos:Concept ;
    skos:definition "Those who take the lead in any enterprise or movement, or who guide the actions and opinions of followers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaders"@en .

aat:300236995 a skos:Concept ;
    skos:definition "Decorative pattern imitating an arcade, as on a piece of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcading"@en .

aat:300237007 a skos:Concept ;
    skos:definition "Absolute rulers of sovereign states, usually by hereditary succession. The term is generally used as a substitute for the specific title of the sovereign, for example, \"king,\" \"queen,\" or \"emperor.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monarchs"@en .

aat:300237015 a skos:Concept ;
    skos:definition "The severing of a glass object from the blowpipe or pontil rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cracking off"@en .

aat:300237064 a skos:Concept ;
    skos:definition "Scholars or compilers of the prescribed rites of formal and public worship, typically including words, music, symbolic aids, and ritual actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgists"@en .

aat:300237068 a skos:Concept ;
    skos:definition "The process of forming an object, such as a hollow vessel, from a flat sheet of metal by alternately hammering and annealing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raising"@en .

aat:300237069 a skos:Concept ;
    skos:definition "Women who have charge of the domestic arrangements of institutions such as hospitals, schools, and prisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matrons"@en .

aat:300237076 a skos:Concept ;
    skos:definition "Those who practice or espouse an ethically righteous way of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moralists"@en .

aat:300237080 a skos:Concept ;
    skos:definition "Those trained or specializing in the organization, administration, functions, and technical processes of museums, including documentation and collections management, as well as the history, philosophy, and purposes of collections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museologists"@en .

aat:300237154 a skos:Concept ;
    skos:definition "States a people is a tributary to a suzerain ruler, or in more recent history, to a more powerful state that controls its foreign affairs while allowing the tributary vassal state some limited domestic autonomy. An historical example is the Ottoman Empire and its surrounding regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suzerainties"@en .

aat:300237188 a skos:Concept ;
    skos:definition "Districts, including those originally possessing a degree of political independence or self-government, which have been incorporated into the boundaries of another administrative body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annexes"@en .

aat:300237189 a skos:Concept ;
    skos:definition "Tracts of land along the border of a nation, country, district, or region, including those originally established as military districts for national defense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marches"@en .

aat:300237209 a skos:Concept ;
    skos:definition "Physicists specializing in the structure of atomic nuclei and their interactions with each other, their constituent particles, and the whole spectrum of elementary particles provided by very large accelerators, with particular reference to the generation of nuclear energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear physicists"@en .

aat:300237213 a skos:Concept ;
    skos:definition "Those who make or sell eyeglasses and contact lenses in accordance with the prescriptions of eye specialists such as optometrists and opthamologists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opticians"@en .

aat:300237219 a skos:Concept ;
    skos:definition "Those trained in the practice of optometry. For physicians specializing in the branch of medicine called ophthalmology, use \"ophthalmologists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optometrists"@en .

aat:300237241 a skos:Concept ;
    skos:definition "Physicians specializing in the branch of medicine called ophthalmology. For those trained in the practice of optometry, use \"optometrists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ophthalmologists"@en .

aat:300237243 a skos:Concept ;
    skos:definition "People or corporate bodies who design and construct organs, which are complex aerophones consisting of one or more rows of individual pipes. They may also advise and supervise the installation of the larger types of organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ builders"@en .

aat:300237244 a skos:Concept ;
    skos:definition "Zoologists trained or working in the scientific study of birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornithologists"@en .

aat:300237245 a skos:Concept ;
    skos:definition "Term used in various parts of Europe at different times from the Roman Empire to the early modern era, and in some European colonies in America, to designate high-ranking officials or nobles who either directly served or represented their monarch in certain spheres, such as the military, the judiciary, or the royal household, or who exercised royal power in a division or dependency of the realm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palatines"@en .

aat:300237335 a skos:Concept ;
    skos:definition "Under the feudal system, those holding land or another source of income such as rents and offices from a superior, and who in return owe homage, fealty, and service, usually specifically military service or its equivalent, to that superior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vassals"@en .

aat:300237336 a skos:Concept ;
    skos:definition "Those who love, support, and defend their country and its interests with devotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patriots"@en .

aat:300237351 a skos:Concept ;
    skos:definition "Those who make portraits in any medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portraitists"@en .

aat:300237357 a skos:Concept ;
    skos:definition "Those whose occupation or function is to proclaim or set forth religious doctrine in public, particularly but not exclusively those who preach the Christian gospel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preachers"@en .

aat:300237368 a skos:Concept ;
    skos:definition "Clergy who occupy offices of high rank and authority in the Christian Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prelates"@en .

aat:300237374 a skos:Concept ;
    skos:definition "Those involved in producing or spreading propaganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propagandists"@en .

aat:300237375 a skos:Concept ;
    skos:definition "Title used for high-ranking administrative officers in various organizations, most commonly in ecclesiastical and academic institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provosts"@en .

aat:300237376 a skos:Concept ;
    skos:definition "Those whose occupation or function is disseminating information to the public about some product, company, institution, individual, cause, or project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publicists"@en .

aat:300237377 a skos:Concept ;
    skos:definition "Those who manipulate puppets in performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puppeteers"@en .

aat:300237413 a skos:Concept ;
    skos:definition "Karabagh rugs whose chief characteristic is a design motif consisting of one or more large floral motifs which function as medallions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunburst Kazaks"@en .

aat:300237433 a skos:Concept ;
    skos:definition "Vessels used for preparing and serving alcoholic beverages, such as glasses, decanters, and cocktail shakers. May also include other utensils used at a bar to prepare drinks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barware"@en .

aat:300237436 a skos:Concept ;
    skos:definition "Rugs woven in India with Persian design motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-Persian rugs"@en .

aat:300237449 a skos:Concept ;
    skos:definition "Those who pick up rags and other waste material of any value from the streets, rubbage cans, or dump sites, as a means of livelihood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ragpickers"@en .

aat:300237469 a skos:Concept ;
    skos:definition "Wine glasses with a foot shaped to form another drinking vessel when reversed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double wine glasses"@en .

aat:300237474 a skos:Concept ;
    skos:definition "Small boxes intended to hold comfits, which are tiny, strongly scented sweets used as breath fresheners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comfit boxes"@en .

aat:300237490 a skos:Concept ;
    skos:definition "Those engaged in or supporting a revolution, which is a change in established patterns of government or social organization, or those who advocate revolutionary doctrines or principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolutionaries"@en .

aat:300237497 a skos:Concept ;
    skos:definition "Scribes who execute rubrics, which are headings, catchwords, or marginal index words printed or written in red (the remainder of the text being in black), or otherwise distinguished in lettering, as guides to the contents of pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubricators"@en .

aat:300237516 a skos:Concept ;
    skos:definition "Small vessels for serving jam or preserves usually having a cover, which often has an indentation for the stem of a jam spoon, and a fixed saucerlike stand. Sometimes a part of a breakfast service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jam pots"@en .

aat:300237528 a skos:Concept ;
    skos:definition "Small dishes used by an individual diner to hold a pat or small serving of butter. For dishes intended to hold and serve butter at the table use \"butter dishes (serving dishes).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter chips"@en .

aat:300237544 a skos:Concept ;
    skos:definition "Vessels intended to hold or dispense wine having one or more taps and a spigot; sometimes made en suite with a wine cooler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine fountains"@en .

aat:300237565 a skos:Concept ;
    skos:definition "Cylindrical containers, often metal, with a close lid perforated with a number of coarse or fine holes for sprinkling flour, sugar, or spices especially when cooking. Typically undecorated, except for some horizontal molding, and often having one simple scroll or ring handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dredgers"@en .

aat:300237566 a skos:Concept ;
    skos:definition "Any of various containers in which plants are grown or placed for decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planters"@en .

aat:300237588 a skos:Concept ;
    skos:definition "Specialists in the study of runes and runic writings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runologists"@en .

aat:300237597 a skos:Concept ;
    skos:definition "Metal points which may be attached, for example, to rules, steel squares, or beam compasses in order to scribe large circles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trammel points"@en .

aat:300237599 a skos:Concept ;
    skos:definition "Containers, usually of pottery or porcelain, with a perforated cover in which cut flowers, boughs, or branches are held or displayed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boughpots"@en .

aat:300237607 a skos:Concept ;
    skos:definition "Those who believe in or adhere to spiritualism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiritualists"@en .

aat:300237608 a skos:Concept ;
    skos:definition "Russian boat-shaped drinking vessels with a long handle at one end; possibly also used as ladles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kovshi"@en .

aat:300237612 a skos:Concept ;
    skos:definition "People who engage in outdoor recreational sporting activities, particularly fishing or game hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sportsmen"@en .

aat:300237629 a skos:Concept ;
    skos:definition "Covered containers of varying form intended primarily for storing biscuits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biscuit boxes"@en .

aat:300237642 a skos:Concept ;
    skos:definition "In Medieval Europe, young men of aristocratic birth who served as personal attendants to knights, often with the goal of attaining the rank of knight themselves. In later times used in England to refer to the chief landed proprietors of a district."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squires"@en .

aat:300237643 a skos:Concept ;
    skos:definition "Russian cups for vodka, often with a horizontal handle flush with the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charkas"@en .

aat:300237650 a skos:Concept ;
    skos:definition "Indentations in the bottom of a drinking glass or in the base of any glass object; when in the bottom of a drinking glass or bottle, they add to the stability but reduce capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kicks"@en .

aat:300237658 a skos:Concept ;
    skos:definition "Eight-inch plates, variously shaped, a size between dinner plates and muffin plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twifflers"@en .

aat:300237663 a skos:Concept ;
    skos:definition "Those who carry standards bearing the insignia or symbol of a leader, group, or nation for display in a public setting such as a procession, ceremony, or battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standard-bearers"@en .

aat:300237665 a skos:Concept ;
    skos:definition "Shallow oblong baskets made of wooden strips with a handle from side to side, chiefly used for carrying fruit, vegetables, or flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trugs"@en .

aat:300237669 a skos:Concept ;
    skos:definition "Metal frames, sometimes gold, intended to hold a ceramic, usually porcelain, cup for coffee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zarfs"@en .

aat:300237682 a skos:Concept ;
    skos:definition "Partitioned boxlike containers intended for use by travelers and military personnel to carry flatware, cutlery, and other articles for eating and drinking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canteens"@en .

aat:300237688 a skos:Concept ;
    skos:definition "Small holes, usually near the base of a container, through which liquid can be poured; usually found in rundlets and water coolers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bungholes"@en .

aat:300237700 a skos:Concept ;
    skos:definition "Finely woven rugs intended for a sophisticated, urban clientelle. They typically duplicate specific patterns and are woven to standards that are enforced in a workshop setting under the guidance of a master weaver, often employing a cartoon that carefully depicts knot counts and colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city rugs"@en .

aat:300237746 a skos:Concept ;
    skos:definition "Large bags of leather or fabric hung from one side of a saddle or laid over the back of the horse, mule, or donkey behind the saddle and commonly one of a pair united by a band or strap. Also, similar bags hung on each side of the rear wheel of a bicycle, motorcycle, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddlebags"@en .

aat:300237754 a skos:Concept ;
    skos:definition "Tubular devices inserted into a vessel that permit the outflow of the liquid contents, usually with a spigot to control the rate of the flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taps"@en .

aat:300237758 a skos:Concept ;
    skos:definition "Those trained or working in the field of taxonomy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxonomists"@en .

aat:300237760 a skos:Concept ;
    skos:definition "Those who study or specialise in technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technologists"@en .

aat:300237761 a skos:Concept ;
    skos:definition "Those who make or sell toys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toymakers"@en .

aat:300237762 a skos:Concept ;
    skos:definition "Those who betray another person, a cause, a duty, or any trust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traitors"@en .

aat:300237763 a skos:Concept ;
    skos:definition "Medical experts whose practice concerns the prevention, control, diagnosis, and treatment of injuries and diseases affecting the health of domestic and wild animals, including the prevention of transmission of animal diseases to other animals and to people"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterinarians"@en .

aat:300237767 a skos:Concept ;
    skos:definition "The sending or bringing back of persons to their country of citizenship or of legal or cultural property to its country, land, or culture of origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repatriation"@en .

aat:300237774 a skos:Concept ;
    skos:definition "Collections of images, usually, but not always, held in electronic format for retrieval by computer. Image databases may contain images of works of art, documents, medical CAT scans, or other images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image databases"@en .

aat:300237780 a skos:Concept ;
    skos:definition "Use with reference to photographic and electronic images, usually pertaining to the clarity of details, often relating to the degree of resolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image quality"@en .

aat:300237781 a skos:Concept ;
    skos:definition "Use to describe two-way systems involving feedback from a viewer or user, to obtain data or commands and to give immediate results or updated information. Generally used to describe computer-based systems, but may have broader applications as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interactive"@en .

aat:300237864 a skos:Concept ;
    skos:definition "Various techniques of manipulating images in a computer environment, whether by program or by adjusting individual pixels or areas of the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image processing"@en .

aat:300237883 a skos:Concept ;
    skos:definition "Glasslike in appearance or composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitreous"@en .

aat:300237887 a skos:Concept ;
    skos:definition "Produced or shaped by beating with a hammer, as iron or silver objects. For commercially pure iron of a fibrous nature made by melting white cast iron use \"wrought iron.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrought"@en .

aat:300237889 a skos:Concept ;
    skos:definition "Tanning hides or skins with chromium salts or chromic acid, used chiefly to produce light leathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome tanning"@en .

aat:300237891 a skos:Concept ;
    skos:definition "Digitizers that derive data from the scanning of opaque or transparent images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scanners"@en .

aat:300237901 a skos:Concept ;
    skos:definition "A material made up of finely divided particles uniformly distributed in a continuous liquid, gaseous, or solid medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colloid"@en .

aat:300237903 a skos:Concept ;
    skos:definition "The recording, storage, and manipulation of images in computer systems in the form of electronically encoded picture elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital imaging"@en .

aat:300237904 a skos:Concept ;
    skos:definition "Images recorded and stored in computer and video systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic images"@en .

aat:300237906 a skos:Concept ;
    skos:definition "Refers to various aggregate materials formed artificially from two or more substances, such as whiting, resin, and size used for modeling ornament in the late 18th century, or plaster of Paris, sawdust, bran, and glue used for dollmaking, or plastic cement-based mortars used in construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composition"@en .

aat:300237910 a skos:Concept ;
    skos:definition "In chemistry, any compound that in water solution is slippery to the touch, tastes bitter, turns red litmus paper blue, reacts with acids to form salts, and promotes certain chemical reactions called \"base catalysis.\" Examples of bases are the hydroxides of the alkali and alkaline earth metals (sodium, calcium, etc.) and the water solutions of ammonia or its organic derivatives (amines). Such substances produce hydroxide ions (OH-) in water solutions. Bases yield hydroxyl ions when dissolved in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base"@en .

aat:300237919 a skos:Concept ;
    skos:definition "Concepts related to the properties and phenomena of visible and invisible light, including its generation, transmission, and detection or perception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical concepts"@en .

aat:300237927 a skos:Concept ;
    skos:definition "Decorative objects adorned on animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal trappings"@en .

aat:300237950 a skos:Concept ;
    skos:definition "Extreme dryness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desiccation"@en .

aat:300237956 a skos:Concept ;
    skos:definition "The change in length or volume of a material or body due to change in temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal expansion"@en .

aat:300237960 a skos:Concept ;
    skos:definition "Patterns characterized by a mass of scattered flowers or plants that form a background to a scene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millefleurs"@en .

aat:300237962 a skos:Concept ;
    skos:definition "Motifs consisting of two wavy lines set beneath three balls arranged in a triangular shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chintamani"@en .

aat:300237963 a skos:Concept ;
    skos:definition "In the design of Turkoman rugs, a large, usually eight-sided geometrical motif (although it may be hexagonal or lozenge-shaped), \"gul\" originally from the Persian for \"rose.\" It originally represented a stylized rose but subsequently was modified in ways characteristic of various tribes. The motifs constitute the primary decorative elements of Turkoman weavings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "güls"@en .

aat:300237964 a skos:Concept ;
    skos:definition "The arrangement of masts and sails on boats or ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigs"@en .

aat:300237965 a skos:Concept ;
    skos:definition "Güls characterized by a hooked stepped polygon; usually found in an endless repeat format on rugs, but sometimes also on saddle rugs and other Turkoman weavings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Memling güls"@en .

aat:300237969 a skos:Concept ;
    skos:definition "The representation of the behavior or characteristics of one system through the use of another system, especially a computer model; often used to forecast or predict the behavior of a dynamic system when real world experimentation is not feasible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simulation"@en .

aat:300237973 a skos:Concept ;
    skos:definition "Rigs in which the principal sails are set parallel to the keel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fore-and-aft rigs"@en .

aat:300237977 a skos:Concept ;
    skos:definition "Rigs generally characterized by a single mast, a triangular sail whose forward edge is sharply raked aft and is attached to a right spar or yard which in turn is attached to the mast, and a boom that extends forward of the mast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lateen rigs"@en .

aat:300237989 a skos:Concept ;
    skos:definition "Technique for making small, accurate castings from alloys having high melting points, the mold being made by investing a pattern of wax or similar material that can be removed from the investment by melting it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "investment casting"@en .

aat:300237999 a skos:Concept ;
    skos:definition "Rigs having a triangular sail whose forward edge is attached to a separate spar which is hoisted to a fully vertical position where it becomes an extension of the short mast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gunter rigs"@en .

aat:300238012 a skos:Concept ;
    skos:definition "Any of various rigs generally characterized by a four-sided sail bent on a yard that crossed the mast obliquely; developed in the late 17th to early 18th century especially for small fishing or coastal craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lug rigs"@en .

aat:300238015 a skos:Concept ;
    skos:definition "An alloy of copper and zinc, often used as a substitute for gold leaf since the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch metal"@en .

aat:300238051 a skos:Concept ;
    skos:definition "Style of rugs woven by the Baloch people living in Afghanistan and eastern Iran. The patterns often incorporate repeated motifs diagonally arranged across the field, or a maze of intricate latch-hooked forms. Prayer rugs may contain a field filled with the leaves and stems of a stylized tree, with geometric small plants in the spandrels. Baluchi rugs frequently have long aprons at both ends, decorated with stripes and bands of brocading. The color scheme of older rugs is a dark combination of reds, browns, blues, tans, and white. The fibers are typically wool, goat and camel hair, cotton for whites, and in some cases a few knots of silk. The knotting is customarily asymmetrical. The rugs vary greatly in quality, the better ones usually being ascribed to the Khorasan province of Iran. Baluchi rugs are frequently classed with the products of the Turkmen but show little relationship to them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baluch"@en .

aat:300238059 a skos:Concept ;
    skos:definition "Process of crimping, plaiting, or fluting the edges of lace, linen, or a trimming or textile of any kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goffering"@en .

aat:300238067 a skos:Concept ;
    skos:definition "Tools used for embossing, as in the stamping of linen book bindings, or gold leaf surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauffers"@en .

aat:300238088 a skos:Concept ;
    skos:definition "Printing establishments that issue small editions at the pleasure of the owner, often finely printed, perhaps on a hand press."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private presses"@en .

aat:300238095 a skos:Concept ;
    skos:definition "Artists' supports, such as canvas, when it is not stretched over a frame. The term is also used more generally to include stiff supports, not intended to be stretched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unstretched supports"@en .

aat:300238097 a skos:Concept ;
    skos:definition "Canvas used by artists to which paint is applied directly, without preparatory treatments, or which is used in collages or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw canvas"@en .

aat:300238334 a skos:Concept ;
    skos:definition "Cloths put over the back of a horse or other riding animal under the saddle and extending out behind it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddlecloths"@en .

aat:300238344 a skos:Concept ;
    skos:definition "Persons who coat or plate articles with a film of metal, usually of silver or gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platers"@en .

aat:300238437 a skos:Concept ;
    skos:definition "The style and culture of the country of Tunisia in North Africa, of its capital Tunis, of the former Barbary state of Tunis, that preceded it, or of speakers of the demotic speech of the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tunisian"@en .

aat:300238441 a skos:Concept ;
    skos:definition "Conveyances carried by people or animals moving in tandem, consisting generally of a bed or couch, often boxlike in form, enclosed by curtains and suspended between two poles. For conveyances used to transport the sick, wounded, or dead consisting of canvas or similar material stretched on a frame, use \"stretchers (conveyances).\" For portable, often elaborate, chairs carried between poles, use \"sedan chairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litters"@en .

aat:300238443 a skos:Concept ;
    skos:definition "A variety of conveyances for one person consisting generally of canvas or similar material stretched or laid across a frame for transporting the sick, wounded, or dead. For more elaborate conveyances carried on poles by people or animals, use \"litters\" if boxlike in form, often enclosed by curtains, or \"sedan chairs\" if in the form of portable chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretchers"@en .

aat:300238444 a skos:Concept ;
    skos:definition "A glob of molten glass before it is tooled or fully shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gather"@en .

aat:300238450 a skos:Concept ;
    skos:definition "The feeling or expression of grief or sorrow, along with the ritual observances accompanying a death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning"@en .

aat:300238451 a skos:Concept ;
    skos:definition "Men or women employed by restaurants, other eating and drinking houses, hotels, caterers, and similar establishments to wait upon the guests at table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servers"@en .

aat:300238469 a skos:Concept ;
    skos:definition "Use with regard to types of computer interface that produce compelling sensory output in response to user selections or movements. Distinguished from \"cyberspace\" which is the virtual place within the collective memories and networks of computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virtual reality"@en .

aat:300238473 a skos:Concept ;
    skos:definition "Covered or fully enclosed litters for one person carried on the shoulders of four or six bearers, formerly common in Asia, especially India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palanquins"@en .

aat:300238511 a skos:Concept ;
    skos:definition "Reduced-size coaches, generally having curved fronts, designed for compactness or to improve appearance yet retaining the elegance of the original, larger enclosed vehicles. For smaller, low-hung coaches, built generally with straight fronts and not based on larger prototypes, especially in the United States in the late 19th century, use \"broughams.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupés"@en .

aat:300238593 a skos:Concept ;
    skos:definition "Hard, dense, white stoneware developed in England during the 18th century as a cheaper substitute for bone china and originally highly decorated, but used most extensively as plain white inexpensive tableware throughout most of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironstone"@en .

aat:300238624 a skos:Concept ;
    skos:definition "Metallic oxide used in glazes that fires from a purplish-brown to black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese oxide"@en .

aat:300238648 a skos:Concept ;
    skos:definition "Applied decoration consisting of a thin sheet of metal, usually silver, cut from a rolled sheet to produce a border or surface silhouette design and affixed by soldering to an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut-card work"@en .

aat:300238711 a skos:Concept ;
    skos:definition "Style of textiles, particularly floor coverings (often prayer rugs), handwoven in Kula, a town east of Izmir in western Turkey, popular with collectors in the 19th century and beyond. The designs are often characterized by a low, straight-sided arch (indicating the direction of Mecca), columnar sides of the prayer niche often comprising broad, ribbonlike pendant forms, and often having elaborate central motifs. Early Kula prayer rugs have strong reds and blues, but in most later examples the red has been exchanged for an assortment of muddy browns and yellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kula"@en .

aat:300238744 a skos:Concept ;
    skos:definition "Marking an object with a postal or other mark to waive the charge for, or otherwise facilitate, its passage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "franking"@en .

aat:300238843 a skos:Concept ;
    skos:definition "Light waves made to vibrate in a single plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polarized light"@en .

aat:300238892 a skos:Concept ;
    skos:definition "Vessels fitted for laying and repairing underwater communications cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable ships"@en .

aat:300238962 a skos:Concept ;
    skos:definition "Costume and manner of dressing required by custom or etiquette for certain occasions or times of day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress"@en .

aat:300238969 a skos:Concept ;
    skos:definition "Pliers used for mounting in various contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounting pliers"@en .

aat:300238982 a skos:Concept ;
    skos:definition "Equipment of various kinds intended for use by one person, including but not limited to equipment for the safety and comfort of the person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal equipment"@en .

aat:300239001 a skos:Concept ;
    skos:definition "Marking the surface of an object by applying pressure with a tool, for example, transferring an ink mark to paper or embossing soft clay; also, applying preprinted labels such as postage stamps that substitute for official stamped marks. In bookbinding, distinguished from \"blocking\", in which pressure is applied by a machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamping"@en .

aat:300239006 a skos:Concept ;
    skos:definition "Three-dimensional representations of human figures, often stylized or otherwise abstracted, used by tailors, dressmakers, and sales personnel for fitting or displaying clothing. For models of the human body used for teaching anatomy or demonstrating surgical operations, use \"manikins.\" For jointed figure of humans or animals used by artists, use \"lay figures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mannequins"@en .

aat:300239022 a skos:Concept ;
    skos:definition "Use to describe wooden watercraft hulls in which the edges of planks are set flush resulting in a smooth exterior surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carvel-built"@en .

aat:300239028 a skos:Concept ;
    skos:definition "Use to describe wooden watercraft hulls in which the lower ends of each plank overlaps the top end of the plank below it; the point of overlap is usually pinned, nailed, or riveted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinker-built"@en .

aat:300239050 a skos:Concept ;
    skos:definition "Models of the human body used for teaching anatomy or demonstrating surgical operations. For three-dimensional representations of human figures used specifically for fitting or displaying clothing, use \"mannequins.\" For jointed figures of humans and animals able to assume a variety of poses to serve as substitutes for living models for artists, use \"lay figures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manikins"@en .

aat:300239060 a skos:Concept ;
    skos:definition "Territorial divisions formed for administrative or electoral purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil districts"@en .

aat:300239103 a skos:Concept ;
    skos:definition "Concepts related to the study of institutions and functioning of human society and with the interpersonal relationships of individuals as members of society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social science concepts"@en .

aat:300239104 a skos:Concept ;
    skos:definition "Describes activities conducted to advertise across platforms and spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising functions"@en .

aat:300239112 a skos:Concept ;
    skos:definition "A locale that constitutes the center of an individual's domestic life, affectional relationships, and interests, together with the feeling of comfort and satisfaction that it conveys. For the buildings or portions of a building designed for residential occupancy by one family, use \"dwellings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home"@en .

aat:300239116 a skos:Concept ;
    skos:definition "Diviners who work by means of signs derived from configurations of earth, such as from a handful of earth thrown upon a surface, or from arrangements of dots jotted down on paper at random."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geomancers"@en .

aat:300239121 a skos:Concept ;
    skos:definition "Divination by means of signs derived from configurations of earth, such as from a handful of earth thrown upon a surface, or from arrangements of dots jotted down on paper at random. It was popular throughout Africa and Europe in the Middle Ages and the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geomancy"@en .

aat:300239125 a skos:Concept ;
    skos:definition "Tours in which the means of travel is walking on foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking tours"@en .

aat:300239147 a skos:Concept ;
    skos:definition "Articles, furnishings, or other physical resources utilized for or with animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal equipment"@en .

aat:300239152 a skos:Concept ;
    skos:definition "Religious officials or functionaries authorized to perform duties in accordance with Christianity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian clergy"@en .

aat:300239153 a skos:Concept ;
    skos:definition "Religious officials or functionaries authorized to perform duties in accordance with Judaism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jewish clergy"@en .

aat:300239154 a skos:Concept ;
    skos:definition "Religious officials or functionaries authorized to perform duties in accordance with Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic clergy"@en .

aat:300239169 a skos:Concept ;
    skos:definition "Religious officials or functionaries authorized to perform duties in accordance with Zoroastrianism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zoroastrian clergy"@en .

aat:300239179 a skos:Concept ;
    skos:definition "Those who engage in business as their primary occupation or function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "businesspeople"@en .

aat:300239253 a skos:Concept ;
    skos:definition "Ancient war or racing chariots drawn by four horses abreast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrigas"@en .

aat:300239260 a skos:Concept ;
    skos:definition "Devices used for fastening consisting of a usually open rectangular or rounded frame and a tongue or catch attached to one side or a vertical bar attached across the center. Sometimes used alone as an ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckles"@en .

aat:300239261 a skos:Concept ;
    skos:definition "Disks, balls, or devices of other shape having holes or a shank by which they are sewn or secured to an article and that are used as fasteners by passing through a buttonhole or loop or a trimming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttons"@en .

aat:300239266 a skos:Concept ;
    skos:definition "Pieces of bent wire or plastic used for holding several sheets of paper together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper clips"@en .

aat:300239269 a skos:Concept ;
    skos:definition "Pins for fastening separate articles, as garments, bent back on itself so as to form a spring, and with a guard or sheath to cover the point and prevent accidental unfastening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety pins"@en .

aat:300239270 a skos:Concept ;
    skos:definition "Fastening devices that close with a click when the two parts are fitted tightly into each other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snaps"@en .

aat:300239275 a skos:Concept ;
    skos:definition "Trademark name for fastening material consisting of opposing pieces of fabric, one with a dense arrangement of tiny nylon hooks and the other with a dense nylon pile, that interlock when pressed together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Velcro (TM)"@en .

aat:300239280 a skos:Concept ;
    skos:definition "Racing events for watercraft, usually consisting of a group of races over short to medium distances and often having the nature of festive social occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regattas"@en .

aat:300239307 a skos:Concept ;
    skos:definition "Cords, bands, or similar flexible devices used for fastening, especially by interlacing, such as in a knot or bow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ties"@en .

aat:300239328 a skos:Concept ;
    skos:definition "Pins in the form of thin pieces of short wire having a head and a sharp point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight pins"@en .

aat:300239340 a skos:Concept ;
    skos:definition "Cylindrical or slightly tapering fasteners having a loop or eye for the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw eyes"@en .

aat:300239342 a skos:Concept ;
    skos:definition "Small holes, usually round and finished along the edge, as in cloth or leather for the passage of a lace or cord or as in embroidery for ornamental effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyelets"@en .

aat:300239360 a skos:Concept ;
    skos:definition "Various devices of wood, metal, or plastic used to hang garments consisting of either a frame, clamp, or crossbar or some combination so as to secure or support a garment and having a hook at the top by which they may be suspended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangers"@en .

aat:300239408 a skos:Concept ;
    skos:definition "Variously shaped inserts, as of cloth or leather, placed in a seam, as in a sleeve or glove, to strenghten or enlarge some part; also, pieces of chain mail or plate at the openings of the joints in a suit of armor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gussets"@en .

aat:300239410 a skos:Concept ;
    skos:definition "Refers to those skilled or practiced in incising marks on the surface of a hard material, such as glass or metal, with a sharp tool, when the designs or images created are for their own sake and not to be printed from. For those who practice the printing process of engraving, see \"engravers (printmakers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engravers"@en .

aat:300239451 a skos:Concept ;
    skos:definition "Describes activities that occur in relation to a body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water activities"@en .

aat:300239459 a skos:Concept ;
    skos:definition "Various types of competitions in which speed in traveling between two or more points is the deciding criterion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racing"@en .

aat:300239463 a skos:Concept ;
    skos:definition "Those who apply a glaze to things, such as pottery, leather, bricks, or fur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazers"@en .

aat:300239467 a skos:Concept ;
    skos:definition "The activity of rolling a series of balls at standing objects or a toward a mark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowling"@en .

aat:300239470 a skos:Concept ;
    skos:definition "The sport or business of catching, usually killing, fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing"@en .

aat:300239488 a skos:Concept ;
    skos:definition "Games in which the outcome is strongly influenced by some randomizing device and upon which contestants frequently wager money. Skill may also be involved in games of chance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "games of chance"@en .

aat:300239493 a skos:Concept ;
    skos:definition "The activity of going by boat or of rowing, especially as when an amusement rather than as a necessity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boating"@en .

aat:300239494 a skos:Concept ;
    skos:definition "Moving through the water by the action of wind on sails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailing"@en .

aat:300239495 a skos:Concept ;
    skos:definition "The activity of a person or animal propelling themselves in the water by natural means of progression, such as floating and kicking or paddling the limbs. For the activity of cleansing, prefer \"bathing (hygienic activity).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swimming"@en .

aat:300239496 a skos:Concept ;
    skos:definition "The action of a person or animal using their legs to go faster than a walk, specifically to go steadily by springing steps so that both or all feet leave the ground for an instant in each step. May be employed as a competitive sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running"@en .

aat:300239497 a skos:Concept ;
    skos:definition "Recreational activity comprising traveling by skis in open country over rolling, hilly terrain as distinguished from traveling downhill on skis. The activity developed in Scandinavian countries as a means of travel as well as recreation. Cross-country skiing differs from downhill skiing in that the skis are longer, narrower, and lighter, the bindings allow movement between the heel of the skier's boot and the ski, and the ski poles are longer than those used in Alpine skiing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-country skiing"@en .

aat:300239498 a skos:Concept ;
    skos:definition "Sport that evolved during the late 19th and early 20th centuries in the mountainous terrain of the Alps in central Europe. Modern Alpine skiing is competitive, divided into speed events (downhill skiing and the supergiant slalom, or super-G) and technical events (slalom and giant slalom)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alpine skiing"@en .

aat:300239499 a skos:Concept ;
    skos:definition "The act of guiding the movement of a vehicle or animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driving"@en .

aat:300239500 a skos:Concept ;
    skos:definition "For a person or bipedal animal, having the torso in an erect position supported by straight legs. For a quadrupedal animal, having the body supported by four straight legs. For an object, positioned in an erect, upright position, perhaps having the support of a base or stand, but without the support of a wall or other attached architectural element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standing"@en .

aat:300239504 a skos:Concept ;
    skos:definition "Detachable buttons with a shank or eye on the back that are inserted through one or more eyelets or buttonholes, usually in a garment, to serve as a fastener or ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studs"@en .

aat:300239507 a skos:Concept ;
    skos:definition "Fasteners made of two or more parts, often of metal, and consisting of separate interlocking hooking and catching elements that hold together two or more objects or complimentary parts of the same object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clasps"@en .

aat:300239662 a skos:Concept ;
    skos:definition "Games in which a ball is used in play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ball games"@en .

aat:300239663 a skos:Concept ;
    skos:definition "Athletic games played on a court with a ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court ball games"@en .

aat:300239666 a skos:Concept ;
    skos:definition "The action or practice of chasing, and usually killing, game or other wild animals, for sustenance, profit, or sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting"@en .

aat:300239937 a skos:Concept ;
    skos:definition "Areas of gardens or lawns demarcated from their surroundings and devoted to the cultivation of a particular group of plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beds"@en .

aat:300239965 a skos:Concept ;
    skos:definition "Any of various toothed devices used in handling or ordering textile fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combs"@en .

aat:300239984 a skos:Concept ;
    skos:definition "Structures at which a local toll or duty was collected, originally by towns and cities, later by monarchs, on certain goods that passed into their territories for local consumption by the inhabitants; found especially from the 17th to the 19th century in France and Italy. Term derives from the name of the tax itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octrois"@en .

aat:300239991 a skos:Concept ;
    skos:definition "Pastoral staffs in the Eastern Church, where the crosier terminates not in a crook but in a tau (T), the ordinary form of a crutch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taus"@en .

aat:300240013 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Hmong people centralized in scattered areas throughout China, Vietnam, Laos, and Thailand. Artistic production in this style features predominantly silver jewelry designs ranging from sliver chain necklaces with lock-shaped pendants attached to neck-rings, large collar necklaces covering the entire chest-area, heavy and narrow bracelets, to circle earrings that surround the ear, widening from narrow ends to a broad center, with pointed pendants hanging from tiny chains. Textile styles feature batik production characterized by geometric patterns on hemp and cotton, appliqué and reverse appliqué in bold colors, cold-dyed indigo, specific symbolic embroidery designs such as mustard blossom, cucumber seed, tiger teeth, and eye of the peacock, elaborate needlework, silk cocoon fibers, and flower and story cloth panel designs depicting village life, shaman's séances, legends and warfare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hmong"@en .

aat:300240021 a skos:Concept ;
    skos:definition "Concrete that is deposited in liquid form in the place where it is required to harden as part of a structure; for concrete that is cast and cured in other than its final location, use \"precast concrete.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cast-in-place concrete"@en .

aat:300240057 a skos:Concept ;
    skos:definition "Spaces set aside, as in museums, for the display of objects in a collection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galleries"@en .

aat:300240114 a skos:Concept ;
    skos:definition "Singles or doubles game played in a four-walled court with a long-handled strung racket and a small rubber ball. The game is played on the same principle as rackets, but in a smaller court and using a softer, slower ball."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squash"@en .

aat:300240132 a skos:Concept ;
    skos:definition "Describes copying processes that reproduce graphics materials through mechanical or electrical means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reprographic processes"@en .

aat:300240133 a skos:Concept ;
    skos:definition "Process of copying written or printed text or images by radio or telephone transmission for exact reproduction elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facsimile transmission"@en .

aat:300240142 a skos:Concept ;
    skos:definition "Process used especially for copying letters, invented in the 19th century, in which writing or drawing made with aniline dye is transferred to a prepared gelatin surface from which a number of copies can be made; eventually replaced by spirit duplicating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hectograph process"@en .

aat:300240160 a skos:Concept ;
    skos:definition "Diazo process in which heat alone is used to render the latent image visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal diazo process"@en .

aat:300240173 a skos:Concept ;
    skos:definition "Diazo process in which the diazonium salts are on the base and the latent image is developed by moistening with a liquid containing the coupler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moist diazo process"@en .

aat:300240192 a skos:Concept ;
    skos:definition "Two-component diazo process in which both the diazonium salts and the coupler are on the base, and development is achieved by neutralizing the acidic stabilizers with vapors derived from evaporating ammonia water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonia process"@en .

aat:300240203 a skos:Concept ;
    skos:definition "Copying process employing silver halides in which both a positive and a negative copy are produced simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffusion transfer reversal"@en .

aat:300240208 a skos:Concept ;
    skos:definition "Copying process that uses visible light from one band of the electromagnetic spectrum to form a latent image and infrared radiation to make the image visible on the copy paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dual spectrum process"@en .

aat:300240210 a skos:Concept ;
    skos:definition "Colorful, multilayered appliqué panels created by the Cuna Indians and usually applied to the front or back of women's blouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molas"@en .

aat:300240211 a skos:Concept ;
    skos:definition "Process for producing paper copies of microform originals, depending on electrolytic image formation on a special paper having metallic layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrolytic process"@en .

aat:300240216 a skos:Concept ;
    skos:definition "Process in which photographically produced dye images are physically transferred from a light-sensitive matrix to a receiving sheet; developed by Eastman Kodak Company and marketed with the trade names Verifax, Readyprint, and Ektalith."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelatin dye transfer process"@en .

aat:300240224 a skos:Concept ;
    skos:definition "Process used to duplicate maps and technical drawings employing a ferric salt to insolubilize a gelatin master selectively by light exposure, making the image areas receptive to ink. Allows production of exact copies having sharp lines in printing ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "true-to-scale process"@en .

aat:300240240 a skos:Concept ;
    skos:definition "Copying processes that employ heat, sometimes from infrared radiation, to form the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal copying"@en .

aat:300240259 a skos:Concept ;
    skos:definition "Term of convenience given to large, typically unseamed, coverlets with intricate patterns and elaborate borders woven with the use of a special mechanised loom attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacquard coverlets"@en .

aat:300240262 a skos:Concept ;
    skos:definition "Documents produced by facsimile transmission, which is a process by which fixed images are scanned, transmitted electronically, and reproduced at a distant location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faxes"@en .

aat:300240276 a skos:Concept ;
    skos:definition "Describes photographic procedures or techniques that create physical prints, generally from, but not always, a negative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic printing techniques"@en .

aat:300240277 a skos:Concept ;
    skos:definition "Any of the processes for making photographic prints that employ materials which yield a positive image when exposed to a positive and then processed, or a negative image when exposed to a negative and processed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autopositive printing"@en .

aat:300240365 a skos:Concept ;
    skos:definition "Earthen enclosures of relatively small size, usually circular and possibly serving as fortifications or chiefs' residences. Examples are found in Wales, Ireland, India, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raths"@en .

aat:300240367 a skos:Concept ;
    skos:definition "Without columns or pilasters or without the repetitive use of them in important locations or as influential elements of design; used especially with reference to facades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astylar"@en .

aat:300240727 a skos:Concept ;
    skos:definition "Parts or components of mosaics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosaic components"@en .

aat:300240903 a skos:Concept ;
    skos:definition "Providing a border or case to surround, support, enclose, or call attention to such items as a work of art, mirror, or document, leaving the item itself visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "framing"@en .

aat:300241088 a skos:Concept ;
    skos:definition "Compounds consisting of the chemical element lead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead compounds"@en .

aat:300241140 a skos:Concept ;
    skos:definition "Negatives produced by the dry collodion process, comprising several types developed between the mid-1850s and 1860s. These negatives were based on the same process as wet collodion negatives, but allowed for the plates to be prepared in advance, by adding a surface coating to the sensitized plates that kept the surface moist, extending the time between preparation and exposure. These plates required far longer exposure times and proved less popular that wet collodion negatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry collodion negatives"@en .

aat:300241444 a skos:Concept ;
    skos:definition "An alloy that consists of half copper and half aluminum; marketed as a form of master alloy that is used for making aluminum alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper-aluminum alloy"@en .

aat:300241507 a skos:Concept ;
    skos:definition "Describes groupings of discrete tangible or visual things that are inanimate and given form by human activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "object groupings"@en .

aat:300241513 a skos:Concept ;
    skos:definition "Describes groupings of functional and decorative moveable objects in dwellings, places or business, or other public or private spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnishings groupings"@en .

aat:300241516 a skos:Concept ;
    skos:definition "Describes groupings of armor piece sets designed as a whole to possess particular physical characteristics, usually to suit a particular purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor groupings"@en .

aat:300241552 a skos:Concept ;
    skos:definition "Describes groupings of objects affiliated with activities for leisure, entertainment, and pleasure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recreational artifact groupings"@en .

aat:300241557 a skos:Concept ;
    skos:definition "Refers to the process of assembling pieces of glass together by inserting their edges into cames, for example to form windows or lampshades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leading"@en .

aat:300241571 a skos:Concept ;
    skos:definition "Describes groupings of objects that augment or allow for the transfer of media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exchange media groupings"@en .

aat:300241583 a skos:Concept ;
    skos:definition "Constituent parts of a larger object. A component differs from an item in that the item can stand alone as an independent work but the component typically cannot or does not stand alone. Examples are a panel of a polyptych or a discrete architectural component such as a dome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "components"@en .

aat:300241615 a skos:Concept ;
    skos:definition "Metal or alloy that is not resistant to oxidation and corrosion in moist air; base metals are thus distinguished from \"noble metal.\" Base metals are also usually of minimum monetary value, and are thus commonly distinguished from \"precious metal\" as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base metal"@en .

aat:300241621 a skos:Concept ;
    skos:definition "Metal or alloy that is resistant to oxidation, corrosion, and dissolution by acids. Noble metals remain bright when heated in air. Examples of noble metals are gold, iridium, mercury, osmium, platinum, and ruthenium. In physics, noble metals are restricted to those having filled electronic d-bands: according to this definition in physics, only gold, silver, and copper are noble metals. Many noble metals are also precious metals, due to their rarity in the Earth's crust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noble metal"@en .

aat:300241913 a skos:Concept ;
    skos:definition "Small, usually compact, binoculars intended for indoor use, as at the opera, theaters, or concerts; includes those made with a detachable stick or handle for holding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opera glasses"@en .

aat:300241917 a skos:Concept ;
    skos:definition "Refers to tools, implements, vessels, or articles of furniture that are relatively small and are useful or necessary in a kitchen, dairy, or elsewhere in a household. It also refers to such items designed for use by an artisan, mechanic, or farmer, or used in the services of a church, temple, or other place of worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utensils"@en .

aat:300241926 a skos:Concept ;
    skos:definition "Combinations of material used for glass fabrication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassmaking mixtures"@en .

aat:300241953 a skos:Concept ;
    skos:definition "Parts or components of furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furnishings components"@en .

aat:300241986 a skos:Concept ;
    skos:definition "Cutting a raw block of glass that has not been previously cut to shape, using a rotating wheel fed with water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold cutting"@en .

aat:300241992 a skos:Concept ;
    skos:definition "Process of manufacturing glass vessels around a core of material made in the shape of the desired vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "core-forming"@en .

aat:300241994 a skos:Concept ;
    skos:definition "The activity of impressing official stamps (hallmarks) onto articles of gold and silver for security and decoration. Traditionally, hallmarks have been applied manually with steel punches. Laser hallmarking is used as an alternative, in particular to avoid bruising items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hallmarking"@en .

aat:300241997 a skos:Concept ;
    skos:definition "Solution of dilute acid, usually sulfuric acid, used for cleaning oxide or flux from silver or other metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickle"@en .

aat:300242002 a skos:Concept ;
    skos:definition "Condition where a surface or material has cracked due to pressure, differential in temperature, or other strain of some kind. An example is in glassmaking, where fissures develop in the body of a vessel caused by internal strain resulting from inadequate annealing and/or accidental thermal shock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strain cracking"@en .

aat:300242009 a skos:Concept ;
    skos:definition "Process of reheating glass after it has cooled in order to develop color or opacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking"@en .

aat:300242012 a skos:Concept ;
    skos:definition "Process of decorating glass in high relief by cutting away part of the glass between the body of a piece and its decoration, leaving an intervening open space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undercutting"@en .

aat:300242023 a skos:Concept ;
    skos:definition "Holes, slits, or loops through which a button is passed and by which it is secured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttonholes"@en .

aat:300242031 a skos:Concept ;
    skos:definition "Parts or components of systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "system components"@en .

aat:300242054 a skos:Concept ;
    skos:definition "Areas of responsibility in which activities are performed with a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-use functions"@en .

aat:300242079 a skos:Concept ;
    skos:definition "Concepts related to study of computation theory and computer design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer science concepts"@en .

aat:300242085 a skos:Concept ;
    skos:definition "Parts or components of protection systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protection system components"@en .

aat:300242112 a skos:Concept ;
    skos:definition "Soldering at lower than usual temperatures, typically between 130 and 180 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft soldering"@en .

aat:300242125 a skos:Concept ;
    skos:definition "Alloy of copper, nickel, and zinc, the nickel serving to enhance color. Uses include operations that require ductility in the cold state, such as stamping, spinning, deep drawing, and for articles to be plated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nickel silver"@en .

aat:300242126 a skos:Concept ;
    skos:definition "An alloy of 45% copper, 30% nickel, 24% zinc, and 1% iron, resembling German silver, first used by the ancient Chinese. It is light, hard and ideal for casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paktong"@en .

aat:300242127 a skos:Concept ;
    skos:definition "Lead alloy solder with tin, having a melting range usually between 130 and 180 degrees Celsius, with an upper limit of around 300 degrees Celsius; usually not used in soldering precious metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft solder"@en .

aat:300242137 a skos:Concept ;
    skos:definition "Silver metal assayed at better than 99.9% pure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine silver"@en .

aat:300242158 a skos:Concept ;
    skos:definition "Silver of the fineness legalized for coins; 90% fine in the United States, 50% fine in Great Britain since 1920."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coin silver"@en .

aat:300242239 a skos:Concept ;
    skos:definition "Narrow ridges or lines which indicate that an object has been made by molding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seam marks"@en .

aat:300242297 a skos:Concept ;
    skos:definition "Unglazed ceramic material that has been fired only once; generally producing a grainy texture; frequently used for modeling ornament or making small statues, dolls, or vessels. Distinct from \"parian (porcelain),\" which is silky in texture and marblelike in appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biscuit"@en .

aat:300242735 a skos:Concept ;
    skos:definition "Describes aggregates of objects that store and convey information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information artifact groupings"@en .

aat:300243189 a skos:Concept ;
    skos:definition "Buildings for any of a wide variety of museums where collections are amassed and typically presented to give a chronological perspective of the history of a city, town, region, group of people, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history museums"@en .

aat:300243201 a skos:Concept ;
    skos:definition "Describes structures devoted to the cultivation of plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horticultural buildings"@en .

aat:300243428 a skos:Concept ;
    skos:definition "Textile made from silk fiber, which is a fiber derived from the cocoon of the silkworm moth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silk"@en .

aat:300243430 a skos:Concept ;
    skos:definition "Textile made from the animal hair wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wool"@en .

aat:300243776 a skos:Concept ;
    skos:definition "Shorts popular in the late 1960s and early 1970s. Often made of luxurious fabrics, such as leather or suede, and sometimes made with straps or a bib."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot pants"@en .

aat:300243779 a skos:Concept ;
    skos:definition "Short whips, usually made of braided leather, used by equestrians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding whips"@en .

aat:300243788 a skos:Concept ;
    skos:definition "18th-century shaping garments consisting of a series of concentric hoops of whalebone or bamboo; worn to add fullness to a skirt. For bell-shaped shaping garments of whalebone or steel use \"cage crinolines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoops"@en .

aat:300243839 a skos:Concept ;
    skos:definition "Describes buildings housing museums that specialize in the history, objects, vehicles, and other materials associated with transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation museums"@en .

aat:300243843 a skos:Concept ;
    skos:definition "Dresses intended for formal or semiformal evening occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening dresses"@en .

aat:300244025 a skos:Concept ;
    skos:definition "Textile styles after Manzikert belonging to Anatolian Islamic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian Islamic textile styles after Manzikert"@en .

aat:300244027 a skos:Concept ;
    skos:definition "Rugs woven in the Beliksir area of northwestern Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balikesir"@en .

aat:300244056 a skos:Concept ;
    skos:definition "Several types of floor coverings handwoven at Bandirma, a town in Turkey on the southern shore of the Sea of Marmora, usually as imitations of Ghiordes prayer rug designs. The enterprise was begun in the early 20th century, perhaps with weavers from Ghiordes, although it is usually described as an Armenian establishment. The rugs are characterized by overly elaborate areas, such as the sides of the prayer-niche design, and a differing color range from the originals they imitate, including pastel shades and opaline effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bandirma"@en .

aat:300244058 a skos:Concept ;
    skos:definition "Style of textiles, particularly village floor coverings, that are handwoven in the vicinity of Bergama, western Turkey, or brought there for market from the interior of the country. Although most Bergama carpets date from the 19th and 20th centuries, rare examples survive from the 17th century. They are characterized by bold, highly varied patterns often in red, blue, and white. Typical designs include rows of panels or central medallion designs, preserving the fashions of much earlier centuries. The format of Bergama carpets is usually more nearly square than other Turkish types, and the few known prayer rugs tend to be unusually small. The red dye used in this area sometimes causes the pile to erode and look as if it had been cut in relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bergama"@en .

aat:300244064 a skos:Concept ;
    skos:definition "Textile styles after the Mongols belonging to Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian textile styles after the Mongols"@en .

aat:300244065 a skos:Concept ;
    skos:definition "Textile styles after the Mongols belonging to Central Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Persian textile styles after the Mongols"@en .

aat:300244066 a skos:Concept ;
    skos:definition "Textile styles after the Mongols belonging to Northeast Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northeast Persian textile styles after the Mongols"@en .

aat:300244067 a skos:Concept ;
    skos:definition "Textile styles after the Mongols belonging to South Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Persian textile styles after the Mongols"@en .

aat:300244068 a skos:Concept ;
    skos:definition "Textile styles after the Mongols belonging to West Persian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Persian textile styles after the Mongols"@en .

aat:300244079 a skos:Concept ;
    skos:definition "Styles after Manzikert belonging to Anatolian Islamic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian Islamic styles after Manzikert"@en .

aat:300244080 a skos:Concept ;
    skos:definition "Pottery styles after Manzikert belonging to Anatolian Islamic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian Islamic pottery styles after Manzikert"@en .

aat:300244089 a skos:Concept ;
    skos:definition "Style of textiles, particularly carpets, from the area of İsparta, Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isparta"@en .

aat:300244097 a skos:Concept ;
    skos:definition "Style of textiles, particularly floor coverings, handwoven in imperial workshops founded late in the 19th century at Hereke, Turkey, east of Istanbul. Large carpets and prayer rugs with pile of wool or silk were for palace use and for gifts presented by the sultan. Antique carpets of various kinds were copied or patterns were created following Western fashions. Usually a tiny cartouche hidden in the design identifies the carpet's origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hereke"@en .

aat:300244099 a skos:Concept ;
    skos:definition "Style of textiles, particularly handwoven floor coverings, usually in a prayer design and made in Kırşehir, a town between Ankara and Kayseri in central Turkey. The typical Kirsehir prayer rug of the 19th century has an elaborately stepped arch above a prayer-niche design, often fringed with tiny carnations in profile and with a smaller, concentric niche similarly outlined but having a contrasting color. The color scheme mya include rich cherry red, yellow, violet, light blue, prominent greens, terra-cotta, and black-brown. Some of the later rugs show influence of the French Empire style, and the palette was altered by the use of harsher aniline dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kirsehir"@en .

aat:300244116 a skos:Concept ;
    skos:definition "Transparent positive photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic transparencies"@en .

aat:300244118 a skos:Concept ;
    skos:definition "Style of textiles, particularly handwoven floor coverings, usually in a prayer design and made in or near Lâdik, a town in the Konya Plain of south-central Turkey. Ladik prayer rugs have either a high, stepped arch design or a triple arch with a dominating central portion. In a separate panel above or below the prayer-niche motif, a group of five or more flower stalks project upward from a band of crenellation. Although a few date to the late 18th century, most Ladik carpets were made in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ladik"@en .

aat:300244119 a skos:Concept ;
    skos:definition "Style of textiles, particularly floor coverings, handwoven in the neighborhood of Melas, southwestern Turkey, on the Aegean coast. The rugs are characterized as being usually of small size, dating from the 19th century, and having unusually wide borders in relation to their narrow fields. In the prayer rugs, the arch (which indicates the direction of Mecca, the holy city) is straight-sided, with a triangular indentation below it on each side, the local reminiscence of a lobed-arch form used in the Ottoman court prayer rugs of the 16th and 17th centuries. The color scheme is unique among similar carpets: the field is usually a strong red, with yellow and violet together with a light blue that is quite variable owing to uneven dyeing. Examples that predate the use of chemical dyes are considered to be among the most attractive Turkish carpets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Milas"@en .

aat:300244120 a skos:Concept ;
    skos:definition "Style of textiles, particularly floor coverings and prayer rugs, made in or associated with Mudjar, a village near Kirsehir in central Turkey. The rugs are characterizsed by usually having a deep border, an arch motif, and similar to desings of medieval stained-glass windows of European churches. The characteristic design in older examples, from the 19th century, is a prayer niche with a stepped arch crowned by a little turret form that is echoed in the crenellations of a narrow cross panel above. The niche is soft red, pale yellow, or green and may contain a skeleton tree or be perfectly plain except for an edging of small triangular indentations. The green spandrels (spaces between the exterior curves of the arch and the enclosing right angle) display stylized ewers. The broad stripe of the border is composed of varicoloured, carefully detailed squares, reminiscent of tilework, and the soft-blue inner stripe has a diamond pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mujur"@en .

aat:300244122 a skos:Concept ;
    skos:definition "Style of rug and other textiles from the area of Sivas, a city in central Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sivas"@en .

aat:300244124 a skos:Concept ;
    skos:definition "Generally, a style of textiles, particularly large, coarse carpets handwoven in western Anatolia and exported by way of Izmir (ancient Smyrna). Such carpets originally represented the production of the town of Usak, but in the late 19th and early 20th centuries large carpets from other centers were also called Smyrna, including those from Ghiordes, Kula, and Demirci. Specifically, the term refers to a particular pattern, usually seen in small examples and derived from a floral pattern used in the Ottoman court production of the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Smyrna"@en .

aat:300244125 a skos:Concept ;
    skos:definition "Style of textile, particularly carpets, made in the town of Ushak, the principal manufacturing center of large commercial carpets in Ottoman Turkey. It includes rugs created for palace and mosque use and for export. By the close of the 19th century the style had become coarser and rougher, with designs calculated to please European tastes. The best-known pattern among the older carpets is a scheme of large, rounded medallions of two types, alternating upon a field of brick red or dark blue. A second common pattern shows diagonal rows of eight-pointed star medallions alternating with diamonds. In the 18th and 19th centuries, a number of carpets with prayer-niche motifs in rows were made for mosque worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ushak"@en .

aat:300244126 a skos:Concept ;
    skos:definition "Styles after the Mongols, belonging to Iranian Islamic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iranian Islamic styles after the Mongols"@en .

aat:300244127 a skos:Concept ;
    skos:definition "Painting styles after the Mongols, belonging to Iranian Islamic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iranian Islamic painting styles after the Mongols"@en .

aat:300244128 a skos:Concept ;
    skos:definition "Pottery styles after the Mongols, belonging to Iranian Islamic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iranian Islamic pottery styles after the Mongols"@en .

aat:300244133 a skos:Concept ;
    skos:definition "Generally, the style and culture of the Bakhtiari ethnic group occupying the plains and mountains in western Iran; they are one of the nomad peoples of Iran whose chiefs have been among the greatest tribal leaders in Iran and have long been influential in Persian politics. Specifically, the textiles, particularly rugs, produced under the influence of the Bakhitiari people in certain villages southwest of Esfahan in central Iran. Bakhtiari rugs are symmetrically knotted on a foundation of cotton, with bold coloring and patterns. The field is usually divided into compartments that may be rectangular or produced by an ogival lattice. Occasionally there are tree or medallion decorative schemes. The palette tends to be darker than is found on most Iranian rugs, with much use of yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bakhtiari"@en .

aat:300244134 a skos:Concept ;
    skos:definition "Style of textiles, particularly rugs, handmade in the village of Joshaqan, north of Esfahan in central Iran. A great variety of rugs has been attributed by various writers to this small place, including Kerman vase carpets, other silk rugs, and rugs with pronounced Kurdish characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Joshaghan"@en .

aat:300244136 a skos:Concept ;
    skos:definition "Style of textiles, primarily silk, created since Sasanian times in and around the city of Yazd, Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yazd"@en .

aat:300244137 a skos:Concept ;
    skos:definition "Style of handwoven floor coverings made in the region of Khorasan, in northeastern Iran, including the classic Herat carpets. From the late 18th and early 19th centuries there are carpets in the herati pattern, probably made in villages of the district. They show a repeat pattern of a lattice that peeps through a maze of blossoms and leaves, with a characteristic border showing pairs of smoothly curved split arabesques. These carpets are usually woven in jufti asymmetrical knotting (upon four warps) on a cotton foundation. The designs of room-sized carpets made in Meshed (Mashhad), Birjand, and villages nearby are characterized by medallions that are often unusually round, grounds that revive the coiling stems of the Herat classic carpets, and borders that show an unusual number of narrow stripes. Most of these carpets, too, are jufti knotted. Reds are dyed with cochineal, which, with the significant amount of blue used in the rugs, gives the carpets a purplish cast. The combination of soft wool and the inadequacies of construction has reduced their durability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khorasan"@en .

aat:300244142 a skos:Concept ;
    skos:definition "Generally, the style and culture of the nomadic Afshar tribe in southeast Iran. Specifically, the style of textiles, particularly rugs, handwoven by the Afshar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afshar"@en .

aat:300244146 a skos:Concept ;
    skos:definition "Term is used by dealers to designate the most choice examples of Kerman carpets, referring to the weaving village of Ravar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ravar"@en .

aat:300244147 a skos:Concept ;
    skos:definition "The style term used specifically for carpets made by the Lur people. For the more general style and culture of the Lur people, use \"Lur (general style and culture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lori"@en .

aat:300244148 a skos:Concept ;
    skos:definition "Generally, the style and culture of a Turkic-speaking people living around Shiraz in Persia. Specifically, a style of carpets handwoven by the Qashqa'i people, who have the reputation of making the best rugs from the Shiraz district of Iran. The coloring of the carpets employs rich blues and reds, with limited use of golden yellow. Usually the designs are geometric, sometimes with a row of three diamond medallions against a background replete with tiny forms of all kinds, including stylized animals and birds. The designs are often based on Persian urban sources. The carpets are asymmetrically knotted on an all-wool foundation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qashqai"@en .

aat:300244151 a skos:Concept ;
    skos:definition "Style of textile, particularly carpets, from Arak (formerly Sultanabad), Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arak"@en .

aat:300244152 a skos:Concept ;
    skos:definition "Style of textiles, particularly floor coverings, from the Farahan district, northeast of Arak in western Iran, produced in the 19th or early 20th century. Ferahan rugs are prized for sturdy construction and design, most having a dark blue ground showing an endless repeat of the herati design, in which a diamond lattice peeps through a tangle of blossoms and leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feraghan"@en .

aat:300244156 a skos:Concept ;
    skos:definition "Style of textiles, particularly rugs, produced in and near the town of Hamadan in northwest Iran. Rugs of this area are characterized by considerable variety; several generations ago many of these rugs were traded through Mosul and consequently were known as Mosul rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamadan"@en .

aat:300244157 a skos:Concept ;
    skos:definition "Style of textile, particularly carpets, handmade in any of a group of villages near the town of Heriz, lying east of Tabriz in northwest Iran. Heriz carpets are often room-sized, stout, serviceable, and attractive to markets in Europe and the United States. They are apparently an offshoot of the Tabriz carpets, a country version of city styles. The smooth curves and flowing lines of a sophisticated Tabriz medallion system are translated into hard, geometric angles and broken contours. Repeat patterns occur less frequently, and a jagged vine and rosette border is characteristic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heriz"@en .

aat:300244158 a skos:Concept ;
    skos:definition "Style of textiles, particularly carpets, from the area around Karaja and the nearby range of Karadagh mountains in northwestern Iran, just south of the Azerbaijan border northeast of Tabriz. The carpets are thick, woollen and knotted with either a geometrical or a floral pattern. The best-known pattern shows three geometric medallions that are similar to those in Caucasian carpets; the central medallion has a latch-hooked contour and differs in color from the others, which are eight-pointed stars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karadagh"@en .

aat:300244159 a skos:Concept ;
    skos:definition "Style of textiles, particularly carpets, handwoven by Kurds in the vicinity of the village of Bijar in western Iran, and characterized by their weight, sturdiness, and remarkable stiffness and resistance to folding. Woven on a woolen foundation in the symmetrical knot, these carpets are said to be double-warped. This refers to the way the warps are strung closely together, and alternate weft shoots are pulled so tight that the warp lies on two levels, one almost precisely behind the other. The structure is unusual in that the weft is passed three times between rows of knots. This is also a Kerman characteristic. Many Bijar carpets have clumsy medallion decorative schemes in which the medallion and corners are ornamented but the balance of the field remains a solid red or yellow. Other examples show repeat patterns, including the herati, in which a diamond lattice peeps through a tangle of stylized flowers. From Bijar come a remarkable number of vagirehs, or weavers' samples used as models for large carpets, that show portions of several patterns and borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bijar"@en .

aat:300244161 a skos:Concept ;
    skos:definition "Style of textiles, particularly a variety of sophisticated, finely-woven Persian rugs, made by Kurds in and around the city of Sanandaj (formerly usually spelled Sehna), Iran. The Sehna pile rugs and kilims are prized for their delicate pattern, coloring, and fine weave. The designs usually use a repeat pattern (diaper) such as the herati, in which a diamond lattice pattern peeps through a tangle of blossoms and leaves or through intricate versions of the boteh, a leaf with curling tip. The entire field may show such a pattern, or a medallion scheme may introduce a hexagonal centerpiece and straight-arched ends. The borders are full of fine detail, often featuring paired arabesques known in the trade as \"turtles.\" The finely woven Sehna kilims are slit tapestries of the highest quality. Their small-scale borders are carried around the ends, as they are typically in pile carpets but rarely in such weavings. Sehna also manufactured saddle cloths, those in pile usually provided with a two-slope arch. Although the town of Sehna has given its name to the asymmetrical Persian knot (see \"asymmetrical knots\"), it is the Turkish, or symmetrical, knot, that is actually used there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sehna"@en .

aat:300244164 a skos:Concept ;
    skos:definition "Style of textile, particularly a type of coarse-woven carpet made in Maḥallāt and villages near Arak in Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahal"@en .

aat:300244170 a skos:Concept ;
    skos:definition "Style of carpets produced in the village of Sarāb, Iran; this is the name under which a particular phase and subvariety of Heriz carpet production was sold in the West. It is characterized by a light, rather bright color scheme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarab"@en .

aat:300244189 a skos:Concept ;
    skos:definition "Style of textiles, particularly floor coverings, handwoven in the village of Saruq, north of Arak in western Iran. The early carpets are characterized as being of very good quality and having short pile and a variety of designs. The medallion decorative schemes that were introduced in the early 20th century are sometimes awkward. Saruk carpets that were produced on a large commercial scale are characterized by a longer pile and rose-colored fields filled with disconnected floral sprays and plant forms. Saruk carpets are asymmetrically knotted on a cotton foundation. Mahal and Muskabad are trade names for village carpets of varying quality that come from the neighborhood of Arak."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarouk"@en .

aat:300244196 a skos:Concept ;
    skos:definition "Style of textiles, particularly floor coverings handwoven in the Sarāband area, southwest of Arak in west-central Iran. The rugs are characterized as dating from the 19th and early 20th centuries, being of sturdy construction, and having a distinctive pattern known commercially as the \"mir\" design, which comprises small, complex leaf (boteh) or leaf forms in diagonal rows with tips pointed alternately in opposite directions. A geometric vine with similar leaf forms usually occupies the principal border stripe. There may be geometric cornerpieces or a small, similarly geometric central medallion. The ground is red, dark blue, or ivory; the knotting is symmetrical on a cotton foundation. Large Seraband rugs are narrower than room dimension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seraband"@en .

aat:300244198 a skos:Concept ;
    skos:definition "Rugs woven by the nomadic Shahsavan of Northwestern Iran, typically wool-on-wool, symmetrically knotted pile rugs, characterized by relatively simple field and border designs, occasional use of camel hair in the pile and cotton in the wefts, and red and salmon color in the wefts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shahsavan"@en .

aat:300244289 a skos:Concept ;
    skos:definition "Describes groupings of cloth coverings draped on the body that are stylistically Spanish-American."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish-American wearing blankets"@en .

aat:300244290 a skos:Concept ;
    skos:definition "Describes groupings of cloth coverings produced and worn by individuals of Native American descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native American wearing blankets"@en .

aat:300244358 a skos:Concept ;
    skos:definition "Term formerly used for a variety of bedcovers, especially those woven of cotton or wool; from the mid-19th century onwards generally replaced by the term \"bedspreads.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterpanes"@en .

aat:300244387 a skos:Concept ;
    skos:definition "Cloth cases, usually of ticking, for a bolster, mattress, or pillow, containing feathers, hair, straw, or other materials used for stuffing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ticks"@en .

aat:300244536 a skos:Concept ;
    skos:definition "Refers to the people, styles, and cultures originating in the general Caucasus region, which is the area between the Black and Caspian Seas, surrounding the Caucasus mountains, comprising roughly the modern nations of Georgia, Armenia, Azerbaijan, southern parts of Russia, and northeastern Turkey. It refers specifically to the Indo-European and Turkic cultures that have occupied the area since around the first millennium BCE. It takes its name from the Caucasus tribes that settled here; was home to Milesian Greeks, subsequently was invaded numerous times; legendary site of Jason's quest for Golden Fleece; the Caucasus mountains have traditionally been the boundary separating Europe from Asia; however, the area is more subject to Asian influence and so is more often grouped with Asia in modern scholarship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caucasian"@en .

aat:300244537 a skos:Concept ;
    skos:definition "Textile styles belonging to Caucasian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caucasian textile styles"@en .

aat:300244538 a skos:Concept ;
    skos:definition "Textile styles belonging to Central Caucasian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Caucasian textile styles"@en .

aat:300244539 a skos:Concept ;
    skos:definition "Textile styles belonging to East Caucasian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Caucasian textile styles"@en .

aat:300244540 a skos:Concept ;
    skos:definition "Textile styles belonging to South Caucasian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Caucasian textile styles"@en .

aat:300244542 a skos:Concept ;
    skos:definition "Painting styles belonging to East Turkestani cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Turkestani historic painting styles"@en .

aat:300244546 a skos:Concept ;
    skos:definition "Refers to the culture and styles of West Turkestan, which covered present-day Turkmenistan, Uzbekistan, Tajikistan, Kyrgyzstan, and the southern part of Kazakhstan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Turkestani"@en .

aat:300244555 a skos:Concept ;
    skos:definition "Historic painting styles belonging to West Turkestani cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Turkestani historic painting styles"@en .

aat:300244556 a skos:Concept ;
    skos:definition "Historic textile styles belonging to West Turkestani cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Turkestani historic textile styles"@en .

aat:300244567 a skos:Concept ;
    skos:definition "Quilts pieced from thousands of squares or rectangles the size of postage stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postage stamp quilts"@en .

aat:300244578 a skos:Concept ;
    skos:definition "Refers to a class of manufactured articles, generally of utilitarian type, usually specified by its material, use, style name, or other characteristic, such as ceramic ware or kitchenware. In archaeology, refers to distinct groups of pottery types classified according to characteristics of temper, hardness, type of paste, and surface treatment, rather than by shape or decoration, such as Kamares ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ware"@en .

aat:300244657 a skos:Concept ;
    skos:definition "Style of handmade thick knotted carpets or rugs, usually with a floral but occasionally an animal pattern, originating in the Karabakh region, in modern southwestern Azerbaijan and eastern Armenia, just north of the present Iranian border. Karabagh designs and color tend to be more like those of Persian rugs than do those made in other parts of the Caucasus; they may be very similar to designs of Karaja, Iran. Certain Karabagh rugs also resemble those of Shirvan to the north in Azerbaijan. They are characterized as being typically stout and comparatively coarse, made of wool and have longer pile than rugs found elsewhere in Caucasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karabagh"@en .

aat:300244674 a skos:Concept ;
    skos:definition "Style of handwoven floor coverings made in the vicinity of Baku, Azerbaijan, a major port on the Caspian Sea. Rugs have been woven in this area since at least the 18th century and probably long before, although it is difficult to determine which were woven in the city and which in such nearby villages as Surahani and Chaildag. The so-called Chila rugs were almost certainly woven in this area. The earliest examples are larger than most Caucasian rugs, ranging up to 12 feet in length (3.6 metres). Most of these rugs have a blue field, and characterized by either an avshan (scattered floral sprig) or harshang (crab) design. Examples from later production may have some cotton in the wefts and are more likely to show a boteh (pear-shaped motif) design, often with a small medallion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baku"@en .

aat:300244676 a skos:Concept ;
    skos:definition "Style of textiles with geometric designs, particularly rugs, originating in the Dagestan region of the eastern Caucasus in present-day Russia. Dagestan rugs are usually small, finer than the Kazakh types, but less fine than rugs from the vicinity of Kuba to the south. While many of the rugs are called \"Derbent,\" referring to a major collecting point, much of the weaving has occurred to the south in villages around Ortasal and Kasumkent. Dagestan rugs of the 19th and early 20th century tend to use blue over red and are more likely to be all wool than the Kuba rugs from neighbouring Azerbaijan. Edges are also more likely to be of blue wool, and the backs of many of these rugs appear ribbed. Rugs marketed under the name \"Zeykhur\" were woven in the Tabarasan district, and many show unusual qualities of color, such as the use of pink and deep red in juxtaposition, and floral designs based on European sources. During the mid-20th century a type of Shirvan prayer rug with an ivory field and lozenge-shaped compartments of stylized flowers was mistakenly called \"Dagestan.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dagestan"@en .

aat:300244678 a skos:Concept ;
    skos:definition "Style of textile, particularly carpets, made in the city of Derbent, Dagestan, in southwestern Russia. Carpets are typically characterized by the use of fine-spun yarn and short pile, with the two wefts between each row of knots being barely visible on the back of the carpet. Many, often complementary, colors are used, with blue being the most common. Motifs are quasi-representational and of graduated sizes, and patterns are intricate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Derbent"@en .

aat:300244687 a skos:Concept ;
    skos:definition "Caucasus floor coverings woven in the vicinity of Quba in northern Azerbaijan, with major varieties woven near the towns of Perepedil, Divichi, Konaghend, Zejwa, Karagashli, and Kusary. They are as a group the most finely knotted Caucasian rugs. The Perepedil shows a highly geometrized floral design on a blue or ivory field. The Konaghend most frequently features a large central medallion. The Karagashli usually contains isolated elements from the Persian avshan \"sprig\" or harshang \"crab\" designs. The most common type of large, red-field Caucasian soumak rug was woven in the nearby town of Kusary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuba"@en .

aat:300244698 a skos:Concept ;
    skos:definition "Style of textiles, particularly short-napped rugs or carpets, from the region of Shirvan, Azerbaijan in the southeastern Caucasus. With the exception of a group of rugs woven in the vicinity of Baku, most Shirvan rugs are small, with examples from the southern part of the area around the town of Saliani more likely to be in the long, narrow format described in the West as runners. The area around Maraza has produced many prayer rugs, including a well-known type with boteh (leaf-shaped) figures on a blue field. Most small Shirvan rugs are not specifically identifiable as to village source, as they share a range of geometric field designs and borders. They are generally less finely woven than rugs from farther north in the Kuba district, although they are finer than the Kazakh-type rugs made in western Azerbaijan. Shirvan rugs are usually all wool, but some may show cotton wefts and cotton edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shirvan"@en .

aat:300244701 a skos:Concept ;
    skos:definition "Style of textiles, primarily carpets, from the city and plain of Lenkoran, in southeastern Azerbaijan on the shore of the Caspian Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lenkoran"@en .

aat:300244702 a skos:Concept ;
    skos:definition "Style of floor covering handwoven in Azerbaijan in or near the city of Genje and characterized by simple, angular designs and saturated (intense) colors of blue, dark blue, and madder red. Genje carpets most often have designs composed of octagons, stars, or three geometric medallions arranged on the carpet's longitudinal axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Genje"@en .

aat:300244708 a skos:Concept ;
    skos:definition "Style of textile, particularly carpets, from the area of Moghan, now in Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moghan"@en .

aat:300244709 a skos:Concept ;
    skos:definition "Style of textiles, particularly carpets, from the area of the Talish Mountains of Iran and Azerbaijan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Talish"@en .

aat:300244761 a skos:Concept ;
    skos:definition "Refers to stools, which are armless and backless seats for one person, characterized by often having a cloth or leather seat and a frame that may be folded or collapsed for transportation or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding stools"@en .

aat:300244770 a skos:Concept ;
    skos:definition "Chairs that are lightweight, portable, and can be folded flat for storage, typically made of wood, metal, or canvas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding chairs"@en .

aat:300244782 a skos:Concept ;
    skos:definition "Historic textile styles belonging to East Turkestani cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East Turkestani historic textile styles"@en .

aat:300244785 a skos:Concept ;
    skos:definition "Style of Turkoman carpet from Yarkand (Shache) in Xinjiang, China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yarkand"@en .

aat:300244813 a skos:Concept ;
    skos:definition "Style of handwoven floor covering that was once marketed through the ancient city of Samarkand in Uzbekistan, but is actually produced by Kyrgyz or Uzbek tribeswomen or in the towns of Khotan (Hotan), Kashgar, and Yarkand in Xinjiang, China. Except for their coloring, the general effect of these rugs is more Chinese than Middle Eastern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samarkand"@en .

aat:300244838 a skos:Concept ;
    skos:definition "Historic styles belonging to West Turkestani cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Turkestani historic styles"@en .

aat:300245048 a skos:Concept ;
    skos:definition "Textile styles belonging to Uzbek cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uzbek textile styles"@en .

aat:300245050 a skos:Concept ;
    skos:definition "Style of textile, particularly carpets, from Bukhara, a district now in south-central Uzbekistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bukhara"@en .

aat:300245255 a skos:Concept ;
    skos:definition "Style and culture of the nation of Morocco or its historical counterparts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moroccan"@en .

aat:300245277 a skos:Concept ;
    skos:definition "A style and culture in the Glaoua area of the High Atlas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ouarzata"@en .

aat:300245281 a skos:Concept ;
    skos:definition "Style and culture of the Zaiane tribal area of Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zaiane"@en .

aat:300245284 a skos:Concept ;
    skos:definition "The style and culture of the city of Marrakech, the chief city of central Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marrakech"@en .

aat:300245290 a skos:Concept ;
    skos:definition "Generally refers to the style and culture of the Chiadma ethnic group in Morocco, who dwell mainly on the Atlantic coast between Safi and Essaouira. Specifically, may refer to a style of pile rug by the Chiadma tribal weavers noted for a unique mixture of medallions, borders, and motifs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiadma"@en .

aat:300245311 a skos:Concept ;
    skos:definition "Generally, the style and culture of the tribal area and city of Chichaoua, located west of Marrakesh. Specifically, a style of carpet produced in the Haouz plains surrounding Marrakesh, characterized by a large size (2.2 x 5.5 m maximum), and having overlapping rows of coarse symmetrical knots with red grounds and sombre decoration of triangles, squares or even figures in green, browns or orange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chichaoua"@en .

aat:300245313 a skos:Concept ;
    skos:definition "Generally, the style and culture of the Rehamna ethnic group in Morocco. Specifically, the style of carpets produced by the Rehamna tribal weavers, noted for unique free-form designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rehamna"@en .

aat:300245314 a skos:Concept ;
    skos:definition "Generally, the style and culture of the people of the tribal area and town of Mediouna, near Casablanca. Specifically, the style of rugs from this area, distinguished from rugs originating in a nearby urban carpet center, Rabat, in having fewer minor borders and a wider field than Rabat rugs, and having three or more octagonal medallions on the field. Traditional Mediouna rugs are no longer woven, but the style is copied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mediouna"@en .

aat:300245316 a skos:Concept ;
    skos:definition "Generally, the style and culture of the people of the tribal area and town of Mediouna, near Casablanca. Specifically, the style of rugs from this area, distinguished from rugs originating in a nearby urban carpet center, Rabat, in having fewer minor borders and a wider field than Rabat rugs, and having three or more octagonal medallions on the field. Traditional Mediouna rugs are no longer woven, but the style is copied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rabat"@en .

aat:300245324 a skos:Concept ;
    skos:definition "Generally, style and culture of the area near the city of Kairouan, Tunisia. Specifically, the style of rugs from this area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kairouan"@en .

aat:300245351 a skos:Concept ;
    skos:definition "Refers to the culture and style, including glass, enamel, and rugs, centered in Peking (Beijing)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peking"@en .

aat:300245352 a skos:Concept ;
    skos:definition "Textile styles belonging to Chinese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese textile styles"@en .

aat:300245354 a skos:Concept ;
    skos:definition "Capacious vessels for beer or ale usually of tar-coated leather, dating from the Medieval."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackjacks"@en .

aat:300245366 a skos:Concept ;
    skos:definition "Refers to the style of carpets manufactured in Northwest China in the 19th century. The style is characterized by knotting with four-ply wool and simple floral decorations, typically lotus flowers and promegranates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ningxia"@en .

aat:300245373 a skos:Concept ;
    skos:definition "Refers to the style of carpet manufactured inthe Suiyuan region of China during the 19th century. The style is characterized by motifs such as clouds, floral elements, and the shou, the symbol of longevity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pao-t'ou"@en .

aat:300245375 a skos:Concept ;
    skos:definition "Refers to the style of carpet manufactured in the Suiyuan province of Inner Mongolia in China. The style is characterized by all-over repeating patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suiyuan"@en .

aat:300245381 a skos:Concept ;
    skos:definition "Refers to the style of carpet produced in the Tientsin region of China since the 20th century. The style is characterized by the \"closed back\" technique of weaving in which the pile is constructed of five strands of machine-spun wool and is to be found in three thicknesses: 0.36 inches, 0.5 inches, and 0.62 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tientsin"@en .

aat:300245450 a skos:Concept ;
    skos:definition "Textile styles belonging to Mughal cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mughal textile styles"@en .

aat:300245452 a skos:Concept ;
    skos:definition "Feraghan style carpets made in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-Feraghan"@en .

aat:300245460 a skos:Concept ;
    skos:definition "Textile styles belonging to Indian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian textile styles"@en .

aat:300245462 a skos:Concept ;
    skos:definition "Style of textiles, particularly carpets, of the region of Agra in the west-central Uttar Pradesh state, north-central India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agra"@en .

aat:300245463 a skos:Concept ;
    skos:definition "Style of carpets and other textiles characteristic of the city of Amristar, located in northern Punjab state, northwestern India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amritsar"@en .

aat:300245464 a skos:Concept ;
    skos:definition "Style of carpets and other textiles produced in India as an imitation or interpretation of Persian Sarouk rug or carpet style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-Sarouk"@en .

aat:300245465 a skos:Concept ;
    skos:definition "Indian carpet and textile style that is an interpretation of Turkoman style from the historic West Turkestani region, typically with an overall repeating geometric medallion design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-Turkoman"@en .

aat:300245473 a skos:Concept ;
    skos:definition "Style of carpet and textile design from the area of Demirci, Anatolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Demirci"@en .

aat:300245499 a skos:Concept ;
    skos:definition "Style and culture of the Kurds, an ethnic and linguistic group living in the Taurus Mountains of eastern Anatolia, the Zagros Mountains of western Iran, portions of northern Iraq, Syria, and Armenia, and other adjacent areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kurdish"@en .

aat:300245512 a skos:Concept ;
    skos:definition "Style and culture of carpets and textiles characteristic of Tabriz, a city in northwestern Iran, that traditionally incorporate a rich decorative medallion pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tabriz"@en .

aat:300245524 a skos:Concept ;
    skos:definition "Handwoven rugs with pile in loops, made in Spain in the Alpujarras district south of Granada and elsewhere in Andalusia and Castile. The foundation is of linen, and the coarse woolen pile material runs along with the weft, each color pulled up above the surface in loops as needed in the design. It has about 20 loops per square inch. This technique may have been in use in the area for a long time, but surviving examples probably do not date before the 18th century. The patterns can be described as folk art and the colors, usually two but as many as ten, are strong. The Alpujarra's origins are probably Moorish. The construction of these rugs makes them more suitable for bedspreads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alpujarras"@en .

aat:300245525 a skos:Concept ;
    skos:definition "Style of textiles handwoven at the city of Cuenca, Spain (located between Madrid and Valencia), especially floor coverings from the 17th and 18th centuries. Carpets are generally coarser and heavier bodied than Alcaraz carpets, with a foundation of bast fibre. In later examples the symmetrical knot may be used instead of the Spanish knot, which encircles only a single warp. Usually the color range is limited and muddy, as if several hues had proved fugitive; later rugs may show bold coloring. A good red dye did not appear in these rugs until the 18th century, when a bright cherry red was sometimes used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cuenca"@en .

aat:300245805 a skos:Concept ;
    skos:definition "Weaving process in which no pile, hand-knotting, or hand-tufting is used, typically with reference to rugs, towels, or other textiles that typically may be expected to have a pile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-woven"@en .

aat:300245935 a skos:Concept ;
    skos:definition "Tools with a sharp edge and used for reducing, leveling, and smoothing wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leveling planes"@en .

aat:300246010 a skos:Concept ;
    skos:definition "Electrical appliances for cleaning objects or surfaces by suction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum cleaners"@en .

aat:300246035 a skos:Concept ;
    skos:definition "Seating furniture designed for young people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's chairs"@en .

aat:300246087 a skos:Concept ;
    skos:definition "Fixed standard sizes of card photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card photographs sizes"@en .

aat:300246089 a skos:Concept ;
    skos:definition "A size of card photograph on a mount measuring 8 1/2 by 5 1/2 or 8 1/4 by 5 inches; popular from the 1870s to 1890s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boudoir"@en .

aat:300246094 a skos:Concept ;
    skos:definition "A size of card photograph on a mount measuring about 7 by 10 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial"@en .

aat:300246102 a skos:Concept ;
    skos:definition "A size of card photograph measuring about 4 by 8 inches on a mount measuring 7 1/2 by 13 inches or larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel"@en .

aat:300246108 a skos:Concept ;
    skos:definition "A size of card photograph on a mount measuring about 7 by 4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promenade"@en .

aat:300246118 a skos:Concept ;
    skos:definition "A size of card photograph on a mount measuring about 3 1/2 by 5 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "victoria"@en .

aat:300246172 a skos:Concept ;
    skos:definition "Describes copying processes that employ light-reactive chemicals or electronics to reproduce graphic materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light-sensitive reprographic processes"@en .

aat:300246214 a skos:Concept ;
    skos:definition "Photographs taken from beyond the earth's atmosphere. For photographs of the earth taken from aircraft, use \"aerial photographs\"; for photographs of celestial bodies or astronomical phenomena, use \"astrophotographs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space photographs"@en .

aat:300246268 a skos:Concept ;
    skos:definition "Environments located below ground level, including those within structures. For the structures themselves, if intentionally built below ground level, use \"underground structures.\" To describe objects that are or have been in the ground and covered with earth, use \"buried.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground environments"@en .

aat:300246275 a skos:Concept ;
    skos:definition "Articles that overlie other articles with the effect of protecting, enclosing, decorating, or hiding them, especially those designed to have this function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "covers"@en .

aat:300246780 a skos:Concept ;
    skos:definition "Coverings for floor or beds woven using strips of rag cloth as the weft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catalognes"@en .

aat:300246920 a skos:Concept ;
    skos:definition "Substance or molecule, other than the reactant, that starts a chain reaction (as in polymerization) and is usually consumed in the reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initiator"@en .

aat:300246922 a skos:Concept ;
    skos:definition "Complex pure substances made up of two or more elements in definite proportions with respect to the number and kind of atoms, held together by chemical bonds. They have entirely different properties from those of the constituent elements, which lose their individual character. For combinations of two or more substances in no definite proportions that are only physically mixed and within which the constituent substances retain their individual properties and are separable by ordinary physical means, use \"mixtures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compounds"@en .

aat:300246925 a skos:Concept ;
    skos:definition "Mechanical combinations of two or more substances in no definite proportions, within which the constituent substances retain their individual properties and are separable by ordinary physical means. For complex pure substances made up of two or more elements in definite proportions which lose their individual properties and are held together by chemical bonds, use \"compounds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixtures"@en .

aat:300246929 a skos:Concept ;
    skos:definition "Simple chemical substances composed of only one type of atom and not able to be broken down, changed, or decomposed by ordinary physical or chemical means. They are the basic chemical constituents of compounds and ultimately of all tangible matter in the universe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elements"@en .

aat:300246933 a skos:Concept ;
    skos:definition "Elements found in minute quantities in minerals, not essential to their composition but found in their structure or adsorbed on their surface, conventionally held to constitute significantly less than 1.0% of the mineral. Use also for elements found in plant and animal tissue in concentrations of 1.0% or less, which are physiologically essential to the organism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trace elements"@en .

aat:300247011 a skos:Concept ;
    skos:definition "Forms of a chemical element having the same atomic number but different mass. An isotope is a form of a particular chemical element that shares with other forms the same number of protons in the nucleus, and thus the same atomic number and position in the periodic table, but differs from other forms in the number of neutrons, and therefore the atomic weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isotopes"@en .

aat:300247258 a skos:Concept ;
    skos:definition "Fields of study that investigate the natural world based on facts learned through experiments and observation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science-related disciplines"@en .

aat:300247259 a skos:Concept ;
    skos:definition "Fields of study relating to sciences that address the health of humans and animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "health sciences-related disciplines"@en .

aat:300247276 a skos:Concept ;
    skos:definition "Collective action undertaken by people, who may or may not be formally organized, for the purpose of promoting or resisting an aspect of social change within a society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social movements"@en .

aat:300247279 a skos:Concept ;
    skos:definition "Something that serves as an ideal, a pattern to follow or copy, or source of inspiration to a creator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model"@en .

aat:300247280 a skos:Concept ;
    skos:definition "Wars that involve most of the leading political and military powers of the world or most of the earth's territory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "world wars"@en .

aat:300247283 a skos:Concept ;
    skos:definition "Study of medical concepts and practice throughout human history in a global, social, cultural, and scientific context including theories, diseases, health care, individual practitioners, special branches of medicine, and medical professions such as nursing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history of medicine"@en .

aat:300247348 a skos:Concept ;
    skos:definition "The condition in which each thing is clearly distinguished and properly disposed with reference to other things, and performs its proper function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "order"@en .

aat:300247349 a skos:Concept ;
    skos:definition "The state of utter confusion and disorder, where everything exists as an undifferentiated, formless mass or mixture. Derived from the original concept in ancient Greek cosmology, meaning the primevil emptiness of the universe before distinct entities came into being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaos"@en .

aat:300247389 a skos:Concept ;
    skos:definition "Students in a national service academy, private military school, or on a training ship, or students training for service as commissioned officers in the United States Army, Air Force, or Coast Guard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadets"@en .

aat:300247394 a skos:Concept ;
    skos:definition "An outline or form combining elements of oval and triangular, typically having three sides, often rounded, with the form being wider at the top and tapering to a point at the bottom; the name refers to a common shape of medieval shields or escutcheons. The term is used, for example, with reference to the backs of Federal and similar types of chairs, and for a certain shape for cut gems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shield-shaped"@en .

aat:300247399 a skos:Concept ;
    skos:definition "Devices, such as life belts or life jackets, designed to keep a person afloat and prevent drowning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life preservers"@en .

aat:300247403 a skos:Concept ;
    skos:definition "Pins inserted through the end of an axletree to secure the wheel or other part from sliding off the axle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linchpins"@en .

aat:300247410 a skos:Concept ;
    skos:definition "Rosettes, knots of ribbons, or similar ornaments worn usually on a hat as a badge of office or party, as part of livery dress, or as decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockades"@en .

aat:300247412 a skos:Concept ;
    skos:definition "Double-edged hand tools having an axe blade on one side and a pickaxe or wide chisel on the opposite side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pulaskis"@en .

aat:300247420 a skos:Concept ;
    skos:definition "Contrivances used for catching animals, especially with reference to those having a mechanical device that springs shut suddenly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traps"@en .

aat:300247426 a skos:Concept ;
    skos:definition "Traps typically consisting of a string with a running noose by which an animal may be caught."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snares"@en .

aat:300247430 a skos:Concept ;
    skos:definition "Implements with teeth or tines for gathering loose plant material, such as cut grass or hay, or for smoothing the surface of the ground. Used in agricultural environments, gardens, landscaping, and other situations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rakes"@en .

aat:300247448 a skos:Concept ;
    skos:definition "The craft or business of building ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipbuilding"@en .

aat:300247453 a skos:Concept ;
    skos:definition "Lighting systems that employ daylight, including the arrangements and installation of such systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daylighting"@en .

aat:300247473 a skos:Concept ;
    skos:definition "Stout sticks or posts with a pointed end for driving into the ground as to mark a boundary or site, to support a plant or part of a framework, or used as tethering rods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stakes"@en .

aat:300247475 a skos:Concept ;
    skos:definition "Two-part fasteners for a coat, jacket, or other garment usually made of a looped braid or cord in an ornamental design on one edge of the garment that attaches around a knot, toggle, or similar device on the other side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frogs"@en .

aat:300247477 a skos:Concept ;
    skos:definition "Instruments or apparatuses designed to store gases and liquids in conditions substantially different from that of the surrounding environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure equipment"@en .

aat:300247478 a skos:Concept ;
    skos:definition "Airtight chambers that can be filled with steam under pressure or surrounded by another chamber for the steam and that are used for sterilizing, cooking, or other purposes requiring moist or dry temperatures above 212 degrees Fahrenheit without boiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autoclaves"@en .

aat:300247483 a skos:Concept ;
    skos:definition "Benchlike tiered seating for spectators at, for example, outdoor sporting events, usually without weather or sun protection, affording less advantageous views than grandstands; may also be used for similarly constructed, often telescoping, indoor seating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleachers"@en .

aat:300247490 a skos:Concept ;
    skos:definition "Bands encircling the arm, sometimes worn for decoration, identification, or to signify mourning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armbands"@en .

aat:300247513 a skos:Concept ;
    skos:definition "Instruments or apparatuses used to immobilize or confine a human being or animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restraining equipment"@en .

aat:300247514 a skos:Concept ;
    skos:definition "Contrivances, such as rings, chains, or other fastenings usually of iron or other metal, attached to the wrists or ankles so as to prevent their free motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shackles"@en .

aat:300247516 a skos:Concept ;
    skos:definition "Shackles for the hand, generally consisting of a divided metal ring which is locked around the wrist; usually made in pairs of rings connected by a short chain or bar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handcuffs"@en .

aat:300247521 a skos:Concept ;
    skos:definition "Shackles for the feet of a human being or animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fetters"@en .

aat:300247523 a skos:Concept ;
    skos:definition "Instruments or apparatuses that aid the diagnosis, prevention, and treatment of diseases and injuries used in the practice of medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medical equipment"@en .

aat:300247524 a skos:Concept ;
    skos:definition "Equipment, such as remedies and bandages, used to dress or cover a sore, wound, or other lesion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressings"@en .

aat:300247527 a skos:Concept ;
    skos:definition "Equipment for dressing a wound in the field or battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field dressings"@en .

aat:300247540 a skos:Concept ;
    skos:definition "Devices for arresting bleeding consisting of a bandage tightened usually with a stick or of a piece of rubber tubing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourniquets"@en .

aat:300247545 a skos:Concept ;
    skos:definition "Tools and equipment used for sewing, which uses the process of joining, attaching, or decorating flexible materials with needle and thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing tools"@en .

aat:300247546 a skos:Concept ;
    skos:definition "Frames, devices, or machines of various designs, used for interlacing at right angles two or more sets of threads or yarns to form a cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "looms"@en .

aat:300247548 a skos:Concept ;
    skos:definition "Devices of various designs, often a slender bar-like object, used in weaving or netting. In weaving, it passes the thread or yarn of the weft to and from one edge of the cloth to the other between the threads or yarns of the warp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shuttles"@en .

aat:300247551 a skos:Concept ;
    skos:definition "Small bell-shaped covers worn over the fingertip to protect it when pushing a needle through material in sewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thimbles"@en .

aat:300247560 a skos:Concept ;
    skos:definition "Refers to the style and culture that is named after the site at Swidry, Poland, and existed in the areas of Poland, Romania, Russia, and elsewhere. It developed in the late Paleolithic Period, though it continued and flourished in the Mesolithic. It is particulalarly characterized by distinctive flint tools, including small, assymetrical tanged blades, arrowheads, and tranchet axes. It seems to be related to the Campignian culture that flourished further south."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swiderian"@en .

aat:300247565 a skos:Concept ;
    skos:definition "Devices that automatically switch lights off when a space becomes unoccupied or exterior lighting conditions brighten sufficiently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupancy sensors"@en .

aat:300247571 a skos:Concept ;
    skos:definition "Personal articles, such as furnishings, equipment, or dress, especially those belonging to a soldier, but excluding weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accoutrements"@en .

aat:300247575 a skos:Concept ;
    skos:definition "Necropolises consisting of inhumation graves set out from a center in long distinct rows; used during the early 5th to 7th century in Germany, France, and the Low Countries, usually along rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reihengräberfelder"@en .

aat:300247580 a skos:Concept ;
    skos:definition "Celtic late Iron Age defensive walls, generally constructed of thick lines of stones, held together and reinforced by a core of timber frames fastened with iron nails, and covered with a sloping earth rampart; sometimes faced with cut stone and topped by a parapet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "murus gallicus"@en .

aat:300247581 a skos:Concept ;
    skos:definition "Refers to female human beings from birth through adolescence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "girls"@en .

aat:300247585 a skos:Concept ;
    skos:definition "Those who favor or advocate the legal prevention of the manufacture, sale, or transportation of alcoholic beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prohibitionists"@en .

aat:300247590 a skos:Concept ;
    skos:definition "Soldiers armed with rifles. Formerly used specifically for superior marksmen armed with the best models of rifles and formed into specially trained companies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riflemen"@en .

aat:300247594 a skos:Concept ;
    skos:definition "Seeking or examining merchandise or property offered for sale, especially but not exclusively by visiting shops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shopping"@en .

aat:300247595 a skos:Concept ;
    skos:definition "Two hundredth anniversaries or their observances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicentennials"@en .

aat:300247598 a skos:Concept ;
    skos:definition "Refers to male human beings from birth through adolescence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boys"@en .

aat:300247602 a skos:Concept ;
    skos:definition "Material derived from the long flat leaves of tall reedlike marsh plants of the genus Typha, used in making mats and chair seats, and since they swell when wet, leaves are used for caulking cracks in barrels and boats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattail"@en .

aat:300247614 a skos:Concept ;
    skos:definition "Ceremonial feasts typically held to honor or support a person, organization, or cause."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquets"@en .

aat:300247617 a skos:Concept ;
    skos:definition "Textile mills in which thread is spun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning mills"@en .

aat:300247625 a skos:Concept ;
    skos:definition "Broad, flat, somewhat thick, and usually rigid, objects; thicker than sheets, wider than slats or boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slabs"@en .

aat:300247630 a skos:Concept ;
    skos:definition "Lighting systems that employ artificial light, including the arrangements and installation of such systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial lighting"@en .

aat:300247651 a skos:Concept ;
    skos:definition "Any of various reckoning devices consisting of movable discs surmounted by or carrying other graduated or figured circles for calculating, for example, phases of the moon, the time of the rising or setting sun, or the times of the tides; usually made of paper, cardboard, or vellum and often found preprinted in or attached to manuscripts or books of the 13th to the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volvelles"@en .

aat:300247655 a skos:Concept ;
    skos:definition "Decorating with painted or carved designs consisting of colorful floral and other forms and inscriptions, derived from a Scandinavian decorative style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosemaling"@en .

aat:300247675 a skos:Concept ;
    skos:definition "Walls specially constructed to have a high capacity for collecting and storing heat or cold and then slowly releasing the stored energy through convection into a building space; usually designed as part of a passive solar system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal storage walls"@en .

aat:300247682 a skos:Concept ;
    skos:definition "Thermal storage walls consisting of south-facing, glass-fronted, thick masonry walls with circulation vents that pass heated air, stored during the day in the walls, into rooms during the night."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trombe walls"@en .

aat:300247685 a skos:Concept ;
    skos:definition "Shelflike passive solar devices usually set near the ceiling projecting from either the interior or exterior of windows to allow daylight or direct sunlight to bounce deep into buildings without glare or strong modulation, to enhance interior lighting conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light shelves"@en .

aat:300247690 a skos:Concept ;
    skos:definition "Refers to those who sell food or small goods from temporary positions on the street. For those who move about selling small goods from door to door or on the street, see \"peddlers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street vendors"@en .

aat:300247693 a skos:Concept ;
    skos:definition "Refers to the elected magistrates of this title of Republican Rome who performed some of the duties of the consuls, to whom they were subordinate. Refers also to chief magistrates or mayors in 17th- and 18th-century Italy who bore this title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "praetors"@en .

aat:300247704 a skos:Concept ;
    skos:definition "Generally, giving advice or offering counsel or recommendations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advising"@en .

aat:300247713 a skos:Concept ;
    skos:definition "Those parts of complete rounds of ammunition, either cartridges or shells, that encase the charge, primer and, usually, the projectile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cases"@en .

aat:300247888 a skos:Concept ;
    skos:definition "Wheeled, often collapsible, chairlike carriages designed primarily for pushing small children able to sit upright. For wheeled carriagelike or wagonlike conveyances used primarily to push or pull infants, prefer \"baby carriages.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strollers"@en .

aat:300247897 a skos:Concept ;
    skos:definition "Devices that automatically time a process or event or activate an operation or another device at a preset time or times; may or may not give an audible signal at the end of the timed interval."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timers"@en .

aat:300247905 a skos:Concept ;
    skos:definition "Mineral occurring in white, green, pink, yellowish, or purple prismatic crystals containing lithium oxide, used as a source of lithium, in ceramic flux, and in glassmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spodumene"@en .

aat:300247907 a skos:Concept ;
    skos:definition "Undertaking or offering to undertake, of one's own free will and without compensation, service to others or to some cause or institution, especially in a community context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volunteering"@en .

aat:300247916 a skos:Concept ;
    skos:definition "Labels, usually of a stiff or adhesive material, attached to a thing or person and bearing some information relevant to the thing or person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tags"@en .

aat:300247919 a skos:Concept ;
    skos:definition "Remains, impressions, or traces of humans, animals, or plants of past geological ages that have been preserved in the earth's crust. The complex of data recorded in fossils worldwide--known as the fossil record--is the primary source of information about the history of life on Earth. Only a small fraction of ancient organisms are preserved as fossils, and usually only organisms that have a solid and resistant skeleton are readily preserved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fossils"@en .

aat:300247921 a skos:Concept ;
    skos:definition "Sets of tools, equipment, and other items, often contained in a box or bag, provided for some necessity or to be assembled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kits"@en .

aat:300247923 a skos:Concept ;
    skos:definition "Bending something over upon itself, as cloth or paper. For the parts bent over upon each other, use \"folds\"; for resulting ridges, use \"creases.\" To describe objects designed to fold into a compact form, use \"folding (attribute).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding"@en .

aat:300247929 a skos:Concept ;
    skos:definition "The practice of using a typewriter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriting"@en .

aat:300247936 a skos:Concept ;
    skos:definition "Protective envelope-like containers for phonograph records, usually of heavy paper or cardboard and often printed with images and information relating to the record, such as important information about a performance or illustrative material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "record covers"@en .

aat:300247960 a skos:Concept ;
    skos:definition "Stage of physical development at which living beings first become capable of sexual reproduction, marked by the maturing of the reproductive organs and the development of secondary sexual characteristics. In human beings it usually occurs between the ages of 10 and 15, and in North American common law it is defined as the age of 14 for boys and 12 for girls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puberty"@en .

aat:300247961 a skos:Concept ;
    skos:definition "The initial onset of menstruation in female humans and primates. In humans it usually occurs around age 13, close upon or one or two years following the onset of puberty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menarche"@en .

aat:300247962 a skos:Concept ;
    skos:definition "The practice of painting or decorating in several colors; a term used mostly regarding sculpture, architectural decoration, ceramics, and various ancient artifacts. For the attribute describing the result of this process, use \"polychrome.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polychromy"@en .

aat:300247999 a skos:Concept ;
    skos:definition "Ceremonial excision of the clitoris, or less radical surgical procedure thereon, typically performed as a female initiation ceremony in some societies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clitoridectomies"@en .

aat:300248001 a skos:Concept ;
    skos:definition "Parties held to introduce young women, generally those of the upper class, into the adult social life of their class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "debutante balls"@en .

aat:300248002 a skos:Concept ;
    skos:definition "Celebratory social debuts, especially by adolescents or young adults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comings out"@en .

aat:300248005 a skos:Concept ;
    skos:definition "Parties, sometimes dances, held to celebrate a girl's sixteenth birthday."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweet sixteens"@en .

aat:300248006 a skos:Concept ;
    skos:definition "Brazilian coming out celebrations and ceremonies held on the occasion of a girl's fifteenth birthday."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festas de quinze anos"@en .

aat:300248007 a skos:Concept ;
    skos:definition "Latino coming out celebrations and ceremonies held on the occasion of a girl's fifteenth birthday."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quinceañeras"@en .

aat:300248011 a skos:Concept ;
    skos:definition "Groups of two or more people or animals functioning as a collaborative unit in some joint action, such as a sport, game, project, or task."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teams"@en .

aat:300248012 a skos:Concept ;
    skos:definition "Refers to those who prepare food for consumption, especially but not exclusively by the use of heat. Includes those who prepare meals and dishes in a private home, public eating place, or institution, or who cook foods as a preparation stage in commercial food processing plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooks"@en .

aat:300248023 a skos:Concept ;
    skos:definition "Use with reference to the unsold or unused end of piece goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remnants"@en .

aat:300248030 a skos:Concept ;
    skos:definition "Uniforms intended for those in the armed forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military uniforms"@en .

aat:300248038 a skos:Concept ;
    skos:definition "Belts having loops or pockets used to carry ammunition and sometimes other equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartridge belts"@en .

aat:300248042 a skos:Concept ;
    skos:definition "Any of variously shaped objects usually made of stone, clay, or metal used in conjunction with a loom as a counterbalance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loom weights"@en .

aat:300248045 a skos:Concept ;
    skos:definition "General term for racks or stands of various forms for the temporary storage of coats and other garments, having pegs, hooks, bars, or projecting arms on or over which clothing may be hung or folded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coatracks"@en .

aat:300248050 a skos:Concept ;
    skos:definition "Cloth armbands, often with braiding or tassels, worn around the upper arm, as by military personnel to signify a particular group or regiment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brassards"@en .

aat:300248053 a skos:Concept ;
    skos:definition "Any of various props or supporting devices used to keep books in an upright position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookends"@en .

aat:300248057 a skos:Concept ;
    skos:definition "Coverings for the leg from ankle to knee consisting of a narrow cloth wrapped spirally around the leg or a fitted leather legging secured by a strap, catch, or laces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puttees"@en .

aat:300248064 a skos:Concept ;
    skos:definition "Any of various gold-colored braids used especially on uniforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold braid"@en .

aat:300248067 a skos:Concept ;
    skos:definition "Devices consisting of a tube with a bowl at one end and a mouthpiece at the other; used for smoking tobacco, opium, and other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipes"@en .

aat:300248073 a skos:Concept ;
    skos:definition "Military uniforms for formal wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress uniforms"@en .

aat:300248076 a skos:Concept ;
    skos:definition "Long-stemmed, ornamented pipes used by Native North Americans on ceremonial occasions, especially as a token of peace or friendship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calumets"@en .

aat:300248082 a skos:Concept ;
    skos:definition "Containers for the safe storage of articles; use especially for boxlike receptacles, generally of steel or iron construction and having one or more securing devices, that can be freestanding or built into a wall or vault and which are used to protect money and other valuables against fire or theft. Prefer \"kitchen safes\" for ventilated cabinets in which food is stored. Prefer \"strongboxes\" for lockable boxes which tend to be smaller and more portable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safes"@en .

aat:300248084 a skos:Concept ;
    skos:definition "Parts or components of land vehicle equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land vehicle equipment components"@en .

aat:300248085 a skos:Concept ;
    skos:definition "Mouthpieces of bridles, having fittings at each end to which the reins are fastened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bits"@en .

aat:300248092 a skos:Concept ;
    skos:definition "Headgear with which a horse is governed and restrained, usually consisting of a headstall, bit, and reins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridles"@en .

aat:300248096 a skos:Concept ;
    skos:definition "Parts or components of stoves; the constituent elements or parts of apparatuses for heating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove components"@en .

aat:300248097 a skos:Concept ;
    skos:definition "Cast iron rectangular plates which, when bolted or otherwise assembled together, form part of a five-plate, six-plate, or ten-plate wood stove. Stove plates intended for the front and sides of stoves were often decorated in low relief, especially with Biblical scenes or text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove plates"@en .

aat:300248102 a skos:Concept ;
    skos:definition "Baskets used to winnow or separate threshed grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winnowing baskets"@en .

aat:300248112 a skos:Concept ;
    skos:definition "Heavy hoes for digging up roots, stumps, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grub hoes"@en .

aat:300248126 a skos:Concept ;
    skos:definition "Glossy transparent material made from regenerated cellulose, typically in the form of thin sheets, usually moisture-proofed and sometimes dyed; impervious to dry gases, grease, and bacteria, and used as packaging or wrapping for food and other merchandise, envelope windows, and bags for dialysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellophane"@en .

aat:300248142 a skos:Concept ;
    skos:definition "The art of making puppets, which are representations of figures, animated by strings, by hands inside the figure, rods, or another manual method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puppet making"@en .

aat:300248147 a skos:Concept ;
    skos:definition "The performing art of puppet shows or other performing with puppets, which are representations of figures, animated by strings, by hands inside the figure, or another manual method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puppetry"@en .

aat:300248152 a skos:Concept ;
    skos:definition "The fronts or forwardmost ends of watercraft or airships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bows"@en .

aat:300248156 a skos:Concept ;
    skos:definition "Enclosed rooms or compartments either aboard watercraft partitioned off by bulkheads and designed as private accommodations for officers, crew, or passengers. These may also be aboard aircraft and spacecraft designed for crew, passengers, or cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabins"@en .

aat:300248161 a skos:Concept ;
    skos:definition "Refers to architectural orders where columns, pilasters, or piers extend over two or more stories. It has roots in Roman architecture, where one arch could span more than two sections of an elevation, but it was fully developed in the Renaissance and beyond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colossal orders"@en .

aat:300248168 a skos:Concept ;
    skos:definition "Bathtubs designed to support a person in the sitting position, immersing only up to the hips; often used for therapeutic treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sitz baths"@en .

aat:300248178 a skos:Concept ;
    skos:definition "Using sight or touch to take in the sense of words or symbols in printed or written matter, either silently or aloud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading"@en .

aat:300248179 a skos:Concept ;
    skos:definition "Use broadly for art depicting religious subjects or for art used in worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious art"@en .

aat:300248181 a skos:Concept ;
    skos:definition "Traveling on foot at a moderate pace, proceeding by steps, and moving the feet alternately so that there is always one foot on the ground in bipedal locomotion and two or more feet on the ground in quadrupedal locomotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking"@en .

aat:300248183 a skos:Concept ;
    skos:definition "Any of various passive constructions built high above rooftops to collect prevailing breezes and channel them down into living spaces; common in hot, arid climates from North Africa to Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wind catchers"@en .

aat:300248196 a skos:Concept ;
    skos:definition "Assembly of rails, ties, and fasteners over which rail vehicles travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracks"@en .

aat:300248206 a skos:Concept ;
    skos:definition "Parts or components of tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "track components"@en .

aat:300248207 a skos:Concept ;
    skos:definition "Rolled steel bars, commonly T-sections, designed to be laid end to end, usually in pairs and in parallel lines, to provide the running surface for certain transit vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rails"@en .

aat:300248218 a skos:Concept ;
    skos:definition "Wind catchers consisting of a tall tower, generally square in plan with X-shaped panels set diagonally across the interior from corner to corner, open at the sides near the top to funnel and accelerate incoming breezes down one channel to cool spaces below creating by convection an updraft in the opposite channel which draws warm indoor air out; Persian in origin, found in Iran and the Gulf countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badgirs"@en .

aat:300248227 a skos:Concept ;
    skos:definition "Wind catchers consisting of tall shafts rising well above rooflines and having a single large opening and a diagonally sloping top facing prevailing winds; found especially in Egypt, Iran, and Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malaqif"@en .

aat:300248231 a skos:Concept ;
    skos:definition "Refers to images, in any medium but usually referring to painting, drawing, prints, photography, or digital works, that are recognizable as representations of visible entities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depictions"@en .

aat:300248239 a skos:Concept ;
    skos:definition "Personal use equipment for caring for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "child care equipment"@en .

aat:300248240 a skos:Concept ;
    skos:definition "Boards or flat framework to which Native Americans traditionally and often today bind an infant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cradleboards"@en .

aat:300248241 a skos:Concept ;
    skos:definition "Smoking equipment used for cleaning the inside of pipes and usually consisting of flexible wire over which tufted fabric is twisted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe cleaners"@en .

aat:300248250 a skos:Concept ;
    skos:definition "Rooms or spaces from which tickets are sold, as for films, travel, or sporting events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ticket offices"@en .

aat:300248257 a skos:Concept ;
    skos:definition "Rooms or spaces in theaters where tickets are reserved, sold, and distributed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box offices"@en .

aat:300248263 a skos:Concept ;
    skos:definition "Use especially to describe images painted manually, to distinguish them from images transferred mechanically, as on pottery, textiles, and other objects. For the manual adding of color to an existing image, use \"hand coloring.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand-painted"@en .

aat:300248280 a skos:Concept ;
    skos:definition "Printed or graphic material intended for promotional or publicity purposes, such as small printed works describing the features or amenities of a place, an organization, or other concern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brochures"@en .

aat:300248289 a skos:Concept ;
    skos:definition "Those who construct models, generally from hard, nonmalleable materials such as wood or stone, such as scale working or display models of three-dimensional objects or models to produce molds for cast products. For those who create models of clay, wax, or other malleable material, see \"modelers\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model makers"@en .

aat:300248296 a skos:Concept ;
    skos:definition "Those who learn, accept, and follow the doctrines, thinking, or example of a teacher or leader, such as the professed followers of a religious leader or the adherents of a school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disciples"@en .

aat:300248300 a skos:Concept ;
    skos:definition "Parts or components of ammunition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammunition components"@en .

aat:300248317 a skos:Concept ;
    skos:definition "Type of bronze powder made from pure aluminum or an aluminum alloy, commonly used as a pigment in industrial paint, ink, plastic, and caulking compound, and as a textile coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum powder"@en .

aat:300248326 a skos:Concept ;
    skos:definition "Material comprising the elongated woody core of an ear of corn, in which the grains were embedded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corncob"@en .

aat:300248340 a skos:Concept ;
    skos:definition "Wall clocks whose pendulum and weights are entirely exposed; usually restricted to early American examples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wag-on-wall clocks"@en .

aat:300248347 a skos:Concept ;
    skos:definition "Improving deteriorating urban areas by offering abandoned or foreclosed houses to persons who agree to repair them and live in them for a specified number of years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban homesteading"@en .

aat:300248351 a skos:Concept ;
    skos:definition "Factories equipped with machines for extracting vegetable oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil mills"@en .

aat:300248355 a skos:Concept ;
    skos:definition "Rooms in dwellings set aside or otherwise intended for temporary use by guests and usually not regularly used by household members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guest rooms"@en .

aat:300248475 a skos:Concept ;
    skos:definition "A space or area within the lived world of daily experience, perceived as distinct and unified, and possessing emotional, purposive, and social connotations along with physical features and characteristics. For the concept of purely physical position precisely definable in terms of geographic or astronomic measurement, or situation relative to geographic or astronomic features or elements of the built environment, use \"location.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place"@en .

aat:300248479 a skos:Concept ;
    skos:definition "The physical position that is precisely definable in terms of geographic or astronomic measurement, or situation relative to geographic or astronomic features or to elements of the built environment. For the concept of a space or area within the lived world of daily experience which possesses emotional, purposive, and social connotations along with physical features and characteristics, use \"place.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "location"@en .

aat:300248484 a skos:Concept ;
    skos:definition "The distinctive character or atmosphere of a place that impresses itself upon the mind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genius loci"@en .

aat:300248512 a skos:Concept ;
    skos:definition "Apartments with rooms on three levels. For buildings comprised of three dwelling units, use either \"triplexes (multiple dwellings)\" or \"three-deckers (dwellings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triplexes"@en .

aat:300248517 a skos:Concept ;
    skos:definition "Multiple dwellings comprised of three housing units in a row, each with its own ground-level entry; for dwellings in which three housing units are stacked one above the other, use \"three-deckers (dwellings).\" For apartments with rooms on three levels, use \"triplexes (apartments).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triplexes"@en .

aat:300248549 a skos:Concept ;
    skos:definition "Concepts related to the study of the relationship between an environment and its affects on inhabitants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental psychology concepts"@en .

aat:300248591 a skos:Concept ;
    skos:definition "Motifs representing grotesque or otherwise caricatured faces of humans or animals, usually viewed frontally; found in various architectural and decorative arts contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mascarons"@en .

aat:300248599 a skos:Concept ;
    skos:definition "Pyrotechnic devices, usually handheld or used with a launcher, producing intense light, sometimes in combination with smoke or sound, used for signaling, identification, or illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flares"@en .

aat:300248601 a skos:Concept ;
    skos:definition "Instruments or apparatuses that convey notice or warning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signaling equipment"@en .

aat:300248603 a skos:Concept ;
    skos:definition "Short spouts, pipes, or channels designed to convey water outward and away from vertical surfaces, as from gutters, parapets, cisterns, or basins of fountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterspouts"@en .

aat:300248611 a skos:Concept ;
    skos:definition "Variations in the color or growth of crops or other vegetation on the surface of the ground, usually patterns or other recognizable shapes that reflect the shapes of buried walls, ditches, or other remains; used, for example, to locate ancient sites on aerial photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crop marks"@en .

aat:300248615 a skos:Concept ;
    skos:definition "Flower gardens in which a majority of beds are designated for the cultivation of roses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose gardens"@en .

aat:300248627 a skos:Concept ;
    skos:definition "Factories in which ceramic tile is manufactured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tileries"@en .

aat:300248636 a skos:Concept ;
    skos:definition "General term for devices that convert incoming television signals into the original images and their associated sounds. The receiver contains an amplifier and demodulator of the radio signal; in modern televisions, the receiver may be housed in a unit separate from the monitor"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television receivers"@en .

aat:300248647 a skos:Concept ;
    skos:definition "Columns or pillars erected to commemorate victories, usually military, or victors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triumphal columns"@en .

aat:300248653 a skos:Concept ;
    skos:definition "Primary roof beams in Native American and Spanish American adobe construction; usually rough-hewn logs of fir or pine, and often left projecting beyond the exterior wall plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vigas"@en .

aat:300248655 a skos:Concept ;
    skos:definition "Any highly flammable dry substance that readily takes spark or fire, typically used to initiate or transfer fire to something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinder"@en .

aat:300248658 a skos:Concept ;
    skos:definition "Shaped supports for the head either made as separate objects, as used in ancient Egypt and other African cultures, or as attachments to other objects, such as used on the backs of motor vehicle seats or barbers' chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headrests"@en .

aat:300248661 a skos:Concept ;
    skos:definition "Term generally applied to any of various tools used for fleshing skins or hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fleshers"@en .

aat:300248664 a skos:Concept ;
    skos:definition "Devices that convert radio waves into intelligible sounds or other perceptible signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio receivers"@en .

aat:300248675 a skos:Concept ;
    skos:definition "Small chapels set above and behind the high altar and usually visible from the nave of some Spanish churches of the 16th to the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camarines"@en .

aat:300248706 a skos:Concept ;
    skos:definition "Woolen shawl-like outerwear, usually gray-checked, commonly worn by shepherds in southern Scotland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mauds"@en .

aat:300248707 a skos:Concept ;
    skos:definition "Close-fitting caps of linen or muslin, especially those worn by elderly women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mutches"@en .

aat:300248708 a skos:Concept ;
    skos:definition "Term loosely applied to women's long, flowing dressing gowns or bathrobes which tend to be made of soft or sheer fabrics decoratively trimmed with lace, fur, or ruffles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negligees"@en .

aat:300248709 a skos:Concept ;
    skos:definition "Short, skirtlike sections of a costume attached at the waistline, such as on a bodice or jacket, and usually extending to cover the hips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peplums"@en .

aat:300248710 a skos:Concept ;
    skos:definition "Waterproof hats worn as rainwear or by seamen in bad weather, having a wide, slanting brim which is broader in the back to protect the neck and sometimes earflaps which tie under the chin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sou'westers"@en .

aat:300248711 a skos:Concept ;
    skos:definition "Traditional Celtic tightly fitting woven trousers, especially of tartan, with the legs usually extended to cover the feet. Also, tartan trousers worn as an item of uniform by Scottish units of the British army or worn by others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trews"@en .

aat:300248749 a skos:Concept ;
    skos:definition "Technique in microanalytical chemistry in which a finely focused electron beam is used to excite an x-ray spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron probe microanalysis"@en .

aat:300248770 a skos:Concept ;
    skos:definition "Refers to the fungi characteristic of a particular environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mycoflora"@en .

aat:300248774 a skos:Concept ;
    skos:definition "Structural or working models at full size or built to scale, for study, testing, or display of, for example, building systems or vehicle assemblies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mock-ups"@en .

aat:300248785 a skos:Concept ;
    skos:definition "Style and culture of the Limba people, a West African people inhabiting Sierra Leone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Limba"@en .

aat:300248796 a skos:Concept ;
    skos:definition "Small, thin, flat pieces of metal, leather, or other suitable material bearing a unique official identification number of a registered vehicle, to which it is to be attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "license plates"@en .

aat:300248834 a skos:Concept ;
    skos:definition "A gold-copper alloy, of wide range of composition and color, resulting in a lower melting point than either contributory metal; widely employed in Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumbaga"@en .

aat:300248835 a skos:Concept ;
    skos:definition "Visual works in the shape of a cross having the figure of Christ crucified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crucifixes"@en .

aat:300248842 a skos:Concept ;
    skos:definition "Farms of wealthy landlords employing the latest and best agricultural techniques and technologies and designed by architects, often built as exemplars for local farmers; found, especially in England, from the late 18th century to the mid-19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model farms"@en .

aat:300248849 a skos:Concept ;
    skos:definition "Short-handled scoops intended for flour, sometimes sized to hold a specific measure, such as one cup, and made with a partial cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour scoops"@en .

aat:300248856 a skos:Concept ;
    skos:definition "Plastic or fiber liners, often detachable, that fit inside helmets. Some varieties may worn separately, without the helmet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet liners"@en .

aat:300248887 a skos:Concept ;
    skos:definition "The process of applying a new surface treatment, such as paint, sealer, or stain, to an object or work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refinishing"@en .

aat:300248891 a skos:Concept ;
    skos:definition "Technique for altering any plain configuration, surface decoration, or structural composition with a repeated motif, especially for textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patterning"@en .

aat:300248893 a skos:Concept ;
    skos:definition "Strips of paper or cloth, bound in a book and used to attach leaves or plates, or used to repair or reinforce the folds of gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guards"@en .

aat:300248928 a skos:Concept ;
    skos:definition "Compact electronic amplifiers worn to improve one's hearing, usually placed in or behind the ear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hearing aids"@en .

aat:300248985 a skos:Concept ;
    skos:definition "Style and culture of the great Songhai trading state of West Africa (flourished 15th-16th century), located on the Niger River in what is now central Mali, and eventually extending west to the Atlantic coast and east into Niger and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Songhai Empire"@en .

aat:300248999 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Gabon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bubi"@en .

aat:300249063 a skos:Concept ;
    skos:definition "Large, powerful species of cat including several subspecies, all having a pattern of dark vertical stripes that overlay near-white to reddish-orange fur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera tigris"@en .

aat:300249069 a skos:Concept ;
    skos:definition "Genus containing two living species of orangutans native to Indonesia and Malaysia; they are large hominids that are intelligent, primarily arboreal, having very long arms, reddish-brown hair, and having males that exhibit two modes of physical development, dominant males being flanged (with large cheek pads) and other males being unflanged. Flanged males hold and protect territory, while unflanged males look and behave more like juveniles and females."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pongo"@en .

aat:300249076 a skos:Concept ;
    skos:definition "Members of a genus containing two species and several races of large apes. In some classifications both species are classified as one species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gorilla"@en .

aat:300249127 a skos:Concept ;
    skos:definition "The technique of reinforcing with a framework, for example in painting conservation to reinforce wooden panels, or in architecture to support an arched or coved ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cradling"@en .

aat:300249128 a skos:Concept ;
    skos:definition "Refers to a sheet made from fiber under carefully controlled conditions typically subjected to standard tests to evaluate pulp quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handsheet"@en .

aat:300249131 a skos:Concept ;
    skos:definition "Process of removing the fleshy parts of leaves, seeds or other vegetation to reveal only the most durable fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeletonizing"@en .

aat:300249134 a skos:Concept ;
    skos:definition "Technique for evaluating basic structural properties of paper using wet and dry paper strips over a range of short spans from 0 to 1 mm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "short-span tensile analysis"@en .

aat:300249135 a skos:Concept ;
    skos:definition "Analysis to determine how a tool was used and what materials were worked on by examining its wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "use-wear analysis"@en .

aat:300249137 a skos:Concept ;
    skos:definition "Analysis employing microscopic techniques to determine how a tool was used and what materials were worked on by examining its wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microwear analysis"@en .

aat:300249146 a skos:Concept ;
    skos:definition "Female slaves in a harem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odalisques"@en .

aat:300249150 a skos:Concept ;
    skos:definition "Symbols of office consisting of a bundle of rods bound around an axe, with the axe blade projecting, carried before Roman Magistrates as a symbol of their power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fasces"@en .

aat:300249151 a skos:Concept ;
    skos:definition "Refers to still lifes in which the objects depicted are overt reminders of mortality, the transcience of human life, and the ultimate worthlessness of earthly possessions, such as hourglasses, scales, mirrors, skulls, and symbols of wealth, learning, and power such as jewels, books, and armor. Such still lifes, unlike most others, have religious overtones. This type of still life, developed in Leiden, was especially popular in 17th-century Dutch painting. The name cames from a passage in the book of Ecclesiastes in the Bible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vanitas"@en .

aat:300249154 a skos:Concept ;
    skos:definition "Nigerian Igbo votive shrines constructed as part of complex festivals of life and sacrificial rituals, often highly ornate and filled with sculpture; prior to the 1960s, built of perishable materials and once erected are left to decay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mbari"@en .

aat:300249162 a skos:Concept ;
    skos:definition "Shooting arrows with a bow, as for hunting, battle, or sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archery"@en .

aat:300249169 a skos:Concept ;
    skos:definition "New settlements created in once rural areas, near major cities, primarily as destinations for office jobs, shopping, and entertainment, generally having a sprawling, car-based layout encompassing vast amounts of leasable and retail space, but usually lacking social and community-based activities, clearly defined edges, a central government, or centralized growth patterns that characterize traditional cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge cities"@en .

aat:300249172 a skos:Concept ;
    skos:definition "Written, oral, sound, or photographic recordings, or presentations in other media that explain or re-create actual events, eras, life stories, or other factual information in a manner purporting to be objective and accurate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentaries"@en .

aat:300249178 a skos:Concept ;
    skos:definition "Areas having beneficial qualities to the surrounding environment or considered as natural assets to their region, typically including wetlands, flood plains, critical habitats of endangered species, and recharge zones of sole-source bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmentally sensitive areas"@en .

aat:300249183 a skos:Concept ;
    skos:definition "Branch of tourism aimed at providing responsible travel to natural areas, conserving the environment, and sustaining the well-being of local people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecotourism"@en .

aat:300249197 a skos:Concept ;
    skos:definition "General term for material from the leaves and stems of several species of large aquatic grass used by Native Americans in house construction, making mats, rafts, etc. From the Nahuatl word, \"tolin.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tule"@en .

aat:300249198 a skos:Concept ;
    skos:definition "Social, political, and economic system of racial segregation, assigning rights to classes of people based on their racial background, supremacy being granted to those of white European extraction, with laws limiting the political participation and economic advancement of those of African, Asian, and mixed race."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apartheid"@en .

aat:300249202 a skos:Concept ;
    skos:definition "Manufacturing using computer systems and techniques to track and control the flow of information, materials, energy, and labor throughout a factory, completely or in part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-aided manufacturing"@en .

aat:300249206 a skos:Concept ;
    skos:definition "Rights concerning real and personal property, constitutionally protected in some nations; examples include the right to transfer, make contracts, conduct business, earn income through a property."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "property rights"@en .

aat:300249221 a skos:Concept ;
    skos:definition "Paintings on cloth, most often velvet or paper, produced by the use of stencils; frequently still lifes of fruit or flowers; popular in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theorems"@en .

aat:300249226 a skos:Concept ;
    skos:definition "Trompe-l'oeil decorations depicting objects such as envelopes, playing cards, and scissors, casually arranged and rendered so as to appear to cast shadows; most commonly associated with late-18th-century Royal Copenhagen porcelain and somewhat earlier Meissen ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quodlibet"@en .

aat:300249261 a skos:Concept ;
    skos:definition "Frame construction in which heavy planking, placed horizontally or vertically, is used to form solid walls instead of studs and sheathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plank construction"@en .

aat:300249267 a skos:Concept ;
    skos:definition "Refers to the culture and creative output and activity of residents of the United States, of Latin American, or Spanish origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hispanic American"@en .

aat:300249275 a skos:Concept ;
    skos:definition "A contemporary art genre utilizing natural physical forces, biological organisms and processes, personal performance, or a variety of other media to demonstrate the workings of the earth's ecological systems, illustrate and explain environmental problems, or implement solutions to these problems. For large scale, outdoor works that surround or involve the participation of the viewer and usually incorporate aspects of their sites, use \"environmental art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecological art"@en .

aat:300249278 a skos:Concept ;
    skos:definition "Raised platforms for speakers or conductors; may be indoors or outdoors, often narrower than the width of the immediate space upon which they rest. Specifically may refer to raised platforms surrounding the arena below the tiers in an ancient amphitheatre, which provided protection for the spectators and seating for the emperor and other high-ranking officials. For raised indoor platforms set at the ends of large rooms as a place of honor or prominence, as for speakers, officers, or dignitaries, see \"daises.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "podiums"@en .

aat:300249288 a skos:Concept ;
    skos:definition "Raised indoor platforms at or along one end of halls or similar large rooms as places of honor or prominence, as would be reserved for dignitaries, officers, speakers, or having a raised table where distinguished persons sat at feasts. For, usually smaller, indoor or outdoor raised platforms used by speakers or conductors, prefer \"podiums (platforms).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daises"@en .

aat:300249295 a skos:Concept ;
    skos:definition "Devices that convert heat energy directly into electric energy using the Sabbatier effect, via thermocouples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoelectric generators"@en .

aat:300249309 a skos:Concept ;
    skos:definition "Traveling on the backs of animals, in or on vehicles (such as, automobiles or carriages), lying at anchor, or moving on the water (as on surfboards)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding"@en .

aat:300249323 a skos:Concept ;
    skos:definition "Fragments of pottery, especially in archaeological contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potsherds"@en .

aat:300249326 a skos:Concept ;
    skos:definition "Pits or enclosed areas designed for cockfighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockpits"@en .

aat:300249330 a skos:Concept ;
    skos:definition "Technique of forming a work with a variety of small parts, generally by sewing together pieces of cloth or leather in various colors and patterns for coverings, cushions, or quilts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patchwork"@en .

aat:300249365 a skos:Concept ;
    skos:definition "Those whose principal occupation or training is in military history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military historians"@en .

aat:300249379 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture named for site at Danilo, Dalmatia, in modern Croatia. Some scholars believe that this culture and its painted pottery style are more closely related to cultures in the Aeolian Islands, Capri, and south Italy than to contemporary east Balkan cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Danilo"@en .

aat:300249383 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture that flourished in the area of modern Bosnia and is named after the site at Butmir. It is characterized by high-quality vases on pedestals and other pottery decorated with ribbons, triangles, rhomboids, and spirals, and modeled clay figures with very expressive heads, where features are exaggerated, often in distinctive grimaces of surprise or alarm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Butmir"@en .

aat:300249384 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture named for the site near Syracuse, Sicily. It is characterized by distinctive pottery in a wide variety of forms, generally with incised designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stentinello"@en .

aat:300249387 a skos:Concept ;
    skos:definition "Refers to a Neolithic culture and style that was contemporary with the Rössen culture, but was located in Hungary, the Czech lands, and eastern Germany, lasting into the late fifth millennium BCE. It followed the relatively homogenous Bandkeramik culture, and is distinguished by the emergence of strong local traditions and styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lengyel"@en .

aat:300249392 a skos:Concept ;
    skos:definition "Refers to a Neolithic style and culture that developed in the Tisza river valley in eastern Europe in the fifth and fourth millennia BCE. It is characterized by an emphasis on fishing and hunting in addition to agriculture, creation of textiles, and distinctive clay figures that are decorated with complex, abstract designs, and are built up like pots, rather than being created through modeling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tisza"@en .

aat:300249395 a skos:Concept ;
    skos:definition "Kingdom containing multicellular organisms having cells bound by a plasma membrane and organized into tissue and specialized tissue systems that permit them to either move about in search of food or to draw food toward themselves. Unable to make their own food within themselves, as photosynthetic plants do, they rely on consuming preformed food. They possess a nervous system with sensory and motor nerves, enabling them to receive environmental stimuli and to respond with specialized movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Animalia"@en .

aat:300249405 a skos:Concept ;
    skos:definition "Prescribed ceremonial cleansing of part or all of the body or of objects with the intent of purification or dedication, usually but not exclusively performed with water. Usually associated with a religious ritual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablutions"@en .

aat:300249423 a skos:Concept ;
    skos:definition "General name referring to various marine and fresh-water, free-swimming members of the phylum Cnidaria, belonging to various classes based on different morphology; families include Cubozoa (about 20 species), Scyphozoa (about 200 species), Staurozoa (about 50 species), and Hydrozoa (about 1000-1500 species, all of which are not jellyfish). Most jellyfish have in common a rounded, nearly transparent gelatinous body with a mouth on the underside surrounded by stinging tentacles; their bodies alternately expand and contract, allowing them to trap prey in their tentacles as they jet upward and parachute down again."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jellyfish"@en .

aat:300249430 a skos:Concept ;
    skos:definition "Small pieces of material such as textile, leather, or paper, either individual pieces or groups of them bound together, especially when issued by a single manufacturer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swatches"@en .

aat:300249434 a skos:Concept ;
    skos:definition "Crisp textile, typically in plain weave, sometimes with a fine crosswise rib and a smooth lustrous surface on both sides, originally of silk, now of various fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taffeta"@en .

aat:300249437 a skos:Concept ;
    skos:definition "Durable twill, of worsted or with the warp of worsted and the weft of another wool yarn, with a clear finish and a flat diagonal rib; often used for tailored garments such as suits, coats, and dresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serge"@en .

aat:300249438 a skos:Concept ;
    skos:definition "A mesh fabric made from threads or cords that are knotted or woven at regular intervals. Nets were originally made by hand, but are now typically machine woven. Net may range from a lace-like fabric to coarse nets used for sports equipment and hunting. For the objects consisting of meshed arrangements of threads, cords, or ropes that have been twisted, knotted, or woven together at regular intervals, use \"nets (objects).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "net"@en .

aat:300249444 a skos:Concept ;
    skos:definition "Sheer, lightweight plain-woven textile, originally of linen now also of fine combed cotton yarn, filled with starch or sizing. often used for handkerchiefs, aprons, and curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lawn"@en .

aat:300249446 a skos:Concept ;
    skos:definition "Woven textile, usually brocaded, incorporating flat metallic thread, often gold or silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamé"@en .

aat:300249448 a skos:Concept ;
    skos:definition "Plain-woven textile, originally of silk, now made also of wool, cotton, and synthetic fibers, characterized by slight, flat ribs in the weft; used, for example, for women's suits and dresses, hats, trimmings, and interior furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faille"@en .

aat:300249449 a skos:Concept ;
    skos:definition "Sheer, lightweight plain-woven textile of fine, tightly-twisted yarn, originally of silk now also of various synthetic fibers, used, for example, for scarves, dresses, blouses, underwear, and veils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiffon"@en .

aat:300249450 a skos:Concept ;
    skos:definition "Branch of history covering organized warfare and military institutions in general, as well as specific wars, personalities, engagements, units, weaponry, uniforms, and other military artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military history"@en .

aat:300249458 a skos:Concept ;
    skos:definition "Genus of flatworm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Planaria"@en .

aat:300249460 a skos:Concept ;
    skos:definition "Class of parasitic flatworms found in the bodies of various animals, having a flattish or cylindrical form, with skin often perforated by pores, and usually furnished with adhesive suckers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trematoda"@en .

aat:300249474 a skos:Concept ;
    skos:definition "Describes groupings of a species from the Animalia kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groups of animals"@en .

aat:300249494 a skos:Concept ;
    skos:definition "Animals, typically domestic or tame, that are housed and cared for by humans for the purposes of pleasure or companionship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pets"@en .

aat:300249497 a skos:Concept ;
    skos:definition "Animals that have been tamed and live with or are cared for by humans; typically limited to animals that have been altered through selective breeding to modify the behavior and often the appearance of their wild ancestors, such as dogs, domestic cats, horses, and cattle. The term excludes wild species of animals cared for by humans in a zoo, park or other place, even if the animal has been bred and raised in captivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domestic animals"@en .

aat:300249525 a skos:Concept ;
    skos:definition "Any living organisms, including human beings; may be real or fictional, including mythical or legendary creatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animals"@en .

aat:300249532 a skos:Concept ;
    skos:definition "Seasonal temporary dwellings or huts of various western and southwestern Native American tribes roughly domical in form, constructed of bent saplings, brushwood, and bark, and covered with reed mats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wickiups"@en .

aat:300249541 a skos:Concept ;
    skos:definition "Style and culture of a group of Native Americans inhabiting parts of Oregon and Washington state in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Walla Walla"@en .

aat:300249545 a skos:Concept ;
    skos:definition "Use generally to refer to various types of Native North American dwellings and ritual buildings, usually with regard to Plains Indians tribes; when possible use a more specific term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodges"@en .

aat:300249549 a skos:Concept ;
    skos:definition "Body of several self-governing churches in Greece and elsewhere within the larger communion of Orthodox Eastern Christianity. The member communities have no obedience to a central authority: they conform in general to the liturgy and discipline of the Byzantine Rite, but look to their respective Holy Synods in their home countries for governing authority and direction. They have a liturgy traditionally conducted in Koine Greek, the original language of the New Testament, and they share a common Greek cultural tradition. The current territory of these churches covers the Eastern Mediterranean region that was formerly part of the Byzantine Empire, as well as newer churches established throughout the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek Orthodox"@en .

aat:300249555 a skos:Concept ;
    skos:definition "An Eastern Orthodox church under the jurisdiction of the Patriarch of Moscow, in communion with other Eastern Orthodox Churches. According to tradition, the church was founded by the Apostle Andrew, who is thought to have visited Scythia and Greek colonies along the northern coast of the Black Sea. An organized Christian community is documented to have existed in Kiev, and Christianity became the state religion, in the 10th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian Orthodox"@en .

aat:300249561 a skos:Concept ;
    skos:definition "Dwellings of the Seminole and Miccosukee Indians of Florida framed with poles and logs, thatched, partially or fully open-sided, and usually having a living platform raised 2 to 3 feet above ground level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chickees"@en .

aat:300249564 a skos:Concept ;
    skos:definition "Printmakers who work in aquatint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquatinters"@en .

aat:300249568 a skos:Concept ;
    skos:definition "Stiff, durable textile characterized by corded effects in either the warp or weft, originally made in white cotton, later also in rayon or silk, and printed or in colors; used for dresses, blouses, trousers, sports clothing, purses, and neckwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piqué"@en .

aat:300249570 a skos:Concept ;
    skos:definition "Use to designate the physical environment of the streets including such elements as structures, open spaces, and vegetation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "streetscapes"@en .

aat:300249572 a skos:Concept ;
    skos:definition "Printed matter or objects devised to advertise or promote products, causes, or other concerns, especially those items given away to prospective consumers, clients, or contributors. Not used with reference to items produced before the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promotional materials"@en .

aat:300249582 a skos:Concept ;
    skos:definition "The physical and chemical changes occurring in sediments between the times of deposition and solidification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagenesis"@en .

aat:300249587 a skos:Concept ;
    skos:definition "Limestone having a light gray color, occurring widely throughout Great Britain and Ireland, in deposits dating to the Dinantian Epoch of the Carboniferous Period, from about 345 to 280 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carboniferous limestone"@en .

aat:300249589 a skos:Concept ;
    skos:definition "Consisting of more than one individual crystal having various orientations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polycrystallinity"@en .

aat:300249592 a skos:Concept ;
    skos:definition "Stencils used to create paintings on fabric or paper; often more than one stencil is used to create an image, commonly fruits or flowers; popular in the 19th century, especially in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theorems"@en .

aat:300249621 a skos:Concept ;
    skos:definition "Extremely small, metabolically inert microorganisms composed of a short strand of either DNA or RNA within a protein coat, and, in some, a surrounding envelope; they replicate only within the cells of living hosts, primarily plants, animals, and bacteria, taking over the nucleus and directing it to produce viral proteins and DNA or RNA. They frequently cause disease in their hosts. Viruses occupy a special taxonomic position: they are not plants, animals, or prokaryotic bacteria (single-cell organisms without defined nuclei), and they are generally placed in their own kingdom. In fact, viruses should not even be considered organisms, in the strictest sense, because they are not free-living, meaning they cannot reproduce and carry on metabolic processes without a host cell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Virus"@en .

aat:300249626 a skos:Concept ;
    skos:definition "Composite organisms consisting of a fungus and a photosynthetic partner, either a green alga or a cyanobacterium, growing together in a symbiotic relationship. Lichens are named based on the fungal component. They are greenish gray, yellow, brown, or blackish in color, growing in leaflike, crustlike, or branching forms on exposed surfaces such as rocks, tree trunks, and walls. which plays the primary role in determining the lichen's form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lichens"@en .

aat:300249644 a skos:Concept ;
    skos:definition "Class of sac-like marine filter feeders characterized by a tough outer \"tunic\" made of the polysaccharide tunicin, as compared to other tunicates which are much less robust. They have with some primitive vertebrate features, found in all seas from the intertidal zone to the greatest depths. The tadpole-like larvae are free-swimming and have a notochord (a flexible, rod-like structure common to all vertebrates) and a nerve cord in the tail. When the larva finds a place to settle, it attaches itself with a sucker; the tail with its notochord and nerve cord is absorbed and disappears. They are commonly found on pier pilings, ships' hulls, rocks, large seashells, and the backs of large crabs. Some species live individually; others live in groups or colonies. Adults have functional male and female reproductive organs; fertilization occurs when eggs are shed into the water and come into contact with sperm from another individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ascidiacea"@en .

aat:300249646 a skos:Concept ;
    skos:definition "Subphylum of small marine animals found throughout the seas of the world. Most are underwater saclike filter feeders, although some are predators. Like other chordates, they have develop a notochord early in their development. Adult members are commonly embedded in a tough secreted tunic containing cellulose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tunicata"@en .

aat:300249651 a skos:Concept ;
    skos:definition "Class of vertebrates representing numerous primitive, fish-like, jawless animals, such as lampreys, hagfishes, and some extinct groups. Some classifications list Agnatha as a superclass with lampreys and hagfishes as classes. Jawless fishes probably arose from ancient small, softbodied filter-feeding organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agnatha"@en .

aat:300249653 a skos:Concept ;
    skos:definition "Order containing 22 species of primitive, eel-like, jawless vertebrates that are scaleless, have a funnel-like toothed sucking mouth, no paired fins, large eyes, one nostril on the top of the head, and seven gills on each side. The animals begin life as burrowing freshwater larvae (ammocoetes), which are toothless, have rudimentary eyes, and feed on microorganisms; they transform into adults via a metamorphosis that is as radical as that seen in amphibians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Petromyzonidae"@en .

aat:300249654 a skos:Concept ;
    skos:definition "Order of eel-shaped, scaleless, soft-skinned aquatic primitive vertebrates with paired thick barbels on the end of the snout, a tail fin (but no paired fins), no jaws, cartilaginous skeletons, mouths comprising round or slit-like sucking openings with horny teeth, poorly developed eyes buried under the skin, a single nostril at the end of the snout, and five to 15 pairs of gills used for respiration. They are found in cold seawater, habitually lie buried except for the tip of the head on soft bottoms and in burrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hyperotreti"@en .

aat:300249658 a skos:Concept ;
    skos:definition "Members of an order containing 400 living species and many fossil species of predatory, cartilaginous fishes that have a fusiform shape and gill cleft location on either side of the head resembling bony fishes; most having a tough skin that is dull gray in color and roughened by toothlike scales; a muscular, asymmetrical, upturned tail and pointed fins; a pointed snout extending forward and over a crescentic mouth set with sharp triangular teeth; and a lack of a swim bladder requiring the animals to swim nearly perpetually to keep from sinking to the bottom. A few of the larger species are able to maintain their body temperature above the surrounding water temperature, although they are not truly warm blooded. Sharks developed as long ago as 450 million years ago. Some classifications place sharks in the superorder Selachimorpha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Selachii"@en .

aat:300249660 a skos:Concept ;
    skos:definition "General name for various members of nine genera in three families: Rajidae, Arynchobatidae, and Anacanthobatidae, having in common that they are very large, flat, cartilaginous fish often used for food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skates"@en .

aat:300249662 a skos:Concept ;
    skos:definition "Ancient family of cartilaginous fish, abundant in the fossil record, with the sharks their closest living relatives; they branched off from sharks 400 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chimaeridae"@en .

aat:300249665 a skos:Concept ;
    skos:definition "Class of vertebrate animals characterized by their ability to exploit both aquatic and terrestrial habitats, typically animals that lay eggs in water, in their early state breathe by gills like fishes, breathe air as adults but have moist skin and rely heavily on cutaneous (skin-surface) respiration, possess a double-channeled hearing system, have green rods in their retinas to discriminate hues, and pedicellate (two-part) teeth. They are represented by nearly 6,200 extant species; their ancestors emerged around 340 million years ago during the Upper Mississippian Epoch in the evolution of animals from strictly aquatic forms to terrestrial types. Modern examples are frogs and toads, newts and salamanders, and caecilians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amphibia"@en .

aat:300249701 a skos:Concept ;
    skos:definition "Largest class of the phylum Mollusca, consisting of about 65,000 species living in the ocean, fresh water, and on land. The name means \"belly-footed,\" referring to the broad tapered foot on which these animals glide. Includes snails, which have a shell into which the animal can withdraw, and slugs, which differ from snails in having shells that are reduced to an internal fragment or completely lost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gastropoda"@en .

aat:300249702 a skos:Concept ;
    skos:definition "General term used to refer to many families and species of gastropod that have coiled shells in the adult stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snails"@en .

aat:300249707 a skos:Concept ;
    skos:definition "Clade including crustaceans, insects, and myriapods, all having mandibles on the third head segment that are modified for feeding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mandibulata"@en .

aat:300249710 a skos:Concept ;
    skos:definition "General term referring to all aquatic invertebrates having an outer shell, especially those which humans eat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shellfishes"@en .

aat:300249712 a skos:Concept ;
    skos:definition "Members of a class containing up to 8,000 species of long, flattened, many-segmented predaceous arthropods, in which each segment except the hindmost bears one pair of legs for a total of 14 to 177 pairs, and having one pair of long, many-jointed antennae, and a pair of jawlike venomous claws just behind the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chilopoda"@en .

aat:300249714 a skos:Concept ;
    skos:definition "Members of the arthropod group that includes spiders, daddy longlegs, scorpions, and (in the subclass Acari) the mites and ticks, as well as lesser-known subgroups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arachnida"@en .

aat:300249715 a skos:Concept ;
    skos:definition "Order containing about 38,000 living species of predatory arthropods having two body segments, eight legs, no chewing mouth parts, no wings, and in many species possessing the ability to spinning webs, which are made of a thin, strong protein strand extruded from spinnerets (most commonly found on the end of the abdomen) and in which their prey is caught.They feed almost entirely on insects. In the context of art and other cultural objects, the presence of spiders in a storage area usually indicates that insects are also present. Spiders, however, do not pose any danger to artifacts themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Araneae"@en .

aat:300249717 a skos:Concept ;
    skos:definition "Members of an order including around 1,400 species of arachnids having a pair of large nippers and a general resemblance to a miniature lobster; they inhabit tropical and warm temperate countries in both hemispheres."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scorpiones"@en .

aat:300249719 a skos:Concept ;
    skos:definition "Members of an order containing 3 families, 18 genera, and close to 900 species or arachnids that are external parasites (ectoparasites) that take nourishment from the blood of mammals, birds, reptiles, and amphibians. Ticks are important parasites of large wild and domestic animals and are also significant as carriers of serious diseases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ixodida"@en .

aat:300249721 a skos:Concept ;
    skos:definition "General term referring to a number of genera containing about 30,000 species of tiny small, often microscopic in size arthropods, many of which are parasites of animals or plants or are destructive to food and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mites"@en .

aat:300249722 a skos:Concept ;
    skos:definition "Members of a infraorder containing ten-legged crustaceans having relatively short tails that are curled under the thorax, or midsection, a broad thick exoskeleton, and a first pair of legs that is modified into pincers. The common term \"crab\" is sometimes part of the name of other crustaceans and insects, such as hermit crabs or lice, that resemble true crabs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brachyura"@en .

aat:300249724 a skos:Concept ;
    skos:definition "Members of a family of large marine stalk-eyed ten-footed long-tailed crustacean having a first pair of feet that are very large and form the characteristic claws (chelae), a rigid segmented exoskeleton, compound eyes on movable stalks, two pairs of long antennae, and a flipper-like muscular tail that is used for swimming by propelling the animal backward. Members of other families of crustaceans may have the word \"lobster\" in their common name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homaridae"@en .

aat:300249729 a skos:Concept ;
    skos:definition "Members of an infraorder containing approximately 2,000 species of crustaceans characterized by a semitransparent body flattened from side to side and a flexible abdomen terminating in a fanlike tail. They are close relatives of crabs, crayfish, and lobsters. Shrimps are sometimes classified as a suborder, Natantia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caridea"@en .

aat:300249762 a skos:Concept ;
    skos:definition "Containers, often set into a wall, used for safekeeping or storage and usually capable of being locked, such as those used in schools and gymnasiums for storing clothing and other valuables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lockers"@en .

aat:300249766 a skos:Concept ;
    skos:definition "Projecting aperatures used to direct the flow of fluids or air or to change the velocity of the flow, especially such aperatures that taper or have a constriction as on the end of a hose or bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nozzles"@en .

aat:300249768 a skos:Concept ;
    skos:definition "Instruments, apparatus, or devices that convey or reproduce sounds at a distance, especially such devices in which the human voice is transmitted as by wire, satellite, or via base-station antennas as short-wave analog or digital signals. The term was used as early as the 18th century to refer to string phones (cups joined by a string), but the modern device is attributed to Alexander Graham Bell, who patented it in March 1876. That original telephones worked on the principle that sounds of speech are complex vibrations in air, which can be transferrable to solid bodies and in electrical impulses in conducting metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephones"@en .

aat:300249771 a skos:Concept ;
    skos:definition "Automatic apparatuses for regulating temperature, particularly such a device in which the expansive force of metals or gas acts directly upon the source of heat, cooling, ventilation, or the like, or controls them indirectly by opening and closing an electric circuit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermostats"@en .

aat:300249775 a skos:Concept ;
    skos:definition "Devices that permit both the transmission and reception of audio messages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transceivers"@en .

aat:300249785 a skos:Concept ;
    skos:definition "Pelt of any of the fur seals prepared for use in clothing or other artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealskin"@en .

aat:300249788 a skos:Concept ;
    skos:definition "Wood rendered dry, crumbly, and easily ignitable by the action of certain fungi; often used as tinder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punk"@en .

aat:300249790 a skos:Concept ;
    skos:definition "Substance derived from the dried, buttonlike top of the peyote cactus, used in religious ceremonies as a stimulant and hallucinogen by some native groups in Mexico and the southwestern United States. Used as a hallucinogenic drug; its active ingredient is mescaline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peyote"@en .

aat:300249795 a skos:Concept ;
    skos:definition "Synthetic garnet that if pure, is colorless and can be made to simulate a diamond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gadolinium gallium garnet"@en .

aat:300249798 a skos:Concept ;
    skos:definition "Synthetic crystal formed by the flame fusion process that can be made to simulate a diamond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strontium titanate"@en .

aat:300249800 a skos:Concept ;
    skos:definition "Machines used to cut thin sections (3 to 5 micrometers thick) of plant and animal tissue for microscopic examination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microtomes"@en .

aat:300249802 a skos:Concept ;
    skos:definition "Modified microtomes used to cut ultra-thin sections (20 to 100 nanometers thick) of plant and animal tissue for electron microscopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultramicrotomes"@en .

aat:300249804 a skos:Concept ;
    skos:definition "A process involving hydrolysis of an organic compound especially by alkali with the formation of salts of the fatty acids together with glycerol resulting in soap or soapy deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saponification"@en .

aat:300249810 a skos:Concept ;
    skos:definition "A volatile flammable petroleum distillate often used as an extracting agent for soft resins, oils, and waxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petroleum ether"@en .

aat:300249812 a skos:Concept ;
    skos:definition "Any number of methods for determining volumetrically the concentration of a desired substance in solution by adding a standard solution of known volume and strength until the reaction is completed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titration"@en .

aat:300249814 a skos:Concept ;
    skos:definition "Public officers of ancient Rome, elected from the plebeians and having the specific function of protecting the individual citizen, particularly plebeians, from any arbitrary exercise of power by the ruling patrician magistrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribunes"@en .

aat:300249819 a skos:Concept ;
    skos:definition "Victory celebrations of ancient Rome, held in honor of generals and admirals, or in Imperial times of emperors or members of the imperial family, who had won a complete victory over a foreign enemy. Typically, the celebration consisted of a victory procession including the honored commander, his army and spoils of war, execution of the chief prisoner, sacrifices at the Temple of Jupiter, and a public feast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triumphs"@en .

aat:300249821 a skos:Concept ;
    skos:definition "Refers to the emotional, intellectual, and physiological condition of sexual arousal. Use also for the capacity or quality of inspiring such arousal through suggestion, symbolism, or allusion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eroticism"@en .

aat:300249828 a skos:Concept ;
    skos:definition "Aromatic beverage prepared from selected dried leaves and buds of the tea plant, by infusion in hot water. For similar beverages made from various other plants and herbs, use \"herbal tea.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea"@en .

aat:300249832 a skos:Concept ;
    skos:definition "Explosive devices typically consisting of a paper case containing combustible material, an oxidizing agent, and, if desired, a metal salt as a coloring agent; used for signals and celebrations. For such celebratory displays of light, sound, or smoke, use \"fireworks (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireworks"@en .

aat:300249839 a skos:Concept ;
    skos:definition "Small, thin containers often of paper and similar in form to envelopes or flat bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packets"@en .

aat:300249843 a skos:Concept ;
    skos:definition "Secondary roof support members, usually light poles or trimmed saplings, placed perpendicularly or in a herringbone pattern over vigas (primary beams) in Native American or Spanish American adobe construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latillas"@en .

aat:300249861 a skos:Concept ;
    skos:definition "Technique of resist dyeing in which hanks of thread are bound and dyed before being woven into fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ikat"@en .

aat:300249863 a skos:Concept ;
    skos:definition "Cellulose, usually derived from wood pulp or cotton linter, that is treated with an alkali, such as sodium hydroxide; used to produce viscose rayon and other cellulose derivatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkali cellulose"@en .

aat:300249866 a skos:Concept ;
    skos:definition "Multifunctional ritual and pictorial modes in which deities occupy purified geometric precincts. They are represented as geometric motifs, often circular and symbolic of the Universe, capable of innumerable variation and meaning in a variety of media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandalas"@en .

aat:300249869 a skos:Concept ;
    skos:definition "Persian decorative pear or teardrop shape, ultimately derived from the shape of a leaf or bush; often found on carpets and other textiles. The European paisley motif is copied from the boteh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boteh"@en .

aat:300249916 a skos:Concept ;
    skos:definition "Animals that typically acquire food by actively hunting or lying in wait to kill and eat other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "predators"@en .

aat:300249917 a skos:Concept ;
    skos:definition "Animals that are typically sources of food for other animals that actively hunt or lie in wait to kill them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prey"@en .

aat:300249918 a skos:Concept ;
    skos:definition "Animals that typically feed on prey that has already been killed by another animal or that has died by accident or natural causes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scavengers"@en .

aat:300249920 a skos:Concept ;
    skos:definition "Telecommunication system whereby visual images, with or without accompanying sound, are converted to electromagnetic waves and transmitted to distant receivers where they are reconverted into moving visual images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television"@en .

aat:300249925 a skos:Concept ;
    skos:definition "Small rooms or furniture pieces for storing food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food cupboards"@en .

aat:300249926 a skos:Concept ;
    skos:definition "One piece cupboards, usually with two drawers over one or two doors, used to store foodstuffs, particularly when used to store canned or preserved foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jelly cupboards"@en .

aat:300249934 a skos:Concept ;
    skos:definition "The collotype process advanced by F. Joubert in France in the 1860s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phototype"@en .

aat:300249941 a skos:Concept ;
    skos:definition "Positive albumen prints on paper from glass negatives; made by a process patented by J. A. Whipple of Boston in 1850. Distinguished from \"hyalotypes\" produced on glass by a similar process patented by the Langenheim brothers of Philadelphia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystalotypes"@en .

aat:300249949 a skos:Concept ;
    skos:definition "Positive albumen prints upon glass widely used to create lantern slides and sometimes larger glass transparencies hung in windows for decoration; produced by a patented process called Hyalotype, developed and promoted by the Lingenheim brothers of Philadelphia from 1850. Distinguished from \"crystalotypes\" on paper produced by a similar process patented by J. A. Whipple of Boston."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyalotypes"@en .

aat:300249951 a skos:Concept ;
    skos:definition "Collotypes produced by a process advanced by F. Joubert in France in the 1860s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phototypes"@en .

aat:300249953 a skos:Concept ;
    skos:definition "Architectural models made to help clarify and visualize aspects of a project during the design process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "study models"@en .

aat:300249968 a skos:Concept ;
    skos:definition "Process for producing wrought iron or steel from pig iron by melting and agitation in a bath followed by working and forging the metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puddling"@en .

aat:300249973 a skos:Concept ;
    skos:definition "Animals without a backbone or spinal column, including all soft-bodied animals without a rigid internal skeleton for the attachment of muscles, but often with a hard outer skeleton, comprising the great majority of all animals (such as insects, mollusks, and crustaceans). Apart from the absence of a vertebral column, invertebrates have little in common. The taxonomic term Invertebrata, formerly used in contrast to Vertebrata (still a valid subphylum name), is not used in modern classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invertebrates"@en .

aat:300249978 a skos:Concept ;
    skos:definition "Drawing wire by forcing it through a series of progressively smaller holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wiredrawing"@en .

aat:300249982 a skos:Concept ;
    skos:definition "The activity of buying, selling, or bartering commodities, particularly when done illegally or disreputably. As used by UNESCO and other international regulatory agencies, refers to Illicit trade of antiquities and other movable cultural property often across national borders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trafficking"@en .

aat:300249983 a skos:Concept ;
    skos:definition "Microscopic traces of wear on artifacts; used especially in reference to archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microwear"@en .

aat:300249989 a skos:Concept ;
    skos:definition "Telecommunication system whereby sound and code signals are transmitted through space without wires by means of radio frequency electromagnetic waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio"@en .

aat:300250018 a skos:Concept ;
    skos:definition "General term for any member of the order Anura that is smooth-skinned, semi-aquatic, and leaping, as distinguished from more terrestrial, squat, warty, hopping anurans, which are called \"toads.\" There is no taxonomic distinction between frogs and toads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frogs"@en .

aat:300250022 a skos:Concept ;
    skos:definition "Common name for several species of deer-like ruminants from several genera, including true antelopes, goat-like antelopes, and ox-like antelopes. They have in common that they are even-toed, hoofed mammals that typically are swift, slender, and graceful plains dwellers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antelopes"@en .

aat:300250026 a skos:Concept ;
    skos:definition "General term denoting any non-human member of the Hominoidea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apes"@en .

aat:300250028 a skos:Concept ;
    skos:definition "Common term referring to the New World monkeys and the Old World monkeys, two of the three groupings of simian primates, the third of which is the apes. There are over 250 known living species of monkey. Because of their similarity to monkeys, apes are often called \"monkeys\" in informal usage. Furthermore, some monkey species have the word \"ape\" in their common name, causing further confusion. Because monkeys are not a single coherent group, they do not all share any particular traits that are not also shared with the apes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monkeys"@en .

aat:300250036 a skos:Concept ;
    skos:definition "General term referring to domestic birds, including chickens, ducks, geese, turkeys, etc., which are raised for their flesh, eggs, or feathers, but usually excluding wild game birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poultry"@en .

aat:300250037 a skos:Concept ;
    skos:definition "Members of a species, the red jungle fowl, that is the most widely domesticated fowl and existing in many breeds. The wild cock has shining silky plumage, red on the head and back and green-black elsewhere; the hen is rusty brown with speckled neck and minimal comb. Domestic chickens are raised worldwide for their meat and eggs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gallus gallus"@en .

aat:300250039 a skos:Concept ;
    skos:definition "Adult male birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocks"@en .

aat:300250041 a skos:Concept ;
    skos:definition "General term applied to many of the 40 species of glossy black birds in the genus Covus, although some birds in this genus are called \"ravens\" rather than crows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crows"@en .

aat:300250043 a skos:Concept ;
    skos:definition "Extinct flightless birds native to Mauritius, first seen by Portuguese sailors about 1507. They were extinct by 1681 Dodos weighed about 50 pounds, had blue-gray plumage, a big head, a blackish bill with reddish sheath forming the hooked tip, small useless wings, stout yellow legs, and a tuft of curly feathers high on its rear end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raphus cucullatus"@en .

aat:300250045 a skos:Concept ;
    skos:definition "General term referring to smaller members of the family Columbidae; larger members are called \"pigeons.\" The white dove is the symbol of peace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doves"@en .

aat:300250047 a skos:Concept ;
    skos:definition "General term for members of various species of relatively small, short-necked, large-billed waterfowl. They differ from geese in being smaller in size and having legs that are placed rearward, and the result is a distinctive waddling gait. Males, known as drakes, and females, known as hens, exhibit some degree of differentiation in plumage and in call."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ducks"@en .

aat:300250049 a skos:Concept ;
    skos:definition "General term referring to several species in diverse genera of the family Accipitridae, that are not all closely related to each other, but having in common that they are large, powerful hunters, heavy-beaked, and have a fully feathered head and strong feet equipped with great curved talons. Because of their strength and agressive nature, eagles have been a symbol of war and imperial power since Babylonian times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eagles"@en .

aat:300250051 a skos:Concept ;
    skos:definition "Members of a genus containing birds of prey characterized by thin, tapered wings that enable them to fly at high speed and to change direction rapidly, plumes called \"flags\" on their legs, and a notch in their hooked beak called a \"tooth.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Falco"@en .

aat:300250053 a skos:Concept ;
    skos:definition "General term referring to members of many species in the order Artiodactyla, including well-known large grazing mammals such as cattle, goats, sheep, deer, antelope, camels, and llamas. Ruminants digest food by regurgitating semi-digested cud to re-chew it in order to extract the maximum possible food value. Ruminants are often divided into suborders Ruminantia and Tylopoda. Other other large grazing mammals such as kangaroos and horses are not strictly ruminants, although they have similar adaptations for surviving on large quantities of low-grade food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruminants"@en .

aat:300250055 a skos:Concept ;
    skos:definition "General term referring to all birds of prey of either Falconiformes or Strigiformes orders, including hawks, eagles, vultures, falcons, and owls, having in common a hooked beak, sharp talons, and keen eyesight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raptors"@en .

aat:300250059 a skos:Concept ;
    skos:definition "General term referring to members of hundreds of species of small, conical-billed, seed-eating songbirds belonging to several families in the order Passeriformes, including true finches of the Fringillidae family, as well as waxbills, buntings, American sparrows, and Darwin's finches of the Galapagos islands, from the Emberizidae, Estrildidae, Carduelidae, and Ploceidae families. Although not closely related, finches are very similar-looking and typically have patches of bright color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finches"@en .

aat:300250061 a skos:Concept ;
    skos:definition "General term referring to members of several species of songbirds of the genus Carduelis, all characterized by sharp, pointed bills, short tails, and bright yellow plumage. In Christian art, the goldfinch is a symbol of the human soul, often held captive by the infant Jesus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldfinches"@en .

aat:300250063 a skos:Concept ;
    skos:definition "General term referring to members of several species of large web-footed birds in different genera, especially the genera Anser and Branta, but also including a number of waterfowl of gooselike build that live in the Northern and Southern Hemispheres and belong to other groups. Geese have in common that they are larger than ducks and smaller than swans; they differ from ducks in having longer necks and legs that are set more forward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geese"@en .

aat:300250065 a skos:Concept ;
    skos:definition "General term referring to a large number of birds, most in Galliformes or Anseriformes orders, including the duck, chicken, turkey, pheasant, and many others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fowl"@en .

aat:300250066 a skos:Concept ;
    skos:definition "Members of a subfamily containing about 60 species of long-legged wading birds that are widely distributed over the world, but are most common in the tropics. They commonly stand with neck bent in a characteristic S-shape, feed while wading quietly in the shallow waters of pools, marshes, and swamps, and nest in rough platforms of sticks constructed in bushes or trees near water; the nests usually are grouped in colonies called heronries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ardeinae"@en .

aat:300250068 a skos:Concept ;
    skos:definition "Members of a species of crested birds found from southern Europe and Africa to southeastern Asia, the sole extant members of the family Upupidae. The birds are pinkish brown on the head and shoulders, with a long, black-tipped, erectile crest and black-and-white barred wings and tail. In the ancient Greek legend of Philomela, Tereus is a wicked king who is transformed into a hoopoe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upupa epops"@en .

aat:300250069 a skos:Concept ;
    skos:definition "Birds that frequent bodies of water or inhabit the margin of lakes, rivers, seas, or other water. May be used to specifically refer to only larger swimming birds, such as ducks, geese, and swans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterfowl"@en .

aat:300250070 a skos:Concept ;
    skos:definition "General term referring to numerous species of birds of prey in several genera in the family Accipitridae. Kites are characterized by a light build, small head, partialy bare face, short beak, long, narrow wings, and weak legs. They spend a great deal of time soaring. In general they feed on carrion but may also take live prey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kites"@en .

aat:300250072 a skos:Concept ;
    skos:definition "General term for several species in four genera of long-tailed gregarious birds of the Corvid family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magpies"@en .

aat:300250074 a skos:Concept ;
    skos:definition "Members of the only living species of the family Struthionidae. The ostrich is a very large, swift-running, flightless bird with a long, almost bare neck and long legs with two toes on each foot, inhabiting open, semi-arid areas of Africa and formerly the Middle East. The male is mostly black but has white plumes in the wings and tail, the females are mostly brown. Ostrich plumes adorned the helmets of medieval European knights, and in the 19th century plumes were sold for women's hats, but the demand fell after World War I. Ostrich eggs are the world's largest and are used in art, especially to create vessels. Ostriches are now raised for their meat and hide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Struthio camelus"@en .

aat:300250076 a skos:Concept ;
    skos:definition "Members of the family comprising over 330 species of fruit- and seed-eating birds of the tropics and southern hemisphere, with a short, downcurved, hooked bill, grasping feet, a raucous voice, and often brightly colored plumage. Parrots have been kept as cage birds since ancient times for their bright colors and ability to imitate human speech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Psittacidae"@en .

aat:300250078 a skos:Concept ;
    skos:definition "Members of a family containing six or more genera of heavily built birds with feathered legs and toes, typically nonmigratory and native to temperate and subarctic regions of the northern hemisphere, feeding mainly on vegetation and insects. Many species are used as game birds. They are sometimes classified as a subfamily of pheasants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tetraonidae"@en .

aat:300250079 a skos:Concept ;
    skos:definition "Members of a species of large sedentary birds found in northern Eurasia in open moor and bog areas adjacent to forests, noted for having a group display in the spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tetrao tetrix"@en .

aat:300250080 a skos:Concept ;
    skos:definition "General term for members of eleven genera of medium-sized, ground-nesting, seed-eating birds of the pheasant family, intermediate between the larger birds called \"pheasants\" and the smaller quails. They are native to Europe, Asia, North Africa, and the Middle East, and were introduced to North America in the nineteeth century as game birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "partridges"@en .

aat:300250082 a skos:Concept ;
    skos:definition "Members of a genus containing two species of blue or green birds having a train of tail feathers that are colored a brilliant metallic green, each tipped with an eyespot that is ringed with blue and bronze. Peacocks have been kept as ornamental birds for centuries. The bird was a symbol of eternal life in the antiquity, due to the belief that its flesh did not rot. It has also been a symbol of pride. Traditionally classified as members of the Phasianidae family, but scientists now believe that the peafowl and Phasianidae do not share the same ancestry. Peafowl and their allies are a very ancient isolated group with no near allies; their family is classified separately as Pavoninidae in some systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pavo"@en .

aat:300250083 a skos:Concept ;
    skos:definition "Members of a genus containing eight living species of water birds distinguished by their large, elastic throat pouches. Pelicans inhabit lakes, rivers, and seacoasts in many parts of the world. They were symbols of renewed life in the Judeo-Christian stories and other folklore, due to the belief that the pelican revives or feeds its young with its own blood, which was a misconception arising from the red tip on the beak of some species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pelecanus"@en .

aat:300250085 a skos:Concept ;
    skos:definition "Members of a subfamily containing about 50 living species in 16 genera, comprising long-tailed birds of open woodlands and fields, typically hunted for game. The males of most species are have brightly colored plumage, and the the females are plain. Pheasants are native to Asia, western Europe, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phasianinae"@en .

aat:300250087 a skos:Concept ;
    skos:definition "Members of a species of gray and black pigeon. It was domesticated since at least 4500 BCE in Mesopotamia. It was bred as many varieties; it became feral and lives in cities worldwide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Columba livia"@en .

aat:300250089 a skos:Concept ;
    skos:definition "General term referring to several species of the genus Corvus, characterized as being heavily billed, dark, intelligent birds. Ravens are distinguished from their close relatives the various species of crows in the genus Corvus in that the raven has a heavier bill and shaggier, more lustrous plumage than the crow, especially around the throat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ravens"@en .

aat:300250091 a skos:Concept ;
    skos:definition "General term referring to unrelated brownish birds with red breasts, one a thrush, the American robin (Turdus migratorius), and the other a flycatcher, the European robin (Erithacus rubecula)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robins"@en .

aat:300250093 a skos:Concept ;
    skos:definition "General term referring to several species of small birds of prey in the genus Accipiter, that with the goshawks are known as true hawks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sparrowhawks"@en .

aat:300250095 a skos:Concept ;
    skos:definition "General term referring to members of many species in the families Ploceidae, Passeridae, and Fringillidae, that resemble each other and are charaterized as small, chiefly seed-eating birds having conical bills, native to Europe and the New World."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sparrows"@en .

aat:300250097 a skos:Concept ;
    skos:definition "Member of the Old World sparrow family Passeridae, considered by some to be a relative of the Weaver Finch Family. one of the world's best-known and most abundant small birds lives in towns and on farms, worldwide, having accompanied Europeans from its original hom most of Eurasia and northern Africa. It was introduced into North America at Brooklyn, N.Y., in 1852 and within a century had spread across the continent. It is a 14-centimetre (5.5-inch) buffy-brown bird with a black bib."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passer domesticus"@en .

aat:300250101 a skos:Concept ;
    skos:definition "Members of a family containing 17 living species in several genera of large, long-necked, voiceless, wading birds having a long, stout bill and flying by alternately flapping and soaring, with neck outstretched and legs trailing. They are related to the herons, flamingos, and ibises. In folklore, storks are responsible for delivering human babies, probably deriving from some species tendency to nest on rooftops. The stork's large size, habit of serial monogamy, and faithfulness to an established nesting site are characteristics that contribute to their prominence mythology and folklore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ciconiidae"@en .

aat:300250103 a skos:Concept ;
    skos:definition "Members of the genus containing several living species and at least 10 extinct species of large waterfowl characterized by long-necks, heavy-bodies, large feet, graceful swimming style, and flying with slow wingbeats and with necks outstretched. Many swans are white. Swans are revered in many religions and cultures, especially Hinduism. They are common symbols in art around the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cygnus"@en .

aat:300250105 a skos:Concept ;
    skos:definition "Members of the genus containing two living species of ox-like grazing mammals, formerly abundant in Europe (now existing only in Lithuania) and North America. Often incorrectly called by the popular name \"buffaloes,\" which are correctly animals of different genera than bison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bison"@en .

aat:300250108 a skos:Concept ;
    skos:definition "Common name referring to several species of oxen in different genera, including the Asian water buffalo and African Cape buffalo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffaloes"@en .

aat:300250112 a skos:Concept ;
    skos:definition "Largest of the wild pigs, native to forests ranging from western and northern Europe and North Africa to India, the Andaman Islands, and China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sus scrofa"@en .

aat:300250114 a skos:Concept ;
    skos:definition "Genus containing at least 11 living and several fossil species of intelligent, social, even-toed ungulate having a stout body, sparse bristly hair, and a broad flat snout for rooting in the soil, including wild and domestic pigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sus"@en .

aat:300250116 a skos:Concept ;
    skos:definition "A collective term referring to live animals, particularly bovine animals, held as property or reared to serve as meat, or sources of milk, skin, wool, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle"@en .

aat:300250117 a skos:Concept ;
    skos:definition "Adult males of cattle, oxen, bison, camel, moose, walrus, whale, seal, rhinoceros, hippopotamus, giraffe, elephant, dolphin, and other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulls"@en .

aat:300250120 a skos:Concept ;
    skos:definition "Adult females of cattle, bison, camel, dolphin, elephant, elk, giraffe, hippopotamus, moose, oxen, rhinoceros, seal, walrus, whale, and other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cows"@en .

aat:300250122 a skos:Concept ;
    skos:definition "Genus of ruminant, hollow-horned mammals containing seven to nine species, including the wild goat, ibexes, the markhor, and the subspecies of domestic goat. The classification of goats is in flux based on new DNA research, and in some older classifications includes Ovis (sheep) and Ammotragus (Barbary Sheep), which are separate genera in other classifications. The Rocky Mountain goat is a separate genus, Oreamnos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capra"@en .

aat:300250124 a skos:Concept ;
    skos:definition "General term for several species of wild goats inhabiting the Asia, Africa, and the Alps and Apennines of Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ibexes"@en .

aat:300250126 a skos:Concept ;
    skos:definition "Members of the taxon of land dwelling archosaurs with an upright gait, by which their legs were straight, perpendicular to the ground, and supported the weight of the body so that the animal could walk or run more easily. Other reptiles and modern lizards had a sprawling gait. Dinosaurs first appeared in the Late Triassic Period about 215 million years ago and thrived worldwide for some 150 million years. Most died out by the end of the Cretaceous Period, about 65 million years ago, but many lines of evidence now show that one lineage evolved into birds about 150 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dinosauria"@en .

aat:300250130 a skos:Concept ;
    skos:definition "Domesticated species of Canis, formerly believed to be descended from Canis lupus, gray wolves; however, recent studies suggest that gray wolves and domestic dogs instead have a common ancestor, now extinct. Dogs come in a variety of shapes, and sizes and over 400 distinct breeds. All domestic or feral dogs are descended from a single common ancestral species. For more than 12,000 years, it has lived with humans as a hunting companion, protector, and as herders and guardians of sheep, goats, and cattle. Today, dogs are employed as aids to the blind and disabled, or for police work. In Western art, dogs have generally come to symbolize faithfulness and loyalty, however, in other cultures they can symbolizes a varity of traits, ranging from unclean to seducer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canis familiaris"@en .

aat:300250132 a skos:Concept ;
    skos:definition "General term applied to members of various large, wild species of Canis, particularly those of North America and Eurasia that hunt in packs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wolves"@en .

aat:300250139 a skos:Concept ;
    skos:definition "Members of a genus of even-toed ungulates containing two living species and several extinct species. Living members have a humped back, short tail, long slim legs, and long neck that dips downward and rises to a small narrow head, an upper lip that is split into two sections that move independently. The Arabian camel species has a single hump, and the Bactrian camel species has two humps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camelus"@en .

aat:300250142 a skos:Concept ;
    skos:definition "Breed known as the fastest and one of the oldest breed of dog. Streamlined and slender but strong, the greyhound can attain a speed of about 45 miles per hour. The greyhound stands 25 to 27 inches (64 to 69 cm) and weighs 60 to 70 pounds (27 to 32 kg). In art, greyhounds appear on an Egyptian tomb dating from about 3000 BC. In a painting by Dürer, the greyhound is identified with the harbinger of the Second Coming of Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greyhounds"@en .

aat:300250144 a skos:Concept ;
    skos:definition "Breed of dog that originated in China, and was introduced to England by Dutch traders at the end of the 17th century. The pug has a short muzzle, a black mask on the face, tightly curled tail, large head with prominent, dark eyes, and small, drooping ears. At maturity, it stands 10 to 11 inches (25.5 to 28 cm) and weighs about 14 to 18 pounds (6 to 8 kg). Its coat is short and glossy with the color ranging from apricot or silver fawn to black. In art, the pug can be found alongside sitters in portrait paintings, and as porcelain objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pugs"@en .

aat:300250148 a skos:Concept ;
    skos:definition "Hooved animal. Original populations of Equus caballus were once found in the steppe zone from Poland to Mongolia. Now domesticated, horses occur throughout the world and in feral populations in some areas. Three of the several early breeds of horse - Przewalski's horse from central Asia, the tarpan from eastern Europe and the Ukrainian steppes, and the forest horse of northern Europe - are generally thought to have been the ancestral stock of modern domestic horses. According to this line of thinking, Przewalski's horse and the tarpan formed the basic breeding stock from which the southerly 'warm-blooded' horses developed, while the forest horse gave rise to the heavy, 'cold-blooded' breeds. All modern breeds are divided as light, fast, spirited breeds typified by the modern Arabian, heavier, slower, and calmer working breeds typified by the Belgian, and intermediate breeds typified by the Thoroughbred. They are also classified according to where they originated (e.g., Percheron, Clydesdale, and Arabian), by the principal use of the horse (riding, draft, coach horse), and by their outward appearance and size (light, heavy, pony)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus caballus"@en .

aat:300250150 a skos:Concept ;
    skos:definition "Wild asses are desert dwellers that often inhabit very arid regions that are inhospitable to other large mammals. Donkeys are the domesticated descendants of the wild ass and are considered the same species in many classifications. The native range extends from Morocco to Somalia and Mesopotamia to Oman; true wild asses are found today only in northern Africa and the Arabian peninsula. Their color ranges from bluish gray to fawn. Domesticated and feral donkeys can now be found in all parts of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus asinus"@en .

aat:300250153 a skos:Concept ;
    skos:definition "Any of several breeds of small horses typically standing less than 14.2 hands (56.8 inches) high and noted for gentleness and endurance. Some breeds are not considered ponies, even if they are under 14.2 hands high."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ponies"@en .

aat:300250157 a skos:Concept ;
    skos:definition "General term referring to any of the larger species of marine mammals of the order Cetacea that have fore-limbs like fins and a tail with horizontal flukes, and are hunted for their oil and whalebone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whales"@en .

aat:300250159 a skos:Concept ;
    skos:definition "General term referring to any of several medium-sized species of cetaceous mammal, usually reserved for species having a longer and more slender snout than others (which are called porpoises)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolphins"@en .

aat:300250160 a skos:Concept ;
    skos:definition "Members of a family comprising four living genera of huge quadruped mammals having long curving ivory tusks, and a prehensile trunk or proboscis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elephantidae"@en .

aat:300250163 a skos:Concept ;
    skos:definition "Family of carnivorous mammals having a long body, short legs, and musky scent glands under the tail, including weasels, stoats, badgers, minks, skunks, martens, and otters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustelidae"@en .

aat:300250165 a skos:Concept ;
    skos:definition "General term referring to members of around ten species of small carnivores with very elongated, slender bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weasels"@en .

aat:300250167 a skos:Concept ;
    skos:definition "Members of a species of the weasel family with reddish brown that in winter in northern regions turns wholly white, except the tip of the tail, which is always black. The whiteness of ermine is often a symbol of purity in art and poetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustela erminea"@en .

aat:300250169 a skos:Concept ;
    skos:definition "Members of a genus containing around eight species of slender, agile, furry, bushy-tailed, forest-dwelling mammals of the weasel family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Martes"@en .

aat:300250170 a skos:Concept ;
    skos:definition "Members of a rather rare species of the weasel family that is dark in color, agile in trees, has a slender body, pursues prey into hollow trees or burrows, and despite its name rarely eats fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Martes pennanti"@en .

aat:300250175 a skos:Concept ;
    skos:definition "Members of the only living species in its genus. It is a medium-sized rodent with a laterally flattened tail, short legs, and a compact body, indigenous to wetlands of North America but found also in South America, Europe, Ukraine, Russia, Siberia, adjacent areas of China and Mongolia, and Honshu Island in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ondatra zibethicus"@en .

aat:300250185 a skos:Concept ;
    skos:definition "General term referring to members of several species of the Cyprinidae family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carp"@en .

aat:300250186 a skos:Concept ;
    skos:definition "Members of a species of ornamental aquarium and pond fish of the Cyprinidae (carp) family native to East Asia but introduced into many other areas. It was one of the earliest fish to be domesticated from a dark-gray or brown carp native to East Asia. It was first domesticated in China, then introduced to Europe in the late 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carassius auratus"@en .

aat:300250187 a skos:Concept ;
    skos:definition "Members of an order containing around 530 species in eight living families of true rays and skates, which are flat-bodied cartilaginous fishes related to sharks, having eyes on top of head, ventral gills, and greatly enlarged pectoral fins extending forward along gill opening to attach to sides of head and in some even meet in front of head. They swim by creating wavelike motions with these pectoral fins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rajiformes"@en .

aat:300250192 a skos:Concept ;
    skos:definition "General term for several species of fish in different genera in the family Salmonidae. Most trout are restricted to freshwater, though a few types migrate to the sea between spawnings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trout"@en .

aat:300250193 a skos:Concept ;
    skos:definition "Members of a genus containing eight species of elongated, robust, and streamlined fishes with a rounded body that tapers to a slender tail base and a forked or crescent-shaped tail. They have red-colored flesh, rather than white. Some species are warm-blooded, able to maintain body temperatures in very cold water. Some species in other genera have names including the word \"tuna,\" although they are not actually tuna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thunnus"@en .

aat:300250194 a skos:Concept ;
    skos:definition "Members of a species of cud-chewing hoofed mammal of Africa, with long legs, a long neck, a coat pattern of irregular brown patches on a light background, and a prehensile tongue. There are nine subspecies of giraffes, classified on the basis of coat pattern and other minor physical differences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Giraffa camelopardalis"@en .

aat:300250197 a skos:Concept ;
    skos:definition "Genus containing about 12 species and more than 50 recognized forms of graceful antelopes found on open plains and semideserts from Mongolia westward to the Atlantic coast of North Africa and throughout eastern and central tropical Africa. Three members of the genus Procapra are also commonly referred to as gazelles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gazella"@en .

aat:300250201 a skos:Concept ;
    skos:definition "General term formerly referring to a bivalve shell-fish such as the mussel or oyster; in more recent usage, refers to any large marine snail with a spiraling shell that is pointed on both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conchs"@en .

aat:300250204 a skos:Concept ;
    skos:definition "Species of marine snail found in sandy bottoms from Florida to Brazil; prized for its attractive white and pink ornamental shell. In some classifications now known as Eustrombus gigas or Lobatus gigas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strombus gigas"@en .

aat:300250215 a skos:Concept ;
    skos:definition "Family containing around 50 species of rabbits and hares. They differ from pikas, which also belong to the Lagomorpha order of mammals in having short furry tails, elongated ears, and and long hind legs adapted for leaping and jumping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leporidae"@en .

aat:300250216 a skos:Concept ;
    skos:definition "General term referring to any of more than 30 species belonging to the genus Lepus and sometimes used for species of other genera of the family Leporidae. They have long ears, a divided upper lip, and long hind legs adapted for leaping, but are distinguished form rabbits by significantly longer ears, longer hind feet, a shorter tail, longer body, and having young are born fully furred and with eyes wide open and seeing. The common names of species containing the word \"hare\" and \"rabbit\" are not strictly indicative of the genera to which the animals belong."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hares"@en .

aat:300250218 a skos:Concept ;
    skos:definition "General term referring to mammals belonging to any of several genera containing around 30 species of Leporids, having long ears, a divided upper lip, and long hind legs adopated for leaping, differing from hares in being smaller and having thier young born naked and blind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbits"@en .

aat:300250224 a skos:Concept ;
    skos:definition "General term for various members of the order Lepidoptera, typically those distinguished from butterflies by being nocturnal and having less colorful wings. Since moths are not a monophyletic group, they cannot be placed together in a scientific taxon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moths"@en .

aat:300250232 a skos:Concept ;
    skos:definition "Members of a family containing around 2,500 species of insects having two pairs of membranous wings, prominent compound eyes, three simple eyes (ocelli), and with males having the ability to produce distinctive sounds by vibrating membranes (timbals) near the base of the abdomen. Most species have a lifepan of two to five years, while some species have long life cycles, even up to 13 and 17 years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cicadidae"@en .

aat:300250233 a skos:Concept ;
    skos:definition "Members of a family containing around 1,000 species of leaping insects known for the musical chirping of the male, produced by rubbing a scraper located on one forewing along a row of about 50 to 250 teeth on the opposite forewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gryllidae"@en .

aat:300250249 a skos:Concept ;
    skos:definition "Members of a genus containing 38 living species of small rodents that usually have a pointed snout, relatively large eyes and ears, and a long tail, and typically feed on seeds and fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mus"@en .

aat:300250251 a skos:Concept ;
    skos:definition "Members of a species of small rodent native to Eurasia but introduced worldwide; now living in most parts of the world in close proximity to humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mus musculus"@en .

aat:300250253 a skos:Concept ;
    skos:definition "Members of a genus containing around 56 living species of thin-tailed, medium-sized rodents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rattus"@en .

aat:300250256 a skos:Concept ;
    skos:definition "A class of highly advanced and organized, exclusively marine animals having a well-developed head with large, well-organized eyes, a pair of strong, bony jaws like a parrot's beak, a set of elongated muscular arms or tentacles usually furnished with prehensile suckers or hooks, and in most species a bag of inklike fluid which they can eject to foil predators. Familiar representatives are the octopus, squid, cuttlefish, and chambered nautilus; there were a large number of distinct extinct forms, particularly flourishing in the late Paleozoic and Mesozoic times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cephalopoda"@en .

aat:300250261 a skos:Concept ;
    skos:definition "Members of a subclass containing around 1,220 species of arthropod that go through several distinct swimming stages as plankton, then usually fix themselves to a rocky or other hard submerged surface as adults, having a hard shell and feeding by reaching into the water with modified legs. Classified as an infraclass in some systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cirripedia"@en .

aat:300250263 a skos:Concept ;
    skos:definition "Family containing numerous species of small, bold, predatory carnivores found mainly in Africa but also in southern Asia and southern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Herpestidae"@en .

aat:300250274 a skos:Concept ;
    skos:definition "Refers to animals that naturally feed exclusively or nearly exclusively on the leaves and other parts of plants. Butterflies and elephants are examples of herbivores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbivores"@en .

aat:300250275 a skos:Concept ;
    skos:definition "Animals characterized by a varied diet of both plant and animal materials, as distinguished from a meat-eating carnivore or a plant-eating herbivore. Bears are examples of omnivores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "omnivores"@en .

aat:300250277 a skos:Concept ;
    skos:definition "Hybrid offspring produced by the mating of a female horse and a male donkey. The less-frequent cross between a female ass and a male horse results in a hinny, or hinney, which is smaller than a mule. Mules were beasts of burden in Asia Minor at least 3,000 years ago and are still used today in many parts of the world because of their ability to withstand hardships and perform work under conditions too severe for many other draft and pack animals. Mules are usually sterile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mules"@en .

aat:300250282 a skos:Concept ;
    skos:definition "Castrated adult male cattle, typically used as draft animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxen"@en .

aat:300250284 a skos:Concept ;
    skos:definition "Refers to members of the genus containing 5 or more species of ruminant (cud-chewing) mammals, including domestic sheep. Sheep are typically distinguished from goats by being stockier, having horns that more divergent in form, having scent glands in its face and hind feet, and the males lack the beards of goats. In all wild species of sheep, the outer coat is hair overlaying a short undercoat of fine wool; the fine wool has been developed into the fleece of domesticated sheep. Sheep were first domesticated from wild species of sheep at least 5000 BCE, and their remains have been found at numerous sites of early human habitation in the Middle East, Europe, and Central Asia. Domesticated sheep are raised for their fleece, milk, and meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ovis"@en .

aat:300250287 a skos:Concept ;
    skos:definition "Adult male uncastrated sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rams"@en .

aat:300250289 a skos:Concept ;
    skos:definition "The young of sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lambs"@en .

aat:300250291 a skos:Concept ;
    skos:definition "The female of sheep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ewes"@en .

aat:300250293 a skos:Concept ;
    skos:definition "Members of a family containing two living genera and 23 living species of large, amphibious, carnivorous reptiles having powerful jaws, short legs with clawed, webbed toes, a body form that allows the eyes, ears, and nostrils to be above the water surface while most of the animal is hidden below, a long massive tail, and thick, plated skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crocodylidae"@en .

aat:300250295 a skos:Concept ;
    skos:definition "Members of a suborder containing nearly 4,450 species of reptiles having a single temporal opening lying above the bar formed by postorbital and squamosal bones, a pectoral girdle and interorbital septum always present, well-eveloped male copulatory organs (hemipenes) and saclike ovaries in females, often an elongated body, a long tail, four legs, and a scaly or granulated hide. The classification of lizards and other reptiles is in flux."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sauria"@en .

aat:300250297 a skos:Concept ;
    skos:definition "General term referring to members of the Testudines order that are land dwelling rather than aquatic, being four-footed reptiles in which the trunk is enclosed between a carapace and plastron, formed by the dorsal vertebrae, ribs, and sternum; the skin being covered with large horny plates, commonly called the shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tortoises"@en .

aat:300250308 a skos:Concept ;
    skos:definition "Members of a family of ruminants typically having solid antlers that are shed yearly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cervidae"@en .

aat:300250310 a skos:Concept ;
    skos:definition "Members of a species of very large, heavy, long-legged, short-necked ruminants with large distinctive palmate antlers; they inhabit the northern parts of North America and Eurasia. They are called \"elk\" in Europe, but the term \"elk\" refers to another animal, Cervus canadensis, in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alces alces"@en .

aat:300250313 a skos:Concept ;
    skos:definition "The male of several animals, including deer, rat, sheep, squirrel, weasel, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucks"@en .

aat:300250314 a skos:Concept ;
    skos:definition "The male deer, especially of the red deer; specifically a hart or male deer of the fifth year of its life. Also used to refer to a male animal castrated when fully grown, as with cattle, a boar or hog, and other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stags"@en .

aat:300250315 a skos:Concept ;
    skos:definition "Family containing four genera and five living species and several extinct species. They are large, thick-skinned odd-toed hoofed quadruped mammals having one or two upright horns on the snout. Originally native to Africa, India, and eastern Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhinocerotidae"@en .

aat:300250317 a skos:Concept ;
    skos:definition "Members of a family containing 341 species of small mammals with cylindrical bodies, short and slender limbs, clawed digits, and small eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soricidae"@en .

aat:300250330 a skos:Concept ;
    skos:definition "Self-contained residences generally set in forests or other wilderness areas and designed for temporary, short-term use during special events, such as while on hunting or fishing excursions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodges"@en .

aat:300250342 a skos:Concept ;
    skos:definition "Subordinate buildings on the grounds of estates or parks used as the individual dwellings for employees, such as caretakers or gatekeepers. For structures located at the entranceway to the grounds, and which may or may not contain habitation spaces, use \"gatehouses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodges"@en .

aat:300250349 a skos:Concept ;
    skos:definition "Boxlike housings, usually of metal, placed over radiators to hide them from view, redirect the flow of warm air, or provide protection from a hot surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiator enclosures"@en .

aat:300250369 a skos:Concept ;
    skos:definition "Buildings housing institutions founded by or maintained by a monastery, abbey, magistrate, nobleman, or private charity for the reception and support of the aged and poor; may also contain the residence of almoners. For buildings where the elderly, poor, or helpless are cared for and put to work at public expense, use \"almshouses (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almonries"@en .

aat:300250371 a skos:Concept ;
    skos:definition "The ability to interpret and critically evaluate visible objects, actions, or symbols encountered in the environment, especially in works of art, television, and films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual literacy"@en .

aat:300250397 a skos:Concept ;
    skos:definition "Lidded troughs on legs or stands in which dough was mixed and left to rise and kneaded on top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough tray tables"@en .

aat:300250421 a skos:Concept ;
    skos:definition "Computer science concept of a place within the collective memories and interconnecting networks of computers filled with virtual 'stuff' and populated by people with virtual bodies. Distinguished from \"virtual reality\" which is an immersive virtual physical environment with user interfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyberspace"@en .

aat:300250423 a skos:Concept ;
    skos:definition "Use to describe objects mounted directly onto a ceiling, wall, or other surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface-mounted"@en .

aat:300250429 a skos:Concept ;
    skos:definition "Use to describe objects in a state or condition of being inclined or diverted from a horizontal or vertical position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilted"@en .

aat:300250434 a skos:Concept ;
    skos:definition "The ability to read and write."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literacy"@en .

aat:300250435 a skos:Concept ;
    skos:definition "The perception of identity, distinctiveness, and significance of a group that shares a linguistic group, religious belief, nationality, cultural tradition, or perceived physiological characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnicity"@en .

aat:300250441 a skos:Concept ;
    skos:definition "Substance which is traced through a biological, chemical, or physical system in order to study the system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracer"@en .

aat:300250452 a skos:Concept ;
    skos:definition "Endeavors to gain the attention, favor, or affection of another being, usually with the intent of establishing a relationship of further intimacy or marriage; the period during which such activities take place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtships"@en .

aat:300250455 a skos:Concept ;
    skos:definition "Small pillows placed on a chair, couch, or other furniture, primarily for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throw pillows"@en .

aat:300250465 a skos:Concept ;
    skos:definition "Motifs representing chubby, sometimes winged and naked figures of little boys, derived from Greco-Roman depictions of Eros. Common in art from Renaissance through the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "putti"@en .

aat:300250469 a skos:Concept ;
    skos:definition "Refers to the process of dividing into parts so as to destroy the integrity of a whole, for example, the separation limbs from a body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dismemberment"@en .

aat:300250472 a skos:Concept ;
    skos:definition "Refers to persons appointed, elected, or otherwise officially authorized to act in place of or as the second-in-command to a ruler, public officer, or executive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deputies"@en .

aat:300250476 a skos:Concept ;
    skos:definition "Unexpected happenings that occur without the intent or volition of any beings involved, especially those of an undesirable or unfortunate nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accidents"@en .

aat:300250480 a skos:Concept ;
    skos:definition "The movement of electrical charges, gases, liquids, or other materials or quantities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flow"@en .

aat:300250482 a skos:Concept ;
    skos:definition "Refers to the field of study that aims at developing manual skills and familiarity with tools and machinery or acquaintance with industrial processes. For the endeavor concerned with the design of machine-made products, use \"industrial design.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial arts"@en .

aat:300250491 a skos:Concept ;
    skos:definition "Genre that depicts or evokes idyllic life in the country; in works of pictorial art, often scenes of shepherds and shepherdesses in idealized arcadian landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastoral"@en .

aat:300250532 a skos:Concept ;
    skos:definition "Cabinets for radio receivers, often also having places for related audio accessories, such as record players."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio cabinets"@en .

aat:300250542 a skos:Concept ;
    skos:definition "Subjecting something to a special process again."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reprocessing"@en .

aat:300250545 a skos:Concept ;
    skos:definition "Water in the upper surface of the earth which forms the water table that supplies springs and wells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groundwater"@en .

aat:300250549 a skos:Concept ;
    skos:definition "Microscopy involving the use of video camera attachments to record the magnified image and allow for playback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video microscopy"@en .

aat:300250552 a skos:Concept ;
    skos:definition "Transfer lithography in which drawings or writing in autographic ink, litho ink, and chalk are tranferred from autographic paper to stone or zinc for lithographic printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autography"@en .

aat:300250554 a skos:Concept ;
    skos:definition "Flexible material made by bonding together two or more layers of materials with adhesive. For resin-impregnated laminate, such as paper or fabric, use \"plastic laminate.\" For thin sheets of layered plastic, use \"laminated plastic.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laminate"@en .

aat:300250556 a skos:Concept ;
    skos:definition "Shoulder belts worn across the breast that hold ammunition within pockets, loops, or cases or from which a wallet might be suspended at the side; also, decorated straps worn over the shoulder and across the breast by North American Indians. For bags with attached straps worn by North American Indians over the shoulder and across the breast, use \"bandolier bags.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandoliers"@en .

aat:300250565 a skos:Concept ;
    skos:definition "Species of bat found in southern Alaska, Canada, the higher elevation forested regions of Mexico, and across the United States from the Pacific to Atlantic coasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myotis lucifugus"@en .

aat:300250566 a skos:Concept ;
    skos:definition "General purpose bags carried by North American Indians with attached shoulder straps worn over the shoulder and across the breast. Usually made of wool, muslin, or buckskin and heavily decorated with beadwork, quillwork, or embroidery. For shoulder belts worn across the breast from which wallets, small bags, or pockets often containing ammunition are sometimes suspended, use \"bandoliers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandolier bags"@en .

aat:300250567 a skos:Concept ;
    skos:definition "Common North American species of relatively large brown bat that is distinct from the stoutly built Eurasian brown bat. Characterized as nocturnal, roosting during the day in hollow trees beneath loose tree bark, in the crevices of rocks or in man-made structures such as attics, barns, old buildings, eaves and window shutters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eptesicus fuscus"@en .

aat:300250568 a skos:Concept ;
    skos:definition "Species of bat common to western North America, ranging from British Columbia to Central Mexico and eastward to Colorado and Oklahoma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myotis yumanensis"@en .

aat:300250578 a skos:Concept ;
    skos:definition "Members of a genus containing two living species of amphibious rodents native to North America, Europe, and Asia. Beavers have short legs, a stout body, a small, broad, blunt head, large chisel-shaped incisor teeth, a broad, oval, horizontally-flattened, scaly tail, palmated hind feet, and a coat of soft fur. They are distinguished by their ability to chew through trunks and cut down trees, constructing huts of mud and wood for habitation, and dams for preserving a supply of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castor"@en .

aat:300250588 a skos:Concept ;
    skos:definition "Members of a common species of rat known worldwide. The brown rat may be brown or gray. As the black rat, the brown rat has exploited human food resources, moved all over the world with humans, and is often considered a pest because it has killed small livestock and native species, and spread certain diseases among humans; it has also been used in laboratories worldwide for medical, genetic, and basic biological research. It is thought to have originated in northern China; it is now the dominant rat in Europe and much of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rattus norvegicus"@en .

aat:300250596 a skos:Concept ;
    skos:definition "Members of a common species of rat known worldwide. Despite its name, the black rat exhibits several color forms. As the brown rat, the black rat has exploited human food resources, moved all over the world with humans, and is often considered a pest because it has killed small livestock and native species, and spread certain diseases among humans. The black rat originated in tropical Asia and spread through the Near East in Roman times before reaching Europe by the 6th century and spreading with Europeans across the world. Today it is again largely confined to warmer areas, having been supplanted by the brown rat in cooler regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rattus rattus"@en .

aat:300250601 a skos:Concept ;
    skos:definition "General term referring to 122 species in 22 genera of tree squirrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squirrels"@en .

aat:300250602 a skos:Concept ;
    skos:definition "Family containing 50 genera and 268 species of small rodents; the term \"squirrel\" is derived from the Greek \"skiouros,\" meaning \"shade tail,\" which describes one of the animals' most conspicuous and recognizable features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sciuridae"@en .

aat:300250605 a skos:Concept ;
    skos:definition "Members of a species of tree squirrel native to the eastern and midwestern United States and southeastern Canada, having a gray coat with reddish overtones, a white belly, and a large bushy tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scurius carolinensis"@en .

aat:300250608 a skos:Concept ;
    skos:definition "Members of a genus containing large, bushy-tailed, stocky ground squirrels native to mountainous areas such as the Alps, Carpathians, Tatra, and Pyrenees in Europe, the Rockies and the Sierra Nevada in the United States, and Northern Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marmota"@en .

aat:300250611 a skos:Concept ;
    skos:definition "Members of a species of giant-sized, stocky, North American burrowing ground squirrel, common in the northeastern and central United States, north to Alaska and southeast to Alabama. According to popular legend in the United States, the woodchuck emerges from hibernation to predict the coming of warm weather each year on February 2, designated as Groundhog Day and corresponding to the older Christian feast day, the Purification of the Virgin Mary, and to more ancient ceremonies marking the mid-point between the solstice and equinox."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marmota monax"@en .

aat:300250621 a skos:Concept ;
    skos:definition "The study of the biosphere, especially through geologic time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geobiology"@en .

aat:300250622 a skos:Concept ;
    skos:definition "Members of a genus containing five species of gregarious, colony-forming rodents that live in extensive burrow systems in grasslands of plains, high plateaus, and montain valleys in North America, and have a call resembling a dog's bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cynomys"@en .

aat:300250623 a skos:Concept ;
    skos:definition "The study and practice of the application of engineering principles and techniques to biological and medical problems, such as the biosynthesis of animal and plant products, erosion control using live plants, and the design and production of artificial limbs and organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioengineering"@en .

aat:300250633 a skos:Concept ;
    skos:definition "General term referring to members of 27 living species in two families of large herbivorous rodents having body and tail covered with sharp defensive spines composed of modified hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcupines"@en .

aat:300250637 a skos:Concept ;
    skos:definition "Those trained or working in bioengineering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioengineers"@en .

aat:300250642 a skos:Concept ;
    skos:definition "Branch of bioengineering dealing with medical problems, such as implantable devices, artificial limbs and organs, physical aids for the handicapped, and instrumentation used in research, diagnosis, and treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biomedical engineering"@en .

aat:300250664 a skos:Concept ;
    skos:definition "The force required to tear a specimen under standardized conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tearing resistance"@en .

aat:300250675 a skos:Concept ;
    skos:definition "Refers to the principal bedrooms in dwellings, usually the largest and intended for the person or persons who head the household; used especially in American contexts since the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master bedrooms"@en .

aat:300250678 a skos:Concept ;
    skos:definition "Complete self-contained apartment units or extensions to a house created within, or with minor exterior additions to existing single-family homes, usually with their own separate entrances and generally for relatives of the homeowners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessory apartments"@en .

aat:300250693 a skos:Concept ;
    skos:definition "A polymer made from the addition polymerization of acrylonitrile. Polyacrylonitrile was first made in the late 1930s and it quickly became an important type of synthetic rubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyacrylonitrile"@en .

aat:300250694 a skos:Concept ;
    skos:definition "The branch of science dealing with the three dimensional interpretation of flat images, often sections or projections, using general principles of geometrical probability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereology"@en .

aat:300250696 a skos:Concept ;
    skos:definition "The degree of hardness induced, usually in steel, to increase the upper limit of elasticity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spring temper"@en .

aat:300250699 a skos:Concept ;
    skos:definition "Paper made from high-grade rag pulp with a treated surface generally in imitation of parchment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vellum"@en .

aat:300250737 a skos:Concept ;
    skos:definition "Organized bodies of part-time, volunteer citizen soldiers with limited military training that are available for emergency service, usually for local defense and peace-keeping or to supplement the regular armed forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "militias"@en .

aat:300250741 a skos:Concept ;
    skos:definition "Military or naval forces that enforce a nation's maritime laws, assist vessels wrecked or in distress on or near its coasts, and in some countries maintain aids to navigation, prevent smuggling, and in wartime augment the regular navy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coast guards"@en .

aat:300250748 a skos:Concept ;
    skos:definition "Soldiers trained and equipped to serve at sea and in land operations incident to naval campaigns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marines"@en .

aat:300250795 a skos:Concept ;
    skos:definition "Objects, such as parts of the body and articles of clothing or of personal use, that belonged to or were associated with a saint, martyr, deity, or other holy person, preserved and held in veneration. Known in many cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relics"@en .

aat:300250799 a skos:Concept ;
    skos:definition "Tile used as finish flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor tile"@en .

aat:300250804 a skos:Concept ;
    skos:definition "Refers to nobles in Europe and Japan, specifically those of the second rank of the nobility of various European countries, ranking immediately below dukes and above earls or counts. It may also carry its original meaning, denoting counts or earls who held a march, or mark, which is a frontier district."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marquises"@en .

aat:300250810 a skos:Concept ;
    skos:definition "In the context of an individual page or sheet, such as a poster the main body of type or written matter, as opposed to the illustrations, margins, borders, headings, or other features. With reference to a book or periodical, refers to the main body of the writing, as distinct from front matter, notes, index, appendix, and bibliography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "text"@en .

aat:300250816 a skos:Concept ;
    skos:definition "Weapons of Africa worn on the wrists and designed for close combat, consisting generally of a metal disk with a central hole and a gap to allow them to be slipped onto the wrist, the outer edge of which is either sharpened like a knife blade or furnished with one or more projections for clubbing or slashing an opponent; sheaths may be worn on both edges. They are used in both actual and ceremonial combat, and worn as signs of manhood or status, or as ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fighting bracelets"@en .

aat:300250819 a skos:Concept ;
    skos:definition "Fighting bracelets furnished with one or more projections, either blunt or sharpened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiked bracelets"@en .

aat:300250821 a skos:Concept ;
    skos:definition "Fist weapons designed for hand-to-hand combat at close quarters, consisting of a finger ring with a single sharp, metal hook; also used for personal use or adornment; found primarily in the Great Lakes region of East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger hooks"@en .

aat:300250825 a skos:Concept ;
    skos:definition "African finger rings to which sharp, curving or crescent-shaped blades are attached, often with a tiny sheath to protect the wearer, used primarily as weapons, sometimes also as cutting implements. Examples with smaller than normal blades may be carried concealed in the palm of the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger knives"@en .

aat:300250828 a skos:Concept ;
    skos:definition "Fighting bracelets consisting of a single, continuous disk-shaped blade with a gap and a hole in the middle to allow them to be slipped onto the wrist, with thin sheaths of hide covering both the inner and sharpened outer edges; may also serve as cutting tools, and in some cases as ornament or signs of identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrist knives"@en .

aat:300250831 a skos:Concept ;
    skos:definition "Groups of religious, generally Christian, Muslim, or Buddhist, who follow a common rule of life, engage in a specific kind of work or schedule of devotions, and submit to the directions of superiors, often though not exclusively living within a cloistered or restricted space such as a convent or monastery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious orders"@en .

aat:300250835 a skos:Concept ;
    skos:definition "Refers generally to high-ranking public officers having the charge, direction, or superintendence of a town or province, a public business, or the household of a prince or noble. Refers specifically to administrative officials of that title under the ancien regime in France, in French, Spanish, and Portuguese colonies, and in some South American countries, serving either as governors or as seconds in authority to governors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intendants"@en .

aat:300250844 a skos:Concept ;
    skos:definition "Organizations that support religious activities by providing places of worship or schools and the payment of salaries to religious leaders. Some religious organizations also establish doctrine, determine qualifications for membership, appoint religious leaders, discipline members regarding religious law, and other duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious organizations"@en .

aat:300250849 a skos:Concept ;
    skos:definition "Members of a family containing around 1,100 species of insects, many of which have larvae that bore through seasoned wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anobiidae"@en .

aat:300250850 a skos:Concept ;
    skos:definition "Class of fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basidiomycetes"@en .

aat:300250851 a skos:Concept ;
    skos:definition "Organisms that do not require air or free oxygen for growth or maintaining life, and may even die in its presence. Those that grow only in the absence of oxygen are obligate, or strict, anaerobes. Some species, called facultative anaerobes, are able to grow either with or without free oxygen. Certain others, able to grow best in the presence of low amounts of oxygen, are called microaerophiles. Used especially in reference to microorganisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anaerobes"@en .

aat:300250854 a skos:Concept ;
    skos:definition "Members of a species of small North American lynx with a spotted reddish-brown coat, long legs, large paws, a rather short body, stubby tail, and tufted ears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lynx rufus"@en .

aat:300250863 a skos:Concept ;
    skos:definition "The young of fallow deer, from birth through its first year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fawns"@en .

aat:300250865 a skos:Concept ;
    skos:definition "General term referring to several species in different genera of righteyed flounders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halibut"@en .

aat:300250866 a skos:Concept ;
    skos:definition "Members of a genus containing two living species and one recently extinct species of semi-aquatic, carnivorous mammals of the weasel family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neovison"@en .

aat:300250867 a skos:Concept ;
    skos:definition "General term for any of 32 species of web-footed aquatic mammals that live chiefly in cold seas and whose body shape, round at the middle and tapered at the ends, is adapted to swift and graceful swimming. There are two types of animals often called by this term: the earless, or true, seals (family Phocidae); and the eared seals (family Otariidae), which comprise the sea lions and fur seals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seals"@en .

aat:300250870 a skos:Concept ;
    skos:definition "Suborder containing around 2,900 species of reptiles with a greatly elongated body, tapering tail, smooth scaly integument, and in some species, venomous properties. Snakes represent a lizard that, over the course of evolution, has undergone structural reduction, simplification, and loss as well as specialization of characteristics. All snakes lack external limbs, but not all legless reptiles are snakes. All snakes are carnivorous and can be distinguished from legless lizards by their lack of eyelids, limbs, external ears, and vestiges of forelimbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serpentes"@en .

aat:300250889 a skos:Concept ;
    skos:definition "Groups of animals of one kind, feeding or traveling together; in modern usage, specifically applied to an assemblage of birds, sheep, or goats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flocks"@en .

aat:300250890 a skos:Concept ;
    skos:definition "Groups of marine mammals, partricularly a small herd or family group of whales or dolphins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pods"@en .

aat:300250891 a skos:Concept ;
    skos:definition "Groups of wild or domestic mammals of one species that remain together, specifically applied to horses, zebra, oxen, antelope, cattle, camels, buffalo, elephants, deer, swine, whales, or certain other species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herds"@en .

aat:300250893 a skos:Concept ;
    skos:definition "Refers to groups of military, naval and air forces of any nation that has a prescribed organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armed forces units"@en .

aat:300250894 a skos:Concept ;
    skos:definition "With reference to the military, refers to large army units regularly organized with officers and enlisted men, able to conduct major operations independently. Also refers to various tactical units devoted to particular services, such as medical, engineering, and communications, or to some branches of the armed forces of various countries, such as the marine corps of the United states and Great Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corps"@en .

aat:300250895 a skos:Concept ;
    skos:definition "Written or printed characters or combinations of characters ordinarily appearing as a unit, when in a sentence or phrase, between spaces or between a space and a punctuation mark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "words"@en .

aat:300250899 a skos:Concept ;
    skos:definition "Small freestanding racks, poles, or stands, either plain or elaborately carved with symbols, made and used in Africa for supporting bows, with or without arrows; traditionally functioning as symbols of office for chieftains and symbols of honor for great heroes and hunters, though in some regions may be owned by any man."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bow stands"@en .

aat:300250904 a skos:Concept ;
    skos:definition "Telling or writing stories, especially recounting stories aloud to others, either from memory, ex tempore, or reading from notes or a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storytelling"@en .

aat:300250909 a skos:Concept ;
    skos:definition "Those who practice the telling of stories, as a livlihood or a skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storytellers"@en .

aat:300250915 a skos:Concept ;
    skos:definition "Official status in a hierarchical ordering of positions within an organization or social class, such as the armed forces, aristocracy, diplomatic corps, or government bureaucracy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rank"@en .

aat:300250925 a skos:Concept ;
    skos:definition "General term referring to any of over 1,300 species of invertebrate marine organisms of several genuses of the class Anthozoa (phylum Cnidaria) that are characterized by internal or external skeletons that have a stonelike, horny, or leathery consistency. In most species, the skeletons are joined together in massive colonies; they feed on small fish and invertebrate plankton using stinging cells on outstretched tentacles, and reproduce both sexually or by budding. For the calcium carbonate skeletal material produced by some species, use \"coral (material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corals"@en .

aat:300250930 a skos:Concept ;
    skos:definition "Family of marine bivalves having a radially ribbed shell with undulating edges, and many tiny eyes and feelers on the edge of the mouth; they inhabit sandy sea beds, and can swim by rapidly clapping the shell halve together by means of a single large adductor muscle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pectinidae"@en .

aat:300250934 a skos:Concept ;
    skos:definition "Small marine gastropod that flourishes in the Indian Ocean, having a porcelain-like shell that is used as money in some parts of Africa and Southern Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monetaria moneta"@en .

aat:300250937 a skos:Concept ;
    skos:definition "Family of marine bivalves having a rough irregular shell, of which the flattened left side is always underneath, closed by a single adduction muscle; they live free on the bottom or attached to stones or other object in shallow water on seacoats or brackish river mouths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostreidae"@en .

aat:300250943 a skos:Concept ;
    skos:definition "Territorial divisions defined for the purpose of administering a census."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "census districts"@en .

aat:300250949 a skos:Concept ;
    skos:definition "Addenda to wills, which explain, revoke, modify, or add to their provisions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codicils"@en .

aat:300250952 a skos:Concept ;
    skos:definition "Causing a liquid, fluid, or anything in loose particles to flow or fall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pouring"@en .

aat:300250954 a skos:Concept ;
    skos:definition "Foodstuff made from sugar or other sweet, edible substance. Includes a wide variety of forms, from hard lozenges of crystallized sugar made by repeated boiling and slow evaporation, to soft filled sweets, such as chocolate-covered bonbons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candy"@en .

aat:300250956 a skos:Concept ;
    skos:definition "Transit systems consisting of overhead wires, cables, or rails supporting and towing suspended cabins along a, usually, closed-loop circuit; generally for transporting passengers up steep gradients, or over deep valleys or bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial tramways"@en .

aat:300250966 a skos:Concept ;
    skos:definition "Rooms at the rear of auditoriums or classrooms for the operation of, usually, motion-picture projectors, slide projectors, or spotlights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "projection booths"@en .

aat:300250976 a skos:Concept ;
    skos:definition "Buildings housing businesses specializing in the sale of cigars and related tobacco products and smoking accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar stores"@en .

aat:300250984 a skos:Concept ;
    skos:definition "Perforated lattices or screens of stone, usually marble; use especially with reference to Indian architecture of the Mughal period. For Islamic windows filled with turned wood screens or grills, use \"meshrebeeyehs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jali"@en .

aat:300250988 a skos:Concept ;
    skos:definition "Urban Islamic structures providing lodging, storage, and commercial space for traveling merchants, as well as some facilities for trading transactions; similar in general function to \"caravanserais\" but less fortified, more mercantile, and found in urban contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khans"@en .

aat:300250991 a skos:Concept ;
    skos:definition "Refers to the process of adding or taking up water again, usually after dehydration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rehydration"@en .

aat:300250994 a skos:Concept ;
    skos:definition "Recreation complexes where golf is played, comprising golf courses, clubhouses, and associated facilities and often restricting use to members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf clubs"@en .

aat:300251002 a skos:Concept ;
    skos:definition "Islamic public baths consisting of a series of cold and hot pools and steam rooms, primarily used for ritual purification; derived in principle from ancient Roman models. For buildings in which bathers pass through a sequence of primarily steam rooms and rooms for massages, prefer \"Turkish baths.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammams"@en .

aat:300251006 a skos:Concept ;
    skos:definition "Architectural features of some Mesoamerican buildings, consisting of a horizontal rectangular panel (tablero) cantilevered over an upward-sloping apron wall (talud); often found repeated on stepped pyramids after around 300 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talud-tableros"@en .

aat:300251008 a skos:Concept ;
    skos:definition "Relatively narrow inclined bands of masonry found on walls of some northern Mesoamerican architecture since about 800 BCE; after around 300 CE often part of the talud-tablero architectural feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taludes"@en .

aat:300251010 a skos:Concept ;
    skos:definition "Horizontal, rectangular framed panels in Mesoamerican architecture, having their recessed surfaces often decorated with paintings or sculpture and the whole often cantilevered over sloping apron walls to form talud-tableros."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tableros"@en .

aat:300251012 a skos:Concept ;
    skos:definition "Decorated platforms, either built on a vehicle or towed behind a vehicle or horses, often bearing a display or tableau and drawn in a parade or procession for a festive or solemn occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floats"@en .

aat:300251040 a skos:Concept ;
    skos:definition "Occasions of the selection or drawing off of an individual from a larger group for some special purpose, most often for military service, but also found in sports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafts"@en .

aat:300251048 a skos:Concept ;
    skos:definition "Refers to the processes involving oxidation and reduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redox"@en .

aat:300251054 a skos:Concept ;
    skos:definition "Containers used to store for posterity a selection of objects representative of life at a particular time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time capsules"@en .

aat:300251068 a skos:Concept ;
    skos:definition "Resistance to permanent changes in property caused solely by heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal stability"@en .

aat:300251078 a skos:Concept ;
    skos:definition "Wood of the trees of the genus Laburnum, having a striking, dark greenish brown or reddish brown color, fine grain, and capable of taking a high polish. It is typically used for cabinetmaking and inlay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laburnum"@en .

aat:300251087 a skos:Concept ;
    skos:definition "Documents, such as deeds, grants, or charters, kept for use as evidence defending title or other degree of property rights in land, possessions, or inheritances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muniments"@en .

aat:300251095 a skos:Concept ;
    skos:definition "The systematic study of all natural objects and beings, including the modern sciences of zoology, botany, and minerology. May include expert scientific study as well as presentation of the materials for instruction of a popular or amateur audience, as in a museum of natural history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural history"@en .

aat:300251099 a skos:Concept ;
    skos:definition "Any of various long, thin-handled shafts with relatively small heads used to strike the ball in golf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf clubs"@en .

aat:300251110 a skos:Concept ;
    skos:definition "The study of manuscripts as physical and cultural artifacts, including all aspects of their structure and manufacture, their interrelationships, and their historical development and impact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codicology"@en .

aat:300251113 a skos:Concept ;
    skos:definition "Generally, the leaders of dramatic choruses in ancient Greece. Specifically, individual citizens of ancient Athens who sponsored one of the choruses appearing in a dramatic festival, selecting the members, providing space for their practice, and paying for all expenses relating to their performance, including costumes, training, and meals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choragi"@en .

aat:300251123 a skos:Concept ;
    skos:definition "Fixed ornamental corbels of inverted conical or pyramidal form, resembling in simple shape the bottoms of ancient lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culs-de-lampe"@en .

aat:300251137 a skos:Concept ;
    skos:definition "Flags, banners, figures, or other objects displayed or carried as an identifying symbol or rallying-point of a leader, public officer, organization, etc. Examples include banners of noble houses, flags of nations, and the colors of a military unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standards"@en .

aat:300251145 a skos:Concept ;
    skos:definition "Study of pollen grains, spores, and other microscopic plant materials, whether living or fossilized, especially their dispersal and applications in stratigraphy and paleontology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palynology"@en .

aat:300251146 a skos:Concept ;
    skos:definition "Long, narrow horizontal members of wood or metal that connect the headboards and footboards of beds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side rails"@en .

aat:300251154 a skos:Concept ;
    skos:definition "Boards, often removable, forming the sides or parts of the sides of structures, as on beds, such as hospital or childrens' beds, or carts and carriages to increase their carrying capacity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sideboards"@en .

aat:300251159 a skos:Concept ;
    skos:definition "Hand tools for opening and closing that do not have a jaw and do not fit into screws. For adjusting tools with a tip that fits into the recess of a screw, use \"screwdrivers.\" For hand tools for opening and closing by means of a jaw, use \"wrenches.\" For the removable actuating devices of locks, use \"keys (hardware).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keys"@en .

aat:300251177 a skos:Concept ;
    skos:definition "Those who work in chromolithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromolithographers"@en .

aat:300251190 a skos:Concept ;
    skos:definition "The planning discipline concerned with the physical environment and any and all human involvement with it, with the general objective of assuring proper habitat for people, animals, and plants and the resources upon which they depend. For the branch of architecture that deals with the design of the scenic environment, including green spaces, accompanying structures, and roadways, with the aim of creating a natural setting for human structures and settlements, use \"landscape architecture.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental design"@en .

aat:300251196 a skos:Concept ;
    skos:definition "Those who study or work in the field of environmental design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental designers"@en .

aat:300251208 a skos:Concept ;
    skos:definition "Hooks mounted in fireplaces on which pots or kettles may be suspended over an open fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pothooks"@en .

aat:300251219 a skos:Concept ;
    skos:definition "Folding, umbrellalike fabric devices with cords supporting a harness or straps for allowing objects to float down safely through the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parachutes"@en .

aat:300251221 a skos:Concept ;
    skos:definition "Swimming pools enclosed by a building or other structure and covered by a roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indoor swimming pools"@en .

aat:300251230 a skos:Concept ;
    skos:definition "Chairs of greater than usual height, often with a front ledge to be used as a foot rest, designed for spectators' use at billiards games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billiard chairs"@en .

aat:300251233 a skos:Concept ;
    skos:definition "Entoprocta is treated as a class of phylum Kamotozoa, rather than as a full phylum. Group of small, aquatic invertebrate animals composed of about 150 species and subdivided into four families. Entoprocts occur throughout the world, primarily in marine habitats, although one genus is a freshwater form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Entoprocta"@en .

aat:300251246 a skos:Concept ;
    skos:definition "Islamic ablutions required before the five daily prayers, involving washing with water the face and nostrils, the head, the hands and forearms, and the feet and ankles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wudu"@en .

aat:300251257 a skos:Concept ;
    skos:definition "Short light sticks, typically capped at both ends with metal or covered with leather and intended for carrying in the hand, often by military officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swagger sticks"@en .

aat:300251265 a skos:Concept ;
    skos:definition "Buildings that do not comply with current laws, codes, or ordinances, but that were lawful at the time that they were built, under the regulations then enacted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonconforming buildings"@en .

aat:300251276 a skos:Concept ;
    skos:definition "Luminous bridges of electricity formed in a gap between two electrodes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric arcs"@en .

aat:300251295 a skos:Concept ;
    skos:definition "Promising, answering, vouching for, or promoting a person, group, or organization, often by providing financial or other material support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponsoring"@en .

aat:300251297 a skos:Concept ;
    skos:definition "Literary compositions in verse or prose, in which human folly and vice are held up to scorn, derision, or ridicule. May be reflected as ideas expressed as the subjects of art works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satires"@en .

aat:300251301 a skos:Concept ;
    skos:definition "Postmodern movement in the visual arts of the 1980s in which artists were influenced by pop art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Pop"@en .

aat:300251302 a skos:Concept ;
    skos:definition "Lighting devices where the housing is set above the ceiling, and the lamp lens is flush or nearly flush with the ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recessed light fixtures"@en .

aat:300251316 a skos:Concept ;
    skos:definition "Creating marks on the surface of a hard material, usually metal, by electrolysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrolytic etching"@en .

aat:300251324 a skos:Concept ;
    skos:definition "Sensitivity to light of all colors in the visible spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panchromatic"@en .

aat:300251330 a skos:Concept ;
    skos:definition "Vertical displacement between layers resulting in converging sides that resemble a tent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenting"@en .

aat:300251352 a skos:Concept ;
    skos:definition "User for objects capable of being drawn or pulled back in, such as aircraft landing equipment, roofs or components of roofs, and other mechanical devices and equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retractable"@en .

aat:300251381 a skos:Concept ;
    skos:definition "Those who study or work in the statistical study of biological observations and phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biometricians"@en .

aat:300251409 a skos:Concept ;
    skos:definition "Any unwanted manmade atmospheric light together with its adverse effects, such as glare, the intrusion of light from one property onto the premises of others, and the sky glow from urban centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light pollution"@en .

aat:300251413 a skos:Concept ;
    skos:definition "Refers to the technique of making pottery of the same name to produce a variety of effects. The traditional Japanese process involves low firing temperatures in which the fired piece is removed from the kiln while still hot and is allowed to cool in open air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raku"@en .

aat:300251415 a skos:Concept ;
    skos:definition "Methods or practices used for constructing pottery forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery forming techniques"@en .

aat:300251427 a skos:Concept ;
    skos:definition "Thin, flat, circular objects of any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disks"@en .

aat:300251432 a skos:Concept ;
    skos:definition "Material comprising the thickened portion of underground stems, roots, or rhizomes of certain plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuber"@en .

aat:300251438 a skos:Concept ;
    skos:definition "Material of plants, specifically a small tuber or tuberlike swelling or protuberance, which may or may not function like a true tuber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubercle"@en .

aat:300251440 a skos:Concept ;
    skos:definition "Fruits of certain nonflowering plants, especially conifers, that are somewhat conical in shape and consisting of overlapping or valvate scales which bear ovules or seeds. More-or-less analagous to the flower of other plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cones"@en .

aat:300251448 a skos:Concept ;
    skos:definition "Instances of people combining to abstain from or prevent commercial or social dealings with some individual, group, or organization as a means of coercion or intimidation, generally for economic or political reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boycotts"@en .

aat:300251460 a skos:Concept ;
    skos:definition "Sloping boards or frames upon which hides are worked in tanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beams"@en .

aat:300251465 a skos:Concept ;
    skos:definition "Hide and skin processing techniques, such as fleshing, unhairing, and scudding, performed with a piece of equipment called a beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaming"@en .

aat:300251466 a skos:Concept ;
    skos:definition "A portion of the oily constituents of a leather that appears on the grain surface in the form of white crystalline fatty acids or as a dark gummy deposit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spew"@en .

aat:300251469 a skos:Concept ;
    skos:definition "Powdered debris produced by insects in the course of feeding and boring, often including excrement and food remains. In art conservation, frass may be an indicator of insect damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frass"@en .

aat:300251470 a skos:Concept ;
    skos:definition "Flags hung from a crossbar or frame mounted on a pole, often having two or three streamers or tails or else square in shape, historically used as standards in battle or in processions by military leaders, princes, cities and republics, particularly of Italy, guilds, and groups associated with the church; also used in the present day by trade unions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gonfalons"@en .

aat:300251471 a skos:Concept ;
    skos:definition "The impression of the markings from the inner surface of the finger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fingerprints"@en .

aat:300251478 a skos:Concept ;
    skos:definition "The technique of analyzing a material for chemical elements by bombarding it with neutrons, charged particles such as protons, or gamma photons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "activation analysis"@en .

aat:300251486 a skos:Concept ;
    skos:definition "Technique of activation analysis induced by protons to determine chemical elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proton activation analysis"@en .

aat:300251492 a skos:Concept ;
    skos:definition "Large bags in which mail is carried, either shoulder bags used by postal carriers, or bags or pouches used to transport mail in bulk, as from central post offices to branch offices, or city to city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mailbags"@en .

aat:300251497 a skos:Concept ;
    skos:definition "Specialists in floriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floriculturists"@en .

aat:300251499 a skos:Concept ;
    skos:definition "Literary works of 20th-century poetry, particularly of the concrete poetry movement of the 1950s and 1960s in which language elements are arranged freely, not necessarily in linear syntax, and meaning is derived from spatial, pictorial, and typographic characteristics of the work, as well as from the sense of the words. For pre-20th-century works of poetry in which letters, words, or lines are arranged to form a shape or image, usually related to the meaning of the words, use \"pattern poems.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete poems"@en .

aat:300251507 a skos:Concept ;
    skos:definition "Those who study the nature, origin, limits, and validity of human knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epistemologists"@en .

aat:300251517 a skos:Concept ;
    skos:definition "Planning and management of traffic routes and speed and other regulations with the goal of achieving calm, safe, and environmentally improved conditions on or near roads and streets, and in the community or region as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traffic calming"@en .

aat:300251526 a skos:Concept ;
    skos:definition "Emergency aid or treatment given to someone injured or suddenly ill before regular medical services arrive or can be reached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first aid"@en .

aat:300251534 a skos:Concept ;
    skos:definition "Tables fitted with medical apparatus for doctors' use in examining patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "examination tables"@en .

aat:300251539 a skos:Concept ;
    skos:definition "A thermoplastic copolymer used to improve adhesion properties of hot-melt and pressure sensitive adhesives, and for conversion coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethylene-vinyl acetate"@en .

aat:300251553 a skos:Concept ;
    skos:definition "Compound that is a salt with the sulfate ion SO4 2-, or an ester of sulfuric acid. Sulfates comprise an enormous group of chemicals that contain the element sulfur. Sulfates are used in a variety of common products and processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfate"@en .

aat:300251561 a skos:Concept ;
    skos:definition "Postmortem examinations, such as inspections and dissections of bodies to determine the cause of death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autopsies"@en .

aat:300251565 a skos:Concept ;
    skos:definition "The science dealing with crystallization and the form and structure of crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystallography"@en .

aat:300251568 a skos:Concept ;
    skos:definition "The science of poisons including their effects, antidotes, and detection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toxicology"@en .

aat:300251574 a skos:Concept ;
    skos:definition "The study of the capacity of machines to simulate human behavior such as reasoning, learning, probelm-solving, or the understanding of speech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial intelligence"@en .

aat:300251577 a skos:Concept ;
    skos:definition "Substances or mixtures applied to leather generally to clean, preserve, or maintain its strength and flexibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leather dressing"@en .

aat:300251598 a skos:Concept ;
    skos:definition "Raised platforms on which Roman magistrates sat, usually in basilicas or theaters; by extension, may be used also for elevated platforms or seats reserved for any presiding officials. For indoor platforms used as places of honor or prominence for dignitaries or speakers, prefer \"daises.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribunals"@en .

aat:300251603 a skos:Concept ;
    skos:definition "Experiences in which a person, thing, or event appears vividly or credibly to the mind, although not actually present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visions"@en .

aat:300251610 a skos:Concept ;
    skos:definition "Works of pre-20th century poetry, in which letters, words, or lines are arranged on the page to form a shape or image, usually related to the meaning of the words. For works of poetry from the 20th century on, particularly of the concrete poetry movement of the 1950s and 1960s in which language elements are freely arranged, not necessarily in linear syntax, and meaning is derived from the spatial, pictorial, and typographic characteristics of the work, as well as from the sense of the words, use \"concrete poems.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern poems"@en .

aat:300251611 a skos:Concept ;
    skos:definition "Successions of images, thoughts, or emotions passing through the mind during sleep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dreams"@en .

aat:300251615 a skos:Concept ;
    skos:definition "Events or actions so unusual, extraordinary, and surpassing rational explanation that they are regarded as manifestations of supernatural power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miracles"@en .

aat:300251618 a skos:Concept ;
    skos:definition "The study and pursuit of archaeology, which is the study of human development and culture, using the methods and theories of geology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geoarchaeology"@en .

aat:300251645 a skos:Concept ;
    skos:definition "Objects or devices that are not essential in themselves but add to the beauty, convenience, or effectiveness of other things, as, for example, to costume or automobiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessories"@en .

aat:300251656 a skos:Concept ;
    skos:definition "Mechanical models of the solar system that demonstrate the movements of some or all of the planets around the sun, sometimes also of moons around their planets, in their correct relative periods, by means of an elaborate, usually clockwork, system. For the buildings housing devices used to project celestial images or for the mechanisms themselves, use \"planetaria.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orreries"@en .

aat:300251676 a skos:Concept ;
    skos:definition "Having the shape or outline of a hollow cylindrical vessel; differs from \"cylindrical,\" in that \"tubular\" may be used to describe objects with curved surfaces rather than straight, and tubular objects are typically quite narrow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tubular"@en .

aat:300251704 a skos:Concept ;
    skos:definition "Long slender throwing spears of hard wood, usually with an iron head, used by peoples of southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assegais"@en .

aat:300251739 a skos:Concept ;
    skos:definition "Refers to the culture of the Eastern Mono, a Native American group from central California who speak a language belonging to the Numic group of the Uto-Aztecan family and are related to Northern Paiute. The Eastern Mono, along with Owens Valley Native communities across the crest, are similar to their neighbors from the Great Basin. Historically the Eastern and Western Mono traded with one another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Mono"@en .

aat:300251746 a skos:Concept ;
    skos:definition "Closely pressed or tightly wrapped, large bundles of materials or goods prepared for storage or transport, as cotton or hay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bales"@en .

aat:300251771 a skos:Concept ;
    skos:definition "The study of botanical remains in an archaeological context, that is, how they relate to human development and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeobotany"@en .

aat:300251790 a skos:Concept ;
    skos:definition "Three species of blood-eating bats, native to the New World tropics and subtropics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Desmodontidae"@en .

aat:300251797 a skos:Concept ;
    skos:definition "Parts or components of animals, including humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal components"@en .

aat:300251798 a skos:Concept ;
    skos:definition "The front part of the head of a human or animal; in vertebrates, the area of the head on which the sense organs of vision and smell as well as the mouth and jaws are located. In humans, the face extends from the forehead to the chin; the term may also be used to describe the part of the front of the head below the forehead, from the eyebrows to the chin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faces"@en .

aat:300251799 a skos:Concept ;
    skos:definition "The feet of a quadrupedal animal, characterized by being relatively compact feet with pads and claws, often configured so the weight of the animal is placed on the pad and toes rather than on a heel; examples are the feet of a bear, dog, or cat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paws"@en .

aat:300251800 a skos:Concept ;
    skos:definition "The posterior extremities of animals, in position opposite to the head and forming either a distinct flexible appendage to the trunk (e.g., in a dog or cat) or a continuation of the trunk behind the anus (as in a dolphin). In vertebrates, the tail contains an extension of the vertebrae beyond the backbone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tails"@en .

aat:300251810 a skos:Concept ;
    skos:definition "Physicists specializing in the properties, relationships, and interactions of elementary particles, especially those produced in collisions involving very high energies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particle physicists"@en .

aat:300251815 a skos:Concept ;
    skos:definition "A variety of processes involving treatment of hides and skins to produce leather with only partial loss of original fibrous structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semi-tanning"@en .

aat:300251821 a skos:Concept ;
    skos:definition "Rooms appropriated to the meetings of deliberative, legislative, or judicial bodies; by extension, may also be used for the private rooms of judges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chambers"@en .

aat:300251827 a skos:Concept ;
    skos:definition "The assemblies of citizens having the highest deliberative functions in a government, as in ancient Rome and other ancient states, the free cities of Medieval Europe, and the upper and smaller branches of the legislatures of, for example, the United States, France, and Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senates"@en .

aat:300251844 a skos:Concept ;
    skos:definition "Nuts of oak trees and shrubs, growing in a shallow woody cup or cupule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acorns"@en .

aat:300251847 a skos:Concept ;
    skos:definition "Groups or movements whose religious beliefs and practices differ significantly from dominant or orthodox religions or society, typically centered around a particular deity, historic or mythic figure, or charismatic living person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cults"@en .

aat:300251856 a skos:Concept ;
    skos:definition "The scientific study of insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entomology"@en .

aat:300251876 a skos:Concept ;
    skos:definition "Groves of trees imbued with special religious, mystical, or spiritual qualities, usually delimited and often located near water, an altar, or memorial dedicated to spirits, gods, heros, or events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacred groves"@en .

aat:300251881 a skos:Concept ;
    skos:definition "Ground or polished unchipped stone or bronze, rarely iron, tools of various forms with chisel-shaped edges, possibly used as adzes, axes, hoes, or weapons by some prehistoric peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celts"@en .

aat:300251886 a skos:Concept ;
    skos:definition "Inclined courses or tracks of ice or snow designed, maintained, or used for certain winter sports activities, as bobsledding or toboganning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runs"@en .

aat:300251908 a skos:Concept ;
    skos:definition "Objects made from bison or other large-animal hides, particularly shields, trunks, or containers made by the North American Plains Indians. Examples are large, folded, rectangular envelopelike containers, characteristically decorated with painted designs, and used for the packing of dried meat and other dried foods, blankets, or clothing, for example."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parfleches"@en .

aat:300251913 a skos:Concept ;
    skos:definition "Private or civil injurious actions or breaches of duty, other than breaches of contract, intentional or not, for which the law will award a remedy in the form of damages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torts"@en .

aat:300251917 a skos:Concept ;
    skos:definition "General term for those who bring about or construct artifacts directly by their own labor, especially as their craft or profession; also, those who construct intangible works, such as music. For industrialists who own or run a manufacturing plant, use \"manufacturers.\" For those who practice an occupation, trade, or pursuit requiring manual dexterity or artistic skill, use \"craftsmen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "makers"@en .

aat:300251926 a skos:Concept ;
    skos:definition "Reflection of light, heat, or sound without diffusion such as, for example, light off a mirror surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specular reflection"@en .

aat:300251929 a skos:Concept ;
    skos:definition "The study of animal remains, especially bones, in an archaeological context, that is in the context of human development and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeozoology"@en .

aat:300251933 a skos:Concept ;
    skos:definition "The study of metal objects, especially with regard to their manufacturing process, in an archaeological context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeometallurgy"@en .

aat:300251935 a skos:Concept ;
    skos:definition "The activity and state of training in the capacity of an apprentice, who learns by practical experience under skilled workers, usually for a prescribed period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apprenticeship"@en .

aat:300251944 a skos:Concept ;
    skos:definition "Continental European noblewomen holding a countship, English noblewomen holding an earldom, or the wives or widows of counts and earls. They rank after duchesses and marchionesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countesses"@en .

aat:300251948 a skos:Concept ;
    skos:definition "Continental European noblemen holding a countship, ranking on the same level as British earls, below dukes and marquises and above viscounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counts"@en .

aat:300251959 a skos:Concept ;
    skos:definition "Scientists specializing in the study of the characteristics and use of materials, such as metal, ceramic, glass, polymers, and composite materials; includes those developing new materials with specific properties to suit specific contexts or functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "materials scientists"@en .

aat:300251965 a skos:Concept ;
    skos:definition "Branch of zoology that deals with fishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ichthyology"@en .

aat:300251967 a skos:Concept ;
    skos:definition "Branch of zoology that deals with birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornithology"@en .

aat:300251975 a skos:Concept ;
    skos:definition "In general, people of high social status, especially those from an established wealthy family. Examples are members of the privileged citizen class of ancient Rome; or to holders of high rank and title in the Byzantine Empire; in several Italian republics (Venice, Genoa, etc.), or in the Free Cities of the German Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patricians"@en .

aat:300251988 a skos:Concept ;
    skos:definition "Those trained or working in the field of history.concerned with topics that are distinctly localized in subject matter and source materials, generally covering specific neighborhoods, communities, counties, or other specific subdivisions of larger geopolitical bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local historians"@en .

aat:300251993 a skos:Concept ;
    skos:definition "Histories that are distinctly localized in subject matter or source materials, focusing on specific neighborhoods, communities, counties, or other specific subdivisions of larger geopolitical bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local histories"@en .

aat:300251998 a skos:Concept ;
    skos:definition "Members of a family containing six living genera and 17 species of flightless diving seabirds native to the oceans of the southern hemisphere, which have an upright stance on land, mainly black and white plumage, a long bill, and wings reduced to scaly flippers or paddles for swimming under water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spheniscidae"@en .

aat:300252002 a skos:Concept ;
    skos:definition "Narrow strips of material, such as leather, gut, or rawhide, used for many purposes. Examples include reins or whips, or in articles of footwear or costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thongs"@en .

aat:300252008 a skos:Concept ;
    skos:definition "Transcribed collections of numbers, names, or other text listing events, biographies, milestones, or other items in serial temporal order relative to given dates or time periods. Used to represent textually those events, biographies, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronologies"@en .

aat:300252014 a skos:Concept ;
    skos:definition "Those who specialize in arranging time into periods or divisions, and placing events in the sequence in which they occurred, either at a defined point or period in time, or in relation to an established time sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronologists"@en .

aat:300252036 a skos:Concept ;
    skos:definition "The degree of change in the appearance of the visible environment caused by a development project or planning policy, and viewer response to these changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual impact"@en .

aat:300252038 a skos:Concept ;
    skos:definition "Methodically analyzing the visual impact of a development project or planning policy on a community or area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual impact assessment"@en .

aat:300252041 a skos:Concept ;
    skos:definition "The systematic distinguishing, classifying, and naming of type groups of organisms, objects, and phenomena within a subject field, especially as applied in biology to living and extinct animals and plants. Also refers to the study of the theory, rules, and methods of systematic classification and nomenclature per se."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxonomy"@en .

aat:300252046 a skos:Concept ;
    skos:definition "In general, an orderly classification for a defined domain. More specifically, a classificatory nomenclatures of real objects, organisms, or phenomena, especially for living and extinct organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxonomies"@en .

aat:300252049 a skos:Concept ;
    skos:definition "Scientists who specialize in the branch of chemistry that deals with the chemical effects of radiation, chiefly visible and ultraviolet light, and with the direct production of radiation by chemical changes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photochemists"@en .

aat:300252053 a skos:Concept ;
    skos:definition "Those who lead or direct the singing of the choir or congregation in a church, monastic establishment, or cathedral, especially officials of that title in certain churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "precentors"@en .

aat:300252058 a skos:Concept ;
    skos:definition "Those who do needleworking, especially as an occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needleworkers"@en .

aat:300252063 a skos:Concept ;
    skos:definition "Property that wives or their families bring to the husbands in marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dowries"@en .

aat:300252068 a skos:Concept ;
    skos:definition "Knitting performed by machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine knitting"@en .

aat:300252071 a skos:Concept ;
    skos:definition "Motion pictures made without a photographic or magnetic sound track carried on the physical medium of the film itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silent films"@en .

aat:300252088 a skos:Concept ;
    skos:definition "Specialists in phonology, the study of the sound patterns and systems of languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonologists"@en .

aat:300252092 a skos:Concept ;
    skos:definition "Specialists in phonetics, the study of the production, transmission, perception, classification, and physical or acoustical properties of speech sounds and how they are organized in language. For specialists in the study of the sound patterns and systems of languages, use \"phonologists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phoneticians"@en .

aat:300252102 a skos:Concept ;
    skos:definition "Cairene commercial buildings offering lodging, storage, and commercial space for merchants and sometimes serving as brokerage houses; similar to khans and often built with unconnected housing above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wakalas"@en .

aat:300252108 a skos:Concept ;
    skos:definition "Recumbent effigies as decomposing corpses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transis"@en .

aat:300252112 a skos:Concept ;
    skos:definition "Prototype single-family houses generally conceived as experiments in low-cost construction using the latest materials and incorporating Modernist forms. Prime examples are those sponsored by Arts and Architecture magazine and built in the Los Angeles area between 1945 and 1966."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Case Study houses"@en .

aat:300252129 a skos:Concept ;
    skos:definition "Gardens created following the Shinto, Buddhist, or Zen philosophy of the relationship between nature and people and generally characterized by simple asymmetrical designs, dominated by clipped evergreens, often incorporating bridges, rocks, stepping stones, raked gravel, and stone lanterns to create an environment for contemplation and meditation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese gardens"@en .

aat:300252136 a skos:Concept ;
    skos:definition "Photographic prints produced by the silver-dye bleach process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver-dye bleach prints"@en .

aat:300252164 a skos:Concept ;
    skos:definition "Genus of rod-shaped, gram-positive, aerobic or, under some conditions anaerobic, bacteria widely found in soil and water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bacillus"@en .

aat:300252166 a skos:Concept ;
    skos:definition "General term referring to extremely minute living things, either plants or animals, that can be seen only under a microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microorganisms"@en .

aat:300252173 a skos:Concept ;
    skos:definition "Prepared outside membrane of the large intestine of cattle used primarily to separate individual gold leaves during the final stages of preparing gold leaf. Occasionally used for the repair of skin artifacts and as the moisture-sensitive element in hygrometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldbeater's skin"@en .

aat:300252175 a skos:Concept ;
    skos:definition "Theater spaces behind the proscenium arch or behind the back wall of the stage setting, including, for example, workshops, dressing rooms, and storage areas; in arena theaters, often includes spaces behind or under seating areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backstages"@en .

aat:300252188 a skos:Concept ;
    skos:definition "Temporary structures, and associated hardware and bracing, that support freshly placed concrete or similar fluid materials until it has hardened sufficiently to stand alone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formwork"@en .

aat:300252194 a skos:Concept ;
    skos:definition "Large, luxurious, and well-equipped hotels featuring distinguished architecture, which are designed to present travelers with an experience reminiscent of the ambiance of life in European palaces. Usage is generally restricted to buildings erected from the mid-19th to early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand hotels"@en .

aat:300252200 a skos:Concept ;
    skos:definition "Counterfeit coins; use especially for blank disks illegally passed as money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slugs"@en .

aat:300252226 a skos:Concept ;
    skos:definition "Small educational buildings, generally consisting of one major teaching space, and often built to resemble meeting houses, churches, or dwellings. Use when emphasizing the size or form of such buildings; when emphasizing the function or location of some early examples, prefer \"rural schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-room schools"@en .

aat:300252238 a skos:Concept ;
    skos:definition "Small buildings that house educational facilities, built in sparsely populated nonurban areas to provide public, usually elementary, education to local residents. Use when emphasizing the function or location of such buildings; when emphasizing the small size or form of some early examples, prefer \"one-room schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural schools"@en .

aat:300252246 a skos:Concept ;
    skos:definition "Refers to the style of art and architecture resulting from the spread of the Renaissance from Italy into northern Europe in the late 15th century. It took hold principally in the courts of the French kings after the invasion of Italy in 1494, in the Netherlands with Margaret of Austria, and in Germany with the emperor Maximillion, and was later adopted by the dukes of Bavaria and by the English royal court. It is characterized by the influence of Classical prototypes and Italian Renaissance ideals, an emphasis on detail, optical clarity, and the use of oil paint and glazes to create brilliant colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Renaissance"@en .

aat:300252249 a skos:Concept ;
    skos:definition "Walking long distances, especially through rural areas, as for pleasure, exercise, or military training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hiking"@en .

aat:300252261 a skos:Concept ;
    skos:definition "Use with reference to sculpture, architectural decoration, ceramics, and various ancient artifacts that have been decorated with more than one color. For the process of so decorating, use \"polychromy.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polychrome"@en .

aat:300252276 a skos:Concept ;
    skos:definition "Members of a genus containing four living species of sea birds having a short neck, black and white plumage (which resembles monastic robes, thus the genus name \"Fratercula\"), and a large, multicolored, laterally compressed, grooved bill that is brightly colored in the breeding season. They feed primarily by diving; they breed in large colonies on coastal cliffs or offshore islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fratercula"@en .

aat:300252278 a skos:Concept ;
    skos:definition "Members of a species of seabird native to the Arctic and northern coasts of the Atlantic that nests in burrows, and has black and white plumage and a very deep and brightly colored bill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fratercula arctica"@en .

aat:300252284 a skos:Concept ;
    skos:definition "General term for any member of the order Anura that is more terrestrial, squat, warty, and hopping as distinguished from smooth-skinned, semi-aquatic, and leaping anurans, which are called \"frogs.\" There is no taxonomic distinction between frogs and toads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toads"@en .

aat:300252286 a skos:Concept ;
    skos:definition "Genus containing two living species of large aquatic crocodilians with powerful jaws and tails that are used in both defense and in swimming. Their eyes, ears, and nostrils are placed on top of their long head and project slightly above the water when the animals float at the surface. Alligators can be differentiated from crocodiles by the form of their jaw and teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alligator"@en .

aat:300252298 a skos:Concept ;
    skos:definition "Members of an order containing six living species of fish having lungs as well as gills, retaining primitive characteristics such as the ability to breathe air, the presence of lobed fins, and a well-developed internal skeleton. Designated as a subclass rather than an order in some classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dipnoi"@en .

aat:300252301 a skos:Concept ;
    skos:definition "Lay honorary officers of a parish or district church who manage the secular affairs of parish or district churches, particularly those relating to the building and other property. Formerly, they acted as the sole representatives of the laity of each parish in matters of church business. The term is use particularly in Episcopalian and Anglican churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "churchwardens"@en .

aat:300252306 a skos:Concept ;
    skos:definition "Those trained in or practicing psycholinguistics, the study of the mental processes and skills underlying language acquisition, production, and comprehension, and the diagnosis and clinical treatment of speech or language problems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psycholinguists"@en .

aat:300252313 a skos:Concept ;
    skos:definition "Those specializing in the analysis and interpretations of historical events using psychological theories and insights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psychohistorians"@en .

aat:300252325 a skos:Concept ;
    skos:definition "Those specializing in sociolinguistics the study of language as it functions in society, and of the interaction between linguistic and social variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sociolinguists"@en .

aat:300252337 a skos:Concept ;
    skos:definition "Members of an order of solitary coelenterate polyps, named after the terrestrial anemone flower and resembling squat columns with a cluster of stinging tentatcles around the mouth, with which they trap small fishes and invertebrates and draw them into the large interior digestive cavity; they are brightly colored, especially in tropical waters, and reproduce sexually, by budding, or by fission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Actiniaria"@en .

aat:300252405 a skos:Concept ;
    skos:definition "Huts of variable plan constructed of dry-laid masonry walls and domed roofs; found in rural areas of Provence, France, of generally indeterminate date from the prehistoric period until the 19th century CE; may also have had agricultural uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bories"@en .

aat:300252407 a skos:Concept ;
    skos:definition "Refers to the development and management of methods and systems to prevent, prepare for, deal with, and recover from disasters. Typically used in the context of governmental or institutional plans and programs. For planning by individuals, families, or other small groups, prefer \"emergency preparedness.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disaster planning"@en .

aat:300252414 a skos:Concept ;
    skos:definition "A lightened or whitish area in layer of paint or varnish layer due to microscopic defects (voids, granules, etc.) that develop within a film layer as it ages. The defects can scatter light making the affected area appear lighter than the surrounding areas. It is distinguished from bloom, which is a surface phenomenon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanching"@en .

aat:300252429 a skos:Concept ;
    skos:definition "Steel ornamented with wavy patterns and noted for its hardness; formerly used especially for making sword blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Damascus steel"@en .

aat:300252440 a skos:Concept ;
    skos:definition "The arrangement and associated installation systems of seats in places of assembly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seating"@en .

aat:300252447 a skos:Concept ;
    skos:definition "Refers to the aggregate of various electronic equipment, such as video recorders, television receivers, video enhancing equipment, and audio components, and often including computer equipment, coordinated for home diversion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home entertainment systems"@en .

aat:300252454 a skos:Concept ;
    skos:definition "Refers to the aggregate of high-end audio-video equipment, usually with large-screen television receivers and surround-sound capabilities, designed and arranged to provide theaterlike environments; may also be used for rooms designed to accommodate viewing images offered by such equipment. For domestic spaces whose focus is a home entertainment system, with video, music, and games, use \"media rooms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home theaters"@en .

aat:300252459 a skos:Concept ;
    skos:definition "The study of cultural landscapes and their features through archaeological fieldwork and analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape archaeology"@en .

aat:300252481 a skos:Concept ;
    skos:definition "Buildings in which monkeys are kept for show, especially in zoos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monkey houses"@en .

aat:300252485 a skos:Concept ;
    skos:definition "Indian peoples who inhabit, or formerly inhabited, the North American Great Plains, which is a vast grassland between the Mississippi River and the Rocky Mountains and from present-day provinces of Alberta and Saskatchewan in Canada through the present-day state of Texas in the United States. The area is drained principally by the Missouri and Mississippi rivers; the valleys of this watershed are the most reliable sites from which to obtain fresh water, wood, and most plant foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plains Indian"@en .

aat:300252489 a skos:Concept ;
    skos:definition "The use of or investigation with a fluorescence microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescence microscopy"@en .

aat:300252498 a skos:Concept ;
    skos:definition "Radar allowing accurate measurement of the depth in the ground of certain target objects; used, for example, in archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground-penetrating radar"@en .

aat:300252504 a skos:Concept ;
    skos:definition "Large, multistory, multiroom complex dwellings of the Ancestral Puebloan and Hohokam periods, mostly dating from 950 to 1150 CE; distinguished from \"pueblos (housing complexes)\" by their often D-shaped outline, cohesive planned design, and location in the San Juan Basin, New Mexico, and parts of Arizona."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Great Houses"@en .

aat:300252554 a skos:Concept ;
    skos:definition "Refers to those who make public offers, solicitations, or promotional declarations by means of paid advertisements or commercials, whether produced by themselves or purchased from others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertisers"@en .

aat:300252561 a skos:Concept ;
    skos:definition "Refers generally to those who purchase something on behalf of another person or organization. Refers specifically to hired agents or middlemen who purchase products for the maintenance and daily operation of a business or other organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purchasing agents"@en .

aat:300252566 a skos:Concept ;
    skos:definition "Those officially chosen by a group or organization, such as a government or the regional membership of a political party, to speak or act in its interests or in accordance with its instructions at a convention, conference, or other meeting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "delegates"@en .

aat:300252571 a skos:Concept ;
    skos:definition "Parts or components of swells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swell components"@en .

aat:300252572 a skos:Concept ;
    skos:definition "Enclosures, left open in front and usually of wood, housing the pipes of an organ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ cases"@en .

aat:300252576 a skos:Concept ;
    skos:definition "Mechanisms built into some keyboard instruments, such as organs, reed organs, and harpsichords, to vary the volume of tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swells"@en .

aat:300252578 a skos:Concept ;
    skos:definition "Boxlike chambers within an organ or reed organ housing a set of pipes or reeds, and having on one side a movable lid, shutter, or set of shutters or slats that can be opened or closed to increase or diminish the tonal volume of the pipes or reeds within."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swell boxes"@en .

aat:300252595 a skos:Concept ;
    skos:definition "Longitudinal shutters or slats built into one side of the swell box of an organ or reed organ, usually with beveled edges and linked together in sets either vertically or horizontally, and pivoted so that the organ player can open or close them as desired by means of the swell action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swell shutters"@en .

aat:300252599 a skos:Concept ;
    skos:definition "Principal governing bodies of boroughs, having legislative and executive powers such as to pass ordinances, levy taxes, and appropriate funds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borough councils"@en .

aat:300252609 a skos:Concept ;
    skos:definition "General term for committees, offices, departments, or other branches or representatives that exercise powers of governing or government through statutory or other authority. For bodies that administer and manage, but do not necessarily govern or are not representatives of government, use \"administrative bodies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governing bodies"@en .

aat:300252610 a skos:Concept ;
    skos:definition "Titles of works or major divisions of works, such as parts or chapters, when they appear at the beginning of the first page of the text, often though not always set below the normal level of the first line of the page. Use also for the titles of musical scores when they appear immediately above the opening bars of the music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caption titles"@en .

aat:300252619 a skos:Concept ;
    skos:definition "Ceramic glaze, either opaque or translucent, applied over a previously glazed and fired surface and fired at a lower temperature than the original glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overglaze"@en .

aat:300252634 a skos:Concept ;
    skos:definition "Translucent overglaze fired at very low temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "china paint"@en .

aat:300252662 a skos:Concept ;
    skos:definition "Waterspouts in the form of lions' heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lion-head spouts"@en .

aat:300252666 a skos:Concept ;
    skos:definition "Altering an object by repeating a process that has already been applied to the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reworking"@en .

aat:300252681 a skos:Concept ;
    skos:definition "Specific theory and method of archaeology, involving the controlled testing of hypotheses about practical aspects of past societies, such as the duplication of known artifacts, effects, or processes, the building of theoretical models simulating past circumstances that are then observed in actual operation through time, and the collection and interpretation of ethnographic data from modern peoples for the information this gives on archaeological questions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experimental archaeology"@en .

aat:300252686 a skos:Concept ;
    skos:definition "Principal governing bodies of cities, having legislative and executive powers such as to pass ordinances, levy taxes, and appropriate funds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "city councils"@en .

aat:300252689 a skos:Concept ;
    skos:definition "Glazed, patterned, or textured paper produced by pressing or sliding objects into a wet, often colored paste or starch mixture that has been spread on the paper; frequently used as decorative endpapers or cover papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste paper"@en .

aat:300252693 a skos:Concept ;
    skos:definition "Producing a variegated effect on the surface of a material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mottling"@en .

aat:300252700 a skos:Concept ;
    skos:definition "Scattering a substance in drops or particles on a surface often resulting in a surface covering of small specks, spots, or splotches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprinkling"@en .

aat:300252706 a skos:Concept ;
    skos:definition "Risking money or other valuable stakes on the outcome of contests or other events whose outcome involves chance and is thus uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gambling"@en .

aat:300252720 a skos:Concept ;
    skos:definition "Commodities, merchandise, or materials brought into one country from another for use, sale, reprocessing, exchange, or export."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imports"@en .

aat:300252722 a skos:Concept ;
    skos:definition "Commodities, merchandise, or materials shipped, sent, or otherwise transmitted from one country to another for use, sale, reprocessing, exchange, or reexport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exports"@en .

aat:300252728 a skos:Concept ;
    skos:definition "Catboats developed in the 1870s around Cape Cod and Martha's Vineyard, Massachusetts, and generally characterized by a 1:2 beam to length ratio, high freeboard, large cockpit, perpendicular square stern, and large outboard rudder; first built for fishing and later used as pleasure craft. Distinguished from \"Great South Bay catboats\" which have a lower freeboard, narrower beam, and a counter stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cape Cod catboats"@en .

aat:300252735 a skos:Concept ;
    skos:definition "Organs of government belonging to the judiciary established by law to hear cases, petitions, and other causes, and publicly administer justice, whether military, ecclesiastical, or relating to the statutory or common law of the land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courts"@en .

aat:300252744 a skos:Concept ;
    skos:definition "Small flat-bottomed rowing, sailing, or outboard skiffs, usually with two-planked sides, whose cross-planked bottom is in the shape of a household flatiron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flatiron skiffs"@en .

aat:300252772 a skos:Concept ;
    skos:definition "Small, Chesapeake Bay centerboard boats of bugeye type about 40 feet long, half-decked, with two masts and leg-of-mutton sails; used for oyster tonging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brogans"@en .

aat:300252777 a skos:Concept ;
    skos:definition "Trimming printed material so that portions of the illustration or text are removed. Distinguished from \"bleeding (printing technique)\" which refers to printing an image so that it extends to the edge of the paper or other printing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleeding"@en .

aat:300252783 a skos:Concept ;
    skos:definition "Any material resembling genuine leather. Examples may be made of flexible fabric, plastic, or paper, often coated, and printed or embossed to simulate the appearance and feel of leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation leather"@en .

aat:300252788 a skos:Concept ;
    skos:definition "General term for calendered paper or board with an exceptionally smooth surface on one or both sides, achieved by coating with a mineral substance or by pressing with rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art paper"@en .

aat:300252822 a skos:Concept ;
    skos:definition "Those who study and practice ritual activities with the object of controlling or influencing human or natural events through the invocation of external and impersonal mystical forces beyond the ordinary human sphere; typical ritual activities include the manipulation of special objects and the recitation of spells. Distinct from \"magicians (illusionists)\", who create illusions and perform sleight-of-hand, conjuring tricks, and other types of stage magic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magicians"@en .

aat:300252827 a skos:Concept ;
    skos:definition "Those who study and exercise supernatural and natural powers for benevolent or malevolent ends, making use in varying degrees of magic, psychic powers, herbalism, divination, and communication with good or evil spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "witches"@en .

aat:300252840 a skos:Concept ;
    skos:definition "Those who practice the skill of making images produced on photographic film by a radiation other than light, especially x-rays or gamma rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiographers"@en .

aat:300252844 a skos:Concept ;
    skos:definition "Members of a people or group who have no permanent residence or settlement but move about in regular seasonal or cyclical routes to obtain sustenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nomads"@en .

aat:300252849 a skos:Concept ;
    skos:definition "Way of life characterized by cyclical or seasonal movement from place to place which is necessary for the subsistence of the group, resulting in lack of a continuous permanent abode."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nomadism"@en .

aat:300252855 a skos:Concept ;
    skos:definition "Tooling, using implements which are usually hand-held and heated, without the addition of gold leaf, silver leaf, or color; often on leather or cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind tooling"@en .

aat:300252865 a skos:Concept ;
    skos:definition "Paper designed for photocopying which may or may not be sensitized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copy paper"@en .

aat:300252872 a skos:Concept ;
    skos:definition "Pressing or twisting into a compact mass of irregular folds or wrinkles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crumpling"@en .

aat:300252875 a skos:Concept ;
    skos:definition "The process of making microfilms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfilming"@en .

aat:300252881 a skos:Concept ;
    skos:definition "Creating separations in a flexible material by pulling or wrenching part from part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tearing"@en .

aat:300252887 a skos:Concept ;
    skos:definition "Techniques involving making, imitating, or altering valued objects or documents with intent to deceive. Distinguished from \"copying\" by the intention of deception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forging"@en .

aat:300252897 a skos:Concept ;
    skos:definition "The customs, tendencies, and routines attributed to how people exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ways of life"@en .

aat:300252901 a skos:Concept ;
    skos:definition "Printmakers who work in photogravure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photogravurists"@en .

aat:300252910 a skos:Concept ;
    skos:definition "Literary works in prose, but having the concentrated rhythmic, figurative, sonorous language characteristic of poetry, written as a continuous sequence of sentences without line breaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prose poems"@en .

aat:300252916 a skos:Concept ;
    skos:definition "Fiction in which crime is the central theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crime fiction"@en .

aat:300252918 a skos:Concept ;
    skos:definition "Literary or oral fiction genre in which a crime, often murder, is committed under mysterious circumstances and then solved by the central figure of a detective, using keen observation and rational analysis of clues and evidence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detective fiction"@en .

aat:300252927 a skos:Concept ;
    skos:definition "The forming of letters and words by hand rather than by printing; may be used to designate a particular and distinctive form, style, or method of writing by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handwriting"@en .

aat:300252936 a skos:Concept ;
    skos:definition "Large blocks, usually metal, with intaglio designs used to decorate book covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel stamps"@en .

aat:300252940 a skos:Concept ;
    skos:definition "Fiction in which a central character of a spy engages in espionage activites, often set in exotic settings and employing elaborate technology to expose or defeat a foreign foe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spy fiction"@en .

aat:300252948 a skos:Concept ;
    skos:definition "The process of marking a surface with a monogram."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monogramming"@en .

aat:300252952 a skos:Concept ;
    skos:definition "Messages or writings in cipher or code."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryptograms"@en .

aat:300252955 a skos:Concept ;
    skos:definition "Finishing tools with a handle and a rotating wheel that has one or more raised bands on its edge for impressing a line or parallel lines; commonly used in bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillets"@en .

aat:300252962 a skos:Concept ;
    skos:definition "Books or treatises presenting the basic principles or elements of an art, science, discipline, or practice, especially in the 17th through the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grammars"@en .

aat:300252967 a skos:Concept ;
    skos:definition "Authorizations to print or publish a work implying approval or sanction of content, usually in a context of church or government censorship. Distinguished from \"privileges (permissions)\" which are authorizations for the printing or selling of books, usually exclusively and for a specified period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imprimaturs"@en .

aat:300252971 a skos:Concept ;
    skos:definition "Pieces of leather attached to the spines of books bearing letters indicating author, title, or other information. For pieces of paper or other, nonleather, material different from the book covering material, bearing the title, author or other information, use \"title-labels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettering pieces"@en .

aat:300252980 a skos:Concept ;
    skos:definition "Periodicals for enthusiasts of aspects of popular culture such as pop music, comic books, and other specialized interests, especially science fiction and fantasy works, often inexpensively produced and with small circulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanzines"@en .

aat:300252982 a skos:Concept ;
    skos:definition "Aggressive, forcefully presented arguments, often disputing a policy or opinion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polemics"@en .

aat:300252986 a skos:Concept ;
    skos:definition "Coverings for the head or tail of the spine of a book, formed by turning the material on the spine over the head and tail and shaping it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headcaps"@en .

aat:300252990 a skos:Concept ;
    skos:definition "Binders, books, albums, or other collections of pages that permit the withdrawal and insertion of pages at any desired position by means of rings, posts, cords, or some other type of fastener securing the margins of the individual leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loose-leaf binders"@en .

aat:300252996 a skos:Concept ;
    skos:definition "Refers to a decorative pattern resembling lace, often tooled in gold in manuscript illuminations or on book covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dentelle"@en .

aat:300252997 a skos:Concept ;
    skos:definition "Loose-leaf binders in which two or more rings of metal or other durable material, attached to a back, pass through holes in the margins of individual leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring binders"@en .

aat:300253001 a skos:Concept ;
    skos:definition "Short, pithy statements of principle or precepts, often of known authorship; distinguished from \"proverbs\" which are statements repeated colloquially and which often embody the folk wisdom of a group or nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aphorisms"@en .

aat:300253008 a skos:Concept ;
    skos:definition "Loose-leaf binders with either solid or sectional posts that pass through holes in the margins of the individual leaves, typically intended for pages that are unusually large and heavy, such as in a scrapbook."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post binders"@en .

aat:300253012 a skos:Concept ;
    skos:definition "Bindings that permit the withdrawal and insertion of pages at any desired position by means of rings, posts, cords, or other type of fastener securing the margins of the individual leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loose-leaf bindings"@en .

aat:300253016 a skos:Concept ;
    skos:definition "Reference works setting out formulas, recipes, or prescribed forms or models. In pharmacological contexts, use for non-standard works formulating the ingredients and amounts to be used in preparations, but not including recommendations for such things as use and dosage. For reference works detailing preparation of drugs and medicines, including their use and dosage, especially those works recognized as official or standard sources, use \"pharmacopoeias.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formularies"@en .

aat:300253017 a skos:Concept ;
    skos:definition "Finishing tools consisting of a handle and a brass wheel, the circumference of which is engraved so as to impress a continuous repeating pattern, called a roll, as it revolves under pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolls"@en .

aat:300253030 a skos:Concept ;
    skos:definition "The decorative repeating pattern created by the bookbinder's finishing tool, called a roll."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolls"@en .

aat:300253035 a skos:Concept ;
    skos:definition "Long narrative poems celebrating on a grand scale the adventures and deeds of one or more heroic figures, ordinarily concerning a serious subject significant to a culture or nation. Classical epic poetry employs dactylic hexameter and recounts a journey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epic poems"@en .

aat:300253045 a skos:Concept ;
    skos:definition "Lyric poems of exalted emotion devoted to the praise or celebration of its subject; often employing complex or irregular metrical form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odes"@en .

aat:300253047 a skos:Concept ;
    skos:definition "Raised ridges across the bound spine of a book indicating the location of the cords beneath the covering material. Distinguished from \"cords (binding components),\" the twisted strands of fibrous material to which the sections of a book are sewn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bands"@en .

aat:300253051 a skos:Concept ;
    skos:definition "The twisted strands of fibrous material to which the sections of a book are sewn. Distinguished from \"thongs (binding components)\" which are the narrow strips of rawhide or processed animal skin used for the same purpose before the latter part of the 16th century, and from \"tapes (binding components)\" which are flat strips of closely woven cloth that perform the same function. Also distinguished from \"bands (binding components)\" which are the raised ridges across the spine of a bound book that indicate the location of the cords beneath the covering material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cords"@en .

aat:300253057 a skos:Concept ;
    skos:definition "Bookbinding cords that have been placed in grooves sawn into the back of the sections of a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recessed cords"@en .

aat:300253066 a skos:Concept ;
    skos:definition "Ceremonial weapons of the Fon people of Dahomey, generally in the shape of an axe or crooked club with a sculpted wooden handle, and, in those of axe shape, an elaborately carved metal or wooden head. They serve as symbols of power, either of the gods of Dahomey or of its king, and are used in various secular and religious ceremonial contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "récades"@en .

aat:300253069 a skos:Concept ;
    skos:definition "Daggers worn in a sheath attached to the upper arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arm daggers"@en .

aat:300253072 a skos:Concept ;
    skos:definition "Protective coverings for the wrist used in archery, fencing, and various ball games, especially those worn by archers on the bow arm as protection from the recoil of the bowstring, generally taking the form of a band, bracelet, or plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bracers"@en .

aat:300253091 a skos:Concept ;
    skos:definition "Impressed lines, either gilt or blind, created in leather or other semi-hard surface materials by finishing tools also called fillets; most commonly used in bookbinding. For similarly shallow recessed moldings in other plane surfaces, use \"sunk fillets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillets"@en .

aat:300253096 a skos:Concept ;
    skos:definition "Narrow strips of rawhide or processed animal skin, such as leather or alum-tawed skin, across the back of a book to which the sections were sewn early in the development of flexible sewing. Distinguished from \"cords (binding components)\" which are twisted strands of fibrous material that replaced thongs by the latter part of the 16th century, and from \"tapes (binding components)\" which are narrow strips of closely woven cloth serving the same purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thongs"@en .

aat:300253099 a skos:Concept ;
    skos:definition "Narrow strips of closely woven cloth across the back of a book to which the sections are sewn. Distinguished from \"thongs (binding components)\" which are narrow strips of rawhide or processed animal skin that served the same purpose early in the development of flexible sewing, and \"cords (binding components)\" which are twisted strands of fibrous material that replaced thongs by the latter part of the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapes"@en .

aat:300253104 a skos:Concept ;
    skos:definition "The process of placing sheets of paper or tissue, usually blank, between leaves of text or illustrations for protective or decorative purposes or for taking notes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interleaving"@en .

aat:300253125 a skos:Concept ;
    skos:definition "The free end of the cords, thongs, or tapes on which a book has been sewn, that are used to attach the boards or case to the text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slips"@en .

aat:300253129 a skos:Concept ;
    skos:definition "The top edges of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heads"@en .

aat:300253132 a skos:Concept ;
    skos:definition "The bottom edges of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tails"@en .

aat:300253138 a skos:Concept ;
    skos:definition "Literary genre describing or set in a utopia, an ideal human society, especially in regard to laws, government, and social conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utopian literature"@en .

aat:300253142 a skos:Concept ;
    skos:definition "Motifs representing a symbol of a hand with the index finger extended, used to draw attention to a specific area of interest on a printed page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexes"@en .

aat:300253152 a skos:Concept ;
    skos:definition "Mud cloth of the Bamana people of Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bogolanfini"@en .

aat:300253162 a skos:Concept ;
    skos:definition "Organizations no part of the net earnings or income of which is distributed or inures to the benefit of any private individual, but is applied to the stated purpose of the organization, such as charity, community service, or research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonprofit organizations"@en .

aat:300253189 a skos:Concept ;
    skos:definition "Decked sailboats, usually 14 to 15 feet long, with metal runners and no rudder, steered with mainsail and jib and capable of sailing over ice and patches of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scooters"@en .

aat:300253198 a skos:Concept ;
    skos:definition "Two-masted, spritsail-rigged, half-decked, square-sterned lobsterboats developed in Kingston on Massachusetts Bay; after ca. 1880s slightly altered for racing and recreational use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kingston lobsterboats"@en .

aat:300253205 a skos:Concept ;
    skos:definition "Lifesaving boats designed for launching and beaching through the surf, and generally double-ended, with marked sheer, high ends, an outboard rudder, and sometimes a sailing rig; early models were rowed, later ones had auxiliary power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surfboats"@en .

aat:300253212 a skos:Concept ;
    skos:definition "Double-ended surfboats, 26 feet long, with ten rowing stations, centerboard, rudder, and lug-rigged sail; designed by the United States Coast Guard in 1934, sometimes used as gigs, and named after Monomoy Island, Cape Cod, Massachusetts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monomoy surfboats"@en .

aat:300253222 a skos:Concept ;
    skos:definition "Pulling boats used in menhaden fishing to drive the fish into nets, usually 12 to 13 feet long and carried aboard menhaden steamers to the fishing grounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "driveboats"@en .

aat:300253292 a skos:Concept ;
    skos:definition "Folding compasses consisting of faceted legs that contain hinged reversible inserts providing ink, pencil, and plain points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar compasses"@en .

aat:300253295 a skos:Concept ;
    skos:definition "Critical theory similar to structuralism in its critique of historicism, meaning, and post-Renaissance rational philosophy, but differing by its rejection of structural linguistics as a theoretical base, emphasizing fragmentation instead, with a belief that there can be no historical progress nor any cumulative progress in knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post-structuralism"@en .

aat:300253299 a skos:Concept ;
    skos:definition "Landscapes significantly altered or modified by industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial landscapes"@en .

aat:300253316 a skos:Concept ;
    skos:definition "Refers to those who study the values relating to human conduct, with respect to the rightness and wrongness of certain actions and to the goodness and badness of the motives and ends of such actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethicists"@en .

aat:300253321 a skos:Concept ;
    skos:definition "Those who study ethics inspired and informed by religious doctrine, faith, and experience; also those who study religious doctrine and commitment with reference to ethics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious ethicists"@en .

aat:300253328 a skos:Concept ;
    skos:definition "Collocates descriptors for organizations that have authority to oversee, direct, manage, and administer on behalf of an institution or other group as related to judgment and justice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judicial administrative bodies"@en .

aat:300253329 a skos:Concept ;
    skos:definition "Final approved screenplays, with full dialogue, all necessary technical instructions for shooting, and usually broken down into individual scenes with shots numbered consecutively in chronological order, for the use of the director and sometimes also the actors during production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shooting scripts"@en .

aat:300253332 a skos:Concept ;
    skos:definition "Intermediate versions of screenplays, written between the synopsis and the first draft of the screenplay in the sequence of development, generally including a full narrative covering all the principal situations and actions, brief descriptions of the characters, and possibly some key sequences of dialogue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treatments"@en .

aat:300253337 a skos:Concept ;
    skos:definition "Screenplays that contain all necessary visual and audio instructions in the final pre-shooting phase, including dialogue, sound effects, shots, and basic editing for all scenes in the order in which they are to be shown on the screen, subject to change only by the director."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuities"@en .

aat:300253341 a skos:Concept ;
    skos:definition "Programs produced and distributed to mark special events, usually more lavishly designed and printed, and with more detailed contents than regular programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "souvenir programs"@en .

aat:300253357 a skos:Concept ;
    skos:definition "Exclusive social clubs that stage festive events such as private balls and public parades during Mardi Gras in New Orleans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "krewes"@en .

aat:300253366 a skos:Concept ;
    skos:definition "Bindings structured so that two books share a lower board, fore edges facing in opposite directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dos-à-dos bindings"@en .

aat:300253377 a skos:Concept ;
    skos:definition "Silent, immobile arrangements of one or more costumed performers, usually staged with appropriate scenery and props, to reproduce a scene from art, drama, literature, history, or the imagination. Enacted in ceremonial, theatrical, festive, or recreational contexts, in public or private, they may be presented on floats, on theatrical stages, such as at the end of an act of a play, or in any suitable private or public space. For the contemporary sculptural works composed of figures and objects arranged into a picturelike scene, use \"tableaux (sculpture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tableaux"@en .

aat:300253401 a skos:Concept ;
    skos:definition "Lightweight folding compasses consisting of legs with upper portion cut away to allow hinged lower legs to fold up inward and with pivoting reversible points that provide ink, pencil, and plain points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Napier compasses"@en .

aat:300253434 a skos:Concept ;
    skos:definition "Boots whose upper part reaches to the thigh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thigh boots"@en .

aat:300253457 a skos:Concept ;
    skos:definition "Extensions attached to a compass to extend the length of one of the legs; used to increase the radius of an inscribed arc or circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lengthening bars"@en .

aat:300253461 a skos:Concept ;
    skos:definition "A pattern of fine, closely spaced dots on a surface used commonly on leather bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointillé"@en .

aat:300253465 a skos:Concept ;
    skos:definition "Distinctive German paper, embossed or printed in gold or silver, with patterns which imitated brocades, damasks, or popular decorative and figurative images of the 18th and early 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch gilt paper"@en .

aat:300253474 a skos:Concept ;
    skos:definition "Heavy weave cotton, jute, or linen textile stiffened with glue, size, or starch and used for interlinings in garments, box making, bookbinding, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckram"@en .

aat:300253476 a skos:Concept ;
    skos:definition "Style and culture of a cluster of peoples living on the fringe of the southern Sudan, especially in the northwestern regions of the Central African Republic and the southcentral area surrounding Sarh, south of Lake Chad in Chad. They include the Gula, Kara, Kreish, Nduka, Ngama, and Sara proper. The Sara peoples all speak Central Sudanic languages of the Nilo-Saharan language family, and their material culture shows evidence of Sudanic influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sara"@en .

aat:300253478 a skos:Concept ;
    skos:definition "Refers to the style of painting and graphic design of a small group of German artists, primarily Sigmar Polke, Gerhard (Gerd) Richter, and Konrad Lueg (Fischer), dating from the early 1960s. Sharing some affinities with Pop Art, the style is characterized by a critical observance of contemporary events and personalities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capitalist Realism"@en .

aat:300253481 a skos:Concept ;
    skos:definition "Water towers wholly or partly boxed in by walls; the interior spaces of the tower below are thus available for, for example, storage or offices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tankhouses"@en .

aat:300253491 a skos:Concept ;
    skos:definition "Wood from an oak tree that has a rich dark brown color as a result of being infected by beefsteak fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brown oak"@en .

aat:300253538 a skos:Concept ;
    skos:definition "Communications satellites that transmit television signals directly to home receivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct broadcast satellites"@en .

aat:300253562 a skos:Concept ;
    skos:definition "Cinemas with ornate architecture and interior decoration, emerging in the 1920s. The exterior of the movie palace is often outfitted with a marquee and an upright, showcasing the cinema's name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movie palaces"@en .

aat:300253564 a skos:Concept ;
    skos:definition "Style of architecture and design reaching its height in the late 1930s in the United States. In architecture, it is characterized by the use of horizontal lines, round corners, and sometimes nautical elements, such as railings and porthole windows. In design, these elements were expressed in a variety of new materials, such as Bakelite (TM) and chrome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Streamlined Moderne"@en .

aat:300253565 a skos:Concept ;
    skos:definition "Ranches dedicated primarly to raising horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse ranches"@en .

aat:300253566 a skos:Concept ;
    skos:definition "Facilities for making margarine, allowing for the processes of emulsifying a blend of vegetable oils and fats, which can be modified using fractionation, interesterification or hydrogenation, with skimmed milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "margarine factories"@en .

aat:300253567 a skos:Concept ;
    skos:definition "Out-of-town shopping developments, usually containing a number of large chain stores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retail parks"@en .

aat:300253568 a skos:Concept ;
    skos:definition "Highway lanes restricted to vehicles transporting a driver and multiple passengers. Used as a tool for traffic management."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-occupancy vehicle lanes"@en .

aat:300253574 a skos:Concept ;
    skos:definition "Axes, often stylized in form or elaborately ornamented, used in ceremonial contexts as symbols or manifestations of social position, power, wealth, or other qualities of status such as divinity or specialized knowledge in the realm of religion and ritual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial axes"@en .

aat:300253581 a skos:Concept ;
    skos:definition "Knives, often stylized in form or elaborately ornamented, used in ceremonial contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial knives"@en .

aat:300253632 a skos:Concept ;
    skos:definition "Study and practice of the use of selected books and other readings for therapeutic purposes to promote an individual's mental or physical health or development; often used as an adjunct to psychotherapy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliotherapy"@en .

aat:300253636 a skos:Concept ;
    skos:definition "Specialists in bibliotherapy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliotherapists"@en .

aat:300253640 a skos:Concept ;
    skos:definition "Animals, especially insects, that damage or infest crops, livestock, stored goods, or other items valued by humans. Also may refer to a plant that is an invasive weed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pests"@en .

aat:300253699 a skos:Concept ;
    skos:definition "Briefs that reach to the hips or below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bikinis"@en .

aat:300253712 a skos:Concept ;
    skos:definition "Strip of lace, cloth, leather, or another material that is gathered on one edge or cut on the bias, so that when attached to the hem, button placard, neckline, or wrist of a garment it produces an ornamental frill or flounce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruffle"@en .

aat:300253714 a skos:Concept ;
    skos:definition "One-piece, skin-tight garments made of knitted or stretch material, usually covering the feet, legs, and torso, and sometimes arms; worn under other clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body stockings"@en .

aat:300253720 a skos:Concept ;
    skos:definition "Tiered sleeve ruffles of lace or other cloth that serve as cuffs; fashionable especially during the late 17th century to the mid 18th century. Also, detachable undersleeves edged with lace or embroidery, fashionable during the middle of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engageantes"@en .

aat:300253723 a skos:Concept ;
    skos:definition "Sleeves with very full tops around the shoulder and upper arms and beginning at the elbow, tapering to a tight wrist; fashionable especially during the 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leg-of-mutton sleeves"@en .

aat:300253738 a skos:Concept ;
    skos:definition "Long loose sleeves with a slit through which the arm can emerge. Also, long false decorative sleeves attached to the back of the armhole. Worn by men, women, or children especially from the 15th through the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging sleeves"@en .

aat:300253741 a skos:Concept ;
    skos:definition "Half- or three-quarter-length funnel-shaped sleeves that flare at the bottom to resemble a pagoda roof; fashionable especially during the third quarter of the 19th century in Western cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pagoda sleeves"@en .

aat:300253745 a skos:Concept ;
    skos:definition "Refers to 18th- and 19th-century full-length gowns cut without a center front opening in the skirt and usually without a train."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round gowns"@en .

aat:300253750 a skos:Concept ;
    skos:definition "Refers to 18th- and 19th-century full-length gowns with overskirt split in front to reveal an ornamental petticoat or underskirt beneath. In two popular variations, the back may be fitted in the \"robe à l'anglaise\" style or loose in the \"robe à la française\" style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open robes"@en .

aat:300253755 a skos:Concept ;
    skos:definition "Supporters for the genitals worn by men participating in sports or strenuous activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jockstraps"@en .

aat:300253763 a skos:Concept ;
    skos:definition "Accessories or main garments used to fill in the open or low-cut bodices of dresses or worn under jackets, made of fine material and with or without sleeves; worn especially from the 19th to the early 20th century. For narrow pieces of cloth worn especially during the 17th to the early 19th century, use \"tuckers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemisettes"@en .

aat:300253766 a skos:Concept ;
    skos:definition "Various types of hats adapted from Bavarian and Austrian Tyrolean hats, usually of felt and with a brim and slightly peaked crown, often trimmed with a ribbon or cord and a feather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alpine hats"@en .

aat:300253774 a skos:Concept ;
    skos:definition "Square headcloths, usually of cotton, often folded into a triangle and traditionally secured on the head with an agal; worn by men especially in Western Asia and parts of North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaffiyehs"@en .

aat:300253790 a skos:Concept ;
    skos:definition "Strips, originally of bone, now usually of plastic or metal, used to stiffen various elements of costume, such as women's foundation garments, strapless bodices, and shirt collars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stays"@en .

aat:300253800 a skos:Concept ;
    skos:definition "A Scottish term for laced shoes made out of the untanned hide of an animal, with the hair facing to the outside; molded to the foot when the hide is still pliant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rivlins"@en .

aat:300253811 a skos:Concept ;
    skos:definition "Artists who produce history paintings, which are multi-figure narrative scenes of real or legendary events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history painters"@en .

aat:300253822 a skos:Concept ;
    skos:definition "Artists who create digital art works that emphasize the computer’s role in thier creation and apprehension. Computer artists devote themselves specifically to employing computer terminals or technology for display, distribution, or interaction, so that the machinery is an integral part of their work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer artists"@en .

aat:300253827 a skos:Concept ;
    skos:definition "Artists who produce video art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video artists"@en .

aat:300253843 a skos:Concept ;
    skos:definition "Species of deer with large branching or palmated antlers, formerly common in Central Europe, but now confined to sub-arctic regions of Europe and North America; commonly domesticated and used for hauling, meat, milk, and skins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rangifer tarandus"@en .

aat:300253844 a skos:Concept ;
    skos:definition "Members of a species of relatively small Eurasian deer found in small family groups in lightly forested regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capreolus capreolus"@en .

aat:300253847 a skos:Concept ;
    skos:definition "General term referring to members of several species in various families of Old World flycatchers and thrushes, having in common that they all frequently sing at night as well as during the day. The term has been used for well over 1,000 years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nightingales"@en .

aat:300253849 a skos:Concept ;
    skos:definition "Members of a family containing about 12 species of Old World birds with stocky legs, colorful blue and violet patches, and called \"rollers\" for the dives and somersaults they perform during courtship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coraciidae"@en .

aat:300253852 a skos:Concept ;
    skos:definition "Factories in which chemicals are created or manipulated, whether natural or synthetic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical plants"@en .

aat:300253873 a skos:Concept ;
    skos:definition "Characteristics and qualities that are time-related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time-related attributes"@en .

aat:300253876 a skos:Concept ;
    skos:definition "Left-over or superfluous material or by-product not useful to the work or process at hand, as from construction, printing, manufacturing, or industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waste"@en .

aat:300253882 a skos:Concept ;
    skos:definition "Any solid, liquid, or gaseous by-product that is destructive to the environment or dangerous to the health of people or animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hazardous waste"@en .

aat:300253891 a skos:Concept ;
    skos:definition "Embroidery in which parts of the ground fabric are cut away or withdrawn and stitches are used to prevent fraying and to embellish the whole by reworking elements or refilling cut-out areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutwork"@en .

aat:300253899 a skos:Concept ;
    skos:definition "Works or parts of works in metal, leather, paper, textile, or any material having openings, perforations, or interstices as part of the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "openwork"@en .

aat:300253901 a skos:Concept ;
    skos:definition "Authorizations for the printing and selling of a particular book or class of books, usually exclusively granted and for a specified period of time. Distinguished from \"imprimaturs\" which are authorizations to print or publish a work, implying approval or sanction of content, usually in a context of church or government censorship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "privileges"@en .

aat:300253909 a skos:Concept ;
    skos:definition "Motifs of human faces surrounded with foliage, in many cases with leaves appearing to sprout from the mouth, nostrils, and sometimes the eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foliate masks"@en .

aat:300253916 a skos:Concept ;
    skos:definition "Poles with red and white, or red, white, and blue spiral stripes used as signs for barber shops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barber poles"@en .

aat:300253921 a skos:Concept ;
    skos:definition "Anything of great value and relatively small in size, usually money, coin, silver, gold, bullion, or plate, found hidden in the ground or otherwise concealed, the owner of which is often unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treasure-trove"@en .

aat:300253931 a skos:Concept ;
    skos:definition "Documents containing directives or commands issued by a military superior to a subordinate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orders"@en .

aat:300253941 a skos:Concept ;
    skos:definition "The limitation of the order of inheritance of an estate to a prescribed sequence of inheritors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entail"@en .

aat:300253947 a skos:Concept ;
    skos:definition "Altruistic concern for human welfare and advancement usually as manifested by the donation of money, property, or work to needy persons, by endowment of institutions of learning or health care, or by generosity to other socially useful purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philanthropy"@en .

aat:300253949 a skos:Concept ;
    skos:definition "The extra length and width of the covering material of a book overlapping the head, tail, and foredge of the cover, which is turned over the edges of the board and adhered to the inside surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turn-ins"@en .

aat:300253951 a skos:Concept ;
    skos:definition "Leather, usually made from calf skin, decorated with a treelike pattern created by the application of acids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tree calf"@en .

aat:300253958 a skos:Concept ;
    skos:definition "Bindings in which the spine and approximately one third the width of the boards are covered, usually in leather or cloth, with disproportionately large corners of the same material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-quarter bindings"@en .

aat:300253962 a skos:Concept ;
    skos:definition "Printed numerals, letters, or symbols irregularly occurring in the lower margins of some hand-pressed books for the purpose of recording press practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press figures"@en .

aat:300253967 a skos:Concept ;
    skos:definition "Sheets of paper or tissue, usually blank, placed, adhered, or bound in between leaves of text or illustrations for protective or decorative purposes or for taking notes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interleaves"@en .

aat:300253971 a skos:Concept ;
    skos:definition "The branch of physics encompassing the study of the behavior and control of electrons. Includes the design and application of devices and systems whose operation depends fully or partially upon the characteristics and behavior of electrons flowing through semiconductors, vacuums, or gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronics"@en .

aat:300253974 a skos:Concept ;
    skos:definition "Branch of electronics dealing with the study, manufacture, and use of electronic circuits and devices of very small size, especially integrated circuits involving semiconductors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microelectronics"@en .

aat:300253978 a skos:Concept ;
    skos:definition "Branch of electrical engineering that deals with practical applications of electronics, primarily with the design, manufacture, and operation of electronic devices and systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic engineering"@en .

aat:300253983 a skos:Concept ;
    skos:definition "Specialists in electronic engineering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic engineers"@en .

aat:300253993 a skos:Concept ;
    skos:definition "Notes set into the text of a page, the type being set around them on three sides; usually set in smaller or heavier type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut-in notes"@en .

aat:300254012 a skos:Concept ;
    skos:definition "Gifts, usually of money, given over and above what is due in return for or in anticipation of some service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gratuities"@en .

aat:300254016 a skos:Concept ;
    skos:definition "Gatherings of people wearing masks, disguises, or costumes, often of an elaborate or fantastic nature; activities often include dancing. In Western cultures they tend to be simply recreational, while in others, notably African, they are important ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masquerades"@en .

aat:300254018 a skos:Concept ;
    skos:definition "Refers to a style of 19th- and early 20th-century Scottish pottery originally named for Lady Grosvenor of Wemyss Castle and characterized by flowers, fruit, or animals painted in bright colors on a white ground often in a sketchy style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wemyss"@en .

aat:300254022 a skos:Concept ;
    skos:definition "Refers to the overall management of urban areas, encompassing the setting of objectives for urban life, the establishment of policies, and the planning, development, operation, and maintenance of the urban environment and services. For the field of planning concerned with designing and improving the spatial organization and content of urban areas, use \"urban planning.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban management"@en .

aat:300254062 a skos:Concept ;
    skos:definition "Practitioners of the general management of urban areas, encompassing the setting of objectives for urban life, the establishment of policies, and the planning, development, operation, and maintenance of the urban environment and services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban managers"@en .

aat:300254069 a skos:Concept ;
    skos:definition "Branch of political science dealing primarily with the planning, operation, and supervision of government agencies, programs, and functions, as well as the determination and implementation of public policy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public administration"@en .

aat:300254115 a skos:Concept ;
    skos:definition "Clearing snow from areas where it is not wanted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snow removal"@en .

aat:300254121 a skos:Concept ;
    skos:definition "Concrete with a fine aggregate or mortar which is cast into blocks or small slabs using special molds so as to resemble natural building stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cast stone"@en .

aat:300254125 a skos:Concept ;
    skos:definition "A wool textile that is thick, heavy, and waterproof; used especially for outerwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loden"@en .

aat:300254129 a skos:Concept ;
    skos:definition "Use to describe forms which are partly human and partly animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "therianthropic"@en .

aat:300254131 a skos:Concept ;
    skos:definition "Primarily a 19th-century process of printing from a thin cast from either a bas-relief model or an engraved surface; originally involving the use of gypsum or plaster of Paris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsography"@en .

aat:300254138 a skos:Concept ;
    skos:definition "Separations in a flexible material caused by pulling or wrenching part from part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tears"@en .

aat:300254142 a skos:Concept ;
    skos:definition "Lateral flat parts on either side of a hinged joint, as on diptychs, door hinges, folding doors, and table tops; by extension, for tables, may also be used for similar but removable components, whether originally hinged or separate. For the lateral components of polyptychs specifically, prefer \"panels (wood)\" (ALT of \"panel (wood)\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaves"@en .

aat:300254154 a skos:Concept ;
    skos:definition "Use generally for all education beyond the high school or secondary level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postsecondary education"@en .

aat:300254172 a skos:Concept ;
    skos:definition "Internal combustion engines driven by a mixture of gaseous fuel and air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas engines"@en .

aat:300254178 a skos:Concept ;
    skos:definition "Educational toys produced and used in a series for teaching Friedrich Froebel's system of kindergarten education. There are 10 gifts, each comprising one or more geometric shapes and colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kindergarten gifts"@en .

aat:300254182 a skos:Concept ;
    skos:definition "Strengthening elements of the built environment against attack, providing them with some means of defense, or protecting them with fortifications or fortification elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortifying"@en .

aat:300254198 a skos:Concept ;
    skos:definition "Buildings housing interdisciplinary museums that present the history and heritage of a particular community or region in the context of its society, culture, and natural environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecomuseums"@en .

aat:300254200 a skos:Concept ;
    skos:definition "Roof-like coverings, usually of canvas or metal and often adjustable, placed over windows, doors, or decks to provide protection from sun and rain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "awnings"@en .

aat:300254203 a skos:Concept ;
    skos:definition "Generally describes objects that can be moved into a variety of proper positions, shapes, or configurations appropriate to a specific use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable"@en .

aat:300254214 a skos:Concept ;
    skos:definition "Describes lighting devices that can be manipulated to change the direction of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjustable lamps"@en .

aat:300254226 a skos:Concept ;
    skos:definition "Refers to the aggregates of human-made structures, infrastructural elements, and associated spaces and features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "built environments"@en .

aat:300254248 a skos:Concept ;
    skos:definition "Enclosed, preserved, and extensive woodland and pasture attached to substantial residences; especially in England and British colonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parks"@en .

aat:300254253 a skos:Concept ;
    skos:definition "Architectural components, generally in passive solar systems, designed to store heat energy, usually radiated back into spaces as ambient temperature drops; derived from and may also be used for the amount of potential heat storage capacity available in a given component or system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal masses"@en .

aat:300254256 a skos:Concept ;
    skos:definition "Openings in vertical surfaces, such as walls, parapets, curbs, or bulwarks, to allow the runoff of excess water from horizontal surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scuppers"@en .

aat:300254263 a skos:Concept ;
    skos:definition "Physical training or body toning involving the use of weights. For the lifting of standard weights as a competitive sport or conditioning exercise, use \"weightlifting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weight training"@en .

aat:300254268 a skos:Concept ;
    skos:definition "Buildings that house schools for training horses and teaching people how to handle, breed, and manage horses. For buildings that house schools teaching equitation, use \"riding schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manèges"@en .

aat:300254273 a skos:Concept ;
    skos:definition "Factories in which coke is produced, usually by burning coal or distilling coal gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coke plants"@en .

aat:300254280 a skos:Concept ;
    skos:definition "Objects with the same weight, and sometimes design, as specific coins in general circulation and usually of brass or other base metal, rarely of glass, created to insure proper metallic content and weight; known in antiquity, but used especially from the 4th century CE to around 1800."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coin weights"@en .

aat:300254286 a skos:Concept ;
    skos:definition "Buildings housing businesses whose primary commodities are tobacco products and smoking accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacconists' shops"@en .

aat:300254296 a skos:Concept ;
    skos:definition "Shop signs in the form of various types of figures, usually of carved wood, advertising tobacco products; popular in Europe from the 17th century and America from the 18th century until the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacconists' figures"@en .

aat:300254301 a skos:Concept ;
    skos:definition "Refers to carved wooden figures, usually life-sized, set up as advertisements in front of or just inside of cigar stores; popular in the United States from the early 19th century until the 1890s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar-store figures"@en .

aat:300254307 a skos:Concept ;
    skos:definition "Cigar-store figures representing American Indians; popular as cigar store advertising signs from the 1850s until the 1890s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar-store Indians"@en .

aat:300254312 a skos:Concept ;
    skos:definition "Pulling boats developed in the 1820s near Whitehall Street, New York City, and used originally in large harbors as workboats by chandlers, pilots, shipping agents, and other businesses, and later for recreation; usually 14 to 22 feet long with one to five rowers sometimes with pail and centerboard, and distinguished by a plumb stem and wine glass-shaped stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Whitehall boats"@en .

aat:300254318 a skos:Concept ;
    skos:definition "Catboats generally characterized by a deep keel, raked stem and transom, and loose-footed gaff sails; sometimes with bowsprit and jib and usually 20 to 24 feet long; originally built around the point at Newport, Rhode Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Newport boats"@en .

aat:300254337 a skos:Concept ;
    skos:definition "Gaff-rigged, stern-steering iceboats usually with long booms and gaffs; developed between the 1860s and the 1880s for racing on the Hudson River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hudson River iceboats"@en .

aat:300254351 a skos:Concept ;
    skos:definition "Scientists who specialize in any or all aspects of soils, including their origin, distribution, classification, utilization, physical and chemical properties, and the role of organisms in soil production and in relation to soil character. For agriculturists who study and work in land cultivation, soil management, and field crop improvement, management, and production, see \"agronomists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil scientists"@en .

aat:300254358 a skos:Concept ;
    skos:definition "Flexible pieces of cloth, paper, or other material joining two separate parts and allowing a swinging motion of one or both of the members along a single axis. Examples include a paper or muslin stub used to affix a print to its mat, and in bookbinding, pieces placed between the two halves of an endpaper where the body of the book is fixed to its covers. Distinguished from \"joints (connections)\", which are the flexing exterior junctions of the spine and covers of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinges"@en .

aat:300254368 a skos:Concept ;
    skos:definition "Refers generally to scientists specializing in any of the sciences concerned with the nature, origin, evolution, and behavior of the solid earth, its waters, and the air that envelops it, including the geologic, hydrologic, and atmospheric sciences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth scientists"@en .

aat:300254374 a skos:Concept ;
    skos:definition "Group portraits depicting two individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double portraits"@en .

aat:300254377 a skos:Concept ;
    skos:definition "Religious texts that explore the values, ideas, and behaviors that a religion is seeking to advance, for the purpose of leading the individual, through devotion, closer to an ultimate state of grace or perfection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional literature"@en .

aat:300254388 a skos:Concept ;
    skos:definition "Science and discipline of breeding, raising, feeding, and tending animals, especially but not exclusively domestic farm animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal husbandry"@en .

aat:300254393 a skos:Concept ;
    skos:definition "Branch of agriculture that deals with land cultivation, soil management, and field crop improvement, management, and production. For the science concerned with all aspects of soils, including their origin, distribution, classification, utilization, physical and chemical properties, and the role of organisms in soil production and in relation to soil character, see \"soil science\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agronomy"@en .

aat:300254398 a skos:Concept ;
    skos:definition "Refers to agriculturists who study and work in land cultivation, soil management, and field crop improvement, management, and production. For scientists who specialize in any or all aspects of soils, including their origin, distribution, classification, utilization, and physical and chemical properties, see \"soil scientists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agronomists"@en .

aat:300254399 a skos:Concept ;
    skos:definition "Primers of cardboard or wood, consisting of two or three pages with the alphabet, numbers, simple text, and sometimes pictures printed or impressed upon them and often varnished for protection. Distinguish from their predecessors, \"hornbooks,\" which are primers consisting typically of a sheet of parchment or layer of paper mounted on a thin wooden board and protected by a sheet of transparent horn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battledores"@en .

aat:300254406 a skos:Concept ;
    skos:definition "Business enterprises owned by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "women-owned business enterprises"@en .

aat:300254418 a skos:Concept ;
    skos:definition "Motif on bone china comprising formalized flowers, foliage, and peaches in blue underglaze; first introduced at Meissen in 1739, and copied extensively by other manufacturers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zwiebelmuster"@en .

aat:300254422 a skos:Concept ;
    skos:definition "Nonimpact computer-controlled printing in which the light from a laser commences an electrophotographic process leading to the fusion of toner onto the printing surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser printing"@en .

aat:300254425 a skos:Concept ;
    skos:definition "Use to describe objects supported by three legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-legged"@en .

aat:300254426 a skos:Concept ;
    skos:definition "Refers to that part of the architectural design process in which requirements, conditions, goals, and methods of a building project are defined and documented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural programming"@en .

aat:300254443 a skos:Concept ;
    skos:definition "The process of piercing or passing into or through a body, form, or substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penetration"@en .

aat:300254446 a skos:Concept ;
    skos:definition "Permanent removal of forests and woodland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deforestation"@en .

aat:300254452 a skos:Concept ;
    skos:definition "A mixture of decaying organic material generally from plant residue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compost"@en .

aat:300254462 a skos:Concept ;
    skos:definition "Images or patterns composed of individually shaped pieces of durable material, usually stone or glass, where each piece forms an element in the design or pattern. It is distinguished from mosaics, which use small fragments of stone or glass (tesserae) to fill in areas or lines in the design, but each tessera does not itself form a pattern or element. Opus sectile originated in Egypt and Asia Minor. It was considered a rarer and more luxurious art than straightforward mosaic. Little survives before Roman times; it was later used in Early Christian and Byzantine churches, and remained popular in Italy, particularly in church floors, throughout the Middle Ages and Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus sectile"@en .

aat:300254470 a skos:Concept ;
    skos:definition "Metal or earthenware covers used to preserve and restrict hearth fires overnight, having a handle and one or more holes to permit draught."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curfews"@en .

aat:300254477 a skos:Concept ;
    skos:definition "Utensils with a spatula-shaped blade and no cutting edge, used for serving meat from a platter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving knives"@en .

aat:300254481 a skos:Concept ;
    skos:definition "Painters who specialize in architectural subjects, which include buildings, gardens, and other items of the built environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural painters"@en .

aat:300254487 a skos:Concept ;
    skos:definition "A thermoplastic adhesive that is already present in a thin layer on the adherend which, by the application of heat and pressure, forms the bond. Distinguished from \"hot-melt adhesive\" which necessitates application of the adhesive in the molten state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat-seal adhesive"@en .

aat:300254496 a skos:Concept ;
    skos:definition "Any material that can be digested or absorbed by the body of a human or other animal and used as a source of energy or some essential nutrient, to build and replace tissue, or to relieve hunger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food"@en .

aat:300254507 a skos:Concept ;
    skos:definition "Hats, usually felt, but also of straw or cloth, with a brim designed to be arranged at various angles; popular especially during the second quarter of the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snap-brim hats"@en .

aat:300254515 a skos:Concept ;
    skos:definition "Headdresses, usually of black fabric, characterized by a peak that projects above the forehead and is maintained by wires or a stiffened decorated framework; usually with embroidered strips that frame the face and either a fall of fabric that continues beyond the shoulders or two long pendant flaps that are sometimes pinned up at the sides; worn with an undercap by women from the late 15th to the mid-16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English hoods"@en .

aat:300254540 a skos:Concept ;
    skos:definition "Rodlike buttons of wood or other material, attached to cord, leather, or chain loops and designed to be passed through another loop as a fastener on a garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toggles"@en .

aat:300254544 a skos:Concept ;
    skos:definition "Loose-fitting, long overcoats or cloaks with elbow-length, often detachable cape and close-fitting collar, may be belted; originally from Inverness, Scotland, and fashionable especially during the second half of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Invernesses"@en .

aat:300254555 a skos:Concept ;
    skos:definition "Members of a family containing 15 living species of tall wading birds with very long legs, neck, and bill. Cranes resemble herons but are usually larger and have a partly naked head, a heavier bill, more compact plumage, and an elevated hind toe. Cranes are ancient in origin, found in Eocene deposits in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gruidae"@en .

aat:300254559 a skos:Concept ;
    skos:definition "Members of an order of nearly 2,900 species placed in about 35 families of bony fishes, characterized by certain distinctive features of the skull and swimbladder. Species vary widely in size and behavior, but most species have prominent barbels. They are sometimes classified in the same order as characins, carp, and minnows; their taxonomy is currently in flux as more research in molecular relationships is undertaken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siluriformes"@en .

aat:300254573 a skos:Concept ;
    skos:definition "Members of a species of flying insects that are common in the homes of humans, having a gray thorax, four longitudinal dark lines on the back, yellow underside of the abdomen, and a body covered with hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musca domestica"@en .

aat:300254582 a skos:Concept ;
    skos:definition "Collapsible shading devices made of a series of cane half-hoops covered with silk and attached to the front of a woman's bonnet that provide protection from the sun; worn especially in the British Isles during the mid-19th century. In Scotland, may also refer to entire protective bonnets made of cotton stretched over half-hoops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uglies"@en .

aat:300254584 a skos:Concept ;
    skos:definition "Sweaters characterized by intricate allover patterns carried out in yarns of several colors, originally hand-knitted on Fair Isle, off the coast of Scotland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fair Isle sweaters"@en .

aat:300254591 a skos:Concept ;
    skos:definition "Schooner-rigged vessels used for fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing schooners"@en .

aat:300254598 a skos:Concept ;
    skos:definition "Two-masted fishing schooners with long narrow bows, straight keels, and a draft limited to 10 to 12 feet due to shoal slips used by them in Gloucester, Massachusetts, harbor; generally found from around 1900 to the 1930s, and used for banks and market fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gloucester fishing schooners"@en .

aat:300254607 a skos:Concept ;
    skos:definition "Vessels designed for sponge fishing, often wide, shallow sloops, schooners, or motorsailers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponge boats"@en .

aat:300254615 a skos:Concept ;
    skos:definition "Close-fitting caps or hairnets usually of gold, silver, silk, or wool thread, often decorated with pearls or beads and made to confine hair; worn by women and sometimes by men especially during the 13th through the 16th century. For hairnets used to confine hair at the back of the neck or attached to the back edge of a hat, use \"snoods.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauls"@en .

aat:300254618 a skos:Concept ;
    skos:definition "Caps of white or navy blue cloth with a flat crown and stiff, dark-colored visor, and usually decorated with an insignia on the front and a braid; patterned after naval officers' caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yachting caps"@en .

aat:300254623 a skos:Concept ;
    skos:definition "Caps with a spherical crown and side and rear flaps, often of fur; worn from the 17th century onward, originally by Spanish hunters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monteros"@en .

aat:300254632 a skos:Concept ;
    skos:definition "Dresses open in front to show an underskirt or with a front gore of contrasting material, with collar and lapels and long sleeves. Bodice may be double-breasted and high-waisted; worn especially during the 1820s through the 1860s. For double- or single-breasted three-quarter length or full-length fitted overcoats with flared skirts, use \"redingote (overcoats).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redingotes"@en .

aat:300254640 a skos:Concept ;
    skos:definition "Implements fastened to a belt or waistband, used for supporting the stationary knitting needle while knitting; usually made of wood or ivory and often carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting sheaths"@en .

aat:300254657 a skos:Concept ;
    skos:definition "Decorative borders created as single design units enclosing the letterpress of a title page. Distinguished from \"frames (ornament areas)\" which are enclosing borders made up of separate units that display no evidence of having been designed to be used together as a border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compartments"@en .

aat:300254662 a skos:Concept ;
    skos:definition "Aromatic, dark brown liquid prepared from the aqueous extract of the seeds of several species of the genus Coffea, particularly C. arabica. Coffee is used as a beverage and as a brown dye. On wool, it produces a dark yellow-tan color with a chrome mordant and a tan with an aluminum mordant. Both colors have fair light fastness. Coffee colors on cotton are not fast. Some restorers have used coffee to tint bleached papers or repair regions to a shade that corresponds to surrounding areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee"@en .

aat:300254667 a skos:Concept ;
    skos:definition "Photographs produced in small, automated picture-taking enclosures; usually requiring automated payment of a small fee to initiate the photographic process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photobooth pictures"@en .

aat:300254678 a skos:Concept ;
    skos:definition "Small, automatic picture-taking enclosures; usually requiring automated payment of a small fee to initiate the photographic process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photobooths"@en .

aat:300254689 a skos:Concept ;
    skos:definition "Refers to the style of porcelain, originally made in China, characterized by the inclusion of an opaque enamel color that ranges from pink to purplish rose. The pigment itself is called Purple of Cassius, derived from colloidal gold, and was taken to China by Jesuit missionaries around 1685. The style reached its peak during the reign of Yongzheng (1723-1735), after which it became increasingly commercial and largely for export to Europe. The style also occurs in French, German, and English wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "famille rose"@en .

aat:300254696 a skos:Concept ;
    skos:definition "Hard, fine-grained, unglazed black stoneware first developed in Staffordshire, England, in the 18th century, further developed and produced by the Wedgwood factory from the 1760s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black basaltes"@en .

aat:300254720 a skos:Concept ;
    skos:definition "Medium used in a number of printing processes, such as xerography, to record an image on a support, consisting of fine particles of pigment plus other materials, produced in the form of a dry resinous powder or a liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toner"@en .

aat:300254740 a skos:Concept ;
    skos:definition "Any material used to protect, cushion, or brace objects for safe shipment or storage. For packing material that carries information or otherwise conveys a message about the product, use \"packaging.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packing material"@en .

aat:300254769 a skos:Concept ;
    skos:definition "Rock gardens in which alpine plants predominate, often with cascading streams or pools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alpine gardens"@en .

aat:300254773 a skos:Concept ;
    skos:definition "Prints made using the process of lithographic engraving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic engravings"@en .

aat:300254782 a skos:Concept ;
    skos:definition "Lithographic printing process in which a design is engraved through a water soluble ground on the stone or plate, causing the ink to be retained in the engraved lines; the process combines aspects of both planographic and intaglio printing processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithographic engraving"@en .

aat:300254788 a skos:Concept ;
    skos:definition "The technique of creating tone in lithography by splattering lithographic ink on the stone or plate using a stiff brush and mesh screen or sieve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splatter"@en .

aat:300254790 a skos:Concept ;
    skos:definition "Literary works in which action, physical danger, and suspense are key elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adventure stories"@en .

aat:300254800 a skos:Concept ;
    skos:definition "Literary works in which an animal or animals are the primary characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal stories"@en .

aat:300254803 a skos:Concept ;
    skos:definition "The mental capacity or faculty of retaining and recalling facts, events, impressions, or recognizing previous experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memory"@en .

aat:300254804 a skos:Concept ;
    skos:definition "Literary works that ridicule either through the treatment of a solemn subject in an undignified manner or by applying an elevated style and manner to a trivial subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burlesques"@en .

aat:300254807 a skos:Concept ;
    skos:definition "Recorded results of diligent and systematic inquiry or investigation into a subject made to discover or revise facts, theories, or applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research"@en .

aat:300254810 a skos:Concept ;
    skos:definition "Accounts of journeys, voyages, and travels written to instruct, inform or entertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel literature"@en .

aat:300254815 a skos:Concept ;
    skos:definition "Genre of novels, short stories, comic books, etc., characterized by a setting in the American West during the US western expansion, usually the 1850s through the early 1900s; the western genre reached its greatest popularity in the early and middle 20th century. The genre is primarily an American creation, although the western had its counterparts in the gaucho literature of Argentina and in tales of the settlement of the Australian outback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "western"@en .

aat:300254823 a skos:Concept ;
    skos:definition "Prose tales of the supernatural in which the living encounter manifestations of the spirits of the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghost stories"@en .

aat:300254833 a skos:Concept ;
    skos:definition "Slits in costume used as a form of decoration to reveal a lining or undergarment often of a contrasting color, used especially on doublets, hose, sleeves, and shoes of the 15th through the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slashing"@en .

aat:300254844 a skos:Concept ;
    skos:definition "A smooth, rounded shape that is convex on both sides; that is, the shape of a long oval that is indented on one side. Named for the shape of the glandular organs situated in the abdominal cavity, especially those of humans, cattle, sheep, and pigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kidney-shaped"@en .

aat:300254850 a skos:Concept ;
    skos:definition "Pullover garments of knitted cloth with short or long sleeves; may be a sweater, shirt, or tunic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jerseys"@en .

aat:300254861 a skos:Concept ;
    skos:definition "Woven textile material characterized by a weave structure that uses a secondary or binding warp to bind the wefts that form the design, producing a double weave effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lampas"@en .

aat:300254863 a skos:Concept ;
    skos:definition "Purpose, design, or concept behind an artist's creative effort."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist's intent"@en .

aat:300254871 a skos:Concept ;
    skos:definition "A substance, often metal, intended for or undergoing assaying analysis or testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assays"@en .

aat:300254874 a skos:Concept ;
    skos:definition "Synthetic fiber produced from long-chain polyamides, suitable for cable, rope, tape, textile, and webbing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aramid"@en .

aat:300254881 a skos:Concept ;
    skos:definition "The determination and measure of responsibility and liability to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accountability"@en .

aat:300254886 a skos:Concept ;
    skos:definition "Numerical quantity expressing the degree to which a substance absorbs something."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absorption coefficient"@en .

aat:300254891 a skos:Concept ;
    skos:definition "The energy that a body possesses because of its motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinetic energy"@en .

aat:300254898 a skos:Concept ;
    skos:definition "Region of space subjected to the influence of magnetism typically due to magnets, current-carrying conductors, and electromagnetic waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic field"@en .

aat:300254909 a skos:Concept ;
    skos:definition "The sum of all chemical and physical processes within a living organism and also the energy made available for various forms of work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metabolism"@en .

aat:300254915 a skos:Concept ;
    skos:definition "Stored capacity of a body or system to do work by virtue of its configuration and position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potential energy"@en .

aat:300254919 a skos:Concept ;
    skos:definition "Energy in the form of a stationary electric charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "static electricity"@en .

aat:300254935 a skos:Concept ;
    skos:definition "Refers to the culture of Armenia roughly corresponding to the area of modern Armenia and central and eastern Turkey, particularly between the 4th and 7th centuries during the so called classical period of Armenian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian"@en .

aat:300254977 a skos:Concept ;
    skos:definition "Members of a loosely constituted youth movement originating in the United States in the 1960s, rejecting the established conventions and structure of society, and advocating universal love, peace, communal living, and simple, idealistic values."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hippies"@en .

aat:300254981 a skos:Concept ;
    skos:definition "Bluish or grayish discoloration of timber caused by the growth of several types of moldlike fungi on the surface and in the interior of the sapwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue stain"@en .

aat:300254992 a skos:Concept ;
    skos:definition "Style and culture of the Bahmani sultanate, a Muslim state (1347-1518) in the Deccan in India. The sultanate was founded in 1347 by 'Ala' al-Din Bahman Shah, who was supported by other military leaders in rebellion against the sultan of Delhi, Muhammad ibn Tughluq."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bahmani"@en .

aat:300255002 a skos:Concept ;
    skos:definition "Portions of theater buildings that rise above the stage area and enclose the fly lofts and devices located over the stage; usually found with proscenium theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly towers"@en .

aat:300255015 a skos:Concept ;
    skos:definition "Field concerned with the design and creation of productive, low-maintenance agricultural systems and urban environments which have the diversity, stability, and resilience of natural ecosystems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permaculture"@en .

aat:300255019 a skos:Concept ;
    skos:definition "Any of a variety of sweet, relatively rich quick breads, shortened or unshortened, typically made with flour, sugar, leavening, liquid, and flavoring, and usually shaped by the tin in which it is baked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cake"@en .

aat:300255024 a skos:Concept ;
    skos:definition "Sources intended primarily for consultation that pertain to heraldry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heraldic reference sources"@en .

aat:300255025 a skos:Concept ;
    skos:definition "Dictionarylike references of armorial bearings (all authorized devices including coats of arms, badges, and flags) listed alphabetically by surname."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armories"@en .

aat:300255028 a skos:Concept ;
    skos:definition "Reference works on coats of arms, heraldic bearings and devices, or the subject of armory (the devising and regulating of emblematic representations according to established convention)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armorials"@en .

aat:300255035 a skos:Concept ;
    skos:definition "Heraldic reference sources in which coats of arms are arranged in some methodical order by the designs they contain (the charges)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordinaries of arms"@en .

aat:300255044 a skos:Concept ;
    skos:definition "Gardening based on soil management practices that do not include artificial or potentially toxic fertilizers, pesticides, or herbicides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic gardening"@en .

aat:300255050 a skos:Concept ;
    skos:definition "Generally lightweight, two-wheeled utility vehicles meant to be pushed by hand, as, for example, used by street vendors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pushcarts"@en .

aat:300255058 a skos:Concept ;
    skos:definition "Branch of agriculture that aims at increasing or maintaining productivity at levels that are economically viable, environmentally sound, and culturally acceptable, through the efficient conservation and use of resources, while protecting the environment and the health of humans and animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sustainable agriculture"@en .

aat:300255059 a skos:Concept ;
    skos:definition "Spatial arrangements and distributions of populations and human settlements across the landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settlement patterns"@en .

aat:300255068 a skos:Concept ;
    skos:definition "Refers to Christian orders or communities of men or women following the Rule of St. Augustine, consisting of instructions for religious life written by the theologian Augustine, bishop of Hippo (354-430). The Rule places an emphasis on union with others in a common love of God. The earliest to follow the Rule were the Canons Regular, Augustinian (or Austin) Canons, approved 1059-63. Specifically, the term often refers to one of the two main Augustinian branches, the mendicant order known as the Augustinian Hermits. The Augustinian Hermits came about in 1256 when disparate orders of Italian hermits were united. The Premonstratensians and the Jeronymites are other notable orders that adopted the Rule. Augustinians have been responsible for many missions, monasteries, schools and well-known hospitals all over the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Augustinian"@en .

aat:300255069 a skos:Concept ;
    skos:definition "Branch of history concerned with any and all aspects of seafaring in any context, such as commerce, exploration, warfare, and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maritime history"@en .

aat:300255080 a skos:Concept ;
    skos:definition "Rows or ranks of objects arranged one above the other, as amphitheater seats, beams, or oars on galleys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiers"@en .

aat:300255094 a skos:Concept ;
    skos:definition "Canopies under which Jewish marriage ceremonies take place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huppahs"@en .

aat:300255102 a skos:Concept ;
    skos:definition "Watertight, usually metal, boatshaped containers hauled on a line between a wrecked vessel and the shore; used for marine rescues from 1849 until ca. 1910."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life cars"@en .

aat:300255109 a skos:Concept ;
    skos:definition "Screw steamboats used in the menhaden fishery to carry fishermen, seiners, and driveboats to fishing grounds, and to transport the catch to fish factories; usually 90 to 150 feet long with the forward mast fitted with a crane for loading catch, and cranes aft for hoisting and lowering seiners and driveboats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menhaden steamers"@en .

aat:300255116 a skos:Concept ;
    skos:definition "Large upper-level floor spaces directly below the roof of commercial buildings or warehouses, originally unpartitioned but often modified for secondary use; may also be used for domestic sleeping or storage platforms set close to ceilings or roofs and open to and overlooking a living space below. For enclosed spaces under sloping roofs, between the roof and the ceiling of the uppermost story, especially in houses, use \"attics (interior spaces).\" For substantial interior spaces at the level of an upper story, usually extending the full length or width of rooms, use \"galleries (upper level spaces).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lofts"@en .

aat:300255138 a skos:Concept ;
    skos:definition "Sections of a garment set in vertically and usually stitched on two sides or strips of cloth attached at the top and allowed to hang freely from a garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panels"@en .

aat:300255147 a skos:Concept ;
    skos:definition "Study of the geographic aspects of political phenomena, including the geographical bases of the power of nations, and geographic influences on power relationships in international politics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geopolitics"@en .

aat:300255151 a skos:Concept ;
    skos:definition "Specialists in the study of the geographic aspects of political phenomena, including the geographical bases of the power of nations, and geographic influences on power relationships in international politics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geopoliticians"@en .

aat:300255157 a skos:Concept ;
    skos:definition "The analytical division of time into defined periods, especially the grouping of historical and cultural events into periods for purposes of discussion and criticism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periodization"@en .

aat:300255160 a skos:Concept ;
    skos:definition "Scottish caps of varying forms, but without brim or visor, usually of knitted wool; originally worn by people in the military."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonnets"@en .

aat:300255177 a skos:Concept ;
    skos:definition "Dresses worn by brides during the wedding ceremony, in many styles and colors, often having a train."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding dresses"@en .

aat:300255216 a skos:Concept ;
    skos:definition "Characters or symbols with which a language is written, comprising an \"alphabetic writing system\"; a set of conventions for their use is not necessarily included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphabets"@en .

aat:300255231 a skos:Concept ;
    skos:definition "Formal arrangements of letters or words with particular attention to overall design and composition, as on the spines or covers of books or on signs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettering"@en .

aat:300255240 a skos:Concept ;
    skos:definition "Adventure stories following the model of Robinson Crusoe featuring exploits of persons stranded in difficult circumstances, surviving through resourcefulness and ingenuity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Robinsonades"@en .

aat:300255244 a skos:Concept ;
    skos:definition "Puzzling questions or statements, written or oral, worded so as to exercise one's ingenuity in answering or discovering their hidden meaning; frequently used as a game or pastime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riddles"@en .

aat:300255252 a skos:Concept ;
    skos:definition "Italic typeface having exaggerated serif, terminal, tail, entry stroke, or other flourish or flourishes. Capital swashes are often used as the first letter of a word beginning a paragraph."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swash"@en .

aat:300255264 a skos:Concept ;
    skos:definition "Letters, symbols, or ornament tranferred from a backing sheet to a working surface, either by burnishing or by hand placement of cut-out self-adhesive characters and figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transfer type"@en .

aat:300255278 a skos:Concept ;
    skos:definition "Mass-market literary genre in which love is the central theme; often written by and for women and featuring plots that focus on finding and sustaining romantic relationships with an ideal partner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "romantic fiction"@en .

aat:300255298 a skos:Concept ;
    skos:definition "The measure, usually in points of the dimensions of type, taken from the body of the individual type, rather than from the actual printing area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type sizes"@en .

aat:300255312 a skos:Concept ;
    skos:definition "Stories, verses, or writings usually intended for children, admonishing or warning of the consequences of misbehavior or foolishness; also, in various disciplines, refers to writings warning of possible methodological pitfalls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cautionary tales"@en .

aat:300255315 a skos:Concept ;
    skos:definition "Motifs comprising circular representations of the points of the compass, often including both true and magnetic directions. Typically seen on maps and navigational charts; originally used to assist mariners in navigation, now most commonly decorative in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compass roses"@en .

aat:300255324 a skos:Concept ;
    skos:definition "Use to describe objects including structures, designed to move incrementally around an axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotating"@en .

aat:300255347 a skos:Concept ;
    skos:definition "Paper printed or patterned in relief with a design and used frequently in bookbindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patterned paper"@en .

aat:300255352 a skos:Concept ;
    skos:definition "The transmission of sound pressure waves from a body due to a rapid energy release in response to internal or external mechanical stress placed upon the medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustic emission"@en .

aat:300255366 a skos:Concept ;
    skos:definition "Books kept at the headquarters of a military unit, such as a regiment or company, in which orders received from higher authorities are recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orderly books"@en .

aat:300255372 a skos:Concept ;
    skos:definition "Metal and plastic identification tages, often worn in pairs, by military personnel around their necks, carrying such information as name, rank, serial number, religious affiliation, and blood type; so-called because they broadly resemble the common tags used for pets. Modern tags may include digital information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog tags"@en .

aat:300255378 a skos:Concept ;
    skos:definition "Cards issued to individual members of an organization attesting to the fact of their membership, typically wallet-sized and carrying the name of the member and the name or logo of the organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "membership cards"@en .

aat:300255412 a skos:Concept ;
    skos:definition "Refers to various processes involving the introduction of one or more acetyl groups into a compound by means of a chemical reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetylation"@en .

aat:300255413 a skos:Concept ;
    skos:definition "Various processes simultaneously involving both the introduction of one or more acetyl groups into a compound and hydrolysis by means of a chemical reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetolysis"@en .

aat:300255420 a skos:Concept ;
    skos:definition "Abnormal reactions of the body produced by a sensitizing dosage of or exposure to some foreign material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allergies"@en .

aat:300255425 a skos:Concept ;
    skos:definition "The values obtained by dividing one number by another; often used for comparison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratios"@en .

aat:300255431 a skos:Concept ;
    skos:definition "The activity and state of being trained in the capacity of an intern, who is a student obtaining practical professional experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internship"@en .

aat:300255438 a skos:Concept ;
    skos:definition "Conducting an interpersonal exchange in order to obtain information from another for such purposes as for journalism, employment, publication, or research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interviewing"@en .

aat:300255443 a skos:Concept ;
    skos:definition "A material, that when added to a medication or other formulation, aids its action or otherwise affects it in some predictable way."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adjuvant"@en .

aat:300255447 a skos:Concept ;
    skos:definition "Excrement of certain animals, especially domesticated animals; may also be used for excrement often enriched with various chemicals and used as fertilizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manure"@en .

aat:300255449 a skos:Concept ;
    skos:definition "Any gradual build up or enlargement due to external addition by deposition of new matter; for example, the increase in size of an inorganic mass as fresh particles are added to its surface or the physical addition to land due to deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accretion"@en .

aat:300255468 a skos:Concept ;
    skos:definition "Hereditary marks, emblems, or badges of a tribe, clan, or group of people, consisting of a representation of a real or mythical animal, or less commonly a plant or other natural object, and having religious or social significance. Often used particularly in reference to such items in Native American culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "totems"@en .

aat:300255471 a skos:Concept ;
    skos:definition "Tobacco prepared for chewing, produced in a variety of forms such as compressed cakes, braided ropes, shredded leaves, and loose leaf ends, and usually flavored with substances such as licorice, spices, honey, or rum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chewing tobacco"@en .

aat:300255475 a skos:Concept ;
    skos:definition "Chewing tobacco produced in the form of a flat cake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plug tobacco"@en .

aat:300255493 a skos:Concept ;
    skos:definition "Formerly used to refer to what was considered an order of mammals characterized by either the complete lack of teeth, or teeth that are small and few, such as in armadillos and anteaters. It was subsequently realized that Edentata was polyphyletic, meaning it contained animals that were actually members of unrelated families; thus the order is now considered invalid by cladistic standards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edentata"@en .

aat:300255496 a skos:Concept ;
    skos:definition "Members of a suborder containing the families Cyclopedidae and Myrmecophagidae, comprising four species of quadruped mammals having elongated skulls and tubular muzzles, with long, thread-like viscous tongues used to catch and consume small insects such as ants and termites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vermilingua"@en .

aat:300255499 a skos:Concept ;
    skos:definition "Members of a species of burrowing nocturnal African edentate mammals having a long snout, long narrow sticky tongue, large ears, a heavy, tapering tail, and long powerful claws for tearing open logs and anthills to feed on ants and termites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orycteropus afer"@en .

aat:300255506 a skos:Concept ;
    skos:definition "Members of the species that are the largest among anteaters, best known in the tropical grasslands of Venezuela, although it was formerly found in the lowland forests of Central America. They are about four feet in length exclusive of the tail, with long shaggy grey fur with a black breast band and white stripe on the shoulder, powerful claws, and long slender sticky tongue with which to lick up ants a termites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myrmecophaga tridactyla"@en .

aat:300255516 a skos:Concept ;
    skos:definition "Members of a genus containing around eight species of armored placental mammals native to Asia and Africa, characterized by having a body covered with broad overlapping horny scales; they curl themselves up into a ball when threatened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manis"@en .

aat:300255521 a skos:Concept ;
    skos:definition "Members of a family of mammals containing around 20 living species in 9 genera, characterized by having a set of bony plates (the carapace) covering much of the body, which is almost hairless in most species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dasypodidae"@en .

aat:300255523 a skos:Concept ;
    skos:definition "Members of the suborder containing six living species belonging to two familes (two-toed and three-toed sloths), the living species having in common that they are tree-dwelling mammals noted for slowness of movement and native to the lowland tropical forests of South and Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Folivora"@en .

aat:300255532 a skos:Concept ;
    skos:definition "Articles or physical resources related to the science and practice of breeding, raising, feeding, and tending domestic animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal husbandry equipment"@en .

aat:300255533 a skos:Concept ;
    skos:definition "Articles or physical resources designed and utilized for animals that perform tasks that aid human labor or activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal work equipment"@en .

aat:300255536 a skos:Concept ;
    skos:definition "Former suborder that included the primitive primates: lemurs, lorises, and tarsiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prosimii"@en .

aat:300255542 a skos:Concept ;
    skos:definition "Members of a genus containing two extant species of apes. The term \"chimpanzees\" properly refers to the genus and both or either species, however, it is sometimes used to refer to the species of common chimpanzee, Pan troglodytes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pan"@en .

aat:300255548 a skos:Concept ;
    skos:definition "Members of a genus containing five living species of large, robust, and primarily terrrestrial monkeys found in dry regions of Africa and Arabia, characterized by a long dog-like snout, large canine teeth or tusks, capacious cheek pouches, and naked callosities on the buttocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papio"@en .

aat:300255555 a skos:Concept ;
    skos:definition "Instruments consisting of an often rigid handle and a flexible lash or lashes made of cord or leather, used for disciplinary action, torture, or weapons against animals or humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whips"@en .

aat:300255558 a skos:Concept ;
    skos:definition "Riding whips with short rigid handles to which one or more leather lashes are attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quirts"@en .

aat:300255560 a skos:Concept ;
    skos:definition "Bars that rest on the shoulders to allow drawing, plowing, or load carrying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yokes"@en .

aat:300255573 a skos:Concept ;
    skos:definition "Metal, wooden, or leather devices with a flat foot rest and bow-shaped section attached to the saddle by a stirrup strap, used to support the rider's feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stirrups"@en .

aat:300255575 a skos:Concept ;
    skos:definition "Long ropes with running nooses, used for ensnaring something or someone, as with livestock or in battle. Lassos have been in use since ancient times in many cultures, including ancient Egypt, Scandinavia, Mongolia, India, and North and South America. Lassos in the Americas are usually made of rawhide or hemp, used for capturing or restraining livestock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lassos"@en .

aat:300255580 a skos:Concept ;
    skos:definition "The curved parts of harnesses, shaped to fit around a draft animal's neck, against which it exerts its weight to move a load."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collars"@en .

aat:300255587 a skos:Concept ;
    skos:definition "Pillowlike saddles made out of skins and stuffed with animal hair, used by Plains Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pad saddles"@en .

aat:300255591 a skos:Concept ;
    skos:definition "Forks in a place setting, larger than the salad fork, that are used for consuming the main course of a meal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table forks"@en .

aat:300255606 a skos:Concept ;
    skos:definition "Tools with a flat round end on an often ornamented handle, usually made of brass or silver, used for pushing down tobacco into the bowls of pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe stoppers"@en .

aat:300255626 a skos:Concept ;
    skos:definition "Roughly constructed fore-and-aft-rigged workboats built in the Bahama Islands and used for fishing and interisland transport; usually 13 to 20 feet long with a single mast stepped forward, loose-footed gaffe sail, outboard rudder and sometimes with an outboard engine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bahama dinghies"@en .

aat:300255632 a skos:Concept ;
    skos:definition "Canoes whose outer skin is bark; originally built by North American Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bark canoes"@en .

aat:300255648 a skos:Concept ;
    skos:definition "Sloop-rigged fishing vessels, 20 to 40 feet long, with a deep keel, counter stern, clipper bow, strong sheer, and gaff topsails and double headsails; originally designed in Friendship and Muscongus Bay, Maine; often converted to power yachts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Friendship sloops"@en .

aat:300255663 a skos:Concept ;
    skos:definition "Distinguished from \"Cape Cod catboats\" by their counter stern, lower freeboard, and narrower beam; originally developed for shellfishing and later for racing in the shoal waters of Great South Bay, Long Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Great South Bay catboats"@en .

aat:300255674 a skos:Concept ;
    skos:definition "Centerboard sloops with mainsail and jib, usually 16 to 26 feet LOA (length overall), developed during the mid-nineteenth century around Muscongus Bay, Maine, for lobstering and fishing off the Maine and Massachusetts coasts; forerunners of Friendship sloops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muscongus Bay sloops"@en .

aat:300255684 a skos:Concept ;
    skos:definition "Double-ended workboats, 16 to 22 feet long, originally keeled, with a hole at each end of the keel, two masts, usually with small spritsails, and later fitted with off-center centerboards; designed to be launched and beached through the surf and developed in the late nineteenth century for lobster and scallop fishing around Martha's Vineyard, Massachusetts, and along the Rhode Island coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "No Man's Land boats"@en .

aat:300255698 a skos:Concept ;
    skos:definition "Catboats distinguished from \"Cape Cod catboats\" by their narrower hulls, increased freeboard, and collapsible spritsail rig; first designed in the 1870s for lobstering and fishing in the specific coastal conditions around Woods Hole, Massachusetts; later used for racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Woods Hole spritsail boats"@en .

aat:300255706 a skos:Concept ;
    skos:definition "Any of various diseases afflicting one or more joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arthropathy"@en .

aat:300255715 a skos:Concept ;
    skos:definition "The aspect of the discipline of dance that involves inventing or arranging and putting together steps, gestures, and patterns to form dances, and separate dances to form a dance composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choreography"@en .

aat:300255718 a skos:Concept ;
    skos:definition "Those from whom a person is descended, usually considered to be those more remote in the line of descent than grandparents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancestors"@en .

aat:300255735 a skos:Concept ;
    skos:definition "Mechanical, electronic or radio-wave transmission, broadcast, or reproduction systems of communication relying on sounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound systems"@en .

aat:300255739 a skos:Concept ;
    skos:definition "The combination of sound recording and transducing devices and associated equipment for picking up sound at one location and time and reproducing it at the same or another location at the same or different time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound-reproducing systems"@en .

aat:300255747 a skos:Concept ;
    skos:definition "Processing facilities for making lime, historically consisting of rows of lime kilns, tracks, and associated mine structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limeworks"@en .

aat:300255752 a skos:Concept ;
    skos:definition "Rooms for the accommodation of guards while on duty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guardrooms"@en .

aat:300255765 a skos:Concept ;
    skos:definition "Dramatic musical performances of operas, which are works in which most roles intended to be sung with instrumental accompanyment, usually including arias, recitives, and choruses. Typically, the performances are staged with elaborate costumes, sets, and dramatic movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "operas"@en .

aat:300255772 a skos:Concept ;
    skos:definition "Use only in the United Kingdom for visors on caps and various types of military headgear, other than armored helmets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peaks"@en .

aat:300255776 a skos:Concept ;
    skos:definition "Accessories or objects of adornment worn to support stockings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosiery supporters"@en .

aat:300255777 a skos:Concept ;
    skos:definition "Men's garters, worn at the knee to hold up socks that are below-knee in length; the term is currently used in the United Kingdom and historically was used in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sock suspenders"@en .

aat:300255782 a skos:Concept ;
    skos:definition "Women's garters in the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspenders"@en .

aat:300255786 a skos:Concept ;
    skos:definition "British sleeveless underbodices, usually front-buttoning, of knitted cloth reinforced with woven fabric strips; introduced in 1908 and formerly worn primarily by young girls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liberty bodices"@en .

aat:300255791 a skos:Concept ;
    skos:definition "Spurs attached without straps to the heels of boots by means of an integral catch in the heel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box spurs"@en .

aat:300255796 a skos:Concept ;
    skos:definition "Rented compartments in officially designated post offices in which all mail is placed and held until called for by the renter. For outdoor public and private boxes for pickup and delivery of mail, use \"mailboxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post-office boxes"@en .

aat:300255803 a skos:Concept ;
    skos:definition "Formal daytime dress for men; also, during the 19th century, women's dress appropriate for wear in the morning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morning dress"@en .

aat:300255809 a skos:Concept ;
    skos:definition "Lidded, roughly cylindrical containers with one or two handles used for holding, cooling, and transporting milk, holding varying quantities and generally of stainless steel or tin-coated galvanized steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk cans"@en .

aat:300255815 a skos:Concept ;
    skos:definition "Close-fitting, usually knitted underwear made of natural or synthetic fibers and consisting of drawers and a shirt with sleeves that usually reach the wrist; may be in one or two pieces; worn to retain body heat or wick moisture off the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long underwear"@en .

aat:300255819 a skos:Concept ;
    skos:definition "Men's two- or three-piece suits of matching material, worn in the United Kingdom for informal occasions from the 1860s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lounge suits"@en .

aat:300255824 a skos:Concept ;
    skos:definition "Single-strapped bags worn over one shoulder, used originally for carrying soldiers' rations and other supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haversacks"@en .

aat:300255832 a skos:Concept ;
    skos:definition "Hard, saltless biscuits or bread made of flour and water; formerly used aboard ships and in the armed forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardtack"@en .

aat:300255860 a skos:Concept ;
    skos:definition "White to yellow mass of amorphous crystals, with the chemical structure K2O2; used as an oxidizing and bleaching agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium peroxide"@en .

aat:300255863 a skos:Concept ;
    skos:definition "Material in film form that has a base of cellulose acetate (CA), cellulose acetate butyrate (CAB) or cellulose propionate (CP). Cellulose acetate was first used as a photographic film in 1908 (Eastman-Kodak) and by 1910 the acetate film produced by Dreyfus in France started to replace cellulose nitrate motion picture film. Acetate film is also used for magnetic tapes, animation cels, drafting films, envelope windows and other protective sheets, and has many other uses. It is transparent, air proof, hygenic, and resistent to grease, oil, and dust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetate film"@en .

aat:300255874 a skos:Concept ;
    skos:definition "Devices for charging storage batteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battery chargers"@en .

aat:300255878 a skos:Concept ;
    skos:definition "Parts of compasses or other devices designed for holding pencil leads and attached to a compass leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pencil points"@en .

aat:300255895 a skos:Concept ;
    skos:definition "Sharp metal points at the ends of the legs of compasses and dividers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needle points"@en .

aat:300255914 a skos:Concept ;
    skos:definition "Combined hue and intensity of a color, without reference to its value, to determine color quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromaticity"@en .

aat:300255920 a skos:Concept ;
    skos:definition "Material made from tendons, the tough cords or bands of fibrous connective tissue forming the termination of the muscle by which it is attached to the bone or other part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tendon"@en .

aat:300255931 a skos:Concept ;
    skos:definition "Oil extracted from the seed of jojoba, used widely in the production of cosmetics and lubricants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jojoba oil"@en .

aat:300255935 a skos:Concept ;
    skos:definition "White mineral consisting of calcium magnesium carbonate occurring as chalklike masses and used as a white pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huntite"@en .

aat:300255937 a skos:Concept ;
    skos:definition "The collagen in bone; used to make glue and gelatin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ossein"@en .

aat:300255941 a skos:Concept ;
    skos:definition "Forms or outlines created by two curves that intersect in such a way so as to combine characteristics of oval and almond-shapes, being rounded on one end and pointed on the other. Examples include leaf-shaped arrowheads. To designate a plant or other thing that is composed of or possesses leaves or parts that resemble leaves, use \"foliose.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaf-shaped"@en .

aat:300255943 a skos:Concept ;
    skos:definition "The optical property of a material that reveals different colors of transmitted light depending on the length of the light beam and the thickness of the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dichroism"@en .

aat:300255945 a skos:Concept ;
    skos:definition "The gas and aerosol envelope that extends from the ocean, land, and ice-covered surface of a planet outward into space; used especially in reference to the earth where it is held by the force of gravity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atmosphere"@en .

aat:300255964 a skos:Concept ;
    skos:definition "In the glass trade, a type of art glass developed and produced by the Württembergische Metallwarenfabrik, Göppingen, ca. 1930, characterized by decorations created through inlaid patches or strips of color, often in combination with patterned air bubbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ikora-Kristall"@en .

aat:300255968 a skos:Concept ;
    skos:definition "Any material, compound, or system, though generally a clay or silicate, that can provide a sorption function such as adsorption, absorption, or desorption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sorbent"@en .

aat:300255978 a skos:Concept ;
    skos:definition "Bathtubs in which water is sprayed down upon the bather from an overhead, usually perforated, nozzle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shower baths"@en .

aat:300255984 a skos:Concept ;
    skos:definition "The skin of a goat; often tanned as a leather and used in the book and garment trades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goatskin"@en .

aat:300255987 a skos:Concept ;
    skos:definition "The skin, usually of a young goat, occasionally a young lamb or related young animal, which when tanned, tawed, or manufactured, commonly finds use in the bookbinding and garment trades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kidskin"@en .

aat:300255993 a skos:Concept ;
    skos:definition "Thin, soft leather made of unsplit sheepskin, similar to basil but firmer and usually tanned with sumach, given a dark finish with a smooth grain in imitation of morocco; popular in bookbinding as a less expensive substitute for morocco from 1790 into the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roan"@en .

aat:300255995 a skos:Concept ;
    skos:definition "Small, rectangular block, generally of granite, used for paving streets and walkways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sett"@en .

aat:300256003 a skos:Concept ;
    skos:definition "Tooling using implements that are usually hand-held, heated, and pressed onto gold leaf leaving a pattern in gold on a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold tooling"@en .

aat:300256007 a skos:Concept ;
    skos:definition "Tooling, using implements that are usually hand-held, heated, and pressed onto silver leaf leaving a pattern in silver on a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver tooling"@en .

aat:300256014 a skos:Concept ;
    skos:definition "A thick paper, historically hand-made in Japan, with a smooth finish produced as an imitation of vellum parchment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese vellum"@en .

aat:300256021 a skos:Concept ;
    skos:definition "A technique used in printing whereby a sheet of paper, originally China paper, is adhered to a heavier backing sheet as it is run through a printing press. This creates variations of color or texture under the printed image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chine collé"@en .

aat:300256026 a skos:Concept ;
    skos:definition "Refers to the decorative form created when smaller pieces of a material are attached onto the surface of a larger piece of material; especially used for pieces of leather, paper, or other material laid on the bindings or covers of books for decorative or illustrative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onlays"@en .

aat:300256033 a skos:Concept ;
    skos:definition "Decorative forms created when pieces of a material are inserted into similar-sized openings in a surrounding material so as to create a design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inlays"@en .

aat:300256040 a skos:Concept ;
    skos:definition "Leaves placed immediately before the title pages of books, carrying the half title on the recto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-title pages"@en .

aat:300256048 a skos:Concept ;
    skos:definition "Trinkets and baubles tossed to spectators from parade floats during Mardi Gras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throws"@en .

aat:300256050 a skos:Concept ;
    skos:definition "Objects signifying an honor bestowed upon an individual; usually worn on the person. For decorative forms that are an integral part of a building or object but not essential to its structure, also for decorative objects attached to or worn by humans and animals, use \"ornaments.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorations"@en .

aat:300256059 a skos:Concept ;
    skos:definition "Cards enclosed with invitations to Mardi Gras balls, intended to be presented for admission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "admit cards"@en .

aat:300256063 a skos:Concept ;
    skos:definition "Systems of musical notation that use letters, numbers, or other symbols instead of conventional staff notation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablature"@en .

aat:300256066 a skos:Concept ;
    skos:definition "Prose works that focus on life on or near the ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea stories"@en .

aat:300256072 a skos:Concept ;
    skos:definition "Biographies employing fact and some invented elements with the intent to both inform and entertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fictional biography"@en .

aat:300256090 a skos:Concept ;
    skos:definition "Marks stamped on valuable or unique objects such as jewelry, silverware, furniture, and timepieces, for the purpose of identifying the craftsman or workshop of origin. Distinguished from \"hallmarks\" which are official stamps affixed by guilds or assay offices as evidence of the quality of the metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "makers' marks"@en .

aat:300256109 a skos:Concept ;
    skos:definition "Small binder's finishing tools consisting of a usually brass shank or head cast in designs of varying complexity, set into a wooden handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unit tools"@en .

aat:300256115 a skos:Concept ;
    skos:definition "Unit tools cut in flower or leaf designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "florets"@en .

aat:300256135 a skos:Concept ;
    skos:definition "Alphabet of written Russian, Slavic, and some non-Slavic languages, originally based on the 38 Greek uncials and including later additions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyrillic"@en .

aat:300256140 a skos:Concept ;
    skos:definition "Alphabet of Semitic origin, borrowed from the Phoenecians in first millennium BCE, and modified by the Greeks to include characters representing both vowel and consonant sounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek alphabet"@en .

aat:300256146 a skos:Concept ;
    skos:definition "Alphabet of 22 characters of Semitic origin, used from the third century BCE for writing the Hebrew language and later for Yiddish, Ladino, and other languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hebrew alphabet"@en .

aat:300256158 a skos:Concept ;
    skos:definition "Documents issued by the government to ships engaged in foreign trade, establishing the nationality and ownership of a ship and entitling it to the benefits and privileges appertaining to all ships of the nation to which it belongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates of registry"@en .

aat:300256164 a skos:Concept ;
    skos:definition "Wood of trees belonging to the genus Rhus. Since they are usually shrubs or very small trees, it is more common for the trees to be used for tannin and other products than for wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sumac"@en .

aat:300256169 a skos:Concept ;
    skos:definition "Those who practice holography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holographers"@en .

aat:300256173 a skos:Concept ;
    skos:definition "Oaths, verbal or written, usually mandatory, affirming the loyalty of the takers, such as to a government, ruler, constitution, or set of principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loyalty oaths"@en .

aat:300256179 a skos:Concept ;
    skos:definition "Wallet-sized cards that those registered for the United States draft are by law required to keep in their personal possession at all times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draft cards"@en .

aat:300256192 a skos:Concept ;
    skos:definition "Short poems or prose compositions in which text is arranged so that the last letters of each line form a word, phrase, or motto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telestichs"@en .

aat:300256195 a skos:Concept ;
    skos:definition "Short poems or prose compositions in which text is arranged so that letters other than the first or last in each line form another word, phrase, or motto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mesostichs"@en .

aat:300256198 a skos:Concept ;
    skos:definition "Short poems or prose compositions in which text is arranged so that the first letters of each line form a word, phrase, or motto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrostics"@en .

aat:300256200 a skos:Concept ;
    skos:definition "Unpublished works, including documents not formally published or commerically available, including reports, internal organizational paperwork, or theses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grey literature"@en .

aat:300256210 a skos:Concept ;
    skos:definition "Bindings that combine two or more books into a single unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compound bindings"@en .

aat:300256213 a skos:Concept ;
    skos:definition "Transmission of energy, in the form of heat, sound, or electricity, through a conductor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conduction"@en .

aat:300256220 a skos:Concept ;
    skos:definition "Refers to the dissipation of energy in motion of any type, especially oscillatory motion, and the consequent reduction or decay of the motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damping"@en .

aat:300256226 a skos:Concept ;
    skos:definition "A very soft mineral, composed of silver chloride, ranging in color from a white to pale-yellow or gray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cerargyrite"@en .

aat:300256237 a skos:Concept ;
    skos:definition "Thin sheet of superimposed layers of plastic bonded or impregnated with resin and compressed under heat. Distinguished from \"plastic laminate\" which is used for resin-impregnated materials, such as paper or fabric, produced under heat and high pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laminated plastic"@en .

aat:300256240 a skos:Concept ;
    skos:definition "Refers to the reduction in amplitude, density, or energy, resulting from such effects as absorption, friction, scattering, or thinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attenuation"@en .

aat:300256245 a skos:Concept ;
    skos:definition "Reduction or decrease in number, size, or strength, also wearing down, often by rubbing or friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attrition"@en .

aat:300256248 a skos:Concept ;
    skos:definition "Solemn promises, usually in writing and signed, to do or refrain from doing something, such as to support or contribute towards a cause, fund or allegiance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pledges"@en .

aat:300256249 a skos:Concept ;
    skos:definition "Use to describe objects which, in contact with another surface, move tangentially in a smooth, continuous, gliding motion by means of gravity or momentum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding"@en .

aat:300256252 a skos:Concept ;
    skos:definition "Use to describe objects designed to be easily carried or conveyed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable"@en .

aat:300256257 a skos:Concept ;
    skos:definition "General term for a material that has the ability to take up another material without any chemical bonding, or that takes up energy. Examples include materials that take up and dissipate radiated energy, or a material that takes up moisture or odor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absorber"@en .

aat:300256266 a skos:Concept ;
    skos:definition "Any substance that absorbs ultraviolet radiant energy then dissipates the energy in a harmless form; used in plastics and rubbers to decrease light sensitivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet absorber"@en .

aat:300256273 a skos:Concept ;
    skos:definition "The art or practice of the accurate graphic delineation of the natural and man-made surface features of a specific urban area, tract of land, or other place, especially so as to show their relative positions and elevations. For the relief features or surface configurations of a place or object, including its natural and man-made features, use \"topography (attribute).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topography"@en .

aat:300256285 a skos:Concept ;
    skos:definition "Official reports or statements submitted by military officers to their superiors, especially those accounting for personnel, property, or supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "returns"@en .

aat:300256291 a skos:Concept ;
    skos:definition "Thin stuffed cushions put between a saddle and a horse's back when riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle pads"@en .

aat:300256296 a skos:Concept ;
    skos:definition "Blankets, often woolen, placed between a saddle and a horse's back when riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle blankets"@en .

aat:300256305 a skos:Concept ;
    skos:definition "Ribbons attached to books, used for for marking a place by insertion between the leaves. Distinguished from \"bookmarks,\" which are unattached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registers"@en .

aat:300256320 a skos:Concept ;
    skos:definition "Devices with a hole over which a sharp, thin blade moves to cut the top of a cigar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar cutters"@en .

aat:300256325 a skos:Concept ;
    skos:definition "Rings, historically made of ivory or bone, now usually of plastic, used by infants to chew on when teething."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teething rings"@en .

aat:300256329 a skos:Concept ;
    skos:definition "Pulleys consisting of a grooved wheel in a frame, held in a frame and used to suspend and move the heddles on a loom. Examples are on African double-heddle looms, where the frames may be elaborately carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heddle pulleys"@en .

aat:300256336 a skos:Concept ;
    skos:definition "Furnishings designed as movable, temporary, compact, or capable of being dismantled and re-assembled elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable furniture"@en .

aat:300256337 a skos:Concept ;
    skos:definition "Members of a family containing about 320 species of small, often brightly colored birds native to the Americas. They have compact, strongly muscled bodies and rather long, bladelike wings that, unlike the wings of other birds, connect to the body only from the shoulder joint, allowing them to flap them very fast to hover in mid-air (creating a humming sound) and to fly straight up, down, sideways, and backwards; their bill is typically long and slender, adapted for securing nectar from certain types of flowers; some of the species represent the smallest living bird and are among the smallest of warm-blooded vertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trochilidae"@en .

aat:300256340 a skos:Concept ;
    skos:definition "Members of a domesticated species of South American ruminant quadruped that is closely allied to the camel, but smaller, humpless, and woolly-haired; used as a beast of burden in the Andes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lama glama"@en .

aat:300256345 a skos:Concept ;
    skos:definition "The last text versions of documents or other written works as they come from the authors or editors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "final drafts"@en .

aat:300256352 a skos:Concept ;
    skos:definition "Corporations originally formed for the purpose of exercising the functions of a trustee, such as managing property for the benefit of other organizations or individuals, now usually engaging in other financial activities as well, such as banking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trust companies"@en .

aat:300256366 a skos:Concept ;
    skos:definition "Business enterprises, including private companies and those owned by nations or international organizations, that gather, write, and supply news reports and photographs fom around the world or a nation to newspapers, magazines, radio and television broadcasters, government agencies and other users who subscribe to their services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "news agencies"@en .

aat:300256375 a skos:Concept ;
    skos:definition "News agencies that distribute news reports and photographs to subscribers by telecommunications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire services"@en .

aat:300256385 a skos:Concept ;
    skos:definition "Purchasing by prepayment a series of objects, events, or services, such as a specified number of issues of a serial publication, a concert series, or cable television."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subscription"@en .

aat:300256391 a skos:Concept ;
    skos:definition "The original or classic flageolets developed in France in the 16th century, featuring a narrow conical bore contracting slightly toward the foot, and commonly four fingerholes at the front and two thumbholes at the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French flageolets"@en .

aat:300256394 a skos:Concept ;
    skos:definition "Double duct-flute developed by William Bainbridge of London in the early 19th century, featuring six, occasionally seven, fingerholes on each side, and one or no thumbholes. It allowed the player to play in two-part harmony with one hand on each duct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English flageolets"@en .

aat:300256404 a skos:Concept ;
    skos:definition "Placards carried or otherwise displayed by people engaged in picketing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picket signs"@en .

aat:300256418 a skos:Concept ;
    skos:definition "In Byzantine or Greek Orthodox monasteries, principle churches with a baptistry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "katholika"@en .

aat:300256434 a skos:Concept ;
    skos:definition "Structures of varying forms in gardens or parks designed to provide cool shady places of relaxation or retreats from summer heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summerhouses"@en .

aat:300256464 a skos:Concept ;
    skos:definition "Photography providing evidence that can be admitted in a court of law and that has been produced according to strict technical requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forensic photography"@en .

aat:300256470 a skos:Concept ;
    skos:definition "Photographs that can be used as legal evidence in a court of law; produced according to strict technical requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forensic photographs"@en .

aat:300256475 a skos:Concept ;
    skos:definition "Identification of a group of people as distinct from other groups on the basis of physical or socially defined characteristics, such as the color of skin, language, nationality, ethnic group, or a combination of multiple characteristics. More recently race has been considered an obsolete or non-scientific system of classification though it is widely and commonly used for categorization still in contexts such as a census."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "race"@en .

aat:300256479 a skos:Concept ;
    skos:definition "Theory or method that seeks to humanize modern architecture by moving away from global uniformity and unquestioning reliance on technology, favoring instead solutions drawing on regional traditions and materials, while at the same time maintaining awareness of the universal nature of contemporary culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "critical regionalism"@en .

aat:300256483 a skos:Concept ;
    skos:definition "The geographical areas that can be seen from a particular place or the areas from which a particular feature can be seen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viewsheds"@en .

aat:300256485 a skos:Concept ;
    skos:definition "Culturally imposed prohibitions often supported by supernatural authority, which, if violated, result in punishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taboo"@en .

aat:300256491 a skos:Concept ;
    skos:definition "Documents or books containing the legal customs or customary laws of a locality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "customaries"@en .

aat:300256494 a skos:Concept ;
    skos:definition "The set or aggregate of words or phrases used by or known to a particular people, group, or used by a particular field or discipline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocabulary"@en .

aat:300256501 a skos:Concept ;
    skos:definition "Series of representations of the Passion of Christ, usually beginning with the Entry into Jerusalem and ending with the Descent of the Holy Ghost at Pentacost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passion cycles"@en .

aat:300256514 a skos:Concept ;
    skos:definition "Documents showing the dates of Easter and the movable feasts associated with it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Easter tables"@en .

aat:300256521 a skos:Concept ;
    skos:definition "Images believed to possess supernatural powers or abilities such as healing, moving, or secreting substances resembling, for example, blood or tears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miraculous images"@en .

aat:300256529 a skos:Concept ;
    skos:definition "Narratives that focus on the life and experiences of a child or young person while at school; originally set in boarding schools, more recent examples may concern day schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school stories"@en .

aat:300256571 a skos:Concept ;
    skos:definition "Partial rising of a topcoat such as a paint, solvent, or varnish layer, due to the break in adhesion to the undercoat or surface layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifting"@en .

aat:300256578 a skos:Concept ;
    skos:definition "Highly intricate tape lace that originated in Germany from about 1893 onward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Battenberg lace"@en .

aat:300256582 a skos:Concept ;
    skos:definition "Cloth made from the fibers extracted from sheaths of the banana tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banana-fiber cloth"@en .

aat:300256591 a skos:Concept ;
    skos:definition "Building boats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boatbuilding"@en .

aat:300256593 a skos:Concept ;
    skos:definition "Coarse, strong linen or cotton twill in various weights and with a warp face; used for durable clothing and furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drill"@en .

aat:300256600 a skos:Concept ;
    skos:definition "Textiles woven in different colored yarns to produce a multicolored crossed-linear pattern, often of woolen or worsted twill. Although the type of textile pattern existed in many early cultures, among the best known are the Scottish tartans, for which distinctive designs and colors signified a Highland clan and were worn only by members of that clan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tartan"@en .

aat:300256611 a skos:Concept ;
    skos:definition "Meshed textile made of sheer silk, nylon, or rayon with a hexagonal mesh; used for hats, veils, ballet costumes, and women's dresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tulle"@en .

aat:300256616 a skos:Concept ;
    skos:definition "Any woven figured textile produced on a Jacquard loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacquard"@en .

aat:300256621 a skos:Concept ;
    skos:definition "Art produced to have an explicit political content or purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political art"@en .

aat:300256630 a skos:Concept ;
    skos:definition "Motifs based on leaves of the oak tree, often incorporating acorns, arranged in the form of a wreath, a running ornament, or in clusters; used from antiquity, often to symbolize strength, power, or valor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oak leaf"@en .

aat:300256657 a skos:Concept ;
    skos:definition "Lightweight helmets of pith or cork covered with cloth with a round crown and fixed brim that slopes downward; worn in tropical regions as a protection against the sun. First worn by the British army in India in the mid-19th century and made with the pith of the sola plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topees"@en .

aat:300256685 a skos:Concept ;
    skos:definition "Beachwear for bathing, dating from the 19th century to present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathing costumes"@en .

aat:300256701 a skos:Concept ;
    skos:definition "Furniture, lighting, ornament, windows, and other objects that are fastened in position and form part of a public building, usually the interior, but are not an integral part of the architecture itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public building fixtures"@en .

aat:300256702 a skos:Concept ;
    skos:definition "Venetian wall mirrors of the first half of the 16th century that usually also have a shelf and pegs; frequently ornately carved and may be gilded or painted; used primarily in bedrooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restelli"@en .

aat:300256704 a skos:Concept ;
    skos:definition "Lustrous silk textile sometimes interwoven with gold or silver thread, used especially for costume worn by ecclesiastics and nobles, during the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samite"@en .

aat:300256706 a skos:Concept ;
    skos:definition "Regulated, formal dress for presentation to the monarch and courtly functions, including costume and the accessories required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court dress"@en .

aat:300256710 a skos:Concept ;
    skos:definition "Straps passed across the forehead or chest and secured to a bundle to help support a load carried on a person's back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumplines"@en .

aat:300256716 a skos:Concept ;
    skos:definition "Headcloths worn instead of hats for warmth or concealment of the head or face, either where the length of the scarf exceeds the width, or a square scarf that is folded in a triangle and tied under the chin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headscarves"@en .

aat:300256721 a skos:Concept ;
    skos:definition "Hooded pullover hip-length garments made of weather-resistant material often with zipper closure at neck and drawstring hem; may be lined and have a front-center pocket; worn for sports. For hooded jackets or pullover garments reaching to the thighs or knees made of skins or hides or water-repellent or windproof fabric, use \"parkas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anoraks"@en .

aat:300256738 a skos:Concept ;
    skos:definition "Black cloth hats in bicorne shape made to resemble a bull's head, worn by matadors at a bullfight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monteras"@en .

aat:300256744 a skos:Concept ;
    skos:definition "Having an outline or form that is higher than it is wide, swelling symetrically outward at or near the middle and narrowing at top and bottom, resembling the contours of a vase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vase-shaped"@en .

aat:300256756 a skos:Concept ;
    skos:definition "Refers to popular utilitarian 18th-century earthenware that has inscriptions as part of the decoration, the name from the French for \"talking faience.\" Much of this ware was produced at Nevers, France, and the items are principally plates, jugs, and bowls. The inscriptions include the names of the owner, coats of arms, Masonic symbols, references to poetry, songs, or proverbs, commemorations of birthdays or anniversaries, or other themes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faïence parlante"@en .

aat:300256757 a skos:Concept ;
    skos:definition "A type of faïence parlante, generally plates and jugs, that features inscriptions and depictions of the French Revolution, its ideology, or other national political events. The first examples appeared around 1745 and featured the Royalist fleur-de-lis. Republican themes soon appeared, including the Phrygian cap, the Gallic cock, plows, oak trees, draped flags, the Bastille, and slogans and scenes related to liberty, the rights of man, the Third Estate, and agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faïence patronymique"@en .

aat:300256762 a skos:Concept ;
    skos:definition "Formal ceremonious introductions of a person to an assembly or to another person, especially of superior rank, such as a head of state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentations"@en .

aat:300256778 a skos:Concept ;
    skos:definition "Cutaways of the late 1830s to 1850 with short rounded tails, the front sloping sharply from above the waist downward to the thighs in back, single- or double-breasted, often with flapped pockets; worn for riding or as a suit coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Newmarket coats"@en .

aat:300256786 a skos:Concept ;
    skos:definition "Cutaways worn from 1825 to the 1870s, made with pockets and the front slanting from the waist in front and curving downward to the thigh in back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding coats"@en .

aat:300256793 a skos:Concept ;
    skos:definition "Rectangular frameworks usually made of wood or aluminum designed to be worn on a person's back to support a burden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pack frames"@en .

aat:300256798 a skos:Concept ;
    skos:definition "Bags without handle or strap, but usually with a clasp, of a size that is suitable to be carried in the hand; made of various fabrics or leathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clutch bags"@en .

aat:300256804 a skos:Concept ;
    skos:definition "Clutch bags with a fold-over flap, of leather or other materials; made to resemble an envelope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "envelope bags"@en .

aat:300256813 a skos:Concept ;
    skos:definition "Play and sports outfits made for women and children, often consisting of a one-piece suit combining shorts and shirt and an overskirt; introduced in the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playsuits"@en .

aat:300256819 a skos:Concept ;
    skos:definition "Trousers cut wide around the thighs and then tightly fitted from just above the knees to the calves; worn by men and women for horseback riding. For trousers cut full over hips and thighs and extending to the ankles, use \"jodhpurs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding breeches"@en .

aat:300256825 a skos:Concept ;
    skos:definition "Documents issued to freed slaves, attesting to their status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free papers"@en .

aat:300256830 a skos:Concept ;
    skos:definition "Bands made of a variety of materials, worn around the wrist as ornament or for protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wristlets"@en .

aat:300256833 a skos:Concept ;
    skos:definition "Hollow devices used to intensify and direct the sound of a voice, usually, though not always, taking the shape of a long cone with a small hole at one end through which the user speaks, and a much wider opening at the other from which the sound emerges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megaphones"@en .

aat:300256839 a skos:Concept ;
    skos:definition "Trumpet-shaped megaphones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speaking trumpets"@en .

aat:300256847 a skos:Concept ;
    skos:definition "Refers to groups of archaeological artifacts found in association with each other, as from one level, activity area, or site, regardless of their material or type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assemblages"@en .

aat:300256869 a skos:Concept ;
    skos:definition "Small self-contained systems with a platform that rises vertically, usually only one story or less, to transport a wheelchair or merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform lifts"@en .

aat:300256877 a skos:Concept ;
    skos:definition "Images, usually of the surface of the earth, created using satellites equipped with cameras or other imaging equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite imagery"@en .

aat:300256881 a skos:Concept ;
    skos:definition "Refers to the ratio of the permissable total floor area of a building on a zoning lot to the total area of the lot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor area ratios"@en .

aat:300256888 a skos:Concept ;
    skos:definition "Various interactive computer games in which a player controls electronically generated images on a video display screen; usually restricted to those written after the late 1970s for microcomputers, arcade systems, or dedicated consoles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video games"@en .

aat:300256895 a skos:Concept ;
    skos:definition "Covered defensive works extending into or across ditches of a fortification to shelter communication with other outworks or to facilitate flanking fire across the ditches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caponiers"@en .

aat:300256897 a skos:Concept ;
    skos:definition "Concrete structures of various forms, usually including a concrete dish linked to microphones, acting as early warning systems to detect and transmit the sound of incoming zeppelins; installed along the English coast facing Europe during the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound mirrors"@en .

aat:300256906 a skos:Concept ;
    skos:definition "Painting styles belonging to Nubian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nubian painting styles"@en .

aat:300256907 a skos:Concept ;
    skos:definition "Painting styles belonging to Christian Nubian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian Nubian painting styles"@en .

aat:300256909 a skos:Concept ;
    skos:definition "Style of Nubian fresco and panel painting that, among other stylistic characteristics, makes great use of the colors violet and steel gray, dating from the early 8th century until the mid-9th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Violet Style"@en .

aat:300256912 a skos:Concept ;
    skos:definition "Refers to the exhaust ducts or pipes connecting furnaces or boilers to smokestacks or chimneys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breechings"@en .

aat:300256941 a skos:Concept ;
    skos:definition "Devices made of buoyant materials, tied onto a line or net when fishing to gauge the depth of the fishhook or net."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing floats"@en .

aat:300256974 a skos:Concept ;
    skos:definition "Short sticks used in pairs for harvesting wild rice. An example of usage was by Great Lakes Indians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ricing sticks"@en .

aat:300256986 a skos:Concept ;
    skos:definition "A pen point is the tip of a pen that touches the writing surface and distributes ink from a reservoir in the pen or adhering to the tip itself. The design may vary, including a simple tip, a split tip, a ball point, a stylograph, or another design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen points"@en .

aat:300256998 a skos:Concept ;
    skos:definition "Describes the surface of the leather from which the outer layer of hair and epidermis is removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain side"@en .

aat:300257010 a skos:Concept ;
    skos:definition "Describes the surface of the leather from which the inner subcutaneous flesh and fat have been removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flesh side"@en .

aat:300257024 a skos:Concept ;
    skos:definition "Leather made from the skin of a ray fish and characterized by a covering of pearl-like papillae usually ground flat leaving a pattern of tiny contiguous circles which are further emphasized by dyeing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galuchat"@en .

aat:300257043 a skos:Concept ;
    skos:definition "High-temperature kilns used for firing the body and glaze of porcelain, or tin-enamel ware decorated with high-temperature colors. The temperature ranges from about 1100 to 1450 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand feus"@en .

aat:300257050 a skos:Concept ;
    skos:definition "The quality or state of being hidden or concealed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secrecy"@en .

aat:300257052 a skos:Concept ;
    skos:definition "Those characteristics or conditions of a thing, person, or group that remain the same amid change or that distinguish a thing, person, or group from another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "identity"@en .

aat:300257053 a skos:Concept ;
    skos:definition "Symbols, often objects such as skulls or hourglasses, but sometimes written inscriptions, intended to remind the viewer of death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memento mori"@en .

aat:300257055 a skos:Concept ;
    skos:definition "Property in the form of assets having no physical substance as for example, the goodwill of a business or patent rights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intangibles"@en .

aat:300257065 a skos:Concept ;
    skos:definition "Books designed to teach spelling; often employing lists of selected words and sometimes including exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spelling books"@en .

aat:300257069 a skos:Concept ;
    skos:definition "Songs or soothing refrains sung or chanted, usually to children, to quiet or lull the listener to sleep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lullabies"@en .

aat:300257076 a skos:Concept ;
    skos:definition "Goras of the Southern Sotho people of southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lesibas"@en .

aat:300257080 a skos:Concept ;
    skos:definition "Objects relating to Jewish life, religion, and culture, especially but not limited to those of a literary, historic, or artistic nature, or pertaining to ritual. For individual types of items, see appropriate hierarchies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Judaica"@en .

aat:300257092 a skos:Concept ;
    skos:definition "Ancient excavations consisting of a shaft sunk into chalk formations and at the bottom widening out horizontally into one or more chambers; found in Essex and Kent, England, and the valley of the Somme River, France; age and purpose are unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deneholes"@en .

aat:300257101 a skos:Concept ;
    skos:definition "Small sculptures, usually of soapstone or steatite, of humans, animals, or monsters, generally three inches to six inches high, from Sierra Leone, Guinea, and Liberia, West Africa, and of unknown date, probably the 7th to the 14th century; may have been ancestor figures, but now used as spirit representations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nomoli"@en .

aat:300257104 a skos:Concept ;
    skos:definition "Use primarily in anthropological and archaeological contexts for small, scattered, seasonal or temporary settlements, usually places of shelter or lodging, often associated with specific activities, and generally having no permanent architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camps"@en .

aat:300257115 a skos:Concept ;
    skos:definition "Books that tell one or more stories entirely through pictures without text, including both books intended for children and those with adult fictional subject matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stories without words"@en .

aat:300257138 a skos:Concept ;
    skos:definition "Women's suits worn for walking and other similar physical activities, dating from around 1900, usually consisting of a coat or jacket and long skirt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking suits"@en .

aat:300257145 a skos:Concept ;
    skos:definition "General term for fish of various species in various orders that live in mud, whether marine, estuarine, or freshwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mudfishes"@en .

aat:300257149 a skos:Concept ;
    skos:definition "Shelves or ledges above and behind Christian altars, on which the altar cross, altar candlesticks, reliquaries, and similar liturgical objects may be placed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gradines"@en .

aat:300257158 a skos:Concept ;
    skos:definition "Lines for catching fish, varying in diameter and weight depending on the fish sought and the method of angling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing lines"@en .

aat:300257169 a skos:Concept ;
    skos:definition "Pistols for launching and igniting flares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flare pistols"@en .

aat:300257189 a skos:Concept ;
    skos:definition "Use generally for devices that expel a material or object from one area and discharge it into another area. Use specifically in civil engineering for pumps that elevate sewage from a lower sewer into a main disposal system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ejectors"@en .

aat:300257199 a skos:Concept ;
    skos:definition "Equipment for the recording, transmission, reproduction, and amplification of sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audio equipment"@en .

aat:300257224 a skos:Concept ;
    skos:definition "Simple books with sturdy cardboard pages often laminated for protection, intended for very young children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board books"@en .

aat:300257228 a skos:Concept ;
    skos:definition "Simple books designed to teach counting and numbers to young children, often employing colorful pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counting books"@en .

aat:300257232 a skos:Concept ;
    skos:definition "The process of augmenting the contents of an individual book by adding prints, engravings, letters, or other documents after publication, often resulting in its rebinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extra-illustration"@en .

aat:300257245 a skos:Concept ;
    skos:definition "Enclosing borders. In bookbinding and printing contexts made up of separate elements showing no evidence of having been designed to function together as a border. Distinguished from \"compartments\" which are decorative borders created as single design units enclosing the letterpress of a title page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frames"@en .

aat:300257252 a skos:Concept ;
    skos:definition "Artists with no formal training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-taught artists"@en .

aat:300257272 a skos:Concept ;
    skos:definition "Decorative motif consisting of tripartite, splayed lobes created by notches at the end of the flattened handles of spoons and forks; found especially on flatware of the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trifid"@en .

aat:300257285 a skos:Concept ;
    skos:definition "Refers to the variant stages of development of graphic and textual works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state"@en .

aat:300257328 a skos:Concept ;
    skos:definition "General term for symbols, sounds, or gestures devised according to a system and used to represent something else. An example is in translating a piece of information in a source language, such as a symbol, letter, word, or phrase, into a target language according to a strict rule, in order to achieve some purpose, such as disguising the message or facilitating its transmission or reception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codes"@en .

aat:300257352 a skos:Concept ;
    skos:definition "Cables used in telephone systems to transmit voice or data via electrical impulses; usually made of copper, steel, or glass wire encased in rubber or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephone wires"@en .

aat:300257358 a skos:Concept ;
    skos:definition "Small crucibles used for cupellation, made of a porous, refractory material such as bone ash and used to melt small amounts of metal, usually silver, for the extraction of lead, or gold, for assaying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupels"@en .

aat:300257360 a skos:Concept ;
    skos:definition "Refers to earthenware decorated in a freehand manner with raised clay slip designs. The slip may be applied through slip trailing or piping. The technique was first employed on Rhenish pottery prior to the 3rd century BCE, replacing molded decoration. The slip was applied by piping to decorate the edges of flat dishes with small flowers and other designs. The technique was again used in the mid- and late 1800s, but it was not popular because firing difficulties caused the slip to flake off easily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barbotine"@en .

aat:300257363 a skos:Concept ;
    skos:definition "Cloth coverings of various materials cut to cover a horse's body from around the withers to the rump and, in front, around the chest; used to protect a horse or discourage growth of a heavy coat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse blankets"@en .

aat:300257370 a skos:Concept ;
    skos:definition "Leaves with the unopened folds at the fore edges and the interior pages blank; often found in Traditional format books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double leaves"@en .

aat:300257411 a skos:Concept ;
    skos:definition "Shapes, forms, or figures cut from, or intended to be cut from, pieces of material such as paper, cardboard, wood, or cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutouts"@en .

aat:300257427 a skos:Concept ;
    skos:definition "Codes used specifically to disguise the content of a message, involving a rule defined by a secret key known only to the transmitters and legitimate receivers of the message."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciphers"@en .

aat:300257437 a skos:Concept ;
    skos:definition "Unique marks stamped in ink on the unsigned prints and drawings remaining in an artist's studio after her or his death, to legally authenticate them as works of the artist, in preparation for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estate stamps"@en .

aat:300257450 a skos:Concept ;
    skos:definition "Use to describe artifacts fabricated primarily by machine, usually to distinguish from those made by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine-made"@en .

aat:300257455 a skos:Concept ;
    skos:definition "Condition of fabrication for items having a predetermined design, but where the items are tailored for an individual's request; usually made in quantity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "made-to-order"@en .

aat:300257459 a skos:Concept ;
    skos:definition "Sewing by hand, as distinct from sewing by machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand sewing"@en .

aat:300257463 a skos:Concept ;
    skos:definition "Sewing by machine, as distinct from sewing by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine sewing"@en .

aat:300257479 a skos:Concept ;
    skos:definition "Receptacles in the shape of a tower, located near Christian altars, for the reserve of the Eucharist; may also be set on top of altarpieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacrament towers"@en .

aat:300257487 a skos:Concept ;
    skos:definition "Containers for the eucharist that are suspended above the altar; they may also hang from a ciborium (structure), an altar canopy, an altarpiece, or a reredos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging pyxes"@en .

aat:300257490 a skos:Concept ;
    skos:definition "Posts, often fitted with horizontal rods, that enclose the ends of Christian altars, from which curtains are hung. The riddel posts may be surmounted by candleholders or sculptures of angels with instruments of the Passion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riddel posts"@en .

aat:300257495 a skos:Concept ;
    skos:definition "Cranes used to lift and move font covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "font cranes"@en .

aat:300257514 a skos:Concept ;
    skos:definition "Gathering cloth by drawing it together with duplicated rows of alternating short and long stitches, to produce even parallel folds; used especially in women's dresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gauging"@en .

aat:300257519 a skos:Concept ;
    skos:definition "Collectively, the items for the bed and table made of linen or other similar fabrics; may also be used for clothing made of linen from the Medieval period through the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linens"@en .

aat:300257524 a skos:Concept ;
    skos:definition "Full-length or three-quarter-length overcoats, usually made of fine fabrics, worn for formal or semiformal occasions; popular especially during the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening coats"@en .

aat:300257532 a skos:Concept ;
    skos:definition "Insulated boxes in which milk bottles or cartons are left in home delivery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porch boxes"@en .

aat:300257537 a skos:Concept ;
    skos:definition "Contemporary technique of applying one piece of colored or clear glass onto another using a clear adhesive such as epoxy; technique may involve multiple layers of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass appliqué"@en .

aat:300257544 a skos:Concept ;
    skos:definition "Pull-on, loose-fitting, fairly short shorts, usually with an elastic waistband."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "athletic shorts"@en .

aat:300257552 a skos:Concept ;
    skos:definition "One-piece, tight-fitting main garments that extend from neck to ankles or feet, usually made of knitted material; designed for everyday wear rather than for physical activities; dating from the second half of the 20th century. Distinguished from \"leotards,\" which are designed for physical activities such as by acrobats and dancers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cat suits"@en .

aat:300257558 a skos:Concept ;
    skos:definition "Supports consisting of a base, a short shaft, and a top, on which wigs are placed when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wig stands"@en .

aat:300257566 a skos:Concept ;
    skos:definition "In Scotland, a pair of straps or pieces of string tied around the leg just below the knee to secure the trousers of farmworkers; used to keep the bottom of trousers lifted clear of dirt to keep them clean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nicky-tams"@en .

aat:300257582 a skos:Concept ;
    skos:definition "The process of removing gathered matter from a binding in preparation for rebinding usually involving removal of covers, spine lining, and old glue, cutting the sewing threads, and separating all sections from each other. Where a discrete bibliographic item has been removed from a binding with the intention that it should stand alone thereafter, use \"disbinding.\" To describe gathered matter that has never been bound, but rather left in sheets, signatures, or gatherings, use \"unbound.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulling"@en .

aat:300257591 a skos:Concept ;
    skos:definition "Uniform bindings produced wholesale and in quantity (often machine-made case bindings), applied to books expected to sell rapidly and in quantity; used from the mid-18th century onwards; distinguished from small quantity \"trade bindings,\" which are simple bindings of sheep or calf commissioned by booksellers from the 15th to the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edition bindings"@en .

aat:300257592 a skos:Concept ;
    skos:definition "Describes gathered matter collated but never bound, such as items left in sheets, gatherings, or signatures. To describe gathered matter that has been removed from its binding in preparation for rebinding, use \"pulled\" (alternate of \"pulling.)\" To describe sections of gathered matter from a composite volume that have been removed to stand alone thereafter, use \"disbound\" (alternate of \"disbinding\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unbound"@en .

aat:300257594 a skos:Concept ;
    skos:definition "The process of removing sections of gathered matter from within a binding with the intention that they stand alone thereafter. Where the gathered matter has been removed from the binding in preparation for rebinding in a different form, use \"pulling (dismantling).\" Where the gathered matter has been collated but never bound, for example a book in sheets, signatures, or gatherings, use \"unbound.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disbinding"@en .

aat:300257608 a skos:Concept ;
    skos:definition "Simple bindings in sheep or calf, rarely lettered, commissioned in small quantities by booksellers from the 15th to the 18th century. Distinguished from uniform \"edition bindings\" produced wholesale, (often machine-made case bindings), applied in quantity to books expected to sell rapidly and in quantity, from the mid-18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade bindings"@en .

aat:300257611 a skos:Concept ;
    skos:definition "Marking the surface of an object by pressing onto it, by means of a machine such as a printing press, a block, plate, or frame containing the elements that make up the printing surface, often having a raised design. In bookbinding, distinguished from \"stamping (marking)\", in which a hand tool is used instead of a machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blocking"@en .

aat:300257617 a skos:Concept ;
    skos:definition "Blocking without the use of gold leaf, silver leaf, or color, usually involving a heated block or frame. In bookbinding, distinguished from \"blind stamping\" in which a hand tool is used instead of a machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind blocking"@en .

aat:300257623 a skos:Concept ;
    skos:definition "Blocking that leaves a pattern of gold on a surface, usually involving the use of a heated block or frame which is pressed on gold leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold blocking"@en .

aat:300257631 a skos:Concept ;
    skos:definition "Designs, often arabesques, used to ornament the corners of the covers of books generally for the purpose of matching a centerpiece or other form of decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornerpieces"@en .

aat:300257640 a skos:Concept ;
    skos:definition "Shore complexes to which whales are taken for processing, consisting of processing facilities and quarters for the workers. For the watercraft used in the processing of whales at sea, use \"factory ships.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whaling stations"@en .

aat:300257647 a skos:Concept ;
    skos:definition "Objects designed to attract fish for capture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing lures"@en .

aat:300257653 a skos:Concept ;
    skos:definition "Objects in the form of a fish, designed to attract other fish for capture by the harpoon, spear, or leister of ice fishermen. Unlike a fishing lure, a fish decoy doesn't have a hook attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish decoys"@en .

aat:300257656 a skos:Concept ;
    skos:definition "Artificial channels carrying water away from waterwheels, turbines, or similar hydraulically operated machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tailraces"@en .

aat:300257666 a skos:Concept ;
    skos:definition "Visual time signals, generally including a ball that is mounted on a tall pole or rod set up on a tower or other prominent location and that is arranged to drop suddenly at a predetermined moment, such as noontime; used, for example, by ships at anchor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time balls"@en .

aat:300257674 a skos:Concept ;
    skos:definition "Areas defined by a line or narrow tract of land that separates the waters flowing into different rivers, river basins, or seas. For the areas drained by a river system, use \"drainage basins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watersheds"@en .

aat:300257678 a skos:Concept ;
    skos:definition "General term for various types of small openings with a grate or door, set within larger ones, including wickets set into doors, gates, or windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wickets"@en .

aat:300257688 a skos:Concept ;
    skos:definition "Specific specimens of a given written or printed work; may be issued in multiples as an edition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copies"@en .

aat:300257689 a skos:Concept ;
    skos:definition "Full-service medical accommodations within a hotel-like environment to which patients are transferred to free up surgical units in hospitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patient hotels"@en .

aat:300257697 a skos:Concept ;
    skos:definition "Refers to the style and culture of the ancient Samnites, who were related to the Sabines, spoke Oscan, occupied the mountainous center of southern Italy and some coastal areas, and battled the Romans for control of the area in a series of three wars during the fourth and third centuries BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samnite"@en .

aat:300257702 a skos:Concept ;
    skos:definition "Firefighting vehicles in which water pumps are steam-engine driven; generally replaced hand pumpers after the mid-19th century; originally horse drawn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam pumpers"@en .

aat:300257719 a skos:Concept ;
    skos:definition "Building panels consisting of two high-density outer sheets, usually plywood, hardwood, or metal, bonded to a lightweight core material, often plastic foam, rubber, or honeycombed paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich panels"@en .

aat:300257723 a skos:Concept ;
    skos:definition "Sandwich panels that provide insulation, generally from a rigid foam core, and structural stability, making them suitable as complete wall, floor, or roof units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural insulated panels"@en .

aat:300257729 a skos:Concept ;
    skos:definition "Built works that provide shelter and accomodations for the basic physical functions of life for an individual or family; may also include spaces for dependents animals. Among the functions provided for are a place to sleep, prepare food, eat, and sometimes to work, usually having doors, windows, or other sources of light and with protection from the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "residential structures"@en .

aat:300257735 a skos:Concept ;
    skos:definition "Racks for holding or storing small arms; may be freestanding or attached to something else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun racks"@en .

aat:300257751 a skos:Concept ;
    skos:definition "Traditional Hawaiian residential structures set aside as eating places for women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hale 'aina"@en .

aat:300257756 a skos:Concept ;
    skos:definition "Traditional Hawaiian residential structures set aside for making tapa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hale kua"@en .

aat:300257764 a skos:Concept ;
    skos:definition "Traditional Hawaiian houses where the wife lives and where the family comes together and may sleep; not taboo to the husband."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hale noa"@en .

aat:300257766 a skos:Concept ;
    skos:definition "Traditional Hawaiian residential structures to which women of a household retire during menstruation; often containing a shrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hale pe'a"@en .

aat:300257777 a skos:Concept ;
    skos:definition "Traditional Hawaiian residential structures set aside as eating places for men; often containing the family shrine; taboo to women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mua"@en .

aat:300257908 a skos:Concept ;
    skos:definition "Plates, usually of metal, placed on doors, usually of houses, apartments, or rooms, bearing the occupant's name or other identifiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door plates"@en .

aat:300257917 a skos:Concept ;
    skos:definition "Flush escutcheons for one or more keyholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key plates"@en .

aat:300258325 a skos:Concept ;
    skos:definition "Bill- or coin-operated machines that automatically play pre-recorded music, furnished with a variety of recordings for listener selection, housed in cabinets that are often colorfully illuminated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jukeboxes"@en .

aat:300258332 a skos:Concept ;
    skos:definition "Relatively small classes for advanced students taught by a person of distinguished expertise, usually also involving practical demonstration and exercises in the skill being taught; especially common in the performing arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master classes"@en .

aat:300258340 a skos:Concept ;
    skos:definition "Any organized body of ideas and attitudes, especially about the structure and working of human society, that comprehends a program of practical political and social action and is more or less institutionalized or shared with others. Originally used for a branch of knowledge dealing with the history and nature of ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ideology"@en .

aat:300258346 a skos:Concept ;
    skos:definition "Intervention in a dispute, especially between labor and management, by a neutral party who facilitates negotiations, examines the arguments of both sides, and proposes a solution, which, however, is not binding on the disputants. Distinguished from \"arbitration\" in which the neutral party has the authority to make a binding decision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mediation"@en .

aat:300258351 a skos:Concept ;
    skos:definition "Companies controlled by another company that owns more than 50% of its voting shares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subsidiaries"@en .

aat:300258362 a skos:Concept ;
    skos:definition "Companies that own or control other companies, usually through owning a controlling portion of their stock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parent companies"@en .

aat:300258363 a skos:Concept ;
    skos:definition "Parent companies whose activities are confined to owning stock in and supervising the financial, managerial, or marketing functions of their subsidiaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holding companies"@en .

aat:300258380 a skos:Concept ;
    skos:definition "Sudden headlong rushes or flights of herds of animals, especially cattle and horses, usually due to fright."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stampedes"@en .

aat:300258385 a skos:Concept ;
    skos:definition "Members of a family of 14 genera and about 55 species of tropical birds with a distinguishing bony casque, or helmet, surmounting their prominent bill, which is supported by powerful neck muscles and fused vertebrae. The large bill assists in fighting, preening, constructing nests, and catching prey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bucerotidae"@en .

aat:300258388 a skos:Concept ;
    skos:definition "Members of a family of African birds comprising 7-10 species of fowl having a long neck with a hackle of long lance-shaped feathers, striped black, white, and blue, and a vulture-like bare blue head. In some classifications, they are placed in the pheasant family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Numididae"@en .

aat:300258393 a skos:Concept ;
    skos:definition "Species found in open and lightly forested areas of Africa. It is sparsely haired, large-headed, has black hair and a coarse mane on the back, tusks, and two pairs of bumps or warts on the face of males."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phacochoerus aethiopicus"@en .

aat:300258401 a skos:Concept ;
    skos:definition "Members of a species of large aquatic mammal inhabiting the warm coastal waters of the Indian and Pacific oceans, feeding on seagrasses; similar to the American manatee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dugong dugon"@en .

aat:300258402 a skos:Concept ;
    skos:definition "Members of a genus containing three species of large, slow aquatic mammals found along tropical and subtropical Atlantic coasts and associated inland waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trichechus"@en .

aat:300258403 a skos:Concept ;
    skos:definition "Species of thick-skinned, herbivorous, even-toed hoofed mammals having a barrel-shaped, nearly hairless body, short legs, a large head, and a huge mouth with very large incisor and canine teeth; native to Africa, living in or near rivers, lakes, and swamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippopotamus amphibius"@en .

aat:300258425 a skos:Concept ;
    skos:definition "Outlines of stories or plots, as for example of plays, ballets, operas, motion pictures, and television programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scenarios"@en .

aat:300258438 a skos:Concept ;
    skos:definition "Noblewomen in Europe and Japan, specifically those of the second rank of the nobility of various European countries, or the wives or widows of marquises, ranking immediately below duchesses and above countesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marchionesses"@en .

aat:300258446 a skos:Concept ;
    skos:definition "Mantles made of pelts, worn traditionally by peoples in southern Africa, especially by chiefs and young male initiates, and as war dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karosses"@en .

aat:300258453 a skos:Concept ;
    skos:definition "Short or long main garments consisting of panels or shields made of hides, skins, cloth, or woven fibers suspended from or near the waist with attached strings or cords; often decorated and usually indicating age or marital status. May cover the front or the back of the body; worn by women and girls in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aprons"@en .

aat:300258459 a skos:Concept ;
    skos:definition "Shield-like aprons worn by Mangbetu women of Africa to cover the buttocks; usually made of woven fibers and often decorated with geometric patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negbe"@en .

aat:300258461 a skos:Concept ;
    skos:definition "Tall military caps of fur, usually bearskin, worn primarily by European and Canadian military personnel, especially grenadiers and foot guards, from the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bearskins"@en .

aat:300258465 a skos:Concept ;
    skos:definition "Full garments reaching to the knees or ankles with sleeves or with sides that drape over the shoulders and arms; worn primarily by men in the Sahelian zone of West Africa, often over trousers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boubous"@en .

aat:300258469 a skos:Concept ;
    skos:definition "Headcloths, often of fine fabric, worn wrapped around a woman's head and usually tied on top of the head, often with ends hanging loose; worn as part of women's traditional dress in West Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headties"@en .

aat:300258478 a skos:Concept ;
    skos:definition "Articles, substances, or procedures that conceal the identity of or alter the appearance of an object or person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disguises"@en .

aat:300258480 a skos:Concept ;
    skos:definition "Implements carried to brush away flies; in a ceremonial context, especially in Africa, also serving as a symbol of high position or authority; usually made of flexible fibers mounted on a handle. For instruments used to kill insects, usually consisting of a flat piece of perforated material or wire mesh attached to a handle, use \"fly swatters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly whisks"@en .

aat:300258488 a skos:Concept ;
    skos:definition "Fighting men of ancient Rome, either professionals or slaves, captives, or condemned criminals, who fought to the death with other men or with wild animals as a form of public entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gladiators"@en .

aat:300258493 a skos:Concept ;
    skos:definition "Coating, lining, or plating with tin or tin alloy; used, for example, to imitate silver or to protect against oxidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinning"@en .

aat:300258504 a skos:Concept ;
    skos:definition "An approximation method for analyzing continuous physical systems, used in structural mechanics, electrical field theory, and fluid mechanics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finite element method"@en .

aat:300258515 a skos:Concept ;
    skos:definition "Substances formed as a result of the process of corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrosion"@en .

aat:300258519 a skos:Concept ;
    skos:definition "Refers to British noblemen of the third rank of the nobility, on the same level as Continental European counts, below dukes and marquises and above viscounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earls"@en .

aat:300258530 a skos:Concept ;
    skos:definition "Refers to judges of certain higher courts in the United States, Canada, and Great Britain, the exact levels of court varying from one jurisdiction to another, but generally including judges of the supreme courts of these countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "justices"@en .

aat:300258550 a skos:Concept ;
    skos:definition "Use to denote collectively the bars or strips of wood glued under the soundboard of many string instruments such as the lute, guitar, harpsichord, and piano, which are crucial to the tone of the instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barring"@en .

aat:300258551 a skos:Concept ;
    skos:definition "A seismic design system involving a mechanism which is installed between the ground and the base of a structure thereby reducing the impact of an earthquake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base isolation"@en .

aat:300258558 a skos:Concept ;
    skos:definition "Refers to an subclass (or \"superorder\" or \"magnorder\") containing the orders Cingulata and Pilosa, currently including 29 species among five living families. It includes the living anteaters, tree sloths, and armadillos, as well as the extinct ground sloths, glyptodonts and pampatheres. Xenarthrans were formerly grouped with pangolins and collectively referred to as edentates (a former order, Edentata), which alludes to the absence of teeth in some members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xenarthra"@en .

aat:300258565 a skos:Concept ;
    skos:definition "Members of a subclass containing around 650 species of segmented worms characterized by a small sucker, which contains the mouth at the anterior end of the body and a large sucker located at the posterior end, having a flattened body, and being aquatic or living on moist soil. A few species have been used by humans in clinical bloodletting for thousands of years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hirudinea"@en .

aat:300258570 a skos:Concept ;
    skos:definition "Members of a class containing around 10,000 species of marine worms having well-defined segmentation of the body, differentiated head with eyes, two sexes, and swimming appendages bristles, including rag worms, lugworms, bloodworms, sea mice, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polychaeta"@en .

aat:300258573 a skos:Concept ;
    skos:definition "Members of a class containing 2,100 living species of marine invertebrates having a body comprising a central round disk from which radiate five long, slender, fragile arms used for locomotion; the arms can be broken off but quickly regenerate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ophiuroidea"@en .

aat:300258581 a skos:Concept ;
    skos:definition "Men's robe-like outerwear of cotton or silk, usually heavily embroidered with symbolic imagery around the neck and down the front; worn originally by the Hausa and primarily by the aristocracy, as a symbol of status, power, or wealth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riguna"@en .

aat:300258586 a skos:Concept ;
    skos:definition "Main garments worn by women, primarily in Africa, to cover the genitals, often consisting of pendant elements made of metal or vegetal matter that hang from a cord tied around the waist or hips; may also be made of cloth and some element may pass between the legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cache-sexe"@en .

aat:300258600 a skos:Concept ;
    skos:definition "Daughters of the former Habsburg emperors of Austria or Austria-Hungary, and for the wives or widows of archdukes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archduchesses"@en .

aat:300258604 a skos:Concept ;
    skos:definition "Refers to male heads of the house of Habsburg. The title of archduke Palatine (in German, \"Pfalz-Erzherzog\") was first assumed by Rudolf IV, Duke of Austria, with the goal of gaining for the dukes of Austria an equal status with the electors of the Holy Roman Empire. The term was also used to refer to the Bourbon kings and queens of Spain, even though they were not descended in the male line from their Habsburg predecessors. The term may also be used to refer to rulers of other Continental European states, including Lorraine, Brabant, and Austrasia. For the wives and daughters of archdukes, use \"archduchesses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archdukes"@en .

aat:300258608 a skos:Concept ;
    skos:definition "Items, usually of metal, flat, and rectangular or oval in shape, worn on the belt of a uniform or other costume. When part of a military uniform, often bear insignia of rank or unit. Includes plates worn on waist belts, shoulder belts, and sword belts. Usage sometimes overlaps with \"belt plaques,\" which may be made of various materials, although items made of stone are typically called \"belt plaques\" rather than \"belt plates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt plates"@en .

aat:300258609 a skos:Concept ;
    skos:definition "Sovereign dukes of certain Continental European states called grand duchies, also the sons or grandsons in the male line of the Czars of imperial Russia; ranking immediately below kings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand dukes"@en .

aat:300258639 a skos:Concept ;
    skos:definition "Sovereign duchesses of certain Continental European states called grand duchies, also for the wives and widows of grand dukes and the daughters of the Czars of imperial Russia; ranking immediately below queens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand duchesses"@en .

aat:300258645 a skos:Concept ;
    skos:definition "Stiffened, generally rectangular pieces of cloth worn on military uniforms at the shoulder that bear the insignia of rank; worn primarily by United States military personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder boards"@en .

aat:300258657 a skos:Concept ;
    skos:definition "Plates or overlapping pieces of metal worn on military uniforms at the shoulder to indicate rank or unit; worn especially during the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder scales"@en .

aat:300258665 a skos:Concept ;
    skos:definition "Short sleeveless or short-sleeved garments consisting of front and back panels and open at the sides, worn over other garments, sometimes to display heraldic devices, by knights, heralds, or civilians, especially during the 12th to the 14th centuries. For padded or quilted protective garments worn over metal armor embellished with heraldic devices, use \"coat armors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabards"@en .

aat:300258669 a skos:Concept ;
    skos:definition "Usually refers to the sovereigns of Iran or Persia. The term may also refer to a ruler of Afghanistan prior to the downfall of the monarchy in 1973. It is sometimes used to refer to rulers of other countries of central and southern Asia, or to the hereditary governors and heads of Sufi orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shahs"@en .

aat:300258673 a skos:Concept ;
    skos:definition "Visual works or parts of works made of minutely faceted and riveted studs generally made of steel; often used for brooches, buckles, bottons, and swordhilts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cut steel work"@en .

aat:300258677 a skos:Concept ;
    skos:definition "Spoken or visual representations of information, such as speeches, demonstrations, and slide shows, for the purpose of achieving favorable visibility and persuading an audience to believe or support the presentor's ideas, projects, or goals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentations"@en .

aat:300258683 a skos:Concept ;
    skos:definition "The introduction or condition of having unwanted biological, chemical, physical, or radiological substances or matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contamination"@en .

aat:300258703 a skos:Concept ;
    skos:definition "Family containing two genera and two species of flying lemurs, which are nocturnal, arboreal gliding mammals found in South-east Asia. They are about the size of a domestic cat and characterized by lateral skin membranes extending from the forelimbs to the tail, by means of which they make long gliding leaps from tree to tree. Although flying lemurs share some characteristics with certain bats (flying foxes), they are most closely related to the primates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cynocephalidae"@en .

aat:300258707 a skos:Concept ;
    skos:definition "Metal devices worn on helmets that indicate rank or unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet plates"@en .

aat:300258742 a skos:Concept ;
    skos:definition "General term referring to members of several invertebrate phyla of various disparate groups, including the entire phylum of annelids. They have in common soft, elongated bodies lacking a hard outer covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worms"@en .

aat:300258754 a skos:Concept ;
    skos:definition "Members of an order of marine invertebrates having a flat, disk-shaped body, lacking the spherical symmetry of other echinoderms, but having five- or six-rayed markings on their surface; living on the sandy sea bottom of coastal North America south of the Arctic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clypeastroida"@en .

aat:300258774 a skos:Concept ;
    skos:definition "Members of a class containing around 950 living species of marine invertebrates having a globular or discoid form, and a rigid shell composed of many calcareous plates, in some species covered with projecting spines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Echinoidea"@en .

aat:300258781 a skos:Concept ;
    skos:definition "Members of a class of marine invertebrates having a flattened body that typically has five or more rays or arms radiating from a central disk, each bearing hundreds of tiny suction feet on the underside. Although adults have superficially radial symmetry, larval pluteus forms and other evidence suggests that their evolutionary ancestors had bilateral symmetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asteroidea"@en .

aat:300258790 a skos:Concept ;
    skos:definition "General term for any member of the class Crinoidea having a stalk that secures it to the ocean bottom, in contrast to other members of the class that can travel. Sea lilies have a cup-shaped body mounted on a stalk with branched, feathery arms studded with tube feet that trap food and convey it to the mouth in the center of the upper side; native to deep ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea lilies"@en .

aat:300258809 a skos:Concept ;
    skos:definition "Members of a family of around 10,000 species of insects that are social, live in colonies often having three castes, have a large head, a slender, oval abdomen joined to the thorax by a small waist, one one or two finlike extensions running across the thin waist region, and elbowed antennae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Formicidae"@en .

aat:300258857 a skos:Concept ;
    skos:definition "Implements used to produce a current of air for individual use; also objects in the form of such implements, but intended to serve as ceremonial or decorative accessories; may be rigid or collapsible. The operation of the fan may be done by oneself or the fan may be held by another to benefit the recipient."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fans"@en .

aat:300258884 a skos:Concept ;
    skos:definition "Military belts of heavy cotton woven fabric with metal fittings to carry equipment in the field, introduced during the First World War and later adapted for civilian use. Also, light cotton belts worn at the waist under military tunics or sashes to which sword slings may be attached, introduced around 1900."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web belts"@en .

aat:300258894 a skos:Concept ;
    skos:definition "Belts worn over the shoulder and particularly diagonally across the body, often used to carry ammunition or weapons; may also be ornamental."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder belts"@en .

aat:300258901 a skos:Concept ;
    skos:definition "Bands, sashes, or belts, usually richly ornamented, worn diagonally from shoulder to hip to support a dagger, bugle, sword, or drum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baldrics"@en .

aat:300258932 a skos:Concept ;
    skos:definition "Members of a genus containing freshwater invertebrate animals of very simple structure, the body having the form of a cylindrical tube, with a mouth surrounded by a ring of tentacles with stinging thread-cells, usually living attached to objects or plants, though able to float or move by cartwheeling from base to tentables; they reproduce by buds or eggs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydra"@en .

aat:300258961 a skos:Concept ;
    skos:definition "Organisms that live in or on another, from which they obtain nutrients and, frequently, shelter at the expense of the host organism, which it may directly or indirectly harm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parasites"@en .

aat:300258968 a skos:Concept ;
    skos:definition "Creators of Christian devotional images in sculpture and painting, called \"retablos\" and \"bultos\", active in Mexico from the Spanish colonial period, and later in the Spanish-speaking United States, to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "santeros"@en .

aat:300258972 a skos:Concept ;
    skos:definition "Refers generally to those who succeed or are designated to succeed to property or rank, either by will or law, upon the death of the former possessor. Use specifically in a legal context for those who inherit from an intestate person by operation of law. The term may refer to males or females, but to distinguish only females, use \"heiresses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heirs"@en .

aat:300258978 a skos:Concept ;
    skos:definition "Officials of monasteries and other religious communities in charge of provisions and supplies, especially of food, of the running of the kitchens, the work and conduct of servants and lay members, the purchase and delivery of goods, and all aspects of the management of the establishment that are not specifically assigned to others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellarers"@en .

aat:300258983 a skos:Concept ;
    skos:definition "Those who ride cycles, such as bicycles, motorcycles, tricycles, and unicycles, as well as stationary exercise cycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclists"@en .

aat:300258988 a skos:Concept ;
    skos:definition "Those who ride bicycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bicyclists"@en .

aat:300258998 a skos:Concept ;
    skos:definition "Those who ride motorcycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motorcyclists"@en .

aat:300259008 a skos:Concept ;
    skos:definition "Those who ride tricycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tricyclists"@en .

aat:300259013 a skos:Concept ;
    skos:definition "Those who ride unicycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unicyclists"@en .

aat:300259058 a skos:Concept ;
    skos:definition "Species of extinct bipedal homonin whose remains were found in the Transvaal region of South Africa; it lived 3.3 to 2.5 million years ago. Characterized by arms slightly longer than the legs, human-like cranial features combined with more primitive features including ape-like curved fingers for tree climbing. This species was the first of the australopiths to be described; Raymond Dart named the genus and species in 1925 after his discovery of the famous Taung child."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australopithecus africanus"@en .

aat:300259074 a skos:Concept ;
    skos:definition "Class of mollusks characterized by a two-piece, hinged outer shell divided from front to back into left and right valves, and large, flattened gills covered with tiny beating cilia; most species are sedentary, often burrowing, filter feeders such as clams, oysters, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bivalvia"@en .

aat:300259085 a skos:Concept ;
    skos:definition "General term for members of various bivalve molluscs. The term is often reserved for species that are edible and live partially buried in the sand of the ocean floor. Clams have two shells of equal size connected by two adductor muscles and have a powerful burrowing foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clams"@en .

aat:300259151 a skos:Concept ;
    skos:definition "Smoking equipment with a long flexible tube attached to a water reservoir through which the smoke is drawn and cooled; used for tobacco and narcotics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hookahs"@en .

aat:300259161 a skos:Concept ;
    skos:definition "Any of a number of systems employing prerecorded audio messages to inform visitors to museums or other exhibitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audioguides"@en .

aat:300259182 a skos:Concept ;
    skos:definition "Strips of woven material used for protecting, covering, or immobilizing injured parts of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandages"@en .

aat:300259185 a skos:Concept ;
    skos:definition "Instruments with a narrow knifelike blade and often ornamented handle used for cutting paper and opening envelopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter openers"@en .

aat:300259204 a skos:Concept ;
    skos:definition "Stewards of British manors, whose responsibilities include the day-to-day supervision of tenants, administration of rents, leases, and agreements, and the maintenance of the buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land agents"@en .

aat:300259214 a skos:Concept ;
    skos:definition "Arabic benches built of stone or mudbrick; often placed along the front and sometimes sides of traditional houses or in other areas for lodging or socializing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mastabas"@en .

aat:300259220 a skos:Concept ;
    skos:definition "Greenhouses in which ferns are grown; may also be used for gardens or other outdoor areas devoted primarily to ferns. For small containers designed to hold ferns, use \"ferneries (planters)\" or \"terrariums.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferneries"@en .

aat:300259226 a skos:Concept ;
    skos:definition "Houses generally characterized by a simple, two-story cubical block with a hipped roof, four roughly equal-sized rooms on each floor, and a symmetrical facade; often also having a one-story front porch and one or more dormers; popular in the United States from the 1890s to the early 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foursquare houses"@en .

aat:300259248 a skos:Concept ;
    skos:definition "Small, narrow, and often secluded valleys usually with steep sides and flat bottoms; originally restricted to the mountainous areas of Scotland and Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glens"@en .

aat:300259254 a skos:Concept ;
    skos:definition "Having the form or plan of two lines or bars intersecting at right angles and placed perpendicular to the horizontal plane; having the shape of a cross. For forms having the shape of the 24th letter of the English alphabet, in which two bars or lines of equal length intersect, but not necessarily forming right angles and where the bars run diagonally across the vertical plane, use \"X-shaped.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruciform"@en .

aat:300259267 a skos:Concept ;
    skos:definition "Use to refer to works by the ethnic group of the same name living in central Nigeria near the confluence of the Niger and Benue Rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Igede"@en .

aat:300259277 a skos:Concept ;
    skos:definition "Japanese architectural movement of the 1960s and 1970s, dedicated to urban-scale issues based on biologic principles of dynamic growth and change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Metabolism"@en .

aat:300259288 a skos:Concept ;
    skos:definition "Discrete housing complexes closed off to nonresidents by gates and fences or walls; may or may not also have guards or other surveillance and security installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gated communities"@en .

aat:300259299 a skos:Concept ;
    skos:definition "Bridges linking two or more settled areas by means of a continuous or discontinuous row of buildings that accommodate different functions, such as domestic, cultural, social, or recreational uses, and are set upon or clustered along the transport route."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inhabited bridges"@en .

aat:300259313 a skos:Concept ;
    skos:definition "Turbans worn especially in India, often of light material and with one end left hanging down in back. Also narrow lengths of cloth, usually of light material, worn around a helmet or hat and often with a piece left hanging down in back to protect the wearer's neck from the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puggrees"@en .

aat:300259320 a skos:Concept ;
    skos:definition "Waist-length coat-like outer military garments, sometimes attached by buttons to trousers and often worn by soldiers and airmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blouses"@en .

aat:300259331 a skos:Concept ;
    skos:definition "Braided cords, worn around the shoulder on military uniforms, awarded as an honorary decoration. Also, similar cords adopted as trim on women's garments. Distinguished from \"aiguillettes (cords),\" which are usually braided, end in aglets, and are worn especially by aides-de-camp and sometimes other military officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourragères"@en .

aat:300259347 a skos:Concept ;
    skos:definition "Objects of adornment worn on an individual's shoulders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder accessories"@en .

aat:300259348 a skos:Concept ;
    skos:definition "Cords, usually braided, ending in aglets, worn looped under the arm and sometimes across the breast on military uniforms; worn especially by aides-de-camp, but also by other officers. Distinguished from \"fourragères,\" which are braided cords worn as an honorary military decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aiguillettes"@en .

aat:300259362 a skos:Concept ;
    skos:definition "Buildings or complexes providing housing and related facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housing complexes"@en .

aat:300259387 a skos:Concept ;
    skos:definition "Accessories that project outward from the shoulder of a garment and are made of cloth or metal. In a military context, may be attached to a shoulder strap and may indicate rank or unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wings"@en .

aat:300259392 a skos:Concept ;
    skos:definition "Hats made of white canvas or duck with gored crown and stitched brim, worn by enlisted navy personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white hats"@en .

aat:300259401 a skos:Concept ;
    skos:definition "Small, rectangular, ribbon-covered pins of distinctive colors worn on military uniforms on prescribed occasions that represent the medals or decorations worn on dress uniforms on the most formal occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon bars"@en .

aat:300259410 a skos:Concept ;
    skos:definition "Thin pieces of split wood, usually hazel, roughly 2 to 3 feet long and bent into a U shape with pointed ends designed for fastening thatch onto roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broaches"@en .

aat:300259446 a skos:Concept ;
    skos:definition "Long, sharp-pointed pieces of metal or other hard material, usually non-circular in cross-section, used for fastening things securely together. In the building and railroad industries, spikes have a head, for impact insertion. For similar fasteners, but smaller and round in cross-section, use \"nails (fasteners).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spikes"@en .

aat:300259451 a skos:Concept ;
    skos:definition "Use when describing the culture of or products from the chief fishing tribe of the same name from Madagascar, currently inhabiting its southwest coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vezo"@en .

aat:300259457 a skos:Concept ;
    skos:definition "Pottery styles belonging to ancient East African cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient East African pottery styles"@en .

aat:300259458 a skos:Concept ;
    skos:definition "Early Iron Age culture, partially identified by characteristic pottery of the interlacustrine region of East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urewe"@en .

aat:300259476 a skos:Concept ;
    skos:definition "Style and culture of the Arab ethnic group of the same name living as pastoralists in the Lake Chad region of western Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shuwa"@en .

aat:300259480 a skos:Concept ;
    skos:definition "In Greek churches, side chapels, or small added churchlike spaces, separate from the cathedral or principal church of a monastery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parekklesia"@en .

aat:300259482 a skos:Concept ;
    skos:definition "Buildings housing businesses selling articles that are chiefly decorative or amusing, whose appeal is often transitory, often relying for their appeal on the newness of their design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novelty shops"@en .

aat:300259487 a skos:Concept ;
    skos:definition "The planning movement in the United States of the 1990s espousing a return to traditional small-town design features for newly constructed suburbs or redeveloped urban neighborhoods. To describe the architectural elements of the movement, incorporating such features as pedestrian spaces, mass transit, and mixed land use, use \"Neotraditional.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Urbanism"@en .

aat:300259490 a skos:Concept ;
    skos:definition "Describes elements of the built environment, primarily in newly constructed suburban areas of the United States, characterized by a mix of land uses, spaces and buildings scaled to pedestrians, public green space, and an emphasis on mass transit rather than on automobiles, elements typical of traditional American small towns; popular from the 1980s. For the American planning movement incorporating neotraditional design principles, use \"New Urbanism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neotraditional"@en .

aat:300259500 a skos:Concept ;
    skos:definition "Public urinals partly screened and located for easy access, usually at curbside; found in some European countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pissoirs"@en .

aat:300259515 a skos:Concept ;
    skos:definition "In the West, sets of health beliefs and practices that developed within the culture of a particular ethnic or geographic group of people, distinct from modern Western medicine; commonly includes herbal and homeopathic remedies, religious or spiritual ritual, and an holistic approach to patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traditional medicine"@en .

aat:300259528 a skos:Concept ;
    skos:definition "Practitioners of traditional medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "healers"@en .

aat:300259534 a skos:Concept ;
    skos:definition "Places where residential garbage and commercial wastes are collected, compacted, or baled for transport to a processing facility or landfill; may be fixed or mobile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transfer stations"@en .

aat:300259541 a skos:Concept ;
    skos:definition "Movable bridges over navigable waterways carrying passengers and vehicles across from bank to bank on a platform suspended from a rolling trolley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transporter bridges"@en .

aat:300259552 a skos:Concept ;
    skos:definition "Scottish narrow streets, lanes, or alleys that are usually curving in their course and lead off of main thoroughfares in towns or cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wynds"@en .

aat:300259557 a skos:Concept ;
    skos:definition "Piers with an engaged figure of Osiris on the front, attached in such a manner that the pier, not the statue, supports the entablature; used in ancient Egyptian and Egyptian revival architecture. For statues that themselves directly support a superstructure, see descriptors collocated under the guide term \"<anthropomorphic supporting elements>.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Osiride pillars"@en .

aat:300259563 a skos:Concept ;
    skos:definition "Business enterprises owned and operated by members who use the enterprises' services and share the financial benefits. The first consumer cooperative store was established in Rochdale, England, in 1844, and most are still modeled after the original principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooperatives"@en .

aat:300259572 a skos:Concept ;
    skos:definition "Refers to narrow routes through or gaps in mountain ranges allowing passage across."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passes"@en .

aat:300259605 a skos:Concept ;
    skos:definition "Retirement communities providing a full range of personal care and supplemental services, often including transportation, medicine, recreational facilities, and financial advice. Distinguished from \"life care communities\" by charging monthly fees that can vary over the duration of the residency, instead of a one-time up-front charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuing care retirement communities"@en .

aat:300259621 a skos:Concept ;
    skos:definition "Cooperatives that sell goods and services produced by their members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "producer cooperatives"@en .

aat:300259641 a skos:Concept ;
    skos:definition "Single-household living arrangements in which two or more individuals who are unrelated or members of an extended family (in contrast to a nuclear family) share a single dwelling unit as a long-term occupancy; typically each resident or nuclear family unit has a private bedroom or other personal rooms, but share a common kitchen, dining area, bath room, laundry, and other facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shared housing"@en .

aat:300259646 a skos:Concept ;
    skos:definition "Use when referring to a semi-independent group living arrangement, usually for the elderly, where some shared common space and some support services, such as housekeeping, transportation, and social activities, but not personal care, are provided; used in the United States since the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "congregate housing"@en .

aat:300259651 a skos:Concept ;
    skos:definition "Long-term care facilities in a residential environment for elderly persons who require some degree of personal assistance with the activities of daily life, such as dressing, bathing, or mobilization; offers a middle ground between independent living and supervised nursing care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal care homes"@en .

aat:300259670 a skos:Concept ;
    skos:definition "Movable, tangible property having more or less intimate relation to the person of the possessor; generally includes such objects as clothing, jewelry, furnishings, personal collections, books, vehicles, and appliances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personalia"@en .

aat:300259706 a skos:Concept ;
    skos:definition "Roughly triangular cloth flaps on each shoulder of an officer's service uniform that extend inward from the sleeve seam, fasten by button near the collar, and bear an insignia of rank. Worn by army, airforce, and marine officers in the United States. For generally rectangular pieces of cloth worn at the shoulder on military uniforms and bearing an insignia of rank, use \"shoulder straps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder loops"@en .

aat:300259712 a skos:Concept ;
    skos:definition "Body-length, baglike coverings designed for one or two persons to sleep in, especially out-of-doors; lined or padded, with closure and often with water-repellent outer covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeping bags"@en .

aat:300259717 a skos:Concept ;
    skos:definition "Strips of leather, cloth, or other material that pass over the shoulder and from which an article is suspended. For strips used for fastening, use \"straps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder straps"@en .

aat:300259727 a skos:Concept ;
    skos:definition "Any brick, tile, stone, or other material fabricated in shaped units and used for paving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paver"@en .

aat:300259782 a skos:Concept ;
    skos:definition "Order of large number of widely distributed, shallow-water cephalopods having eight sucker-bearing arms or tentacles, a beak-like mouth, and either only a vestigial internal shell or no shell at all."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Octopoda"@en .

aat:300259787 a skos:Concept ;
    skos:definition "Order of large number of 10-armed cephalopods found in both coastal and oceanic waters, characterized by having elongated tubular bodies and short compact heads. Two of the 10 arms have developed into long slender tentacles with expanded ends and four rows of suckers with toothed, horny rings. The body of most squids is strengthened by a feathery-shaped, internal shell composed of a horny material. Squid eyes are very complex and set into the sides of the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Teuthida"@en .

aat:300259895 a skos:Concept ;
    skos:definition "Those taken by capture or surrender into the power of the enemy during war, especially military personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prisoners of war"@en .

aat:300259912 a skos:Concept ;
    skos:definition "Business enterprises whose primary service is providing access to the Internet, sometimes also providing applications software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Internet service providers"@en .

aat:300259938 a skos:Concept ;
    skos:definition "Juvenile) forms of animals with indirect development, going through or undergoing metamorphosis, including insects, amphibians, cnidarians, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larvae"@en .

aat:300259939 a skos:Concept ;
    skos:definition "Larvae of butterflies, moths, as well as larvae of some other insects that are hairy, such as the saw-fly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caterpillars"@en .

aat:300259951 a skos:Concept ;
    skos:definition "Small spoons, made of silver, bone, ivory, or wood, used to bring snuff from a container to the nose, or from a larger container to a smaller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuff spoons"@en .

aat:300259955 a skos:Concept ;
    skos:definition "Horned figures associated with the Igbo and Igala people of Nigeria that represent a man's ability to succeed in the world through the power of his strong right arm. These may be simply horns on a base, a horned head, or a full figure of considerable elaboration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ikenga"@en .

aat:300260027 a skos:Concept ;
    skos:definition "The condition or state of mental or physical harmony, tranquility, or serenity, or mutual concord between individuals or groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peace"@en .

aat:300260030 a skos:Concept ;
    skos:definition "Type of pattern common on late 18th and 19th century ceramics, derived from Chinese sources, depicting a willow tree, a pagoda, a bridge with figures, two birds flying, and a small boat; most commonly blue figures on a white background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "willow pattern"@en .

aat:300260035 a skos:Concept ;
    skos:definition "Genre of Japanese folk art conforming to the principle of the inseparability of beauty and high utility in everyday practical objects of the common people; traditional craft methods without conscious aesthetic intent govern the production of the objects of the genre. Distinguished from the utilitarian goods of the aristocracy, which consciously strove for aesthetic effect, and from the everyday utilitarian products of modern industrialization; genre defined and term used since 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mingei"@en .

aat:300260043 a skos:Concept ;
    skos:definition "Fertility figures, usually female, of abstracted form, with disk-like heads with high oval foreheads and most often having horizontal arms, cylindrical torso, breasts, and navel; among Asante of West Africa believed to ensure conception and successful birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "akua'mma"@en .

aat:300260048 a skos:Concept ;
    skos:definition "Vessels designed for holding and serving milk, especially for medium-sized pitchers having a handle and a spout or lip and sometimes a lid; usually made as part of a tea service; originating in the early 18th century. For containers for holding and serving cream, especially small pitchers, use \"creamers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk jugs"@en .

aat:300260068 a skos:Concept ;
    skos:definition "Type of woven design in which compartmentalized forms surround a large central floral motif in a diaper pattern that resembles lace or net; popular in England between 1690 and 1730."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace pattern"@en .

aat:300260073 a skos:Concept ;
    skos:definition "Originally the banner of St. Denis used by early French kings; more recently any banner or similar device that serves as a rallying point or symbol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oriflammes"@en .

aat:300260079 a skos:Concept ;
    skos:definition "The juxtaposition of dissimilar elements, properties, or qualities in a work in order to heighten expressiveness through the differences revealed by comparison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contrast"@en .

aat:300260080 a skos:Concept ;
    skos:definition "Delivering speeches in front of a group or in a public setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public speaking"@en .

aat:300260111 a skos:Concept ;
    skos:definition "Women's jackets worn over skirts, usually with short, skirt-like extensions below the waist, worn during the mid-19th century. May have pagoda sleeves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basquines"@en .

aat:300260120 a skos:Concept ;
    skos:definition "Parts or components of stalls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stall components"@en .

aat:300260121 a skos:Concept ;
    skos:definition "Shelf-like projections attached to the undersides of hinged seats in choir stalls; when the seats are lifted, they give support to a person standing in the stall; often ornamented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misericords"@en .

aat:300260141 a skos:Concept ;
    skos:definition "Musical clocks in which, instead of bells or gongs, sound is produced by organlike pipes blown usually by bellows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ clocks"@en .

aat:300260144 a skos:Concept ;
    skos:definition "Formal gardens or portions of gardens that by design are set at a lower level than their surroundings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunken gardens"@en .

aat:300260149 a skos:Concept ;
    skos:definition "The directional growth of an organism or part of an organism in response to an external stimulus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tropism"@en .

aat:300260153 a skos:Concept ;
    skos:definition "The welfare or well-being of the general public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public interest"@en .

aat:300260164 a skos:Concept ;
    skos:definition "Collars worn to signify a member of the clergy. The most common forms are white stiffened linen or linenlike independent standing collars or tabs inserted in a black collar and worn by certain ordained Roman Catholic and Protestant clergy with a suit or liturgical robes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clerical collars"@en .

aat:300260178 a skos:Concept ;
    skos:definition "Ancient Roman containers in the form of a shallow bowl without handles, often with a base whose center is pushed up into the body; used for offering libations at religious ceremonies or for drinking. For similar ancient Greek containers, use \"phialae.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paterae"@en .

aat:300260188 a skos:Concept ;
    skos:definition "Members of a genus containing over 1,000 species of ant large ants that create nests in dead, damp wood or hollow out sections of trees. They may infest buildings made of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camponatus"@en .

aat:300260195 a skos:Concept ;
    skos:definition "Members of a species of small, light brown beetle that is a pest of tobacco, cereals, flour, dried fruit, and some animal products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lasioderma serricorne"@en .

aat:300260204 a skos:Concept ;
    skos:definition "Members of a species of woodboring beetle that may live in rafters of wooden structures. The common name derives from the noise made by the beetle: to attract mates, it makes a tapping or ticking sound by bumping its head or jaws against the sides of the tunnels it bores in old furniture and wood, which was heard by those sitting up with dying people on quiet, sleepless nights, thus believed to forecast or accompany an approaching death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xestobium rufovillosum"@en .

aat:300260218 a skos:Concept ;
    skos:definition "Species of beetle that, in the larval stage, bores in sapwood timber and feeds upon it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anobium punctatum"@en .

aat:300260228 a skos:Concept ;
    skos:definition "Members of a family containing over 2,000 species in around 25 genera of beetles, that are small, cylindrical in shape, brown or black in color, and bore into a tree to form an egg chamber. A few species are destructive to live trees, although most live in dead or dying wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scolytidae"@en .

aat:300260234 a skos:Concept ;
    skos:definition "Members of a species of beetle, the common name of which reflects that it may infest household larders, feeding upon cheese, dried meats, and raw animal hides; the larva is characterized by short and long reddish-brown or black hair and other distinguishing markings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dermestes lardarius"@en .

aat:300260238 a skos:Concept ;
    skos:definition "Members of a family containing over 20,000 species of beetles, most having extremely long antennae. The larvae may be very destructive to trees and woody plants; they are distinguished by a round head with strong jaws, used to bore through and feed on woody plants; the larva pupates within the tree and the new adult exits through a tunnel that has been bored through the wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cerambycidae"@en .

aat:300260252 a skos:Concept ;
    skos:definition "General name for many species belonging to three separate families of insects that have in common larvae that feed on and tunnel through seasoned wood, including furniture, wood floors, structural timbers, and lumber piles, often destroying the item. The name refers to the fact that the wood is converted to a fine powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder-post beetles"@en .

aat:300260269 a skos:Concept ;
    skos:definition "Those who practice that branch of history in which historical information is recorded or histories are presented in the form of audible speech or song."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oral historians"@en .

aat:300260284 a skos:Concept ;
    skos:definition "General term referring to members of several families in different superfamilies of insects in the suborder Apocrita having in common that they have the abdomen attached to the thorax by a slender petiole or waist, most are winged, and the females have a stinger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wasps"@en .

aat:300260289 a skos:Concept ;
    skos:definition "General term referring to members of several species in various genera, having in common that they are small moths that have larva that feed upon and form a chrysalis case from stored fabrics, and thus are destructive to woollen fabrics, feathers, furs, and similar organic materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothes moths"@en .

aat:300260297 a skos:Concept ;
    skos:definition "Members of the genus containing two species of moths that are native to northern China. When changing into the pupa state, the larva or caterpillar silkworm spins a cocoon made of silken filament that is used by humans to create silk thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bombyx"@en .

aat:300260302 a skos:Concept ;
    skos:definition "Western African people whose role is to narrate, chant, or sing histories, especially genealogies, of individuals, families, and communities, often accompanying this with instrumental music, acting, and mime. Originally the term was used with reference only to West Africans, now applied to such people in other cultures and geographic regions. Griots are usually male; for females who have this role, prefer the narrower term \"griottes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "griots"@en .

aat:300260311 a skos:Concept ;
    skos:definition "Members of an order containing around 4,000 species of insects characterized by a flattened oval body, long threadlike antennae, and a shining black or brown leathery integument. They are are among the most primitive living, winged insects, appearing today much like they do in fossils that are more than 320 million years old."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blattaria"@en .

aat:300260319 a skos:Concept ;
    skos:definition "Women who narrate, chant, or sing histories, especially genealogies, of individuals, families, and communities, often accompanying this with instrumental music, acting, and mime. Originally used with reference to West Africans, now applied to such people in other cultures and geographic areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "griottes"@en .

aat:300260323 a skos:Concept ;
    skos:definition "Festivals held to celebrate the gathering of crops, usually expressing thanks for a successful harvest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harvest festivals"@en .

aat:300260328 a skos:Concept ;
    skos:definition "West African harvest festivals held to celebrate the yam crop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yam festivals"@en .

aat:300260332 a skos:Concept ;
    skos:definition "Islamic holy men in Africa who serve as spiritual leaders, teachers, and mystics as well as community leaders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marabouts"@en .

aat:300260338 a skos:Concept ;
    skos:definition "Design of paper structures and mechanisms, such as pop-up elements in books and greeting cards, cut-and-assemble paper models, and various types of paper containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper engineering"@en .

aat:300260345 a skos:Concept ;
    skos:definition "Readings or recitations of works of literature, such as plays, poems, and short stories, with interpretive or dramatic use of voice and often of gesture, but little or no props or other stage elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dramatic readings"@en .

aat:300260349 a skos:Concept ;
    skos:definition "National and international fairs exhibiting the material culture and products of colonies and colonized peoples, with the general aim of promoting the colonization activities of nations or organizations; held from the mid- 19th until the mid-20th centuries, especially in Great Britain and France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonial exhibitions"@en .

aat:300260356 a skos:Concept ;
    skos:definition "Refers to partners in or owners of professional practices who are legally responsible for the activities of their companies, especially in architectural or design-related companies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "principals"@en .

aat:300260366 a skos:Concept ;
    skos:definition "Close-fitting trousers that fit over footwear and strap under the sole, worn especially as part of a military uniform or for horseback riding. Use also for loose-fitting trousers worn over breeches or other bifurcated garments as protective wear by military personnel and others, especially during the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overalls"@en .

aat:300260369 a skos:Concept ;
    skos:definition "Vertical poles in fire stations positioned to facilitate getting firefighters quickly and safely from their sleeping quarters to their vehicles; invented in the United States in the late 1870s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding poles"@en .

aat:300260388 a skos:Concept ;
    skos:definition "Round or cone-shaped covers, often of gourd, wood, or hides, worn on the penis, especially by men in southern Africa, particularly after circumcision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penis caps"@en .

aat:300260407 a skos:Concept ;
    skos:definition "Automata, water jets, or other devices designed to spray, soak, and surprise unwary onlookers in gardens; generally activated by hidden, usually pressure-sensitive, levers, springs, or similar triggers; popular especially during the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water tricks"@en .

aat:300260428 a skos:Concept ;
    skos:definition "Inflicting severe bodily pain as punishment, revenge, or coercion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torturing"@en .

aat:300260431 a skos:Concept ;
    skos:definition "Built structures or dwellings for accomodating swine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swine housing"@en .

aat:300260432 a skos:Concept ;
    skos:definition "Relatively large, enclosed buildings with facilities for housing and breeding a large number of swine under one roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hog houses"@en .

aat:300260465 a skos:Concept ;
    skos:definition "Devices in which electromagnetic radiation is generated by a potential at a junction between two types of material, upon absorption of radiant energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photovoltaic cells"@en .

aat:300260469 a skos:Concept ;
    skos:definition "Photovoltaic cells that convert sunlight directly into electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar cells"@en .

aat:300260475 a skos:Concept ;
    skos:definition "Buildings or groups of closely spaced buildings housing four or more individual, usually small, motion picture theaters, generally with a common lobby, ticket booth, and concessions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multiplex cinemas"@en .

aat:300260497 a skos:Concept ;
    skos:definition "Secular version of the Gothic style, derived from the college buildings at Oxford and Cambridge; popular in North America from the 1880s to the 1920s for academic buildings and other institutional structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Collegiate Gothic"@en .

aat:300260503 a skos:Concept ;
    skos:definition "Artificial surfaces designed to facilitate practicing rock climbing techniques, providing the climber with varying surface textures, grips, scale, and inclination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climbing walls"@en .

aat:300260516 a skos:Concept ;
    skos:definition "Enclosed spaces reserved for men of a household."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "men's quarters"@en .

aat:300260517 a skos:Concept ;
    skos:definition "Enclosed spaces reserved for women of a household."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "women's quarters"@en .

aat:300260518 a skos:Concept ;
    skos:definition "Portions of Islamic houses reserved for men, and in some countries, also considered the public sectors of houses. For the women's quarters of Islamic houses, use \"harems.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selamliks"@en .

aat:300260522 a skos:Concept ;
    skos:definition "Rooms and other spaces within buildings that house exhibitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition building spaces"@en .

aat:300260523 a skos:Concept ;
    skos:definition "Commercial spaces in museums or separate buildings staffed by museum personnel and selling primarily museum-specific souvenirs and related merchandise, the proceeds of which help to support the operating museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museum shops"@en .

aat:300260549 a skos:Concept ;
    skos:definition "Those versed in the study of the theistic philosophy that views creative becoming as the universal form of reality and emphasizes the relational nature of all being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "process philosophers"@en .

aat:300260644 a skos:Concept ;
    skos:definition "Box-like containers used to carry or store corporals, which are altar cloths. For envelope-like containers of stiffened material used to hold the corporal, use \"burses (corporal).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporal cases"@en .

aat:300260656 a skos:Concept ;
    skos:definition "Sheathlike coverings that encase the penis; may be attached to a belt or girdle. Often made of plaited plant material, animal intestine, or hides or skins and decorated; worn especially by African men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penis sheaths"@en .

aat:300260662 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, currently inhabiting the Plateau region, or middle belt zone, of northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mada"@en .

aat:300260665 a skos:Concept ;
    skos:definition "Style and culture of African ethnic groups inhabiting the island of Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malagasy"@en .

aat:300260689 a skos:Concept ;
    skos:definition "Sites considered for development that already have some form of development on them or that are derelict and thus would require clearance before redevelopment could take place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brownfield sites"@en .

aat:300260694 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name currently inhabiting the coastal regions and part of the inland forest of Liberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bassa"@en .

aat:300260713 a skos:Concept ;
    skos:definition "Style and culture of the African Pygmy ethnic group of the same name currently inhabiting the southeast Ituri Forest region of Zaire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbuti"@en .

aat:300260723 a skos:Concept ;
    skos:definition "Style and culture of the Toka peoples, located in southwest Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toka"@en .

aat:300260726 a skos:Concept ;
    skos:definition "Style and culture of the Tawana people of the Tswana tribes of Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tawana"@en .

aat:300260727 a skos:Concept ;
    skos:definition "The process of providing permanent support to a structure from underneath as by reinforcing an existing foundation, pier, or wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underpinning"@en .

aat:300260731 a skos:Concept ;
    skos:definition "Glass made with slices of colored canes which can be used as inlays for walls and furniture, fashioned into beads and various kinds of jewelry, or arranged in molds and fused together to form vessels. Distinguished from \"millefiori glass\" which is glass made with slices of colored canes embedded in clear molten glass, usually creating flowerlike designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosaic glass"@en .

aat:300260736 a skos:Concept ;
    skos:definition "Tin glaze with a blue to grayish blue or lilac-gray stain; used to decorate ceramics, especially Italian maiolica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berettino"@en .

aat:300260743 a skos:Concept ;
    skos:definition "Reworking large painted areas either to cover damage, mask unwanted features, or change color and design. For similar work done on paintings by conservators, use \"inpainting\" or \"overpainting.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repainting"@en .

aat:300260756 a skos:Concept ;
    skos:definition "A marble of argillaceous limestone containing dark coloring matter so distributed as to resemble forests or landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest marble"@en .

aat:300260770 a skos:Concept ;
    skos:definition "Masquerades held by the secret society named Gelede of the Yoruba people of West Africa, incorporating performances of songs honoring the older women of the community, and satiric commentary on community figures, events, and moral behavior; they are held all night on the opening night of the society's annual festival."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Efe"@en .

aat:300260771 a skos:Concept ;
    skos:definition "Masquerades held by the secret society named Gelede of the Yoruba people of West Africa, performed by masked, costumed dancers, often impersonating women, for the purpose of placating the older women of the community and encouraging them to use their powers for community well-being; they are held when society members die, and during the society's annual festival, on the afternoon following the nightlong performance of the Efe masquerade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gelede"@en .

aat:300260773 a skos:Concept ;
    skos:definition "Festival of dancing and masquerades held every two years in March by the Yoruba people of West Africa to promote the fertility and well-being of the community, and to honor important people and events in community history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Epa"@en .

aat:300260775 a skos:Concept ;
    skos:definition "Broadswords with a distinctive basket hilt and, usually, a double-edged, pointed blade, named after the Slavonian bodyguards of the Doge of Venice who used them; surviving examples date from the late 15th to the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schiavonas"@en .

aat:300260781 a skos:Concept ;
    skos:definition "A short tale, often of a fantastic or artificial nature, used as an example to illustrate a moral point; developed, cultivated, and popular in the Middle Ages, exempla were often incorporated into sermons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exempla"@en .

aat:300260787 a skos:Concept ;
    skos:definition "Objects used to lure or attract another into a trap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decoys"@en .

aat:300260790 a skos:Concept ;
    skos:definition "Arched or vaulted niches or similar recesses in Roman catacombs; usually meant to hold sarcophagi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcosolia"@en .

aat:300260794 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name currently inhabiting south-central Ivory Coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dida"@en .

aat:300260806 a skos:Concept ;
    skos:definition "The process of applying a protective coating and decorative painting to land vehicles, primarily those drawn by draft animals, such as carriages, wagons, and sleighs; encompasses the application of primer, ground color, and varnish, lettering, striping and other ornamentation, and the painting of pictures such as coats of arms and flower wreaths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coach painting"@en .

aat:300260816 a skos:Concept ;
    skos:definition "Artists who specialize in applying decorative painting to land vehicles, primarily those drawn by draft animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coach painters"@en .

aat:300260850 a skos:Concept ;
    skos:definition "Those trained or working in the branch of engineering concerned with the daily technical and managerial operations of a factory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant engineers"@en .

aat:300260859 a skos:Concept ;
    skos:definition "Small vessels that hold iced water to cool or rinse a wine glass at the table; made of silver, glass, earthenware, or porcelain, with one or two notches in the rim from which an inverted wine glass may be suspended. For large circular or oval bowls with scalloped rims used to cool six or more glasses, use \"monteiths.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine glass coolers"@en .

aat:300260877 a skos:Concept ;
    skos:definition "Use specifically for aerophones of generally conical bore and a wooden body made from or bound with birch or other bark, with fingerholes, a cup-shaped mouthpiece, and a bell of horn at the other end; examples are known to have been made in the early 1930s by Teppo Repo, a native of the Ingria region of Russia who brought the instrument to Finland. Used also very generally for a variety of wooden horns of Finland, usually made of or covered with birch bark, with or without fingerholes, some resembling trumpets or cornetts, others having a single reed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuohitorvis"@en .

aat:300260881 a skos:Concept ;
    skos:definition "Refers to the permanent or temporary cessation, in whole or in part, of a right, legal proceeding, nuisance, taxes, debt, or other claim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abatement"@en .

aat:300260885 a skos:Concept ;
    skos:definition "Refers to the temporary cessation, interruption, postponement, or withholding of a right, statute, legal proceeding, or legal decision or its effects, such as a prison sentence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suspension"@en .

aat:300260893 a skos:Concept ;
    skos:definition "Courts in Great Britain and in some American states that administer specifically the law of equity and proceed according to the forms and principles of equity, as opposed to the common law or statutory law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courts of chancery"@en .

aat:300260956 a skos:Concept ;
    skos:definition "Use generally for any proceedings in court brought by one or more persons against another or others, or by the state against a person or persons, to enforce a private right, redress or prevent a private wrong, or to punish a public offense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actions"@en .

aat:300260960 a skos:Concept ;
    skos:definition "Legal actions brought to court by one or more parties against another or others to enforce, redress, or protect private rights."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civil actions"@en .

aat:300260967 a skos:Concept ;
    skos:definition "The contemporary music and fashion style, originating in Seattle, Washington, among alternative hard-rock bands and by the 1990s influencing national fashion trends, based generally on the flannel shirt, torn jeans, and combat boots ensemble of urban youth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grunge"@en .

aat:300260970 a skos:Concept ;
    skos:definition "Period and English architectural style during the reigns of Charles I and Charles II between 1625 and 1685 and associated with red brick and hipped roof structures prominent between 1640 and 1670."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caroline"@en .

aat:300260984 a skos:Concept ;
    skos:definition "Places offering, in a social atmosphere, public access to the Internet, often also providing related hardware and software, training courses, and audio-visual equipment, usually food and drink, and sometimes music or traditional paper-based reading material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cybercafes"@en .

aat:300261000 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name currently inhabiting southern Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pari"@en .

aat:300261008 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Konongo"@en .

aat:300261009 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name currently inhabiting Sierra Leone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Landogo"@en .

aat:300261014 a skos:Concept ;
    skos:definition "Pelts of a distinctive style, usually of sable or marten, commonly mounted with decorated heads and paws of crystal or gold ornamented with gems. Worn either around the neck and shoulders, suspended by a chain from a girdle, or carried in the hand. Popular in Europe during the 16th century; the name refers to the theory, probably erroneous, that the furs were used to attract fleas and lice away from the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flohpelze"@en .

aat:300261041 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name currently inhabiting the Ivory Coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neyo"@en .

aat:300261044 a skos:Concept ;
    skos:definition "Small 18th- and 19th-century Philadelphia row houses generally comprised of one room per floor for three floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trinity houses"@en .

aat:300261054 a skos:Concept ;
    skos:definition "Refers to the Fante Asafo military associations' meeting places, rallying points, and ritual centers for the groups' events; originally functioning as shrines, now also acting as storage facilities, civic symbols, and advertisements of community strength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posuban"@en .

aat:300261068 a skos:Concept ;
    skos:definition "Matched sets of ornaments intended to be worn together, either jewels or trimmings for costume, usually a collar and cuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parures"@en .

aat:300261080 a skos:Concept ;
    skos:definition "Ancient Roman decorative metal disks or bosses worn on the breast by men as a mark of military distinction or as an ornament; may also be used for similar ornaments on horse equipment. May be of Celtic origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phalerae"@en .

aat:300261086 a skos:Concept ;
    skos:definition "Collocates descriptors for organizations consisting of a governing authority together with a population and an area of land which are under its jurisdiction in some or all respects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political administrative bodies"@en .

aat:300261087 a skos:Concept ;
    skos:definition "Describes occurrences taking place during a particular interval of time relating to a judgment, the function of judging, the administration of justice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judicial events"@en .

aat:300261095 a skos:Concept ;
    skos:definition "Transfer of acid from one material to another by direct contact or by vapor transfer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid migration"@en .

aat:300261097 a skos:Concept ;
    skos:definition "Professionals concerned with the planning, cultivation, protection, and management of urban forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban foresters"@en .

aat:300261137 a skos:Concept ;
    skos:definition "Refers to the method of constructing walls and partitions, sometimes floors, by pouring concrete or assembling wooden sections on site in a horizontal position, and then tilting them into place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilt-up construction"@en .

aat:300261158 a skos:Concept ;
    skos:definition "Sharp edged or pointed implements used in Pre-Columbian Mesoamerican cultures to kill victims or simply shed blood as sacrifices to the gods; they take a variety of forms, including manmade objects such as knives and sharp spikes with handles, and natural objects such as thorns and stingray stings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bloodletters"@en .

aat:300261160 a skos:Concept ;
    skos:definition "Sharp pointed implements used in Pre-Columbian Mesoamerican cultures to prick the flesh and draw blood to offer as a self-sacrifice to the gods; includes both manmade implements resembling daggers or spikes with handles, and natural objects such as thorns or stingray stings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perforators"@en .

aat:300261181 a skos:Concept ;
    skos:definition "Motif derived from the the boteh, copied from Kashmiri shawls by the woollen manufacturers of Paisley, Scotland in the 19th century, and becoming popular in Britain, France, and North America. It occurs in many variations and with numerous ancillary motifs, particularly in textile patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paisley"@en .

aat:300261225 a skos:Concept ;
    skos:definition "Members of an order containing 19 families, 110 genera, and almost 600 species of fresh water and marine soft-finned bony fishes with elongated snake-like or worm-like bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anguilliformes"@en .

aat:300261228 a skos:Concept ;
    skos:definition "Members of a family containing about 40 species of oceanic fish found worldwide in warm waters and noted for their ability to fly or glide by using winglike, rigid fins and an unevenly forked tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Exocoetidae"@en .

aat:300261234 a skos:Concept ;
    skos:definition "Members of a genus containing 15 species of small, oily, small-headed, streamlined, variously colored fish, some with silvery iridescent sides and metallic deep-blue backs, living in shallow temperate waters of the North Atlantic, the North Pacific, the Baltic Sea, and the Mediterranean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clupea"@en .

aat:300261242 a skos:Concept ;
    skos:definition "Members of a genus containing 32 species of small marine fishes with consecutive rings of body armor, a single, soft-rayed dorsal fin, forward-curled, prehensile tail, and head resembling a horse head and set at an angle to their bodies. The head has a long, tubular snout, small mouth, and eyes that can move independently of one another. Sea horses are weak swimmers that typically live along the shore among seaweed and other plants to which they cling by their tails. When swimming, they maintain an upright position, propelling themselves with their fins, and rising or sinking by altering the volume of gas within their swim bladders. They catch and eat small organisms by sucking them into their mouths. The male incubates the eggs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippocampus"@en .

aat:300261248 a skos:Concept ;
    skos:definition "Textile woven by Igbo women of Nigeria, featuring intricate weft-woven patterns in cotton or rayon over a ground weave in cotton; only commercial machine-woven yarn is used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akwete"@en .

aat:300261251 a skos:Concept ;
    skos:definition "Members of a genus containing three species of large and economically important marine fish, some of which can change color at different water depths, may have distinct color phases, feed on mollusks, crabs, squid, small fish, starfish, and worms; some migrate south in winter to spawn. Other species of fish may have the word \"cod\" in their name, although they are not really cod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gadus"@en .

aat:300261258 a skos:Concept ;
    skos:definition "Members of a species of North Atlantic food fish that are bottom dwellers, having a chin barbel, two anal and three dorsal fins, and ra black lateral line running along its white side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melanogrammus aeglefinus"@en .

aat:300261263 a skos:Concept ;
    skos:definition "General term for several species in different genera in the family Salmonidae, found in both the Atlantic and Pacific Oceans, as well as in the Great Lakes and other land locked lakes. Most species are salt water fish that spawn in fresh water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salmon"@en .

aat:300261270 a skos:Concept ;
    skos:definition "Members of a species of elongated, streamlined bony fish, distinguished by a tall dorsal fin, lack of pelvic fins, lack of scales and teeth in adults, and a long sword extending from its snout, used to slash at prey fish. The sword is flat, rather than rounded as in other spear-nosed fishes (such as the marlin), and thus the fish is sometimes called \"broadbill.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xiphias gladius"@en .

aat:300261373 a skos:Concept ;
    skos:definition "Children in the Yoruba culture of Nigeria Africa, who die young and then are reborn to the same mother, only to repeat the cycle of birth and early death several times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abiku"@en .

aat:300261383 a skos:Concept ;
    skos:definition "The shell of the pearly nautilus, Nautilus macromphalus, native to the tropical Pacific and Indian Oceans, used to make decorative objects such as cups, salts, and jewelry, and as carving material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nautilus shell"@en .

aat:300261401 a skos:Concept ;
    skos:definition "Process in the hand binding of books in which the material covering the spine is pressed and shaped over the bands with band nippers to ensure proper adhesion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nipping up"@en .

aat:300261403 a skos:Concept ;
    skos:definition "Process of applying heavy pressure to something between two surfaces for a brief period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nipping"@en .

aat:300261405 a skos:Concept ;
    skos:definition "In bookbinding, the process of sewing and shaping the spine of a sewn textblock, whereby the back edges of the gatherings are splayed outwards from the center of the back, thus shaping a ridge or shoulder on each side; it is done at the same time as or just after rounding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backing"@en .

aat:300261407 a skos:Concept ;
    skos:definition "In bookbinding, the process of shaping the back of a text block into a convex arc, as by light hammering or by putting it through a rounding or rounding and backing machine, before the block is cased-in; usually performed at the same time or just prior to backing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rounding"@en .

aat:300261413 a skos:Concept ;
    skos:definition "Equipment used to aid the process of securing leaves or gatherings, usually within covers, to form a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookbinding equipment"@en .

aat:300261423 a skos:Concept ;
    skos:definition "Lengths of hard, smooth wood of varying sizes used during the process of covering a book to smooth down the leather on the spine on either side of the bands; may have a groove along one side that fits over a band, facilitating smoothing both sides at once."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandsticks"@en .

aat:300261427 a skos:Concept ;
    skos:definition "Boards, usually with a right-angle projection on one end, used to protect the sides and fore edges of a covered book during tying up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tying-up boards"@en .

aat:300261430 a skos:Concept ;
    skos:definition "Bevelled, wedge-shaped boards of varying sizes usually made of wood and sometimes faced with metal, used in a lying press when backing a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backing boards"@en .

aat:300261463 a skos:Concept ;
    skos:definition "Printing from glass plates, using either intaglio or planographic methods, developed and popularized from 1974 on primarily by Harvey K. Littleton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitreography"@en .

aat:300261465 a skos:Concept ;
    skos:definition "Prints produced by vitreography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitreographs"@en .

aat:300261467 a skos:Concept ;
    skos:definition "Those who make prints using vitreography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitreographers"@en .

aat:300261471 a skos:Concept ;
    skos:definition "The bookbinding process of wrapping cord tightly around a book held between specially shaped boards, the cords running over the spine on either side of the raised bands, over the boards, and under the fore edge of the book, for the purpose of making the covering adhere securely to the boards. May refer also for the process of wrapping cord from head to tail at the spine of a book in order to pinch the headcaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tying up"@en .

aat:300261477 a skos:Concept ;
    skos:definition "Refers to the arching up of the back of the bound text block of a book when the book is opened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throw up"@en .

aat:300261479 a skos:Concept ;
    skos:definition "In bookbinding, the process of sawing grooves in the back of a text block for the reception of cords on which the gatherings are sewn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sawing-in"@en .

aat:300261489 a skos:Concept ;
    skos:definition "The process of attaching boards to a text block by passing the bands or cords on which the text block is sewn through holes cut into the boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacing-in"@en .

aat:300261514 a skos:Concept ;
    skos:definition "The attaching of a strip or strips of material to the back of a text block after sewing, gluing, rounding, and backing, and before casing-in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back lining"@en .

aat:300261522 a skos:Concept ;
    skos:definition "Pieces of material adhered to the back of a text block prior to casing-in, or used to line the inside of the cover along the spine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back linings"@en .

aat:300261531 a skos:Concept ;
    skos:definition "Machine or hand sewing of text blocks without the use of tapes, cords, or other sewing supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French sewing"@en .

aat:300261537 a skos:Concept ;
    skos:definition "In the context of bookbinding, the joining of leaves or gatherings together one by one by drawing thread or wire backwards and forwards through the back folds of each sheet to attach it to the cords. It is distinct from \"stitching,\" which, in the context of bookbinding, is used for fastening together a number of leaves or gatherings by passing the thread or wire through all of them at once."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing"@en .

aat:300261538 a skos:Concept ;
    skos:definition "In the context of bookbinding, the fastening together of a number of leaves or gatherings by passing the thread or wire through all of the sheets at once; it is distinct from \"sewing,\" which, in the context of bookbinding, is used for the joining of leaves or gatherings together one by one by drawing thread or wire backwards and forwards through the back fold of each sheet to attach it to the cords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stitching"@en .

aat:300261540 a skos:Concept ;
    skos:definition "The technique of sewing a text block, usually by hand and generally on cords or tapes, in which one length of thread passes through each sewing station within a single gathering, from kettle stitch to kettle stitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "all along"@en .

aat:300261551 a skos:Concept ;
    skos:definition "Bookbinding sewing in which the needle is passed through leaves or gatherings placed face to face with the edges together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oversewing"@en .

aat:300261555 a skos:Concept ;
    skos:definition "Bookbinding stitching technique in which stitches pass close to and over the binding edges, creating gatherings which are then sewn all along. In addition to sewing through the fold, the first and last signatures of a book are overcast to strengthen them against the volume's opening and closing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overcasting"@en .

aat:300261564 a skos:Concept ;
    skos:definition "Refers to linked stitches, often chain stitches, made by hand at the head and tail of a text block, joining each gathering to the one next to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kettle stitches"@en .

aat:300261572 a skos:Concept ;
    skos:definition "Places on the back of a text block where the sewing needle emerges from or passes into the leaves or gatherings, generally designated during marking up."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing stations"@en .

aat:300261575 a skos:Concept ;
    skos:definition "Adhesive binding method in which loose leaves are fanned in one direction then passed over a glue roller, so that the adhesive penetrates between the leaves; the leaves are then fanned in the other direction and passed over the glue roller again, so that both sides of the binding edge of each leaf are coated and adhere to the adjoining leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double fan adhesive binding"@en .

aat:300261655 a skos:Concept ;
    skos:definition "Proprietary technique for document repair and restoration, developed by William J. Barrow in the mid-20th century, in which documents are deacidified, then laminated under heat and pressure between sheets of tissue and cellulose acetate film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barrow method"@en .

aat:300261674 a skos:Concept ;
    skos:definition "Method of hand sewing a text block in which two gatherings are sewn together by a single length of thread; the thread passes between them at alternate sewing stations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-on"@en .

aat:300261691 a skos:Concept ;
    skos:definition "Process of attaching a worked headband to the text block, by looping the thread used in forming the headband down the back to a point below the kettle stitch, through the fold of the gathering, and then back up to be wound around the core of the headband; it may be done through all or only every few gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tying down"@en .

aat:300261696 a skos:Concept ;
    skos:definition "Exhibitions of clothing on live models, usually on a runway or stage, typically given by a retail store, designer, or manufacturer to promote fashion merchandise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion shows"@en .

aat:300261705 a skos:Concept ;
    skos:definition "Refers to the process of attaching headbands to the head and tail of a text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headbanding"@en .

aat:300261706 a skos:Concept ;
    skos:definition "Refers generally to the process of striking something repeatedly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beating"@en .

aat:300261718 a skos:Concept ;
    skos:definition "The sequence of processes involved in binding a book following the sewing or stitching of the text block up to and including covering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forwarding"@en .

aat:300261720 a skos:Concept ;
    skos:definition "The process of evening up and squaring the edges of a text block by tapping it at the head and spine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knocking up"@en .

aat:300261722 a skos:Concept ;
    skos:definition "Use generally for the process of making relatively minor repairs to an object, as by darning, patching, or joining pieces back together, without replacing large portions of the object. In the context of book and paper conservation, use specifically for repairs that do not involve the replacement of any of the original material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mending"@en .

aat:300261726 a skos:Concept ;
    skos:definition "Use generally for removing or reducing a layer or edge of a material or object. Use specifically in the context of bookbinding for the process of cutting away or shaving the flesh side of leather used to cover the boards, or of beveling the edges of such leather to provide a neat turn-in over the boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paring"@en .

aat:300261729 a skos:Concept ;
    skos:definition "The process of covering a portion of the outside surface of the boards of a book with a material different from and contrasting with that already applied to the spine and part of the boards, as in half, quarter, and three-quarter binding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siding"@en .

aat:300261733 a skos:Concept ;
    skos:definition "Attaching silk chiffon or other fine, transparent material to one or both sides of a sheet of paper in order to strengthen, repair, or preserve it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silking"@en .

aat:300261739 a skos:Concept ;
    skos:definition "Plumes made of feathers, often three, used as an ornament on top of a helmet, hat, or cap or as a headdress. Common also as a heraldic device and as an ornamental motif on furniture and other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panaches"@en .

aat:300261742 a skos:Concept ;
    skos:definition "Thin, U-shaped pieces of metal or wood that are placed between the sewing supports and boards at the back of a text block to temporarily flatten the rounded back so that the foredge may be trimmed or decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trindles"@en .

aat:300261744 a skos:Concept ;
    skos:definition "Spiral disks made from the base of the shell of the marine snail species Conus. and worn as ornaments or to indicate status, especially in Africa. Use also for similar disks of ceramic or glass made in imitation of these disks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cone shell disks"@en .

aat:300261765 a skos:Concept ;
    skos:definition "Headbands worked on two cores, usually one being smaller than the other and placed either above, or below and in front of the other one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double headbands"@en .

aat:300261769 a skos:Concept ;
    skos:definition "Headbands that are attached to the text block by means of glue or other adhesive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuck-on headbands"@en .

aat:300261776 a skos:Concept ;
    skos:definition "The row of small twists or rolls at the base of a hand-sewn headband formed by passing one thread over the top of the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead"@en .

aat:300261780 a skos:Concept ;
    skos:definition "Stitches that secure a worked headband to the text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie downs"@en .

aat:300261788 a skos:Concept ;
    skos:definition "Health sciences discipline that uses gardens, plants, and horticultural activities to promote improvement in the physical and psychological well-being of patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horticultural therapy"@en .

aat:300261796 a skos:Concept ;
    skos:definition "Those professionally engaged in the field of horticultural therapy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horticultural therapists"@en .

aat:300261803 a skos:Concept ;
    skos:definition "Gardens designed to improve or maintain the physical and mental health of the ill or injured, including gardens serving as clinical tools in horticultural therapy. For gardens designed for use by the handicapped or the elderly, use \"enabling gardens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "healing gardens"@en .

aat:300261815 a skos:Concept ;
    skos:definition "Folded books developed in China and Japan, in which individual folded sheets are gathered into a text block with the folds at the back. Adhesive is applied between the sheets along the outside of the folds to attach adjacent sheets to each other; the cover is adhered to the first and last leaves but not to the spine. When the book is opened, each pair of adhered pages stands out at an angle like the wings of a butterfly, with two pages of text alternating with two blank pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detchos"@en .

aat:300261817 a skos:Concept ;
    skos:definition "Folded books developed in Japan and China in which the text block is composed of individual folded sheets, gathered so that the folds are at the back while, at the fore edge, the edge of one leaf of each folded sheet is adhered to the edge of the adjacent leaf. The text block is covered by a single sheet adhered to the first and last leaves but not attached to the spine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sempu-yo"@en .

aat:300261824 a skos:Concept ;
    skos:definition "An early British building material composed of hard clay or chalk, or of soft white limestone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clunch"@en .

aat:300261825 a skos:Concept ;
    skos:definition "Soft, durable, fine-grained, nonporous colored leather, vegetable-tanned and curried, made originally solely from the outer layer of horsehide rumps, later also from goatskin and pigskin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cordovan"@en .

aat:300261855 a skos:Concept ;
    skos:definition "Refers to earthenware produced by Josiah Wedgewood from 1779, distinguished from his creamware by having a greater percentage of flint and white clay in the body and a trace of cobalt oxide in the glaze which gives it a bluish white cast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearlware"@en .

aat:300261859 a skos:Concept ;
    skos:definition "The shell of various marine snails of the genus Conus and family Conidae, typically straight-sided with tapering body whorl, low spire, and narrow opening, and of vivid colors and eccentric markings; it is valued as a material for bracelets, disks, and other ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cone shell"@en .

aat:300261872 a skos:Concept ;
    skos:definition "Lever-type cutters often mounted on a flat bed and equipped with a foot-operated clamp; used for cutting boards or similar materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board cutters"@en .

aat:300261887 a skos:Concept ;
    skos:definition "Devices designed for scratching one's own back; often in the form of a small hand mounted on a long handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back scratchers"@en .

aat:300261900 a skos:Concept ;
    skos:definition "Sound modifying devices which incorporate mirlitons set in vibration by the human voice, and used to disguise the voice of the user; in Africa they are often employed in the context of masquerades, ceremonies, and rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voice disguisers"@en .

aat:300261905 a skos:Concept ;
    skos:definition "Long, loose-fitting garments with hoods and usually long sleeves, worn over other garments, traditionally by men, chiefly in Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jlaleb"@en .

aat:300261922 a skos:Concept ;
    skos:definition "Copper alloy vessels cast by the lost-wax process and used by the Akan peoples of Ghana to hold valuables such as gold dust or beads, and to serve several ritual purposes; of various forms and styles and often with a hinged lid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuduo"@en .

aat:300261924 a skos:Concept ;
    skos:definition "Hinged plastic cases used to store compact disks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewel cases"@en .

aat:300261934 a skos:Concept ;
    skos:definition "Technique used to create images of objects, structures, or other features located underground at relatively shallow depths, by bouncing sound waves off the features from several different positions, collecting and processing the signals to get a number of partial views, then focusing and combining these partial views to create a complete image; developed by Alan J. Witten between 1984 and 1987."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geophysical diffraction tomography"@en .

aat:300261945 a skos:Concept ;
    skos:definition "Those trained for or engaged in the physical combat of warfare, especially close hand-to-hand combat, and designated for or sanctioned in that function by the society or group for which they fight, irrespective of membership in an army. Includes men of the warrior age grade in certain pre-literate societies, as for instance, among some East African pastoral societies. For members of an army, whether directly involved in combat or in other duties, use \"soldiers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warriors"@en .

aat:300261949 a skos:Concept ;
    skos:definition "Bottoms of glass cups or bowls decorated with designs in engraved gold leaf backed by a protective layer of fused, sometimes tinted, glass; they were first made during the Roman Empire from the third to the early fifth centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fondi d'oro"@en .

aat:300261951 a skos:Concept ;
    skos:definition "Cutting machines consisting essentially of a single heavy blade that descends between vertical guides to cut or trim paper, metal, or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guillotines"@en .

aat:300261954 a skos:Concept ;
    skos:definition "Containers shaped like deep, lidded glass jars, designed to serve pickles. Pickle casters were typically placed in a silver or silver-plated frame with a handle, sometimes in pairs; often with matching tongs or forks, which hang from the frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickle casters"@en .

aat:300261961 a skos:Concept ;
    skos:definition "Cases designed to hold portrait photographs, usually daguerreotypes or ambrotypes. The case was customarily made of leather or another material, hinged, opening like a book, with velvet or another covering applied to the interior surface facing the image, and the outside surfaces decorated with relief designs. The design was patented in the United States by Samuel Peck in 1854."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Union cases"@en .

aat:300261971 a skos:Concept ;
    skos:definition "The process of designing and usually arranging human hair, either natural or artificial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairstyling"@en .

aat:300261977 a skos:Concept ;
    skos:definition "Hairstyling process in which hair is parted into rows and braided firmly on the surface of the scalp into various patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornrowing"@en .

aat:300261983 a skos:Concept ;
    skos:definition "The process of carving away and shaping the layered gesso covering the carved ornament on a wooden picture frame so as to sharpen and, often, add detail prior to the gilding of the frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reparure"@en .

aat:300261984 a skos:Concept ;
    skos:definition "Craftsmen who practice the art of reparure, which is the process of carving away and shaping the layered gesso covering the carved ornament on a wooden picture frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repareurs"@en .

aat:300261990 a skos:Concept ;
    skos:definition "Strongly adhesive, waterproof cloth tape, usually coated on the cloth side with a thermoplastic such as polyethylene. Most often used for sealing ducts against moisture and air leaks, but also used for more general purposes. The 3-ply product was initially composed of a plastic cellulose nitrate laminated cotton strips coated with a rubber-based adhesive. Within a short time, the plastic coating was switched to polyethylene to increase water resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duct tape"@en .

aat:300262022 a skos:Concept ;
    skos:definition "Generally meaning the state of being of mixed origin. In a social or cultural context, refers to the concept of individual or group self-identity or creative activity deriving from the interaction of two different societies or cultures, often within the context of Third World people encountering Western or Westernized people, or the formerly colonized meeting the colonizers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hybridity"@en .

aat:300262026 a skos:Concept ;
    skos:definition "Beads used as exchange media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade beads"@en .

aat:300262035 a skos:Concept ;
    skos:definition "Refers to the political theory or belief that the focus of political activities should be the universal human condition rather than the interests of a particular nation. For the similar philosophical approach not limited to the context of politics but discussed or applied in a broader social, cultural, scientific, ecological, or humanistic context, see \"globalism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internationalism"@en .

aat:300262038 a skos:Concept ;
    skos:definition "The process of dividing something into two equal or nearly equal parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bisecting"@en .

aat:300262042 a skos:Concept ;
    skos:definition "Air cooling systems that operate without power-driven mechanical devices, utilizing instead natural means such as evaporation, condensation, radiation, convection, and earth sheltering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passive cooling"@en .

aat:300262176 a skos:Concept ;
    skos:definition "C-shaped metal bars (usually of copper or copper-alloy) of varying weights used as money in West Africa; originally imported from Europe, later alter cast (or re-cast) and used as a medium of exchange locally in West Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manillas"@en .

aat:300262203 a skos:Concept ;
    skos:definition "Protective screens made of woven or linked metal or other nonflammable material, placed in front of fireplace openings to prevent logs, sparks, or embers from escaping. For furniture used to protect occupants of the room from the full heat of the fire, use \"fire screens (furniture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire screens"@en .

aat:300262233 a skos:Concept ;
    skos:definition "Small, thin-bladed, usually straight knives, sometimes with changeable blades, used for precise cutting or delicate removal of one material from another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scalpels"@en .

aat:300262235 a skos:Concept ;
    skos:definition "Finishing tools consisting of a metal block with a long narrow face bearing lines or designs and mounted on a handle; used for decorating the covers of books. ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pallets"@en .

aat:300262237 a skos:Concept ;
    skos:definition "Small, thin instruments with usually tapered edges and rounded or tapered ends used for folding, smoothing, burnishing, and other operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folders"@en .

aat:300262244 a skos:Concept ;
    skos:definition "Thin metal plates of tin or zinc used during pressing to ensure even distribution of pressure, to protect the textblock from moisture, and to prevent the indentations of the turn-ins from marking the textblock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressing tins"@en .

aat:300262254 a skos:Concept ;
    skos:definition "Refers to the hardware required to display or use audiovisual materials such as filmstrip viewers, projection equipment, videocassette recorders, and compact disk players."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiovisual equipment"@en .

aat:300262271 a skos:Concept ;
    skos:definition "Objects consisting of a long shaft with a bent or hooked end, usually of wood or metal, that are used to catch or hold another object, especially those used to restrain livestock or to gather hay while reaping. Employed in some cultures as a symbolic or ritual object, such as those used by the Yona Society of the Dogon people, in Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crooks"@en .

aat:300262402 a skos:Concept ;
    skos:definition "Composite material made from scrap leather pieces mixed with white adhesive, which is then pressed and dried and the surface shaved or planed; developed in the mid-20th century by English bookbinder Philip Smith."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maril"@en .

aat:300262415 a skos:Concept ;
    skos:definition "Parts or components of organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organ components"@en .

aat:300262450 a skos:Concept ;
    skos:definition "Painting of the body, either in connection with ceremonies, festivals, or other special events, or for reasons of personal decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body painting"@en .

aat:300262452 a skos:Concept ;
    skos:definition "Refers to permanent marks, such as symbols, patterns, or other designs, made on human skin by scarring, done for social or cultural reasons or for personal decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarifications"@en .

aat:300262467 a skos:Concept ;
    skos:definition "Permanent marking of the human body, as with symbols, patterns, or other designs, by means of producing raised scars, done for social or cultural reasons or for adornment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarification"@en .

aat:300262468 a skos:Concept ;
    skos:definition "Intentional permanent or semi-permanent modifications of the living human body for religious, aesthetic, or social reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body modification"@en .

aat:300262469 a skos:Concept ;
    skos:definition "Sudden occurrences of violent expansion or bursting, intentional or accidental, caused by rapidly-developed internal energy, as by chemical or nuclear reaction, or esape of gases or vapors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "explosions"@en .

aat:300262472 a skos:Concept ;
    skos:definition "Oriental Orthodox Christian religion established in Ethiopia in the 9th century CE, and practiced to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ethiopian Orthodox"@en .

aat:300262475 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bulahay"@en .

aat:300262476 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mafa"@en .

aat:300262477 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living primarily in southwestern Chad, with smaller numbers in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mundang"@en .

aat:300262478 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living mainly in Ethiopia but also in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oromo"@en .

aat:300262479 a skos:Concept ;
    skos:definition "Traditional Igbo women's art and practice of painting on the body and the walls of shrines and houses, using primarily indigo and earth pigments, and featuring curvilinear abstract, occasionally figurative designs; now also incorporated into contemporary Nigerian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uli"@en .

aat:300262480 a skos:Concept ;
    skos:definition "Refers to a type of modern cast glass that is made by pouring molten glass into molds, creating a thick glass that may have a chipped or faceted surface. It is used primarily in construction, for example, to create floors or windows set in concrete, sometimes resembling stained glass. It was invented in France around 1900 as a form of paving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slab glass"@en .

aat:300262481 a skos:Concept ;
    skos:definition "The state or status of being a full member of a political community with all attendant rights, responsibilities, and privileges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citizenship"@en .

aat:300262482 a skos:Concept ;
    skos:definition "The action or process of creating or forming into a legal corporation or community; common examples of incorporation include cities, towns, or businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incorporation"@en .

aat:300262483 a skos:Concept ;
    skos:definition "Any of various siliceous, open-textured types of limestone or sandstone; uses include for millstones and as building material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buhrstone"@en .

aat:300262484 a skos:Concept ;
    skos:definition "Glassy or crystalline material formed in or around meteor craters by the fusion of Earth rock and meteorite fragments upon impact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impactite"@en .

aat:300262485 a skos:Concept ;
    skos:definition "The largest type of tureen, said to have been used originally to serve a particular kind of Spanish stew; they are commonly of round body resting on feet or a pedestal, with two handles and a cover, usually made of silver but sometimes of porcelain; most examples date from the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pots-à-oille"@en .

aat:300262486 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Northwest Province of Cameroon, and seasonally in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yamba"@en .

aat:300262487 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living generally as hunters and gatherers in the western highlands of Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Okiek"@en .

aat:300262488 a skos:Concept ;
    skos:definition "Style and culture of people speaking a Bantu language called \"Mongo\" and living in the Democratic Republic of the Congo (formerly Zaire). This includes any of several peoples living in the African equatorial forest, south of the main Congo River bend and north of the Kasai and Sankuru rivers in Congo (Kinshasa), such as the ethnic groups Bokote, Ekonda, Bolia, Sengele, Ntomba, Ndengese, Songomeno, Mbole, Bongandu, Boyela, Nkutu, and Tetela-Kusu. They speak dialects of a common language, Mongo or Nkundo, which belongs to the Benue-Congo branch of the Niger-Congo languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mongo"@en .

aat:300262489 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, a subgroup of the Mongo inhabiting northwestern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolemba"@en .

aat:300262490 a skos:Concept ;
    skos:definition "Works produced by the African ethnic group of the same name residing in Cameroon, Congo, and Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bumali"@en .

aat:300262491 a skos:Concept ;
    skos:definition "Sculpture that serves as a memorial to beings or events, not necessarily in the context of gravesites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative sculpture"@en .

aat:300262492 a skos:Concept ;
    skos:definition "Anthropomorphic carved posts of the Mijikenda of the East African nation of Kenya, made to commemorate deceased members of the men's Gohu society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vigango"@en .

aat:300262495 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in central western Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nkoya"@en .

aat:300262496 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kawendi"@en .

aat:300262497 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in central Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadza"@en .

aat:300262498 a skos:Concept ;
    skos:definition "Carved portrait figures of kings of the African kingdom of Kuba, typically depicted sitting cross-legged, wearing royal regalia, and grasping a knife; at the front of the base is a small carved object serving as the unique symbol identifying the particular king."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ndop"@en .

aat:300262499 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwere"@en .

aat:300262500 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alago"@en .

aat:300262501 a skos:Concept ;
    skos:definition "Style and culture of the ethnic group of the same name living in Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antankarana"@en .

aat:300262502 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the border area between Zambia and the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aushi"@en .

aat:300262503 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Nigeria, historically the same group as the neighboring Tumbuka across the border in what is now modern Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyasa"@en .

aat:300262504 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, a sub-group of the San living in Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarwa"@en .

aat:300262505 a skos:Concept ;
    skos:definition "Buffer of an alkaline substance added to materials such as paper to counteract the formation or introduction of acid. The alkaline reserve is intended to neutralize future acidic components that may otherwise accumulate. As cellulosic materials are very sensitive to acid degradation, an alkaline reserve is sometimes added to archival papers and treated papers to minimize acid produced embrittlement, yellowing, and deterioration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkaline reserve"@en .

aat:300262506 a skos:Concept ;
    skos:definition "The condition of being understandable in two or more ways, as, for example in two or more different social or historical contexts, or of referring to two or more things at the same time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambiguity"@en .

aat:300262508 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ila"@en .

aat:300262509 a skos:Concept ;
    skos:definition "Organic red pigment obtained from the wood of either barwood or camwood, used as cosmetic, as a red dye, or sculpted into ceremonial pigment blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tukula"@en .

aat:300262510 a skos:Concept ;
    skos:definition "Hardwood from the West African Baphia nitidia tree, having various uses, including for house posts and rafters, walking sticks, medicines, and pigment. For similar wood of various species of the genus Pterocarpus, use \"barwood.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camwood"@en .

aat:300262511 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolewa"@en .

aat:300262512 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minungo"@en .

aat:300262513 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Côte d'Ivoire, neighboring the Baule and the Guro, known for their masks and masquerades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wan"@en .

aat:300262514 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betsileo"@en .

aat:300262515 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nandi"@en .

aat:300262516 a skos:Concept ;
    skos:definition "Carved or sculpted blocks of pigment that are valued as sculpture rather than, or in addition to, for their use as a pigment. Prominent examples are those made by made by the Kuba peoples of the African nation of the Democratic Republic of Congo from dried tukula paste mixed with other ingredients such as sand, water, and palm oil. They are used as commemorative tokens of their deceased owners, and may be moistened and rubbed to remove pigment for use. The creation of carved blocks of pigment is also known in other cultures, including very ancient examples; some scholars believe Neanderthals carved pigment blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigment blocks"@en .

aat:300262517 a skos:Concept ;
    skos:definition "Pottery drinking or serving vessels in the form of a human figure, usually a stout seated man holding a mug and wearing a three-cornered hat, first manufactured in England in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toby jugs"@en .

aat:300262519 a skos:Concept ;
    skos:definition "Generally, those who inform others of some fact or occurrence. In the context of law enforcement and the judiciary, connotes those who lay information against other persons. In the context of anthropology, linguistics, art history, and other cultural studies, refers to those who assist investigators by providing information from their specialized or native knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "informants"@en .

aat:300262520 a skos:Concept ;
    skos:definition "Representations of the heads of humans, animals, or mythical or legendary beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heads"@en .

aat:300262524 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in southwestern Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antaimoro"@en .

aat:300262525 a skos:Concept ;
    skos:definition "Styles belonging to Central Côte d'Ivoire cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Côte d'Ivoire styles"@en .

aat:300262526 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mwan"@en .

aat:300262527 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in eastern Liberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Krahn"@en .

aat:300262528 a skos:Concept ;
    skos:definition "Masquerades of the Lunda, Luvale, Chowke, Mbunda, Bakangala, and Luchazi peoples of Africa associated with the circumcision ceremony Mukanda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "makishi"@en .

aat:300262529 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name inhabiting the coastal region of Western Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ga-Adangme"@en .

aat:300262530 a skos:Concept ;
    skos:definition "Small farmhouses common in Scotland, typically one or one and one-half stories, constructed of stone and thatching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "croft houses"@en .

aat:300262532 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Burkina Faso primarily, with smaller numbers in Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gurma"@en .

aat:300262533 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamberi"@en .

aat:300262535 a skos:Concept ;
    skos:definition "Style and culture of the many African ethnic groups who inhabit this highland area in western Cameroon and who share similar stylistic characteristics, forms, and motifs in their art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cameroon Grassfields"@en .

aat:300262536 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marghi"@en .

aat:300262537 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sanwi"@en .

aat:300262538 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kenga"@en .

aat:300262539 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting eastern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Krachi"@en .

aat:300262540 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vagala"@en .

aat:300262541 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting south-central Cameroon, northern Río Muni in Equatorial Guinea, and northwestern Gabon. Works in this style are known for their elongated morphology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ntumu"@en .

aat:300262542 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in southeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yako"@en .

aat:300262543 a skos:Concept ;
    skos:definition "Works produced by the African ethnic group of the same name, inhabiting southwestern Ethiopia primarily and also Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dasenech"@en .

aat:300262544 a skos:Concept ;
    skos:definition "Works produced by the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rangi"@en .

aat:300262545 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southern Burkina Faso and northern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kassena"@en .

aat:300262546 a skos:Concept ;
    skos:definition "Works produced by the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sagara"@en .

aat:300262547 a skos:Concept ;
    skos:definition "Styles belonging to Cameroon cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cameroon styles"@en .

aat:300262548 a skos:Concept ;
    skos:definition "Obstructions hastily put in place, as in a street, to stop an enemy's advance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barricades"@en .

aat:300262549 a skos:Concept ;
    skos:definition "Styles belonging to Lower Zambezi River region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Zambezi River region styles"@en .

aat:300262554 a skos:Concept ;
    skos:definition "Styles belonging to Upper Zambezi River region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upper Zambezi River region styles"@en .

aat:300262555 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group collective of the same name living in eastern Senegal, Guinea-Bissau, and western Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tenda"@en .

aat:300262556 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name living in eastern Senegal, Guinea-Bissau, and western Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Badyaranke"@en .

aat:300262557 a skos:Concept ;
    skos:definition "Style and culture of the ethnic group of the same name living in eastern Senegal, Guinea-Bissau, and western Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bedik"@en .

aat:300262558 a skos:Concept ;
    skos:definition "Establishments for the breeding and boarding of cats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catteries"@en .

aat:300262559 a skos:Concept ;
    skos:definition "Hard ovoid-shaped drupes (stone fruit) of the coconut palm (Cocos nucifera) native to the tropics. Coconuts have a fibrous outer husk and a woody inner shell that contains the coconut meat and white juice. Coconut shells range in diameter from 8 to 14 inches. Despite its name, the coconut is not classified as a nut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coconuts"@en .

aat:300262560 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahi"@en .

aat:300262561 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pabir"@en .

aat:300262562 a skos:Concept ;
    skos:definition "Hagiographies devoted to the life of a single saint, and often containing additional material such as liturgical texts, letters, or music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libelli"@en .

aat:300262563 a skos:Concept ;
    skos:definition "Decorated cosmetic containers made by African Akan metalsmiths from imported sheet brass and primarily used to store shea butter and sometimes, to store gold weights, gold dust, and other valuables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forowa"@en .

aat:300262564 a skos:Concept ;
    skos:definition "Material comprising the usually hard outer covering of a fruit, nut, or seed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell"@en .

aat:300262565 a skos:Concept ;
    skos:definition "Carved figures, usually of steatite, produced by the Kongo peoples of northern Angola and lower Congo, for the purpose of serving as watchmen over the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mintadi"@en .

aat:300262566 a skos:Concept ;
    skos:definition "Sculpture used to contain potent medicines that are associated with spiritual or healing power, often taking the form of carved wooden figures or assemblages of objects, such as bundles, shells, pots, and amulets. Originating in the Congo region of Africa, their use in divination, protection, and healing rites has been carried to Cuba, Haiti, Brazil, and the American South."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minkisi"@en .

aat:300262567 a skos:Concept ;
    skos:definition "Very large cylindrical beakers or steins, usually made of glass but also ceramic or metal, often decorated with enamel or engraving. They were used for drinking beer and wine, made in Germany from the 16th century onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Humpen"@en .

aat:300262568 a skos:Concept ;
    skos:definition "Small, leafy stemmed, flowerless plants of the class Musci, reproducing by spores and usually found in tufts, mats or sod on moist ground, tree trunks or rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moss"@en .

aat:300262569 a skos:Concept ;
    skos:definition "Material, usuallly chips or sticks of wood, used for filling holes or cracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinking"@en .

aat:300262570 a skos:Concept ;
    skos:definition "Log-frame houses, common in Northern Russia, primarily rural, but found in urban areas until the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isbas"@en .

aat:300262571 a skos:Concept ;
    skos:definition "Straps, usually of leather or woven horse hair, that encircle the body of a horse or other animal to fasten a saddle upon its back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinches"@en .

aat:300262572 a skos:Concept ;
    skos:definition "Hand-held, flat objects used for writing or drawing, either directly, or as a flat, rigid support for another surface such as paper. If written upon directly, the tablets are typically coated with a substance such as clay, plaster, or wax upon which the characters or depictions are incised with a stylus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing tablets"@en .

aat:300262573 a skos:Concept ;
    skos:definition "Islamic writing boards used in Qur'anic schools upon which pupils write verses from the Qur'an as a means of rote learning. Also used as devotional objects, and by diviners in magical practices involving inscriptions and symbols written upon the boards, both Qur'anic and from other sources. Typically they have crescents carved at the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qur'anic boards"@en .

aat:300262574 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in eastern Senegal, Guinea-Bissau, and western Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bassari"@en .

aat:300262576 a skos:Concept ;
    skos:definition "Building material comprising rubble or roughly cut stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubblework"@en .

aat:300262577 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo south of the Kasai River between the Loange and Kamtsha Rivers, also west of the Kamtsha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dzing"@en .

aat:300262580 a skos:Concept ;
    skos:definition "Crucifixes that are specifically designed to be permanent adjuncts to the altar in a Roman Catholic church, traced back to at least the 13th century. They are prescribed to be placed at the middle of the altar between the candlesticks, of a size large enough to be conveniently seen by both the celebrant and the congregation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar crosses"@en .

aat:300262581 a skos:Concept ;
    skos:definition "General term for the period and culture of the Middle East as described in the Biblical Old Testament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Testament"@en .

aat:300262583 a skos:Concept ;
    skos:definition "Style and culture of the people of Senegal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Senegalese"@en .

aat:300262584 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name currently living in southern Ghana, formerly constituting a famous kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Denkyira"@en .

aat:300262585 a skos:Concept ;
    skos:definition "Representations of the fall of cloth, as depicted in visual art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drapery"@en .

aat:300262586 a skos:Concept ;
    skos:definition "Style and culture a kingdom established by the Dyula in the 17th century in Gonja, the Sudan, western Africa. It was a territory that the northern traders had to cross to reach the Akan forestlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gonja Kingdom"@en .

aat:300262587 a skos:Concept ;
    skos:definition "Bowl-shaped basketry pot-lids made and used by the Zulu and other southern African peoples, traditionally fabricated of grasses, or, in recent times, of colored telephone wire. They are also sometimes used as dishes to hold small items or dry foodstuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "izi-mbenge"@en .

aat:300262588 a skos:Concept ;
    skos:definition "Styles and cultures belonging to modern Africa, generally from the 19th century and later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern African"@en .

aat:300262589 a skos:Concept ;
    skos:definition "Styles and culture belonging to modern East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern East African"@en .

aat:300262590 a skos:Concept ;
    skos:definition "Style of modern Makonde sculpture depicting devils or folk spirits, featuring distorted, exaggerated, or abstract forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shetani"@en .

aat:300262591 a skos:Concept ;
    skos:definition "Sculpture styles belonging to modern Makonde cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern Makonde sculpture styles"@en .

aat:300262592 a skos:Concept ;
    skos:definition "Masquerades particularly for children. Primary examples are masquerades performed by young African boys, either as part of initiation rites or as entertainment; they are sometimes considered as training for adult masquerades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's masquerades"@en .

aat:300262593 a skos:Concept ;
    skos:definition "Carved wooden masks of the Songye people of the Democratic Republic of Congo in Africa, existing in both \"female\" and \"male\" types; the female type is used in burial rituals and the consecration of new chiefs, while the male type is used to impose discipline among the ranks of the circumcised. In form they are distinguished by prominent facial features, often including a crest, and stripes of black, red, and white. They embody attributes of the human, the animal, and the spirit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bifwebe"@en .

aat:300262594 a skos:Concept ;
    skos:definition "Hotels that cater primarily to Japanese commuters who have missed the last train home to the suburbs; rooms are single- occupant capsules equipped with color TVs, radios, ventilation, and alarm clocks usually stacked on two levels in long rows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capsule hotels"@en .

aat:300262595 a skos:Concept ;
    skos:definition "Construction technique where the facade of a building is designed or constructed separately from the rest of a building, or where the front elevation of an older building is preserved with a new building constructed behind it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facadism"@en .

aat:300262596 a skos:Concept ;
    skos:definition "A method of painting in oils underwater developed in the 18th century by Arnaud Vincent de Montpetit. Montpetit believed that this technique of painting would preserve a work and eliminate the need for restoration in the future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eludoric painting"@en .

aat:300262597 a skos:Concept ;
    skos:definition "Women who were part of the colonial Dutch household in the Dutch East Indies (modern-day Indonesia); they were kept as housekeepers, companions, and concubines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nyais"@en .

aat:300262598 a skos:Concept ;
    skos:definition "Style and culture of the small African highland society inhabitng the Mandara highlands in Adamawa state in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sukur"@en .

aat:300262599 a skos:Concept ;
    skos:definition "Doors decorated with icons, located in the center of iconostases, which typically have three doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal doors"@en .

aat:300262600 a skos:Concept ;
    skos:definition "Vessels for hot water, with a shaped opening, used to warm the bowls of spoons at the table. Found in a variety of fanciful shapes, often animals, and generally of silver or ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spoon warmers"@en .

aat:300262601 a skos:Concept ;
    skos:definition "Poetry in which sound is the primary element. Sound poetry is often performed or is experienced via audio recordings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound poetry"@en .

aat:300262602 a skos:Concept ;
    skos:definition "Species of tall, robust, leafless aquatic plant growing to 5 m (16 feet) in height, forming a grass-like clump of green stems, triangular in cross section, that rise up from thick, woody rhizomes. Each stem is topped by a dense cluster of thin, bright green stems. It is edible to humans. It was cultivated in ancient Egypt, collected for its stalk or stem, the central pith of which was cut into thin strips, assembled in layers at right angles, pressed together, and dried to form a smooth, thin writing surface as early as the 3rd millennium BCE. Its use spread to the Greeks and then to the Roman Empire. Papyrus can darken and discolor with age. Other products were boats, sails, and cords. The species is now almost extinct in Egypt, but still of importance elsewhere in Africa as a fuel source. It is cultivated throughout the tropics; popular as an ornamental in Europe, Asia, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyperus papyrus"@en .

aat:300262606 a skos:Concept ;
    skos:definition "Tombs of martyrs or confessors, sometimes with altars erected over them, in which case, the name was extended to both the altar and the subterranean chamber containing the relics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confessions"@en .

aat:300262607 a skos:Concept ;
    skos:definition "Drawn-glass beads with an internal structure of multiple, pleated layers in different colors, creating a two-dimensional star-like pattern of chevrons around the central hole, and stripes on the sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevron beads"@en .

aat:300262609 a skos:Concept ;
    skos:definition "One or more animal skins inflated to serve as a vessel for water crossing, in parts of Africa and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inflated skins"@en .

aat:300262611 a skos:Concept ;
    skos:definition "Mills consisting of one or more boats equipped with waterwheels, moored in mid-stream by connections to the bank and used for various purposes including grinding grain or paper pulp and supporting military machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating mills"@en .

aat:300262612 a skos:Concept ;
    skos:definition "Style and culture of the large cluster of African ethnic groups collectively referred to as the Nguni, inhabiting southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nguni"@en .

aat:300262613 a skos:Concept ;
    skos:definition "Bussiness enterprises providing modes of transportation for hire, most commonly automobiles and boats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liveries"@en .

aat:300262614 a skos:Concept ;
    skos:definition "Printed documents containing the names, descriptions, and wage information of every member of a ship's company, including the master's name and the ship's name, destination, and tonnage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crew lists"@en .

aat:300262616 a skos:Concept ;
    skos:definition "Barge-like, flat-bottomed sailing ships common to the Netherlands from the Middle Ages to the end of the 19th century, used for fishing and river and costal transport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aaks"@en .

aat:300262617 a skos:Concept ;
    skos:definition "The absence of clothing, leaving those parts of the body that, in the cultural traditions of the viewer, are usually covered, exposed to view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nudity"@en .

aat:300262618 a skos:Concept ;
    skos:definition "Boat racing, commonly with dinghies, during late fall, winter and early spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frostbiting"@en .

aat:300262619 a skos:Concept ;
    skos:definition "Medieval overgarments, typically short, with round neckline and high collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courtepy"@en .

aat:300262620 a skos:Concept ;
    skos:definition "Sports jackets or coats, typically made of tweed or wool, and worn when shooting or hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shooting jackets"@en .

aat:300262621 a skos:Concept ;
    skos:definition "Robes or loose light garments worn with a short cape or scarf over the shoulders; worn by clergy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simars"@en .

aat:300262623 a skos:Concept ;
    skos:definition "Hosiery worn by European men in the 16th and 17th centuries, covering the upper leg, thighs and buttocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper stocks"@en .

aat:300262624 a skos:Concept ;
    skos:definition "Hosiery worn by European men in the 16th and 17th centuries, typically made of silk or wool, and covering the lower leg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "netherstocks"@en .

aat:300262625 a skos:Concept ;
    skos:definition "Short breeches worn by European men in the 16th and 17th centuries, covering the body from the waist to the middle of the thigh. They were sometimes stuffed, varied from tight- to loose-fitting, and were joined to the stocking portion near the fork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trunk hose"@en .

aat:300262626 a skos:Concept ;
    skos:definition "Stylized stoneware vessels depicting a human face, with white clay inserted for eyes and teeth. Manufactured by African Americans in South Carolina, and possibly Alabama and northern Florida during the nineteenth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face vessels"@en .

aat:300262627 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of Congo, along the southern bank of the Kasai River, between the Kwilu River and the Luange River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngul"@en .

aat:300262628 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, inhabiting the Ubangi River region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yakoma"@en .

aat:300262629 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of the people of the nation of the République centrafricaine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central African"@en .

aat:300262630 a skos:Concept ;
    skos:definition "Nationality, styles, and cultures of the Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Congolese"@en .

aat:300262631 a skos:Concept ;
    skos:definition "The style and culture of the people speaking the Bantu Rwanda language of East Africa, or of any of the inhabitants of the country of Rwanda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rwandese"@en .

aat:300262632 a skos:Concept ;
    skos:definition "Style and culture of the nation of Seychelles, an island republic in the western Indian Ocean, comprising about 115 islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seychellois"@en .

aat:300262633 a skos:Concept ;
    skos:definition "Style and culture of the nation of Sierra Leone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sierra Leonean"@en .

aat:300262634 a skos:Concept ;
    skos:definition "Style and culture of the nation of São Tomé and Príncipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sao Tomean"@en .

aat:300262635 a skos:Concept ;
    skos:definition "Wooden sculptures to which medicines are added and activated during oath-taking rites, sometimes by driving nails, blades, or wood points into the sculpture's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minkondi"@en .

aat:300262637 a skos:Concept ;
    skos:definition "Nationality, styles, and cultures of the people of the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Congolese"@en .

aat:300262638 a skos:Concept ;
    skos:definition "Style and culture of the nation of Dijbouti."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Djiboutian"@en .

aat:300262639 a skos:Concept ;
    skos:definition "Style and culture of the nation of Liberia, a West African state founded in 1822."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liberian"@en .

aat:300262640 a skos:Concept ;
    skos:definition "Style and culture of inhabitants of the large ancient country, Libya, in North Africa, or of the modern state of Libya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Libyan"@en .

aat:300262641 a skos:Concept ;
    skos:definition "Style and culture of people of the nation of Malawi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malawian"@en .

aat:300262642 a skos:Concept ;
    skos:definition "Style and culture of the ancient region of Mauretania in North Africa, corresponding to parts of present-day Morocco and Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Mauretanian"@en .

aat:300262643 a skos:Concept ;
    skos:definition "Style and culture of the modern African nation of Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mauritanian"@en .

aat:300262644 a skos:Concept ;
    skos:definition "Style and culture of the people of Equatorial Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equatorial Guinean"@en .

aat:300262645 a skos:Concept ;
    skos:definition "Style and culture of the people of the modern nation of Eritrea, or to the ancient civilization that flourished in this region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eritrean"@en .

aat:300262646 a skos:Concept ;
    skos:definition "Style and culture of the people of the modern nation of Ethiopia or of the ancient peoples known as the AEthiopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ethiopian"@en .

aat:300262647 a skos:Concept ;
    skos:definition "Process creating stonework or brickwork that is used as the surface finish of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry facing"@en .

aat:300262648 a skos:Concept ;
    skos:definition "Style and culture of the inhabitants of the nation of Gabon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gabonese"@en .

aat:300262649 a skos:Concept ;
    skos:definition "Style and culture of inhabitants of the nation of Gambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gambian"@en .

aat:300262650 a skos:Concept ;
    skos:definition "Style and culture of people of the modern nation of Guinée (Republic of Guinea) or of the historical people of the broader region of forest and coastal areas of western Africa between the tropic of Cancer and the equator known also as \"Guinea.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guinean"@en .

aat:300262651 a skos:Concept ;
    skos:definition "Style and culture of the people of the nation of Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ghanaian"@en .

aat:300262652 a skos:Concept ;
    skos:definition "Style and culture of the people from Guinea-Bissau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guinea-Bissauan"@en .

aat:300262653 a skos:Concept ;
    skos:definition "Style and culture of the Ivory Coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ivorian"@en .

aat:300262654 a skos:Concept ;
    skos:definition "Style and culture of Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kenyan"@en .

aat:300262655 a skos:Concept ;
    skos:definition "Style and culture of any of the ethnic groups of Lesotho, particularly the Sotho."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lesotho"@en .

aat:300262656 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Zambezi River Valley of Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "We"@en .

aat:300262657 a skos:Concept ;
    skos:definition "Figural sculptures, often with additional objects incorporated onto the surface, made and used by the Fon and other Ewe peoples of Africa in the context of voodoo, to gain protection and achieve empowerment and change for the individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bocio"@en .

aat:300262658 a skos:Concept ;
    skos:definition "Journeys or trips that involve stopping at a series of ports or places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruises"@en .

aat:300262659 a skos:Concept ;
    skos:definition "Citizenships papers consisting of pre-printed documents, issued to American seamen by customs collectors from 1796 to 1940, as a result of An Act for the Relief and Protection of American Seamen of 1796."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protection certificates"@en .

aat:300262660 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Senegal and Guinea-Bissau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balanta"@en .

aat:300262661 a skos:Concept ;
    skos:definition "Style and culture of the North African people of the same name living in the oases of the Fazzan, Libya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Garamantes"@en .

aat:300262662 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yungur"@en .

aat:300262663 a skos:Concept ;
    skos:definition "Styles and cultures of the easternmost extension of Africa including Somalia, Djibouti, Eritrea, and Ethiopia, that with East Africa (Kenya, Tanzania, and Uganda) make up Eastern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Horn of Africa"@en .

aat:300262664 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living mainly in Djibouti, but also in Somalia and Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Issa"@en .

aat:300262665 a skos:Concept ;
    skos:definition "Term used to describe works produced by the African ethnic group of the same name living in Cameroon, Republic of the Congo, and Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sanga"@en .

aat:300262666 a skos:Concept ;
    skos:definition "Toward the fore-and-aft center line or within the sides of watercraft, aircraft or machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inboard"@en .

aat:300262667 a skos:Concept ;
    skos:definition "Patterns that occur naturally on the surface of materials, such as cloth, leather, wood, or stone, caused by the arrangement of their constituent fibers or particles. Also, patterns, produced artificially, as for instance by embossing, on the surface of materials such as book cloth, in order to give them the appearance of having a particular grain; these may be either imitative of natural grains, or artificial designs such as a diaper pattern. Distinct from \"grain (structure)\" which refers to the actual arrangement and stratification of a material's constituent fibers or particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain patterns"@en .

aat:300262669 a skos:Concept ;
    skos:definition "Grain pattern embossed on leather in imitation of the grain of pigskin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pig grain"@en .

aat:300262670 a skos:Concept ;
    skos:definition "Grain pattern of very fine, regular, parallel, undulating lines, embossed on book cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ripple grain"@en .

aat:300262671 a skos:Concept ;
    skos:definition "Describes varieties of patterns produced artificially through embossing into book-cloth and used for publisher's binders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book cloth grain patterns"@en .

aat:300262672 a skos:Concept ;
    skos:definition "Rear frames of square-ended watercraft terminating at the stern. Use also for the individual planks or boards forming the sterns of square-ended watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transoms"@en .

aat:300262673 a skos:Concept ;
    skos:definition "Textile material produced for use in covering book bindings, typically woven cotton or linen subjected to processes to stiffen, color, and pattern it and enhance its durability, such as bleaching, dying, sizing, impregnating, glazing, and embossing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book cloth"@en .

aat:300262674 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name inhabiting the Luba region of the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalundwe"@en .

aat:300262675 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living mainly in the Democratic Republic of Congo, also across the border in Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kaonde"@en .

aat:300262676 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a subgroup of the Coastal Akan living in Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwahu"@en .

aat:300262677 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, a subgroup of the Luyia living in Kenya east of Lake Victoria and in Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Logooli"@en .

aat:300262678 a skos:Concept ;
    skos:definition "Generally, the rear portions of watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sterns"@en .

aat:300262679 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Ubangi River region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbunda"@en .

aat:300262680 a skos:Concept ;
    skos:definition "Style and culture of the ethnic group of the same name, a subgroup of the Mongo living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngandu"@en .

aat:300262681 a skos:Concept ;
    skos:definition "Instruments used for creasing hides or skins, consisting of a curved, cork-covered board on one side, and a loop through which the operators arm's is inserted and a grip on the other."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graining boards"@en .

aat:300262682 a skos:Concept ;
    skos:definition "Burnishers with hard, smooth, hook-shaped ends, originally made of dog's teeth, used for smoothing and polishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tooth burnishers"@en .

aat:300262683 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Ubangi River region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poto"@en .

aat:300262684 a skos:Concept ;
    skos:definition "Style and culture of the ethnic group of the same name, a subgroup of the Luyia living primarily in Kenya and Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samia"@en .

aat:300262685 a skos:Concept ;
    skos:definition "Style of twentieth-century Makonde sculpture reflecting Tanzania's national emphasis on family and unity, featuring clusters of intertwined, naturalistic human figures arranged around a central core or pole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ujamaa"@en .

aat:300262686 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo and Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unga"@en .

aat:300262687 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in southern Africa in the border area between Malawi and the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zimba"@en .

aat:300262688 a skos:Concept ;
    skos:definition "Burnishers with flat, hard, smooth, rounded edges, typically with flat sides, used for smoothing and polishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat burnishers"@en .

aat:300262689 a skos:Concept ;
    skos:definition "Roman facing technique in which irregularly shaped small blocks or stones are applied over a concrete wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus incertum"@en .

aat:300262690 a skos:Concept ;
    skos:definition "Roman facing technique in which square-faced pyramidal stones are arranged in regular, net-like patterns over a concrete wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus reticulatum"@en .

aat:300262691 a skos:Concept ;
    skos:definition "An irregular, granulated grain pattern resembling small pebbles, used especially on book cloth and leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pebble grain"@en .

aat:300262695 a skos:Concept ;
    skos:definition "Sculptures of the Fon people of Benin, Africa, consisting of a staff surmounted by a disc-like platform decorated with a tableau of cut-out or forged metal figures, often with pendants hanging from the edge; they function as commemoratives to deceased relatives, and are prayed to and offered sacrifices in ceremonies of mourning and ancestor worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asen"@en .

aat:300262696 a skos:Concept ;
    skos:definition "Boxes usually of bronze, brass, or wood, often decorated with silver, gold, or jewels, and used for the storage of valuable books and manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cumdachs"@en .

aat:300262697 a skos:Concept ;
    skos:definition "Object used for grating tobacco into snuff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tobacco rasps"@en .

aat:300262698 a skos:Concept ;
    skos:definition "Style and culture of the people of the Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sudanese"@en .

aat:300262699 a skos:Concept ;
    skos:definition "Style and culture of the people of Algeria or Algiers, in northern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Algerian"@en .

aat:300262700 a skos:Concept ;
    skos:definition "Style and culture of the people of Angola, a republic (formerly a Portuguese colony) in southwestern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angolan"@en .

aat:300262701 a skos:Concept ;
    skos:definition "Style and culture of the people of Cape Verde."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cape Verdean"@en .

aat:300262702 a skos:Concept ;
    skos:definition "Style and culture of the people of Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burkina Faso"@en .

aat:300262703 a skos:Concept ;
    skos:definition "Style and culture of the people of Burundi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burundi"@en .

aat:300262704 a skos:Concept ;
    skos:definition "Style and culture of the people of the modern nation of Botswana. To refer specifically to the style and culture of the Bantu people living chiefly in Botswana and western South Africa who speak or are descendants of those who traditionally spoke the Twana dialect of the Sotho language, use \"Tswana.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Botswana"@en .

aat:300262705 a skos:Concept ;
    skos:definition "General national designation of the nation of Somalia, the Somali Democratic Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Somalian"@en .

aat:300262706 a skos:Concept ;
    skos:definition "Style and culture of the people of South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South African"@en .

aat:300262707 a skos:Concept ;
    skos:definition "Style and culture of the East African state of Tanzania, formed in 1964 by the union of the republics of Tanganyika and Zanzibar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tanzanian"@en .

aat:300262708 a skos:Concept ;
    skos:definition "Style or culture of the nation of Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chadian"@en .

aat:300262709 a skos:Concept ;
    skos:definition "Nationality, style, or culture of the West African state of Togo (formerly Togoland)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Togolese"@en .

aat:300262710 a skos:Concept ;
    skos:definition "Complexes typically comprising a jail, police station, and courthouse, which provide services such as educational classes and treatment programs as means of reform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "justice centers"@en .

aat:300262711 a skos:Concept ;
    skos:definition "Style and culture of the people of mixed heritage, predominantly Nguni, inhabiting the kingdom of Swaziland (independent since 1968) and parts of eastern Transvaal in the Republic of South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swazi"@en .

aat:300262713 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of Congo, on the left bank of the Kasai River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nzadi"@en .

aat:300262714 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Liberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuwaa"@en .

aat:300262715 a skos:Concept ;
    skos:definition "Bamana carved wooden headdresses representing antelopes or aardvarks. Typically, they are worn by males who perform a masquerade in pairs, with one dancer representing a male animal and the other a female."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chi wara"@en .

aat:300262716 a skos:Concept ;
    skos:definition "A chequer pattern of small diamond, cube, or dice-like motifs tooled or pressed onto book cloth or leather bindings, especially popular on calf bindings in the early 19th century and on publisher's cloth bindings between 1835 and 1845."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diced pattern"@en .

aat:300262717 a skos:Concept ;
    skos:definition "A combination-tanned leather that has first been vegetable tanned, then retanned by a chrome tanning process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semi-chrome leather"@en .

aat:300262718 a skos:Concept ;
    skos:definition "Combination-tanned leather that has first been chrome-tanned, then retanned by a vegetable tanning process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome-retan leather"@en .

aat:300262719 a skos:Concept ;
    skos:definition "Raw animal skins converted to leather from treatment with two or more tanning agents; i.e., a combination of vegetable matter and metal chromium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combination-tanned leather"@en .

aat:300262720 a skos:Concept ;
    skos:definition "Trousers cut with fullness on both the outer and inner seams to give a flare at the hem. This style was popular in the 1960s and 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell-bottoms"@en .

aat:300262721 a skos:Concept ;
    skos:definition "Describes groupings of cloth coverings produced and worn by inhabitants of Africa or those of African descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African wearing blankets"@en .

aat:300262722 a skos:Concept ;
    skos:definition "Wraps, typically made of wool, covering the head and body, and worn in northern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haiks"@en .

aat:300262723 a skos:Concept ;
    skos:definition "The style and culture of the island of Mauritius in the Indian Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mauritian"@en .

aat:300262724 a skos:Concept ;
    skos:definition "Style and culture of the people of Mayotte, the southeasternmost island of the Comoros archipelago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahoran"@en .

aat:300262725 a skos:Concept ;
    skos:definition "Style and culture of the nation of Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mozambican"@en .

aat:300262726 a skos:Concept ;
    skos:definition "Style and culture of the people of the nation of Namibia or of the Namib desert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Namibian"@en .

aat:300262727 a skos:Concept ;
    skos:definition "Style and culture of the western African country of Niger, formerly part of the Federation of French West Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nigerien"@en .

aat:300262728 a skos:Concept ;
    skos:definition "Style and culture of an African ethnic group inhabiting Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwanyama"@en .

aat:300262729 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Kalahari desert of Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kgalagadi"@en .

aat:300262730 a skos:Concept ;
    skos:definition "Side-blown trumpets of the Swahili people of Africa, generally of conical, slightly curved bore, made from brass, wood, or ivory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siwas"@en .

aat:300262731 a skos:Concept ;
    skos:definition "Therianthropic sculptures of the Isoko and Uhrobo peoples of Africa, commemorating ancient warriors and office holders and celebrating the ethos of tenacity and aggression. They are typically comprised of a hippopotamus-like mouth suspended on four large legs, atop of which there are several carved figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivri"@en .

aat:300262732 a skos:Concept ;
    skos:definition "Stone or concrete mintadi, used as grave monuments erected on tombs of high-ranking persons among Kongo peoples and in Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitumba"@en .

aat:300262733 a skos:Concept ;
    skos:definition "Earthenware vessels, shaped much like tea kettles, but generally larger, with a canted spout and handles. Found in Barbados, Jamaica, Nevis, and Antigua as early as the 18th century and still made today. Also made in the American south (particularly in the Carolinas and Tennessee)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monkey jugs"@en .

aat:300262734 a skos:Concept ;
    skos:definition "Akan terracota heads used in Africa in funerary and burial contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mma"@en .

aat:300262735 a skos:Concept ;
    skos:definition "Anthropomorphic basaltic stone monoliths referring to dead legendary figures and found in localized areas in the Middle Cross River region of Nigeria, Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atal"@en .

aat:300262736 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dagomba"@en .

aat:300262737 a skos:Concept ;
    skos:definition "Style and culture of the African peoples of the independent chiefdom of the same name, located in the Upper Cross River region, just west of the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Widekum"@en .

aat:300262738 a skos:Concept ;
    skos:definition "Native American headgear, part of ceremonial regalia, and made from the hair of deer, porcupine, and occasionally moose or horse. The roach headdress is held in place by a scalp lock, which is a small lock of hair braided on the crown of the wearer's head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roach headdresses"@en .

aat:300262739 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Central Liberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gbi"@en .

aat:300262740 a skos:Concept ;
    skos:definition "Anthropomorphic figures carved by the Yoruba people of Africa in memory of a deceased twin or twins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ere ibeji"@en .

aat:300262741 a skos:Concept ;
    skos:definition "Garments comprising a leaf or a cluster of leaves, often resembling the leaves of the fig tree, used as a cover for the genitalia. Typically depicted in art works of nude figures; for example, on a statue or painting of the Biblical subject Adam and Eve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fig leaves"@en .

aat:300262743 a skos:Concept ;
    skos:definition "Ritual group dances performed by Native Americans in the late 19th century, as part of a religious movement to promote the return of the dead, the restoration of Indian lands, food supplies, and way of life, and generally rehabilitate the traditional Indian culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghost dances"@en .

aat:300262744 a skos:Concept ;
    skos:definition "Parts or components of belts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt components"@en .

aat:300262745 a skos:Concept ;
    skos:definition "Metal pieces, sometimes jeweled, enclosing the end of a belt or girdle, and that is opposite the end attached to the buckle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mordants"@en .

aat:300262746 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Kenya and Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gaya"@en .

aat:300262747 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Malawi, Tanzania, and Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tumbuka"@en .

aat:300262748 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dakakari"@en .

aat:300262749 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gamergu"@en .

aat:300262750 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the border area of Kenya and Uganda, north of Lake Victoria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyole"@en .

aat:300262751 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sangu"@en .

aat:300262752 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting Côte d'Ivoire and neighboring countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dyula"@en .

aat:300262754 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngangela"@en .

aat:300262755 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyungwe"@en .

aat:300262756 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting central Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yeke"@en .

aat:300262757 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Ghana and Ivory Coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sefwi"@en .

aat:300262758 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting western Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bukusu"@en .

aat:300262759 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living along the coast of western Ghana and the eastern Ivory Coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nzema"@en .

aat:300262760 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yergum"@en .

aat:300262761 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Malawi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manganja"@en .

aat:300262762 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samo"@en .

aat:300262763 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Niger and Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dendi"@en .

aat:300262764 a skos:Concept ;
    skos:definition "Style and culture of the Pygmy-stature African ethnic group inhabiting the Tumbwe region of southeastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbote"@en .

aat:300262765 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the eastern Niger River Delta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nembe"@en .

aat:300262766 a skos:Concept ;
    skos:definition "Buildings that house justice centers used for the custody and treatment of juvenile offenders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juvenile justice centers"@en .

aat:300262770 a skos:Concept ;
    skos:definition "Portions of sterns, typically curved, that project aft of the sternposts of watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counters"@en .

aat:300262771 a skos:Concept ;
    skos:definition "Bookbinder's finishing tools, commonly used in England and the Netherlands during the second half of the 17th century, consisting of a semi-circular arch with volutes at each end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawer-handle tools"@en .

aat:300262772 a skos:Concept ;
    skos:definition "Open boats, typically less than 20 feet in length, used for general service applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utility boats"@en .

aat:300262774 a skos:Concept ;
    skos:definition "Steam engines, common in the 19th century, in which a beam is pivoted in the center above a veritical cylinder, transmitting motion to the piston down to a crank shaft by a long connecting rod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walking beam engines"@en .

aat:300262775 a skos:Concept ;
    skos:definition "Pieces of pure rubber, typically soaked in turpentine or treated with paraffin to make it absorbent, and used to remove surplus gold from surfaces after tooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold rubber"@en .

aat:300262776 a skos:Concept ;
    skos:definition "Standard model boats, either sail or power, designed to be produced in quantity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock boats"@en .

aat:300262781 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wute"@en .

aat:300262782 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oku"@en .

aat:300262783 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Owan"@en .

aat:300262784 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Chad-Cameroon border region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laka"@en .

aat:300262785 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Lake Chad region of southern Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nar"@en .

aat:300262786 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the islands and southern and eastern banks of Lake Baringo in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Il Chamus"@en .

aat:300262787 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bafoussam"@en .

aat:300262788 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manga"@en .

aat:300262789 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Niger River delta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ekpeye"@en .

aat:300262790 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Central region of Ghana, near Cape Coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Efutu"@en .

aat:300262791 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Djimini"@en .

aat:300262792 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Guinea-Bissau and Senegal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kasanga"@en .

aat:300262793 a skos:Concept ;
    skos:definition "Buildings, sites, districts, structures, or objects that possess national cultural significance, according to criteria established by the National Park Service of the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "National Historic Landmarks"@en .

aat:300262794 a skos:Concept ;
    skos:definition "Instructing others in, or explaining or illustrating to others, the practical operation or results of methods, processes, products, devices, or theories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demonstration"@en .

aat:300262795 a skos:Concept ;
    skos:definition "Events comprising presentations that instruct in, explain, or illustrate the practical operation or results of methods, processes, products, devices, or theories to others, such as students or prospective clients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demonstrations"@en .

aat:300262796 a skos:Concept ;
    skos:definition "Man-made objects such as buoys, lighthouses, lightships, Loran and other electronic systems, which aid mariners in determing position of safe course."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aids to navigation"@en .

aat:300262797 a skos:Concept ;
    skos:definition "Moored, floating devices, employed as aids to mariners, marking navigable limits of channels and their fairways, or hazards such as sunken dangers, rocks, mines, torpedoe grounds or telegraph cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buoys"@en .

aat:300262798 a skos:Concept ;
    skos:definition "Individual or group games intended to teach a subject or skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational games"@en .

aat:300262800 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Angola, Botswana, and Namibia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbukushu"@en .

aat:300262801 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuburi"@en .

aat:300262802 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Duru"@en .

aat:300262803 a skos:Concept ;
    skos:definition "Straight-sided, narrow-sterned, and almost double-ended dories developed in the 1790s by fishermen in North Atlantic waters, and typically employed aboard fishing schooners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banks dories"@en .

aat:300262804 a skos:Concept ;
    skos:definition "Tubular trade beads of West Africa, known from the 15th century, of different and variegated colors though the most highly prized were blue with a greenish translucence. Their manufacture and component material is uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aggrey beads"@en .

aat:300262805 a skos:Concept ;
    skos:definition "Cut-thread and pulled-thread cloth made and used by the Kalabari peoples of the Niger Delta, Nigeria, Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pelete bite"@en .

aat:300262806 a skos:Concept ;
    skos:definition "Long, iron bars equipped with sliding shackles and a lock, used to confine the ankles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bilboes"@en .

aat:300262807 a skos:Concept ;
    skos:definition "Ships, typically anchored in a specific location where a lighthouse would be impractical, and equipped with lights and various warning devices serving as aids to mariners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lightships"@en .

aat:300262808 a skos:Concept ;
    skos:definition "Registration documents issued by the United States government to vessels of twenty tons burden or more engaging soley in domestic or coastal trade or the fisheries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enrollments"@en .

aat:300262809 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turka"@en .

aat:300262810 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Jos Plateau in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kofyar"@en .

aat:300262811 a skos:Concept ;
    skos:definition "Buildings erected in coastal areas to house men, lifeboats and equipment to aid shipwreck victims; usually maintained by volunteers or government agencies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life-saving stations"@en .

aat:300262813 a skos:Concept ;
    skos:definition "Buildings housing libraries of films and other moving image materials. Specifically, the structures that house stock footage, films, film clips and/or videotapes, and that provide storage, cataloging, and loan for use in future productions, study and research by film students, or simple viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film libraries"@en .

aat:300262814 a skos:Concept ;
    skos:definition "Songs of grief or lamentation, especially those intended to accompany funeral or memorial rites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dirges"@en .

aat:300262815 a skos:Concept ;
    skos:definition "Masquerades of the Dogon people of the western Sudan region of Africa, distinguished by their tall wooden sculptural face maks, typically featuring a double-barred cross with short vertical elements projecting from the tips of each horizontal bar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kanaga"@en .

aat:300262817 a skos:Concept ;
    skos:definition "Ankle-length boots worn by women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booties"@en .

aat:300262818 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tatoga"@en .

aat:300262819 a skos:Concept ;
    skos:definition "Movable stands used to transport a coffin and often upon which corpses or coffins containing corpses may be placed during viewing and religious services before burial. They often have long handles at either end to be carried by or placed on the shoulders of the pall bearers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biers"@en .

aat:300262820 a skos:Concept ;
    skos:definition "Use generally for cooked food made of dough composed of flour or meal of various plants, water, and other ingredients, with or without the addition of a leavening agent. Use specifically for loaves or cakes of dough made with flour and cooked by baking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread"@en .

aat:300262824 a skos:Concept ;
    skos:definition "Officially circulating media of exchange manufactured from cloth, such as the strips or squares of woven raffia commonly made and used in West and Central Africa prior to the 20th century, as well as other types used in Japan and Indonesia in the past."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth money"@en .

aat:300262826 a skos:Concept ;
    skos:definition "Stands placed on altars or attached to the wall behind an altar, consisting of or featuring a raised platform on which a monstrance is displayed for the adoration of the faithful in the Roman Catholic Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exposition thrones"@en .

aat:300262831 a skos:Concept ;
    skos:definition "Refers to strings of beads or knotted cord used for a religious exercise in which prayers are recited and counted on the beads or knots. The term is most often used to refer to strings of beads used in Roman Catholicism and Eastern Orthodoxy, although it may also be used to refer to prayer beads employed in Hinduism, Islam, Judaism, and other religions. In Christianity, the practice was adopted in the 3rd century by Eastern Christian monks, and various forms of the rosary were developed. In Roman Catholicism, the rosary became a popular method of public and private prayer. The most common rosary is the rosary of the Blessed Virgin Mary, comprising beads arranged in five decades (sets of 10), each decade separated from the next by a larger bead. The two ends of the string are joined by a smaller string holding a crucifix, two large beads, and three small beads. The devotions consist of the recitation or chanting of fifteen decades of Aves, each decade being preceded by a Paternoster and followed by a Gloria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosaries"@en .

aat:300262832 a skos:Concept ;
    skos:definition "Designs created by pouring colored sands, powdered pigments from minerals or crystals, or pigments from other natural or synthetic sources onto a surface to make a fixed or unfixed image. They are often made on the ground or the floor rather than on a separate support. Unfixed sand paintings are created or used in religious and healing rituals by various groups, including Navajo, Pueblo, and Zuni in North America, Australian Aborigines, Tibetans, Japanese, and Hindus in various nations. Sand paintings may be fixed, often with works of relatively small size for sale to the tourist trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand paintings"@en .

aat:300262833 a skos:Concept ;
    skos:definition "African masks characterized by animal horns, whether real or imitation, projecting from the top of the mask."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horned masks"@en .

aat:300262834 a skos:Concept ;
    skos:definition "Masks that are worn on the face and cover most of it. Examples are masks worn for protection or during ritual dances in African and other cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face masks"@en .

aat:300262835 a skos:Concept ;
    skos:definition "Masks that enclose the head entirely or in part, especially those worn during African ceremonies and masquerades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet masks"@en .

aat:300262837 a skos:Concept ;
    skos:definition "Refers to relatively small panel paintings of Roman Catholic religious subjects produced in Mexico, other Latin American countries, and the Spanish-speaking United States. They were produced from Spanish colonial times through the present. The subjects may include saints or miraculous events wherein individuals dedicating the paintings are assisted through the divine intervention of the holy personages depicted. They are typically painted in bright colors, usually oils or tempera, on panels of pine, zinc, copper, or tin-plated iron. The paintings were used in household altars or served as offerings of religious devotion or thanksgiving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retablos"@en .

aat:300262838 a skos:Concept ;
    skos:definition "In Latin American cultures, distinctive three-dimensional saintly or spirit figures. For example, in Andean cultures, bultos represent mummified ancestors. In Mexico and the Spanish-speaking United States from Spanish colonial times to the present, bultos are wooden Christian santos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bultos"@en .

aat:300262839 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shashi"@en .

aat:300262840 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living on the island of Ukara in Lake Victoria on the Tanzanian side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kara"@en .

aat:300262841 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Kenya and Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuria"@en .

aat:300262844 a skos:Concept ;
    skos:definition "Marks that are printed, impressed, perforated, or embossed, made by a relatively hard object, especially a die, block, or other tool, on a softer or absorbent material such as paper or wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stamps"@en .

aat:300262845 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name indigenous to Tanzania but inhabiting the islands of Zanzibar and Tumbatu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadimu"@en .

aat:300262846 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vazimba"@en .

aat:300262847 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sidamo"@en .

aat:300262848 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iraqw"@en .

aat:300262849 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting central Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chuka"@en .

aat:300262850 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bisa"@en .

aat:300262851 a skos:Concept ;
    skos:definition "African masks in the form of an elongated vertical plank, positioned in front of the masker's face, and projecting upwards. Worn in Burkina Faso among the Gurunsi, Mossi, Bwa, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plank masks"@en .

aat:300262852 a skos:Concept ;
    skos:definition "African masks worn on an axis parallel to the ground. Usually composed of a tripartite structure consisting of a helmet form at the center, with horizontal projections to the front and back, horizontal masks often have abstract animal forms where the front projection is a mouth or snout and the back projections are horns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horizontal masks"@en .

aat:300262854 a skos:Concept ;
    skos:definition "Handmade powdered glass beads made in the Mauritanian town of Kiffa, decorated with molten colored glass in various colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kiffa beads"@en .

aat:300262855 a skos:Concept ;
    skos:definition "The system of methods, rules, customs, and privileges involved in the conduct of negotiations among foreign governments or their representatives for the attainment of mutually satisfactory relations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diplomacy"@en .

aat:300262856 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Burkina Faso and Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kusasi"@en .

aat:300262857 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Somalia and Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boni"@en .

aat:300262858 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living around the coastal lagoons of Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Avikam"@en .

aat:300262859 a skos:Concept ;
    skos:definition "Style and culture of the twelve ethnic groups living in the lagoons region of southwestern Côte d'Ivoire in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lagoon people"@en .

aat:300262860 a skos:Concept ;
    skos:definition "Term used to describe works produced by members of the pan-ethnic group of people speaking the language of the same name, living in central, southern, and eastern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bantu"@en .

aat:300262861 a skos:Concept ;
    skos:definition "Style and culture of the Bantu-speaking African ethnic group of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Binji"@en .

aat:300262862 a skos:Concept ;
    skos:definition "Models, traditionally of wood, representing half of a structure, generally a building or a ship divided vertically along a central axis, such as the mid-ship line for a vessel half-model. Used for a design presentation or for decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half models"@en .

aat:300262864 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dembo"@en .

aat:300262866 a skos:Concept ;
    skos:definition "Pads, consisting of a wooden board with a layer of cotton, wool or blotting paper and covered with rough leather, flesh side out, used as a working surface when cutting gold leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold cushions"@en .

aat:300262867 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Malawi, Mozambique, Zambia, and Zimbabwe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kunda"@en .

aat:300262868 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southern Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ge"@en .

aat:300262870 a skos:Concept ;
    skos:definition "Stationary members or tracks in a slipway, upon which the sliding ways, supporting a vessel, travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground ways"@en .

aat:300262871 a skos:Concept ;
    skos:definition "Staffs used primarily for ceremonial or ritual purposes rather than as weapons, for walking, or other practical purposes. For weapons consisting of a long staff of wood, often tipped with iron at both ends, use \"quarterstaffs.\" For staffs used by regents as symbols of power, use \"scepters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial staffs"@en .

aat:300262872 a skos:Concept ;
    skos:definition "Refers to earth spirit figures, made by the Baule people of West Africa, which serve as intermediaries to contact blolo spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asie usu"@en .

aat:300262873 a skos:Concept ;
    skos:definition "Refers to spirit spouse figures made by the Baule people of West Africa, representing a woman. For spouse figures representing a man, see \"blolo bian\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blolo bla"@en .

aat:300262874 a skos:Concept ;
    skos:definition "Refers to spirit spouse figures made by the Baule people of West Africa, representing a man. For spouse figures representing a woman, see \"blolo bla\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blolo bian"@en .

aat:300262875 a skos:Concept ;
    skos:definition "Refers to body masks made entirely or in part from leaves and other natural fibers. Leaf masks may have a crested headpiece, and are prevalent among the Bwa people of Burkina Faso in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaf masks"@en .

aat:300262876 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kimbu"@en .

aat:300262877 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Ndop plain in the Northwest province of Cameroon, in the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Babungo"@en .

aat:300262878 a skos:Concept ;
    skos:definition "Large anthropomorphic funerary figures, made by wrapping red cloth over the dried corpse of a chief or other person of high status, during funerary rites of the Bwendi and Kamba peoples of Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niombo"@en .

aat:300262879 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbugu"@en .

aat:300262880 a skos:Concept ;
    skos:definition "Style and culture of the nomadic, camel-herding, Arabic-speaking people of the same name who move through African territories in Eastern Chad, Western Sudan, and Darfur, Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rizekat"@en .

aat:300262881 a skos:Concept ;
    skos:definition "Half models used specifically as guides in the construction of vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "builder's models"@en .

aat:300262882 a skos:Concept ;
    skos:definition "A pile of vellum or parchment paper leaves together with laminae of gold leaf, which are to be beaten in the first stage of beating to produce gold leaf by hand, before being transferred into the \"shoder\" packet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutches"@en .

aat:300262885 a skos:Concept ;
    skos:definition "Relatively short-shafted spears designed to be thrust instead of thrown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stabbing spears"@en .

aat:300262886 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kinga"@en .

aat:300262887 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting west central Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ekonda"@en .

aat:300262888 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southern Tanzania and northern Malawi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngonde"@en .

aat:300262889 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Harar region of Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Harari"@en .

aat:300262891 a skos:Concept ;
    skos:definition "Fortified farming villages found primarily among the Berber peoples in Morocco, Algeria, and Tunisia; mostly constructed at oases, along northeastern and southern edges of the Atlas mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ksour"@en .

aat:300262892 a skos:Concept ;
    skos:definition "Figurative sculpture, dating in Africa from the 1880s, depicting the impact of colonialism through the manipulation of European characteristics, such as posture, attire, and accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colons"@en .

aat:300262893 a skos:Concept ;
    skos:definition "African sculptures that are in the form of a mask, but smaller in size, not intended to be worn on the face, and found predominantly among groups in Liberia and the Democratic Republic of Congo. For miniature versions of masks, use \"miniature\" + \"masks\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maskettes"@en .

aat:300262894 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gouin"@en .

aat:300262895 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southwestern Ethiopia and southeastern Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anuak"@en .

aat:300262896 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbugwe"@en .

aat:300262897 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lamba"@en .

aat:300262898 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Bénin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Woaba"@en .

aat:300262899 a skos:Concept ;
    skos:definition "Removal or reduction of government regulation of business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deregulation"@en .

aat:300262900 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tusyan"@en .

aat:300262901 a skos:Concept ;
    skos:definition "Goods given in exchange for a bride by the family of the man to the family of the woman."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bride price"@en .

aat:300262902 a skos:Concept ;
    skos:definition "Short cloaks covering the shoulders, especially as adopted by certain religious orders as part of their ordinary costume. An example of usage is when scapulars were prescribed by the Rule of St. Benedict, originally worn by monks when engaged in manual labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scapulars"@en .

aat:300262903 a skos:Concept ;
    skos:definition "Styles, forms, and arrangements of hair, usually hair on a human head and often enhanced by adding materials or substances to the hair. Hairstyles may have social and religious significance as well as aesthetic and artistic qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairstyles"@en .

aat:300262904 a skos:Concept ;
    skos:definition "Wooden headdress, in the form of a female bust, with four base posts, worn on top of the head, with the base posts encircling the wearer's chest. Found among the Baga and Nalu peoples of Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nimba"@en .

aat:300262905 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hananwa"@en .

aat:300262906 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Niger, Mali, Bénin, Burkina Faso, and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zarma"@en .

aat:300262907 a skos:Concept ;
    skos:definition "Speedboats with a light hull and equipped with one or more marine engines. Built primarily between 1900-1910, the name \"autoboat\" originated in France, where the first high-speed motorboats had automobile engines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autoboats"@en .

aat:300262908 a skos:Concept ;
    skos:definition "Traveling about from place to place without a particular destination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruising"@en .

aat:300262909 a skos:Concept ;
    skos:definition "Metal covers, often gold or silver, used for the veneration and preservation of icons or similar devotional images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revetments"@en .

aat:300262910 a skos:Concept ;
    skos:definition "Internal-combustion engines in which a spray of fuel introduced into air compressed to a temperature of approximately 1000 degrees Farenheit (538 degrees Celsius), ignites at a virtually constant pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diesel engines"@en .

aat:300262911 a skos:Concept ;
    skos:definition "Complexes consisting of a light house and various support buildings and structures, such as keepers quarters, boathouses, fog signals, cisterns, and workshops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light stations"@en .

aat:300262912 a skos:Concept ;
    skos:definition "The gradual increase over time of the average temperature of the entire earth's lower atmosphere. Global warming has occurred in the distant past as the result of natural influences, but the term is most often used to refer to the warming predicted to occur as a result of emissions of greenhouse gases directly and indirectly caused from the burning of fossil fuels. An increase of the earth's temperature by only a few degrees results in dramatic climate change, loss of habitat and species, sea-level rise, and alteration of the oceans' currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "global warming"@en .

aat:300262913 a skos:Concept ;
    skos:definition "The technique of decorating surfaces with cut-outs of paper, linoleum, plastic, or other flat material, over which a finish is applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "découpage"@en .

aat:300262914 a skos:Concept ;
    skos:definition "Orders issued by a company and drawn upon its bank or banks for payment of a dividend to a named shareholder or stock holder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dividend warrants"@en .

aat:300262915 a skos:Concept ;
    skos:definition "Comics that tell stories intended to be entertainingly frightening, usually featuring such things as monsters, violence, and the supernatural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horror comics"@en .

aat:300262917 a skos:Concept ;
    skos:definition "Examples of script or type forms considered to be fine quality examples of typography or calligraphy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typographica"@en .

aat:300262918 a skos:Concept ;
    skos:definition "Separately printed portions of larger works, such as periodical articles or book chapters, produced at the same time of issuance as the original from the same setting of type or plates; typically made for the authors' use or for promotional purposes. Distinct from \"reprints\", which, with reference to articles, is used for portions of larger works produced subsequent to the publication of the original, usually but not always from the same setting of type or plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offprints"@en .

aat:300262919 a skos:Concept ;
    skos:definition "Milling machines that separate the seeds, hulls, or foreign material from cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotton gins"@en .

aat:300262920 a skos:Concept ;
    skos:definition "Works produced by the technique of découpage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "découpages"@en .

aat:300262923 a skos:Concept ;
    skos:definition "Comics whose stories are set in distant times and lands, either past or future, featuring heroic persons, magicians, and mythological figures battling evil forces, typically in face-to-face combat with swords, axes, hammers, and other hand-wielded weapons, and often involving magic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sword and sorcery comics"@en .

aat:300262924 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Naudeba"@en .

aat:300262925 a skos:Concept ;
    skos:definition "Boards of appointed or elected laypersons in charge of the temporal administration of Catholic Church parishes in French-speaking regions such as France and the province of Québec. For similar boards in the Church of England, Anglican Church of Canada, and American Episcopalian Church, use \"vestries (boards).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabriques"@en .

aat:300262926 a skos:Concept ;
    skos:definition "Appointed or elected assemblies or boards of parishioners who originally met in the vestry of the parish church for the purpose of deliberating or legislating upon the affairs of the parish or upon certain temporal matters connected with the church. Often used particularly for such boards in the Church of England, the Anglican Church of Canada, and the American Episcopalian Church. For similar boards in Catholic Churches in French-speaking regions of Canada, use \"fabriques.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestries"@en .

aat:300262927 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Bénin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kilinga"@en .

aat:300262928 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vere"@en .

aat:300262929 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wukari"@en .

aat:300262930 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Cameroon and Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musgu"@en .

aat:300262931 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo and Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mundu"@en .

aat:300262932 a skos:Concept ;
    skos:definition "Describes the process of creating or transforming objects, disciplines, locales, or elements of culture according to aspects of the Walt Disney Company's theme parks, merchandise, animation style, or public image. Characteristics include an emphasis on escapism, fantasy, consumerism, virtue, and idealized notions of society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Disneyfication"@en .

aat:300262933 a skos:Concept ;
    skos:definition "Councils of a parish, either the local administrative body in a rural civil parish or an ecclesiastical parish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parish councils"@en .

aat:300262934 a skos:Concept ;
    skos:definition "Musical pieces composed for one or more voices with instrumental accompaniment, typically incorporating a narrative and organized in a somewhat dramatic manner but not intended to be acted in movement or costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantatas"@en .

aat:300262935 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Mozambique and Malawi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sena"@en .

aat:300262936 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Central African Republic, Sudan, Democratic Republic of Congo, and Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banda"@en .

aat:300262937 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southeastern Cameroon, northern Democratic Republic of Congo, northeastern Gabon, and southwestern Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baka"@en .

aat:300262938 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting central and southeastern Gabon and southwestern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bongo"@en .

aat:300262939 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo, between the Lukenie and Kasai rivers and between the Lualaba and Lomami rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cwa"@en .

aat:300262940 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southwestern Cameroon and Equatorial Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gieli"@en .

aat:300262941 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Ituri forest in Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basua"@en .

aat:300262942 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Democratic Republic of Congo and southeastern Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aka"@en .

aat:300262943 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the northwestern Ituri forest in Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aka"@en .

aat:300262944 a skos:Concept ;
    skos:definition "Rings worn on one of the toes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toe rings"@en .

aat:300262945 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sakata"@en .

aat:300262946 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, closely related to the Yaka, and inhabiting the Democratic Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nkanu"@en .

aat:300262947 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Lega region of the Democratic Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bira"@en .

aat:300262948 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Democratic Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luimbe"@en .

aat:300262949 a skos:Concept ;
    skos:definition "Style and culture of the state of Comoros, comprising the islands of the Comorian archipelago in the Indian Ocean, off the coast of East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Comorian"@en .

aat:300262950 a skos:Concept ;
    skos:definition "Representations in any medium of Gautama Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhas"@en .

aat:300262951 a skos:Concept ;
    skos:definition "Refers the bodies of human beings, or sometimes of animals, that have been embalmed, naturally preserved, or treated for burial with preservatives. Among the many peoples who practiced mummification were the people living along the Torres Strait between Papua New Guinea and Australia, the Incas of South America, and the Chinese. Prominent examples were created by the ancient Egyptians. The process varied from age to age in Egypt, but it always involved removing the internal organs (though in a late period they were replaced after treatment), treating the body with resin, and wrapping it in linen bandages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummies"@en .

aat:300262952 a skos:Concept ;
    skos:definition "Refers to pictures composed of several separate sections that can be combined in various ways so as to produce different scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "myrioramas"@en .

aat:300262953 a skos:Concept ;
    skos:definition "Refers to the culture of ancient Scandinavia, particularly the culture of those peoples who spoke Old Norse, which was the language of Norway and its colonies through the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norse"@en .

aat:300262954 a skos:Concept ;
    skos:definition "Japanese woodblock prints, made from 1915 to ca. 1950, and characterized by a romantic or nostalgic tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shin hanga"@en .

aat:300262955 a skos:Concept ;
    skos:definition "Bamana zoomorphic sculptures, which serve as portable altars for the Komo association, and which are usually shaped in the form of a cow, with the insides containing materials such as animal bones, vegetable matter, honey, metal, and covered with a thick coating of earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boliw"@en .

aat:300262956 a skos:Concept ;
    skos:definition "Creative process during which musical compositions and ideas are realized and transmitted to a listener."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical performances"@en .

aat:300262957 a skos:Concept ;
    skos:definition "Small, painted, clay figurines originating from Provence, used to adorn nativity scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "santons"@en .

aat:300262958 a skos:Concept ;
    skos:definition "Use to describe art of the United States-Mexico border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "border art"@en .

aat:300262960 a skos:Concept ;
    skos:definition "Style and culture of the Algonquian-speaking, Native American people who inhabited Massachusetts, Rhode Island, and Connecticut. Presently the Nipmuc Nation is based in Massachusetts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nipmuc"@en .

aat:300262961 a skos:Concept ;
    skos:definition "Style and culture of the Algonquian-speaking, Native American people of Rhode Island, southeastern Massachusetts, and the eastern shore of Narragansett Bay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wampanoag"@en .

aat:300262962 a skos:Concept ;
    skos:definition "Refers to the culture and style of works produced in the southern Louisiana bayou lands by the descendents French Canadian immigrants who were driven out by the British when they captured the French colony of Acadia (which was centered in what is now Nova Scotia) in the 18th century. One characteristic that defines the culture is the use of a distinctive patois, which comprises archaic French words and idioms derived from the English, Spanish, German, American Indian, and black cultures in southern Louisiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cajun"@en .

aat:300262963 a skos:Concept ;
    skos:definition "Bottles with a rubber or soft plastic nipple attached, from which an infant sucks milk or other liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing bottles"@en .

aat:300262964 a skos:Concept ;
    skos:definition "Style and culture of the inhabitants of ancient Carthage and its colonies in the western Mediterranean, Adriatic coast, and Spain during the first millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Punic"@en .

aat:300262965 a skos:Concept ;
    skos:definition "Designation applied to a taste for cultural materials that provide a knowing amusement by virtue of their being artlessly mannered and self-conscious, artificial or ostentatious. For the related concept applied to artistic or literary material, use \"kitsch.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camp"@en .

aat:300262966 a skos:Concept ;
    skos:definition "Heavy timbers in a slipway, which slide down the ground ways when a vessel is being launched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sliding ways"@en .

aat:300262967 a skos:Concept ;
    skos:definition "Use to describe the works produced by the Algonquian-speaking tribe of the same name, who inhabit Southern New England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pequot"@en .

aat:300262968 a skos:Concept ;
    skos:definition "Masquerades of the Bini and Edo peoples of Benin in Africa, referring to the creation of the Benin royal dynasty by the mythical king Oranmiyan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ododua"@en .

aat:300262969 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eton"@en .

aat:300262970 a skos:Concept ;
    skos:definition "Dress associated with a culture defined by or named for a nationality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national dress"@en .

aat:300262971 a skos:Concept ;
    skos:definition "Masquerades of the Chewa and neighboring peoples in Malawi, Zambia, and Angola in Africa; they are performed at funerary ceremonies, masqueraders representing spirits of the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nyau"@en .

aat:300262972 a skos:Concept ;
    skos:definition "African bearing swords with long iron blades, symbolizing the power of the rulers of Benín; one has traditionally been carried on public occasions by a swordbearer accompanying the oba, or king, and sometimes other certain designated chiefs. Historically they were also used as executioner's swords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ada"@en .

aat:300262973 a skos:Concept ;
    skos:definition "Refers to works produced by the Caucasoid Japanese people who are the indigenous inhabitants of the Japanese archipelago, the Kuril Islands, and part of Sakhalin Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ainu"@en .

aat:300262975 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Zambia and the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbowe"@en .

aat:300262976 a skos:Concept ;
    skos:definition "Visual works submitted for decision or consideration, such as for a commission or entrance into a competition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submissions"@en .

aat:300262977 a skos:Concept ;
    skos:definition "Twinned brass images, one male, the other female, joined by a chain, usually around the neck. The edan serve as a main sculptural form of the Yoruba Ogboni secret society in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edan"@en .

aat:300262978 a skos:Concept ;
    skos:definition "Sculpted human figures or heads attached to the reliquaries of deceased Fang elders, which function as a symbolic evocation of the ancestor as well as a guardian of the relics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bieri"@en .

aat:300262979 a skos:Concept ;
    skos:definition "African monkey figures of the Baule people, characterized by open hands or small offering cups for sacrificial offerings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gbekre"@en .

aat:300262980 a skos:Concept ;
    skos:definition "Style and culture of the Native American people who inhabited the upper James River valley of Virginia, or the present-day group in Amherst County, Virginia, claiming descent from these people. Distinct from the \"Algonkin\" who share the same original Algonquian language heritage, but inhabit Northern Ontario and Quebec along the Ottawa River in Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monacan"@en .

aat:300262981 a skos:Concept ;
    skos:definition "Refers to a style that was predominant in German-speaking regions in the 13th century in panel painting, wall painting, stained glass, and manuscript illuminations. The term comes from the German for \"jagged style,\" and is characterized by its distinctive treatment of drapery, in which fabrics seem to have a nervous, living vitality and zig-zag or broken-fold forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zackenstil"@en .

aat:300262982 a skos:Concept ;
    skos:definition "The transmission of facts and cultural knowledge, rules, beliefs, and stories in oral rather than written form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oral tradition"@en .

aat:300262983 a skos:Concept ;
    skos:definition "Cards displaying samples of small merchandise items, such as beads and buttons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sample cards"@en .

aat:300262984 a skos:Concept ;
    skos:definition "African bearing swords with curved, elaborately carved blades, often of ivory, carried by the royal Olowo of Yoruba and high-ranking chiefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "udamalore"@en .

aat:300262985 a skos:Concept ;
    skos:definition "African bearing swords with a looped handle and very thin, broad blade swelling to a large oval shape at the end, carried by Benín chiefs at the royal court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eben"@en .

aat:300262986 a skos:Concept ;
    skos:definition "African ceremonial knives of the Kuba people having a pommel and a flat, leaf-shaped blade of metal or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ikula"@en .

aat:300262987 a skos:Concept ;
    skos:definition "African ceremonial swords of the Asante people, having a curved iron blade, broad at the point but gradually tapering towards the woden hilt which is sometimes encased in gold and consisting of two spheres at either end of a cylinder, worn or carried by Asante kings and major chiefs or their representatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "afena"@en .

aat:300262988 a skos:Concept ;
    skos:definition "Detachable portions of tickets returned to the user as proof of purchase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ticket stubs"@en .

aat:300262989 a skos:Concept ;
    skos:definition "Parts or components of shipyard structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipyard structure components"@en .

aat:300262991 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dagari"@en .

aat:300262992 a skos:Concept ;
    skos:definition "Style and culture of the nation of Cameroon, lying at the junction of western and central Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cameroonian"@en .

aat:300262993 a skos:Concept ;
    skos:definition "Style and culture of the people of Bénin, particularly of the modern inhabitants. For the style and culture of the more ancient people of southern Nigeria, use \"Benin.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beninese"@en .

aat:300262995 a skos:Concept ;
    skos:definition "Buildings housing businesses that sell meat, poultry and sometimes fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butcher shops"@en .

aat:300262996 a skos:Concept ;
    skos:definition "Spears used for ritual purposes, rather than as fighting and hunting weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial spears"@en .

aat:300262997 a skos:Concept ;
    skos:definition "Ethnic, cultural, and regional styles in that region of North Africa historically known as Morocco. For the style of the nation of Morocco, see \"Moroccan.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moroccan styles"@en .

aat:300262998 a skos:Concept ;
    skos:definition "Textile works, typically fine cloth embroidered by women or girls in various stitches and intended to be framed. They were usually created as demonstrations of a beginner's skill and featured a combination of stitches, motifs, letters, verses, and often the date of completion and the stitcher's name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samplers"@en .

aat:300262999 a skos:Concept ;
    skos:definition "The uncovered binding edges of text blocks, formed where and when the back edges of the gatherings are attached together. For the portions of covers that enclose the back, use \"spines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backs"@en .

aat:300263000 a skos:Concept ;
    skos:definition "Bindings in which a closely-spaced number of holes are drilled or punched through the leaves near the binding edge to take a spiral-twisted wire or plastic coil which is drawn through the holes to secure the leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral bindings"@en .

aat:300263002 a skos:Concept ;
    skos:definition "Describes books the edges of which have been hand cut with a knife to remove the bolts after the binding process is finished, usually by the bookseller or purchaser."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opened"@en .

aat:300263004 a skos:Concept ;
    skos:definition "Raw animal skins converted to leather from treatment with ingredients found in vegetable matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable-tanned leather"@en .

aat:300263005 a skos:Concept ;
    skos:definition "Skin of goat converted to leather from treatment with ingredients found in vegetable matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable-tanned goatskin"@en .

aat:300263006 a skos:Concept ;
    skos:definition "Skin of sheep converted to leather from treatment with ingredients found in vegetable matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable-tanned sheepskin"@en .

aat:300263007 a skos:Concept ;
    skos:definition "Smooth, thin vegetable-tanned sheepskin leather, usually tanned with oak bark and grained in imitation of other leathers, softer than roan, and popular for inexpensive bookbindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basil"@en .

aat:300263010 a skos:Concept ;
    skos:definition "Generally, the process of cutting or scraping the surface of something with a sharp-edged tool so as to remove a thin layer or unwanted extra material. In the context of skin and hide preparation, denotes the beamhouse operation of removing hair or excess dermal material to create an even thickness. In the context of bookbinding, for the removal of a small amount of material from the edges of a book, use \"trimming.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving"@en .

aat:300263011 a skos:Concept ;
    skos:definition "Leaves indicating the beginning of distinct, major portions of books, bearing the divisional title or number of the portion on the recto. The verso is normally left blank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divisional title pages"@en .

aat:300263012 a skos:Concept ;
    skos:definition "The three outer extremities of the folded gatherings of books, usually cut at some stage so that the book can be opened and sometimes also trimmed; they may be decorated by gilding, painting, sprinkling, or some other manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edges"@en .

aat:300263013 a skos:Concept ;
    skos:definition "Instruments for cutting or trimming the edges of books or paper, consisting of an adjustable wooden frame that holds a blade which is run back and forth along a groove or guide-rail in the cutting-press. Used to hand-cut the bolts from the uncut edges or to trim the already cut edges of books while they are held in a lying press."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plows"@en .

aat:300263015 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting central Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamba"@en .

aat:300263016 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basa"@en .

aat:300263017 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Ituri forest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Efe"@en .

aat:300263018 a skos:Concept ;
    skos:definition "Use to describe Ethiopian art and architecture associated with the Gondar dynasty, which lasted from the mid-16th to mid-18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gondar"@en .

aat:300263019 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting western Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bacwezi"@en .

aat:300263020 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyindu"@en .

aat:300263021 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Katab"@en .

aat:300263022 a skos:Concept ;
    skos:definition "Style and culture of the northern division of the African ethnic group Tonga living in a vast area along the Zambezi River and throughout parts of Zambia, Zimbabwe, Malawi, Mozambique, and South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plateau Tonga"@en .

aat:300263023 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting South Africa and Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shangaan"@en .

aat:300263024 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Central province in Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soli"@en .

aat:300263025 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Darfur and Kurdufan regions of Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Messiria"@en .

aat:300263026 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macha"@en .

aat:300263027 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Jos Plateau in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anaguta"@en .

aat:300263028 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting coastal communities in the Niger Delta of southeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Obolo"@en .

aat:300263029 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etulo"@en .

aat:300263035 a skos:Concept ;
    skos:definition "Styles belonging to Eastern Democratic Republic of Congo cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Democratic Republic of Congo styles"@en .

aat:300263036 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in southeastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sanga"@en .

aat:300263037 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Cameroon, Congo, and Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pomo"@en .

aat:300263038 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyanga"@en .

aat:300263039 a skos:Concept ;
    skos:definition "Objects used in divination or associated with divination rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divination objects"@en .

aat:300263041 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting southeastern Zimbabwe and Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Duma"@en .

aat:300263042 a skos:Concept ;
    skos:definition "Neolithic culture partially identified by characteristic pottery found in East Africa, especially in the area of Lake Turkana in Kenya, characterized by decorations that appear on the inside of vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nderit"@en .

aat:300263043 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gade"@en .

aat:300263044 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kanakuru"@en .

aat:300263045 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zela"@en .

aat:300263046 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the Kinshasa region in Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngata"@en .

aat:300263047 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Central African Republic and Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndogo"@en .

aat:300263048 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Senegal and Guinea-Bissau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pepel"@en .

aat:300263049 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the lagoon region of Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abidji"@en .

aat:300263050 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Malawi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phoka"@en .

aat:300263052 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Chad and Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Day"@en .

aat:300263053 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwena"@en .

aat:300263054 a skos:Concept ;
    skos:definition "Flooring made of synthetic materials such as vinyl, vinyl-asbestos, and linoleum, that provides a smooth surface and has the capacity to recover its original size and shape after deformation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resilient flooring"@en .

aat:300263056 a skos:Concept ;
    skos:definition "Sudden occurrences of bursting inward or interior collapse, intentional or accidental, including the collapsing of buildings as a means of demolishing them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "implosions"@en .

aat:300263057 a skos:Concept ;
    skos:definition "In two-dimensional representation such as drawing or painting, the depiction of figures and objects in perspective with their gradations of light and shadow, using such techniques as hatching; applies particularly to architectural rendering that depicts shadows cast at a particular angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skiagraphy"@en .

aat:300263058 a skos:Concept ;
    skos:definition "Styles belonging to Kuba region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuba region styles"@en .

aat:300263059 a skos:Concept ;
    skos:definition "Styles belonging to Mongo region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mongo region styles"@en .

aat:300263060 a skos:Concept ;
    skos:definition "Reliquaries designed in the shape of the relic they were ostensibly intended to contain, which may be a piece of clothing, an object or fragment of an object, a body part, a saint's blood, or other artifact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speaking reliquaries"@en .

aat:300263061 a skos:Concept ;
    skos:definition "Reliquaries believed to contain a part of the body of a saint or other holy figure. They may be, but are not necessarily, speaking reliquaries, which take the form of the body part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body-part reliquaries"@en .

aat:300263062 a skos:Concept ;
    skos:definition "Describes objects, particularly tools, machines, or components, that change position relative to other objects or components within the same object, or relative to a coordinate system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving"@en .

aat:300263063 a skos:Concept ;
    skos:definition "Entities, including a site, building, city, complex, desert, forest, island, lake, monument, or mountain designated by the United Nations Educational, Scientific and Cultural Organization (UNESCO) as exceptional examples of cultural values or natural phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "World Heritage Sites"@en .

aat:300263064 a skos:Concept ;
    skos:definition "The apparent arch or vault above the surface of the earth as perceived by those standing on the surface, whether covered with clouds or clear and blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sky"@en .

aat:300263065 a skos:Concept ;
    skos:definition "Architects with managerial responsibility for building projects, responsible for translating the design vision into a buildable document set; may undertake every stage in a project from initial design to construction supervision. May also be the architect of record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executive architects"@en .

aat:300263066 a skos:Concept ;
    skos:definition "Teachers in post-secondary education institutions who rank immediately below professors and above assistant professors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "associate professors"@en .

aat:300263067 a skos:Concept ;
    skos:definition "Disciplines that focus on forming plans regarding human habitats or humans’ effects upon other habitats, typically disciplines that deal with the design, sustainability, or control of development regarding urban, economic, regional, environmental, community, health-related, and transportation concerns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planning disciplines"@en .

aat:300263068 a skos:Concept ;
    skos:definition "Small, house-like structures built over graves, usually comprising a shed or ramada, which is a roof with comer posts supporting it. Examples are found in the American south, in Native American cultures, and in certain places in Europe; roof-shaped constructions made of wood and placed fresh graves seem to date from the Bronze Age in Europe (ca. 2000-800 BCE). For houselike structures intended as dwellings for spirits, use \"spirit houses (religious structures).\" For freestanding structures or rooms near graves for the benefit of mourners, prefer \"funeral chaples.\" For buildings, often grand but sometimes smaller, that permanently house the body of the deceased, use \"mausoleums.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravehouses"@en .

aat:300263069 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Central African Republic, Democratic Republic of Congo, and Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bomitaba"@en .

aat:300263070 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kilenge"@en .

aat:300263071 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name inhabiting the Kurdufan region of Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamar"@en .

aat:300263072 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the lagoon region of Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gwa"@en .

aat:300263073 a skos:Concept ;
    skos:definition "Plucked lutelike chordophones of bass register, having a soundbox with a scalloped silhouette, a flat or slightly domed back, a flat soundboard with a round ornamental soundhole, and a long neck with a pegbox with usually lateral tuning pegs. They are strung with six or seven double courses of metal strings, the lowest of which are made of two or more strands twisted together. The bridge is glued in position, having a fret-like strip of brass and a row or hitch-pins along its bottom edge; a lutelike system of bars is fixed under the soundboard. They are said to have been first made by John Rose, in London, 1562, and were popular as continuo instruments in string consorts into the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandoras"@en .

aat:300263074 a skos:Concept ;
    skos:definition "Celtic script used in inscriptions in the Irish and Pictish languages, dating from the fourth century and found in Britain and Ireland. Its alphabet consists of 20 characters represented by notches or straight or diagonal strokes, varying in number from one to five and drawn or cut to the left, right, or directly through vertical lines or the edges of the vertical stone monuments on which they were carved. Besides stone monuments, they are traditionally said to have been used on shields and wooden staves, and occur in at least one 14th-century manuscript."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ogham"@en .

aat:300263075 a skos:Concept ;
    skos:definition "Tall Mahafaly wooden sculptures in Madagascar, placed in small groups at tombs, carved with human and animal figures and geometric openwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aloalo"@en .

aat:300263076 a skos:Concept ;
    skos:definition "People who make or deal in sweet food items such as candy, cakes, icing, and ice cream. Formerly applied to those who compound medicines, poisons, and other drugs, for which now use \"pharmacists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confectioners"@en .

aat:300263077 a skos:Concept ;
    skos:definition "Those who have membership in an organization, community, joint enterprise, or other group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "members"@en .

aat:300263078 a skos:Concept ;
    skos:definition "Works which recount aspects of funeral and memorial activities relating chiefly to royalty, nobility, or famous persons, usually illustrated and containing descriptions of processions, services, attendees, caskets, church decorations, and other funeral furnishings and structures, and often including sermons, eulogies, and other textual testaments to the deceased's virtue and importance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral books"@en .

aat:300263079 a skos:Concept ;
    skos:definition "Those who, through membership in voluntary associations, support causes and institutions such as museums, libraries, and charities through donations of money, volunteer work, or public expressions of support. For those who undertake primary responsibility for causes or projects, either as individuals or in groups, use \"sponsors.\" For those who support causes as individuals or in groups but not necessarily taking primary responsibility for them, use \"patrons.\" Do not use for the common meaning of \"friends,\" that is, not for persons joined to one another in mutual benevolence and intimacy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friends"@en .

aat:300263080 a skos:Concept ;
    skos:definition "Morocco with a small, round, tight grain pattern, popular in 19th-century bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard grain morocco"@en .

aat:300263081 a skos:Concept ;
    skos:definition "Buildings located near coal mines, equipped with showers and clothes-drying facilities, typically found in England, Scotland, and Wales, and built for use by coal miners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pithead baths"@en .

aat:300263082 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Mozambique and Zimbabwe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gova"@en .

aat:300263083 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the lagoon region of Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abe"@en .

aat:300263084 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dizi"@en .

aat:300263085 a skos:Concept ;
    skos:definition "Describes works produced by the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irigwe"@en .

aat:300263086 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mau"@en .

aat:300263087 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the lagoon region of Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abure"@en .

aat:300263088 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Cameroon, southwestern Chad, and western Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbum"@en .

aat:300263089 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tharaka"@en .

aat:300263090 a skos:Concept ;
    skos:definition "A patinated alloy of copper with varying amounts of gold and silver, said to have been developed in Corinth in the second century BCE, and highly valued for ornament and statues. Objects cast from the metal were subjected to a heating and quenching process that resulted in a lustrous purple-black patina resistant to tarnishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian bronze"@en .

aat:300263091 a skos:Concept ;
    skos:definition "Goatskin leather imported from Turkey through Venice to Europe where it was used in fine bookbinding from the early 16th to the early 18th century. It was tawed with oil before the hair was removed, stained a distinctive shade of red, then tanned with sumac."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkey leather"@en .

aat:300263092 a skos:Concept ;
    skos:definition "Thin, not very durable vegetable-tanned leather made from the grain split of a skin or hide, usually sheepskin but sometimes goatskin or cowhide; it is produced in a variety of colors and embossed grain patterns as well as undyed and ungrained. Typical uses include for hat linings and inexpensive bookbindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skiver"@en .

aat:300263093 a skos:Concept ;
    skos:definition "Skiver, usually sheepskin, that has been coated with a thin paste or glue wash, which, when it dries, causes the skin to shrink and draw up, forming an artificial grain pattern which is then enhanced by boarding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste-grain"@en .

aat:300263094 a skos:Concept ;
    skos:definition "Any one of two or more layers of a skin or hide separated from each other by a mechanical splitting process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split"@en .

aat:300263095 a skos:Concept ;
    skos:definition "The outermost or surface split of a skin or hide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grain split"@en .

aat:300263098 a skos:Concept ;
    skos:definition "Easels used primarily or solely for the display or presentation of an object, rather than to support a work as it is created."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display easels"@en .

aat:300263099 a skos:Concept ;
    skos:definition "Cushions placed under the feet of an important person, as a sign of status and holiness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suppedions"@en .

aat:300263101 a skos:Concept ;
    skos:definition "Tall sets of shelves mounted on low dressers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "étagères dressoirs"@en .

aat:300263102 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barambo"@en .

aat:300263103 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo and Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zombo"@en .

aat:300263104 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Topoke"@en .

aat:300263105 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Central African Republic and Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nzakara"@en .

aat:300263106 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Zimbabwe and Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndau"@en .

aat:300263107 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iramba"@en .

aat:300263108 a skos:Concept ;
    skos:definition "Factory buildings in which pharmaceutical drugs are produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharmaceutical factories"@en .

aat:300263109 a skos:Concept ;
    skos:definition "Large natural objects that orbit a star or a stellar remnant. Planets are not radiating energy from internal nuclear fusion reactions, are not a brown dwarfs, and are bigger than an asteroid. Planets are large enough to have become round due to the force of their own gravity, and dominate the neighborhood around their orbit, and are thus distinguished from dwarf planets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planets"@en .

aat:300263110 a skos:Concept ;
    skos:definition "Containers that are more or less box-shaped, and used for holding earth and growing plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planter boxes"@en .

aat:300263111 a skos:Concept ;
    skos:definition "Stools having very tall legs or other supports, designed for sitting at a counter or other high table-like surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tall stools"@en .

aat:300263112 a skos:Concept ;
    skos:definition "Bathtubs that are not permanently afixed to the floor, but devised to be hidden in a drawer or cabinet, folded into a wall, or otherwise positioned to save space in the room when not in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hideaway bathtubs"@en .

aat:300263113 a skos:Concept ;
    skos:definition "Mats, doilies, or other small coverings placed on a table to protect it from a table lamp, which is placed upon it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamp mats"@en .

aat:300263114 a skos:Concept ;
    skos:definition "A pose in which a figure or group of figures twists in three dimensions, creating the impression of movement and, with sculptures, encourages viewing of the piece from all sides. In western art, the pose was seen in Hellenistic art, but was adopted and further developed in the Mannerist style, growing out of the Classical and Renaissance \"contrapposto\"; figura serpentinata moves figures in a spiral pose or other pose having larger numbers of axes than contrapposto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figura serpentinata"@en .

aat:300263116 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northeastern Namibia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ogowe"@en .

aat:300263118 a skos:Concept ;
    skos:definition "Painting on glassware or pottery without subsequent firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold painting"@en .

aat:300263120 a skos:Concept ;
    skos:definition "The split of a skin or hide between the grain and the flesh split."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle split"@en .

aat:300263121 a skos:Concept ;
    skos:definition "Concepts related to the study of human beings and their ancestors through time and space and in relation to physical character, environmental and social relations, and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthropological concepts"@en .

aat:300263122 a skos:Concept ;
    skos:definition "The concept of using found materials to resolve problems and create things. The idea was first described in a 1969 publication by the social anthropologist Claude Lévi-Strauss, drawing an analogy between how a bricoleur, or man-of-all-work, uses whatever tools and materials are at hand to construct projects, and how primitive human beings, when presented with new problems, did not think up new concepts but reordered and adapted existing ideas to accommodate a new set of circumstances. The concept has been borrowed by thinkers and writers in other disciplines, such as education, art theory, law, and economics, in discussions of how creative artists, teachers, and others make adaptive reuse of existing ideas, materials, and practices to deal with new situations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bricolage"@en .

aat:300263123 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gisiga"@en .

aat:300263124 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zara"@en .

aat:300263125 a skos:Concept ;
    skos:definition "Cabinets of various designs, intended for the storage and display of medals; popular in 18th-19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medal cabinets"@en .

aat:300263126 a skos:Concept ;
    skos:definition "Boundaries delineating areas in which Orthodox Jews are permitted to perform certain activities otherwise forbidden on the Sabbath, such as carrying personal items outside one's home. Eruvin consist of existing demarcations, such as roads and canals, plus poles and wires added to complete the boundary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eruvin"@en .

aat:300263127 a skos:Concept ;
    skos:definition "Devices or strategies for aiding the memory, such as verses, rhymes, or imagery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mnemonics"@en .

aat:300263128 a skos:Concept ;
    skos:definition "Hand-sized wooden boards covered with beads, shells, and carvings, created and used by the Mbudye secret society of the Luba people to recall their genesis myth and other complex information about the history, organization, and functioning of the society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lukasas"@en .

aat:300263129 a skos:Concept ;
    skos:definition "Gardens designed for use by the handicapped or the elderly that include such features as easliy accessible and well-marked paths, raised beds, rest areas, and plants with enhanced fragrance and textures. For gardens designed to improve and maintain the pysical and mental health of the ill or injured, use \"healing gardens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enabling gardens"@en .

aat:300263130 a skos:Concept ;
    skos:definition "Refers to the style of late Anglo-Saxon art that flourished during the ninth century and is named after the Trewhiddle Hoard from Cornwall, England. The style is characterized by its distinctive decoration with interlaced, contorted beasts and leafy scrolls, and in metalwork by the preference for silver rather than bronze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trewhiddle Style"@en .

aat:300263131 a skos:Concept ;
    skos:definition "Refers to the style of art that is named after the eighth-century ship burial at Oseberg in southern Norway, but is found over a wide geographic area in Scandinavia. While there is considerable variety within the style, it is generally characterized by the use of semi-naturalistic, gripping animals and a formal composition that disposes motifs of equal size over an area, to form a carpet-like design. The style seems to exhibit some connection with the Anglo-Saxon Trewhiddle style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oseberg Style"@en .

aat:300263132 a skos:Concept ;
    skos:definition "Refers to a style of Viking art that developed in the later ninth century and lasted to the mid-tenth century. It is noted as the first Scandinavian style produced in settlements in Iceland, England, and Russia. The style is characterized by the use of ribbon-like, gripping animals, frontally positioned, with polygonal hips, and an overall design composed of equilateral forms in static, repetitive arrangements that emphasize geometric shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Borre Style"@en .

aat:300263133 a skos:Concept ;
    skos:definition "Used by modern scholars to refer to ancient Greek large, round-bottomed bowls that curve into a wide, open mouth, and that often stood on a stand. Metal vessels of this shape were probably used for cooking and those made of terracotta were used for mixing wine and date from the mid-seventh through the late fifth centuries BCE. They are distinguished from \"lebetes\" by their larger size. Some scholars hold that ancient literary evidence suggests that the term was originally applied to drinking cups rather than bowls, and that such bowls were at that time called \"lebetes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinoi"@en .

aat:300263134 a skos:Concept ;
    skos:definition "Refers to ancient Greek small, deep bowls that curve in sharply at the shoulder and have a distinct neck with overhanging lip and round bottom designed so the bowl could sit on a stand, although some had feet. A lebes may be equipped with a pair of upright handles at the shoulder and often with a domed cover topped by a tall, stemmed handle. Bronze lebetes were used for cooking and those made of terracotta were used for mixing wine. They are distinguished from \"dinoi\" by their smaller size. Many scholars in the past have used the term to refer to both the dinos and lebes, because they thought that the term dinos referred to a cup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lebetes"@en .

aat:300263135 a skos:Concept ;
    skos:definition "Stations providing electrical power to electric vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recharging stations"@en .

aat:300263136 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name inhabiting northeastern Nigeria and Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bata"@en .

aat:300263137 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting central Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basa-Nge"@en .

aat:300263138 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Chad, Niger, and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kanembu"@en .

aat:300263139 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Nigeria and Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koma"@en .

aat:300263140 a skos:Concept ;
    skos:definition "Bookplates displaying coats of arms or other armorial devices as a mark of ownership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armorial bookplates"@en .

aat:300263141 a skos:Concept ;
    skos:definition "Lithographs created by the process of transfer lithography, in which the image is created on one surface and then transferred to a stone or plate to be printed from."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transfer lithographs"@en .

aat:300263142 a skos:Concept ;
    skos:definition "Slips or leaves bearing a list of corrections to typos, omissions, or other errors that occur in the printed text of a book They are inserted loose, tipped in, or, rarely, bound in with the pages, usually in the front matter, less commonly at the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "errata slips"@en .

aat:300263143 a skos:Concept ;
    skos:definition "Comics featuring mainly or exclusively male characters, with extraordinary personal physical or mental powers, usually garbed in strange costumes and engaged in fighting evil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superhero comics"@en .

aat:300263144 a skos:Concept ;
    skos:definition "Comics in which the story or action is basically adventurous, often set in exotic locations and involving the main characters in travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adventure story comics"@en .

aat:300263145 a skos:Concept ;
    skos:definition "Historic districts established and maintained by local units, such as a county, city, village, or township."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local historic districts"@en .

aat:300263146 a skos:Concept ;
    skos:definition "Dogon men's meeting houses used to discuss community issues. Togu na are characterized by millet-stalk roofs supported by wood pillars, which are typically carved with fertility symbols such as women's breasts or scenes from Dogon society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "togu na"@en .

aat:300263147 a skos:Concept ;
    skos:definition "Broken pediments both in furniture and architecture, with s-shaped sides terminating in inwardly facing scrolls and separated at the center point often by a finial or urn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrolled pediments"@en .

aat:300263148 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting the eastern Niger River delta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kana"@en .

aat:300263149 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kupa"@en .

aat:300263150 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kakanda"@en .

aat:300263151 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting western Cameroon and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oli"@en .

aat:300263152 a skos:Concept ;
    skos:definition "Works produced by the African ethnic group of the same name inhabiting Côte d'Ivoire. The Ano were formerly part of the Anufo, who later migrated into Ghana and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ano"@en .

aat:300263153 a skos:Concept ;
    skos:definition "Works produced by the African ethnic group of the same name inhabiting northern Ghana and northern Togo, formerly part of the Ano and inhabiting Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anufo"@en .

aat:300263154 a skos:Concept ;
    skos:definition "Styles, cultures, and ethnicity of the region of the Lower Kasai river, primarily in today's Democratic Republic of the Congo. is GT, need concept"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Kasai"@en .

aat:300263155 a skos:Concept ;
    skos:definition "Refers to the Late Assyrian period from 721 to 627 BCE, during the rule of the dynasty founded by Sargon II and including his successors, Sennacherib, Esarhaddon, and Assurbanipal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sargonid"@en .

aat:300263156 a skos:Concept ;
    skos:definition "Cultures and styles of the Ubangi River region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ubangi River"@en .

aat:300263157 a skos:Concept ;
    skos:definition "Those trained in or practicing acrobatics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrobats"@en .

aat:300263158 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Cameroon and Gabon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tanga"@en .

aat:300263159 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in southern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bane"@en .

aat:300263160 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, a subgroup of the Songye living in southeastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalebwe"@en .

aat:300263161 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name, a subgroup of the Mongo living in Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kala"@en .

aat:300263162 a skos:Concept ;
    skos:definition "The art of tumbling, balancing, and jumping presented as performance, often with the use of such apparatus as poles, unicycles, tightropes, trampolines, and trapezes, and typically performed at fairgrounds, circuses, and theaters. For the competitive sport involving physical exercises of strength, agility, and balance, use \"gymnastics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrobatics"@en .

aat:300263163 a skos:Concept ;
    skos:definition "Refers to the style of marble figures produced in the Cycladic archipelago during the Early Cycladic period but specifically during the period between roughly 3500 and 3000 and 2800 or 2600 BCE. Named for the site of their discovery on the island of Naxos, the abstract figures are characterized by featureless heads and stump-like arms that extend from their sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Louros type"@en .

aat:300263164 a skos:Concept ;
    skos:definition "Refers to the style of marble, folded-arm type figurines produced in the Cycladic archipelago during the Early Cycladic period. Named for the site of discovery in a cemetery on Amorgos, they are characterized by slender yet naturalistic proportions and rounded forms found especially in the shape of the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kapsala"@en .

aat:300263165 a skos:Concept ;
    skos:definition "Refers to the style of marble, folded-arm type figures produced in the Cycladic archipelago during the Early Cycladic period. Considered a departure from the traditional forms and proportions, the figures, which include representations of hunters or warriors, are characterized by wide shoulders, squat torsos, and arms that fold right over left."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chalandriani"@en .

aat:300263166 a skos:Concept ;
    skos:definition "Outdoor trails equipped with a series of stations where joggers or walkers stop and perform exercises on the apparatus provided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fitness trails"@en .

aat:300263168 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malete"@en .

aat:300263170 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Angola and Namibia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kung"@en .

aat:300263171 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Central African Republic and the northwestern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banziri"@en .

aat:300263172 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Budja"@en .

aat:300263173 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo, the Central African Republic, and the Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bondjo"@en .

aat:300263174 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in northwestern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boloki"@en .

aat:300263175 a skos:Concept ;
    skos:definition "Rooms in a palace or great house, often splendidly decorated and used for official and State entertaining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staterooms"@en .

aat:300263176 a skos:Concept ;
    skos:definition "The historical-political-cultural nexus of the global colonial experience and its aftermath in the late 20th century and beyond; it embraces the colonial past, the present time following the end of colonial status in a given region, the exile and diaspora of colonized and colonizing peoples, and the politics of multiculturalism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postcolonialism"@en .

aat:300263177 a skos:Concept ;
    skos:definition "Approach to art education based on and integrating the four disciplines of decorative arts, art criticism, art history, and aesthetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discipline-based art education"@en .

aat:300263178 a skos:Concept ;
    skos:definition "Businesses that offer services in advertising, branding, marketing, and promotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising agencies"@en .

aat:300263179 a skos:Concept ;
    skos:definition "Fields in the building and construction industries requiring specialized knowledge. These fields may include carpentry, masonry, electricity, heating, ventilation, and plumbing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building trades"@en .

aat:300263180 a skos:Concept ;
    skos:definition "Large, wooden, serving spoons with carved handles, typically in the form of a human head, domestic animals or ornament, used by the Dan and neighboring peoples in Liberia in association with feasts, and serving as a symbol of hospitality and generosity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wunkermian"@en .

aat:300263181 a skos:Concept ;
    skos:definition "People who own the premises they live in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homeowners"@en .

aat:300263182 a skos:Concept ;
    skos:definition "Children's books intended for use in the bath, with plastic or vinyl waterproof leaves, often filled with foam sponge so that they float; usually pictures predominate over text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bath books"@en .

aat:300263183 a skos:Concept ;
    skos:definition "Mass-produced children's books, printed on cheap and lightweight but very thick paper, typically containing non-copyright material for which no royalties had to be paid, printed in large type, and re-using the same illustrations from one book to another. They were produced in Britain from about 1925."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bumper books"@en .

aat:300263184 a skos:Concept ;
    skos:definition "Stories paraphrasing Biblical texts or closely based on Biblical events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bible stories"@en .

aat:300263185 a skos:Concept ;
    skos:definition "Manuals containing sets of words, formulas, verses, or incantations that are supposed to possess occult or magical powers, cast spells, invoke demons, and achieve other occult purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grimoires"@en .

aat:300263186 a skos:Concept ;
    skos:definition "Of, relating to, or contained in the Bible, which contains the sacred scriptures of Judaism or Christianity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biblical"@en .

aat:300263187 a skos:Concept ;
    skos:definition "Having to do with the ancient philosophers of the Academy, which was the school of Plato and his followers, founded by Plato in ca. 387 BCE in Athens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Academic"@en .

aat:300263188 a skos:Concept ;
    skos:definition "Refers to the Neolithic period in the southern Levant from about 6000 to 4500 BCE. The period is characterized by the introduction of pottery and the production of clay and stone figurines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pottery Neolithic"@en .

aat:300263189 a skos:Concept ;
    skos:definition "Platforms extending part-way or all the way from side to side of a vessel, forming a covering for the space below and itself serving as a floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decks"@en .

aat:300263190 a skos:Concept ;
    skos:definition "Main structural members running for and aft along the bottom of a ship or boat, to which the frame of the vessel is attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keels"@en .

aat:300263191 a skos:Concept ;
    skos:definition "Actions and methods performed by transmitting and receiving information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmission processes"@en .

aat:300263193 a skos:Concept ;
    skos:definition "Process of transmitting and recieving information to and from one's place of employment via telecommunication systems, such as microcomputers and modems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telecommuting"@en .

aat:300263194 a skos:Concept ;
    skos:definition "Communities designed to provide telecomunications services for to people working at home, often including state-of-the-art techonolgy and located in rural areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "televillages"@en .

aat:300263195 a skos:Concept ;
    skos:definition "The process of enhancing or modifying the grain on a piece of leather by folding it grain side to grain side and working the fold across the leather back and forth either by hand with a board or by means of a boarding machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boarding"@en .

aat:300263196 a skos:Concept ;
    skos:definition "The process of attaching individual boards to a text block, usually by gluing the tapes and spine-lining material to the inside of single boards or between split boards, or by the lacing-in of the cords through holes or grooves in the boards. For the attachement of a previously made case to a text block, use \"casing-in.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board attachment"@en .

aat:300263197 a skos:Concept ;
    skos:definition "Style and culture of the African ehnic group of the same name living on Luanda Island in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Axiluanda"@en .

aat:300263198 a skos:Concept ;
    skos:definition "Enclosed spaces on the deck of a ship, housing the steering wheel and other navigating devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilothouses"@en .

aat:300263199 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shinji"@en .

aat:300263201 a skos:Concept ;
    skos:definition "Having both of two ends that are similar or exactly alike. Examples include watercraft with both ends built alike and a bolt having a screw-thread on each end."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-ended"@en .

aat:300263202 a skos:Concept ;
    skos:definition "The characteristic of having an angular, V-shaped bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-bottomed"@en .

aat:300263204 a skos:Concept ;
    skos:definition "Continuous, unbroken decks from stem to stern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush decks"@en .

aat:300263205 a skos:Concept ;
    skos:definition "Business enterprises owned and usually operated by married or co-habiting couples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couple-owned business enterprises"@en .

aat:300263206 a skos:Concept ;
    skos:definition "Refers to the square cloths used for wiping the face, carried by the upper classes in Ancient Rome. Examples are cloths venerated as relics, believed to be parts of the cloth carried by Saint Veronica, which according to legend, was used to wipe the face of Christ and on which his features were impressed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sudaria"@en .

aat:300263207 a skos:Concept ;
    skos:definition "Eyeglasses consisting of a single lens, without a nosepiece or frame, used to compensate for defective vision in one eye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monocles"@en .

aat:300263208 a skos:Concept ;
    skos:definition "Breweries that produce a limited amount of high quality beer annually, and typically selling their products on the premises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microbreweries"@en .

aat:300263209 a skos:Concept ;
    skos:definition "General term for literary works written and published for children, including fiction and non-fiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's literature"@en .

aat:300263210 a skos:Concept ;
    skos:definition "Market towns, typically French, that developed around a castle, monastery, or church and were often fortified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bourgs"@en .

aat:300263211 a skos:Concept ;
    skos:definition "Rigs consisting of a single gaff and boom mainsail set on a mast stepped close to the stern and carrying no headsails, found on catboats and other watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cat rigs"@en .

aat:300263213 a skos:Concept ;
    skos:definition "Lines applied to the sides of a vessel indicating maximum draft to which it may be loaded under various conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plimsoll lines"@en .

aat:300263214 a skos:Concept ;
    skos:definition "Adjustment of a loss when cargo on board a ship belonging to one or more owners has been sacrificed for the safety of the whole, whereby the amount of the loss is shared by all who have cargo on board the vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general average"@en .

aat:300263215 a skos:Concept ;
    skos:definition "Plan of buildings, typically churches or ancient Roman structures, that has an oblong footprint, a nave, side aisles, an apse, and clerestory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basilican plan"@en .

aat:300263216 a skos:Concept ;
    skos:definition "Bag-shaped fish traps with cork floats, towards which fish are directed by means of a leader, such as a line of netting; used in rivers and sheltered waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fykes"@en .

aat:300263217 a skos:Concept ;
    skos:definition "Trophies consisting of the whole bodies or portions of game animals or fish taken in hunting, preserved as souvenirs usually by being taxidermized and mounted for display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting trophies"@en .

aat:300263218 a skos:Concept ;
    skos:definition "Color prints made using a combination printing process involving an intaglio, or occasionally lithographic, key plate which prints the image, after which color is superimposed on the print using wood blocks. The process was patented by an Englishman, George Baxter, in 1835, and was very popular up into the 1870s. The term is sometimes used to refer exclusively to prints made by Baxter himself; Baxter-process prints is a term used to describe prints of the same process made by other printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baxter prints"@en .

aat:300263219 a skos:Concept ;
    skos:definition "Generally, the process of separating an object or material from end to end into two or more layers. In the context of leather manufacture, use specifically for the process of dividing a hide or skin horizontally into two or more layers, a practice originating with the introduction of the splitting machine in the mid-19th century, performed either after the hide or skin has been fully or partially limed, or after tanning. The resulting layers are termed \"splits.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splitting"@en .

aat:300263220 a skos:Concept ;
    skos:definition "Condition caused by the early stage of growth of any of several types of mold or fungi, appearing as a white to black downy and often smelly film on the surface of organic materials such as cloth, wood, leather, and paper. The two most common species are Aspergillus glaucus and Penicillium glaucum. Mildew is most often found in warm, damp, dark areas and can often look like dirt. It excretes damaging organic acids, such as citric, oxalic, gluconic, etc., that can discolor dyed textiles, paper, paint and leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mildew"@en .

aat:300263221 a skos:Concept ;
    skos:definition "Tables giving daily predictions, usually a year in advance, of the times and heights of the tide for one or more places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tide tables"@en .

aat:300263222 a skos:Concept ;
    skos:definition "Refuge settlements established by fugitive Middle Passage slaves particularly from Loango Coast, found especially in Sao Tomé and Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quilombos"@en .

aat:300263223 a skos:Concept ;
    skos:definition "Rags, typically soaked with olive oil, and used to remove surplus gold from surfaces of bookbindings after tooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold rag"@en .

aat:300263224 a skos:Concept ;
    skos:definition "Ship's papers made out by the shipmaster at the end of a voyage stating the total earnings of each crew member, including any overtime or gratuities due under special circumstances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portage bills"@en .

aat:300263225 a skos:Concept ;
    skos:definition "Life-saving devices resembling and operating similarly to firearms, designed to shoot a rocket or other projectile with a line or rope to a stranded vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "line-throwing guns"@en .

aat:300263226 a skos:Concept ;
    skos:definition "Renting or hiring something for exclusive use, typically a boat, airplane, or bus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chartering"@en .

aat:300263227 a skos:Concept ;
    skos:definition "Compensation derived from a share of profits from a whaling or fishing voyage, distributed to officers and crew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lays"@en .

aat:300263228 a skos:Concept ;
    skos:definition "Any or all of those processes involved in the manufacture of leather or rawhide that follow curing and precede tanning or tawing of skins or hides. The objective is to rid the skins or hides of substances not wanted in the finished leather, and to put them in the proper chemical and physical condition for tanning or tawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beamhouse operations"@en .

aat:300263230 a skos:Concept ;
    skos:definition "Treating skins or hides with brain tissue which contains phosphorous compounds that oxidize oils to aldehydes. The process is not considered true tanning, as it is reversible, and the shrinkage temperature of the resulting material is not raised above that of the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brain tannage"@en .

aat:300263231 a skos:Concept ;
    skos:definition "Removing defects from the flesh side of leather by means of an abrasive or abrading tool. For the removal of defects from the grain side of leather by similar means, use \"buffing (leather process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluffing"@en .

aat:300263232 a skos:Concept ;
    skos:definition "Removing scars, scratches, and other defects from the grain side of leather by means of an abrasive or abrading tool. For the removal of defects from the flesh side of leather by similar means, use \"fluffing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffing"@en .

aat:300263233 a skos:Concept ;
    skos:definition "Parts or components of scaffolds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaffold components"@en .

aat:300263234 a skos:Concept ;
    skos:definition "Short pieces of timber supporting the planks of a mason's scaffold, one end supported by the scaffold, the other inserted in a putlog hole left in the masonry wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "putlogs"@en .

aat:300263236 a skos:Concept ;
    skos:definition "Pan or other collector placed beneath a pipe, tub, or other fixture to prevent leakage or overflow from getting onto the floors, ceilings, or walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safes"@en .

aat:300263237 a skos:Concept ;
    skos:definition "Diagrams for setting up shaft looms to construct particular weaves. Traditonally drawn up on point paper or some other kind of paper with preprinted lines, they show at least one weave unit of the cloth to be woven. A complete set of them instructs the weaver how to plot the drawing in of the warp, connect the shafts and treadles, the order in which the treadles are to be used, the interlacement of warp and weft, and the transverse section of the weave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weaving drafts"@en .

aat:300263238 a skos:Concept ;
    skos:definition "Graph paper on which weaving drafts for shaft looms and point paper plans for drawlooms or looms with a Jacquard attachment are printed or drawn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point paper"@en .

aat:300263239 a skos:Concept ;
    skos:definition "Refers to the northern European Mesolithic period and culture that flourished around 7,000 Before Present. It is characterized by the return of cold-climate technologies that followed the milder interstadial period and the Hamburgian culture, including a distinctive antler ax, called the \"Lyngby Axe,\" detachable antler harpoon heads, harpoon-like arrowheads with detachable shafts, other re-usable tools, and decorative motifs similar to Hamburgian, such as fishbone patterns, meanders, and geometric figures. The culture spread over the lowlands now occupied by the North Sea, from Germany to the Netherlands and south-east England. Some scholars believe that it may have had ties to eastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ahrensburgian"@en .

aat:300263240 a skos:Concept ;
    skos:definition "Two siblings conceived, carried in the womb, and usually born at the same time. They may be identical, as when one fertilized egg splits, or fraternal, as when two eggs are individually fertilized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twins"@en .

aat:300263241 a skos:Concept ;
    skos:definition "Scripts related to conventionalized pictures or symbols that convey an idea or thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ideographic scripts"@en .

aat:300263242 a skos:Concept ;
    skos:definition "An ideographic script developed and used by the peoples of the Cross River region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nsibidi"@en .

aat:300263243 a skos:Concept ;
    skos:definition "Offerings of an animal, plant, or human life or of some material possession to a divinity or personage of great religious significance in order to establish, maintain, or restore a right relationship of a human being or community to the sacred order, such as through propitiation or homage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacrifices"@en .

aat:300263244 a skos:Concept ;
    skos:definition "Military groups of the Fante of Ghana, constituting the primary defensive units of the Fante states. They also serve political, social, and religious functions. They are widely known for the colorful flags that represent them at important festivals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asafo"@en .

aat:300263245 a skos:Concept ;
    skos:definition "Process of drying out a pelt to preserve it. For the more complex process that treats the skin to preserve it with a flexible and soft texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin curing"@en .

aat:300263246 a skos:Concept ;
    skos:definition "A method of curing hides and skins, generally employed in the larger abattoirs, prior to transportation to tanneries. After flaying, and a thorough washing and brushing to remove hair and flesh, the hides or skins are hung in pits or large paddles in a very strong solution of sodium chloride, causing salt to penetrate the material. Distinct from \"pickling,\" a beamhouse operation following bating, in which hides and skins are soaked in a solution of 12% salt and 1.2% sulfuric acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brining"@en .

aat:300263247 a skos:Concept ;
    skos:definition "In bookbinding, the process of indicating on the back of a text block the intended locations of the sewing stations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marking up"@en .

aat:300263249 a skos:Concept ;
    skos:definition "Persons who fit the rigging of watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riggers"@en .

aat:300263250 a skos:Concept ;
    skos:definition "The study of the rules of a language governing the sounds, words, sentences, and other elements, including their structure, combination, and interpretation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grammar"@en .

aat:300263251 a skos:Concept ;
    skos:definition "Those who study the nature and function of poetry, identifying and describing its types, forms, and techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poeticians"@en .

aat:300263252 a skos:Concept ;
    skos:definition "Facing technique producing a mixture of square and rectangular stones or bricks. The term is also sometimes used for any of several other patterns of laying flat masonry in what was considered the 'Roman manner.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus romanum"@en .

aat:300263253 a skos:Concept ;
    skos:definition "The beamhouse operation of treating unhaired hides or skins with a solution of fermented dog manure to remove undesirable constituents and impart a quality of softness and flexibility to the final leather. It is a similar process to bating, which involves pigeon or hen manure, but faster, as the solution is more powerful, and also possibly more damaging to the hides or skins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puering"@en .

aat:300263254 a skos:Concept ;
    skos:definition "Curing skins and hides for later tanning by coating them with salt after flaying and hanging them to dry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry-salting"@en .

aat:300263255 a skos:Concept ;
    skos:definition "Rubbing or scraping the flesh side of leather with a hand tool, such as a moon knife, to make it soft and pliable. Distinct from \"staking\" in that the leather is secured and the tool is moved. It is a gentler operation than staking, and done mainly on furred or woolled skins or delicate ones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perching"@en .

aat:300263256 a skos:Concept ;
    skos:definition "Drawing a piece of leather or rawhide over a stationary rigid edge, either by hand or by machine, to soften it and render it more pliaable. Distinct from \"perching\" in that the leather moves and the tool is stationary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staking"@en .

aat:300263257 a skos:Concept ;
    skos:definition "Prehistoric Iron Age culture, partially identified by characteristic pottery found on the East African littoral from Kilwa,Tanzania to the river Tana in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tana"@en .

aat:300263258 a skos:Concept ;
    skos:definition "A beamhouse operation, following bating, in which dehaired hides and skins are soaked in or saturated with 12% salt and 1.2% sulfuric acid to either prepare them for chrome tanning, or to preserve them to be stored for later tanning. Distinct from \"brining\", which is the soaking of hides and skins in strong salt solution to cure them before transportation to tanneries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickling"@en .

aat:300263259 a skos:Concept ;
    skos:definition "Imparting a smooth, glossy finish to leather by pressing it against a highly-polished heated metal plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plating"@en .

aat:300263260 a skos:Concept ;
    skos:definition "The process of smoothing and compressing the grain side of leather by subjecting it to the action of a heavy metal roller under pressure, performed by machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling"@en .

aat:300263261 a skos:Concept ;
    skos:definition "Any vessels engaged in the smuggling of liquor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rumrunners"@en .

aat:300263262 a skos:Concept ;
    skos:definition "Narrow, removeable boards of wood or metal lowered through the bottom of watercraft to increase stability. For similar, pivoting boards mounted in a casing or trunk located amidships, use \"centerboards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daggerboards"@en .

aat:300263263 a skos:Concept ;
    skos:definition "Artists who specialize in decorating pottery by applying two-dimensional designs using paint made of metallic oxides or other pigments held in suspension in slip or another medium. The term is particularly used to refer to Ancient Greek artists who worked in these media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vase painters"@en .

aat:300263264 a skos:Concept ;
    skos:definition "Refers generally to workmen and craftsmen who work with marble, including those who do any of quarrying, dressing, sculpting, mosaic, and masonry work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marble workers"@en .

aat:300263265 a skos:Concept ;
    skos:definition "Those who make, process, or handle ribbons, including those who attach them to garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbonmakers"@en .

aat:300263267 a skos:Concept ;
    skos:definition "Recreation involving at least some bodily exercise or hands-on activity, especially in children and immature animals as part of their process of learning adult behavior and exploring their environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play"@en .

aat:300263268 a skos:Concept ;
    skos:definition "Charters by which all or part of a ship is leased for a specific voyage or period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charter parties"@en .

aat:300263269 a skos:Concept ;
    skos:definition "Maskers, primarily of African descent, who masquerade as Native Americans for Carnival parades in various cities and nations including New Orleans, Toronto, London, Brooklyn, Brazil, and Haiti and other island nations of the Caribbean. They are renowned for their elaborate, vividly-colored, hand-made costumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Black Indians"@en .

aat:300263270 a skos:Concept ;
    skos:definition "Use to describe the works and activities produced or carried out by people of combined African American and Creole heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afro-Creole"@en .

aat:300263271 a skos:Concept ;
    skos:definition "Short, deep keels in the shape of a fin, used typically by racing yatchs to improve winward sailing and increase transverse stabilty under sail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fin keels"@en .

aat:300263272 a skos:Concept ;
    skos:definition "The condition, as it applies to optical phenomena and images in any medium or on any support, of being visually indistinct or hazy in outline or detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blur"@en .

aat:300263273 a skos:Concept ;
    skos:definition "Weapons that serve ceremonial or symbolic functions, for instance as symbols of office, public regalia, or signs of personal status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial weapons"@en .

aat:300263274 a skos:Concept ;
    skos:definition "Exhibitions staged in the open air instead of in an enclosed space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open air exhibitions"@en .

aat:300263276 a skos:Concept ;
    skos:definition "Buildings within a religious community complex in which novices are housed and trained during their period of probation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novitiates"@en .

aat:300263278 a skos:Concept ;
    skos:definition "Machines for turning fiber into thread or yarn, in which the formation of the thread is performed by the help of a wheel worked either by a hand or foot pedal that spins the thread onto a single spindle. Said to have been invented in India, they were introduced into Europe via the Middle East in the Medieval period, and were in common use there and in North America after colonization into the 18th century. For spinning machines developed in the 18th century having more than one spindle, use \"spinning jennies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinning wheels"@en .

aat:300263279 a skos:Concept ;
    skos:definition "Machines used on dairy farms and in factories for separating and removing cream from whole milk, consisting of a centrifuge in the form of a rapidly revolving bowl containing a set of disks and mounted on a spindle. Milk enters the bowl at the top, and as the bowl revolves, the heavier skim milk is thrown to the outer sides and led off through openings while the cream concentrates in the interior and is led off through a cream outlet at the center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream separators"@en .

aat:300263280 a skos:Concept ;
    skos:definition "Agricultural buildings equipped with kilns for drying hops, typically circular in plan, with a conical roof and commonly found in Kent, England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oasthouses"@en .

aat:300263281 a skos:Concept ;
    skos:definition "Refers to the period in history when Rome was ruled by kings, traditionally from the founding of the city by the legendary Romulus in 753 BCE to the establishment of the Republic in 509 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monarchic"@en .

aat:300263282 a skos:Concept ;
    skos:definition "Refers to the period and dynasty of the two legendary Etruscan kings of ancient Rome named Tarquinius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarquinian"@en .

aat:300263283 a skos:Concept ;
    skos:definition "Refers to the Predynastic period in Upper Egypt around 4500 BCE. The period is characterized by pottery that is primitive in appearance which has led some scholars to believe it is earlier in date than the Badarian period. Others believe it is contemporary with the Badarian period or just an early stage of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tasian"@en .

aat:300263284 a skos:Concept ;
    skos:definition "Refers to the phase in the Ubaid period in southern Mesopotamia from about 5000 to 4500 BCE. The phase is characterized by monocrhrome pottery with simple geometric designs and increased connections with areas outside of southern Mesopotamia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ubaid 3"@en .

aat:300263285 a skos:Concept ;
    skos:definition "Refers to the phase in the Ubaid period in southern Mesopotamia from about 4500 to 4000 BCE. The phase is characterized by the continuation of Ubaid 3 pottery although the designs are painted with less skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ubaid 4"@en .

aat:300263286 a skos:Concept ;
    skos:definition "Persons who produce scrimshaws; originally whalers who carved whale teeth and baleen while aboard ship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrimshanders"@en .

aat:300263287 a skos:Concept ;
    skos:definition "Ships' papers issued to a neutral vessel certifying her nationality and the specific details of a voyage, such as cargo, names and nationalities of crew members, port of registry, and destination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea letters"@en .

aat:300263288 a skos:Concept ;
    skos:definition "Builder's models comprising a plank backboard or sawn-out section of the hull of a ship with plank sections mounted onto it to represent the frames of the proposed vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hawk's nest models"@en .

aat:300263289 a skos:Concept ;
    skos:definition "Barriers that surround a camp or settlement, or reinforce a defensive wall. They are typically composed of strong branches of trees placed upon a rampart, or they are made of a palisaded bank or mound, or a rampart of earth, sod, or stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valla"@en .

aat:300263290 a skos:Concept ;
    skos:definition "Ship builder's models comprising layers of horizontal planks designed to be removed and measured as a guide in determining the waterlines of a proposed vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lift models"@en .

aat:300263291 a skos:Concept ;
    skos:definition "Builder's models comprising alternating strips of constrasting colored wood glued edge to edge to create a checkerboard effect when carved, and to distinguish the sectional lines of a proposed vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkerboard models"@en .

aat:300263292 a skos:Concept ;
    skos:definition "The practice of rescuing or protecting lives from danger of death, typically from drowning or fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "life-saving"@en .

aat:300263293 a skos:Concept ;
    skos:definition "Sterns in which the bottom edge of the transom is above the waterline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter sterns"@en .

aat:300263294 a skos:Concept ;
    skos:definition "Declarations made by the master of a vessel before a government official, indicating that any damage incured during a voyage was due to sailing conditions rather than neglect or misconduct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protests"@en .

aat:300263295 a skos:Concept ;
    skos:definition "Refers to the process or technique of welding together particles or particulate material, usually metal or ceramic, by applying heat below the melting point, so that the particles coalesce into a solid mass without liquefaction. It is typically used to create or decorate ceramics or metalwork, or to improve the mechanical or physical properties of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sintering"@en .

aat:300263302 a skos:Concept ;
    skos:definition "Wheels for winding yarn or thread typically consisting of an expandable cage that swivels on a verical shaft and a finial cup, designed to be free standing on its own legs, attachted to the lids of sewing baskets or designed to be clamped on to the edge of a table. A skein of yarn is placed over the cage and turned, swiveling to order to wind a neat ball of yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swifts"@en .

aat:300263303 a skos:Concept ;
    skos:definition "Refers to the earliest phase of Minoan art and culture, according to the classification system devised by the archaeologist, Nikolas Platon. It is characterized by a society on Crete divided into a series of small units, politically and economically independent, with great regional variation, though sharing certain common cultural traits. It overlaps with the Early Minoan period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prepalatial"@en .

aat:300263304 a skos:Concept ;
    skos:definition "Liberal denomination founded in the United States and Canada in 1961 through the merger of the Unitarian and Universalist denominations. Its characteristic principles include the responsibility of each individual for her or his own religious beliefs and ethics, the inherent worth and dignity of every human being, the value of religiously-motivated action for social reform, democratic method in church governance, and respect and regard for a diversity of religious traditions. There is no creed to which members must subscribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unitarian Universalism"@en .

aat:300263305 a skos:Concept ;
    skos:definition "The liberal Protestant movement that arose in Europe during the 16th century Reformation, was embodied in a church in Transylvania, and achieved denominational status in the 19th century in the United Kingdom, the United States, and Canada. It is characterized by a denial of the orthodox Christian doctrines of the Trinity and the divinity of Jesus, the free use of reason in religion, and the belief that God exists in one person. In 1961, in the United States and Canada, it merged with the Universalist denomination to form \"Unitarian Universalism.\" Use also generally for the theological doctrines of the unified nature of God and the humanity of Jesus, first expressed in second- and third-century monarchism and in the teachings of Arius in the third and fourth centuries, and later in the radical Neoplatonist thinkers of the Reformation such as Michael Servetus, Faustus Socinus, and Ferenc David."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Unitarianism"@en .

aat:300263306 a skos:Concept ;
    skos:definition "Specifically the liberal Protestant denomination active in the United States and Canada, starting first as an organized movement in the 18th century and achieving denominational status in the 19th century. Its basic and defining belief was in the salvation of all souls, rejecting the Calvinist doctrine of the election of a few and the damnation of many. Other principles included the freedom of individual interpretation, tolerance of diversity, and the inherent worth and dignity of all human beings. In 1961 it merged with \"Unitarianism\" to form a new denomination \"Unitarian Universalism.\" Use also generally for the doctrine of universal salvation that has appeared at various times in Christian history, starting with the writings of Origen in the third century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Universalism"@en .

aat:300263307 a skos:Concept ;
    skos:definition "Type of porcelain material comprising a relatively high proportion of clay to china stone, and usually produced in China or Europe. It is characterized by having extremely thin and fine, even translucent walls, and is typically white in color, thus resembling the shell of a bird's egg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggshell porcelain"@en .

aat:300263308 a skos:Concept ;
    skos:definition "Smoking apparatuses in which the smoke is drawn through a cnotainer of water and cooled before reaching the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water pipes"@en .

aat:300263309 a skos:Concept ;
    skos:definition "Style of works produced by the African ethnic group of the same name livnig in Uganda and west of Lake Edward in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Konjo"@en .

aat:300263310 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Namibia and South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nama"@en .

aat:300263311 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in southeastern Cameron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maka"@en .

aat:300263312 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ovimbundu"@en .

aat:300263313 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo, a dynastic ruling group of the Zande."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bandia"@en .

aat:300263314 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Enya"@en .

aat:300263315 a skos:Concept ;
    skos:definition "Lists or other accounts of relics in a collection of other context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relic inventories"@en .

aat:300263316 a skos:Concept ;
    skos:definition "Describes ceramic or objects of ceramic fashioned from a mixture of clay and crushed rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grit-tempered"@en .

aat:300263317 a skos:Concept ;
    skos:definition "Fragments of a ceramic or glass vessel from just below the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rim sherds"@en .

aat:300263318 a skos:Concept ;
    skos:definition "Buildings housing collections of photographs, sometimes including other visual resources in various formats and media, usually within larger libraries, archives, or collections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture libraries"@en .

aat:300263324 a skos:Concept ;
    skos:definition "The first phase in the Early Dynastic period in Mesopotamia, from about 2900 to 2750 BCE. It is characterized by innovations in architecture, specific styles of seal carving, and transitional styles in the plastic arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Dynastic I"@en .

aat:300263325 a skos:Concept ;
    skos:definition "The second phase of the Early Dynastic period in Mesopotamia, from about 2750 to 2600 BCE. It is characterized by stylized sculpture, the development of the combat scene in seal carving, and a relative homogeneity in the plastic arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Dynastic II"@en .

aat:300263326 a skos:Concept ;
    skos:definition "The third phase of the Early Dynstic period in Mesopotamia, from about 2600 to 2340 BCE. It is characterized by the development of the description of historical events in sculpture, finely-crafted luxury objects, and innovations in the construction of temples and palaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Dynastic III"@en .

aat:300263327 a skos:Concept ;
    skos:definition "The process of writing alternate lines in opposite directions, one line from left to right, then the next from right to left, with the letters in the lines starting at right reversed as in a mirror; found in various ancient instriptions in Greek and other languages. Used metaphorically in analysis of narrative painting to refer to the disposition of the scene from right to left, then from left to right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boustrophedon"@en .

aat:300263328 a skos:Concept ;
    skos:definition "East African rectangular cotton textiles printed in bold designs and bright colors, with borders that frame the panel that often contain Swahili inscriptions. They are variously used as main garments, skirts, shawls, hoods, and even occasionally as tablecloths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kangas"@en .

aat:300263329 a skos:Concept ;
    skos:definition "Ritual African cloth associated with the men's association known as Ekpe found among the Igbo and other peoples of the Cross River region of southern Nigeria. Indigo dyed and covered with symbols, including nsibidi, it is usually worn as a wrapper and is the prerogative of the highest grade of Ekpe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ukara"@en .

aat:300263330 a skos:Concept ;
    skos:definition "Dolls that by means of a bellows or other mechanism in the inside are able to emit the sounds of speech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talking dolls"@en .

aat:300263332 a skos:Concept ;
    skos:definition "Card games played with tarot cards, especially the central European game played with 22 Greater Arcana tarot cards and up to 56 regular modern playing cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarot"@en .

aat:300263333 a skos:Concept ;
    skos:definition "Describes categories of furnishings that share a set of stylistic or formal criteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture genres"@en .

aat:300263334 a skos:Concept ;
    skos:definition "Indigenous furniture typically produced by anonymous craftsmen and based on either traditional practices or high-style prototypes that may follow the original closely or display a range of modifications, such as a simplication of form and the use of local materials and techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernacular furniture"@en .

aat:300263335 a skos:Concept ;
    skos:definition "The state or quality of extending in the same direction and being everywhere equidistant, usually referring to lines or linear objects and structures. For the corresponding adjective, use \"parallel.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallelism"@en .

aat:300263336 a skos:Concept ;
    skos:definition "Slotted boxes or other containers used, often in churches, for receiving offerings or donations. They may be portable, or fixed to a part of the building or a furnishing. Portable collection boxes typically have a handle used to pass around in order to collect donations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collection boxes"@en .

aat:300263337 a skos:Concept ;
    skos:definition "Books containing coupons that entitle the holder to a fixed allowance of a rationed item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ration books"@en .

aat:300263338 a skos:Concept ;
    skos:definition "Comic books or strips in which the pictures are photographs with balloons containing the speech or thoughts of the characters. Most are of the romance or soap opera kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fotonovelas"@en .

aat:300263339 a skos:Concept ;
    skos:definition "Fiction written for adolescents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "young adult fiction"@en .

aat:300263341 a skos:Concept ;
    skos:definition "Handthrown earthenware vessels made for domestic use, particularly by inhabitants of the remote Hebrides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craggans"@en .

aat:300263343 a skos:Concept ;
    skos:definition "The process of gilding the edges of gatherings before they are sewn into a text block, giving the gilded edges a slightly uneven apperance. Distinct from \"gilt on the rough\" which is gilding on uncut or deckle edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough gilt"@en .

aat:300263344 a skos:Concept ;
    skos:definition "The process of gilding the edges of text blocks that have not first been cut smooth or are deckled. Distinct from \"rough gilt\" which is the process of gilding unsewn gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilt on the rough"@en .

aat:300263345 a skos:Concept ;
    skos:definition "The process of gilding the edges of a book with a piece of paper laid over the gold and the burnisher rubbed over the paper, resulting in a dull finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dull gilt"@en .

aat:300263346 a skos:Concept ;
    skos:definition "Small stoves used for heating finishing and lettering tools, especially in the context of bookbinding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finishing stoves"@en .

aat:300263347 a skos:Concept ;
    skos:definition "The Situationist concept of the integration of pre-existing artistic media or elements into newer art production for purposes of social, political, or artistic commentary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "détournement"@en .

aat:300263348 a skos:Concept ;
    skos:definition "Branch of social anthropology that studies the culture history of specific peoples using historic oral, pictorial, and textual documents as the major research sources. Refers also to the study of a people's own telling and interpretation of its history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnohistory"@en .

aat:300263349 a skos:Concept ;
    skos:definition "People who study or practice that branch of social anthropology that studies the culture history of specific peoples using historic oral, pictorial, and textual documents as the major research sources.Use also for those who study a people's own telling and interpretation of its history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnohistorians"@en .

aat:300263351 a skos:Concept ;
    skos:definition "People who function as doorkeepers and escorts, responsible for guiding and seating people in a theater, church, courtroom, or other place of assembly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ushers"@en .

aat:300263352 a skos:Concept ;
    skos:definition "Brooches in the shape of a ring, with a movable pin that may extend beyond the diameter of the ring; usually of metal and often ornamented. Used to fasten costume and worn especially during the Medieval period in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring brooches"@en .

aat:300263353 a skos:Concept ;
    skos:definition "Inclined platforms fixed to the top of lecterns, and sometimes on altars, writing desks, or other furniture on which an open book may be supported."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookrests"@en .

aat:300263354 a skos:Concept ;
    skos:definition "Blank spaces or missing portions of a written or printed text, of the media or support of a two-dimensional object, or of paint or a coating on a three dimensional object; objects subject to lacunae include paintings, mosaics, manuscripts, and painted sculptures. Lacunae result from damage or accidental omission; intentional omissions are not called \"lacunae.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacunae"@en .

aat:300263358 a skos:Concept ;
    skos:definition "Private local area networks set up within an organization, using the same kinds of software and protocols used on the public Internet but for internal use only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intranets"@en .

aat:300263359 a skos:Concept ;
    skos:definition "Gardening in which the plants are grown in vertical containers containing soil, compost, or other growing medium, and often trained upward on trellises or walls, requiring little space and water compared to conventional gardening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical gardening"@en .

aat:300263360 a skos:Concept ;
    skos:definition "Lakes or reservoirs created behind a dam or other man-made structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial lakes"@en .

aat:300263361 a skos:Concept ;
    skos:definition "Additive to clay, such as sand or grit, that improves workability, uniform forming and drying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temper"@en .

aat:300263362 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name living in the Western Sudan, primarily around the upper Volta rivers area and in the countries of Burkina Faso, Mali, Ghana, Côte d'Ivoire, Togo, and Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gur"@en .

aat:300263365 a skos:Concept ;
    skos:definition "A part of the Internet containing documents stored in various locations worldwide and which are cross-referenced using hypertext links, accessed through a graphical user interface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "World Wide Web"@en .

aat:300263367 a skos:Concept ;
    skos:definition "Theory concerned with the relationships and mutual informing among disparate images of and references to other texts and works of visual art or architecture placed within a text or work of visual art or architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intertextuality"@en .

aat:300263368 a skos:Concept ;
    skos:definition "The concept that conditions in a society or period can foster artistic experimentation and innovation, as opposed to being closed and focused on tradition and ideas of the past."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artistic change"@en .

aat:300263369 a skos:Concept ;
    skos:definition "Activities, businesses, and professions that people pursue as a livelihood or as their primary endeavor, whether paid or not. For the degree or extent to which paid work is provided or available to the population, use \"employment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupations"@en .

aat:300263370 a skos:Concept ;
    skos:definition "In painting, sculpture, and artistic image-making of various kinds, representations of radiant light or luminosity emanating from divinities, holy persons, and other divine beings or objects, such as the Christian Lamb of God or the word \"God.\" Sometimes used by extention to refer to the entire ensemble of light and beings or objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glories"@en .

aat:300263371 a skos:Concept ;
    skos:definition "Concepts related to established systems of spoken or written communication used by a particular nation, culture, people, or community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "language-related concepts"@en .

aat:300263372 a skos:Concept ;
    skos:definition "The use of what was originally a picture-symbol or hieroglyph of an object or being to represent phonetically the initial syllable or sound of the name of the object or being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrophony"@en .

aat:300263373 a skos:Concept ;
    skos:definition "Science involved in the investigation of illegal activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forensic science"@en .

aat:300263374 a skos:Concept ;
    skos:definition "The branch of forensic science dealing with the study of fingerprints to establish the identity of the person who made them or from whom they were taken. For the method or technique of analyzing and identiying fingerprints, use \"dactyloscopy.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dactylography"@en .

aat:300263375 a skos:Concept ;
    skos:definition "The method or technique of analyzing and identifying fingerprints. For the branch of forensic science that studies fingerprints, use \"dactylography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dactyloscopy"@en .

aat:300263376 a skos:Concept ;
    skos:definition "Writing that, by means of various electronic, computerized devices, results in digital texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital writing"@en .

aat:300263377 a skos:Concept ;
    skos:definition "Metal composed of two or more layers of different metals joined to each other by plating and without being fused into a homogenous mass as in an alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plated metal"@en .

aat:300263378 a skos:Concept ;
    skos:definition "The lowest deck of a ship, typically for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orlop decks"@en .

aat:300263379 a skos:Concept ;
    skos:definition "Collections maintained by a nation's government and housed typically in a library, archive or museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national collections"@en .

aat:300263380 a skos:Concept ;
    skos:definition "Making or modifying something according to individual specifications or preferences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "customizing"@en .

aat:300263381 a skos:Concept ;
    skos:definition "Photogravure process in which the impression is produced by a rotary press using an intaglio engraved cylinder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotogravure"@en .

aat:300263382 a skos:Concept ;
    skos:definition "Drawing technique in which charcoal or, less commonly, pastel crayon is used on a board painted white and coated with marble dust, which gives the drawing a sandpaper-like sparkle and texture, and effects of light and dark similar to an engraving. Popular in mid-19th century United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandpaper painting"@en .

aat:300263383 a skos:Concept ;
    skos:definition "Drawings in charcoal or, less commonly, pastel on board painted white and coated with marble dust, which gives the finished drawing a sandpaper-like sparkle and texture, and effects of light and dark similar to those in engravings. Popular in the mid-19th-century United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandpaper paintings"@en .

aat:300263384 a skos:Concept ;
    skos:definition "Substances used to optically brighten or whiten materials including textiles and paper, or to give a blue tint to metal, particularly gunmetal. A variety of substances may be used as bluing including many pigments and chemical formulations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bluing"@en .

aat:300263385 a skos:Concept ;
    skos:definition "Intarsia technique that incorporates relief carving, developed in Bohemia, especially in Eger, and popular all over Europe from the mid-17th to the mid-18th century. It was used particularly for altar panels, furniture, and lids for game boxes and caskets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief intarsia"@en .

aat:300263386 a skos:Concept ;
    skos:definition "Fine, lustrous, soft, sheer cloth originating in the Philippines, woven from piña fibers, from the pineapple plant. It is used for decorative handkerchiefs, trimmings, lingerie, accessories, and home furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piña cloth"@en .

aat:300263387 a skos:Concept ;
    skos:definition "Heavyweight plain- or twill-weave cloth of worsted, cotton, wool, or other fibers, singly or in combination, first made in Bedford, England, characterized by heavy, warpwise cords or stripes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bedford cord"@en .

aat:300263388 a skos:Concept ;
    skos:definition "A proprietary name for a breathable waterproof material used chiefly for outdoor clothing. It is the a Teflon (TM)-based membrane filled with many minute pores which make it breathable yet waterproof and vapor proof. Its most common use is as a laminate between layers of cloth in all-weather clothing and footwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gore-Tex (TM)"@en .

aat:300263389 a skos:Concept ;
    skos:definition "Hard, red, scented wood of the species Prunus mahaleb, used for small objects such as nutcrackers and tobacco rasps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahaleb"@en .

aat:300263391 a skos:Concept ;
    skos:definition "Siliceous or calcareous material deposited at the mouth of springs or geysers, along streams, or on lake bottoms or shores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sinter"@en .

aat:300263392 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a sub-group of the Hausa, living among the people of Wukari in the Benue River region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abakwariga"@en .

aat:300263393 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Ghana, a subgroup of the Nzema."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ahanta"@en .

aat:300263394 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in southern Nigeria, a northeastern Yoruba subgroup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akoko"@en .

aat:300263395 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a subgroup of the Ijo living in the Niger River Delta region of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apoi"@en .

aat:300263396 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ataka"@en .

aat:300263397 a skos:Concept ;
    skos:definition "Style and culture of the African people who are a subgroup of the Berber, living in Awjilah, Cyranainca, northeast Libya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Awjilah"@en .

aat:300263398 a skos:Concept ;
    skos:definition "Construction toys consisting of girders, nuts, bolts, motors and other parts for assembling buildings and structures; first manufactured by the A.C. Gilbert Company in 1913 and later by the Meccano Company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Erector Sets (TM)"@en .

aat:300263399 a skos:Concept ;
    skos:definition "Structures used for storing and loading coal onto vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coaling stations"@en .

aat:300263400 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bangubangu"@en .

aat:300263401 a skos:Concept ;
    skos:definition "Sets of pottery utensils designed to fit together vertically in the form of a vase or urn, made as a gift for women during confinement; usually consisting of a broth bowl on a raised foot, its cover in the form of a plate, a bowl or cup, a saltcellar, and its domed pierced cover. They were made in Italy during the Renaissance and subsequently in other parts of Europe, and were often elaborately decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accouchement sets"@en .

aat:300263402 a skos:Concept ;
    skos:definition "Hand-stitched embroidered needlework pieces from South American Andean countries, used as wall hangings or to make quilts, handbags, pillows, or various other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arpilleras"@en .

aat:300263403 a skos:Concept ;
    skos:definition "Objects such as cloths, screens, curtains, or canvasses, used to provide suitable background behind the subjects of photographs, paintings, or other pictorial media, or behind the actors and props in a theatrical stage or setting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backdrops"@en .

aat:300263404 a skos:Concept ;
    skos:definition "Bibles that have annotations in the margins or between the lines explaining, interpreting, or translating the Biblical text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glossed Bibles"@en .

aat:300263405 a skos:Concept ;
    skos:definition "Italian imitation of Asian lacquer work in which the relief decorations are formed by cut-out prints stuck to the surface and varnished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacca povera"@en .

aat:300263406 a skos:Concept ;
    skos:definition "Marbled ware produced by mixing pottery clays of two or more colors to produce ware resembling agate. Agate ware was made in ancient Rome and was later very popular in England in the 18th century, when it was made by Staffordshire potters such as Whieldon and Wedgwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agate ware"@en .

aat:300263407 a skos:Concept ;
    skos:definition "Convex, dark-tinted glasses used as mirrors to reflect landscapes or objects in landscape in reduced size, muted colors, and merged detail, abstracting the subject from its surroundings, simplifying it, and presenting it in terms of light and shade. It was popular in the 17th and 18th centuries with artists, travelers, and those who simply wished to view landscapes in a different way. They were either handheld, or larger ones were mounted beside the windows of carriages. They were said to have been used by the painter Claude Lorrain, who produced similar effects in his landscapes, hence the name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Claude glasses"@en .

aat:300263408 a skos:Concept ;
    skos:definition "British lead-glazed earthenware with a cream-colored body, painted, stippled, or sponged with high-temperature colors, mainly a brownish ochre, dull blue, and green, and featuring relief decoration; made from 1790 onwards until about 1830. Associated with and named for the pottery factory of William Pratt in Staffordshire, it was made by other local potters in Staffordshire, the north of England, and Scotland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pratt ware"@en .

aat:300263409 a skos:Concept ;
    skos:definition "Refers to a type of lusterware made by Wedgewood from November 1915, featuring decoration designed by Daisy Makeig-Jones depicting whimsical creatures in a fairyland setting, the colors having a marked irridescent appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fairyland Lustre"@en .

aat:300263410 a skos:Concept ;
    skos:definition "Small decorated wooden objects, usually sold as souvenirs, developed by William and Andrew Smith in the Scottish town of Mauchline in the first half of the nineteenth century. This type of objects was named after the town although it was also made elsewhere. The objects included tartan-covered book covers, snuff boxes, and napkin rings decorated with transfer-printed topographical scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mauchline ware"@en .

aat:300263411 a skos:Concept ;
    skos:definition "Medieval picture bibles that are composed of paraphrased passages translated into French, including passages from the \"Historia Scholastica\" of Petrus Comestor, or of biblical passages juxtaposed with passages from Comestor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bibles historiales"@en .

aat:300263412 a skos:Concept ;
    skos:definition "Refers to the work of a group of artists exhibiting in London in the late 1980s and 1990s. Reacting against Minimalist and Conceptualist art, the work is characterized by an emphasis on multimedia, slick and self-conscious promotion of artwork and exhibitions, clever, literary titles and ironic, shocking imagery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Young British Art"@en .

aat:300263413 a skos:Concept ;
    skos:definition "Refers to the style of painting popular in the late 1970's and early 1980's, produced by professionally trained fine artists which is self-consciously inept, garish or tasteless."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bad Painting"@en .

aat:300263414 a skos:Concept ;
    skos:definition "Refers to the aesthetic theories of Hungarian artist Lazlo Moholy-Nagy, which he explored predominently through photography. His style is characterized by a radical, machine-age rendering of objects and images with an emphasis on motion and pure visual elements, such as color, light, and form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Vision"@en .

aat:300263415 a skos:Concept ;
    skos:definition "Plates, usually metal, set in a coffin lid bearing the name of the deceased, usually with the dates of birth and death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffin plates"@en .

aat:300263416 a skos:Concept ;
    skos:definition "Refers to the style of painting and sculpture popular in the late 1970's in Europe and the United States. Reacting against Conceptualist Art, the style is characterized by a fusion of abstraction and figuration and an emphasis on the creative process of manipulating images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Image"@en .

aat:300263417 a skos:Concept ;
    skos:definition "A concept relating to the supply, demand and management of water resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water consumption"@en .

aat:300263418 a skos:Concept ;
    skos:definition "Bodies of water serving as ways or routes for travel or transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterways"@en .

aat:300263420 a skos:Concept ;
    skos:definition "Refers to the style of architecture and painting developed in India during the British Colonial period. In architecture, the style is charcterized by a fusion of vernacular elements, such as polychrome cupolas, onion domes and arcaded vistas, with Classical and Gothic styles. In painting, the style is characterized by the depiction of images on a white background and precise, painstaking attention to detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Mughal"@en .

aat:300263421 a skos:Concept ;
    skos:definition "Photocopied or offset-printed limited edition serial publications featuring graphic arts, designed and produced by one or more artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphzines"@en .

aat:300263422 a skos:Concept ;
    skos:definition "Open spaces designed for public use or are accesible to the public, often designed to foster a sense of community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public spaces"@en .

aat:300263423 a skos:Concept ;
    skos:definition "Color stereographic photographs made by using two similar prints, one treated with dammar varnish to make it transparent, the other painted with washes of color; the former is laid over the latter and the two bound together with a glass and backing, achieving a three-dimensional effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hallotypes"@en .

aat:300263424 a skos:Concept ;
    skos:definition "Color and stereoscopic relief process patented by John Bishop Hall of New York in 1856. Two similar prints were used, one made transparent with dammar varnish, the other painted with washes of color. The transparent print was registered on top of the painted one and the two bound together with a glass and backing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hallotype"@en .

aat:300263425 a skos:Concept ;
    skos:definition "Projectile launchers consisting of a beam with arms of unequal length balanced on a high scaffold; a heavy weight is attached flexibly to the shorter arm and a sling to the longer arm. The longer arm is pulled down by a windlass, and a stone or other projectile is loaded into the sling. When the windlass is disengaged, the weighted short arm falls downward, whipping the longer arm up and hurling the projectile forward. Distinct from \"trebuchets\" in that the weight is not fixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biffas"@en .

aat:300263426 a skos:Concept ;
    skos:definition "Compact discs on which large numbers of photographic images can be stored and viewed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photo CDs"@en .

aat:300263427 a skos:Concept ;
    skos:definition "Method of acquiring property by each party giving and receiving from the other party, often regarding property of equal value, but may include equivalent values of exchange media. For example, an exchange may be made by individual authors, libraries, museums, and other institutions in which they exchange between or among each other their own publications or those of the institution with which they are connected, or duplicates from their own collections. For specific forms of exchange that include money for goods, use 'sales' or 'selling', and for the exchange of goods for goods in general, use 'barter,' except in local instances where ‘exchange’ is more appropriate, as in the example above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exchange"@en .

aat:300263428 a skos:Concept ;
    skos:definition "In libraries and book collecting, the exchange between or among individual authors, libraries, or other institutions of their own publications or of those institutions with which they are affiliated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exchange of publications"@en .

aat:300263429 a skos:Concept ;
    skos:definition "Inscriptions that are an integral part of a work of art such as a manuscript illumination or on a cross, and that serve to identify or otherwise explain or elaborate upon the figure or scene depicted. They also are used to introduce and explain chapters in a manuscript."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tituli"@en .

aat:300263430 a skos:Concept ;
    skos:definition "Books of tropes, which are introductions to liturgical chants or interpolations or elaborations to the text of the Catholic Mass. They were discontinued when the Roman Missal was revised under Pius V (1566-1572)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tropers"@en .

aat:300263431 a skos:Concept ;
    skos:definition "Transmissions of signals, usually taking the form of programs consisting of images and sound, made public by means of television or radio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadcasts"@en .

aat:300263433 a skos:Concept ;
    skos:definition "Thin disks of dried paste, gelatin, adhesive paper, isinglass, or similar material with added coloring matter and typically bearing an identifying mark, used to seal letters or other documents or to attach papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wafers"@en .

aat:300263434 a skos:Concept ;
    skos:definition "Reproductions of images, books, or other intellectual property in electronic form, such as for online viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic reproductions"@en .

aat:300263435 a skos:Concept ;
    skos:definition "Model houses designed as experimental projects that explore ideas outside conventional building practices, provoking discussion and change regarding the direction of architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concept houses"@en .

aat:300263436 a skos:Concept ;
    skos:definition "Branch of chemistry concerned with the relation between electricity and chemical change and with the interconversion of chemical and electrical energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrochemistry"@en .

aat:300263437 a skos:Concept ;
    skos:definition "The forceful introduction of a fluid or other, typically liquid, substance into an object or structure to cure, stabilize, consolidate, or repair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "injecting"@en .

aat:300263438 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Burkina Faso and Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Birifor"@en .

aat:300263439 a skos:Concept ;
    skos:definition "Refers to the international movement in architecture begun in the late-1970s. The style is characterized by a combination of a Late-Modernist emphasis on function, technology and purity with Deconstructionist notions of complexity and displacement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Modernist"@en .

aat:300263440 a skos:Concept ;
    skos:definition "Small streams only a few inches deep, either man-made or formed by rainwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rills"@en .

aat:300263441 a skos:Concept ;
    skos:definition "Works that include the act of sending materials via facsimile transmission; may also be applied to the materials themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fax art"@en .

aat:300263442 a skos:Concept ;
    skos:definition "Refers to the practice of archaeological investigation that complies with state or federal laws protecting sensitive or threatened sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compliance archeology"@en .

aat:300263443 a skos:Concept ;
    skos:definition "Buildings that house schools for training individuals to become policemen, usually in accordance with state requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police academies"@en .

aat:300263444 a skos:Concept ;
    skos:definition "Rooms designed to house collections of various objects, typically fossils, botanical rarities, shells, taxidermy, horns, tusks, skeletons, minerals, small artworks such as medallions and statuettes, and other items that often had been collected during exploring and trading voyages. Items were typically arranged in cabinets as well as on the walls and ceilings. Popular in 16th- and 17th-century Europe, cabinets of curiosities focused on the strange and unusual, and have been described as the forerunner to the natural history museum and other modern museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinets of curiosities"@en .

aat:300263445 a skos:Concept ;
    skos:definition "Refers to the beginning of the Hellenistic period, from around 330 BCE to around 220 BCE. It is characterized by the establishment of Greek workshops in distant cities, including Syracuse, Pergamon, and Alexandria. It is marked by the creation of technically advanced works of art that incorporate human figures that differ from Late Classical art in that they have increasingly elongated proportions and they exhibit subtly idealized portraiture that begins to incorporate true character studies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Hellenistic"@en .

aat:300263446 a skos:Concept ;
    skos:definition "Refers to the zenith of the Hellenistic period, from around 220 BCE to around 150 BCE. It was initiated by the Roman victory over Macedonian and Syrian attempts at hegemony, and the relocation of power and wealth from the eastern kingdoms to Rome. It is marked by major sculptural and architectural programs that typically incorporate nostalgic references to the glory and prosperity of the Classical period. In art and architecture it is characterized by neo-Classical style and compositional patterns that are re-worked with active poses and new emotive rhetoric, as typified in major, influential works, such as the Altar of Zeus at Pergamon, and the Ptolemaic court art at Alexandria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Hellenistic"@en .

aat:300263447 a skos:Concept ;
    skos:definition "Churches fortified with strong walls, towers, and bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortified churches"@en .

aat:300263448 a skos:Concept ;
    skos:definition "Cooperatives that provide agricultural products such as grain, milk and meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agricultural cooperatives"@en .

aat:300263449 a skos:Concept ;
    skos:definition "Styles belonging to Central Ghana cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Ghana styles"@en .

aat:300263450 a skos:Concept ;
    skos:definition "Styles belonging to Ngamiland region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngamiland region styles"@en .

aat:300263451 a skos:Concept ;
    skos:definition "Styles belonging to Eastern Sudanese cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Sudanese styles"@en .

aat:300263452 a skos:Concept ;
    skos:definition "Refers to the African people of Southern Ghana; formerly they constituted one of the pre-colonial Akan states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twifo"@en .

aat:300263453 a skos:Concept ;
    skos:definition "Psychoanalytical concept and theory surrounding a supposed anxious state that comes with the awareness that one can be viewed: the subject loses a degree of autonomy upon realizing that he or she is a visible object. In the context of art, literature, film, and other arts, a way of regarding people or things so as to embody certain aspects of the relationship between the observer and the observed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaze"@en .

aat:300263454 a skos:Concept ;
    skos:definition "Projecting spars with floats, such as a log, rigged out from the side or sides of a vessel to maintain stability; may also refer to vessels so rigged. For canoes rigged with outriggers, construct from \"outrigger\" and \"canoes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outriggers"@en .

aat:300263455 a skos:Concept ;
    skos:definition "Narrow, shallow canoes common in East Africa, made of hollowed-out tree trunks and equipped with outriggers of both sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ngalawa"@en .

aat:300263456 a skos:Concept ;
    skos:definition "Veils covering the body from head to foot, typically made of sheer black cotton or silk, and worn by Swahili women of Zanzibar, Pemba, and the coastal cities and towns of Tanzania and Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buibui"@en .

aat:300263457 a skos:Concept ;
    skos:definition "Large canoes built to carry several passengers used to launch attacks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "war canoes"@en .

aat:300263458 a skos:Concept ;
    skos:definition "Objects made in the form of another object but in an alien or alternative material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeuomorphs"@en .

aat:300263459 a skos:Concept ;
    skos:definition "Funerary pottery style from the Akan region of southern Ghana in Africa, exemplified by terra cotta heads and ritual pots found in burial or funerary contexts dating from the 17th ceentury and later. They come from the Akan region of southern Ghana of Africa where the pre-colonial state of Twifo was located; Hemang refers to the place near whch these ceramics were discovered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twifo Hemang"@en .

aat:300263460 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in southwestern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wasa"@en .

aat:300263461 a skos:Concept ;
    skos:definition "Refers to distinctive chambers in temples or churches. In ancient temples, the chambers were the apartments of the \"pastophori,\" who were an order of priests who carried the shrines of the gods in procession. According to tradition, the Temple of Jerusalem also had such chambers, thus the term is applied to apartments that imitate these chambers and are typically located on either side of the bema in ancient churches or modern Greek Orthodox churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastophoria"@en .

aat:300263462 a skos:Concept ;
    skos:definition "Necklaces, collars, bracelets, or similar ornament consisting of a narrow band or strip in a rigid curved or circular form, often twisted, and usually of precious metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torques"@en .

aat:300263463 a skos:Concept ;
    skos:definition "People concealed in masks or costumes who perform or participate in rituals or other public ceremonies. They typically impersonate known legendary characters, stock figures, or spirit beings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maskers"@en .

aat:300263464 a skos:Concept ;
    skos:definition "Wives whose husbands are deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "widows"@en .

aat:300263465 a skos:Concept ;
    skos:definition "Husbands whose wives are deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "widowers"@en .

aat:300263466 a skos:Concept ;
    skos:definition "People who are occupied or skilled in the handling of small watercraft such as canoes and rafts, typically on smaller bodies of water and waterways than oceans and very large lakes. For those who handle ships and other large watercraft, typically out to sea or on very large lakes, use \"seamen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boatmen"@en .

aat:300263467 a skos:Concept ;
    skos:definition "Mortars made specifically for use with a pestle for grinding tobacco into snuff. The object may be a combination container and mortar and pestle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuff mortars"@en .

aat:300263468 a skos:Concept ;
    skos:definition "Recognized groups of persons of appromimately the same age in a community, especially common in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "age grades"@en .

aat:300263469 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a subgroup of the Katab living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kagoro"@en .

aat:300263471 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a subgroup of the Katab living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kaje"@en .

aat:300263472 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Ghana and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anlo"@en .

aat:300263473 a skos:Concept ;
    skos:definition "Describes objects covered in animal or human skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin-covered"@en .

aat:300263474 a skos:Concept ;
    skos:definition "Having an outline or form comprising or in cross-section delimited by two straight sides that are wider on one end and intersect or come to a near-point on the other end, resembling shape of the letter V."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-shaped"@en .

aat:300263475 a skos:Concept ;
    skos:definition "Motifs having the appearance of an eye, generally a human eye, as found, for example, painted or bossed on the bows of watercraft as protective devices, or, in Christian iconography, as the eye of God in the center of an equilateral triangle representing the Trinity. Distinct from \"oculi (openings)\" which are small round or oval openings such as windows in a wall or openings in the crown of a dome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyes"@en .

aat:300263476 a skos:Concept ;
    skos:definition "The impressions or marks of human feet, shod or unshod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footprints"@en .

aat:300263478 a skos:Concept ;
    skos:definition "Impressions or marks made by a hoof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoofprints"@en .

aat:300263479 a skos:Concept ;
    skos:definition "Middle Eastern and North African motif in the form of a stylized handprint with an eye in the center, generally associated with good health and warding off evil. The so-called \"hand\" is generally symmetrical with two small \"thumbs\" on each side rather than a little finger on one side. The motif is most often seen in modern times in Jewish and Islamic jewelry and decorations at doors, but it pre-dates both Islam and Judaism. It may have developed from a symbol for a vagina, referring to the Punic goddess, Tanit, influenced by the palmette motif and joined with the Ancient Egyptian eye of Horus motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khamsa"@en .

aat:300263480 a skos:Concept ;
    skos:definition "Various African secular festivals incorporating lanterns, held in several regions and areas that had African slaves, particularly Sierra Leone, Senegambia, and the Caribbean nation of Haiti. The festivals are typically held on the occasion of Christian or Islamic holy days, featuring parades and large wooden and paper structures lit from within by candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lantern festivals"@en .

aat:300263481 a skos:Concept ;
    skos:definition "Small sticks of wood used as toothbrushes, especially in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chewing sticks"@en .

aat:300263482 a skos:Concept ;
    skos:definition "Idiophones composed of two clapperless hollow cylinders, usually of metal but occasionally of wood and of differing pitch, connected at their vertices by a handle. They are sounded by being struck on the exterior with a stick, and are usually used in a ceremonial context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double gongs"@en .

aat:300263483 a skos:Concept ;
    skos:definition "Tombs characterized by a single pillar or obelisk extending from the burial chamber, usually on the north or east side of the structure. This form is wholly distinctive to East Africa, being particularly typical of Swahili funerary architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar tombs"@en .

aat:300263484 a skos:Concept ;
    skos:definition "Secular lantern festivals of Senegal and Gambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanals"@en .

aat:300263485 a skos:Concept ;
    skos:definition "Acts of interment, usually but not necessarily ceremonial, including preparation of the corpse and its placement in the grave, and all accompanying ritual practices, if any."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burials"@en .

aat:300263486 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the Lake Turkana and Upper Great Rift Valley regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamar"@en .

aat:300263487 a skos:Concept ;
    skos:definition "Material comprising or processed from the hard exterior covering of the egg of an ostrich, which is a large, flightless bird inhabiting open, semi-arid areas of Africa and formerly the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ostrich eggshell"@en .

aat:300263488 a skos:Concept ;
    skos:definition "Containers of any size or shape made for holding snuff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuff containers"@en .

aat:300263489 a skos:Concept ;
    skos:definition "Structures built or used primarily or exculsively for ceremonies or related activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial structures"@en .

aat:300263491 a skos:Concept ;
    skos:definition "Metal or wooden bars, rods, or framing used to consolidate and reinforce buildings or other structures. Uses include sustaining slender columns, as the supporting framework for a tent, canopy, or hanging members, and in tracery. For the skeletons or framework that support the plastic material of sculptures during modeling, use \"armatures (sculpture components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armatures"@en .

aat:300263492 a skos:Concept ;
    skos:definition "Style and culture of the African people living in Chad and Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gula"@en .

aat:300263493 a skos:Concept ;
    skos:definition "Early Iron Age culture, partially identified by characteristic ceramic ware from East Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kansyore"@en .

aat:300263494 a skos:Concept ;
    skos:definition "Ancestral screens of the African people of Kalibara, Nigeria, Africa, generally consisting of a screen of bamboo slats in a wooden frame with carved and painted decoration. Lashed to the screen is an image of the ancestor for whom the screen is made, accompanied by two other figures representing attendants. Together with an altar for receiving libations, it constitutes a shrine to the ancestor. The term translates into English as \"foreheads of the dead.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duein fubara"@en .

aat:300263495 a skos:Concept ;
    skos:definition "Carved staffs bearing heads shaped like double-headed axes, carried by devotees of the Yoruba god Shango and used in ceremonies as dance wands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oshe Shango"@en .

aat:300263496 a skos:Concept ;
    skos:definition "Carved wooden ancestor statues, ranging in height up to a meter, of the Oron-Ibibio people in southeastern Nigeria in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ekpu"@en .

aat:300263497 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in northern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Matakam"@en .

aat:300263498 a skos:Concept ;
    skos:definition "Carved stones that have been found at ancient and more recent North American sites. They were apparently often part of an atlatl, or spear-thrower; it is believed that a bannerstone was tied to the center of thin, willowy atlatl shafts, thus increasing the spear-thrower's flexibility and causing an efficient, whip-like action. Bannerstones were often carefully carved of decorative stone, and were probably considered sumptuary implements and symbols of status. Some bannerstones seem to have been mounted on staffs or poles to serve primarily as symbols of rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bannerstones"@en .

aat:300263499 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name. A traditional autonomous kingdom, today they are an important ethnic subgroup of the Ovimbundu people of Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bailundu"@en .

aat:300263500 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living mainly in Sudan but also in Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lotuko"@en .

aat:300263501 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mandari"@en .

aat:300263502 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in southwestern Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mekan"@en .

aat:300263503 a skos:Concept ;
    skos:definition "Core styles belonging to Mande cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "core Mande styles"@en .

aat:300263504 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Botswana, a subgroup of the San people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Naron"@en .

aat:300263505 a skos:Concept ;
    skos:definition "Peripheral styles belonging to Mande cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peripheral Mande styles"@en .

aat:300263506 a skos:Concept ;
    skos:definition "The style and culture of the Mande people inhabiting northwest Sierra Leone and the southern coastal regions of the Republic of Guinea in West Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Susu"@en .

aat:300263507 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Tazania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Msalala"@en .

aat:300263508 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the countries of Mali, Burkina Fasso, Côte d'Ivoire, Guinea, Sierra Leone, Gambia, Liberia, Guinea-Bissau, and Senegal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mande"@en .

aat:300263509 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Senegal, Gambia, and Guinea-Bissau. Term is used both for the works of this Mande subgroup and as synonymous with \"Mande\" itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mandingo"@en .

aat:300263510 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Gabon, Equatorial Guinea, and Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Benga"@en .

aat:300263511 a skos:Concept ;
    skos:definition "Refers to drawings on sheets of clear acetate or nitrate, where the outline of the figures are applied to the front of the cel, and the color is applied to the back. The sheet is typically placed over a background image and photographed, along with a series of other animation cels that together depict phased movements of the figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animation cels"@en .

aat:300263512 a skos:Concept ;
    skos:definition "Animated films, tapes, or sheets comprising a series of drawings that show successive phases of an action in order to produce the illusion of movement. The drawings are typically photographed on film or drawn directly on film and projected, or manually flipped as a series of pages, with the effect of simulating movement of the objects and figures depicted in the drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animated cartoons"@en .

aat:300263513 a skos:Concept ;
    skos:definition "Refers to original drawings that are created by an animator as a model from which animation cels or other animation will be made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animation drawings"@en .

aat:300263514 a skos:Concept ;
    skos:definition "Refers to animation cels that were produced specifically for collectors, and not for the production of an animated film, although they typically imitate or copy actual production animation cels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limited edition cels"@en .

aat:300263515 a skos:Concept ;
    skos:definition "Refers to animation cels that were not used in production and were not a limitied edition, but were produced for mass distribution and were silkscreened rather than having been created by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serigraph cels"@en .

aat:300263516 a skos:Concept ;
    skos:definition "Refers to a type of animation cel set-up, or grouping, that is composed of two or more cels and a production background that was created by, or imitates those created by, the Courvoisier Galleries in the late 1930s and early 1940s. It is distinctive in the technique by which figures were trimmed to their edges, glued to a background typically composed of wood veneer, patterns, or hand-painted watercolors, and covered by a protective top cel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "courvoisiers"@en .

aat:300263517 a skos:Concept ;
    skos:definition "Facilities provided by the armed forces to recruit new members to its ranks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recruiting stations"@en .

aat:300263518 a skos:Concept ;
    skos:definition "Any chemical that is toxic or lethal to living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biocide"@en .

aat:300263519 a skos:Concept ;
    skos:definition "Herbicide used to kill weeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weed killer"@en .

aat:300263520 a skos:Concept ;
    skos:definition "Toxic or lethal substances used to kill pests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pesticide"@en .

aat:300263521 a skos:Concept ;
    skos:definition "Fortified sanctuaries used as a refuge in times of war, situated on hilltops in eastern Kenya among the Mijikenda and related peoples. Many kayas are regarded as sacred sites. a primary division of a building’s elevation"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kayas"@en .

aat:300263522 a skos:Concept ;
    skos:definition "Devices for performing calculations, typically consisting of a frame set with sliding counters alongs rods or in grooves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abaci"@en .

aat:300263523 a skos:Concept ;
    skos:definition "Sculpted figures of the Senufo people of Africa. They are mostly of women, though men, couples, and equestrian figures are also known, and all have thick, heavy bases. Using them in various ceremonial contexts such as funerary rites and Iô society initiations, participants grasp the figures by their arms and rhythmically pound the ground with them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "déblés"@en .

aat:300263524 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in north central Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isanzu"@en .

aat:300263525 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Sudan and Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ingassana"@en .

aat:300263527 a skos:Concept ;
    skos:definition "Characteristics and qualities of form, that are figure-derived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figure-derived form attributes"@en .

aat:300263528 a skos:Concept ;
    skos:definition "Describes human and other animal figures other then fish having legs depicted as fish bodies, usually holding in his or her hands the fish tails or two other animals in an aggressive, dominant attitude."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish-legged"@en .

aat:300263529 a skos:Concept ;
    skos:definition "Having exactly or approximately the form of a phallus, the male organ of generation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phallic"@en .

aat:300263530 a skos:Concept ;
    skos:definition "Style and culture of the pastoral African people of the same name living in the Darfur region of Sudan and the eastern region of Chad. Historically the Zaghawa were the rulers of the Kanem Empire from the 9th until the 11th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zaghawa"@en .

aat:300263531 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in southeastern Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dabida"@en .

aat:300263532 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the Democratic Republic of Congo west of Rwanda and Burundi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shi"@en .

aat:300263534 a skos:Concept ;
    skos:definition "Major executive or administrative units within an organization. For major autonomous or semi-autonomous units within an organization, use \"divisions (organizational units).\" Use of these terms in literature, especially with regard to the official titles of organizational units, is idiosyncratic and often no consistent distinction is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "departments"@en .

aat:300263535 a skos:Concept ;
    skos:definition "Describes defined groups of individuals within an organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organizational units"@en .

aat:300263536 a skos:Concept ;
    skos:definition "Major autonomous or semi-autonomous units within an organization. For other organizational units which generally, though not always, have a lesser degree of autonomy than divisions, use \"departments (organizational units).\" Use of these terms, especially with regard to the official titles of organizational units, is idiosyncratic and often no consistent distinction is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divisions"@en .

aat:300263537 a skos:Concept ;
    skos:definition "Refers to a phase of Corinthian pottery style that existed from around 630 BCE to around 625 BCE, between Proto-Corinthian and Early Corinthian styles. It is characterized by a change in the shape of pots to favor slimmer vessels rather than the squatter Proto-Corinthian shapes. The vase painting differs from the earlier style in its move away from spontaneity to a standardized repetition of figure types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Transitional"@en .

aat:300263538 a skos:Concept ;
    skos:definition "Groups of buiiness enterprises of the same kind or function, such as restaurants, stores, theaters, or hotels, linked together into a single system under a single ownership, management, or control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chains"@en .

aat:300263539 a skos:Concept ;
    skos:definition "Characteristics and qualities that are electrophysical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrophysical properties"@en .

aat:300263540 a skos:Concept ;
    skos:definition "Undergoing a change in color, or changing from transparency to a bright color, upon the passage of an electric current. A typical material manufactured to have this property is window glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrochromic"@en .

aat:300263541 a skos:Concept ;
    skos:definition "Refers to relatively small household items, often collectibles such as ceramics, fans, or statuettes that are characterized by being ornamental, often having antiquarian interest, and typically being displayed on tables, shelves, or elsewhere in a living area. This term is generally not used for collections of natural history objects, coins, furniture, or fine art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knickknacks"@en .

aat:300263542 a skos:Concept ;
    skos:definition "Bridges designed for pedestrian traffic, typically consisting of a deck stiffened by arches or supension cables to minimize horizontal movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stress ribbon bridges"@en .

aat:300263543 a skos:Concept ;
    skos:definition "Vegetable-tanned goatskin leather imported in a partially-processed state from Nigeria or South Africa. Similar but distinct to \"Niger (leather),\" in that its final tanning and dying is processed elsewhere, usually England or France, and is available in a wider range of colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oasis"@en .

aat:300263544 a skos:Concept ;
    skos:definition "Vegetable-tanned goatskin from Nigeria. Similar to \"oasis\" but tanned locally and dyed in fewer colors, the most common being brick-red, green, and buff. It is highly prized by bookbinders for its high quality and grain pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Niger"@en .

aat:300263545 a skos:Concept ;
    skos:definition "Collocates names for general color names that are used in the literature but do not consistently correspond to precise colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indeterminate colors"@en .

aat:300263546 a skos:Concept ;
    skos:definition "Generally refers to a brownish-yellow color of varying degrees of value, sometimes with other colors, such as pink or orange, mixed in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buff"@en .

aat:300263547 a skos:Concept ;
    skos:definition "Leather that has been tanned by forcing vegetable tanning liquor through the pores of the skin or hide. It is often dressed on the flesh side to have a fine nap like suede."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ooze leather"@en .

aat:300263548 a skos:Concept ;
    skos:definition "Calf that has been tanned by forcing vegetable tanning liquor through the pores of the skin or hide. It is often dressed on the flesh side to have a fine nap like suede."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ooze calf"@en .

aat:300263549 a skos:Concept ;
    skos:definition "Sheepskin leather that has been tanned by forcing vegetable tanning liquor through the pores of the skin or hide. It is often dressed on the flesh side to have a fine nap like suede."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ooze sheep"@en .

aat:300263550 a skos:Concept ;
    skos:definition "Refers to the style of Shinto architecture that developed around 300 BCE. The style is characterized by a type of shrine similar in construction to the Sumiyoshi stlye, but with three posts along the long side and innner and outer sancturay arrangements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otori"@en .

aat:300263551 a skos:Concept ;
    skos:definition "Refers to a type of Japanese body armor designed primarily for use by archers on horseback and used mainly from the 9th century to the 16th century. It is characterized by being lightweight compared to other styles of armor and constructed of multiple pieces that were held together by brightly colored cord or ribboons. In addition to its practical function, it was valued for decorative and ritualistic reasons, and was often donated to Shinto shrines upon the death of its owner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yoroi"@en .

aat:300263552 a skos:Concept ;
    skos:definition "Structures or parts of structures that are the result of conscious construction, are of practical use, are relatively stable and permanent, and are of a size and scale appropriate for--but not limited to--habitable buildings. Works of architecture are manifestations of the built environment that is typically classified as fine art, meaning it is generally considered to have aesthetic value, was designed by an architect (whether or not his or her name is known), and constructed with skilled labor. For the art or science of designing and building structures, use \"architecture (discipline).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architecture"@en .

aat:300263553 a skos:Concept ;
    skos:definition "The aggregate of physical objects produced by a society or culturally cohesive group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "material culture"@en .

aat:300263554 a skos:Concept ;
    skos:definition "Paintings in which the primary subject is an animal, generally a dog, horse, or other prized pet or livestock, or an exotic wild animal. The subject genre was highly developed in 18th-century European painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal paintings"@en .

aat:300263555 a skos:Concept ;
    skos:definition "Refers to art created by non-professional artists or artisans who have not had formal training and are often self-taught; also art in the naive style created by formally trained artists. It typically displays a child-like rendering of anatomy, perspective, and other pictorial elements. Media may include painting, sculpture, embroidery, quilts, toys, ships' figureheads, decoys, painted targets, and other objects; often refers to such objects created specifically in 19th- and 20th-century Europe and North America. Distinguished from \"outsider art,\" which is based on a philosophy of the avoidance of, rather than simply a lack of, traditional training. It is also usually distinct from \"folk art,\" which is created according to specific cultural traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naive art"@en .

aat:300263556 a skos:Concept ;
    skos:definition "Calf that is dressed on the flesh side, often used for account books and other stationery bindings. Distinct from \"suede\" in that it is not polished with an emery wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rough calf"@en .

aat:300263557 a skos:Concept ;
    skos:definition "Chrome-tanned calf traditionally dyed black and boarded in two directions to produce a grain of rectangularly crossed lines. Distinct from \"willow calf\" which is boarded in only one direction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box calf"@en .

aat:300263558 a skos:Concept ;
    skos:definition "Chrome-tanned calf traditionally dyed brown and boarded in one direction head to tail to produce the characteristic long pattern termed 'willow.' Distinct from \"box calf\" which is usually dyed black and is boarded in two directions to produce a rectangularly crossed pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "willow calf"@en .

aat:300263559 a skos:Concept ;
    skos:definition "Traditionally a high-quality morocco from the Middle East with a distinctive large grain pattern. In recent years it refers to vegetable-tanned or semii-chrome tanned goatskin leather from Africa, particularly South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "levant"@en .

aat:300263560 a skos:Concept ;
    skos:definition "Levant said to be of the best quality, from South Africa and made from the skins of large Cape goats. It was used by French master binders for very fine bookbindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cape levant"@en .

aat:300263561 a skos:Concept ;
    skos:definition "Variegated leather, usually but not always calf, which has been decorated with an irregular spotted pattern created by daubing dye or ferrous sulfate upon it with a sponge or piece of cotton. Distinct from \"sprinkled calf\" which has had dye or ferrous sulfate sprinkled upon it to create a speckled pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mottled calf"@en .

aat:300263562 a skos:Concept ;
    skos:definition "Variegated leather, usually but not always calf, which has been decorated with a speckled pattern by sprinkling dye or ferrous sulfate upon it. Distinct from \"mottled calf\" which has had dye or ferrous sulfate daubed on it with a sponge or piece of cotton to create an irregular spotted pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprinkled calf"@en .

aat:300263563 a skos:Concept ;
    skos:definition "Hide of small or yearling cattle, larger than the skin of a calf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kip"@en .

aat:300263564 a skos:Concept ;
    skos:definition "Bookbinding morocco, often levant, that has had its grain flattened before it has been attached to the book boards, then, after it is on the boards, polished very smooth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crushed morocco"@en .

aat:300263565 a skos:Concept ;
    skos:definition "Skin of a deer or other member of the cervid family, used especially for clothing, moccasins, and bookbinding leather. In early bookbinding, before the 16th century, the skin was either processed with lime or alum-tawed to make it white in appearance. For processed deerskin, use \"buckskin\" or \"doeskin (skin).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deerskin"@en .

aat:300263566 a skos:Concept ;
    skos:definition "Metalworkers who do decorative work by chasing, which is the process of adding detail or ornament on metal by indenting with a hammer or other tools without cutting edges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chasers"@en .

aat:300263567 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living mainly in northwestern Uganda and southern Sudan, but also in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Madi"@en .

aat:300263568 a skos:Concept ;
    skos:definition "The skin of an adult female deer, leather made from which was used in early bookbinding. For the soft, suede-like leather made from the flesh split of kidskin, sheepskin, or goatskin, use \"doeskin (leather).\" For leather made from doeskin (skin), combine \"doeskin (skin)\" + \"leather.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doeskin"@en .

aat:300263569 a skos:Concept ;
    skos:definition "Soft, supple leather with a suede-like finish made from the flesh split of kidskin, sheepskin, or goatskin, used especially for gloves. Distinct from \"doeskin (skin)\" which is the skin of an adult female deer used to make another type of leather, commonly used in early bookbinding. For leather made from doeskin (skin), combine \"doeskin (skin)\" + \"leather.\" For unprocessed skin, use \"deerskin.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doeskin"@en .

aat:300263570 a skos:Concept ;
    skos:definition "Smooth-grained, natural- or cream-colored calf, vegetable-tanned, usually with bark, and commonly used in the 19th and early 20th centuries in binding law books, particularly in England. It has been superceded for that use by \"law buckram.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law calf"@en .

aat:300263571 a skos:Concept ;
    skos:definition "Smooth-grained natural- or cream-colored sheepskin leather, vegetable-tanned, usually with bark, commonly used in the 19th and early 20th centuries in binding law books, especially in England, as a less expensive alternative to \"law calf.\" It has been superceded in that use by \"law buckram.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law sheep"@en .

aat:300263572 a skos:Concept ;
    skos:definition "Heavy buckram in tan shades, so colored as to resemble sheepskin leather. Used as book cloth, it superceded the more expensive leathers \"law calf\" and \"law sheep\" as a common binding material for law books in the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law buckram"@en .

aat:300263573 a skos:Concept ;
    skos:definition "Parchment made from sheepskin, dressed in imitation of vellum. It is not strong and tends to be greasy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forel"@en .

aat:300263574 a skos:Concept ;
    skos:definition "Material comprising the skin of an unborn, prematurely born, or aborted animal, especially a calf, having very fine fibers and used for high-grade parchment and suede."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slunk"@en .

aat:300263576 a skos:Concept ;
    skos:definition "Leather made from the skin of any of several species of very small deer-like mammals of Asia and West Africa, used in England in the Medieval period for \"chemises,\" a type of loose book cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevrolain"@en .

aat:300263578 a skos:Concept ;
    skos:definition "Trade name for a book cloth made by the Winterbottom Book Cloth Company of England, made of linen and finished with a grain pattern resembling that of leather, most often straight-grain morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial morocco cloth"@en .

aat:300263579 a skos:Concept ;
    skos:definition "Gold leaf ground into a powder and mixed with honey or other binder, used to produce powdered effects on leather bindings, to repair or restore gold tooling, and to gild manuscripts. Originally packaged in mussel shells, more recently it is sold in plastic containers shaped like mussel shells or in tablet or small block form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell gold"@en .

aat:300263580 a skos:Concept ;
    skos:definition "Stacks of gold sheets, removed from the \"cutches\" grouping and cut into quarters, piled in a stack interleaved with goldbeater's skin and bound with parchment strips, to be beaten thinner in the second stage of producing gold leaf by hand before being moved to \"molds (grouping for gold-shaping).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoders"@en .

aat:300263581 a skos:Concept ;
    skos:definition "A mixture of cod oil and tallow used to incorporate oils and fats into leather during the hand stuffing or currying process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dubbin"@en .

aat:300263582 a skos:Concept ;
    skos:definition "Vellum that has been treated to make it transparent. Such treatments involve coating the skin with various substances such as oils, glues, sizes, and potassium carbonate, then stretching it under pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparent vellum"@en .

aat:300263583 a skos:Concept ;
    skos:definition "The pure, milky, sticky, elastic, resinous juice obtained from various species of the tropical genera Hevea and Ficus. It coagulates on exposure to the air, becomes highly elastic, and is waterproof. Distinguished from \"gutta-percha\" in that caoutchouc must be heated longer to set. In the early 19th century, the name \"caoutchouc\" was also used for a commercial rubber-based cement in which a small amount of the elastomer was dissolved in a solvent and mixed with mastic. Today, this material is called \"latex.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caoutchouc"@en .

aat:300263586 a skos:Concept ;
    skos:definition "A style of binding introduced in the early 20th century featuring a miniature painting inset in gold-tooled leather on the front cover. Historically the term refers to bindings commisioned by J.H. Stonehouse, manager of Henry Sotheran, a London bookseller, usually using the binding firm of Rivière and Son. The style is named after Richard Cosway (1742-1821), an English miniature painter who had nothing to do with the bindings themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cosway bindings"@en .

aat:300263587 a skos:Concept ;
    skos:definition "Historical bindings the structure of which originatied in Coptic monasteries in Egypt, known to have been made from the 4th to the 11th centuries CE. They feature boards made of wood or pressed papyrus, leather covers, gatherings sewn through the folio usually by chain or kettle stitches without sewing supports, and lined spines with flanges and headbands. They make up the oldest known family of leather bookbindings and represent the ultimate source of all decorated leather bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coptic bindings"@en .

aat:300263588 a skos:Concept ;
    skos:definition "Highly decorated bindings, usually covered in red morocco, tooled in gold with elaborate Rococo-style borders, areas of criss-crossed or dotted lines, and exotic motifs of animals, plants, and human and mythical figures. Motifs inspired by Chinese and Chinese export porcelain, such as dragons, flowers, and birds, are also common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chippendale bindings"@en .

aat:300263589 a skos:Concept ;
    skos:definition "Quarter bindings featuring a flat, gilt-lettered, green or brown calfskin leather spine, dark red cloth or paper covers on the boards, gilt top edge, and rough-cut or deckle side and bottom edges. This type of binding was originally used for publications of the Roxburghe Club, an association of bibliophiles founded in England in 1812 and named after the Duke of Roxburghe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roxburghe bindings"@en .

aat:300263590 a skos:Concept ;
    skos:definition "Japanese book bindings in which thread is stitched through four equidistant holes in the joint between the spine and the sides of the book, creating a pattern similar to that of a hemp leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asa-no-ha-toji"@en .

aat:300263591 a skos:Concept ;
    skos:definition "Bindings featuring cloth covers, usually of velvet, silk, or canvas, embroidered with gold, silver, or silk thread. The art of making this type of binding peaked in Europe in the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidered bindings"@en .

aat:300263592 a skos:Concept ;
    skos:definition "Bindings, usually of calfskin leather, decorated with patterns and motifs derived from Etruscan pottery, including key patterns, vases, and palmettes. They were popularized in the mid-18th century by the bookbinders of Halifax, Yorkshire, England, notably the Edwards family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etruscan bindings"@en .

aat:300263593 a skos:Concept ;
    skos:definition "Thin strips of material such as leather, card, or board, attached to the back of a text block before it is covered; done to books with a hollow back binding to imitate the appearance of true bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false bands"@en .

aat:300263594 a skos:Concept ;
    skos:definition "Japanese bindings consisting of folded sheets stitched together so that the folded edges form the fore edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fukuro-toji"@en .

aat:300263595 a skos:Concept ;
    skos:definition "The top edges of books trimmed smooth and gilded, implicitly leaving the two other edges ungilded and either rough cut or uncut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilt tops"@en .

aat:300263596 a skos:Concept ;
    skos:definition "Gilding only the top edges of books after they have been cut smooth, leaving the other edges ungilded and trimmed or uncut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilt top"@en .

aat:300263598 a skos:Concept ;
    skos:definition "Method of attaching leaves together to form a text block. Slots or holes are cut or punched through the folds of a gathering, thin adhesive is forced through the holes to adhere the leaves of the gathering together, then a second, thicker adhesive is applied to the back of the stack of gatherings to create a text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burst binding"@en .

aat:300263599 a skos:Concept ;
    skos:definition "Conditioning heavily tanned skins and hides with water to bring about an even distribution of moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samming"@en .

aat:300263600 a skos:Concept ;
    skos:definition "Removing unwanted tanning by-products from tanned skins or hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scouring"@en .

aat:300263601 a skos:Concept ;
    skos:definition "Very light buffing of the grain side of leather with an abrasive, often sandpaper wrapped around a revolving cylinder, to remove slight grain defects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuffing"@en .

aat:300263602 a skos:Concept ;
    skos:definition "A pre-tanning process of loosening the hair on skin or hides prior to depilation by placing them in a warm environment and allowing controlled putrefaction to occur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweating"@en .

aat:300263603 a skos:Concept ;
    skos:definition "Tanning hides or skins, usually sheepskins or lambskins with the grain split or shaved off, with an aldehyde, usually formaldehyde, to produce a white, washable leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aldehyde tanning"@en .

aat:300263604 a skos:Concept ;
    skos:definition "Aldehyde tanning done by exposing leather to smoke, which contains aldehydes. Usually done in combination with oil tanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoke tannage"@en .

aat:300263605 a skos:Concept ;
    skos:definition "Dressing process of applying a coating to the grain side of leather prior to glazing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seasoning"@en .

aat:300263606 a skos:Concept ;
    skos:definition "Dressing process of smoothing, stretching, and removing excess moisture from newly tanned leather or from parchment, done by hand or machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setting out"@en .

aat:300263607 a skos:Concept ;
    skos:definition "Setting out by hand leather or parchment, done when the skin is very thin and delicate or when an exceptionally smooth grain side is required, as with vellum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slicking"@en .

aat:300263608 a skos:Concept ;
    skos:definition "Removing the grain surface of a skin or hide by chemical or mechanical means to allow penetration of tanning oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frizing"@en .

aat:300263609 a skos:Concept ;
    skos:definition "Curing skins and hides for later processing by stacking them when freshly flayed in piles alternating with layers of salt; the moisture from the skins or hides mixes with the salt to form a brine which penetrates them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet-salting"@en .

aat:300263610 a skos:Concept ;
    skos:definition "Tumbling skins, hides, or leather in a revolving container either to remove some substance from them such as water or other liquids, to add a substance to them, such as dye or tanning substances, or to wash them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drumming"@en .

aat:300263611 a skos:Concept ;
    skos:definition "Removing lime from and acidifying unhaired skins or hides by immersion in a water infusion of fermented bran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drenching"@en .

aat:300263612 a skos:Concept ;
    skos:definition "Bindings in a simple style featuring tooled republican motifs and symbols, commissioned in large quantities by the English republican Thomas Hollis, who gave away collections of books bound in this way to universities and libraries in Europe and America to disseminate and promote republican beliefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hollis bindings"@en .

aat:300263613 a skos:Concept ;
    skos:definition "Ceramicists who join the various separately cast or molded parts of a figure or other ceramic object into completed form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repairers"@en .

aat:300263614 a skos:Concept ;
    skos:definition "Shallow grooves sawn into the back of the text block near the head and tail to receive cords or the loops of stitches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kerfs"@en .

aat:300263615 a skos:Concept ;
    skos:definition "Japanese book bindings in which thread is stitched through four equidistant holes in the joint between the spine and the sides of the book, creating a diamond pattern similar to that of a tortoise shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kikko-toji"@en .

aat:300263616 a skos:Concept ;
    skos:definition "Bindings decorated with landscape scenes on either one or both covers; they were popular in England from the late 18th century into the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape bindings"@en .

aat:300263617 a skos:Concept ;
    skos:definition "In bookbinding, the process of gilding, coloring, tooling, painting, printing, or other by other means coating or marking one or more edges of a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "edge decoration"@en .

aat:300263618 a skos:Concept ;
    skos:definition "In bookbinding, free-swinging joints produced by setting the boards a slight distance, about 1/8\" to 1/4\", away from the backing shoulder, creating a space into which the covering material is pressed, forming a gully or groove. It is one of the more obvious characteristics of library bindings. It allows relatively thick covering material, such as buckram, to be used while still allowing the covers to open easily. Distinct from \"tight joints,\" in which the board lies with its back edge flush against the shoulder, making for a comparatively rigid joint with no gully."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French joints"@en .

aat:300263619 a skos:Concept ;
    skos:definition "Book edges that have been decorated with a spattering of color or colors, usually earth pigment dissolved in a non-spirit solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprinkled edges"@en .

aat:300263620 a skos:Concept ;
    skos:definition "The practice of painting on the fore edge of a book, either with the edge solid so that the resulting image is visible with the book closed, or, in the more usual sense of the term, with the edges fanned out so that the image is visible only when the book is open. The edge may also be gilded or marbled in the usual manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fore-edge painting"@en .

aat:300263621 a skos:Concept ;
    skos:definition "Paintings done on the fore edge of a book, either with the edge solid so that the resulting image is visible when the book is closed, or, in the more usual sense of the term, with the edges fanned out so that the image is visible only when the book is open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fore-edge paintings"@en .

aat:300263622 a skos:Concept ;
    skos:definition "The technique of painting two separate images on the fore-edge of a book, one done with the leaves fanned one way, the other with the leaves fanned the other way, so that the two images are visible independently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double fore-edge painting"@en .

aat:300263623 a skos:Concept ;
    skos:definition "Two separate images painted on the fore-edge of a book, one done with the leaves fanned one way, the other with the leaves fanned the other way, so that the two images are visible independently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double fore-edge paintings"@en .

aat:300263624 a skos:Concept ;
    skos:definition "Book bindings first made by Cedric Chivers, Bath, England, around 1903 featuring a layer of transparent vellum laid over a painted or decorated cover, sometimes having inlays of shell or other materials. The vellum was sometimes gold tooled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vellucent bindings"@en .

aat:300263625 a skos:Concept ;
    skos:definition "Headbands sewn directly onto the text block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worked headbands"@en .

aat:300263626 a skos:Concept ;
    skos:definition "Strips of material, often the waste ends of the back lining or endsheets, their width extending from the book shoulder onto the board a short way; they are adhered to the boards as a means of board attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flanges"@en .

aat:300263627 a skos:Concept ;
    skos:definition "Decorative protective metal pieces attached to the corners of the cover of a book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornerpieces"@en .

aat:300263628 a skos:Concept ;
    skos:definition "Small lengths of material, such as vellum, catgut, leather, straw, or paper, around which headbands are sewn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cores"@en .

aat:300263629 a skos:Concept ;
    skos:definition "Headbands sewn on one core."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single headbands"@en .

aat:300263630 a skos:Concept ;
    skos:definition "Bookbinding boards with the back or binding edge either split open to a shallow depth or, in the case of laminated boards, left unadhered. The boards are attached to the text block by the tapes or flanges being inserted into and adhered within the split edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "split boards"@en .

aat:300263631 a skos:Concept ;
    skos:definition "In bookbinding, cords, tapes, or thongs placed against the back of a text block around which the sewing passes. They may also be used as a means of board attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing supports"@en .

aat:300263632 a skos:Concept ;
    skos:definition "In bookbinding, the type of joint formed by the juncture between the board and the book shoulder. The board lies with its back edge flush against the shoulder, creating a relatively rigid joint and leaving a thin crease instead of a gully, as compared with \"French joints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tight joints"@en .

aat:300263633 a skos:Concept ;
    skos:definition "Decorative motif that resembles stylized fruits of the species Ananas comosus. Examples include finials on Rococo furniture and tableware. On book bindings they are typically placed in the lozenge compartments of a panel divided by diagonal fillets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pineapple"@en .

aat:300263634 a skos:Concept ;
    skos:definition "Running patterns consisting of twisted stems interrupted at intervals by pineapple motifs, found on several English and French bookbinders' rolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twisted pineapple"@en .

aat:300263637 a skos:Concept ;
    skos:definition "In book design, right angles formed at the corners of title pages and book covers by the crossing of single or multiple border lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oxford corners"@en .

aat:300263639 a skos:Concept ;
    skos:definition "Patterns tooled onto the spine of a leather-bound book, consisting of a fillet, usually double, running from head-to tail alongside the joint, with horizontal lines intersecting it at intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "run-up"@en .

aat:300263640 a skos:Concept ;
    skos:definition "Irregular book cloth grain pattern imitating the appearance of sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand grain"@en .

aat:300263641 a skos:Concept ;
    skos:definition "Regular book cloth grain pattern of alternating parallel solid lines and dotted lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dot and line"@en .

aat:300263642 a skos:Concept ;
    skos:definition "Refers to the culture of the modern republic of Serbia, or in general to the cultures that have occupied the area south of the Danube river on the Balkan Peninsula. It may also refer to the broader historical or modern culture of the south Slavonic people who speak Serb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serbian"@en .

aat:300263643 a skos:Concept ;
    skos:definition "Long-drawn, large grain pattern embossed on leather in imitation of levant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "levant grain"@en .

aat:300263644 a skos:Concept ;
    skos:definition "Grain pattern consisting of an overall pattern of parallel creases, embossed on leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straight grain"@en .

aat:300263645 a skos:Concept ;
    skos:definition "Grain pattern of intersecting lines produced by boarding the leather in two different directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross grain"@en .

aat:300263646 a skos:Concept ;
    skos:definition "Tools or instruments used for gilding, which involves the surface application of gold or another metal in the form of leaf, powder applied directly to the surface, powder mixed with a binder, electroplating, or other forms to approximate the effect of solid or inlaid metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilding equipment"@en .

aat:300263647 a skos:Concept ;
    skos:definition "In the hand working of hides and skins, convex slabs, typically wooden, sloping upwards from the floor, over which hides and skins are placed while they undergo such processes as trimming, fleshing, depilation, liming, and scudding, known as beamhouse operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beams"@en .

aat:300263648 a skos:Concept ;
    skos:definition "Flat-bladed knives with a smooth, moderately sharp cutting edge on one or both sides, used to cut gold leaf to the required size and shape, and to manipulate it in the gilding process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold knives"@en .

aat:300263652 a skos:Concept ;
    skos:definition "Leather finishing tools consisting of a stone or a blunt blade of metal, glass, or plastic set into a wooden handle, used to gently scrape, smooth, and remove excess moisture from very thin and delicate leather or parchment, or to produce an exceptionally smooth grain side on leather. They are also sometimes used to work dubbin into a skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slickers"@en .

aat:300263653 a skos:Concept ;
    skos:definition "Individuals who specialize in creating ambrotypes, which are photographs produced by mounting a negative on glass with a dark backing, making the image appear as a positive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambrotypists"@en .

aat:300263654 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Slovenia, or in general to the cultures that have occupied the area in central Europe corresponding to the modern nation. It may refer broadly to the culture of the southern Slavonic groups of peoples, who dwelled in southern Austria and in Slovenia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Slovene"@en .

aat:300263655 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Croatia, or in general to the cultures that have occupied the area in central Europe corresponding to the modern nation. It may refer broadly to the culture of the Slavic Croat peoples who came out of the Ukraine in the seventh century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Croatian"@en .

aat:300263656 a skos:Concept ;
    skos:definition "Refers to the culture of the Slavonic people who now inhabit Lusatia in eastern Saxony, but who formerly occupied most of Northern Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wendish"@en .

aat:300263657 a skos:Concept ;
    skos:definition "Refers to the culture of the region of Catalonia in western Europe, either the modern northeasterly province of Spain or the former independent principality of which the area of the modern province formed the core."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Catalan"@en .

aat:300263658 a skos:Concept ;
    skos:definition "Red or reddish-brown calf originally produced in Russia and introduced into western Europe in the 17th century, vegetable-tanned with willow, poplar, or larch bark and curried on the flesh side with extract from birch bark, which gave it a characteristic pleasing odor thought to repel insects. It was often finished with a diced pattern. Between 1780 and 1830 it was highly prized for bookbinding, \"Russia leather\" was made in imitation of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russia calf"@en .

aat:300263660 a skos:Concept ;
    skos:definition "Analyzing the potential loss, failure, injury, or other damage involved in or resulting from any activity or project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "risk assessment"@en .

aat:300263661 a skos:Concept ;
    skos:definition "Middle Stone Age pottery style and period found in southern Africa, named for Bambata Cave in Zimbabwe where pottery of this type was first discovered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bambata"@en .

aat:300263662 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a Sarwa people living on the northern fringe of the Okavango Delta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bugakwe"@en .

aat:300263663 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a Tsonga people living in South Africa, Mozambique, and Zimbabwe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hlengwe"@en .

aat:300263664 a skos:Concept ;
    skos:definition "Describes the works produced by the African people of the same name living on the Cameroon-Nigeria border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kapsiki"@en .

aat:300263665 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kgatla"@en .

aat:300263666 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Chad near the Sara people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lele"@en .

aat:300263667 a skos:Concept ;
    skos:definition "Staffs with t-shaped finials at one end, used by congregants of the Ethiopian Orthodox Church to rest upon during services, also to mark rhythm during liturgical songs and dances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer-sticks"@en .

aat:300263668 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a Tswana people living in South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ntwane"@en .

aat:300263669 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a Shona people living in Mozambique and Zimbabwe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tawara"@en .

aat:300263670 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a Tswana people living in Botswana and South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tlhaping"@en .

aat:300263671 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a Tswana people living in Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tlokwa"@en .

aat:300263672 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Ngamiland region of Botswana and Namibia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yeye"@en .

aat:300263673 a skos:Concept ;
    skos:definition "A branch of tourism whose object is to provide great understanding of monuments and sites, focusing on historical authenticity, preservation, and local involvement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural tourism"@en .

aat:300263674 a skos:Concept ;
    skos:definition "Having the outline of the uppercase letter U, or for a three dimensional form, when in cross-section resembling a U."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "U-shaped"@en .

aat:300263676 a skos:Concept ;
    skos:definition "African cylindrical or biconical beads made of a type of reddish brown stone after which they are named, made by the Yoruba, particularly in Ilorin, Nigeria. They are no longer made though they are still used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lantana beads"@en .

aat:300263677 a skos:Concept ;
    skos:definition "Spiral cone shell disks worn as ornaments and prestige objects by the Shona people of Zimbabwe and Mozambique, taken from the base of the shell of the marine snail species Conus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ndoro"@en .

aat:300263678 a skos:Concept ;
    skos:definition "Circular objects made of various materials and in various sizes, used in many different contexts and applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rings"@en .

aat:300263679 a skos:Concept ;
    skos:definition "Necklaces comprised of beads sewn in rows to form a bib-like pendant that lies upon the wearer's chest, notable among ancient Egyptian jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broad collars"@en .

aat:300263680 a skos:Concept ;
    skos:definition "Sacred objects of the Bemba people of Africa, associated with women's initiation and marriage, taking various forms such as ceramic models, pottery vessels, wall paintings, and bundles of household goods. All have either a secret emblematic meaning or a secret name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mbusa"@en .

aat:300263681 a skos:Concept ;
    skos:definition "Type of farthingale chair developed by the Asante people of Africa after the European prototype, decorated with brass tacks, having a low inclined back, and often with a leather-covered seat, used only by high-ranking or honored persons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asipim"@en .

aat:300263682 a skos:Concept ;
    skos:definition "Brass-studded prestige X-chairs of the Asante people of Africa, having arms, openwork backs, and legs that cross diagonally; the leg configuration is based on European folding chairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "akonkromfi"@en .

aat:300263683 a skos:Concept ;
    skos:definition "Sculpture serving as cult objects associated with the Cult of the Hand of the Bini people of Africa; they are made of cast bronze or carved wood in cylindrical form with a projection from the top, relief sculpture around the sides, and figures on the flat top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ikegobo"@en .

aat:300263684 a skos:Concept ;
    skos:definition "Crosses with short handles that are held in the hand, used in Christian rituals or devotions; they may be used in religious processions but are smaller than processional crosses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hand crosses"@en .

aat:300263685 a skos:Concept ;
    skos:definition "Crosses or crucifixes mounted on staffs and carried in Christian religious processions. Such crosses seem to have been in general use from very early times, given that it is mentioned in the Roman \"Ordines\" as to suggest that such a cross belonged to each church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional crosses"@en .

aat:300263687 a skos:Concept ;
    skos:definition "Religious masquerades of the Igbo people of Africa, performed in the northcentral Igbo region on very special occasions, such as yam festivals and major events associated with kingship. It features monumental mask costumes in the form of a huge cylinder or cone bearing a complex tableau of miniature human, animal, bird, and spirit figures made of brightly-colored cloth stuffed with grass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ijele"@en .

aat:300263688 a skos:Concept ;
    skos:definition "Masquerade of the Igbo people of Africa, performed in the northcentral Igbo region during the annual dry season festivals and at the burial festivals of respected men. It features massive mask costumes surmounted by horns, representing masculine physical strength and spiritual power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mgbedike"@en .

aat:300263689 a skos:Concept ;
    skos:definition "Tents made of woven goat hair and black in color, used by the nomadic peoples living in northern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black tents"@en .

aat:300263690 a skos:Concept ;
    skos:definition "Historic or traditional quarters in some North African cities, originally referring to a citadel or fortress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casbahs"@en .

aat:300263691 a skos:Concept ;
    skos:definition "Tents made of sewn together skins, typically that of goats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin tents"@en .

aat:300263692 a skos:Concept ;
    skos:definition "Tents usually made of plaited doum palm leaves or straw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mat tents"@en .

aat:300263693 a skos:Concept ;
    skos:definition "Pottery made by slaves, frequently found at plantation sites in South Carolina, Virginia, and several Caribbean Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonoware"@en .

aat:300263697 a skos:Concept ;
    skos:definition "Phrases, sentences, or inscriptions in which certain letters, usually distinguished by size or other means from the rest, express by their numerical values a date, year, or epoch when added together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chronograms"@en .

aat:300263698 a skos:Concept ;
    skos:definition "In the context of typesetting by hand, the condition of the pieces of type having been sorted into the wrong compartments of the case and any errors appearing in the resulting printing due to this condition. Signs of foul case typically include letters of the wrong size or wrong font, or spelling errors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foul case"@en .

aat:300263699 a skos:Concept ;
    skos:definition "The style and culture of the central African State, Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ugandan"@en .

aat:300263700 a skos:Concept ;
    skos:definition "The style and culture of the south central African country, Zambia (formerly Northern Rhodesia)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zambian"@en .

aat:300263701 a skos:Concept ;
    skos:definition "The style and culture of Zimbabwe or of Black Rhodesians in the former Rhodesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zimbabwean"@en .

aat:300263702 a skos:Concept ;
    skos:definition "Books, usually intended for children, the leaves of which include or consist of press-out jigsaw puzzles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jigsaw books"@en .

aat:300263703 a skos:Concept ;
    skos:definition "Comics intended for an adult readership, dealing with socially outrageous subject matter such as sex, violence, drugs, and political dissent. Originating the mid-1960s in the U.S. and Great Britain, they were produced cheaply, mainly by the artists, and tended to be distributed through nontraditional channels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground comics"@en .

aat:300263705 a skos:Concept ;
    skos:definition "In bookbinding, labels made of paper or other material, other than leather, different from the book cover material, bearing the book title, often the author(s) name, and sometimes also date and publisher, afixed to the spine or front board. Sometimes such labels were printed on otherwise blank leaves, typically in vertical format, and bound into the book, so that book owners could cut them out and use them. For similar labels made from leather, use \"lettering pieces.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "title labels"@en .

aat:300263706 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, living in the Democratic Republic of the Congo, inlcuding small populations in the northwestern Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngiri"@en .

aat:300263707 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in northern Ghana and Burkino Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Builsa"@en .

aat:300263708 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a subgroup of the Koro living in Kaduna State in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koro Ache"@en .

aat:300263709 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the Cameroon Grassfields, relatives of the Babanki."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Babanki-Tungo"@en .

aat:300263710 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banen"@en .

aat:300263711 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Kogi State, Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bunu"@en .

aat:300263712 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daba"@en .

aat:300263713 a skos:Concept ;
    skos:definition "Community development which focuses on minimizing urban sprawl and environmentally damaging development, promoting greenbelt protection, pedestrian and rural areas, and restoring vitality to center cities and older communites through adaptive reuse and the use of infill development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smart growth"@en .

aat:300263714 a skos:Concept ;
    skos:definition "Refers to a type of glass characterized by being one deep color throughout its thickness. The process by which it is made is ancient, and requires the combination of silica, potash, and lime, with metal oxides added to the molten glass for color. The name refers to the metal oxides and the custom of melting the compound in a clay pot in the furnace. This type of glass was generally used in making stained-glass windows, with the typical effect of relatively little light penetrating the deep, saturated colors of the glass. A technique was later developed to create \"flashed glass,\" which layers color over clear or white glass and allows more light to pass through the window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pot-metal glass"@en .

aat:300263715 a skos:Concept ;
    skos:definition "Refers to a type of glass characterized by two or more layers of color, usually a thin layer or \"flash\" of colored glass layered on a clear or light-colored glass. It is created by dipping a small blob of dark glass into a pot of light-colored glass, and then blowing the blob into a bubble in which the distinct layers are formed. It is used to make stained glass windows, valued over \"pot-metal glass\" for certain effects, because the thinner layer of color allows more light to pass through the window, while the saturated color of pot-metal glass results in a darker interior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flashed glass"@en .

aat:300263716 a skos:Concept ;
    skos:definition "Refers to a type of glass that was invented during the Gothic Revival in the 19th century and is characterized by an uneven thickness that is thicker in the center, and thinner on the edges. It is made by blowing the molten mixture into a rectangular mold, or by blowing and molding a bubble of glass into a box shape, then cutting the sides of the box to form rectangles of glass. The glass may be clear or colored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norman slab glass"@en .

aat:300263717 a skos:Concept ;
    skos:definition "Refers to a type of glass that is characterized by an irregular rippled effect in the color, caused by a mixture of glass of different hardnesses. It is usually a blend of white with colored glass, the word \"reamy\" referring to the creamy white color. It may be similar in appearance to \"cloudy glass\" and \"streaky glass.\" It is often used to make windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reamy glass"@en .

aat:300263718 a skos:Concept ;
    skos:definition "Refers to a type of glass that is blown from two colors combined in the molten state, creating streaks of various colors. It is often used to make windows, but may also be used to make vessels. It differs from \"reamy glass\" in that reamy glass generally contains white streaks and has the distinctive appearance of a colored liquid having been stirred into cream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "streaky glass"@en .

aat:300263719 a skos:Concept ;
    skos:definition "Refers to a type of glass in which colored glass is mixed with white glass, to create an opalescent effect that resembles clouds. It is often used to create decorative vessels. It is similar in appearance to \"reamy glass\" and to \"Clutha glass,\" which means \"cloudy glass.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloudy glass"@en .

aat:300263720 a skos:Concept ;
    skos:definition "Refers to a type of glass characterized by central circular ridges around a pontil mark. It is a pane created from the central portion of a sheet of crown glass, which is created by spinning a bubble of glass on a rod and cutting one end so that the bubble opens into a large circular sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bull's eye glass"@en .

aat:300263721 a skos:Concept ;
    skos:definition "Refers to a type of sheet glass characterized by a linear relief pattern or texture that is created by using a ridged roller in the manufacturing process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reeded glass"@en .

aat:300263722 a skos:Concept ;
    skos:definition "Works made of transparent or semi-opaque colored glass, generally in the form of a window, autonomous panel, or lampshade, in which the design is meant to be observed through refracted light and its effect is greatly dependent on the quality of the light. Generally the glass is primarily made of \"stained glass (material)\" as opposed to painted glass, but there may be painted details. The stages of manufacture were described in a manual written in the early twelfth century by the monk Theophilus and the process has hardly changed since then. The window or other item is made by cutting pieces of colored glass based on a full-scale cartoon and holding the pieces together by strips of lead. Details may be painted on the surface of the pieces of glass and fired in a kiln before piecing the glass together. The method of weatherproofing and fixing the glass in a window is often highly decorative and forms an important element of the design. The highest achievements in stained glass are thought to be those of the Gothic era in Europe and those of the Gothic Revival of the nineteenth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stained glass"@en .

aat:300263723 a skos:Concept ;
    skos:definition "Refers to glass created by a technique in which ground glass is made into a paste and molded into a vessel or figure, and then the design is refined by carving. Glass created by this method was known in ancient times and revived in France in the late 19th and early 20th centuries, notably in the studio of glass and jewelry designer, René Lalique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pâte de verre"@en .

aat:300263724 a skos:Concept ;
    skos:definition "Refers to a type of pâte de verre that is characterized by being especially translucent. It was developed by Gabriel Argy-Rousseau, a famous Art-Deco glass designer of the 1920s and 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pâte de cristalle"@en .

aat:300263725 a skos:Concept ;
    skos:definition "Styles belonging to High Atlas cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High Atlas styles"@en .

aat:300263726 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a Berber people of central Morocco and Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tamazight"@en .

aat:300263727 a skos:Concept ;
    skos:definition "Saharan rock engraving style named for the Algerian site where it was first discovered. Typically,Tazina rock engravings are finely incised and carefully polished; they depict wild animals, frequently gazelles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tazina"@en .

aat:300263728 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living in the coastal area west of Algiers, Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chenoua"@en .

aat:300263729 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living in the High Atlas and Anti Atlas mountains as well as the Dra and Sous regions of Morocco, and in western Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shluh"@en .

aat:300263730 a skos:Concept ;
    skos:definition "Style and culture of the people of the same name living in the Ghadamis Oasis, Libya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ghadames"@en .

aat:300263731 a skos:Concept ;
    skos:definition "Use to describes works produced by the Berber people of the same name living in the Egyptian oasis of Siwah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siwa"@en .

aat:300263732 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living in the Aurès Mountains of Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shawia"@en .

aat:300263733 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living in northern Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rif"@en .

aat:300263734 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name who lived in the Canary Islands. They do not exist as a distinct group in modern times, having since the sixteenth century become assimilated into the Iberian world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guanche"@en .

aat:300263735 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living in the African region of Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Imraguen"@en .

aat:300263736 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living on the island of Jerba, Tunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jerba"@en .

aat:300263737 a skos:Concept ;
    skos:definition "Style and culture of the Berber people livng in settled areas of southern Tunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Matmata"@en .

aat:300263738 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living primarily in the Algerian Saharan towns of Ghardaia, Gurara, and Berriane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mzab"@en .

aat:300263739 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living in Nefusa Jabal in southwest Tripolitania, Libya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nefusa"@en .

aat:300263740 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name living in northwestern Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ouarsenis"@en .

aat:300263741 a skos:Concept ;
    skos:definition "Groupings of diversified religious buildings and related facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious complexes"@en .

aat:300263742 a skos:Concept ;
    skos:definition "Religious complexes generally comprised of a structure of worship, such as a mosque or temple, towers, and subsidiary sancturaries or temples; characteristic of Southeast Asian, Indian, and Middle Eastern religious architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalan"@en .

aat:300263743 a skos:Concept ;
    skos:definition "Water vessels with bulbous spout and elongated neck with flared rim; of Malay origin and found throughout Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kendi"@en .

aat:300263744 a skos:Concept ;
    skos:definition "Motif often serving as a framing architectural device, generally combined with lintels of free-standing gateways supported by carved pillars set on molded bases. Based on ancient mythical animal, the \"makaras (legendary animals),\" of Indian origin and used throughout Asian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "makara"@en .

aat:300263745 a skos:Concept ;
    skos:definition "Pillared halls or porch structures of Southeast Asian origin. For example, in Thai culture, mandapas are elongated meeting halls that lead to a Buddha image at one end; usually featuring a square roof and accompanied by a wihan outside near the entrance. Mandapas are incorporated into northern Indian Hindu temples; they may connect to the shrine directly, lead to intermediary spaces, or be completely detached from the shrine itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maṇḍapas"@en .

aat:300263746 a skos:Concept ;
    skos:definition "Sanctuary towers of Southeast Asian origin, generally used in Thai culture; based on Khmer prasat tower designs and usually accompanied by a wihan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prang"@en .

aat:300263747 a skos:Concept ;
    skos:definition "Religious buildings of Southeast Asian origin used as assembly halls or sanctuaries containing an altar and Buddhist images. Buddhist monastery; medieval Jaina temple; vasatī; monastery (sometimes with sanctum)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wihan"@en .

aat:300263748 a skos:Concept ;
    skos:definition "Lists of the signatures of which books are compiled, often printed at the end of early printed books, particularly those printed in Italy, to asssist the binder in assembling and collating complete copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registers"@en .

aat:300263750 a skos:Concept ;
    skos:definition "Works that identify and describe an individual or group, either historical persons or fictional characters, within a particular historical or literary context in terms of his, her or their public career, family connections, and personal characteristics; written particularly with reference to Roman and Medieval European times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prosopographies"@en .

aat:300263751 a skos:Concept ;
    skos:definition "Written or printed words, phrases, or sentences arranged to make a communication. Includes oral verbal communications set down in writing or print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "texts"@en .

aat:300263752 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Burkina Faso and Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Falafala"@en .

aat:300263753 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ewondo"@en .

aat:300263754 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in the Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dakpa"@en .

aat:300263756 a skos:Concept ;
    skos:definition "Styles belonging to Thai cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thai styles"@en .

aat:300263757 a skos:Concept ;
    skos:definition "Painting done on the front or the reverse of glass, whether or not the paint is then fired onto the glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass painting"@en .

aat:300263758 a skos:Concept ;
    skos:definition "Painters who create images or decoration on the front or reverse of glass pieces or sheets. Examples are stained glass artists who paint images on the glass, especially the smaller details, such as faces of figures, on windows and panels. To refer to craftsmen who stain glass, use \"glass stainers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass painters"@en .

aat:300263759 a skos:Concept ;
    skos:definition "The art of creating elaborate flourishes to decorate the margins or otherwise blank spaces in a work of calligraphy. Especially common in European copybooks of the 17th and early 18th centuries, the technique often resulted in images of animals, plants or human composed of a single line, or having that appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "striking"@en .

aat:300263760 a skos:Concept ;
    skos:definition "Elaborate flourishes, often resembling animals, humans, or plants, produced by calligraphers to decorate calligraphic works. They were especially common in European copybooks of the 17th and 18th centuries, and were made, or made to look if they were made, with a single unbroken line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strikings"@en .

aat:300263761 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buji"@en .

aat:300263762 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Birom"@en .

aat:300263763 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dibo"@en .

aat:300263764 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in southwestern Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dorosie"@en .

aat:300263765 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dyan"@en .

aat:300263766 a skos:Concept ;
    skos:definition "Style and culture of the African collective cultural-linguistic group of the same name living in Ghana and Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Frafra"@en .

aat:300263767 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in northern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dowayo"@en .

aat:300263768 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in northern Ghana and Burkino Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gurensi"@en .

aat:300263769 a skos:Concept ;
    skos:definition "Narratives for children in which geography, together with the history, customs, and folklore of nations, is presented by means of accounts of the fictional adventures of a child, a family, or some other group. Examples are found in the United Kingdom in the 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travelogue storybooks"@en .

aat:300263770 a skos:Concept ;
    skos:definition "Said of a book sold with the folded fore edges of the gatherings (bolts) not trimmed or cut, intended to be slit by hand by the purchaser with a paper knife. Distinct from \"uncut\" which is said of a book of which the folded fore edges have not been cut with the plough or guillotine prior to sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unopened"@en .

aat:300263771 a skos:Concept ;
    skos:definition "Said of a book of which the folded fore edges of the leaveshave not been cut with the plough or guillotine prior to sale. Distinct from \"unopened\" which is said of a book sold with the folded fore edges not trimmed or cut, intended to be slit by hand by the purchaser with a paper knife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncut"@en .

aat:300263772 a skos:Concept ;
    skos:definition "Refers to works produced by the African people of the same name living in Burkina Faso, related to the Nunuma but living in an area to the south of them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuna"@en .

aat:300263773 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Burkino Faso and Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lela"@en .

aat:300263774 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Ghana and Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hwela"@en .

aat:300263775 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in Senegal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lebu"@en .

aat:300263776 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in northeastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwange"@en .

aat:300263777 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name, a subgroup of the Frafra living in northern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nabdam"@en .

aat:300263778 a skos:Concept ;
    skos:definition "Style and culture of the African people of the same name living in western Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gagu"@en .

aat:300263779 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Burkina Faso and Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gan"@en .

aat:300263781 a skos:Concept ;
    skos:definition "Refers to a distinctive pottery that was produced in Bologna, Italy, and elsewhere, primarily from the 15th through the 18th centuries. It was created by dipping the earthenware body into clay slip and covering it with a lead glaze. Designs were incised into the slip, sometimes in conjunction with the application of green and manganese glazes. The technique was copied from certain Chinese and Korean objects, and it was practiced by Byzantine potters in Constantinople before appearing in Italy about 1500. Though it superficially resembles true \"maiolica,\" or tin-glazed earthenware, it is distinct from maiolica in that lead glaze is used instead of tin glaze, designs are applied by incision through the slip to reveal differently colored clay beneath rather than by painting, and the colors tend to run during firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezza-maiolica"@en .

aat:300263782 a skos:Concept ;
    skos:definition "Refers to a style of painting that developed in Regensburg, Germany, and elsewhere along the Danube river during the Renaissance and Reformation. It is characterized by a renewed interest in medieval piety, an expressive use of nature, the relationship of the human figure and events to nature, and the introduction of landscape as a primary theme in art. The term was coined by Theodor von Frimmel (1853-1928), who believed that painting in the Danube River region around Regensburg, Passau, and Linz possessed common characteristics; the style seems to exist even though leading artists did not form a school in the usual sense of the term, since they did not work in a single workshop or in a particular center. Major artists whose work represents the style include Lucas Cranach the elder and Albrecht Altdorfer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Danube style"@en .

aat:300263783 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gbagyi"@en .

aat:300263784 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glavda"@en .

aat:300263785 a skos:Concept ;
    skos:definition "Describes the African people living in northern Nigeria, inhabitants of the former Hausa state of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gobir"@en .

aat:300263786 a skos:Concept ;
    skos:definition "A type of tin brass that is widely used for products requiring high strength and a high level of corrosion resistance, particularly marine equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval brass"@en .

aat:300263787 a skos:Concept ;
    skos:definition "Wooden coffers in which are stored the sacred altar tablets of the Ethiopian Orthodox Church; they also at times serve as altar tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manbara tabots"@en .

aat:300263788 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Goma"@en .

aat:300263789 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Malawi, Tanzania, and Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Henga"@en .

aat:300263790 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Uganda and the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hima"@en .

aat:300263791 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northern Namibia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Himba"@en .

aat:300263792 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Kivu, Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hunde"@en .

aat:300263793 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living mainly in Burundi and Rwanda, but also in Uganda, Tanzania, and Democratic Republic of Congo. The Hutu came into the Great Lakes region around 1000 to 500 BCE. Among the resident Twa pygmy peoples, they established an agrarian society based on the family unit. They were gradually dominated by a feudal system headed by the aristocracy of the nomadic Tutsi people in the 14th or 15th century. The Tutsi monarchy in Rwanda was overthrown 1959-1961. The European colonial period created tensions between the two groups that remain problematic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hutu"@en .

aat:300263794 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in eastern Nigeria, a subgroup of the Igbo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Izi"@en .

aat:300263795 a skos:Concept ;
    skos:definition "Tools used for holding prepared fibers in a carefully arranged manner so that they require the minimum of manual regulation during spinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distaffs"@en .

aat:300263796 a skos:Concept ;
    skos:definition "Spherical or circular objects with a pierced center, usually made of wood, stone, or clay, that act as a flywheel for a spindle and stop for the yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whorls"@en .

aat:300263797 a skos:Concept ;
    skos:definition "Hand-held sticks designed for digging in the earth, to expose roots or tubers, and for planting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digging sticks"@en .

aat:300263798 a skos:Concept ;
    skos:definition "Athletes trained or engaged in the competitive sport of wrestling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrestlers"@en .

aat:300263799 a skos:Concept ;
    skos:definition "Public drinking fountains in Islamic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabils"@en .

aat:300263800 a skos:Concept ;
    skos:definition "A volcanic igneous rock of vitreous or glassy texture; it is a natural glass produced by the cooling of molten lava, or some liquid fraction of it, too quickly to allow crystallization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volcanic glass"@en .

aat:300263801 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a subgroup of the Soninke consisting of an Islamic clerical class and traders, living in Senegal, Guinea, Guinea Bissau, Mali, and northern Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jakhanke"@en .

aat:300263802 a skos:Concept ;
    skos:definition "Describes the works produced by the nomadic Arabic-speaking people of the same name, a subgroup of the Bedouin, living in northern Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kababish"@en .

aat:300263803 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kaguru"@en .

aat:300263804 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a subgroup of the Kongo people, living in Cabinda province, Angola and in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kakongo"@en .

aat:300263805 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a subgroup of the Katab living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamantan"@en .

aat:300263806 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Central African Republic, Cameroon, and Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kare"@en .

aat:300263807 a skos:Concept ;
    skos:definition "Refers to various types of glass made in Europe in the 16th and 17th centuries using the techniques and styles that had been perfected in Venice, Italy, the name being French for \"Venetian fashion.\" It was produced in areas outside Venice, including other parts of Italy, France, Spain, Britain, Germany, and the Netherlands, and it evolved various local stylistic and technical traits over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "façon de Venise"@en .

aat:300263808 a skos:Concept ;
    skos:definition "Refers to a type of glass produced in the town of Altare, near Genoa, Italy. The glass industry was established there in the 9th century by glassmakers from Normandy or Flanders. The term particularly refers to glass dating from the 15th century and later that was produced here, or that was made elsewhere based on techniques taught by Altare glassmakers. During this period Altare glassmakers imitated the highly sought-after and secret techniques of Venetian glassmakers, and they spread the secrets to other European centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Altare glass"@en .

aat:300263809 a skos:Concept ;
    skos:definition "Refers to cut crystal glass in which a decorative ceramic object is embedded, usually a medallion or cameo that has been carved into a white porcellaneous, heat-resistant material. A Bohemian invention of the 18th century, the technique was taken up in Paris but only became popular through English glassmakers in 18th- and 19th-century Europe. For glass characterized by a particular yellow or red color, use \"cadmium sulphide glass.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystallo ceramie"@en .

aat:300263810 a skos:Concept ;
    skos:definition "Refers to a type of glass that became popular in the 19th century. It is usually opaque and is characterized by a lime-yellow or lemon-yellow color that is caused by the presence of cadmium sulfide in the glass mixture. Selenium is sometimes added to the mixture to create orange or bright red glass. It is not related to \"sulphides (glass),\" which is glass characterized by the insertion of a carved object into clear glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium sulfide glass"@en .

aat:300263811 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Central African Republic, the Democratic Republic of Congo, and Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kare"@en .

aat:300263812 a skos:Concept ;
    skos:definition "Describes works produced by the African people living in northern Nigeria, in the former Hausa state of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kebbi"@en .

aat:300263813 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Gambia, Senegal, and western Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khassonke"@en .

aat:300263815 a skos:Concept ;
    skos:definition "Describes motion picture film that is 16 millimeters wide. In silent films it is perforated on both sides; in sound films only on one side, the other being used for the sound track. It was introduced in 1923 for the amateur market, and evolved into the common medium for home movie makers and filmmakers whose work was not intended for general theatrical release. Film of this size is typically used for independent films, documentaries, and films made for educational purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "16mm"@en .

aat:300263816 a skos:Concept ;
    skos:definition "Describes motion picture film that is 35 millimeters wide with four perforations per frame on each side and having 16 frames per foot. It has been used as the standard gauge of film for professional cinematography since the earliest days of cinema."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "35mm"@en .

aat:300263817 a skos:Concept ;
    skos:definition "Having a form or outline that is bounded by a smooth curve having no concave parts, longer along one axis and rounded at each end. It differs from an ellipsis in that it is not necessarily symmetric about its horizontal and vertical axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oval"@en .

aat:300263818 a skos:Concept ;
    skos:definition "Having the form of a plane figure with three or more straight sides and the same number of angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polygonal"@en .

aat:300263819 a skos:Concept ;
    skos:definition "Shape characterized by regular shapes or patterns that are determined, constructed, or formed according to geometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometric shape"@en .

aat:300263820 a skos:Concept ;
    skos:definition "Having the form or outline of an ellipse, which is section of a cone cut obliquely by a plane, and symmetric about its horizontal and vertical axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elliptical"@en .

aat:300263821 a skos:Concept ;
    skos:definition "Having the form or outline of a decagon, which is a plane figure with ten sides and ten angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decagonal"@en .

aat:300263822 a skos:Concept ;
    skos:definition "Havng the form or outline of a dodecagon, a plane figure with twelve sides and twelve angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dodecagonal"@en .

aat:300263823 a skos:Concept ;
    skos:definition "Having the form or outline of a hexagon, which is a plane figure with six sides and six angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hexagonal"@en .

aat:300263824 a skos:Concept ;
    skos:definition "Having the form or outline of an octagon, which is a plane figure with eight sides and eight angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octagonal"@en .

aat:300263825 a skos:Concept ;
    skos:definition "Having the form or outline of a pentagon, a plane figure with five angles and five sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pentagonal"@en .

aat:300263826 a skos:Concept ;
    skos:definition "Bounded by four lines or having a four-sided base or section."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrilateral"@en .

aat:300263827 a skos:Concept ;
    skos:definition "Having the shape or outline of a circle, which is a plane figure bounded by a single curved line which is everywhere equally distant from the center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular"@en .

aat:300263828 a skos:Concept ;
    skos:definition "Having the form or outline of a semicircle, a plane figure which is the half of a circle divided by the diameter, or the half of its circumference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semicircular"@en .

aat:300263829 a skos:Concept ;
    skos:definition "Having the form or outline of a half of an ellipse that is bisected by one of its diameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semielliptical"@en .

aat:300263830 a skos:Concept ;
    skos:definition "Having the form or outline of a rhombus, which is a parallelogram with four equal sides and the opposing angles equal, two being obtuse and two acute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhombic"@en .

aat:300263831 a skos:Concept ;
    skos:definition "Having the form or outline of a rectangle, a plane figure with four sides and four right angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectangular"@en .

aat:300263832 a skos:Concept ;
    skos:definition "Having the form or outline of a square, a four-sided plane figure with four equal sides and four right angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square"@en .

aat:300263833 a skos:Concept ;
    skos:definition "Having the form or outline of a polygon with three sides and three angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triangular"@en .

aat:300263834 a skos:Concept ;
    skos:definition "In North America, having the form of quadrilateral figures with no parallel sides. In Britain and certain other places, \"trapeziums\" are the same as \"trapezoids\" in North America, that is, figures having one set of parallel lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trapezial"@en .

aat:300263835 a skos:Concept ;
    skos:definition "In North America, the form or shape of quadrilateral figures having one pair of parallel and one pair of nonparallel sides. In Britain and certain other places, these figures are called a \"trapeziums.\" \"Trapezium\" has a different meaning in North America, referring to figures having no parallel sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trapezoidal"@en .

aat:300263836 a skos:Concept ;
    skos:definition "Short segments from longer, finished motion pictures, often inserted into a compilation of like segments or into another motion picture or television program."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film clips"@en .

aat:300263838 a skos:Concept ;
    skos:definition "Events at which motion pictures are exhibited to showcase new work or the work of a particular genre, era, nation or film artist. They often feature discussions, panels, seminars and presentations by the filmmakers, film artists, or film critics or scholars. They frequently recur at regular intervals and last for several days or weeks. Some but not all are competitive and give awards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film festivals"@en .

aat:300263839 a skos:Concept ;
    skos:definition "Animation involving pliable modeled clay figures which are moved very slightly, filmed a few frames, moved again, filmed again, and so on. When the film is projected at normal speed, the figures appear to move and change expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay animation"@en .

aat:300263840 a skos:Concept ;
    skos:definition "People trained in or practicing the art of clay animation, which is animation involving modeling clay figures moving them very slightly, filming them for a few frames, moving them again, filming again, and so on. When the film is projected at normal speed, the figures appear to move and change expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clay animators"@en .

aat:300263841 a skos:Concept ;
    skos:definition "Collectively, all the processes and techniques employed in the creation of motion pictures on film or videotape, including directing, performing, producing, filming, editing, writing and design. Specifically refers to the activities of film or video directors and producers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filmmaking"@en .

aat:300263842 a skos:Concept ;
    skos:definition "Films created by cutting and splicing film clips from pre-existing motion pictures or library footage. Often done with nonfiction footage to make documentaries, or with clips from old motion pictures for entertainment. May have new footage by way of introduction, comment, or closing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compilation films"@en .

aat:300263843 a skos:Concept ;
    skos:definition "Filmmakers who make motion pictures without financial backing from a major studio. Generally they retain a greater degree of artistic control over their projects than do studio filmmakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "independent filmmakers"@en .

aat:300263844 a skos:Concept ;
    skos:definition "Motion pictures created by independent filmmakers, without financial backing from a major studio and with generally a greater degree of artistic control in the hands of the filmmakers than is the case with studio films. Major studio distribution systems may handle their release to theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "independent films"@en .

aat:300263845 a skos:Concept ;
    skos:definition "Broadly describes a genre of motion pictures that explore new ways of dealing with a subject or that employ new and different production techniques or an unorthodox style of filmmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experimental films"@en .

aat:300263846 a skos:Concept ;
    skos:definition "Motion pictures whose length is relatively short in comparison to feature films; they may range between a few minutes to one hour but 30 minutes is typical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "short subjects"@en .

aat:300263847 a skos:Concept ;
    skos:definition "Motion pictures typically ranging from 85 minutes to about two hours in length that are the principal, sometimes the only, offering on theater programs. The majority are fictional and produced for entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feature films"@en .

aat:300263848 a skos:Concept ;
    skos:definition "Parts and components of motion pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion picture components"@en .

aat:300263849 a skos:Concept ;
    skos:definition "Motion picture material shot for a larger work but not used in the final edited version."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outtakes"@en .

aat:300263850 a skos:Concept ;
    skos:definition "The successive individual images that comprise a motion picture, or the spaces such images occupy on a length of film, each separated from the others by a horizontal bar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frames"@en .

aat:300263851 a skos:Concept ;
    skos:definition "Filmed shots of various subjects stored in a film library and used in other productions. They tend to be general scenes such as busy street scenes, scenes which are difficult, costly, or impossible to replicate, such as of natural disasters or historic places and events, and, especially in the case of serials and television series, shots which are frequently used, such as shots of the ouside of a building the characters live or work in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stock shots"@en .

aat:300263852 a skos:Concept ;
    skos:definition "The prevailing and distinctive spirit or character, as of a person, place, time or group. Can also refer to a prevailing taste or sentiment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genius"@en .

aat:300263853 a skos:Concept ;
    skos:definition "All movable physical objects used on a motion picture, television, or stage set that are not costume or structurally part of the set, such as furnishings, decorations, and objects held or touched by actors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "props"@en .

aat:300263855 a skos:Concept ;
    skos:definition "Early motion picture genre, made prior to 1910. It consisted of silent films of very short length showing people and events from everyday life as they happened, usually authentic but sometimes manipulated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actuality"@en .

aat:300263856 a skos:Concept ;
    skos:definition "Early silent motion pictures, made prior to 1910, usually of very short length, recording people and events from everyday life as it happened. They were usually filmed direct from life but sometimes manipulated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actualities"@en .

aat:300263857 a skos:Concept ;
    skos:definition "Visual works in which the image, by an optical trick, appears to be in motion. Media for moving images include motion pictures, video recordings, flip books, and some optical toys such as zoetropes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moving images"@en .

aat:300263858 a skos:Concept ;
    skos:definition "Roughly assembled visual and audio workprints of each day's shooting of a motion picture production, shown that same day or the next for the director and others involved in the filming process to judge the results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dailies"@en .

aat:300263859 a skos:Concept ;
    skos:definition "Describes motion picture film that is 8 millimeters wide, the narrowest gauge available for such film. Introduced in 1932 for use by amateur filmmakers and for home movies, 8mm film was also taken up by filmmakers of the avant0garde and the underground, due to the comparatively low cost of the film stock and the processing. Since the mid-1960s, standard 8mm film has been generally superceded by the Super 8 type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "8mm"@en .

aat:300263861 a skos:Concept ;
    skos:definition "Refers to a number of Chinese characters symbolizing long life. The most common is circular in form, but there are many elongated variants. The character is sometimes used as a central medallion or repeated border in Chinese rugs. PSORL."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shou"@en .

aat:300263862 a skos:Concept ;
    skos:definition "Refers to the period and culture of Great Britain prior to the Norman Conquest of 1066."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Conquest"@en .

aat:300263863 a skos:Concept ;
    skos:definition "Animation technique in which humans or objects are filmed incrementally in various fixed poses or positions, creating an unnatural or surreal effect when projected at normal speed. The technique was first used by Canadian filmmaker Norman McLaren in his 1952 short film \"Neighbours.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pixilation"@en .

aat:300263864 a skos:Concept ;
    skos:definition "Animation technique invented in the mid-1930s by Alexandre Alexeieff and Claire Parker, in which a vertical metal surface is perforated by millions of holes into which headless pins are inserted; the pins are depressed to make shadows, and changes in the position of the pins are filmed frame by frame, creating an animated effect when projected at normal speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinscreen animation"@en .

aat:300263865 a skos:Concept ;
    skos:definition "The audio portion of a film or video recording, in the form of an optical or magnetic band along the edge of the film stock or videotape, carrying the dialogue, narrative, music, or sound effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound tracks"@en .

aat:300263866 a skos:Concept ;
    skos:definition "Short works promoting new coming attractions such as feature films or television mini-series, usually containing scenes from them. They are shown in theaters and on television."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trailers"@en .

aat:300263867 a skos:Concept ;
    skos:definition "Type of animation in which cutout pieces of artwork made of paper, wood, cardboard, metal or other material are laid out on a background under an animation camera, moved by hand, and shot incrementally to create the illusion of motion when the film or video is projected at normal speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutout animation"@en .

aat:300263868 a skos:Concept ;
    skos:definition "Animation technique in which solid three-dimensional figures with articulated limbs or made of malleable yet stable material such as clay, are manipulated in carefully phased movements on miniature sets and each position shot in brief exposures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model animation"@en .

aat:300263869 a skos:Concept ;
    skos:definition "Type of animation in which the images are drawn or painted directly onto the film rather than photographed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cameraless animation"@en .

aat:300263870 a skos:Concept ;
    skos:definition "Type of cutout animation in which flat silhouettes, often highly intricate, cut out of paper or other stiff material are silhouetted with back lighting, minutely readjusted, and each position photographed with single frame exposures. The technique was first developed by Lotte Reiniger in Germany during the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silhouette animation"@en .

aat:300263871 a skos:Concept ;
    skos:definition "Low-budget motion pictures made usually to accompany major features on double-bills. In the 1930s, \"B\" was the designation given to a motion picture shown in a U.S. theater as the second half of a double feature. Typically they have lower production values and less well-known or unknown actors compared to major features. The term is still used although the practice of showing two features for a single admission price no longer applies to new releases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "B-movies"@en .

aat:300263872 a skos:Concept ;
    skos:definition "Documents issued by or on behalf of a sovereign, usually by an official herald, permitting the use of armorial bearings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grants of arms"@en .

aat:300263873 a skos:Concept ;
    skos:definition "Term used from the 17th to the 19th centuries in England for chapbooks, usually of eight pages and sometimes with a woodcut title page, containing songs, poems, nursery rhymes and tales. The word \"garland\" often occurred in the books' titles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garlands"@en .

aat:300263874 a skos:Concept ;
    skos:definition "Motion pictures on film or videotape made by amateurs, or professionals in a nonprofessional capacity, intended for home viewing by family and friends. People, scenes and events filmed generally feature the filmmakers' immediate circle and personal activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home movies"@en .

aat:300263877 a skos:Concept ;
    skos:definition "Unusual elements of a motion picture created using a variety of techniques such as computer, mechanical, makeup, pyrotechnic, optical, lighting, camera speed, weather effects, and model techniques. Generally they are used to create effects that normal camera techniques or set action cannot provide or would be too costly to shoot normally. They are often inserted into the motion picture by the special effects department after live shooting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special effects"@en .

aat:300263878 a skos:Concept ;
    skos:definition "A cinematographic visual effect of animate beings or objects in motion appearing to be moving at much slower than normal speed, achieved by running the film or videotape through a camera at faster than normal speed and, when processed, projecting it at the standard rate of speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slow motion"@en .

aat:300263880 a skos:Concept ;
    skos:definition "The production of sounds other than speech or music, naturally or artificially reproduced, to make desired effects in a motion picture, video recording, radio or television program, or live theatrical stage presentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound effects"@en .

aat:300263881 a skos:Concept ;
    skos:definition "Special effects achieved by combining or altering film or video images, generally done after shooting by means of special optical or computer technologies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual effects"@en .

aat:300263882 a skos:Concept ;
    skos:definition "Term coined by French critics to describe a genre of film characterized by dark, somber tone and cynical, pessimistic mood. Typically such films portray the dark and gloomy underworld of crime and corruption with the heroes as well as the villains being cynical and disillusioned, trapped by their pasts and insecure or apathetic about the future. The genre is typifed by Hollywood black-and-white motion pictures of the 1940s and early 1950s, though later examples in color exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film noir"@en .

aat:300263883 a skos:Concept ;
    skos:definition "Books, generally intended for children, in which the pages feature illustrations with blank spaces on which to place adhesive stickers; the stickers come with the book either as separate sheets or on leaves of the book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sticker books"@en .

aat:300263884 a skos:Concept ;
    skos:definition "American motion picture genre typically featuring a comic battle of the sexes in which the hero and heroine are caught up in a romantic pursuit or patching up a marriage, involving a rapid sequence of improbable events and a surrounding group of eccentric characters. The dialogue is generally fast-paced and witty, and romantic love triumphs in the end. The hayday of the screwball comedy was from the mid-1930s through the 1940s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screwball comedy"@en .

aat:300263885 a skos:Concept ;
    skos:definition "Genre of motion picture featuring action and adventure, usually though not always in a more or less accurate historical setting, with dashing and courageous protagonists who fight, often with swords, for some noble cause."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swashbuckler"@en .

aat:300263886 a skos:Concept ;
    skos:definition "Refers to maps depicting a relatively small district or region, such as a town or city, drawn on a large scale and with considerable detail. For maps of larger regions, use \"topographic maps\" or \"chorographic maps.\" For depictions of smaller plots of land, particularly as related to the planning of architecture, use \"site plans.\" For representations of buildings or objects depicted on a horizontal plane, use \"plans (orthographic projections).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plans"@en .

aat:300263887 a skos:Concept ;
    skos:definition "Refers to combined software and hardware systems that relate and display collected information concerning phenomena associated with location relative to the Earth. They often have the ability to overlay temporal information or information related to geology, ecology, weather, land use, demographics, transportation, or other data on top of existing geographic base data. The data are typically presented in the form of maps or tables, displayed in color on a computer screen or printed out."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geographic information systems"@en .

aat:300263888 a skos:Concept ;
    skos:definition "Refers to the technology originally developed by the U.S. Department of Defense and consisting of 24 satellites that continuously transmit signals globally. In conjunction with receivers on Earth, the system uses triangulation to quickly and accurately determine the latitude, longitude, and altitude of a point on or above the Earth's surface. In addition to military applications, the system is primarily used to gather spatial data needed for making maps and to calculate geographic positions for travelers on Earth who have GPS receivers. The system was originally called \"NAVSTAR\" (Navigation System with Timing And Ranging)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Global Positioning System"@en .

aat:300263889 a skos:Concept ;
    skos:definition "Refers to the integration of engineering design and the manufacture of objects into a system under the direct control of digital computers. It combines the use of computers in industrial-design work, called \"computer-aided design\" or \"CAD,\" with the use of computers in manufacturing operations, known as \"computer-aided manufacturing\" or \"CAM.\" This integrated process is commonly called CAD/CAM. It is typically characterized by the facility to allow drawings developed and revised during the design process to be converted directly into instructions for the production machines that will manufacture the desired object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer-aided engineering"@en .

aat:300263890 a skos:Concept ;
    skos:definition "Refers to plans for the brick, concrete, or stone foundations, walls, and piers of a building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry plans"@en .

aat:300263891 a skos:Concept ;
    skos:definition "Refers to maps of the surfaces of planets other than Earth, or the surfaces of moons, suns, or other celestial bodies. Modern maps of this kind are based on coordinate systems analogous to latitude and longitude used on Earth. In most cases, such modern maps are compiled from photographic observations made with Earth-based equipment or with instruments carried aboard spacecraft. The term is also used to refer to charts of stars and the heavens, where its meaning overlaps with \"astronomical charts\"; however, \"astronomical maps\" is most commonly used for all such depictions derived by modern technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical maps"@en .

aat:300263892 a skos:Concept ;
    skos:definition "Refers to images depicted on a flat surface, but representing the celestial sphere, which is the stars and constellations as they are located on the apparent hollow sphere of the sky as seen from the surface of the Earth. They appeared in Europe around 1515, though simple depictions of constellations had been known since the time of ancient Egypt. They are a narrower concept to \"astronomical charts\" because \"planispheres\" are specifically early depictions of the heavens on a flat surface, where the concept being depicted is of a sphere projected on a flat plane; \"astronomical charts\" may refer to charts from a much wider historical range, and do not necessarily refer only to charts where the heavens were conceptually considered to exist on or in a sphere. For representations of the heavens actually depicted on a sphere, as opposed to being projected on a flat plane, use \"celestial globes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planispheres"@en .

aat:300263893 a skos:Concept ;
    skos:definition "Refers to the activity of taking photographs using cameras mounted on satellites orbiting the Earth or another planet. Its purpose is generally to observe ground features and activities from high orbits above the Earth, as for military reconnaissance, mapmaking, and monitoring weather phenomena. The cameras may also be focused on space, and the photographs could reflect celestial objects or phenomena covered by the concept \"astronomical photography.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite photography"@en .

aat:300263894 a skos:Concept ;
    skos:definition "Refers to maps of large areas, often an ocean, depicted in a small scale by gnomonic projection. They are laid out to allow calculation of a great-circle route, which is the shortest course between two points on the surface of the sphere of the Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great-circle charts"@en .

aat:300263895 a skos:Concept ;
    skos:definition "People who operate video cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videographers"@en .

aat:300263896 a skos:Concept ;
    skos:definition "The art and process of making video recordings using a video camera. Light reflected from the subject is focused onto a camera tube or sensor whence it is converted into an electronic signal and recorded on magnetic tape or laser-beam disk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videography"@en .

aat:300263897 a skos:Concept ;
    skos:definition "Refers to systems that gather or manipulate geographic information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geographic systems"@en .

aat:300263898 a skos:Concept ;
    skos:definition "Hand-held, shoulder-mounted, or structurally-attached cameras using electronic components to record or transmit pictures and usually sound as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video cameras"@en .

aat:300263899 a skos:Concept ;
    skos:definition "Portable video cameras with a built-in video recorder-playback machine and other features, such as for editing, picture magnification (zoom), on-screen titling, and low-light recording."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camcorders"@en .

aat:300263900 a skos:Concept ;
    skos:definition "Describes works by the African people of the same name living in Angola, a sub-group of the Mbundu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kisama"@en .

aat:300263901 a skos:Concept ;
    skos:definition "Describes the works of the African people of the same name living in the lagoon region of the Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Krobu"@en .

aat:300263902 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kukuya"@en .

aat:300263903 a skos:Concept ;
    skos:definition "Describes the work of the African people of the same name, a sub-group of the Nupe people, living along the Niger River in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kyedye"@en .

aat:300263904 a skos:Concept ;
    skos:definition "Large standing wooden bird sculptures with long curved beak, rounded head, prominent belly, and sharp-cornered rectangular wings, usually standing on a hollow base. They are made for use primarily in central Senufo rituals, including Poro male initiation rites and funeral ceremonies for dignitaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porpianong"@en .

aat:300263905 a skos:Concept ;
    skos:definition "Styles belonging to Central Sudanese region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Sudanese region styles"@en .

aat:300263906 a skos:Concept ;
    skos:definition "Styles belonging to Bahral Ghazal region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bahral Ghazal region styles"@en .

aat:300263907 a skos:Concept ;
    skos:definition "Styles belonging to Darfur region cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Darfur region styles"@en .

aat:300263908 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Chad, Libya, and Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Teda"@en .

aat:300263909 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lendu"@en .

aat:300263910 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Democratic Republic of Congo and the Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lobala"@en .

aat:300263911 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daza"@en .

aat:300263912 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Ghana and Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "LoWiili"@en .

aat:300263916 a skos:Concept ;
    skos:definition "Refers to masks created for or used in ceremonies or rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial masks"@en .

aat:300263917 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Uganda and the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lugbara"@en .

aat:300263918 a skos:Concept ;
    skos:definition "Wooden sculptures made and used by the Buluñits people of central coastal Guinea, in the form of a long, beaked head mounted upon a long, thin neck mounted on a spherical base; the heads may be carved in the shape of human heads or those of birds, crocodiles, horned animals, or D'mba figures. They are used primarily as shrine figures representing both the supreme god and the lineage protector; other uses include as dance headdresses and as divination objects for various rituals such as male and female initiation ceremonies, harvest and healing rituals, and judicial and funerary ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ëlëkël"@en .

aat:300263919 a skos:Concept ;
    skos:definition "Sacred gourds used in Luba villages in Central Africa by diviners to hold natural or manmade objects that are used in divination ceremonies. Distinct from \"mboko (sculpture)\", which are carved wooden figures of a woman carrying a bowl, used by the Luba people in ceremonies pertaining to divination or to the transfer of power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mboko"@en .

aat:300263920 a skos:Concept ;
    skos:definition "Carved wooden figures of a woman holding a bowl, used by the Luba people of Central Africa in ceremonies pertaining to divination or to the transfer of power. Distinct from \"mboko (containers)\" which are sacred gourds used by Luba diviners to hold natural or manmade objects that are used in divination ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mboko"@en .

aat:300263921 a skos:Concept ;
    skos:definition "Oval wooden or metal face masks made and used by the Senufo people of northern Côte d'Ivoire, southern Mali, and southwestern Burkina Faso. Representing the female element, these masks are generally slightly smaller than life-size. They are ornamented with sets of geometric projections that flank the crown of the head, upper face, and mouth, diagonal scarifications on each cheek, and sometimes a set of vertical horns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kpeli-yehe"@en .

aat:300263922 a skos:Concept ;
    skos:definition "Strings or other physical combinations of specific objects such as kola nuts, cowrie shells, pieces of textile, chalk, or bark, conveying highly allusive encoded messages. These are used by the Yoruba of West Africa in a symbol communication system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "àrokò"@en .

aat:300263923 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lula"@en .

aat:300263924 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maba"@en .

aat:300263925 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Sudan and Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maban"@en .

aat:300263926 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Ghana, Burkina Faso, and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mamprusi"@en .

aat:300263927 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Guinea-Bissau and Senegal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mandyak"@en .

aat:300263928 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Guinea-Bissau, Senegal, and Gambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mankanya"@en .

aat:300263929 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marakwet"@en .

aat:300263930 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Cameroon in the Bamileke area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbembe"@en .

aat:300263931 a skos:Concept ;
    skos:definition "Occurences of populations or groups traveling from one locality or habitat to another, usually for specific purposes such as resettlement, feeding, or breeding. With regard to human beings, refers to the changing of permanent residence (conventionally understood as being for at least one year) by discrete populations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "migrations"@en .

aat:300263932 a skos:Concept ;
    skos:definition "Appliqué flags of the asafo companies of the Fante people of Ghana; they typically measure about four feet by six feet and carry mirror-image designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frankaa"@en .

aat:300263933 a skos:Concept ;
    skos:definition "Hand-operated mills typically consisting of a slab with a slightly concave upper surface and a smaller, smooth, rounded stone, used for grinding or pulverizing grains or other food materials. They are distinguished from grinding wheels, which are abrasive disks used for cutting or smoothing materials such as metal, glass, plastics, or clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grinding stones"@en .

aat:300263934 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Igbo living in an area centered on the town of Arochukwe in southeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aro"@en .

aat:300263935 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Mozambique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ronga"@en .

aat:300263936 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Mozambique, Malawi, and Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chipeta"@en .

aat:300263937 a skos:Concept ;
    skos:definition "Money made and used in Central Africa, in the form of sand-cast copper-alloy ingots, typically in the shape of a cross, an X, or an H."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Katanga crosses"@en .

aat:300263938 a skos:Concept ;
    skos:definition "Money in the form of thin, twisted iron rods with flat ends, made and used in West Africa, particularly in Sierra Leone, Liberia, and Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kissi pennies"@en .

aat:300263939 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Tsonga living in Mozambique, Zimbabwe, and South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tswa"@en .

aat:300263940 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, a subgroup of the Berber living in Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tekna"@en .

aat:300263941 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Central African Republic and Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbimu"@en .

aat:300263942 a skos:Concept ;
    skos:definition "African American male maskers, usually of the working class, who sing, dance and parade in unofficial associations or \"tribes\" in New Orleans's Mardi Gras and St. Joseph's Day parades. Their costumes are comprised of large feather headdresses, moccasin-style boots, and aprons with patterns sewn in such materials as sequins, rhinestones, glass beads, ribbons velvet, and ostrich plumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mardi Gras Indians"@en .

aat:300263943 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Berber living in Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zenaga"@en .

aat:300263944 a skos:Concept ;
    skos:definition "Describes works created by the ancient African people of the same name, forebears of the Beja who lived in the eastern desert and Sinai."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blemmyes"@en .

aat:300263945 a skos:Concept ;
    skos:definition "Egyptian peasant farmers living in the Nile River Valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fellahin"@en .

aat:300263946 a skos:Concept ;
    skos:definition "Refers to one of the two main branches of Zen. It originated in the Lin Chi school of Ch'an in China and was later introduced to Japan by Eisai in 1191. Rinzai stresses spontaneous enlightenment and advocates unusual ways of achieving it, such as shouts, slaps, and the use of koans. Rinzai downplays veneration of Buddha images and reading of scripture (sutras). After it was first introduced it appealed to the aristocracy and was supported by the shoguns. Later, Soto became the more popular form of Zen. Rinzai nevertheless flourished during the Kamakura period (1685-1768) during which Hakuin, a Rinzai master, introduced reforms that led to modern Zen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rinzai"@en .

aat:300263947 a skos:Concept ;
    skos:definition "Refers to one of the two main branches of Zen. Known as Tsao-tung in China, it was brought by Dogen from China to Japan in 1227. Unlike Rinzai, Soto teaches a form of silent seated meditation in which enlightenment is a gradual process. In his 'Shobo Genzo,' Dogen advocates a combination of seated meditation (zazen), daily labor, discipline, and the use of koans. Dogen also wrote the 'General Teaching for Seated Meditation' which describes the five stages of zazen, culminating in the realization of the individual's oneness with reality. Soto appealed to the lesser samurai and to peasant farmers as a method of self-control. Soto became more popular than Rinzai, in part because it incorporates Pure Land funeral practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soto"@en .

aat:300263948 a skos:Concept ;
    skos:definition "A school of Japanese Buddhism founded by the militant Japanese Buddhist reformer Nichiren (1222-1282). Nichiren rejected other forms of Buddhism, and believed that the 'Lotus Sutra' contained the ultimate truth and asked the Japanese people to convert to this true Buddhism. Today there are almost 40 sub-sects, with Nichiren Shoshu being the largest and most important."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nichiren Buddhism"@en .

aat:300263949 a skos:Concept ;
    skos:definition "Refers to assembly drawings that depict the complete layout of equipment. They are distinct from subassembly drawings, which show only a detail of a certain area or component."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general arrangement drawings"@en .

aat:300263950 a skos:Concept ;
    skos:definition "Refers to a system of perspective that is based on orthodox linear perspective but exploits the extreme degradation of forms on the picture plane at very wide angles of view. It uses the optical trick of anamorphosis, in which a form depicted on the picture plane is subject to such extreme lateral stretching that it is unrecognizable from the front, but legible when viewed from a very shallow angle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anamorphic perspective"@en .

aat:300263951 a skos:Concept ;
    skos:definition "Refers to a perspective system in which rectangular forms are set at an angle to the picture plane rather than parallel to it; among possible techniques are two-point perspective and three-point perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblique perspective"@en .

aat:300263952 a skos:Concept ;
    skos:definition "Refers to a perspective system derived from linear perspective, but employing curved lines to account for the optical illusion that wide or tall forms at right angles to the viewer's line of sight undergo perspectival diminution towards their extreme edges. In this system, a wide wall parallel to the picture plane would appear to taper at the left and right. The system was discussed by Leonardo da Vinci in the Renaissance, but was not often used until the 19th and 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curvilinear perspective"@en .

aat:300263953 a skos:Concept ;
    skos:definition "Refers to a perspective system that indirectly uses two vanishing points, but is empirical rather than scientific. It was primarily used in Western art prior to the codification of one-point perspective in the Renaissance. In bifocal perspective, two vanishing points are placed at the same height at the left and right margins of the picture plane. From these points are drawn diagonal lines to points along the bottom or top margins of the picture plane; the points at which these diagonal lines cross are used to draw a floor or ceiling grid which resembles a grid drawn with a single central vanishing point and gives the illusion of recession into space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bifocal perspective"@en .

aat:300263954 a skos:Concept ;
    skos:definition "Refers to a system of perspective designed to counteract the effect of more distant objects appearing smaller at a distance. It employs the use of lines of sight to adjust proportions, typically in large-scale lettering and decorations, the effect being that all lettering or decoration appears to be the same scale from the vantage point of the viewer. The system was described in ancient times by Plato and others, and it was discussed by Dürer and other Renaissance artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negative perspective"@en .

aat:300263955 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nso"@en .

aat:300263956 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbo"@en .

aat:300263957 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Somalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sab"@en .

aat:300263958 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Somalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Digil"@en .

aat:300263959 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in Somalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hawiye"@en .

aat:300263960 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Bedouin group living in Eritrea and Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rashaida"@en .

aat:300263961 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Ndop Plain, Bamenda region of the western Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nsei"@en .

aat:300263962 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Sudan. Historically they founded the Funj kingdom centered at Sinnar, which controlled the eastern Sudan, including southern Nubia, and flourished from the fifteenth to the nineteenth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Funj"@en .

aat:300263963 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mboi"@en .

aat:300263964 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in coastal Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mboko"@en .

aat:300263965 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbula"@en .

aat:300263966 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbwela"@en .

aat:300263967 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Morwa"@en .

aat:300263968 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living mainly in Ethiopia and in southern Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mursi"@en .

aat:300263969 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in southern Chad in the region of Gounougaya in the Chari River valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musey"@en .

aat:300263970 a skos:Concept ;
    skos:definition "The act of placing oneself upon an object or the ground so that the weight of the body is on the posterior. Term may modify a representation of a figure in a seated posture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sitting"@en .

aat:300263971 a skos:Concept ;
    skos:definition "Secular rites of passage among various African peoples in which girls of marriageable age are secluded and fed large amounts of fattening food over a set period of time in preparation for marriage and the rigors of childbirth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fattenings"@en .

aat:300263972 a skos:Concept ;
    skos:definition "Religious ceremonies featuring music and dance traditionally performed by African Americans in coastal Georgia and South Carolina, derived from African practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring shouts"@en .

aat:300263973 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the central highlands of Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huambo"@en .

aat:300263974 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Botswana and Zimbabwe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalanga"@en .

aat:300263975 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngwoi"@en .

aat:300263976 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, that are made using oblique perspective, which is a system of linear perspective in which rectangular objects are set at an angle to the picture plane rather than parallel to it. Oblique perspectives may be two-point perspectives, three-point perspectives, or they may use another scheme. For drawings that use oblique projection, where parallel lines remain parallel rather than converging as they recede in space, use \"oblique projections.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oblique perspectives"@en .

aat:300263977 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bamunka"@en .

aat:300263978 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aten"@en .

aat:300263979 a skos:Concept ;
    skos:definition "Refers to drawings, or works in another medium, created by parallel perspective, which is either a system of perspective in which primary subjects are parallel to the picture plane or a system in which parallel projecting lines do not converge as they recede into space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parallel perspectives"@en .

aat:300263980 a skos:Concept ;
    skos:definition "Refers to a projection typically used to make great-circle charts or astronomical charts. It is an azimuthal projection represented on a plane tangent to the globe of the earth, heavens, or a heavenly body. It is often characterized by having the shape of a circle in which lines of longitude radiate from a central point at a pole and parallels of latitude are curved; however, other sections of the globe may also be represented using this projection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gnomonic projection"@en .

aat:300263981 a skos:Concept ;
    skos:definition "Refers to a system of projection used to transfer information from a globe to a flat surface. It is generally used in cartography where a portion of the Earth or other heavenly body is represented as if it were transferred to the surface of a cylinder and then unrolled as a plane on which parallels of latitude are horizontal lines and meridians of longitude appear as vertical lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylindrical projection"@en .

aat:300263982 a skos:Concept ;
    skos:definition "Refers to a system of projection generally used in cartography and named for Gerardus Mercator, who introduced this projection on a map in 1569. It is generally classified as a cylindrical projection, even though it is actually derived mathematically. It is characterized by having parallels of latitude represented as straight horizontal lines and meridians of longitude represented as vertical straight lines at right angles to the equator. It is often used for navigation charts because any straight line is a line of true bearing that allows navigators to plot a straight-line course; it often considered impractical for world maps because the scale is distorted and areas farther away from the equator appear disproportionately large."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mercator projection"@en .

aat:300263983 a skos:Concept ;
    skos:definition "Refers to a projection that depicts a portion of a globe as a flattened disk. It is often used in cartography and typically represents a section of the Earth or a heavenly body as viewed from a point at the center of the globe (\"gnonomic projection\"), on the opposite side of the globe (\"stereographic projection\"), or from a point in space (\"orthographic projection\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azimuthal projection"@en .

aat:300263984 a skos:Concept ;
    skos:definition "Refers to a projection that represents a solid body on a plane, generally used in the context of projecting the Earth or other heavenly body on a plane in making maps. It is typically characterized by a projection of a hemisphere depicting the Earth's lines of latitude and longitude on a tangent plane, where radials are generated from a point on the surface of the sphere opposite to the point of tangency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereographic projection"@en .

aat:300263985 a skos:Concept ;
    skos:definition "Refers to a system of projection generally used in map-making and based on the principle of a hollow cone being placed over a sphere so that when the cone is unrolled the line of tangency becomes the central or standard parallel of the area being mapped. In this system, all parallels of latitude are arcs of concentric circles and the meridians of longitude are straight lines generated from the cone's vertex to the divisions of the standard parallel. It is typically derived from a projection of the globe on a cone drawn with a point above one of the poles and tangent to the Earth or other heavenly body at one selected parallel. It may also be derived from a projection where the cone is arranged to intersect the sphere at two closely spaced parallels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conic projection"@en .

aat:300263986 a skos:Concept ;
    skos:definition "Refers to a system of projection generally used in creating large-scale map series, where each map is depicted as part of a cone tangent to the globe at the particular latitude. The projection is based on the concept of a series of concentric cones being placed over the sphere so that each cone is tangent to a different latitude, where only the section of each unrolled cone that lies along a common central meridian of longitude and forms a strip on both sides of the line of tangency is represented. In this system, all parallels of latitude are arcs of nonconcentric circles, and the meridians of longitude other than the central meridian are represented by curved lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyconic projection"@en .

aat:300263987 a skos:Concept ;
    skos:definition "Refers to an azimuthal projection typically used in map-making and depicting the sphere of the Earth or other heavenly body where the point of sight is at the center and the plane of projection passes through one of the polar circles. It is typcially limited to 10 or 15 degrees from the pole; parallels of latitude are concentric circles and meridians are radiating straight lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polar projection"@en .

aat:300263988 a skos:Concept ;
    skos:definition "Refers to a system of projection generally used in map-making, where distances are true to scale in all directions when taken from a given point or along a given meridian or parallel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equidistant projection"@en .

aat:300263989 a skos:Concept ;
    skos:definition "Refers to a projection generally used in map-making, where a section of the surface of the Earth or other heavenly body is depicted so that a straight line drawn from the center to any other point represents the shortest distance and can be measured to scale. This type of projection is often used to show distances and directions from a particular city, and measurements are accurate only when taken from the selected central point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azimuthal equidistant projection"@en .

aat:300263990 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, an Akan group living in southern Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adanse"@en .

aat:300263991 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nungu"@en .

aat:300263992 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuer"@en .

aat:300263993 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in southern Cameroon and northern Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Njem"@en .

aat:300263994 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living on the Gandoul Islands in the delta of the Saloum River, Senegal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Niominka"@en .

aat:300263995 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngulu"@en .

aat:300263996 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a sub-group of the Sara living primarily in Chad but also in Cameroon and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngambay"@en .

aat:300263997 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northwestern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngala"@en .

aat:300263998 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a nomadic Berber group living in Mauritania and Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nemadi"@en .

aat:300263999 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in eastern Gabon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Obamba"@en .

aat:300264000 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Equatorial Guinea, comprised of many Kombe-speaking sub-groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndowe"@en .

aat:300264001 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living mainly in the Democratic Republic of Congo but also in Uganda and Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndo"@en .

aat:300264002 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndiki"@en .

aat:300264003 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndibu"@en .

aat:300264004 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northeastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndaka"@en .

aat:300264005 a skos:Concept ;
    skos:definition "Describes the works created by the African people of the same name living in central Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nchumuru"@en .

aat:300264006 a skos:Concept ;
    skos:definition "Complexes within an enclosure, comprising single or multi-unit family dwellings with communal spaces, adjacent outbuildings or structures. Examples are in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compounds"@en .

aat:300264007 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shako"@en .

aat:300264008 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya and Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sebei"@en .

aat:300264010 a skos:Concept ;
    skos:definition "Folk tales of mythical figures who are comical or deceitful; the tales are amusing yet also serve to highlight important social values. Typical characters include Br'er Rabbit, Coyote, Til Eulenspiegel, Badger, and Ananse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trickster tales"@en .

aat:300264011 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Niger River Delta region of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Okrika"@en .

aat:300264012 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pokomo"@en .

aat:300264013 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ron"@en .

aat:300264014 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a sub-group of the Ovimbundu living in Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sele"@en .

aat:300264015 a skos:Concept ;
    skos:definition "Low, outdoor stone seats built into the landscapes of gardens or parks and used as places for discussions, drama, dances and other social activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "council rings"@en .

aat:300264016 a skos:Concept ;
    skos:definition "Structures where coal is unloaded from mining cars by means of a tipping device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tipples"@en .

aat:300264017 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Central African Republic, Sudan, and Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sere"@en .

aat:300264018 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tale"@en .

aat:300264019 a skos:Concept ;
    skos:definition "Business machines, usually with money drawers, that record sales, other transactions, and related operations such as totaling receipts and dispensing printed receipts for customers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cash registers"@en .

aat:300264020 a skos:Concept ;
    skos:definition "A beverage consisting of an infusion of hot or cold water and the leaves or leaf fragments of various herbs, dried or fresh, sometimes with ground spices added. It is often used for medicinal purposes as well as refreshment. For the beverage made from infusion of the leaves of the tea plant, Camellia sinensis, use \"tea (beverage).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbal tea"@en .

aat:300264021 a skos:Concept ;
    skos:definition "Visual works made of or decorated with lacquer, which is paint or varnish that dries with a high gloss. Works are usually made of thin wood, then coated and decorated with lacquer applied in several coats. This dries to a very hard and smooth surface layer which is durable, waterproof, and attractive to feel and look at. Works of lacquer may be painted with pictures, inlaid with shell and other materials, carved, or dusted with gold and given other further decorative treatments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacquerware"@en .

aat:300264023 a skos:Concept ;
    skos:definition "Refers to a system of projection by which the points on a sphere are mapped onto a plane, maintaining a one-to-one correspondence of points. It is generally used for map-making, and tries to resolve the problem that arises because a sphere cannot be represented on a flat surface with the preservation of the proportion of all distances. Conformal projection attempts to preserve the relative shape of configurations that surround each point; that is, it preserves the magnitude and sense of angles at each point. Mercator projection and streographic projection are examples of conformal projection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conformal projection"@en .

aat:300264024 a skos:Concept ;
    skos:definition "Refers to works characterized by a pattern or design executed in stitches using thread or fine wire. The designs are typically executed on textiles, but leather, paper, or another media may also be used; the designs may be intended to be framed, or to decorate apparel, bed linens, furniture coverings, pillows, altar cloths, ceremonial hangings, or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embroidery"@en .

aat:300264025 a skos:Concept ;
    skos:definition "Refers to lacquer produced in France during the 18th century in imitation of Japanese and Chinese lacquers. The basic ingrediant in copal varnish with powdred metal, often gold, mixed in. It was developed by and named for the Martin brothers, Parisian craftsmen, it was used to decorate furniture, carriages, snuff boxes and other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernis Martin"@en .

aat:300264026 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Democratic Republic of Congo in the region of the Salampasu, Lunda, Kanyok, and Luba. Geographically and culturally distinct from the Northern Kete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern Kete"@en .

aat:300264027 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bile"@en .

aat:300264028 a skos:Concept ;
    skos:definition "Boats that sewn or pegged together with wooden pegs, its boards warped closely together with fiber lashing or caulking. If included, the sails are made of coarse matting. Sewn boats also include skin or bark covered canoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewn boats"@en .

aat:300264029 a skos:Concept ;
    skos:definition "Sewn boats of East Africa origin, about thirty or fourty tons, and having a long curved prow, and rigged with a square sail of coarse matting. No longer used, mitepe were mainly engaged in traffic along the section the Swahili Coast that lies between Zanzibar and the Lamu Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitepe"@en .

aat:300264030 a skos:Concept ;
    skos:definition "Refers to works decorated with cross-stitching, which is a type of needlework in which designs are created with tiny crosses or \"x\" shapes made by crossing two stitches. The works may be executed on fine fabrics, such as linen, or on heavy canvas or carpets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross stitch"@en .

aat:300264031 a skos:Concept ;
    skos:definition "Refers to works created with a needle and thread on fabric or a mesh of canvas. The works are characterized by designs that are executed by using the grid of the fabric to count out the desired position of various stitches or colors in the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlepoint"@en .

aat:300264032 a skos:Concept ;
    skos:definition "Refers to needlepoint in which the design is worked on a canvas or cloth that has around 16 to 50 mesh holes per linear inch, allowing stitches that are small and fine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petit point"@en .

aat:300264033 a skos:Concept ;
    skos:definition "Refers to needlepoint in which the design is worked on a canvas or cloth that has around 7 to 16 mesh holes per linear inch, allowing stitches that are relatively large and bold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gros point"@en .

aat:300264034 a skos:Concept ;
    skos:definition "Refers to the process of using thread to create two stitches of the same length that cross each other to form crosses or \"x\" shapes. It is often used to make designs on fine fabrics or heavy canvas or carpet. It is also used to secure seams or splices in pieces of fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-stitching"@en .

aat:300264035 a skos:Concept ;
    skos:definition "Refers to coarse lace or fringe made by knotting cords or thick threads in a geometric pattern. The term comes from Turkish \"makrama,\" meaning \"napkin,\" or \"towel.\" It was a specialty of Genoa, where towels decorated with knotted cord were popular in the 19th century. The predecessor of macrame was the 16th-century technique of knotting lace known as \"punto a groppo.\" In the 1960s macrame became a popular craft and creative art technique in America and in Europe. It has been used to create lampshades, plant hangers, hammocks, window coverings, and wall hangings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macrame"@en .

aat:300264037 a skos:Concept ;
    skos:definition "Refers to a kind of decorative material that is generally classified as lace. It is made of knotted thread that is netted with a small flat shuttle-shaped instrument using stout sewing-thread. It is composed of knots or stitches and picots, forming rings and semicircles, which are arranged in patterns or shapes. Tatting is typically used for edging or trimming, and sometimes for doilies, collars, or parasol covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tatting"@en .

aat:300264038 a skos:Concept ;
    skos:definition "Needlework created by crocheting, which employs looped stitches made with a single cord or strand of yarn and a single hooked needle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crochet"@en .

aat:300264039 a skos:Concept ;
    skos:definition "Refers to handmade works or material created by interlacing loops of a long or continuous piece of yarn or thread by means of two needles; various types of loops or stitches are used to create patterns or designs. Some forms of knitting are made by using circular needles or more than two needles. Loops running lengthwise are called wales; those running crosswise are called courses. Knitting is typically formed into apparel, bedspreads, rugs, or other household articles. The term may also refer to knitted fabrics that are constructed by hand or by machine, comprising an interlocking series of loops made from one or more yarns, with each row of loops caught into the preceding row."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting"@en .

aat:300264040 a skos:Concept ;
    skos:definition "Hill top resorts and places of refuge, especially in Asia, built by colonial administrators as an escape from the hot climates or politally unstable conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hill stations"@en .

aat:300264041 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tangale"@en .

aat:300264042 a skos:Concept ;
    skos:definition "Freestanding, cast brass shrine figures, symbols of the Ogboni society of the Yoruba people of Nigeria; they often occur in pairs. The name literally means \"owners of the earth.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onile"@en .

aat:300264043 a skos:Concept ;
    skos:definition "Ritual emblematic sculptures in the form of sceptors or of bundles of sticks from the tallow tree named \"ofo\", associated with an Igbo men's society also called \"Ofo.\" Although typically of wood, examples made of bronze, copper alloy, and iron hae also been documented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ofo"@en .

aat:300264044 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tugen"@en .

aat:300264045 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tiriki"@en .

aat:300264046 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Ethiopia and Eritrea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tigray"@en .

aat:300264047 a skos:Concept ;
    skos:definition "Iron and bronze staffs or scepters of uncertain origin and age, possibly made by the Soninke, Fulani or Fula people. They have been found in Guinea-Bissau and Sierra Leone. They date possibly to the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sono"@en .

aat:300264048 a skos:Concept ;
    skos:definition "Yoruba narrow-strip woven cloth made on a horizontal loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aso oke"@en .

aat:300264049 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Shluh Berber group living in the Morocco High Atlas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glawa"@en .

aat:300264050 a skos:Concept ;
    skos:definition "School of painting that flourished in the mid-16th century in eastern Tibet; it was begun by Jamyang Khyentse Wangchuk (b. 1524). Attention to detail, continued Chinese influence, and a new way of treating the background are hallmarks of this school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khyen ris"@en .

aat:300264051 a skos:Concept ;
    skos:definition "Early style of Tibetan painting that flourished in western Tibet from the 10th to the 14th century. The style, which is akin to Kashmiri painting, is characterized by brilliant and lustrous color and a taste for elegantly dressed swaying figures with pinched waists and full bosoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tibeto-Kashmiri style"@en .

aat:300264052 a skos:Concept ;
    skos:definition "An eastern Tibetan painting style in which the Chinese style of painting landscape background is adapted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khamdi"@en .

aat:300264053 a skos:Concept ;
    skos:definition "A type of transfer paper that has been printed with a design in such a way that the design can be transferred to another surface. Moisture is usually applied to the paper and then it is placed face down on the second surface; the design, or 'decal,' attaches itself to the second surface and the backing is stripped away. Mass-produced ceramic wares are commonly decorated with transfers of this kind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decalcomania paper"@en .

aat:300264054 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Côte d'Ivoire, Guinea, Senegal, and Sierra Leone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yalunka"@en .

aat:300264055 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name formerly living on Beta Island off the coast of Victoria, Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wovea"@en .

aat:300264056 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Burkina Faso, a subgroup of the Gurunsi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Winiama"@en .

aat:300264057 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, originally of Fulbe origin, who have assimilated culturally and linguistically with Mande peoples, specifically the Bamana and Maninka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wassalunke"@en .

aat:300264058 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wanga"@en .

aat:300264059 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northwestrn Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wala"@en .

aat:300264060 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vidunda"@en .

aat:300264061 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in southwestern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tumbwe"@en .

aat:300264062 a skos:Concept ;
    skos:definition "Pieces of ornament or entire textile works created by applying shapes or patterns in one material onto another material. The works are typically further decorated with embroidery that is used to secure and embellish the design. The term may refer to a single cutout decoration that is intended to be fastened to the larger piece of material, or to the material having the piece attached. Works may be intended to be framed or formed into apparel, hangings, bed linens, or other household items. Appliqué, along with embroidery, are among the most ancient and universal types of decorated textile works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appliqué"@en .

aat:300264063 a skos:Concept ;
    skos:definition "Refers to embroidery done with distinctive, two-ply, loosely twisted woolen yarns known as \"crewel wool.\" Crewelwork traditionally has a twill foundation, with linen warp and cotton weft; however, pure linen or cotton cloth or another fabric may be used. It may be intended for framing or fashioned into apparel, bed hangings, furniture coverings, or other items. It is characterized by having a more free-hand style than other types of embroidery. The creation of crewelwork particularly flourished in 16th- to 18th-century Europe and the American colonies, with designs inspired by textiles from India and the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crewelwork"@en .

aat:300264064 a skos:Concept ;
    skos:definition "Refers to hand sewing characterized by the simplicity of the stitches and by its application, which is primarily for the construction of clothing and the finishing of household textiles. It is distinct from sewing used to create designs, such as embroidery. Plain sewing generally may include basic stitches, such as running stitches, back-stitching, hemming stitches, and seaming stitches, as well as simple embellishments to these basic stitches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain sewing"@en .

aat:300264066 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bandjoun"@en .

aat:300264067 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zaose"@en .

aat:300264068 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tulama"@en .

aat:300264069 a skos:Concept ;
    skos:definition "Ancient North African sepulchral chambers dug into rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haouanet"@en .

aat:300264070 a skos:Concept ;
    skos:definition "Refers to thin, transparent, mesh fabric, often linen or cotton, created with a lace \"whole stitch.\" It is often used as a foundation for lace. The term may also refer to any thin, transparent fabric that resembles fabric made with the lace whole stitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toile"@en .

aat:300264071 a skos:Concept ;
    skos:definition "A rubberized cloth made by coating two fabric layers with rubber dissolved in naphtha and then pressing them together. This double cloth was the first coated cloth and was developed by Charles Macintosh in Scotland in 1823 for rainwear use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mackintosh cloth"@en .

aat:300264072 a skos:Concept ;
    skos:definition "Refers to works done with one or more needles and thread, yarn or cord. The term generally refers to work done by hand. Needlework includes sewing, embroidery, knitting, and other works. Until the 20th century \"plain sewing\" was the most widely practiced form of needlework in Western cultures. Most females learned basic sewing and knitting, which was used in the construction of clothing and the finishing of household textiles. With the introduction of machine sewing, needlework done by hand was often limited to decorative work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "needlework"@en .

aat:300264073 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Hausa people of a pre-Islamic state in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zamfara"@en .

aat:300264074 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a sub-group of the Yoruba living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yagba"@en .

aat:300264075 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lalia"@en .

aat:300264076 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Senufo living in Côte d'Ivoire and Mali, distinguished as woodcarvers and calabash repairers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kulebele"@en .

aat:300264077 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hurutshe"@en .

aat:300264078 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gorowa"@en .

aat:300264079 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Cameroon, Central African Republic, Republic of the Congo, and Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gbaya"@en .

aat:300264080 a skos:Concept ;
    skos:definition "Carvings of saints and other holy figures, usually wooden or of ivory, produced for Roman Catholics in Spanish colonies in the Americas, the Caribbean, and elsewhere, or similar objects made at a later date in imitation. Santos were very popular; they have a particular style, reminiscent of the seventeenth-century Spanish Baroque style, but use a less refined technique and primitive representations. It was customary to dress them in clothing. For two-dimensional representations of saints in Mexico and the southwestern United States, prefer \"retablos.\" For three-dimensional images of saints Mexico and the southwestern United States, prefer \"bultos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "santos"@en .

aat:300264081 a skos:Concept ;
    skos:definition "Describes works created by the African people living in central Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Degha"@en .

aat:300264082 a skos:Concept ;
    skos:definition "Structures made of steel, reinforced concrete or wood which stand at the entrance of a mine shaft and support pit-head gear from the shaft, at the top of which two wheels guide cables off to a winding engine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineheads"@en .

aat:300264083 a skos:Concept ;
    skos:definition "Vessels made from the dried, hollowed-out shells of the fruit of the calabash tree or of various types of gourd. Included are containers such as bottles and drinking gourds, utensils such as bowls and ladles, and musical instruments or components thereof such as drums and rattles. They are made and used throughout the world, particularly in Africa, Central and South America, and Polynesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calabashes"@en .

aat:300264084 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Chad, Niger, and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buduma"@en .

aat:300264085 a skos:Concept ;
    skos:definition "Refers to lace made on a foundation of fine, knotted netting of either square or diamond mesh; the netting is stretched on a frame and embroidered; the art is of ancient origin. A common way of making the net entails passing a thread, which is wound on an elongated shuttle, over a mesh stick or gauge that governs the size of the mesh, and into a previously created square or diamond; a knot similar to a fisherman's knot is tied holds the thread in place. The embroidery applied on the net may employ a variety of stitches, often including a darning stitch and fillings. The term derives from the French \"filet,\" meaning \"network.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filet lace"@en .

aat:300264209 a skos:Concept ;
    skos:definition "Bindings in a style made from the mid-eighteenth to the early nineteenth century, with decoration featuring Masonic symbols tooled in gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Masonic bindings"@en .

aat:300264210 a skos:Concept ;
    skos:definition "Goods in transit, whether by land, air, or water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freight"@en .

aat:300264211 a skos:Concept ;
    skos:definition "Any instruments for making recordings, either continuously or intermittantly, of the successive values of a number of different physical quantities, such as heat, light, and moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dataloggers"@en .

aat:300264212 a skos:Concept ;
    skos:definition "Those who direct and train choirs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choirmasters"@en .

aat:300264213 a skos:Concept ;
    skos:definition "Coverings for pamphlets, each cover consisting of two boards connected by a cloth hinge to which an additional tape or strip of material is attached. The pamphlet is then sewn or adhered to the strip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pamphlet binders"@en .

aat:300264214 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Sudan and Eritrea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bisharin"@en .

aat:300264215 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Birwa"@en .

aat:300264216 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Guinea-Bissau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Biafada"@en .

aat:300264217 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a mixed race African, Brazilian, and Portuguese people living in southwestern Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbali"@en .

aat:300264218 a skos:Concept ;
    skos:definition "Bindings typically used for pamphlets that are expected to receive infrequent use. Typically they are side-stitched, sometimes with wire, and covered with boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pamphlet bindings"@en .

aat:300264219 a skos:Concept ;
    skos:definition "Books produced and published by private presses. For manuals provided to theater owners, especially in the 1930s and 1940s, advising them on how to promote a particular motion picture being shown in their theater, use \"pressbooks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press books"@en .

aat:300264220 a skos:Concept ;
    skos:definition "Analysis and measurement of minute quantities of radioisotopes in materials, using a particle accelerator. It is used in fields such as archaeology, anthropology, toxicology, radiochemistry, and climatology for purposes such as dating, identifying, and describing materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accelerated mass spectrometry"@en .

aat:300264221 a skos:Concept ;
    skos:definition "The decomposition of a molecule with the addition of the elements of an acid to that molecule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid hydrolysis"@en .

aat:300264223 a skos:Concept ;
    skos:definition "A deposit of earth, sand, and other transported matter left by water flowing over land not permanently submerged; chiefly applied to the deposits formed in river valleys and deltas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alluvium"@en .

aat:300264224 a skos:Concept ;
    skos:definition "A member of a large group of organic chemicals, containing only the elements hydrogen and carbon. They are major constituents of crude petroleum and natural gas, from which certain fractions are extracted for use as fuel and as raw materials for the chemical industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrocarbon"@en .

aat:300264225 a skos:Concept ;
    skos:definition "A serpentinite from the Italian Riviera, between Spezia and Genoa. It is found in two varieties: one is purplish or mottled black and dark red with some green pebbles or veins, the other is green with many white veins. It is difficult to work with but acquires a high polish. It may resemble some varieties of variegated marble from Tennessee in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levanto granite"@en .

aat:300264226 a skos:Concept ;
    skos:definition "A member of the series of saturated hydrocarbons with the general chemical formula CnH2n+2, where \"n\" is a whole number. Though generally nonreactive, they combust readily and many important fuels are alkanes, such as methane and butane, or mixtures of alkanes such as gasoline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkane"@en .

aat:300264228 a skos:Concept ;
    skos:definition "Non-metallic solid element, atomic number 5, symbol B, with several specialized uses, such as in alloy steels, in semiconductors, and in commercially valuable compounds such as borax and boric acid. It is usually prepared as a brown powder, but when very pure it forms hard, shiny, dark crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boron"@en .

aat:300264230 a skos:Concept ;
    skos:definition "Generally, any of a number of acids containing boron and oxygen. Specifically, it refers to the compound H3BO3, a white or colorless solid that is soluble in water and ethanol. It occurs naturally in the condensate from volcanic steam vents; commercially, it is made by treating borate minerals with sulphuric acid followed by recrystalization. It is used in the manufacture of glass, glazes and enamels, leather, paper, adhesives, and explosives. It is widely used (particularly in the USA) in detergents, and because of the ability of fused boric acid to dissolve other metal oxides, it is used as a flux in brazing and welding. Because of its mild antiseptic properties, it is used in the pharmaceutical industry and as a food preservative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boric acid"@en .

aat:300264231 a skos:Concept ;
    skos:definition "A relatively thin cardboard made from recycled paper; it is clay-coated or surfaced with white paper. Railroad board is often made water resistant to prevent buckling when waterborne paint is used or because of handling with wet hands. Four and six-ply are common thicknesses and it is typically found in black, white, or one of several lackluster, dyed colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad board"@en .

aat:300264232 a skos:Concept ;
    skos:definition "A silvery white metal, with symbol Ca and atomic number 20, the fifth most abundant element in the earth's crust, occurring in many compounds. Its uses include as a nutritional supplement to assist the growth of bone and teeth, as a dehydrating agent for organic solvents, and to remove gases from molten metals prior to casting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium"@en .

aat:300264233 a skos:Concept ;
    skos:definition "Any compound of carbon, hydrogen, and oxygen in which the last two elements occur in the same proportion as in water. Carbohydrates include monosaccharides (fructose, glucose), disaccharides (sucrose, maltose, lactose) and polysaccharides (starch, cellulose, gum, agar, carrageenan). They are manufactured by plants and provide the major source of energy for animals and people. Simple carbohydrates, such as sugars, are water-soluble with a sweet taste. Starches and gums are composed of repeating saccharide groups. They swell in water to form a gel and can be hydrolyzed to obtain their sugar constituents. Cellulose is insoluble in water and organic solvents. Carbohydrates are used as paint binders, varnishes, adhesives, and sizing agents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbohydrate"@en .

aat:300264234 a skos:Concept ;
    skos:definition "Refers to large wing-handled lusterware vases found at the medieval Islamic palace of Alhambra in Granada, Spain. Averaging 125 cm in height, they are the largest lusterware pots ever made. They were probably produced in the coastal town of Málaga. These amphora-shaped vessels fall into two stylistic groups. Vases of the first group, dating to the late 13th and early 14th centuries, are more bulbous in shape and have short necks, monochrome luster, and bold, angular inscriptions. Vases of the second group, dating to the late 14th and early 15th centuries, are more elongated and are decorated in cobalt blue and gilding; they also have less conspicuous inscriptions. As they are unstable, they would have been displayed on tripods or set into holes in the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alhambra vases"@en .

aat:300264235 a skos:Concept ;
    skos:definition "Any member of a group of organic compounds, -COOH, in which a carbon atom is doubly bonded to an oxygen atom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbonyl"@en .

aat:300264236 a skos:Concept ;
    skos:definition "A heavy, metallic, hard tin dioxide, chemical formula SnO2, that is the major ore of tin. It is colorless when pure, but brown or black when iron impurities are present. Commercially important quantities occur in placer deposits, but cassiterite also occurs in granite and pegmatites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassiterite"@en .

aat:300264237 a skos:Concept ;
    skos:definition "Parts or components of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "material components"@en .

aat:300264238 a skos:Concept ;
    skos:definition "Any atom or group of atoms that bears one or more positive or negative electrical charges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ions"@en .

aat:300264239 a skos:Concept ;
    skos:definition "Positively charged ions, so called because they are attracted by the cathode or negatively charged electrode in electrolysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cations"@en .

aat:300264240 a skos:Concept ;
    skos:definition "A private enclosure in a mosque near the mihrab, typically for the use of the caliph or other important person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maqsuras"@en .

aat:300264241 a skos:Concept ;
    skos:definition "Ions that have gained one or more electrons and thereby carry a negative electric charge, so-called because when an electric current is passed through a conducting solution the negative ions present in the solution are attracted to the anode."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anions"@en .

aat:300264242 a skos:Concept ;
    skos:definition "The smallest particles in which the elements combine either with themselves, or with each other, and thus the smallest quantity of matter known to possess the properties of a particular element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atoms"@en .

aat:300264243 a skos:Concept ;
    skos:definition "Negatively charged elementary particles that are a constituent of all atoms, occupying an atomic orbital around the nucleus. They were discovered by J. J. Thomson in 1897."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrons"@en .

aat:300264244 a skos:Concept ;
    skos:definition "Refers to the ancient Roman emperors from the time of Augustus Caesar (born 63 BCE) to the fall of Constantinople. The term is taken from the surname of the Roman dictator Caius Julius Caesar, and was transferred as a title to succeeding emperors. From the time of Hadrian (died 138 CE) it was also used as a title of the heir-presumptive of the emperor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caesars"@en .

aat:300264245 a skos:Concept ;
    skos:definition "The smallest components of a compound that can exist independently and retain their properties. The atoms that make up a molecule are either bonded together covalently, as in carbon dioxide, or electrovalently, as in sodium chloride."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molecules"@en .

aat:300264246 a skos:Concept ;
    skos:definition "An element, symbol Cl and atomic number 17, that is at ordinary temperatures a greenish-yellow gas, toxic and corrosive to the eyes and respiratory system. It becomes a liquid at -29 degrees Fahrenheit. It occurs in nature in great abundance in compounds, such as common salt. Free chlorine is used as a sterilizing agent, such as for water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chlorine"@en .

aat:300264247 a skos:Concept ;
    skos:definition "Material comprising flowers, which are the reproductive portion of any plant in the division Magnoliophyta (Angiospermae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower"@en .

aat:300264248 a skos:Concept ;
    skos:definition "Small, reddish-brown flower bud of the tropical evergreen tree Syzygium aromaticum. It yields oil which is used as an antiseptic and a flavoring, and is dried and ground into an aromatic spice. The ground flower is also used as a means of organic pest control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clove"@en .

aat:300264249 a skos:Concept ;
    skos:definition "The dark, porous, carbonized residue left after the destructive distillation of bituminous coal, petroleum or coal tar pitch. Coal can be converted to coke by heating it in an airless oven to drive off all volatile components. Coke was once made in large quantities as a byproduct when coal was burnt to produce methane. Coke is useful in metallurgy because it burns hotter than coal; it is used primarily as a fuel or as a reducing agent in the iron and steel industry, primarily in blast furnaces. The process for using coke in smelting was developed in the 17th century. In the 18th and 19th centuries coke aided in the expansion of the cast iron and steel production. Coke can also be converted to graphite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coke"@en .

aat:300264250 a skos:Concept ;
    skos:definition "A method of storing food and other perishables, such as photographic film, at a low temperature to prevent deterioration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold storage"@en .

aat:300264251 a skos:Concept ;
    skos:definition "Cuprous sulfide occurs in the form of black powder or lumps and is found as the mineral chalcocite. Large quantities of the compound are obtained by heating cupric sulfide (CuS) in a stream ofhydrogen. Cuprous sulfide is insoluble in water but soluble in ammonium hydroxide and nitric acid. Its applications include use in solar cells, luminous paints, electrodes, and certain varieties of solidlubricants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuprous sulfide"@en .

aat:300264252 a skos:Concept ;
    skos:definition "Large masks enveloping the wearers' torso, and often the head or arms as well. Known particularly among the Yoruba and Makinde peoples of Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body masks"@en .

aat:300264254 a skos:Concept ;
    skos:definition "Name referring to secular and religious leaders of Muslim communities who are seen as successors of Muhammad; it derives from the Arabic 'khalifa' meaning 'successor.' The term is primarily used in historical reference following Turkey's abolition of the caliphate on March 23, 1924."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caliphs"@en .

aat:300264255 a skos:Concept ;
    skos:definition "Refers to boxes or chests of pedestal form for the Koran; it can also refer to thrones or preachers' seats in a mosque as well as to large lecterns on which readers of the Koran sit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kursis"@en .

aat:300264256 a skos:Concept ;
    skos:definition "Zulu married women's beaded headdresses, having a removable top knot made of basketry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "izicholo"@en .

aat:300264257 a skos:Concept ;
    skos:definition "Typically refers to interior courtyards of mosques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sahns"@en .

aat:300264258 a skos:Concept ;
    skos:definition "Yoruba metalworkers who work in non-ferrous metals such as lead, silver, copper, bronze and brass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asude"@en .

aat:300264259 a skos:Concept ;
    skos:definition "Igbo wooden shrine statues of male human figures representing tutelary or guardian spirits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alusi"@en .

aat:300264263 a skos:Concept ;
    skos:definition "Refers to high executive officers or ministers in a Muslim government, particularly in the Ottoman Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viziers"@en .

aat:300264264 a skos:Concept ;
    skos:definition "Yoruba statues representing a kneeling woman holding over her head or out in front of her a container such as a calabash, bowl, or tray. They are associated with Shango worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arugba"@en .

aat:300264265 a skos:Concept ;
    skos:definition "African textile material of Ewe origin but adapted and varied by other peoples, woven on a loom in narrow strips to produce strong patterns. A popular cloth, it is traded all around the Niger Delta region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Popo cloth"@en .

aat:300264266 a skos:Concept ;
    skos:definition "Kings or sovereign rulers of Muslim states, especially those of the former Ottoman Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sultans"@en .

aat:300264267 a skos:Concept ;
    skos:definition "Synthetic yarn with reflective properties made of aluminum filaments coated with plastic. It is used in Nigeria and other parts of West Africa to weave shiny, glittering cloth-like material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lurex"@en .

aat:300264268 a skos:Concept ;
    skos:definition "Refers to a Romanesque school of manuscript illumination, enamelwork and metalwork that flourished in the Meuse Valley from the late 11th to the early 13th century. Although the river runs from northeastern France to the Rhine estuary in the Netherlands, the term Mosan refers, in art historical contexts, to the stretch of river in modern Belgium, particularly the area around Liège and the Benedictine monastery of Stavelot. Within Romanesque art, the Mosan school is distinctive for its more naturalistic, if still idealized, treatment of the human figure. It is also known for its sumptuousness and classical aspects, the latter due to the fact that this area was the home of the classicizing Reims Style in the Carolingian period. Important Mosan artists include Godefroid de Claire, Nicolas of Verdun and Renier of Huy. Mosan metalwork was particularly influential and renowned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mosan"@en .

aat:300264269 a skos:Concept ;
    skos:definition "Refers to rulers, particularly emperors, who ruled one of the following entities: the German Holy Roman Empire, the empire of Austria-Hungary from 1804, or Germany from 1871-1918. The term is occasionally used in a more general sense to refer to any Germanic supreme ruler who reigned from the 13th century onwards. It is derived from an early German word that in turn was derived from the Latin word for \"Caesar.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaisers"@en .

aat:300264270 a skos:Concept ;
    skos:definition "Untailored outer garments of Madagascar worn by both men and women wrapped around the shoulders and sometimes the upper torso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamba"@en .

aat:300264271 a skos:Concept ;
    skos:definition "Shrouds of Madagascar, woven of silk, cotton, bast, or raffia and often decorated with embroidery or beads, used to wrap bodies for ritual reburial. The term literally translates as \"red cloth\", although red is not always the dominant color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamba mena"@en .

aat:300264272 a skos:Concept ;
    skos:definition "Typically refers to Persian rulers. The term is derived from a Persian title meaning \"Great King\" or \"Emperor.\" The term is usually used to refer to the shah of Iran, but it may also refer to the Sultan of Turkey or to the Great Mogul of India. Before 1948, it was also used in India to refer to the sovereign of Great Britain. It is occasionally used in Asia to refer in a more general sense to monarchs of Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padishahs"@en .

aat:300264273 a skos:Concept ;
    skos:definition "Terms or names that are used as coequal forms of access but not desingated as the \"preferred term\" in a given context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonpreferred terms"@en .

aat:300264275 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Tanale-Waja District, formerly Bauchi Province, of northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cham-Mwana"@en .

aat:300264276 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hona"@en .

aat:300264277 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tera"@en .

aat:300264278 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agona"@en .

aat:300264279 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the lagoon region of Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aizi"@en .

aat:300264280 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Yoruba living in Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Awori"@en .

aat:300264281 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maguzawa"@en .

aat:300264282 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalenjin"@en .

aat:300264283 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Tanzania and Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyiha"@en .

aat:300264284 a skos:Concept ;
    skos:definition "Refers to large estates or sizable sections of a larger territory, which itself is typically ruled by a sovereign. A barony is held by a baron and was often originally awarded for military or other service to the monarch, and thereafter was generally handed down from father to son."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baronies"@en .

aat:300264285 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Sierra Leone and Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuranko"@en .

aat:300264286 a skos:Concept ;
    skos:definition "Describes works created by the North African Arab people of the same name living in Mauritania and western Sahara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hassaniya"@en .

aat:300264287 a skos:Concept ;
    skos:definition "Describes works created by the Bedouin people of the same name living inTunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Djerid"@en .

aat:300264292 a skos:Concept ;
    skos:definition "Describes works created by the Tuareg people of the same name living in Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Udalen"@en .

aat:300264293 a skos:Concept ;
    skos:definition "Describes works created by the Tuareg people of the same name living in the Adrar des Iforas mountain of northern Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Adrar"@en .

aat:300264294 a skos:Concept ;
    skos:definition "Describes works created by the Tuareg people of the same name living in southern Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Geres"@en .

aat:300264295 a skos:Concept ;
    skos:definition "Describes works created by the Tuareg people of the same name living in eastern Mali and western Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iwellemmeden"@en .

aat:300264296 a skos:Concept ;
    skos:definition "Describes works created by the Tuareg people of the same name living in southern Algeria and Libya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Ajjer"@en .

aat:300264297 a skos:Concept ;
    skos:definition "Describes works created by the Tuareg people of the same name living in the Air region of Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Ayr"@en .

aat:300264298 a skos:Concept ;
    skos:definition "Describes works created by the Tuareg people of the same name living in the Ahaggar mountain area of Algeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Ahaggar"@en .

aat:300264299 a skos:Concept ;
    skos:definition "Describes works created by the Bedouin people of the same name living in southwestern Tunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nefzawa"@en .

aat:300264300 a skos:Concept ;
    skos:definition "Describes works created by the Bedouin people of the same name living in Nefzaoua region, Tunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ghrib"@en .

aat:300264301 a skos:Concept ;
    skos:definition "Any of several Christian denominations that believe in the literal and imminent second coming of Christ and the imminent end of the world. These beliefs are found in most periods of history. William Miller (1781-1849) began a movement in the United States based on his prediction that Christ would return in 1843-44. Miller's followers, who formed the denomination called Seventh Day Adventists, believe that Christ's second coming is delayed solely by a failure to keep the Sabbath. Seventh Day Adventists rigorously follow laws of Sabbath observance as well as Old Testament dietary laws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adventism"@en .

aat:300264302 a skos:Concept ;
    skos:definition "Any of the movements stemming from the more radical elements of the 16th-century Reformation that insisted that only adult baptism is valid and that true Christians should not hold government office, use force, or bear arms. Followers of these movements, also known as Rebaptizers, emphasize strict church discipline, adherence to scripture, and the separation of church and state. Anabaptists frequently suffered persecution as a result of their criticism of government; they are often considered the forerunners of the Baptists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anabaptism"@en .

aat:300264303 a skos:Concept ;
    skos:definition "A declaration of forgiveness of sins. In Christianity it refers specifically to the formal remission of sin imparted by a priest or minister either in private after confession or as part of the liturgy in public worship. In Catholicism it is part of the sacrament of penance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absolution"@en .

aat:300264304 a skos:Concept ;
    skos:definition "The idea of survival of a person in some form after physical death. This notion is present in a wide variety of forms in different religions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "afterlife"@en .

aat:300264305 a skos:Concept ;
    skos:definition "Refers to the principle of respect for all life and the practice of non-injury to all living beings; it is found in Buddhism, some Hindu sects, and especially Jainism. Ahimsa is based on the belief that all living creatures are sacred and that violence has negative effects on those who commit it, for example, harming a living thing may result in an unfavorable reincarnation. The term comes from the Sanskrit meaning 'not-harming.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ahimsa"@en .

aat:300264306 a skos:Concept ;
    skos:definition "Refers to an Islamic religious movement founded in India in 1889 by Mirza Ghulam Ahmad (ca. 1839-1908). Ghulam Ahmad claimed to be the Messiah Mahdi prophesied in the Koran, the Christian Messiah, an incarnation of the Hindu god Krishna, and a reappearance of Muhammad. In 1914 the sect split into two very separate branches, the Qadiyani and Lahori. Ahmadiyya is rejected by orthodox Muslims because Ghulam Ahmad's claim to be a prophet following Muhammad cannot coexist with the traditional belief that Muhammad was the last manifestation of God. Other unorthodox beliefs are that Jesus feigned death and actually escaped to India, where he died at the age of 120, and that the concept of jihad (holy war) can be reinterpreted as a peaceful instead of violent battle against unbelievers. After many years of demonstrations against the sect, its followers were declared heretical in 1974 and were officially banned from the orthodox Islamic community. The movement is noted for its missionary zeal and is active in Asia, Africa, and Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ahmadiyya"@en .

aat:300264307 a skos:Concept ;
    skos:definition "Refers to one of two branches of the modern Islamic movement of Ahmadiyya. This branch maintains the Ahmadiyya belief that Ghulam Ahmad was a prophet, considered heretical by mainstream Islam. Believers in this sect live chiefly in Pakistan with other communities found in India and West Africa and to some extent in Great Britain, Europe, and the United States. The Qādī are a highly organized community with a considerable financial base and they are zealous missionaries, proselytizing Ahmadiyya as the one true Islam. After the establishment of Pakistan in 1947, the sect officially relocated from Qadian, birthplace of the founder, to Rabwah, Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qādī"@en .

aat:300264308 a skos:Concept ;
    skos:definition "Refers to one of two branches of the modern Islamic movement of Ahmadiyya. This branch regards Ahmadiyya's founder, Ghulam Ahmad, as a reformer rather than as a prophet and thus stays closer to mainstream Islam. The Lahori, like the Qadianis, are known for their preaching although they are more concerned in gaining converts to Islam in general than to their particular sect. They are also active in liberalizing Islam and in English- and Urdu-language publishing. The Lahori were led by Mawlana Muhammad Ali from its inception in 1914 until his death in 1951. The sect, which has spread widely, established the Woking mosque as it center in the United Kingdom; its main center is in Lahore, Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lahori"@en .

aat:300264309 a skos:Concept ;
    skos:definition "A heterodox sect of world-renouncers founded by Makkhali Gosala, a contemporary and opponent of the Buddha (5th century BCE). Gosala was the itinerant companion of the Jain leader Mahāvīra for six years before they parted after a disagreement. Jainism and Ajivika differ in belief although they share similar practices: initiation is by tearing out one's hair and a lifestyle of extreme austerity, involving nakedness, penance, and ordeals, is required. Ajivikas believed that life was governed by fate and denied the existence of free will. The sect also believed that each soul went through a process of reincarnation lasting billions of years, experiencing all possible life forms until it attained perfection and release. The Ajivikas were an important sect at the time of the Buddha and continued as so for hundreds of years. By the Middle Ages, however, it had disappeared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ajivika"@en .

aat:300264310 a skos:Concept ;
    skos:definition "A fundamental concept of Australian aboriginal religion that refers to a mythological period of time before living memory when the world was shaped and humanized by the actions of mythic ancestral beings. Some of these beings were in human or animal (totemic) form while others changed their form. They were responsible for creating the different types of plants and animals, including humans, as well as for establishing local social order and laws to live by. In aboriginal belief, these ancestors are spiritually as much alive today as they ever were. As a belief system, the Dreaming includes totemism: man is regarded as part of nature, not fundamentally different from his mythic ancestors or from animals, all of which share a common life force. This connection is often made visible through the use of totem figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dreaming, the"@en .

aat:300264311 a skos:Concept ;
    skos:definition "Refers to clergymen in the Anglican Church responsible for assisting diocesan bishops in ceremonial functions and administrative work. Duties typically include general supervision of parish clergy and attention to matters of church buildings and other property. Archdeacons are styled as 'Venerable.' The office formerly also existed in the Roman Catholic and Eastern Orthodox Churches; in the Roman Catholic Church the role has been displaced by that of Vicar-General."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archdeacons"@en .

aat:300264312 a skos:Concept ;
    skos:definition "Refers to the doctrines of the Alexandrian priest Arius (ca. 250-ca. 336), which denied that Jesus was of the same substance as God and stated instead that he was only the highest of created beings. As such, the Son was not co-equal or co-eternal with the Father. According to the Arians, Jesus was created- not begotten- by God and he achieved his divinity through his perfect obedience to God. Arius' doctrine was condemned as heretical at a synod in Alexandria in 321 and definitively at the Council of Nicaea in 325. Arianism maintained a foothold in many Germanic nations. The Arian controversy was revived at different times and was eventually superseded by Unitarianism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arianism"@en .

aat:300264314 a skos:Concept ;
    skos:definition "Having a convex curved front; the term is used particularly with reference to case furniture and to buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowfront"@en .

aat:300264315 a skos:Concept ;
    skos:definition "In mechanical engineering, the load at which a solid material that is being stretched begins to flow, or change shape permanently, divided by its original cross-sectional area; or the amount of stress in a solid at the onset of permanent deformation. Britannica Online."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yield strength"@en .

aat:300264317 a skos:Concept ;
    skos:definition "Pieces of blotting paper in various sizes and formats, including individual sheets, gatherings of sheets, and large sheets inserted or built into desk pads to protect desk tops from ink stains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blotters"@en .

aat:300264318 a skos:Concept ;
    skos:definition "Blotters bearing advertisements. Some, advertising mainly school supplies, were issued to school children in France from the late 19th century up until the 1960s. In mid-20th century, Esquire Magazine was advertised by blotters featuring movie star pin-up drawings and photos. Customized advertising blotters are still produced today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising blotters"@en .

aat:300264319 a skos:Concept ;
    skos:definition "Refers to a system of theology based on the doctrine of the Dutch Reformed theologian Jacobus Arminius (1560-1609). Arminius and his followers opposed the Calvinist doctrine of absolute predestination and instead believed that man's free will and God's sovereignty are compatible. The beliefs of Arminianism were the subject of fierce controversy but were ultimately widely influential. Arminianism was especially influential on English theologians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arminianism"@en .

aat:300264320 a skos:Concept ;
    skos:definition "Refers to a Hindu sect and reform movement founded by the brahman Dayananda Sarasvati in Bombay in 1875. Followers, striving for a return to the original purity of Hinduism found in the Vedas, are against image-worship, child-marriage, polygamy and meaningless ritual. Dayananda's book 'Vedabhashya' contains his interpretations of the Vedas, the earliest Hindu scriptures. Arya Samaj promotes a moral vision of kindness and goodwill to all. Arya Samaj, now a worldwide organization, is also opposed to the traditional Hindu caste system and works to remove religious and social injustices. Arya Samaj followers also introduced the novel idea of converting to Hinduism people of other faiths. In 1893 there was a split between conservative and liberal followers who disagreed on whether to advocate traditional or modern forms of education and on whether to advocate vegetarianism or freedom of diet. The movement became nationalistic and was in conflict with Sikhs and Muslims, especially in the Punjab around the time of the partition of India and Pakistan in 1947."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arya Samaj"@en .

aat:300264321 a skos:Concept ;
    skos:definition "The act or process of rising from the earthly to the heavenly sphere. One example is Christ's ascension witnessed by the apostles forty days after his resurrection. Another prime example is the ascent of the Prophet Muhammad to heaven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ascension"@en .

aat:300264322 a skos:Concept ;
    skos:definition "Refers to the practice of self-control and self-denial as an act of religious devotion and a means of achieving greater spiritual awareness; it is found in different forms and to different extents in all religions. Ascetic practices include fasting, a solitary life, meditation, celibacy, the renunciation of possessions, and the mortification of flesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asceticism"@en .

aat:300264323 a skos:Concept ;
    skos:definition "Complexes for Indian religious communities whose members focus on religious study and meditation and lead lives of austere self-discipline. Such communities or retreats are usually secluded and center around a Hindu philosopher or religious teacher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ashrams"@en .

aat:300264324 a skos:Concept ;
    skos:definition "A Christian renewal movement that emphasizes the descent of the Holy Spirit on the apostles at the first Christian Pentecost. The modern Pentecostal movement arose in the United States in 1901 with Charles Parham who linked baptism with speaking in tongues. The reappearance of prophecy and healing are also part of Pentacostalism. Pentecostal churches are characterized by their various forms of participatory and informal worship and by their literal interpretation of the Bible. The movement probably appeals to impoverished and less-educated people in part because there is a general emphasis on spiritual experience rather than intellectual reflection. Missionary work is typically a high priority but the formation of a representative body of Pentecostals is usually opposed just as is the ecumenical movement. Since the 1960s Pentacostalism has appeared within the Roman Catholic, Protestant, and Greek Orthodox churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pentacostalism"@en .

aat:300264325 a skos:Concept ;
    skos:definition "Christian Pentecostal denomination formed in Canada and the United States in the early 20th century out of previously independent Pentecostal churches. The Assemblies of God are in the Baptist tradition and specifically believe that speaking in tongues is evidence of baptism by the Holy Spirit. The denomination promotes missionary work all over the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assemblies of God"@en .

aat:300264326 a skos:Concept ;
    skos:definition "Christian ceremonies or sacraments involving of the consecration of bread and wine by the minister or priest and its distribution to the worshippers. The term 'eucharist' derives from the Greek 'eucharistia' meaning 'thanksgiving.' It is the central act of worship for most Christian denominations, commemorating the Biblical story of the Last Supper, when Jesus referred to the wine and bread as his blood and body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eucharists"@en .

aat:300264327 a skos:Concept ;
    skos:definition "Utensil used to protect the Eucharistic bread from disturbance. It is usually made of gilded silver or gold, and in the Roman church is a rare item used to hold the host in place on the paten in outdoor masses, having the shape of two slightly raised crossed bars or crucifix, sometimes within a raised disk; formerly used in the papal liturgy, when it was made of gold and in the shape of a star within a disk, raised slightly and designed to protect the host from being touched by the veils or otherwise disturbed. In the Eastern church, it is still used to protect the sacred bread from being touched by the covering veils: in this context, the asterisk consists of two curved gold or silver bands, significantly raised, and crossing each other at right angles to thus form a double arch and star-shape. The asterisk is usually surmounted by a cross, and often has a tiny star suspended from the central junction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asterisks"@en .

aat:300264328 a skos:Concept ;
    skos:definition "Postcards bearing a picture, a stamp bearing the same picture or one similar in image content, and usually a postmark related in some way to the picture. They are made and sold as commemoratives or collectors' items, or created by collectors themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maximum cards"@en .

aat:300264330 a skos:Concept ;
    skos:definition "Notebooks of usually ruled pages used by school children for the writing or drawing of exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exercise books"@en .

aat:300264331 a skos:Concept ;
    skos:definition "The goods for men sold at a haberdasher's shop or store department, such as shirts, ties, socks, belts, hats, gloves. and other accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haberdasheries"@en .

aat:300264332 a skos:Concept ;
    skos:definition "Dealers in small items of men's wear, such as shirts, and men's dress accessories such as gloves, ties, socks, hats, canes, and belts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haberdashers"@en .

aat:300264333 a skos:Concept ;
    skos:definition "The addition of carbon dioxide or a carboxyl group into an organic molecule or compound, thus forming carboxylic acid or carboxylate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carboxylation"@en .

aat:300264334 a skos:Concept ;
    skos:definition "Refers to the system of solar monotheism in ancient Egypt, particularly during the reign of the pharaoh Akhenaton (Amenophis IV) in the 14th century BCE. Aten (or Aton), the Egyptian word for the sun disc, was depicted as a round solar disc with rays that end in hands. Aten was originally an aspect of the sun god Re but had begun to be worshipped in its own right during the reign of Akenaton's two predecessors. Akhenaton believed that Aten was the only deity worth worshipping and he presecuted other deities such as the prominent Amun. Akhenaton was considered the sole intermediary between Aten and the world. An interest in art flourished during this time, and the resulting painting and sculpture is more naturalistic than earlier Egyptian art. Follows of Atenism worshipped the actual sun as a giver of life, beauty, and love through its light and warmth. Atenism was disruptive among the ruling classes and had little impact on the beliefs of the common people; the new religion collapsed shortly after Akhenaton's death and the old gods were reinstated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Atenism"@en .

aat:300264335 a skos:Concept ;
    skos:definition "In ancient Roman religion, the signs of the gods that were inscribed in nature and meant to be deciphered. Auspicia were seen as affirmative or negative answers to proposed courses of action. Auspicia often came from the sky as thunder, lightning, and different kinds of birds although there were other kinds as well. Public auspicia were taken by magistrates or augurs in the sacred space of the templum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "auspicia"@en .

aat:300264336 a skos:Concept ;
    skos:definition "Refers to the descent to earth of a Hindu deity in a visible form. The word comes from the Sanskrit meaning 'descent.' The concept comes from the tradition associated with the deity Vishnu who periodically appeared on earth in human or animal form in order to save it from severe danger or destruction. Vishnu's most famous manifestations have been as Krishna and Rama. The deity is expected to return in the last of his forms to destroy and subsequently recreate the world at a time when it is completely depraved. In more recent times the concept has been challenged by reformers, particularly in regards to manifestations in animal forms. At the same time, others have put forward the idea that humans, even non-Hindus such as Jesus or Muhammad, can become avataras by a divine infilling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avatara"@en .

aat:300264337 a skos:Concept ;
    skos:definition "A religion that arose out of the Persian Islamic sect Babi in the 1860s, founded by Bahaullah who claimed to be the prophet foretold by Ali Mohammed Shirazi, the founder of the Babi sect. Bahaism emphasizes both social goals and spritual truths: the oneness of God, the unity of all faiths. Worship consists of daily prayers and scripture reading; Bahai houses of worship have proliferated throughout the world, especially in the Third World, and are typically centered around a school, hospital, orphanage, or similar institution. The governing body, called the Universal House of Justice, meets every five years and is based in Haifa, Israel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bahaism"@en .

aat:300264338 a skos:Concept ;
    skos:definition "In Tibetan Buddhism, the intermediate state between death and rebirth. Bardo, which can last up to 49 days, follows a vision of a beam of clear light by the dying person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bardo"@en .

aat:300264340 a skos:Concept ;
    skos:definition "An eclectic Islamic dervish order that originated in the 12th century with an Anatolian dervish named Hadjdji Bektash, about whom little is known. It was given definitive form in the 16th century in Anatolia (Turkey) by Bālim Sulṭān. While originally a Sufi order within Orthodox Sunnite Islam, during this period it became more syncretic and adopted tenets of the Shi'a sect. Aspects of Christianity such as confession, absolution and initiation practices were also incorporated as a result of contact with Christians. Bektashi is Shi'a in that it recognizes the twelve imāms (spiritual leaders) and venerates Ali but it is different from most other Muslim orders in that it regards traditional Islamic rituals as hypocrisy and, like many Sufi orders, is lax about observing daily Muslim laws. Bektashi allows women to take part in rituals without wearing a veil. Bektashi mystical writings are an important contribution to Sufi poetry. Through its connection with the Janissaries, an elite Ottoman military corp recruited from Christian areas, Bektashi maintained political importance from the 15th century until shortly after 1826 when the Janissaries were disbanded. The Bektashi order was dissolved in Turkey in 1925 along with all other Sufi orders but it survived in Albania until religion was banned there in 1967. It is still found in some communities in Turkey, Albanian regions of the Balkans, and the United States. Followers wear white caps with 4 or 12 folds, the 4 representing the 4 gates of Islam and the 12 representing the 12 imāms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bektashi"@en .

aat:300264341 a skos:Concept ;
    skos:definition "Photographs taken as or subsequently used as documentary evidence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary photographs"@en .

aat:300264342 a skos:Concept ;
    skos:definition "In the context of ancient Roman architecture, this term usually refers to passageways that allowed for closure at either end. Originally these structures functioned as bridges or as crossings of the pomerium. The term was later applied to gateways and over time post-and-lintel doors were replaced by arches. Later jani were often vaulted as well. There were several noteworthy jani in Rome, most notably the Janus Geminus, the most important shrine of Janus in the city. The closed gates of the Janus Geminus signaled that Rome was at war and open gates meant that it was at peace. It is not known if all jani were considered sacred in some sense but the term certainly has some religious connotation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jani"@en .

aat:300264343 a skos:Concept ;
    skos:definition "Occasions of the passing of a meteoroid through the Earth's atmosphere, creatng a fiery streak or ball in the sky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteors"@en .

aat:300264344 a skos:Concept ;
    skos:definition "Large meteors in which the meteoroid explodes as it passes through the Earth's atmosphere, creatng the effect of a brilliant ball of fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolides"@en .

aat:300264346 a skos:Concept ;
    skos:definition "Ornamental chains, usually of polished metal with various badges, medals or other symbols attached, worn around the neck and generally long enough to rest upon the chest. They are worn by officials such as mayors as insignia of office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chains of office"@en .

aat:300264347 a skos:Concept ;
    skos:definition "Critical concept relating to the tendency of thinkers, artists, architects, and writers to rebel against the perceived theories and practices of modernity and Modernism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anti-modernism"@en .

aat:300264348 a skos:Concept ;
    skos:definition "Generally, any item created by soldiers, prisoners of war, or civilians from any kind of material, as long as it and they are associated in time or place with armed conflict or its consequences. Specifically, objets of metal, cloth, bone, or wood made as remembrances either during or after World War I or World War II."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trench art"@en .

aat:300264349 a skos:Concept ;
    skos:definition "Arches, typically monumental, that have two intersecting passageways and four façades. They are sometimes placed at crossroads and, in the context of ancient Roman architecture, were mainly popular in Africa and the eastern parts of the empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadrifrontal arches"@en .

aat:300264350 a skos:Concept ;
    skos:definition "Women police officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police women"@en .

aat:300264351 a skos:Concept ;
    skos:definition "Male police officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "policemen"@en .

aat:300264353 a skos:Concept ;
    skos:definition "Refers to small figures, animals, and other small details added to enliven a painting or drawing of a landscape or architectural composition. Staffage was often painted by specialist artists, for example, in the northern Netherlands in the 17th century. The term may also refer to painted, gilded, or other small accents or embellishments added to decorate porcelain, furniture or other decorative arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staffage"@en .

aat:300264354 a skos:Concept ;
    skos:definition "Books of blank pages, usually ruled, used for taking notes, especially by pupils and students for taking class notes or writing or drawing exercises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notebooks"@en .

aat:300264355 a skos:Concept ;
    skos:definition "Refers to the performing art characterized by movement, gesture, facial expressions, speaking, and intonation, which are used to create a fictional character for the stage, motion pictures, or television. The art of acting is not mimicry, exhibitionism, or imitation, but is marked by the skill to react to imaginary stimuli, a refined sensibility, intelligence, and an ability to convey the intent and feelings of a character to the audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acting"@en .

aat:300264356 a skos:Concept ;
    skos:definition "In Hinduism, loving and adoring devotion to God or to one's chosen manifestation of the divine that leads to a close personal relationship with God. By surrendering to God, one can receive grace, however low one's station. In most religious texts of popular Hinduism, bhakti is recommended as the most effective path to the divine. This concept is behind some of the world's most moving theistic poetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhakti"@en .

aat:300264357 a skos:Concept ;
    skos:definition "Refers to Buddhist, particularly Tibetan, paintings portraying the endless process of birth, death, and rebirth (samsara) as a wheel. The many pictures on the wheel represent the conditions of samsara as well as the moral and mental factors that cause an individual to remain within samsara. The wheel is clutched by a demon monster, symbolizing death and impermanence. Bhavacakras are usually found on tankas or painted in the doorways of Tibetan temples. The earliest surviving example is a 6th-century fresco at Ajanta. The drawing of the bhavacakra was originally developed, supposedly by the Buddha himself, as a pedagogic device that could be used to teach the non-literate about Buddhist truths. The term, which is Sanskrit, translates to the 'wheel of existence.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhavacakras"@en .

aat:300264358 a skos:Concept ;
    skos:definition "Ceremonies used in Indian religions, particularly by Sikhs. In the Sikh tradition, bhogs are used at the ceremonial end of worship and other important occasions, especially at the end of complete readings of the 'Guru Granth Shahib.' The term, which literally means 'pleasure,' symbolizes the enjoyment of faithful worship and this feeling is often given material form as special food that is distributed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhogs"@en .

aat:300264359 a skos:Concept ;
    skos:definition "An irreverent or impious act, attitude, or utterance regarding something considered inviolable or sacrosanct, particularly something concerning God."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blasphemy"@en .

aat:300264360 a skos:Concept ;
    skos:definition "Superhuman beings of infinite wisdom and compassion; Buddhist saints who, having only one birth to undergo before attaining Nirvana, consent to be reborn for the sake of suffering mankind. In Mahayana Buddhism, the spiritual ideal. In Theravada Buddhism, the term is exclusively used to identify historical Buddhas in their previous lives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodhisattvas"@en .

aat:300264361 a skos:Concept ;
    skos:definition "A Hindu-oriented movement that arose in the 1930s in Hyderabad out of the vivid religious experiences of a merchant named Dada Lekhraj. Lekhraj, using the new name of Prajapita Brahma, encouraged the movement's leadership to pass to female followers, where it still remains. In this millennial movement, the traditional roles of husbands and wives have been reversed. The Hindu belief in the possibility of escape from samsara is rejected in favor of a belief in a golden age that will follow our present age of decline, ending in a nuclear catastrophe. Only purified souls will continue to exist in this golden age and these souls will live as deities in a state of complete happiness. Followers recommend a lifestyle of vegetarianism, abstinence from alcohol and cigarettes, and celibacy with a large emphasis placed on meditation and yoga as ways to attain mental union with God. Their ideas are circulated in the form of messages or 'murlis' that are delivered daily at Brahma Kumari centers throughout the world. Followers have recently become active in the United Nations, for instance they inspired the Global Co-operation Movement. Current headquarters are located at Mount Abu in Rajasthan, India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brahma Kumaris"@en .

aat:300264362 a skos:Concept ;
    skos:definition "Acts that engage with cognitive processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mental activities"@en .

aat:300264363 a skos:Concept ;
    skos:definition "Refers to the act or process of serious and sustained mental reflection or contemplation, often as a private devotional practice. Meditation is regarded as conducive to increased spiritual awareness or somatic calm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meditation"@en .

aat:300264364 a skos:Concept ;
    skos:definition "Buddhist doctrinal concept associated with meditation. There are two types: mind-development (citta-bhāvanā), which is calm meditation leading to tranquility, and insight-development (vipassana-bhāvanā), which is meditation leading to increased spiritual insight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhāvanā"@en .

aat:300264365 a skos:Concept ;
    skos:definition "The cycle of death and rebirth experienced by all unawakened beingsover potentially infinite eons consisting often of six destinies: (1) divinity, (2) demigod, (3) human, (4) animal, (5) ghost, and (6) hell dweller in Buddhism, Hinduism and Jainism. Although debated, the concept is probably of non-Vedic or heterodox origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samsara"@en .

aat:300264366 a skos:Concept ;
    skos:definition "The systems of physical and breathing exercises, typically combined with meditation, practiced as an activity or discipline for mental and physical health benefits. For the orthodox system of Indian philosophy, use \"Yoga (philosophy).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yoga"@en .

aat:300264367 a skos:Concept ;
    skos:definition "A 19th-century Hindu reform movement that has its roots in the Hindu apologist and reformer Rammohun Roy (1772-1833) who was impressed by Western achievements but believed that Indian spirituality was greater. The theistic movement, influenced by Islam, Christianity, and modern science, sought a return to the purity of Hindu worship through a rejection of idol-worship, an emphasis on monotheism, and a reform of Hindu social practices. Roy's most important reform was to convince the British that sati, the practice of widow burning, was not part of original dharma and should be banned. The movement continued, with much division, into the 20th century, but quickly lost members and influence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brahmo Samaj"@en .

aat:300264368 a skos:Concept ;
    skos:definition "Refers to the philosophical and theological ideas and doctrines derived from the work of Augustine (354-430), bishop of Hippo, and associated with the Augustinian orders. The intellectual tradition of Augustinianism has been influential since the Middle Ages, when it developed. Augustine offered an optimistic ontology and an escape from skepticism. He also formulated a cosmic theory to account for the plurality of form in the world and to reconcile it with the uniqueness of God's creative act. Augustine also described the ultimate goal of human life as a life of beatitude combined with ethical-political concern. Primacy of faith, knowledge of the soul, divine illumination, and grace are all essential aspects of Augustinianism. Augustine believed that truth resided in man's soul and it was this truth alone that instructs man. This truth, the greatest proof of God's existence, confers joy and happiness. Augustine's speculation on the Trinity and predestination were also highly influential."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Augustinianism"@en .

aat:300264369 a skos:Concept ;
    skos:definition "An atheistic religion established in the 1970s by Claude Vorilhon, known as Raël, who is held by his followers to be a prophet along with Buddha, Mohammed, Moses, and Jesus Christ. Among its basic tenets are that life on Earth was created through genetic engineering by extra-terrestrials and that life may be continued after death through cloning, citing as proof an interpretation of certain scientific material, the Bible, and other religious texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raelianism"@en .

aat:300264370 a skos:Concept ;
    skos:definition "Refers to a religious order following the Rule of St. Augustine that was founded by the medieval mystic St. Bridget of Sweden (died 1373). After the death of her husband, Bridget dedicated her life to prayer and experienced visions, one of which was to found the Order of the Most Holy Savior. Shortly after Bridget's death, her daughter, St. Catherine of Sweden, became the first abbess of the original monastery in Vadstena, Sweden. Other monasteries followed, each with no more than 60 nuns. Attached to each was a parallel community of monks who shared the same liturgical life under the governing of the abbess. Brigittine contributions to Scandinavian culture include one of the first printing presses, located at Vadstena Abbey. The order, emphasizing humility, simplicity and contemplation, flourished until the Reformation and was banished from Sweden in 1595. After this time there were no more Brigittine monks but four autonomous houses of nuns survived: one in England, another in Bavaria, and two in Holland. Elisabeth Hesselblad founded a new branch of the old order in 1911 and went on to revive the order by founding houses in Sweden, Italy, England, India, Switzerland, and the United States. Although the order has an ancient history, it is modern in its efforts regarding monastic revival and ecumenical concerns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brigittine"@en .

aat:300264371 a skos:Concept ;
    skos:definition "Refers to the religion founded by L. Ron Hubbard in the 1950s, based on the principles of Dianetics, which is a form of psychotherapy for ridding the psyche of painful experiences or engrams. It includes a highly structured system of beliefs, including the role of the thetan, which is comparable to the soul or life energy, in the physical universe. It views Jesus Christ as an important teacher, values self-determination, and has the stated goal of building a planet populated by happy, fulfilled people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scientology"@en .

aat:300264372 a skos:Concept ;
    skos:definition "Genre of performing art characterized by the skillful production of musical tones by means of the human voice. Singing requires a physical technique in which the lungs supply air to the larynx, which acts as a reed or vibrator; the chest and head cavities function as amplifiers. The tongue, palate, teeth, and lips articulate and impose consonants and vowels on the amplified sound. In the art of singing, refined skill is required to coordinate these various anatomical mechanisms and their interaction upon one another. Singing is distinct from speaking in the way in which the breath is expended to vibrate the vocal cords and by the control required in the movement and reflexes of the larynx."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "singing"@en .

aat:300264374 a skos:Concept ;
    skos:definition "Refers to districts or provinces ruled by a viceroy, who is a person acting as the representative of their sovereign or king. Viceroyalities are often on frontiers or in provinces distant from the seat of power of the state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viceroyalties"@en .

aat:300264376 a skos:Concept ;
    skos:definition "Japanese ceremonial dances combined with music used in Shinto, Buddhist, and Imperial court rituals and festivals. The dance and music were brought to Japan at an early date from China, Korea, India, and Southeast Asia. These dance and music forms were standardized and systematized by Japanese emperors of the 9th century. The dances are composed of stylized movements cued by the beat of a drum and the overall choreography is based on simple geometric patterns. The masks worn by the dancers are an important element of bugaku. There are two basic dance forms each accompanied by specific music: saho no mai (\"dances of the left\"), accompanied by togaku (derived mainly from Chinese music); and uho samai no mai (\"dances of the right\"), accompanied by komagaku (music imported from Korea). The richly embroidered costumes of the saho no mai dancers are typically red while the costumes of uho samai no mai dancers are usually green or blue. A bugaku program typically starts with a selection performed by the lead dancers of both forms, followed by alternating dances from both repertoires. When the music is performed alone it is called 'gagaku.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bugaku"@en .

aat:300264378 a skos:Concept ;
    skos:definition "Masks worn by performers of bugaku to embellish the ceremonial dances. Bugaku masks range from the abstract to the naturalistic to the fantastic; they sometimes have movable parts and attenuated features. Some of the earliest examples of bugaku masks are housed at the Tamukeyama Shrine, Nara, and date to 1052. Most extant masks date from the mid-Heian period to the Kamakura period (1185-1333). In the 12th century, considered the height of bugaku mask production, master Buddhist sculptors such as Insho, Shamon Gyomyo, and Jokei produced highly refined examples. Bugaku masks can be divided into three groups which loosely correlate with styles of bugaku dance. Performers of hiramai dances, which are slow and quiet, often don't wear masks and if they do they are typically close to human proportions. Dancers of bunomai, which are military dances, wear intensely expressive masks that have elongated faces with features such as flaring nostrils, glaring eyes and bushy eyebrows. Dancers of hashirimai, which are energetic running dances, wear animal or other non-human masks. Bogaku mask forms, like the dances, are also grouped into 'left' and 'right.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bugaku masks"@en .

aat:300264379 a skos:Concept ;
    skos:definition "Genre of traditional Japanese music mainly performed at Imperial court ceremonial occasions. The name is a Japanese pronunciation of the Chinese characters for elegant music (ya yueh). This music was imported from Korea to Japan in the 5th century and it became part of established court tradition by the 8th century. In the 9th century the various forms of North Asian, Chinese, Indian, Southeast Asian, and indigenous Japanese music were organized into two major genres: togaku and komagaku. Togaku, the so-called 'music of the left,' is derived from Chinese and Indian forms while komagaku, the 'music of the right,' contains Southeast Asian and Japanese forms. Performances of gagaku typically include combinations of plucked instruments, wind instruments, drums and a gong. The main drum and flute of the two types differ, and komagaku does not involve stringed instruments. The term kangen refers to purely instrumental performances of gagaku while bugaku ('dance music') refers to the music performed with accompanying ceremonial dance. Some aspects of accompanying Shinto ritual and ancient vocals have remained; most of the solo music for the gagaku instruments has been lost although some notations have survived. Surviving gagaku music provides valuable information about traditional national musical forms. Gagaku closely resembles the secular music of China during the Tang dynasty and thus sheds light on the music of this ancient period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gagaku"@en .

aat:300264380 a skos:Concept ;
    skos:definition "Refers to the dimensions of an object that are visible to the eye, as distinct from the actual size of the object. It is typically used to describe the dimensions of the portion of a two-dimensional work of art that are visible within the window of a frame or mat, not including those parts of the work that are hidden by the rabbet of the frame or the area of the mat. It may also be used to describe the frame or mat itself, referring to the size of the opening through which a work of art would be seen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sight size"@en .

aat:300264381 a skos:Concept ;
    skos:definition "Refers to a technique of drawing or sculpting in which the subject is directly transferred to the image or replica by comparing the measurements of the two, often with the aid of plumb-lines and calipers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sight size"@en .

aat:300264383 a skos:Concept ;
    skos:definition "Refers to the process or branch of fine art concerned with creating sculpture, which are three-dimensional works. It refers particularly to carving or engraving a hard material, or with molding or casting a malleable material, so as to produce designs or figures in relief, in intaglio, or in the round. It is typically used to refer to the production of large or medium-sized objects in stone, clay, or bronze. The production of small objects in bronze or stone is typically referred to by a specific term, such as \"stone carving\" or \"die sinking.\" The production of sculpture in wood or ivory is typically referred to as \"carving,\" even though the finished work in these materials may be called \"sculpture (visual work).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpting"@en .

aat:300264384 a skos:Concept ;
    skos:definition "Refers to a key concept with multiple meanings in Hinduism, Buddhism, and Jainism. In Hinduism, dharma is the religious and moral law governing and enabling society and individual conduct. It is found in the early religious manuals called the dharmasutras and has been expanded into larger compilations of law called the dharmashastra. Dharma in Buddhism retains the Hindu sense of cosmic law and order but it also came to be applied to the teachings of the Buddha who is seen as a manifestation of the universal truth that is dharma. Thus, dharma is the practice of this truth in Buddhism. The triratna (\"three jewels\") is a fundamental aspect of Buddhism and consists of the Buddha, dharma, and the sangha (community of believers). In the context of Buddhist metaphysics, the term in the plural (dharmas) refers to the interrelated elements that make up the empirical world. In addition to being commonly understood as moral virtue in Jaina philosophy, dharma also refers to an eternal \"substance\" (dravya) that is the medium that allows living beings to move. It is a meaning unique to Jainism. The term may simply refer to the teachings of the Jinas. For the Jains, dharma has its opposite in adharma which is error and immorality as well as the ability to rest or pause."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dharma"@en .

aat:300264385 a skos:Concept ;
    skos:definition "In Hinduism, liberation from samsara, the cycle of birth, death, and rebirth. This liberation would mean a state of bliss (ananda), freedom from sorrow and higher awareness. It is the fourth and ultimate artha (goal) for Hindus, attained when ignorance, desire, and all attachments are overcome. There are various interpretations of moksha, especially in regard to how it is attained, whether by personal effort, by grace of a personal god, or a combination of the two. In Jainism, moksha lies beyond enlightenment and is freedom from the impediment of karma; enlightenment provides the means for rooting out all remaining karma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moksha"@en .

aat:300264386 a skos:Concept ;
    skos:definition "Hindu concept of the collapse of the three main Hindu gods, Brahma, Vishnu, and Shiva, into a single form with three faces. Some scholars consider the trimurti as a way to reconcile different monotheistic approaches with one another and with the concept of ultimate reality (Brahman) since the trimurti manifests the cosmic functions of the Supreme Being. The trimurti was classically expressed in the poem 'Kumarasambhava' by Kalidasa (ca. 4th-5th century)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimurti"@en .

aat:300264387 a skos:Concept ;
    skos:definition "Depictions and representations on a surface in two dimensions or low relief, or digital, whether the optical counterpart exists in reality or only in imagination. For example, the term may refer to a depiction as distinguished from its support, as when referring to a drawing as distinct from the paper upon which it is drawn. For a representation of an object as opposed to the tangible object itself, as when distinguishing between a photograph or digital image and the art object depicted, use the descriptor \"visual surrogates\" or the UF \"images (visual surrogates).\" For three-dimensional works, use \"objects\" or a more specific term, such as \"sculpture (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "images"@en .

aat:300264388 a skos:Concept ;
    skos:definition "Object genre that includes two-dimensional works. Examples would be in the media of painting, drawing, photography, film, digital formats, bas-relief, or other media. In usage, the term does not necessarily imply that the work is representational, but instead refers to the two dimensionality of the work, including abstract works. However, it excludes purely decorative details; for example, a faux-marble painted, decorative wall panel is not considered a picture. To particularly designate works that represent the visible world, use \"depictions(visual works)\" or \"representation (form of expression).\" In historical usage, \"pictures\" was typically reserved for paintings; in modern usage, use \"paintings (visual works)\" to designate paintings in particular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictures"@en .

aat:300264389 a skos:Concept ;
    skos:definition "Refers to the offices, reigns, or dominions of caliphs. The caliphate, a political-religious state, became a Muslim institution after the death of Muhammad in 632. Through conquest the caliphate grew rapidly for the first few hundred years but ultimately ceased to exist after the defeat of Baghdad by the Mongols in 1258. Even when declining in power, the caliphate remained a symbolic focus of Muslim unity and there have been attempts to revive it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caliphates"@en .

aat:300264390 a skos:Concept ;
    skos:definition "Monastic order founded in 1529 by Matteo da Bascio (1495-1552) as a reform movement. It is an autonomous branch of the Franciscans and prescribes a very strict rule emphasizing austerity and poverty. In seeking to return to the greater simplicity of early Franciscans and their literal observance of the rule of St. Francis of Assisi, Matteo wore the pointed cowl or hood (capuce) of St. Francis and he introduced aspects of the solitary life of the hermit. Despite opposition from established groups of Franciscans and near-suppression when their vicar-general became a Protestant in 1542, the zeal and preaching of the Capuchins made them powerful during the Counter-Reformation as they appealed to common and country people. In 1619 they officially became an independent order. Matteo and his followers devoted themselves to caring for victims of the plague from the 16th to the 18th century; they are also noted for their missionary and social work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capuchin"@en .

aat:300264391 a skos:Concept ;
    skos:definition "The study of pharaonic Egypt, spanning the period around 4500 BCE to CE 641. Egyptology began when the scholars accompanying Napoleon Bonaparte's invasion of Egypt (1798-1801) published \"Description de l'Égypte\" (1809-1828), which made large quantities of source material about ancient Egypt available to European scholars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptology"@en .

aat:300264392 a skos:Concept ;
    skos:definition "Branch of paleography specializing in the study of certain ancient characters termed \"runes\" and the systems of writing that are based on them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runology"@en .

aat:300264393 a skos:Concept ;
    skos:definition "Those who study and work in the field dealing with the care, reading, and interpretation of ancient documents written on papyrus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papyrologists"@en .

aat:300264394 a skos:Concept ;
    skos:definition "Days of celebration observed by followers of Christianity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian holidays"@en .

aat:300264395 a skos:Concept ;
    skos:definition "Days of celebration observed by followers of Judaism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jewish holidays"@en .

aat:300264396 a skos:Concept ;
    skos:definition "A Christian monastic order founded by St. Romuald (ca. 920-1027) in about 1012 at Camaldoli near Arezzo in Italy. An independent offshoot of the Benedictines, it was begun as part of the monastic reform movement of the 11th and 12th centuries. The order prescribes a combination of the solitary life of a hermit with an austere version of the common life of a monk. Although a part of the Benedictine confederation, the Camaldolese sees itself as rooted in the Desert Fathers and Mothers, which precede both Benedict and Romuald. Beginners live in the monastery and the more proficient live in the hermitage; together they form one unit. This ideal union was not always followed and independent monasteries and hermitages were founded. In 1935 the two branches were reunited. The Congregation of Monte Corona, a Camaldolese reform group, was founded in 1523 and still exists in small numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camaldolese"@en .

aat:300264397 a skos:Concept ;
    skos:definition "Refers to the religious ideas of individuals and groups who were greatly influenced by the reformer John Calvin (1509-64) as well as by 17th-century Calvinist scholars. Calvinism stresses the sovereignty of God over all aspects of life and the Bible as the sole rule of faith. Justification by faith alone is another central concept. Although predestination was not a leading axiom of Calvin's theology, it was heavily emphasized by his early followers, in part to distinguish themselves from followers of Luther. The Helvetic Confession (1566) and the Synod of Dort (1618-19) were important moments in the history of Calvinist theology; the latter affirming the 'five points of Calvinism': total depravity, unconditional election, limited atonement, irresistible grace, and the final perseverance of the saints. By the mid-17th century, Calvinism had spread from France and Holland to England and Scotland where it was espoused by the Puritans and taken to New England. While it has suffered rationalistic attacks, it influenced much church life and there has been a Neo-Calvinist renewal in modern times led by the theologian Karl Barth. As an historical force, Calvinism has had a wide impact on European and Northern American culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calvinism"@en .

aat:300264398 a skos:Concept ;
    skos:definition "Prayers intended to be chanted or sung, used in Christian worship; sources of the prayers are the Bible (other than Psalms) and other certain texts. Examples of these scriptural hymns are the Song of Moses from the Old Testament, the Benedictus from the New Testament, and the Lord's Prayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canticles"@en .

aat:300264400 a skos:Concept ;
    skos:definition "Refers to a Christian festival and feast most often observed on February 2 or forty days after Christmas. It commemorates the Virgin Mary's visit to the Temple in Jerusalem forty days after the birth of Jesus (Luke 2, 22-39). In accordance with Jewish law, Mary was purified and presented her son to God as her firstborn. In the Roman Catholic church the festival is currently called the Presentation of the Lord while the Anglican church calls it the Presentation of Christ in the Temple. Hypapante, the name for the festival in the Greek church, means 'meeting' and refers to the meeting of Jesus with Simeon and Anna in the Temple. The earliest reference to the festival comes from Jerusalem in the late 4th century. It quickly spread to other Eastern cities while it spread more slowly in the West. Justinian I decreed that it be observed on February 2 in 542. The festival was instituted in Rome probably before the time of Pope Sergius I (687-701) and the procession seems to have originated there, perhaps even before the feast itself was accepted. In the Western church it was mainly a celebration of the Virgin Mary (until the 1969 calendar reform) while in the Eastern church it was primarily a celebration of Christ. The name Candlemas comes from the tradition, in place by the mid-5th century, of observing the festival with candles. In the West, this procession with lit candles symbolizes Christ as the light of the world and his entry into the Temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Candlemas"@en .

aat:300264401 a skos:Concept ;
    skos:definition "Temporarily-assembled groups of people selected according to law and sworn to decide upon matters of fact and to declare the truth on the basis of the evidence presented before them in a court of law. Citizens of a nation have the duty to present themselves, when asked, for service on a common jury in the legal jurisdiction of their residence, or to show sufficient reason to be excused."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juries"@en .

aat:300264402 a skos:Concept ;
    skos:definition "Branch of biology dealing with life forms living in the sea and on shore and the features of their environment that affect them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine biology"@en .

aat:300264403 a skos:Concept ;
    skos:definition "Generally, the study of the earth's water. Specifically, the science that studies the occurrence and movement of water on and over the surface of the earth. The main processes with which hydrology is concerned are precipitation, evaporation and transpiration, stream flow, and groundwater flow. Applications include flood control and the supply of water for domestic and industrial purposes, irrigation, and hydroelectric power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrology"@en .

aat:300264404 a skos:Concept ;
    skos:definition "Generally, scientists who study the occurrence and movement of water on and over the surface of the earth. The particular processes with which hydrologists are concerned are precipitation, evaporation and transpiration, stream flow, and groundwater flow. Their work includes flood control, supplying water for domestic and industrial purposes, irrigation, and the production of hydroelectric power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrologists"@en .

aat:300264405 a skos:Concept ;
    skos:definition "People who are experts in the chemical composition of the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geochemists"@en .

aat:300264406 a skos:Concept ;
    skos:definition "Scientists who study the physical forces acting on, and particularly within, the earth. Their work concerns phenomena such as the study of earthquake waves, geomagnetism, gravitational fields, and electrical conductivity using precise quantitative principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geophysicists"@en .

aat:300264407 a skos:Concept ;
    skos:definition "Refers generally to any period of high artistic or cultural development. It refers specifically to the period known for luxury and high artistic development in fin de siècle Europe, most notably in France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belle époque"@en .

aat:300264408 a skos:Concept ;
    skos:definition "Items comprising relatively short lengths of rope or cord, designed to be used in various contexts, including but not limited to the following: to hold a whistle, knife, or other item around the neck of a person, to wear as a symbol of a military citation, to attach something to a costume, to attach a sign or name tag to an item, to fasten something on a ship (particularly rope passing through deadeyes to extend shrouds or stays), or to fire a cannon, sound a whistle, or activate some other system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanyards"@en .

aat:300264410 a skos:Concept ;
    skos:definition "Mathematicians specializing in the properties, relationships, and computation of real numbers, involving chiefly addition, subtraction, multiplication, and division."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arithmeticians"@en .

aat:300264411 a skos:Concept ;
    skos:definition "Mathematicians specializing in the measurement, relationships and properties of points, lines, curves, angles, surfaces, and solid figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geometers"@en .

aat:300264412 a skos:Concept ;
    skos:definition "Mathematicians who specialize in the relations holding among the sides and angles of triangles and among closely related magnitudes, especially with methods of deducing from given parts other required parts. Refers particularly to those engaged in trigonometric surveys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trigonometers"@en .

aat:300264413 a skos:Concept ;
    skos:definition "During Holy Week, the Thursday before Easter that commemorates Jesus Christ's institution of the eucharist at the Last Supper. Maundy Thursday services typically include the consecration of the holy oils for the coming year and a ceremony in which the feet of 12 men are washed in remembrance of Christ's washing the feet of his disciples. The custom in England is for the British sovereign to distribute alms to twelve deserving impoverished people in a different church every year. The variant name 'Green Thursday' refers to the early practice of giving penitents a green branch after completing their Lenten penance and the variant name 'Sheer Thursday' (also 'Clean Thursday') refers to the ceremonial washing of altars that takes place on this day. The name 'Maundy Thursday' comes from a Latin antiphon sung on this feast day in Roman Catholic churches: \"Mandatum novum do vobis\" (\"a new commandment I give to you\"; John 13:34)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maundy Thursday"@en .

aat:300264414 a skos:Concept ;
    skos:definition "Refers to those versed in the science of sound and sound waves. Refers also to those who design, make, or repair sound devices, acoustic materials, and acoustical components of structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acousticians"@en .

aat:300264415 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbere"@en .

aat:300264416 a skos:Concept ;
    skos:definition "Originally refers to puritan and ascetic separatists who followed the teachings of the Roman bishop Novatian in the 3rd century. In the Middle Ages the term came to refer to a highly organized sect that rejected sacraments and believed in a neo-Manichaean dualism in which good and evil were separate spheres and the material world was evil. Cathars led rigorously ascetic and celibate lives. The faithful were divided into two groups: the 'perfect' and the 'believers.' The perfect were set apart from the latter group by a ceremony of initiation called the 'consolamentum.' The sect was seen as a serious threat to the Roman Catholic Church in the 13th and 14th centuries, particularly in southern France. The Cathars declined in the 14th century due to repression by the Inquisition, disagreement amongst followers regarding dualism, and the newly appealing piety and devotion of the Franciscans. Although the term is sometimes used interchangeably with 'Albigenses,' this is actually a branch of the Catharistic movement. The Cathars was related to the Bogomils and Paulicans, other medieval sects that had similar beliefs in dualism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cathari"@en .

aat:300264417 a skos:Concept ;
    skos:definition "A Roman Catholic religious order that originated in the 12th century from hermits on Mount Carmel who sought the way of life of the prophet Elijah. When the Crusades failed, the Carmelites migrated to Europe where they flourished as mendicant friars. Solitude, abstinence, and prayer are strictly practiced. In 1452 the friars were joined by Carmelite nuns (Sisters of the Blessed Virgin Mary of Mt. Carmel), the Carmelite Second Order. The Carmelites do not have a founding figure as do many orders, but they consider Elijah and Mary, both central to Carmelite consciousness, as their founders. Important reform figures are St. Teresa of Avila, reformer of the female order in 1562, and St. John of the Cross, who similarly reformed the male order later in the century. The reformed branch became its own order in 1593 and is referred to as the Discalced Carmelites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carmelite"@en .

aat:300264418 a skos:Concept ;
    skos:definition "Carved wooden staffs of the Akan people of Africa. They are surmounted by carved finials of various figures, often covered in gold leaf, representing at least one proverbial saying. Held and displayed by the chief counselors of paramount chiefs at public events, they serve as the badges of office of those counselors and their proverbial subject matter refers to the continuity and political dominance of chief and state, the responsibilities of the chief, and the appropriate and wise behavior of the chief's subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linguist staffs"@en .

aat:300264419 a skos:Concept ;
    skos:definition "Reformed branch of the Carmelite order that became its own order in 1593. Perceived laxity and abuses within the Carmelite order led to the reforms of St. Teresa of Avila and later of St. John of the Cross. The term 'discalced' refers to the practice of the reformers of wearing sandals instead of shoes and stockings. Discalced Carmelites focus on parochial and missionary work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Discalced Carmelite"@en .

aat:300264420 a skos:Concept ;
    skos:definition "Gold disks of the Akan people of Africa, often elaborately worked, usually worn as pectoral pendants, but known to be worn occasionally attached to caps or the hair or tied to the ankle. Their original function, especially among the Asante, was to mark the wearer as the \"akra\" or \"soul washer\" of a king, responsible for cleansing the king's soul in ceremonies of purification or soul renewal. Later on akrafokonmu became multifunctional, worn by kings, chiefs, sword bearers, heralds, sub-chiefs, war leaders, junior officials, and young girls at puberty ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "akrafokonmu"@en .

aat:300264421 a skos:Concept ;
    skos:definition "Heavy, roughly rounded, ovular and oblong stones found at neolithic sites in the Sahara Desert, having a groove across the middle. From depictions in rock carvings, they are known to have served as anchors or drags for tethering ropes for domestic animals such as cattle, or for rope traps and snares for wild animals; the rope was wound or tied around the stone where the groove was and the weight of the stone kept the animal from running away."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tethering stones"@en .

aat:300264422 a skos:Concept ;
    skos:definition "Dualistic Christian sect founded in Armenia and eastern Byzantine Empire in the mid-7th century by an Armenian named Constantine. Other than a brief period when it found favor with the iconoclast emperors of the 8th and 9th centuries, the sect was persecuted and it consequently allied itself with Muslims. The sect was particularly influenced by the dualistic beliefs of Marcionism and of Manichaeism, which recognize an evil God and a good God with the former being the creator and ruler of this world and the latter of the world to come. While Paulicians honored the gospel according to St. Luke and the letters of St. Paul, they rejected the Old Testament, the letters of St. Peter, and the sacraments, worship, and hierarchy of the established church. The Paulicians influenced the 10th-century neo-Manichaean Bogomils. Small Paulician communities were found in the early 19th century in Russian-occupied areas of Armenia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paulician"@en .

aat:300264423 a skos:Concept ;
    skos:definition "Dualistic Christian sect that thrived in Bulgaria from the tenth to the seventeenth century and more widely in the Byzantine Empire in the 11th and 12th centuries. It was founded in Bulgaria in the mid-tenth century by a priest who took the name Bogomil. The sect can be described as a fusion of dualistic, neo-Manichaean doctrines imported from the Paulicians and a local Slavonic movement aimed at reforming the recently established Bulgarian Orthodox Church. The central belief was that humanity and the visible, material world were created by the devil. Bogomils were hostile to most aspects of the Orthodox church as well as to civil authorities. The sect advocated a rigorously ascetic lifestyle, rejecting sex, marriage, possessions, and the eating of meat. Bogomils influenced the later Cathari of Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bogomil"@en .

aat:300264424 a skos:Concept ;
    skos:definition "Refers to an early Christian Gnostic movement that rivaled Catholic Christianity in the second and third centuries. The sect's founder, Marcion (died ca. 160), held the dualistic belief that the God of the Old Testament was not the same as the God of the New Testament and that the Old Testament was not a Christian book. As Christianity and Judaism are not connected in his view, he thought the New Testament should be purified of all Jewish elements. Marcion organized many ascetic communities and compiled the first known canon of scripture. Most Marcionites were absorbed into Manichaeism by the late third century. The term is sometimes used more generally to refer to deliberate or benign neglect of the Old Testament within Christianity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marcionism"@en .

aat:300264425 a skos:Concept ;
    skos:definition "Collective term for the range of artistic decoration and embellishment applied to the human body for purposes of cultural identity, beautification, or self expression. It includes such forms as scarification, tattooing, body piercing and painting, hair styling, and the wearing of jewelry. Distinct from \"body art\" which refers to performance works produced since the 1960s that employ human bodies as the medium of expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body arts"@en .

aat:300264426 a skos:Concept ;
    skos:definition "Culture and style of works created by an African people living in southern Africa who speak or are descendants of those who traditionally spoke the Sesotho sa Leboa or Northern Sotho language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Sotho"@en .

aat:300264427 a skos:Concept ;
    skos:definition "Culture and style of works created by the African people living in southern Africa who speak or who are descendants of those who traditionally spoke the Sesotho or Southern Sotho language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern Sotho"@en .

aat:300264428 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lemba"@en .

aat:300264429 a skos:Concept ;
    skos:definition "Very generally the term covers from late prehistory to the time when Islam became the dominant religion and way of life in those areas of the world where, at various times after the early seventh century CE, a majority of the population or a preponderance of the ruling classes converted to Islam. It covers a wide and varied range of cultures, artistic traditions, and time periods, varying with the different times when Islam came to different regions and influenced and was influenced by different traditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pre-Islamic"@en .

aat:300264430 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Kel Ayr living in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Ewey"@en .

aat:300264431 a skos:Concept ;
    skos:definition "Describes works created by the Berber people of the same name living in Morocco in the area between Rabat and Meknes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zemmour"@en .

aat:300264432 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a western subgroup of the Iwellemmeden living in eastern Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Ataram"@en .

aat:300264433 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Kel Ataram living in eastern Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Tademaket"@en .

aat:300264434 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a western group of the Iwellemmeden living in western Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Dinnik"@en .

aat:300264435 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Shluh subgroup living in the Moroccan High Atlas and the Sahara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ait Atta"@en .

aat:300264436 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Berber living in the High Atlas Mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ait Hadiddou"@en .

aat:300264437 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Gur living in northern Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taneka"@en .

aat:300264438 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Bamana living in Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Somono"@en .

aat:300264439 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, living in a kingdom of Dyula origin in Burkina Fasso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yarse"@en .

aat:300264440 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in central Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beng"@en .

aat:300264441 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Gur living in Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyende"@en .

aat:300264442 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living on the Jos Plateau in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mwaghavul"@en .

aat:300264443 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mupun"@en .

aat:300264444 a skos:Concept ;
    skos:definition "A branch of the medieval Cathars in Southern France; its main center was at Toulouse but another place of activity was Albi, hence its name given by the Council of Tours in 1163. The sect was regarded as a serious threat by the Catholic Church: Pope Innocent III (1198-1216) failed to convert these Christian dualist heretics and Simon de Montfort led a savage Crusade (the Albigensian Crusade) against them until 1218. The Dominican Inquisition also sought to eliminate the sect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albigensian"@en .

aat:300264445 a skos:Concept ;
    skos:definition "A Jewish holiday observed on 6 Sivan (May or June) to commemorate God's giving of the Law to Moses on Mount Sinai. Second of the three Jewish pilgrim festivals, it falls fifty days after the first day of Passover and originally marked the end of the barley harvest and the beginning of the wheat harvest. The traditional agricultural aspect of the festival is reflected in the continuing custom of decorating synagogues with flowers, green plants, and fruits. In the Middle Ages, children first attended Hebrew school on this day; in modern times, confirmation often occurs on Shavuot. Customary readings include the Book of Ruth and the Ten Commandments. Dairy products are traditionally consumed on Shavuot because Song of Songs compares the Torah with milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shavuot"@en .

aat:300264447 a skos:Concept ;
    skos:definition "Small carved wooden or ivory sculptures consisting of a figurine, often a male equestrian or a kneeling woman, and a shallow bowl. The bowl is used to hold the sixteen sacred palm nuts used in Yoruba divination rituals. Such sculptures are works of art commissioned by patrons from the carvers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agere Ifa"@en .

aat:300264448 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in southern central Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndamba"@en .

aat:300264449 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name living in the Upper Omo River Valley in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karo"@en .

aat:300264450 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in northeastern Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anjoaty"@en .

aat:300264451 a skos:Concept ;
    skos:definition "Describes works created by the African Malagasy people of the same name living in eatern Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betsimisaraka"@en .

aat:300264452 a skos:Concept ;
    skos:definition "Describes works created by the African Malagasy people of the same name living in southern Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karembola"@en .

aat:300264453 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in southwestern Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kafa"@en .

aat:300264454 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngbaka-Ma'bo"@en .

aat:300264455 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Luba living in the eastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Luba"@en .

aat:300264456 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Luba"@en .

aat:300264457 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in the Kasai region of southeastern Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Luba"@en .

aat:300264458 a skos:Concept ;
    skos:definition "Architectural styles belonging to Southern African cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern African architectural styles"@en .

aat:300264460 a skos:Concept ;
    skos:definition "Refers to the largest school of Japanese Buddhism. It was founded by Shinran (1173-1262) and organized by Rennyo (1414-1499) and is based on simple yet exclusive devotion to Amida. Shinran, a disciple of Honen, was more radical than his teacher. Shinran believed that since Amida's grace is relevant to a good person, it was even more so to a sinner. Reliance on Amida is all that is needed for liberation. Only one sincere recitation of the 'nembutsu' is needed to be reborn in Amida's Pure Land. The nembutsu is seen as an act of gratitude rather than one of supplicating trust. This and other aspects of Jodo Shinshu (e.g. it is a lay movement with no monks or monasteries) made it extremely popular. The school split into two factions in the 17th century, the Ōtani and Honganji. Both factions remain powerful and popular today and have their main temples in Kyoto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jodo Shinshu"@en .

aat:300264461 a skos:Concept ;
    skos:definition "A school of Jōdo-shū Buddhism founded by Bencho, a student of Honen who built Zendōji as a center for training in nembutsu in his hometown of Kyushu. There are many subdivisions of Chinzei, with Shirahata-ryū being the strongest ongoing group. Its center is at Chion-in but Zōjōji in Tokyo is also of special importance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinzei"@en .

aat:300264462 a skos:Concept ;
    skos:definition "An indigenous Korean religion founded by Ch'oe Suun (1824-1864) as an attempt to directly appeal to the religious consciousness of the Korean people. Chondogyo was a reaction against Christianity and the traditional religions of Korea although it nevertheless contains elements of Confucianism, Taoism, Buddhism, shamanism, and Roman Catholicism. After Suun was executed by the government, his successors Ch'oe Si-hyong and Son Piyong-hi fostered the movement until it grew to become a major Korean religion. The Chondogyo scriptures are the writings of the three founders. The religion views humans as bearers of divinity and as such, humans must treat one another 'as God.' Chondogyo stresses the universality of God and calls for a cooperative kingdom of God on earth based on faith, simplicity, steadfastness, and sincerity. There is no concept of eternal reward because the religion's aim is solely to bring righteousness and peace to the world. There are five recommended practices: chanting of a formula every night at nine o'clock; the use of water as a symbol of purity; attending a Sunday worship service; offering rice to the church on a regular basis; and praying in different ways. Chondogyo had an important role in modernizing Korea after 1894. It also opposed Japanese imperialism after 1919 and did not acquiesce to communism in North Korea after 1945. By the late 20th century, there were approximately 3 million members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ch'ǒndogyo"@en .

aat:300264463 a skos:Concept ;
    skos:definition "Domestic architectural style of the Cape provinces of South Africa, developed mainly in the period from 1652 until the end of the rule of the Dutch East India Company in 1796 and for a generation further, some examples being built as late as 1874. Characteristic elements include front and end gables, steep thatched roofs with a span of about six meters, and thick rubble, clay, or soft-brick walls, plastered and limewashed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cape Dutch"@en .

aat:300264464 a skos:Concept ;
    skos:definition "Describes works created by the Fulbe people living in the Adamawa region of Nigeria and northern Cameroon in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adamawa Fulbe"@en .

aat:300264465 a skos:Concept ;
    skos:definition "Describes works created by the Fulbe people of the same name living in Chad, Niger, Nigeria, Mali, Senegal, and Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bororo"@en .

aat:300264466 a skos:Concept ;
    skos:definition "Refers to the largest denomination and principal body of the Mormon religion. By the late 20th century it had more than 9,700,000 members. Its headquarters are in Salt Lake City, Utah. An important leader of this denomination was Brigham Young (1801-1877), who led the trek to Utah in 1847, founding Salt Lake City."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Church of Jesus Christ of Latter-Day Saints"@en .

aat:300264467 a skos:Concept ;
    skos:definition "Refers to the second largest Mormon denomination. Its headquarters are in Independence, Missouri and it had a membership of more than 200,000 people by the late 20th century. The Community of Christ came out of one of the factions that developed after Joseph Smith's death in 1844. A group of Mormons rejecting Brigham Young's leadership instead claimed that Smith's son was the rightful successor; they did not follow Young to Utah. The leaders of the denomination were descendants of the founder up until 1996. This denomination actually rejects the appellation Mormon because of the association with polygamy. Followers feel that polygamy is not in harmony with the original tenets of the church or with the teachings and practices of Smith. Many of its doctrines are similar to those of other Mormon denominations but the church can be described in general terms as more liberal and more ecumenical. For instance, the Community of Christ allows women to be ordained, rejects the practice of 'blood atonement' called for by Young, and allows the general public to attend its services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Community of Christ"@en .

aat:300264468 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a primarily urban-dwelling subgroup of the Fulbe living in Senegal, Nigeria, Niger, and Cameroon. They tend to form the professional, religious, and administrative elite of the towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toroobe"@en .

aat:300264469 a skos:Concept ;
    skos:definition "Culture or style of a subgroup of the Fulbe African people living in the Futa Toro region of northern Senegal and southern Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tukulor"@en .

aat:300264470 a skos:Concept ;
    skos:definition "Refers to ministers in Eastern churches intermediate in rank between priests and bishops. In the early church such clergy were the bishops of a country district, subject to the authority of a diocesan bishop. Chorepiscopi were only allowed to the minor orders. The office of chorepiscopus was abolished at the Council of Laodicea (between 343 and 381) but such ministers still existed until the 8th century. Today it is used as an honorary title."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chorepiscopi"@en .

aat:300264471 a skos:Concept ;
    skos:definition "A Christian sect founded in Richmond, Virginia in 1848 by John Thomas (1805-71), who had previously been a follower of Thomas and Alexander Campbell. John Thomas wanted to return to the beliefs and practices of the earliest disciples, hence the name meaning 'brothers of Christ.' The name was adopted during the American Civil War to justify the follower's pacifism. The doctrines of the Trinity and of the pre-existence of Christ were rejected by Thomas. Christadelphians believe in the complete accuracy of the Bible. At the center of Christadelphian belief is millennialism. Specifically, it is believed that Christ will come again to establish a theocracy based in Jerusalem. Christadelphians do not agree on whether all people will be resurrected although it is most commonly believed that anyone other than a true believer will go to oblivion. Adult followers must be baptized by immersion. There are no ordained ministers and local congregations are called 'ecclesias.' Christadelphians do not take part in military service, politics, or voting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christadelphian"@en .

aat:300264472 a skos:Concept ;
    skos:definition "Refers to the eastern Slavic people of the same name, living in the modern Republic of Belarus or the earlier country or region called Belarus in eastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belarusian"@en .

aat:300264473 a skos:Concept ;
    skos:definition "Objects plaited or woven from grain stalks, traditionally from the last sheaf to be cut in the field, intended to serve as a home over the winter for the spirit of the grain field, before being burnt or ploughed back into the field in spring to ensure the continuity of the harvest. The folk tradition originated in Britain and Ireland and was taken by immigrants to North America. The designs include human-like figures, one or more loops conjoined, or conical cages, and ribbons or rags are common enhancements. In the present time many are made for sale as crafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corn dollies"@en .

aat:300264474 a skos:Concept ;
    skos:definition "Hooded cloaks, usually sleeveless, typically worn by Christian monks. The term originally applied to outer garments worn by both men and women in Europe, but around 530 CE became the outerwear prescribed by St. Benedict for the monks of his order, hence their primary association with monks. The term is also sometimes used for the hoods alone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowls"@en .

aat:300264475 a skos:Concept ;
    skos:definition "An individual person's conscious sharing of some kind of essential character with one or more groups of other people, such as a race, nation, social class, profession, or body of people organized into a group at some particular time for some particular purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "group identity"@en .

aat:300264476 a skos:Concept ;
    skos:definition "Refers to a Christian denomination and movement founded by Mary Baker Eddy (1821-1910) that seeks to reinstate the Christian message of salvation from all evil, including sickness and disease as well as sin. Eddy, a semi-invalid who was interested in cures not involving medicine, claimed a recovery from a bad injury without medical assistance in 1866. Afterwards, she devoted herself to restoring the healing emphasis of early Christianity. In 1875 she finished writing the first edition of the 'Science and Health with Key to the Scriptures.' This work and the Bible are the principal texts of the movement and importance has been laid on establishing reading rooms where these works can make their own appeal to readers. The 'Christian Science Monitor' is also published by the denomination. Christian Science believes that ignorance is at the root of human unease and thus 'dis-ease.' Instead of seeking medical treatment, special Christian Science healers are to be consulted for spiritual healing. Health, happiness, and holiness can be restored by applying to all aspects of life practices and attitudes in keeping with the principal of divine harmony. The first Church of Christ, Scientist was founded in 1879 in Boston and its headquarters remain there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian Science"@en .

aat:300264477 a skos:Concept ;
    skos:definition "Refers to an ancient Middle Eastern religion still surviving in Iraq and Khuzistan (southwest Iran). The religion is usually considered a Gnostic sect and as such is the only surviving representative of Gnosticism. Mandaeans number about 15,000-20,000. Mandaeanism, like other dualistic systems, emphasizes salvation of the soul through esoteric knowledge (gnosis). The spiritual soul will be freed from the material world by their redeemer, Manda d'Hayye, but evil Archons obstruct the ascent of the soul. In Mandaeanism, Jesus is seen as a false messiah but John the Baptist is revered for performing miraculous healings through baptism. Mandaeans developed elaborate cultic ritual, particularly for baptism, which is not a part of any other known Gnostic sect. Baptism is seen as purification from sin and it can be often repeated. The religion's origins are obscure and remain controversial. On the basis of Babylonian elements in Mandaean magical texts, the use of the Iranian calendar, and the incorporation of several Iranian words into the Mandaic language, some scholars argue that Mandaeanism originated in southwestern Mesopotamia in pre-Christian or early Christian times. Other scholars argue for a Syro-Palestinian origin on the basis of the 'Haran Gawaita,' a quasi-historical Mandaean document narrating the exodus from Palestine to Mesopotamia of the Nasoreans (the Mandaean priestly caste as opposed to Mandaiia, the laity) in the 1st century CE. Certain noteworthy affinities to Judaism are also called attention to: a familiarity with the Old Testament; parallels to Jewish ethics, especially the high value placed on marriage and procreation; the use of Hebrew angelology; and a concern for cultic purity. There are also a number of similarities to Manichaeism. The Mandaeans may be the Sabeans mentioned in the Koran. Mandaean literature, written in an Aramaic dialect and in a distinctive script, is quite extensive. Important extant works include the Ginza (Book of Adam); the Book of John; the Book of the Zodiac; and the Baptism of Hibil Ziwa. Mandaeans are traditionally skilled silversmiths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mandaeanism"@en .

aat:300264478 a skos:Concept ;
    skos:definition "Style and culture of the Pashto-speaking people living in southeastern Afghanistan, northwestern Pakistan., and surrounding areas. They constitute the largest ethnic group in Afghanistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pashtun"@en .

aat:300264479 a skos:Concept ;
    skos:definition "Religion that draws upon Taoism, Confucianism, and Buddhism as sources for its doctrines and practices. It is a school or sect of religious Taoism founded by Wang Ch'un-yang (1112-1170) in 1163 after he met a hermit claiming to be an incarnation of two of the immortals and from whom he received secret teachings. Ch'uan-yang drew on classic Tao sources as well as on sources outside the Taoist tradition, particularly from Zen Buddhism. Every disciple of this school has the objective of realizing Tao in experience, through understanding his own mind and nature in relation to Tao. The school was favored by the Mongols and its second patriarch, Ch'iu Ch'ang-ch'un, was invited into Central Asia to preach to Genghis Khan. The school was immensely popular and its establishments of celibate monks continued to be active into the 20th century, with the famous White Cloud Monastery at Beijing as headquarters. This particular monastery is of the Lung-men (or Dragon Gate) school, one of the most important of several movements that came out of Ch'üan-chen tao."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ch'üan-chen"@en .

aat:300264480 a skos:Concept ;
    skos:definition "Brief formal prayers used in Western Christian worship that vary with the day. The term reflects the original 'collecting' of the petitions of the worshippers into a single prayer. Collects consist of an invocation, a petition, and a pleading of Christ's name or ascription of glory to God. The collect precedes the readings in the eucharist. The collects in the 'Book of Common Prayer' are partly written by Thomas Cramner and partly adapted from Latin service books. According to the 'Book of Common Prayer,' two invariable collects follow the collect of the day at morning and evening prayers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collects"@en .

aat:300264481 a skos:Concept ;
    skos:definition "Celebrations of the eucharist by a number of priests at once. Together the priests say the eucharistic prayer or the words of consecration over the same bread and wine. The practice died out in the West except at ordinations, but it was revived in the Roman Catholic Church by Vatican II. It is sometimes used as a way to allow priests and congregations from churches out of communion with one another to have a eucharist together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concelebrations"@en .

aat:300264482 a skos:Concept ;
    skos:definition "The doctrine according to which the substances of both the body and blood of Christ and of the bread and wine coexist in the eucharistic elements after being consecrated. The concept is attributed to Luther, who was opposed to the doctrine of transubstantiation. Luther illustrated the concept with the analogy of an iron in a fire: the fire and the iron are united in the red-hot iron yet both are still present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consubstantiation"@en .

aat:300264483 a skos:Concept ;
    skos:definition "Refers to a Christian feast and festival commemorating the origin of the eucharist and in honor of the presence of the body of Jesus Christ in the eucharist. The Latin term means 'body of Christ.' It is usually celebrated on the Thursday after Trinity Sunday in the Western church. Its origins lie in the Middle Ages when there was increased devotion to the Blessed Sacrament, especially after the Fourth Lateran Council of 1215. In 1246, Robert de Torote, bishop of Liège, first celebrated the feast in his diocese after being persuaded to do so by Blessed Juliana, prioress of Mont Cornillon near Liège (1222-58), who had experienced a vision. The feast did not spread until Jacques Pantaléon, formerly archdeacon of Liège, became Pope Urban IV; a bull of 1264 commanded its observance. Over time it became more accepted and in the 15th century it became, in effect, the main feast of the church. Corpus Christi has been celebrated by carrying the host in procession since the 14th century. The feast's procession became a pageant in which sovereigns, princes, magistrates, and guild members took part. In the 15th century the procession was often followed by performances of miracle plays and mystery plays by members of guilds. The feast was suppressed in Protestant churches after the doctrine of transubstantiation was rejected during the Reformation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corpus Christi"@en .

aat:300264484 a skos:Concept ;
    skos:definition "Originally, and in Catholic theology, this term refers to the belief that God creates a soul for each individual person at conception or birth, in contrast to the belief in a soul's pre-existence. In the Middle Ages it was thought that this occurred 40 days after conception for a male baby and 80 days after conception for a female baby. While Augustine thought creationism and original sin were contradictory, Aquinas held that not believing in this tenet constituted heresy. In modern times the term has come to refer to the literal belief in the Genesis creation story as opposed to the theory of evolution associated with Darwin's 'The Origin of Species' of 1859. Linked to fundamentalism, creationism emerged in the 1960s in the United States, with its roots in the 19th century. Proponents of creationism demand that public schools equally teach creationism and evolutionary theory. Numerous creation science papers have been and continue to be published although they are not regarded as serious science outside of the movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creationism"@en .

aat:300264485 a skos:Concept ;
    skos:definition "Refers to Christian clergy who have the charge ('cure') of a parish. The term is more often popularly used to denote assistants or unbeneficed clergymen who help or temporarily replace priests, vicars, rectors, or other incumbents of parishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curates"@en .

aat:300264486 a skos:Concept ;
    skos:definition "Concept of state of deep inner freedom and peace, the supreme goal of Hinduism and Buddhism. Reaching nirvana means liberation from samsara, the cycle of birth, death, and rebirth. In Buddhism, nirvana represents freedom from attachments and individual consciousness and the attainment of tranquility and purity. Nirvana is conceived somewhat differently within the various schools of Buddhism. In Hinduism it furthermore means that union with God or the Absolute is possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nirvana"@en .

aat:300264487 a skos:Concept ;
    skos:definition "Containers, generally rectangular and shaped like a box, incorporating a translucent screen illuminated from within, typically used for tracing or for viewing or displaying transparencies and films such as slides and x-rays, or for the shadowless illumination of small objects for photography or another purpose; portable light tables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light boxes"@en .

aat:300264488 a skos:Concept ;
    skos:definition "Describes works created by the nomadic Turkish people of the same name of southeastern Europe. Originating in the region between the Ural and the Volga rivers, the people were very active militarily in the area north of the Black Sea from the ninth to the 12th century. After their defeat at Constantinople in 1091, they lost most of their military power and moved into what are now Hungary and Bulgaria to settle there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pecheneg"@en .

aat:300264490 a skos:Concept ;
    skos:definition "Small boxes, typically of wood, designed for holding one or more packs of playing cards, and sometimes also accessories to card games such as gaming chips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playing card boxes"@en .

aat:300264491 a skos:Concept ;
    skos:definition "The activity of riding to and fro on a swing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "swinging"@en .

aat:300264492 a skos:Concept ;
    skos:definition "Dutch literary movement of the 1880s, the members of which were young writers and poets determined to express real emotions in highly individualistic language, avoiding cliché and traditional rhetoric. Notable members included Willem Kloos, Jacques Perk, Frederik van Eeden, and Hélène Swarth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Men of the Eighties"@en .

aat:300264493 a skos:Concept ;
    skos:definition "Science of the long-distance sending and receiving of computerized information, the term coined by Alain Minc and Simon Nora in 1978."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telematics"@en .

aat:300264494 a skos:Concept ;
    skos:definition "Physicists specializing in the field that deals with the properties and phenomena of both visible and invisible light, including its generation, transmission, and detection or perception."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opticists"@en .

aat:300264495 a skos:Concept ;
    skos:definition "Physicists specializing in deducing the consequences of established physical theories using mainly the method of mathematical solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathematical physicists"@en .

aat:300264496 a skos:Concept ;
    skos:definition "Specialists in the use of radiation, such as X-rays, and radioactive materials in the diagnosis and treatment of disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiologists"@en .

aat:300264498 a skos:Concept ;
    skos:definition "Refers to modern-day Zoroastrian high priests. Dasturs oversee the liturgical lives of the important fire temples with which they are associated, assisted by a team of mobeds. This rank of priest is akin to that of the bishop in Christianity. The dasturs have a strong tradition of learning, especially among the Parsis in Bombay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dasturs"@en .

aat:300264499 a skos:Concept ;
    skos:definition "Independent dollmakers who design and create one-of-a-kind dolls, their costumes, and other accessories, usually for individual sale to collectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doll artists"@en .

aat:300264500 a skos:Concept ;
    skos:definition "Refers to Zoroastrian priests that rank above ervads and below dasturs within the priestly hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobeds"@en .

aat:300264501 a skos:Concept ;
    skos:definition "Refers to Zoroastrian priests of the lower degree. Ervads have undertaken navar, the first of the two initiation rites for priests. In the more important ceremonies, ervads act only as assistant priests. The correlating historical term, 'ehrpats,' originally referred to religious teachers who were entrusted with the care of the fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ervads"@en .

aat:300264502 a skos:Concept ;
    skos:definition "One-of-a-kind dolls made by hand by the original designers, together with their costumes and other accessories, such as a base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist dolls"@en .

aat:300264503 a skos:Concept ;
    skos:definition "Refers to various Christian officials but most often to senior clergymen (after bishops) in cathedral chapters or dioceses. The term originally referred to monks in charge of ten novices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deans"@en .

aat:300264504 a skos:Concept ;
    skos:definition "Refers most often to the ideas of a heterogeneous religious movement of the late 17th and 18th centuries that flourished mainly in Britain. Deism also became very popular in 18th-century Germany. The movement was concerned with defending the rationality of religion and belief in God in the face of rising skepticism, especially as a consequence of Newton's laws. According to Deist writers, there exists a supreme being who initiated creation and is thus the basis of reality, but who does not intervene in the world and its natural laws (i.e. does not answer prayers or perform miracles). Nevertheless, Deism holds that religion is natural to humanity, and emphasizes natural religion as opposed to revealed religion or the teachings of churches. Natural religion comes from a certain body of religious knowledge that is inborn in everyone or that can be acquired through reason. Important Deist writings include Matthew Tindal's 'Christianity as Old as the Creation' (1730), the so-called 'Deist Bible.' Other important English Deists were Lord Herbert of Cherbury and Anthony Ashley Cooper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Deism"@en .

aat:300264505 a skos:Concept ;
    skos:definition "Japanese ritual dances with music, the Japanese word meaning 'field entertainments,' in reference to the agricultural folk religion of medieval Japan (ca. 11th-17th centuries). Dengaku was performed in the rice fields either at New Year's or during the planting season in early summer. The dance and music were meant to entertain the kami (Shinto gods) in the hopes of plentiful crops and to relieve the boredom of the workers. In the 14th century some forms of dengaku were taken to the cities and performed as court entertainment; through this exposure dengaku came to influence some of the classical performing arts such as the Nō drama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dengaku"@en .

aat:300264509 a skos:Concept ;
    skos:definition "Refers to techniques used to produce the appearance of three-dimensionality in photographs by using two images made at slightly different positions, mounting them side by side, and viewing the pair through a stereoscope or other device. This type of photography was extremely popular in the Victorian period. The process was described in 1832, but the techniques were perfected only after 1856, when a twin-lens camera was designed to take two pictures of the same scene simultaneously. The viewpoints of the photographs were 2 1/2 inches apart, which is approximately the normal distance between human eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereoscopic photography"@en .

aat:300264510 a skos:Concept ;
    skos:definition "Technique for making copies of images or documents using a device called a polygraph. An early polygraph consists of a blunt stylus and a pen or brush connected by frames and springs that allow the user to trace over the original with the stylus while the pen or brush moves in parallel, copying what is traced onto a sheet of paper or other surface. The term can also be used to describe a technique for simultaneously producing two or more identical writings or drawings. Polygraphy also refers to a method of producing copies of paintings, invented by Joseph Booth, ca. 1788. Polygraphy can furthermore more generally refer to the art or practice of using any copying machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polygraphy"@en .

aat:300264511 a skos:Concept ;
    skos:definition "Refers to graffiti on or in subway cars as well as in subway stations. A tradition of subway graffiti originated in New York in the early 1970s and quickly spread to other large urban centers in the United States and the rest of the world, especially in Europe. Like other types of graffiti, aerosol spray paint and permanent markers are the most common media. Subway graffiti typically consists, in part, of an artist's name, nickname, or 'tag.' For graffiti in subways but considered art, combine indexing with \"graffiti art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subway graffiti"@en .

aat:300264512 a skos:Concept ;
    skos:definition "Refers to a mixture of flowers, herbs, spices, fruit juices or other aromatic substances that are typically aged, fermented, or stored in a jar and used for scent. Although the term originally referred to the jar (or \"pot\") that stored the fermenting mixture, it is often now used to refer to the aromatic mixture itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potpourri"@en .

aat:300264513 a skos:Concept ;
    skos:definition "Refers to books, scrolls, rolls, or other document forms containing the sacred scriptures of Judaism or Christianity. Bibles may also contain illuminations, which are painted scenes or decorations. The Bible is composed of two parts: The Hebrew scriptures or Old Testament, written originally in Hebrew (with some parts in Aramaic) and including the writings of the Jewish people, and the New Testament, composed in Greek and recording the story of Jesus and the beginnings of Christianity. The Roman Catholic and Eastern Orthodox versions of the Old Testament are somewhat larger than the Protestant Bible because they accept certain books and parts of books considered apocryphal by Protestants. The Jewish Bible includes only the books known to Christians as the Old Testament. The arrangements of the Jewish and Christian canons differ considerably. Traditionally the Jews have divided their scriptures (the Old Testament) into three parts: The Torah (the \"Law\"), or Pentateuch; the Nevi'im (the \"Prophets\"); and the Ketuvim (the \"Writings\"), or Hagiographa. The stories, moral teachings, and theological doctrines in the bible have provided subjects for an immense body of visual art in both Christian and Jewish imagery. For Christians, a canon of biblical books was established in the Early Christian period; however, several apocryphal books continued to circulate long afterwards. Beginning in the late medieval period, poetic and dramatic interpretations of biblical narratives were very popular, providing ample extra-canonical literature that contributed to the development of important subjects in Christian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bibles"@en .

aat:300264514 a skos:Concept ;
    skos:definition "Days of celebration observed by followers of Hinduism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindu holidays"@en .

aat:300264515 a skos:Concept ;
    skos:definition "Refers to an annual spring festival that is the last festival of the Hindu calendar, occuring on the full-moon day of Phalguna in February or March. The festival is probably ancient in origin and is characterized by its sense of playfulness and reversal of normal codes of behavior. It is only on this day that the typical restrictions of caste, sex, age, and status are set aside. Celebrants throw colored waters and powders on one another and celebrations are known for their ribald language and behavior. Some participants may drink 'bhang,' an intoxicating beverage made with hemp. Bonfires are lit the preceding evening to signify the triumph of good over evil and the end of winter; a straw figure of the witch Holikā may be burnt in the fires. The festival is especially associated with Krishna, the young god known for his frivolity. The Dolayatra (swinging of the god) festival takes place during Holi; images of the gods on decorated platforms are swung to the accompaniment of special songs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holi"@en .

aat:300264516 a skos:Concept ;
    skos:definition "An annual Hindu festival dedicated to the worship of the god Shiva, celebrated on the night before the new moon in February or March. The thirteenth night of the dark half of every lunar month is sacred to Shiva but this night in the month of Magha or Phalguna is when devotions to the deity reach a climax. The festival commemorates the night Shiva is said to have performed the Tandava, the celestial dance of primordial creation, preservation, and destruction. The festival includes fasting, worship every three hours, and the annointing of the linga, a phallic emblem that is the principal symbolic representation of Shiva. The day after the all-night vigil is celebrated with feasting and festival fairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahashivaratri"@en .

aat:300264517 a skos:Concept ;
    skos:definition "A Hindu festival celebrating the birth of the elephant-headed god Ganesha. This festival, lasting seven to ten days, culminates on the fourth day of the lunar month of Bhadra (August-September). It is particularly popular in the Maharashtra state in India. Worshippers place instruments of work before Ganesha, god of wisdom and prosperity, in order for them to be blessed. This joyous festival features many statues and images of Ganesha and culminates in a spectacular parade called Ganesha Visarjana. Worshippers are forbidden to look at the moon on this day because the moon laughed at Ganesha when he fell from his mount, the rat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ganesha Chaturthi"@en .

aat:300264518 a skos:Concept ;
    skos:definition "The Hindu festival of lights, an important festival celebrated throughout India for four or five days in October/November (from the thirteenth day of the dark half of the lunar month Asvina to the second day of the light half of Karttika). The festival, honoring Lakshmi, the goddess of wealth and good fortune, is observed with particular enthusiasm by merchants who begin new account books at this time (the goddess Kali is worshipped in Bengal). Worshippers place small earthenware oil lamps in rows along the parapets of temples and houses; the lamps are also set adrift on rivers and streams. This commemorates the return from exile and coronation of Rama, an incarnation of the god Vishnu. Ornate patterns of lotuses are drawn on the floor near the doors of houses as a way of inviting Lakshmi in. During the festival, people visit one another, exchange gifts, feast, and wear new clothes. The fourth day of the festival marks the beginning of the new year according to the Vikrama calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Divali"@en .

aat:300264519 a skos:Concept ;
    skos:definition "Days of celebration observed by followers of Jainism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jain holidays"@en .

aat:300264521 a skos:Concept ;
    skos:definition "Refers to an important Jain festival that ends the ritual year. The lights of the Hindu festival of the same name are reinterpreted as a commemoration of the passing into nirvana of Mahavira, the most recent of the Jain Tirthankaras, or saints. The lighting of the lamps is seen as a material substitute for the light of holy knowledge that was extinguished with Mhavira's death. The festival occurs on the full-moon day of the month of Karttika (October-November)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diwali"@en .

aat:300264522 a skos:Concept ;
    skos:definition "Paintings and other adornments applied to books, scrolls, or other document types for the purpose of illustrating or decorating the text. It may take any of three forms: Miniatures, which are small pictures that are often set apart from the text and comprise a self-contained design; decorated initial letters, that themselves may contain a small scene; and decorated borders, which also may contain scenes. The media of illumination generally includes paint, ink, and precious metals on vellum, paper, or silk. Among the earliest surviving illuminated documents are papyrus rolls of the ancient Egyptian Book of the Dead. Other early examples have survived from Classical Greece and Rome, as Aztec pictorial maps, and in Mayan and Chinese codices. The art form flourished in bibles and other sacred books of medieval Europe, where the media typically were egg-white tempera on vellum and card. It also flourished in Indian and Islamic miniatures, which were produced into the 19th century. For pictures that are not painted miniatures or that accompany printed books or advertisements, use \"illustrations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illuminations"@en .

aat:300264523 a skos:Concept ;
    skos:definition "Devices comprising sticks or rods; used by people working above ground in an attempt to discover water, minerals, treasure, archaeological remains, graves, or other things below ground. Use of rods for these purposes has ancient origins; devices similar to those used today are first documented in 16th-century Europe. Traditionally Y-shaped twigs, often of hazel, rown, or willow which, when their two prongs are grasped, twist and dip in the hands of the dowser as he or she approaches the substances or objects sought for. Alternatively, the rods consist of two metal rods held parallel a few inches apart, that swing across each other when nearing the sought-after substance or objects. In controlled studies, the success rate of finding anything below ground by using these devices is no better than chance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divining rods"@en .

aat:300264524 a skos:Concept ;
    skos:definition "People with the skill or ability to detect the presence of water, minerals, treasure, archaeological remains, and even dead bodies located underground by means of a divining rod. Dowsers grasp the rod by its two prongs and appear to receive transmissions from the hidden substance or object that cause involuntary muscular contractions, which in turn make the rod bend, twist, or quiver violently. Some dowsers claim to be ableto detect buried substances merely by passing a divining rod over amap of the area where the substance lies hidden. This ability has as yet no scientific explanation, but dowsers generally deny that divination is part of the process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dowsers"@en .

aat:300264525 a skos:Concept ;
    skos:definition "Pattern comprising a zigzag of contrasting colors, imitating flame stitch embroidery in certain upholstery at the Bargello Museum in Florence. Examples of the pattern are found in upholstery, wallpapers, and parquet floors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bargello work"@en .

aat:300264526 a skos:Concept ;
    skos:definition "Performers who create illusions and perform sleight-of-hand, conjuring tricks, and other types of stage magic. Distinct from \"magicians (people in the occult)\", who study and practice ritual activities with the object of controlling or influencing human or natural events through the invocation of external and impersonal mystical forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magicians"@en .

aat:300264527 a skos:Concept ;
    skos:definition "Concepts related to the doctrine of Hinduism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindu doctrinal concepts"@en .

aat:300264528 a skos:Concept ;
    skos:definition "Concepts related to the doctrine of Christianity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christian doctrinal concepts"@en .

aat:300264529 a skos:Concept ;
    skos:definition "Concepts related to the doctrine of Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhist doctrinal concepts"@en .

aat:300264530 a skos:Concept ;
    skos:definition "Concepts related to the doctrine of Jainism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jain doctrinal concepts"@en .

aat:300264531 a skos:Concept ;
    skos:definition "Refers specifically to craftsmen who create decorative sculpted surfaces and sculptural detail for walls and ceilings in stucco, which is a light, malleable plaster. Also refers generally to those who apply stucco to surfaces, not necessarily sculpted or molded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuccoists"@en .

aat:300264532 a skos:Concept ;
    skos:definition "Refers to glass that was originally manufactured in the forest regions of France and Germany in the Middle Ages. It is usually greenish, yellowish, or brownish in color, and the glass is typically rather thick, simple in form, mold blown, and decorated with trailing and prunts. It is characterized by the alkali ingredient having been provided by potash from the ashes of burnt beechwod, fern (bracken), or other woods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest glass"@en .

aat:300264533 a skos:Concept ;
    skos:definition "Refers to threads of glass that are applied as a decoration, generally on the body, foot, or handle of a vessel. The threads may be laid down in straight rows or in a pattern or chain. Trailings were first seen in ancient Roman glass, and were also popular in medieval and later glass. They are distinct from \"threadings,\" which are independent designs that are often partially free-standing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trailings"@en .

aat:300264534 a skos:Concept ;
    skos:definition "Refers to the protective coverings for the face worn by goalkeepers in the game of ice hockey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goalie's masks"@en .

aat:300264535 a skos:Concept ;
    skos:definition "Refers to groups of artists or craftsmen working under the supervision of a master. The term is derived from an Italian word, and it is typically used to refer only to Italian workshops or studios."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottegas"@en .

aat:300264536 a skos:Concept ;
    skos:definition "Refers to groups of artists working in a studio. In modern usage, it generally refers only to fine arts studios, and often only to artists' studios in France, or in Britain after the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ateliers"@en .

aat:300264537 a skos:Concept ;
    skos:definition "Refers to tables having a set of cabinets above, used for writing. The form was popular in France, England, and America in the early 18th century. In modern usage, it is typically distinguished from an \"escritoire\" or a \"secretary.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrutoires"@en .

aat:300264538 a skos:Concept ;
    skos:definition "Refers to low chests of drawers often surmounted by a mirror and typically used in a bedroom or dressing room as a surface for grooming and to store clothing and toiletries. The term in this context is used primarily in America, and is derived from the European \"dresser (cupboard),\" which contains drawers and is surmounted by shelves, but is used to store kitchen utensils and dishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressers"@en .

aat:300264539 a skos:Concept ;
    skos:definition "Experts in one or more of the arts or matters of refined taste, competent to pass critical judgement in relation thereto.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "connoisseurs"@en .

aat:300264540 a skos:Concept ;
    skos:definition "The school of Tibetan Buddhism founded in 1409 by Tsongkapa (1357-1419) with the founding of the Riwo Ganden monastery; the Dalai and Panchen lamas are both members of this school. It absorbed the Kadampa, the oldest order of Tibetan Buddhism. The Geluk has been the predominant school since the 17th century and it had enormous political power from the time of the fifth Dalai Lama. The Geluks value scholarship and debates. Followers are often called 'Yellow Hats' because of the yellow hats prescribed by Tsongkapa to differentiate Geluk monks from Nyingma monks who wear red hats. The school has been successful in reaching outside of Tibet, with centers in Europe in the United States. Its center is Dharmasala in Northern India, where an ambitious publishing program seeks to preserve and disseminate Tibetan texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Geluk"@en .

aat:300264541 a skos:Concept ;
    skos:definition "The second largest school of Tibetan Buddhism, sometimes called the 'old order.' It traces its roots to the Indian Vajrayana master Padmasambhava (8th century), regarded as the 'second Buddha,' and claims to transmit his original teachings. The school's origins are in the first diffusion of Buddhism from India and Central Asia to Tibet in the 8th and 9th centuries. Nyingma became a distinct order in the 10th century. The school emphasizes religious practice and the mystical aspects of the Vajrayana tradition over scholarly work, and includes shamanistic practices and local divinities borrowed from the indigenous Bon religion. Some of the school's ideas are considered heretical by later teachings of Tibetan Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyingma"@en .

aat:300264542 a skos:Concept ;
    skos:definition "A school of Tibetan Buddhism following the teachings of the scholar Drogmi (992-1072), who is known for translating into Tibetan the 'Hevajra Tantra,' an important Tantric work which is one of the main texts of the Sakya school. The well-known 'Blue Annals,' a history of Tibetan Buddhism, was written in the 15th century by a follower of the school. The school takes its name from the Sakya monastery founded in 1073 by Konchok Gyalpo near Mount Everest. The abbots of the Sakya monastery were appointed regents of Tibet by the Mongol rulers of China from about 1270 to 1340. The Sakya has vied for power with other schools of Tibetan Buddhism. There are two subsects of the Sakya school: the Ngor and the Tshar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sakya"@en .

aat:300264543 a skos:Concept ;
    skos:definition "A school of Tibetan Buddhism that is currently the third largest in Tibet. The school follows the teachings of Marpa, a distinguished 11th-century translator of Buddhist texts, and the Tantric yogins or siddhas of India. Esoteric Tantric teachings are combined with the monastic discipline of the Kadampas. The more severe practices of Hatha Yoga are emphasized. A more positive ontology of the ultimate status of things is characteristic of Kagyü scholarship, in contrast to the thinking of the Geluks, who regard all phenomena as devoid of inherent existence. Milarepa, considered a great Tibetan poet, was Marpa's chief disciple. Gampopa was, in turn, Milarepa's most important student, and he was responsible for the organization of the Kagyü into a true school. Six separate schools of Kagyü thought (although similar in doctrine) quickly developed, including the Tshal, Baram, Karma, and Druk. Of these, the Druk went on to become the main school of Buddhism in Bhutan and the Karma was the main rival of the now-predominant Geluk school from the 15th to the early 17th century. The idea of succession through reincarnating lamas originated in the Karma school and was later adopted by other Tibetan Buddhist schools including the Geluk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kagyü"@en .

aat:300264544 a skos:Concept ;
    skos:definition "Refers to an indigenous religion of Tibet that is, along with Buddhism, one of the two main religions of the country. Many aspects of Bon were mixed with the Buddhist traditions introduced from India in the 8th century and gave Tibetan Buddhism much of its distinctiveness. Disagreement amongst the ruling class of Tibet in the 8th and 9th centuries resulted in the noble families choosing Bon and the ruling house choosing Buddhism. The religion became organized around the 11th century largely thanks to the Buddhist concern for written works. Besides surviving in many aspects of Tibetan Buddhism, Bon continues to thrive in the northern and eastern frontiers of Tibet. It is unclear how much continuity there is between ancient and modern Bon. The features of ancient Bon are hard to determine because all early description are Buddhist and what is known of Bon today is heavily influenced by Mahayana Buddhism. Ancient Bon seems to have featured animism, shamanism, and the practice of magic rites. The Bon gods of the atmosphere, the earth, and subterranean regions were incorporated into the Buddhist pantheon as lesser deities. There is evidence of a cult of divine kingship in which the kings are seen as manifestations of the sky divinity; this belief may be the root of the reincarnated lamas of Buddhism. Bon oracular priests have as their counterpart the Buddhist soothsayers. Aspects of Bon doctrine are virtually identical to that of Tibetan Buddhism, including doctrine of buddhahood and the bodhisattva ideal. Particularly noteworthy are the dzogchen beliefs of Bon that are shared with the Nyingma school of Tibetan Buddhism; these beliefs hold that there is an ineffable state beyond all Buddhas and all manifestation. The Bon monastic system is also almost identical to that of the Geluk school. Nevertheless, believers in Bon rigorously guard their non-Buddhist image. Shenrab is considered the founder of the religion and the historical Buddha Shakyamuni is said to be a manifestation of him. Bon scriptures are of one of two groups: the 'Kanjur,' containing myths, doctrines, and biographies of Shenrab; and 'Katen,' containing commentary and ritual and iconographic works. The name Tibet is derived from Bon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bon"@en .

aat:300264545 a skos:Concept ;
    skos:definition "Jewish holiday commemorating the deliverance of the Jews in the 5th century BCE by Mordecai and Esther from a plot to have them massacred. The plot was the work of Haman, the chief minister of the Persian King Ahasuerus. The story is recorded in the Old Testament book of Esther. Its name derives from the lots cast to determine in what month the killing would take place. It is celebrated on 14 Adar (about March 1). The holiday was well established by the 2nd century CE. The day preceding Purim, Ta'anit Esther (Fast of Esther), is a day of fasting. On Purim the 'Scroll of Esther' is read in the synagogue. A festive and carnival atmosphere includes the customs of dressing up, exchanging gifts, and making donations to the poor. Three-cornered pastries called hamantaschen (\"Haman's ears\") are baked and Purim plays, which became popular in the 17th century, are performed on this holiday."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Purim"@en .

aat:300264546 a skos:Concept ;
    skos:definition "A festival celebrated on January 6 that is one of the three main and oldest festivals of the Christian Church (the other two being Christmas and Easter). The festival originated in the East where it originally celebrated both the birth and baptism of Jesus Christ. Since the 4th century when December 25 became the date of Christmas, the festival in the East has remained the celebration of the manifestation of Christ's divinity at his baptism. The festival spread to the West in the 4th century where it became more associated with visit of the Magi to the infant Christ and specifically the manifestation of Christ to the Gentiles in the form of the Magi. The festival also commemorates Christ's first miracle at Cana in Galilee. Gifts are exchanged on Epiphany instead of Christmas in some countries. The eve of Epiphany is called Twelfth Night in the West."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Epiphany"@en .

aat:300264547 a skos:Concept ;
    skos:definition "The activity of using one's mind to produce thoughts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thinking"@en .

aat:300264548 a skos:Concept ;
    skos:definition "Persons employed in the construction of boats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boatbuilders"@en .

aat:300264553 a skos:Concept ;
    skos:definition "Refers to symbols or other marks made by masons, generally incised into the stone. They were used to indicate a mason's responsibility for a building or sections of a building. They were often very elaborate marks, sometimes used in conjunction with a signature. The term may also refer to marks incised on stones to indicate in which part of the building they belonged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masons' marks"@en .

aat:300264554 a skos:Concept ;
    skos:definition "Refers to marks used in Western architecture to identify the mason who carved the stone at his banker in the building lodge. The origins and intended use of banker marks varied through history, and are not entirely understood. Early banker marks were apparently used to assure responsibility and quality control in a large building project where a number of less-skilled masons were employed. By the 13th century, banker marks often identified stones carved by specific task, so that the masons could be paid appropriately. Bankers marks typically appear on the work of masons less skilled than the freemasons, who carved moldings and figures. The banker mark eventually came to identify the mason himself. It was often assumed as a signature outside the context of the building site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banker marks"@en .

aat:300264555 a skos:Concept ;
    skos:definition "Refers to benches on which stonecutters place blocks of stone in order to dress and prepare them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bankers"@en .

aat:300264556 a skos:Concept ;
    skos:definition "Refers to the general style of art, architecture, performing arts, literature, and overall culture created by people of African descent living in Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afro-Brazilian"@en .

aat:300264557 a skos:Concept ;
    skos:definition "The business of selling and generally dealing in books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookselling"@en .

aat:300264558 a skos:Concept ;
    skos:definition "Freewheeled land vehicles, often with open sides, usually with a permanent or removable top, furnished with benches or long seats all facing forward, typically used for sightseeing. Early models were horsedrawn, later ones were motorized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charabancs"@en .

aat:300264559 a skos:Concept ;
    skos:definition "Designed to be filled or distended with air or gas in order to be functional."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inflatable"@en .

aat:300264560 a skos:Concept ;
    skos:definition "Inpainting technique in which the lacunae are painted in with short, vertical strokes, resulting in inpainting that is very difficult to notice as such at a distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tratteggio"@en .

aat:300264561 a skos:Concept ;
    skos:definition "Mosaics made from hundreds or thousands of tiny tesserae, typically of opaque glass. Often used to create pictures, jewelry, plaques, small boxes, and tabletops. Made from the 16th century to the present in Rome and elsewhere. The term was coined by British collector Sir Arthur Gilbert (1913-2001) in the mid-20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micromosaics"@en .

aat:300264562 a skos:Concept ;
    skos:definition "Days of celebration observed by followers of Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic holidays"@en .

aat:300264563 a skos:Concept ;
    skos:definition "Days of celebration observed by followers of Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhist holidays"@en .

aat:300264564 a skos:Concept ;
    skos:definition "Refers to an important Buddhist festival commemorating the birth, enlightenment, and death of the Buddha. It is particularly important in Theravada Buddhism. This festival is held on the full moon in the lunar month of Vesakha (falling in April or May). Celebrations include special devotional services and meritorious deeds such as offering food or alms to monks. Captive birds are sometimes released in memory of the Buddha's compassion. This day is observed as a public holiday in many countries in Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wesak"@en .

aat:300264565 a skos:Concept ;
    skos:definition "One of the two canonical festivals of Islam. Falling on the first three days of the month of Shawwal, the festival immediately follows the fasting month of Ramadan. The festival is celebrated with the communal saying of the special Id prayer and special alms are given. These three days are a time for visiting friends, presenting gifts, wearing new clothes, feasting, congratulating one another, and visiting the graves of relatives. Official celebratory receptions are also held. This festival is also a public holiday throughout much of the Islamic world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Id al-Fitr"@en .

aat:300264566 a skos:Concept ;
    skos:definition "One of the two canonical festivals of Islam. This festival occurs at the end of the period of the Mecca pilgrimage, on the tenth and following three days of the last month of the year, Dhu al-Hijjah. The festival commemorates the willingness of Abraham to sacrifice his son. Abraham's sacrifice is believed by Muslims to have occurred at Mina outside of Mecca. Muhammad started this festival during his second year at Medina when it was impossible for early Muslims to observe the pilgrimage to Mecca. Id al Adha is marked by rejoicing, feasting, and the wearing of new clothes. All who can afford to are supposed to sacrifice a legal animal (sheep, goats, camels, or cattle) and then equally distribute the meat among themselves, friends, neighbors, and the poor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Id al Adha"@en .

aat:300264567 a skos:Concept ;
    skos:definition "Enclosed white spaces issuing from the mouths of cartoon or photographic characters in comics, generally used to express dialogue or thoughts but also a variety of signs and symbols, such as punctuation, to express emotions. Speech is indicated by a solid line, arrow, or tapered cone linking the balloon to the speaking character, while thought is indicated by a series of bubbles linking the balloon to the thinking character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloons"@en .

aat:300264568 a skos:Concept ;
    skos:definition "Air-tight bags of rubber, plastic, paper, silk, or similar lightweight material, of varying shapes and sizes, usually brightly colored, which, when inflated with air or lighter-than-air gas, becomes lighter or nearly as light as air. Small ones that can be handled by children are intended as toys or as decorations. Largr-than-life examples, often representing lifelike or fictional beings and objects, are used in parades and other public displays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloons"@en .

aat:300264569 a skos:Concept ;
    skos:definition "Refers to works created by the African people of the same name, a subgroup of the Pende living in the Democratic Republic of Congo between the Kwilu and Loange Rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central Pende"@en .

aat:300264570 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Pende living in the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Pende"@en .

aat:300264571 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a subgroup of the Pende living in the Kwango region of the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Pende"@en .

aat:300264572 a skos:Concept ;
    skos:definition "Chronologies in graphic linear form, either vertical or horizontal, listing important events or other phenomena, such as dominant styles, for successive years or periods within a defined historic period, often limited to a particular culture or region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timelines"@en .

aat:300264574 a skos:Concept ;
    skos:definition "Refers to carved wooden sculptures depicting stylized heads and necks of birds. The larger sized style features a very long, usually pointed beak and a face that may include features of a crocodilem, a horned figure, or a D'mba figure; the arching neck piece is mounted on a detachable spherical base. The other main style. is smaller, made from one piece of wood, is more compact,with a shorter beak, is less elaborately carved, and mounted on a concave base. They serve mainly as shrine pieces, representing both the Supreme God and the spiritual protector of the family lineage. Alternative uses are as dance headresses and divination implements for such rituals as male and female initiation and harvest, healing, judiciary, and funerary ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tshol"@en .

aat:300264575 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Berber people living in the Middle Atlas region of Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beni M'Guild"@en .

aat:300264576 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Berber people living the Middle Atlas region of Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ait Youssi"@en .

aat:300264577 a skos:Concept ;
    skos:definition "Paper toys and models shaped more or less realistically like airplanes and generally intended to glide through the air with impetus from the human hand. Simple models are folded from virtually any kind of paper by people with no special training into a long, delta-wing shapes. More elaborate and often more lifelike models are carefully crafted from special stiff, lightweight paper, and often painted or otherwise decorated with military insignia and other symbols and designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper airplanes"@en .

aat:300264578 a skos:Concept ;
    skos:definition "Hypertext documents of text or images that are accessible via the World Wide Web, hosted on a web site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Web pages"@en .

aat:300264579 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Baggara people living in eastern Sudan, Chad, and northern Nigeria. They are the descendants of a kingdom that may have migrated from north or northeastern Africa to the central Sudanic region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tunjur"@en .

aat:300264580 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Hausa people living in southern Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mawri"@en .

aat:300264581 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in western Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toro"@en .

aat:300264582 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, a Sidamo people living in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dime"@en .

aat:300264583 a skos:Concept ;
    skos:definition "Describes works created by the Berber people living in the Middle Atlas region, a subgroup of the Tamazight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zaer"@en .

aat:300264584 a skos:Concept ;
    skos:definition "Style and culture of certain of the Bantu-speaking Tswana people living in South Africa and Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngwato"@en .

aat:300264586 a skos:Concept ;
    skos:definition "Refers to workers skilled in stone work associated with architectural construction, first documented in Medieval Europe. They are distinguished from other masons in that they were extremely skilled and well-trained in fine and complex work. They were often itinerate, moving wherever large or important buildings were being erected. They were noted for having a system of secret signs and passwords, which they learned from other freemasons and were used as evidence that they were competent and had been properly trained. By the 16th century, the term was often used as a complimentary synonym of \"mason,\" implying that the workman had superior skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freemasons"@en .

aat:300264587 a skos:Concept ;
    skos:definition "Refers to a style of tapestry design that developed in the Gobelins manufactory and flourished in 18th-century France. It is characterized by a relatively small, framed picture area containing figures or other scene, with the scene surrounded by rich borders composed of motifs such as flowers, garlands, decorative ropes, and other ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestries à alentours"@en .

aat:300264589 a skos:Concept ;
    skos:definition "Sports that includes running, walking, jumping, and throwing, usually on a running track and a grass field. Winners are those who complete the event in the shortest amount of time, throw the longest distance, among other parameters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "track and field"@en .

aat:300264590 a skos:Concept ;
    skos:definition "Collections of familiar expressions or sentiments, often attributed to a particular person. Typically used in a more general sense than \"epigrams\" or \"aphorisms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sayings"@en .

aat:300264591 a skos:Concept ;
    skos:definition "Rules or principles of conduct, morality or prudence, expressed in sententious form. It is often used specifically for precepts of morality or prudence occurring in Old English verse, or for self-evident propositions assumed as a premiss in mathematical or dialectical reasoning. The meaning of this term may overlap somewhat with \"aphorisms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maxims"@en .

aat:300264592 a skos:Concept ;
    skos:definition "Painted wall panels of a distinctive type produced in Tuscany in the 15th and early 16th centuries. Today, they have typically been removed from their original setting and are characterized by their size and shape: Their length is two to three times longer than their height, and they are larger than cassone panels and proportionally higher. The term originally meant \"backrest [for a piece of furniture],\" and referred to decorative panels positioned in wall panelling at head or shoulder height, above the backrest of a piece of furniture such as a cassone, bed, or or a high-backed bench with a chest below the seat that doubled as a narrow bed (a \"lettuccio\"). It may also refer to any panel paintings that were set into the wall as an integral part of the wainscoting. They are often distinguished from \"cornice pictures,\" which were installed higher on the wall in a frieze above the wooden cornice molding, forming a separate register between the wooden paneling and the bare wall just below the ceiling. Since this distinction may be lost once the panel has been removed from the wall, the term \"spalliere\" is often applied to both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spalliere"@en .

aat:300264593 a skos:Concept ;
    skos:definition "Refers to distinctive painted wall panels, generally those from 15th- and 16th-century Italy. They were typically installed in a frieze above the wooden cornice molding, forming a separate register between the wooden paneling and the bare wall just below the ceiling. Today, they have often been removed from their original location, and are recognized by their long, narrow proportions. They are distinguished from \"spalliere (paintings),\" which were installed lower on the wall, just above chests or benches. Since the original context of the setting is lost once the panel has been removed from the wall, the term \"spalliere\" may be applied to both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornice pictures"@en .

aat:300264594 a skos:Concept ;
    skos:definition "High-backed benches with a chest below the seat that doubled as a narrow bed, used primarily in Medieval and later Italian homes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lettucci"@en .

aat:300264595 a skos:Concept ;
    skos:definition "In the context of art and related disciplines, refers to institutions, agencies, or individuals that have physical or administrative responsibility for an art object, work of architecture, or other thing. In a broader sense, the term may refer to persons or institutions to whom some matter is entrusted or confided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repositories"@en .

aat:300264596 a skos:Concept ;
    skos:definition "Refers to buildings or rooms for long-term storage or depositing of archives or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archive repositories"@en .

aat:300264597 a skos:Concept ;
    skos:definition "Refers to paintings, photographs, or art in other media in which the subject is a female nude in a suggestive pose or other erotica. It generally refers specifically to pictures dating from the 17th through 19th centuries in Western art, when such pictures would have typically been displayed in a smoking room, study, or other domestic room frequented primarily by men. The female subjects commonly assumed traditional poses known from older, more traditional art, such as the reclining nude originally depicted in iconography of the mythological characters Venus or Diana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentlemen's pictures"@en .

aat:300264598 a skos:Concept ;
    skos:definition "People who make physical books, including bookbinders, printers, and others. The term does not generally include authors, who write the intellectual content of books, although it may include artists who make books by hand, including writing or drawing the content by hand. Do not use for a broker who accepts wagers from gamblers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookmakers"@en .

aat:300264599 a skos:Concept ;
    skos:definition "Refers to wood from the intersection of a branch to the trunk of a tree. It is characterized by a distinctive V-shaped grain, often cut into veneers for cabinetmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crotch"@en .

aat:300264600 a skos:Concept ;
    skos:definition "Refers to illusionistic effects on two- or three-dimensional art works in which the appearance of wood grain is simulated. In interior spaces, pine and other inexpensive softwood paneling may be painted to imitate expensive woods such as oak, walnut and cedar. Plaster or wall paper may also be painted with a wood grain texture. The term may also refer to furniture or other objects, typically intended for use outdoors in a garden, where the objects appear to be made of branches or trunks of trees, both in their three-dimensional form and in the surface effect that simulates wood grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faux bois"@en .

aat:300264603 a skos:Concept ;
    skos:definition "Refers to organized groups who make objects primarily by hand. In the context of Western art and decorative arts, the term \"manufactory\" is often used rather than \"factory (organization)\" to distinguish groups active in the 17th century or later that made fine art, furniture, tapestries, ceramics, and other decorative objects, as contrasted to workers active in modern industrial complexes, or \"factories (structures),\" where objects other than art are produced. Manufactories are typically characterized by the types of objects they produce, by the relatively large numbers of artists and craftsmen employed, and by the relatively complex administrative structure of director, or \"directeur,\" and several masters, who may each supervise a separate workshop or studio of artisans and apprentices. Manufactories were often sponsored by a monarch or other powerful person. For smaller groups consisting of a master artist or architect and his or her assistants or pupils, especially those dating from the mid-17th century on, use \"studios (organizations).\" For smaller groups of artists or craftsmen collaborating to produce works, often under a master's name, especially when the groups existed prior to the 17th century, use \"workshops (organizations).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manufactories"@en .

aat:300264604 a skos:Concept ;
    skos:definition "Refers to portions of thread left in fabric or another material by the in and out movement of a threaded needle through the thickness or surface of the material. It also refers to the loops of thread created on a needle in knitting or other needlework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stitches"@en .

aat:300264605 a skos:Concept ;
    skos:definition "In architecture, refers to detached vertical members, monolithic or built in courses, and made of stone, brick, wood, metal, or another solid material. They are characterized by being slender or narrow in proportion to their height, and of any shape in section. A pillar is typically used as a vertical support of some superstructure, as a stable point of attachment for something heavy and oscillatory, or standing alone as a conspicuous monument or ornament. The term may also be used for a natural pillar-shaped stone or other formation. The usage of \"pillar\" is broader than \"columns,\" \"posts,\" or \"piers,\" which are basically pillars of particular shapes, proportions, and functions; a \"pillar\" may be, but is not necessarily, any of these three more specific members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillars"@en .

aat:300264606 a skos:Concept ;
    skos:definition "Wood in the form of large, squared or dressed pieces used for forming part of a built work or used to create a curving frame branching outward from the keel of a ship and bending upward in a vertical direction. Timber that is curved or bent may be a composite formed of several pieces rather than being a single piece of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timber"@en .

aat:300264607 a skos:Concept ;
    skos:definition "Refers to imitations of hand-made lace created by machines. The term may also refer to lace that is worked by hand on top of machine-made netting. The latter was produced in England beginning in the 1770s. Early machine-made netting is often characterized by looped stitches, which tend to run; machine-made netting dating after 1808 may be characterized by an imitation of the simple twist of Lille lace. Machine-made nets may be decorated by machine with chain stitching or needle-run patterns. Machine lace dating to the 1840s or later may imitate bobbin lace. Machine laces are generally characterized by a lack of the clearly woven structure of bobbin lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machine lace"@en .

aat:300264608 a skos:Concept ;
    skos:definition "Refers to imitations of hand-made lace created by embroidering designs in cotton on a silk ground; the silk is then burned away with chlorine or caustic soda. Imitation lace produced by this method first appeared in the late 19th century. Chemical lace often appears similar to Venetian lace, but is distinguished because it lacks the buttonhole stitches of hand-made lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemical lace"@en .

aat:300264609 a skos:Concept ;
    skos:definition "Refers to needle lace created in Venice primarily during the 16th through 19th centuries. It also refers to imitations of Venetian lace made later and/or in other locations. It is characterized by a sumptuousness defined by the large size of the pieces of lace and by the rich high-relief patterns and Baroque designs. Early examples were created by stitching together sections of deep, acute-angled points of lacework, which were typically used for making ruffs and collars known as \"vandykes.\" Later designs were more curvilinear. Lace making declined in Venice proper in the early 19th century, but lace is still made on the nearby island of Burano."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian lace"@en .

aat:300264610 a skos:Concept ;
    skos:definition "Refers to a type of lace that developed from flat Venetian lace. It is characterized by a raised pattern created by outlining scrolls or leaf designs with a cordonnet, which is a relatively heavy thread or bundle of threads; the design is then worked over with buttonholing so that scrolls and leaves stand out in relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punto a relievo"@en .

aat:300264611 a skos:Concept ;
    skos:definition "Refers to a type of lace that is similar to \"punto a relievo\" lace, but distinguished by being less grandiose but more ornamented. It is characterized by the inclusion many little loops and rosettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose point"@en .

aat:300264612 a skos:Concept ;
    skos:definition "Refers to a type of Venetian lace that is characterized by the inclusion of many light bars, or brides, of thread worked with motifs such as loops, picots, and stars that resemble snowflakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point de neige"@en .

aat:300264613 a skos:Concept ;
    skos:definition "Refers to early examples of Venetian lace that are characterized by a relatively flat surface. Later Venetian lace had a heavily carved or raised appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point plat de Venise"@en .

aat:300264614 a skos:Concept ;
    skos:definition "Refers to a thick, loosely spun silk thread or cord. It is often made from inferior silk and used for outlining patterns in lace making, making trimmings or fringes, and in other applications where strength is not required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cordonnet"@en .

aat:300264615 a skos:Concept ;
    skos:definition "Refers to collars and ruffs that were made of Venetian lace or a similar lace; they were an article of fashionable dress in 18th-century Europe and European colonies. They typically include deep, acute-angled points of lacework. The term refers to the appearance of such collars in portraits by the famous painter, Anthony van Dyck (also spelled \"van Dyke\")."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vandykes"@en .

aat:300264616 a skos:Concept ;
    skos:definition "Refers to a distinct type of bobbin lace created in Lille, which is now in France but was formerly in Flanders. It was created primarily during the 16th through 19th centuries. It also refers to imitations of Lille lace made later and/or in other locations. It is characterized by a very fine net background formed of a hexagonal mesh in which the thread is twisted rather than plaited. The designs typically include curving flowers and scrolls, and small, square dots scattered over open areas of mesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lille lace"@en .

aat:300264617 a skos:Concept ;
    skos:definition "Refers to a distinctive type of textile work made at Mount Kennet, near Limerick, Ireland, from 1829 onwards. It may also refer to similar textiles made in other locations. It comprises machine-made net on which embroidery is applied, with a result that is similar in appearance to true hand-made lace. It is characterized by having designs that imitate contemporary popular designs; designs are embroidered using tambour stitches for outlines and needlerun stitches for filling. The term is sometimes used loosely to refer to embroidered net in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Limerick lace"@en .

aat:300264618 a skos:Concept ;
    skos:definition "Refers to a distinctive type of bobbin lace that was sold in and exported from England during a particular period of history. It refers both to genuine Brussels lace that was secretly imported to England in late 17th century, and to lace produced in England that was comparable to fine Brussels lace in thread quality, technique, and design. In order to encourage the lace industry at home, in the 1660s both England and France enacted laws prohibiting the importation of the wildly popular Brussels lace. To circumvent these laws, merchants often smuggled Brussels lace to England and France, selling it as lace made in England. Scholars still debate whether surviving examples were actually made in England or Brussels, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angleterre lace"@en .

aat:300264619 a skos:Concept ;
    skos:definition "Refers to lace made at Chantilly, Oise departement, France, since the 18th century. It is characterized by being delicate, made of silk or linen, and having a six-sided mesh ground and a distinctive floral or scrolled design. Later designs include ribbons, naturalistic flowers, and other designs on a dotted background. Chantilly lace dating from the 19th century was produced in three colors: white, black, and \"blond,\" which was the natural beige color of silk. It was made into large items such as veils, shawls, other of apparel, and household dresser covers and draperies. Chantilly lace was copied in machine lace from 1840 on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chantilly lace"@en .

aat:300264620 a skos:Concept ;
    skos:definition "Refers to a work created by the process of sewing, which is the stitching, fastening, attaching, or joining together of layers or pieces of textiles, leather, or other materials by passing thread, cord, or other filament through the material by means of a needle or awl. It may also refer to materials intended to be sewn or to the stitches or seams of anything that is sewn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing"@en .

aat:300264621 a skos:Concept ;
    skos:definition "Refers to hand sewing characterized by techniques more elaborate than used in plain sewing. It includes embroidery, smocking, and quilting, and other works done with a needle and thread. The purpose of fancy sewing is generally to create decoration rather than to bind pieces of material together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy sewing"@en .

aat:300264622 a skos:Concept ;
    skos:definition "Refers to the process applied to a garment or other piece of fabric, comprising gathering tucks and working the tucks with a simple or decorative stitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smocking"@en .

aat:300264623 a skos:Concept ;
    skos:definition "Refers to stitches or an ornamental pattern formed by embroidering or shirring parallel gathers or regularly-spaced, round tucks of fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smocking"@en .

aat:300264624 a skos:Concept ;
    skos:definition "Refers to loose garments worn over main garments for protection while working, especially coarse linen garments worn by peasants or lower-class workmen over their nicer coats or in the fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smock frocks"@en .

aat:300264626 a skos:Concept ;
    skos:definition "Refers to buildings designed and fitted with machinery for the purpose of performing some task or making a product, including grinding of grain into flour or running a loom to make fabric. For the machinery itself, independent of the building, use \"mills (equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mills"@en .

aat:300264628 a skos:Concept ;
    skos:definition "Refers to machines or mechanical apparatus, either simple or complex, for grinding or reducing a solid substance to a powder or pulp, such as corn or spice. To refer to the combined building and the milling machinery housed within it, use \"mills (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mills"@en .

aat:300264629 a skos:Concept ;
    skos:definition "Refers to the techniques representative of a collection of prehistoric implements of the same age found at one or several related archaeological sites. For the collection of implements, use \"industry (object groupings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industry"@en .

aat:300264630 a skos:Concept ;
    skos:definition "Refers to a collection of prehistoric objects or implements of approximately the same age or era found at one or several related archaeological sites and used as evidence of the origin of the technique that was used to create similar objects. For the style and technique used to produce the implements, use \"industry (technique).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industry"@en .

aat:300264631 a skos:Concept ;
    skos:definition "Describes the works created by the African people of the same name living in Tanzania, mainly on the shores of lakes Malawi and Rukwa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manda"@en .

aat:300264632 a skos:Concept ;
    skos:definition "Refers to a portrait, generally painted, a print, or other two-dimensional media, of a particular size. It is typically around 36 x 28 inches in size and of a distinctive format that is less than half-length, but includes one or both hands. The name derives from the series of members' portraits painted by Godfrey Kneller ca. 1700-1720 for the dining room of the literary Kit-Cat club in London, where the ceiling was too low to allow half-size portraits and Kneller used this unusual format instead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kit-cat"@en .

aat:300264633 a skos:Concept ;
    skos:definition "Refers to pottery characterized by feathering, branching decoration that resembles the markings of moss agate (mocha stone). It was developed in England around 1785 and was popular through the 19th century. It is typically seen on mugs, jugs and other pottery used in taverns or to measure or store dry goods, although it may appear on other items as well. The ornament was made by dabbing the body, either green ware or covered with slip, with a liquid pigment that then spread out through capillary action or by use of a blowpipe. The pigment often included tobacco juice, urine, and metallic oxide; it was generally greenish, brown, black or pink. The body was sometimes first painted with a horizontal banded design in brown, blue or gray slip. The body was generally made of creamware, white or cane-colored earthenware, or pearlware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mocha ware"@en .

aat:300264634 a skos:Concept ;
    skos:definition "Refers to a variety of agate containing brown or black moss- or tree-like dendritic forms. It is typically a grayish to milky-white agate, which is a variety of the silica mineral quartz. It contains opaque, dark-colored inclusions with feathery, branching forms that resemble ferns, moss, or other vegetation but that are in fact of inorganic origin, mainly manganese and iron oxides. Most examples of moss agate are found as fragments of weathered from volcanic rocks from India, Brazil, Uruguay, central Europe, and the western United States. The stone has historically been used for ornamental purposes, often cut in flat or rounded forms, and sometimes dyed to improve its color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moss agate"@en .

aat:300264636 a skos:Concept ;
    skos:definition "Proofs of line or halftone engravings. The proofs should ideally be pulled on the same paper as that on which the job is to be printed. In the 19th century such proofs might be signed \"engraver's.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engraver's proofs"@en .

aat:300264637 a skos:Concept ;
    skos:definition "Trial impressions of a printed image; print impressions from a plate or block, usually before the production of the regular edition, in order to correct, add to, or check the development of a work. Formerly, true proofs referred to proofs made before work on the plate or block is finished. Common since the 18th century are proofs before letters, artist's proofs, remarque proofs, and printers' proofs; such proofs may be deliberately printed to be sold at higher prices, thus are not, in the strictest sense, true proofs. The term is sometimes loosely and incorrectly and used as a synonym for \"impressions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proofs"@en .

aat:300264638 a skos:Concept ;
    skos:definition "Refers to proofs that are corrected by hand by the artist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "touched proofs"@en .

aat:300264639 a skos:Concept ;
    skos:definition "Refers to trial sheets of printed matter that are checked against original manuscripts and on which errors can be corrected and alterations made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proofs"@en .

aat:300264640 a skos:Concept ;
    skos:definition "Prints made from a design cut in vinyl blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinylcuts"@en .

aat:300264641 a skos:Concept ;
    skos:definition "Color prints made using a combination printing process involving an intaglio, or occasionally lithographic, key plate which prints the image, after which color is superimposed on the print using wood blocks. The process was patented by an Englishman, George Baxter, in 1835, and was very popular up into the 1870s. This term refers to prints of this process not made by Baxter himself; the term Baxter prints is sometimes used to refer exclusively to prints made by Baxter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baxter-process prints"@en .

aat:300264642 a skos:Concept ;
    skos:definition "Refers to wood engravings with one or two tints from wood blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinted wood engravings"@en .

aat:300264643 a skos:Concept ;
    skos:definition "Refers to lithographs made from zinc plates by the process of zincography. The term is adopted from the French who make a distinction between lithographs made on stone and those made on zinc; the two types of print can rarely be distinguished from their appearance and so the distinction is rarely made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zincographs"@en .

aat:300264644 a skos:Concept ;
    skos:definition "Refers to lithographs made from aluminum plates; the term is not commonly used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "algraphs"@en .

aat:300264645 a skos:Concept ;
    skos:definition "Refers to color relief prints where the printing surface has been taken apart for separate inking and then reassembled for printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relief compound prints"@en .

aat:300264646 a skos:Concept ;
    skos:definition "Refers to prints made by combining carborundum with synthetic resin or varnish; this mixture is then hardened on a plastic or metal support and various heated tools are used to cut lines. This type of print was invented in the 1960s by the French artist Henri Goetz (1909-1989), who noticed that carborundum provided an ink-holding 'tooth.' Many corborundum prints resemble intaglio prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carborundum prints"@en .

aat:300264647 a skos:Concept ;
    skos:definition "Prints in which powdered sulphur is used to give tone to a plate coated with a layer of oil. Sulphur prints are similar to aquatints and feature extremely fine, delicate tones or tints. Many sulphur prints date to the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulphur prints"@en .

aat:300264648 a skos:Concept ;
    skos:definition "Prints produced by the sugar-ground etching process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar-ground etchings"@en .

aat:300264649 a skos:Concept ;
    skos:definition "Prints produced by the salt-ground etching process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt-ground etchings"@en .

aat:300264650 a skos:Concept ;
    skos:definition "A printing process in which tone is added to a major part of the print by sprinkling granulated salt on the ground while it is still hot and liquid. Once the plate is cold and the salt has been rinsed away, a random pattern of pits of varied depth is left behind and will create corresponding clusters of black dots on the resulting print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt-ground etching"@en .

aat:300264651 a skos:Concept ;
    skos:definition "A printing process in which tone is added to a major part of the print by sprinkling granulated sugar on the ground while it is still hot and liquid. Once the plate is cold and the sugar has been rinsed away, a random pattern of pits of varied depth is left behind and will create corresponding clusters of black dots on the resulting print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar-ground etching"@en .

aat:300264652 a skos:Concept ;
    skos:definition "A printing process in which sandpaper is laid face down on the grounded plate and the two are passed together through an intaglio press. The result is an etching ground perforated all over with the granular texture of the sand which will translate to small black dots on the finished print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand-grain etching"@en .

aat:300264653 a skos:Concept ;
    skos:definition "Prints produced by the sand-grain etching process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand-grain etchings"@en .

aat:300264654 a skos:Concept ;
    skos:definition "Refers to modern prints produced by the sand-grain mezzotint process, by which a mezzotint-like tone is achieved from sandpaper grain. The process was developed in the 20th century as a way to avoid the laborious process of rocking the plate. Such prints will have the general quality of a mezzotint but will not show in the lighter areas the straight lines of the rocker's serrated edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand-grain mezzotints"@en .

aat:300264655 a skos:Concept ;
    skos:definition "A printing process developed in the 20th century in which mezzotint-like tone is achieved from sandpaper grain. The process was developed as a way to avoid the laborious process of rocking the plate. The plate is passed through the press several times with a sheet of sandpaper; the grains of sand physically displace dots of copper, forming ink-retaining burrs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand-grain mezzotint"@en .

aat:300264656 a skos:Concept ;
    skos:definition "A printing process developed in the 20th century in which mezzotint-like tone is achieved by roughening the surface of the plate with abrasives. The process was developed as a way to avoid the laborious process of rocking the plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carborundum mezzotint"@en .

aat:300264657 a skos:Concept ;
    skos:definition "Refers to modern prints produced by the carborundum mezzotint process, developed in the 20th century and by which mezzotint-like tone is achieved by roughening the surface of the plate with abrasives. Such prints will have the general quality of a mezzotint but will not show in the lighter areas the straight lines of the rocker's serrated edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carborundum mezzotints"@en .

aat:300264658 a skos:Concept ;
    skos:definition "An informal group of painters that was centered in the village of Barbizon around the edge of the Forest of Fontainebleau. Influenced by John Constable and 17th century Dutch landscape painters, the Barbizon painters were concerned with depicting naturalistic settings and the dignity of peasant life. Theodore Rousseau, the unofficial leader of the School, moved to the Fontainebleau region in 1841 and began acquiring disciples, such as Jean-Francois Millet, who would later become the most renown member of the Barbizon School, and whose work had more overt socialist overtones. Because of their non-traditional approach to subject matter, it took until the 1850's for the individual members of the School to become critically accepted. Rousseau, in fact, had been rejected by the Salons so often he garnered the nickname 'le grande refuse'. After several decades of success, the movement lost popularity with Millet's death in 1875. Though often seen as a transitional movement between classical landscape painting and Impressionism, the Barbizon School's importance lies with their plein-air landscape technique and humble, unpretentious subject matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barbizon School"@en .

aat:300264659 a skos:Concept ;
    skos:definition "A movement among French painters of the 1920s and 1930s that manifested in reaction to then current, modern movements such as Surrealism and Cubism. Essentially an attempt to bridge modernism with academicism with an emphasis on normally perceived reality, the movement was unofficially led by Dunoyer de Segonzac. Other artists associated with the movement were Robert Lotiron, Raymond-Jean Legueult, Charles Dufresne and Luc-Albert Moreau. Néo-Réalisme is not connected with the later movement known as Nouveau Réalisme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Néo-Réalisme"@en .

aat:300264660 a skos:Concept ;
    skos:definition "Beads arranged in strings and used in praying, such as the beads of a rosary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer beads"@en .

aat:300264661 a skos:Concept ;
    skos:definition "Refers to strings of Muslim prayer beads in which units of 99, 33, or other numbers, represent the names of God; they are thought to have originated in Persia. They are typically made of made of wood, bone, or precious stones, with the ends bound together. As the beads are touched one by one, Muslims may recite any of numerous formulas, the most common being \"Glory to Allah.\" Also, since prayer may also be recited in the secret of one's heart, a person can multiply his praises of God by merely moving the beads through his fingers while engaged in conversation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subhahs"@en .

aat:300264662 a skos:Concept ;
    skos:definition "Refers to strings of beads or knots for counting prayers, one third of the length of a rosary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chaplets"@en .

aat:300264663 a skos:Concept ;
    skos:definition "Describes the art of the Picts, the inhabitants of what is now northern and eastern Scotland from Caithness to Fife in the years between the Roman occupation of Britain (mid-1st century BCE) and the 9th century. Their use of tattooing may derive from the Roman name of Picti, or painted people. Pictish art is notable for the stylized but vigorous beauty of its carved memorial stones and crosses. Some silverwork is also known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pictish"@en .

aat:300264665 a skos:Concept ;
    skos:definition "Refers to views that look out to a distance, usually extensive or commanding views of landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prospects"@en .

aat:300264666 a skos:Concept ;
    skos:definition "In the visual arts, refers to views or pictures that depict a place, episode, situation, incident, series of actions, or events, or objects. It is derived as a metaphorical use of \"scenes\" in the theatrical sense of a subdivision of a play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scenes"@en .

aat:300264667 a skos:Concept ;
    skos:definition "Visual works, often tableware, plated with high quality silver or gold. The term is used more correctly for silverwork alone, but sometimes used loosely for goldwork as well. For the layer of metal or any kind deposited upon a metal base, for purposes of decoration or to impart desirable physical or chemical properties, use \"plate (material).\" Plate the visual work is often created with plate the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plate"@en .

aat:300264668 a skos:Concept ;
    skos:definition "Those trained and working in the field of study and practice that falls between and overlaps architecture and urban and regional planning, and whose concern is the specific design and contextual integration of urban buildings and spaces; includes expertise in, for example, landscape architecture, urban sociology, environmental psychology, and law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban designers"@en .

aat:300264669 a skos:Concept ;
    skos:definition "Introduced in 1971, Super 16mm motion picture film has a picture area 40-46% larger than standard 16mm film. It is often used with the intention to blow the film up to 35mm for theatrical release, as Super16mm production costs are less expensive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Super 16mm"@en .

aat:300264670 a skos:Concept ;
    skos:definition "Motion picture film with a 65-millimeter width, with sprocket-holes on both sides. Often transferred to 70mm projection film, for theatrical release."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "65mm"@en .

aat:300264671 a skos:Concept ;
    skos:definition "Trademarked name for a motion picture camera and projection system developed by Paramount Studio technicians that ran standard 35mm film horizontally through a projector, doubling its size. It was used for approximately 70 films between 1954 and 1961."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "VistaVision (TM)"@en .

aat:300264672 a skos:Concept ;
    skos:definition "Projection print film, 70 millimeters wide, with sprocket holes on both sides. Motion pictures shot on 35mm or 65mm can be transferred and enlarged to 70 millimeter film, for widescreen theatrical screening and distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "70mm"@en .

aat:300264673 a skos:Concept ;
    skos:definition "A red powder derived from turmeric, used for making the mark on the forehead in the Hindu religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kumkum"@en .

aat:300264674 a skos:Concept ;
    skos:definition "Type of moss commonly found in the southern United States, characterized by tufts of grey strands on the trunks and branches of trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish moss"@en .

aat:300264675 a skos:Concept ;
    skos:definition "Film footage inserted into a motion picture that was originally shot for another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "found footage"@en .

aat:300264676 a skos:Concept ;
    skos:definition "A link with a screw-thread at one end and a swivel at the other, used for tightening a rod or stay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turnbuckles"@en .

aat:300264677 a skos:Concept ;
    skos:definition "Optical disks used primarily for storing video and data; they are the same size as compact discs, but designed to hold approximately seven times more digital information, including multiple layers. DVDs are generally one-sided, and hold 4.7 gigabytes of information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DVDs"@en .

aat:300264679 a skos:Concept ;
    skos:definition "Describes videotape 8mm in width, used primarily for home use in hand-held cameras or camcorders. The resolution quality for 8mm videotape is 240 lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "8mm"@en .

aat:300264680 a skos:Concept ;
    skos:definition "Wool shorn from a lamb seven to eight months old."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamb's wool"@en .

aat:300264681 a skos:Concept ;
    skos:definition "Paper made in Mexico and Central America from bast fibers of amate Ficus trees, such as Ficus petolaris; also reportedly made from majirey cactus fibers (Sahgum 1963) or naturalized mulberry trees fibers (Lenz 1961). The fibers are scraped from inside the bark of the tree, boiled, then beaten and felted into sheets. The paper was often polished with stones to produce a smooth surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amate paper"@en .

aat:300264682 a skos:Concept ;
    skos:definition "8mm videotape with approximately 400 lines of resolution, generally for camcorder use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hi-8"@en .

aat:300264683 a skos:Concept ;
    skos:definition "Standard size and format for consumer-level analog recording on videotape cassettes. Describes a videotape one-half inches in width (12.7mm); this videotape format, known primarily as VHS (Video Home System), was developed in the 1970s for use with home videocassette recorders. It contains 240 lines of horizontal resolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "VHS"@en .

aat:300264684 a skos:Concept ;
    skos:definition "One-half inch videotape with a higher resolution (400 horizontal lines) than standard VHS tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Super-VHS (TM)"@en .

aat:300264685 a skos:Concept ;
    skos:definition "Describes videotape with a width of 3/4 inches (19.7mm). Used professionally for many years until more compact formats with better resolution appeared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "3/4-inch"@en .

aat:300264686 a skos:Concept ;
    skos:definition "Describes videotape one-half-inch wide, for professional use, with higher resolution than standard VHS, Super-VHS or other, earlier analog video types. Originally developed by Sony and introduced in 1982."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betacam (TM)"@en .

aat:300264687 a skos:Concept ;
    skos:definition "Betacam videotape for professional use, one-half-inch in size, with stronger resolution than standard Betacam. Introduced in 1987 by Sony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betacam-SP"@en .

aat:300264688 a skos:Concept ;
    skos:definition "Betacam videotape with digital quality resolution. Introduced by Sony in 1993."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Digital Betacam (TM)"@en .

aat:300264689 a skos:Concept ;
    skos:definition "Decribes videotape with a one-inch width (25.4mm). Formerly a professional format, rarely used today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "1-inch"@en .

aat:300264690 a skos:Concept ;
    skos:definition "Digital videotape format for digital video recording and playback with excellent resolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mini-DV"@en .

aat:300264691 a skos:Concept ;
    skos:definition "General term for any low-growing tree or other woody plant that produces several stems from the base. The term is also used specifically for scrubland vegetation found in southern Australia typically composed primarily of woody shrubs and trees of the genus Eucalyptus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mallee"@en .

aat:300264692 a skos:Concept ;
    skos:definition "Refers to small loops of twisted thread, larger than the purl, generally appearing in a series to form an ornamental edging on lace, ribbon, or braid. In embroidery, the term may also refer to a raised knot similarly formed to represent a leaf, petal, ear of corn, or other similar shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picots"@en .

aat:300264693 a skos:Concept ;
    skos:definition "Refers to a darned net worked in silk or flax on an open, woven gauze ground. It is a variant kind of filit lace and one of the earliest types of lace. It is characterized by a twisted net background running in one direction and single thread running in the other direction; designs are sewn over the square grid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burato"@en .

aat:300264694 a skos:Concept ;
    skos:definition "Refers to lace made in Armenia, Cyprus, Turkey, and the Greek Islands, and characterized by the use of a single needle and traditional techniques and stitches. Designs and stitches vary in different regions, but in general it is characterized by extreme delicacy and intricacy of design. It often is made with silk thread and includes gold threads and is decorated with pearls and various precious gems. It was particularly popular in the 17th century, and was used in lace borders on apparel, as chalice covers, and on other liturgical linen. Some scholars believe that Venetian lace has its origins in 16th-century Armenian lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian lace"@en .

aat:300264695 a skos:Concept ;
    skos:definition "Refers to openwork embroidery that uses eyelets, which are small holes bound by satin stitches, as a main design element. It is typically worked in cotton; it usually forms edgings for apparel or household linens. The holes, or eyelets, are grouped in patterns that are further delineated by simple embroidery stitches on the surrounding material. The work is generally done with white thread on white fabric. The technique originated in 16th-century Europe; it was not confined to England as its name would imply. In the 19th century it was commonly used on nightwear and underclothing. Modern broderie anglaise is generally done by machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broderie anglaise"@en .

aat:300264696 a skos:Concept ;
    skos:definition "Refers to works of delicate knitting in which, instead of yarn, much finer threads are used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitted lace"@en .

aat:300264697 a skos:Concept ;
    skos:definition "Refers to Venetian lace made on the island of Burano in the 19th century and later. While it is a relatively delicate lace, it is characterized by patterns that are not as delicate as earlier Venetian lace, and a background without bars or brides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burano lace"@en .

aat:300264698 a skos:Concept ;
    skos:definition "Refers to works created in linen or another fabric on which a design is produced by drawing threads out of the body of a piece of material to create a mesh, and then stitches are worked on the mesh. It was highly developed in Italy and preceded the development of needle lace in the 16th century. It continued to be created in many nations, and commonly appears as a standard needlework type on embroidery samplers from the 17th century onward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawn thread work"@en .

aat:300264699 a skos:Concept ;
    skos:definition "Refers to a type of embroidery that is drawn thread work done in white thread on white material. It is characterized by being worked in fine muslin, on which a variety of drawn fabric stitches are combined with designs of floral sprigs and other motifs executed in satin stitches so that the effect is somewhat akin to lace. Work of this type was know in 13th-century Germany and other places, but it is named after the shire or county of Ayr, Scotland, where the work was produced from 1780 on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayrshire whitework"@en .

aat:300264700 a skos:Concept ;
    skos:definition "Refers to a bobbin-made lace that is characerized by simple geometric patterns and relatively coarse designs. It typically made by peasants in many European countries; it is noted as one of the mainstays of the lace makers of the Austrian Tirol and as the type of lace on which apprentices generally begin learning lace-making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torchon lace"@en .

aat:300264701 a skos:Concept ;
    skos:definition "Refers to small stitches applied at regular intervals to fasten a length or design of thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couched stitches"@en .

aat:300264702 a skos:Concept ;
    skos:definition "Generally, water dedicated to sacred uses and used for ritual purification of persons and things. More specifically, water blessed by a priest and used in various rites and devotional acts, such as baptisms and blessings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy water"@en .

aat:300264703 a skos:Concept ;
    skos:definition "Texts having to do with devils, devil-lore, or the description or representation of devils. The term may refer to any representations in words or pictures of black magic or of dealings with the devil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diableries"@en .

aat:300264704 a skos:Concept ;
    skos:definition "Systems developed to project motion picture film onto a screen, operating by passing a beam of light through moving, exposed film, and throwing the image onto a screen, thereby enlarging it to fit theater and screen size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film projection systems"@en .

aat:300264705 a skos:Concept ;
    skos:definition "In Ethiopian culture, parchment scrolls upon which various taslismanic images and texts, often prayers, are inscribed, generally by clerics in complex rituals. Their purpose is in healing ceremonies. Sick people focus on the scroll, and enter into a healing trance by which they are cured; they may wear the scrolls for a time. The images that appear on the scrolls range from Jewish, Christian, and Islamic religious symbols, the story of King Solomon, lions, birds, and abstract talismanic patterns to the most frequently depicted symbols, large, colorfully-rendered eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magic scrolls"@en .

aat:300264706 a skos:Concept ;
    skos:definition "Brand name of a floor or grounds covering made of vinyl and nylon made to resemble turf. Used primarily on athletic playing fields and on outdoor patios."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Astroturf (TM)"@en .

aat:300264707 a skos:Concept ;
    skos:definition "Photogravures differing from the ordinary type in that they are made using an aquatint grain and only one density of etching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoaquatints"@en .

aat:300264708 a skos:Concept ;
    skos:definition "Refers to at type of tall and mainly concave-sided lekythoi that developed in the 5th century BCE. It is a common form in black-figure. It features a mouth and neck resembling an old-fashioned chimney pot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimney lekythoi"@en .

aat:300264709 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name, living in the Darfur region of Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahria"@en .

aat:300264710 a skos:Concept ;
    skos:definition "A type of chevron bead carried by the Spaniards for trade to the New World, and first identified in an archeological site in Venezuela, from which they derived their name \"Nueva Cadiz,\" an island which was a prosperous port from 1498-1545. They are usually made from three twisted layers of blue glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nueva Cadiz beads"@en .

aat:300264711 a skos:Concept ;
    skos:definition "Money in the form of bells, either functional bells or items in the shape of bells. Bells have been used as money in many different cultures, such as the Maya of Central America, in Nigeria, and elsewhere in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell money"@en .

aat:300264715 a skos:Concept ;
    skos:definition "Money is the form of metal gongs, used in various parts of Africa such as the Congo region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gong money"@en .

aat:300264716 a skos:Concept ;
    skos:definition "African metal money in the form of throwing-knife blades; particularly well-known in sub-Saharan Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing knife money"@en .

aat:300264717 a skos:Concept ;
    skos:definition "Metal money in the form of metal wire, often copper or brass, cut in lenghts and stored in bundles or loose, introduced into Africa by European traders as trade money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire money"@en .

aat:300264718 a skos:Concept ;
    skos:definition "The nestoride is a vessel type of native southern Italian origin. The name \"nestoride\" was devised by 19th-century scholars attempting to identify a vase with the cup of nestor. Nestorides are a continuation of a previous vessel type known as the trozzella which was named after the disks attached to the vessel's horizontal handles. The nestoride is a distinct form because of its tall side handles. Images of nestorides on southern Italian red-figure vases suggest that nestorides were used primarily as storage vessels like stamnoi or amphorae but there were also smaller nestorides that were similar in function to kantharoi in that they served as drinking vessels. Nestorides were most commonly made in Lucania and Apulia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nestorides"@en .

aat:300264719 a skos:Concept ;
    skos:definition "A form of carbon black that is produced in refractory chambers in the absence of air by the decomposition of acetylene gas preheated to 800 degrees Celsius. As a pigment, it is softer, bluer, and more intense than other carbon blacks. It is also used in industrial applications requiring high electrical conductivity, such as in dry cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetylene black"@en .

aat:300264720 a skos:Concept ;
    skos:definition "Element that forms the framework for all tissues of plants and animals. Chemical symbol C and atomic number 6. Carbon may appear in many forms, including diamond, graphite, charcoal, carbon black, and fullerene. High quantities of carbon occur in coal, coke, oil, gasoline, and natural gas. Proteins such as hair, meat, and silk contain carbon and other elements. More than six and a half million compounds of the element carbon exist, including sugar, starch, and paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon"@en .

aat:300264721 a skos:Concept ;
    skos:definition "A form of carbon black that is produced from benzene, which in turn is obtained chiefly from coke-oven gas. As a pigment, it is softer, bluer, and more intense than other carbon blacks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benzol black"@en .

aat:300264722 a skos:Concept ;
    skos:definition "A form of carbon black that is an aniline pigment, in which a primary aromatic amine, aniline, is converted into a diazonium salt that is an intermediate in the preparation of dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamond black"@en .

aat:300264723 a skos:Concept ;
    skos:definition "A form of carbon black that is created by burning coal tar, mineral oils, or another such material, to produce a rather inferior grade of carbon. As a pigment, it is brownish in color and likely to contain oily impurities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flame black"@en .

aat:300264724 a skos:Concept ;
    skos:definition "A form of carbon black that is created by burning natural gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas black"@en .

aat:300264725 a skos:Concept ;
    skos:definition "Various kinds of carbon black that is produced by burning plant material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable black"@en .

aat:300264727 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Algeria, Mauritania, and Morocco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Regeibat"@en .

aat:300264728 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gamo"@en .

aat:300264729 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyuswa"@en .

aat:300264730 a skos:Concept ;
    skos:definition "Funerary figures, similar to the cloth-covered funerary figures of the Bwende, known as niombo, but smaller in size and not as widely used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kimbi"@en .

aat:300264735 a skos:Concept ;
    skos:definition "Refers to a decorative border for tapestries, first developed at the Gobelins tapestry manufactory in around 1714, probably with the Don Quixote series of tapestries designed by Coypel. It is characterized by simulating a thick, rich damask border that surrounds a relatively small scene. The border is typically decorated with trompe l'oeile garlands of ribbons, flowers, animals, ropes, or fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alentours"@en .

aat:300264736 a skos:Concept ;
    skos:definition "Period and styles of painting, sculpture, graphic arts, and architecture dating from the late 19th century to the present date and characterized by a rejection of traditional artistic forms and conventions. It typically reflects changing social, economic, and intellectual conditions. Modern art includes numerous movements and theories. It differs from contemporary art, which does not carry the implication of a non-traditional style, but instead refers only to the time period in which the work was created. 'Modern' and 'contemporary' are inherently fluid terms. The term 'modern' sometimes more narrowly refers to art up until the 1960s or 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modern"@en .

aat:300264737 a skos:Concept ;
    skos:definition "Period and styles of painting, sculpture, graphic arts, and architecture dating from the recent past and present. It differs from modern art in that the term 'Contemporary art' does not carry the implication of a non-traditional style, but instead refers only to the time period in which the work was created. 'Modern' and 'Contemporary' are inherently fluid terms. The term 'Contemporary' is sometimes more narrowly used to refer to art from ca. 1960 or 1970 up to the present. To refer to the current time period without reference to style of art, use \"contemporary (generic time frame)\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Contemporary"@en .

aat:300264738 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Darasa"@en .

aat:300264739 a skos:Concept ;
    skos:definition "Refers to depictions in photographs, paintings, other still images, or motion pictures that show a view or detail of a subject that is far closer than is typical, as when macro and micro lenses are used in photography. They typically isolate the details of an object, for example, an eye on a human face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extreme close-ups"@en .

aat:300264740 a skos:Concept ;
    skos:definition "Refers to dipictions with a vantage point above the subject, such as from the ceiling of an interior, but not so high as in a bird's-eye view or an aerial view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overhead views"@en .

aat:300264741 a skos:Concept ;
    skos:definition "Refers to depictions containing a partial view that focuses on a particular detail of the whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detail views"@en .

aat:300264743 a skos:Concept ;
    skos:definition "Refers to depictions with a point of view from the side of the subject, as contrasted to depictions taken from the back or front. For views of figures taken from the side, use \"profiles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side views"@en .

aat:300264744 a skos:Concept ;
    skos:definition "Refers to depictions with a point of view from in front of the subject, as contrasted to depictions taken from the side or back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "front views"@en .

aat:300264745 a skos:Concept ;
    skos:definition "Refers to depictions of the back of the subject, as contrasted to depictions of the side or front of the subject. For views from the vantage point of the subject, looking backwards, use \"rear views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back views"@en .

aat:300264746 a skos:Concept ;
    skos:definition "Refers to dipictions with a vantage point below the subject, but not so low as in a worm's-eye view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "views from below"@en .

aat:300264748 a skos:Concept ;
    skos:definition "Heavy wooden squares made to enclose the neck of a human being, so that he or she cannot lie down, feed her/himself, or touch her/his head. They were used in the past in China and Chinese-influenced countries to punish people for petty offences. The offender's name and crime were inscribed upon the wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cangues"@en .

aat:300264753 a skos:Concept ;
    skos:definition "Artists or craftsmen who paint directly on fabric with the goal of decorating drapery, banners, or another textile. The term does not refer to artists who create oil paintings or paintings in another media on canvas or another fabric, where the goal is to create a scene or other work of art that will be displayed in a frame or hung on a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric painters"@en .

aat:300264755 a skos:Concept ;
    skos:definition "Depictions rendered from a vantage point directly above the object, building, or site, but not so high as an \"overhead view.\" For depictions specifically of a building or site from above, prefer \"plan views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "top views"@en .

aat:300264756 a skos:Concept ;
    skos:definition "Depictions as if from the point of view of the subject, looking backwards. For depictions of the back of a subject, use \"back views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rear views"@en .

aat:300264757 a skos:Concept ;
    skos:definition "Describes the style and culture of the inhabitants of the Massim area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Massim Area regional style"@en .

aat:300264758 a skos:Concept ;
    skos:definition "Architectural styles belonging to Massim Area cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Massim Area sculptural styles"@en .

aat:300264759 a skos:Concept ;
    skos:definition "The Massim style is a stylized, curvilinear and geometric low relief carving, which can be glazed with lime to develop a contrast against the dark wood or painted with colorful patterns. The three types of incised designed utilized in the Massim style are 'motifs,' 'fillers' that fill in the space around a motif, and 'dividers' that create spatial divisions in the piece. This style is used by the inhabitants of the Massim area in Papua New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Massim style"@en .

aat:300264760 a skos:Concept ;
    skos:definition "Refers to Medieval monumental crosses, usually of stone, used to mark an outdoor place, typically a sacred place, a burial spot, or an assembly point in the Celtic lands of Ireland, Scotland or elsewhere. They are generally inscribed or decorated in low relief in the Celtic style, influenced by Viking art. The form is typically the Latin cross with a ring around the point of vertical and horizontal intersection; however, some of the oldest examples are single stone pillars that have been decorated and inscribed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic crosses"@en .

aat:300264761 a skos:Concept ;
    skos:definition "The X-ray style is native primarily to the Australian region of Arnhem Land. It is an Aboriginal rock art style estimated to have developed ca. 2000 BCE and is still produced today. It consists of illustrating the silhouette of an animal or human figure along with internal details. Paintings are found in shallow caves, rock shelters, and isolated locations. The artist began by painting a silhouette of the figure, often in white, and then adding the internal details in red or yellow. For red, yellow, and white paints, the artist uses natural ocher pigments mined from mineral deposits, while black is derived from charcoal. Early X-ray images depict the backbone, ribs, and internal organs of humans and animals. Later examples also include features such as muscle masses, body fat, optic nerves, and breast milk in women. Some works created after European contact even show rifles and ships with bullets and cargo inside them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "X-ray style"@en .

aat:300264762 a skos:Concept ;
    skos:definition "The Bradshaw style is considered one of the most ancient recorded rock art styles. This monochromatic rock art is found in the Kimberleys region of Australia in isolated locations. Bradshaw style paintings depict animated human figures in black, white, and red ochre; the figures are drawn as though frozen in movement. Two phases can be detected within Bradshaw art, characterized by different headdresses, artefacts, and poses. Later Bradshaw art of the Kimberleys is very similiar to the Lewis Stick period in the rock art of Western Arnhem Land. These artworks remain undated due to deterioration of pigment, although current research determines the paintings to be about 17,000 years old."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bradshaw"@en .

aat:300264763 a skos:Concept ;
    skos:definition "The Wanjina style is considered one of the most ancient recorded rock art styles. These works in this style are found in the north-central Kimberleys region of Australia in isolated locations. Wanjina style rock paintings depict round-headed human figures outlined with red ochre, specifically around the head. The figures typically have prominently defined eyes and noses, but lack a mouth. Wanjina style figures vary in size between less than forty centimeters to more than three meters in length. This style also depicted animal figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wanjina style"@en .

aat:300264764 a skos:Concept ;
    skos:definition "Refers to art works created by scratching or engraving a design into a board or other surface that has been prepared by covering with ink, so that the color of the board shows through the scratched design. Colored wax or paint may be applied to create a design on any paper board, or the board may be commercially produced \"scratchboard.\" India ink is often used to cover the wax or paint. A stylus or other sharp instrument is generally used to scratch or scrape away the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratch art"@en .

aat:300264765 a skos:Concept ;
    skos:definition "Panaramittee is a rock art style found throughout the Australian continent, although primarily practiced in the New South Wales region. The style is generally composed of both figurative and nonfigurative rock engraving including bird and animal tracks and small pecked motifs such as circles, crescents, and radiating lines, which are occasionally enclosed in rings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panaramittee"@en .

aat:300264769 a skos:Concept ;
    skos:definition "The Dynamic style is one of the most ancient recorded rock art styles. The artworks are found in the western Arnhem Land region of Australia in isolated locations. Dynamic style rock paintings depict small, red, animated human stick figures that are typically involved in hunting, fighting and ceremonial scenes. These ornamented figures are represented carrying weapons and are occasionally drawn with animal heads. Aboriginal Australians often describe these figures as representations of Mimi, a long, thin, trickster spirit which lives in the crevices of caves and other isolated locations. These figures vary in size between 200 and 300 millimeters in height. Although the exact date of the style is unknown, it is estimated to be several thousand years old."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dynamic style"@en .

aat:300264770 a skos:Concept ;
    skos:definition "Geometric or figural engraving into the bark of living trees. The carving is typically executed using a metal instrument. Dendroglyphs are a distinctive form of sculpture of the Aboriginal Australians made to mark ceremonial grounds or the graves of notable individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dendroglyphs"@en .

aat:300264771 a skos:Concept ;
    skos:definition "Monolithic stone figures carved of volcanic tuff, a soft volcanic stone. On average, the moai sculptures stand 13 feet high and weigh 14 tons. The moai represent the Easter Island ancestral chiefs whose supernatural power protected the community. The common structure of the moai consists of a trunk, engraved, inset arms and an angular head. Monumental moai figures are the most common and well known of Easter Island art, although various sizes and styles of moai do exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moai"@en .

aat:300264772 a skos:Concept ;
    skos:definition "Glyphs carved on wooden tablets or board found on Easter Island and believed to be part of a boustrophedon writing system utilized as ceremonial mnemonic devices. All deciphering attempts of the rongo-rongo have failed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rongo-rongo"@en .

aat:300264773 a skos:Concept ;
    skos:definition "Sculpture styles belonging to Oceanic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oceanic sculpture styles"@en .

aat:300264774 a skos:Concept ;
    skos:definition "Describes a carving and painting style that is composed of a curving line used to form abstract patterns, such as spirals, circles, swirls, S-shapes, concentric rings, and wavy lines, as well as to accentuate human facial features. These carvings are primarily found in the Oceanic region of New Zealand and Papua New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Curvilinear style"@en .

aat:300264775 a skos:Concept ;
    skos:definition "Ceramic styles belonging to Oceanic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oceanic ceramic styles"@en .

aat:300264776 a skos:Concept ;
    skos:definition "An early ceramics style that is features elaborate geometric motifs on a range of vessel shapes and distributed widely throughout Oceanic cultures. The distinct patterns were created using a toothed stamp of a single design element that is combined with other stamps to form a pattern. These designs occasionally include anthropomorphic faces and figures. In addition to vessels, freestanding Lapita pottery figures depicting human and animal subjects have also been unearthed. The style is named after a site in New Caledonia and an ancient Pacific culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lapita"@en .

aat:300264777 a skos:Concept ;
    skos:definition "Buildings that house graduate schools of a college or university in which medicine is taught."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medical schools"@en .

aat:300264778 a skos:Concept ;
    skos:definition "Buildings that house graduate schools that teach law and the legal profession, with the object of producing professional lawyers, scholars of law, or other professionals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law schools"@en .

aat:300264779 a skos:Concept ;
    skos:definition "Describes the style and culture of the aboriginal Warlpiri people of central Australia. The Warlpiri people are well recognized for their sand drawings, which are an informal element of ancestral storytelling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Warlpiri"@en .

aat:300264780 a skos:Concept ;
    skos:definition "Abstract sculptures without moving parts, as oppose to a mobile. The term was coined in 1931 by Jean Arp to describe the stationary work of the artist Alexander Calder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stabile"@en .

aat:300264781 a skos:Concept ;
    skos:definition "Kuruwarri is an exclusively male ceremony of the aboriginal Warlpiri people. These ceremonies include sand designs during story telling to represent the presence of ancestral beings or the procreative strength of their ancestors. Although primarily drawn into sand, these designs may be incised into wood or stone as well as painted onto bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuruwarri"@en .

aat:300264782 a skos:Concept ;
    skos:definition "Yawulyu is an exclusively female ceremony of the aboriginal Warlpiri people. Sand designs are used during story telling to represent concerns of sexuality, fertility, and well-being, as well as the presence of ancestral beings during ceremonies. Although primarily drawn into sand, these designs may be incised into wood or stone as well as painted onto bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yawulyu"@en .

aat:300264783 a skos:Concept ;
    skos:definition "Rock art styles belonging to Kimberleys cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kimberleys rock art styles"@en .

aat:300264784 a skos:Concept ;
    skos:definition "Narrative ceremonial dance cycles practiced by the inhabitants of the eastern Kimberleys region of Australia. The narrative dance is based on the cyclone and serves as a way of explaining such events to the general population. Painted boards and threaded crosses are carried behind the dancers head while performing. The type of material utilized for the dances changes depending of the context of the story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palga"@en .

aat:300264785 a skos:Concept ;
    skos:definition "Rock art styles belonging to Arnhem Land cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arnhem Land rock art styles"@en .

aat:300264786 a skos:Concept ;
    skos:definition "Thin, complex, crosshatched patterns found in Arnhem Land bark and body paintings. The pattern is not only a decorative element of bark and body painting, but also a symbol of ancestral pride and a form of clan identification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rarrk"@en .

aat:300264787 a skos:Concept ;
    skos:definition "Rock art styles found throughout the Australian continent. Collocates rock art styles found throughout the Australian continent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australian rock art styles"@en .

aat:300264788 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of the state of South Australia. It is well known for its production of toas, figurative direction-markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Australian"@en .

aat:300264789 a skos:Concept ;
    skos:definition "South Australian carved sculptures made of wood, gypsum, and ochre, which function as direction-markers. These sculptures were placed in the ground to indicate which particular tribal group inhabited the site or in which direction they could be found. The aboriginal Australians named Diyari constructed these innovative signposts at the Lutheran Mission at Killalpaninna between 1903 and 1906. Toas are not a traditional form of sculpture; it is believed that the production of toas was by the request of Europeans interested in aboriginal culture. Toas were only produced in the South Australian state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toas"@en .

aat:300264790 a skos:Concept ;
    skos:definition "Works of a specific iconographic type, depicting the Virgin Mary and Christ Child enthroned in the center with saints and angels in adoration to each side. The type developed in Italy in the 13th century and was based on earlier Greek types. Works of this type are typically two-dimensional, including painted panels (often altarpieces), manuscript illuminations which imitate panels, and occasionally low-relief carvings that also imitate the panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maestà"@en .

aat:300264791 a skos:Concept ;
    skos:definition "Describes the culture and style of the Pitjantjara people of Australia. The Pitjantjara women have earned international fame for their batik designs, which they refer to as raiki wara or Ernabellaku Walka. They create textiles, prints, and carvings for the local community and the international market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pitjantjara"@en .

aat:300264793 a skos:Concept ;
    skos:definition "Long pieces of wood carved on the upper end with a human figure with a large phallus and a central section wrapped with bark cloth or containing several carved horizontal figures. They often vary in size, ranging between 0.76 meters and 5.5 meters in length. The images on the staff gods emphasize the notion of male procreation power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staff gods"@en .

aat:300264795 a skos:Concept ;
    skos:definition "Pointed wooden peg sculptures carved with a human head at the upper end. The function of god sticks is to act as containers for the divinities to enter during rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "god sticks"@en .

aat:300264796 a skos:Concept ;
    skos:definition "Refers to carved and painted wooden sculptures found in northern and central New Ireland. These figures function as a representation of ancestral or mythological beings during secret ceremonies known by the same name. The sculptures have clearly defined anatomies and sharply sculptured facial features, which give the figures a threatening appearance. Both male and female uli have exaggerated sexual organs and legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uli"@en .

aat:300264799 a skos:Concept ;
    skos:definition "Describes the culture and style of the inhabitants of Oronga, a region of Easter Island. Orongo artwork is well known for its rock art carving, which contain an almost three-dimensional quality. There are numerous carvings of birdmen, commemorating the annual ceremony dedicated to selecting an island king."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orongo"@en .

aat:300264801 a skos:Concept ;
    skos:definition "Maori storehouses, typically raised off the ground; used to keep preserved food, seed, mats, weapons, agricultural tools, fishing equipment, or other goods;, Often decorated, the carvings on the storehouses serving as elaborate designs that advertise the village wealth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pātaka"@en .

aat:300264803 a skos:Concept ;
    skos:definition "Sculpture styles belonging to Maori cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maori sculpture styles"@en .

aat:300264804 a skos:Concept ;
    skos:definition "Male sculptural mortuary figures containing the skull of the deceased. They are created by the people of the island of Malekula in Melanesia. Each rambaramp depicts a recently deceased individual whose spirit has joined their ancestors and will ensure the well being of the community. The framework of the object is made of bamboo, wood, and fibrous leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rambaramps"@en .

aat:300264805 a skos:Concept ;
    skos:definition "Engraved design motif or pattern featuring bold, angular lines contrasted with delicate, organic shapes. They are found on canoe prows, headrests, bamboo quivers, and on korwar carved figures, which often have enlarged heads in proportion with their squatting bodies. Objects bearing korwar style designs are often used during funerary rites in order to maintain contact with ancestors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "korwar"@en .

aat:300264807 a skos:Concept ;
    skos:definition "Material comprising or processed from the hard exterior covering of an egg of the emu, an Australian flightless bird. An emu eggshell is dark green in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emu eggshell"@en .

aat:300264809 a skos:Concept ;
    skos:definition "Regional styles belonging to Papua New Guinea cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papua New Guinea regional styles"@en .

aat:300264810 a skos:Concept ;
    skos:definition "Highly stylized anthropomorphic carved sculptures constructed from flat boards and decorated with red, black, and white paint. These figures were used to display trophy skulls within the men's ceremonial houses, on the south coast of New Guinea. The sculptures are depictions of important ancestors or founders of a clan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agiba"@en .

aat:300264812 a skos:Concept ;
    skos:definition "Describes the artwork created by the Asmat people of Sepik region. Elaborate sculptures are their primary art form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asmat"@en .

aat:300264813 a skos:Concept ;
    skos:definition "Carved wooden ancestral poles, large in size, made by the Asmat people of the Sepik region. The figures on the sculptures represent deceased clan members who were murdered by enemy clans. A recurring characteristic of most bisj is the phallus, representing the strength of male fertility. These memorial poles were constructed for funerary ceremonies that commemorated the deceased. Designs vary depending on the area or group who constructed the bisj."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bisj"@en .

aat:300264815 a skos:Concept ;
    skos:definition "Describes elaborately painted sheets of bark found throughout Aboriginal Australian cultures. For native Australians, the art of bark paintings was an everyday practice, but it was also utilized for ceremonial purposes. After European colonization, bark painting production decreased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bark paintings"@en .

aat:300264816 a skos:Concept ;
    skos:definition "Refers broadly to the culture and styles associated with the area of southeast Europe comprising the southern Balkan peninsula, Peloponnese, and various offshore islands, as well as other territories that were colonized or held by Greece during various periods of history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek"@en .

aat:300264817 a skos:Concept ;
    skos:definition "Style and culture of an African people living in Kenya's Great Rift Valley region in the Elgeyo Marakwet District."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Endo"@en .

aat:300264818 a skos:Concept ;
    skos:definition "Refers to a style of literati painting that emphasized a distinctive relationship between ink as medium and bamboo as subject; the works also included calligraphy. The works are typically monochrome or subtly colored, deliberately emphasizing the brushwork required to create the stalks and leaves of bamboo, positioned near the brushwork of the calligraphy. Bamboo was symbolic in Chinese culture for moral integrity, purity, and the ability to withstand adversity, qualities with which the literati identified themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ink-bamboo"@en .

aat:300264820 a skos:Concept ;
    skos:definition "Refers to a representation of the events surrounding the birth of Christ. It is typically characterized by being three-dimensional and including the infant Jesus in the manger, the Virgin Mary and Saint Joseph, sheep, the ox and ass, and other attending figures, such as shepherds, magi, and angels. The term \"crèche\" derives from the animals' manger in which, according to some translations of the Gospel of Saint Luke, the Virgin placed the newborn Jesus. According to legend, Saint Francis of Assisi popularized the Christmas crèche in 1223 at Greccio, Italy, when he is said to have celebrated Midnight Mass in a stable where men and animals re-enacted the Nativity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crèches"@en .

aat:300264821 a skos:Concept ;
    skos:definition "Printed works that are created to meet an array of immediate needs, usually transitory in nature not intended to be saved. Examples cold be broadsides, posters, leaflets, pamphlets, programs, postcards, tradecards, labels, tickets, handbills, sale notices, and valentines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printed ephemera"@en .

aat:300264822 a skos:Concept ;
    skos:definition "Refers to decorated trees, typically an evergreen tree of pine, balsam, or fir, decorated with candles, lights, and ornaments as a part of Christmas festivities. It is rooted in the use of evergreen trees, wreaths, and garlands to symbolize eternal life, customary among ancient Egyptians, Chinese, and Hebrews. In addition, tree worship was common among the pagan Europeans; Scandinavian and German customs surrounding evergreen branches and trees during the midwinter holidays survived their conversion to Christianity. The modern Christmas tree originated in western Germany, around a popular medieval play about Adam and Eve, in which the 'paradise tree' was a fir tree hung with apples, representing the Garden of Eden. The Germans set up a paradise tree in their homes on December 24, the feast day of Adam and Eve. The custom became popular in Victorian England; the symbolism was expanded to include ornaments that referred more directly to Christ's birth. The tradition was taken up by many countries in the Western world. In today's use, it has often lost its original religious significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Christmas trees"@en .

aat:300264823 a skos:Concept ;
    skos:definition "Refers to altarpieces produced primarily in Germany, Austria, and the Tyrol in the 15th and 16th centuries. The term means 'carved altarpiece' in German. Schnitzaltars could be located on either the high altar or side altars; they are characterized by being profusely colored and gilded and having four sections: a central shrine containing sculpture, under which is a smaller shrine commonly referred to by the Italian term 'predella,' and two movable pairs of shutters or wings, containing either paintings or relief carvings on both front and back. Opening and closing the wings provided variety, generally relating to the liturgical calendar. The shrine section was typically surmounted by an architectural superstructure of carved tracery and sculpture niches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schnitzaltars"@en .

aat:300264824 a skos:Concept ;
    skos:definition "Refers to an altarpiece or other polyptych with five panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pentaptychs"@en .

aat:300264825 a skos:Concept ;
    skos:definition "Refers to an altarpiece or other polyptych with four panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quadriptychs"@en .

aat:300264826 a skos:Concept ;
    skos:definition "Refers to altarpieces composed of a single panel, rather than multiple panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palas"@en .

aat:300264827 a skos:Concept ;
    skos:definition "Refers broadly to a variety of art created in the 1960s and 1970s; for earlier art emphasizing the idea rather than the object, use \"conceptual art (art genre).\" Critiquing the concept of art as commodity, the style Conceptual is characterized by an emphasis on communicating an idea and the artist's intent, rather than the production of the artwork itself, often including documentation referring to the creation process, such as maps, photographs, and notes. A genre of art in which the ideas or concepts that a work expresses or refers to are considered to be its defining characteristic, and the finished material result, if it exists at all, is regarded primarily as a form of documentation rather than as the art work. The genre emerged in the late 1960s and early 1970s, arising at virtually the same time in North America, Europe and Latin America, and helping to inspire the acceptance of nontraditional media such as photographs, architectural drawings and performance art as art of equal status as traditional painting and sculpture. It directly inspired the medium of artists' books as an individual type of art. The term entered common art parlance through an article by Sol LeWitt, \"Paragraphs on Conceptual Art\" published in Artforum in 1967."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Conceptual"@en .

aat:300264828 a skos:Concept ;
    skos:definition "Knotted string recording devices used in the Inca empire and its predecessor societies in the Andean region. The term \"khipu\" is an orthographic rendering of the Quechua word for knot. A khipu typically consists of colored cotton or alpaca cords or strings; arranged with a main cord to which are attached a variable number of pendant strings. Pendant strings may bear further subsidiary strings. On most khipus there are three types of knots. It is believed that khipus were used to record numeric values for tributes, censuses, and the like; according to contemporaneous European accounts, the khipus were also used as mnemonic devices representing cultural histories and tales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khipus"@en .

aat:300264829 a skos:Concept ;
    skos:definition "Artists that produce raised letters or designs on a surface, typically by means of stamping or molding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossers"@en .

aat:300264830 a skos:Concept ;
    skos:definition "Collective term for the animation processes used in Japan by Japanese animation artists for anime films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anime"@en .

aat:300264831 a skos:Concept ;
    skos:definition "Refers to sheets of gold that have been hammered or rolled very thin (typically around 0.1 micrometer, or 4 millionths of an inch, thick). In art, gold leaf has been applied to paintings, sculptures, manuscripts, and decorative arts since around 1500 BCE. In the 1920s, the process of creating gold leaf was successfully automated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold leaf"@en .

aat:300264832 a skos:Concept ;
    skos:definition "Refers to craftsmen who create gold leaf. Generally considered a trade separate from goldsmiths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldbeaters"@en .

aat:300264833 a skos:Concept ;
    skos:definition "Process of making gold leaf by beating or pressing gold into a very thin, flexible sheet. An example of a common method of production begins with a small ingot of gold alloyed with small amounts of silver and copper, which is rolled into a long ribbon, the ribbon is then cut up into pieces, the pieces are placed between sheets of heavy paper and enclosed in a sheepskin, then hammered until the leaves of gold have been reduced to a thickness of about 0.001 mm,so delicate that they can be moved or straightened with a light breath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldbeating"@en .

aat:300264834 a skos:Concept ;
    skos:definition "A laminated leaf, resembling gold leaf, was made by placing a thin sheet of gold over a similar sheet of silver (or tin) and hammering the two together. The gold-silver laminate was used instead of gold leaf, but it had the undesirable characteristic of tarnishing, since the thin gold layer cannot protect the silver below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zwischgold"@en .

aat:300264835 a skos:Concept ;
    skos:definition "East Polynesian religious structures of various forms from small stone platforms, to simple stone enclosures. The most common patterns of marae are found on Society Island. to templelike structures. For similar structures from Hawaii, see \"heiaus.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maraes"@en .

aat:300264837 a skos:Concept ;
    skos:definition "Refers to artists working in China beginning around 1100, and in Korea and Japan in later periods. They are characterized by being primarily scholars and gentlemen, which they held made them distinct from, and superior to, professional painters and craftsmen. They believed that an art work revealed the character of the person who painted it and that quality in art was dependent upon the moral rectitude and intellect of the artist. They typically integrated poetry, calligraphy, and simple monochromatic painting into a single work. Their works often had a learned literary content. They preferred calligraphic expressionism over realistic and detailed depictions, often making allusions to antique styles and using deliberately primitive or naive techniques. Motifs such as bamboo, plum, or flowers were used to showcase brushwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literati"@en .

aat:300264839 a skos:Concept ;
    skos:definition "Nature reserves inhabited by indigenous peoples of Australia that have been designated as protected by the Australian Government. Traditional indigenous owners of the land enter into voluntary agreement with the Govenment to establish the boundaries of the area, in order to promote biodiversity and to preserve cultural resource conservation. An IPA is considered part of the National Reserve System of Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indigenous Protected Areas"@en .

aat:300264840 a skos:Concept ;
    skos:definition "Areas where lacunae, gaps, cracks, pores, holes, or other losses or differences in grade have been filled or leveled with a filling material, such as in paintings, mosaics, frames, sculpture, architectural elements, landscape surfaces, and other objects of many kinds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infills"@en .

aat:300264841 a skos:Concept ;
    skos:definition "The process of setting something into its desired position and fixing it there, such as bricks or shingles.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laying"@en .

aat:300264842 a skos:Concept ;
    skos:definition "Generally, the process of setting down again in a fixed position something that had been taken up. In the context of mosaic conservation, the detaching of tesserae from their preparation layer, in sections or in one piece, and setting them back in situ on a new support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "re-laying"@en .

aat:300264843 a skos:Concept ;
    skos:definition "The removal of an object or object component from physical contact with another. For the dividing of a whole object or aggregate of objects or object components into constituent parts, see \"separating.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detaching"@en .

aat:300264844 a skos:Concept ;
    skos:definition "the process of a whole object separating itself into layers, scales, or laminae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exfoliating"@en .

aat:300264846 a skos:Concept ;
    skos:definition "A mass or layer of matter of varying thickness that has subsided or been precipitated from a fluid medium onto another mass of material, or has collected in one place by any natural process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deposit"@en .

aat:300264847 a skos:Concept ;
    skos:definition "Buildings, groups of buildings, or spaces within buildings where works of art are housed and displayed for public benefit. For stores in which works of art are displayed for sale, see \"art galleries (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art museums"@en .

aat:300264848 a skos:Concept ;
    skos:definition "Linguist who is versed in the history and the origin of words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etymologists"@en .

aat:300264849 a skos:Concept ;
    skos:definition "Processes and techniques for making images using the arts of printmaking, illustration, drawing, and other techniques that depend upon line and not color to render the design. In historical usage, the term referred more broadly to presentation in two-dimensional visual form, including most arts on paper, panel, or canvas, including painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic arts"@en .

aat:300264850 a skos:Concept ;
    skos:definition "Artists who specialize in printmaking and illustration that depend upon line and not color to render the design. Formerly referred more broadly to artists who specialize in any of several two-dimensional arts on paper, panel, or canvas, including painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic artists"@en .

aat:300264851 a skos:Concept ;
    skos:definition "Venetian-type glass style, popular in England during the 16th and 17th centuries. This type of glass was very fragile, containing many microscopic air bubbles and was discolored in various hues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Venetian"@en .

aat:300264852 a skos:Concept ;
    skos:definition "Glassware styles belonging to Renaissance-Baroque cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance-Baroque glassware styles"@en .

aat:300264854 a skos:Concept ;
    skos:definition "Style and culture of an African people living in Kenya near Lake Turkana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elmolo"@en .

aat:300264855 a skos:Concept ;
    skos:definition "Style and culture of an African people living in South Africa, part of the southern Nguni cluster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mfengu"@en .

aat:300264856 a skos:Concept ;
    skos:definition "Shadow theater is a type of puppetry involving the use of flat shadow puppets manipulated behind a blank translucent screen or sheet onto which light shines so that the shadows of the puppets are cast on it. The audience views the shadows of the puppets as they act out the story. There is difference in scholarly opinion as to its origins, but either Egypt or eastern Asia is a likely place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shadow theater"@en .

aat:300264857 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Sierra Leone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Krim"@en .

aat:300264858 a skos:Concept ;
    skos:definition "Describes works produced by the African people of the same name, inhabiting Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kera"@en .

aat:300264859 a skos:Concept ;
    skos:definition "Farm machines used for cutting down a standing crop. Modern machines incorporate harvesters, combines, and binders, and may perform other harvesting operations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reapers"@en .

aat:300264860 a skos:Concept ;
    skos:definition "Agricultural implements consisting of a hook-shaped metal blade with a short handle fitted on a tang. Similar in form and use to 'reaping hooks,' but distinguished from these by having serrated cutting edges, and the method in which they are employed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sickles"@en .

aat:300264861 a skos:Concept ;
    skos:definition "Describes works creatted by the African people of the same name living in the Cameroon Grassfields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ntem"@en .

aat:300264862 a skos:Concept ;
    skos:definition "Refers to work produced by the Arabic ethic group of the same name, inhabiting Tunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khrumir"@en .

aat:300264863 a skos:Concept ;
    skos:definition "A technique involving the pooling of pigments to create distinctive blurred effects. Color is applied with a wet brush and a second color is then applied before the first has dried. The technique most likely originated in Chinese ink painting, but it was developed and made popular in Japan by Sosatsu in the 17th century and continued to be used throughout the 18th and 19th centuries. It was most often seen in Japanese Rimpa-style painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tarashikomi"@en .

aat:300264864 a skos:Concept ;
    skos:definition "Temporary or permanant structures built or used for a fair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fair buildings"@en .

aat:300264865 a skos:Concept ;
    skos:definition "Refers to the firing of ceramics at relatively low temperatures, as with earthenware, which is fired at 900 to 1200 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "low firing"@en .

aat:300264866 a skos:Concept ;
    skos:definition "Refers to the firing of ceramics at relatively high temperatures, as with porcelain, which is fired at a temperature up to 1280 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high firing"@en .

aat:300264867 a skos:Concept ;
    skos:definition "Refers to Pre-Columbian carved objects that resemble a thin-blade or ax, but were apparently not used as an ax. They had a ceremonial purpose, likely serving as ballcourt markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hachas"@en .

aat:300264868 a skos:Concept ;
    skos:definition "Animation cels made from cellulose nitrate, which were common during the 1920s through 1940s. The material was thereafter replaced because it was unstable and prone to yellowing, wrinking, and shrinkage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrate cels"@en .

aat:300264869 a skos:Concept ;
    skos:definition "Refers to prevously burnt, finely ground pottery that is added to terracotta clay in order to open the pores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grog"@en .

aat:300264871 a skos:Concept ;
    skos:definition "Refers to Inca designs comprising geometric forms enclosed in squares, believed to be used primarily on textiles. It is believed that the designs were a system of pictographs, perhaps an ancient ideographic form of writing (perhaps representing the names of cities or kings) or a mnemonic system. Tocapu was apparently used only on the garments of chiefs and other individuals of high rank. See also \"khipu,\" which was a mnemonic system made of knotted strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tocapu"@en .

aat:300264872 a skos:Concept ;
    skos:definition "Refers to Japanese prints or other works depicting famous places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meisho-e"@en .

aat:300264873 a skos:Concept ;
    skos:definition "Refers to rock in its original environment, as opposed to having been quarried. It typically refers to rock that is carved or otherwise used in situ, often to sculpture or architecture carved in situ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living rock"@en .

aat:300264875 a skos:Concept ;
    skos:definition "Adherents of the movement inaugurated by Austrian Rudolf Steiner (1861-1925) and devoted to the development of the faculty of cognition and the realization of spiritual reality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthroposophists"@en .

aat:300264876 a skos:Concept ;
    skos:definition "Field of study developed by Austrian educator and philosopher Rudolf Steiner (1861-1925) to develop a scientific and intuitive faculty of cognition and the realization of spiritual reality. Students were said to acquire ultrasensitive perception by means of a type of meditation. It was greatly influenced by the religious ideology theosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthroposophy"@en .

aat:300264877 a skos:Concept ;
    skos:definition "Large square-built concertinas developed by the German Heinrich Band in the 1840s. It has button keys and may have either a single or double action, though single is more common. Early models have 88 keys or more, but the average modern instrument has 71. They are best known as used by the tango bands of Brazil, Argentine, and Uruguay, but are also known in West Africa and the USA.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandoneons"@en .

aat:300264878 a skos:Concept ;
    skos:definition "Techniques related to music arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music composition techniques"@en .

aat:300264879 a skos:Concept ;
    skos:definition "Technique of music composition in which the composer leaves a significant amount of control over the piece to the performers or circumstances, excluding some of the traditional ways of doing this such as guided improvisation and unmeasured pauses. There are generally three methods employed: (1) the use of random procedures to generate compositions; (2) the allowance of choice to the performer(s) from among options created by the composer; and (3) the use of nontraditional or totally new-made schemes or notation and notational symbols that loosen the composer's instructions and allow much room for the performer(s) own interpretation. The technique has been used widely since the mid-20th century, one of the notable practitioners being the American composer John Cage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aleatory"@en .

aat:300264880 a skos:Concept ;
    skos:definition "Refers to a Neolithic Chinese culture and period active from ca. 3300 to 2250 BCE. The most notable Liangzhu artifacts consist of ritual jades; flat disks of varying sizes and segmented hollow columnar objects have been found in graves. The columnar jades feature angled corners worked with what are among the earliest representations of the human form in this part of the world. Later ritual manuals identify the objects as 'bi' (the flat disks) and 'cong' (the tubular objects) and explain their role in the worship of heaven and earth and as markers of hierarchical rank; although the jades were certainly bearers of meaning, the later texts may not be relevant to the Neolithic context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liangzhu"@en .

aat:300264882 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic period and culture partly synonymous with Qinglian'gang. It takes its name from a site in Taian in Shandong province. Dawenkou flourished between ca. 4300 and ca. 2400 BCE and was geographically located across Shandong, western Henan, northern Anhui, and Jiangsu provinces. In its central area of Shandong, Dawenkou developed out of the Beixin culture and was succeeded by the Longshan culture. Some of the characteristics of later Longshan pottery are seen in Dawenkou ceramics: elaborate ritual vessels, polished blackwares and whitewares, and the use of the potter's wheel. Painted decoration gave way in the Late Dawenkou period (ca. 2900-ca. 2400 BCE) to surface treatments such as cord and basket impressions. Other characteristic artifacts of the period include ivory combs and carved ivory tubes. Dawenkou cemeteries contain the graves of wealthy individuals; some graves contain more than 100 valuable objects such as jade beads and axes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dawenkou"@en .

aat:300264883 a skos:Concept ;
    skos:definition "Green-glazed stoneware manufactured in the kilns of Zhejiang province in southern China, with production concentrated in Shangyu, Yuyao, and Shaoxing. Developed during the Six Dynasties period, it was the first recognizable ware type in China. Yueh-yao was a highly durable ceramic often used for bowls and jars. Its popularity led to its eventual exportation to places as distant as Egypt and the Philippines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yue yao"@en .

aat:300264884 a skos:Concept ;
    skos:definition "Refers to a phase of the Chinese Neolithic Yangshao culture. It is named after Miaodigou village in Henan province where the first find from this culture was made. Two distinct periods have been determined: Miaodigou I, dating from ca. 4000 to ca. 3300 BCE and Miaodigou II, dating from ca. 3300 to 2600 BCE. Miaodigou ceramics are typically made of a refined red clay, occasionally covered with red or white slip. A few objects made of the thin, hard, lustrous pottery typical of the Longshan culture have been excavated at Miaodigou sites. Villages were surrounded by ditches and fences and were internally divided into distinct areas for living, working, and burial. Burials were mostly furnished with ceramics but occasionally stone tools and bone ornaments have been found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miaodigou"@en .

aat:300264885 a skos:Concept ;
    skos:definition "Refers to a phase of the Chinese Neolithic Miaodigou culture dating from ca. 4000 to ca. 3300 BCE. Pottery vessels were sometimes painted, usually in black but sometimes black combined with white and red slip. Decoration was usually geometric, with bird, frog, and plant motifs being exceptions. A noteworthy barrel-shaped jar topped with a human head had been found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miaodigou I"@en .

aat:300264886 a skos:Concept ;
    skos:definition "Refers to a phase of the Chinese Neolithic Miaodigou culture dating from ca. 3300 to ca. 2600 BCE. Pottery vessels are usually grey in color and coarse; fewer painted examples from Miaodigou II than Miaodigou I have been found. Impressed patterns such as basket, cord, and check marks are more common; appliqué and incised design were also used. Kilns of the Miaodigou II culture have the firing chamber directly on top of the furnace instead of beside it, as in earlier Neolithic kilns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miaodigou II"@en .

aat:300264887 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture of the middle Yangzi River basin dating from ca. 4400 to ca. 3300 BCE. Its name comes from a site at Daxi Wushan in Sichuan province; other important Daxi sites are Guanmiaoshan Zhijiang and Honghuatao in Hubei province and Sanyuangong in Hunan province. Ceramics are the most distinctive Daxi artifacts, with hand-built red wares predominanting. The techniques of painting, stamping, cord impressions, incising, appliqué, and openwork are all used; chevrons, flower petal designs, and intertwined curvilinear and triangular designs are common motifs. Upright vessels such as deep-bowled dou and ring-footed bowls, plates, and cups are the most important Daxi vessel forms. Stone tools and ornaments such as rings and necklaces made of jade, bone, stone, and shell have been found at Daxi sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daxi"@en .

aat:300264888 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating from 4000 to 3000 BCE; it covered the area of Liaoning province, the western part of Inner Mongolia, and northeast Hebei province. It was named after the first excavation site in 1908 at Hongshanhou on the Laoha River. Hongshan's relatively complex society was based on villages in a wide distribution, with contact with the Yangshao culture of the Central Plain. The Hongshan had sites along rivers in the grassland and ceremonial sites and elaborate burial grounds in the hills and forest. Realistic animal and female human clay figurines have been found at ceremonial sites; the female figurines may indicate a matriarchal society. Dwellings are large and built on high terraces; graves are of the cairn type and often include gifts of pottery and jade carvings. Polished stone tools and red and grey pottery, sometimes decorated with geometric patterns, were produced. The carved and ornamented jade objects of the Hongshan are particularly noteworthy since most Neolithic jades are without surface decoration. Hongshan jades are fashioned into various animal shapes, beads, rings, pendants, and bi discs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hongshan"@en .

aat:300264889 a skos:Concept ;
    skos:definition "Refers to a southern Chinese Neolithic culture of the period between ca. 3100 to ca. 2600 BCE that was centered on the Yangzi-Hanshui plain. It is named for a site near Qujialing village in Jingshan county, Hubei province. The Qujialing succeeded the Daxi culture and was itself succeeded by the Longshan culture. Qujialing culture is noted for its fine black and grey wares as well distinctive painted eggshell ceramics that appeared in the latter half of the period. Most ceramics are plain but some are decorated with impressed or painted designs. In imitation of Daxi ceramics, ring-foot and pedestal forms are prevalent in the Qujialing. The many painted clay spindle-whorls perhaps indicate an intensive textile production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qujialing"@en .

aat:300264891 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating to ca. 6000 to ca. 4800 BCE. It was centered in the middle Yellow River valley and preceding the Yangshao culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peiligang-Cishan"@en .

aat:300264892 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating to ca. 5400 to ca. 2400 BCE. It was centered on the east coast of China and shares some characteristics with the Yangshao culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beixin"@en .

aat:300264894 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating to ca. 5200 to ca. 3300 BCE; its name comes from the site of a Neolithic village in Yuyao county in Zhejiang province. The culture was centered in the lower Yangzi valley and is noted for its evidence of China's earliest rice cultivation, ca. 5000 BCE. The earliest known lacquerware from China, a red lacquered wooden bowl, comes from a Hemudu site. Hemudu pottery is handmade, thick, and greyish black in color. Surfaces are often burnished, cord-impressed or incised with plant and animal motifs. Other Hemudu artifacts include crude clay figurines of animals and humans and incised wood and ivory, with bird motifs, particularly the double bird."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hemudu"@en .

aat:300264895 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating to ca. 5300 to ca. 4800 BCE. It was located in the Liao River valley in northeastern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xinle"@en .

aat:300264896 a skos:Concept ;
    skos:definition "Refers to a Chinese Neolithic culture dating to ca. 2600 to ca. 2000 BCE. It was located in the middle Yangzi valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shijiahe"@en .

aat:300264897 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period associated with the northern Chinese dynasty dating 386 to 556 CE, founded by the Tuoba people. The Wei dynasty succeeded the series of Sixteen Kingdoms (310-439) that ruled northern China after the collapse of the unifying Western Jin dynasty. The Northern Wei dynasty, ruled from 386 to 534 and succeeded in reunifying the north. Frontier areas revolted in 534 and the Northern Wei was succeeded by the two overlapping states of Eastern Wei (534-550) and Western Wei (535-556). Although a time of geographic division, China benefited from foreign influences and Wei institutions such as land reform, taxation, and militia systems were further developed by later Chinese dynasties. Buddhism was widely adopted during the Wei period and it quickly became the main inspiration for figurative art. The Wei rulers were great patrons of Buddhist art, commissioning vast rock-cut temples decorated with sculpture and painting at Yungang, Longmen, Mt. Maiji and Dunhuang. Although mostly melted down, many Buddhist bronze sculptures were produced. Landscape painting became more important, as seen on carved stone sarcophagi and in wall paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wei"@en .

aat:300264898 a skos:Concept ;
    skos:definition "Refers to a period of four centuries in southern Chinese history after the overthrow of the Han dynasty in 220 CE and before the Sui dynasty (ca. 589 CE). During this time, rival clans tried to control portions of the Han empire. Chinese art was influenced during this time by new ideas, especially religious developments. Buddhism, which came to China from neighboring India, had the most profound effect on Six Dynasties art; by the fourth century there was an established category of Chinese Buddhist art. The monastery at Dunhuang in western China preserves notable wall paintings. Monumental sculpture, a tradition brought to China from northern India, became popular, as is evidenced in the massive stone carvings of Buddhist deities in the mountains of Shaanxi and Henan provinces. Wooden pagodas, based on both the stupa of India and the towers of the Han dynasty, were an important architectural development of the period. The native belief systems of Confucianism and Taoism also fostered new subject matter and styles. The Confucian ideal was most popularly expressed in scenes of filial piety while Taoist artists favored landscapes and folk legends. Secular artistic traditions also underwent changes, particularly in the realm of painting. Gu Kaizhi, considered the father of Chinese landscape painting, was active during this period. Noteworthy advances in ceramics in southern China were also made, most notably in the green-glazed stoneware called Yueh-yao or \"Yueh ware,\" a durable ceramic that was eventually exported to places as distant as Egypt and the Philippines. It was during this period that gentlemen-painters and calligraphers and great private art collections first emerged in China. Literary and art criticism also developed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Six Dynasties"@en .

aat:300264899 a skos:Concept ;
    skos:definition "Refers to the culture, style, and period of Chinese history dating from 265 to 581 CE that encompasses six dynasties in the south and five in the north."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern and Northern Dynasties"@en .

aat:300264900 a skos:Concept ;
    skos:definition "Refers to one of the three major phases of the Gansu culture, dating from ca. 3300 to ca. 2100 BCE. Majiayao culture covered western Gansu and eastern Qinghai provinces; it is named after a site in Lintao county in Gansu that was excavated in 1921 to 1923 by the Swedish archaeologist Johan Gunnar Andersson. Typical Majiayao-phase pottery includes jars and bowls of fine paste with lustrous black decoration painted on yellow or red grounds. Sweeping, curvilinear designs punctuated with a central dot or interspersed with undulating lines or crosshatching are characteristic, and are particularly found on jars and urns. Other designs include thick zigzags lines and frog, bird, and dancing human figures. Bone ornaments, stone and bone tools, and toys such as pottery rattles have been found. The limited bronzeworking of this period was of no significance to the economy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Majiayao"@en .

aat:300264901 a skos:Concept ;
    skos:definition "Refers to one of the three major phases of the Gansu culture, dating from ca. 2800 to ca. 2300 BCE. Four sites make up Banshan: Waguanzui, Banshan proper, Bianjiagou and Wangjiagou. Banshan culture covered an area that overlapped with the eastern end of the Majiayao region and extended north and west; it is named for a site in the area of the middle Tao and upper Wei rivers, from which numerous funerary urns were uncovered in the 1930s. As a result of these urns being acquired by American and European museums, Banshan urns, with their narrow necks, wide shoulders, and narrow bases, are the most recognized Chinese Neolithic pottery in the West. Designs are often comprised of four large roundels and are usually painted in purplish black and plum-red pigments although shades of yellow and brown are sometimes seen. Bowls, produced less frequently than urns, occasionally feature designs of human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banshan"@en .

aat:300264902 a skos:Concept ;
    skos:definition "Refers to one of the three major phases of the Gansu culture, dating from ca. 2000 to ca. 1800 BCE. It is named after a site east of Ledu in eastern Qinghai province that was excavated in 1921 to 1923 by the Swedish archaeologist Johan Gunnar Andersson. Machang-phase pottery was made of either red clay or sand-tempered red and grey clay; the most common forms are jars, bowls, and juglike vessels. Typical decorative motifs include four large circles, ringlets, spirals, anthropomorphic patterns, and woven and checked patterns. Much Machang pottery bears painted symbols; 139 different symbols have been identified so far. Some large jars have tops in the shapes of human heads; one notable vessel has a human figure with both male and female sexual organs and breasts. These figures were probably associated with shamanistic rituals. The best-preserved remains of Machang houses have been excavated in Majiawan in Yongjing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Machang"@en .

aat:300264904 a skos:Concept ;
    skos:definition "Refers to a dark beige travertine; it is darker in color than Roman classic travertine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barco"@en .

aat:300264905 a skos:Concept ;
    skos:definition "Refers to a type of travertine that is beige, cream, honey, and/or gold in color; it is lighter in color than barco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman classic travertine"@en .

aat:300264906 a skos:Concept ;
    skos:definition "Style and culture of Mali in West Africa, either the ancient empire of the 13th and 14th centuries or of the modern republic founded in 1960."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malian"@en .

aat:300264907 a skos:Concept ;
    skos:definition "In general scientific use, charts that consist of several lines marked off to scale and arranged in such a way that by using a ruler to connect known values on two lines with a straight line, an unknown value can be read at the point of intersection with another line. Used specifically in the notation of Minimal music to establish new relationships between notes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nomographs"@en .

aat:300264908 a skos:Concept ;
    skos:definition "Pianos whose individual notes have been changed in terms of timbre, pitch, and dynamics by means of placing various objects, such as rubber erasers, screws, bolts, and short sticks, at particular points between or on top of the strings. The idea came from American composer Henry Cowell, though the first prepared piano was created by American Minimal composer John Cage around 1940."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prepared pianos"@en .

aat:300264909 a skos:Concept ;
    skos:definition "Generally, devices that can transform an input of physical quantity, usually coming from an energy source, into an output quantity typically of a different kind, for instance, converting solar heat into electricity, or pressure into hydraulic energy. Many devices, such as phonograph pickups, microphones, thermometers, loudspeakers, and light meters, can be termed transducers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transducers"@en .

aat:300264910 a skos:Concept ;
    skos:definition "Refers to the early phase (ca. 4800-4300 BCE) of the Neolithic Yangshao culture. It is named after a Neolithic village site near Xi'an in Shaanxi province. Banpo architecture already includes the traditional Chinese orientation of the entrance towards the south and the use of wooden roof support frames. Banpo was a major site for ceramic production; a kiln has been excavated. Vessels were usually shaped by hand but were sometimes coiled or formed in molds. Basins and bowls with contracted bases are typical vessel shapes. Vessels were decorated with impressions or with a black or grey slip and were burnished. Geometric patterns predominate; human masks are an unusual motif sometimes used. A series of about 20 different marks incised on the rims of vessels may be a primitive means of recording events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banpo"@en .

aat:300264911 a skos:Concept ;
    skos:definition "A type of continuous curve amphorae characterized by flaring and slightly concave lips, flat handles with flanges, and feet in two degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphorae type A"@en .

aat:300264912 a skos:Concept ;
    skos:definition "Refers to the style and culture of a little-known group of pre-Columbians who lived in the northern Peruvian cloud forests. They are known primarily for tombs placed high on the mountainsides, containing mummies and stone and mahogany carved figures. The culture flourished flourished 800-1536 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chachapoya"@en .

aat:300264913 a skos:Concept ;
    skos:definition "A type of continuous curve amphorae characterized by a straight or slightly concave lip, round handles, and an echinus foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphorae type B"@en .

aat:300264914 a skos:Concept ;
    skos:definition "A type of continuous curve amphorae characterized by a convex or echinus shaped lip, and a torus or echinus foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphorae type C"@en .

aat:300264915 a skos:Concept ;
    skos:definition "Small pointed-neck amphorae used for scented oil (perfume)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphoriskoi"@en .

aat:300264916 a skos:Concept ;
    skos:definition "Amphorae, usually Campanian, having a body close to that of a neck amphora, but where the handles have been replaced by a single handle arched over the mouth. Mythological scenes on these amphorae are rare, while funerary scenes around a stele are common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bail amphorae"@en .

aat:300264917 a skos:Concept ;
    skos:definition "A type of neck amphorae found in large numbers in Etruscan site in Italy, and not in Greece, so that they were originally thought to be Etruscan-made, Tyrrhenian being an old name for Etruscan. It is now know that they were made in Athens specifically for export to Italy. Komasts (dancers) and the adventures of Herakles are among the most popular subjects for Tyrrhenian vases. The artists to whom these vessels are attributed to are known as the Tyrrhenian Group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tyrrhenian amphorae"@en .

aat:300264918 a skos:Concept ;
    skos:definition "Black-figure amphorae with scenes or figures restricted to panels on the sides of the vase."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel amphorae"@en .

aat:300264919 a skos:Concept ;
    skos:definition "Amphorae characterized by pointed or knob-feet and requiring stands. In its unpainted form it was the standard container for commercial transportation of wine and oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointed amphorae"@en .

aat:300264920 a skos:Concept ;
    skos:definition "Amphorae with a shape like a Panathenaic amphora, but with subject matter and painting that is not characteristic of Panathenaic amphorae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudo-Panathenaic amphorae"@en .

aat:300264921 a skos:Concept ;
    skos:definition "Ceramic vessels that were used to transport wine or other liquid, and are characterized as being plain and unglazed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transport amphorae"@en .

aat:300264922 a skos:Concept ;
    skos:definition "A type of late Roman amphora that feature a tapered body with the maximum diameter occurring at the shoulder and a height from 44 to 64cm, rim diameter of 4.5 to 11cm, maximum body diameter of 28.4 to 39cm and upper part height of 16.4 to 33cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphorae type Ia"@en .

aat:300264925 a skos:Concept ;
    skos:definition "Aryballoi having the early rounded form characteristic of Early Protocorinthian art. It was originally derived from the globe-shaped wine jars, oinochoe, of the 9th century BCE Geometric period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globular aryballoi"@en .

aat:300264926 a skos:Concept ;
    skos:definition "Aryballoi of the later style, having a relatively tall shape with a more pointed base than the globular or spherical styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piriform aryballoi"@en .

aat:300264927 a skos:Concept ;
    skos:definition "Aryballoi having a round shape that is spherical rather than ovoid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spherical aryballoi"@en .

aat:300264928 a skos:Concept ;
    skos:definition "Ancient Greek containers for liquid, perhaps perfume (scented oil), with a very distinctive shape: an oblate spheroid bowl with turned-in rim, short or tall foot, and lid with finial. The lids are rarely preserved. In vase paintings the exaleiptron most often appears in scenes of women bathing or participating in funerary rituals. Other ancient names have sometimes been used in modern times to refer to this vessel shape: kothon, plemochoe, and smematotheke (or smegmatotheke)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exaleiptra"@en .

aat:300264929 a skos:Concept ;
    skos:definition "Bottles made to allow the sprinkling of perfume, water, or another liquid that must be dispensed parsimoniously. One construction utilizes a neck resembling a washer: the constriction regulates the flow of contents to a trickle. Among other forms are nipple-like or tapering or branched tops perforated with holes. Contents were luxury items such as expensive perfumes, rose water, or in the church, holy water. Sprinkler flasks are found in ancient Egypt, China, the Middle East, the ancient Roman world, Europe, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprinkler flasks"@en .

aat:300264930 a skos:Concept ;
    skos:definition "Ancient Greek vessels in a shape reminiscent of an oil lamp. They feature prominent spouts and seem to have been specialized containers designed for the refilling of oil lamps with a fresh supply of olive oil. Most lamps were made with a hole in the discus (the round sealed cover of the reservoir) so that the refilling did not need to disturb the wick that emerged from the spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gutti"@en .

aat:300264931 a skos:Concept ;
    skos:definition "Small vessels, usually ancient, having the shape of a jug, which is a vessel with a narrow neck, handle, and pouring lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juglets"@en .

aat:300264932 a skos:Concept ;
    skos:definition "An ancient Greek and Roman vessel type often used to pour wine; it was particularly popular in the Hellenistic period. It features a narrow neck, swelling body, broad shoulder, long neck, and horizontal handle. The lagynos form originates in eastern Greece. At least two places where it was manufactured in the Mediterranean are known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lagynos"@en .

aat:300264933 a skos:Concept ;
    skos:definition "An ancient Greek jug featuring a squat body, a tall and narrow neck, and a beak spout. The body sometimes features rib decoration. Th name means \"to pour.\" Most of these vessels were produced in South Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epichyseis"@en .

aat:300264934 a skos:Concept ;
    skos:definition "A Cycladic vessel featuring a globe-shaped body, tall neck, pedestal foot, and four pierced lugs on the body. The pierced lugs would have held cords for securing a lid to the vessel. Kandilai take their name from their resemblance to modern Greek church lamps; they would have been used to hold liquids such as oil or wine. The kandila form was very common, made in both marble and clay and in a wide range of sizes. The gradual elimination of a foot or base may represent a step in the transition from the kandila to the spherical pyxis form that later became popular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kandilai"@en .

aat:300264935 a skos:Concept ;
    skos:definition "Early black-figure form of the squat lekythoi with an ovoid body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deianira lekythoi"@en .

aat:300264937 a skos:Concept ;
    skos:definition "Ancient Greek one-handled, usually tall and slender narrow-necked vessels used for oil and unguents and as an offering for the dead. The form resembles the aryballos in that it has a narrow neck and a single handle, but the lekythos is generally a taller vessel with a small, deep mouth. The Greek word lekythos was undoubtedly used for the various forms called \"lekythos\" today, although it also appears that the term was used for oil vessels in general in Ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lekythoi"@en .

aat:300264941 a skos:Concept ;
    skos:definition "Ancient Greek vessel type named after the potter Nikosthenes. It features a domed lid with finial, a body shaped like an inverted bell set on a short stem, and a flaring foot for support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nikosthenic pyxides"@en .

aat:300264942 a skos:Concept ;
    skos:definition "A type of pyxis with a flat lid and knob and a concave-sided body. It is either footless or has a ringlike foot that is sometimes divided into three or four sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyxides type A"@en .

aat:300264943 a skos:Concept ;
    skos:definition "A type of pyxis with a low, wide shape, straight-sided body, and slip-over lid. It resembles a modern powder box."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyxides type B"@en .

aat:300264944 a skos:Concept ;
    skos:definition "A type of pyxis with a convex lid and a concave-sided body like the pyxis type A, but more shallow and broad. It is only found in red-figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyxides type C"@en .

aat:300264945 a skos:Concept ;
    skos:definition "A type of pyxis with a body similar to the pyxis type B, but with a smaller, caplike lid rather than a slip-over lid. It is found only in red-figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyxides type D"@en .

aat:300264946 a skos:Concept ;
    skos:definition "A type of pyxis that has a lid with finial and a bowl-shaped body supported on three concave slab-like legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tripod pyxides"@en .

aat:300264947 a skos:Concept ;
    skos:definition "Containers probably used to hold ointments and perfume. Early ceramic examples found at Petra (probably 4th-century BCE) were in the typical Hellenistic form of the spindle bottle, but this form was later completely replaced by a series of high-necked types with round to ovoid bodies of varying and apparently standardized forms (from the 1st century BCE onwards). The number of unguentaria found at Petra suggests that they were made locally; their manufacture would have been linked to the myrrh and other unguents that the Nabataeans traded. They have also been found at western sites. Pear-shaped glass unguentaria were later made at various locations in the Arabian peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unguentaria"@en .

aat:300264948 a skos:Concept ;
    skos:definition "A large type of urn with a wide lip used for funerary purposes in ancient Etruria, particularly during the 10th-8th centuries BCE. Early Villanovan burials were often characterized by the use of such urns; one handle would be knocked off in a ritual destruction of the vessel. Biconical urns often stood as a shorthand for the body of the deceased and were often capped by a military helmet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biconical urns"@en .

aat:300264949 a skos:Concept ;
    skos:definition "Kraters from the ancient district of Messapia (now Apulia and Calabria) in southern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Messapian kraters"@en .

aat:300264950 a skos:Concept ;
    skos:definition "A type of krater of an early-black figure shape (but invented earlier, in the Late Geometric period) with the bowl resembling a large skyphos, with separate lid and stand, high horizontal handles, and a simple torus foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Skyphos kraters"@en .

aat:300264951 a skos:Concept ;
    skos:definition "Refers to works produced in Venice by Muslims and by Italian craftsmen trained in the Islamic style; the primary example comprises a large group of 15th- and 16th-century metal wares, primarily in European collections, once attributed to Muslim artists working in Venice. Veneto-Saracenic wares are domestic in nature and include bowls, spherical incense burners, candlesticks, and salvers. They are made of brass or bronze and are inlaid with geometric or arabesque motifs in silver, with occasional traces of gold and frequent additions of a black compound. The term is sometimes loosely applied to objects decorated with figural ornament and Western coats of arms. In the 19th century Lavoix popularized the identification of these objects as Veneto-Saracenic but his theory that Muslim metalworkers worked in Venice and trained Italian craftsmen in the Islamic style was challenged in 1970, when Huth questioned whether guild laws would have allowed foreign craftsmen on Venetian territory. No documentary evidence has come to light to prove or disprove either idea and it is often difficult to distinguish between Islamic originals and Western copies. Auld has identified three sub-groups: Turkoman, Mamluk, and Western."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Veneto-Saracenic"@en .

aat:300264952 a skos:Concept ;
    skos:definition "Style of a sub-group of Veneto-Saracenic metal wares. This group of over a hundred pieces is based on the eleven pieces signed by Mahmud al-Kurdi. The eclectic and exuberant decoration of Mahmud al-Kurdi's works features centrifugal designs of cusped ogees, lime-shaped medallions, and cruciform motifs inlaid in silver in both spatial and linear techniques against a minutely incised arabesque ground. This style of decoration is similar to metalwork made during the same period for the Timrid dynasty in eastern Iran and Central Asia and the Mamluk rulers of Egypt and Syria although Mahmud al-Kurdi had a heightened interest in drama and color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkoman"@en .

aat:300264953 a skos:Concept ;
    skos:definition "Style of a sub-group of Veneto-Saracenic metal wares that includes the bulk of such objects. Related to late 15th-century Mamluk metalwork, their designs are organized centripetally or in concentric bands. The motifs, which are typically Mamluk, include alternating knots, twisted ropes, and trefoiled trelliswork derived from calligraphy. None of the objects in this group is signed, but many bear north Italian, and specifically Venetian, coats of arms. Although they do not provide precise enough information about ownership, they are nonetheless evidence of the close diplomatic and commercial ties between the Mamluk and Venetian states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mamluk"@en .

aat:300264954 a skos:Concept ;
    skos:definition "Style of a sub-group of Veneto-Saracenic metal wares. Objects in this group were apparently made in the West, probably in northern Italy, to imitate Islamic wares. While individual motifs were accurately copied there is a basic misunderstanding of the rules of Islamic proportion and a disregard for any relationship between positive and negative shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western"@en .

aat:300264955 a skos:Concept ;
    skos:definition "A general term for wares decorated predominantly with one or more clay slips of greater or lesser iron content than the body clay. The slip clays fire to a contrasting color or shade from that of the body. Slipware can be decorated by pouring, dipping, painting, daubing or trailing slips on to the unfired, or sometimes once-fired, body. After it is applied, the slip can be manipulated by twisting the piece, by combing or feathering the slip into more regular designs or, after drying to a tacky consistency, can be carved in the sgraffito technique. Dipping, trailing, and marbling are other common techniques used for slip-decorated ceramics. The application of slip almost always precedes glazing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slipware"@en .

aat:300264956 a skos:Concept ;
    skos:definition "Refers to lead-glazed English earthenware vessels with a red body and a brownish-black glaze commonly found near the sites of Cistercian monasteries in England. These vessels, often mugs and tankards, were mostly made during the early 16th century. Although most pre-date the dissolution of the monasteries in 1540, a dated example of 1599 indicates continued production. Cups were the speciality of the Cistercian ware potters, but jugs, costrels, candlesticks, chafing dishes, salts and bowls were also produced. Most Cistercian ware is undecorated but some examples are distinguished by horizontal ribbing or by white slip ornamentation of rosettes or roundels. Potteries making these wares were located at Abergavenny, Monmouthshire; Tickford, Derbyshire; and Wrotham, Kent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cistercian ware"@en .

aat:300264957 a skos:Concept ;
    skos:definition "Refers to a type of 17th-century jug in the form of two rings which cross one another at right angles. They are made of Rhenish stoneware. The term literally means 'sausage jugs.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wurstkrüge"@en .

aat:300264958 a skos:Concept ;
    skos:definition "Refers to objects made of a fine white earthenware clay decorated with delicate, repeating, incised or impressed designs inlaid with different -colored slips, especially yellow ochre and brown. Favored designs were scrolls, coats of arms, a variety of popular abstract motifs, especially those used for ornamenting book covers. Motifs were generally derived from the pattern book \"La Fleur de la science de pourtraicture\" (1530) by Francesco Pellegrino. Relief work was often added. The thin, overlying lead glaze has the appearance of a varnish and gives the ware a cream color. Saint-Porchaire ware was made at Saint-Porchaire, France, and the surrounding area around Saintes in south-west France during the reigns of François I and Henri II, the period of manufacture lasting from ca. 1500 to ca. 1570. Due to the technical skill involved, only a small number were made (64 recorded). Such wares were imitated in the 19th century by such factories as the Minton Ceramic Factory in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint-Porchaire ware"@en .

aat:300264959 a skos:Concept ;
    skos:definition "Refers to one of the most common forms of oinochoe. This type is usually red-figured and features a trefoil (three-spouted) mouth and bulbous body continuously curved from neck to foot. The chous was a standard unit of measure, equivalent to about 3.28 liters. The chous was especially associated with the Anthesteria, an Athenian festival celebrating wine, the wine god Dionysos, and the dead. The second day of the festival was called 'Chous.' It was customary during the festival to drink from choes and to pour libations from them at tombs. Miniature red-figured choes, decorated with scenes of children at play, were probably festival gifts to children or gifts offered at a child's grave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choes"@en .

aat:300264960 a skos:Concept ;
    skos:definition "Refers to one of the most common forms of oinochoe. It was popular in both black- and red-figure and features a trefoil (three-spouted) mouth, offset neck, and ovoid body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 1"@en .

aat:300264961 a skos:Concept ;
    skos:definition "Refers to a type of oinochoe with a narrow-beaked spout. The body usually resembles that of shape 1."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 10"@en .

aat:300264962 a skos:Concept ;
    skos:definition "Refers to one of the most common forms of oinochoe. It was popular in both black- and red-figure and features a trefoil (three-spouted) mouth, offset neck, and bulbous body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 2"@en .

aat:300264963 a skos:Concept ;
    skos:definition "Refers to a type of oinochoe similar to shape 2 and featuring a round mouth (also called a flat mouth)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 4"@en .

aat:300264964 a skos:Concept ;
    skos:definition "Refers to a type of oinochoe featuring a narrow-beaked (narrow-spouted) mouth with the neck and upper body concave and curved outward. The lower body is either straight-sided or concave and curved inward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 6"@en .

aat:300264965 a skos:Concept ;
    skos:definition "Refers to a type of oinochoe featuring a wide-beaked mouth, offset neck, and ovoid body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 7"@en .

aat:300264966 a skos:Concept ;
    skos:definition "Refers to a type of oinochoe closely resembles the modern one-handled mug, but often has two handles. It was used as a dipper for serving wine and a cup for drinking and measuring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 8"@en .

aat:300264967 a skos:Concept ;
    skos:definition "Refers to a type of oinochoe featuring a round mouth and a bulbous body continuously curved from neck to foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oinochoai shape 9"@en .

aat:300264968 a skos:Concept ;
    skos:definition "Refers to a special type of oinochoe based on a narrow-beaked and round-bodied shape indigenous to Cyprus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypro-jugs"@en .

aat:300264969 a skos:Concept ;
    skos:definition "Vessels used to pour liquids, having one handle, a large body, and a nib-like neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prochoi"@en .

aat:300264970 a skos:Concept ;
    skos:definition "Oinochoai having a trefoil-mouthed shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trefoil oinochoai"@en .

aat:300264971 a skos:Concept ;
    skos:definition "Refers to a rare vessel type of hybrid form. It is essentially a psykter with a trefoil mouth instead of a round one and a vertical handle for pouring. This vessel was used for wine rather than coolant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psykter-oinochoai"@en .

aat:300264972 a skos:Concept ;
    skos:definition "Refers to a rare vessel type of hybrid form. It combined the functions of a krater and a psykter, either by implanting a psykter inside the bowl, or by making the krater's body double-walled which, when the compartment between the two walls was filled with cold water, chilled the wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "krater-psykters"@en .

aat:300264973 a skos:Concept ;
    skos:definition "Refers to a rare vessel type of hybrid form; most examples are neck amphorae. An amphora-psykter functioned like a double-walled krater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amphora-psykters"@en .

aat:300264974 a skos:Concept ;
    skos:definition "A typical form of phiale featuring a hollow knob in the middle- an omphalos- projecting upward into the bowl. The vessel was held with the middle finger tucked into the underside of the omphalos and the thumb hooked over the rim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phialae mesomphalos"@en .

aat:300264975 a skos:Concept ;
    skos:definition "A type of phiale that lacks the omphalos of phialae mesomphalos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phialae anomphalos"@en .

aat:300264976 a skos:Concept ;
    skos:definition "Plates of a special form used by the ancient Greeks, having a central depression and sometimes a turned-down rim, used for serving fish. The central depression was used to collect the juice or sauce in which the fish was served. Such fish plates may be made of stone, ceramic, or another material. They may be decorated with highly accurate representations of fish and other marine life. They were popular in Greece and its colonies in South Italy from the 4th century BCE. Athenian painters always oriented the bellies of the fish toward the rim of the plate while southern Italian painters positioned them with the bellies towards the center. Some fish plates have depictions of seafood arranged around a central dip for sauce. Androkydes of Kyzikos was one of the few fish plate painters to sign his work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish plates"@en .

aat:300264977 a skos:Concept ;
    skos:definition "Ancient Greek votive images on plaques. The supports may be terracotta, wood, marble, or bronze; images may be cast, impressed, sculpted, or painted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinakes"@en .

aat:300264978 a skos:Concept ;
    skos:definition "Kantharoi with bowls in the form of back-to-back, or janiform, faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "janiform kantharoi"@en .

aat:300264979 a skos:Concept ;
    skos:definition "Vessels partly in the shape of a moldmade head or face. For aryballoi, kantharoi, mugs, oinochoai, and rhyta, the head usually constitutes the body of the vessel. All other parts of a head-vase (except for the handles) are wheelmade. Animal heads are most popular for rhyta while human heads or faces are characteristic for other vessel types."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "head-vases"@en .

aat:300264980 a skos:Concept ;
    skos:definition "Head-vases consisting of two different heads back-to-back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "janiform head-vases"@en .

aat:300264981 a skos:Concept ;
    skos:definition "Kantharoi decorated with panels containing a distinctive pattern of bands having geometric and floral patterns painted with black and added white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Valentin kantharoi"@en .

aat:300264982 a skos:Concept ;
    skos:definition "The most common type of kantharos, featuring two large looped handles that rise above its deep bowl as well as a tall stem and foot. The lower part of the bowl is slightly offset from the upper part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kantharoi type A"@en .

aat:300264983 a skos:Concept ;
    skos:definition "A type of kantharos featuring handles smaller than type A, rising only to the rim of the bowl, as well as a torus (tire-shaped) foot with very short or no stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kantharoi type B"@en .

aat:300264984 a skos:Concept ;
    skos:definition "A type of kantharos featuring handles as in type A, a continuously curved bowl, and a torus foot with a very short stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kantharoi type C"@en .

aat:300264985 a skos:Concept ;
    skos:definition "A type of kantharos featuring handles and bowl as in type C and a small torus foot with a very short stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kantharoi type D"@en .

aat:300264986 a skos:Concept ;
    skos:definition "A type of kantharos that is a variant of type D. It is named for the potter Sotades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sotadean kantharoi"@en .

aat:300264987 a skos:Concept ;
    skos:definition "A type of kantharos featuring handles and bowl much as in type B, a small torus foot with no stem, and a bowl usually decorated with patterns rather than figures. The name comes from the botanical term 'sessile' denoting something sitting directly on its base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sessile kantharoi"@en .

aat:300264988 a skos:Concept ;
    skos:definition "Refers to kantharoi that are also head-vases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "head-kantharoi"@en .

aat:300264989 a skos:Concept ;
    skos:definition "Refers to kantharoi that are also plastic vases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic kantharoi"@en .

aat:300264990 a skos:Concept ;
    skos:definition "A type of black-figure kantharos featuring a single handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-handled kantharoi"@en .

aat:300264991 a skos:Concept ;
    skos:definition "Black-figure cups named after the chief subject chosen for their decoration, namely revellers (komasts). Komast cups feature narrow, offset lips, deep bowls, and short, flaring or conical feet. The komast cup was one of the forms to predominate in black-figure until about 540 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "komast cups"@en .

aat:300264992 a skos:Concept ;
    skos:definition "Refers to the indigenous culture of the Eagles subgroup of the Haida people of the Northwest Coast region of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eagles"@en .

aat:300264993 a skos:Concept ;
    skos:definition "Refers to the indigenous culture of the Ravens subgroup of the Haida people of the Northwest Coast region of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ravens"@en .

aat:300264994 a skos:Concept ;
    skos:definition "A type of kylix characterized by one continuous curve from lip to foot and a broad and relatively shallow bowl. It was the most common red-figured cup, supplanting eye cups by about 500 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kylikes type B"@en .

aat:300264995 a skos:Concept ;
    skos:definition "Black-figure kylikes of type A, generally of the 6th century BCE, decorated on the outside with a pair of large eyes on each side, often with figures painted between the eyes and sometimes under the handles as well. On some rare eye cups, moldmade male genitals substitue for the wheelmade foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye cups"@en .

aat:300264996 a skos:Concept ;
    skos:definition "A type of kylix resembling type B in its general proportions but with a discontinuous contour. The lip is often offset from the bowl and there is a fillet (raised ring of clay) between the stem and foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kylikes type C"@en .

aat:300264997 a skos:Concept ;
    skos:definition "A type of kylix that, unlike other kylikes, was thrown in one piece, the bowl joined directly to the foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stemless kylikes"@en .

aat:300264998 a skos:Concept ;
    skos:definition "A black-figure cup type that is unusual in that one large picture fills the interior of the bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "segment cups"@en .

aat:300264999 a skos:Concept ;
    skos:definition "Kylikes in which a central picture on the inside is surrounded by a ring-shaped figured zone, or in which one picture occupies the entire surface. Examples of both black- and red-figure zone cups are known. The largest known kylikes, up to 22 inches (56 cm), are zone cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zone cups"@en .

aat:300265000 a skos:Concept ;
    skos:definition "Rhyta of a particular type in which a half-head of a ram is joined with a half-head of a boar or donkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimidiating rhyta"@en .

aat:300265001 a skos:Concept ;
    skos:definition "A type of drinking vessel in the shape of a deep cup, usually with two horizontal handles attached to the lip and a small integral foot. In all-black or unglossed plain wares the skyphos was the most common type of cup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skyphoi"@en .

aat:300265002 a skos:Concept ;
    skos:definition "Refers to a type of skyphos that is easily distinguished by its disparate handles, one horizontal and one vertical. The body is similar to that of type A skyphoi but with the lower body more tapered and the foot smaller. They are almost always decorated with an owl, often in red-figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "owl skyphoi"@en .

aat:300265003 a skos:Concept ;
    skos:definition "Refers to a type of skyphos consisting of a thin-walled cup with delicate handles and a ring foot. The form originated in Corinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian type skyphoi"@en .

aat:300265004 a skos:Concept ;
    skos:definition "Refers to a type of skyphos consisting of a relatively thick-walled cup with sturdy handles and a torus (tire-shaped) foot. The overall proportions are heavier than that of Corinthian type skyphoi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skyphoi type A"@en .

aat:300265005 a skos:Concept ;
    skos:definition "Refers to a type of hybrid vessel; like a skyphos the bowl is deep but like a kylix its handles are upcurved and the bowl tapers sharply toward the foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup-skyphoi"@en .

aat:300265006 a skos:Concept ;
    skos:definition "A type of ancient Greek incense burner or small incense altar made of bronze, silver, or terracotta; the perfumed smoke of the incense would escape through decorative openings. Thymiateria were functional objects but may also have been placed in tombs as funerary offerings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thymiateria"@en .

aat:300265007 a skos:Concept ;
    skos:definition "An ancient Greek vessel type used in connection to marriage. It is generally thought to hold water for the ritual bath taken by the bride, and perhaps the groom, before the wedding. Another theory is that it was a container for the couple's food; there may also have been funerary uses as well. Pictures of a wedding procession or women preparing for marriage often appear on such vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lebetes gamikoi"@en .

aat:300265008 a skos:Concept ;
    skos:definition "Horse armor forming a chest guard, often made of bronze for chariot teams or the horses of generals and high-ranking soldiers. Leather straps held it on to the horse. Ceremonial pieces were highly decorated with reliefs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prosternidions"@en .

aat:300265009 a skos:Concept ;
    skos:definition "Refers to a style of black- and red-figure vase painting featuring highly idiosyncratic drawing styles; Mannerist vases were usually larger shapes such as amphorae, column kraters, pelikai, and hydriae. The name was adopted from terminology applied to 16th-century Italian painters. The black-figure painters working in this style include the Affecter and Elbows-Out, both of whom worked in the third quarter of the 6th century BCE. These artists were named by Beazley for their self-conscious, \"mannered\" styles characterized by odd proportions and unnatural gestures. Red-figure Mannerist vases of the early Classical period feature less extreme idiosyncrasies; the Pan Painter is considered the most gifted of the red-figure Mannerists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mannerist"@en .

aat:300265010 a skos:Concept ;
    skos:definition "Nolan amphorae featuring double handles, each composed of two cylindrical sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doubleens"@en .

aat:300265011 a skos:Concept ;
    skos:definition "A vase painting style based on Orientalizing motifs that was particularly popular in Corinth and eastern Greece. Animals, both real (felines, birds, bulls, boars, goats, deer, dogs, and hares) and imagined (sirens, sphinxes, and griffins), are the predominant decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Animal Style"@en .

aat:300265012 a skos:Concept ;
    skos:definition "Rare red-figure vessels in the shape of knucklebones. The ancient name of the vessel is unknown. The Greeks and Romans used sheep knucklebones as gaming pieces and it has been suggested that the astragalos may originally have been used as a container for them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astragaloi"@en .

aat:300265013 a skos:Concept ;
    skos:definition "A late black-figure painting style named after the sanctuary at Kabirion, west of Thebes, where much of this pottery has been found. This style flourished from the late 5th into the 4th century BCE. Though not sophisticated in its decoration, Cabiran pottery can be amusing and lively."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cabiran"@en .

aat:300265014 a skos:Concept ;
    skos:definition "A vase painting style and technique involving coral-red paint that was used for some Attic vases of the 6th and 5th centuries BCE. A number of well-known vase painters such as Onesimos and Psiax experimented with the technique. Coral-red was made by adding yellow ocher to the black gloss, making the gloss porous and thus deep orange-red in color after the reoxidizing phase of firing. The coral-red technique was most typically found on stemless cups and phialai dating from after the Persian Wars, on which the red body contrasts strikingly with the black lip and handles. They may have been made in Athens under the influence of Persian metalwork and it is possible that the color was intended to evoke gold. Since the coral-red gloss did not adhere well to the vase's surface, it was never a widespread technique and it was eventually abandoned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coral-red"@en .

aat:300265015 a skos:Concept ;
    skos:definition "Painted marks on ancient Greek vases, usually found on the foot of the vase. Less common than graffiti, dipinti were typically painted in red ocher and the vase after firing. The relatively fewer dipinti done in black gloss were painted before firing. Like graffiti, dipinti usually consist of a single letter or linked letters, numerical notations, and, less frequently, words, phrases, and sentences. Most are probably forms of trademarks; they are mostly found on vases intended for export."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dipinti"@en .

aat:300265016 a skos:Concept ;
    skos:definition "Refers to ancient Greek woolworker's thigh- and knee-guards. They take the form of a thick terracotta half-cylinder open at one end and closed at the other, the closed end corresponding to the knee. Their precise use is uncertain, but at some point in the woolmaking process after carding and perhaps before spinning, the fibers were rubbed across the top of an epinetron, which was roughened by an incised pattern. The knee end was occasionally decorated with a moldmade female head, appropriate since weaving and woolworking were done by women. Some of the figured and more elaborately painted epinetra were probably given as wedding presents to young women. Although the term onos is often used synonymously with epinetron, an onos was the woolworker's footrest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epinetra"@en .

aat:300265017 a skos:Concept ;
    skos:definition "The standard hydria form used for black-figure vases. This substantial vessel is distinguished by a large round mouth, offset neck, broad flattish shoulder, and wide body. This shape continued in red-figure but was less common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder hydriae"@en .

aat:300265018 a skos:Concept ;
    skos:definition "Applications or proposals for a competition, whether literary, artistic, architectural, or otherwise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "competition entries"@en .

aat:300265019 a skos:Concept ;
    skos:definition "Ancient Greek vase inscriptions that take the form of \"so-and-so [is] kalos,\" kalos meaning handsome or beautiful, with an erotic connotation. Some such inscriptions are found on walls as well. The inscriptions are thought to indicate male homosexual love or a cult of celebrity, associated with pederastic courtships that were customary in ancient Greece; they probably reflect the emotions of the patron of the vessel rather than those of the vase painter. The names are usually those of teenage artistocratic Athenians. Those that can be associated with known historical figures have played a significant role in establishing the chronology of Attic vase painting, for they were presumably written when the named person was young. Kale inscriptions for women also exist but they are outnumbered by kalos inscriptions more than twenty to one; the women who are praised in these inscriptions were probably courtesans. The majority of kalos inscriptions are on vases produced between 550 and 450 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalos inscriptions"@en .

aat:300265020 a skos:Concept ;
    skos:definition "One of the two forms of lebetes gamikoi. Type 1 features an attached conical stand. This form is common to both red- and black-figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lebetes gamikoi type 1"@en .

aat:300265021 a skos:Concept ;
    skos:definition "One of the two forms of lebetes gamikoi. Type 2 features an echinoid or disk-shaped foot instead of a stand. This form is a red-figure shape only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lebetes gamikoi type 2"@en .

aat:300265022 a skos:Concept ;
    skos:definition "Late red-figure lekanai on which a bride and groom, accompanied by others and in the presence of wedding vases, are depicted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuptial lekanai"@en .

aat:300265023 a skos:Concept ;
    skos:definition "The dominant form of lekythoi that developed around the middle of the century, characterized by a tapering body, black-figure painting, a calyx-shaped mouth, thick lip, very narrow neck, one handle, concave shoulder, cylindrical body, and disk foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder lekythoi"@en .

aat:300265025 a skos:Concept ;
    skos:definition "The most common shape of loutrophoros; it resembles a tall neck amphora but differs in its narrow proportions and elongated handles, with the space between the neck and handles occasionally partly filled in."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loutrophoros-amphorae"@en .

aat:300265026 a skos:Concept ;
    skos:definition "A type of loutrophoros featuring three handles, two horizontal ones on the sides and a vertical one at the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loutrophoros-hydriae"@en .

aat:300265027 a skos:Concept ;
    skos:definition "Small, extremely rare egg-shaped vessels of ancient Greece, found in both black- and red-figure. The specific use of oa is not determined although real eggs as well as marble and ceramic ones were placed in graves. Lidded oa might have held scented oil (perfume). Lidless oa were probably not containers since they either have a small hole at one or both end or no opening at all."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oa"@en .

aat:300265030 a skos:Concept ;
    skos:definition "Refers to the Orientalizing phase of Greek art in Corinth, from about 720 to 620 BCE, which is roughly contemporary with the Proto-Attic phase in Athens. The Proto-Corinthian pottery style developed in Corinth in the eighth century BCE and lasted until around 640 BCE. It is characterized by vessels that are usually cups, jugs, or perfume pots, with decoration that is at first geometric and later includes animal and human figures, with occasional Eastern curvilinear ornamentation. The later examples are distinctive for the rounded contours and animation of the figures, painted in outline and silhouette, with added designs in incision and white color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Corinthian"@en .

aat:300265031 a skos:Concept ;
    skos:definition "Refers to the Orientalizing phase of Greek art in Athens; it was approximately contemporary with the Proto-Corinthian phase. In these early phases of the Attic vase painting style, elements of the earlier Late Geometric styles are still evident. It began around 710 BCE and ended with the development of Attic black-figure painting around 610 BCE. It is characterized by a strong decorative scheme, spiral hooks and other motifs, and litheness of figures, with some roundness of form not found in Geometric styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Attic"@en .

aat:300265032 a skos:Concept ;
    skos:definition "A rare variation of the basic pelike featuring an offset neck and less globular proportions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck-pelikai"@en .

aat:300265033 a skos:Concept ;
    skos:definition "Refers to components or embellishments used in antiquity in both the East and West. Moldmade protomai are often used on ancient vessels, typically plastic vases such as rhyta or kantharoi although also used on other vessel types such as cauldrons and shoulder hydriae. Protomai usually consist of the upper part (head, chest, and forelegs) of an animal or mythological creature or the head and upper body of a person. Protomai are often depicted in Greek vase paintings as shield devices as well. Amongst other things, protomai are also used as embellishments on ancient Hittite architecture and ancient Roman furniture. Protomai, especially in their earliest incarnations, most likely often had votive purposes. The term is occasionally used to refer to embellishments of a later date, particularly medieval stone architectural embellishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protomai"@en .

aat:300265034 a skos:Concept ;
    skos:definition "Refers to a method of decoration used by some ancient Greek black-figure artists to decorate small vases. The technique, invented around 530 BCE, involves painting figures in added white, red, or pink on top of a black-glaze ground and incising details so that the black glaze shows through. The resulting effect is similar to red-figure. Beazley named this technique after the Dutch scholar Jan Six, who first drew attention to these polychrome vases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Six's Technique"@en .

aat:300265035 a skos:Concept ;
    skos:definition "A dealer in tapestries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry dealers"@en .

aat:300265036 a skos:Concept ;
    skos:definition "Refers to color photomechanical prints produced as lithographs from photographic negatives. The technique was developed in the 1890s in Switzerland by Hans Jakob Schmid at the company Orell Gessner Füssli, also known as Photoglob Zurich. The technique was introduced at the World Exposition in Paris in 1898 and it was used until ca. 1930s. The technique was one of the more successful attempts preceding color photography to produce color images; indeed, photochroms looks deceptively like color photographs unless viewed with a magnifying glass. A black and white image served as the base and a form of photolithography with as many as sixteen colors was used to make the final image. Photochroms are distinguished from chromolithographs by their hard clear coating. The patented process was licensed to firms in England and America; most photochroms are scenic views of the American West, Europe, and the Middle East. William Henry Jackson and the Detroit Publishing Company were responsible for a large number of photochroms. Captions are often in gold lettering, on the lower portion of the recto, identifying the view and sometimes the maker. The process was labor intensive and time consuming and was replaced by faster and easier techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photochroms"@en .

aat:300265037 a skos:Concept ;
    skos:definition "Refers to watermarks that are darker than the surrounding area on the sheet. A shaded watermark is produced by a depression in the sheet mold wire; when wet pulp flows into the recesses, the design is formed as different gradations of tone. The intaglio design, as opposed to a relief design, results in a thickening of the sheet at the point of contact, creating an opaque, or \"shaded,\" design. It is a rather rare type of watermark; it has been produced since the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaded watermarks"@en .

aat:300265038 a skos:Concept ;
    skos:definition "Gunsmith that specializes in fitting the stocks of guns to their barrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gun-stockers"@en .

aat:300265039 a skos:Concept ;
    skos:definition "Refers to watermarks that are translucent and thus lighter than the surrounding area on the sheet. Its effect is the result of a wire design laid over and sewn onto the sheet mold wire (for handmade paper) or attached to the dandy roll (for machine-made paper). The design presses against the surface of the paper and displaces fibers to make the watermark. It is a more common type of watermark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wire watermarks"@en .

aat:300265040 a skos:Concept ;
    skos:definition "Refers to watermarks showing three thicknesses in the same sheet of paper, created by depressing or raising portions of the mold wiring or even by placing a bas-relief image in the mold, giving the effect of sculpture in the paper. Seen through light, the paper shows portions both lighter and darker than the paper substance itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-plane watermarks"@en .

aat:300265041 a skos:Concept ;
    skos:definition "Refers to detailed watermarks produced by a relief sculpture on the paper mold. The technique was supposedly invented in 1848 by the Englishman William Henry Smith. The light and shade watermark created more detail than the wire watermark. It is often used in paper money to make counterfeiting more difficult."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light-and-shade watermarks"@en .

aat:300265042 a skos:Concept ;
    skos:definition "A type of still life depicting simple foodstuffs, such as fish, ham, fruit, cheese, or bread, with a glass of beer or wine. Though ontbijtje is Dutch for \"little breakfast,\" paintings categorized as such do not necessarily depict items of a typical Dutch breakfast; the foodstuffs depicted are those that would be consumed at a light meal at any time of day. Ontbijtje were especially popular in the Netherlands during the 1620s and 1630s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ontbijtjes"@en .

aat:300265043 a skos:Concept ;
    skos:definition "A type of still life painting featuring lavish arrangements of expensive foodstuffs and serving pieces. A typical banquet piece might include such luxury items as lobsters, oysters, exotic fruits, and decorated pies in raised crusts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banquet pieces"@en .

aat:300265045 a skos:Concept ;
    skos:definition "Still lifes depicting predominantly flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower pieces"@en .

aat:300265046 a skos:Concept ;
    skos:definition "Still lifes depicting predominantly fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit pieces"@en .

aat:300265047 a skos:Concept ;
    skos:definition "Still lifes depicting an arrangement of poultry, duck, suckling pig, hare, rabbit, or any other type of game. Because game hunting was reserved for nobility, some historians believe that people of lesser rank purchased these works in an effort to associate themselves with the more privileged class. This type of still life developed in the second half of the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "game pieces"@en .

aat:300265048 a skos:Concept ;
    skos:definition "Still life paintings depicting a combination of items found in a kitchen, often including food, utensils, and vessels, as if in the process of meal preparation, and often laid out on a working table of the type that would have been set in the center of the kitchen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kitchen pieces"@en .

aat:300265049 a skos:Concept ;
    skos:definition "A type of banquet piece which has as its distinguishing feature a quality of ostentation and splendor; they usually depict one or more especially precious objects. This type developed in the second half of the 17th century although the term is a post-17th century invention. The Dutch word 'pronk' means 'ostentation.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pronk still lifes"@en .

aat:300265050 a skos:Concept ;
    skos:definition "Still life paintings depicting fish and other items of food preparation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish pieces"@en .

aat:300265051 a skos:Concept ;
    skos:definition "Genre scenes that depict soldiers drinking, resting, and gambling. Coortegardjes enjoyed their greatest popularity during the 1620s and 1630s, perhaps as a result of Dutch preoccupation with the ongoing war with Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coortegardjes"@en .

aat:300265052 a skos:Concept ;
    skos:definition "Refers to a type of Dutch still life in which a ham is prominently featured. The term translates from the Dutch as \"little ham.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammetje"@en .

aat:300265053 a skos:Concept ;
    skos:definition "Refers to a type of still life that features smokers' accoutrements such as tobacco pipes, smoldering hemp wicks, and braziers of burning coals. Jugs of beer or glasses of wine are also typically depicted. The term tabakje is translated from the Dutch as \"little tobacco.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabakje"@en .

aat:300265054 a skos:Concept ;
    skos:definition "Images, especially Spanish, in which still life predominates, though it is often part of a kitchen or eating scene. The term was mainly used up to ca. 1650 in Spain. These genre scenes were sometimes set in the rough public eating establishments from which they take their name. By association, however, the term was applied to a wide range of genre paintings depicting figures of humble origin, often with food and drink. As early as the 1590s Flemish and Italian kitchen and market scenes were referred to as bodegones in Spanish inventories. Such paintings were imitated by Spanish artists. Bodegones, such as those by Diego Velázquez, were often regarded as inconsequential and even disreputable by contemporary society. They were generally monochromatic so as to emphasize relief and volume. Due to the still life aspects of bodegones, over time the term came to refer to still lifes in general; up until the mid-17th century, Spanish still lifes, like their Dutch counterparts, were referred to by their specific contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodegones"@en .

aat:300265055 a skos:Concept ;
    skos:definition "Small, long-necked Pre-Columbian vases; many examples have been found at sites such as Teotihuacán."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floreros"@en .

aat:300265056 a skos:Concept ;
    skos:definition "An establishment providing entertainment in the form of strip-tease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strip clubs"@en .

aat:300265057 a skos:Concept ;
    skos:definition "Cans made of tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tin cans"@en .

aat:300265058 a skos:Concept ;
    skos:definition "Cans made of aluminum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum cans"@en .

aat:300265059 a skos:Concept ;
    skos:definition "Portraits in which the portrayed subject or subjects are depicted as historical or mythological figures, who often take on some of the moral weight of the history painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historiated portraits"@en .

aat:300265060 a skos:Concept ;
    skos:definition "Refers to the various costumes worn by university and collegiate faculty, administrators, and graduating students at graduation ceremonies and other special occasions. The most common element of academic costume is the gown, a tradition dating to the Middle Ages. Decorative hoods and various caps, including the mortarboard, are other common elements of academic costume. Trimmings of various colors may be used to refer to different disciplines of study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic costume"@en .

aat:300265061 a skos:Concept ;
    skos:definition "Residences located at a distance from a monastery or convent and used by the monks or nuns as asylums in times of war and as pied-à-terres in times of peace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monastic refuges"@en .

aat:300265062 a skos:Concept ;
    skos:definition "Devices of the 18th century for viewing \"perspective view prints,\" which are pseudo-stereoscopic images. These table-top viewers consist of a wooden stand supporting a hinged mirror and lens, used to view a flat image placed on the table next to the stand. A perspective effect is created through a combination of image design and lens and mirror properties. Surviving examples are elegant and highly collectible pieces of mahogany furniture, designed for the drawing rooms of affluent homes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zograscopes"@en .

aat:300265063 a skos:Concept ;
    skos:definition "Refers to special ornate capital letters in illuminated manuscripts marking the beginning of a section of text such as a verse or paragraph. In modern calligraphy the term is applied to capitals built up by inking between pen strokes and having serifs in the form of long, thin, straight lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "versals"@en .

aat:300265064 a skos:Concept ;
    skos:definition "Tables that can perform a variety of functions by rearranging or removing its parts such as the top and drawers, for example, to transform from a dressing table to a writing desk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical tables"@en .

aat:300265065 a skos:Concept ;
    skos:definition "A type of deeply etched, crystalline glass developed by Bernard O. Gruenke and his son, Bernard E. Gruenke, Jr., in the 1970s. The glass was inspired by a Czechoslovakian etched glass exhibit they saw at the World's Fair in Osaka, Japan; they called their glass \"leptat,\" a word derived from the Czech meaning \"to etch,\" in honor of its inspiration. The etching technique was later patented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leptat glass"@en .

aat:300265066 a skos:Concept ;
    skos:definition "Refers to small plaques available at the major shrines visited by pilgrims and worn by successful pilgrims as a souvenir and proof of their journey. The badges celebrated the saint or devotional object venerated at the pilgrimage site. Amongst the most distinctive pilgrim badges are the scallop-shell badges from the shrine of St James in Santiago de Compostella, a badge sold as early as the 11th century. Badges were usually made of metal and were usually worn pinned to a hat. Badges also provided practical benefits, by marking the wearer as a person entitled to aid, hospitality and safe-conduct, for example; there were also supernatural benefits since badges were normally allowed to touch the shrine they commemorated and were thus thought to be transformed into secondary relics. Pilgrim badges were especially popular in the Middle Ages in Europe, particularly in the 14th and 15th centuries, but declined after the Reformation of the mid-16th century. However, there are a few instances of sites that continue to use associated badges in the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrim badges"@en .

aat:300265067 a skos:Concept ;
    skos:definition "Refers to souvenirs acquired at pilgrimage sites that served as tokens of accomplished pilgrimage. Such souvenirs include badges and ampullae sold at pilgrimage sites, and even more valuable objects taken or presented as gifts from the shrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrim souvenirs"@en .

aat:300265068 a skos:Concept ;
    skos:definition "Ornamental sculptures found on the front ends of boats and canoes. For prow ornaments sculpted in the form of a human figure, use the specific term \"figureheads.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prow ornaments"@en .

aat:300265069 a skos:Concept ;
    skos:definition "Ornamental sculptures placed on the front ends of canoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canoe-boards"@en .

aat:300265070 a skos:Concept ;
    skos:definition "Ornamental sculptures located on the front ends of pirogues, or dugouts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pirogue ornaments"@en .

aat:300265071 a skos:Concept ;
    skos:definition "Technique in which wet, inked lines on non-absorbent paper were folded along a hinge and pressed against a second piece of paper, transferring the inked lines. The technique has been associated with the early commercial artwork by artist Andy Warhol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blotted line technique"@en .

aat:300265072 a skos:Concept ;
    skos:definition "Drawings where wet, inked lines on non-absorbent paper are folded along a hinge and pressed against a second piece of paper, transferring the inked lines. Generally associated with the early commercial artwork by artist Andy Warhol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blotted line drawings"@en .

aat:300265077 a skos:Concept ;
    skos:definition "Refers broadly to the culture and styles associated with the territory surrounding the Nile river in northeast Africa, particularly the area of the modern nation of Egypt and dating to after the ancient periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian"@en .

aat:300265078 a skos:Concept ;
    skos:definition "The act of speaking very quietly, without vibration of the vocal chords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whispering"@en .

aat:300265079 a skos:Concept ;
    skos:definition "Scrolls, displayed vertically, that contain text, artwork, or both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging scrolls"@en .

aat:300265080 a skos:Concept ;
    skos:definition "Chinese handscrolls, containing text, artwork, or both, and are displayed horizontally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoujuan"@en .

aat:300265081 a skos:Concept ;
    skos:definition "Chinese scrolls containing calligraphy and/or pictures, intended to be unrolled vertically and hung on the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lizhou"@en .

aat:300265082 a skos:Concept ;
    skos:definition "Photographic process that uses light to print onto photosensitized paper a drawing on a glass plate (or another translucent surface). The resulting print contains elements of both printmaking and photography. The term is often used for both the process, the negative, and also the resulting print. The technique was developed in the 1830s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cliché-verre"@en .

aat:300265083 a skos:Concept ;
    skos:definition "Negatives made by drawing through a prepared ground applied to a glass plate (a subtractive process), or painting directly on a glass plate (an additive process)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clichés-verre"@en .

aat:300265085 a skos:Concept ;
    skos:definition "African people living in Southern Zambia and Northern Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwandi"@en .

aat:300265086 a skos:Concept ;
    skos:definition "Vessels made for domestic preservation of meat and fish, usually for short periods of time, and often covered with a layer of fat or butter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potting pots"@en .

aat:300265087 a skos:Concept ;
    skos:definition "HIstorically, sticks or rods made of wood or other materials, and marked with transverse notches for the purpose of counting or measuring a debt or payment. Some tallies were split, and a debtor and creditor would each retain halves of the sticks which would be cleft lengthwise across the notches, constituting legal proof of the debt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tallies"@en .

aat:300265088 a skos:Concept ;
    skos:definition "Toys comprising a icosidodecahedron structure (a type of polyhedron) that resembles a geodesic dome; it can be folded to a fraction of its extended form via scissor-like actions of its joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hoberman spheres (TM)"@en .

aat:300265089 a skos:Concept ;
    skos:definition "Closed-circuit television system where programs are transmitted via coaxial or fiber-optic cable (as opposed to airwave transmissions) to connected subscribers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cable television"@en .

aat:300265090 a skos:Concept ;
    skos:definition "Shape or form delimited by two curves intersecting so as to delimit a space that is overall narrow but wider in the middle and tapering to a point on both ends (sometimes only on one end), thus resembling a spear or lance-head. For similar forms that are overall wider, use \"almond-shaped.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lanceolate"@en .

aat:300265092 a skos:Concept ;
    skos:definition "Projectile points having a form where notches for hafting have been struck into the corners of its base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner-notched points"@en .

aat:300265093 a skos:Concept ;
    skos:definition "Projectile points having a form where notches for hafting have been struck in the sides of a blade near its base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side-notched points"@en .

aat:300265094 a skos:Concept ;
    skos:definition "Projectile points or blades with a stem-like extension of the base to allow hafting or gripping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stemmed points"@en .

aat:300265095 a skos:Concept ;
    skos:definition "Decorative paper usually used as end leaves in printed or blank books. Traditional marbled paper is prepared one sheet at a time, the process beginning with a bath or trough of liquid gum, where colors for the marble pattern are sprinked onto the surface. Turpentine and oil, or gall, is often used as well. Patterns are then made by combing the solution, or by another method that produces the desired design. A sheet of paper is then placed in the bath, the colors in the solution adhere to the paper, and the paper is hung to dry. The process is generally considered to have been invented during the 16th century in the Near East, and soonafter spread to Europe. A variety of individual marbled paper types have been named pertaining to their designs, although recent scholarship has deduced that these names have been arbitrarily used, if not misused, throughout their history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbled paper"@en .

aat:300265096 a skos:Concept ;
    skos:definition "Embossed, decorative paper produced using woodblocks and stencils, that is embellished with a metallic finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brocade paper"@en .

aat:300265097 a skos:Concept ;
    skos:definition "Marbled paper decorated to resemble the banded appearance of agate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agate marbled paper"@en .

aat:300265098 a skos:Concept ;
    skos:definition "Marbled paper prepared first with three colors which are then raked before two further colors are added in large blots, which press the first three colors into veins. White is later added in smaller spots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antique marbled paper"@en .

aat:300265099 a skos:Concept ;
    skos:definition "Marbled paper prepared to imitate the look of natural marble. The spots are of the same color, in a lighter tint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British marbled paper"@en .

aat:300265100 a skos:Concept ;
    skos:definition "Paper having a German pattern that is not true marbling, but was very popular in the 19th century and was classified as a marbled paper. It is characterized by heavy, small, dark spots with a darker outer rim on a bright-colored background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocoa marbled paper"@en .

aat:300265101 a skos:Concept ;
    skos:definition "Marbled paper where colors are not raked within the prepared bath, and instead combed to produce a whorl effect. A curl pattern may be made of one color only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curl marbled paper"@en .

aat:300265102 a skos:Concept ;
    skos:definition "Paper having a distinctive marbling design with swirls and Turkish spots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyprus marbled paper"@en .

aat:300265103 a skos:Concept ;
    skos:definition "Marbled paper where colors are mingled with a wired comb within the prepared bath, which produces \"scallops\" of colors, as opposed to \"veins\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch marbled paper"@en .

aat:300265104 a skos:Concept ;
    skos:definition "Marbled paper prepared in a similar fashion as the spotted technique used in antique marbled paper, but spots are in blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gloster marbled paper"@en .

aat:300265105 a skos:Concept ;
    skos:definition "Marbled paper prepared one of three ways: \"blue\", which shows a network of blue with small to medium white spots, \"four veins\", which contains red, yellow, green and blue, and \"hair vein marble\", which contains a ground color (black), which is driven into tiny veins using water or another substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italian marbled paper"@en .

aat:300265106 a skos:Concept ;
    skos:definition "Marbled paper usually prepared with five colors and then drawn with a rake or comb, and later drawn again with a fine wire comb. This produces a scalloped pattern. Dutch marbled paper is a variant of nonpareil marbled paper, with a slightly different color scheme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonpareil marbled paper"@en .

aat:300265107 a skos:Concept ;
    skos:definition "Papers with a pattern created by coating paper with one or more applications of colored paste made from flour and stamped or worked to create a simple and inexpensive design. The product is not considered true marbled paper, but it was used extensively for bookbinding and is classified with marbled papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste marbled paper"@en .

aat:300265108 a skos:Concept ;
    skos:definition "Marbled paper prepared so that the color spots have shell-like rings, darker in the center than around the edges, which is produced by adding oil to the color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell marbled paper"@en .

aat:300265109 a skos:Concept ;
    skos:definition "Marbled paper with light and dark waves that diagonally cross the marbled pattern. Occasionally the paper is folded or creased in squares or diamond shapes before staining to increase the effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish marbled paper"@en .

aat:300265110 a skos:Concept ;
    skos:definition "Marbled paper prepared with a turpentine mix, as well as the added oil or gall. The color then breaks into fine holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stormont marbled paper"@en .

aat:300265111 a skos:Concept ;
    skos:definition "Paper having a very unique pattern containing small suns with rays or a nimbus, achieved by adding a mixture of Kreolin solution after the color is thrown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun marbled paper"@en .

aat:300265112 a skos:Concept ;
    skos:definition "Marbled paper made in Sweden and having a characteristic spotted pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swedish marbled paper"@en .

aat:300265113 a skos:Concept ;
    skos:definition "Paper marbled to resemble tree calf, or tree marbled leather binding, which is decorated with marbling or staining in a tree-like branching pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tree marbled paper"@en .

aat:300265114 a skos:Concept ;
    skos:definition "Marbled paper showing black veins with orange, yellow and white portions. The dominant color is applied last, which pushes the other colors into fine veins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkish marbled paper"@en .

aat:300265115 a skos:Concept ;
    skos:definition "Marbled paper produced usually with two colors, usually a light and dark of the same color. Similar to Spanish marbled paper, but without the wave design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West End marbled paper"@en .

aat:300265116 a skos:Concept ;
    skos:definition "Marbled paper produced using five colors. During preparation, after the fourth color is added, the mix is raked, and the fifth is sprinkled in medium-sized spots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zebra marbled paper"@en .

aat:300265117 a skos:Concept ;
    skos:definition "Imitation marbled paper, produced by spotting various colors on paper with a brush. Often used for lining boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratted paper"@en .

aat:300265118 a skos:Concept ;
    skos:definition "Bowed instruments, the term for which appears in medieval Europe from the mid-12th century to the late 14th century. Its exact form seems to vary in different locations and periods, but it is related to \"vièle,\" \"fidel,\" and \"rebec.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gigues"@en .

aat:300265119 a skos:Concept ;
    skos:definition "String keyboard instrument mentioned in 14th to early 16th century texts. No accurate description exists of its construction but evidence suggests that it was a type of clavichord. It is said to have looked like an organ, but sounded by strings.The earliest known reference to it is from 1360, when Edward III of England presented one made by Jehan Perrot to John of France. References to the clavichord begin to appear around the middle of the 14th century; and as the harpsichord appeared only after 1390, it is assumed that use of the term 'chekker' indicated a struck string, rather than plucked string keyboard instrument, though documentation remains unclear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chekkers"@en .

aat:300265121 a skos:Concept ;
    skos:definition "Articles made of metal, especially utensils and tableware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalware"@en .

aat:300265122 a skos:Concept ;
    skos:definition "Writing produced involuntarily, when the subject's attention is focused elsewhere, performed in a waking or hypnotic state. In the late 19th century, automatic writing was frequently attributed to supernatural forces. In the 20th century, it has been viewed as an internal phenomenon, specifically in relation to theories of the personality. The Surrealists adopted this technique with the hopes that it would assist in tapping the unconscious."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automatic writing"@en .

aat:300265124 a skos:Concept ;
    skos:definition "Refers to the practice of making photographs with a pinhole camera. Light-sensitive film or paper is exposed through a tiny, lensless aperture: the resulting images have very great depth of field, but lack critical sharpness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinhole photography"@en .

aat:300265125 a skos:Concept ;
    skos:definition "By-products or debris produced during the manufacture of stone tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "debitage"@en .

aat:300265126 a skos:Concept ;
    skos:definition "Describes ceramic or objects of ceramic fashioned from a mixture of clay and crushed shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell-tempered"@en .

aat:300265127 a skos:Concept ;
    skos:definition "Window openings cut in the form of a quarter-circle, commonly found in Federal and Greek revival houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarter-round lights"@en .

aat:300265128 a skos:Concept ;
    skos:definition "Refers to the sacred scriptures of Islam, believed by Muslims to be the word of Allah and revealed to the prophet Muhammad between 610-632 CE by the angel Gabriel. The text may be embellished with geometric and vegetal decorations, but the traditional prohibition against representing living creatures is applied with particular force to texts of the Koran. Paintings illustrating narrative passages of the Koran never appear in manuscripts of the Koran itself, although they do appear in manuscripts of texts inspired by its themes. A definitive text of the Koran is believed to have been established within 30 years of Muhammad's death; it has remained unchanged since. The Koran comprises 114 chapters, or suras, which are roughly arranged by decreasing order of length, and primarily written in the voice of God. The text is poetry rather than prose, and as such is less concerned with narrative flow. In general, the early suras focus on summoning worshipers, appeals to worship one God, social justice, and stories of unbelieving peoples. The later suras contain social material and prescriptions concerning marriage, the family, ethical matters, and the Muslim community. The Koran has been the main source of Islamic legislation on issues ranging from divorce, times of worship, fasting, and warfare. It is frequently recited or chanted for devotional and liturgical purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qur'ans"@en .

aat:300265129 a skos:Concept ;
    skos:definition "Accounts detailing the process of probate including inventories, final expenses, and the dispensation of property. Historical probate accounts were mostly filed by women and therefore these accounts provide unique information on women's experience in handling property and the history of property relations between men and women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "probate accounts"@en .

aat:300265130 a skos:Concept ;
    skos:definition "Work comprising a series of fourteen devotional pictures or carvings recalling the passion of Christ from his condemnation to his burial. The devotional exercise of visiting and praying in front of each of the 14 stations originates from the practice of early Christian pilgrims who visited the scenes of the events in Jerusalem and walked the traditional route from the supposed location of Pilate's house to Calvary. The Stations of the Cross are the subject of personal and private devotions during Lent and Passiontide in Roman Catholic and some Anglican churches. The images are typically mounted on the inside walls of a church or chapel but may also be installed in such places as cemeteries, hospitals, religious houses, and on mountainsides. The Franciscans popularized this form of devotion in the late Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stations of the Cross"@en .

aat:300265131 a skos:Concept ;
    skos:definition "Devices for supporting a cross on the altar and by extension, any device for supporting or fixing a cross at or near the altar. As early as the 5th and 6th centuries there is evidence in Byzantine art of partly combined candlesticks and cross, which are the precursors to cross feet as the form developed in the later Middle Ages. There are four main groups of cross feet placed on the altar: four-sided, three-sided, circular, and architectural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross feet"@en .

aat:300265134 a skos:Concept ;
    skos:definition "In the context of archaeology, this term refers to nodules of stone from which flakes have been struck for making tools. The core can be either discarded or shaped further into a core tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cores"@en .

aat:300265135 a skos:Concept ;
    skos:definition "In archaeology, stone tools from which flakes have been removed from only one side of an edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unifaces"@en .

aat:300265136 a skos:Concept ;
    skos:definition "In archaeology, stone tools from which flakes have been removed from both sides or faces of an edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bifaces"@en .

aat:300265137 a skos:Concept ;
    skos:definition "In the context of archaeology, this term refers to thin, flat pieces of stone intentionally removed from a tool or core during the process of stone tool manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flakes"@en .

aat:300265138 a skos:Concept ;
    skos:definition "Buildings in which goods are stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storehouses"@en .

aat:300265139 a skos:Concept ;
    skos:definition "Refers to a whiteware specially compounded to serve an electrical insulator. Often used as an insulator in spark plugs and power lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical porcelain"@en .

aat:300265140 a skos:Concept ;
    skos:definition "Refers to a brass alloy of copper, zinc, and tin, with the appearance of silver or gold. Invented and largely produced in Mannheim, Germany, it was especially in use in the early 18th century. Mannheimer gold was often used to make inexpensive jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mannheim gold"@en .

aat:300265141 a skos:Concept ;
    skos:definition "An alloy of about five parts of copper with one of zinc that is used as imitation gold. It is similar to brass but contains more copper. It was invented by a London watchmaker named Christopher Pinchbeck, ca. 1740. Pinchbeck was often used in clock making and the production of inexpensive jewelry and snuffboxes, particularly by craftsmen in London."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinchbeck"@en .

aat:300265142 a skos:Concept ;
    skos:definition "Refers to an alloy used in the jewelry and watch trade during the 17th and 18th centuries, mostly in England; it was golden in color and was probably an alloy of copper and zinc that resembled brass. Some sources specifically describe it as a type of brass with a composition of three parts copper to one of zinc pickled in a diluted spirit of vitriol and then immersed in aquafortis before burnishing. Prince's metal was supposedly invented by Prince Rupert of the Rhine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prince's metal"@en .

aat:300265144 a skos:Concept ;
    skos:definition "Spanish Renaissance trestle stands used to support vargueños; oblong pulls on each side of the stand support the drop-front of the cabinet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pies de puente"@en .

aat:300265145 a skos:Concept ;
    skos:definition "Regarded as the central text of the Hindu religion, the Bhagavad-gītā, written ca. 200 BCE, is comprised of eighteen sections and a total of 700 verses which form part of the epic poem known as the Mahābhārata. The verses describe a dialogue between the warrior Arjuna and Lord Krishna, on the eve of a battle between Arjuna and members of his family. It is thought that the text was written at a time when Bhramanical religion had been splintered, with Buddhism and Jainism separated. The Bhagavad-gītā teaches that there may be many ways to salvation, and can be interpreted as an endorsement of reconciliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bhagavad-gītās"@en .

aat:300265146 a skos:Concept ;
    skos:definition "Instruments for measuring distances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diastimeters"@en .

aat:300265147 a skos:Concept ;
    skos:definition "Refers to one of the main service books of the Byzantine Church; it contains the text and rubrics for the Orthodox Christian liturgy of the eucharist, fixed parts of the daily office, and the other sacraments and minor rituals. The term sometimes refers more generally to collections of prayers or prayer books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "euchologions"@en .

aat:300265148 a skos:Concept ;
    skos:definition "Large groups of people, organized through the internet, who meet at a specific place at a specific time, perform according to written or loose instructions, then disperse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash mobs"@en .

aat:300265149 a skos:Concept ;
    skos:definition "Paper money representing standard monetary units in the United States, Canada, Australia, New Zealand, historically from states in the USA, and other places; each equal to 100 cents. Originally from a silver coin that circulated in many European countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollars"@en .

aat:300265152 a skos:Concept ;
    skos:definition "Platforms with wheels that hold cameras, and in the case of motion picture cameras, also often the camera operator. These may be used to film moving shots or moving or stationary subjects. Dollies can be used with or without dolly tracks to act as guides for movement. For still cameras these may facilitate moving large format cameras within a studio environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollies"@en .

aat:300265153 a skos:Concept ;
    skos:definition "Screens between the choir and body of the church, particularly the low screens that served to separate the chancel from the nave. Cancellos were widespread in the Early Christian period, particularly in Rome, and continued throughout the Middle Ages. This early form of screen was gradually expanded into the higher, deeper, and generally more elaborate rood screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cancellos"@en .

aat:300265155 a skos:Concept ;
    skos:definition "Chancel screens surmounted by a cross or crucifix, and which evolved from 'rood beams.' Rood screens are often richly adorned and are sometimes double with vaulting between and a rood loft on top. The French term of 'jubé' derives from the Latin phrase Jube domine benedicere (\"Let us bless the Lord\"), which is often said by Catholic priests before the lesson while standing in front of the screen; some jubés have a balcony or platform from which to preach to the laity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rood screens"@en .

aat:300265156 a skos:Concept ;
    skos:definition "Refers to screens comprising two or more panels in a frame which has hinged sections that can be folded to adjust coverage. They are often decorated. Early examples include the Chinese form, mentioned as early as the 2nd century BCE. The earliest surviving examples date to the Ming dynasty. Folding screens were introduced to Japan from China in the 8th century; such screens were often designed in pairs in Japan. From the early 17th century eastern folding screens were imported to Europe and the form was soon adopted by European craftsmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding screens"@en .

aat:300265157 a skos:Concept ;
    skos:definition "Refers to screens surrounding or placed in front of confessionals in order to shield penitents from public view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pardon screens"@en .

aat:300265160 a skos:Concept ;
    skos:definition "Refers to ornamental devices of any kind, especially grilles or lattices, fitted into window openings. In the United States the term more specifically refers to screens of mesh designed to be put across window openings to admit air while excluding insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window screens"@en .

aat:300265162 a skos:Concept ;
    skos:definition "Surveying areas for the purpose of determining the character of mineral deposits and rock masses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological surveying"@en .

aat:300265163 a skos:Concept ;
    skos:definition "Artistic aesthetic developed by John Weichsel, influenced by the writings of the German art historian Wilhelm Worringer, and steeped in anarchist philosophy. The Cosmist aesthetic was put into practice by such artists as Elie Nadelman and Adolf Wolff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cosmist"@en .

aat:300265164 a skos:Concept ;
    skos:definition "Photograph popular in the 1870s which measured approximately 8 1/4 inches by 5 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boudoir photographs"@en .

aat:300265165 a skos:Concept ;
    skos:definition "Photograph or photographic mount which measured between 6 7/8 inches by 10 inches, and 7 7/8 inches by 9 7/8 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial photographs"@en .

aat:300265166 a skos:Concept ;
    skos:definition "Photograph introduced in 1875 as a variation of the cabinet photograph. Measuring approximately 9.5 centimeters by 19 centimeters, the size was meant to allow for photos of standing figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promenade photographs"@en .

aat:300265167 a skos:Concept ;
    skos:definition "Card photographs that measured approximately 4 inches by 8.5 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel photographs"@en .

aat:300265168 a skos:Concept ;
    skos:definition "Card photographs or mounts which measured approximately 5 inches by 3 1/4 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "victoria cards"@en .

aat:300265169 a skos:Concept ;
    skos:definition "Refers to screens consisting of one panel, typically made of wood with low legs. The single-panel screen is generally the smallest of the three types of screens in East Asia. Single-panel screens in China were set in stands and were usually of lacquer; the panels often framed a painted picture, jade panel, or looking glass. In Japan such screens were stationery and used at the entrance of a house to denote status or a ceremony in progress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-panel screens"@en .

aat:300265170 a skos:Concept ;
    skos:definition "Refers to semi-permanent screens sliding in tracks that are characteristic features of traditional Japanese architecture. They can be open and closed or removed altogether to alter the dimensions or character of a room. Location determined the materials from which they were made: wood was typically used for screens near the exterior of a building, while screens made of wooden lattices covered with translucent paper, painted or upainted, were more often used for interior rooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fusuma"@en .

aat:300265171 a skos:Concept ;
    skos:definition "Refers to a type of Chinese folding screen that was typically very large, as tall as ten feet in height and twenty in length, with twelve panels of lacquered and gilded wood. Coromandel screens feature incised lacquer decoration and often have wide borders around the main design. The name comes from a part of the southeastern Indian coast near Madras that was a transfer point for Far Eastern goods being shipped to Europe by England's East India Company. Coromandel screens were mainly made in China in the 17th and 18th centuries for the European market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese Coromandel screens"@en .

aat:300265172 a skos:Concept ;
    skos:definition "A hard, insoluble coating prepared from the resinous exudation of Toxicodendron vernicifluum and Toxicodendron succedaneum, native to China and Japan. It contains urushiol, hydrourushiol, some polysaccharides, laccase, and water. It thickens and solidifies by oxidative polymerization when exposed to humid air, forming a hard, durable film that takes a high polish or may have a matte finish, and may be carved or inset with inlays. It has been used for at least 6,000 years as a protective and decorative coating, applied to wooden furniture, musical instruments, weapons, jewelry, and household items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urushi"@en .

aat:300265173 a skos:Concept ;
    skos:definition "Refers to a type of lacquerware made in central and northern China from the 17th century and particularly popular in the 18th century in European high society. Coromandel lacquerware is characterized by its incised decorations filled with brightly colored lacquer or oil paint. The name comes from a part of the southeastern Indian coast near Madras that was a transfer point for Far Eastern goods being shipped to Europe by England's East India Company. The most well-known Coromandel lacquerware are the large Coromandel screens. The term is sometimes used to refer to the technique of doing the lacquering. The Japanese were also familiar with the technique but rarely used it for their lacquerware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coromandel lacquer"@en .

aat:300265174 a skos:Concept ;
    skos:definition "Refers to small decorative screens, usually Chinese or Japanese, made to stand on tables. Table screens can be either single-panel screens or folding screens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table screens"@en .

aat:300265175 a skos:Concept ;
    skos:definition "Refers to a type of European, and especially French, ornament in which monkeys dressed in human clothing mimic such activities as drinking, dancing, hunting, and playing musical instruments. The monkeys are often placed in a setting of scrolling foliage or strapwork. Although ornamental monkeys had been depicted since the Middle Ages as a means to parody and mock the baser human activities, the taste for more elegant singerie first developed in the late 17th century in the work of Jean Bérain I and Claude Audran III. Singerie decoration reached its height of popularity in the 18th century (i.e. the work of Christophe Huet) when it became associated with chinoiserie, fading from fashion with the rise of Neoclassicism. It enjoyed another wave of popularity in the 19th-century revival of 18th-century taste. Singerie developed in part as a way of lampooning the excessive fadism for neo-Chinese forms of the aristocracy and wealthy bourgeoisie which some artists considered pretentious. Singerie is found on porcelain, faience, and marquetry as well as embroidered and printed on textiles and painted on walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "singerie"@en .

aat:300265176 a skos:Concept ;
    skos:definition "Officials in ancient Greece chosen to oversee althetic games such as torch-races, or to superintend athletic schools. The position was appointed annually, from ten tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gymnasiarchs"@en .

aat:300265177 a skos:Concept ;
    skos:definition "Ancient objects made from a composite material consisting of a body of sintered quartz coupled with an alkaline glaze surface. Faience was used for decorating beads, amulets, figurines, and other small objects. Invented in Mesopotamia or Iran ca. 4500 BCE, the production of faience continued until the mid-7th century CE. It is distinguished from later European earthenware, which is known by the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faience"@en .

aat:300265178 a skos:Concept ;
    skos:definition "Refers to half-tone color printing, usually using metal blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromotypography"@en .

aat:300265179 a skos:Concept ;
    skos:definition "General term for sheets printed in chromatic colors by any process. Examples would be relief prints made from metal blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromotypes"@en .

aat:300265180 a skos:Concept ;
    skos:definition "Carbon prints developed on collodionised glass, and stripped when dry. The name was given by Claude Léon and T. S. Lambert; the process to make these prints was in use in the United States from 1876."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromotypes"@en .

aat:300265181 a skos:Concept ;
    skos:definition "Refers to a type of potter's tool; ribs are curved pieces of wood or bone, characteristically having one flat and one curved edge. Ribs are used for shaping, curving, smoothing, trimming, or opening wet clay; they give the profile of the outside of a plate or pot. One hand presses outwards and upwards on the inside of the worked clay, while outside the rib is used to create a smooth surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribs"@en .

aat:300265182 a skos:Concept ;
    skos:definition "Photomechanical prints, in color, and usually tinted relief halftones. Used in France in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromotypogravures"@en .

aat:300265183 a skos:Concept ;
    skos:definition "A composite material consisting of a body of sintered quartz coupled with an alkaline glaze surface, and used for decorating beads, amulets, figurines, and other small objects. It was invented in Mesopotamia or Iran ca. 4500 BCE, and produced through the mid-7th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faience"@en .

aat:300265184 a skos:Concept ;
    skos:definition "Projecting bands, usually of masonry, that support or decorate domes or vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribs"@en .

aat:300265188 a skos:Concept ;
    skos:definition "Books having content related to the topic of science or a particular branch of science, often with illustrations, graphs, and charts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science books"@en .

aat:300265191 a skos:Concept ;
    skos:definition "Factory buildings in which automobiles are produced or assembled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automobile factories"@en .

aat:300265192 a skos:Concept ;
    skos:definition "Materials, byproducts, or objects that have been recovered or diverted and utilized in place of raw or virgin material in manufacturing a new product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recycled materials"@en .

aat:300265193 a skos:Concept ;
    skos:definition "Portraits painted on two sides of a support, one side being either an alternate view or an allegorical composition related to the subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-sided portraits"@en .

aat:300265194 a skos:Concept ;
    skos:definition "Vases in the form of masted ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaisseaux à mât"@en .

aat:300265196 a skos:Concept ;
    skos:definition "Refers to a type of French chaise longue featuring a foot surrounded on three sides by a low curving back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duchesses en bateau"@en .

aat:300265197 a skos:Concept ;
    skos:definition "Refers to a simpler type of bed that originated in France in the first half of the 17th century, replacing the massive carved frames of earlier beds. The frame of a lit à housse was a simple cubelike form, broken only by plumed finials at the corners of the tester, and covered entirely in fabric. This type of bed featured a deep valance and four curtains: two wide curtains went from the center of the foot of the bed round the outside of the footposts and to the center of the sides; two narrow curtains went from the bedhead to the center of the sides. Towards the end of the century the lit à housse became more elaborate and taller, although the frame continued to be entirely covered by fabric. Lits à housse are so-called because they resemble a grand state bed with its protective covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits à housse"@en .

aat:300265198 a skos:Concept ;
    skos:definition "Surveys which investigate and determine the distribution and origin of mineral deposits and rock masses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological surveys"@en .

aat:300265199 a skos:Concept ;
    skos:definition "Silver beaten out into thin leaf for use in gilding. Silver leaf is about three times as thick as gold leaf because silver is less malleable but the resulting leaf is easier to handle. It requires lacquering or varnishing to prevent tarnishing; for this reason it is often replaced by palladium leaf. In the commerical arts inexpensive aluminum leaf is used to achieve the effect of silver leaf. Silver leaf can also be covered with a golden yellow transparent coating as a substitute for gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver leaf"@en .

aat:300265200 a skos:Concept ;
    skos:definition "A thin, beaten leaf used in gilding for a silvery effect. It is often used as a replacement for silver leaf because palladium, a precious metal that is part of the platinum group of elements, does not tarnish at normal temperatures. Palladium leaf is slightly duller in appearance than silver leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palladium leaf"@en .

aat:300265201 a skos:Concept ;
    skos:definition "A thin leaf used in gilding for a silvery effect. Because of its relatively dull, leaden appearance, aluminum leaf is an inferior substitute for silver leaf and palladium leaf. It is mainly used in the commercial arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum leaf"@en .

aat:300265202 a skos:Concept ;
    skos:definition "Persons who takes part in fighting with the fists, especially for sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxers"@en .

aat:300265203 a skos:Concept ;
    skos:definition "The practice or art of choosing, cooking, and eating good food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gastronomy"@en .

aat:300265204 a skos:Concept ;
    skos:definition "The process of making wine, which is the fermented juice of the grape used as a beverage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine making"@en .

aat:300265205 a skos:Concept ;
    skos:definition "The process of making cheese, which is the curd of milk (coagulated by rennet) separated from the whey and pressed into a solid mass, used as food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese making"@en .

aat:300265206 a skos:Concept ;
    skos:definition "Refers to the religious order founded ca. 1140 by Gilbert of Sempringham (ca. 1083-1189) in Lincolnshire, England. The only purely English monastic order, it included both men and women. Gilbert attempted to model his order on that of the Cistercians; when the Cistercians refused to accept communities of nuns under their aegis, Gilbert had his nuns instructed by priests following the Augustinian Rule. Until the dissolution the Gilbertines were popular and were favored by the Crown, as they did not owe allegiance to foreign superiors as did members of other orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gilbertine"@en .

aat:300265207 a skos:Concept ;
    skos:definition "Works of church music written to be sung as a single vocal line in free rhythm and a restricted scale, in a style developed for the medieval Latin liturgy. It is monodic and does not need instrumental accompaniment although this may be provided. Gregorian chant is named after Saint Gregory the Great (ca. 540-604) who is said to have standardized it. Gregorian chant refers to a Roman form of early plain chant as distinguished from the Ambrosian, Galliean, and Mozarabic chants, which were similar, but were gradually supplanted by it from the eighth to the eleventh century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gregorian chants"@en .

aat:300265208 a skos:Concept ;
    skos:definition "A confection made of a thick paste of ground almonds, sugar, and egg whites or yolks. The paste is formed into small sweets or petits fours. It can be molded into decorative forms and can also be used for icing cakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marzipan"@en .

aat:300265209 a skos:Concept ;
    skos:definition "The study of reproductive organs, systems, and processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproductive biology"@en .

aat:300265210 a skos:Concept ;
    skos:definition "Meetings at which participants are the leaders and members of a given labor union."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "union meetings"@en .

aat:300265211 a skos:Concept ;
    skos:definition "A mixture of oil, usually olive oil, and balsam that is consecrated for use as an unguent in the administration of certain sacraments (baptism, confirmation, and ordination) and in the performance of certain ecclesiastical functions in the Catholic, Orthodox, and Anglican churches. It is consecrated on Maundy Thursday by bishops in the West and by patriarchs in the East. In Orthodox churches the mixture can also include other ingredients such as wine, nuts, and gum. The annointing with chrism is sometimes called chrismation, especially after baptism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrism"@en .

aat:300265212 a skos:Concept ;
    skos:definition "Ceremonial anointing with chrism, especially immediately after baptisms in the Orthodox Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrismation"@en .

aat:300265213 a skos:Concept ;
    skos:definition "A traditional form of popular musical comedy in Spain. The term supposedly derives from the name \"Real Sitio de la Zarzuela\" in Madrid, where such works were first performed in the early 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zarzuela"@en .

aat:300265214 a skos:Concept ;
    skos:definition "A recreation of an event, often of cultural or historical significance, such as a battle, frequently performed in period costume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reenactments"@en .

aat:300265215 a skos:Concept ;
    skos:definition "Nuns governing their own houses (priories) or nuns ranking next below an abbess in an abbey in a position similar to that of a claustral prior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prioresses"@en .

aat:300265216 a skos:Concept ;
    skos:definition "Groups of people, specializing in different crafts, creating motion pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film crews"@en .

aat:300265217 a skos:Concept ;
    skos:definition "Floor of a building that is partially both below and above ground level, and lacking an entrance at that level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English basements"@en .

aat:300265218 a skos:Concept ;
    skos:definition "A concept in the Indian tradition of aesthetics that refers to the aesthetic experience produced by a work of art. The term is sometimes translated as flavor, mood, or aesthetic delight. Theoreticians identified eight major moods: erotic, humorous, heroic, furious, piteous, wondrous, terrifying, and disgusting. A work of art had to have, in addition to a major mood, other features such as accompanying minor moods, determinants, and consequents; these features, in varying combinations, produced the overall aesthetic experience. Each of the eight rasas is associated with a specific color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rasa"@en .

aat:300265219 a skos:Concept ;
    skos:definition "A doctrine deriving from a schism that occurred in Christian North Africa ca. 311 CE. The Donatists arose due to a disagreement over the election of Cæcilian as the Bishop of Carthage. The local bishops consecrated Donatus, a rival, for whom the sect is named. Occasionally persecuted, the sect survived until the Islamic conquest, during the 7th-8th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Donatism"@en .

aat:300265220 a skos:Concept ;
    skos:definition "Refers to painted, photographic, or sculptural portraits that are created by combining multiple parts to make a face, including images where objects such as books, vegetable matter, or other images are combined to form physiognomic constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite portraits"@en .

aat:300265221 a skos:Concept ;
    skos:definition "Generally refers to a rather rough imitation of incised Coromandel lacquer made in England in the 17th century. In 17th- and early 18th-century literature the term sometimes refers to the genuine article as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bantam work"@en .

aat:300265222 a skos:Concept ;
    skos:definition "An anti-modernist movement in early to mid-20th century Germany that focused on an idealized German past in order to combat a perceived threat stemming from French Impressionism, and other influences deemed as \"foreign\". The movement was exploited by Adolf Hitler for purposes of propaganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Idealist"@en .

aat:300265223 a skos:Concept ;
    skos:definition "Curule-type chair that derives from the x-frame folding stools of ancient Egypt. It is characterized by a non-folding curule base supporting an embossed leather or cane sling back and seat. Believed to be of Spanish origin, they are named for the port city on the Yucatán Peninsula. Often found in Louisiana among plantation furniture of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campeche chairs"@en .

aat:300265224 a skos:Concept ;
    skos:definition "Used to describe photography by conceptual artists from the 1960s onward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Photoconceptualism"@en .

aat:300265225 a skos:Concept ;
    skos:definition "Style in imitation of Wemyss ware and produced by the Kirkcaldy pottery of David Methven and Sons. The Kirkcaldy pottery is near the Fife Pottery which produced Wemyss ware. Abbotsford ware may indeed have been decorated by artists from the Fife Pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abbotsford"@en .

aat:300265226 a skos:Concept ;
    skos:definition "Objects of art or architecture that are known to have existed, usually through written documentation, but are no longer accounted for."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost works"@en .

aat:300265228 a skos:Concept ;
    skos:definition "Storehouses for artifacts and other archaeological materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological storehouses"@en .

aat:300265229 a skos:Concept ;
    skos:definition "Mahogany wood having a spotted or mottled pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acajou moucheté"@en .

aat:300265230 a skos:Concept ;
    skos:definition "Refers to beds in the shape of a shallow basket, primarily found during the period of the French Restoration in the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits en corbeille"@en .

aat:300265231 a skos:Concept ;
    skos:definition "German drinking glasses that are tall, cylindrical, and decorated in enamel with the imperial double eagle of the Holy Roman Empire. The eagle's breast is usually covered with either a large crucifix or a ball of empire and the wings are sometimes decorated with the heraldic arms of the families or ranks of the Empire. They may or may not have covers. Reichsadlerhumpen were popular from the mid-16th century through the 17th century; the earliest example dates from 1547."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reichsadlerhumpen"@en .

aat:300265232 a skos:Concept ;
    skos:definition "German drinking glasses that are tall, cylindrical, and decorated in enamel with portraits of the Holy Roman Emperor with the seven Electors. The emperor can be depicted on horseback with the three spiritual electors behind him and four princes below, or the kaiser can be depicted enthroned, with three or four princes on either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kurfürstenhumpen"@en .

aat:300265233 a skos:Concept ;
    skos:definition "German drinking glasses that are tall, cylindrical, and decorated in enamel with mountain landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fichtelgebirgehumpen"@en .

aat:300265234 a skos:Concept ;
    skos:definition "Refers to the slightly undulating wooden surface finished with an adze, a type of axe with the blade set at right angles to the handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adzed surface"@en .

aat:300265236 a skos:Concept ;
    skos:definition "Motifs representing the heads of rams or goats used in antiquity to decorate altars, sarcophagi, and funerary urns; revived as an ornamental device during the Renaissance and used to decorate furniture in the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aegricanes"@en .

aat:300265237 a skos:Concept ;
    skos:definition "A German type of singerie found on porcelain, introduced at Meissen ca. 1750-1760, probably by Johann Joachim Kändler. Musician monkeys had appeared in singerie painting earlier in such work as that of David Teniers II. Affenkapelle porcelain groups typically consist of twenty or so figures. Other European porcelain factories imitated he groups produced at Meissen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Affenkapelle"@en .

aat:300265238 a skos:Concept ;
    skos:definition "Refers to pierced or perforated metalwork. For open work jewelery that uses threads that are soldered together use \"filigree.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ajouré"@en .

aat:300265239 a skos:Concept ;
    skos:definition "A French fashion, originally a court jewel, which was derived from the pilgrim badge and worn on a hat. It was meant to convey the personal ambitions of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enseignes"@en .

aat:300265240 a skos:Concept ;
    skos:definition "Spanish water vessels of porous, unglazed earthenware used for cooling water by evaporation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcarrazas"@en .

aat:300265241 a skos:Concept ;
    skos:definition "Distinctive visual works composed of individually shaped stones of varying colors used to make a composition. The works may be low-relief or flat. An example is as used for a pendant or gem, where the commesso work is often coupled with enamel, gold, and gems. Although usage may overlap, for larger works, such as table tops, using a similar technique, use \"pietra dura (visual works).\" For works utilizing differently colored layers of a single material to create the design, use \"cameos.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commessi"@en .

aat:300265242 a skos:Concept ;
    skos:definition "Early gold-tooled bookbindings made in Venice and other locations in northern Italy. Stylized arabesques or a small trefoil leaf called an 'Aldine fleuron' often decorate the angles. Simple geometric strapwork or rectangular panels of gold fillets with the book's title or author's name stamped in the middle are typical decorations on these bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aldine bindings"@en .

aat:300265243 a skos:Concept ;
    skos:definition "A type of needle lace made in and around Alençon, France, as well as similar lace made elsewhere. Venetian lace makers were brought to France by Colbert in 1665 and settled in Alençon in 1765, establishing a lace industry under government protection. The industry declined over the course of the 18th century but was revived under Napoleon and again during the Second Empire. Alençon lace is characterized by a uniform square mesh with twisted sides, heavy use of modes, and bold main elements outlined with a conspicuous cordonnet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alençon lace"@en .

aat:300265244 a skos:Concept ;
    skos:definition "Decorations composed of mosaics formed of polygonal, colored glazed tiles in designs of geometric patterns. They have been used mostly for paving Spanish and Moorish patios, but also for wall surfaces. The expansion of the lands under Christian control in Spain in the 13th century led to a mixture of Gothic and Islamic styles evident in alicatados. Alicatados were superceded by mosaics composed of uniform tiles in the 14th century; by the 15th century alicatados were primarily used to surround tilework. The term is Spanish and means 'cut work.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alicatados"@en .

aat:300265245 a skos:Concept ;
    skos:definition "Style of blue-and-white decoration on maiolica in imitation of 15th-century Chinese wares. The term was first used by Cipriano Piccolpasso in the 16th century but the form of decoration itself, which proved to be quite popular, was introduced in the late 15th century in Italy as expensive Chinese porcelain began to be imported into Europe. Sometimes the term is used synonymously with \"alla damaschina\" which is better described as a different type of decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alla porcellana"@en .

aat:300265246 a skos:Concept ;
    skos:definition "Refers to a style of blue-and-white pottery decoration done in Italy beginning in the 15th century in imitation of Damascus wares. This decorative technique developed in response to the popularity of imported East Asian pottery. Sometimes the term is used synonymously with \"alla porcellana\" which is better described as a different type of decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alla damaschina"@en .

aat:300265247 a skos:Concept ;
    skos:definition "Distinctive Spanish glass rose water sprinklers typically characterized by the body of the vessel being ovoid or pear-shaped atop a high spreading foot. The vessel is intended to be filled through the neck. Four slender upright spouts come out of the shoulder. Almorratxes were most commonly found in Catalonia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almorratxes"@en .

aat:300265248 a skos:Concept ;
    skos:definition "Any technique for forming or shaping wax into sculptural shapes, either for casting purposes or as a final work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wax-modeling"@en .

aat:300265249 a skos:Concept ;
    skos:definition "General term for hard, patterned wood from any of several trees of the genus Pterocarpus that are native to southern Asia. Amboyna wood has a striped, curved or mottled grain that varies in color from pale yellow to a deep red. The medium texture polishes to a silky surface. It is used for veneer, inlay and decorative furniture. Amboyna burls are valued for veneers. The name, which dates to the 19th century, comes from Ambon island in Indonesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amboyna wood"@en .

aat:300265250 a skos:Concept ;
    skos:definition "Textile weaving looms operated by mechanical power, associated with the advent of the Industrial Revolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powerlooms"@en .

aat:300265251 a skos:Concept ;
    skos:definition "Wine glasses engraved with decoration to show support for the Jacobite bid for the throne, first made in 1688 and in large quantities after 1745. They were used for drinking loyal toasts, which was an act of treason. Engraved decoration included Jacobite anthems and symbols such as the rose with two buds (for the Old and Young Pretender), lily of the valley, daffodils, oak leaves, and moths. Jacobite glasses have been extensively faked or the decoration added at a later date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jacobite glasses"@en .

aat:300265252 a skos:Concept ;
    skos:definition "A type of Jacobite glass produced to commemorate the rising of 1715. Amen glasses are decorated with diamond point engraved prayers ending with \"Amen,\" thus their name. They also feature the elaborately scrolled letters \"I.R.\" with a concealed figure of eight and a crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amen glasses"@en .

aat:300265253 a skos:Concept ;
    skos:definition "A German type of 12th-century hanging pottery oil lamp with a mouth or mouths for one or more wicks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ampel"@en .

aat:300265254 a skos:Concept ;
    skos:definition "A type of German glass jug that is onion-shaped and has a neck or spout formed of several intertwined tubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angster"@en .

aat:300265255 a skos:Concept ;
    skos:definition "Panels or hangings for the front of a Christian altar, pulpit, or lectern; may be carved, painted, embroidered, or otherwise decorated. Antependia are of various materials including wood, ivory, precious metals, and embroidered textiles. The exposed position of precious antependia meant that they were sometimes moved on top of the altar for safety, thus becoming retables. If the coverings are continued around the sides and back they are called \"paraments\" or paliotti."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antependia"@en .

aat:300265256 a skos:Concept ;
    skos:definition "Carved, painted, embroidered, or otherwise decorated panels or hangings that cover all four sides of a Christian altar, as distinct from an antependium which covers the front alone. The term may also refer to similar hangings or ornaments of a room of state. The term formerly referred to both the vestments worn by the celebrants of Christian services and the hangings around the altar; over time it has come to mean only the hangings and panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paraments"@en .

aat:300265257 a skos:Concept ;
    skos:definition "Refers to a strong, heavy-looking bobbin lace made from the 17th century in Antwerp. A two-handled vase is the dominant decorative motif in Antwerp lace. The term can also be used more loosely to refer to other varieties of lace produced in Antwerp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antwerp lace"@en .

aat:300265258 a skos:Concept ;
    skos:definition "Silver spoons with the top of the handle surmounted by a small statuette of an apostle. Apostle spoons were intended for personal use at table and were highly popular in England ca. 1490-1675; they were also made on the Continent, especially in Germany. Sometimes apostle spoons were made as sets of thirteen, a dozen featuring the apostles and another topped with a figure of Jesus Christ, a so-called master spoon. Spoons featuring small statuettes of saints have also been called apostle spoons. In the 16th and 17th centuries apostle spoons were seemingly popular as christening presents. Silver-plated versions were made in the 20th century for use as demitasse spoons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apostle spoons"@en .

aat:300265259 a skos:Concept ;
    skos:definition "Refers to spouted drug jars intended for liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevrettes"@en .

aat:300265260 a skos:Concept ;
    skos:definition "Refers to pharmaceutical ceramics or glass that typically take the form of medium-sized jars, often cylindrical with short necks and glass stoppers although other shapes and sizes are found. Drug jars are made to hold medicine, spices, herbs, pigments, or other ointments, powders, and liquids. The term can sometimes refer specifically to sets of four or more jars originally sold to an apothecary and labeled with the name of a standard medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drug jars"@en .

aat:300265261 a skos:Concept ;
    skos:definition "Visual works in Hindu art and architecture, representing Shiva's phallic pillar. These objects are generally three-dimensional, in the shape of a phallus and worshipped as a symbol of the god Shiva."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lingams"@en .

aat:300265262 a skos:Concept ;
    skos:definition "Portayals of the navel of Vishnu or other form or symbol of the female organ of generation, used as an object of veneration among Hindus and others; often used in conjunction with the male symbol, the lingam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yonis"@en .

aat:300265263 a skos:Concept ;
    skos:definition "Large, usually round, flat plates or shallow bowls positioned on top of a pedestal or high base to elevate and display food. The pedestal may be attached in one piece with the plate, or the plate and pedestal may form separate pieces. A common example is an elevated cake stand or shallow bowl for fruit, or in other serving vessels in Western and Asian ceramics and metalware. Another example is a ceramic funerary object in Pre-Columbian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pedestal plates"@en .

aat:300265264 a skos:Concept ;
    skos:definition "Refers to paintings of genre scenes combined with portraits, often portraying idealized rural scenes and peasants or aristocratic patrons dressed as peasants. The term generally applies to such pictures produced in studios in the 18th-century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy pictures"@en .

aat:300265265 a skos:Concept ;
    skos:definition "Refers to a combination of cels intended to be shown together, for example a cel with a design and a background cel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cel set-ups"@en .

aat:300265266 a skos:Concept ;
    skos:definition "A controlled vocabulary is an organized arrangement of words and phrases that are used to index content and/or to retrieve content through browsing or searching. It typically includes preferred and variant terms and has a limited scope or describes a specific domain. Controlled vocabulary is a broader concept than authority file, encompassing authority files as well as other controlled lists of terminology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "controlled vocabularies"@en .

aat:300265267 a skos:Concept ;
    skos:definition "A controlled list is a simple list of terms used to control terminology. In a well-constructed controlled list, the following should be true: each term must be unique; terms should all be members of same class; terms should not be overlapping in meaning; terms should be equal in granularity/specificity; and terms should be arranged alphabetically or in another logical order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "controlled lists"@en .

aat:300265268 a skos:Concept ;
    skos:definition "Sets of terms that are considered equivalent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synonym rings"@en .

aat:300265269 a skos:Concept ;
    skos:definition "Access points to a bibliographical record based upon subject terminology, usually from a standardized or controlled vocabulary. Subject headings are words or phrases; pre-coordination of terminology is a characteristic of subject headings, meaning that they combine several unique concepts together in a string (e.g., \"Medieval bronze vessels\" combines a period, material, and work type in one heading)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subject headings"@en .

aat:300265271 a skos:Concept ;
    skos:definition "Shaman masks of the Yup'ik people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nepcetaqs"@en .

aat:300265272 a skos:Concept ;
    skos:definition "A scaraboid is a seal, setting in a ring, or other object in the general shape of a scarab--that is a ovoid domed shape with a flat bottom--but lacking the details that identify it as the scarab insect. Scaraboids may be decorated with designs unrelated to the original insect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scaraboids"@en .

aat:300265273 a skos:Concept ;
    skos:definition "Refers to cels actually used in the production of the animated work, for example, a cartoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "production cels"@en .

aat:300265274 a skos:Concept ;
    skos:definition "Refers to sculptures, often colossi, carved or cut from live rock formations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-cut sculpture"@en .

aat:300265275 a skos:Concept ;
    skos:definition "Ancient East African culture, partially identified by characteristic pottery ware found in southeastern Kenya and northeastern Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwale"@en .

aat:300265276 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ibeno"@en .

aat:300265277 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Borneo State, in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chibak"@en .

aat:300265278 a skos:Concept ;
    skos:definition "Carved wooden figures, usually just heads and often attached to wands or staffs, or to the head of a dancer. Made and used by the Kuyu and Mbochi people of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kebe-kebe"@en .

aat:300265279 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbosi"@en .

aat:300265280 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the Democratic Republic of Congo, near the border with Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Babukur"@en .

aat:300265282 a skos:Concept ;
    skos:definition "Refers to work produced by the African ethnic group of the same name, inhabiting the Volta Region of Ghana and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Avatime"@en .

aat:300265283 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mende-Nkwe"@en .

aat:300265284 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, an offshoot of the Sotho who migrated north to Barotseland (in western Zambia)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kololo"@en .

aat:300265285 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndombe"@en .

aat:300265286 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northwestern Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jita"@en .

aat:300265287 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northwestern Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwaya"@en .

aat:300265288 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jo Luo"@en .

aat:300265289 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jen"@en .

aat:300265290 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting southeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Efut"@en .

aat:300265291 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Ethiopa and Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burji"@en .

aat:300265292 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbangala"@en .

aat:300265293 a skos:Concept ;
    skos:definition "Money that was used in parts of Africa into the 20th century, comprising unadorned copper and iron rods, bars, and blade-shaped pieces. The blades may resemble hatchets, axes, knives, hoes, swords, spearheads, arrows, or other items. Rather than value accorded by weight, these currencies are priced by length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blade currency"@en .

aat:300265294 a skos:Concept ;
    skos:definition "In Pre-Columbian Mexico, small T-shaped hachuelas or axes used as money or a unit of exchange in markets. In Africa, full size objects in the shape of an ax and used as currency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "axe money"@en .

aat:300265295 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting eastern Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwame"@en .

aat:300265296 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ningawa"@en .

aat:300265297 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northeastern Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orma"@en .

aat:300265298 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting southwestern Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belanda Bor"@en .

aat:300265299 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting southwestern Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belanda Viri"@en .

aat:300265300 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Nigeria, in Bauchi State."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guruntum-Mbaaru"@en .

aat:300265301 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Geji"@en .

aat:300265302 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Nigeria, in Bauchi State."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zul"@en .

aat:300265303 a skos:Concept ;
    skos:definition "Refers to work produced by the African, Yoruba-speaking peoples of the same name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ijesha"@en .

aat:300265304 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ariaal"@en .

aat:300265305 a skos:Concept ;
    skos:definition "Refers to archaeological sites in present day Sudan which date from 4900-3000 BCE, and are divisible into Early (4900-3800 BCE) and Late (3800-3000 BCE) periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khartoum Neolithic"@en .

aat:300265306 a skos:Concept ;
    skos:definition "Refers to archaeological sites in present day Sudan which date from 8000 BCE to 4900 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khartoum Mesolithic"@en .

aat:300265307 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadjerai"@en .

aat:300265308 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agaw"@en .

aat:300265309 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kutu"@en .

aat:300265310 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kutu"@en .

aat:300265311 a skos:Concept ;
    skos:definition "Sloping roofs placed either against buildings so as to create smaller substructures (such as a sheds or outhouses) or over doorways or windows to protect from the weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penthouses"@en .

aat:300265312 a skos:Concept ;
    skos:definition "Wine decanter stands, or coasters, usually of silver, which are mounted on wheels with a swiveling handle and joined with a coupling. The decanter wagon was developed in England during the reign of George IV to avoid the need of dinner guests on either side of the king to rise and pass the wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decanter wagons"@en .

aat:300265313 a skos:Concept ;
    skos:definition "A jib crane designed with a boom that pivots around a post attached to a building column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "column cranes"@en .

aat:300265314 a skos:Concept ;
    skos:definition "Imaginary places where inhabitants lead fearful lives, and conditions are as bad as possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dystopias"@en .

aat:300265315 a skos:Concept ;
    skos:definition "The property of shining in the dark, or luminescence without sensible heat or combustion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphorescent"@en .

aat:300265316 a skos:Concept ;
    skos:definition "Viewers for full-plate Daguerreotype stereo pairs, designed and patented by Southworth & Hawes, ca. 1853. A large cabinet mounted on a cast-iron base could display ten stereo pairs in succession by means of a crank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand parlor stereoscopes"@en .

aat:300265317 a skos:Concept ;
    skos:definition "Crowns crafted for the funeral ceremony of young, unmarried women in England from the 17th through the 19th centuries. Never intended to be worn, they consist of dome-shaped wooden frames decorated with ribbons, flowers, rosettes, and the names of the decreased. They were either carried before the coffin or placed upon it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maidens' garlands"@en .

aat:300265318 a skos:Concept ;
    skos:definition "Spaces with fluidly curves surfaces, usually designed with the aid of computer software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blob architecture"@en .

aat:300265319 a skos:Concept ;
    skos:definition "Clocks with a running duration of eight days. They are either longcase or bracket in form. The interval for winding is seven days, but the additional day is to enable a day's delay in winding. They can often be identified by winding squares on the dial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eight-day clocks"@en .

aat:300265320 a skos:Concept ;
    skos:definition "Photographic process invented by Niépce and Daguerre in 1832, whereby images are produced by a process that utilized lavender dissolved in alcohol as the photosensitive agent. The resulting solution was then applied to a silver plate, and then exposed in a camera obscura for several hours."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physautotypes"@en .

aat:300265321 a skos:Concept ;
    skos:definition "Patented technique for mounting photographic images to Plexiglas, without resulting air bubbles or glue residue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diasec (TM)"@en .

aat:300265322 a skos:Concept ;
    skos:definition "Lengths of film or magnetic tape whose ends have been sliced together, so as to project or play back the same material continuously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loops"@en .

aat:300265323 a skos:Concept ;
    skos:definition "Shirts made from brightly colored printed fabric depicting images of the Hawaiian Islands: palm trees, outrigger canoes, fish, flowers, surfing, and hula dancers. Usually sold to, and worn by, tourists. First made in the 1930s from inexpensive fabric imported from Japan, the popularity of the garment peaked during the 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aloha shirts"@en .

aat:300265324 a skos:Concept ;
    skos:definition "Glassware produced by English glass-makers working in Irish factories ca. 1780-1825."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Irish glass"@en .

aat:300265325 a skos:Concept ;
    skos:definition "Processes in which particles are selectively removed from a liquid by means of their unequal diffusion through membranes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dialysis"@en .

aat:300265326 a skos:Concept ;
    skos:definition "Dialysis that is accelerated by an electromotive force which is applied to electrodes adjacent to the membranes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrodialysis"@en .

aat:300265327 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shoowa"@en .

aat:300265328 a skos:Concept ;
    skos:definition "Buildings or spaces for museums that are founded, run or patronized by local communities, which serve the aspirations and educational needs of the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community museums"@en .

aat:300265329 a skos:Concept ;
    skos:definition "Refers to works produced by the Shluh Berbers of the Western Atlas (Morocco)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soussi"@en .

aat:300265330 a skos:Concept ;
    skos:definition "Style and culture particular to one of the five geographically based subcultures of Igbo-speaking people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western Igbo"@en .

aat:300265331 a skos:Concept ;
    skos:definition "Wine decanters with wide bases and steeply sloping sides made for greater stability onboard a ship. Produced from 1780."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship's decanters"@en .

aat:300265332 a skos:Concept ;
    skos:definition "Refers to works produced by the Berber peoples living in southern Tunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chenini"@en .

aat:300265333 a skos:Concept ;
    skos:definition "Refers to works produced by the Tuareg peoples inhabiting Mali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ineslemen"@en .

aat:300265334 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Chad and Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Azza"@en .

aat:300265335 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Uganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "So"@en .

aat:300265336 a skos:Concept ;
    skos:definition "Money, made of metal rods, used as a medium of exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rod money"@en .

aat:300265337 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gumuz"@en .

aat:300265338 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murle"@en .

aat:300265339 a skos:Concept ;
    skos:definition "From 1772; describes a common shape of decanter produced by British, Irish, and American glassmakers, having an elongated neck and slightly squat, barrel shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prussian decanters"@en .

aat:300265340 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Meta"@en .

aat:300265341 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mankon"@en .

aat:300265342 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting southeastern Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mkako"@en .

aat:300265343 a skos:Concept ;
    skos:definition "Cranes with a horizontal load-supporting boom fastened to a rotating vertical column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jib cranes"@en .

aat:300265344 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reshe"@en .

aat:300265345 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Cameroon and Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wawa"@en .

aat:300265346 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moghamo"@en .

aat:300265347 a skos:Concept ;
    skos:definition "Carved or cast objects depicting the pre-Christian Norse symbol representing the god Thor's hammer, particularly related to the manufacture of lightning. Usually takes the shape of an inverted \"T\" or a swastika."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thor's hammers"@en .

aat:300265348 a skos:Concept ;
    skos:definition "Long, thin swords with blunt ends, used by the Tuareg and other Saharian peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "takuba"@en .

aat:300265349 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Uganda and Kenya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nubi"@en .

aat:300265350 a skos:Concept ;
    skos:definition "People who practice healing by the use of herbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herbalists"@en .

aat:300265351 a skos:Concept ;
    skos:definition "Refers to work produced by the African ethnic group of the same name, inhabiting Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ahouan"@en .

aat:300265352 a skos:Concept ;
    skos:definition "Refers to work produced by the African ethnic group of the same name, inhabiting the Middle Cross River region of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bakor"@en .

aat:300265353 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting western Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mfumte"@en .

aat:300265354 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Togo and Ghana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akposo"@en .

aat:300265355 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Uganda and Rwanda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mpororo"@en .

aat:300265356 a skos:Concept ;
    skos:definition "The act or posture of falling or resting on one's knees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kneeling"@en .

aat:300265357 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Namibia and Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbandieru"@en .

aat:300265358 a skos:Concept ;
    skos:definition "Equipment (bits, bridal, chest piece, forehead fringe, halters, headstalls, neck pieces, saddles, headstalls, neck pieces, saddles, saddle blankets, etc.) used on a horse, particularly when the equipment is decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse trappings"@en .

aat:300265359 a skos:Concept ;
    skos:definition "Used for objects, typically masks or figures, with two faces positioned front-to-back or side-to-side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Janus-faced"@en .

aat:300265360 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting southwestern Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Omotic"@en .

aat:300265361 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the island of Bavuma in the Uganda sector of Lake Victoria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bavuma"@en .

aat:300265362 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the east coast of Africa, Kenya, Tanzania, and the Comores. They originally migrated from Yemen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadrami"@en .

aat:300265363 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabited in southwestern Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dorze"@en .

aat:300265364 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting southwestern Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yemma"@en .

aat:300265365 a skos:Concept ;
    skos:definition "Generally, a travelled way or course, from one place to another, whether terrestrial or on water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "routes"@en .

aat:300265366 a skos:Concept ;
    skos:definition "A route followed by traders, particularly caravans, or by merchant ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trade routes"@en .

aat:300265367 a skos:Concept ;
    skos:definition "Routes taken by pilgrims, usually to a sacred place as an act of religious devotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrimage routes"@en .

aat:300265368 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting eastern Sudan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shukria"@en .

aat:300265369 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arbore"@en .

aat:300265371 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Côte d'Ivoire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyabwa"@en .

aat:300265372 a skos:Concept ;
    skos:definition "An ornamental pavilion or recreational structure, usually situated at an elevated point in a park or garden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gloriettes"@en .

aat:300265373 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wolayta"@en .

aat:300265374 a skos:Concept ;
    skos:definition "Covers for the eyes, typically of fabric, for shutting out light or vision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blindfolds"@en .

aat:300265375 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hadiya"@en .

aat:300265376 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gude"@en .

aat:300265377 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Botswana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tannekwe"@en .

aat:300265378 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Gabon and Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Koozime"@en .

aat:300265379 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the Democratic Republic of Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tembo"@en .

aat:300265380 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndlambe"@en .

aat:300265381 a skos:Concept ;
    skos:definition "African metal medium of exchange in the form of hoe blades, often anchor-shaped or heart-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoe money"@en .

aat:300265382 a skos:Concept ;
    skos:definition "African metal medium of exchange in the form of spear blades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spear money"@en .

aat:300265383 a skos:Concept ;
    skos:definition "Money in the form of bars of metal. Examples include stamped copper bars issued 1796-1818 for use as money in the Dutch East Indies, and various African examples of metal masses, spheres, or flat regular plates used as money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar money"@en .

aat:300265384 a skos:Concept ;
    skos:definition "Salt used as a medium of exchange, in the shape of bars, blocks, cones, or in bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt money"@en .

aat:300265385 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting northern Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yowa"@en .

aat:300265386 a skos:Concept ;
    skos:definition "Rattles in the form of elaborate wood or bronze staffs from the Benin kingdom and other Edo peoples in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ukhurhe"@en .

aat:300265387 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tendgha"@en .

aat:300265388 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the plateau region of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eggon"@en .

aat:300265389 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Majangir"@en .

aat:300265390 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting western Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsamay"@en .

aat:300265391 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the Democratic Republic of the Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bangba"@en .

aat:300265392 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the Democratic Republic of the Congo. Mokango is a singular form; Bakango is a plural form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kango"@en .

aat:300265393 a skos:Concept ;
    skos:definition "Portable, cordless telephones for use in a cellular radio network."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellular telephones"@en .

aat:300265394 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lala"@en .

aat:300265395 a skos:Concept ;
    skos:definition "Central African reliquary figures of the Kota culture that are placed as protective devices on baskets containing bones of ancestors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mbulu ngulu"@en .

aat:300265396 a skos:Concept ;
    skos:definition "Telecommunications towers that are cellular-enabled mobile device sites where antennas and electronic communications equipment are placed to transmit and receive cell phone signals over one or more cells in a mobile phone system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cell towers"@en .

aat:300265397 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting central Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gafat"@en .

aat:300265398 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting the Casamance region of Senegal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karon"@en .

aat:300265399 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Idaca"@en .

aat:300265400 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sambla"@en .

aat:300265401 a skos:Concept ;
    skos:definition "Refers to a single large block of stone shaped into a pillar, column, sculpture or other item. For modern structural elements composed of cast concrete, use \"concrete monolith.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monoliths"@en .

aat:300265402 a skos:Concept ;
    skos:definition "Refers to massive, relatively featureless concrete supporting elements, often used under water to support a bridge or quay or other structure, or on land as structural or decorative units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete monoliths"@en .

aat:300265403 a skos:Concept ;
    skos:definition "An 18th-century French bookbinding style in which 17th-century lace or dentelle borders were expanded to fill most of the cover, with only a central space left for a coat-of-arms. The wavy pattern of the tooling on the edges also created a lacy effect. The bookbinders Derome and Dubuisson made lace bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace bindings"@en .

aat:300265404 a skos:Concept ;
    skos:definition "Boxes with small interior compartments for storing pieces of lace. The term is popularly applied to wide and shallow boxes, often decorated with marquetry, made in the late 17th-century in England; such boxes, however, were not necessarily intended to contain lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lace boxes"@en .

aat:300265405 a skos:Concept ;
    skos:definition "Any of numerous organic compounds that serve as chemical messengers. They are secreted by a gland or organ into the body fluids of an animal, particularly the bloodstream, by a gland or organ, are transported to another part of the organism, and trigger or regulate particular functions such as growth, metabolism, reproduction, and the functioning of various organs. The term may also refer to similar compounds produced by plants or produced synthetically. The term was coined in 1905 from the Greek \"horman,\" meaning \"to set in motion.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hormone"@en .

aat:300265406 a skos:Concept ;
    skos:definition "A soft, waxy, light, extremely malleable, silvery-white, unstable metallic element of the alkali group. It has the symbol Na in the periodic table and the atomic number 11. Sodium is the most common alkali metal and the sixth most abundant element on Earth. It appears only as a compound with other elements in nature. It has a strong affinity for oxygen and other nonmetallic elements. It is highly reactive, burns with a yellow flame, oxidizes in air, and reacts violently with water. Sodium provides the chief cation (positive ion) of extracellular body fluids. It is an essential nutrient in animals; it helps to maintain blood volume, regulate the balance of water in the cells, and keeps nerves functioning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium"@en .

aat:300265407 a skos:Concept ;
    skos:definition "Merchants selling second-hand books, leaflets, and prints of little value, such as those working outdoors alongside the Seine River in Paris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouquinistes"@en .

aat:300265408 a skos:Concept ;
    skos:definition "Structures, typically relatively substantial and often with with columns, arches, a roof, hangings, and other decorations used to shelter a catafalque or bier, especially those used to designate the prestige or rank of the deceased. It is first seen in Medieval funerary services as a temporary structure and in permanent monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "castra doloris"@en .

aat:300265409 a skos:Concept ;
    skos:definition "Modifications to shields or coats of arms for supposed misconduct or dishonor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abatements"@en .

aat:300265411 a skos:Concept ;
    skos:definition "The planning and construction of a structure that is involved with its ability to maintain its intended position and orientation during earthquakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismic design"@en .

aat:300265412 a skos:Concept ;
    skos:definition "A soft sweet confection made originally from the root of the marshmallow plant and later from albumen, gelatin, sugar, and other ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marshmallow"@en .

aat:300265413 a skos:Concept ;
    skos:definition "Paste or dough made of water and flour into various forms such as macaroni, spaghetti, and vermicelli; it can be dried for use later or made fresh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pasta"@en .

aat:300265414 a skos:Concept ;
    skos:definition "Drawings on the earth's surface; specifically geometric or zoic symbols constructed by altering the arrangement of gravel. To refer to those made by the Nasca (Nazca) people and found on the southern desert plains of coastal Peru, use the specific term \"Nazca lines.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geoglyphs"@en .

aat:300265415 a skos:Concept ;
    skos:definition "Geometric and zoic figures constructed by altering the surface arrangement of gravel on the level expanses of the coastal desert plain of southern Peru. Created by the Nazca people for unknown purposes. \"Nazca\" and \"Nasca\" are commonly used to refer to the same thing, but generally prefer the use of Nazca to describe the region and Nasca to refer to the culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nazca lines"@en .

aat:300265416 a skos:Concept ;
    skos:definition "Professionals who physically handle cultural objects, including those who prepare works for shipping, transport the works themselves, or are involved in the storage or installation of artworks. For those involved in preparing art, other objects, or specimens (such as fossils) specifically for display in museums or galleries, use \"preparators.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art handlers"@en .

aat:300265417 a skos:Concept ;
    skos:definition "Sulfuryl fluoride (SO2F2) is a toxic inorganic gas used as a structural fumigant insecticide to control dry-wood termites. It was developed by Dow Chemical Company in the late 1950s and sold under the trade name \"Vikane.\" It more recently has been used as a post-harvest fumigant for dry fruits, nuts, and grains, sold for this use under the trade name \"ProFume.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfuryl fluoride"@en .

aat:300265418 a skos:Concept ;
    skos:definition "A general term used to refer to freestanding buildings, components of buildings, complexes of buildings, other structures, or a man-made environment, typically large enough for humans to enter, serving a practical purpose, being relatively permanent and stable, and usually considered to have aesthetic value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "built works"@en .

aat:300265419 a skos:Concept ;
    skos:definition "Generally, refers to all physical objects or physical phenomena not produced by humans. The universe of physical objects is often divided into realia, which are naturally occurring objects and phenomena, and \"artifacts, \" which are human-made objects and phenomena. Specifically, in library classification systems, realia are physical objects that are not the books, periodicals, or sound recordings typically cataloged by libraries. Specifically, in education, realia are objects from nature, home, or otherwise from real life that are used in classroom instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "realia"@en .

aat:300265420 a skos:Concept ;
    skos:definition "Materials or items left of a thing or things after other parts have been removed, used, or destroyed. Examples include substances of organic origin that are entirely or partially preserved, often in the earth, in a conserved or fossilized condition, including what is left of a person or animal when life is extinct. May also include artifacts, ruins, and other remanants of a person or civilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remains"@en .

aat:300265421 a skos:Concept ;
    skos:definition "Physical objects produced or shaped by human craft, especially tools, weapons, ornaments, or other items that inherently give cultural clues about the person who made it or used it, and are further characterized by being of archaeological or historical interest and of the type collected by museums or private collectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural artifacts"@en .

aat:300265422 a skos:Concept ;
    skos:definition "The belief systems, values, philosophical systems, knowledge, behaviors, customs, arts, history, experience, languages, social relationships, institutions, and material goods and creations belonging to a group of people and transmitted from one generation to another. The group of people or society may be bound together by race, age, ethnicity, language, national origin, religion, or other social categories or groupings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural heritage"@en .

aat:300265423 a skos:Concept ;
    skos:definition "Processes and their accompanying technologies that can construct physical models from three-dimensional design data. It is an additive process, created by adding layers of paper, wax or plastic with the end result being a solid, 3-D object. Rapid prototyping processes are generally used by industrial designers to create prototypes of their designs both for displaying and testing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rapid prototyping"@en .

aat:300265424 a skos:Concept ;
    skos:definition "Type of rapid prototyping whereby filaments of heated thermoplastic are gradually extruded onto a platform, creating cross-sections of an object and eventually creating a 3-D object prototype out of plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fused deposition modeling"@en .

aat:300265425 a skos:Concept ;
    skos:definition "An an early, widely used 3-D printing technology. It is a process that builds 3-D objects by converting liquid materials into solid parts by curing them using a light source, which causes chains of molecules to link, forming polymers. The process is used for creating models, prototypes, patterns, and production parts. A typical method uses a UV laser to create cross-sections of the object within a vat of liquid photopolymer. The process was first developed in 1986. The process is valued to create accurate parts with repeatable dimensions; applications include engineering assemblies, jewelry casting, and dental repairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereolithography"@en .

aat:300265426 a skos:Concept ;
    skos:definition "Rapid prototyping process that uses a carbon dioxide laser to create layers of cross-sections of paper that have one side coated with polyethylene. The successive layers eventually create a 3-D object from a computer-designed model."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laminated object manufacturing"@en .

aat:300265427 a skos:Concept ;
    skos:definition "Rapid prototyping process that uses whereby layers of plastic, metal, or ceramic powders are fused or sintered by carbon dioxide laser energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "selective laser sintering"@en .

aat:300265428 a skos:Concept ;
    skos:definition "Rapid prototyping process similar to stereolithography, except solid ground curing cures one layer of UV-sensitive photopolymer at a time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid ground curing"@en .

aat:300265429 a skos:Concept ;
    skos:definition "Global computer network which provides the world's users a variety of information resources and communication facilities. It consists of interconnected networks that use standardized communication protocols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Internet"@en .

aat:300265431 a skos:Concept ;
    skos:definition "A group of World Wide Web pages usually associated with a particular subject and connected via hyperlinks, made available online by an institution, company, government, or other organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Web sites"@en .

aat:300265432 a skos:Concept ;
    skos:definition "Coins, often a United States penny, pressed into an oval or elogated shape by being rolled between steel dies with a design impressed on one or both sides. Elongated coins are typically souvenirs and are not used as currency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elongated coins"@en .

aat:300265433 a skos:Concept ;
    skos:definition "Associations of artists, wherein members of each group collaborate in a formal manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' collectives"@en .

aat:300265434 a skos:Concept ;
    skos:definition "The range of monochromatic colors including blacks, grays, and whites. Examples are monochromatic images, usually prints, photographic images, or television."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-and-white"@en .

aat:300265435 a skos:Concept ;
    skos:definition "A fine wool or silk chenille thread used in embroidery, especially in the 19th century. It is stitched into a fabric in the same way as in crewelwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrasene"@en .

aat:300265436 a skos:Concept ;
    skos:definition "Refers to a type of globular Chinese vase with a long cylindrical neck at the top of which are two tubular loops or lugs. They were used as targets in the competitive game in which arrows were aimed into the mouth or, better yet, the lugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrow vases"@en .

aat:300265438 a skos:Concept ;
    skos:definition "In general, the book format resulting from folding a sheet once, making two leaves or four pages. The term specifically refers to a sheet size of 17 x 22 inches or larger. Frequently, it is used to describe any book of the largest size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folio"@en .

aat:300265439 a skos:Concept ;
    skos:definition "The format created by folding a sheet of paper twice. It is typically more square in shape than a folio and can be of varying sizes. A common example is a book between octavo and folio in size, approximately 11 x 13 inches. To make a quarto, a sheet of paper is folded twice, forming four leaves or eight pages. Another example is a mid-sized newspaper, about 9 x 12 inches, again made by folding a sheet twice. For books, when laid paper is used, the chain lines are horizontal. The quarto was considered the most elegant format for published works in England in the early 18th century. With the mechanization of the printing industry in the 19th century, librarians began to apply the term based on the size rather than the way a book was constructed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarto"@en .

aat:300265440 a skos:Concept ;
    skos:definition "Book format that results from folding a sheet of paper with three right angle folds, producing a leaf one-eighth the size of the original sheet, and creating 16 pages. The resulting untrimmed page size would be 12 1/2 by 9 1/2 inches. The term itself is frequently coupled with a paper size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octavo"@en .

aat:300265441 a skos:Concept ;
    skos:definition "Book format produced by folding a sheet with four right angle folds, producing a leaf 1/16th the size of the original sheet, and creating 32 pages. Typically, the untrimmed size is 6 1/2 by 9 1/2 inches. The term is frequently used with a paper size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixteenmo"@en .

aat:300265442 a skos:Concept ;
    skos:definition "Uncommon book format consisting of 64 pages or 32 leaves. Although it may be formed by making 5 right angles from the original sheet, the process is hampered by trapped air and buckling. Instead, the book format is created by folding an entire sheet with parallel folds, and folding a half sheet with two parallel and two right angle folds, and inserting the folded half sheet into the former."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thirty-twomo"@en .

aat:300265443 a skos:Concept ;
    skos:definition "Book format produced by folding a sheet using six right angle folds, producing a leaf size of 1/64th the original sheet, and creating 128 pages. Typically, the untrimmed page size is 4 3/4 by 3 1/8 inches. Because of the difficulty in folding a sheet with six right angles, usually more than one sheet is used, and those are inserted into the book."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixty-fourmo"@en .

aat:300265444 a skos:Concept ;
    skos:definition "Refers to European noblewomen holding a barony in their own right. It may also refer to European and Japanese noblewomen who are the wives or widows of barons. In Great Britain and Japan, they occupy the lowest rank of nobility; in Continental Europe, their rank and status within the nobility vary from country to country. Refers to female holders of a barony, which is a large estate or a sizable section of a larger territory ruled by a sovereign and often originally awarded for military or other service. It may also refer to the wives or daughters of a baron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baronesses"@en .

aat:300265445 a skos:Concept ;
    skos:definition "Book format created when a sheet is folded to form 12 leaves or 24 pages. Typically made by inserting a smaller sheet into a larger sheet, as opposed to creating the size by creating two parallel folds and two right angle folds in one sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twelvemo"@en .

aat:300265446 a skos:Concept ;
    skos:definition "Uncommon book format with 18 leaves and 36 pages, used in bookmaking from 1770-1840, but rarely used today. The most common method of creating the size is to fold a sheet in an accordian-fold, followed by an envelope fold, and a right angle fold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighteenmo"@en .

aat:300265447 a skos:Concept ;
    skos:definition "Book format which holds 24 leaves or 48 pages. The most common method used to produce a twenty-fourmo is to fold two separate sheets with two parallel folds in thirds. This is followed by a right angle fold, a parallel fold, and then inserting the second sheet within the first."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-fourmo"@en .

aat:300265448 a skos:Concept ;
    skos:definition "Book format where a sheet is folded to form 48 leaves or 96 pages. It is formed by folding a sheet five times to form 32 leaves, and then a half sheet is folded to form 16 leaves, which is inserted into the former."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forty-eightmo"@en .

aat:300265449 a skos:Concept ;
    skos:definition "Book format with 6 leaves or 12 pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixmo"@en .

aat:300265451 a skos:Concept ;
    skos:definition "A standard size of printing paper in Great Britain, generally measuring around 13 1/2 by 17 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foolscap"@en .

aat:300265452 a skos:Concept ;
    skos:definition "Book size having height dimension of approximately 23 inches (58 cm)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elephant folio"@en .

aat:300265454 a skos:Concept ;
    skos:definition "A size of drawing and cartridge paper measuring 28 × 23 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elephant"@en .

aat:300265455 a skos:Concept ;
    skos:definition "Large size of drawing paper measuring approximately 34 by 26 inches. The term \"atlas paper\" was originally used to refer to what is now known as \"map paper\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atlas"@en .

aat:300265456 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, standardized at 22 or 22 1/2 inches by 30 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial"@en .

aat:300265457 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, and standardized at 15 1/2 by 19 inches. When folded, a half sheet of post forms the quarto letter-paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "post"@en .

aat:300265458 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, measuring 18 1/2 by 14 1/2 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinched post"@en .

aat:300265459 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, measuring 16 1/2 by 21 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "large post"@en .

aat:300265460 a skos:Concept ;
    skos:definition "Printing paper size measuring 17 1/2 by 22 1/2 inches. Demy writing paper measures 15 1/2 by 20 inches in Great Britain, and 16 by 21 inches in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demy"@en .

aat:300265461 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, measuring 18 by 23 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium"@en .

aat:300265462 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, measuring 20 by 25 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal"@en .

aat:300265463 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, measuring 15 by 20 inches (in the United States, 15 by 19 inches). Crown paper was originally watermarked with the insignia of a crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown"@en .

aat:300265464 a skos:Concept ;
    skos:definition "Paper size measuring 15 by 12 1/2 inches. Originally, pott paper bore the watermark of a pot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pott"@en .

aat:300265465 a skos:Concept ;
    skos:definition "Paper size, generally used in Great Britain, that measures one size larger than royal, or 19-21 by 27-28 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "super royal"@en .

aat:300265467 a skos:Concept ;
    skos:definition "Refers to the culture of the Catawba, a North American Indian tribe of Siouan language stock who historically inhabited the territory around the Catawba River in the Carolinas. Their main village was on the west side of the river in what is now York county, South Carolina. Today, the Catawba is federally recognized as the \"Catawba Indian Nation,\" with its center in Rock Hill, South Carolina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Catawba"@en .

aat:300265468 a skos:Concept ;
    skos:definition "Style and culture of one of the seven branches of the Lakota Sioux; they fought alongside Sitting Bull in the 1870s. The majority of Hunkpapa Lakota now reside in the Standing Rock Indian Reservation of South and North Dakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hunkpapa"@en .

aat:300265469 a skos:Concept ;
    skos:definition "Style and culture of a subdivision of the Lakota Sioux who formerly inhabited an area from the Black Hills in South Dakota to the Platte River, currently residing primarily in west central South Dakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miniconjou"@en .

aat:300265470 a skos:Concept ;
    skos:definition "Style and culture of one of the six subgroups of Lakota who had separated from each other by the early 19th century. Today the Oglala reside primarily in the Pine Ridge Indian Reservation in South Dakota bordering Nebraska."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oglala"@en .

aat:300265471 a skos:Concept ;
    skos:definition "Style and culture of a subdivision of the Lakota people who currently live primarily in the Cheyenne River Reservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sans Arc"@en .

aat:300265472 a skos:Concept ;
    skos:definition "Style and culture of one of the seven branches of the Lakota Sioux who currently live primarily on the Rosebud Indian Reservation in Southwestern South Dakota and the Lower Brule Indian Reservation on the west bank of the Missouri River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brulé"@en .

aat:300265473 a skos:Concept ;
    skos:definition "Style and culture of that portion of the Brulé people who live on the Rosebud reservation, South Dakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosebud Sioux"@en .

aat:300265474 a skos:Concept ;
    skos:definition "Style and culture of that portion of the Brulé peoples who live on the west bank of the Missouri River in central South Dakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lower Brulé"@en .

aat:300265475 a skos:Concept ;
    skos:definition "Style and culture of characteristic of one of the seven bands of Teton Sioux, that currently occupy a reservation along the Cheyenne River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oohenonpa"@en .

aat:300265476 a skos:Concept ;
    skos:definition "Not to be confused with the Algonkin-speaking Blackfoot, another Plains Indian tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blackfeet"@en .

aat:300265477 a skos:Concept ;
    skos:definition "The style and culture of a division of the Sioux people formerly inhabiting northern Minnesota, now located mainly in North and South Dakota and eastern Montana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yanktonai"@en .

aat:300265478 a skos:Concept ;
    skos:definition "Broadly defined post-Second World War art movement named to distinguish it from 'classic' avant-garde movements such as Surrealism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neo-avant-garde"@en .

aat:300265479 a skos:Concept ;
    skos:definition "Perspective, or sensibility of the underdog, or the view of the downtrodden. The term is used specifically within the Chicano and Chicano artist community, specifically for purposes of defining identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rasquachismo"@en .

aat:300265480 a skos:Concept ;
    skos:definition "Bagpipes invented in the early 17th century, and frequently referred to as Italian musettes. The complex pipes were bellows-blown and had four separate chanters, two of which were partly keyed, and two that were completely keyed, enabling the user to produce four-part music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sourdelines"@en .

aat:300265481 a skos:Concept ;
    skos:definition "Prints made by professional engravers from an artist's original drawing. Interpretive prints are freer than reproductive engravings, the aim of which is to precisely mimic the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interpretive prints"@en .

aat:300265482 a skos:Concept ;
    skos:definition "Style and culture of the Native American peoples currently occupying an area north of Calgary, Alberta, Canada, who were the northernmost of the Niitsítapi (Original People). When European explorers travelled west, they probably encountered the Siksika people first and erroneously assumed that all people of the Blackfoot Confederacy were Blackfoot. The four Niitsítapi nations of the Blackfoot Confederacy are the Siksika, Kainaa (Blood), Aapatohsipikani (Northern Peigan), and Aamsskaapipikani (South Peigan or Montana Blackfoot)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siksika"@en .

aat:300265483 a skos:Concept ;
    skos:definition "Handwritten manuscripts that have been decorated with gold or silver, brilliant colors, designs, or miniature pictures. Although prevalent in Islamic and Asian societies, the longest tradition of illuminating manuscripts was in Christian medieval Europe, from the 6th-16th centuries, when the art was superseded by printed illustrations. Generally, the manuscripts were both 'historiated', or decorated with relevant paintings, and 'illuminated' in its original sense, meaning decorated with calligraphic initial capital letters using gold leaf. Over time, the term 'illuminated' came to refer to any illustration or decoration in a manuscript. Illuminated manuscripts played a major role in the development of art, partly because of the manuscript's portability in carrying artistic developments from one region to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illuminated manuscripts"@en .

aat:300265484 a skos:Concept ;
    skos:definition "Style and culture of a group comprising the Southern Tiwa ethnic group who speak Isletan Tiwa, a variety of the Southern Tiwa language, located primarily at Isleta Pueblo in the Rio Grande Valley, 13 miles (21 km) south of Albuquerque."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isleta"@en .

aat:300265485 a skos:Concept ;
    skos:definition "Heraldic manuscripts blazoning or emblazoning the weaponry of persons at a particular battle or tournament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolls of arms"@en .

aat:300265486 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe of North Carolina; their origins are disputed, however the tribe believes they are descendants of the Cheraw and related Siouan-speaking tribes of Native Americans originally inhabiting the coastal regions of the state of North Carolina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lumbee"@en .

aat:300265487 a skos:Concept ;
    skos:definition "Style and culture of a group of Native Americans living in Northern California in the central Sierra Nevada, in the drainage area of the Feather and American Rivers. Their culture is noted for basket making. When Europeans arrived, they were hunter-gathers; however like many other California tribes, they groomed their gathering grounds and tended local groves of oak trees to maximize production of acorns, a dietary staple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maidu"@en .

aat:300265488 a skos:Concept ;
    skos:definition "Knives used for precise cutting and scraping, particularly as used in mechanical drawing for erasing ink lines from tracing paper or cloth; usually made of steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erasing knives"@en .

aat:300265489 a skos:Concept ;
    skos:definition "Style and culture of the Paiute group from the Mono Lake area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mono Lake Paiute"@en .

aat:300265490 a skos:Concept ;
    skos:definition "Style and culture of a group that originated in the Tewa culture and who have inhabited the area around the curent Pueblo of Nambe since the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nambe"@en .

aat:300265491 a skos:Concept ;
    skos:definition "Refers to the culture of the Nanticoke, a confederacy of Algonkian-speaking Indians who have lived along the eastern shore of what are now Maryland and southern Delaware. Their culture is related to that of the Delaware and the Conoy. The name Nanticoke means Tidewater People. Today, the Nanticoke are known today as the \"Nanticoke Indian Tribe\" in Delaware and the \"Nanticoke Lenni-Lenape Tribal Nation\" in New Jersey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nanticoke"@en .

aat:300265492 a skos:Concept ;
    skos:definition "Refers to the culture of the Narragansett, an Algonkian-speaking Indian tribe that occupied most of what is now the state of Rhode Island west of Narragansett Bay. Today, the Narragansett largely live in southern Rhode Island as a federally-recognized tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Narragansett"@en .

aat:300265493 a skos:Concept ;
    skos:definition "Refers to the culture of the Passamaquoddy, an Algonkian-speaking Native American/First Nations people who live on Passamaquoddy Bay, the St. Croix River, and Schoodic Lake on the boundary between what are now Maine and New Brunswick. The Passamaquoddy tribe belonged to the loose confederation of eastern American Indians known as the Wabanaki Alliance, together with the Maliseet, Mi'kmaq, Abenaki, and Penobscot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passamaquoddy"@en .

aat:300265494 a skos:Concept ;
    skos:definition "Culture and style of Native North Americans who historically occupied the areas in Idaho, Montana, and Washington when Europeans arrived, particularly the area around what is now called Lake Pend Oreille. Today, the Kalispel are recognized as the \"Kalispel Indian Community\" in Washington and are members of the Confederated Salish & Kootenai Tribes in Montana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kalispel"@en .

aat:300265496 a skos:Concept ;
    skos:definition "Style and culture of one of the six Northern Tewa speaking Rio Grande Pueblos. Habitation of the historic Pojoaque Pueblo area as early as 500 CE with a large prehistoric population in the late fifteenth and early sixteenth centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pojoaque"@en .

aat:300265499 a skos:Concept ;
    skos:definition "Used to describe works produced by the African ethnic group of thje same name, inhabiting northwestern Bénin and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Biyobe"@en .

aat:300265500 a skos:Concept ;
    skos:definition "Used to describe works produced by the African ethnic group of the same name, inhabiting Swaziland and South Africa. Mahlalela was the name of a formerly independent chiefdom, and of their chief, within the nation of Swaziland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mahlalela"@en .

aat:300265501 a skos:Concept ;
    skos:definition "Used to descibe works produced by the African ethnic group of the same name, inhabiting Southern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ekperi"@en .

aat:300265502 a skos:Concept ;
    skos:definition "Style and culture of one of the dozens of Pueblo cultures than once dominated the Rio Grande Valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sandia"@en .

aat:300265503 a skos:Concept ;
    skos:definition "Style and culture of the group of Apache who currently occupy an area in Gila, Graham, and Pinal counties in southeastern Arizona."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "San Carlos Apache"@en .

aat:300265504 a skos:Concept ;
    skos:definition "Used to descibe works produced by the African ethnic group of the same name, inhabiting Congo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mba"@en .

aat:300265505 a skos:Concept ;
    skos:definition "Style and culture of one of the groups of Keresan speaking people, currently located primarily near Albuquerque, New Mexico. Currently noted for the cultural events surrounding the annual Feast of St. Philip on May 1, when hundreds of pueblo people participate in traditional corn dances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "San Felipe"@en .

aat:300265506 a skos:Concept ;
    skos:definition "Style and culture of the tribe of Ojibwa and Metis peoples based on the Turtle Mountain Indian Reservation in Belcourt, North Dakota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turtle Mountain Chippewa"@en .

aat:300265507 a skos:Concept ;
    skos:definition "Style and culture of a group of Native Americans Chinook who are closely related to the Wishram, both being Plateau tribes that share many cultural aspects of the Northwest Coast tribes. When Europeans arrived, the Wasco lived along the banks of the Columbia River, near The Dalles. Today the tribes are part of the Warm Springs Reservation in Oregon and Confederated Tribes and Bands of the Yakama Nation in Washington."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wasco"@en .

aat:300265508 a skos:Concept ;
    skos:definition "Style and culture of Native Americans who were originally located on the Colville River in the eastern part of the U.S. state of Washington, along the Columbia River in the area between Kettle Falls and Hunters. The original name of the tribe is unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colville"@en .

aat:300265509 a skos:Concept ;
    skos:definition "Style and culture of a Native American people living primarily in the U.S. state of Louisiana and speaking Coushatta language, in the Muskogean family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coushatta"@en .

aat:300265510 a skos:Concept ;
    skos:definition "Style and culture of a division of the Wintun people from the Upper Sacramento area above Kennett, California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nomtipom"@en .

aat:300265511 a skos:Concept ;
    skos:definition "Style and culture of a group of First Nations people located in Saskatchewan, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peepeekisis"@en .

aat:300265512 a skos:Concept ;
    skos:definition "Refers to the culture of the Métis, peoples of mixed French-Canadian and Native American ancestry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Métis"@en .

aat:300265513 a skos:Concept ;
    skos:definition "Refers to the culture of the Rappahannock, a tribe of Native Americans in Virginia who inhabit an area stretching from the Northern Neck on the Rappahannock River to the Mattaponi Rivers and as far north as Fredericksburg, Virginia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rappahannock"@en .

aat:300265514 a skos:Concept ;
    skos:definition "People who create decoration or objects from beads, which are small, pierced objects through which a wire or string may be passed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beadworkers"@en .

aat:300265515 a skos:Concept ;
    skos:definition "People who decorate textiles or other objects by decorative arrangements of quills derived from feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quillworkers"@en .

aat:300265516 a skos:Concept ;
    skos:definition "People who create ceremonial designs using sand and other natural materials such as minerals or pollen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand painters"@en .

aat:300265517 a skos:Concept ;
    skos:definition "People who create art, usually dating from the 1960s or later, that uses the exhibition space as part of the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "installation artists"@en .

aat:300265518 a skos:Concept ;
    skos:definition "Proofs retained by the artist, similar to artist's proofs, although they are usually separate or additional publications. Can also generally refer to three-dimensional objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist's copies"@en .

aat:300265519 a skos:Concept ;
    skos:definition "Representational drawings of scenes from the lives of 19th-century Plains Indians, with an emphasis on martial accomplishments. Ledger drawings were so named for the ruled ledger books in which they were often executed; these books were obtained from white soldiers or traders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ledger drawings"@en .

aat:300265520 a skos:Concept ;
    skos:definition "Refers primarily to Native American draftsmen and painters of the 19th century who used account ledger books or similar lined or bound paper to record vignettes of the Plains Indian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ledger artists"@en .

aat:300265521 a skos:Concept ;
    skos:definition "Transparent sheets of tints that consist of dots, which are used to apply texture to artwork and designs. The name derives from Benjamin Day, a New Jersey printer, who sold shading mediums in the 19th century. Ben Day dots were made famous through their use by Pop artist Roy Lichtenstein."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ben Day dots"@en .

aat:300265522 a skos:Concept ;
    skos:definition "Transferring technique by which texture patterns, in particular dots, are imprinted on paper, metal or glass, via a celluloid sheet. Invented by New Jersey printer Benjamin Day in 1879. The process is frequently associated with the work of Pop artist Roy Lichtenstein."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ben Day process"@en .

aat:300265523 a skos:Concept ;
    skos:definition "Proofs that meets the standard used for editions that are intended for distribution to specific groups of artists or craftspeople."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collaboration proofs"@en .

aat:300265525 a skos:Concept ;
    skos:definition "Proofs with the same printing elements as the edition, but they may differ because of the color variance, or added or deleted elements. Color trial proofs may have been pulled during the proofing period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color trial proofs"@en .

aat:300265526 a skos:Concept ;
    skos:definition "Proofs created for presentation purposes by the artist or publisher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special proofs"@en .

aat:300265527 a skos:Concept ;
    skos:definition "Process like that of embossing, except inverted; for instance, where a relief plate is placed under a sheet of paper as it runs through a press, lowering areas of the paper as opposed to raising them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "debossing"@en .

aat:300265528 a skos:Concept ;
    skos:definition "The lower voussoirs, or bottom stones of an arch or vault from which the curve of the arch or vault begins. Springers rest immediately on an impost."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "springers"@en .

aat:300265530 a skos:Concept ;
    skos:definition "Script with rounded forms and an exaggerated horizontal stroke, dating from Persia in the 9th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taʻlīq"@en .

aat:300265531 a skos:Concept ;
    skos:definition "Layouts marked on a card or paper, used as guides for motifs for weaving or lacemaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mises en carte"@en .

aat:300265532 a skos:Concept ;
    skos:definition "Script developed in Persia in the 14th century, combining elements from both the nashki and tal'iq scripts. Its main features are groups of connecting letters that slope downwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nastaʻliq"@en .

aat:300265533 a skos:Concept ;
    skos:definition "Temples dedicated to all the gods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pantheons"@en .

aat:300265534 a skos:Concept ;
    skos:definition "Arabic script invented by Vizier Ibn Muqla, translated to mean strongly expressed and tightly woven; characterized by downward curving, broad strokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muḥaqqaq"@en .

aat:300265535 a skos:Concept ;
    skos:definition "Arabic script possibly invented by calligrapher Ibn Muqlah in the 9th century CE, and based on the thuluth script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tawqī'"@en .

aat:300265536 a skos:Concept ;
    skos:definition "Arabic script similar to muhaqqaq, though smaller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rīḥān"@en .

aat:300265537 a skos:Concept ;
    skos:definition "Arabic script, originally developed in the Ottoman Empire, and frequently used for scrolls and inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dīwānī"@en .

aat:300265538 a skos:Concept ;
    skos:definition "Arabic script that developed from earlier Kufic scripts from peoples of the Maghrib. The script is still used widely in North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maghribī"@en .

aat:300265539 a skos:Concept ;
    skos:definition "Arabic script used primarily in modern day Iran and Afghanistan. Shikasteh, translating roughly as 'broken' or 'broken form', is a dense script with a lack of diacritical marks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shikasteh"@en .

aat:300265540 a skos:Concept ;
    skos:definition "Arabic script that is a smaller version of the tawqī' script. Invented by Muhammed ibn Khazin ca. 11th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riqāʻ"@en .

aat:300265541 a skos:Concept ;
    skos:definition "List of printed errors and their corrections, usually inserted into a book or publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "errata"@en .

aat:300265542 a skos:Concept ;
    skos:definition "Hide of a cow, or the leather made from this hide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowhide"@en .

aat:300265543 a skos:Concept ;
    skos:definition "Comic booklets produced from the 1930s to the 1950s, containing parodies of popular comic strip characters in explicit sexual adventures. Typically issued in 3x4 in. booklets of eight leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tijuana bibles"@en .

aat:300265544 a skos:Concept ;
    skos:definition "Comics, inspired by the underground comics of the 1960s and 1970s, that began to appear in periodicals from ca. 1980. Their contents are generally for a mature audience and with small print runs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alternative comics"@en .

aat:300265545 a skos:Concept ;
    skos:definition "Mechanical devices meant for lighting cigarettes, cigars, and pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighters"@en .

aat:300265547 a skos:Concept ;
    skos:definition "Series of proofs showing the image development of the finished print. Each printing element is shown singly in black, regardless of their color in the edition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elements in black"@en .

aat:300265548 a skos:Concept ;
    skos:definition "Series of proofs that illustrate the image development of the finished print. Each printing element is shown singly in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elements in color"@en .

aat:300265549 a skos:Concept ;
    skos:definition "Proofs of letterpress type pages that include illustrations to be reproduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "etch proofs"@en .

aat:300265550 a skos:Concept ;
    skos:definition "Publishing from an electronic archive where material, often customized, is printed as required for delivery to the end user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "on-demand publishing"@en .

aat:300265551 a skos:Concept ;
    skos:definition "Reprints of printed matter produced as required, with the original being stored in an electronic archive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "on-demand reprints"@en .

aat:300265552 a skos:Concept ;
    skos:definition "Printing process whereby material to be printed is stored in an electronic archive, and copies are produced as required by the end user."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "on-demand printing"@en .

aat:300265553 a skos:Concept ;
    skos:definition "Publications printed in amounts as required by the end user. The material to be printed is stored in an electronic archive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "on-demand publications"@en .

aat:300265554 a skos:Concept ;
    skos:definition "Books in an electronic format that are available for viewing on the Internet or in a local digital file on a computer or handheld device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "e-books"@en .

aat:300265555 a skos:Concept ;
    skos:definition "Used to descibe works produced by the African ethnic group of the same name, inhabiting Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kariya"@en .

aat:300265556 a skos:Concept ;
    skos:definition "Loads added to existing loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superimposed loads"@en .

aat:300265557 a skos:Concept ;
    skos:definition "One or more mechanical figures, typically in armor, which strike the hours and sometimes quarters with a club or ax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacks"@en .

aat:300265558 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Nisqually, a Native American people who once dominated the Snoqualmie River area in west-central Washington. Today the Nisqually retain a reservation on the Snoqualmie River near Tacoma, Washington."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nisqually"@en .

aat:300265559 a skos:Concept ;
    skos:definition "Proof, similar to an artist's proof, which is retained by the publisher. Can also be used in reference to any three-dimensional object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publisher's copies"@en .

aat:300265560 a skos:Concept ;
    skos:definition "Screenprint where a light-sensitive resist applied to a screen is exposed to a photographic image which has been broken down by a dot screen. It is then exposed to light, and a photo stencil is created. Unexposed sections are washed away, and the ink is forced through the mesh to create the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoscreenprints"@en .

aat:300265561 a skos:Concept ;
    skos:definition "Proofs, meeting the right to print impression, that are intended as gifts to groups or individuals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation proofs"@en .

aat:300265562 a skos:Concept ;
    skos:definition "Copies of printed matter, or three-dimensional objects, created specifically for the presentation by the artist and/or publisher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dedication copies"@en .

aat:300265563 a skos:Concept ;
    skos:definition "Proofs produced as part of the creation process in printmaking, used as the artist or craftsman creates the plate or screen, and makes decisions regarding alterations or next steps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "working proofs"@en .

aat:300265564 a skos:Concept ;
    skos:definition "Coat armors or tunics of rich material worn by men of the Middle Ages, with heraldic arms depicted on them. Today, they are known as a sleeveless garments of crimson velvet worn with a mantle. The term is somewhat ambiguous, and can also mean outergarments worn by people of rank of both sexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surcoats"@en .

aat:300265565 a skos:Concept ;
    skos:definition "Surcoats that were sleeveless and worn outside the armor, emblazoned with arms. Can also mean a close fitting tunic or doublet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jupons"@en .

aat:300265566 a skos:Concept ;
    skos:definition "Outer garments, generally long and loose with tubular or bell-shaped sleeves, worn by women in the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surcoats"@en .

aat:300265567 a skos:Concept ;
    skos:definition "Body armor, similar to gambesons; close-fitting military garments from ca. 14th century that are worn under body armor or hauberks. Generally considered the forerunner to doublets, gipons extended to the knees and were sometimes belted. There is some ambiguity with this term and the term 'jupons', which have been defined as types of surcoats. There is also ambiguity as to whether gipons had sleeves or were sleeveless."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gipons"@en .

aat:300265568 a skos:Concept ;
    skos:definition "Comics in book form, which generally consist of an extended story with sequential art. The term is not strictly defined, as graphic novels can be collections of comics previously published as serials, or works that were created specifically for book form. The term is also used more broadly to refer to collections or anthologies of comics published in book form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphic novels"@en .

aat:300265569 a skos:Concept ;
    skos:definition "Paper produced from bleached wood pulp or esparto grass, and with a relatively rough or unfinished surface. It can be lightweight or heavyweight. Examples of usage include books, particularly novels, and artists' prints, when a particular effect is desired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antique paper"@en .

aat:300265570 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tyapi"@en .

aat:300265572 a skos:Concept ;
    skos:definition "Refers to zigzag or wriggled grooves found on the underside of silver pieces (Continental or Scottish but rarely English) formed when samples of the metal were taken for assaying. The marks often resemble the letter N or Z but no significance can be attached to their form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assay grooves"@en .

aat:300265573 a skos:Concept ;
    skos:definition "Modern term for a type of embroidery made in various places, including Italy, since the 16th century. The pattern in Assisi work is reserved in plain linen and the rest of the ground is covered with long-armed cross stitch in red or other colors. It was supposedly first produced in convents in Assisi although this is unlikely; the term instead probably derives from the fact that such embroidery has been made in Assisi in recent times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assisi work"@en .

aat:300265574 a skos:Concept ;
    skos:definition "Refers to lead-glazed Staffordshire pottery figurines of a type associated with John Astbury and Thomas Whieldon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Astbury-Whieldon figures"@en .

aat:300265575 a skos:Concept ;
    skos:definition "Brasswork inlaid with silver or gold in knot patterns and mauresques. Azzimina was made in northern Italy, notably in Venice, and the Levant from the late 15th century to the 16th century. It is sometimes confused with damascening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azzimina"@en .

aat:300265576 a skos:Concept ;
    skos:definition "Motif resembling knotted, gnarled branches of a young crab apple tree, used as the form for handles and spouts that developed on 18th-century English stoneware, particularly that made by the Staffordshire, Leeds, Liverpool, and Derby potteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crabstock"@en .

aat:300265577 a skos:Concept ;
    skos:definition "Scale that is shown by a line that is labeled to represent a stated distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar scale"@en .

aat:300265578 a skos:Concept ;
    skos:definition "Refers to a precursor of papier-mâché that was derived from waste cardboard and often used to imitate stone or bronze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carton-pierre"@en .

aat:300265579 a skos:Concept ;
    skos:definition "A conical pit with a pointed stake fixed vertically at the bottom center; most often used in group formation, in rows, as a defensive obstacle in medieval military fortifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trous-de-loup"@en .

aat:300265580 a skos:Concept ;
    skos:definition "Paper decorated by various means, which might include marbling, stencilling, dyeing, or block printing; to be used for endpapers, wallpaper, wrapping objects, or as a ground for printing or calligraphy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorated papers"@en .

aat:300265581 a skos:Concept ;
    skos:definition "A plug, typically of cotton, used in cases of hemorrhage or to absorb menstrual flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tampons"@en .

aat:300265582 a skos:Concept ;
    skos:definition "A sheath typically of very thin rubber, worn over the penis during sexual intercourse to prevent contraception or sexually transmitted disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condoms"@en .

aat:300265584 a skos:Concept ;
    skos:definition "A paste for cleaning teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toothpaste"@en .

aat:300265585 a skos:Concept ;
    skos:definition "A substance or preparation that destroys or masks odor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deodorant"@en .

aat:300265586 a skos:Concept ;
    skos:definition "A preparation that is lathered and applied to a surface in order to soften and condition the area for shaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving cream"@en .

aat:300265587 a skos:Concept ;
    skos:definition "Sticks of soap or emollients used for shaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaving sticks"@en .

aat:300265588 a skos:Concept ;
    skos:definition "A preparation for cleaning, especially for hair or fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shampoo"@en .

aat:300265589 a skos:Concept ;
    skos:definition "Pads or towels worn by women to absorb menstrual flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanitary napkins"@en .

aat:300265590 a skos:Concept ;
    skos:definition "A cream or liquid preparation applied to the hair or skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conditioner"@en .

aat:300265591 a skos:Concept ;
    skos:definition "Grains or pieces of gum and sometimes spices that are burned to produce a fragrant odor. Incense is frequently used as an oblation, or in religious ritual. The term can also refer to the smoke produced by the burning of incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense"@en .

aat:300265592 a skos:Concept ;
    skos:definition "Sticks coated with incense (usually made of gum and spices), which are burned to create a fragrant odor. They are sometimes used during religious ceremonies or rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incense sticks"@en .

aat:300265593 a skos:Concept ;
    skos:definition "Towns which invent or reinvent themselves on a particular theme in order to attract tourism. Generally, residential areas of such towns do not incorporate the adopted theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theme towns"@en .

aat:300265594 a skos:Concept ;
    skos:definition "Reprographic equipment invented in 1780 by James Watt. A sheet or sheets of copying paper would be pressed against original documents, and ink would be transferred. Letter copying presses were made in various forms: roller, bed and platen, and portable models. Presses comprising a platen and base, often a screw press, used to copy an original document. In the 18th century, the original was pressed to a dampened tissue-weight paper, producing a copy transfer; the image was a mirror image of the original, but could be read through the back of the tissue. In the 19th century, the original was often written with a special copying ink that was formulated to allow easy and repeated transfer. For presses of similar design, used to press newly bound books, use \"book presses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copy presses"@en .

aat:300265595 a skos:Concept ;
    skos:definition "Reprographic machines that produce copies from a stencil, operated manually, and that use a particular type of ink and chemistry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mimeographs"@en .

aat:300265596 a skos:Concept ;
    skos:definition "Equipment used for the reproduction of graphics through photomechanical or electronic means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reprographic equipment"@en .

aat:300265597 a skos:Concept ;
    skos:definition "Reprographic machines which make copies of writing produced on a gelatin surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hectographs"@en .

aat:300265598 a skos:Concept ;
    skos:definition "Reprographic machines which produce copies of graphic or written material by the use of light, heat, chemicals, or electrostatic charges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photocopying machines"@en .

aat:300265599 a skos:Concept ;
    skos:definition "Scottish drinking vessels having a lid with a knob, typically made of pewter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tappit hens"@en .

aat:300265600 a skos:Concept ;
    skos:definition "Style of architecture and design first popular in the United States in the 1950s, typified by roadside buildings such as coffee shops, motels, gas stations, and signs. The style is characterized by bold, angular forms and an intensive use of steel, glass, and neon inspired by The Space Age, science fiction, and car culture. Although origin of the term is unknown, it is speculated to have come from Googie's Coffee Shop in Los Angeles, California, and has since been used to describe similar designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Googie"@en .

aat:300265601 a skos:Concept ;
    skos:definition "Styles of pottery made by the Rockingham Ceramic Factory (1745-1842) at Swinton in southern Yorkshire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rockingham"@en .

aat:300265602 a skos:Concept ;
    skos:definition "Style term used loosely for a wide variety of 19th-century American household wares that typically have a mottled brown glaze. The connection, if any, to the Rockingham ware produced in England is uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rockingham"@en .

aat:300265603 a skos:Concept ;
    skos:definition "A liturgical document such as the 'Synodikon of Orthodoxy.' read aloud at particular feasts, especially in the Eastern Orthodox Church. It can also refer to a letter written from one patriarch to another to circulate the decrees of a patriarchal synod, or council. More broadly, it is a declaration signed by members of a synod, affirming decisions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synodicons"@en .

aat:300265604 a skos:Concept ;
    skos:definition "Open-air amphitheaters built during the Nazi era in Germany for Völkisch meetings and to view theater and propaganda presentations. Some 1200 sites were planned but only about 40 were built."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thingplätze"@en .

aat:300265605 a skos:Concept ;
    skos:definition "Refers to an early stage in the process of turning flax or similar plants into yarn in which the material is steeped in order to soften and separate the fibrous core of the plant from the outer layer. Basic methods include dew retting and water retting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retting"@en .

aat:300265606 a skos:Concept ;
    skos:definition "A strata of limestone chalk formed from shell deposited in the Middle Triassic formation. Found in Europe, most commonly in Germany, lying above the Bunter and and below the Keuper layers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muschelkalk"@en .

aat:300265607 a skos:Concept ;
    skos:definition "Refers to small carved holes with tiny figures carved into them. They are found on the façadees of east Bavarian and Austrian barns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guggerl"@en .

aat:300265608 a skos:Concept ;
    skos:definition "Sepulchral monuments containing the heart of a deceased king."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heart monuments"@en .

aat:300265609 a skos:Concept ;
    skos:definition "Public spaces that feature sculpture, earthworks, or other art-forms as an integral part of their design and use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art parks"@en .

aat:300265610 a skos:Concept ;
    skos:definition "Lime-sand mortar mixed with crushed brick and used for pavements and the facings of walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocciopesto"@en .

aat:300265612 a skos:Concept ;
    skos:definition "Urban political units having corporate status and a local self-government. Municipalities can be towns, cities, or districts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipalities"@en .

aat:300265613 a skos:Concept ;
    skos:definition "Decorative arts style for furnishings pioneered by designer and architect Thomas Jeckyll (1827-1881) and featuring Japanese-inspired ornamentations (both geometric and floral)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Japanese"@en .

aat:300265614 a skos:Concept ;
    skos:definition "Multi-panelled sanctuary screens like those used in the Eastern Orthodox church, but on a small scale. Used in private devotion in a family chapel, in private homes, or for travel. The depiction of saints matched that of the church iconostasis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable iconostases"@en .

aat:300265615 a skos:Concept ;
    skos:definition "Roman masonry facing method in which the techniques of opus reticulatum and opus testaceum are combined to form a hybrid surface pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus mixtum"@en .

aat:300265616 a skos:Concept ;
    skos:definition "In Roman masonry, a wall-facing technique using fragments of broken tile embedded in concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus testaceum"@en .

aat:300265617 a skos:Concept ;
    skos:definition "Concept that in certain works of art the awareness of the \"beholder\" is deliberately removed, due to the artist's depiction of the subject as completely absorbed by what he or she is doing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "absorption"@en .

aat:300265618 a skos:Concept ;
    skos:definition "Motifs based on the candelabrum form, typically carved or painted and used in vertical panels of decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candelabrum"@en .

aat:300265619 a skos:Concept ;
    skos:definition "Geometric patterns of shapes, covered on a plane, without gaps or overlaps. Used with computer design and mathematics, as opposed to the physical act of creating a mosaic of 3-D tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tilings"@en .

aat:300265620 a skos:Concept ;
    skos:definition "Paintings -- usually on a rigid support such as wooden panel or metal, but occasionally on canvas -- that are painted on both front and back and intended to be viewed from either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-sided paintings"@en .

aat:300265621 a skos:Concept ;
    skos:definition "Prints made from inkjet printers, which use a non-impact computer-controlled printing process in which tiny droplets of ink are projected from nozzles onto paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkjet prints"@en .

aat:300265622 a skos:Concept ;
    skos:definition "Inkjet prints made using the Piezography (R) process, which utilizes monochromatic inks developed by photographers, and software that works in conjunction with consumer printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Piezo (R) prints"@en .

aat:300265623 a skos:Concept ;
    skos:definition "Process invented in the late 20th century by Jon Cone, where special, monochromatic inks are used in conjunction with software to produce black and white inkjet prints using consumer printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Piezography (R)"@en .

aat:300265624 a skos:Concept ;
    skos:definition "Platforms used for public speaking. In Ancient Rome, a platform elevated in the Roman forum, decorated with the prows or rostra of captured ships, and used to deliver orations or pleadings to the Roman populace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rostra"@en .

aat:300265625 a skos:Concept ;
    skos:definition "Describes works created by the African people of the same name living in Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marba"@en .

aat:300265626 a skos:Concept ;
    skos:definition "Built structures or dwellings for accomodating cattle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cattle housing"@en .

aat:300265627 a skos:Concept ;
    skos:definition "An enclosed building of relatively modest size used for sheltering or stabling cows or bulls. For a large structure used to shelter dozens or more animals, use \"dairy barns\" or \"cattle barns.\" For a structure with at least one open side, use \"cowsheds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cow houses"@en .

aat:300265628 a skos:Concept ;
    skos:definition "Divisions of a book published in parts, especially sections of a lengthy book or series of books, usually reference works, that are issued in parts as they are completed rather than waiting for the entire work to be completed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fascicles"@en .

aat:300265629 a skos:Concept ;
    skos:definition "Material comprised of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological material"@en .

aat:300265630 a skos:Concept ;
    skos:definition "Parts or components that are related to the phenomena of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological components"@en .

aat:300265631 a skos:Concept ;
    skos:definition "In biology, refers to a tight cluster or group, where the bundles originate from a common point or are running parallel to a common axis. Examples include a cluster of leaves or flowers with very short stalks growing closely together at the base, a bunch of roots growing from one point, or a cluster or bundle of muscles, nerves, or veins or arteries in an animal. It may also refer to an arrangement of wires, cords, or other natural or artificial material that resembles a biological fascicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fascicles"@en .

aat:300265632 a skos:Concept ;
    skos:definition "Objects comprising sheets of paper, vellum, papyrus, or another material that are bound together. Volumes may include printed books, manuscripts, sketchbooks, or albums. Where the parts of a historical volume have been dispersed, records for the individual sheets may be linked as a historical volume for research purposes. Given that an album contains individual drawings, prints, or other art works that have been mounted, the drawings, etc. in an album may be cataloged as items and linked to the record for the volume. For intact books, manuscripts, and sketchbooks, the illuminations or other parts may be better cataloged as components rather than items. The term may also refer to a separately bound portion or division of a written work or series that is divided into two or more sections, each contained in a separate binding; generally, multiple volumes of the same work or series are of similar dimensions and contained in similar bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volumes"@en .

aat:300265634 a skos:Concept ;
    skos:definition "Refers to works produced by the African ethnic group of the same name, inhabiting Gabon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ndumu"@en .

aat:300265635 a skos:Concept ;
    skos:definition "Refers to the work of a group of artists exhibiting in New York in the mid-1980s. Incorporating ideas from earlier movements such as Dada, Hard-Edge, and Pop, the work is purposefully calculating and intellectual and includes paintings in flat, Dayglo colors, kitsch objects, and sculpture made out of consumer products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Geo"@en .

aat:300265636 a skos:Concept ;
    skos:definition "Cutting tools consisting of a heavy blade with a hooked point fitted with a handle and used in pruning, clearning heavy brush, and maintaining hedges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billhooks"@en .

aat:300265637 a skos:Concept ;
    skos:definition "Wood of the species Prunus serotina of North America, found in forest areas from Ontario to Florida and from the Dakotas to Texas. Black cherry has a dense, close-grain wood that polishes to a high gloss. The reddish-brown wood is used for musical instruments, furniture, cabinetry, interior trim, and paneling. Fine, narrow, brown pith flecks are common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black cherry"@en .

aat:300265638 a skos:Concept ;
    skos:definition "Long augers whose end terminates in a notched spoon blade with one projection sharpened to form a nose, and the other projection bent upward to clear and hold the shavings from the hole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell augers"@en .

aat:300265639 a skos:Concept ;
    skos:definition "In any field, notes made in the course of creative, scholarly, or scientific inquiry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research notes"@en .

aat:300265640 a skos:Concept ;
    skos:definition "A building or architectural element shaped like an elongated pyramid. Used to describe structures with upright and tapered form that do not fall under any other technical term. For monolithic pillars with this shape, use \"obelisk.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guglias"@en .

aat:300265641 a skos:Concept ;
    skos:definition "Carefully selected and situated collections of original buildings designed to illustrate not only the architecture and building forms of a given geographical area and period, but also to recreate the atmosphere and lifestyle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open-air museums"@en .

aat:300265642 a skos:Concept ;
    skos:definition "Wood from the European birch tree, Betula pubescens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European birch"@en .

aat:300265643 a skos:Concept ;
    skos:definition "Zitherlike chordophones of northern and western Uganda, having a shallow trough-shaped resonator with two long straight sides and two shorter curved sides, bearing a single string laced up and down from end to end through holes or over notches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enangas"@en .

aat:300265644 a skos:Concept ;
    skos:definition "Sacred temples of worship of native Hawaiian people, typically rectangular in shape and situated on hill tops or mountain slopes. Heiaus have carved designs of deep symbolism. For similar structures from East Polynesia, use \"maraes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heiaus"@en .

aat:300265645 a skos:Concept ;
    skos:definition "Refers to the land, buildings, machinery, apparatus, and fixtures used to carry on a trade or an industrial business, which can include a factory or workshop for the manufacture of a particular product or the total facilities available for production or service. There is some overlap in usage of this term with \"industrial buildings,\" \"industrial complexes,\" and \"factories (structures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial plants"@en .

aat:300265646 a skos:Concept ;
    skos:definition "Armless chair used in the chancel by a bishop or prelate while officiating at a church not his own. For ecclesiastical folding stools used by worshippers in various functions, use \"faldstools.\" For French domestic folding stools from the 17th century on, use \"pliants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faldistories"@en .

aat:300265647 a skos:Concept ;
    skos:definition "A distinctive form of Buddhism that draws heavily on Mahayana Buddhism, which was introduced to Tibet in the seventh century. Tibetan Buddhism incorporates the esoteric tradition of tantra of Vajrayana Buddhism, features of ancient Bon shamanism, and monastic disciplines of early Theravada Buddhism. Avalokiteshvara, the Bodhisattva of Compassion, is particularly revered in Tibetan Buddhism and each Dalai Lama, the spiritual and temporal leader of Tibet, is believed to be his reincarnation. Worship includes the recitation of mantras and prayers, and the singing of hymns accompanied by the playing of drums and horns. The Tibetan canon of scripture includes the 'Kangur' and the 'Tenjur;' the Tibetan Book of the Dead (Bardo Thödröl) describes consciousness between death and rebirth. There are four major schools: Nyingma, Sakya, Kagyu, and Geluk. The religion is sometimes incorrectly called lamaism, a Western term not used by Tibetan Buddhists themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tibetan Buddhism"@en .

aat:300265648 a skos:Concept ;
    skos:definition "Refers to one of the three major phases of the Gansu culture, dating from ca. 2000 to ca. 1600 BCE; it is approximately contemporary with the later phases of the Longshan culture to the east. Qijia, discovered by the Swedish archaeologist Johan Gunnar Andersson in 1923, is named after a site at Qijiaping in Guanghe county in eastern Gansu province; the culture also extended into western Qinghai province and the autonomous regions of Ningxia and Inner Mongolia. Qijia-phase pottery includes grey and red earthenware that is smooth, painted, or corded. Vessel profiles are more angular and forms such as pedestal vessels indicate increased cross-fertilization of traditions throughout China from ca. 2000 BCE. Some copper artifacts have been excavated as well. Burials were furnished with such gifts as bone and stone tools, pottery vessels, ornaments, and oracle bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qijia"@en .

aat:300265649 a skos:Concept ;
    skos:definition "Refers to the culture and styles native to the area and islands along Adriatic coast, both historically and in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalmatian"@en .

aat:300265650 a skos:Concept ;
    skos:definition "A yellow to reddish brown dyestuff obtained from the East Indian perennial herb, turmeric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turmeric"@en .

aat:300265651 a skos:Concept ;
    skos:definition "African people living in northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tula"@en .

aat:300265652 a skos:Concept ;
    skos:definition "Style and culture of the native people who live along the shores of Ungava Bay, on the south shore of Hudson Strait, and on the eastern coast of Hudson Bay. They exploit the resources of the vast area north of the treeline, especially sea mammals in the coastal waters, and also move inland to hunt caribou and at times penetrate the traditional Cree and Montagnais-Naskapi lands south of the treeline. Culturally close to the Inuit southeast of Baffin Island and to the Labrador Inuit, the Ungava nevertheless differ from these tribes in a number of linguistic and technological respects and in their social and religious customs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ungava"@en .

aat:300265653 a skos:Concept ;
    skos:definition "Used to describe the modernist movement in architecture as it evolved in California, specifically Los Angeles and the area surrounding it, from the 1930s through the 1960s. Hallmarks of this style are attention to indoor-outdoor living, open plans, rectilinear structures often constructed with steel frames, and extensive use of glass. The term is most often used to refer to the Case Study House Program initiated by John Entenza in 1945, and to modernist residential structures in general. Architects associated with the style are Richard Neutra, Rudolf Schindler, Charles and Ray Eames, Gordon Drake, Albert Frey, John Lautner, Pierre Koenig, and Rafael Soriano. Public perception of this movement is commonly attributed to the photographs of Julius Shulman, as published in architectural and interior design magazines during the 1950s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "California Modernism"@en .

aat:300265654 a skos:Concept ;
    skos:definition "Process developed by Lea and Luis Remba with Rufino Tamayo that produces embossed or dimensional prints in color with handmade paper. This is achieved with inked plates moulded from a model created by an artist into which is pushed raw paper pulp under great pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mixografia (R)"@en .

aat:300265655 a skos:Concept ;
    skos:definition "Indoor installation works which incorporate materials from nature and address ecological concerns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eco-installations"@en .

aat:300265656 a skos:Concept ;
    skos:definition "The practice of making photographs that reproduce as nearly as possible the objective of photographs of an earlier time in order to highlight changes in weather, environment, or built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repeat photography"@en .

aat:300265657 a skos:Concept ;
    skos:definition "Primarily used to describe an architectural style evident in Russia from the late 19th century until 1917 that relies on old Russian decoration and spatial constructs. It can be seen in many Old Believer churches built between 1906 and 1917. The neo-Russian style existed before and after the Modern Style, the Russian reaction to Art Nouveau, and is considered a separate movement. Proponents include Ivan Fomin and Ivan Zholtovsky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neo-Russian Style"@en .

aat:300265658 a skos:Concept ;
    skos:definition "Specifically refers to the work of the \"Lukasbrüder,\" a group founded in Vienna in 1809 by Friedrich Overbeck, later derisively called \"Nazarenes.\" The style is anti-academic and emulates techniques of the late Medieval and early Renaissance period, particularly Dürer and Perugino, and places an emphasis on Christian values and morality in art over technical virtuosity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nazarene"@en .

aat:300265659 a skos:Concept ;
    skos:definition "Sound device in which a photoelectric cell is used to scan a text, which then produces electric signals that are converted into audible sound. The instrument today is generally used to enable the blind to read, although the device had its origins with the inventions of Austrian artist and Dadaist Raoul Hausmann in the 1920s, who was preoccupied with unifying the senses, and changing light into sound. It was patented in 1935 as a \"calculating device\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optophones"@en .

aat:300265660 a skos:Concept ;
    skos:definition "Evangelical Christian denomination founded in California in 1895, deriving from the 19th-century Holiness movement in North America. With its members colloquially referred to as Nazarenes, it is the largest Wesleyan-holiness denomination in the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nazarene"@en .

aat:300265661 a skos:Concept ;
    skos:definition "The wood of the evergreen tree Hippomane mancinella, found in the Caribbean; although the tree is highly poisonous, the wood takes a good polish and is sometimes used in furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manchineel"@en .

aat:300265662 a skos:Concept ;
    skos:definition "An early Judeo-Christian sect dating to the 4th century, located in Jerusalem, and believing that Jesus of Nazareth was the promised Messiah and the Son of God. As the Ebionites, Nazarenes considered themselves Jews, adhered to Mosaic Law, and used only the Aramaic Gospel of the Hebrews. They accepted the doctrine of the Virgin Birth. In early texts, the term is also used broadly to refer to any Christian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nazarene"@en .

aat:300265663 a skos:Concept ;
    skos:definition "Architecture style espoused by Sol LeWitt and Giuseppe Terragni."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post-Functionalism"@en .

aat:300265664 a skos:Concept ;
    skos:definition "Plates or dishes formerly used for holding spices. English spice-plates from the 16th and 17th centuries were often elaborately decorated and gilded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice-plates"@en .

aat:300265666 a skos:Concept ;
    skos:definition "Generally, lead or tin-glazed, relief-molded and decorative earthenware manufactured principally in Germany from 1350 as insulating tiles for stoves. The term is also used to describe vessels with figurative decoration, usually of religious or mythological scenes, created by stove makers beginning in the 16th century. From ca. 1500 polychromatic glazes appear. From the mid-1600s, lead glazes are replaced by tin. Nürnberg is considered the center of Hafner ware manufacture, though it was made in Switzerland and elsewhere in Central Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hafner ware"@en .

aat:300265667 a skos:Concept ;
    skos:definition "Generally any craftsperson involved in the manufacture of felt. The Worshipful Company of Feltmakers was one of the Livery Companies of London, makers of felt hats, incorporated in 1604. Current usage most often refers to artists and craftspeople who create sculptural or wearable objects from felted fibers, usually wool. For those who create works from fibrous material in general, use \"fiber artists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feltmakers"@en .

aat:300265670 a skos:Concept ;
    skos:definition "An apparatus that produces a blast of air to a furnace or a forge by means of falling water, and that separates the air and water at a secondary stage. Specifically, a blowing apparatus with no moving parts used in Italian, Spanish and other Mediterranean countries' metallurgical plants until the 19th century. A blast of wet air is supplied to a furnace through the action of falling water, which carries air downward by means of the Venturi effect to a barrel where the air is separated and sent through a pipe, or \"tuyere,\" to the furnace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trompes"@en .

aat:300265671 a skos:Concept ;
    skos:definition "Interleaves, often made of highly sized paper, or glassine paper, inserted into a book to prevent the transfer of ink from an illustration or plate onto the facing page. Guard sheets are also frequently used to elucidate the accompanying illustration. They may be loose, or bound, and are often made of inferior paper, which may transfer acidity to the facing leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guard sheets"@en .

aat:300265672 a skos:Concept ;
    skos:definition "The study of the scientific or technical aspects of architecture as distinguished from the purely artistic or historical aspect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectonics"@en .

aat:300265674 a skos:Concept ;
    skos:definition "Refers to the art group co founded in 1999 by British artists Charles Thomson and Billy Childish, along with eleven other artists. The term 'Stuckist' was derived from fellow artist Tracey Emin's criticisms of Childish's paintings as 'Stuck! Stuck! Stuck!' The movement calls for a return to painting and the authenticity of direct expression. Rejecting postmodernism as a marketing tool that denies emotion or content, the Stuckists promote a form of 'Remodernism', where spirituality can counteract prevalent skepticism and nihilism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stuckist"@en .

aat:300265675 a skos:Concept ;
    skos:definition "Members of the group of true bacteria, which is one of two major groups of prokaryotic organisms, and one of the three major divisions of living organisms. The division of the bacteria into two groups arises from studies of their ribosomal RNA, which indicates that they are as different from each other as they are from eukaryotes (plants and animals). Bacteria and Archaea (formerly called Eubacteria and Archaebacteria) are thought to have evolved separately from a common ancestor early in Earth's history. Bacteria and Archaea differ in important characteristics, such as the number of ribosomal proteins and the size and shape of the ribosomal S unit. Use generally for unicellular microscopic protists, spherical, rodlike, or spiral in form, or clustered into filamentous colonies, reproducing by cell division, by asexual spores, or by imperfectly understood sexually processes. Various types have chemical effects, such as fermentation, nitrogen fixation, and putrefaction, or cause diseases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bacteria"@en .

aat:300265676 a skos:Concept ;
    skos:definition "Members of a group of bacteria that differ in certain morphological, physiological, and genetic features from the eubacteria. One of the three major divisions of living organisms. They do have some features in common with the eubacteria, suggesting to some researchers that the two groups shared a common ancestor early in their evolutionary history. The two groups of bacteria are as different from each other as they are from eukaryotes (plants and animals). Archaea are microbes and most live in extreme environments requiring excesses of heat or salt for survival, and neither sunlight nor oxygen. They absorb carbon dioxide, nitrogen, or hydrogen sulfide and give off methane gas as a waste product the same way humans breathe in oxygen and breathe out carbon dioxide. Archaea could survive in environments such as those on Venus and in the past on Jupiter, Mars, and Saturn, and Jupiter's moon, Io."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaea"@en .

aat:300265677 a skos:Concept ;
    skos:definition "One of the three major divisions of living organisms; includes plants, animals, and all living things other than Archaea and Eubacteria. Although members in this group differ greatly, all members of the group have eukaryotic cells with a nucleus that contain genetic material within chromosomes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eukaryota"@en .

aat:300265679 a skos:Concept ;
    skos:definition "Kingdom containing around 80,000 known species of non-photosynthetic organisms composed of one or more cells having visibly evident nuclei. They obtain nutrients by the absorption of organic compounds from their surroundings, bear spores, and typically reproduce both sexually and asexually, including yeasts, rusts, smuts, mildews, molds, mushrooms, and toadstools. The term \"fungi\" is also used erroneously for organisms that superficially look like true fungi, including slime molds and oomycetes that do not actually belong to the kingdom Fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fungi"@en .

aat:300265680 a skos:Concept ;
    skos:definition "Kingdom comprising organisms with a relatively simple organization that are regarded as intermediate between or distinct from animals and plants, especially unicellular eukaryotes. They may share certain morphological and physiological characteristics with animals or plants, or both. They may be either free-living or gathered into simple colonies, and having diverse ways of nutrition and reproduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protista"@en .

aat:300265681 a skos:Concept ;
    skos:definition "Multicellular eukaryotic life forms characterized by photosynthesis, in which chemical energy is produced from water, minerals, and carbon dioxide with the aid of pigments and the radiant energy of the Sun. However, also included in the kingdom are plants that do not produce their food by photosynthesis but rather are parasitic and live off of other living plants. Other plants are saprophytic, obtaining their food from dead organic matter. Plants have cells that contain cellulose in their walls and are therefore to some extent rigid. There is also an absence of organs of locomotion, resulting in a more or less stationary existence as well as no sensory and nervous systems. There are over 300,000 different species of plants, making it one of the largest kingdoms on Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chromista"@en .

aat:300265682 a skos:Concept ;
    skos:definition "General term for many types of microscopic organisms that were formerly thought to be a related group, but are today believed to instead represent organisms that do not necessarily share a common evolutionary history. They have in common that they are single-celled and heterotrophic eukaryotes, have a membrane-bound nucleus, are nonfilamentous, and are confined to moist or aquatic habitats, ubiquitous worldwide. Many are symbionts of other organisms, and some species are parasites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protozoans"@en .

aat:300265683 a skos:Concept ;
    skos:definition "Phylum of primitive multicellular aquatic animals. There are approximately 5,000 described species and inhabit all seas, where they occur attached to surfaces from the intertidal zone to depths of 29,000 feet or more. Early naturalists regarded the sponges as plants because of their frequent branching form and their lack of obvious movement. The animal nature of sponges was first described in 1755, and was confirmed in 1765 after observations revealed movement of their openings. In structure, function, and development, however, sponges are distinct from other animals. Many zoologists regard sponges as occupying an isolated position in the animal kingdom and classify them in the subkingdom Parazoa. Other sources consider sponges relatives of the invertebrate animal group coelenterates. Aquatic, chiefly marine animals of the phylum Porifera, varying greatly in size, shape, and color, and having a porous body and siliceous or calcareous internal framework, living permanently attached singly or in groups, feeding b filtering food particles from the water that enters their internal body channels through their pores. They are very simply organized with no mouth, digestive cavity, nerves, muscle, or true behavior, and sometimes are considered to be colonized protozoans rather than single multicellular organisms. For the light, porous, yielding fibrous skeletal matter of these animals, use \"sponge (material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Porifera"@en .

aat:300265685 a skos:Concept ;
    skos:definition "Phylum of flat soft-bodied invertebrates that include tapeworms and flukes. The flatworms are free-living as well as parasitic and lack respiratory, skeletal, and circulatory systems. The body is not divided into true segments, but rather has spongy connective tissue called parenchyma filling in the space between organs. Flatworms are hermaphroditic and are the lowest invertebrates to possess three embryonic layers of endoderm, mesoderm, and ectoderm. Bilaterally symmetrical worms of the phylum Platyhelminthes, having a soft, solid, usually flattened body without an internal cavity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platyhelminthes"@en .

aat:300265686 a skos:Concept ;
    skos:definition "Members of a class of parasitic flatworms that live in the digestive tract of vertebrates as adults. They are fluid-feeding with a knoblike head provided with suckers and hooks, a short neck, and the rest of the body made up of a series of identical segments packed with reproductive organs. Larvae live within the gut vertebrates and arthropods, adults within vertebrates only, absorbing the hosts' food directly across their body wall; they reach a length of 40 feet in some species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cestoda"@en .

aat:300265687 a skos:Concept ;
    skos:definition "The largest phylum in the animal kingdom; includes lobsters, crabs, spiders, insects, centipedes, and millipedes. Diverse in structure, lifestyle, and habitat, about 84 percent of the known species of animals are members of this phylum. Arthropds are characterized by the presence of a skeletal covering composed of chitin, a complex sugar, bound to protein. This nonliving exoskeleton is secreted by the underlying epidermis, similar to the skin of other animals. The body is usually segmented with jointed appendages, from which the name arthropod or \"jointed feet\" is derived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arthropoda"@en .

aat:300265689 a skos:Concept ;
    skos:definition "Bottom-dwelling marine invertebrates characterized by being covered by two valves or shells, with one valve covering the dorsal or topside and the other covering the ventral or bottom side; commonly known as lamp shells because they resemble early Roman oil lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brachiopoda"@en .

aat:300265690 a skos:Concept ;
    skos:definition "Invertebrate animals that are characterized by coelom or body cavity, or setae or movable bristles, and a body divided into segments by transverse rings or annulations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Annelida"@en .

aat:300265691 a skos:Concept ;
    skos:definition "Widely distributed, aquatic, invertebrate animals whose members form colonies composed of numerous units called \"zooids,\" hence the term Polyzoa or \"many animals.\" They inhabit both fresh and marine waters. Until the mid-18th century, bryozoans, like corals, were regarded as plants and were referred to \"moss animals.\" Seventy-five years later, the bryozoans were distinguished from the cnidarians, and the characteristic structure of the zooid was first described."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bryozoa"@en .

aat:300265692 a skos:Concept ;
    skos:definition "Phylum having members that are characterized by a hard, spiny covering or skin. Echinoderms have existed since the Lower Cambrian Period, and today comprise about extant 7,000 species that fall into five well-defined groups: Crinoidea (sea lilies and feather stars), Ophiuroidea (basket stars and brittle stars), Asteroidea (starfishes), Echinoidea (sea urchins, sand dollars, and sea biscuits), and Holothuroidea (sea cucumbers). In the 19th century, Echinodermata was recognized as a distinct group of animals that was occasionally associated with the cnidarians and selected other phyla in a division of the animal kingdom known as the Radiata, however the concept of the superphylum Radiata is no longer valid. Marine invertebrate animals of radially symmetrical structure, having a body wall stiffened by calcareous pieces that may protrude as spines, and tiny hydraulically-operated tube-feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Echinodermata"@en .

aat:300265693 a skos:Concept ;
    skos:definition "Small phylum that includes acorn worms and pterobranchs, characterized as wormlike marine invertebrates closely related to the chordates. While they are typically given phylum rank, some sources place the group at various other taxonomic levels with the other so-called protochordates. Hemichordates are so named for the Greek hemi, meaning \"half,\" and chorde, meaning \"string,\" thus, \"half-chordate,\" which was first proposed because the buccal diverticulum, a tubular outgrowth from the mouth cavity forward into the proboscis, resembled a rudimentary notochord. This theory has since been rejected, however, because it has been determined that the diverticulum bears little resemblance in origin and function to the vertebrate notochord. Along with the proboscis, the body comprises a short collar, and a long, wormlike trunk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hemichordata"@en .

aat:300265695 a skos:Concept ;
    skos:definition "Large and diverse group of simple, typically autotrophic organisms, predominantly aquatic, photosynthetic organisms ranging from unicellular to multicellular forms, such as microscopic single-celled planktonic forms to huge kelps reaching over 100 feet in length; they photosynthesize their own food, though some species also ingest food particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Algae"@en .

aat:300265698 a skos:Concept ;
    skos:definition "Formerly classified as a single division called \"Bryophyta,\" it is now split into three divisions: Bryophyta (mosses), Anthocerotophyta (hornworts), and Marchantiophyta (liverworts). Mosses are small, simple land plants which first appeared in the Devonian. They are characterized by lacking true roots, stems, and leaves and relying upon water for reproduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bryophyta"@en .

aat:300265699 a skos:Concept ;
    skos:definition "A large group of around 20,000 species of flowerless, seedless vascular plants having true roots from a rhizome and fronds that uncurl upward, reproducing by spores. The ferns are an ancient lineage of plants, dating back to at least the Devonian; during the Palaeozoic, tree-ferns grew several meters tall. The ferns include three living groups (Marattiales, Ophioglossales, and leptosporangiate ferns) and two or more extinct groups. An additional group, the Psilotales, is tentatively included in the ferns, although the group is vastly different from living ferns and its relationships are uncertain. The ferns group is also referred to as Polypodiophyta or Polypodiopsida when classified as a subdivision of tracheophyta (vascular plants)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pteridophyta"@en .

aat:300265702 a skos:Concept ;
    skos:definition "Division of the plant kingdom containing conifers, which are gymnospermous exogens (stem grows by deposit on its outside), comprising trees and shrubs bearing cones; most are evergreen, with leaves that are needlelike, scale-like, with a single vein or, less commonly, strap-shaped with multiple veins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coniferophyta"@en .

aat:300265703 a skos:Concept ;
    skos:definition "Gymnospermous plants with lineage dating back only to the early Cretaceous; widely considered to be the closest extant relative of the flowering plants. Plants are trees, shrubs, lianes, and stumpy turnip-like plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gnetophyta"@en .

aat:300265704 a skos:Concept ;
    skos:definition "Gymnospermous (seeds are not provided with a seed-vessel) plants that are characterized as tall, multi-branched deciduous trees with a well-developed cylinder of wood and bearing distinctive fan-shaped leaves. It flourished in the Mesozoic era and today is represented by one living species, Ginkgo biloba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ginkgophyta"@en .

aat:300265705 a skos:Concept ;
    skos:definition "Gymnosperms that are related to the conifers but resembling palms and having affinity with tree-ferns. Characterized by a crown of large compound leaves and a stout trunk; examples exist in tropical and subtropical regions today, but they flourished in great variety and abundance during the Jurassic Period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cycadophyta"@en .

aat:300265706 a skos:Concept ;
    skos:definition "Plants having seeds inclosed in a seed-vessel possessing the distinctive feature, the flower, which is a cluster of highly-specialized leaves that participate in reproduction. There are perhaps as many as 400,000 species of flowering plants, representing arouind 80% of plants now living. The classification of angiosperms is in flux, with newer divisions called the \"APG system\" (organized by the Angiosperm Phylogeny Group)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angiospermae"@en .

aat:300265707 a skos:Concept ;
    skos:definition "Large and varied class of vertebrate animals characterized by being warm-blooded, having mammary glands that secrete milk to feed the young, bearing live young (with few exceptins), hair (although it has largely disappeared in some adult animals, such as whales), a lower jaw that is hinged directly to the skull instead of through a separate bone (the quadrate) as in all other vertebrates, three tiny bones that transmit sound waves across the middle ear, a muscular diaphragm separating the heart and the lungs from the abdominal cavity, a left aortic arch, and mature red blood cells lacking a nucleus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mammalia"@en .

aat:300265709 a skos:Concept ;
    skos:definition "Family containing four genera with seven living species of humans, chimpanzees, bonobos, gorillas, and orangutans that developed in Africa and Eurasia (prior to human expansion) from the Late Pleistocene. There are 25 fossil species of seven genera dating from the Pliocene. Note that this classification has been revised several times in the last few decades and is still in flux: Originally the group was restricted to humans and their extinct relatives, with the other great apes being placed in a separate family, the Pongidae. This earlier classification is still used by many anthropologists and by lay people; biologists reject the earlier classification because according to the earlier classification the group would contain the most recent common ancestor of the members of the group, but it would not contain all the descendants of that ancestor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hominidae"@en .

aat:300265710 a skos:Concept ;
    skos:definition "Members of a genus of primates characterized by a relatively large cranial capacity, limb structure adapted to a habitual erect posture and a bipedal gait, well-developed and fully opposable thumb, hand capable of power and precision grips, and the ability to make standardized precision tools, using one tool to make another. Together with modern man, Homo sapiens, the genus includes the extinct species H. habilis, H. erectus, and H. heidelbergensis as well as the extinct Neanderthals (H. neanderthalensis) and the early form of H. sapiens called Cro-Magnon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homo"@en .

aat:300265711 a skos:Concept ;
    skos:definition "Members of the species to which all modern human beings belong. Homo sapiens is one of several species grouped into the genus Homo, but it is the only one that is not extinct. The name \"Homo sapiens\" was applied in 1758 by Carolus Linnaeus, who distinguished humans from their close cousins, the apes. The large fossil record now contains numerous extinct species that are much more closely related to humans than to today's apes and that were presumably more similar to us behaviorally as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homo sapiens"@en .

aat:300265713 a skos:Concept ;
    skos:definition "Family containing 35 living species of mammals in 13 genera, representing foxes, wolves, jackals, and other members of the dog family. They tend to be slender, long-legged animals with long muzzles, bushy tails, and erect, pointed ears, social, intelligent, and easily trained. They were probably the first animals to be domesticated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canidae"@en .

aat:300265714 a skos:Concept ;
    skos:definition "Genus of eight species of canids including dogs, coyotes, wolves, jackals, and dingos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canis"@en .

aat:300265715 a skos:Concept ;
    skos:definition "The best-known of the three species of wild doglike carnivores known as wolves. It is the largest nondomestic member of the dog family (Canidae) and inhabits vast areas of the Northern Hemisphere. It once ranged over all of North America from Alaska and Arctic Canada southward to central Mexico and throughout Europe and Asia above 20 degrees N latitude. There are at least five subspecies of gray wolf. It was formerly thought that domestic dogs were descended from gray wolves, but new research suggests that instead both the wolf and dogs had a common ancestor. Pervasive in human mythology, folklore, and language, the gray wolf has had an impact on the human imagination in mythology, legends, literature, and art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canis lupus"@en .

aat:300265716 a skos:Concept ;
    skos:definition "Family of mammals containing 37 species in 18 genera representing the cheetah, puma, jaguar, leopard, lion, lynx, tiger, domestic cat, and others, descended from a common ancestor about 10.8 million years ago. According to a 2006 genomic study the ancestor of extant Leopardus, Lynx, Puma, Prionailurus, and Felis lineages migrated across the Bering land bridge into the Americas approximately 8 to 8.5 million years ago. Members of Felidae are typically characterized by having a long tail, a head with a short nose and round face, large eyes positioned for good binocular vision, usually with short ears, sharp claws that are retractile except in the cheetah, a tongue covered with horny papillae, five toes on their forefeet and four on their hindfeet, with the male larger than the female, possessing a genetic anomaly that prevents them from tasting sweetness, and being the most strictly carnivorous of the mammal families in the order Carnivora. Their closest relatives are thought to be the civets, hyenas, and mongooses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felidae"@en .

aat:300265717 a skos:Concept ;
    skos:definition "Genus of six Old World species, including the wildcat and domestic cat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis"@en .

aat:300265719 a skos:Concept ;
    skos:definition "Small wild member of the cat family (Felidae) native to Europe, western Asia, and Africa. It is a hunter of small mammals, birds, and other creatures. The wild cat is of a light to medium gray color and has a tabby coat with rather thin strips. It resembles a domestic tabby cat. Some classifications include it as a single species with Felis domesticus, which is descended from Felis silvestris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis silvestris"@en .

aat:300265720 a skos:Concept ;
    skos:definition "A subphylum including include fishes, reptiles, amphibians, birds, and mammals. They are characterized by a bony or cartilaginous endoskeleton that includes a spinal column surrounding and virtually replacing the notochord as the chief stiffener of the body in locomotion. They also typically have a general body plan consisting of a head, trunk, two pairs of appendages, a postanal tail (which may be highly modified in many vertebrates and sometimes absent), bilateral symmetry, a muscular system attached to the skeleton, a digestive system with large glands, a ventral heart with two to four chambers, blood with red and white corpuscles, and two sexes that each have paired gonads. Vertebrates originated around 500 million years ago during the Cambrian period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vertebrata"@en .

aat:300265721 a skos:Concept ;
    skos:definition "The arrangment of various visual components for a page or pages, including drawings, graphs, photographs, or other illustrations used as supplementary to news, stories, or other text in a newspaper, magazine, brochure, online page, or other publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial layout"@en .

aat:300265722 a skos:Concept ;
    skos:definition "Short for 'Web logs' or 'weblogs:' a Web site that functions as an online journal or diary, most often maintained by a single person, but also by groups with common interests. Commentary, images, sound, or video files are posted regularly with the most recent entry appearing first. Blogs may focus on a particular area of interest and contain links to content on external Web pages. Blogs usually have archives of all past entries, with links between similar items of interest. They originated in the United States in 1997 as a few online journals, and became popular ca. 2002, when software designed specifically for creating and maintaining blogs was introduced. For files storing detailed requests from Web servers use 'Web logs.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blogs"@en .

aat:300265723 a skos:Concept ;
    skos:definition "Electronic files that store detailed records of requests made of Web servers, or errors generated by them, and usually used to generate statistical data. For online journals created by individuals or groups, use 'blogs.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Web logs"@en .

aat:300265724 a skos:Concept ;
    skos:definition "Refers to the period of the Ikṣvāku kings. The Ikṣvākus seized power from the Satavahanas in the second quarter of the the 3rd century, and established their kingdom in the Guntur district around the Nạgạrjunakonda Valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ikṣvāku dynasty"@en .

aat:300265725 a skos:Concept ;
    skos:definition "Late Neolithic Chinese jade or stone tubes having a squared exterior surface and a round, hollow interior. They are usually decorated at the corners with facial features, sometimes abbreviated to concentric circles or eye-like shapes, and embellished with incised horizontal bars on the planar surfaces. An ancient Chinese text called 'The Rites of Zhou' states that the cong was used as a sacrifice to the earth. Symbolic meaning may be a counterpart to that of the \"bi (ceremonial object),\" which represented the heavens. Similar vessels may date to later periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cong"@en .

aat:300265726 a skos:Concept ;
    skos:definition "Neolithic Chinese objects in the form of a flat disk with a hole in the center. The term bi is applied to wide disks with proportionately small central holes, made from jade or other stone, and found at burial sites. There is much speculation on the function of these objects, though they are generally thought to represent the heavens or the sun. Bi have continued to be used as a form of regalia and as decorative objects well into the late nineteenth and early twentieth centuries. They are often seen as related to the \"cong (ceremonial vessel),\" which represented the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bi"@en .

aat:300265727 a skos:Concept ;
    skos:definition "Broadsides, posters, or fliers that describe criminals sought by law enforcement agencies. Wanted posters usually include an offer of reward for capture or information, with a pictorial representation of the person sought."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wanted posters"@en .

aat:300265728 a skos:Concept ;
    skos:definition "Books, with or without text in which the essential information is conveyed through a collection of photographic images. These may be authored by one or more artists or photographers, or arranged by an editor. Generally the images in a photobook are meant to be viewed in context, as parts of a larger whole. Most often used to refer to mechanically reproduced and commercially distributed works. For albums made up of mounted photographic prints, with or without identifying information, use \"photograph albums.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photobooks"@en .

aat:300265730 a skos:Concept ;
    skos:definition "Memphis, the group, was founded in Milan, 11 December 1980, by Ettore Sottsass, Barbara Radice, Marco Zanini, Aldo Cibic, Matteo Thun, Michele De Lucchi, and Martine Bedin. Others who did work in the Memphis idiom were: Peter Shire, Shiro Kuramata, and Michael Graves. Objects such as furniture and lighting designed in the Memphis style feature bright colors and bold geometric shapes, made from industrial materials such as plastic laminate. The group was formed in reaction to modernist design sensibilities, and advocated forms derived from popular culture and kitsch sources. The style associated with Memphis was influential and developed many international followers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Memphis"@en .

aat:300265731 a skos:Concept ;
    skos:definition "A book format derived from folding a sheet of paper into 128 leaves, resulting in 256 pages. Often notated as 128mo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hundred and twenty-eightmo"@en .

aat:300265732 a skos:Concept ;
    skos:definition "A nursery for breeding silkworms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnaneries"@en .

aat:300265733 a skos:Concept ;
    skos:definition "Spaces within a museum where objects are stored when not being exhibited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museum storerooms"@en .

aat:300265734 a skos:Concept ;
    skos:definition "The curves that are formed from chains or rope that hang from two fixed points, though not in the same vertical line. Derived from the Latin \"catena,\" meaning \"chain\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catenaries"@en .

aat:300265735 a skos:Concept ;
    skos:definition "A white, vertical, flat surface on which images are projected, made of reflective material. Generally used for motion picture, video, or photographic slide projection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screens"@en .

aat:300265736 a skos:Concept ;
    skos:definition "A non-repeating, often flat, rectangular, and usually stone surface, slab, or panel set into a wall or pedestal; and bearing inscriptions, paintings, or relief sculpture. For similar objects that are movable or that are not part of the structure of a wall or pedestal, use \"tablet.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tables"@en .

aat:300265737 a skos:Concept ;
    skos:definition "Coloring or staining a material so it resembles marble or a similar stone. Usually reserved for broader, less delicate techniques, as in interior and exterior construction. An example would be when two differently colored materials are swirled together to form a marbelized appearance in manufacturing countertops. For more delicate, hand-rendered techniques, such as in hand-painting book endpapers to resemble marble, use \"marbling.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marbleizing"@en .

aat:300265738 a skos:Concept ;
    skos:definition "Rods, usually tapered at both ends, used as axes in hand spinning. Fibers are drawn and twisted onto the spindle from a mass of wool or other material that is gathered on the distaff. The image of the spindle and distaff has been associated historically with feminine power or virtue. For the similar cylindrical objects used to gather or accumulate thread after it has been spun, and for use in weaving, use \"spools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spindles"@en .

aat:300265739 a skos:Concept ;
    skos:definition "Book cloth grain with honeycomb pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honeycomb grain"@en .

aat:300265740 a skos:Concept ;
    skos:definition "Book cloth grain with bead-like pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead grain"@en .

aat:300265741 a skos:Concept ;
    skos:definition "Book cloth grain which became popular in the 1830s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaper grain"@en .

aat:300265742 a skos:Concept ;
    skos:definition "Book cloth pattern introduced ca. 1836."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rib grain"@en .

aat:300265743 a skos:Concept ;
    skos:definition "Book cloth grain with a bubble pattern, introduced ca. 1870."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bubble grain"@en .

aat:300265744 a skos:Concept ;
    skos:definition "Irregular granular pattern embossed on bookcloth in imitation of leather. \"Morocco\" refers to a type of goatskin leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morocco grain"@en .

aat:300265745 a skos:Concept ;
    skos:definition "Paper discarded as superfluous or not fit for a particular use, although possibly regarded as valuable in other processes; also, blank paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waste paper"@en .

aat:300265746 a skos:Concept ;
    skos:definition "Internet-based discussion forums in which messages are exchanged via electronic mail, rather than through a bulletin board system or newsgroup. LISTSERV (TM) is a trademarked term for a commercial software product devoted to managing electronic mailing lists. Though \"listserv\" is often generically used to refer to any such software application, and commonly to mailing lists themselves, \"electronic mailing lists\" is preferred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic mailing lists"@en .

aat:300265748 a skos:Concept ;
    skos:definition "Apartments or houses in which all the rooms are on one level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain-pied"@en .

aat:300265749 a skos:Concept ;
    skos:definition "Book cloth pattern which resembles plant fronds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frond grain"@en .

aat:300265750 a skos:Concept ;
    skos:definition "Book cloth grain pattern in use from ca. 1833-1866."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbed morocco grain"@en .

aat:300265751 a skos:Concept ;
    skos:definition "Buildings for 'trying' or extracting oil from blubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "try-houses"@en .

aat:300265752 a skos:Concept ;
    skos:definition "Long dresses, typically elaborately trimmed with lace, beading, or embroidery, and worn by infants for christening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening gowns"@en .

aat:300265754 a skos:Concept ;
    skos:definition "Ceramic objects used to separate wares during firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiln spacers"@en .

aat:300265755 a skos:Concept ;
    skos:definition "Painting directly on stone supports (slate or marble), a technique pioneered by Sebastiano del Piombo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting on stone"@en .

aat:300265756 a skos:Concept ;
    skos:definition "Creamware that is lead-glazed, and originating ca. 1763. It was developed by Josiah Wedgwood and named after Queen Charlotte. Its popularity eventually led to the disappearance of the English, tin-glazed earthenware industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Queen's ware"@en .

aat:300265757 a skos:Concept ;
    skos:definition "Designation used for stylistic families of Chinese tin-glaze porcelain enamel wares from the Qing period, assigned by the French ceramic historian Albert Jacquemart in the 19th century, and based on the predominant colors of the enamel itself: green, yellow, black, and pink. The primary groups, from which the others are derived are \"famille verte\" and \"famille rose.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "famille"@en .

aat:300265758 a skos:Concept ;
    skos:definition "Embroidered coverings or hangings produced by using the colcha stich."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colchas"@en .

aat:300265759 a skos:Concept ;
    skos:definition "Family of sytles of Chinese porcelain glazed wares from the Qing dynasty onwards that is characterized by a brilliant green enamel, though other colors appear such as iron-red, blue, yellow, and purple. The style influenced European porcelain manufacture. The term was developed by the ceramics historian Albert Jacquemart in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "famille verte"@en .

aat:300265760 a skos:Concept ;
    skos:definition "Style of Chinese porcelain wares of the Qing dynasty with a black ground covered by transparent green enamel. Represents a subset of the \"famille verte\" class of enamel ware style designated by Albert Jacquemart in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "famille noire"@en .

aat:300265761 a skos:Concept ;
    skos:definition "Subset of the \"famille verte\" style of porcelain enamel wares of the Qing dynasty characterized by extensive use of yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "famille jaune"@en .

aat:300265762 a skos:Concept ;
    skos:definition "Small tables supported on legs, pillar, or tripod, with an adjustable top, hinged to fold flat. GLOAG."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading tables"@en .

aat:300265763 a skos:Concept ;
    skos:definition "Embroidered laid stitches sewn in an alternating or uneven lengths to create a rough, woven-looking surface, often sewn using crewel or Persian yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colcha stitches"@en .

aat:300265764 a skos:Concept ;
    skos:definition "Refers to a style of painting that combines ideas of science and art, and mythology and history, updating 16th-century Mannerism's use of distorted bodies and space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New Italian Manner"@en .

aat:300265765 a skos:Concept ;
    skos:definition "The practice of measuring phosphates in soil from archaeological sites to map the boundaries of settlements and agricultural areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphate mapping"@en .

aat:300265766 a skos:Concept ;
    skos:definition "Length of existence of anything in its present form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "age"@en .

aat:300265767 a skos:Concept ;
    skos:definition "Philosophical study of finality, especially as it pertains to design or purposes in the processes of nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teleology"@en .

aat:300265768 a skos:Concept ;
    skos:definition "Losing consciousness, due to a drop in blood supply to the brain. Also, a weakening or decline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fainting"@en .

aat:300265769 a skos:Concept ;
    skos:definition "Treatment of disease by exposure to the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heliotherapy"@en .

aat:300265770 a skos:Concept ;
    skos:definition "Fiction which contains elements of autobiography, or fictionalized autobiography. The term was originally coined by author Serge Dubrovsky in 1977."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autofiction"@en .

aat:300265771 a skos:Concept ;
    skos:definition "The concept of one's home or native land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homeland"@en .

aat:300265772 a skos:Concept ;
    skos:definition "Documents that announce the birth of a child. Often these include the parents' names, and sometimes physical details of the child. This term may be extended to printed cards, newspaper listings, electronic mailings, or other historical forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth announcements"@en .

aat:300265773 a skos:Concept ;
    skos:definition "In form or position, the state or quality of being oblique. Also, a deviation from a parallel state, or perpendicularity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obliquity"@en .

aat:300265774 a skos:Concept ;
    skos:definition "Political ideology that advocates a transition to a socialist society, achieved gradually through the democratic process. Originally a form of Marxism, the movement grew out of the formation of the German Social Democratic Worker's Party in 1869, which eventually led to the Social Democratic Party of Germany. Its philosophy evolved and eventually rejected militarism, totalitarianism, and revolution as a means for political change. A main advocate of social democracy was theorist Eduard Bernstein, who parted ways with Marx and Engel, instead positing that democracy must be embraced in order to instill socialist changes. Following the Second World War, several social-democratic governments came to power, including those in West Germany and Sweden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social democracy"@en .

aat:300265775 a skos:Concept ;
    skos:definition "Characteristic of being mortal or subject to death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortality"@en .

aat:300265776 a skos:Concept ;
    skos:definition "Political adherence to a monarchy, or monarchic principles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monarchism"@en .

aat:300265777 a skos:Concept ;
    skos:definition "Markets, usually outdoors or in a large roofed space, where fresh dead fish are sold for food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish markets"@en .

aat:300265778 a skos:Concept ;
    skos:definition "Soldiers from Switzerland, now exclusively used by the Vatican to guard the Pope, and the college of cardinals. Originally the soldiers were mercenaries used to guard various monarchs, and their most familiar uniforms were designed by Michelangelo during the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swiss guards"@en .

aat:300265779 a skos:Concept ;
    skos:definition "Type of insanity, described by ancient writers, in which the patient imagines himself to be a wolf, with the instincts and propensities of a wolf. Also, more generally applied to those forms of insanity in which the patient imagines himself a beast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lycanthropy"@en .

aat:300265780 a skos:Concept ;
    skos:definition "The quality or state of being theatrical in action, appearence, or style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theatricality"@en .

aat:300265781 a skos:Concept ;
    skos:definition "Concept regarding the condition of being present in front of, or in the same place with a person or thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presence"@en .

aat:300265782 a skos:Concept ;
    skos:definition "Television system standard for broadcasting television signals at twice the resolution than the current NTSC (National Television System(s) Committee) standard. It employs a wide aspect ratio of 16:9."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high-definition television"@en .

aat:300265783 a skos:Concept ;
    skos:definition "Refers to a textile effect produced by weaving warp threads of one color and weft threads of a contrasting color, so that the fabric, often silk or other lustrous fabric, changes in color when viewed from different points of view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shot"@en .

aat:300265784 a skos:Concept ;
    skos:definition "Refers to a technique in painting, drawing, mosaics, or other media in which depicted drapery is modeled using two contrasting colors, rather than darker and lighter tones of the same color, to create an effect that simulates shot or cangiante textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cangiantismo"@en .

aat:300265786 a skos:Concept ;
    skos:definition "Cement and asbestos sheeting, used primarily in Australia to build cheap housing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fibro"@en .

aat:300265787 a skos:Concept ;
    skos:definition "People who keep, protect, or defend prisons and the inmates of prisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prison guards"@en .

aat:300265788 a skos:Concept ;
    skos:definition "Lead coins used in ceremonies surrounding the election of the \"boy-bishop\" during the feast of St. Nicholas in medieval Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boy-bishop tokens"@en .

aat:300265789 a skos:Concept ;
    skos:definition "Generally, anyone who sells fish. Historically, the Fishmongers' Company was one of the \"Great Twelve\" livery companies of the city of London."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishmongers"@en .

aat:300265790 a skos:Concept ;
    skos:definition "Phonograph records played at 78 revolutions-per-minute, the standard playing speed for records until the mid-20th century. The maximum length of play per side was 4 1/2 minutes, and they appeared most commonly in ten-inch and twelve-inch formats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "78 rpm records"@en .

aat:300265792 a skos:Concept ;
    skos:definition "Crosses, flowers, or other memorials, usually ephemeral, to victims of violent deaths; examples are roadside memorials to victims of fatal automobile accidents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "descansos"@en .

aat:300265793 a skos:Concept ;
    skos:definition "Refers to those engaged in carving and cutting gem stones, including creating cameos and intaglio carvings on the surface of gems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gem carvers"@en .

aat:300265794 a skos:Concept ;
    skos:definition "Documentary audio recordings, often for professional or research purposes, which are generally made outside a professional sound studio or venue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field recordings"@en .

aat:300265796 a skos:Concept ;
    skos:definition "Devices that reproduce sound by the means of a vibrating needle, or stylus, which follows the groove of a rotating phonograph recording."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonographs"@en .

aat:300265797 a skos:Concept ;
    skos:definition "Light emanating from a holy personage or visions of supernatural light in general. Usually associated with Christ or the Virgin, and specifically the Transfiguration and the Ascension. For motifs based on the concept of divine light, use \"glories.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divine light"@en .

aat:300265798 a skos:Concept ;
    skos:definition "Early instruments of the type invented by Thomas Alva Edison in 1877, that record and play back sounds using rotating grooved cylinders covered with tinfoil, later made of wax. Although Edison recognized that grooves could also be made on a rotating disc, he concentrated his efforts on cylinders, since the groove on the outside of a rotating cylinder provided a constant velocity to the stylus in the groove. In 1886 vertically modulated engraved recordings using wax coated cylinders were patented by Chichester Bell and Charles Sumner Tainter. Rotating discs were employed in \"gramophones,\" invented in the 1890s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder phonographs"@en .

aat:300265799 a skos:Concept ;
    skos:definition "Equipment used to play magnetic tapes, sometimes including recorders, but without speakers. Can also refer to components in audio or video systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape decks"@en .

aat:300265800 a skos:Concept ;
    skos:definition "Phonograph records, invented by the RCA company in the mid-20th century, which eventually replaced 78-rpm records in terms of production and popularity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "45 rpm records"@en .

aat:300265801 a skos:Concept ;
    skos:definition "Vessels used for one or more particular ritual activities, often for sacrificial offerings or consumption of food and wine as part of a ceremony. In some disciplines, this term is preferred over the slightly less descriptive \"ceremonial vessels,\" but in other disciplines the meanings overlap and the distinction is moot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ritual vessels"@en .

aat:300265802 a skos:Concept ;
    skos:definition "Phonograph records originally invented by Columbia Records, first introduced in 1948. The records have a rotational speed of 33 1/3 rpm (revolutions per minute), and have very fine grooves. They, along with 45 rpm records, replaced 78 rpm records in popularity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long-playing records"@en .

aat:300265803 a skos:Concept ;
    skos:definition "People who select and play pre-recorded music for an audience, or an event. Originally, the term specifically referred to radio or television announcers that played, selected, and announced phonograph records. From the late 20th century, the practice of DJing has expanded to include the live manipulation of recordings using a variety of techniques such as \"mixing\" and \"scratching\". DJing has also become an accepted art form as it pertains to sound manipulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disc jockeys"@en .

aat:300265806 a skos:Concept ;
    skos:definition "Disc jockeys, or DJs, that use phonograph turntables as an instrument to make music, as well as a component to create music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turntablists"@en .

aat:300265807 a skos:Concept ;
    skos:definition "Chinese Shang and Zhou-period cauldron-shaped vessels with three legs used to hold cooked food for sacrificial offerings to ancestors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ding"@en .

aat:300265808 a skos:Concept ;
    skos:definition "Videotape recorders that play and record on videocassettes. Prototypes of videocassette recorders were designed in the late 1960s, and by the 1970s, had become inexpensive enough for home use by consumers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videocassette recorders"@en .

aat:300265809 a skos:Concept ;
    skos:definition "Videotape recorders which may either be reel-to-reel recorders, or cassette recorders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videotape recorders"@en .

aat:300265810 a skos:Concept ;
    skos:definition "Book cloth grain pattern imitating the appearance of angular waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wave grain"@en .

aat:300265811 a skos:Concept ;
    skos:definition "Book cloth grain pattern imitating the appearance of a dotted line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dotted-line"@en .

aat:300265812 a skos:Concept ;
    skos:definition "Book cloth grain pattern imitating the appearance of a diagonal beaded line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagonal beaded-line"@en .

aat:300265813 a skos:Concept ;
    skos:definition "Book cloth grain pattern imitating the appearance of a diagonal beaded line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crackle grain"@en .

aat:300265814 a skos:Concept ;
    skos:definition "Long-stemmed lidded vessels of the Western Zhou. The shape first appeared in ceramic and lacquer, then in bronze. Often the bowl sections of these vessels continued to be made in lacquer or ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dou"@en .

aat:300265815 a skos:Concept ;
    skos:definition "Dedicated devices that play audio in digital formats. These usually consist of internal storage, either a hard drive or flash memory, designed to retrieve content using an interface for navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital audio players"@en .

aat:300265816 a skos:Concept ;
    skos:definition "Digital music players that play audio, especially music, that is compressed using the MP3 audio compression format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MP3 players"@en .

aat:300265817 a skos:Concept ;
    skos:definition "Projector which projects an image onto a vertical screen by passing light through a transparency that is positioned horizontally, then through lenses positioned above the transparency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overhead projectors"@en .

aat:300265818 a skos:Concept ;
    skos:definition "Device designed for playback of compact discs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compact disc players"@en .

aat:300265819 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels for wine with flared tops and a horn-like shape. One of the earliest forms of this type of vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gu"@en .

aat:300265820 a skos:Concept ;
    skos:definition "Equipment used for playback of digital versatile discs (DVDs). Generally, DVD players can also play CDs, although CD players cannot play DVDs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DVD players"@en .

aat:300265821 a skos:Concept ;
    skos:definition "Magnetic tapes on which sound is recorded digitally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital audio tapes"@en .

aat:300265822 a skos:Concept ;
    skos:definition "Tape decks which record sound onto magnetic tape using digital technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital audio tape recorders"@en .

aat:300265823 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels used for offerings of food, having a bulbous shape. Those from the Shang period have no handles while later versions from the Shang and Zhou have two ear-like handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gui"@en .

aat:300265824 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels used for holding wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "he"@en .

aat:300265825 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels used for wine drinking with three curved legs that support a cup, often with two capped vertical posts on the lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jia"@en .

aat:300265827 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels of the Eastern Zhou used for holding water. Has a low, rounded, cauldron shape and no legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jian"@en .

aat:300265828 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels used for drinking wine. These have two symmetrical and pointed spouts for pouring. This vessel type appeared during the Shang and lasted until the Western Zhou."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jiao"@en .

aat:300265829 a skos:Concept ;
    skos:definition "Equipment, usually a type of keyboard, used to generate typed characters and titles which are inserted or superimposed onto a video image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "character generators"@en .

aat:300265830 a skos:Concept ;
    skos:definition "Chinese ritual vessels, usually bronze, that are among the earliest forms of spouted wine cup, used from the Erlitou to the middle Western Zhou."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jues"@en .

aat:300265831 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessel type used for holding wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lei"@en .

aat:300265832 a skos:Concept ;
    skos:definition "Stylized floral motif based on the palmette (of ancient Egyptian, Greek, and Roman art), which was seen by 18th-century architects and craftsmen to resemble flowers of the European honeysuckle, species Lonicera periclymenum. The honeysuckle motif is seen most often in architecture and furniture decoration. It is symmetrical with three or more curved members radiating from each side of a long central petal; it differs from the palmette in generally having thinner members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honeysuckle"@en .

aat:300265833 a skos:Concept ;
    skos:definition "Movement centered around artist Otto Peine, as well as artists at the Center for Advanced Visual Studies at the Massachusetts Institute of Technology. Sky artists have utilized modern technologies such as laser projections and solar-tracked holograms, as well as simpler techniques such as kite-flying, to produce temporary artworks in sky space, both urban and rural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sky art"@en .

aat:300265834 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels used to hold water during ablutions. These are in the form of a shallow basin resting on a ring support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pan"@en .

aat:300265835 a skos:Concept ;
    skos:definition "Motif of an almond-shape with a circle in the middle, representing a human eye seen frontally. It was first used in Ancient Egypt; generally was a symbol of protection and power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye of Horus"@en .

aat:300265838 a skos:Concept ;
    skos:definition "A style of architecture that developed in Prague ca.1912-1928, as influenced by Cubism. The term itself has been in use since the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Czech Cubism"@en .

aat:300265839 a skos:Concept ;
    skos:definition "Motif of an eye in a triangle or pyramid that developed from the Egyptian eye of Horus in the 17th and 18th centuries in Europe and North America. It represents an all-seeing eye or the eye of God. The motif is often associated with Freemasonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye of Providence"@en .

aat:300265840 a skos:Concept ;
    skos:definition "Italian art movement founded in 1948 and inspired by the Concrete Art style from Switzerland. The movement, however, was not strictly defined and did not have a manifesto. The artists rejected social realism, as well as automatism and irrationalism. They also published a monthly and annual bulletins, which are known for their unique layout and typography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Movimento arte concreta"@en .

aat:300265841 a skos:Concept ;
    skos:definition "Italian architecture movement, active from 1930-1931, and a coalition of Rationalist architects. Internal dissent began over MIAR architects particpating in government projects, and the group dissolved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Movimento Italiano per l'Architettura Razionale"@en .

aat:300265842 a skos:Concept ;
    skos:definition "Jar-shaped Chinese ritual bronze vessels used to hold wine. Appeared between the Erligang and Anyang period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pou"@en .

aat:300265843 a skos:Concept ;
    skos:definition "Italian fine arts movement originating in 1922, which sought to begin a new, yet traditional, Italian art. The movement has frequently been equated with Fascist art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Novecento italiano"@en .

aat:300265844 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels of rectangular shape, with lids, used to store food. This shape appeared during the late Western Zhou period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xu"@en .

aat:300265845 a skos:Concept ;
    skos:definition "Chinese ritual bronze vessels formed as steamers with perforated plates between the lower lobed stand and upper basin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yan"@en .

aat:300265846 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels used to pour water during ablutions, and used with \"pan.\" Employed during the late Western Zhou period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yi"@en .

aat:300265847 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels with a basin shape, similar to gui, but without handles, common to the Erligang and Anyang period. The style ends in the Western Zhou."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yu"@en .

aat:300265848 a skos:Concept ;
    skos:definition "Chinese lidded ritual vessels with curved bodies and handles. Used from the latter part of the Shang to to the middle of the Western Zhou. Wine containers of various shapes, squat to long, may be called \"you\" if they lack other documented terminology and follow the general stereotype above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "you"@en .

aat:300265849 a skos:Concept ;
    skos:definition "The quality or character of a musical or vocal sound. It is the primary basis for the differences in musical instruments when they play the same musical note."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timbre"@en .

aat:300265850 a skos:Concept ;
    skos:definition "Chinese bronze ritual vessels of jar shape with a wide lip, supported by a tall ring, and used to hold wine. In the latter half of the Shang period, this shape was replaced with a taller profile based on the \"gu.\" The term \"zun\" is also sometimes used to describe an animal-shaped vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zun"@en .

aat:300265852 a skos:Concept ;
    skos:definition "Spike fiddles of the Near East, originating in Iran, with a spherical body, a circular belly of animal membrane or fish skin on which the bridge rests, and from one to four strings, traditionally of silk, though in modern times usually of metal. The instruments are held vertically and turned to present the strings to the bow during performance. Spike fiddle of Iran, Armenia, Azerbaijan, and Georgia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kamānches"@en .

aat:300265853 a skos:Concept ;
    skos:definition "Short-necked fiddles from Turkey, particularly the coastal regions around the Black Sea. It can be played sitting or standing, and has three strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kemençes"@en .

aat:300265854 a skos:Concept ;
    skos:definition "Long necked lutes of the Middle East and Central Asia, usually with 15 movable frets and 2 strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dutār"@en .

aat:300265855 a skos:Concept ;
    skos:definition "Handheld computers first developed in the late 1980s and early 1990s, that had a miniature keyboard and handwriting-recognition software. Originally meant to perform simple tasks such as calculation and organizing, they have since become more advanced. Most PDAs now have the ability to act as a mobile phone, surf the Internet, and run more advanced software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal digital assistants"@en .

aat:300265856 a skos:Concept ;
    skos:definition "The practice or policy of collectivizing, as in the working of farms, particularly in the former Soviet Union."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectivization"@en .

aat:300265857 a skos:Concept ;
    skos:definition "Christian sect originally founded by Charles Taze Russell in the late 19th century. Russell's successor, Joseph Franklin Rutherford, adopted the name Jehovah's Witness in 1931. The sect believes that Jehovah (Yahweh) is the true God, and that Jesus Christ is the son of God. The sect's goal is to establish what they consider to be God's Kingdom, which they believe will emerge following an apocalyptic Armageddon. Generally, Jehovah's Witnesses have no association with other denominations, and shun secular governments. They do not vote, celebrate religious or national holidays, and members refuse military service. Members engage in door-to-door proselytizing, selling their publications, \"The Watchtower\" and \"Awake!\", which is published in 80 languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jehovah's Witnesses"@en .

aat:300265858 a skos:Concept ;
    skos:definition "Fiddles of Bulgaria, usually with three strings. Generally, gadulkas are held in a vertical position, although in some areas they are played horizontally against the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gadulkas"@en .

aat:300265859 a skos:Concept ;
    skos:definition "Fiddles of Croatia, with three strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liricas"@en .

aat:300265860 a skos:Concept ;
    skos:definition "Long-necked lutes of Greece, generally with fixed metal frets, three or four double courses of metal strings, and played with a plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouzoukis"@en .

aat:300265861 a skos:Concept ;
    skos:definition "Short-necked bass lute, known to be played in Thrace, and by Greek refugees in Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outis"@en .

aat:300265862 a skos:Concept ;
    skos:definition "Primitive guitars of African peoples, particularly Hottentots and Bushmen. They usually are unfretted, have a belly made of skin, and three or four strings which are finger-plucked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramkies"@en .

aat:300265864 a skos:Concept ;
    skos:definition "Guitars, generally four-stringed, of Portugal. In size, they are between the ukelele and mandolin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavaquinhos"@en .

aat:300265865 a skos:Concept ;
    skos:definition "Psalteries from the Ukraine with flat, oval bodies, and thirty strings or more along the soundboard. Bandouras are sometimes played in large ensembles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandouras"@en .

aat:300265866 a skos:Concept ;
    skos:definition "A contraction of \"binary digit,\" bits are units of information that represent either a zero or one, on or off, and are the smallest elements a computer is able to process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bits"@en .

aat:300265867 a skos:Concept ;
    skos:definition "Chordophones of Spain, and hybrids of the guitar and cittern families. They are flat-bodied, and have four or five strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandurrias"@en .

aat:300265868 a skos:Concept ;
    skos:definition "Short necked lutes of China. Yüeh ch'in have a circular body, four strings, a flat back, and metal tongues inside their bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yüeh ch'in"@en .

aat:300265869 a skos:Concept ;
    skos:definition "Unit of storage measurement, specifically a collection of 8 bits, in digital technology, or computers. It represents a value, or code, for an individual character or typographic symbol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bytes"@en .

aat:300265870 a skos:Concept ;
    skos:definition "A unit of measure for information or computer storage representing 1024 or 1000 bytes. The most commonly referred to unit of computer file size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kilobytes"@en .

aat:300265871 a skos:Concept ;
    skos:definition "Fiddles of Mongolia, generally square-bodied, with two strings and a carved horse's head at the top of their necks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morin khuur"@en .

aat:300265872 a skos:Concept ;
    skos:definition "Banjos strung like ukeleles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banjo ukeleles"@en .

aat:300265873 a skos:Concept ;
    skos:definition "Unit of measurement for computer file storage. Equal to 1,048,576 bytes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megabytes"@en .

aat:300265874 a skos:Concept ;
    skos:definition "A unit of information or computer file storage equal to one billion bytes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gigabytes"@en .

aat:300265875 a skos:Concept ;
    skos:definition "Box lyres of Swedish origin, used primarily in Swedish enclaves of Estonia, until the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tallharpas"@en .

aat:300265876 a skos:Concept ;
    skos:definition "Large, sitar-like plucked lutes from North India. Effectively, bass sitars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surbahars"@en .

aat:300265877 a skos:Concept ;
    skos:definition "Hybrid of the violin and viol, popularly used in the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quintons"@en .

aat:300265878 a skos:Concept ;
    skos:definition "Tabor flutes of the Basque region. Txistus have two finger holes and one rear thumb hole. They are played with the left hand, while the right hand plays a drum that hangs from the left forearm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "txistus"@en .

aat:300265879 a skos:Concept ;
    skos:definition "Duct flutes of Slovakia. They are large, wooden flutes, held vertically, and have a large stopped tube attached to a smaller tube which contains the mouthpiece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fujaras"@en .

aat:300265880 a skos:Concept ;
    skos:definition "Transverse flutes of the Venda peoples of South Africa. They are made of river cane, have two to four fingerholes, and are played by boys who herd cattle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tshitiringos"@en .

aat:300265881 a skos:Concept ;
    skos:definition "Transverse flutes of the Pedi peoples of Southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naka ya lethlake"@en .

aat:300265882 a skos:Concept ;
    skos:definition "Transverse flutes of Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuye"@en .

aat:300265883 a skos:Concept ;
    skos:definition "Vertical flutes of the Katanga people of Zimbabwe. They are made with stopped canes, which are fit into a hollow nsala fruit shell. The cane has two finger holes, and the flute is played by blowing across a hole in the shell. Different from \"khumbgwes,\" which has three finger holes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ombgwes"@en .

aat:300265884 a skos:Concept ;
    skos:definition "Vertical flutes of Southern Africa, with three finger holes. They are similar to the ombgwes of the Katanga people of Zimbabwe, in that they are made with stopped canes, which are fit into a hollow nsala fruit shell. The flute is played by blowing across a hole in the shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khumbgwes"@en .

aat:300265885 a skos:Concept ;
    skos:definition "Multiple flutes of Tibet. Gling-bus are end blown, and usually triple flutes, with identically placed finger holes on each pipe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gling-bus"@en .

aat:300265886 a skos:Concept ;
    skos:definition "Multiple flutes of Slovakia, consisting of two separate flutes tied together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dvojankas"@en .

aat:300265887 a skos:Concept ;
    skos:definition "Treble shawm of Spain, played usually in Catalonian ensembles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiples"@en .

aat:300265888 a skos:Concept ;
    skos:definition "Shawms of the Abruzzi region of Italy, generally used to accompany bagpipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piffaros"@en .

aat:300265889 a skos:Concept ;
    skos:definition "Shawms of Yugoslakvia, with a conical shape and six fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sopilas"@en .

aat:300265890 a skos:Concept ;
    skos:definition "Shawms of Macedonia and South Serbia. They generally have seven finger holes, with a cylindrical upper bore, and a conical lower portion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zurlas"@en .

aat:300265891 a skos:Concept ;
    skos:definition "Gong chimes of Vietnam. They consist of three gongs, suspended in metal circles, which are attached to a wooden frame. Since the 18th century, they have been used in Vietnamese court music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tam âm la"@en .

aat:300265893 a skos:Concept ;
    skos:definition "Mouth organs which have a rectangular body that terminates in a plastic mouthpiece. They are played via a keyboard corresponding to 12 notes, and usually have two or three octaves. There are various sizes, classed by range, including soprano, alto, tenor, and bass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melodicas"@en .

aat:300265894 a skos:Concept ;
    skos:definition "Clappers of Bali and Java. They consist of two metal objects shaped like bananas on stalks, and with concave surfaces, which are then clapped together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kemanaks"@en .

aat:300265895 a skos:Concept ;
    skos:definition "Clappers of the Thonga peoples of South Africa. They consist of rectangular pieces of wood which are worn like gloves to increase the sound of clapping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spaganes"@en .

aat:300265896 a skos:Concept ;
    skos:definition "Clappers of China, made of six pieces of wood and tied at one end with cord."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "p'ai pan"@en .

aat:300265897 a skos:Concept ;
    skos:definition "Clappers of Naples, Italy, which consist of three mallets inserted into a wooden frame. The center mallet is fixed so the others can strike it on either side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triccaballacca"@en .

aat:300265898 a skos:Concept ;
    skos:definition "Resting bells of Afro-Cuban origin. They are struck, and clapperless. In some locations, they are multiple bells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agogos"@en .

aat:300265899 a skos:Concept ;
    skos:definition "Tubular drums of South Africa, made from hollow logs and two skins which are laced together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isigubus"@en .

aat:300265900 a skos:Concept ;
    skos:definition "Tubular drums of Japan, generally used in kabuki theater productions. The drums have two laced heads, and are played with sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "okedōs"@en .

aat:300265901 a skos:Concept ;
    skos:definition "Double-headed drums of Cuba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batás"@en .

aat:300265902 a skos:Concept ;
    skos:definition "Distinctive type of Japanese drums set on the stand horizontally and played by tapping the right drumhead with a narrow stick held in each hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daibyoshi"@en .

aat:300265904 a skos:Concept ;
    skos:definition "Double-headed drums of Uganda. They are found in different sizes, and although they are double-headed, only one side is played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ntengas"@en .

aat:300265905 a skos:Concept ;
    skos:definition "Double-headed drums of India, usually played in a horizontal position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhols"@en .

aat:300265906 a skos:Concept ;
    skos:definition "Double-headed Japanese drums with deerskin heads, used in Japanese court music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kakkos"@en .

aat:300265907 a skos:Concept ;
    skos:definition "Double-headed Japanese drums, resembling large taikos. Often played on a stand, although they may be played horizontally as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odaiko"@en .

aat:300265908 a skos:Concept ;
    skos:definition "Double-headed drums of Korea that have lacquered bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "changgos"@en .

aat:300265910 a skos:Concept ;
    skos:definition "Single-headed drums of South Africa. They are made with two handles and an open bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moropas"@en .

aat:300265911 a skos:Concept ;
    skos:definition "Friction drums of the Zulu people in South Africa. They consist of spherical clay pots covered in goat skin, and they are played with a friction stick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ingungus"@en .

aat:300265912 a skos:Concept ;
    skos:definition "Friction drums of the Pedi people of South Africa, usually played by women. They are built with staves, are shaped like a bowl, and have goatskin membranes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moshupianes"@en .

aat:300265913 a skos:Concept ;
    skos:definition "Frame drums of Indonesia, made of heavy wood, they have an open bottom and goatskin membrane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terbangs"@en .

aat:300265914 a skos:Concept ;
    skos:definition "Small kettledrums of Bosnia and Herzegovina, often played in pairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talambas"@en .

aat:300265915 a skos:Concept ;
    skos:definition "Kettledrums used as the left hand drums of the tabla, in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bayas"@en .

aat:300265916 a skos:Concept ;
    skos:definition "Cylindrical, double-reed instruments of Armenia and Turkey. They usually have eight finger holes and one thumb hole. They have a warm timbre and are used for lyrical tunes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duduks"@en .

aat:300265917 a skos:Concept ;
    skos:definition "Zitherlike chordophones of the Konjo people of Uganda. They are stick zithers which have three strings and three frets carved out of their bars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enzenzes"@en .

aat:300265918 a skos:Concept ;
    skos:definition "Long zithers of Java, with movable bridges and tuning pegs located inside the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kachapis"@en .

aat:300265919 a skos:Concept ;
    skos:definition "Long zithers of Korea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kŏmun'gos"@en .

aat:300265920 a skos:Concept ;
    skos:definition "Long zithers of Thailand, shaped like crocodiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "čhakhēs"@en .

aat:300265921 a skos:Concept ;
    skos:definition "Phylum of aquatic invertebrates typically having a simple tube-shaped or cup-shaped body, which includes sea anemones, hydras, jellyfish, and corals. There are over 9000 species living today. More or less radially symmetrical marine invertebrates having a single internal cavity serving for digestion, excretion, and other functions, and usually a circle of tentacles around the mouth for catching prey, some provided with paralyzing stings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cnidaria"@en .

aat:300265922 a skos:Concept ;
    skos:definition "Zitherlike chordophones of Norway. They are fretted, and rectangular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "langeleiks"@en .

aat:300265923 a skos:Concept ;
    skos:definition "Zitherlike chordophones of the low countries and Scandinavia. Their frets are under the strings, which are plucked with a plectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hummels"@en .

aat:300265924 a skos:Concept ;
    skos:definition "Bowed, zitherlike chordophones of Iceland with trapezoidal bodies, and two or four horsehair strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fidlas"@en .

aat:300265925 a skos:Concept ;
    skos:definition "Bowed, zitherlike chordophones of Iceland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "langspils"@en .

aat:300265926 a skos:Concept ;
    skos:definition "Cymbals of India, often made of brass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jalra"@en .

aat:300265927 a skos:Concept ;
    skos:definition "Zitherlike chordophones of Korea, similar to a dulcimer. They are in a trapezoidal shape, and usually have fourteen strings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yanggŭms"@en .

aat:300265928 a skos:Concept ;
    skos:definition "Fiddles of North India and Pakistan, similar to the esraj."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dilrubās"@en .

aat:300265929 a skos:Concept ;
    skos:definition "Long necked, plucked chordophones of India. They generally have a single string, which passes through a gourd used as a resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ektārs"@en .

aat:300265930 a skos:Concept ;
    skos:definition "Plucked, long necked chordophones of Bengal and other Indian states. They are fretless, made of wood, and generally four-stringed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dotārās"@en .

aat:300265931 a skos:Concept ;
    skos:definition "Double reed shawms of Tibet used in Buddhist rituals. They have a conical bore, seven fingerholes, and a mouthpiece with pirouette."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rgya-glings"@en .

aat:300265932 a skos:Concept ;
    skos:definition "Trumpets of Tibet, historically made from a human tibia, though the term now refers to bone trumpets covered in metal, as well as small metal trumpets in general. They are usually played in pairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rkang-glings"@en .

aat:300265933 a skos:Concept ;
    skos:definition "Xylophones of Burma. They usually consist of 17-23 slats which are tuned by wax that has been applied underneath each slat, and they sit above a trough which acts as a resonator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pat-talàs"@en .

aat:300265934 a skos:Concept ;
    skos:definition "Double reed pipes of Burma, with seven fingerholes and a rear thumbhole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hnès"@en .

aat:300265935 a skos:Concept ;
    skos:definition "Reedpipes of Thailand with cylindrical bore. They generally have six front fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pi nais"@en .

aat:300265936 a skos:Concept ;
    skos:definition "Grouping of mammals including all placental and marsupial mammals, characterized by having mammary glands with nipples, functional teeth, oviducts that are partly fused, may have a cloaca, and having a uterus and vagina, giving birth to live young (viviparous)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theria"@en .

aat:300265941 a skos:Concept ;
    skos:definition "Large and fretless acoustic bass guitars with six strings, predominant in mariachi music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guitarróns"@en .

aat:300265945 a skos:Concept ;
    skos:definition "Flutes of modern Egypt and Morocco. They generally have six fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ʻanfītas"@en .

aat:300265946 a skos:Concept ;
    skos:definition "Duct flutes of Burma, made of bamboo and with seven fingerholes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palweis"@en .

aat:300265947 a skos:Concept ;
    skos:definition "Very young dogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puppies"@en .

aat:300265950 a skos:Concept ;
    skos:definition "Breed of dog that is of hound, spaniel, and setter ancestry. The pointer is used as an aid in hunting and derives its name from its assumption of a rigid posture in the direction of prey it has located. First recorded about 1650, in England, the pointer was originally used to point out hares for greyhounds to track down and was later trained as a bird dog in the 18th century. Pointers stand 23 to 28 inches (58 to 71 cm) and weigh 44 to 75 pounds (20 to 34 kg). It has a long muzzle, hanging ears, a tapered tail, and a short, smooth coat, usually white with black, liver-colored, yellowish brown, or reddish brown spots. In art, the pointer is often featured in sporting and hunting scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointers"@en .

aat:300265951 a skos:Concept ;
    skos:definition "The young of a cat and various other animals, including beaver, mouse, rabbit, and squirrel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kittens"@en .

aat:300265952 a skos:Concept ;
    skos:definition "Breed of domestic cat that originated in Thailand. It is characterized by a long body and tail, wedge-shaped head and slightly slanted blue eyes. Siamese are typically white or buff colored on the body with darker \"points\" on the tail, head, and feet, which may be dark brown (seal point), blue gray (blue point), milk-chocolate brown (chocolate point), pinkish gray (lilac point), or reddish orange (red point). The color and coat pattern are genetically recessive characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siamese cats"@en .

aat:300265953 a skos:Concept ;
    skos:definition "Subclass of cartilaginous fishes that includes great white sharks and the extinct megalodon, distinguished from the other subclass, Holocephali, by having no swim bladders, five to seven pairs of gill clefts opening individually to the exterior, rigid dorsal fins, and small placid scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elasmobranchii"@en .

aat:300265954 a skos:Concept ;
    skos:definition "Class of acquatic animals (fish) characterized by possessing a skeleton at least partly composed of true bone (as opposed to cartilage) and typically a swim bladder (an air-filled sac to give buoyancy), a single pair of gills, gill covers over the gill chamber, bony platelike scales, a skull with sutures, and external fertilization of eggs. Modern bony fishes represent over 20,000 species in more than 400 families. In some classifications it is listed as a superclass instead of a class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Osteichthyes"@en .

aat:300265956 a skos:Concept ;
    skos:definition "Class of air-breathing vertebrate animals characterized by being tetrapods (although some, such as snakes, have evolved modified skeletons), cold-blooded, having an ossified skeleton, usually having scales or horny plates covering their body, and laying eggs with embryos surrounded by an amniotic membrane. Living reptiles include over 8,700 species of turtles, tuataras, lizards and snakes, and crocodiles. Birds (class Aves) share a common ancestor with crocodiles, thus some classifications would group them as technically one lineage with reptiles; more commonly, but they are treated separately. Excluding birds, there are over 8,700 species of living reptiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reptilia"@en .

aat:300265958 a skos:Concept ;
    skos:definition "Family of odd-number-hooved animals that includes asses, horses, and zebras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equidae"@en .

aat:300265959 a skos:Concept ;
    skos:definition "Domesticated descendant of the wild ass. Donkeys resemble horses and are characterized by their large head, long ears, and cow-like tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "donkeys"@en .

aat:300265960 a skos:Concept ;
    skos:definition "Domesticated member of the genus Felis. Domesticated in Egypt ca. 2,000 BCE, in Cyprus by 9,500 years ago, earlier elsewhere in the Middle East. In some taxonomies, Felis catus and Felis sylvestris are the same species. Ancient Egyptian affection and respect for the cat as predator led to the development of religious cat cults and temple worship of cats. Since tabby-like markings appear in the drawings and mummies of ancient Egyptian cats, present-day tabbies probably look much like the sacred cats of Egypt. Other variations of coat and body form have appeared over the centuries of domestication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis catus"@en .

aat:300265961 a skos:Concept ;
    skos:definition "Asiatic wild ass. Among other characteristics, it may be distinguished by the color, which is lighter than the African ass, ranging from reddish to yellow-gray. The term \"kulan\" is sometimes used to refer to this species, although it is often reserved for the race, Equus hemionus hemionus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus hemionus"@en .

aat:300265962 a skos:Concept ;
    skos:definition "Wild ass of Mongolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus hemionus hemionus"@en .

aat:300265963 a skos:Concept ;
    skos:definition "Syrian wild ass probably became extinct ca. 1927."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus hemionus hemippus"@en .

aat:300265964 a skos:Concept ;
    skos:definition "General term referring to two or more species belonging to the horse family, usually distinguished from the horse by its smaller size, long ears, tuft at end of tail, and black stripe across the shoulders, but differing from zebras, which have stripes all over their bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asses"@en .

aat:300265965 a skos:Concept ;
    skos:definition "Ass found in Tibet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus hemionus kiang"@en .

aat:300265967 a skos:Concept ;
    skos:definition "Ass found in India and Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus hemionus khur"@en .

aat:300265968 a skos:Concept ;
    skos:definition "Wild horse distinguished by a stocky build, yellowish or dun (light red) coat, a short erect dark mane with no forelock, dark tail, and usually a dorsal stripe. The low withers blend into a narrow back, and the croup is short and steep. It is the last surviving wild horse (not to be confused with feral horses)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus caballus przewalskii"@en .

aat:300265973 a skos:Concept ;
    skos:definition "Genus of small dog-sized animals representing the oldest known horse; they lived in the Eocene Epoch. Characterized by a relatively short face, eye sockets nearer the middle than modern horses, and a short space between the front teeth and the cheek teeth (diastema)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hyracotherium"@en .

aat:300265974 a skos:Concept ;
    skos:definition "Extinct genus of small horses known from North American Oligocene fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miohippus"@en .

aat:300265975 a skos:Concept ;
    skos:definition "Extinct genus of horses. Fossils of Merychippus are found at many late Miocene localities throughout the United States, dating from from 17-11 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Merychippus"@en .

aat:300265976 a skos:Concept ;
    skos:definition "Genus of stocky, stilt-legged, Clydesdale-sized horse that lived in South America during the Ice Age Pleistocene epoch, between 2 million and 10,000 years ago. Hippidion possessed a highly distinctive, long, domed nasal bone. In an alternate classification, the stilt-legged build is seen as similar to the onager and kiang wild asses of Asia, thus suggesting they migrated from Asia across the Bering Strait."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippidion"@en .

aat:300265977 a skos:Concept ;
    skos:definition "Genus including horses and similar animals. It evolved from small animals with multi-toed padded hooves. Equus is the only surviving genus in the once diverse family of horses. It was domesticated about 3,000 years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus"@en .

aat:300265978 a skos:Concept ;
    skos:definition "Hybrid offspring between a female ass and a male horse; mules, the offspring of a male ass and a female horse, are larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hinnies"@en .

aat:300265979 a skos:Concept ;
    skos:definition "Male ass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackasses"@en .

aat:300265980 a skos:Concept ;
    skos:definition "Female asses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "she-asses"@en .

aat:300265981 a skos:Concept ;
    skos:definition "Mature male equines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stallions"@en .

aat:300265982 a skos:Concept ;
    skos:definition "Mature female equines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mares"@en .

aat:300265983 a skos:Concept ;
    skos:definition "Very young equines, particularly those of the male sex, a colt. Also used when the sex is not specified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foals"@en .

aat:300265984 a skos:Concept ;
    skos:definition "Stallions used for breeding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studs"@en .

aat:300265985 a skos:Concept ;
    skos:definition "Castrated stallions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geldings"@en .

aat:300265986 a skos:Concept ;
    skos:definition "Very young male equines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colts"@en .

aat:300265987 a skos:Concept ;
    skos:definition "Very young female equines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillies"@en .

aat:300265988 a skos:Concept ;
    skos:definition "Breed of horse characterized by being tall, slim, most notably used for racing and jumping. It was developed in England; the origin may be traced back to records indicating that a stock of Arab and Barb horses was introduced into England as early as the 3rd century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thoroughbreds"@en .

aat:300265989 a skos:Concept ;
    skos:definition "Breed of horse characterized by a distinctive head shape, high tail carriage, fine bone structure, concave profile, arched neck, a comparatively level croup, and known for speed, stamina, beauty, intelligence, and gentleness. It is believed to be one of the oldest horse breeds, with archaeological evidence dating to 4,500 years before present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabian horses"@en .

aat:300265990 a skos:Concept ;
    skos:definition "Breed of heavy draft horse characterized by a thick muscular neck, small head, powerful shoulders and quarters, short legs, and having a sorrel (chestnut) coloring with a lighter mane. It is an old breed descended from the Flemish 'great horse,' the medieval battle horse native to the Low Countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgian horses"@en .

aat:300265991 a skos:Concept ;
    skos:definition "Heavy draft-horse breed that is agile, powerful, mostly grey or black with a fine coat, clean-limbed, and docile. It originated in the Perche region of France. The breed probably stems from the Flemish 'great horse' of the Middle Ages; modified by Oriental blood to develop a coach-horse type, it was changed again in the 19th century by introduction of draft-type blood to produce animals for heavy farm work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Percherons"@en .

aat:300265992 a skos:Concept ;
    skos:definition "General term referring to any of four living species of equines having black-and-white-stripes over all or most of their bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zebras"@en .

aat:300265993 a skos:Concept ;
    skos:definition "Herd animal that formerly occurred in vast herds in the Karoo regions of Cape Province and the southern part of Orange Free State. It is recently extinct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus quagga"@en .

aat:300265994 a skos:Concept ;
    skos:definition "Species of striped equine (zebra) native to arid, sparsely wooded areas in parts of Kenya, Ethiopia, and Somalia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus grevyi"@en .

aat:300265995 a skos:Concept ;
    skos:definition "Large land mammal of the genus Equus, noted for characteristic dark stripes on an ivory background, with leg stripes that are absent or very pale. Formerly found in rich grasslands over much of eastern and southern Africa, they were thought to have gone extinct, but small populations have been discovered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus burchellii"@en .

aat:300265996 a skos:Concept ;
    skos:definition "Striped equine found in dry upland plains in Namibia and a few scattered areas in western South Africa. Although it has been proposed that the Cape mountain zebra (Equus zebra) and the Hartmann's mountain zebra (Equus hartmannae) are two distinct species, recent genetic evidence indicates that they are a single species, in spite of their now inhabiting non-overlapping territories and typically differing in the width of the black stripes and variations in sexual dimorphism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus zebra"@en .

aat:300265998 a skos:Concept ;
    skos:definition "Ass found in Iran and Turkmenistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Equus hemionus onager"@en .

aat:300266001 a skos:Concept ;
    skos:definition "Horses suitable for riding or light work, and of a size and build between a heavy horse and pony. Light horses are often classified according to their training, including riding horses, racers, trotters, and cow horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light horses"@en .

aat:300266002 a skos:Concept ;
    skos:definition "Horses originally used for heavy loads and farm labor, descended from the ancient war horses of the Middle Ages. They are characterized by being large, strong, and having great endurance and a good disposition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draft horses"@en .

aat:300266003 a skos:Concept ;
    skos:definition "Lightweight horses kept primarily for riding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding horses"@en .

aat:300266004 a skos:Concept ;
    skos:definition "Powerful horses originally bred for war, heavy loads, and farm labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heavy horses"@en .

aat:300266005 a skos:Concept ;
    skos:definition "Powerful horses used to carry men, usually in armor, in war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "war horses"@en .

aat:300266006 a skos:Concept ;
    skos:definition "Horses especially bred and trained to the trot, particularly in harness racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trotters"@en .

aat:300266007 a skos:Concept ;
    skos:definition "Horses bred or kept for racing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racehorses"@en .

aat:300266008 a skos:Concept ;
    skos:definition "A short, squat drinking glasses without a stem used for serving whiskey. Their volume capacity is around 10 ounces, but they are traditionally filled with only about 2 ounces of whiskey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiskey glasses"@en .

aat:300266009 a skos:Concept ;
    skos:definition "Assessments of the overall physical condition, characteristics, and completeness of a thing. Examples include reports on works of art or architecture, the state of conservation of the natural environment, and the state of roadways and waterways under various weather conditions. For assessments of groups or collections of things, use \"condition surveys.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condition reports"@en .

aat:300266010 a skos:Concept ;
    skos:definition "Concepts related to telecommunications systems that allow computers to exchange data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer networking concepts"@en .

aat:300266011 a skos:Concept ;
    skos:definition "Standardized means of organizing and storing files created using a binary numerical system electronically stored in the form of encoded image elements, or pixels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital file formats"@en .

aat:300266013 a skos:Concept ;
    skos:definition "Seven-bit code used in computing to store and transmit standard English language characters, punctuation, and numerals. It was developed by the American National Standards Institute and is used in most personal computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ASCII"@en .

aat:300266014 a skos:Concept ;
    skos:definition "Refers to the width of a communications channel in telecommunications or information exchange. Bandwidth effects the speed of data transmission by allowing more or less information flow through a single channel at any one time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandwidth"@en .

aat:300266015 a skos:Concept ;
    skos:definition "A telecommunications channel that allows fast transmission of large data files. Most often used to describe lines that connect personal computers to the World Wide Web. The term does not define a specific bandwidth, but typically refers to anything that is capable of transmitting over 45 million bits of information per second."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadband"@en .

aat:300266016 a skos:Concept ;
    skos:definition "Locations on the Internet or any network that may contain sub-domains, and that are defined by a unique address. A domain is maintained by an individual or organization. A \"domain name\" is the part of the domain address that identifies any part of it as belonging to the domain. A \"domain name server,\" or DNS, is the computer that contains the programs and files that populate the domain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domains"@en .

aat:300266017 a skos:Concept ;
    skos:definition "Refers to frames manufactured to hold photographs of standard sizes (in the United States, 8 x 10 inches, 5 x 7 inches, 4 x 6 inches, etc.). They are typically equipped with glass (glazing) to protect the photograph and a flap attached to the back that may be extended to allow the frame to stand upright on a table, shelf, or other surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photo frames"@en .

aat:300266018 a skos:Concept ;
    skos:definition "A type of local area network based on the principle of collision detection. It is used for connecting computers and their peripheral printers, servers, workstations within the same physical location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ethernet"@en .

aat:300266019 a skos:Concept ;
    skos:definition "A list of questions and answers posted on a web site or included with computer software for users to consult. Originally used by newsgroups to prevent repetitive postings of information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "FAQs"@en .

aat:300266020 a skos:Concept ;
    skos:definition "An abbreviation of \"file transfer protocol:\" a standard for the transfer of electronic files between two computers, especially via the Internet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "FTP"@en .

aat:300266021 a skos:Concept ;
    skos:definition "The language used to structure information, specifically in the creation of World Wide Web pages. It uses a system of \"tags\" to tell a Web browser how to combine and lay out text and images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "HTML"@en .

aat:300266022 a skos:Concept ;
    skos:definition "An open file format standard for electronic document exchange via the Internet. Developed by Adobe Systems to encode the visual representation of a document independent of the type of software used to write or read it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "PDF"@en .

aat:300266023 a skos:Concept ;
    skos:definition "Coined by Ted Nelson in 1965. Generally, hypertext is any collection of written or pictorial matter that may be experienced non-sequentially, specifically used now in relation to the World Wide Web."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypertext"@en .

aat:300266024 a skos:Concept ;
    skos:definition "In hypertext, embedded instructions or codes that connect units of data. Links may take the form of highlighted text, images, or other indicators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "links"@en .

aat:300266025 a skos:Concept ;
    skos:definition "In computing, a localized network consisting of hardware and software links between computers, servers, printers, and other peripheral devices. Usually confined to an office or small physically defined area such as a college campus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "LANs"@en .

aat:300266026 a skos:Concept ;
    skos:definition "Refers to collage artists who use torn posters to create their works. Usually the term is reserved for artists associated with the Nouveau Réalistes, who began creating similar works in the 1950s and early 1960s: François Dufrène, Jacques de la Villeglé, Raymond Hains, and Mimmo Rotella, though it is often used for others whose work involves torn and collaged commercial posters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "affichistes"@en .

aat:300266027 a skos:Concept ;
    skos:definition "A software program that searches the contents of a database based on keywords entered by the user. More specifically, a program that returns a list of URLs from the World Wide Web based on keywords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "search engines"@en .

aat:300266028 a skos:Concept ;
    skos:definition "Generally, any prefabricated ornamental border that serves to frame an image. Specifically, a mat of paper, cardboard, or other material with an opening cut out of the center that readily accepts printed matter for display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passe-partouts"@en .

aat:300266029 a skos:Concept ;
    skos:definition "Dolls that are typically used for play by boys rather than girls, or as collectibles for adult males, characterized by being representations of comic book characters, military people, sports figures, movie or television characters, or other characters who take part in heroic or adventurous activities. The figures are usually male, although they may occasionally be female. They often have unnatural, overdeveloped musculature; they may have movable joints that allow the characters to hold various weapons or strike various poses. The term was coined by Hasbro corporation in 1964 to market a \"G.I. Joe\" military-themed doll to boys. The legal case \"Toy Biz v. United States\" determined that for purposes of tariffs, action figures produced by Toy Biz/Marvel Comics were toys, not dolls, because they represent \"nonhuman creatures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "action figures"@en .

aat:300266030 a skos:Concept ;
    skos:definition "Devotional images that are two dimensional or low-relief pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional pictures"@en .

aat:300266031 a skos:Concept ;
    skos:definition "Refers to Latin American ex-votos, usually cast of silver and valued as a distinctive form of folk art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milagros"@en .

aat:300266032 a skos:Concept ;
    skos:definition "Images of a deity used as a focus for worship; the term is usually used specifically to distinguish a non-Christian item from Christian images. For a Christian image that is itself considered sacred, use \"icon.\" For an ancient Greek or Roman sacred image, use \"cult image.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idols"@en .

aat:300266033 a skos:Concept ;
    skos:definition "Items that are considerably smaller than the standard or usual size, especially objects that are accurate scale models of the original and intended as toys or collectibles. Miniatures are often manufactured at standard scales, for example, doll house furniture is often 1:12 scale and model trains may be 1:87 (HO) and 1:48 (O guage) scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniatures"@en .

aat:300266034 a skos:Concept ;
    skos:definition "Representations or copies of an object that are larger or smaller than the actual size of the object being represented, and manufactured precisely according to relative size. Typically, the scale model is smaller than the original and used for illustrating the object, for a toy or collectible, or as a guide to constructing it in full size. Scale models may be one- or two-dimensional. Scale models are generally built according to a standard scale for the particular product; for example, model trains may be HO scale (1:87 scale), model ships may be 1:500 scale, and dollhouse furniture may be 1:12 scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scale models"@en .

aat:300266035 a skos:Concept ;
    skos:definition "Describes attributes that are measurable by spatial or temporal extent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "size/dimensions"@en .

aat:300266036 a skos:Concept ;
    skos:definition "Measurable or spatial extent of any kind, such as length, breadth, thickness, area, volume, measure, magnitude, or size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimensions"@en .

aat:300266037 a skos:Concept ;
    skos:definition "Dimensions or size ascertained by measuring; a magnitude, quantity, or extent calculated by the application of an instrument or device marked in standard units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "measurements"@en .

aat:300266038 a skos:Concept ;
    skos:definition "The configuration of a work, objects, books, or data, including technical formats, or the conventional designation for the dimensions or proportion of a work. For bibliographic works, the shape, size and general makeup of a book, periodical or other publication. In the context of computer science, the physical layout of a data storage device or the logical structure or composition of a file. Designations of format may overlap with designations of standard size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "format"@en .

aat:300266039 a skos:Concept ;
    skos:definition "A theater production system based on a permanent association of actors, and often a particular location or theater structure. Professional theater companies evolved during the Renaissance in response to urbanization in the major countries of Europe. Modern theater companies follow the same model as the earliest ones: a group of actors, scenarists, and technicians devoted to presenting theatrical performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theater companies"@en .

aat:300266040 a skos:Concept ;
    skos:definition "An outbuilding containing an oven used for baking bread. May be combined with a brewery or other functional structures. May be found associated with farmhouses, hospitals, monasteries, or other major structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bakehouses"@en .

aat:300266041 a skos:Concept ;
    skos:definition "Art that is created by a step-by-step procedure, often expressed and realized through computer code."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "algorithmic art"@en .

aat:300266042 a skos:Concept ;
    skos:definition "Electronic art that incorporates process in the creation of the work. The work itself is usually experienced through time and space, and may include sound, motion, animated graphics, sculptural elements, or any combination of these. Generative art has a performative aspect. For visual art that incorporates algorithms to produce static visual works, use \"algorithmic art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "generative art"@en .

aat:300266043 a skos:Concept ;
    skos:definition "Computers and/or programs that manage access to shared files on a network."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servers"@en .

aat:300266044 a skos:Concept ;
    skos:definition "Structure design that is specifically environmentally conscious, taking into account construction methods and materials that are locally available as well as the building's efficient use of resources, including systems of heating, cooling, power, water, and waste. Provides affordable, adequate shelter with minimal negative effect on the local and global environment; may be replicated and locally maintained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sustainable architecture"@en .

aat:300266045 a skos:Concept ;
    skos:definition "Avant-garde dances having a style that originated in Japan. The first Butoh performance was given by Tatsumi Hijikata in 1959. As practiced by various groups and individuals, Butoh may incorporate elements of dance, theater, and performance art. Butoh performances typically incorporate grotesque imagery and physical endurance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Butoh"@en .

aat:300266046 a skos:Concept ;
    skos:definition "Dutch-style gardens, distinctive geometric and symmetrical designs, especially prominent in the seventeenth and eighteenth centuries; found also in countries other than the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch gardens"@en .

aat:300266047 a skos:Concept ;
    skos:definition "Magazines or books printed on cheap, low-quality paper made of wood pulp, which usually contain sensational material, such as lurid stories and articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulps"@en .

aat:300266048 a skos:Concept ;
    skos:definition "Fiction, printed on poor-quality, cheap paper made of wood pulp, usually dealing with lurid or sensational subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pulp fiction"@en .

aat:300266049 a skos:Concept ;
    skos:definition "Dating technique which determines the age of minerals by measuring, using either heat (thermoluminescence dating), or light (optically stimulated luminescence dating), to determine the release of stored energy in the form of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luminescence dating"@en .

aat:300266050 a skos:Concept ;
    skos:definition "Luminescence dating technique which, by using a lamp or laser, measures the stored energy in the form of light which is trapped in minerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optically stimulated luminescence dating"@en .

aat:300266051 a skos:Concept ;
    skos:definition "Persons who live at, occupy, or have possession of a building, a unit within a building, a plot of land, or any other property for a significant period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupants"@en .

aat:300266052 a skos:Concept ;
    skos:definition "Musical works created by recording natural sounds and subsequently altering and rearranging them into a composition. The word \"concrète\" refers to the method of working directly with sound rather than a system of abstract musical notation. Originally recorded onto discs, these works were later realized with magnetic tape as the technology became available. Developed by the French composer Pierre Schaeffer and colleagues, including Pierre Henry, in the Club d'Essai and Groupe de Recherches Musicales at the Office de Radio-diffusion et Télévision Française ca. 1948. The term \"musique concrète\" is reserved for works created solely with naturally occurring sounds recorded onto disc or magnetic tape. For works created from sounds generated primarily by electronic synthesis, or using combinations of natural and synthesized sound, use \"electronic music.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musique concrète"@en .

aat:300266053 a skos:Concept ;
    skos:definition "Flesh-colored, carnation, pale red or pink, but also used for various shades of crimson or blood-red. That is, the color of either a European person's skin or of animal flesh (meat)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incarnadine"@en .

aat:300266054 a skos:Concept ;
    skos:definition "A structural principle for musical composition used since the early 20th century in which a series or set of elements are used repeatedly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serial music"@en .

aat:300266055 a skos:Concept ;
    skos:definition "A body of musical compositions created since the early part of the 20th century created using the twelve-tone system attributed to Arnold Schoenberg. Generally twelve-tone music is considered a subset of serial music, but there is some disagreement on this."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twelve-tone music"@en .

aat:300266056 a skos:Concept ;
    skos:definition "Includes all non-pantherine cats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felinae"@en .

aat:300266057 a skos:Concept ;
    skos:definition "Bibles which generally contain only illustrations, sometimes with short pieces of text. In the past, they were used to spread knowledge of the Bible to the uneducated. Numerous examples exist from the Middle Ages, although picture Bibles dating to the 11th and 12th centuries, as well as those dating as late as the 16th century, have been discovered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture Bibles"@en .

aat:300266058 a skos:Concept ;
    skos:definition "Religious doctrine proposed in 622 and adopted by Byzantine Emperor Heraclius which declared that Jesus Christ had one will but two natures, the divine and the human. This ideology was developed under Patriarch Sergius I of Constantinople in attempt to bridge the gap between Monophysites and Chalcedonians, although neither group accepted it. In 680, the Third Council of Constantinople declared Monothelitism as heretical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monothelitism"@en .

aat:300266059 a skos:Concept ;
    skos:definition "Natural depressions or courses in the earth's surface that are filled with water, including seas, lakes, and rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodies of water"@en .

aat:300266060 a skos:Concept ;
    skos:definition "Geomorphic features of the earth's surface formed by natural processes and that have definable composition and range of characteristics, which recur wherever the features are found and that reflect similar surface and subsurface conditions. Typically reserved for features above water. For marine landforms, use \"undersea landforms.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landforms"@en .

aat:300266061 a skos:Concept ;
    skos:definition "Plants collectively, usually referring to plants or vegetal growths in a defined area. For the kingdom of plants, use \"Plantae (kingdom).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetation"@en .

aat:300266062 a skos:Concept ;
    skos:definition "Meetings conducted by a medium, who is person believed to be in contact with the spirits of the dead, in attempt to communicate with the deceased."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "séances"@en .

aat:300266063 a skos:Concept ;
    skos:definition "Decorated fans in the form of a disk or other shape made from precious feathers, metal, leather, parchment, or silk, mounted on a pole or handle, and used to keep flies and other insects away from liturgical sacrifices. They were first used in pre-Christian sacrifices and were then taken up by the Early Christians. Use was continued in the Latin Church to about the 14th century, and in the Greek Church to the present day. Flabelli in the shape of a fan, later morphing into an umbrella or canopy, were also used historically to designate the ranks of bishops and princes in ceremonies. Two fans of this kind are used at the Vatican whenever the Pope is carried in state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flabelli"@en .

aat:300266064 a skos:Concept ;
    skos:definition "Rings worn to signfiy the office of a bishop, pope (the bishop of Rome), or certain other high ranking members of the clergy in the Roman Catholic church and some other Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastoral rings"@en .

aat:300266065 a skos:Concept ;
    skos:definition "Rings worn to signify the office of the abbot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abbot's rings"@en .

aat:300266066 a skos:Concept ;
    skos:definition "Rings worn to signfiy the office of a bishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bishop's rings"@en .

aat:300266067 a skos:Concept ;
    skos:definition "Rings worn to signify the office of a cardinal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardinal's rings"@en .

aat:300266068 a skos:Concept ;
    skos:definition "Rings worn to signfiy the office of the Pope of the Roman Catholic church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal rings"@en .

aat:300266069 a skos:Concept ;
    skos:definition "Bands, usually of gold or silver, worn in the manner of a wedding ring by some orders of nuns in the Roman Catholic and certain other faiths, signifying the nun's fidelity and betrothal to the Church and to God. The ring may be given when the nun professes vows at her first profession or at her final profession of vows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nun's profession rings"@en .

aat:300266070 a skos:Concept ;
    skos:definition "Large crosses pinned or worn suspended from a chain or cord on the chest by the Pope, archbishops, and bishops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pectoral crosses"@en .

aat:300266071 a skos:Concept ;
    skos:definition "Veils worn by women while receiving communion in the Catholic Church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dominicals"@en .

aat:300266072 a skos:Concept ;
    skos:definition "Shaping something, particularly a gem, without facets, so that an oval, round, rectangular, or polygonal shaped stone has a flat bottom and a domed top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabochoning"@en .

aat:300266073 a skos:Concept ;
    skos:definition "Refers to the period and style of art that developed during the early part of the rise of Kamakura period, typically dated from 1185 to around 1300."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Kamakura"@en .

aat:300266074 a skos:Concept ;
    skos:definition "Period generally during the dates 1300-1333."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Kamakura"@en .

aat:300266075 a skos:Concept ;
    skos:definition "A piece of fabric worn on a Bishop's lap during High Mass and ordinations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gremials"@en .

aat:300266076 a skos:Concept ;
    skos:definition "Towels on which a priest dries his hands after washing them before celebrating Mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manuterges"@en .

aat:300266077 a skos:Concept ;
    skos:definition "Miters worn by Christian clergy, distinguished by being decorated with jewels and other precious materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitrae pretiosae"@en .

aat:300266078 a skos:Concept ;
    skos:definition "Tall headdresses worn by Christian clergy, including the pope, bishops, and senior abbots as a symbol of office. The miter tapers to a point at the vertical summit of two pieces, front and back, with a deep cleft between. It is distinguished by being made of relatively modest materials, such as silk or linen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitrae simplicēs"@en .

aat:300266079 a skos:Concept ;
    skos:definition "Decorated miters, lacking jewels, worn by Christian officiates. For miters decorated with gold and jewels, use \"mitra pretiosa.\" For miters of simpler materials, use \"mitrae simplex.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitrae auriphrygiatae"@en .

aat:300266080 a skos:Concept ;
    skos:definition "The effect of graduated or shaded color in textiles, created through the weave or by dyeing. The effect may be monochromatic or polychromatic. The term is most often used for textiles, but may also be extended to painted or colored surfaces that display a graduated shading effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ombré"@en .

aat:300266081 a skos:Concept ;
    skos:definition "Low boots of a type first designed for Roman military use and later adapted for other uses. They are first known by the time of Augustus. The soles comprise several layers of leather, which may be nailed all around with hobnails for traction; the uppers may be cut in open latice work for ventilation, giving the boots a sandal-like appearance. For Christian liturgical footwear known by a homograph, use \"liturgical stockings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caligae"@en .

aat:300266082 a skos:Concept ;
    skos:definition "Skullcaps worn by ordained officiates in the Catholic Church. The color varies according to rank: white is for the pope, red for cardinals, violet for bishops, and black for all others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zucchettos"@en .

aat:300266083 a skos:Concept ;
    skos:definition "A reed organ on which the player maintains the air pressure needed for creating the sound in the free reeds by pumping foot pedals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pump organs"@en .

aat:300266085 a skos:Concept ;
    skos:definition "General term referring to animals from several evolutionary lines and thus not properly a taxonomic group. The term refers to aquatic animals found in the fresh and salt waters all over the world, characterized by being cold-blooded, living and breathing primarily in the water throughout their lives, possessing gill slits, a notochord or skeletal supporting rod, a dorsal hollow nerve cord, a tail, scales covering the body, and two sets of paired fins and several unpaired fins. Living species range from the primitive jawless lampreys and hagfishes through the jawed fishes with cartilaginous skeletons such as sharks, skates, and rays to the abundant and diverse bony fishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish"@en .

aat:300266087 a skos:Concept ;
    skos:definition "Granular hydrated silica used as a desiccant, often employed in long-term storage of electronics or optical devices such as cameras. It absorbs and releases moisture based on ambient humidity. Rather than a drying agent, it is more accurately a moisture stabilizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silica gel"@en .

aat:300266091 a skos:Concept ;
    skos:definition "Method for the removal of wall paintings involving the removal of the arriccio together with the wall support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacco a massello"@en .

aat:300266092 a skos:Concept ;
    skos:definition "Abstract wordless images made on paper using a typewriter as a mark-making device. Coined by Edwin Morgan to describe the works of Dom Sylvester Houédard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typestracts"@en .

aat:300266094 a skos:Concept ;
    skos:definition "Family containing four genera and 14 species of arboreal apes, plus one fossil species of a different genus dating from the Pleistocene. Their major distinction from other apes are their long arms which they use to brachiate through the trees. The great ape family was previously referred to as Pongidae, and humans (and fossil hominids) were omitted from it, but on grounds of relatedness chimpanzees, gorillas, humans and orangutans are now classified with humans, because they are all more closely related to one another than any of them are to the gibbons, who are now classified in this separate family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hylobatidae"@en .

aat:300266095 a skos:Concept ;
    skos:definition "Classification comprising two families of hominoids, Hylobatidae, including the gibbons and other lesser apes, and Hominidae, including gorillas, chimpanzees, orangutans, and humans, known as the great apes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hominoidea"@en .

aat:300266096 a skos:Concept ;
    skos:definition "Family containing two genera, about ten living species of capuchins and squirrel monkeys in South and Central America. Dolichocebus, a now extinct cebid, lived in the Middle East about 25 million years ago. They have been in South America since at least the early Oligocene, when they probably arrived via overwater rafting from Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cebidae"@en .

aat:300266097 a skos:Concept ;
    skos:definition "Refers to fine-art digital prints made with an ink jet process; originally with the Iris, a large drum-based inkjet printer used to create proofs for offset lithography. These prints may be made on various supports: paper, canvas, mylar, etc. For high-volume editions of reproductions, use \"giclée prints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iris prints"@en .

aat:300266098 a skos:Concept ;
    skos:definition "Family containing four genera, 27 or more living species of marmosets and tamarins of South and Central America. There are three fossil species in three extinct genera dating from the Early Miocene to Holocene. Some classifications list this as a subfamily of Cebidae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Callitrichidae"@en .

aat:300266099 a skos:Concept ;
    skos:definition "Family containing 21 genera with 103 or more living species of monkeys, almost all from Asia and Africa. Also includes 17 fossil species in 11 genera dating from Middle Miocene to Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cercopithecidae"@en .

aat:300266100 a skos:Concept ;
    skos:definition "Family containing five genera, with 25 or more living species of dwarf, mouse, and fork-crowned lemurs, all from Madagascar, including the smallest living primates. The number of species cannot be precisely given, as new species continue to be discovered; they date from the Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cheirogaleidae"@en .

aat:300266101 a skos:Concept ;
    skos:definition "Genus with one living species of rare squirrel-like primate and one recently extinct, perhaps within the past 500 years, from Madagascar. They date to the Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daubentonia"@en .

aat:300266102 a skos:Concept ;
    skos:definition "Family containing four genera of about 20 living African species of small, quick primates, and three fossil genera, dating from the Miocene to Holocene. They are sometimes included as a subfamily within the Loridae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galagidae"@en .

aat:300266103 a skos:Concept ;
    skos:definition "Family containing three genera and about 14 living species of arboreal Madagascan primates. They date from the Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indridae"@en .

aat:300266106 a skos:Concept ;
    skos:definition "Group or succession of persons with their own identity, arising from shared theory or practice, from being disciples of the same master, or from a similarity of principles, methods, or artistic style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schools"@en .

aat:300266107 a skos:Concept ;
    skos:definition "The milieu and characteristics surrounding academic learning and university scholarship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academia"@en .

aat:300266108 a skos:Concept ;
    skos:definition "General term for organizations or establishments that provide instruction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schools"@en .

aat:300266109 a skos:Concept ;
    skos:definition "Members of an academy or other learning institution, particularly teachers or scholars belonging to a body of higher education or learned society dedicated to the promotion of art, the humanities, or science."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academics"@en .

aat:300266110 a skos:Concept ;
    skos:definition "Family containing five genera and around 18 species from Madagascar, pluse 1 Holocene fossil genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lemuridae"@en .

aat:300266111 a skos:Concept ;
    skos:definition "Family containing four or more genera with 11 or more species from Africa and Asia, plus one fossil genus dating from the Miocene. They are characterized by being arboreal, nocturnal, having soft gray or brown fur, huge eyes encircled by dark patches, and short index fingers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lorisidae"@en .

aat:300266112 a skos:Concept ;
    skos:definition "Family containing one genus with at least ten species of nocturnal and predominantly arboreal primates from Madagascar, and one Holocene fossil genus. They were until recently placed in the Lemuridae family, but they are now believed to have a close relationship to the extinct giant lemur genus Megaladapis, which is in a separate family from other lemurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megaladapidae"@en .

aat:300266113 a skos:Concept ;
    skos:definition "Family containing one genus and about seven Asian species of tarsiers, plus two fossil species from the Middle Eocene to Holocene. Living tarsiers are small, leaping primates found only on various islands of Southeast Asia, including the Philippines, Borneo, Sumatra, on some East Indian islands, and on some Philippine islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarsiidae"@en .

aat:300266114 a skos:Concept ;
    skos:definition "Culinary implements with, on one end, triangular heads used for piercing the tops of beverage cans, and on the opposite end, rounded heads used for opening bottles. The term is slang, and may be also be used as a synonym for both can openers and bottle openers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church keys"@en .

aat:300266115 a skos:Concept ;
    skos:definition "Municipal buildings in some English towns where moot cases are, or once were, discussed. Historically, the term was used to refer to town halls, or assembly spaces such as courtrooms, or council chambers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moot halls"@en .

aat:300266116 a skos:Concept ;
    skos:definition "A type of art glass developed and produced by the Württembergische Metallwarenfabrik (W.M.F.) by Karl Weidman ca. 1926. It is characterized by the use of colorless, raw glass made iridescent by a silver stain and then matte fired, resulting in a shimmering metallic surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myra-Kristall"@en .

aat:300266117 a skos:Concept ;
    skos:definition "Artists who specialize in painting scenes of daily life of common people, such as market scenes and domestic settings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genre painters"@en .

aat:300266118 a skos:Concept ;
    skos:definition "Artists who specialize in painting inanimate objects such as bowls of fruit, bottles, and flowers, which are often arranged in an aesthetic composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "still life painters"@en .

aat:300266119 a skos:Concept ;
    skos:definition "Artists who specialize in painting flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower painters"@en .

aat:300266121 a skos:Concept ;
    skos:definition "Generally, may refer to showy unsubstantial objects, especially a useless ornament. Specifically, typically refers to mechanical contrivances or scientific apparatuses that are collectible but of little utilitarian value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gimcracks"@en .

aat:300266122 a skos:Concept ;
    skos:definition "Refers to small ornaments, typically showy inexpensive jewelry or other articles for personal adornment or attached to clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trinkets"@en .

aat:300266123 a skos:Concept ;
    skos:definition "Refers to small manufactured articles that are decorative or amusing and intended primarily for personal or household use. They are typically characterized by being of little utilitarian value and for being appealing primarily due to the newness of their design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novelties"@en .

aat:300266124 a skos:Concept ;
    skos:definition "Books which have had imperfections, such as missing leaves, made good by the insertion of portions from copies of similar editions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "made-up copies"@en .

aat:300266125 a skos:Concept ;
    skos:definition "Architectural elements found on Indian religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindu religious building fixtures"@en .

aat:300266126 a skos:Concept ;
    skos:definition "Flat, or disc-shaped, serrated or fluted stones placed at the summit of North Indian or Nāgara temples, as a repeating motif in these superstructures or in other contexts. The shape is derived from the Indian fruit amla or myrobalan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "āmalakas"@en .

aat:300266127 a skos:Concept ;
    skos:definition "Intermediate spaces in North Indian temples; antechambers or vestibules of the sanctum, the space in front of sanctum door, a type of vestibule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antarālas"@en .

aat:300266129 a skos:Concept ;
    skos:definition "The enclosed form of the maṇḍapa that may be connected to the shrine of a temple or stand separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ardhamaṇḍapas"@en .

aat:300266130 a skos:Concept ;
    skos:definition "The hall for the preparation and distribution of consecrated food offerings in an Orissan temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhogamaṇḍapas"@en .

aat:300266131 a skos:Concept ;
    skos:definition "Rounded decorative openings, windows, or arches in a barrel-vaulted hall or cave shrine entry, a dormer-window as decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candraśālās"@en .

aat:300266132 a skos:Concept ;
    skos:definition "Literally: \"womb-\" or \"embryo chambers.\" The inner, or main sanctum of a Hindu temple where the object of worship; either an image or linga, is venerated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garbhagṛhas"@en .

aat:300266134 a skos:Concept ;
    skos:definition "Monumental barrel-roofed temple gateways or gate towers of South Indian temples or temple enclosures. These evolved from the form of vimanas, but with a passageway incorporated through the center of the structure. gateway, with śālā (Valabhī) type of superstructure; gate-house (Dravidian and early Indian in general)"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gopuras"@en .

aat:300266135 a skos:Concept ;
    skos:definition "Refers to the part of a wall below the superstructure of southern Indian shrines. It may be of square, circular, or octagonal shape, a neck recess between the wall and the śikhara, and also between the śikhara's upper end and crowning āmalaka; beki (Oriyā)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grīvās"@en .

aat:300266136 a skos:Concept ;
    skos:definition "Spaces or rooms located in Hindu religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindu temple spaces"@en .

aat:300266137 a skos:Concept ;
    skos:definition "As with the Egyptian lotus, Indian lotus motifs are also ancient and seen in Hindu iconography, but they gained widespread use in Buddhist iconography. The Indian motifs are based on the species of aquatic plant Nelumbo nucifera, having a large bright pink, white, or blue flower, in art seen in profile, in rosettes, and as medallions. Examples of use in Indic culture include as a pedestal to support figures of deities, as a molding, or as a capital. It is associated with the qualities of transcendence and grace, and appears as an emblem of Vishnu. Color variations impart various meanings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padma"@en .

aat:300266138 a skos:Concept ;
    skos:definition "The high enclosure-walls of a south Indian temple structure, or the covered walkway that surrounds the temple boundary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prākāras"@en .

aat:300266139 a skos:Concept ;
    skos:definition "Entablatures that form the transition from wall to roof in a Dravida temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prastaras"@en .

aat:300266140 a skos:Concept ;
    skos:definition "Molded bases, in Indian architecture, a molded lower element, such as in South India, the moldings below a wall-frieze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhiṣṭhānas"@en .

aat:300266141 a skos:Concept ;
    skos:definition "Eaves or awnings projecting from a Hindu temple buiding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chādyas"@en .

aat:300266142 a skos:Concept ;
    skos:definition "In Indian architecture, the central projections or offsets, such as those containing images of deities in north Indian nāgaras or shrines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhadras"@en .

aat:300266143 a skos:Concept ;
    skos:definition "Small cell-like shrines containing sacred images that are subsidiary components of some north Indian temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devakulikās"@en .

aat:300266144 a skos:Concept ;
    skos:definition "Fluted bell-shaped structures used as finials in pyrimidal roofing of Indian temple architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghaṇṭās"@en .

aat:300266145 a skos:Concept ;
    skos:definition "Raised plinths, or platforms on which temples and their attendant shrines are placed in Indian architecture, a plinth, platform; basal moulding of adhiṣṭhāna (South Indian); platform supporting a temple (with its hall) (northern Indian usage); vertical moulding at the base of adhiṣṭhāna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jagatīs"@en .

aat:300266146 a skos:Concept ;
    skos:definition "The sections of wall of Indian temples located above but not including moldings, and below the tower or spire. In Indian architecture, a wall; wall-frieze between vēdībandha and śikhara; kaṭi (older synonym); jāṅgha (Oriyā)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jaṅghās"@en .

aat:300266147 a skos:Concept ;
    skos:definition "Crowning finial components in the shape of a pot, pitcher, or ewer appearing in Hindu temple architecture. In Indian architecture, a pitcher; torus moulding; jar-shaped pinnacle of śikhara; pitcher-finial; ghaṭa; vase-finial; pot; stūpī, stūpikā (southern); also torus in a vēdībandha group of mouldings (northern and upper southern)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalaśas"@en .

aat:300266148 a skos:Concept ;
    skos:definition "Refers to the culture of the historical region, kingdom, and later administrative district of Bohemia. Often used as a synonym of 'Czech.' Bohemia ceased to be an autonomous administrative district in 1949, and in 1993 formed part of the modern Czech Republic. There is no cultural difference implied in the terms 'Czech' and 'Bohemian,' the distinction is more precisely a chronologic or historical one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bohemian"@en .

aat:300266149 a skos:Concept ;
    skos:definition "Moldings in Hindu temple architecture that resemble roll-cornices, or overhanging cornices; curved cornices of basement or walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kapotas"@en .

aat:300266150 a skos:Concept ;
    skos:definition "Refers to angles, quoins, corners, or corner projections of northern Indian temple structures. In Indian architecture, an angle; plain fillet (moulding); corner wall-division; corner-division of plan and elevation; corner; kōṇa; corner projection. In Indian architecture, a corner (Kaliṅga); karṇa; kaṇika-pāga (Oriyā)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karṇas"@en .

aat:300266151 a skos:Concept ;
    skos:definition "Locations where there is digging or other uncovering of evidence of ancient life, including artifacts of human activity, fossils, frozen remains, or other preserved evidence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excavations"@en .

aat:300266152 a skos:Concept ;
    skos:definition "Sites where there is evidence of forms of life that existed in former geologic periods. For sites where evidence of human activity exists, use \"archaeological sites.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleontological sites"@en .

aat:300266153 a skos:Concept ;
    skos:definition "Grotesque animal heads or masks resembling the form of a lion that are used as decorative devices on some temples, common in India and Southeast Asia. They may appear with horns, pearl festoons, or floral garlands erupting from the mouth; grāsamukha; demon head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kīrttimukhas"@en .

aat:300266154 a skos:Concept ;
    skos:definition "The process of performing actions to halt damage or to keep any object, material, or system from injury or destruction. For example, it may refer to the preservation of food or an ecological system. For the function of preservation, use \"preservation (function)\" or a specific type of preservation, such as \"historic preservation.\" For the discipline of involving treatment and long-term preventive care of cultural and natural heritage objects and systems, use \"conservation.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preserving"@en .

aat:300266156 a skos:Concept ;
    skos:definition "Refers to Hindu temple building complexes comprised of one main temple surrounded by four subsidiary shrines, the term meaning \"five-shrined.\" five-shrined; five-fold; five shrines in quincunx formation; shrine complex with four sub-shrines at the four corners"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pañcāyatanas"@en .

aat:300266157 a skos:Concept ;
    skos:definition "Generally, natural objects existing outside the planet Earth and its atmosphere, including the Earth's moon and other planets in this solar system. Specifically, natural objects of extraterrestrial origin, such as comets or other meteoroids, that enter the Earth's atmosphere or fall to its surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extraterrestrial bodies"@en .

aat:300266158 a skos:Concept ;
    skos:definition "An extraterrestrial body consisting of a frozen mass and rock debris that travels around the Sun in a highly elliptical orbit; it generally developes a diffuse gaseous envelope and a long luminous tail when near the Sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comets"@en .

aat:300266159 a skos:Concept ;
    skos:definition "Interplanetary particles or chunks of stony or metallic matter that survive the passage through the Earth's atmosphere and strike the ground, or that strike any other planet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteorites"@en .

aat:300266160 a skos:Concept ;
    skos:definition "Interplanetary bodies of relatively small size that enter the Earth's atmosphere at high velocity, burn and heat the air around themselves causing a resultant luminous phenomenon that is called a \"meteor.\" If such an object survives its plunge through the atmosphere and lands on the ground, it is called a \"meteorite.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meteoroids"@en .

aat:300266161 a skos:Concept ;
    skos:definition "Rocky bodies that are about 1,000 km or less in diameter and that orbit the Sun primarily between the orbits of Mars and Jupiter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asteroids"@en .

aat:300266162 a skos:Concept ;
    skos:definition "Double-ended metal spatulas that are heated and used to burn in colors in encaustic paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauteria"@en .

aat:300266163 a skos:Concept ;
    skos:definition "Metal spatulas with pointed ends used to apply color in encaustic paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cestrums"@en .

aat:300266164 a skos:Concept ;
    skos:definition "Equipment and implements used for encaustic painting, such as a palette, pan of coals, brazier, and spatula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cauteria"@en .

aat:300266165 a skos:Concept ;
    skos:definition "Layered cornice roof structures having a pyramidal shape rising from a square base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phāṁsanās"@en .

aat:300266166 a skos:Concept ;
    skos:definition "Molded pedestals, plinths, or bases of structures that support an image of a deity, or lingam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pīṭhas"@en .

aat:300266167 a skos:Concept ;
    skos:definition "Traditional type of soap made from olive oil or other vegetable oils, in the area of Marseilles, France since ca. 1370. In 1688 Louis XIV introduced regulations limiting the use of the name \"savon de Marseille\" to soaps made in and around the Marseilles area and only made from olive oil. Today this law still applies, although other vegetable oils may now be used. Often used for cleaning and degumming textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marseilles soap"@en .

aat:300266168 a skos:Concept ;
    skos:definition "A sulfide of tin, copper, and iron; an ore of tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stannite"@en .

aat:300266169 a skos:Concept ;
    skos:definition "East Asian paintings primarily depicting birds, and plants, and natural subjects. Paintings of this genre originated in China and were transmitted to Japan by the literati master Shen Nanpin when he visited there in 1731. Japanese artists further developed the genre in the Edo period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird-and-flower paintings"@en .

aat:300266170 a skos:Concept ;
    skos:definition "Japanese painting style influenced by Chinese painting from the Yuan and Song periods, imported into Japan from the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kanga"@en .

aat:300266171 a skos:Concept ;
    skos:definition "Japanese painting style also known as \"fingertip painting\" where artists use their fingertips or fingernails to create ink effects. Used primarily by Nanga artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shitōga"@en .

aat:300266172 a skos:Concept ;
    skos:definition "Japanese painting style also known as \"splashed ink\" whereby ink is splattered on a surface of a painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hatsuboku"@en .

aat:300266173 a skos:Concept ;
    skos:definition "Japanese painting technique where ink washes are layered to enhance the three-dimensional quality of forms in a painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsuketate"@en .

aat:300266174 a skos:Concept ;
    skos:definition "Japanese painting style, also known as the \"boneless\" technique, which refers to painting without outlines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mokkotsu"@en .

aat:300266176 a skos:Concept ;
    skos:definition "White pigment made of calcium carbonate derived from ground seashells, eggshells, or fish bones. Shell white is made by crushing, then boiling the shells. The calcium carbonate powder is then pulverized and dried to form a very pure, white pigment used for watercolors, especially in Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell white"@en .

aat:300266177 a skos:Concept ;
    skos:definition "A principal ore of lead; lead sulfide (PbS). Often contains silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galena"@en .

aat:300266178 a skos:Concept ;
    skos:definition "Folding screens, originally secular, painted during the late Heian period, and later used in Buddhist ordination ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senzui byōbu"@en .

aat:300266179 a skos:Concept ;
    skos:definition "Japanese artists' brush used for writing and painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fude"@en .

aat:300266180 a skos:Concept ;
    skos:definition "A principal class of soap that is created using fatty acids that are longer and tend to dissolve more slowly in water than soft soaps; for example, olive oil and caustic soda lye would be used to create a hard soap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard soap"@en .

aat:300266181 a skos:Concept ;
    skos:definition "A type of hard soap that is mild, odorless, and white or semitransparent, made with olive oil or other vegetable oils and sodium hydroxide or sodium carbonate. Castile soap is used to clean leather (saddle soap) and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castile soap"@en .

aat:300266182 a skos:Concept ;
    skos:definition "A furnace with an inner chamber to keep objects from exposure to direct flame; a low temperature oven used to apply overglaze colors on objects. Temperatures usually range from 700 to 900 degrees Celsius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muffle kilns"@en .

aat:300266183 a skos:Concept ;
    skos:definition "An impure cobalt oxide created with mineral ore and sand, used to create smalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zaffer"@en .

aat:300266184 a skos:Concept ;
    skos:definition "An ore of manganese that is dark grey in color; manganese dioxide. Used to decolorize glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrolusite"@en .

aat:300266186 a skos:Concept ;
    skos:definition "Hindu sacred wells, reservoirs, or tanks, located below ground-level, often stepped, and associated with Hindu temple architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kundas"@en .

aat:300266187 a skos:Concept ;
    skos:definition "A type of collage and painting that uses only paper to create the composition; the term means \"glued papers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papiers collés"@en .

aat:300266188 a skos:Concept ;
    skos:definition "Refers to a people of South-west Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gimira"@en .

aat:300266189 a skos:Concept ;
    skos:definition "Parts or components of electronic images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic image components"@en .

aat:300266190 a skos:Concept ;
    skos:definition "The smallest units of an electronic display of digital imagery. In a black and white display this unit registers as either on or off. With a color display, the number of colors that may be displayed are limited by the screen's 'pixel depth,' measured in bits. The resolution of computer displays is also measured in pixels: the higher the number of pixels, the greater the resolution of the image displayed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pixels"@en .

aat:300266191 a skos:Concept ;
    skos:definition "Process of refining precious metals like gold and silver; the impurities are oxidized and partly absorbed into the cupel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupellation"@en .

aat:300266192 a skos:Concept ;
    skos:definition "Technique of scattering a monochromatic light, such as a laser, changing the vibrational, rotational, or electronic energy of a sample, the results of which help determine its molecular structure. Discovered by Indian physicist Sir Chandrasekhara Venkata Raman (1888-1970)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raman spectroscopy"@en .

aat:300266193 a skos:Concept ;
    skos:definition "Used to describe something riding on top of another thing, such as a person riding on another's shoulders or hips, but often used in the context of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piggyback"@en .

aat:300266194 a skos:Concept ;
    skos:definition "Radiography that focuses on a specific plane of an object or body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomography"@en .

aat:300266195 a skos:Concept ;
    skos:definition "Method of obtaining a series of cross-sections of internal structures of a body or object to create three-dimensional images; used in diagnostic medicine, but also in science for nondestructive testing of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computerized axial tomography"@en .

aat:300266196 a skos:Concept ;
    skos:definition "The culture and style of Bench-speaking people of Ethiopia, particularly from the Mizan Teferi area of the Kafa region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bench"@en .

aat:300266197 a skos:Concept ;
    skos:definition "Refers to images rendered in pixels that correspond to bits of data in computer memory, and are displayed on a screen. Pixels correspond to bits that may vary in depth: a one-bit pixel is either black or white. The higher the bit depth, the greater the number of colors that may be represented on screen. Bit maps make raster graphics possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bit maps"@en .

aat:300266198 a skos:Concept ;
    skos:definition "Named for French mathematician Pierre Bézier. Use for curves rendered mathematically from cubic equations generated from a series of control points. Bezier curves are used in computer programs to create curved lines for graphics and complex paths for 3-D modeling. A Bezier curve is a form of b-spline curve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bézier curves"@en .

aat:300266199 a skos:Concept ;
    skos:definition "Dolls with moving parts, similar to \"jumping-jacks,\" particularly those used by children in ancient Greece. They were typically made of wood, bone, ivory, marble, cloth, wax, alabaster, or terracotta, with articulated arms and legs that were made separately and attached to the doll's body with cords, which allowed the limbs to move. Earliest examples date to about 800 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plangones"@en .

aat:300266200 a skos:Concept ;
    skos:definition "Generic term that commonly refers to a broad class of anthropomorphic figurines or dolls, historically made of wax, clay, lead, and other material, used as focus entities to ritually bind social and supernatural enemies. Though these figurative objects have been anachronistically linked to colonial syncretic religions such as Haitian Vodou or Mississippi River Valley Voodoo, often through the dissemination of racist popular culture in the 19th through 21st centures, the dolls are not prominent features of any Vodun-based religions. Contemporary scholars specifically locate the false equvalence between these figurative objects and Vodu or Voodoo religions in the 19th century European misinterpretation of the Kongo power figure (ir nkisi nkondi). The objects that are vernacularly termed voodoo dolls, however, more accurately evidence a wide spectrum of defensive magic rituals employed by ancient Greco-Roman and Egyptian cultures, amongst others, to control evil forces. While evidence of these figurative objects was first documented around the 7th century BC, the use of these dolls is thought to have predated the Greco-Roman period and entered the European imagination as a cultural import from the East. Traditional treatment of dolls includes twisting, burning, melting, and otherwise manipulating their limbs into bound positions; piercing the objects with pins or nails; and enclosing the dolls within sealed boxes. For the figurative binding figures used in the Kongo tradition, use the term \"minkondi.\" For a more precise reference to ancient Greco-Roman binding figures, use the term \"kolossoi.\" For a less pejorative generic term for a wide range of anthropomorphic figures, use the term \"binding figures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voodoo dolls"@en .

aat:300266201 a skos:Concept ;
    skos:definition "Timber framed, one or one and a half story, side-gabled houses, with a central chimney, steeply-pitched roof, and typically clapboarded or shingled siding. These were small houses found in colonial New England, particularly Massachusetts, during the 18th century. The Cape Cod house also became popular in the United states as a revival style in the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cape Cod houses"@en .

aat:300266202 a skos:Concept ;
    skos:definition "A unit of illumination in the International System of Units. One lux is equal to one lumen per square meter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lux"@en .

aat:300266203 a skos:Concept ;
    skos:definition "The measure of density of luminous flux per unit of surface area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illuminance"@en .

aat:300266204 a skos:Concept ;
    skos:definition "Use to refer to units of luminous flux. It is equal to the amount of flux emitted by one candela into a cone having the solid angle of one steradian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lumens"@en .

aat:300266205 a skos:Concept ;
    skos:definition "A string of beads, usually carried on one's person and manipulated by the fingers as a means of occupying one's hands to relieve worry or tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worry beads"@en .

aat:300266206 a skos:Concept ;
    skos:definition "Strings of worry beads used in Greece and Turkey, characterized by the material often comprising amber or coral, the string of beads containing an odd number of beads, with knots between the beads, generally with the ends bound together into a loop, and often with the ends of the string extending beyond the joint and decorated at the end with a tassel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "komboloi"@en .

aat:300266207 a skos:Concept ;
    skos:definition "Printed or photographic material generated from a microform or digital source. Usually refers to prints on paper, but the substrate may be of any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardcopies"@en .

aat:300266208 a skos:Concept ;
    skos:definition "Information as displayed on a computer screen, or that cannot be read without the aid of electromechanical devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft copies"@en .

aat:300266209 a skos:Concept ;
    skos:definition "That part of a print-making device that transfers the medium to the substrate. Usually used to describe components of ink jet printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printheads"@en .

aat:300266210 a skos:Concept ;
    skos:definition "Small pictures, pictograms, or symbols used on computer displays or in graphical user interfaces meant to represent files, objects, applications, actions, or messages. These can be selected and manipulated to access data or perform functions. Icons are represented with a graphical design that indicates meaning to the user and may act as hyperlinks. Icons may change their appearance when events occur, such as files being opened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icons"@en .

aat:300266211 a skos:Concept ;
    skos:definition "Very small dolls made of bits of cloth, bone, and wood generally produced in Guatemala but probably having originated in the Maya culture utilizing scraps of fabric left over from making clothing. Children and adults confide their worries or troubles to the doll, and it is believed that the doll takes on the troubles so that the user can sleep in peace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "worry dolls"@en .

aat:300266212 a skos:Concept ;
    skos:definition "Strings or garlands of beads used in Hinduism, Sikhism, and Mahayana Buddhism; often characterized by having 108 beads, often made of wood or bone, and used as an aid for repititions of a mantra or prayers. A mala may also offer protection to the one who wears it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malas"@en .

aat:300266213 a skos:Concept ;
    skos:definition "Japanese ritual dolls made of clay or porcelain and dressed in real clothes that are used at the girls' festival, Hina Matsuri, held annually in March. A number or dolls representing the emperor, empress, and their court are displayed on a stepped altar. Girls of ages 7 to 17 visit each other's collections and refreshments are offered to their majesties, then to the guests, in a ritual more than 900 years old."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hina dolls"@en .

aat:300266214 a skos:Concept ;
    skos:definition "Dolls found in ancient Egyptian graves, typically carved out of flat pieces of wood, roughly in the shape of a paddle, and decorated with paint and hairmade of strips of clay or wooden beads. Their function may have been as toys but also as protective figures for the deceased in the afterlife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paddle dolls"@en .

aat:300266215 a skos:Concept ;
    skos:definition "A surface finish effect that approximates the lustre of pearl or mother of pearl for decorative effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearlescence"@en .

aat:300266216 a skos:Concept ;
    skos:definition "An accessory formed of clothlike folds or scrollwork depicted behind or above a heraldic achievement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantling"@en .

aat:300266217 a skos:Concept ;
    skos:definition "Transparent layers applied to a drawing or painting using diluted ink or watercolor. An example of usage is in order to create an atmospheric effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink washes"@en .

aat:300266218 a skos:Concept ;
    skos:definition "A clear or colored lacquer applied to the finger- or toenails, usually for decorative purposes, but also as a protective barrier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail polish"@en .

aat:300266219 a skos:Concept ;
    skos:definition "Drawings made using a pen and ink, then altered or embellished with transparent washes of ink or watercolor, for example, to create an atmospheric effect. Usage may overlap with \"ink wash paintings,\" which may appear similar but typically use brush only, not pen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen and wash drawings"@en .

aat:300266220 a skos:Concept ;
    skos:definition "Documents that are concerned with the description of antiquity or antiquities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeographies"@en .

aat:300266222 a skos:Concept ;
    skos:definition "A waxy, odorous substance of marbled ashy color produced in the intestines of the sperm whale, and often found floating in tropical seas, or on the seashore. Formerly used as an ingredient in perfumery to prevent evaporation, more recently it has been replaced in this function by synthetic substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambergris"@en .

aat:300266223 a skos:Concept ;
    skos:definition "Seals with which papal and royal documents were authenticated from the early Middle Ages. Examples include the round leaden seals used on particular documents originating from the pope, namely those with the superscription of the pope \"episcopus, servus servorum Dei.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullae"@en .

aat:300266224 a skos:Concept ;
    skos:definition "File format or compression scheme designed to create smaller file sizes for images on the World Wide Web; name derived from Joint Photography Experts Group, a committee of the International Standards Organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "JPEG"@en .

aat:300266225 a skos:Concept ;
    skos:definition "The effect given by an image created or reproduced with pixels, resulting in a jagged or indistinct image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pixelation"@en .

aat:300266226 a skos:Concept ;
    skos:definition "An image file format commonly used in computer scanning and desktop publishing applications. Appended to computer file names as '.tif.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "TIFF"@en .

aat:300266227 a skos:Concept ;
    skos:definition "Groups of image-capturing pixels numbering one million. Used to describe the resolution of digital cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megapixels"@en .

aat:300266228 a skos:Concept ;
    skos:definition "A computer interface that behaves as both an input and output device. The surface of the monitor screen is overlaid with sensors of various types that allow the user to trigger software tasks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "touch screens"@en .

aat:300266229 a skos:Concept ;
    skos:definition "Artists who create in order to express an often intense and very personal vision or aesthetic, and whose work is usually unmediated by the standards, traditions, and practices of the culture of the art world, as embodied by the international art markets and established art institutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outsider artists"@en .

aat:300266230 a skos:Concept ;
    skos:definition "Refers to art created by artists who do not have formal training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-taught art"@en .

aat:300266231 a skos:Concept ;
    skos:definition "Style and culture typical of Veracruz ca. 600-900 C.E."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Classic Veracruz"@en .

aat:300266232 a skos:Concept ;
    skos:definition "An African people living in the Jos Plateau of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mernyang"@en .

aat:300266233 a skos:Concept ;
    skos:definition "Refers to certain patterned beads, of cylindrical, tubular, or round shape, and generally made of agate. They originated in Tibetan culture and are particularly prized by Tibetan and Chinese Buddhists and other Asian groups. The most valuable beads are of ancient origin, have a reddish or dark brown color, and are characterized by distinctive ivory- or gold-colored patterns including circles that look like eyes, ovals, wavy lines, stripes, rectangles, and other symbolic patterns. The beads may be etched or carved. The beads are believed to be endowed with talismanic properties: Many were found in the earth by Himalayan farmers or shepherds, and the faithful believe that they were created by a mysterious lost process or are of supernatural origin. The processes of manufacture actually seem to have included taking advantage of the natural patterns of the agate, etching or carving the beads, using a chemical agent to create patterns, and firing the agate in a kiln. The existence of the beads is documented by the Chinese by at least the 7th century CE, but scholars believe that the technical knowledge for making dzi beads came to Tibet from Iran or India in very ancient times, perhaps along with the ancient Bon faith. They resemble banded agate beads and etched carnelian beads that were traded between Mesopotamia, the area of modern Afghanistan, and the Indus Valley as early as the third millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dzi beads"@en .

aat:300266235 a skos:Concept ;
    skos:definition "Fabric made of undyed wool, noted for being extremely soft, light in weight, graceful in draping, and formerly commonly used as a material for ladies' daytime dresses. Although it was originally left in its natural color, it was later dyed in various colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beige"@en .

aat:300266236 a skos:Concept ;
    skos:definition "Heavy yellow powder composed of lead monoxide, both the native mineral as well as lead monoxide produced by heating lead carbonate to 300 C. It is used as a drier in oil, as a low-fire flux in making ceramics and glass, as a yellow pigment in paints and glazes, in thin layers to produce iridescent colors on brass and bronze, as a filler for rubber, and to produce artificial tortoiseshell and horn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "massicot"@en .

aat:300266237 a skos:Concept ;
    skos:definition "Color model used in printing; based on mixing cyan, magenta, and yellow pigments in a subtractive method to create black and all other colors through light absorption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CMYK"@en .

aat:300266238 a skos:Concept ;
    skos:definition "Prints made by taking a second impression without reinking the plate, to clear the plate of residual ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maculatures"@en .

aat:300266239 a skos:Concept ;
    skos:definition "Color model used for televisions, computer monitors, and in other situations where light produces the color. It is an additive model in which red, green, and blue are combined in various ways to produce other colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "RGB"@en .

aat:300266240 a skos:Concept ;
    skos:definition "Sheds, usually detached outbuildings, in which wood, especially firewood, is stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woodsheds"@en .

aat:300266241 a skos:Concept ;
    skos:definition "Japanese hourglass drums having two heads of hide stretched over iron rings that project well beyond the body, laced to each other across the body with ropes. Players hold them by the ropes, relaxing and tightening their grip to alter the tension and thus adjust the pitch of the heads during play. Often used during performaces of Noh drama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tsuzumi"@en .

aat:300266242 a skos:Concept ;
    skos:definition "Refers to a warm off-white color of various shades, reminiscent of the color of cream, which is the whitish-yellowish fatty thick material in milk that floats to the top."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream"@en .

aat:300266243 a skos:Concept ;
    skos:definition "The whitish-yellowish layer that floats to the top of milk, comprising 18 to 40 percent butterfat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cream"@en .

aat:300266244 a skos:Concept ;
    skos:definition "The color of pink roses, which may range from pinkish to reddish, typically with overtones of mauve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose"@en .

aat:300266245 a skos:Concept ;
    skos:definition "The color of fabric stained by mauve dye, generally light shades of purple ranging between lilac and violet, but may also refer to deep purple tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mauve"@en .

aat:300266246 a skos:Concept ;
    skos:definition "Genus containing over 100 species of erect, climbing, or trailing shrubs. The great majority of species are native to Asia, with a few native to Europe, North America, and northwest Africa. However, they are cultivated in all corners of the world for their beautiful, fragrant flowers, and are known in large numbers of varieties and hybrids. The aggregate fruit of the rose is the berry-like rose hip, consumed by humans and animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosa"@en .

aat:300266247 a skos:Concept ;
    skos:definition "Long guns used in England in the late 16th century for military purposes, as they can be fired without rest. They were a newer form of the harquebus, but were not used after the Civil War. They were generally sized larger than the harquebus and smaller than the musket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calivers"@en .

aat:300266248 a skos:Concept ;
    skos:definition "A light to moderate brownish tawny color. The term originally referred to the color of crushed oak bark or tannin that is employed to tan leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tan"@en .

aat:300266249 a skos:Concept ;
    skos:definition "A dull yellowish brown color, often with greenish overtones, from the Hindi word meaning \"dust-colored\" and referring to the color of the British colonial army of the 1880s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khaki"@en .

aat:300266251 a skos:Concept ;
    skos:definition "Cloth of cotton, wool, or a blend, often of a serge weave, characterized by a dull brownish color and originally referring to cloth used for British field uniforms of the 1880s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khaki"@en .

aat:300266252 a skos:Concept ;
    skos:definition "A variable color, generally a warm whitish color with yellowish overtones resembling the color of ivory, which is the modified dentine that composes the tusks of elephants and other tusked mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivory"@en .

aat:300266253 a skos:Concept ;
    skos:definition "A variable color, generally a light grayish brownish color with pale yellowish overtones, originally referring to the color of raw linen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecru"@en .

aat:300266254 a skos:Concept ;
    skos:definition "A variable color, generally a moderately light warm brownish yellowish color, originally referring to the color of camel hair as used in textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camel"@en .

aat:300266255 a skos:Concept ;
    skos:definition "Devices designed to grant instant exit by pushing a crossbar that releases a locking bolt or catch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panic bolts"@en .

aat:300266257 a skos:Concept ;
    skos:definition "People who have withdrawn or secluded themselves from the world for religious reasons. Examples are the recluses of the East in the early Christian centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchorites"@en .

aat:300266258 a skos:Concept ;
    skos:definition "Refers to people who have withdrawn from the world by living on top of high columns or pillars, particularly the early Christian ascetics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylites"@en .

aat:300266259 a skos:Concept ;
    skos:definition "People who journey a great distance, particularly those who travel to a sacred place as an act of religious devotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrims"@en .

aat:300266260 a skos:Concept ;
    skos:definition "A cool brownish color with overtones of violet or olive color, varying from light to moderate value, originally referring to the color of sepia ink, which is derived from cuttlefish and used in pen and ink drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepia"@en .

aat:300266261 a skos:Concept ;
    skos:definition "A warm brownish red color of various values, originally referring to the color of sienna pigment, which is derived from soil and used as a pigment in oil and watercolor painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sienna"@en .

aat:300266262 a skos:Concept ;
    skos:definition "A warm reddish brown color of various values, originally referring to the color of raw sienna pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw sienna"@en .

aat:300266263 a skos:Concept ;
    skos:definition "A brown color with reddish overtones of various tones, originally referring to the color of burnt sienna pigment, made by exposing sienna earth to red heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnt sienna"@en .

aat:300266264 a skos:Concept ;
    skos:definition "Any of several brown colors, originally referring to the color of umber pigment, which is derived from earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "umber"@en .

aat:300266265 a skos:Concept ;
    skos:definition "A brown color of various hues, referring to the pigment raw umber and tending to be yellower than burnt umber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw umber"@en .

aat:300266266 a skos:Concept ;
    skos:definition "A brown color of various hues, referring to the pigment burnt umber and tending to be cooler and less yellow than raw umber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnt umber"@en .

aat:300266268 a skos:Concept ;
    skos:definition "Any of various brownish-gold colors resembling the topaz mineral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topaz"@en .

aat:300266269 a skos:Concept ;
    skos:definition "Refers to pink or reddish topaz, usually having been produced by exposing yellow Brazilian topaz to moderate heat, causing it to turn pink. The term may also refer to the extremely rare naturally occurring pink or red topaz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brazilian ruby"@en .

aat:300266270 a skos:Concept ;
    skos:definition "Refers to a range of bright medium greens to dark bluish green colors resembling the color of emerald, a mineral used as a gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emerald"@en .

aat:300266271 a skos:Concept ;
    skos:definition "General term for a medium-sized citrus fruit of several species, distinguished by having a rind with an orange color (reddish-yellow) and an acidic, juicy pulp that is sweeter than a lemon, grapefruit, or lime. The species most commonly intended by this term is Citrus sinensis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oranges"@en .

aat:300266272 a skos:Concept ;
    skos:definition "Refers to the large round, juicy, single-seeded fruits of a smallish tree belonging to the genus Prunus persica, believed to have originated in China, and cultivated in warmer climates throughout the world. The fruit has yellow or whitish flesh, a delicate aroma, and a skin that is either velvety (peaches) or smooth (nectarines) in different cultivars. Peaches are known in for the many associated folk tales and traditions, including that it was said to be consumed by the immortals, conferring longevity on all who ate them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peaches"@en .

aat:300266273 a skos:Concept ;
    skos:definition "Various tones of pinkish yellow, referring to the color of the stain of the juice of the fruit of the peach, a low spreading tree of the rose family that is widely cultivated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peach"@en .

aat:300266274 a skos:Concept ;
    skos:definition "Various tones of warm orangey pink, referring to the color of the flesh of the salmon fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salmon"@en .

aat:300266275 a skos:Concept ;
    skos:definition "Various colors ranging from reddish brownish gray to dark yellowish brown, from French and Latin words referring to the color of moleskin, which is the fur of the mole (animal)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taupe"@en .

aat:300266276 a skos:Concept ;
    skos:definition "The method of structuring and presentation of digitized information in various formats; audio, video, text, linked together non-sequentially in the same manner as hypertext."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypermedia"@en .

aat:300266277 a skos:Concept ;
    skos:definition "The introductory page of a Web site or domain that often contains an index or table of contents linking to further content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "home pages"@en .

aat:300266278 a skos:Concept ;
    skos:definition "The ratio of width to height of an image frame. The term is generally used in reference to motion pictures and other screen-oriented technologies including computer graphics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aspect ratio"@en .

aat:300266279 a skos:Concept ;
    skos:definition "In photography, refers to the usually unintended optical effect caused by reflected light at the time of initial film exposure, or the resulting halo surrounding the boundaries of light-emitting or reflecting sources in the image printed from this film. Modern photographic films are coated with an 'anti-halation layer' to prevent this effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halation"@en .

aat:300266280 a skos:Concept ;
    skos:definition "Parts or components of photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photograph components"@en .

aat:300266281 a skos:Concept ;
    skos:definition "Symmetrical lens design created in 1866 by Steinheil, which formed the basis for most general-purpose lenses until the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aplanats"@en .

aat:300266282 a skos:Concept ;
    skos:definition "A unit or circuit that converts audio or video information to and from analog and digital form, for storage and use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codecs"@en .

aat:300266283 a skos:Concept ;
    skos:definition "Duplicates of computer data stored on any type of media for archival or safety purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backups"@en .

aat:300266284 a skos:Concept ;
    skos:definition "Ribs crossing a vault bay diagonally, used either to mask the groins or to support the vault."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagonal ribs"@en .

aat:300266285 a skos:Concept ;
    skos:definition "The ribs along the longitudinal or transverse ridges of vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ridge ribs"@en .

aat:300266286 a skos:Concept ;
    skos:definition "Ceiling ribs that are partly or entirely detached from the surface of the vault, thus without vaulting cells and forming an aerial network; found in German and English Late Gothic architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying ribs"@en .

aat:300266287 a skos:Concept ;
    skos:definition "Small subordinate ribs, inserted between the main ribs of Gothic vaults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liernes"@en .

aat:300266288 a skos:Concept ;
    skos:definition "Secondary ribs springing from the main springer or central boss of vaults and leading to the ridge ribs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiercerons"@en .

aat:300266289 a skos:Concept ;
    skos:definition "Ribs which span at right angles to the longitudinal axis of the space being spanned, dividing it into bays or compartments; for arches separating the bays of vaults, particularly in a groin- or barrel-vaulted space, use \"transverse arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transverse ribs"@en .

aat:300266290 a skos:Concept ;
    skos:definition "Ribs, usually decorative, located where a vaulted space abuts a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall ribs"@en .

aat:300266291 a skos:Concept ;
    skos:definition "A piece of lead used by scribes after the 12th century to create rules or sketches of layouts on parchment pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plummets"@en .

aat:300266294 a skos:Concept ;
    skos:definition "Devices that house a fixed (non-removable) hard disk for storage and retrieval of digital computer data. To refer to the disks themselves, use \"hard disks,\" to generally refer to mechanisms that use magnetic media for storage on disks, either fixed or removable, use \"disk drives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hard drives"@en .

aat:300266297 a skos:Concept ;
    skos:definition "Technique used in computer imaging to counteract the jagged effect seen in curved or diagonal lines, caused by pixelation. It involves the interpolation of intermediate colors where differing colors meet on computer monitors and printouts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anti-aliasing"@en .

aat:300266300 a skos:Concept ;
    skos:definition "Cameras that record an image in half of the area of the conventional 35mm film frame for still photography. The image area usually measures 18x24mm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half-frame cameras"@en .

aat:300266302 a skos:Concept ;
    skos:definition "Devices on which sound is recorded onto magnetic tape, and may be replayed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape recorders"@en .

aat:300266303 a skos:Concept ;
    skos:definition "Computer memory that contains fixed information, such as a program, that does not change, and cannot be written to, only read from."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ROM"@en .

aat:300266304 a skos:Concept ;
    skos:definition "Books that are valuable due to their actual or prospective rarity, specifically books distinguished by an early publication date, limited issue, historical interest, or a special characteristic of the edition or binding, for example having been signed by the artist or containing special illustrations. This designation typically includes books that are collected by a special collections department, archives, or museum, as opposed to books that are available to casual readers on the shelves of a public library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rare books"@en .

aat:300266305 a skos:Concept ;
    skos:definition "Persons or animals that issue from immediate or remote ancestors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "descendants"@en .

aat:300266306 a skos:Concept ;
    skos:definition "Contests in which the participants prepare a recipe in a fixed amount of time. Although the term has been trademarked by the Pillsbury Company since 1950, it is found without the tradmark designator in dictionaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bake-Offs (TM)"@en .

aat:300266307 a skos:Concept ;
    skos:definition "Computer graphics technology as applied to special effects for motion pictures. The term is used generally to refer to images that mimic the appearance of three dimensional objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CGI"@en .

aat:300266308 a skos:Concept ;
    skos:definition "Cultural movement of Italy from the 1920s to the 1940s, which rejected modernist tendencies in art and literature. Proponents of the Strapaese movement encouraged a provincial lifestyle and a focus on the Italian past. The movement was associated with both Nationalism and Fascism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strapaese"@en .

aat:300266309 a skos:Concept ;
    skos:definition "Events taking place once every two years, especially art exhibitions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biennials"@en .

aat:300266310 a skos:Concept ;
    skos:definition "Exhibitions occurring once every three years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triennials"@en .

aat:300266311 a skos:Concept ;
    skos:definition "Art Nouveau movement in Poland including the visual arts, literature, and music. The group of artists involved in the movement were active ca. 1890/1918."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Young Poland"@en .

aat:300266313 a skos:Concept ;
    skos:definition "A type of mourning jewelry that incorporates human hair in its manufacture. Usually refers to intricately woven or braided strands, set in gold and made into bracelets, necklaces or watch fobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairwork jewelry"@en .

aat:300266314 a skos:Concept ;
    skos:definition "North American avant-garde movement in music and cinema. The term is rarely extended to painting and sculpture. The movement was peculiar to New York City, specifically the Lower East Side ca. 1978-1981. The music is characterized by harsh dissonance, unstudied musicianship, and the aggressive attitudes of its performers. Musicians and visual artists often appeared as actors in films, usually fictional narratives shot with Super 8 sound film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "No Wave"@en .

aat:300266315 a skos:Concept ;
    skos:definition "A standardized chart of the chemical elements laid out in sequence by atomic number, arranged in horizontal rows and vertical columns, called periods and groups, so that elements with similar properties are in the same column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periodic table"@en .

aat:300266316 a skos:Concept ;
    skos:definition "Indian state-sponsored manufactories for the production of multiple kinds of art and craft, including weaving, manuscript illumination, enameling and jewelry making. They were established during the Sultanate and Mughal periods in India; they later became vocational centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karkhanas"@en .

aat:300266317 a skos:Concept ;
    skos:definition "Refers to enthusiasts of cinema: persons knowledgeable about motion pictures or filmmaking. Not used for people engaged in creating films such as directors, cinematographers, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cineastes"@en .

aat:300266319 a skos:Concept ;
    skos:definition "An aesthetic and social movement of the late 19th century that originated in England and spread to the United States, Germany, and Northern Europe. A reaction against industrialization and the quality of manufactured goods, the movement is marked by a desire to revive the craftsmanship associated with traditional arts, a form follows function philosophy, and an idealized view of the medieval craft guilds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arts and Crafts"@en .

aat:300266322 a skos:Concept ;
    skos:definition "Devices that convert acoustical sound waves into corresponding variations in electrical current that are then amplified, transmitted, or recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microphones"@en .

aat:300266323 a skos:Concept ;
    skos:definition "Use to describe financial statements outlining royalties to be paid to an artist, writer, musician, or other creator, based on profits made by a publisher from reproduced or copyrighted works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royalty statements"@en .

aat:300266324 a skos:Concept ;
    skos:definition "Ware styles belonging to Hizen cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hizen ware styles"@en .

aat:300266325 a skos:Concept ;
    skos:definition "Coins, specifically the nickels designed by James E. Fraser and minted in the United States between 1913 and 1938, which were hand-carved by itinerant American workers of the time, many of whom were homeless. The coins used the nickels' images as their base, and were altered to depict images of loved ones or friends, then subsequently traded for meals, a place to sleep, or other favors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hobo nickels"@en .

aat:300266326 a skos:Concept ;
    skos:definition "Use to describe roofed underground water cisterns or reservoirs, fed by qanats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "āb-anbārs"@en .

aat:300266327 a skos:Concept ;
    skos:definition "Celebrations or gatherings held for the presentations of newly mounted art exhibits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhibition openings"@en .

aat:300266328 a skos:Concept ;
    skos:definition "Parts or components of cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera components"@en .

aat:300266329 a skos:Concept ;
    skos:definition "Use to describe camera shutters that are situated near the plane of focus, rather than coincident with the lens. Focal-plane shutters are usually a type of dual-curtain or roller-blind device made of cloth or metal that can form openings of various sizes that correspond to exposure times. The curtains are held in tension until the moment of exposure, when the slit is pulled across the film, exposing it to light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "focal-plane shutters"@en .

aat:300266330 a skos:Concept ;
    skos:definition "Mechanisms used in cameras that allow light to pass through an aperture and expose a frame of film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shutters"@en .

aat:300266331 a skos:Concept ;
    skos:definition "Describes photographic shutter mechanisms that are mounted in lens barrels, between lens elements. These most generally have a leaf construction that act as a diaphragm that opens and shuts for specific lengths of time, thus exposing the camera film to light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "between-the-lens shutters"@en .

aat:300266332 a skos:Concept ;
    skos:definition "Czech avant-garde movement of the 1920s, spearheaded by Karel Teige and the group Devětsil. Poetism was an attempt to unify all the arts from literature to architecture, and was influenced by the other European avant-garde movements of the time, including the Futurist, Constructivist, Dada, and Surrealist movements. Poetism was eventually absorbed by the Czech Surrealist movement in the 1930s. Teige's theories encompassed not only the conventional arts of literature, painting, theater and architecture, but epicurianism, jazz music, the circus, and such entertainments as fireworks. All were considered \"poetry for the senses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poetist"@en .

aat:300266333 a skos:Concept ;
    skos:definition "Works used as test-pieces, often by apprentices, and presented to a guild to determine whether the makers were qualified to rank as masters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masterpieces"@en .

aat:300266334 a skos:Concept ;
    skos:definition "Multi-episodic films, presented one chapter at a time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serials"@en .

aat:300266335 a skos:Concept ;
    skos:definition "Large upright stones, arranged in the shape of a ship's plan, chiefly dating from the Iron and Viking Ages and found throughout Scandinavia. Sometimes containing one or more graves, it is believed that the stone serve as a funerary monument, perhaps to those lost at sea. It is also proposed that that alignment of the stones correspond to the rising and setting of the sun at the time of solstice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship-settings"@en .

aat:300266336 a skos:Concept ;
    skos:definition "A soft, plastic, non-drying, claylike substance, used for modelling. The original was invented by William Harbutt, an English art teacher, in 1897. There are various formulations made from calcium salts, petroleum jelly, and aliphatic acids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasticine"@en .

aat:300266337 a skos:Concept ;
    skos:definition "Style and culture of the people of the African language group of the same name living in Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Okpamheri"@en .

aat:300266338 a skos:Concept ;
    skos:definition "Style and culture of the people of the African language group of the same name living in Democratic Republic of the Congo and Zambia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lomotwa"@en .

aat:300266339 a skos:Concept ;
    skos:definition "An element with atomic number 7 and symbol: N. It is an odorless, gaseous element that makes up 78% of the earth's atmosphere, is a constituent of all living tissue, and is nearly inert in its gaseous form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrogen"@en .

aat:300266341 a skos:Concept ;
    skos:definition "Any nonhardening or slow to harden maleable material used to create sculptures or another form, excluding terracotta or another pure natural clay and any materials in powder form to which water must be added."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modeling clay"@en .

aat:300266342 a skos:Concept ;
    skos:definition "Flat plates made of concrete and used as structural elements in architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete slabs"@en .

aat:300266343 a skos:Concept ;
    skos:definition "Furniture specially designed for or used outdoors in a garden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden furniture"@en .

aat:300266344 a skos:Concept ;
    skos:definition "Furniture specially designed for or used outdoors on a porch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porch furniture"@en .

aat:300266345 a skos:Concept ;
    skos:definition "Furniture specially designed for or used outdoors in a patio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patio furniture"@en .

aat:300266348 a skos:Concept ;
    skos:definition "A product of brown seaweeds, usually kelp. It is used as a thickening agent, and commonly as an impermanent and non-toxic mold-making material, particularly in dental work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alginate"@en .

aat:300266350 a skos:Concept ;
    skos:definition "Indexes of the deceased by name, typically those that have appeared in obituaries of a newspaper or other publication over a designated period of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obituaries indexes"@en .

aat:300266351 a skos:Concept ;
    skos:definition "Microphones that function via a magnet that oscillates within a coil attached to a diaphragm. Sound waves cause the relative motion of the magnet and coil to create an electrical signal by magnetic induction. Dynamic microphones are the most commonly used in recording speech and music, due to their rugged design, but require more gain or amplification to render a signal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamic microphones"@en .

aat:300266352 a skos:Concept ;
    skos:definition "Small detached houses that are occupied by impoverished people or laborers, used for sheltering small animals, or for storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cotes"@en .

aat:300266353 a skos:Concept ;
    skos:definition "Microphones that respond to air velocity rather than air pressure of sound waves. This is accomplished via a ribbon of corrugated aluminum held between two magnets. Ribbon microphones were used extensively in radio and television broadcasting during the mid-20th century due to their broad dynamic range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbon microphones"@en .

aat:300266354 a skos:Concept ;
    skos:definition "Floating houses or shacks on the water, usually a river; characterized by their small size and having been quickly built, often ramshackle. May refer specifically to houseboats built as temporary housing by lumbermen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shanty boats"@en .

aat:300266355 a skos:Concept ;
    skos:definition "Open-air museums in which archaeological evidence and scholarly research inform the reconstruction, restoration, or recreation of the original site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living history museums"@en .

aat:300266356 a skos:Concept ;
    skos:definition "Activities that cause the reduction of a corpse to ashes, generally as a way of disposing of it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cremations"@en .

aat:300266357 a skos:Concept ;
    skos:definition "Devices combining an un-manned camera and a mechanism to trigger the capturing of a still or moving image. The triggering mechanism may comprise a motion sensor, an infrared sensor, or a light beam, or it may be mechanical, as when an animal tugs at bait or passes in proximity to the camera. An example of usage is to capture pictures of animals in the wild."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera traps"@en .

aat:300266358 a skos:Concept ;
    skos:definition "The ashes of a cremated person or animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cremains"@en .

aat:300266359 a skos:Concept ;
    skos:definition "Sculpted works comprising groups of figures, similar in scale and size to crèches, that depict the Crucifixion and other events of the Christian Holy Week."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passionskrippen"@en .

aat:300266360 a skos:Concept ;
    skos:definition "Japanese style coined by artist Takashi Murakami, which describes contemporary artwork influenced by the two-dimensional style of Japanese animation (anime, manga, etc.)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Superflat"@en .

aat:300266361 a skos:Concept ;
    skos:definition "Payments made to inventors or creators for the right to reproduce or perform their works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royalties"@en .

aat:300266362 a skos:Concept ;
    skos:definition "Computer memory which acts as the primary storage for programs and data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "RAM"@en .

aat:300266363 a skos:Concept ;
    skos:definition "Telecommunication system with transmission and reception of electromagnetic waves from 10 to 80 meters in length, and frequencies larger than 3000 kilohertz."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shortwave radio"@en .

aat:300266364 a skos:Concept ;
    skos:definition "Illuminated sculptures, or lanterns, that are based on traditional Japanese lantern-making craft. Coined by Isamu Noguchi to describe the objects he designed and that are manufactured in Gifu, Japan, from paper made from mulberry tree bark; and that are considered to be a union of sculpture and functional object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "akaris"@en .

aat:300266365 a skos:Concept ;
    skos:definition "Hide glue made from rabbits. Used as a primer for canvases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbitskin glue"@en .

aat:300266366 a skos:Concept ;
    skos:definition "Microphones that have a diaphragm constructed of metal or metal-coated plastic film, stretched before an electrode. This diaphragm is depressed by sound waves causing a change in the distance between the diaphragm and electrode, causing a voltage change that is subsequently rendered as recorded, amplified, or broadcast sound. These microphones require a separate source of electrical current to operate, unlike dynamic or ribbon microphones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condenser microphones"@en .

aat:300266367 a skos:Concept ;
    skos:definition "Music, often improvisational, originally developed around the turn of the 20th century by African Americans from elements of blues and ragtime, with syncopated rhythms and a European harmonic structure. Jazz consistently evolved throughout the 20th century with numerous phases, from a New Orleans style or swing, to \"free jazz,\" for example, which emerged in the late 1950s. Therefore, jazz itself has no precise definition, however it has rarely been a completely composed music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jazz"@en .

aat:300266368 a skos:Concept ;
    skos:definition "Belts that conducted electrical current to the body; advertised in the 19th and 20th centuries as curative instruments, though without scientific evidence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric belts"@en .

aat:300266369 a skos:Concept ;
    skos:definition "Circular charts displaying information with wedge-shaped or concentric segments, or using a combination of the two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel charts"@en .

aat:300266370 a skos:Concept ;
    skos:definition "Assistants to priests and deacons, who generally perform duties such as lighting and bearing candles. The term is also used, by extension, in a general sense to refer to any novice or assistant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acolytes"@en .

aat:300266371 a skos:Concept ;
    skos:definition "Art works, including performance art, designed specifically to interact with an existing work, structure, environment, or situation, be it another artwork, the audience, an institution, or in the public domain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art interventions"@en .

aat:300266372 a skos:Concept ;
    skos:definition "Earthenware pottery that is turned on a horizontal lathe and decorated with colored slip; term is used especially for vessels produced by late 18th- and 19th-century British potteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dipped ware"@en .

aat:300266373 a skos:Concept ;
    skos:definition "Large anti-aircraft gun blockhouses used by the Luftwaffe in World War II to protect against Allied overflights, serve as air-raid shelters, and to coordinate air defence. They had concrete walls up to 3.5 meters thick and were considered invulnerable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiaircraft towers"@en .

aat:300266374 a skos:Concept ;
    skos:definition "Compounds consisting of the chemical element barium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium compounds"@en .

aat:300266375 a skos:Concept ;
    skos:definition "Barium compound and fixative which, when used with ammonium carbonate solution, can repair the deterioration caused by calcium sulphate crystallization on fresco surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium hydroxide"@en .

aat:300266376 a skos:Concept ;
    skos:definition "Computer software technique for rendering virtual models of three-dimensional terrain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital terrain modeling"@en .

aat:300266377 a skos:Concept ;
    skos:definition "Distinctive photographs made from a hand-colored positive image process used from the 1880s through 1910, intended to give the appearance of painting on glass. An albumen paper print is adhered to a curved piece of glass and sanded from the back to the emulsion layer. A layer of oil is applied to render it translucent, and detailed color is applied to the back. When dry, a second layer of curved glass is added, and painted with broad fields of color. A layer of white material was applied behind this, and everything bound together. The glass, solutions, and adhesives were available commercially until World War I. The process was based on 18th-century hand-colored engravings known as mezzotint paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crystoleums"@en .

aat:300266378 a skos:Concept ;
    skos:definition "The Prophet Muhammad's birthday, which traditionally falls on the 12th day of the month of Rabīʻ al-Awwal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mawlid al-Nabī"@en .

aat:300266379 a skos:Concept ;
    skos:definition "Painting technique in which hair, usually human hair, was ground up, mixed with glue, and used as pigment or texture. Examples are often miniature paintings dating from the 17th century onward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair painting"@en .

aat:300266380 a skos:Concept ;
    skos:definition "Islamic holiday generally falling on the 27th of the month of Ramaḍān. Some Muslims spend this night in prayer or retreat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laylat al-Qadr"@en .

aat:300266381 a skos:Concept ;
    skos:definition "Cameras used for surveillance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surveillance cameras"@en .

aat:300266382 a skos:Concept ;
    skos:definition "Poems consisting of 14 decasyllabic lines, often in a rhyming scheme. The sonnet form is considered to be of Italian origin, appearing in the 13th century in Sicily, after which it spread to Tuscany, where Petrarch perfected the form with his Canzioniere, a series of 317 sonnets to his idealized love, Laura. The Petrarchian sonnet has historically been the most widely used of the form, although the Elizabethan form (3 quatrains, with a final rhyming couplet) is also common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sonnets"@en .

aat:300266383 a skos:Concept ;
    skos:definition "Poems with six stanzas of six lines each. The last words of the first stanza are repeated, in a different order, in the other five stanzas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sestinas"@en .

aat:300266384 a skos:Concept ;
    skos:definition "Fees charged to allow entry into an exhibition, event, museum, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "admission fees"@en .

aat:300266385 a skos:Concept ;
    skos:definition "Mines where salt is excavated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt mines"@en .

aat:300266386 a skos:Concept ;
    skos:definition "The name by which an individual person is identified or known, as distingushed from names for corporate bodies or other entities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal names"@en .

aat:300266388 a skos:Concept ;
    skos:definition "Reporters in a war zone who are assigned to a military unit and who travel with that unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embedded reporters"@en .

aat:300266389 a skos:Concept ;
    skos:definition "A fabricated wood product produced in the 1920s by the Italian paper industry as a decorative coating and finishing material used mainly for interiors and furnishings, especially intarsia work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buxus"@en .

aat:300266391 a skos:Concept ;
    skos:definition "Knives, often serving knives or carving knives, having an inscription on the blade, which is usually a blessing for the meal or the server."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benediction knives"@en .

aat:300266392 a skos:Concept ;
    skos:definition "Refers to the architectural style of villas built for the British on the French and Italian Rivieras, ca. 1870-ca. 1950, or of architecture imitating the style of these villas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Mediterranean"@en .

aat:300266395 a skos:Concept ;
    skos:definition "Communities that were of a relatively large size, but are now abandoned by their occupants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned cities"@en .

aat:300266397 a skos:Concept ;
    skos:definition "Rooms or other designated spaces reserved for meditation practice, usually a quiet space that is free from distractions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meditation rooms"@en .

aat:300266398 a skos:Concept ;
    skos:definition "Allotment gardens typical in German urban areas cultivated by individuals and used to provide agricultural and recreational space. The schrbergatren originated in Leipzig in the 1860s, and was named after the educational reformer Daniel Gottlob Moritz Schreber (1808-1861)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schrebergartens"@en .

aat:300266399 a skos:Concept ;
    skos:definition "Style that refers back to the original Symbolist movement, characterized by a complex synthesis of psychology, mystical and occult practices, and linguistics used to challenge traditional relationships between representation and meaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Symbolist"@en .

aat:300266400 a skos:Concept ;
    skos:definition "Various bright scarlet reds of varying degrees of value, resembling the color of the pigment vermilion, which is synthetic red mercuric sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vermilion"@en .

aat:300266403 a skos:Concept ;
    skos:definition "Pottery to which a simple, low firing glaze was applied. Lead glazes may be sprinkled or thinly painted on a clay body. Lead glazes are used on clay that can be fired below its volatilization temperature of about 1150C. Lead glazes produce a lustrous, opaque surface, but they are no longer in common use because of the potential for lead poisoning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead-glazed ware"@en .

aat:300266405 a skos:Concept ;
    skos:definition "Archaeology that explores the emergence of the Modern World, from around 1400 CE to the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical archaeology"@en .

aat:300266409 a skos:Concept ;
    skos:definition "Recordable compact discs. CD-Rs have a light-sensitive layer which can be recorded onto, or \"burned,\" by a CD-recorder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CD-Rs"@en .

aat:300266410 a skos:Concept ;
    skos:definition "Recordable compact discs which are rewritable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CD-RWs"@en .

aat:300266412 a skos:Concept ;
    skos:definition "Rubber cushions, usually filled with compressed air, which fit around the wheels of a vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tires"@en .

aat:300266413 a skos:Concept ;
    skos:definition "Plantings of bushes or woody plants in a row as a formal element of a landscape or as a barrier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hedges"@en .

aat:300266414 a skos:Concept ;
    skos:definition "General term for material comprising grass that has been mown, cut, and cured; often used as fodder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hay"@en .

aat:300266415 a skos:Concept ;
    skos:definition "Long-haired breed of domestic cats originally raised in Persian and Afghanistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian cats"@en .

aat:300266416 a skos:Concept ;
    skos:definition "The decorative technique of scratching through one surface layer, such as on a wall, slip on a pot, or the surface of glass, so as to reveal a layer beneath. For non-decorative, casual, or defacing marks on walls or other surfaces ancient or modern, use \"graffiti.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sgraffito"@en .

aat:300266417 a skos:Concept ;
    skos:definition "The fruit of trees in the Malus genus. Domestic apples are usually green, red, or yellow, cultivated in temperate zones worldwide in a multitude of varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apples"@en .

aat:300266418 a skos:Concept ;
    skos:definition "Breed of dog that is large, powerfully built, with a massive head and drooping ears, standing a minimum of 25 inches (63.5 cm), and weighing up to 200 lbs (91 kg). Its coat is red-brown and white or brindle and white and may be either short and dense or medium-long. They are bred as pathfinders and rescue dogs at the hospice founded by St. Bernard of Montjoux in Great St. Bernard Pass in the Pennine Alps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "St. Bernards"@en .

aat:300266419 a skos:Concept ;
    skos:definition "Motif of fruit, flowers, and foliage in three-dimensional friezes, particularly as used by architects and carvers in the 17th-18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encarpus"@en .

aat:300266420 a skos:Concept ;
    skos:definition "Pulpy fruits covered with fairly thick skins from the genus Citrus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citrus fruit"@en .

aat:300266421 a skos:Concept ;
    skos:definition "Breed of dog thought to have originated in Germany, but so poular in France it is the national dog of that country. The poodle was developed as a water retriever, and is clipped with its distinctive coat to increase its efficiency in the water. The poodle has been bred in three size varieties: standard, miniature, and toy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poodles"@en .

aat:300266422 a skos:Concept ;
    skos:definition "Large citrus fruits with yellow skin and a juicy, bitter pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grapefruits"@en .

aat:300266423 a skos:Concept ;
    skos:definition "Citrus fruits with an oval shape, yellow skin, with acidic, juicy pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemons"@en .

aat:300266424 a skos:Concept ;
    skos:definition "General term for a number of different citrus fruits, both established species and hybrids, that are typically round, green to yellowish green in color, containing acidic pulp that is sweeter than lemons, and of a size usually smaller than lemons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limes"@en .

aat:300266426 a skos:Concept ;
    skos:definition "Fruits (drupaceous nuts) from any of several species of walnut tree, having a two-lobed seed covered with a fleshy husk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walnuts"@en .

aat:300266427 a skos:Concept ;
    skos:definition "Kidney-shaped nuts of the cashew tree that are edible when roasted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cashew nuts"@en .

aat:300266428 a skos:Concept ;
    skos:definition "Nuts of the chestnut tree, two or more of which are inclosed in a prickly 'burr.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chestnuts"@en .

aat:300266430 a skos:Concept ;
    skos:definition "Use to describe large cylindrical or spherical tanks containing gas used for fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasholders"@en .

aat:300266431 a skos:Concept ;
    skos:definition "Type of arabesque used in Ottoman pottery in the Iznik style, dating from the mid 15th century. Hatayi employs a complex pattern of foliage such as lotus palmettes, curving vines, and feathery leaves, and often includes birds, cloud bands, dragons, and beasts. Resembling the motifs in Chinese decorative styles from which it evolved, \"hatayi\" means \"Chinese\" or \"in the Cathayan manner\" in Turkish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hatayi"@en .

aat:300266432 a skos:Concept ;
    skos:definition "According to the botanical definition, fruit with a structure (the core) that clearly separates the seeds from the ovary tissue. Fruit that is characteristic of the pome is the apple. Small fruits commonly called \"berries\" are really pomes, such as the hawberries and juneberries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pomes"@en .

aat:300266433 a skos:Concept ;
    skos:definition "A very narrow stipe repeated at intervals, usually present in woven or printed cloth, but also used to describe such a stripe in paintings or other works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinstripes"@en .

aat:300266434 a skos:Concept ;
    skos:definition "Fruits of various species of genus Musa. The fruits are technically berries, growing in clusters of angular, finger-like fruits that contain highly nutritious pulp within the rind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bananas"@en .

aat:300266435 a skos:Concept ;
    skos:definition "Berry of the tomato plant, which is cultivated as a garden vegetable in temperate and tropical lands. The fruit varies in color from red to yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomato"@en .

aat:300266436 a skos:Concept ;
    skos:definition "Fruits of several species in the genus Mangifera, but most often referring to the species Mangifera indica, native to India and Burma (Myanmar); it is a sweet orange-fleshed drupe which is much eaten as dessert, especially in the tropics, and is used in its unripe state to make chutney and jam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mangoes"@en .

aat:300266437 a skos:Concept ;
    skos:definition "According to the botanical definition, fleshy fruits produced from a single-seeded ovary (occasionally multi-seeded) with a hard stony layer or endocarp surrounding the seed. They are typically characterized by having an outer skin, a thick, fleshy middle layer, and an inner pit that is hard and stony. Also known as stone-fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drupes"@en .

aat:300266438 a skos:Concept ;
    skos:definition "Drupes, or stone-fruits, from several trees of the genus Prunus. The plum usually has red, purple, or yellow skin, and when ripe, a powdery bloom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plums"@en .

aat:300266439 a skos:Concept ;
    skos:definition "Power tools used for boring holes or setting screws. Generally used for hand-held tools that are operated electrically via alternating or direct current, this term may also be extended to large machinery used to dig tunnels for mining or transportation purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power drills"@en .

aat:300266440 a skos:Concept ;
    skos:definition "Oval drupe, or stone-fruit, of the olive tree. The edible olive has been cultivated since approximately 3500 BCE, generally in warm climates. There are hundreds of named varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olives"@en .

aat:300266441 a skos:Concept ;
    skos:definition "Traditional foliate and vegetal arabesques in the Turkish Ottoman decorative style dating from the 15th century. The pattern depicts long, pointed split-leaves with curved sides and prehensile tips, often tightly strung together with classical vines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rumi"@en .

aat:300266442 a skos:Concept ;
    skos:definition "An irregular check pattern, most commonly appearing in woven fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "houndstooth"@en .

aat:300266443 a skos:Concept ;
    skos:definition "Berry developed from an inferior ovary, with a hard outer rind and numerous seeds attached to parietal placentas. The characteristic fruit of the gourd family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pepo"@en .

aat:300266444 a skos:Concept ;
    skos:definition "Fruits of various kinds of edible gourd, most often used for the fleshy fruits of various members of the Cucurbitaceae family, which grow as a vine. The fruit is typically large and globose to oblong, with a smooth, netted, or warty rind, and sweet pulpy flesh colored red, light green, orange, or yellowish pink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melon"@en .

aat:300266445 a skos:Concept ;
    skos:definition "Revitalized industrial architecture used as hotels, or hotels having a design imitating industrial design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hôtels industriels"@en .

aat:300266446 a skos:Concept ;
    skos:definition "Broad term describing fruit in which the pericarp and accessory parts develop into succulent tissues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fleshy fruit"@en .

aat:300266447 a skos:Concept ;
    skos:definition "Fruit where the entire pericarp is dry at maturity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry fruit"@en .

aat:300266448 a skos:Concept ;
    skos:definition "A kind of pigment of that is blue, light blue, bluish green, or green, usually prepared by adding chalk or whiting to a solution of nitrate of copper, or to ground azurite (blue) or malachite (green). Primarily used in making crayons and watercolors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verditer"@en .

aat:300266449 a skos:Concept ;
    skos:definition "Copper carbonate pigment that is green in color rather than blue, counterpart to natural malachite pigment. It tends to have regularly sized particles with rounded edges with a paler color than natural malachite pigment. Natural malachite was occasionally used in tempera-based paintings before the 16th century and later, green verditer was used for both distemper and oil based interior house paints in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green verditer"@en .

aat:300266450 a skos:Concept ;
    skos:definition "A copper-based mineral, copper carbonate hydroxide, that is often used in jewelry ranging from very deep blue to pale blue. Azurite is often found in association with the green mineral malachite, resulting from weathering and oxidation of copper sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azurite"@en .

aat:300266451 a skos:Concept ;
    skos:definition "Material comprising the leaves and stems of various species of grass of the Saccharum genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugarcane"@en .

aat:300266452 a skos:Concept ;
    skos:definition "The thick, brown, uncrystallized syrup drained from raw sugar, particularly the concentrated syrup obtained from sugar during the process of refining from cane or beet juice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molasses"@en .

aat:300266453 a skos:Concept ;
    skos:definition "A generic term for a group of polysaccharides that are located in the cell walls of all plant tissues. Pectin is composed of methoxylated galacturonic acids joined in long chains. The main commercial sources of pectin are citrus peel and apple pomace. Pectin dissolves in water to produce viscous stable solutions. They are mainly used for food products (jams and jellies) but are also found as sizing agents in paper and textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pectin"@en .

aat:300266454 a skos:Concept ;
    skos:definition "Fluid secreted by the lacrimal apparatus. Tears, along with other secretions, help form the protective, precorneal film on the exterior of the eye. Tears can be reflexly secreted in response to a variety of stimuli (bright lights, etc.). The secretion of tears as a result of emotional upset is called psychical weeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tear"@en .

aat:300266455 a skos:Concept ;
    skos:definition "Moisture excreted through the pores of the skin of most mammals, usually as a result of physical exertion or heat, in order to cool the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perspiration"@en .

aat:300266457 a skos:Concept ;
    skos:definition "Elaborated details projecting laterally at the corners of door and window frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crossettes"@en .

aat:300266458 a skos:Concept ;
    skos:definition "Hard, central wood of the trunks of dead trees. Usually, heartwood contains tannins which make it aromatic and dark in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heartwood"@en .

aat:300266466 a skos:Concept ;
    skos:definition "Joints in which a thin strip of wood (spline), acts as an independent tongue that fits simultaneously into corresponding grooves cut in two butted or mitered boards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spline joints"@en .

aat:300266469 a skos:Concept ;
    skos:definition "Powdered glass that is colored deep blue by oxide of cobalt. After cooling, the glass is finely pulverized for use as a pigment or for brightening whites in laundry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smalt"@en .

aat:300266470 a skos:Concept ;
    skos:definition "Lengthy speeches by one actor in a film, play, or broadcast production, or a dramatic composition performed by one person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monologues"@en .

aat:300266471 a skos:Concept ;
    skos:definition "Areas of objects where converging lines or surfaces meet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corners"@en .

aat:300266472 a skos:Concept ;
    skos:definition "Parts or components of joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint components"@en .

aat:300266473 a skos:Concept ;
    skos:definition "Cavities or openings in wood or other material that is meant to receive a corresponding component, or \"tenon,\" that, connected, forms a joint. In architecture, to refer to the complete joint so formed, use \"mortise-and-tenon joints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortises"@en .

aat:300266474 a skos:Concept ;
    skos:definition "Colorless and odorless acid found in the juices of most fruits, as well as other plants, many animal tissues, and fluids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citric acid"@en .

aat:300266475 a skos:Concept ;
    skos:definition "A projection on the end or side of a piece of wood, stone, or other material that fits into a corresponding opening to form a joint. Used variously to refer to projection element of joints in architecture; or musical instruments with multiple sections, such as oboes or clarinets. To refer to joints so formed in architecture use \"mortise-and-tenon joints.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenons"@en .

aat:300266476 a skos:Concept ;
    skos:definition "Type size, standardized at 12 point, often used for type or plate areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pica"@en .

aat:300266477 a skos:Concept ;
    skos:definition "Unit of measurement for computer file storage equal to approximately one trillion bytes. Specifically, 1,099,511,627,776 bytes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terabytes"@en .

aat:300266478 a skos:Concept ;
    skos:definition "Strips of metal used for spacing. Also, a line of type cast by a Linotype machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slugs"@en .

aat:300266479 a skos:Concept ;
    skos:definition "Short articles, usually related to a long article, but separated visually on the page."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sidebars"@en .

aat:300266480 a skos:Concept ;
    skos:definition "The young of any bird, especially the young bird still in the egg or only just hatched."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chicks"@en .

aat:300266481 a skos:Concept ;
    skos:definition "Styles and cultures existing in the extensive area that includes the nations of southwest Asia and northeastern Africa. The term was formerly used to also include Afghanistan, Pakistan, India, and Burma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle Eastern"@en .

aat:300266482 a skos:Concept ;
    skos:definition "Parts or components of letterforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterform components"@en .

aat:300266483 a skos:Concept ;
    skos:definition "Short cross-strokes at the top or bottom of a letter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serifs"@en .

aat:300266484 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Asturias region of northern Spain (modern Oviedo), particularly the cultures of the Medieval eighth- and ninth-century kingdom of Asturias. It is characterized by the retention and development of classical Roman forms and architectural techniques, anticipating the Romanesque style in Europe by two centuries. This style differs from contemporary Carolingian style in its distinct architectural iconography, often including walls of \"petit appareil,\" stilted brick arches, ashlar quoins, and timber roofs with small barrel vaults over the apses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asturian"@en .

aat:300266485 a skos:Concept ;
    skos:definition "Vertical, horizontal, or oblique motions of letterforms in a typeface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strokes"@en .

aat:300266486 a skos:Concept ;
    skos:definition "White spaces that are partly or wholly enclosed by the strokes of a letter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counters"@en .

aat:300266488 a skos:Concept ;
    skos:definition "Songs with rhyming verse and a narrative; some ballads are slow, romantic songs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballads"@en .

aat:300266489 a skos:Concept ;
    skos:definition "Sailor's rhythmic songs, especially those sung while undertaking labor aboard ship; for example, shanties may be sung when a group is manipulating heavy sails by means of ropes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shanties"@en .

aat:300266490 a skos:Concept ;
    skos:definition "Cultural movement encompassing DJing, rap and rap music, dance and dance music, graffiti writing, and styles of dress. The movement began in the 1970s, in the South Bronx section of New York City, a depressed, predominantly African American neighborhood. The popularity of rap music in particular throughout the 1980s to the present, helped turn hip-hop into an international movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hip-hop"@en .

aat:300266493 a skos:Concept ;
    skos:definition "Members of a family containing around 80 species of small, dark-barred brownish birds with a short bill slightly downcurved, short rounded wings, and a short cocked tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Troglodytidae"@en .

aat:300266494 a skos:Concept ;
    skos:definition "Memebers of a family containing over 65 species of medium-size songbirds native to the New World, all with crested heads. Cardinal males typically have bright red plumage, and all are nonmigratory and give clear, whistled songs. The northern cardinal (Cardinalis cardinalis) is the only red North American bird with a crest, and is the official state bird bird of seven eastern U.S. states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cardinalidae"@en .

aat:300266495 a skos:Concept ;
    skos:definition "Members of a subfamily containing about 180 species in many genera of birds noted for having variegated plumage of bright contrasted colors with various markings and probing for insects in tree bark and for boring nest holes in dead wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picinae"@en .

aat:300266496 a skos:Concept ;
    skos:definition "A stereoscopic viewing device that uses a wheel or reel of slides to present two images, isolated for each eye, that together create a three-dimensional optical effect. Invented by William Gruber in 1938 as an educational device, it has been marketed as a children's toy since that time under the trademarked name \"View-Master.\" For the device used to view individual stereo cards, popular in the 19th century, use \"stereoscopes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereoviewers"@en .

aat:300266497 a skos:Concept ;
    skos:definition "Members of a genus containing two living species of large North American birds having a distinctive fleshy wattle that hangs from the underside of the beak, and a fleshy protuberance that hangs from the top of its beak called a snood. It prefers woodlands near water, eating seeds, insects, and an occasional frog or lizard. When alarmed it may run rapidly to cover, but it can fly strongly for only short distances. Turkeys were first domesticated for their feathers and meat in Pre-Columbian Mexico; they were introduced to Europe, and are now valued as a table fowl in numerous countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Meleagris"@en .

aat:300266498 a skos:Concept ;
    skos:definition "Amusement devices or toys comprising a box and images, often a reel of images, that are viewed through a hole cut into the box."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panorama boxes"@en .

aat:300266499 a skos:Concept ;
    skos:definition "Churches having a centralized, circular plan; examples are the round churches popular in Scandinavia in the 11th and early 12th centuries. For churches with a round floorplan but that are in the form of a tower, use \"round-tower churches.\" For churches having a centralized that is polygonal rather than circular, use \"polygonal churches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round churches"@en .

aat:300266502 a skos:Concept ;
    skos:definition "Members of a genus containing three species in of North American birds in the chat-thrush group distinguished by having coloration that is blue or blue with red breasts; female birds are less brightly colored than males, although color patterns are similar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sialia"@en .

aat:300266503 a skos:Concept ;
    skos:definition "In heraldry design, human or animal figures that hold or support the coat of arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armorial supporters"@en .

aat:300266504 a skos:Concept ;
    skos:definition "Sleeves used in armor, made of mail, which is a metal fabric consisting of iron or steel rings, riveted or pressed together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeves of mail"@en .

aat:300266505 a skos:Concept ;
    skos:definition "Pieces of defensive armor in the form of a coat, covering the upper part of the body, having interlaced rings or overlapping plates of steel, usually over a quilted linen or leathern jacket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coats of mail"@en .

aat:300266506 a skos:Concept ;
    skos:definition "The class of vertebrate animals that are typically bipedal and warm-blooded, lay large-yolked hardshelled eggs, often arboreal, and possessing feathers, hollow bones, forelimbs adapted for flight (although some have lost the ability to fly) and hindlimbs for perching and locomotion, a four-chambered heart, keen vision, a horny beak without teeth, and a large muscular stomach. Birds arose from theropod dinosaurs, which were an order of carnivorous dinosaurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aves"@en .

aat:300266507 a skos:Concept ;
    skos:definition "Adult female birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hens"@en .

aat:300266508 a skos:Concept ;
    skos:definition "Films that are based on or are adaptations of a previous film or script, usually with the roles played by different actors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film remakes"@en .

aat:300266509 a skos:Concept ;
    skos:definition "Objects on which to place an inked pen during use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pen rests"@en .

aat:300266510 a skos:Concept ;
    skos:definition "Phylum that includes such diverse animals as the clams, mussels, scallops, oysters, and cockles, as well as slugs, snails, nautiluses, cuttlefishes, squids, and octopuses. Mollusks are wholly or partly enclosed in a calcium carbonate shell secreted by a soft mantle covering the body. Different species occur in marine, freshwater, and terrestrial habitats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mollusca"@en .

aat:300266512 a skos:Concept ;
    skos:definition "Small, fishlike marine invertebrates that are probably the closest living relatives of the vertebrates. Their distinguishing characteristics include a notochord that extends the entire body length, with tip anterior to nerve cord; an atrium that is a single cavity with single ventral opening, but no heard; segments that are well developed; a head poorly developed; and no paired fins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cephalochordata"@en .

aat:300266513 a skos:Concept ;
    skos:definition "Phylum that includes common vertebrates such as fishes, amphibians, reptiles, birds, mammals, as well as the tunicates and lancelets. With few exceptions, chordates are active animals with bilaterally symmetric bodies that are longitudinally differentiated into head, trunk, and tail. The most distinctive morphological features of chordates are the notochord, nerve cord, and visceral clefts and arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chordata"@en .

aat:300266516 a skos:Concept ;
    skos:definition "Family containing nine species in six genera, characterized as being large, short-tailed, having stocky legs, a long snout, shaggy hair, and plantigrade paws with five non-retractile claws. Bears are generally omnivorous, but some bears are entirely carnivorous (like the polar bear ) or vegetarian (like the panda)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursidae"@en .

aat:300266518 a skos:Concept ;
    skos:definition "Pens with a tubular, needlelike point for which the ink supply is controlled by a check valve and released only when pressure is placed on the point; used for drawing precise, even lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylographs"@en .

aat:300266519 a skos:Concept ;
    skos:definition "Pens such as lettering pens, quill pens, reed pens, and others that must be dipped frequently into the ink in order to wet the pen point, as distinguished from pens such as fountain pens, felt-tip pens, and others that hold a reservoir of ink in the handle or holder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dip pens"@en .

aat:300266520 a skos:Concept ;
    skos:definition "General term referring to various members of the family Canidae, especially those of the genus Vulpes, such as the red or common, fox (V. vulpes), which lives in both the Old World and the New World. Several other foxes belong to genera other than Vulpes, including the North American gray fox, the Arctic fox, and the the bat-eared fox, and the crab-eating fox. Foxes resemble small dogs, with pointed snouts, large ears, and bushy tails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foxes"@en .

aat:300266522 a skos:Concept ;
    skos:definition "Pens such as fountain pens and others that hold a reservoir of ink in the handle, holder, or other receptacle, as distinguished from dip pens that require frequent dipping of the pen point in ink, such as lettering pens, quill pens, reed pens, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reservoir pens"@en .

aat:300266524 a skos:Concept ;
    skos:definition "Pens with a tip made of a very small cylindrical tube with one open end making contact with the writing surface and generally with the other end in contact with the ink supply (alternatively they may be dip pens). They are used primarily in recording instruments, but also for writing and drawing. They are distinguished from the many other types of pens that work via a tube and capillary action in that they do not have a ball point, felt tip, needle, or other object fitted into the tube of the writing tip, but instead use the small diameter of the tube and external air pressure to regulate the flow of ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capillary pens"@en .

aat:300266525 a skos:Concept ;
    skos:definition "Cameras that focus by means of a coupled or un-coupled rangefinder device. Though many cameras may be fitted with a rangefinder including some press or view cameras, this term is most commonly used to refer to cameras that rely solely on the rangefinder for composing and focusing, rather than a through-the-lens reflex system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rangefinder cameras"@en .

aat:300266526 a skos:Concept ;
    skos:definition "Refers to medium- to large-format folding cameras that generally share characteristics of the view camera such as rising fronts and tilt adjustments, including a drop-bed to accommodate wide angle lens objectives. So-called because the earliest models (ca. 1910) were intended for newspaper photographers requiring a sturdy camera with a large negative, and that could be handheld. Many are equipped with focal-plane shutters and wire frame viewers used to follow fast action. These characteristics, along with exceptional sturdiness of construction, are what distinguish them from the typical view camera. Press cameras were used primarily ca. 1910-1960; after this time 35mm cameras became the norm for news photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press cameras"@en .

aat:300266528 a skos:Concept ;
    skos:definition "Persian wool carpets made in Herat, characterized by a wine red field color, and a border of clear emerald green and asymmetrical knotting; often made of silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Herat carpets"@en .

aat:300266529 a skos:Concept ;
    skos:definition "Straight-edged strips or cylinders of medium size, usually of wood, metal, plastic, or ivory and having demarcations to indicate units of measurement, used for measuring and for guiding a pen, pencil, or other marking-instrument in forming straight lines upon paper or another material. They are used in geometry, drafting, drawing, carpentry, building, interior design, crafts, and other disciplines. For very long bars or strips of wood or metal having straight and true edges and used for a variety of purposes, including cutting or establishing the evenness of surfaces, use \"straightedges.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rulers"@en .

aat:300266530 a skos:Concept ;
    skos:definition "Refers to a cylindrical component in papermaking machines that impresses patterns, such as watermarks, onto the surface of the paper to impart a hand-made look."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dandy rolls"@en .

aat:300266531 a skos:Concept ;
    skos:definition "Electrical or mechanical devices for communicating signals from the deck of a vessel to the engine-room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engine-room telegraphs"@en .

aat:300266533 a skos:Concept ;
    skos:definition "Workmen who reproduce a draftsman's specifications for a ship or aircraft in full size on the floor of a mold-loft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loftsmen"@en .

aat:300266535 a skos:Concept ;
    skos:definition "Any of numerous types of devices or systems that allow the transmission of information by coded signal over a distance. Many telegraphic systems have been used over the centuries, but the term most often refers to the electric telegraph, which was developed in the mid-19th century and was the principal means of transmitting printed information by wire or radio wave for over a century. It consisted of a transmitting or sending instrument and a distant receiving instrument connected by a conducting wire or other communications channel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telegraphs"@en .

aat:300266537 a skos:Concept ;
    skos:definition "Large spotted cat now existing only in sub-Saharan Africa and Northern Iran. Coloration is pale yellow with small black spots. Long spine, long legs, and efficiency of internal organs allow the animal to sprint up to 70 miles per hour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acinonyx jubatus"@en .

aat:300266539 a skos:Concept ;
    skos:definition "The work or industry of capturing, killing, and rendering whales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whaling"@en .

aat:300266541 a skos:Concept ;
    skos:definition "Boiling oil from blubber of marine mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trying out"@en .

aat:300266543 a skos:Concept ;
    skos:definition "People whose occupation is whaling, which includes capturing, killing, and rendering whales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whalers"@en .

aat:300266545 a skos:Concept ;
    skos:definition "The process of creating shallow overcast stitching, with small stitches arranged in a diagonal pattern, used to bind pieces together or to secure small small rolled-over hems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whipping"@en .

aat:300266547 a skos:Concept ;
    skos:definition "A basic knitting stitch made by putting the needle through the front of the stitch from left to right, so that each loop is drawn through other loops to the right side of the fabric. The loops form vertical rows, or wales, on the fabric face and crosswise rows, or courses, on the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain stitches"@en .

aat:300266549 a skos:Concept ;
    skos:definition "Small, shallow overcast stitches arranged in a diagonal; used to bind pieces together or to secure small rolled-over hemming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whip stitches"@en .

aat:300266550 a skos:Concept ;
    skos:definition "Basic tapestry stitches worked in two journeys, first carrying the thread diagonnally over a double thread of canvas from left to right, then vertically transversing the double thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain cross stitches"@en .

aat:300266554 a skos:Concept ;
    skos:definition "Streams, rivers, or other watercourses that are wet and dry seasonally or otherwise flutuate depending upon rainfall, snowmelt, or other factors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermittent watercourses"@en .

aat:300266556 a skos:Concept ;
    skos:definition "Saline lakes, often with no outlet to the sea so that salts brought in by rivers accumulate, especially when the water is not particularly alkaline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt lakes"@en .

aat:300266557 a skos:Concept ;
    skos:definition "The parta of an open body of water occupying the space between two headlands, generally a shallow or slightly receding bay or slight recession in a coastline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bights"@en .

aat:300266558 a skos:Concept ;
    skos:definition "A long arm of the sea or relatively narrow channel between the mainland and an island or islands or connecting two larger bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sounds"@en .

aat:300266559 a skos:Concept ;
    skos:definition "A narrow waterway, usually narrower and less extensive than a sound, connecting two larger bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "straits"@en .

aat:300266560 a skos:Concept ;
    skos:definition "Diverging branches flowing out of a main stream and rejoining it downstream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anabranches"@en .

aat:300266561 a skos:Concept ;
    skos:definition "A lake in a crater or caldera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crater lakes"@en .

aat:300266563 a skos:Concept ;
    skos:definition "A navigable narrow part of a bay, strait, or river."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrows"@en .

aat:300266566 a skos:Concept ;
    skos:definition "Permanent caps or coverings of ice over a large tract of land, such as exists on high mountains and at either pole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice caps"@en .

aat:300266569 a skos:Concept ;
    skos:definition "Areas of permanent snow and ice forming the accumulation area at the head of a glacier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snowfields"@en .

aat:300266571 a skos:Concept ;
    skos:definition "Category of marine body of water comprising areas where freshwater streams or rivers merge with the ocean. This mixing of waters with such different salt concentrations creates a very interesting and unique ecosystem. An estuary is usually a funnel-shaped stream mouth or embayment where fresh water mixes with sea water under tidal influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estuaries"@en .

aat:300266573 a skos:Concept ;
    skos:definition "Music in which sound is generated, transferred, triggered, or amplified by electronic devices. The creation of electronic music may involve the use of magnetic tape or digital technology and whose reproduction involves the use of loudspeakers. For works created with only natural sound sources recorded and manipulated via discs or magnetic tape use \"musique concrète.\" For music created entirely through the use of a computer, in which the sound is initiated purely through digital means, use \"computer music.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic music"@en .

aat:300266577 a skos:Concept ;
    skos:definition "Devices that emit an audible repetitive tap to regulate musical tempo. Many different forms exist, most commonly the small clock work-driven pyramidal devices with a beating rod in front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metronomes"@en .

aat:300266579 a skos:Concept ;
    skos:definition "Describes buildings, particularly classic Greek and Roman temples or buildings like them in structure, having a row or rows of six columns at one or both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hexastyle"@en .

aat:300266581 a skos:Concept ;
    skos:definition "Australian end-blown, straight natural trumpets of more or less conical bore, traditionally consisting of a hollowed eucalyptus or bamboo branch over 3 feet in length, stripped of outer bark and often decorated with totemic symbols; played by men, standing or seated on the ground, employing a complex technique involving lip vibration, tongue movements, voiced sounds, circular breathing, and changing the shape of the mouth cavity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "didjeridus"@en .

aat:300266583 a skos:Concept ;
    skos:definition "Chairs having a seat that is a shaped and contoured plank drilled with sockets on the upper and lower surfaces to anchor the back and undercarriage and having the rear legs and a back that are separate rather than continuous members. The elements of the back are vertical, horizontal, or curved, and spindles may or may not be present. Chairs using bentwood back frame and legs pegged directly into the seat instead of being framed with aprons. The style is so named for chairs originating around Windsor Castle in England between 1700 and 1725, and was made by wheelwrights or turners, rather than cabinetmakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windsor chairs"@en .

aat:300266585 a skos:Concept ;
    skos:definition "Small objects worn as protecting charms, as to ward off evil, harm, or illness, or to bring good fortune. For objects specifically cut with astrological or magical symbols, intended to protect the bearer, but not necessarily worn, use \"talismans.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amulets"@en .

aat:300266586 a skos:Concept ;
    skos:definition "Distinctive structures typically used as fortified collective storage bins or communal refuges in Berber settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tighremts"@en .

aat:300266597 a skos:Concept ;
    skos:definition "The process of treating a dead body to prevent decay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embalming"@en .

aat:300266600 a skos:Concept ;
    skos:definition "The rearing of silk worms for the purpose of producing silk fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sericulture"@en .

aat:300266605 a skos:Concept ;
    skos:definition "Drawings or prints, typically profile portraits, made by tracing a profile from a shadow cast by the sitter using a physionotrace, a mechanical instrument invented in 1784 by the French musician and portraitist Gilles-Louis Chrétien."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physionotrace works"@en .

aat:300266607 a skos:Concept ;
    skos:definition "Examples of an instrument invented by Gilles-Louis Chrétien (1754-1811) as an aid to making profile portraits by enabling the artist to trace round the shadow cast by the sitter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physionotraces"@en .

aat:300266636 a skos:Concept ;
    skos:definition "Tent roofs in the particular context of Russian architecture, characterized as being a tall four- or many-sided pyramid. The form first appeared in defensive structures and then spread into religious architecture, reaching an apex of development in 15th-16th century wooden architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "šaters"@en .

aat:300266638 a skos:Concept ;
    skos:definition "Mid-20th century style of industrial and furniture design characterized by organic shapes, a lack of applied ornament, and extensive use of wood: often teak. Furniture in this style generally conforms to standards of construction, materials and proportion of traditional forms, though streamlined. The term is most often applied to furniture and industrial design such as tableware rather than to architecture, though it is also found in extended use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scandinavian modern"@en .

aat:300266639 a skos:Concept ;
    skos:definition "Coverings for the torso, limbs, hands, feet, and head for warmth, fashion, or to cover nudity. It generally excludes other items of costume such as jewelry, crowns, and other accessories that are purely decorative or symbolic and have no practical function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing"@en .

aat:300266640 a skos:Concept ;
    skos:definition "Ridges are elongated strips of elevated ground that may be either on dry land or underwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ridges"@en .

aat:300266642 a skos:Concept ;
    skos:definition "Female heads of families, tribal lines, or entire social orders, classes, or peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matriarchs"@en .

aat:300266643 a skos:Concept ;
    skos:definition "Roofs with a square, octagonal, or other base and steeply pitched slopes rising to a peak. May include Russian and Victorian wooden structures as well as membrane and thin shell structures comprising roofs of modern structures and actual tents. For such roofs in the specific context of Russian architecture, use \"saters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tent roofs"@en .

aat:300266644 a skos:Concept ;
    skos:definition "An optical effect manifested as a series of alternating light and dark colored bands; generally caused when one piece of glass with a curved surface rests on another with a flat surface, resulting in an interference of light waves. Named for the English physicist Sir Isaac Newton who first investigated their properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Newton's rings"@en .

aat:300266645 a skos:Concept ;
    skos:definition "Flasks, usually of molded glass, having of a distinctive style of scroll design impressed upon them; popular in the 19th-century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scroll flasks"@en .

aat:300266648 a skos:Concept ;
    skos:definition "Buildings housing museums that focus on peoples, societies, and cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnographic museums"@en .

aat:300266649 a skos:Concept ;
    skos:definition "Pointed arches located at the culmination of a wall in Russian church architecture. They differ from \"zakomaras\" in having a a purely decorative rather than a structural purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kokoshniks"@en .

aat:300266650 a skos:Concept ;
    skos:definition "Half-round or keel-shaped culminations of an outer wall of a church building in Russian architecture. It may also refer to rounded gable heads in English architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zakomaries"@en .

aat:300266651 a skos:Concept ;
    skos:definition "Items of the type collected and displayed in a cabinet of curiosities, including many genres of natural objects; examples are animal skulls, rocks, preserved insects, feathers, colorful leaves, birds' eggs, honeycombs, and seashells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural curiosities"@en .

aat:300266652 a skos:Concept ;
    skos:definition "A defensive perimeter made by arranged felled trees with their sharpened branches pointing outward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abatises"@en .

aat:300266654 a skos:Concept ;
    skos:definition "Extensible Markup Language, or XML, is a markup language and file format for storing, transmitting, and reconstructing arbitrary data. Based on SGML, it allows the mark-up of electronic documents, and can aid the exchange of data via the World Wide Web, and allows users to customize tags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "XML"@en .

aat:300266657 a skos:Concept ;
    skos:definition "Large spoons, with a capacity three times the size of a teaspoon, used for serving or consuming foods and as a standard unit of measurement in recipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablespoons"@en .

aat:300266659 a skos:Concept ;
    skos:definition "Contemporary collector's term referring to large flaring glass vessels used for heating flip, most popular during the 18th and 19th centuries; sometimes smaller glass vessels from which flip was drunk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flip glasses"@en .

aat:300266660 a skos:Concept ;
    skos:definition "Works composed primarily of beautiful, elegant letters or flourishes that are typically created by hand with a pen, either in unjoined characters or in cursive writing. May also refer to similar works created by computer or another means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calligraphy"@en .

aat:300266662 a skos:Concept ;
    skos:definition "The measure of the level of sharpness that photographic films are able to render."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acutance"@en .

aat:300266663 a skos:Concept ;
    skos:definition "Having the property of color change, due to chemical impurities or optical effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "allochromatic"@en .

aat:300266664 a skos:Concept ;
    skos:definition "Machines used for macerating rags into pulp for papermaking. Named for their country of origin, they appeared in Germany as early as 1710."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hollanders"@en .

aat:300266668 a skos:Concept ;
    skos:definition "Any of various machines for sewing material such as textile or leather, usually having needle and shuttle to carry thread and powered by treadle, waterpower, or electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sewing machines"@en .

aat:300266669 a skos:Concept ;
    skos:definition "Funerary altars or monuments designed to hold ashes rather than a corpse or other remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cineraria"@en .

aat:300266670 a skos:Concept ;
    skos:definition "Refers to the glaze of white porcelain that is decorated with blue under the glaze. Underglaze blue had been used in the Middle East from the 9th century; it was introduced to China in the Yuan dynasty (1279-1368). Particularly notable are the blue-and-white wares produced in China during the Ming (1368-1644) and Qing (1644-1911) dynasties. Underglaze blue was introduced to Europe from China in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue-and-white"@en .

aat:300266671 a skos:Concept ;
    skos:definition "Refers to a glaze comprising a transfer-printed blue design on white porcelain or stoneware, characterized by the design taking on a soft, feathery, blurry, or fuzzy-edged appearance, as if the blue had bled into the white ground. It was created by firing the work in an atmosphere containing volatile chlorides, which caused the blue pigment to become diffused through the glaze. The glaze was an early 19th-century development, originally in Staffordshire; it was popular throughout the English and American Victorian and Edwardian ages. The blue may range from grayish blue to greenish blue, but the most desirable is a vivid cobalt blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flow blue"@en .

aat:300266672 a skos:Concept ;
    skos:definition "In Japanese architecture, an interior space that may have evolved historically from the private altars of Zen Buddhist monks, used for the display of devotional objects; then later as elevated seating for warriors or dignitaries. The most recent use of the space in Japanese houses is for the display of flower arrangements and scrolls that set the mood of the tea ceremony, or other art objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tokonoma"@en .

aat:300266673 a skos:Concept ;
    skos:definition "Architectural elements found on Japanese religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese religious building fixtures"@en .

aat:300266674 a skos:Concept ;
    skos:definition "A Buddhist family altar or shrine found usually in Japanese homes, but also in temples. Generally a freestanding cabinet with two doors, in which are kept memorial items of dead ancestors and representations of divinities. Incense, candles, and flowers are offered at the butsudan in daily rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butsudan"@en .

aat:300266677 a skos:Concept ;
    skos:definition "Decorative headgear or bands worn on the forehead or just above the hairline, described variously, and evolving from the Middle Ages through the 16th century. These may be ornamented with pearls, gems, or other similar decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontlets"@en .

aat:300266678 a skos:Concept ;
    skos:definition "Web pages designed so that multiple users can add to or edit their content. Wikis are typically not monitored by a single editor: the community of users itself determines the veracity or trustworthiness of the information contained therein. Use of the term dates to 1995."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wikis"@en .

aat:300266679 a skos:Concept ;
    skos:definition "Information electronically recorded that requires a computer or other electronic device for display, interpretion, and processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic documents"@en .

aat:300266680 a skos:Concept ;
    skos:definition "Refers generally to comic books produced in Japan. Although the term manga is often used to refer to the Japanese form of animation known as anime and much anime has been based in manga, it is a separate art form. Manga themes include sports, romance, historical drama, comedy, soap operas, fantasy, mystery, sexuality, and horror. It is often produced in black and white, with the cover or the first few pages in color, with emphasis on exaggerated facial expressions and large eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manga"@en .

aat:300266681 a skos:Concept ;
    skos:definition "Chain lines in the paper that appear to run the wrong way for a particular format, for example, vertical chain lines in a horizontal format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turned chain lines"@en .

aat:300266683 a skos:Concept ;
    skos:definition "Characteristic design of book covers, developed by Samuel Mearne, binder to King Charles II, in which the covers were ornamented to resemble cottage gables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cottage style"@en .

aat:300266685 a skos:Concept ;
    skos:definition "Thin iron frames, hinged to the tympan of a hand press, securing the sheet and lowered with it to face the form before the carriage is rolled under the platen. The frisket was covered in paper with windows cut in it where, and only where, type meets paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friskets"@en .

aat:300266687 a skos:Concept ;
    skos:definition "Clamps for holding string, typically used in dollmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stringing clamps"@en .

aat:300266689 a skos:Concept ;
    skos:definition "The more widely spaced lines visible in the texture of laid paper, made by the wire mesh at the bottom of the tray in which it is made. Laid lines are the fine lines running through the chain lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain lines"@en .

aat:300266692 a skos:Concept ;
    skos:definition "Media events generally comprising interviews given by officials, politicians, or celebrities to journalists in order to make an announcement, answer questions, or otherwise attract media coverage for an issue or event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press conferences"@en .

aat:300266694 a skos:Concept ;
    skos:definition "Photographic images made from a negative that had been printed on a glass plate covered with gelatin silver emulsion, characterized by the back of the glass plate having been painted with gold mixed with banana oil or with bronze powders mixed in resin to give the appearance of gold. The technique was popularized by Edward Sheriff Curtis (1868-1952)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orotones"@en .

aat:300266696 a skos:Concept ;
    skos:definition "Process for producing a photographic printing plate, using a particular method developed by William Henry Fox Talbot. This process for producing a printing plate from a photograph was patented in 1858. After coating a copper plate with bichromated gelatin, Talbot exposed the plate to light under a positive transparency. It was then dusted with powdered resin and heated evenly to distribute the resinous particles. The plate was then etched in an acid solution that dissolved the gelatin and etched those same areas. After cleaning, the plate was inked, wiped, and printed on paper. He coined the term photoglyph from the Greek for \"carved light.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photoglyphic engraving"@en .

aat:300266700 a skos:Concept ;
    skos:definition "The more narrowly spaced, fine lines visible in the texture of laid paper, made by the wire mesh at the bottom of the tray in which it is made. Chain lines are the thicker, more widely spaced lines running through the laid lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laid lines"@en .

aat:300266701 a skos:Concept ;
    skos:definition "Areas of land generally characterized by being of medium size, often comprising an individual's property, often rectangular or of another regular shape, and defined by precise boundaries. Distinguished from \"lots (land),\" which are typically smaller, used for a single building, and often found in a town or urban environment rather than in the countryside."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plats"@en .

aat:300266702 a skos:Concept ;
    skos:definition "Style and culture of the the people of the Muzumbi area, Angola, particularly the style of trade goods produced under Portuguese rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muzamba"@en .

aat:300266703 a skos:Concept ;
    skos:definition "Sedimentary rock deposits, consisting mainly of sandstones and shales, formed as shore deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molasse"@en .

aat:300266705 a skos:Concept ;
    skos:definition "Photographic prints made using a solution of gold chloride. Developed by Sir John Herschel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrysotypes"@en .

aat:300266706 a skos:Concept ;
    skos:definition "Branch of geophysics concerned with the study of earthquakes and seismic waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismology"@en .

aat:300266707 a skos:Concept ;
    skos:definition "Written documents representing routine administrative or clerical work, such as forms, letters, reports, or invoices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paperwork"@en .

aat:300266708 a skos:Concept ;
    skos:definition "Visual works comprising small panels or tablets with images or text, especially miniatures painted on small wooden panels or images or ancient texts carved or engraved on stone or metal panels. Examples include small panels with miniatures used for various purposes, including as book covers. Common in the Middle Ages and Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tavolette"@en .

aat:300266709 a skos:Concept ;
    skos:definition "Refers to the creation of decorative scrapbooks and albums, typically using photgraphs and other items mounted to colored and patterned papers, which may be cut or stamped in various ways and involving the application of decorative lettering and other embellishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrapbooking"@en .

aat:300266710 a skos:Concept ;
    skos:definition "Brazilian coarse hardwood, of the family Leguminosae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angelim"@en .

aat:300266711 a skos:Concept ;
    skos:definition "The study of buildings as archaeological objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buildings archaeology"@en .

aat:300266712 a skos:Concept ;
    skos:definition "Exhibitions, usually focusing on one individual maker, that demonstrate the development of a body of work over a span of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retrospectives"@en .

aat:300266713 a skos:Concept ;
    skos:definition "Canopy-like arrangments of precious fabric, often consisting of celures, testers, and at least one set of valences. They were often used with chairs of estate, foot stools, and cushions, and could be raised onto a dais for added formality. For simple hangings of precious fabric placed behind a person, use \"cloths of honor.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloths of estate"@en .

aat:300266714 a skos:Concept ;
    skos:definition "Uniforms worn by sports teams and athletes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports uniforms"@en .

aat:300266715 a skos:Concept ;
    skos:definition "Furniture designed for use by children rather than for adults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's furniture"@en .

aat:300266716 a skos:Concept ;
    skos:definition "Pottery characterized by a fine-grained matrix encorporating rock fragments that cause the surface to feel gritty. Used generally to refer to materials from different periods and regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white gritty ware"@en .

aat:300266717 a skos:Concept ;
    skos:definition "Farmhouse of the Vendée region of France, consisting of a one-story roof with thatch and a lime-washed exterior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bourrines"@en .

aat:300266718 a skos:Concept ;
    skos:definition "The promotion of consumer awareness of particular goods or services, often through merchandise packaging or trademarking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "branding"@en .

aat:300266719 a skos:Concept ;
    skos:definition "Wood log construction technique of layering tightly fitting timbers one on top of the other. Used since the Neolithic period, particularly in Europe and Asia. Either round logs or squared timber beams may be used. The combination of a block enclosed in a frame is called \"plank construction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blockbau"@en .

aat:300266722 a skos:Concept ;
    skos:definition "Houses that are large but not overly grandiose, characterized by stately facades, high ceilings, grand reception rooms, and a regular floor plan. The term is used particularly in France, Switzerland, and Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maisons-de-maître"@en .

aat:300266723 a skos:Concept ;
    skos:definition "An Italian word meaning coloring or colored, referring to the use of color in painting. Its counterpart is \"disegno,\" which is the foundational design or drawing of a work. For modern art theory regarding the systematization of the individual properties of colors, use \"color theory.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colorito"@en .

aat:300266727 a skos:Concept ;
    skos:definition "Weights attached to fishing lines to sink baits and lures into deeper water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sinkers"@en .

aat:300266728 a skos:Concept ;
    skos:definition "Complex polymers created by combining two monomers of different species. The resulting materials may exhibit combined properties of the monomers employed; distinct from what can be achieved by a physical, rather than chemical blend of polymerized component monomers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copolymers"@en .

aat:300266729 a skos:Concept ;
    skos:definition "Any member of a family of thermoplastic synthetic resins that may vary from liquids to rigid solids, created by the polymerization of ethylene derivatives or vinyl compounds; generally vinyl acetate, vinyl chloride, and vinylidine chloride. Vinyl resins produce clear, hard films and are also used as coatings and adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl resin"@en .

aat:300266730 a skos:Concept ;
    skos:definition "Polymers created by combining two separate monomers from the vinyl group, vinyl acetate and vinyl chloride, for example."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl copolymers"@en .

aat:300266731 a skos:Concept ;
    skos:definition "General term for materials derived from the polymerization of a monomer from the vinyl group. For materials derived from more than one monomer of the vinyl group, use \"vinyl copolymer.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl polymers"@en .

aat:300266733 a skos:Concept ;
    skos:definition "Range of greenish gray or bluish gray colors, resembling the color of ashes, which are the earthy or mineral residue that remains after combustible substances have been thoroughly burned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ash"@en .

aat:300266734 a skos:Concept ;
    skos:definition "Exhibitions that lay out facts and examples to tell a story or explain an issue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary exhibitions"@en .

aat:300266735 a skos:Concept ;
    skos:definition "Peasant paintings or needlework of long, narrow profile on linen or paper used to decorate farmhouses in Sweden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonader"@en .

aat:300266736 a skos:Concept ;
    skos:definition "Carts in which wine, in casks or bottles, is conveyed for serving, sale, or another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine carts"@en .

aat:300266737 a skos:Concept ;
    skos:definition "Originally a chest or coffer in which things were stored, including a box-like pen in which an animal was confined. Today the term typically refers to a dining room case piece with a surface surmounted by an enclosed cupboard or open shelves, generally resting on either a relatively solid base or taller legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hutches"@en .

aat:300266738 a skos:Concept ;
    skos:definition "Case furniture on low legs, popular during the Victorian period. It is characterized by being divided in half vertically, with one half comprising shelves enclosed by a wooden or glass-fronted door, for the storage of books, dishes, or curiosities, and the other side often comprising a secretary, cabinet, or some combination of mirror, drawers, and fold-down desk top. Distinguished from a chifforobe, which is case furniture also divided vertically, but typically characterized by placement in a bedroom, having a narrow clothes closet on one side, and a narrow chest of drawers with a mirror on the other side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side by sides"@en .

aat:300266739 a skos:Concept ;
    skos:definition "Men's unlined, close-fitting, collarless undergarments, worn as undershirts or jerseys in the 18th and 19th centuries. Also refers to sleeveless, athletic tops and unlined waistcoats. In the context of modern costume, the term may refer to single-pieced outfits worn by wrestlers. For lined waistcoats, use \"doublets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "singlets"@en .

aat:300266741 a skos:Concept ;
    skos:definition "Formal, machine-readable specifications of a conceptual model, in which concepts, properties, relationships, functions, constraints, and axioms are all explicitly defined. Refers to a compilation that is not technically a controlled vocabulary, but that uses one or more controlled vocabularies for a defined domain and expresses the vocabulary in a representative language that has a grammar for using vocabulary terms to express something meaningful. Ontologies generally divide their world into the following areas: individuals, classes, attributes, relations, and events. The grammar of the ontology links these areas together by formal constraints that determine how the vocabulary terms or phrases may be used together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ontologies"@en .

aat:300266742 a skos:Concept ;
    skos:definition "The decentralized practice and method by which individuals and groups create, manage, and share terms, names, etc. (called \"tags\") to annotate and categorize digital resources in an online \"social\" environment. This method is not necessarily collaborative because the effort is typically not organized, individuals are not actually working together or in concert, and standardization and common vocabulary are not employed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social tagging"@en .

aat:300266743 a skos:Concept ;
    skos:definition "A neologism, the meaning of which is changing over time. Currently, it typically refers to assemblages of concepts represented by terms and names (called tags) that are compiled through social tagging. They are not necessarily the result of a collaborative effort, but are usually the compilation of personal tagging of content by individuals. Folksonomies are typically without hierarchical structure, generally have no preferred term for a concept, and may not even cluster synonyms. They are not considered authoritative because they are not compiled by experts. Furthermore, they are by definition not applied to documents by professional indexers. Given that it is impossible for the large and varied community of Internet creators and users to independently add metadata in a consistent manner, folksonomies are generally characterized by non-standard, idiosyncratic tagging. Although they do not support searching and other types of browsing as well as tags from controlled vocabularies applied by professionals, folksonomies are useful in certain situations, including where controlled tagging is not possible or where individuals prefer to tag content for their own use. The term formerly referred to the internet-based information retrieval methodologies involved rather than the resulting terminology or tagging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folksonomies"@en .

aat:300266744 a skos:Concept ;
    skos:definition "Refers to the period from the mid-1950s through the early 1970s when rocketry was first used to launch satellites and manned missions to extraterrestrial space. Generally applied to works that were inspired by new techniques, materials, and designs developed for space flight; or the images, experiences, or psychological states recorded by astronauts during space missions. The term has been applied to works of art, design, music, and architecture characteristic of this period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space age"@en .

aat:300266745 a skos:Concept ;
    skos:definition "Ceremonial tea bowls of various designs used for preparing and drinking tea in East Asian tea ceremonies. They are traditionally small earthenware vessels without handles, often glazed in muted tones and characterized by an aesthetic of irregularity or imperfection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chawan"@en .

aat:300266746 a skos:Concept ;
    skos:definition "Hardware and software standard established in 1983 that provides both a physical means of interconnecting electronic musical instruments to each other and to computers, and the code to transmit data that controls variables such as notes, timbre, duration, velocity, and a variety of effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MIDI"@en .

aat:300266747 a skos:Concept ;
    skos:definition "Literary works recorded on audio media and distributed commercially. Texts are often read by actors or by the authors themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "audiobooks"@en .

aat:300266748 a skos:Concept ;
    skos:definition "A system that incorporates components that allow recording, editing, mixing, storing, performing and outputting digital audio. Generally these include three components: a computer, software, and some kind of hardware interface for the connection of microphones or musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital audio workstations"@en .

aat:300266749 a skos:Concept ;
    skos:definition "Electronic hardware or software instruments used to create digital representations of audio waveforms, process them, and replay them in a musical context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samplers"@en .

aat:300266750 a skos:Concept ;
    skos:definition "Refers to ancient Greek vase painters who painted in both Red-figure and Black-figure techniques. The term also refers to vessels where the same vessel displays both Red-figure and Black-figure techniques. The bilingual style was seen during a brief time in the Late Archaic period, during the third to fourth decades of the sixth century BCE, when the Attic Red-figure style was new and was gradually largely replacing the Black-figure style. During this transition phase, vessels sometimes exhibited both techniques, each relegated to distinct areas of the vessel, such as Black-figure in the interior and Red-figure on the exterior of a cup, or the exterior design of an amphora having been divided in half, with one technique on the front and the other on the back. The two techniques are sometimes employed by the same vase painter, and sometimes different vase painters are responsible for each of the two techniques on the same vessel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bilingual"@en .

aat:300266751 a skos:Concept ;
    skos:definition "Small loudspeakers worn on the head for listening to music or for communications purpose; may have speakers for one or both ears, attached to the head by a band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headphones"@en .

aat:300266752 a skos:Concept ;
    skos:definition "A standard peripheral interface for connecting devices such as mice, keyboards, cameras, etc. to personal computers. The term \"USB\" is used to refer to the standard as well as the cable device and port."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "USB"@en .

aat:300266753 a skos:Concept ;
    skos:definition "Fast external serial bus standard for the connection of computer peripheral devices such as cameras, hard drives, and video recorders. It was developed by Apple Computer, and has been licensed to other manufacturers. The term \"FireWire\" is trademarked, thus the technology is implemented by other manufacturers under various names."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "IEEE 1394"@en .

aat:300266754 a skos:Concept ;
    skos:definition "Describes works that depend upon the interaction of the viewer for complete expression. This term has often referred to works in which computers or other technology have a role. For works that may incorporate elements of space or time, but that do not require the participation of the viewer, use \"generative art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interactive art"@en .

aat:300266755 a skos:Concept ;
    skos:definition "In general, areas or large, open structures used for burial or entombment. Specifically, typically refers to relatively large public parks or grounds laid out expressly for the interment of the dead, and not being the yard of any church. Originally the term was derived from the Latin \"cœmeterium,\" referring to Roman underground cemeteries or catacombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cemeteries"@en .

aat:300266756 a skos:Concept ;
    skos:definition "Cemeteries that are designed as a park, in which upright memorials are not used, as originally intended by Hubert Eaton (1881-1966), the coiner of the term. They are generally characterized by open expanses of turf with either flush or other regulated gravemarkers. In the last half of the 19th century, those with flush markers were called \"lawn\" cemeteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorial parks"@en .

aat:300266757 a skos:Concept ;
    skos:definition "Cemeteries characterized by open expanses of turf with flush markers, particularly those dating from the late 19th-century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lawn cemeteries"@en .

aat:300266758 a skos:Concept ;
    skos:definition "Refers to burial grounds established for war casualties, veterans, and eligible dependents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military cemeteries"@en .

aat:300266759 a skos:Concept ;
    skos:definition "Complexes comprising a coal mine and processing facilities such as a breaker or sorting machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collieries"@en .

aat:300266760 a skos:Concept ;
    skos:definition "Districts encompassing tin mines and tin works, and governed by special laws in historical Britain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stannaries"@en .

aat:300266762 a skos:Concept ;
    skos:definition "Refers to any supporting stones in the foundation of a structure, often of a rougher or different texture than the stones used in the upper part of the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundation stones"@en .

aat:300266763 a skos:Concept ;
    skos:definition "Refers generally to a cloakroom; use specifically for large rooms in monasteries or other buildings where garments are kept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestiaries"@en .

aat:300266764 a skos:Concept ;
    skos:definition "In Christian churches, rooms or separate buildings in which the celebrants, other clergy, and acolytes may dress prior to the mass or other services. The room may also be used for storage of liturgical vestments, sometimes for storage of vessels, and other items, and for meetings. For rooms serving more for the storage of sacred items, use \"sacristies,\" although modern usage of the two terms broadly overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestries"@en .

aat:300266766 a skos:Concept ;
    skos:definition "Windows in a sliding frame, having a vertically or horizontally hung sash, but usually not a double-hung window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash windows"@en .

aat:300266767 a skos:Concept ;
    skos:definition "Dairy product created from cream, flavorings, and sugar, which is stirred slowly while freezing to prevent large ice crystals from forming, resulting in a smoothly textured semi-solid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice cream"@en .

aat:300266769 a skos:Concept ;
    skos:definition "Stones, usually upright, placed at the top of graves, that is, over the head of the interred body; generally includes an inscription noting the name and life and death dates of the deceased. For upright grave or commemorative stones in an ancient context, prefer \"funerary stelea.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headstones"@en .

aat:300266770 a skos:Concept ;
    skos:definition "Refers to the upright stones placed at the foot of graves, that is, over the feet of the interred body, generally shorter in height than the headstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footstones"@en .

aat:300266771 a skos:Concept ;
    skos:definition "Landscaping section comprising turf on which grass is growing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenswards"@en .

aat:300266772 a skos:Concept ;
    skos:definition "Built works housing printsellers' shops, that is, stores in which the primary items for sale are prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "print shops"@en .

aat:300266773 a skos:Concept ;
    skos:definition "Buildings or other facilities where in which the founding of metal or glass is carried on, meaning these materials are cast or poured into molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundries"@en .

aat:300266774 a skos:Concept ;
    skos:definition "Utility poles used primarily to support telephone lines or cables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephone poles"@en .

aat:300266775 a skos:Concept ;
    skos:definition "Brochures, online pages, or other documents detailing or advertising the facilities or activities of a school, university, or other educational institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic prospectuses"@en .

aat:300266776 a skos:Concept ;
    skos:definition "Descriptive catalogs or classifications of the plants of any geographical area, geological period, etc., whether in book form, an online site, or other medium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floras"@en .

aat:300266777 a skos:Concept ;
    skos:definition "Romantic fictions having a prevailing atmosphere of mystery and terror, often combined with a love story. The genre was introduced in England ca. 1765, but soon became popular elsewhere in Europe, reaching its heyday in the 1790s. The genre has undergone frequent revivals in subsequent centuries. It is called \"Gothic\" because the early examples were often set in part among medieval buildings and ruins, such as castles or monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic novels"@en .

aat:300266779 a skos:Concept ;
    skos:definition "One of the world's oldest known boardgames, it is played by two people who oppose each other across a board of 64 alternating light and dark squares. The 24 disk-shaped playing pieces are of contrasting colors. Play consists of advancing a piece diagonally forward to an adjoining vacant square. A win is scored when an opponent's pieces are all captured or blocked so that they cannot move. Games similar to checkers were played in the days of the early Egyptian pharaohs (by ca. 1600 BCE); they were mentioned in the works of the Greek writers Homer and Plato. In the 12th century CE, an early form of the game was adapted to the 64-square chessboard, and by the 16th century the rule compelling capture had been added, producing a game essentially the same as modern checkers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "checkers"@en .

aat:300266780 a skos:Concept ;
    skos:definition "Strategy board game played in China from about 700 CE. Like Western chess, Chinese chess is believed to have been derived from an Indian board game known as chaturanga. The object of Chinese chess is to capture the opponent's king or general. While the game boards appear superficially similar, the Western board is 8 x 8 rows of alternating light and dark colors, while the Chinese board is 8 x 8 rows of squares of the same color with an extra horizontal void, known as a river, between the two halves; diagonal lines are inscribed across certain squares. Unlike Western chess, which is played on the two-toned squares, Chinese chess is played on the intersection of the lines, known as points, that form the squares. Chinese chess pieces are usually in the form of flat disks, often black and red in color, with Chinese characters inscribed on them to designate their rank. The pieces include a king (general), mandarins, rooks (chariots), knights (horses), elephants (bishops or ministers), cannons, and pawns (soldiers)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese chess"@en .

aat:300266781 a skos:Concept ;
    skos:definition "The hydroxy salt of ammonium ion, formed when ammonia reacts with water molecules in solution. It is an alkaline solution containing around 28.5% ammonia by weight, highly soluble in water. For solutions containing this substance, use \"ammonia water,\" though usage overlaps because ammonium hydroxide always or almost always exists only in solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium hydroxide"@en .

aat:300266782 a skos:Concept ;
    skos:definition "Nonmetallic chemical element (O). It is a colorless, odorless, tasteless gas, the most plentiful element in the Earth's crust; its most important compound is water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxygen"@en .

aat:300266783 a skos:Concept ;
    skos:definition "A method for generating sound involving the combination of tiny waveform fragments to create larger acoustic events. This is generally achieved with the use of digital computers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granular synthesis"@en .

aat:300266785 a skos:Concept ;
    skos:definition "In electronics, the result of the return of an output signal from a circuit to the input of the same system. Feedback can be used to boost a signal, though in many cases it is an unwanted byproduct of a signal path, equivalent to noise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feedback"@en .

aat:300266786 a skos:Concept ;
    skos:definition "Finely divided particulate matter resulting from the burning of pulverized coal or wood, often emitted as an airborne pollutant at power and manufacturing plants. Current practice in the United States is to trap and recover fly ash; used as a filler in brick and concrete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly ash"@en .

aat:300266787 a skos:Concept ;
    skos:definition "Refers to the process of making an audio master disc or tape from which multiple copies will be made. Mastering may incorporate a variety of functions, excluding recording. The term is frequently extended to videodisc technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mastering"@en .

aat:300266788 a skos:Concept ;
    skos:definition "The process of re-recording or adding a layer of sound to an existing soundtrack, usually for the purpose of introducing a translation of spoken dialog to a film. Also generally; to mix several tracks into a united track, or in extended use, the process of copying an existing sound or video recording in its entirety."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dubbing"@en .

aat:300266789 a skos:Concept ;
    skos:definition "The term derives from the Latin \"frater,\" the title by which early Christians customarily addressed each other. From the end of the 13th century, it referred to the members of the mendicant orders. Friars are distinguished from \"monks\" in that friars focus on a sacred ministry of preaching, mixing with their fellow men in the world, soliciting alms, and moving from place to place, while monks live in seclusion in a fixed place; in addition friars' orders originally could possess no fixed revenues, but lived upon the voluntary offerings of the faithful, while the orders of monks could possess property and revenues, although the individual monks took vows of poverty. The orders of friars are usually divided into two classes, the four great orders mentioned by the Second Council of Lyons, Dominicans, Franciscans, Carmelites, and Augustinians, and the lesser orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "friars"@en .

aat:300266791 a skos:Concept ;
    skos:definition "Copies of documents created simultaneously with the original manuscript or typescript by the use of an intermediate sheet of paper coated with carbon. Copies of documents created simultaneously with the original manuscript or typescript by the use of an intermediate sheet of paper coated with carbon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon copies"@en .

aat:300266792 a skos:Concept ;
    skos:definition "Cameras capable of acquiring still or motion pictures via an electronic sensor and storing them as digital information on a memory device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital cameras"@en .

aat:300266794 a skos:Concept ;
    skos:definition "Decorative forms or embellishments that are an integral part of a building or object but are not essential to its structure. Refers also to decorative objects attached to or worn by humans and animals. For objects signifying an honor bestowed upon an individual, usually worn on the person, see \"decorations.\" Regarding techniques of embellishment in general, see \"decoration (process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornaments"@en .

aat:300266795 a skos:Concept ;
    skos:definition "A rise in the surface of the sea due to increased water volume of the ocean or sinking of the land. There is concern that the rate in sea-level rise may increase markedly in the future owing to global warming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea-level rise"@en .

aat:300266796 a skos:Concept ;
    skos:definition "An allotropic form of oxygen, O3, which is a bluish toxic gas with a characteristic sharp odor, is a powerful oxidizing agent, and is produced from molecular oxygen by electrical discharge and in the upper atmosphere by ultraviolet light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ozone"@en .

aat:300266797 a skos:Concept ;
    skos:definition "Region of the upper atmosphere of the Earth containing a relatively high concentration of ozone, which absorbs much of the ultraviolet radiation reaching the earth from the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ozone layer"@en .

aat:300266798 a skos:Concept ;
    skos:definition "Reduction of the concentration of ozone in the ozone layer as a result of the action of atmospheric pollutants. The thinning of the ozone layer and the appearance of a visible \"hole\" over the South Pole region has been the subject of extensive public policy discussions, media coverage, and national legislation and international treaties. Stratospheric ozone shields living organisms on Earth from the harmful effects of the Sun's ultraviolet radiation; even a relatively small decrease in the stratospheric ozone concentration can result in an increased incidence of skin cancer in humans and in genetic damage in many organisms. The prohibition of the manufacture or use of chlorofluorocarbons in the United States, and many other nations, is perhaps the most visible positive result to date of this debate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ozone depletion"@en .

aat:300266799 a skos:Concept ;
    skos:definition "Region of the ozone layer in which the ozone concentration is substantially depleted, occurring chiefly at high latitudes and attributed to the chemical action of CFCs and other atmospheric pollutants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ozone hole"@en .

aat:300266800 a skos:Concept ;
    skos:definition "Phenomenon whereby the surface and the lower atmosphere of a planet are maintained at a relatively high temperature owing to the greater transparency of the atmosphere to visible radiation from the sun than to infrared radiation from the planet. It is so-called because the heating of Earth's atmosphere is loosely analogous to the glass of a greenhouse letting light in but not letting heat out. The term is often used to refer specifically to the increased magnitude of this effect occurring in the modern age in the context of global warming: Gases from the burning of fossil fuels and other sources, including water vapor, carbon dioxide, methane, and chlorofluorocarbons, absorb infrared radiation and prevent its energy from leaving the Earth, resulting in the increasing mean global surface temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenhouse effect"@en .

aat:300266801 a skos:Concept ;
    skos:definition "Gases that contribute to the greenhouse effect, including water vapor, carbon dioxide (CO2), methane (CH4), ozone (O3), nitrous oxide (N2O), hydrofluorocarbons (HFCs), halogenated fluorocarbons (HCFCs), and perfluorinated carbons (PFCs)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenhouse gases"@en .

aat:300266802 a skos:Concept ;
    skos:definition "Describes a technique for creating the illusion of continuous tones or color depth by mixing dots of color from a limited palette. The term is generally used in the context of digital imaging or computer graphics, and can be applied to color or black and white images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dithering"@en .

aat:300266803 a skos:Concept ;
    skos:definition "Architectural elements found on Japanese religious buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jewish religious building fixtures"@en .

aat:300266804 a skos:Concept ;
    skos:definition "Reading stands used to support a book or other reading material for prayer, study, or speaking. Ultimately from the German \"stehender,\" meaning \"standing\" or \"upright.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shtenders"@en .

aat:300266806 a skos:Concept ;
    skos:definition "Refers to the apse or chancel of a basilica, usually in the context of ancient or Early Christian basilicas or meeting places, synagogues, or Eastern Orthodox churches. In modern times it most commonly refers to an elevated platform in a synagogue on which the Torah reading stand is placed; in the Ashkenazi (German) ritual, the Torah and Haftarah (a reading from the prophets) are read on the Sabbath and festivals. In the Sephardic (Spanish) rite, the entire service is conducted from the platform. At an earlier date, when the bimah was positioned in the center of the synagogue (as it still is in Sephardic and many Orthodox Ashkenazi synagogues), the attention of the congregation was divided between it and the Ark of the Law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bemas"@en .

aat:300266807 a skos:Concept ;
    skos:definition "Pieces of glass, crystal, plastic, or other transparent substance characterized by having two curved surfaces or one plane and one curved surface, serving to cause regular convergence or divergence of the rays of light passing through it. Lenses may be components of a larger object or objects in themselves. They are used for magnifying vision in eyeglasses, binoculars, telescopes, microscopes, cameras, and for directing or magnifying light in lighting devices such as flashlights or lighthouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lenses"@en .

aat:300266808 a skos:Concept ;
    skos:definition "Devices to compensate for defective vision or to protect the eyes from light, dust, and the like, consisting usually of two lenses set in a frame that includes a nosepiece for resting on the bridge of the nose and which may also have two sidepieces extending over or around the ears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyeglasses"@en .

aat:300266809 a skos:Concept ;
    skos:definition "Small magnifiers of the type used by watchmakers or jewelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loupes"@en .

aat:300266810 a skos:Concept ;
    skos:definition "The dress of an actor or actress who is representing a character on stage or in film, or of any other person who is playing a role or impersonating a character, as during Carnevale or Halloween."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "costumes"@en .

aat:300266811 a skos:Concept ;
    skos:definition "Essential oil distilled from species of Cymbopogon grass, and used as a stabilizer in soaps, perfumes, and cosmetics. It contains 70–80 percent citral, which may be isolated by distillation or from the oils of verbena and citronella."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemongrass oil"@en .

aat:300266813 a skos:Concept ;
    skos:definition "Genus containing 23 species of bats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eptesicus"@en .

aat:300266814 a skos:Concept ;
    skos:definition "Term refers to the process of demagnetization, originally used in the context of warships, now extended to magnetic media such as audio tapes and computer storage media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "degaussing"@en .

aat:300266815 a skos:Concept ;
    skos:definition "The process of converting data into code, to conceal information or prevent unauthorized access. May be used to refer to schemes for this purpose in print or electronically transmitted, but is increasingly used to refer to digitized, or computer data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encryption"@en .

aat:300266816 a skos:Concept ;
    skos:definition "Copper molds that have been struck with a punch and from which individual type letters are cast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matrices"@en .

aat:300266818 a skos:Concept ;
    skos:definition "A size of drawing paper with size ranging between 54 x 36 inches and 52 x29 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiquarian"@en .

aat:300266820 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Jordan. Following the dissolution of the Ottoman Empire, Britain created this semi-autonomous region of Transjordon in the early 1920s, which gained its independence in 1946 and was named Jordon in 1950."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jordanian"@en .

aat:300266821 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Iraq."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iraqi"@en .

aat:300266822 a skos:Concept ;
    skos:definition "Pertains to the style and culture of modern Iran. Although modern Iran was known as Persia until 1935, art and architecture of ancient Iranian civilizations dates back to prehistoric times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iranian"@en .

aat:300266823 a skos:Concept ;
    skos:definition "Paper or cardboard covers that form illustrated slip-cases for records, such as a seven-inch 45 rpm phonograph record, or slim books, to protect and to advertise the contents of the book or record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture sleeves"@en .

aat:300266824 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Lebanon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lebanese"@en .

aat:300266825 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Afghanistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afghan"@en .

aat:300266826 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Turkmenistan after 1924. The Turkmen Soviet Socialist Republic was formed in 1924. The republic declared independence in 1991 and adopted the name Turkmenistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkmen"@en .

aat:300266827 a skos:Concept ;
    skos:definition "Compositions or interior design that are considered by many to be overly crowded and busy; from the Latin meaning \"fear of empty spaces.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horror vacui"@en .

aat:300266828 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Kuwait."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kuwaiti"@en .

aat:300266829 a skos:Concept ;
    skos:definition "Refers to the practice of painting scenes while outdoors, rather than in a studio from sketches that may or may not have been made outdoors. It is often used to refer to impressionistic painting originating in France in the late 1860s that attempts to capture the transient effects of atmosphere and light by direct observation from nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plein-air"@en .

aat:300266830 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Saudi Arabia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saudi Arabian"@en .

aat:300266840 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pakistani"@en .

aat:300266841 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Azerbaijan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Azerbaijani"@en .

aat:300266842 a skos:Concept ;
    skos:definition "Refers to the style and culture of modern Georgia, in the Caucasus region of Eurasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Georgian"@en .

aat:300266843 a skos:Concept ;
    skos:definition "A type of granite found in England, used as a building stone, and often gathered from the surface of moors (hence the name)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moorstone"@en .

aat:300266845 a skos:Concept ;
    skos:definition "A hard, thermoplastic white powder that used as a drier, thickener, emulsifier, and matting agent in paints and varnishes; excess amounts produce soft, noncohesive films. Aluminum stearate is also used to waterproof fabrics, ropes, paper, leather, concrete, and stucco. It is used as an ingredient in photographic emulsions. It forms gels with turpentine, mineral spirits, and oils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum stearate"@en .

aat:300266846 a skos:Concept ;
    skos:definition "Naturally occurring mineral composed of barium carbonate usually found in hydrothermal veins associated with barite. It is mined in Germany, England, Scotland, Canada (Ontario) and the U.S. (Illinois, California, Arizona). Witherite is used in case-hardening steel and in refining sugar. It is also used as a pigment in the manufacture of paints, glazes, and synthetic marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "witherite"@en .

aat:300266847 a skos:Concept ;
    skos:definition "The process of making small pleats or folds in paper with a blade, a process which imparts stretch, strength, bulk, conformability, and texture similar to that found in fabrics. It also refers to the crimping or frizzing of hair or a similar treatment for rubber or thin fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creping"@en .

aat:300266848 a skos:Concept ;
    skos:definition "Decorative paper manufactured and used for wrapping gifts. The paper is often not as strong or durable as wrapping paper intended for wrapping parcels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift wrap"@en .

aat:300266849 a skos:Concept ;
    skos:definition "A self-stick adhesive commonly used on tapes, labels, and stamps, characterized by bonding to another surface with slight pressure at room temperature. Such adhesives are distinct from other adhesives in that they do not require solvent evaporation or a chemical reaction in order to bond. They have been applied to cloth, paper, film, foil, and foam substrates. They may be made from natural rubber, butyl rubber, styrene-butadiene rubber, nitrile rubber, acrylic, polyvinylalkyl ether, or silicone formulations. They commonly contain additives such as tackifiers, plasticizers, fillers, and antioxidants. They are used in the industrial and commercial market in the form of adhesive tapes and films directed toward packaging, mounting and fastening, masking, and electrical and surgical applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pressure-sensitive adhesive"@en .

aat:300266852 a skos:Concept ;
    skos:definition "Breakage, cracking, or slippage caused by shear stress, which is the force that tends to cause deformation of a material by slippage along a plane or planes parallel to the imposed stress. Shear failure is often in reference to geological or architectural materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shear failure"@en .

aat:300266853 a skos:Concept ;
    skos:definition "Free-standing figures representing deities, most often carved in wood, found in Polynesia, particularly the Hawaiian Islands. The word 'tiki' is commonly used to refer broadly to these figures, but is technically incorrect. Use \"Tiki\" to refer to the popularization of Polynesian imagery in Post-WWII North American culture, and more specifically to copies of these figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ki'i"@en .

aat:300266854 a skos:Concept ;
    skos:definition "A style reminiscent of the cultures of the islands of the South Pacific. Evident after World War II, its popularity is often attributed to returning U.S. soldiers who were exposed to authentic Oceanic culture during wartime service. The term is variously used to describe architecture, interior design, sculpture, and industrial design. The style peaked in the 1950s, but became resurgent as a fad in the early 21st century. For the small greenstone carvings of the Maori culture, use 'hei-tiki'. For authentic free-standing Oceanic sculpture of deities, use 'ki'i.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tiki"@en .

aat:300266855 a skos:Concept ;
    skos:definition "Small sculptures carved from green nephrite and worn as pendants by the Maori people of New Zealand. Hei tiki are fertility symbols resembling the form of a human fetus. Traditionally worn only by women, they are handed down through generations. They are more recently mass-produced in plastic as tourist souvenirs or good luck charms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hei tiki"@en .

aat:300266864 a skos:Concept ;
    skos:definition "Vessels with spouts, generally with lids and handles, used for preparing coffee or another beverage on the stove top or on a fire. They they are used to boil the beans or grounds in water, typically by forcing boiling water through a hopper that holds the beverage grounds. Coffee boilers are most often made of iron or enamelware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee boilers"@en .

aat:300266866 a skos:Concept ;
    skos:definition "Knives that are designed to be used primarily or entirely as weapons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knife weapons"@en .

aat:300266867 a skos:Concept ;
    skos:definition "Knives designed for the kitchen or cookery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary knives"@en .

aat:300266868 a skos:Concept ;
    skos:definition "Objects that are improvised or makeshift, particularly those that are created to give new use to an old, broken, or cast-off item. Applies most often to items of clothing, furniture, or household items, for example, a new garment created from old items of clothing or a broken piece of mirror mounted in a new frame. The term is distinguished from \"spolia,\" which refers to older architectural materials (e.g., ancient columns or carvings) built into a new fabric (e.g., a Medieval building)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "make-dos"@en .

aat:300266881 a skos:Concept ;
    skos:definition "A popular genre of spiritual autobiography that proliferated during the last two-thirds of the eighteenth century within the context of the Evangelical Revival in England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conversion narratives"@en .

aat:300266883 a skos:Concept ;
    skos:definition "Devices comprising a frame usually of two upright posts and a transverse beam, particularly such a device employed in executing criminals by hanging. The term may also refer to any similarly constructed support, such as an iron support for a pot over a kitchen fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallows"@en .

aat:300266885 a skos:Concept ;
    skos:definition "Generally, a headscarf or veil that covers the head and neck while leaving the face revealed. Worn by women in Islamic culture as an expression of modesty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hijabs"@en .

aat:300266886 a skos:Concept ;
    skos:definition "Long headscarf or veil that extends to waist-level; concealing the head, neck, torso and arms of the wearer, but leaving the face visible. Worn in public by some women in Islamic culture to express modesty. For shorter headscarves that cover the head and neck only, use \"hijab.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khimars"@en .

aat:300266887 a skos:Concept ;
    skos:definition "A veil worn by some Muslim women to obscure the face, while leaving the eyes revealed. It is worn in combination with a separate headscarf or other head covering, such as a khimar or hijab."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niqabs"@en .

aat:300275124 a skos:Concept ;
    skos:definition "Refers to illusionistic effects on two- or three-dimensional art works or architecture, in which the appearance of marble is simulated by painting. For example, wooden or plaster columns or paneling may be painted to imitate the color and graining of marble, which would be a more costly and desirable material. It is distinguished from \"scagliola,\" in which the effect of marbling is achieved by mixing pigment directly with the wet plaster, and then applying the plaster to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faux marbre"@en .

aat:300275168 a skos:Concept ;
    skos:definition "Describes works which have the character of art, but which mocks or challenges preconceptions about the nature of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anti-art"@en .

aat:300281845 a skos:Concept ;
    skos:definition "Refers to maiolica with usually polychrome decorations of historical, mythological, Biblical, or allegorical scenes painted over most of the surface. It was first produced about 1500 and is associated with Urbino. The earliest examples were decorated only in the well of plates and dishes; later the decoration extended to the entire inner surface. Images were often derived from works of contemporary artists, notably those reproduced in the engravings of Marcantonio Raimondi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "istoriato"@en .

aat:300281852 a skos:Concept ;
    skos:definition "Refers to a type of earthenware first developed around 1850 by the Thomas Minton factory in England. It is characterized by a richly modeled surface with thick, colored glazes. It is typically used for large objects such as umbrella stands, fountains, jardinieres, and figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial majolica"@en .

aat:300297855 a skos:Concept ;
    skos:definition "Printing technique created by a combination of direct painting with screenprinting, lithography or other traditional print matrix. For single prints painted on a plane without the use of a print matrix, use \"monotype (planographic process)\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monoprint"@en .

aat:300297856 a skos:Concept ;
    skos:definition "Refers to the style and culture of the African Bé people in Benin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bé"@en .

aat:300297857 a skos:Concept ;
    skos:definition "Novels of a traditional German genre that focuses on the spiritual development or formative years of an individual. Now in broad use to refer to this type of novel written in any language or in any culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bildungsromans"@en .

aat:300298098 a skos:Concept ;
    skos:definition "Ceramic ware to which a vitreous glaze has been applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazed ceramic ware"@en .

aat:300298378 a skos:Concept ;
    skos:definition "Dark red stone quarried in two deposits near Verona, in the Lessinia geographical area of the northern Veneto Prealps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Verona red marble"@en .

aat:300298452 a skos:Concept ;
    skos:definition "Fine needlework using gold and silver threads on rich velvet or linen grounds, for ecclesiastical or secular clothing, hangings, or other luxury textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus anglicanum"@en .

aat:300298634 a skos:Concept ;
    skos:definition "Fired terracotta to which a vitreous glaze has been applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazed terracotta"@en .

aat:300298669 a skos:Concept ;
    skos:definition "Any glass, usually blown glass, made with colorless, white, or colored canes to form a linear pattern in the glass. One method of production is by placing side by side a series of transparent rods or canes, each containing a twisted thread of colored or milk-white glass. The rods are then heated until they are fused into a single sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "filigree glass"@en .

aat:300298692 a skos:Concept ;
    skos:definition "A type of filigree glass having a decorative mesh pattern of criss-crossed fine glass threads. Known in ancient times, but it was made popular in modern times in Venice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vetro a reticello"@en .

aat:300298733 a skos:Concept ;
    skos:definition "Hard leather shields used by light calvary and designed specifically for riding riding with a short stirrup with knees bent. They were originally of a round or heart shape, then generally created in the shape of a pair of overlapping ellipses or ovals. They were originally used by the Moors, then by Spain; the form came to North America when Cortés entered Mexico in the early 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adargas"@en .

aat:300298735 a skos:Concept ;
    skos:definition "Refers to disks of wax bearing the sign of the Agnus Dei, which is a symbol of Christ in the form of a lamb bearing a cross with a halo round its head. The small cake of wax was stamped with such a figure and blessed by the Pope. The wax may be the remains of the Pascal candle, solemnly blessed by the Pope on the Thursday after Easter. Disks may be round or oval. Figures of saints or the name and arms of the Pope are commonly impressed on the reverse. Agnus Deis may be worn suspended round the neck, or they may be preserved as objects of devotion. In virtue of the consecration they receive, they are regarded as \"sacramentals,\" like holy water or blessed palms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agnus Deis"@en .

aat:300298764 a skos:Concept ;
    skos:definition "Altars that are of relatively small size and transportable, often fitting into a container along with other items for worship or services. In Christian contexts, examples include consecrated altar stones set in a case or otherwise mounted, used by priests who travel from location to location saying Mass where a permanent consecrated altar may not be available. Specifications included that it should be a solid piece of natural stone of a type and size resistant to fracture, consecrated by a bishop, large enough to hold the host and chalice, and designed so that it may be inserted in or placed on a table convenient for the service. For transportable versions of Christian painted or carved image-bearing objects of the type displayed on or above an altar, use \"portable altarpieces.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable altars"@en .

aat:300298778 a skos:Concept ;
    skos:definition "Large aedicules that elevate and surround the altarpiece or altar sculptures behind the altar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alzate d'altare"@en .

aat:300298798 a skos:Concept ;
    skos:definition "Altarpieces consisting of several painted panels or other images connected by an architectural structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anconas"@en .

aat:300298799 a skos:Concept ;
    skos:definition "Altarpieces that are designed to be of a small enough size and format to be transportable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable altarpieces"@en .

aat:300298807 a skos:Concept ;
    skos:definition "Papal ring used to seal the class of papal official documents known as Briefs. The earliest mention of the fisherman's ring worn by the popes is in a letter of Clement IV written in 1265. Public documents are distinguished by the leaden bulls rather than the fisherman's seal. The fisherman's ring is placed by the cardinal camerlengo on the finger of a newly elected pope. It is made of gold, with a representation of St. Peter in a boat, fishing, and the name of the reigning pope around it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rings of the fisherman"@en .

aat:300298862 a skos:Concept ;
    skos:definition "General term for secure chests or arks intended to contain the remains of the deceased, used particularly for such chests from ancient Greek, Etruscan, and Egyptian cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepulchral chests"@en .

aat:300298870 a skos:Concept ;
    skos:definition "Trim or casings around the sides and top of a rectangular opening, having a molded form similar to an architrave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architrave trims"@en .

aat:300298883 a skos:Concept ;
    skos:definition "Piece of sacristy furniture in the form of a cupboard, intended to store a variety of liturgical objects, such as robes, apparel, and altar vestments, or used for other liturgy-related functions. It may be either an isolated piece of furniture, built into the wall, or incorporated as an integral part of the sacristy furnishings. It is generally surmounted by a cross or a religious symbol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacristy cupboards"@en .

aat:300298887 a skos:Concept ;
    skos:definition "Cupboard in which the archives are kept. An inscription sometimes indicates its function. The term is often used to refer to the archives of a church, confraternity, or a town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archives cupboards"@en .

aat:300298894 a skos:Concept ;
    skos:definition "Armor made in the style of ancient Roman armor, as understood by the maker and patron based on depictions on Roman monuments. The armor was usually ceremonial rather than functional, most of it made in the Renaissance for ceremonial parades and tournaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armor alla romana"@en .

aat:300298907 a skos:Concept ;
    skos:definition "Originally a pipe or reed (hence the name arundo, which means \"reed\") with which the celebrant of the Mass may sip the communion wine, instead of the celebrant and all communicants putting their lips to the rim of the same cup. Use of the arundo was known from the Carolingian period onwards, when the arundo was made of a precious material such as gold; for example, in the papal high mass, a golden arundo is used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arundos"@en .

aat:300298908 a skos:Concept ;
    skos:definition "Instruments, usually of metal attached to an absorbent material, for the sprinkling of holy water. In the Western church, the aspergillum is composed of a handle surmounted by a perforated ball, sponge, or brush-like end to hold water. Some have sponges or internal reservoirs that dispense holy water when shaken, while others must periodically be dipped in \"aspersoriums (vessels).\" The tool was originally made of branches of hyssop, palm, or boxwood, wisps of straw, or the tail of a fox (in Old French the fox was called \"goupil\"). By the 13th century the aspergillum assumed the modern Western form of a handle surmounted by a rose-shape covered with bristles; the handles of the sprinklers came to be very richly ornamented. In the Greek Orthodox Church the aspergillum is a standing vessel with a tapering lid perforated with holes for sprinkling; in the Russian Orthodox Church, it is a whisk made of cloth, hair, or sprigs of basil. The tool was derived from ancient sources, where branches were used to sprinkle water, blood, or another liquid in rituals. Such tools were used in ancient Rome, the Middle East, ancient Norse rituals, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aspergilla"@en .

aat:300298909 a skos:Concept ;
    skos:definition "The activity of sprinkling for religious purposes. The custom is derived from ancient Rome. In Catholic and Episcopalian churches, the congregation is sprinkled with holy water before the Mass, during other sacraments, or in processions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asperges"@en .

aat:300298913 a skos:Concept ;
    skos:definition "Brushes, usually long brushes made of horse hair, fixed to a handle and used to sprinkle water. Used in ancient Rome and other cultures, and later in Christian churches used to dip into holy water in order to sprinkle it on the congregation, the altar, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brush aspergilla"@en .

aat:300298924 a skos:Concept ;
    skos:definition "Arrangements of hooks or pegs attached directly to the wall or to a plank or other piece which is mounted on the wall, for hanging coats, hats, and other clothes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall hooks"@en .

aat:300298926 a skos:Concept ;
    skos:definition "Shelves designed with a row of hooks or pegs beneath, for the hanging of hats, clothing, umbrellas, or other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelves with hooks"@en .

aat:300298927 a skos:Concept ;
    skos:definition "Rods secured horizontally, usually in closets or armoires, for the purpose of hanging clothes on clothes hangers. They may be removable or permanent fixtures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing rods"@en .

aat:300298928 a skos:Concept ;
    skos:definition "Stiff straight metal rods, one end of which is fitted with or made into a handle, for poking or stirring a fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pokers"@en .

aat:300298934 a skos:Concept ;
    skos:definition "Borders of particularly rich embroidery or woven designs in gold thread and colored silk, often embellished with jewels or beads, used as ornamental bands on clothing, such as on royal or ecclesiastical vestments. Term refers to the Phrygians, who were noted for their skill in embroidering with gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aurifrisia"@en .

aat:300298938 a skos:Concept ;
    skos:definition "Basins or shallow bowls having a convex boss, umbo, or elevated point in the center of the basin, for the purpose of gathering the liquid around the rim of the basin, such as for libations, or to provide an attachment for a ewer that is fitted with a concave bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basins with central boss"@en .

aat:300298940 a skos:Concept ;
    skos:definition "Basins of metal or porcelain, produced as a pair and fitting one inside the other: one bowl with a small spout to pour water over the hands and the other to serve as a catch basin. They were used for washing the hands before meals or during liturgical ceremonies. They were being produced in Limoges by the 13th-century, although the form is earlier. The name is derived from \"gemellus,\" the Latin word for \"twin\"), referring to the fact that they were produced in pairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gemellions"@en .

aat:300298949 a skos:Concept ;
    skos:definition "Large elevated lecterns that may be pivoted, usually found in the choir of churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badalones"@en .

aat:300298960 a skos:Concept ;
    skos:definition "Suspended structures used to protect the altar in a church, or to designate the altar as the place of greatest importance in the space. When an altar canopy is made of fabric, it consists of a roof with hangings and sometimes curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar canopies"@en .

aat:300298962 a skos:Concept ;
    skos:definition "Canopies that are relatively small in size and movable, or that fold or collapse into a format and size that is small enough to be portable. Used as a shelter or protection from the sun outdoors, and in religious ceremonies, triumphal entries, or otherwise to shelter or designate a dignitary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable canopies"@en .

aat:300298963 a skos:Concept ;
    skos:definition "Portable canopies used in processions to shelter a monarch, dignitary, holy person, or object. In Catholic ceremonies, such canopies are used to shelter the Blessed Sacrament, the holy oils on Holy Thursday, relics, or a statue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional canopies"@en .

aat:300298970 a skos:Concept ;
    skos:definition "Trays or containers for packing and conveying goods, such as portable platforms on which goods can be moved, stacked, or stored, especially with the aid of a forklift truck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pallets"@en .

aat:300298974 a skos:Concept ;
    skos:definition "Benches with desks, usually attached, designed for the seating of two or more students in a class room."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school benches"@en .

aat:300298975 a skos:Concept ;
    skos:definition "Bench-like pieces of furniture for the use of a person at prayer, consisting of a kneeler with a narrow upright front surmounted by a ledge for books or for resting the elbows, and often a shelf below this for storing books. For similar pieces that are in the form of a low chair, use \"prie-dieu chairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prie-dieus"@en .

aat:300298983 a skos:Concept ;
    skos:definition "Hangings attached to the front of or covering a lectern, often embroidered or painted, sometimes in the liturgical color corresponding to the current season of the church calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lectern covers"@en .

aat:300298984 a skos:Concept ;
    skos:definition "Banners carried at the head of a procession, usually mounted upon a long staff or handle. They are usually rectangular, but may be triangular or of another shape. They are usually suspended at the top edge, but may be fixed on a stiff frame on all sides. They may be painted or richly embroidered; used in religious processions, royal processions, and for other occasions. They may carry the identification of a confraternity, congregation, or parish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional banners"@en .

aat:300298987 a skos:Concept ;
    skos:definition "Long narrow flags, scrolls, or streamers, often with a cleft end, flying from the mast-heads of ships, carried by hand, carried in battle, and for other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banderoles"@en .

aat:300299037 a skos:Concept ;
    skos:definition "Saddles adapted to support a pack or packs for transportation by a pack animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packsaddles"@en .

aat:300299039 a skos:Concept ;
    skos:definition "Maces intended primarily for ceremonial display rather than as weapons. A ceremonial mace is a staff or club-shaped device, often richly ornamented and typically topped with a knob or other head-piece, carried by priestly officials, ecclesiastical persons, magistrates, and academic persons as a symbol of jurisdiction or office during a solemn ceremony. Examples are found in ancient Egypt, pre-Columbian America, Asia, and Europe and North America. For similar objects carried by rulers, use \"scepters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial maces"@en .

aat:300299080 a skos:Concept ;
    skos:definition "Windows having one mullion, wlth the space divided into two sections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biforate windows"@en .

aat:300299089 a skos:Concept ;
    skos:definition "Golden ornaments in the form of seals attached to special decrees issued by Popes, Byzantine Emperors, and later by European monarchs in the Middle Ages and Renaissance. The term originally referred to a golden seal itself, but came to be applied to the entire decree: for the proper name of a particular decree, use the CONA Iconography Authority or another authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golden bulls"@en .

aat:300299090 a skos:Concept ;
    skos:definition "Seals made of lead with which papal and royal documents were authenticated from the early Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaden seals"@en .

aat:300299093 a skos:Concept ;
    skos:definition "Long staffs often having a pointed lower tip and topped by a knob or hook onto which was attached a gourd (pilgrim's gourd), a cloth tied into a sack, or other item. Used as an aid walking on pilgrimages; some were decorated with religious inscriptions and images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilgrim staffs"@en .

aat:300299135 a skos:Concept ;
    skos:definition "Supports for the arm, typically as part of a chair or other seating furniture, although they may be separate objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "armrests"@en .

aat:300299142 a skos:Concept ;
    skos:definition "Receptacles used in Roman Catholic services to burn the coals needed for censing, and to light the Paschal candle on Holy Saturday, usually on a tripod, or a three-footed stand of varying height. The brazier is typcially accompanied by liturgical tongs and a scoop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical braziers"@en .

aat:300299144 a skos:Concept ;
    skos:definition "Short pole weapons, around 5 feet in length, having a retractable blade of either a one or three long thin points that were retracted into a hollow aperture inside the shaft. A sharp thrust of the weapon propelled the points out. The weapons were used by both infantry and civilians alike between the 16th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brandistocks"@en .

aat:300299154 a skos:Concept ;
    skos:definition "Genus containing shrubby evergreen plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brunia"@en .

aat:300299160 a skos:Concept ;
    skos:definition "A low, portable candleholder of a design reserved for a pope, cardinal, bishop, and certain abbots and other high-ranking prelates; usually made of silver, with a wide drip pan and ring or a long handle, which may store a spare candle. It is used to illuminate the liturgical books during pontifical services, and may bear the coat of arms of the pope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bugias"@en .

aat:300299165 a skos:Concept ;
    skos:definition "Structures housing entry doors that are attached to the main door to form an interlocking system of two sets of doors, or occasionally revolving doors, such as in churches, theaters, banks, clean rooms in laboratories, ships, etc. In secure systems, it is required that the exterior door is closed before the interior door is opened. Even if this security measure is not employed (such as in a church), the system serves to protect the interior from outside weather, light, and noise. It differs from a vestibule in that a vestibule is part of the floor plan, designed as integral to and attached to the architecture, while an entry cubicle is primarily separate and attached to the architectural entrance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entry cubicles"@en .

aat:300299188 a skos:Concept ;
    skos:definition "Large chalices having two handles, particularly those of the style favored in the Middle Ages, resembling loving cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "two-handled chalices"@en .

aat:300299204 a skos:Concept ;
    skos:definition "Caps that are worn by the Pope, larger than a skull-cap and having flaps over the ears. They are often made of red wool or velvet and ornamented with red satin, having swan's down trim or lined with ermine. It is white during the week in albis. The name means \"camel-skin cap\"; incorporated in the Papal wardrobe since the 12th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camauros"@en .

aat:300299206 a skos:Concept ;
    skos:definition "Protective garments often used as armor, in the form of a shirt, covering the torso and made of mail, which is metal fabric consisting of iron or steel rings riveted or pressed together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirts of mail"@en .

aat:300299211 a skos:Concept ;
    skos:definition "Small bells in the presbytery or on exterior of churches, smaller than bells mounted in the bell tower. May also refer to small bells on musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "campanellas"@en .

aat:300299212 a skos:Concept ;
    skos:definition "Small bells used in the Celtic Rite liturgy; usually distinctively decorated with Celtic designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic campanellas"@en .

aat:300299221 a skos:Concept ;
    skos:definition "Series of fences or other barriers, usually metal or wood and substantial in size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fencing"@en .

aat:300299222 a skos:Concept ;
    skos:definition "Small or relatively insubstantial gates or door-like structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cancellettos"@en .

aat:300299224 a skos:Concept ;
    skos:definition "Small gates set into a balustrade, as the gate in a communion rail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cancelletti di balaustrata"@en .

aat:300299239 a skos:Concept ;
    skos:definition "Candles held by members of a group in processions. Processional candles may be of various designs and sizes; the term includes both the candle and the fixtures that secure them, usually with candles mounted to a hand grip or pole, often within a protective shade or glass shield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional candles"@en .

aat:300299253 a skos:Concept ;
    skos:definition "Inkwells in a stand or structure that also includes one or more candlesticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candlestick inkwells"@en .

aat:300299255 a skos:Concept ;
    skos:definition "Wall-mounted candelabra or other supports specifically for candles and intended to be mounted on a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle sconces"@en .

aat:300299268 a skos:Concept ;
    skos:definition "In the context of armor, plate arm guards protecting the arm from the humerus to the wrist, of the style used in Italy and elsewhere during the 14th-17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cannoni di braccio"@en .

aat:300299269 a skos:Concept ;
    skos:definition "Tubes used to dispense the consecrated Eucharistic wine. It is typically of larger diameter than a \"eucharistic straw,\" and usually has a reservoir in which a serving of wine is held until released into the mouth of the recipient. Although the term may have overlap with \"eucharistic straw,\" the straw typically is used for sipping. The purpose of the tube was to prevent spillage of the consecrated wine; it is known from ancient times, when methods of sharing the wine included spoon, straw, and tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eucharistic tubes"@en .

aat:300299270 a skos:Concept ;
    skos:definition "Traditional accessory for the celebration of the Eucharist, consisting of a straw, which is a very narrow tube, through which the consecrated wine may be sipped from the chalice; typically made of silver or gold. The purpose of the straw was to prevent spillage of the consecrated wine; it is known from ancient times, when methods of sharing the wine included spoon, straw, and tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eucharistic straws"@en .

aat:300299272 a skos:Concept ;
    skos:definition "Frames that sit upon the altar during mass, containing the words for parts of the mass; used to aid the priest during recitations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar card frames"@en .

aat:300299277 a skos:Concept ;
    skos:definition "Cabinets for storing wine, usually located near the dining table, having four or more openings for bottles, often with ice to cool the wine. The type is particularly well known in Tuscany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantinettas"@en .

aat:300299300 a skos:Concept ;
    skos:definition "Voluminous cloaks worn by higher Christian prelates, typically bishops and cardinals. In design, it is often circular, of purple or red color, having a large hood, and so large that the back trails on the ground, and the front is draped over one arm to allow free movement of the feet. This very full form did not develop until the 14th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cappa magnas"@en .

aat:300299312 a skos:Concept ;
    skos:definition "Padded hoods used inside the helmet for jousting, so as to hold the wearer's head firmly in place against the shock and whiplash of being struck with a lance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jousting hoods"@en .

aat:300299339 a skos:Concept ;
    skos:definition "Type of body armor to protect the skull, usually a particular type used from the end of the 15th to the beginning of the 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caschetti"@en .

aat:300299366 a skos:Concept ;
    skos:definition "Boxes that slide into openings in case furniture or shelving, used for storage but not mounted on runners as drawers would be."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drawer boxes"@en .

aat:300299372 a skos:Concept ;
    skos:definition "Cassoni that serve as wedding chests, often coming with the bride to her new home and decorated with images related to marriage and fertility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassoni nuziali"@en .

aat:300299497 a skos:Concept ;
    skos:definition "Megarian-style ceramics, often moldmade bowls, produced in central Italy and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italo-Megarian ware"@en .

aat:300299503 a skos:Concept ;
    skos:definition "Pottery that existed during the third and second centuries BCE, and was first found at Megara, but later in Attica and numerous other places. It is generally found on bowls, and is characterized by relief decoration on the exterior, created by a combination of wheel work, stamping, and molding. The surface may be covered with glaze that is also ornamented in black or red. Themes are usually of flowers, with occasional figures and narrative scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megarian ware"@en .

aat:300299536 a skos:Concept ;
    skos:definition "Wedge-shaped stones at the apex of masonry arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arch keystones"@en .

aat:300299540 a skos:Concept ;
    skos:definition "Blocks of stone that close the intersection of arches at the apex of a vault, such as a ribbed vault; may be covered by a round, decorative boss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vault keystones"@en .

aat:300299547 a skos:Concept ;
    skos:definition "Doors or closures of cast iron or another material, often decorative objects in their own right, used to cover the opening of a stove, oven, or furnace. In modern usage, may refer to any door constructed, as a component of a device or architecture, so as to enclose fire or to protect an area from fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire doors"@en .

aat:300299596 a skos:Concept ;
    skos:definition "Columns of the Corinthian style that is seated on a base and usually fluted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian columns"@en .

aat:300299597 a skos:Concept ;
    skos:definition "Columns of the Doric architectural order, having no bases and relatively simple capitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Doric columns"@en .

aat:300299598 a skos:Concept ;
    skos:definition "Columns, having bases, of the architectural order characterized by capitals with volutes and richly carved moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionic columns"@en .

aat:300299789 a skos:Concept ;
    skos:definition "Crosses comprising broad, flat planks of wood on which is painted the crucified Christ, often in lifesize or monumental scale and with additional scenes or figures filling the terminations of the arms and the area above and beneath the figure of Christ. Painted crosses were particularly common in Byzantine and early Italian art, typically placed over or near the altar in churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painted crosses"@en .

aat:300299792 a skos:Concept ;
    skos:definition "Crosses incorporating the chi-rho symbol, which is formed by the first two Greek letters in the name of Christ, where the \"X\" shape is imposed on the bar of the \"P\" shape rather than across it, forming a cross topped with a right facing loop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monogram crosses"@en .

aat:300299807 a skos:Concept ;
    skos:definition "Crosses with arms having split and spayed terminations, resembling the arms of a traditional ship's anchor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses recercely"@en .

aat:300299808 a skos:Concept ;
    skos:definition "Crosses with couped and pointed arms, that is, the two pointed ends of each arm are cut off to form a center point, resembling the end of a sword; typically used as a symbol in heraldry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aiguise crosses"@en .

aat:300299813 a skos:Concept ;
    skos:definition "Crosses that have arms terminating in roundels or knobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses pommy"@en .

aat:300299830 a skos:Concept ;
    skos:definition "Crosses with arms terminating in crosslets, and with additional small crosses located at the four open corners of intersection between the arms of the larger cross."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jerusalem crosses"@en .

aat:300299831 a skos:Concept ;
    skos:definition "Crosses in the shape of a Maltese cross, or occasionally other equal-armed crosses, having the color green. It was the device of the order of hospitalers of St. Lazarus of Jerusalem, which had a special duty of protecting leper hospitals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lazarus crosses"@en .

aat:300299840 a skos:Concept ;
    skos:definition "Crosses with a Maltese shape, but with arms having a pointed termination rather than indented, and a ball or point projecting from each of the three corners on each arm. It was the device of the medieval Counts of Toulouse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses of Toulouse"@en .

aat:300299842 a skos:Concept ;
    skos:definition "Crosses with each arm terminating in a stylized fleur-de-lis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses flory"@en .

aat:300299852 a skos:Concept ;
    skos:definition "Crosses with arms that are almost triangular, being very narrow where they meet and widening out towards the extremities, so that the whole resembles a square. In variations, the terminations are not cut off to form a square but fill a shield-shape or circle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses paty"@en .

aat:300299856 a skos:Concept ;
    skos:definition "Crosses used or worn by certain Christians as penance or a symbol of penance having been done. Examples include large crosses carried or dragged by penitents during Holy Week processions, images of crosses emblazoned on the garments of penitents, or cross-shaped objects worn around the neck, sometimes having rough or sharp points intended to injure the skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penitential crosses"@en .

aat:300299861 a skos:Concept ;
    skos:definition "Crosses with arms terminating in potents, which are bars forming a T-shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses potent"@en .

aat:300299865 a skos:Concept ;
    skos:definition "Crosses having a hook or bend in the end, ranging from a small point-like hook to a larger bend, as in the swastika."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fylfots"@en .

aat:300299866 a skos:Concept ;
    skos:definition "Crosses having the extremity of each arm in the form of a small cross."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-crosslets"@en .

aat:300299867 a skos:Concept ;
    skos:definition "Crosses with losenge-shaped or diamond-shaped truncations on the arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses fusilee"@en .

aat:300299870 a skos:Concept ;
    skos:definition "Stylized crosses with relatively short arms that are all shaved to a point, resulting in a form resembling a star with four arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses étoilées"@en .

aat:300299871 a skos:Concept ;
    skos:definition "Crosses having arms ending in a shape resembling three knobs or bud-like projections, similar to a trefoil leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses bottony"@en .

aat:300299934 a skos:Concept ;
    skos:definition "Visual works or parts of works made of stucco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stuccowork"@en .

aat:300300034 a skos:Concept ;
    skos:definition "Ornamented or embroidered forms of amice worn over the alb, having a circular shape with a round hole or slit in the center so that it can be placed over the head and extend just over the top of the shoulders to fall in a semicircle in front and at the back in the manner of a short cape. From the 8th through the 12th century it is documented as having been worn by several orders of the clergy; in the later centuries it has become restricted to the pope alone. In order to distinguish the papal garments from the earlier garments, use the narrower term \"papal fanons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanons"@en .

aat:300300043 a skos:Concept ;
    skos:definition "Long mantles worn at formal but non-liturgical occasions. The color of the garment indicates the rank of the cleric, black for secular priests, purple for bishops, and scarlet for cardinals. The pope does not wear a ferraiolone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferraiolones"@en .

aat:300300062 a skos:Concept ;
    skos:definition "Narrow windows having a single light; may be decorated with pilasters and topped by an arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monofora windows"@en .

aat:300300063 a skos:Concept ;
    skos:definition "Windows, usually arched windows, in which sub-arches or lobes form the arch or other part of the design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multifoil windows"@en .

aat:300300065 a skos:Concept ;
    skos:definition "Windows for which the jamb is cut obliquely (flared) inwards or outwards, creating a trapezoidal section and thus allowing better light entry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splayed windows"@en .

aat:300300219 a skos:Concept ;
    skos:definition "Standards incorporating the chi-rho and a wreath, used in the standard of Constantine the Great and other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labarums"@en .

aat:300300293 a skos:Concept ;
    skos:definition "Inclined, sometimes foldable supports, made of wood or metal, on which a missal or other liturgical book is placed on the altar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missal stands"@en .

aat:300300412 a skos:Concept ;
    skos:definition "Staffs carried in procession by participants, for example members of a religious confraternity, guild, congregation, parish, tribe, or a ruler's retinue. Identification of the group represented in the procession is typically affixed to the staff, including badges, the statue of the patron saint, or other items. For processional poles upon which banners, lanterns, torches, candles, or crosses or mounted, prefer the appropriate term describing the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional staffs"@en .

aat:300300504 a skos:Concept ;
    skos:definition "Short, cape-shaped garments that coveri the shoulders and reach only to the elbow, with an open front, which may be fastened by means of a row of small buttons; at the neck it has a very small and purely ornamental hood. The privilege of wearing the mozzetta belongs properly to no one but the pope, cardinals, exempt abbots, abbots general, and the four prelates di fiochetti."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mozzettas"@en .

aat:300300525 a skos:Concept ;
    skos:definition "Umbrella-like objects carried in processions, particularly as used to distinguish important people or things in the procession, as well as for protection from the sun. Examples are found in ancient, Asian, and western traditions. For example, in Christian tradition, parasols are held in procession as a sign of veneration over monarchs, high-ranking church dignitaries, or the blessed sacrament (the consecrated host)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional parasols"@en .

aat:300300532 a skos:Concept ;
    skos:definition "Clocks controlled by a pendulum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pendulum clocks"@en .

aat:300300764 a skos:Concept ;
    skos:definition "Devices for holding cards marking the place at a dining table, or other location, where each diner or other participant is assigned seating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "place card holders"@en .

aat:300300837 a skos:Concept ;
    skos:definition "Refers to relatively small reliquaries in the form of a rectangular box surmounted by a steeped-roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reliquiari a cassetta"@en .

aat:300300896 a skos:Concept ;
    skos:definition "Receptacle, typically of gold, silver, or another precious material, intended for the preservation of relics, which are the physical remains of a holy person or an object of particular veneration. Reliquary monstrances are distinguished by having an opening or transparent covering, sometimes a horizontal cylinder of glass, crystal, etc. through which the venerated object may be seen. For receptacles specifically for the display of the sacred Host, use \"monstrances.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reliquary monstrances"@en .

aat:300300917 a skos:Concept ;
    skos:definition "Reliquaries in the form of a rectangular box-shape, including the forms of a chest, coffin, or building surmounted by a roof-shaped cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chasse reliquaries"@en .

aat:300300970 a skos:Concept ;
    skos:definition "Closed, flat-soled slippers worn by pontiffs only at pontifical solemn mass and related functions; they were of various colors, including liturgical colors, throughout the centuries. They are not sandals. They are worn with liturgical stockings. The privilege of wearing the slippers and stockings belongs only to bishops, abbots, and other prelates by special privilege from the pope. Use of the slippers has fallen out of common use since the Second Vatican Council."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "episcopal sandals"@en .

aat:300301253 a skos:Concept ;
    skos:definition "Sculptures of various types that are created for or used for display in processions, either mounted on a pole or carried on a processional stretcher or other device. For a Christian crucifix mounted on a pole and used in processions, prefer \"processional crosses.\" For larger scenes mounted on a wheeled vehicle for use in a procession, prefer \"floats (vehicles).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional sculptures"@en .

aat:300301267 a skos:Concept ;
    skos:definition "Stelae marking the grave of, or otherwise in tribute to a deceased person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary stelea"@en .

aat:300301312 a skos:Concept ;
    skos:definition "Tabernacles, which are receptacles for sacred items representing the essence of the deity (for example consecrated hosts in Christian contexts), that are not fixed within an architectural structure and of small enough size to be portable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable tabernacles"@en .

aat:300301349 a skos:Concept ;
    skos:definition "General term for tables of small size or certain types of stands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small tables"@en .

aat:300301373 a skos:Concept ;
    skos:definition "Chests or tables of various designs used in kitchens or bakeries, having storage areas and a working surface. Used for the storage of flour, making of bread on the table top, and often for the storage of bread. For smaller, counter-top containers used to store bread, use \"bread boxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread chests"@en .

aat:300301393 a skos:Concept ;
    skos:definition "Fine terra sigillata that was produced in the province of Africa Proconsularis, the area corresponding to modernTunisia and other terrritory. It is distinguished by a thick-orange red slip over a slightly granular fabric. Interior surfaces are completely covered, while the exterior can be only partially slipped, particularly on later examples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African terra sigillata"@en .

aat:300301412 a skos:Concept ;
    skos:definition "Red slip ware produced in central, eastern, and southern Tunisia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African terra sigillata E"@en .

aat:300301414 a skos:Concept ;
    skos:definition "Its origin was Gallia Narbonensis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terra sigillata chiara B"@en .

aat:300301420 a skos:Concept ;
    skos:definition "Terra sigillata from the area of the Bay of Naples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sigillata Puteolana"@en .

aat:300301426 a skos:Concept ;
    skos:definition "Sigillata from the area of the Black Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pontic sigillata"@en .

aat:300301443 a skos:Concept ;
    skos:definition "Bells having a very particular ceremonial significance in ancient or Roman Catholic ceremonies. It may refer to a bell mounted on a pole and carried in procession or otherwise displayed, signifying a cathedral (seat of a bishop) and its link to the Pope. It derives from a medieval practice where a mounted bell was used in papal processions to alert passersby of the approach of the Pope. The term may also refer to a distinctive Etruscan or Roman carved or decorated ceremonial or funereal bell, or such a bell-shape depicted in two dimensions in a relief sculpture or wall painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tintinnabulos"@en .

aat:300301502 a skos:Concept ;
    skos:definition "Thuribles used in the Amrbosian rite liturgies, disntictive in that the thurible has no top cover; it is swung in a prescribed pattern clockwise before the censing of a person, altar, or other object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ambrosian rite thuribles"@en .

aat:300301504 a skos:Concept ;
    skos:definition "Thuribles in the shape of a structure or incorporating architectural elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural thuribles"@en .

aat:300301507 a skos:Concept ;
    skos:definition "Thuribles having a body that is spherical or globular in form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spherical thuribles"@en .

aat:300301532 a skos:Concept ;
    skos:definition "Vessels or other receptacles, usually two in number, used for storing the sacred oils used for baptism and ordinations, and for the annointing of the sick. Typically placed with a third vessel, for the holy chrism, which is a mixture of oil and balsam. Set of three containers for the holy oils in a case or box used for the anointment Sometimes provided with three matching spoons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy oil stocks"@en .

aat:300301620 a skos:Concept ;
    skos:definition "Yellow-skinned fruit of the Pouteria caimito tree, having mild-flavored, mucilaginous white flesh. Until it reaches maturity, the fruit of the abiu is green, hard, and contains acrid latex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abiu"@en .

aat:300301749 a skos:Concept ;
    skos:definition "Genus of plants (family Amaryllidaceae), of which the chief species is the American Aloe, whose stately flower-stem (sometimes forty feet high) is produced only when the plant arrives at maturity, at the age of from ten to seventy years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agave"@en .

aat:300302722 a skos:Concept ;
    skos:definition "An alcoholic beverage obtained by the fermentation of malt from cereal grain (or another saccharine substance), flavored with hops or other aromatic bitters. Formerly the term was used as distinct from \"ale,\" with beer being hopped; now \"ale\" is used to describe a type of beer. May also be applied as a generic reference to other fermented liquors of various kinds, flavored by various ingredients such as ginger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beer"@en .

aat:300303176 a skos:Concept ;
    skos:definition "Unreal creatures of the imagination; grotesque monsters, formed of the parts of various animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chimeras"@en .

aat:300303196 a skos:Concept ;
    skos:definition "Legendary one-eyed giants in ancient Greek mythology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclopes"@en .

aat:300303357 a skos:Concept ;
    skos:definition "Convocations of three or more authorities or experts to confer and give advice or reach conclusions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concilia"@en .

aat:300303413 a skos:Concept ;
    skos:definition "Motifs in the form of horns of plenty, symbolism derived from ancient Greek mythology; originally, a curved goat's horn possessed by the nymph Amalthaea, which could be filled with whatever the owner wished. Most often depicted or formed as a horn or cone filled with fruits and grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornucopias"@en .

aat:300303759 a skos:Concept ;
    skos:definition "Cross with arms that resemble hazelnuts or filberts in their husks, joined together at the large blunt ends with the frilly ends outward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "avellan crosses"@en .

aat:300303762 a skos:Concept ;
    skos:definition "Crosses with an X or several crossed lines placed over the point where the two bars of the cross intersect, symbolizing rays of light or a star."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crosses rayonnée"@en .

aat:300303786 a skos:Concept ;
    skos:definition "Ephemeral structures made of food and drink, intended to be consumed during a festival or other occasion. The name refers to the fabled land of Cockaigne, the land of plenty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuccagne"@en .

aat:300304902 a skos:Concept ;
    skos:definition "Physical strength, might, or vigor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "force"@en .

aat:300305226 a skos:Concept ;
    skos:definition "Period of life prior to mature adulthood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "youth"@en .

aat:300305364 a skos:Concept ;
    skos:definition "Mythical female beings having snakes for hair, and whose look turned the beholder into stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorgons"@en .

aat:300305500 a skos:Concept ;
    skos:definition "The style and culture of the Iberians, a prehistoric people of southern and eastern Iberian Peninsula, who arrived 8th-6th cen. BCE. The term may also refer to the culture of the modern nations of Spain and Portugal together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iberian"@en .

aat:300305635 a skos:Concept ;
    skos:definition "The quality or status of being free from wrong-doing, illegal acts, sin, guilt, evil, or moral wrong."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "innocence"@en .

aat:300306478 a skos:Concept ;
    skos:definition "Images drawn so that one subject appears when the item is held upright, but another is seen when the viewer turns the image upside down or sideways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metamorphic pictures"@en .

aat:300306786 a skos:Concept ;
    skos:definition "In Greek and Roman mythology, goddesses regarded as presiding over and inspiring learning and the arts, especially poetry and music. Often, but not always, numbering nine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muses"@en .

aat:300307202 a skos:Concept ;
    skos:definition "Distinctive processional statues depicting Jesus on a donkey, mounted on a wheeled platform. Typically life-size or nearly so, they were common in Palm Sunday processions in certain regions of Catholic northern Europe from the 10th century; found also in southern Europe and South and Central America. Smaller versions were made in imitation of the life-size statues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palmesels"@en .

aat:300307716 a skos:Concept ;
    skos:definition "General term for representations of nude, chubby toddlers, typically male and often with wings, derived from personifications of Eros in Greek and Roman art and Cherubim of Christian tradition. They most frequently appear in both mythological and religious art of the Renaissance, Baroque, and Victorian periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "putti"@en .

aat:300309064 a skos:Concept ;
    skos:definition "Acts or thoughts that are transgressions of the divine law and an offence against God, or are a deliberate violation of some religious or moral principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sin"@en .

aat:300309068 a skos:Concept ;
    skos:definition "Operas comprising semi-dramatic performance in which song and dialogue alternate, popular in Germany in the latter part of the 18th century. Usually comic in tone. The earliest singspiels were light plays with dialogue interspersed with popular songs; rose to great popularity in the late 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "singspiels"@en .

aat:300309801 a skos:Concept ;
    skos:definition "The state or quality of being personally vain, having an overly high opinion of oneself, self-conceit, desire for admiration, and an overly strong focus on physical beauty and earthly possessions over intellect and moral values."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vanity"@en .

aat:300310042 a skos:Concept ;
    skos:definition "In Jewish tradition, the anniversary of the death of a parent or other close relative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yahrzeits"@en .

aat:300310077 a skos:Concept ;
    skos:definition "Prints made by the monoprint process resulting from direct painting combined with a traditional printmaking process, such as silk screen, etching, woodcut, and lithography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monoprints"@en .

aat:300310079 a skos:Concept ;
    skos:definition "Apparatuses for making coffee by forcing boiled water under pressure through finely ground coffee. They are used primarily for making espresso and other traditional Italian coffee-based beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "espresso machines"@en .

aat:300310080 a skos:Concept ;
    skos:definition "Very small audiocassettes roughly a quarter of the size of a standard audiocassette. For audiocassettes of comparable size, but that lack a capstan drive system, use 'minicassettes.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microcassettes"@en .

aat:300310081 a skos:Concept ;
    skos:definition "Small audiocassettes that are approximately one quarter the size of a standard cassette, and that use only the reels to achieve tape transport. For audiocassettes of roughly the same size but that use a capstan transport system, use 'microcassettes.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minicassettes"@en .

aat:300310082 a skos:Concept ;
    skos:definition "Special effects artists, or artists in the visual effects department of a film studio, who design and paint false backgrounds (known as matte paintings). The painted backgrounds are then incorporated into matte shots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matte artists"@en .

aat:300310083 a skos:Concept ;
    skos:definition "Primarly used in film industry special effects, mattes are sheilds or masks placed in front of a camera's lens to block out part of the image being shot, for the purpose of shooting subsequent images which may be inserted into the blocked space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mattes"@en .

aat:300310084 a skos:Concept ;
    skos:definition "Large paintings used as mattes in motion picture special effects. The paintings are most often false backgrounds, foregrounds, or scenery in general, and are later composited with other visual elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matte paintings"@en .

aat:300310085 a skos:Concept ;
    skos:definition "A simple electron tube with only two electrodes, an anode and a cathode. For more sophisticated electron tubes housed in evacuated glass bulbs, use \"vacuum tubes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diodes"@en .

aat:300310088 a skos:Concept ;
    skos:definition "Format in which a large sheet of paper is printed on only one side, and not folded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broadsheet"@en .

aat:300310091 a skos:Concept ;
    skos:definition "Elaborate ornamental calligraphic imperial monograms of the Ottoman sultans (reigned 1281-1924), formed of the name, titles, and formula for \"ever victorious.\" They were used as authentication on documents, because the Ottoman sultans did not sign their decrees. The tuǧras were drawn by specially designated high officials with the rank of pasha, who checked the copy for accuracy. In form, the tuǧra is distinguished by three high verticals and one large elliptical curve extending to the left and enclosing a smaller, similar curve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuǧras"@en .

aat:300310093 a skos:Concept ;
    skos:definition "Refers to tangible objects capable of being moved or conveyed from one place to another, as opposed to real estate or other buildings. The term is borrowed from legal jargon. Art and other cultural works may be classified in two broad categories: movable works and built works. Movable works, which are typically located in a repository, have a repository identification number, have a provenance of former locations, and other characteristics that do not apply to built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movable works"@en .

aat:300310095 a skos:Concept ;
    skos:definition "In Zen Buddhism, satori refers to a sudden personal enlightenment analagous to the original moment of spiritual rebirth experienced by the Gautama Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satori"@en .

aat:300310096 a skos:Concept ;
    skos:definition "Embroidery stitches in which the thread is wound several times round the needle and taken back through the fabric at the same spot to create a tiny raised dot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French knots"@en .

aat:300310097 a skos:Concept ;
    skos:definition "Connecting loop stitches that form links, as in a chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain stitches"@en .

aat:300310098 a skos:Concept ;
    skos:definition "Small stitches sewn in a line by passing a needle in and out of the fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running stitches"@en .

aat:300310099 a skos:Concept ;
    skos:definition "Refers to a style that borrows elements characteristic of the carnival, or that is florid or grotesque. Frequently used to refer generally to literary style, the visual arts, or musical compositions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnivalesque"@en .

aat:300310100 a skos:Concept ;
    skos:definition "Embroidery stitches consisting of satin and brick stitches, and arranged to form repeated zigzag or interlocking patterns of different colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Florentine stitches"@en .

aat:300310101 a skos:Concept ;
    skos:definition "Stitches made with a double purl, used to finish the edges of tailored buttonholes and to form a secure edge in cut work. For similar stitches are further apart used for thick fabrics use \"blanket stitches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttonhole stitches"@en .

aat:300310102 a skos:Concept ;
    skos:definition "Single purl edge finish stitches, used in laces and openwork embroidery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttonhole stitches"@en .

aat:300310104 a skos:Concept ;
    skos:definition "Ridges of hard material; typically wood, ivory, plastic or metal inserted at the junction of the neck and headstock of chordophones, chiefly guitars, which maintains both the proper height and lateral spacing of the strings over the fretboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuts"@en .

aat:300310105 a skos:Concept ;
    skos:definition "Inlaid decorative and protective wood, plastic, or other material placed along the edges of a chordophone's belly, back, or fretboard. The term is usually used chiefly to refer to such edging on violins or guitars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purfling"@en .

aat:300310106 a skos:Concept ;
    skos:definition "Sashes historically worn by bishops of the Catholic church, and more recently only by the Pope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "succinctoria"@en .

aat:300310107 a skos:Concept ;
    skos:definition "Instruments of the type first invented by Emil Berliner in the 1890s for the reproduction of recorded sound, comprising a turntable for a disc record, a sound box mounted on a pivot (allowing the record groove to guide the stylus), and a conical sounding-horn. Gramophones operate similarly to \"cylinder phonographs\" but use, instead of a drum, a flat disc containing a spiral groove; a stylus is allowed to rest in the groove as the disc is rotated on a turntable, and the vibrations communicated to the stylus by the irregularities in the groove are transformed into sound vibrations. The earliest gramophones were also used to cut records, using blank discs. For similar devices that employ electronic amplification of sound recorded on more modern high fidelity vinyl discs, in use since the 1950s, use \"record players.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gramophones"@en .

aat:300310109 a skos:Concept ;
    skos:definition "Refers to the plates of gramophones or record players on which the recorded discs rest and are spun to draw the grooves of recorded sound under a stylus, at fixed speeds, to enable reproduction of sound. Usage of the term is frequently extended to the totality of the machinery or housing of this plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turntables"@en .

aat:300310110 a skos:Concept ;
    skos:definition "A data transfer technique that allows the user to access audio and video media via the Internet without downloading the entirety of a very large file. A host or source \"streams\" packets of information to the user in smaller increments as it is viewed. Unlike downloads, streaming video is not intended to be retained as a file on a viewer's computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "streaming video"@en .

aat:300310111 a skos:Concept ;
    skos:definition "Translucent porcelain plaques produced from 1830 to ca. 1900, most in Germany by the Royal Porcelain Manufactory in Berlin and by Meissen, and in England by Minton and Copeland. Relief molds of decorative motifs, usually based on paintings, were impressed into hard-paste porcelain while in its soft state so that after firing the image would be visible by transmitting light through the plate. These objects were typically hung in windows, placed on stands as screens, or incorporated into lamp shades. The process was invented by Baron Paul de Bourgoing and patented in France in 1827."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithophanes"@en .

aat:300310112 a skos:Concept ;
    skos:definition "Style of blanc de Chine porcelain ware, which is fine white translucent porcelain with a thick white glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanc de Chine"@en .

aat:300310113 a skos:Concept ;
    skos:definition "Conical, double reed instruments of South India, similar to shanais. The pipe of a nagaswaram contains seven equidistant finger-holes with no thumb-hole. Five more holes are located near the distal end of the pipe, which are used for tuning purposes, and may also be filled with wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nagaswarams"@en .

aat:300310115 a skos:Concept ;
    skos:definition "Stamps that share the appearance of conventional postage stamps, including size, perforated edges, and in some cases imagery, but that are created and used by artists engaging in the practice of mail art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artistamps"@en .

aat:300310116 a skos:Concept ;
    skos:definition "Refers generally to objects designed specifically to support vessels such as Roman kraters or Chinese bronze ritual vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vessel stands"@en .

aat:300310118 a skos:Concept ;
    skos:definition "Balustrades or railings enclosing a sacred object or places of veneration in Indic religious structures, the railing-formed blind dado of a pillared porch/raṅgamaṇḍapa; blind railing-enclosure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vedikās"@en .

aat:300310119 a skos:Concept ;
    skos:definition "Generally, announcements of nuptial ceremonies. May be extended to multiple types, including formal printed announcements intended to be mailed, announcements in newspapers, or any historical variant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding announcements"@en .

aat:300310120 a skos:Concept ;
    skos:definition "Supporting structures composed of ribs of any material that intersect diagonally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diagrids"@en .

aat:300310121 a skos:Concept ;
    skos:definition "Paintings that were initially exhibited in the official Paris Salon of the 18th and 19th centuries, where members of the Academie Royale de Peinture et de Sculpture would exhibit recent works. Salon paintings are most often academic in nature, and are reflective of the forum in which they were exhibited; i.e.: a competition for public and private commissions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salon paintings"@en .

aat:300310122 a skos:Concept ;
    skos:definition "Headgear dating from the Iron Age. The only known example of this garment was found preserved in peat in the 19th century. Radiocarbon-dating by the National Museums of Scotland established its origin as dating between 250 - 615 CE. The original object is considered the oldest and best-preserved textile in Britain. At least one replica has been made for study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orkney hoods"@en .

aat:300310123 a skos:Concept ;
    skos:definition "Sheer, crisp fabric made with a loose plain weave; usually made from silk or synthetics such as rayon, nylon, acrylic or polyester. It is fine to leightweight, strong, stable, and durable. It is distinct from organdy, which is made from cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organza"@en .

aat:300310125 a skos:Concept ;
    skos:definition "Synthetic elastomeric fiber or fabric composed largely of alternating rigid and flexible segments of polyurethane. It is used in the clothing industry, especially for hosiery, underwear, swimwear, and other close-fitting garments. Spandex is the generic name in the United States and Canada. Elastane is the generic name used elsewhere. Lycra is a proprietary name for this material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spandex"@en .

aat:300310127 a skos:Concept ;
    skos:definition "An absorbent paper or board, made from several sheets moistened and pasted together, used for making moulds for casting printing plates and stereotypes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flong"@en .

aat:300310128 a skos:Concept ;
    skos:definition "Sheer, lightweight, crisp, semitransparent cotton fabric. It is a plain woven cloth of fine combed yarns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organdy"@en .

aat:300310130 a skos:Concept ;
    skos:definition "Seats or covered pavilions for two or more people on the back of an elephant or camel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "howdahs"@en .

aat:300310132 a skos:Concept ;
    skos:definition "A fly-whisk made of hair or feathers or a representation of same, held by figures attending royalty or respected personages in Asia, and particularly in the art of the Indian subcontinent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caurī"@en .

aat:300310133 a skos:Concept ;
    skos:definition "Miniature portraits of a single human eye, often set into a brooch, small enameled case, or other small object. Most date from the late 1790s until ca. 1825, and were given as tokens from anonymous lovers, from one female friend to another, or as a mourning memento of a loved one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye portraits"@en .

aat:300310134 a skos:Concept ;
    skos:definition "Loose-fitting unisex pullover shirts derived from African design and made from African fabrics or Africa-inpired fabrics. Dashikis became part of the wardrobe of black activists in the 1960s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dashikis"@en .

aat:300310135 a skos:Concept ;
    skos:definition "The exoskeleton of salt-water mollusks, often used for jewelry or decorative objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seashell"@en .

aat:300310136 a skos:Concept ;
    skos:definition "Material comprising a narrow strip of paper, plastic, cloth, or another material coated on one or both sides with an adhesive, which, depending upon type, is activated by water, solvents, heat, or pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adhesive tape"@en .

aat:300310137 a skos:Concept ;
    skos:definition "Audio recordings or multimedia files formatted like radio programs, but distributed as digital files online. The user may play these back at his or her convenience on a computer or digital music player. Most often podcasts include interviews, music, or tutorials. The term was coined in 2004."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "podcasts"@en .

aat:300310139 a skos:Concept ;
    skos:definition "Chinese method or technique of painting using colored washes without any outlines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boneless"@en .

aat:300310140 a skos:Concept ;
    skos:definition "Chinese painting technique using meticulous brush work with attention to details, forms and standards. Usually confined to color paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gongbi"@en .

aat:300310141 a skos:Concept ;
    skos:definition "Method of Chinese painting by free sketch or freehand brushwork, usually done in ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xieyi"@en .

aat:300310143 a skos:Concept ;
    skos:definition "Chinese painting style of gold and green landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jinbi shanshui"@en .

aat:300310144 a skos:Concept ;
    skos:definition "Chinese painting style in monochrome ink, not color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shuimo"@en .

aat:300310145 a skos:Concept ;
    skos:definition "Chinese painting technique having outline and definition, giving shading, depth, and texture to the work using ink alone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "broken ink"@en .

aat:300310146 a skos:Concept ;
    skos:definition "Chinese painting techinque using broad full strokes and no outline, often with the side of the brush. Used often during the Southern Sung period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splashed ink"@en .

aat:300310147 a skos:Concept ;
    skos:definition "Chinese painting technique in which the brush is applied quickly across the paper, which separates the hairs of the brush, leaving streaks of untouched white background, giving the design a light and airy quality. Most frequently used in bamboo and bird and flower paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying white"@en .

aat:300310148 a skos:Concept ;
    skos:definition "Style of Chinese painting where the fingers and fingernails are used used as implements instead of, or in addition to, a brush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chih-hua"@en .

aat:300310149 a skos:Concept ;
    skos:definition "Small pieces of storage furniture built into or hung on a wall near the main altar, in the baptistery, or in the sacristy to contain the holy oils. The door, which must be kept locked, sometimes bears the words \"Olea Sancta.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy oils aumbries"@en .

aat:300310150 a skos:Concept ;
    skos:definition "Refers to all of the animals or animal life of a particular area or time period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauna"@en .

aat:300310152 a skos:Concept ;
    skos:definition "All of the plants or plant life of a particular region or time period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flora"@en .

aat:300310153 a skos:Concept ;
    skos:definition "Small, non-vascular plants characterized by tall horn-shaped sporophytes that grow on a more flattened gametophyte; typically have a single, large chloroplast in each cell. Formerly classified with Bryophyta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anthocerophyta"@en .

aat:300310154 a skos:Concept ;
    skos:definition "Small primitive photosynthetic, nonvascular plants growing in wet places and resembling green seaweeds or leafy mosses. Formerly classified with Bryophyta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hepatophyta"@en .

aat:300310156 a skos:Concept ;
    skos:definition "Ancient group of plants known only as fossils dating to the Middle Devonian to Early Carboniferous; they are thought to be ancestors of ferns and horsetails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cladoxylopsida"@en .

aat:300310157 a skos:Concept ;
    skos:definition "Small plant distinguished by the club-like shape of its upright fertile spore-cases and the very small microphylls, a kind of leaf that arose and evolved independently from the leaves of other vascular plants; the microphyll has only a single unbranched strand of vascular tissue. While this division is a small and inconspicuous group of plants today, in the Carboniferous some lycophytes were forest-forming trees more than 35 meters tall. Lycophytes are the oldest extant group of vascular plants, and dominated major habitats for 40 million years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lycophyta"@en .

aat:300310158 a skos:Concept ;
    skos:definition "Clade of woody plants intermediate between ferns and gymnosperms comprising the Devonian genus Archaeopteris. Like the true gymnosperms, they commonly had secondary growth of their vascular tissues (i.e. they produced wood), and some grew to be tall trees. However, unlike true gymnosperms, they did not produce seeds, but rather released their spores as do ferns. Two major groups of progymnosperms are recognized, the Archaeopteridales and Aneurophytales. A third group, the Protopityales is sometimes recognized, but it is poorly known, and so its relationship to other plants is unclear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Progymnospermophyta"@en .

aat:300310159 a skos:Concept ;
    skos:definition "Group consisting of two extant genera, Psilotum and Tmesipteris. They are chiefly tropical, clump-forming plants of skeletal appearance resembling whisk brooms. These plants are primitive in structure, lacking both roots and leaves, or having structures on the aerial shoot that are foliar. They are structurally similar to the fossil genus Rhynia. Recent molecular systematic studies suggest that the family is actually related to primitive ferns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Psilophyta"@en .

aat:300310160 a skos:Concept ;
    skos:definition "Cryptogamous (using sexual reproduction but lacking stamens or pistils) with hollow, jointed stems and whorls of slender branches at the joints. Today comprises one genus and around 30 species, but they were abundant in earlier periods; some Paleozoic sphenophytes grew up to 100 feet in height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphenophyta"@en .

aat:300310162 a skos:Concept ;
    skos:definition "includes a variety of animals that have polyps with a flower-like appearance. sea anemones, a variety of corals, sea fans, and sea pens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anthozoa"@en .

aat:300310163 a skos:Concept ;
    skos:definition "Small deep sea worm-like mollusks that lack both shells and distinct muscular feet, but have scales and calcareous sclerites (spines). The live vertically positioned in soft sediment, feeding upon organic detritus. In some classifications, this division, along with \"Solenogastres\" is called a class instead of a subclass; here the two are combined under class \"Aplacophora.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caudofoveata"@en .

aat:300310164 a skos:Concept ;
    skos:definition "Small deep sea worm-like mollusks lacking calcareous plates on the body but having fine slimy spicules on the covering mantle and known as narrow-footed gliders. In some classifications, this division, along with \"Caudofauveata\" is called a class instead of a subclass; here the two are combined under class \"Aplacophora.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solenogastres"@en .

aat:300310165 a skos:Concept ;
    skos:definition "Class of deep-sea mollusks lacking a shell and but covered by solid or hollow aragonotic sclerites (spines). They are characterized by having a mouth with very complex salivary glands and a unique sense organ, the vestibulum. In some classifications the subclasses under this class, Solenogastres and Caudofoveata, are listed as separate classes in their own right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aplacophora"@en .

aat:300310166 a skos:Concept ;
    skos:definition "Order of marine cephalopod mollusks characterized by having eight short arms and two usually longer tentacles; they differ from the related squid in having a calcified internal shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sepiida"@en .

aat:300310167 a skos:Concept ;
    skos:definition "Order of small marine cephalopod mollusks having eight suckered arms and two tentacles; they are closely related to cuttlefish but differ in having a rounder mantle than cuttlefish and lacking an internal cuttlebone. In some classifications, they are a family of Sepiida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sepiolida"@en .

aat:300310168 a skos:Concept ;
    skos:definition "Order of deepwater squid-like cephalopods containing only one extant member; distinguished by possessing a distinctive buoyancy organ, which is a chambered internal shell. In some classifications, they are a family of Sepiida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spirulida"@en .

aat:300310169 a skos:Concept ;
    skos:definition "Order of cephalopods containing only one extant member; considered to be a possible connecting link between the Teuthida and the Octopoda. They are purplish-black gelatinous animals with one or two pairs of paddle-shaped fins at various stages of growth; they have eight arms and two small retractile filaments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vampyromorpha"@en .

aat:300310170 a skos:Concept ;
    skos:definition "Ancient subclass (or order) of which Nautilus is the last surviving genus; ancient specimens are important in paleontology for dating the strata in which they appear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nautiloidea"@en .

aat:300310171 a skos:Concept ;
    skos:definition "Marine cephalopods possessing a many-chambered external shell with simple septa; represented by a small number of extant species, but over 2,500 species flourished in the early Paleozoic era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nautilida"@en .

aat:300310172 a skos:Concept ;
    skos:definition "Bivalves separated by some into a subclass based on shell structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pteriomorphia"@en .

aat:300310173 a skos:Concept ;
    skos:definition "Order of about 600 species of bivalves having unequal shell valves, typically lacking hinge teeth, with a shell structure of foliated calcite, and other distinguishing characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostreoida"@en .

aat:300310174 a skos:Concept ;
    skos:definition "General term used to refer to several species of bivalve mollusks of family Ostreidae and and of other families, found in marine habitats or brackish water; certain species (of family Ostreidae) are used by humans for food; certain others of other families are used for producing pearls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oysters"@en .

aat:300310175 a skos:Concept ;
    skos:definition "A watermark placed in the corner of a sheet of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornermarks"@en .

aat:300310176 a skos:Concept ;
    skos:definition "Subclass of gastropods that includes marine snails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prosobranchia"@en .

aat:300310178 a skos:Concept ;
    skos:definition "Prosobranchia having 7 denticles or teeth; most are herbivorous, but a few families are parasites or predators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesogastropoda"@en .

aat:300310179 a skos:Concept ;
    skos:definition "Cowrie shells (Cypraeidae) and egg shells (Ovulidae) that have highly polished and brilliantly colored shells and a mantle, which may cover the shell; if touched, members of group suddenly withdraw, the change in colour serving to confuse predators; common in shallow tropical oceans, some species in cooler waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypraeoidea"@en .

aat:300310180 a skos:Concept ;
    skos:definition "Family containing several species of small marine gastropods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypraeidae"@en .

aat:300310181 a skos:Concept ;
    skos:definition "Distinguished by a foot and operculum that are greatly modified; they move with a lurching motion; they feed on algae and plants. Some species used for human food, others used by humans for decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stromboidea"@en .

aat:300310182 a skos:Concept ;
    skos:definition "Family of gastropods known as \"true conchs,\" that feed on fine plant matter in warm waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strombidae"@en .

aat:300310183 a skos:Concept ;
    skos:definition "Term used in a general sense to refer to any animal or plant that eats animals, as opposed to a plant-eating herbivore or an omnivore, that has a diet of both plant and animal material. For members of the mammalian order Carnivora, use \"Carnivora\" or the alternate descriptor \"carnivores (order).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnivores"@en .

aat:300310185 a skos:Concept ;
    skos:definition "Animals belonging to species that are not domesticated and have not been altered by humans through selective breeding to modify behavior or appearance; includes wild species of animals that are cared for by humans in a zoo, park or other place, even if the animal has been bred and raised in captivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wild animals"@en .

aat:300310188 a skos:Concept ;
    skos:definition "The digits of the foot of a human or an animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toes"@en .

aat:300310189 a skos:Concept ;
    skos:definition "The joints that connect the foot with the leg of a human or an animal; also used for the larger area comprising the slender part of the leg between this joint and the calf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ankles"@en .

aat:300310190 a skos:Concept ;
    skos:definition "The joints, or region surrounding the joint, between the thigh and the lower leg of a human or an animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knees"@en .

aat:300310191 a skos:Concept ;
    skos:definition "In bipedal and quadrupedal animals and in humans, the projecting part of the body on each side formed by the lateral expansions of the pelvis and upper part of the thigh bone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hips"@en .

aat:300310192 a skos:Concept ;
    skos:definition "Parts of a human's or an animal's body that supply support and locomotion, such as the two lower limbs of the human body. For limbs truncated in a hand rather than a foot, use \"arms (animal components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legs"@en .

aat:300310193 a skos:Concept ;
    skos:definition "Parts of a human's or an animal's body, usually having fingers, located below the wrist joint of the arms, characterized by being routinely used for purposes other than support and locomotion. For the truncating components of legs, use \"feet (animal components),\" \"paws (animal components),\" \"hooves (animal components),\" or another appropriate term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hands"@en .

aat:300310194 a skos:Concept ;
    skos:definition "The terminal parts of the hand of a human or an animal, usually numbering five (as in humans) or four."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fingers"@en .

aat:300310195 a skos:Concept ;
    skos:definition "The joints between the fore- and the upper arm of humans or animals. For the similar joint on legs, use \"knees (animal or human components.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elbows"@en .

aat:300310198 a skos:Concept ;
    skos:definition "Group of invertebrate marine animals that take the form of an elongated polyp, specifically a hollow stalklike structure with a mouth and tentacles at the upper end; the animals live in a tube of slime on the ocean bottom. The genus is widely distributed in tropical and subtropical waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cerianthus"@en .

aat:300310199 a skos:Concept ;
    skos:definition "Species of tube anemone found in shallow waters from New England to Florida. It grows to about 60 cm (24 inches) in length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cerianthus americanus"@en .

aat:300310200 a skos:Concept ;
    skos:definition "Parts of a human's or an animal's body, usually having toes, located below the ankle joint of the legs, with the main function of supplying support and locomotion. For the truncating components of arms, use \"hands (animal components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feet"@en .

aat:300310201 a skos:Concept ;
    skos:definition "Parts of a human's or an animal's body that are forelimbs, truncated in a hand and routinely used for purposes other than support and locomotion. For limbs truncated in a foot rather than a hand, use \"legs (animal components).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arms"@en .

aat:300310202 a skos:Concept ;
    skos:definition "The feet of a quadrupedal animal, usually reserved for feet having a keratinized sheath covering the toes or lower part of the foot, as is typical of ungulates such as horses, cows, pigs, and goats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooves"@en .

aat:300310203 a skos:Concept ;
    skos:definition "The carpus joints that connect the arm with the hand of humans and other animals, or the leg with the foot of a bird."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrists"@en .

aat:300310204 a skos:Concept ;
    skos:definition "In former classifications, referred to a major division of Mammalia comprising all hoofed mammals, which are now divided into the orders Perissodactyla (odd-toed ungulates) and Artiodactyla (even-toed ungulates)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ungulata"@en .

aat:300310205 a skos:Concept ;
    skos:definition "Group of marine animals characterized by having at some point in their life cycle a hollow dorsal nerve cord, a notochord, and gill slits, including hemichordates, urochordates, cephalochordates, or any hypothetical ancestral form of any of these. The protochordates lack a skull and vertebrae and are believed to resemble the ancestors of the vertebrates. They include the subphylums of Tunicata and Cephalochordata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protochordata"@en .

aat:300310213 a skos:Concept ;
    skos:definition "Family of hagfishes distinguished from other hagfishes by having gill pairs that share a common opening on each side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myxinidae"@en .

aat:300310214 a skos:Concept ;
    skos:definition "Family of hagfishes distinguished from the family Myxinidae of hagfishes by having gills that open separately on the surface rather than on each side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eptatretidae"@en .

aat:300310215 a skos:Concept ;
    skos:definition "Style of domestic construction using four horizontal wooden beams (schwellen) that support vertical squared posts. This style produced a very stable frame that allowed the stacking of floors; it was the precursor to fachwerbau and other timber-frame construction. It has been found in Germany in structures dating to as early as the late 12th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "schwellenbau"@en .

aat:300310216 a skos:Concept ;
    skos:definition "Style of timber-framed houses particular to Germany and nearby areas, distinguished by rather small, regular square divisions. Developed from earlier schwellenbau constructions in the mid- to late 14th century; similar in style to the later Tudor Revival style of England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fachwerkbau"@en .

aat:300310217 a skos:Concept ;
    skos:definition "Class of vertebrate fish characterized by lepidotrichia or fin rays, meaning their fins are webs of skin supported by bony or horny spines in contrast to the fleshy lobed fins of some other fish. There is generally no fleshy base to their paired fins, no internal nares, their air sacs usually function as swim bladders, and their skeleton is usually well ossified. The class contains 46 orders representing over 30,000 species. The earliest known fossil dates to the Late Silurian, 420 million years ago. In some classifications, it is listed as a class instead of a subclass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Actinopterygii"@en .

aat:300310218 a skos:Concept ;
    skos:definition "Collaborative, instructional Web-based seminars that do not require participants to be in physical proximity to one another. Webinars may include the ability to interact with other participants via audio or video feeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "webinars"@en .

aat:300310219 a skos:Concept ;
    skos:definition "Class of vertebrate fish characterized by lobed paired fins with a fleshy base over a bony skeleton and joined to the body by a single bone, persisting notochord, internal nares, and two dorsal fins with separate bases as opposed to the single dorsal fin of ray-finned fishes. They are extremely ancient in origin, appearing in the Lower Devonian about 390,000,000 years ago. They gave rise to amphibians. In some classifications, it is listed as a class instead of a subclass. Recognition of the subclass or class Sarcopterygii is controversial because some ichthyologists believe that the two major groups, the Crossopterygii (including the rhipidistians and coelacanths) and the Dipnoi arose from independent origins, given that the current structures of the two groups are widely divergent. The primitive members, however, show several similarities, supporting the view that they had a common ancestor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sarcopterygii"@en .

aat:300310221 a skos:Concept ;
    skos:definition "Extinct class of vertebrate jawed fish-like animals known mainly from fossils of the Silurian and Devonian periods, having the head and pectoral region encased in broad, flat bony plates. Characterized by jaws supported by both cranium and hyoid arch, a partly ossified cranium, a head and trunk with armor that is jointed at the neck, often pelvic fins, pectoral fins or finlike structures, and gill arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Placodermi"@en .

aat:300310222 a skos:Concept ;
    skos:definition "Class of vertebrate shark-like aquatic animals characterized by having no scales, four gill pairs under one gill opening on each side, an erectile dorsal fin, in using claspers to accomplish internal fertilization of females, laying eggs with leathery cases, differing from sharks in having upper jaws that are fused to the braincase, separate anal and urogenital openings, and a few large permanent grinding tooth plates instead of teeth. In some classifications, they are included in the same class with rays and sharks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holocephali"@en .

aat:300310223 a skos:Concept ;
    skos:definition "Order of serpent-like amphibians, having a compact skull for burrowing with many compound bones, limbs or girdles, a persistent notochord, typically having naked skin (although some have scales), complete metamorphosis like frogs and toads, a compact skull, and lidless tiny eyes nearly hidden by the skin. Dates from Early Jurassic to present, with six extant families and about 170 living species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gymnophiona"@en .

aat:300310224 a skos:Concept ;
    skos:definition "Order of amphibians characterized by larvae lacking true teeth and external gills, adults being tailless and having elongated hind limbs modified for jumping, and a single frontoparietal and no lacrimal bone in skull. Dates from the Middle Jurassic to present, including two extinct and 28 or more extant families with over 5,400 living species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anura"@en .

aat:300310225 a skos:Concept ;
    skos:definition "Members of an order of amphibians characterized by having a tail, normal limbs, many cartilaginous skeletal elements, four-faceted articulation between the skull and vertebral column, incomplete maxillary arcade lacking a bony connection with neurocranium and palatoquadrate, and larvae with true teeth and external gills. Dates from the Middle Jurassic to present, with ten living and three extinct families, including more than 550 living species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caudata"@en .

aat:300310226 a skos:Concept ;
    skos:definition "Subclass of reptiles having no temporal skull openings, no teeth in living members (although certain extinct species had teeth), being egg-laying, and having a body encased in bony shell. Dating from the Pennsylvanian to present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anapsida"@en .

aat:300310227 a skos:Concept ;
    skos:definition "Large subclass of reptiles characterized by overlapping scales, no bipedal specializations, two complete temporal openings, a complete palate, being egg-laying, and a male lacking a penis. They include tuataras, lizards, snakes, and amphisbaenians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lepidosauria"@en .

aat:300310228 a skos:Concept ;
    skos:definition "Members of a taxon of reptiles characterized by a pair of openings in the skull behind each eye (diapsid), having longer hind legs than front legs, some ancient forms had bipedal locomotion, some are semiaquatic with webbed feet, teeth in sockets, a single penis, and being egg-laying. Includes the extinct dinosaur group containing pterosaurs, plesiosaurs, ichthyosaurs, thecodonts, and modern birds and crocodilians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archosauria"@en .

aat:300310229 a skos:Concept ;
    skos:definition "Extinct subclass of reptiles characterized by single temporal opening on area of cheek."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Synaptosauria"@en .

aat:300310230 a skos:Concept ;
    skos:definition "Extinct subclass of fishlike marine reptiles characterized by a spindle-shaped body, high tail fin, triangular dorsal fin, and paddlelike legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ichthyopterygia"@en .

aat:300310231 a skos:Concept ;
    skos:definition "Extinct subclass of mammal-like reptile characterized by a lateral temporal opening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Synapsida"@en .

aat:300310233 a skos:Concept ;
    skos:definition "Extinct subclass of birds having teeth in both jaws, a long, feathered tail, by being less specialized for flight than modern birds, a body elongated and reptilelike, forelimbs with three clawed digits, a small brain and eyes, and bones that are not filled with air (nonpneumatic)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaeornithes"@en .

aat:300310234 a skos:Concept ;
    skos:definition "Subclass of birds having a well-developed sternum, a relatively short tail, forelimbs modified to wings, and teeth replaced by horny rhamphoteca over bill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neornithes"@en .

aat:300310235 a skos:Concept ;
    skos:definition "Subclass of primitive mammal including monotremes and their extinct relatives, characterized by being egg-laying, having hair, mammary glands without nipples, a pectoral girdle, and separate oviducts that open into a cloacal chamber that is shared with excretory ducts. Most of the animals in this group are extinct, known from fossils of the Cretaceous and Cenozoic periods. They are represented today by the monotremes, platypus and several species of echidna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prototheria"@en .

aat:300310237 a skos:Concept ;
    skos:definition "Phylum of approximately 50 species of small, ciliated, multicellular animals that are parasitic in marine invertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesozoa"@en .

aat:300310238 a skos:Concept ;
    skos:definition "Phylum of numerous marine invertebrates characterized by a series of vertical ciliary combs over the surface of the animal. Most species float through the water, although a few creep or are parasitic. Refers to solitary, hermaphroditic, marine invertebrates of the phylum Ctenophora, found worldwide, having an ovoid, gelatinous, bilaterally symmetical body with regular, comblike rows of beating cilia for propulsion, and two trailing tentacles with adbesive cells to trap planktoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ctenophora"@en .

aat:300310239 a skos:Concept ;
    skos:definition "Phylum of approximately 900 known species representing the simplest animals to possess a circulatory system and a gut with a separate mouth and anus. The body is usually long and slender and is often extended greatly during movement. Most are marine free-living forms, but there are also a few parasites and some that live in freshwater or on land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nemertea"@en .

aat:300310240 a skos:Concept ;
    skos:definition "Phylum of about 600 recorded species, all of which are parasites in vertebrates (usually fish) as adults and in arthropods as juveniles. They are named for their proboscis, or snout, which bears hooks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acanthocephala"@en .

aat:300310241 a skos:Concept ;
    skos:definition "Phylum of wormlike invertebrates, mostly of microscopic size, characterized by a body cavity, the pseudocoel, that arises in the embryo in a way different from that found in more advanced animals and that has no epithelial lining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aschelminthes"@en .

aat:300310242 a skos:Concept ;
    skos:definition "Phylum of 15 species of predatory, marine, mud-inhabiting, unsegmented worms. They are sometimes classified as a class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Priapulida"@en .

aat:300310243 a skos:Concept ;
    skos:definition "Phylum of about 350 species of free-living, cosmopolitan invertebrates that in evolutionary development are considered to lie between annelid worms and arthropods such as insects, crustaceans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tardigrada"@en .

aat:300310244 a skos:Concept ;
    skos:definition "Phylum of about 70 wormlike species of ancient, terrestrial invertebrates with short, thick legs and a dry, velveteen-like body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Onychophora"@en .

aat:300310245 a skos:Concept ;
    skos:definition "Phylum including several tube-dwelling, worm-like marine invertebrates characterized by a horseshoe-shaped lophophore, which is a characteristic feeding organ. Wormlike marine invertebrates of the phylum Phoronidea, having a true body cavity divided into compartments, a cluster of tentacles at the upper end, a circulatory system, circular and longitudinal muscles, and a nervous sytem beneath the epidermis; ranging up to 15 feet in length, each individual lives in a chitinous tube which it secretes, the lower end of which is buried in the mud or sand at the bottom of shallow seas while the tentacles extend out of the t to gather food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phoronida"@en .

aat:300310246 a skos:Concept ;
    skos:definition "Phylum containing elongated, often spindle-shaped, unsegmented marine worms with a head that usually possesses one or more rings of tentacles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sipuncula"@en .

aat:300310247 a skos:Concept ;
    skos:definition "Phylum containing about 50 species in seven extant genera and one fossil genus. They are wormlike marine animals with transparent to translucent or opaque arrow-shaped bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chaetognatha"@en .

aat:300310248 a skos:Concept ;
    skos:definition "Formerly considered a separate phylum; now generally classified as an order of annelids. Contains primarily marine invertebrate sausage-shaped organisms, that have lost their segmentation, found in sand and mud of tropical and subtropical seas. A flattened extension of the head is curved along its lateral edges and sometimes shaped like a scoop or spoon to form a nonretractable anterior proboscis. Some respiration probably takes place across the body wall, but the hind gut is often utilized as a respiratory organ by drawing water through the anus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Echiurida"@en .

aat:300310249 a skos:Concept ;
    skos:definition "Phylum of marine invertebrates that live a sedentary life in long, protective tubes on seafloors throughout the world and often possessing a beard-like mass of feather-like tentacles at the anterior end. An intestine, which forms in embryos, disappears as development progresses; they are the only multicellular animals that have neither mouth nor anus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pogonophora"@en .

aat:300310250 a skos:Concept ;
    skos:definition "Order generally viewed as a divergent, early offshoot of the anthozoan line of comb jellies and sea walnuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceriantharia"@en .

aat:300310251 a skos:Concept ;
    skos:definition "One of two families of the Order Ceriantharia, tube-dwelling anemones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cerianthidae"@en .

aat:300310252 a skos:Concept ;
    skos:definition "Class of solitary, free-swimming tunicates found throughout the world's oceans, characterized by being filter feeders, and having a form superficially resembling tadpole larvae, retaining the juvenile discrete trunk and tail in adult life (pedomorphism)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Appendicularia"@en .

aat:300310253 a skos:Concept ;
    skos:definition "Small class of marine tunicates that are free-floating for their entire lifespan; they have an atrial aperture directed toward the rear of each zooid, and asexual buds that form from a ventral stolon. Sometimes classified as an order instead of a class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thaliacea"@en .

aat:300310254 a skos:Concept ;
    skos:definition "Family of marine animals distinguished from relatives by a double row of gonads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Branchiostomatidae"@en .

aat:300310255 a skos:Concept ;
    skos:definition "Family of marine animals distinguished from relatives by having gonads on the right side of the body only."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Epigonichthyidae"@en .

aat:300310256 a skos:Concept ;
    skos:definition "Extinct group that resembled amphibians but are often not included within the Amphibia class in the most recent classifications. This group contained a great variety of semiaquatic forms such as the snakelike Ophiderpeton, the \"horned\" Keraterpeton, and the microsaurs, such as Asaphestera. The lepospondylians became extinct during the Pennsylvanian subperiod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lepospondyli"@en .

aat:300310257 a skos:Concept ;
    skos:definition "Extinct order of presumably aquatic amphibians dating to the Late Mississippian, characterized by an elongate solidly roofed skull with the orbits located very far forward and well developed limbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adelospondyli"@en .

aat:300310258 a skos:Concept ;
    skos:definition "Extinct order of order of highly specialized snake-like amphibians with a small skull with large orbits, large fenestrae, reduced or absent bones at the back of the skull, and an extremely elongate body. Dating to the Carboniferous and Early Permian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aistopoda"@en .

aat:300310259 a skos:Concept ;
    skos:definition "Extinct order of order of amphibians characterized by vertebrae in which large fan-shaped hemal arches grow directly downward from the middle of each caudal centrum. Dates to the Lower Pennsylvanian to Middle Permian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nectridea"@en .

aat:300310260 a skos:Concept ;
    skos:definition "Extinct order of order of amphibians characterized by a spool-shaped bony cylinder around the notochord. Dates to the Lower Pennsylvanian to Middle Permian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Microsauria"@en .

aat:300310261 a skos:Concept ;
    skos:definition "Extinct order of aquatic reptiles with slender elongate jaws filled with long pointed teeth, a tail as long as or longer than the body and flattened side to side, well developed limbs, and enlarged paddlelike hind feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesosauria"@en .

aat:300310262 a skos:Concept ;
    skos:definition "Extinct order of two or three families, ten or more genera of small to moderately large terrestrial reptiles, ranging in appearance from lizard-like to sprawl-limbed and cow-like. They had dermal sculpturing of large tuberosities and deep pits on skull, well developed limbs, often possessing a robust limb and trunk skeleton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pareisauria"@en .

aat:300310263 a skos:Concept ;
    skos:definition "Extinct order of herbivorous reptiles represented in three or four families of about 30 genera. They were small terrestrial lizard-like reptiles, having a Pineal eye foramen near the frontoparietal suture on top of skull. They lived from the Upper Permian to Upper Triassic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Procolophonia"@en .

aat:300310264 a skos:Concept ;
    skos:definition "Members of the order of armored marine or terrestrial reptiles usually having a shell comprising a top (carapace) and a bottom (plastron) that arise from the ribs and often join one another along each side of the body, creating a rigid skeletal box, a skull without a pineal opening, and toothless jaws. Earliest examples are very ancient, dating from the Upper Triassic 215 million years ago. There are around 300 living species of turtles, terrapins, and tortoises. Some species live in and near water, although they cannot breathe or lay eggs in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Testudines"@en .

aat:300310265 a skos:Concept ;
    skos:definition "Order of aquatic or amphibious reptiles with a robust body and tail, short sturdy limbs, a strong flattened and elongate skull with nostrils at tip of snout, and a well-developed secondary palate. Dating from the Paleocene to present, including three living families, eight genera, and 23 species of crocodiles, gavials, caimans, and alligators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crocodilia"@en .

aat:300310266 a skos:Concept ;
    skos:definition "Order of reptiles characterized by a premaxillary downgrowth replacing premaxillary teeth and four to five teeth enlarged at beginning of palatine tooth row. Dating from the Lower Triassic to present, including three families, about 20 genera, but only one surviving genus (Sphenodon) and two living species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphenodontia"@en .

aat:300310267 a skos:Concept ;
    skos:definition "Extinct order of reptiles characterized by triradiate pelvis with the inferior pelvic elements directed downwards, a subnarial foramen, some reduction in digits, forelimbs that are usually distinctly shorter than hind limbs, and three to seven sacral vertebrae. Includes all theropod carnivorous dinosaurs and one of the two great lineages of herbivorous dinosaurs. Dating from the Upper Triassic to Upper Cretaceous, after which all non-avian saurischians became extinct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saurischia"@en .

aat:300310268 a skos:Concept ;
    skos:definition "Order of reptiles distinguished by the horny scales or shields on the skin, either egg-laying or with live births, having movable quadrate bones making it possible to move the upper jaw relative to the braincase, and a male hemipenis, which is unique among vertebrates. Dating from the Upper Jurassic to present, represented by approximately 7,900 living species of lizards, snakes, and amphisbaenid \"worm-lizards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Squamata"@en .

aat:300310269 a skos:Concept ;
    skos:definition "Extinct order of obligate bipedal or quadrupedal, beaked, herbivorous dinosaurs characterized by a pelvic structure like that of birds, a beak-like structure in the front part of the mouth and grinding teeth in the rear, a four-branched pelvis, toes that often have hooflike structures., and often having heavy armor and horns. Dating from the Upper Triassic to Upper Cretaceous, existed in five major groups: ornithopods, pachycephalosaurs, stegosaurs, ankylosaurs, and ceratopsina dinosaurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ornithischia"@en .

aat:300310270 a skos:Concept ;
    skos:definition "Extinct order of extinct flying reptiles of the Mesozoic order characterized by having a fourth digit of each forelimb prolonged to a great length to support a wing membrane for active flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pterosauria"@en .

aat:300310271 a skos:Concept ;
    skos:definition "Extinct order of fossil marine reptiles having a stout, sometimes armoured body and large flat palatal teeth, thought to have been used for crushing mollusc shells dating to the Triassic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Placodontia"@en .

aat:300310272 a skos:Concept ;
    skos:definition "Extinct order of fossil marine reptiles characterized by a broad, flattened body, often a small head often on long flexible neck, a short tail, and four large, paddle-like limbs, dating to the Jurassic and Cretaceous periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plesiosauria"@en .

aat:300310273 a skos:Concept ;
    skos:definition "Extinct order of fossil marine reptiles found chiefly in Europe and closely resembling the later plesiosaurs, but classified as a distinct order; dating to the Triassic age. Distinguished by a palate that was closed with the air passages being separated from the food passages, a long and flat skull with large openings, numerous pointed teeth along the margins of the jaws, a slender body, long neck and tail, and long limbs. Although the animal was aquatic, the limbs were less specialized for swimming than they were in more advanced sauropterygians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nothosauroidea"@en .

aat:300310274 a skos:Concept ;
    skos:definition "Extinct order of small lizard-like terrestrial reptiles dating to the Lower Permian to Upper Triassic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Araeoscelidia"@en .

aat:300310279 a skos:Concept ;
    skos:definition "Order containing around 425 species in 3 families of rapid-flying birds that feed in flight upon insects or nectar, having a 'hand' and primary flight feathers constituting a relatively great proportion of the wing, and relatively weak feet used primarily only for perching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apodiformes"@en .

aat:300310280 a skos:Concept ;
    skos:definition "Order containing around 5,700 species in 74 families comprising a complex assemblage containing more than half of all known bird species with bill, plumage, and habits that are highly varied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passeriformes"@en .

aat:300310281 a skos:Concept ;
    skos:definition "Order containing around approximately 400 species in six families including jacamars, puffbirds, barbets, honey guides, and toucans. Characterized as forest dwelling, hole-nesting birds that feed upon insects and fruit, having outer toes able to face rearward, some are specialized for climbing, and some that are brood parasites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Piciformes"@en .

aat:300310282 a skos:Concept ;
    skos:definition "Order containing around 370 species in 17 families including plovers, jacanas, stilts, avocets, thickknees, terns, and murres, having three basic body plans: waders (shorebirds) that usually feed on small animals in mud or water; web-footed dense-plumaged water birds that feed by plunging into water for fish, robbing other birds, or scavenging; and dense-plumaged, web-footed, marine, wing-propelled divers that feed on fish or invertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Charadriiformes"@en .

aat:300310283 a skos:Concept ;
    skos:definition "Order containing 16 species in one family of stocky, pigeon-like ground birds with short legs, fast flight, and feeding upon seeds and insects in the deserts of Africa and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pteroclidiformes"@en .

aat:300310284 a skos:Concept ;
    skos:definition "Order containing 368 species in two families, 10 species have been extinct since 1600. Characteraized as often brightly colored, strong-flying, seed-, fruit-, or nectar-eating birds with very stout, hooked bills and feet with the outer toe facing rearward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Psittaciformes"@en .

aat:300310285 a skos:Concept ;
    skos:definition "Order containing over 300 species in one family of fast-flying birds with pointed wings and weak bills, feeding on seeds and fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Columbiformes"@en .

aat:300310286 a skos:Concept ;
    skos:definition "Order containing 309 species in five families including hawks, falcons, eagles, the secretary bird, Old World vultures, and condors. They are characterized by typically have a sharply hooked beak with a cere (soft mass) housing the nostrils, long and fairly broad wings suitable for soaring flight, strong legs and feet with raptorial claws and an opposable hind claw, most are carnivorous, hunting by sight during the day or at twilight, and being exceptionally long-lived with low reproductive rates. They date from the Middle Eocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Falconiformes"@en .

aat:300310287 a skos:Concept ;
    skos:definition "Order containing around 290 species in five families including pheasants, megapodes, guinea fowl, curassows, and guans, characterized by being terrestrial or arboreal with strong scratching feet, short rounded wings, and feathers with long aftershafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galliformes"@en .

aat:300310288 a skos:Concept ;
    skos:definition "Order containing around 210 species in 11 families including rails, coots, and moorhens. They are morphologically diverse wading and terrestrial birds ranging from small quail-like hemipodes to large long-legged cranes, marsh-inhabiting rails, swimming coots and finfoots, and cursorial bustards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gruiformes"@en .

aat:300310289 a skos:Concept ;
    skos:definition "Order containing around 211 species in ten families including hornbills, bee-eaters, rollers, hoopoes, todies, and motmots. They are a heterogeneous group of hole-nesting birds, many with long pointed bills and blue or green in plumage, and all having two toes joined at base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coraciiformes"@en .

aat:300310290 a skos:Concept ;
    skos:definition "Order containing around 180 species in two families of nocturnal raptorial birds with hooked beaks, strong talons, and soft plumage. All owls have the same general appearance, which is characterized by a flat face, small hooked beak, short tail, round wings, and large, forward-facing eyes. The bird became associated with Athena, the Greek goddess of wisdom and also owls became symbolic of intelligence because it was thought that they could forsee events. Also, because of their nocturnal existence and hooting sounds, owls have also been symbols associated with the occult. In the Middle Ages, the owl became a symbol of the darkness before the coming of Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strigiformes"@en .

aat:300310291 a skos:Concept ;
    skos:definition "Order containing 18 species in one family of fruit-eating large birds with brilliant purple, green, and crimson plumage and a prominent crest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musophagiformes"@en .

aat:300310292 a skos:Concept ;
    skos:definition "Order containing 141 species in two families including anis, roadrunners, and the hoatzin, with one species extinct since 1600. They are long-tailed birds with rearward or sideward facing toes, feeding on both fruits and small animals, most are arboreal but a few are terrestrial, and some are brood parasites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cuculiformes"@en .

aat:300310293 a skos:Concept ;
    skos:definition "Order containing 150 species in two families including ducks, geese, and swans. Characteriezed as web-footed birds with broad bills containing fine plates or lamellae (except for screamers) and large-footed marsh birds with chickenlike bills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anseriformes"@en .

aat:300310294 a skos:Concept ;
    skos:definition "Order containing 120 species in six families including shoebills, New World vultures, ibises, and bitterns. They are long-legged wading birds with long bills and feet that are not webbed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ciconiiformes"@en .

aat:300310295 a skos:Concept ;
    skos:definition "Order containing 121 species in five families including frogmouths, potoos, and the oilbird. They are nocturnal and concealingly colored, with weak feet, soft plumage, very large mouths, and most feeding on insects caught in flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caprimulgiformes"@en .

aat:300310296 a skos:Concept ;
    skos:definition "Order containing 66 species in six families worldwide, including cormorants, boobies, gannets, tropic birds, and frigate birds. They are water birds with all four toes webbed and a bill that is hooked or straight and sharply pointed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pelecaniformes"@en .

aat:300310297 a skos:Concept ;
    skos:definition "Order containing 47 species in one family of ground-dwelling birds resembling quails or pheasants with flat, elongated, and rather weak bills and very small tails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tinamiformes"@en .

aat:300310298 a skos:Concept ;
    skos:definition "Order containing 37 species in one family, characterized with extremely soft-plumaged arboreal birds that feed on insects and small fruit, and having weak feet with the first and second toes directed backward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trogoniformes"@en .

aat:300310299 a skos:Concept ;
    skos:definition "Order containing 22 species in one family, two species having recently gone extinct. Characterized as foot-propelled diving birds with lobed toes, minute tails, and silky plumage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Podicipediformes"@en .

aat:300310300 a skos:Concept ;
    skos:definition "Order containing 17 species in one family found in oceans of the Southern Hemisphere having flipperlike wings for propulsion underwater; short stout webbed feet, upright stance upright, and short dense feathers that are molted in patches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sphenisciformes"@en .

aat:300310301 a skos:Concept ;
    skos:definition "Order containing five species in one family in the northern hemisphere. Characterized as foot-propelled diving birds with webbed feet and pointed bills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gaviiformes"@en .

aat:300310302 a skos:Concept ;
    skos:definition "Order containing a single extant family, Struthionidae, containing the ostriches. Formerly believed to contain up to ten species in six families, DNA comparison has altered the classification in the 2000s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Struthioniformes"@en .

aat:300310303 a skos:Concept ;
    skos:definition "Refers to an egg-laying mammalian order four species classified in two suborders, extant members are the duck-billed platypus and the two species of echidna. Probably split from the lineage leading to other mammals in the Mesozoic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monotremata"@en .

aat:300310304 a skos:Concept ;
    skos:definition "With the echidna, Platypoda are the only egg-laying mammals. Family contains one extant genus with one species, and one or more ancient genuses. Semiaquatic, burrowing mammals inhabiting lakes and streams in Tasmania and eastern Australia, having brown fur, a sensitive, pliable bill shaped like that of a duck, webbed feet with venomous spurs in the male, a flattened tail, and laying leathery eggs with young sucking milk from the pores of milk patches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platypoda"@en .

aat:300310305 a skos:Concept ;
    skos:definition "With the platypus, Tachyglossa are the only egg-laying mammals. The female lays a single soft-shelled, leathery egg, deposits it directly into her pouch, where there are no nipples, but after hatching the young echidna sucks milk from the pores of the two milk patches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tachyglossa"@en .

aat:300310306 a skos:Concept ;
    skos:definition "Grouping containing the former taxon Marsupialia as well as the nearest fossil relatives of marsupial mammals. Common characteristics include the bearing of very immature young which are typically nursed in an abdominal pouch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Metatheria"@en .

aat:300310307 a skos:Concept ;
    skos:definition "Order containing 115 or more species in 10 families and a number of extinct species. Distinguished by a pair of large procumbent incisors on the lower jaw (diprotodont) paired with typically three pair of upper incisors and no lower canines, and the fusing of the second and third digits of the foot up to the base of the claws which leaves the claws themselves separate (syndactyly) and with the fifth digit usually absent and a greatly enlarged fourth digit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diprotodontia"@en .

aat:300310308 a skos:Concept ;
    skos:definition "Order containing around 60 species of carnivorous marsupials in two families, plus the third recently extinct family of the Tasmanian wolf. Living memebers include the quolls, dunnarts, tnumbats, Tasmanian devils, and the recently extinct Thylacine (Tasmanian wolf)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dasyuromorphia"@en .

aat:300310309 a skos:Concept ;
    skos:definition "Order containing 22 species in two families. Includes bandicoots and bilbies, all having a plump, arch-backed body with a long tapering snout, very large upright ears, relatively long, thin legs, a thin tail, fused second and third toes, and several pairs of lower front teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peramelemorphia"@en .

aat:300310310 a skos:Concept ;
    skos:definition "Order containing two species in one family resembling true moles, having forefeet with triangular claws used for digging, leathery skin surrounding the blunt snout and stubby tail, poorly developed eyes that are virtually hidden in the long silky fur, and the habit of burrowing just beneath the soil surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Notoryctemorphia"@en .

aat:300310311 a skos:Concept ;
    skos:definition "Ancient order of marsupial mammals containing one living species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Microbiotheria"@en .

aat:300310312 a skos:Concept ;
    skos:definition "Order of North and South American marsupial mammals, containing 70 or more species in only one family. Usually semi-arboreal omnivores, having a very full jaw of teeth, moving with feet flat on the ground (plantigrade) and hind feet with an opposable digit with no claw, and a prehensile tails. The name \"opossum\" is based on a term in the Powhatan language meaning \"white dog-like creature.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Didelphimorphia"@en .

aat:300310313 a skos:Concept ;
    skos:definition "Order of marsupial mammals containing six living species in one family. They have thin limbs, a long pointed snout, a thin hairy tail, and are largely carnivorous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paucituberculata"@en .

aat:300310314 a skos:Concept ;
    skos:definition "Grouping consisting of about 4,700 living species in 20 orders, characterized by the fetus being nourished during gestation by a placenta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Placentalia"@en .

aat:300310315 a skos:Concept ;
    skos:definition "Order containing more than 2,050 species in 27 families characterized by having no canine teeth and strong incisors, the upper and lower pairs of which are ever-growing and rootless, including rats, mice, porcupines, beavers, squirrels, marmots, pocket gophers, and chinchillas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rodentia"@en .

aat:300310316 a skos:Concept ;
    skos:definition "Order containing more than 1,000 species in 18 families of mouse-like quadrupeds capable of flight with the ability to navigate at night by using a system of acoustic orientation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiroptera"@en .

aat:300310317 a skos:Concept ;
    skos:definition "Order containing around 370 species in three families of shrews, moles, and kin. Moles (family Talpidae) are sometimes classified with hedgehogs in Erinaceomorpha. It is now often classified as a biological clade within the class of mammals, because members apparently are paraphyletic (i.e., a taxonomic group which does not include all the descendants of an ancestral taxon)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soricomorpha"@en .

aat:300310318 a skos:Concept ;
    skos:definition "Order containing around 47 species in two families including the golden moles of southern Africa and the tenrecs of Madagascar and Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afrosoricida"@en .

aat:300310319 a skos:Concept ;
    skos:definition "Order containing around 21 species in one family possessing several thousand short, smooth spines that densely cover a short, stocky body except for the underside, legs, face, and ears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Erinaceomorpha"@en .

aat:300310320 a skos:Concept ;
    skos:definition "Order containing around 300 or more species in 16 families including humans, apes, monkeys, lemurs, and kin, characterized in general by relatively rounded skulls, flattened faces, short jaws and noses, forward-facing eyes, and an opposable digit on hands and feet (except in humans), and most of which are are are descended from agile tree-dwellers, illustrated in features of the skull, teeth, and limbs. Several species, including Homo sapiens, no longer live in trees but nonetheless retain many of these features. The brains of primates have a unique fissure, called the Calcarine sulcus, which separates the first and second visual areas on each side of the brain. Only primates have flat nails, rather than the claws and hooves of other mammals, and opposable digits. Most modern primate species live in the tropics or subtropics, although a few also inhabit temperate regions. The earliest primates date to the Early Eocene Epoch (54.8 million to 49 million years ago) or perhaps to the Late Paleocene Epoch (57.9 million to 54.8 million years ago)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Primates"@en .

aat:300310321 a skos:Concept ;
    skos:definition "Order containing around 202 species in 10 families, including giraffes, camels, deer, cattle, pigs, sheep, goats, and kin, characterized by feet with weight borne equally by the third and fourth toes rather than mostly or entirely by the third, and by the shape of the astragalus (a bone in the hock joint) that has a double-pulley structure in artiodactyls, giving the foot greater flexibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Artiodactyla"@en .

aat:300310322 a skos:Concept ;
    skos:definition "Order containing around 80 species in extant 10 families, the living members characterized by being nearly fully adapted to aquatic life with a fusiform (streamlined) body, forelimbs modified into flippers, tiny vestigial hindlimbs that do not attach to the backbone and are hidden within the body, a tail with horizontal flukes, being nearly hairless, insulation provided by a thick layer of blubber, and typically a high level of intelligence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cetacea"@en .

aat:300310323 a skos:Concept ;
    skos:definition "Order containing around 15 species of mammals in three families, including horses, asses, zebras, rhinoceroses, tapirs, and kin, characterized as browsing and grazing animals, with an odd number of toes on each hoof, usually large in size, having relatively simple stomachs and being hindgut fermenters, digesting plant cellulose in their intestines rather than a stomach."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Perissodactyla"@en .

aat:300310324 a skos:Concept ;
    skos:definition "Members of the order containing six species in one family. Living members are primitive hoofed herbivorous mammals of the family Procaviidae, the only surviving members of the order Hyracoidea, being small thickset, herbivorous quadrupeds, about the size of a large domestic rabbit, similar to guinea pigs in appearance, with tusk-like incisor teeth, and native Africa and the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hyracoidea"@en .

aat:300310325 a skos:Concept ;
    skos:definition "Order containing four living mammal species in two families, characterized by being fully aquatic, herbivorous, inhabiting rivers, estuaries, coastal marine waters, swamps, and marine wetlands. The order evolved during the Eocene epoch, more than 50 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sirenia"@en .

aat:300310326 a skos:Concept ;
    skos:definition "Order containing four living species in one family. Characterized as huge quadrupeds having long curving ivory tusks, a prehensile trunk or proboscis, columnar legs, a huge head with temporal glands, and wide flat ears. There were at least 170 fossil species, such as mammoths and mastodons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proboscidea"@en .

aat:300310327 a skos:Concept ;
    skos:definition "Order containing one living species of medium-sized, burrowing, nocturnal mammal native to Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tubulidentata"@en .

aat:300310328 a skos:Concept ;
    skos:definition "Order containing around 270 species in 12 families, being the most diverse of any mammalian order; the taxonomy of the major categories has been in a state of flux for more than a century. Carnivores have in common that they possess teeth and claws adapted for catching and eating other animals. Some eat primarily or exclusively meat, while others are omnivores. Members are typically hunter and scavenger meat-eating mammals such as dogs, cats, wolves, foxes, bears, and seals. Given that the order includes such great taxonomic diversity, the characteristics used to separate Carnivora from other mammalian orders and to define the subdivisions of Carnivora are primarily structural, notably certain features of the skull (such as jaw articulation), feet (number of toes, lack of opposability of the hind toe, type of claws, and fusion of certain bones), and teeth (both the overall tooth pattern and the shape of individual teeth). For exclusively meat-eating animals in a more general sense, use \"carnivores (general sense).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carnivora"@en .

aat:300310329 a skos:Concept ;
    skos:definition "Order containing around 87 species in two families, having a superficial resemblance to rodents in some ways. Characterized by long ears, a short tail, and strong hind limbs, or by shorter, rounded ears, no external tail, and less-well-developed hind limbs associated with scampering locomotion. Members of the order Lagomorpha, which includes rabbits, hares, and pikas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lagomorpha"@en .

aat:300310330 a skos:Concept ;
    skos:definition "Order containing around 20 surviving species in one family characterized by a bony armor shell, and usually sharp claws used to dig for grubs and to dig dens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cingulata"@en .

aat:300310331 a skos:Concept ;
    skos:definition "Order containing around nine living species in four families, members of which do not have front incisor teeth or molars, or have poorly-developed molars. The origins of the order can be traced back as far as the early Tertiary about 60 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pilosa"@en .

aat:300310332 a skos:Concept ;
    skos:definition "Order containing 17 species in one family, characterized as slender animals with long tails and soft gray or brown fur, with tterrestrial species larger than the arboreal forms with larger claws, which they use for digging up insect prey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scandentia"@en .

aat:300310333 a skos:Concept ;
    skos:definition "Order containing five species in one family, characterized by long noses, mouse-like tails, long limbs, large canine teeth, and high-crowned cheek teeth like those of ungulates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macroscelidea"@en .

aat:300310334 a skos:Concept ;
    skos:definition "Order containing seven living species in one family, characterized by unique large keratin scales covering their skin, and being nocturnal animals that use their well-developed sense of smell to find insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pholidota"@en .

aat:300310335 a skos:Concept ;
    skos:definition "Genus containing more than 80 species of bats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myotis"@en .

aat:300310336 a skos:Concept ;
    skos:definition "Large familycontaining over 400 species of bats, found worldwide in both tropical and temperate regions, their habitats ranging from tropical forest to desert. Characterized by having small eyes, well-developed tails, most having long wings, and some have very large ears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vespertilionidae"@en .

aat:300310337 a skos:Concept ;
    skos:definition "General term referring to any of several medium-sized species of cetaceous mammal, usually reserved for species having a shorter and wider snout than others (which are called dolphins)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porpoises"@en .

aat:300310341 a skos:Concept ;
    skos:definition "Family containing 35 species in 20 genera of civets and related species resembling long-nosed cats, having retractile or partially-retractile claws, a baculum (penile bone), and an anal scent gland. They are among the most primitive families Carnivora, with skeletons very similar to those of fossils dating back to the Eocene 50 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Viverridae"@en .

aat:300310342 a skos:Concept ;
    skos:definition "Family containing 18 species in six genera including includes the raccoons, coatis, kinkajous, olingos, ringtails, and cacomistles. Characterized by being tree-climbing, omnivorous, having poorly developed carnassial teeth, and being closely related to bears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Procyonidae"@en .

aat:300310343 a skos:Concept ;
    skos:definition "Family containing 11 species in four genera including skunks and stink badgers, having moderately elongated bodies with reasonably short well-muscled legs, long front claws for digging, a striped coat, and extremely well-developed anal scent glands used to produce noxious odors to deter threats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mephitidae"@en .

aat:300310344 a skos:Concept ;
    skos:definition "Family containing four living species in four genera, characterized by long forelegs, a powerful neck and shoulders, a bear-like gait due tofront legs being longer than their back legs, intelligence, excellent sight, hearing, and smell, powerful carnassial teeth adapted for cutting flesh, and premolars for crushing bone. They originated 26 million years ago from arboreal ancestors in the cat group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hyaenidae"@en .

aat:300310345 a skos:Concept ;
    skos:definition "Family containing 19 species in ten genera, of carnivores that are highly specialized for aquatic life. Characteristics include returning to dry land or pack ice to breed and give birth, lacking external ears, having sleek streamlined bodies, nipples that can be retracted, internal testicles, a penis in an internal sheath, a layer of blubber under the skin, the ability to divert blood to the blubber level to help control their temperature, fore-flippers that are used primarily for steering, and hind flippers bound to the pelvis in such a way that they cannot be moved under the body for walking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phocidae"@en .

aat:300310346 a skos:Concept ;
    skos:definition "Family containing 14 species in seven genera comprising sea lions and fur seals. They are adapted to a semi-aquatic lifestyle, feeding and migrating in the water but breeding and resting on land or ice, having small but visible external ear flaps, larger foreflippers and pectoral muscles than true seals, and the ability to turn their hind limbs forward and walk on all fours. With true seals and walruses, arose in the late Miocene (10-12 million years ago), descended from a common ancestor most closely related to modern bears."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otariidae"@en .

aat:300310347 a skos:Concept ;
    skos:definition "Family containing one species, characterized by being semi-aquatic, having prominent tusks, whiskers, great bulk, being relatively long-lived, and social."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odobenidae"@en .

aat:300310348 a skos:Concept ;
    skos:definition "Species of North American wolf somewhat smaller than the gray wolf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canis rufus"@en .

aat:300310349 a skos:Concept ;
    skos:definition "Species of wolf found in the highlands of Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canis simensis"@en .

aat:300310351 a skos:Concept ;
    skos:definition "Female canids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitches"@en .

aat:300310352 a skos:Concept ;
    skos:definition "Genus of five species of South American foxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pseudalopex"@en .

aat:300310353 a skos:Concept ;
    skos:definition "Genus of two species of North and South America, one of which lives only on the Channel Islands off the California coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urocyon"@en .

aat:300310354 a skos:Concept ;
    skos:definition "Genus of one 1 species of fox of the northern polar region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alopex"@en .

aat:300310355 a skos:Concept ;
    skos:definition "Genus of one 1 species of canid of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Atelocynus"@en .

aat:300310356 a skos:Concept ;
    skos:definition "Genus of one 1 species of fox of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cerdocyon"@en .

aat:300310357 a skos:Concept ;
    skos:definition "Genus of one 1 species of wolf-like canid of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chrysocyon"@en .

aat:300310358 a skos:Concept ;
    skos:definition "Genus of one 1 species of dog-like canid of Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lycaon"@en .

aat:300310359 a skos:Concept ;
    skos:definition "Genus of one species of dog-like canid of Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyctereutes"@en .

aat:300310360 a skos:Concept ;
    skos:definition "Genus of one 1 species of fox of Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otocyon"@en .

aat:300310361 a skos:Concept ;
    skos:definition "Genus of one 1 species of dog-like canid of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Speothos"@en .

aat:300310362 a skos:Concept ;
    skos:definition "Genus of four species, including the bobcat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lynx"@en .

aat:300310363 a skos:Concept ;
    skos:definition "Genus of four species in Asia, including the leopard cat, flat-headed cat, and fishing cat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prionailurus"@en .

aat:300310364 a skos:Concept ;
    skos:definition "Genus of three primarily Central and South American species, including the little spotted cat, margay, and ocelot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leopardus"@en .

aat:300310365 a skos:Concept ;
    skos:definition "Genus of three South American species, Geoffroy's cat, kodkod, and pampas cat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oncifelis"@en .

aat:300310366 a skos:Concept ;
    skos:definition "Genus of two Asian species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Catopuma"@en .

aat:300310367 a skos:Concept ;
    skos:definition "Genus of one African and Southwest Asian species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caracal"@en .

aat:300310369 a skos:Concept ;
    skos:definition "Genus of one African species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leptailurus"@en .

aat:300310370 a skos:Concept ;
    skos:definition "Genus of one South American species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oreailurus"@en .

aat:300310371 a skos:Concept ;
    skos:definition "Genus of one Asian species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otocolobus"@en .

aat:300310372 a skos:Concept ;
    skos:definition "Genus of one African species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Profelis"@en .

aat:300310373 a skos:Concept ;
    skos:definition "Species of large golden-brownish, solitary, adaptable, generalist cat that has the greatest range of any wild terrestrial mammal in the Western Hemisphere, found from Yukon in Canada to the southern Andes of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Puma concolor"@en .

aat:300310374 a skos:Concept ;
    skos:definition "Genus of four Asian, African, and South and Central American species, including the jaguar, lion, leopard, and tiger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera"@en .

aat:300310375 a skos:Concept ;
    skos:definition "Genus of two Southeast Asian species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neofelis"@en .

aat:300310376 a skos:Concept ;
    skos:definition "Genus of one Southeast Asian species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pardofelis"@en .

aat:300310377 a skos:Concept ;
    skos:definition "Genus of one Asian species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uncia"@en .

aat:300310378 a skos:Concept ;
    skos:definition "Genus of one almost exclusively African species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acinonyx"@en .

aat:300310379 a skos:Concept ;
    skos:definition "A distinct population or subspecies of Felis silvestris found in the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis sylvestris lybica"@en .

aat:300310380 a skos:Concept ;
    skos:definition "A distinct population or subspecies of Felis silvestris found in Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis sylvestris silvestris"@en .

aat:300310381 a skos:Concept ;
    skos:definition "A distinct population or subspecies of Felis silvestris found in Central Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis sylvestris ornata"@en .

aat:300310382 a skos:Concept ;
    skos:definition "A distinct population or subspecies of Felis silvestris found in sub-Saharan Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis sylvestris cafra"@en .

aat:300310383 a skos:Concept ;
    skos:definition "A distinct population or subspecies of Felis silvestris found in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Felis sylvestris bieti"@en .

aat:300310386 a skos:Concept ;
    skos:definition "General term referring to either of two cosmopolitan genera of invertebrate marine animals in the Pleurobrachiidae family, the Hormiphora and the Pleurobrachia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea gooseberries"@en .

aat:300310387 a skos:Concept ;
    skos:definition "Genus of gelatinous, planktonic marine invertebrates, now generally considered to contain one living species that manifests in three different ecological forms.The sea walnut resembles the sea gooseberry morphologically, but as in many ctenophores the body is prolonged into eight lobes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mnemiopsis"@en .

aat:300310388 a skos:Concept ;
    skos:definition "Large, powerful species of cat that is well-muscled, with a large head, short legs, size and appearance that varies considerably between the sexes, and is unique among the cats in living in family groups or prides. In the Pleistocene, lions were the most widespread large land mammals, ranging throughout Eurasia, Africa, and North America. Today listed as Vulnerable, remaining only in fragmented populations remain in Sub-Saharan Africa and western India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera leo"@en .

aat:300310389 a skos:Concept ;
    skos:definition "Largest New World cat, once found from the U.S.-Mexican border southward to Patagonia, Argentina, but with habitat now greatly reduced. Coloration is orange to tan, with black spots arranged in rosettes with a black spot in the center. The base color of the jaguar varies greatly from white to black; although brown and black jaguars appear to be solid-colored, spots are always faintly visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera onca"@en .

aat:300310390 a skos:Concept ;
    skos:definition "Species of large cat having a wide range in Africa and Asia; its coat has a ground color that is typically yellowish above and white below, dark spots generally arranged in rosettes over much of the body, without the central spot characteristic of the coat of the jaguar. The ground color within the rosettes is sometimes a darker yellow, and the size and spacing of the spots vary greatly, distinguishing the several races of leopard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panthera pardus"@en .

aat:300310392 a skos:Concept ;
    skos:definition "Former suborder classification that included New World monkeys, Old World monkeys, apes, and humans. In modern classification, the tarsiers and simians are grouped under the suborder Haplorhini, while the strepsirrhines are placed in suborder Strepsirrhini."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anthropoidea"@en .

aat:300310394 a skos:Concept ;
    skos:definition "Refers to all species regarded as human, directly ancestral to humans, or very closely related to humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hominini"@en .

aat:300310395 a skos:Concept ;
    skos:definition "Infraorder containing the family of aye-ayes, small arboreal primates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiromyiformes"@en .

aat:300310396 a skos:Concept ;
    skos:definition "Rare squirrel-like, nocturnal, solitary, and arboreal primate of Madagascar; the sole living representative of the family Daubentoniidae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daubentonia madagascariensis"@en .

aat:300310397 a skos:Concept ;
    skos:definition "Recently extinct relative of the aye-aye known from subfossils (partially fossilized remains). Was two times larger and otherwise very similar morphologically to the living aye-aye species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daubentonia robusta"@en .

aat:300310398 a skos:Concept ;
    skos:definition "Infraorder containing various species of lemurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lemuriformes"@en .

aat:300310399 a skos:Concept ;
    skos:definition "Extinct family containing four genera and five species from Madagascar, all extinct within the past 2,000 years. Developed in the Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palaeopropithecidae"@en .

aat:300310400 a skos:Concept ;
    skos:definition "Extinct family containing two recently extinct genera and three species from Madagascar, all extinct within the past 2,000 years. Developed in the Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archaeolemuridae"@en .

aat:300310401 a skos:Concept ;
    skos:definition "Infraorder containing various species of lorises and their close relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lorisiformes"@en .

aat:300310402 a skos:Concept ;
    skos:definition "Infraorder containing one living family of tarsiers and the Eocene to Early Miocene families Anaptomorphidae and Omomyidae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarsiiformes"@en .

aat:300310403 a skos:Concept ;
    skos:definition "Genus containing six or more living species of small leaping primates found only on various islands of Southeast Asia, including the Philippines. Tarsiers are intermediate in form between lemurs and monkeys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarsius"@en .

aat:300310404 a skos:Concept ;
    skos:definition "Group of primates containing 8 living and 6 fossil families; included are Old World monkeys and apes, including humans; dating to the Early Miocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Simiiformes"@en .

aat:300310405 a skos:Concept ;
    skos:definition "Family containing one genus and nine species of South and Central American monkeys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aotidae"@en .

aat:300310406 a skos:Concept ;
    skos:definition "Family containing four genera with 29 or more living South American species, plus three fossil species in two genera dating from the Middle Miocene to Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pitheciidae"@en .

aat:300310407 a skos:Concept ;
    skos:definition "Family containing four genera with around 19 species from South America north to Mexico, plus three fossil species in two genera dating from the Early Miocene to Holocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Atelidae"@en .

aat:300310408 a skos:Concept ;
    skos:definition "Classification comprising one family with 21 genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cercopithecoidea"@en .

aat:300310409 a skos:Concept ;
    skos:definition "Species of large, intelligent, social hominid. The western gorilla differs from the eastern gorilla in being lighter in color, having an overhanging tip on its nose, a more slender body, being more arboreal, having a diet more based on fleshy fruits, and typically a smaller family group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gorilla gorilla"@en .

aat:300310410 a skos:Concept ;
    skos:definition "Species of intelligent, social hominid, the largest living primate, having a large head, broad chest, long arms, a flat nose with large nostrils, and fur that is black with a silver saddle on the back of adult males. The eastern gorilla differs from the western gorilla in being larger, darker, lacking an overhanging tip on its nose, having a more robust body, being less arboreal, and typically living in a larger family group of up to 40 individuals. In some classifications, both the Eastern Gorilla and the Western Gorilla are classified as a single species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gorilla beringei"@en .

aat:300310411 a skos:Concept ;
    skos:definition "Members of a species of hominid found only in lowland rainforests of the Congo river. They differ from the other extant species of the genus Pan, Pan troglodytes, in being more slender, with longer limbs, a narrower chest, a rounder head with a less-protruding face, descending from trees only to move between trees, and having different behaviors and dynamics in social groups. In older classifications, the bonobo and the common chimpanzee were classified as one species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pan paniscus"@en .

aat:300310412 a skos:Concept ;
    skos:definition "Members of a species of hominid found in tropical forests and wet savannas of western and central Africa, although their habitat was formerly much larger. They are characterized by a body that is mostly covered by dark brown hair, having thumbs and its big toes that are opposable, and differing from the other extant species of the genus Pan, bonobos, in being more robust, having a more protruding face, spending more time out of the trees, and having different behaviors and dynamics in social groups. In older classifications, the bonobo and the common chimpanzee were classified as one species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pan troglodytes"@en .

aat:300310413 a skos:Concept ;
    skos:definition "Species of orangutan living on Sumatra island, they differ from the Bornean orangutan in being smaller and shorter, having lighter and longer hair, a longer face, and flanges that are covered in small white hairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pongo abelii"@en .

aat:300310414 a skos:Concept ;
    skos:definition "Species of orangutan living on Borneo island; they differ from the Sumatran orangutan in being larger, taller, having darker but shorter hair, a shorter face, and a more solitary lifestyle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pongo pygmaeus"@en .

aat:300310415 a skos:Concept ;
    skos:definition "Species of extinct early homonin who was at least partially bipedal and whose remains were found in the Ethiopia and Kenya; fossils date 4.2-3.9 mya million years ago. Characterized by slender build, strongly protruding face, and thickening of tooth enamel that becomes characteristic of all later hominins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australopithecus anamensis"@en .

aat:300310416 a skos:Concept ;
    skos:definition "Genus containing several species of extinct early homonins that were closely related to, if not actually ancestors of, modern human beings, known from a series of fossils found at numerous sites in eastern, central, and southern Africa. The various species of Australopithecus lived during the Pliocene Epoch, which lasted from 5.3 to 1.8 million years ago. As characterized by the fossil evidence, they bore a combination of human- and apelike traits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australopithecus"@en .

aat:300310418 a skos:Concept ;
    skos:definition "Genus containing one species of large mammal with short, stumpy legs, and barrel-shaped bodies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippopotamus"@en .

aat:300310419 a skos:Concept ;
    skos:definition "Family containing two living genera of large mammals, with short, stumpy legs, and barrel-shaped bodies and several extinct genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippopotamidae"@en .

aat:300310420 a skos:Concept ;
    skos:definition "Genus containing two species of mammal with short, stumpy legs, and barrel-shaped bodies, smaller than the Hippopatums genus. It is believed that one species, the Malagasy pygmy hippopotamus, is extinct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexaprotodon"@en .

aat:300310421 a skos:Concept ;
    skos:definition "Species of thick-skinned, herbivorous, even-toed hoofed mammals, significantly smaller than the common hippopotamus, native to the forests and swamps of western Africa; thought to be the only surviving species of their genus, as the Malagasy pigmy hippopotamus is presumed extinct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexaprotodon liberiensis"@en .

aat:300310422 a skos:Concept ;
    skos:definition "Species of small hippopotamus native to Madacascar, believed to be extinct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexaprotodon madagascariensis"@en .

aat:300310423 a skos:Concept ;
    skos:definition "Genus containing one living species of flying lemur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cynocephalus"@en .

aat:300310424 a skos:Concept ;
    skos:definition "Order that contains a single family with two genera and two living species of flying lemur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dermoptera"@en .

aat:300310425 a skos:Concept ;
    skos:definition "Genus containing one living species of flying lemur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galeopterus"@en .

aat:300310426 a skos:Concept ;
    skos:definition "Genus containing 3 to 7 species (depending upon the classification) of nocturnal mammals characterized by bushy ringed tails; native to North, Central, and South America. They are omnivores, arboreal, intelligent, having a striped tail and dark mask around the eyes, and having thumbs that are not opposable, but positioned to allow the animal to grasp and manipulate small items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Procyon"@en .

aat:300310427 a skos:Concept ;
    skos:definition "Family containing four and eight genera and up to sixteen species of pigs and their relatives, including wild boars, the domestic pig, and several fossil pigs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suidae"@en .

aat:300310428 a skos:Concept ;
    skos:definition "Genus containing two living species of of even-toed ungulates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phacochoerus"@en .

aat:300310430 a skos:Concept ;
    skos:definition "Family of mammals containing only two living members, the giraffe and the okapi, with many diverse extinct species formerly spread throughout Eurasia and Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Giraffidae"@en .

aat:300310431 a skos:Concept ;
    skos:definition "Family containing one species and several subspecies of giraffe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Giraffa"@en .

aat:300310432 a skos:Concept ;
    skos:definition "Genus containing two living species, the wild guanaco and the domesticated llama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lama"@en .

aat:300310433 a skos:Concept ;
    skos:definition "Members of a wild species of South American ruminant quadruped that is slender-bodied with long legs and neck, short tail, small head, and large pointed ears. They graze on grass and other plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lama guanicoe"@en .

aat:300310434 a skos:Concept ;
    skos:definition "Family containing several genera of even-toed ungulates, including camels, dromedaries, llamas, alpacas, vicuñas, and guanacos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camelidae"@en .

aat:300310435 a skos:Concept ;
    skos:definition "Genus containing one species of large aquatic mammal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dugong"@en .

aat:300310436 a skos:Concept ;
    skos:definition "Family containing one genus and one living species of large aquatic mammal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dugongidae"@en .

aat:300310437 a skos:Concept ;
    skos:definition "Family containing one genus and three living species of manatees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trichechidae"@en .

aat:300310438 a skos:Concept ;
    skos:definition "Species of ox-like grazing hooved animals native to North America; sometimes divided into subspecies based on their habitat: the plains bison and woodland bison."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bison bison"@en .

aat:300310439 a skos:Concept ;
    skos:definition "Species of ox-like grazing animals native to Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bison bonasus"@en .

aat:300310440 a skos:Concept ;
    skos:definition "Members of the family containing 140 species of cloven-hoofed mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bovidae"@en .

aat:300310443 a skos:Concept ;
    skos:definition "Genus containing reindeer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rangifer"@en .

aat:300310444 a skos:Concept ;
    skos:definition "Genus that contains moose, also known as elk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alces"@en .

aat:300310445 a skos:Concept ;
    skos:definition "Genus containing the roe deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capreolus"@en .

aat:300310446 a skos:Concept ;
    skos:definition "Members of a genus containing two species of of tree-dwelling mammals noted for slowness of movement and native to the lowland tropical forests of South and Central America, differing from three-toed sloths in that they are smaller, move somewhat slower, and spend most of their time hanging upside down from branches rather than sitting in trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Choloepus"@en .

aat:300310447 a skos:Concept ;
    skos:definition "Family containing the three-toed sloths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bradypodidae"@en .

aat:300310448 a skos:Concept ;
    skos:definition "Family containing the two-toed sloths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megalonychidae"@en .

aat:300310449 a skos:Concept ;
    skos:definition "Members of a genus containing four species of of tree-dwelling mammals noted for slowness of movement and native to the lowland tropical forests of South and Central America, differing from two-toed sloths in that they are larger, move somewhat faster, and often sit in the forks of trees rather than hanging from branches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bradypus"@en .

aat:300310450 a skos:Concept ;
    skos:definition "A family containing one genus of scaly anteaters distinguished by having backs covered with large, overlapping scales made up of agglutinated hairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manidae"@en .

aat:300310451 a skos:Concept ;
    skos:definition "Genus containing one living species of aardvark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orycteropus"@en .

aat:300310452 a skos:Concept ;
    skos:definition "Genus containing the great anteater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myrmecophaga"@en .

aat:300310453 a skos:Concept ;
    skos:definition "One of two families containing anteaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myrmecophagidae"@en .

aat:300310454 a skos:Concept ;
    skos:definition "One of two families containing anteaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyclopedidae"@en .

aat:300310463 a skos:Concept ;
    skos:definition "Organisms able to live and reproduce only in the presence of free oxygen; having an oxygen-based metabolism in which they utilize cellular respiration to use oxygen to oxidize substrates (for example sugars and fats) in order to obtain energy. Obligate or strict aerobes can live only in the presence of oxygen; facultative aerobes are capable of living in its absence as well as in its presence. Used especially in reference to microorganisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerobes"@en .

aat:300310465 a skos:Concept ;
    skos:definition "Members of a class of around ten orders of extinct fossil marine arthropods with a distinctive three-lobed, three-segmented form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trilobita"@en .

aat:300310466 a skos:Concept ;
    skos:definition "Members of a subphylum including scorpions, spiders, mites, horseshoe crabs, and sea spiders, all of which have six pairs of appendages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chelicerata"@en .

aat:300310467 a skos:Concept ;
    skos:definition "Members of a subphylum including 11,000 recognized living species and many extinct species, including the extinct Archipolypoda and living millipedes, centipedes, pauropods, and symphylans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myriapoda"@en .

aat:300310468 a skos:Concept ;
    skos:definition "Members of a subphylum containing two classes, insects and ametabolous arthropods, with bodies divided into an anterior head, thorax, and posterior abdomen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexapoda"@en .

aat:300310469 a skos:Concept ;
    skos:definition "Members of a subphylum containing crabs, lobsters, shrimps, barnacles, and many other forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crustacea"@en .

aat:300310470 a skos:Concept ;
    skos:definition "Members of a class containing over 1,000,000 species characerized by a body divided into head, thorax, and abdomen; head with one pair of antennae, mouthparts consisting of a pair of mandibles and two pairs of maxillae, several pairs of legs, and often wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Insecta"@en .

aat:300310471 a skos:Concept ;
    skos:definition "Members of an order containing around 150 species of tiny, pale, wingless, blind, primitive insects that live in damp humus and soil and feed on decaying organic matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protura"@en .

aat:300310472 a skos:Concept ;
    skos:definition "Members of an order of containing approximately 370 species of small primitive, wingless insects having three slender, bristlelike appendages at the tip of the abdomen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thysanura"@en .

aat:300310473 a skos:Concept ;
    skos:definition "Members of an order of containing approximately 800 species of small primitive wingless insects, considered by some entomologists to have features similar to ancestral insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diplura"@en .

aat:300310474 a skos:Concept ;
    skos:definition "Members of an order of containing approximately 6,000 species of small, primitive, wingless insects, most characterized by a forked appendage (furcula) attached at the end of the abdomen and held in place under tension from the tenaculum, a clasplike structure formed by a pair of appendages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Collembola"@en .

aat:300310475 a skos:Concept ;
    skos:definition "Members of an order of containing various species of insects known for their extremely short adult life spans, ranging from 30 minutes to one day, and emergence in large numbers in the summer months."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ephemeroptera"@en .

aat:300310476 a skos:Concept ;
    skos:definition "Members of an order of containing at least 5,000 living species of insects with adults that are easily recognized by their two pairs of narrow, transparent wings, sloping thorax, and long, usually slender body; the abdomen is almost always longer than any of the wings. They are large, active by day, and often strikingly colored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odonata"@en .

aat:300310477 a skos:Concept ;
    skos:definition "Members of an order of containing at least 1,700 recorded living species of insects, named because larvae are found under stones in streams. All species are intolerant of water pollution, thus their presence in a stream or still water is considered an indicator of good water quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plecoptera"@en .

aat:300310478 a skos:Concept ;
    skos:definition "Members of a superorder of containing cockroaches, termites, and mantids having two pairs of wings, thickened forewings called tegmina, hindwings folded longitudinally fanwise, hindlegs similar to middle ones that are adapted for running, and mandibulate mouthparts adapted for chewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dictyoptera"@en .

aat:300310479 a skos:Concept ;
    skos:definition "Members of an order of containing a single family of icebugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grylloblattodea"@en .

aat:300310480 a skos:Concept ;
    skos:definition "Members of a family containing 5 genera of extremophile wingless insects that live in extreme cold atop mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grylloblattidae"@en .

aat:300310481 a skos:Concept ;
    skos:definition "Members of an order containing one family of African carnivorous insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mantophasmatodea"@en .

aat:300310482 a skos:Concept ;
    skos:definition "Members of a family of insects having wingless adults with long, thin antennae, a predacious habits, mandibulate mouthparts, and raptorial legs adapted for walking; sometimes classified as a suborder of Notoptera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mantophasmatidae"@en .

aat:300310483 a skos:Concept ;
    skos:definition "Members of an order of insects including stick and leaf insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phasmida"@en .

aat:300310484 a skos:Concept ;
    skos:definition "Members of an order of insects including grasshoppers and crickets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orthoptera"@en .

aat:300310485 a skos:Concept ;
    skos:definition "Members of an order including 1,800 species of insects that are characterized by large membranous hindwings that lie hidden under short, leathery forewings. The name earwig is derived from the Anglo-Saxon word meaning \"ear creature,\" probably because of a widespread ancient superstition that earwigs penetrated the head by crawling into the ears of sleeping people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dermaptera"@en .

aat:300310486 a skos:Concept ;
    skos:definition "Members of an order containing ten families of insects known to be gregarious and inhabiting silken funnels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Embioptera"@en .

aat:300310487 a skos:Concept ;
    skos:definition "Members of an order containing cellulose-eating insects, the social system of which shows remarkable parallels with those of ants and bees, although it has evolved independently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isoptera"@en .

aat:300310488 a skos:Concept ;
    skos:definition "Members of an order containing 40 families of small insects that are destructive to books, feeding upon the paste in the bindings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Psocoptera"@en .

aat:300310489 a skos:Concept ;
    skos:definition "Members of an order containing one family and two genera of insects, one extinct and one living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zoraptera"@en .

aat:300310490 a skos:Concept ;
    skos:definition "Members of an order containing nearly 3000 species of chewing lice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mallophaga"@en .

aat:300310491 a skos:Concept ;
    skos:definition "Members of an order containing around 500 species of small, wingless, flat lice that have piercing and sucking mouthparts and live on blood and tissue fluids of mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anoplura"@en .

aat:300310492 a skos:Concept ;
    skos:definition "Members of an order containing cicadas, hoppers, whiteflies, aphids, and scale insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homoptera"@en .

aat:300310493 a skos:Concept ;
    skos:definition "Members of an order containing over 5,000 species of tiny, slender insects with fringed wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thysanoptera"@en .

aat:300310494 a skos:Concept ;
    skos:definition "Group including around 40,000 species of insects in the Hemiptera order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heteroptera"@en .

aat:300310495 a skos:Concept ;
    skos:definition "Members of an order containing over 680,000 living species of insects that develop wings inside the body and undergo an elaborate metamorphosis involving a pupal stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Endopterygota"@en .

aat:300310496 a skos:Concept ;
    skos:definition "Members of an order containing around 300 species of alderflies, dobsonflies, and fishflies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megaloptera"@en .

aat:300310497 a skos:Concept ;
    skos:definition "Members of an order containing around 150 species of predatory insects characterized by having an elongate prothorax but no modification of the forelegs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raphidiodea"@en .

aat:300310498 a skos:Concept ;
    skos:definition "Members of an order containing around 4,000 species of lacewings, mantidflies, antlions, and their relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neuroptera"@en .

aat:300310499 a skos:Concept ;
    skos:definition "Members of an order containing around 550 species in nine families of slender carnivorous insects with elongated filiform antennae, head usually a downward directed rostrum, with biting mouthparts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mecoptera"@en .

aat:300310500 a skos:Concept ;
    skos:definition "Members of an order containing small moth-like insects having two pairs of hairy membranous wings, closely related to moths and butterflies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trichoptera"@en .

aat:300310501 a skos:Concept ;
    skos:definition "Members of an order containing 155,000 species of butterflies, moths, and skippers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lepidoptera"@en .

aat:300310502 a skos:Concept ;
    skos:definition "Members of an order containing over 350,000 known living species of insects having the upper pair of wings converted into hard sheaths or wing-cases (elytra) that close over the back, and protect the lower or true wings, which most species are able to use in flight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coleoptera"@en .

aat:300310503 a skos:Concept ;
    skos:definition "Members of an order of insects containing sawflies, wasps, bees, and ants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hymenoptera"@en .

aat:300310504 a skos:Concept ;
    skos:definition "Members of an order of containing 240,000 species of insects possessing a single pair of wings on the mesothorax and hind wings that have developed into a pair of halteres on the metathorax. Insects in other orders may have the word \"fly\" in their name (e.g., dragonfly), but they are not true flies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diptera"@en .

aat:300310505 a skos:Concept ;
    skos:definition "Members of an order of around 2,000 species or varieties of parasitic bloodsucking insects that live on the exterior of the host and are often carriers of disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siphonaptera"@en .

aat:300310506 a skos:Concept ;
    skos:definition "Species of slender, flat, wingless insect with three tail bristles and covered with silvery scales. It normally lives indoors, eating materials containing high percentages of starch, including paste, bookbindings, and wallpaper, causing damage to books and fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lepisma saccharina"@en .

aat:300310507 a skos:Concept ;
    skos:definition "Genus containing silverfish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lepisma"@en .

aat:300310508 a skos:Concept ;
    skos:definition "Family containing silverfish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lepismatidae"@en .

aat:300310510 a skos:Concept ;
    skos:definition "Subclass containing mites and ticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acari"@en .

aat:300310511 a skos:Concept ;
    skos:definition "Members of a genus containing four living species of bird in the pheasant family, all native to Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gallus"@en .

aat:300310512 a skos:Concept ;
    skos:definition "Members of a large family containing 38 genera and around 138 species of jungle fowl (from which the domestic chicken is descended), partridge, peacock, pheasant, and quail. Grouse are also sometimes classified as a subfamily of this family rather than a separate family. Some classifications assign the turkey to Phasianidae, whereas several others place it in the family Meleagrididae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phasianidae"@en .

aat:300310514 a skos:Concept ;
    skos:definition "Members of a species of deer that are among the largest in the world, found in North America and closely related to the red deer of Eurasia (formerly considered the same species). The shoulders and neck are covered with long, shaggy, dark brown hair; the male has large antlers, which usually bear five tines and tower about 4 feet above his head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cervus canadensis"@en .

aat:300310515 a skos:Concept ;
    skos:definition "Genus containing 12 species of deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cervus"@en .

aat:300310516 a skos:Concept ;
    skos:definition "Family containing four living genera, including alligators and caimans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alligatoridae"@en .

aat:300310517 a skos:Concept ;
    skos:definition "Stiff, straight, high-backed chairs with solid arms used in Roman homes and public spaces; also, any chair that has the same form. The seat was placed high, requiring a footstool. In a Roman home, it was kept in the atrium for the use of the master of the house when he received guests or clients. Gods and kings in art may be represented as seated in such a chair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soliums"@en .

aat:300310518 a skos:Concept ;
    skos:definition "Members of a taxon of reptiles who developed two pairs of temporal arches (holes behind the eye in their skull) around 300 million years ago during the late Carboniferous period. Among diapsids are dinosaurs, crocodians, lizards, snakes, turtles, and birds. Some living diapsids have lost either one hole (lizards), or both holes (snakes), or even have a heavily restructured skull (modern birds), but they are classified as diapsids based on their ancestry. There are at least 14,600 living species of diapsids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diapsida"@en .

aat:300310519 a skos:Concept ;
    skos:definition "Dry sinks surmounted by an enclosed cupboard or open shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry sink hutches"@en .

aat:300310520 a skos:Concept ;
    skos:definition "General term referring to members of the Testudines order that live in fresh or brackish water rather than on land or in the sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrapins"@en .

aat:300310521 a skos:Concept ;
    skos:definition "General term referring to members of two families and at least seven living species of the Testudines order, distinguished from other turtles because they live in the sea rather than in fresh or brackish water or on land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea turtles"@en .

aat:300310522 a skos:Concept ;
    skos:definition "Dolls dressed in traditional clothes and representing people in various positions of society, created by native people in a Christian mission; particularly carved wooden dolls created by Chinese women and children in British Christian missions in China during the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mission dolls"@en .

aat:300310523 a skos:Concept ;
    skos:definition "Dolls having heads, and sometimes neck, arms, feet, or body, made of porcelain, whether glazed or unglazed (bisque)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain dolls"@en .

aat:300310524 a skos:Concept ;
    skos:definition "Genus containing around 40 species, including crows and ravens, characterized as being large, glossy, black, gregarious, intelligent omnivores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corvus"@en .

aat:300310525 a skos:Concept ;
    skos:definition "Family containing around 100 species of crows, ravens, jays, magpies, nutcrackers, rooks, jackdaws, treepies, and choughs; considered among the most intelligent of birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corvidae"@en .

aat:300310526 a skos:Concept ;
    skos:definition "General term referring to several species of carnivorous dinosaurs that walk on two legs, including Velociraptor, Deinonychus, Oviraptor, Dromaeosaurus, Gigantoraptor, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raptors"@en .

aat:300310527 a skos:Concept ;
    skos:definition "Family containing 236 species in 64 genera, including hawks, eagles, buzzards, harriers, accipiters, kites, Old World vultures, and sparrowhawks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Accipitridae"@en .

aat:300310528 a skos:Concept ;
    skos:definition "Family containing about 60 species of falcons and caracaras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Falconidae"@en .

aat:300310529 a skos:Concept ;
    skos:definition "Members of the genus containing around 50 living species of goshawks and sparrowhawks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Accipiter"@en .

aat:300310530 a skos:Concept ;
    skos:definition "Albums or scrapbooks containing photographs and other momentos of a wedding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding albums"@en .

aat:300310531 a skos:Concept ;
    skos:definition "Family of birds containing ducks, geese, and swans. Various classifications divide it into 3 subfamilies and 8 to 12 tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatidae"@en .

aat:300310532 a skos:Concept ;
    skos:definition "Family containing egrets, bitterns, and herons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ardeidae"@en .

aat:300310533 a skos:Concept ;
    skos:definition "Members of a genus containing about 10 living species of herons, which are long-legged wading birds. Most egrets have white plumage and develop long ornamental nuptial plumes for the breeding season. The term \"egret\" is sometimes used to refer to birds of similar appearance in other genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egretta"@en .

aat:300310534 a skos:Concept ;
    skos:definition "Members of a subfamily containing 12 living species of solitary marsh birds, allied to the heron, but with shorter neck and stouter body. Bitterns typically have a camouflage pattern of streaks of variegated brown and buff, and when they stand with their bill pointed upwards they are able dissappear among the reeds and grasses of their habitat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Botaurinae"@en .

aat:300310535 a skos:Concept ;
    skos:definition "Family containing only one living species of ostrich."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Struthionidae"@en .

aat:300310536 a skos:Concept ;
    skos:definition "Genus containing only one living species of ostrich."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Struthio"@en .

aat:300310537 a skos:Concept ;
    skos:definition "The young of cattle, oxen, bison, dolphins, elephants, giraffes, hippopotamuses, moose, rhinoceroses, whales, and yaks, and other animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calfs"@en .

aat:300310539 a skos:Concept ;
    skos:definition "A style, particularly in the context of interior design, characterized by European or American antiques or replicas of antiques that that show evidence of wear and age, such as layers of paint that are worn and chipped and faded or muted fabrics. The style first developed in Britain. The term was coined in the \"World of Interiors\" magazine in the 1980s and has become a registered trademark for a US company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shabby chic"@en .

aat:300310540 a skos:Concept ;
    skos:definition "A generic style, particularly in the context of interior design, characterized by the use of long-established and common styles of furniture, wall and window treatments, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traditional"@en .

aat:300310541 a skos:Concept ;
    skos:definition "A generic style, particularly in the context of decorative arts and interior design, characterized by the use of rural motifs and themes, especially incorporating furniture made of wood or metal, the main components of which are carved and fretted to resemble the branches of trees. The style that appeared in the mid-18th century with the theme of the idealization of nature and the simple life. The style was especially popular in Switzerland, Germany, Austria, Britain, and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rustic"@en .

aat:300310542 a skos:Concept ;
    skos:definition "A generic style, particulary in the context of decorative arts and interior design, characterized by motifs and elements originating in New Mexico, Arizona, and nearby areas, including influences of Native American and Spanish design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southwest"@en .

aat:300310543 a skos:Concept ;
    skos:definition "A generic style, particularly in the context of clothing fashion and interior design, characterized by harking back to a former style that is nostalgically retrospective, particularly styles from the mid-20th century. Differing from \"old-fashioned\" in not being antiquated in form or character, but having reference to a previous style that is both not from as distant a time as \"old-fashioned\" and is still considered desirable and popular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retro"@en .

aat:300310544 a skos:Concept ;
    skos:definition "Term referring to any generic style, particularly in the context of interior design, characterized by the incorporation of antiques or replicas of antiques of one particular named style, usually styles from 18th and 19th-century Europe and the United States (e.g., American Colonial, Louis XIV, Hepplewhite, etc.)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "period style"@en .

aat:300310545 a skos:Concept ;
    skos:definition "A generic style, particularly in the context of interior design, characterized by soft, comfortable furnishings incorporating antiques or replicas of antiques reminiscent of 19th-century rural farmhouses or cottages of Britain and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "country"@en .

aat:300310546 a skos:Concept ;
    skos:definition "Typically used with reference to collectibles and desirable objects dating to at least 100 years before the present, with differing ranges of age for certain specific objects (e.g., 60 years carpets, 25 years for automobiles)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antique"@en .

aat:300310547 a skos:Concept ;
    skos:definition "Typically used with reference to collectibles and desirable objects not so old as an antique (100 years old), usually reserved for objects dating between the 1940s and 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vintage"@en .

aat:300310548 a skos:Concept ;
    skos:definition "Family of birds including woodpeckers, piculets, and wrynecks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picidae"@en .

aat:300310549 a skos:Concept ;
    skos:definition "Family containing one living genus and eight species of pelicans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pelecanidae"@en .

aat:300310550 a skos:Concept ;
    skos:definition "Family of seabirds including puffins, murres, auklets, and relatives. They superficially resemble penguins, although they are not closely related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alcidae"@en .

aat:300310551 a skos:Concept ;
    skos:definition "Genus containing pumas and jaguarundis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Puma"@en .

aat:300310552 a skos:Concept ;
    skos:definition "Members of a species of medium-sized cat found in forested and brushy regions, especially those near water, in Mexico, Central and South America. Jaguarundis have short legs, short, rounded ears, an unspotted uniformly colored coat that occurs in two phases, a blackish to brownish gray phase and a foxy red to chestnut phase, which were formerly considered separate species (although now it is recognized that both phases may occur in a single litter). The cat resembles an otter to some extent. Genus of one primarily South American species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Puma yagouaroundi"@en .

aat:300310553 a skos:Concept ;
    skos:definition "Family containing pigeons and doves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Columbidae"@en .

aat:300310554 a skos:Concept ;
    skos:definition "Family of extinct flightless birds, including the dodo, that inhabited the Mascarene Islands of Mauritius and Rodrigues, but became extinct through hunting by humans and predation by introduced non-native mammals following human colonization in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raphidae"@en .

aat:300310555 a skos:Concept ;
    skos:definition "Genus containing the extinct flightless bird, the dodo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raphus"@en .

aat:300310556 a skos:Concept ;
    skos:definition "Genus containing several species of medium to large stout-bodied pigeons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Columba"@en .

aat:300310557 a skos:Concept ;
    skos:definition "General term referring to larger members of the family Columbidae; smaller members are called \"pigeons.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigeons"@en .

aat:300310558 a skos:Concept ;
    skos:definition "Family containing several hundred species of small, conical-billed, seed-eating songbirds, including many, but not all, called \"finches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fringillidae"@en .

aat:300310559 a skos:Concept ;
    skos:definition "Genus containing goldfinches, redpolls, greenfinches, linnets, twites, and the non-African siskins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carduelis"@en .

aat:300310560 a skos:Concept ;
    skos:definition "Members of a family of small, gregarious sparrows and weaver birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passeridae"@en .

aat:300310561 a skos:Concept ;
    skos:definition "Genus of Old World sparrows that are found naturally in open habitats in the warmer climates of Africa and southern Eurasia, including several species that have adapted to human habitation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Passer"@en .

aat:300310562 a skos:Concept ;
    skos:definition "Members of a family of 305 species of songbirds in 20 genera, including birds that are called thrushes, bluebirds, robins, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turdidae"@en .

aat:300310564 a skos:Concept ;
    skos:definition "Family of birds containing one genus and two species of living turkeys, and several fossil turkeys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Meleagrididae"@en .

aat:300310566 a skos:Concept ;
    skos:definition "Genus including alpacas and vicuñas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vicugna"@en .

aat:300310567 a skos:Concept ;
    skos:definition "Members of a species of Peruvian quadruped having long fine woolly hair. Along with the llama, the alpaca was apparently domesticated several thousand years ago by the Indians of the Andes Mountains of South America. Alpacas are considerably smaller than llamas, and unlike llamas, alpacas are not used as beasts of burden but are valued only for their fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vicugna pacos"@en .

aat:300310568 a skos:Concept ;
    skos:definition "General term referring to members of ten or more species of stout carnivores of the weasel family, found in various parts of the world, known for their burrowing ability, and some having one or more white stripes on their heads. The species differ in size, habitat, and coloration, but all are nocturnal and possess anal scent glands, powerful jaws, and large, heavy claws on their forefeet, which are used to dig for food and construct underground dens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badgers"@en .

aat:300310569 a skos:Concept ;
    skos:definition "Genus containing 16 extant species of weasels, ermines, and ferrets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustela"@en .

aat:300310570 a skos:Concept ;
    skos:definition "Family containing one genus with two living species of beavers and 24 extinct genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castoridae"@en .

aat:300310571 a skos:Concept ;
    skos:definition "Family containing around 1,383 living species in over 300 genera of rats, mice, and similar animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muridae"@en .

aat:300310572 a skos:Concept ;
    skos:definition "Family of rodent and the second largest family of mammals overall; it has members throughout the New World, Asia, and Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cricetidae"@en .

aat:300310573 a skos:Concept ;
    skos:definition "Genus containing one species, the muskrat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ondatra"@en .

aat:300310574 a skos:Concept ;
    skos:definition "Members of a species of gregarious tree squirrel native to the eastern United States excluding New England, north into the southern prairie provinces of Canada, and west to the Dakotas, Colorado, and Texas. Their habitat partially overlaps with the eastern gray squirrel, which is smaller and not as reddish in color as the fox squirrel. Fox squirrels are noted as living fossils, skeletally very similar the oldest known squirrel, Protosciurus, from the late Oligocene and early Miocene epochs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sciurus niger"@en .

aat:300310575 a skos:Concept ;
    skos:definition "Members of a species of tree squirrel that is the largest in size among species native to western North America. They are relatively shy, and will generally run up a tree and give a hoarse barking call when disturbed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sciurus griseus"@en .

aat:300310576 a skos:Concept ;
    skos:definition "Genus containing over 30 living species of tree squirrels, including the common, bushy-tailed squirrels in North and South America, Europe, and parts of Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sciurus"@en .

aat:300310577 a skos:Concept ;
    skos:definition "Members of a genus containing around 25 species of small, burrowing ground squirrels native to North America and Eurasia. Chipmunks are pygmy squirrels that have adapted to exploiting the resources of rocky terrain and forest understories; they scamper along the ground but are also expert climbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tamias"@en .

aat:300310578 a skos:Concept ;
    skos:definition "Genus containing the meerkat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suricata"@en .

aat:300310579 a skos:Concept ;
    skos:definition "Members of a species of small, agile mammals of the mongoose family, with a pointed face, tiny ears, black eye patches, living in cooperative warrens containing 20 to 50 animals, found in southwestern Africa, and unmistakably recognizable by the upright posture of the pack's sentinels that watch for predators."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Suricata suricata"@en .

aat:300310580 a skos:Concept ;
    skos:definition "Species of intelligent, adaptable New World canid that evolved in North America two million years ago alongside the extinct dire wolf. It is found throughout North and Central America, is smaller and more lightly built than the wolf, having a coat color varying from grayish brown to yellowish gray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canis latrans"@en .

aat:300310581 a skos:Concept ;
    skos:definition "Species of New World canid that existed during the Pleistocene Epoch (1,600,000 to 10,000 years ago), differing from the modern wolf in its larger size, more massive skull, smaller brain, and relatively light limbs. It was widespread, with remains found in Florida, the Mississippi Valley, the Valley of Mexico, the La Brea Tar Pits of Los Angeles, and other sites. Although it was closely related to the gray wolf, it was not the direct ancestor of any species known today. The type specimen (a fossilized jawbone) of the dire wolf was found in Evansville, Indiana in the summer of 1854, when the Ohio River was quite low."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canis dirus"@en .

aat:300310582 a skos:Concept ;
    skos:definition "General term referring to members of 22 species of large, carrion-eating birds that live predominantly in the tropics and subtropics of the New World and Old World. Although they superficially resemble each other, they are only distantly related, the similarities between Old World and New World groups due to convergent evolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vultures"@en .

aat:300310583 a skos:Concept ;
    skos:definition "General term for members of four species of medium-sized canids found in Africa, Asia southeastern Europe, filling an ecological niche of predators of small to medium-sized animals, scavengers, and omnivores, similar to the coyote in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jackals"@en .

aat:300310584 a skos:Concept ;
    skos:definition "Crosses having three crossbars on a longer vertical bar, where the upper bar represents the INRI title of the cross, the second longer crossbar designating arms of the cross, and the lowest crossbar, which is always inclined at an angle, signifying the suppedaneum or foot rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orthodox crosses"@en .

aat:300310585 a skos:Concept ;
    skos:definition "Members of a a very large family of freshwater fish originally from Eurasia and southeast Asia, including carp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyprinidae"@en .

aat:300310586 a skos:Concept ;
    skos:definition "An order containing six families, over 300 genera, and over 3,300 species of ray-finned fish including the carp, minnows, loaches, and their relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cypriniformes"@en .

aat:300310587 a skos:Concept ;
    skos:definition "Members of the genus of the carp family including goldfish and around five other species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carassius"@en .

aat:300310588 a skos:Concept ;
    skos:definition "Refers to visual works made of steel. With reference to architecture, use \"steel frame construction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steelwork"@en .

aat:300310589 a skos:Concept ;
    skos:definition "A technique of building where all or part of the frame, usually wooden or metal, is exposed on the exterior rather than being hidden by walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exposed frame construction"@en .

aat:300310590 a skos:Concept ;
    skos:definition "Order of ray-finned fish including the cod and its allies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gadiformes"@en .

aat:300310591 a skos:Concept ;
    skos:definition "Family of ray-finned marine fish including cod, haddock, pollock, and whiting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gadidae"@en .

aat:300310592 a skos:Concept ;
    skos:definition "A class of very ancient vertebrates including sharks, rays, skates, and chimaeras, that are characterized by having a cartilaginous skeleton, and typically a notochord present in the young that is gradually replaced by cartilage, a relatively large brain weight relative to body size, red blood cells produced in the spleen and special tissue around the gonads rather than in bone marrow, unique Leydig's organ and epigonal organ that may be part of the immune system, tough skin covered with dermal teeth, five to seven gills, internal fertilization, having young produced by either live birth (ovoviviparous species) or through eggs (oviparous) depending upon the species, and by being primarily ectothermic or cold blooded. Many of the living sharks and rays are assigned to the same genera as species that swam the Cretaceous seas over 100,000,000 years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chondrichthyes"@en .

aat:300310594 a skos:Concept ;
    skos:definition "Members of an order containing five families of freshwater and marine ray-finned fish, including ricefish, medakas, needlefish, flyingfishes, halfbeaks, and sauries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beloniformes"@en .

aat:300310595 a skos:Concept ;
    skos:definition "Pertaining to the social movement centered on a concern for the environment and sustainable living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green"@en .

aat:300310596 a skos:Concept ;
    skos:definition "Order that contains over 7,000 species of ray-finned bony fishes, making it the largest order of vertebrates, including forty percent of all bony fishes. The name Perciformes means perch-like. They have a wide variety of shapes and sizes and are found in almost all aquatic environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Perciformes"@en .

aat:300310597 a skos:Concept ;
    skos:definition "Family containing one genus and one species, the swordfish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xiphiidae"@en .

aat:300310598 a skos:Concept ;
    skos:definition "Genus containing one species, the swordfish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xiphias"@en .

aat:300310599 a skos:Concept ;
    skos:definition "Family containing 15 genera and 55 species of mackerels, tunas, and bonitos, having two dorsal fins, a series of finlets between the rear dorsal fin and behind the anal fin, a caudal fin that is strongly divided and rigid, with a slender, ridged, base. They are generally fast predators in the open ocean. Some members of the family warm-blooded, such as the tuna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scombridae"@en .

aat:300310600 a skos:Concept ;
    skos:definition "Order that contains ray-finned fishes, including pipefishes and seahorses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syngnathiformes"@en .

aat:300310601 a skos:Concept ;
    skos:definition "Family containing around 55 genera of seahorses, pipefishes, and weedy and leafy sea dragons. Fish of this family have the unique characteristic of males carrying the eggs during incubation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syngnathidae"@en .

aat:300310602 a skos:Concept ;
    skos:definition "Forms appearing like the letter \"P\" crossed by the letter \"X,\" actually the first two letters of the Greek word for \"Christ,\" chi and rho, used to symbolize the name in Christian iconography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chi-rhos"@en .

aat:300310603 a skos:Concept ;
    skos:definition "Refers to a fine grade of Prussian blue, having a finer luster and a bronze sheen, favored in printing inks. It is also used in paints, enamels, and lacquers. Considered one of the three best grades of Prussian blue. Chinese blue (BaCuSi4O10) is more stable in chemical structure and fades less easily than Chinese purple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese blue"@en .

aat:300310604 a skos:Concept ;
    skos:definition "A zigzag pattern in which the rows of zigzags alternate colors, in which each leg of each v is often decorated with an s-motif and in which a line extends from the point of each v into the succeeding v."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyer kası"@en .

aat:300310606 a skos:Concept ;
    skos:definition "Genus of fish containing the haddock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melanogrammus"@en .

aat:300310607 a skos:Concept ;
    skos:definition "Members of an order including herring and anchovies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clupeiformes"@en .

aat:300310608 a skos:Concept ;
    skos:definition "Members of a family containing herring, shad, sardines, menhadens, and hilsa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clupeidae"@en .

aat:300310610 a skos:Concept ;
    skos:definition "Members of an order containing around 600 species of bony, oval-shaped, flattened fishes, such as the flounder, halibut, and turbot. In many species, both eyes lie on one side of the head, either the left eye or the right eye (depending upon species) having migrated through or around the head during development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pleuronectiformes"@en .

aat:300310611 a skos:Concept ;
    skos:definition "Members of a family of right-sided flat fish, most species of which lie on the sea bottom on their left side, with both eyes facing upwards on the right side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pleuronectidae"@en .

aat:300310612 a skos:Concept ;
    skos:definition "Order containing one living family of trout and salmon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salmoniformes"@en .

aat:300310613 a skos:Concept ;
    skos:definition "Family containing salmon, trout, chars, freshwater whitefishes, and graylings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salmonidae"@en .

aat:300310614 a skos:Concept ;
    skos:definition "Members of a superfamily containing around 14,000 species of insects belonging to four families. The wings, bodies, and legs of butterflies, like those of moths, are covered with dustlike scales. Unlike moths, butterflies are active during the day and are usually brightly colored or strikingly patterned. Perhaps the most distinctive physical features of the butterfly are its club-tipped antennae and its habit of holding the wings vertically over the back when at rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papilionoidea"@en .

aat:300310615 a skos:Concept ;
    skos:definition "Members of a superfamily containing around 3,500 species of insects that occur worldwide and are named for their fast, darting flight. Skippers are considered an intermediate form between butterflies and moths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hesperioidea"@en .

aat:300310616 a skos:Concept ;
    skos:definition "Members of a particular superfamily of the Lepidoptera order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hedyloidea"@en .

aat:300310617 a skos:Concept ;
    skos:definition "Members of a particular superfamily including clothes moths, bagworms and relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tineoidea"@en .

aat:300310618 a skos:Concept ;
    skos:definition "Members of a family containing around 3000 species of small or medium-sized moths that hold their wings over the body when at rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tineidae"@en .

aat:300310619 a skos:Concept ;
    skos:definition "Refers to a unit of currency in circulation in Bhutan from 1974, equal to 100 chetrums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ngultrums"@en .

aat:300310620 a skos:Concept ;
    skos:definition "Paintings or prints that depict beautiful women. This term, which literally means \"pictures of beautiful women,\" was most likely coined in the Edo period (1615-1868) or the Meiji period (1868-1912). Before this period, these pictures may have been called \"onna-e\" or \"bijin-e\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bijinga"@en .

aat:300310621 a skos:Concept ;
    skos:definition "Describes currency manufactured from paper originating in Asia, used from the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asian paper money"@en .

aat:300310622 a skos:Concept ;
    skos:definition "Paintings or sculptures portraying Zen priests. These portraits are known for having particularly expressive faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinzō"@en .

aat:300310624 a skos:Concept ;
    skos:definition "Roofed porch or lean-to pent roofs that extend from a building, especially of a temple hall or of a \"tahōtō.\" They usually surround the main part of the building and were used as a method to increase depth. This architectural element was widely used in Zen-style architecture introduced to Japan in the late 12th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mokoshi"@en .

aat:300310625 a skos:Concept ;
    skos:definition "In general, paintings and calligraphy by Zen Buddhist priests of China, Korea, and Japan. More specifically, may refer to work by Japanese Zen priests from the Edo period (1600-1868). The content of the work is focused on teachings of the Dharma. Aesthetically this style is known to be bold, spontaneous and even amateurish in execution and light-hearted in tone. The term literally means \"Zen painting.\" For the practice of painting as a Zen activity, use \"gazen.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zenga"@en .

aat:300310626 a skos:Concept ;
    skos:definition "Twentieth century Japanese printmaking movement that was based on the artists' personal involvement in all stages of print production as opposed to the teamwork style of traditional \"ukiyo-e\" print production. The term literally means \"creative print.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sōsaku hanga"@en .

aat:300310627 a skos:Concept ;
    skos:definition "Main halls of temple complexes which usually housed the primary statues of buddhas or bodhisattvas. For the main halls of some early Buddhist temples (into the 8th century), use kondō."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hondō"@en .

aat:300310628 a skos:Concept ;
    skos:definition "Main halls, or \"golden halls,\" of Buddhist temples or sanctuaries; used particularly for some early Buddhist temples into the 8th century. For the main halls of temples in general, use hondō."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kondō"@en .

aat:300310629 a skos:Concept ;
    skos:definition "Members of a particular superfamily of the Lepidoptera order, containing around 3,400 species, with adults large to very large in size, antennae that are comblike in males, including the silk moths, emperor moths, sphinx moths and relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bombycoidea"@en .

aat:300310630 a skos:Concept ;
    skos:definition "Family of moths including the silk worm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bombycidae"@en .

aat:300310631 a skos:Concept ;
    skos:definition "Members of a family containing 1,500 species of large moths, some of which spin thick, silken cocoons and are sometimes used to produce commercial silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saturniidae"@en .

aat:300310632 a skos:Concept ;
    skos:definition "Genus containing one species of living giant panda and four extinct species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ailuropoda"@en .

aat:300310633 a skos:Concept ;
    skos:definition "Members of a species of bear inhabiting bamboo forests in the mountains of central China, distinguished by a striking coat of black and white, a bulky body, round face, and a diet. An unusual anatomic characteristic is an enlarged wrist bone that functions somewhat like a thumb, enabling pandas to handle food with considerable dexterity. Although the animal was formerly classified with racoons and their relatives, it is now agreed that they are bears. It is endangered by loss of habitat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ailuropoda melanoleuca"@en .

aat:300310634 a skos:Concept ;
    skos:definition "Genus containing four living species and at least one extinct species, as well as many subspecies, including the black bear, brown bear, and polar bear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursus"@en .

aat:300310635 a skos:Concept ;
    skos:definition "Members of a species of large, solitary, strictly carnivorous bear found throughout the Arctic region, having a stocky build, long neck, relatively small head, short rounded ears, a short tail, insulating blubber, black skin, and fur comprising dense underfur with an outer layer of guard hairs that appear white or biege but are actually transparent. The polar bear travels long distances over vast desolate expanses, generally on drifting oceanic ice floes, searching for seals, its primary prey. It is endangered by loss of habitat resulting from global warming. According to both fossil and genetic evidence, the polar bear diverged from the arctic brown bear around 200,000 years ago, when it is probable that a population of brown bears became isolated during a period of glaciation in the Pleistocene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursus maritimus"@en .

aat:300310636 a skos:Concept ;
    skos:definition "Members of a species containing over 20 subspecies and up to 80 varieties of shaggy-haired bear native to Europe, Asia, and northwestern North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursus arctos"@en .

aat:300310637 a skos:Concept ;
    skos:definition "Members of a subspecies of brown bear native to the mountainous districts of western North America, characterized by their massive size, humped shoulders, elevated forehead that contributes to a somewhat concave profile, and fur that is brownish to buff in color with hairs that are typically silver- or pale-tipped, giving them the grizzled (hair sprinkled with gray) appearance for which they are named."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursus arctos horribilis"@en .

aat:300310638 a skos:Concept ;
    skos:definition "Members of a subspecies of brown bear native to the Kodiak Islands of southcentral Alaska, noted as the largest of living land carnivores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursus arctos middendorffi"@en .

aat:300310639 a skos:Concept ;
    skos:definition "Members of an extinct species of very large bear notable for its habit of inhabiting European caves, where its remains are frequently preserved. The cave bear is best known from late Pleistocene cave deposits, although it can be traced back to Late Pliocene times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ursus spelaeus"@en .

aat:300310640 a skos:Concept ;
    skos:definition "Order containing one living family of flamingos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phoenicopteriformes"@en .

aat:300310641 a skos:Concept ;
    skos:definition "Family containing around three genera and five living species of tall, long-necked, long-legged, pink-colored, large-winged, wading birds with thick downturned bills. The birds were previously classified with the the long-legged Ciconiiformes based on certain physical characteristics, although now they are generally placed in their own family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phoenicopteridae"@en .

aat:300310642 a skos:Concept ;
    skos:definition "Paintings with subject matter of interest to women, particularly romances such as the Tale of Genji. There are few if any contemporary definitions of the term, resulting in ambiguity about the style of painting or the gender of the artists creating these works. This term was used in the Heian period (794-1185). For paintings or prints that depict the beauty of women, see also \"bijinga,\" a term coined in the Edo (1615-1868) or Meiji (1868-1912) period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "onna-e"@en .

aat:300310644 a skos:Concept ;
    skos:definition "Painting style from the Heian period (794-1185) that may have referred specifically to the work of professional painters of the imperial court and was notable for its ink-line drawing and action packed scenes. This style, considered masculine, was sometimes contrasted with \"onna-e,\" feminine painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otoko-e"@en .

aat:300310645 a skos:Concept ;
    skos:definition "Japanese figurative sculpture construction technique characteristic of the early Heian period (794-1185) where the head and torso were carved from the same block of wood. The arms, legs and other elements such as drapery were many times carved from separate pieces of wood and attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ichiboku zukuri"@en .

aat:300310646 a skos:Concept ;
    skos:definition "Technique of sculpture construction that was perfected in 11th century Japan where blocks of wood were carved individually and then joined together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yosegi zukuri"@en .

aat:300310647 a skos:Concept ;
    skos:definition "Sliding decorative doors or panels that are the sole entrance to a concealed area in a shoin-style building. The term literally means \"sleeping-room fixture.\" May be used to refer to the doorways rather than the panels themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chōdaigamae"@en .

aat:300310648 a skos:Concept ;
    skos:definition "Ordination halls in Buddhist temple complexes of the Tendai sect which contain an ordination platform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kaidan'in"@en .

aat:300310649 a skos:Concept ;
    skos:definition "Decorative technique in which thin pieces of gold and silver leaf that have been shaped into squares, strips or lozenges are applied to lacquerware, paintings, and sculptures. Originally introduced to Japan during the Nara period (710-794), the technique was popular from the Heian period (794-1185) through the Kamakura period (1185-1333)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kirikane"@en .

aat:300310650 a skos:Concept ;
    skos:definition "A group of decorative techniques involving the application of colored powders to lacquerware. Literally, \"sprinkled picture\", powdered gold, silver or colored pigment is applied while the lacquer is still damp. These techniques were very popular during the Heian period (794-1333) when they became the dominant method used for decorating Japanese lacquerware. They are often used in conjuction with \"kirikane.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maki-e"@en .

aat:300310651 a skos:Concept ;
    skos:definition "Sculpture construction technique where cloth is soaked with lacquer and then draped over a mold that is removed once the lacquer has dried. The technique was introduced to Japan from China in the 8th century and is still used. For hollow dry lacquer technique, see \"dakkatsu kanshitsu\"; for wood-core dry lacquer technique, see \"mokushin kanshitsu.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kanshitsu"@en .

aat:300310652 a skos:Concept ;
    skos:definition "Sculpture construction technique referred to as hollow dry lacquer where layers of lacquer soaked cloth are applied over a clay mold. Once the lacquer dries, the mold is removed and a wooden armature is sometimes inserted to prevent warping. This technique was popular during the Hakuhou (645-710) and Nara (710-749) periods and was largely replaced by the wood-core dry lacquer technique, \"mokushin kanshitsu,\" by the end of the Nara period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dakkatsu kanshitsu"@en .

aat:300310653 a skos:Concept ;
    skos:definition "Sculpture construction technique referred to as wood-core dry lacquer where layers of lacquer soaked cloth are applied over a solid wooden mold. This technique was popular during the last half of the Nara (710-749) period, replacing the hollow dry-lacquer technique, \"dakkatsu kanshitsu.\" As the technique developed, more details were added to the wood form and the cloth layers became thinner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mokushin kanshitsu"@en .

aat:300310656 a skos:Concept ;
    skos:definition "Members of an order of Psittaciformes containing 21 living species found in Australia, New Guinea, and Solomon Islands, characterized by a curved beak, a foot with two forward toes and two backwards toes, differing from true parrots in having a showy movable headcrest, the presence of a gall bladder, and coloration that is white, black, or gray with touches of red or yellow rather than the bright green and blue of true parrots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cacatuidae"@en .

aat:300310657 a skos:Concept ;
    skos:definition "Genus containing one living species, the budgerigar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melopsittacus"@en .

aat:300310658 a skos:Concept ;
    skos:definition "Members of a species of small parrot belonging to the tribe of the broad-tailed parrots. They are green and yellow in color, gregarious, monogamous, living in large colonies, are naturally distributed through Australia but introduced to several other semi-arid and sub-humid habitats around the world, and have been popular as a caged pet since the 19th century, existing in many color variations through breeding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melopsittacus undulatus"@en .

aat:300310659 a skos:Concept ;
    skos:definition "General term referring to several species in different genera, having in common that they are small or medium-sized parrots, usually green in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parakeets"@en .

aat:300310660 a skos:Concept ;
    skos:definition "General term referring to around 18 species in different genera of parrots, having in common that they are large, colorful, native to tropical America, have a very large beak that is dark in color, and have a relatively featherless, light colored, facial patch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macaws"@en .

aat:300310661 a skos:Concept ;
    skos:definition "Suborder of insects including wasps, bees, and ants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apocrita"@en .

aat:300310662 a skos:Concept ;
    skos:definition "Members of a superfamily containing more than 20,000 living species of flying insects in eight families, including primitive wasplike bees, solitary bees, and bees that live in colonies, some of which are valued by humans as pollinators and producers of honey and wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apoidea"@en .

aat:300310663 a skos:Concept ;
    skos:definition "Members of a superfamily containing ants and some wasps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vespoidea"@en .

aat:300310664 a skos:Concept ;
    skos:definition "Masks which depict physical deformity, such as paralysis, leprosy, or ravages of disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deformity masks"@en .

aat:300310665 a skos:Concept ;
    skos:definition "Family containing over 4,000 species in over 100 genera of flies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muscidae"@en .

aat:300310666 a skos:Concept ;
    skos:definition "Genus containing the housefly and face fly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musca"@en .

aat:300310667 a skos:Concept ;
    skos:definition "Members of a species of Middle Palaeolithic hominid who emerged between 200,000 and 100,000 years ago and were replaced by early modern humans between 35,000 and 28,000 years ago. Neanderthals inhabited Eurasia; similar human populations lived at the same time in eastern Asia and Africa; however, because Neanderthals lived in a land of abundant limestone caves that they used for shelters, their bones were preserved and they are thus better known than some other archaic members of Homo. In some classifications, Neanderthals are listed as a subspecies of humans (Homo sapiens neanderthalensis)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homo neanderthalensis"@en .

aat:300310669 a skos:Concept ;
    skos:definition "Two-storied main gates of a Zen temple complexes; literally \"enlightenment gate,\" \"mountain gate,\" or \"triple gate.\" The size of the gate could be equated with the status of the temple. These gates can contain three passages and are seen also as symbolic barriers between the profane and the sacred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanmon"@en .

aat:300310670 a skos:Concept ;
    skos:definition "Relic hall, where Buddhist relics are preserved and venerated. A famous example is located on the grounds of Engakuji Temple in Kamakura."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shariden"@en .

aat:300310671 a skos:Concept ;
    skos:definition "Family containing up to 700 species in four genera of beetles, including the larder beetle, hide or leather beetle, carpet beetle, and khapra beetle, among others. The wormlike larvae of members of this family are the only beetle larvae that are covered with hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dermestidae"@en .

aat:300310672 a skos:Concept ;
    skos:definition "One of the four genera of skin beetles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dermestes"@en .

aat:300310673 a skos:Concept ;
    skos:definition "Crosses having arms terminating in steplike forms, in heraldry typically affecting all four arms. In other contexts, often a Latin cross with only the lower arm terminating in the steplike form, as if the cross were standing on a mount."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graded crosses"@en .

aat:300310674 a skos:Concept ;
    skos:definition "Members of a family containing 90 species of small beetles ranging from reddish brown to black in color, and having larvae that bore through seasoned wood, reducing it to a dry powder. They do not enter varnished, painted, or treated wood. The holes left behind by this and other species of powderpost beetles are often erroneously considered to be evidence of the antiquity of a wooden object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lyctidae"@en .

aat:300310675 a skos:Concept ;
    skos:definition "Members of a family containing over 700 species in 11 genera of beetles that live in living vines and branches, dry wood, or under tree bark, some of which can damage or destroy structures or furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bostrichidae"@en .

aat:300310676 a skos:Concept ;
    skos:definition "Buildings that replaced the pagoda in some temple complexes of Esoteric Buddhism; literally \"many-jewelled pagoda\", \"pagoda of many tiers\", or \"multi-treasure tower\". These were introduced to Japan during the Heian period (794-1185) and are characterized by a white, plaster hemisphere rising from a square substructure. A famous example of these is the Ishiyamadera Pagoda in Otsu near Kyoto, erected in 1154."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tahōtō"@en .

aat:300310677 a skos:Concept ;
    skos:definition "Cores of buildings, the parts placed directly underneath the main part of the roof; usually an odd number of bays wide and 2 bays deep. Sometimes used to refer specifically to the central part of a Buddhist temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moya"@en .

aat:300310678 a skos:Concept ;
    skos:definition "The strongest and securist parts of Japanese castles, these tower-like structures were constructed both within other buildings and free-standing and were sometimes located within an inner compound called a \"honmaru\". They could exist alone or connected to other structures of the same type. For these types of fortification structures in western European castles, use \"keeps\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenshu"@en .

aat:300310679 a skos:Concept ;
    skos:definition "Main fortified areas of Japanese castle complexes, literally \"main circles\", that contained the \"tenshu\". These areas were the most protected parts of the castle and, in some cases, were used as the residences of the castle owners during wartime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honmaru"@en .

aat:300310680 a skos:Concept ;
    skos:definition "Family containing around 30,000 species of beetles characterized as being stout-bodied, having bright metallic colors, clubbed antennae, and front legs are broad and adapted for digging. The family includes the scarab, species Scarabaeus sacer, considered sacred in ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scarabaeidae"@en .

aat:300310681 a skos:Concept ;
    skos:definition "Genus containing several species of Old World dung beetle, including the scarab, species Scarabaeus sacer, considered sacred in ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scarabaeus"@en .

aat:300310682 a skos:Concept ;
    skos:definition "Members of a species of dung beetle that lays its eggs in dung balls fashioned through rolling. Formerly called Ateuchus sacer. This beetle considered sacred in ancient Egypt; it was associated with the divine manifestation of the early morning sun, Khepri, whose name was written with the scarab hieroglyph and who was believed to roll the disk of the morning sun over the eastern horizon at daybreak."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scarabaeus sacer"@en .

aat:300310683 a skos:Concept ;
    skos:definition "Genus that includes the death-watch beetle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xestobium"@en .

aat:300310684 a skos:Concept ;
    skos:definition "Members of a suborder containing around 11,000 species in over 2,000 genera and 8 superfamilies of insects in which the femur region of the upper hindlegs is greatly enlarged and contains large muscles that make the legs well adapted for leaping, the male able to produce a buzzing sound either by rubbing its front wings together or by rubbing toothlike ridges on the hind femurs against a raised vein on each closed front wing, ranging in color from green to olive or brown, and found in lowland tropical forests, semiarid regions, and grasslands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caelifera"@en .

aat:300310685 a skos:Concept ;
    skos:definition "General term for several species of short-horned grasshoppers that become gregarious, migratory, and increase greatly in numbers under suitable conditions, forming destructive swarms that can travel great distances, rapidly damaging crops and stripping fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locusts"@en .

aat:300310686 a skos:Concept ;
    skos:definition "Members of a family containing around 10,000 species of grasshoppers, characterized by short, heavy antennae, a four-valved ovipositor for laying eggs, a three-segmented tarsi (distal segments of the leg), being herbivorous, and including some of the most destructive species of agricultural pests known, the plague, or migratory, locusts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acrididae"@en .

aat:300310687 a skos:Concept ;
    skos:definition "Genus containing the cigarette beetle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lasioderma"@en .

aat:300310688 a skos:Concept ;
    skos:definition "Genus containing the furniture beetle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anobium"@en .

aat:300310690 a skos:Concept ;
    skos:definition "Members of a species of extinct hominin presumed to have lived on the Indonesian island of Flores and maybe elsewhere from 94,000 until 18,000 years ago, well within the time range of modern humans. Skeletal remains of an adult female and other individuals were found at the Liang Bua cave on Flores in 2004 by a team of Australian and Indonesian anthropologists. The species was around one third the size of modern humans, made tools, hunted dwarf elephants and other animals, cooked food, and is thought to have descended from H. erectus, a much older and larger hominin that may also be the ancestor of modern humans; the small size of H. floresiensis was perhaps the result of island dwarfing. Given that no H. erectus remains have been found on Flores, an alternative theory is that the species arrived on the island already small, perhaps having descended much earlier from a common ancestor of H. erectus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Homo floresiensis"@en .

aat:300310691 a skos:Concept ;
    skos:definition "Family containing one living species, the koala, and up to 13 extinct species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phascolarctidae"@en .

aat:300310692 a skos:Concept ;
    skos:definition "Genus containing one living species, the koala, and two known extinct species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phascolarctos"@en .

aat:300310693 a skos:Concept ;
    skos:definition "Members of a species of small, stout, arboreal marsupial mammal of Australia that feeds on the leaves of certain eucalyptus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phascolarctos cinereus"@en .

aat:300310694 a skos:Concept ;
    skos:definition "Class containing around 1,800 species of terrestrial and freshwater worms possessing permanent sex organs, most being hermaphroditic, feeding on detritus and algae, aquatic members having gills, and having direct development, meaning the young resemble tiny adults."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oligochaeta"@en .

aat:300310695 a skos:Concept ;
    skos:definition "Order containing earthworms and their relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lumbriculida"@en .

aat:300310696 a skos:Concept ;
    skos:definition "Family containing earthworms and their relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lumbriculidae"@en .

aat:300310697 a skos:Concept ;
    skos:definition "Members of a genus of terrestrial worm with a body divided into ringlike segments; having some internal organs, including the excretory organs, duplicated in each segment; having a clitellum, a slightly bulged, discolored organ that produces a cocoon for enclosing the earthworm's eggs, located between segments 32 and 37; a body tapered at both ends, with the tail end the blunter of the two; and being unable to see or hear, but having sensitivity to both light and vibrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lumbricus"@en .

aat:300310699 a skos:Concept ;
    skos:definition "Class containing around 8,000 species of worms characterized by having a clitellum (collar) that forms a reproductive cocoon during part of their life cycle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clitellata"@en .

aat:300310700 a skos:Concept ;
    skos:definition "Outlaws who travel the seas in ships with the organized intention of attacking and robbing others. Pirates have been active throughout history but the term is used chiefly to describe those active between the 1500s and the 1800s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pirates"@en .

aat:300310701 a skos:Concept ;
    skos:definition "Sea adventurers of the Caribbean and Pacific around South America who attacked and robbed Spanish ships and settlements during the late 17th and early 18th centuries. The term is generally attributed to Alexander Exquemelin who published a work on these privateers, or pirates, in 1684."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buccaneers"@en .

aat:300310702 a skos:Concept ;
    skos:definition "Privateers, or pirates, active along the coast of the Barbary States. Saracen and Turkish corsairs were authorized to loot ships and settlements under Christian rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corsairs"@en .

aat:300310703 a skos:Concept ;
    skos:definition "Japanese gardens, traditionally associated with Zen Buddhist temples, that have no water. Sand and rocks are used to represent streams and waterfalls. Literally \"dry landscape\" or \"withered mountains and waters.\" This term is usually used to refer to gardens of the Muromachi (1392-1573), Momoyama (1373-1615) and Edo periods (1615-1868)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karesansui"@en .

aat:300310704 a skos:Concept ;
    skos:definition "Drawing or sketching from nature, this practice was useful in the development of \"yamato-e\" techniques through the realistic study of nature. The term is also used to refer to the drawings or sketches that result from the activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaseiga"@en .

aat:300310705 a skos:Concept ;
    skos:definition "Writing shelves, characteristic of Shoin style architecture, that projected out, sometimes from a bay window, onto the surrounding porch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tsuke-shoin"@en .

aat:300310706 a skos:Concept ;
    skos:definition "Japanese pottery of all types. The term is derived from the city of Seto, an important producer of utilitarian wares in the early modern period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setomono"@en .

aat:300310707 a skos:Concept ;
    skos:definition "Japanese painting technique, popular in the Heian (794-1185) and Kamakura (1185-1333) periods, where layers of opaque color are applied over an underdrawing. Ink lines are then carefully redrawn and facial features are added. This technique is associated with \"yamato-e\" and was the technique used in the creation of The Tale of Genji handscroll."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tsukuri-e"@en .

aat:300310708 a skos:Concept ;
    skos:definition "Members of one of the two subclasses of cartilaginous fishes (the other being the Elasmobranchii), containing only one living order, Chimaeriformes, but having an extensive fossil record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holocephali"@en .

aat:300310709 a skos:Concept ;
    skos:definition "Feudal estates or pieces of land which are held on the condition of service to a superior, under whose ownership the property remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiefs"@en .

aat:300310710 a skos:Concept ;
    skos:definition "Members of a class of around 23,000 species of ancient, relatively small, primarily marine crustaceans including barnacles, copepods, mystacocarids, tantulocarids, branchiurans, ostracods, and related groups, having five pairs of head appendages, a single median eye, and up to 11 trunk segments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maxillopoda"@en .

aat:300310711 a skos:Concept ;
    skos:definition "Order containing crayfish, crabs, lobsters, prawns, shrimp, and their relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Decapoda"@en .

aat:300310712 a skos:Concept ;
    skos:definition "Members of the class containing over 29,000 species of widely distributed marine, freshwater, and terrestrial invertebrates, including crabs, hermit crabs, krill, pill bugs, shrimp, and their relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malacostraca"@en .

aat:300310713 a skos:Concept ;
    skos:definition "Built-in staggered, asymmetrical shelves commonly found in shoin style decoration. This style first because popular at the end of the Muromachi period (1392-1573)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chigaidana"@en .

aat:300310714 a skos:Concept ;
    skos:definition "Artisan or merchant class of people that lived in urban areas and are associated with the production of much of the art, music, literature and drama in Japan during the Edo period (1615-1868). This class includes both wealthy financiers and wholesale merchants as well as low income artisans, peddlers, and day laborers. The term is often translated as \"townspeople\" or \"townsmen\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chōnin"@en .

aat:300310715 a skos:Concept ;
    skos:definition "A wealthy merchant class of people, particularly those living in Kyoto, who became major patrons of art in Japan during the Momoyama (1573-1615) and Edo (1615-1868) periods and thus influenced the production of painting styles from the 16th to 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "machishū"@en .

aat:300310716 a skos:Concept ;
    skos:definition "The clearest expression of apocalyptic thought in Japanese Buddhism, this third and final age of Buddhism was believed to have begun in 1052. During this end of the Buddhist Law, Buddhism is thought to degenerate to the point where the teaching still exists, but there is no true practice of it. This religious pessimism and preparation for the end times caused a flurry of art commissions during the late Heian period in areas such as sculpture, calligraphy, painting and temple building by wealthy aristocrats who hoped to gain salvation by honoring Amida Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mappō"@en .

aat:300310717 a skos:Concept ;
    skos:definition "An aesthetic ideal advocating for the appreciation of austerity, simplicity, and humility that has deeply influenced Japanese culture. This ideal finds surpassing beauty and deep significance in what is humble or commonplace and appears natural or artless. It expressed in the aesthetic of the tea ceremony, particularly in its ceramics. Its influence can also be seen in the practice of collecting older paintings and works of calligraphy and, more recently, in the rough and natural style of contemporary grass style ink painting. Wabi became a part of a poetic ideal only when it was absorbed into the concept of \"sabi\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wabi"@en .

aat:300310718 a skos:Concept ;
    skos:definition "Aesthetic and poetic ideal particularly important in the Japanese tea ceremony and haiku poetry which advocates taking pleasure and finding tranquility in the old, tarnished and imperfect for their own sake. It is sometimes used synonymously or in conjunction with the concept of \"wabi\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabi"@en .

aat:300310719 a skos:Concept ;
    skos:definition "Members of an infraorder containing around 400 species of decapod crustaceans including lobsters, crayfish, and their close relatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Astacidea"@en .

aat:300310720 a skos:Concept ;
    skos:definition "Variable color ranging from strong to vivid red or reddish orange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarlet"@en .

aat:300310721 a skos:Concept ;
    skos:definition "Variable color ranging from dark or deep red to deep purplish red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruby"@en .

aat:300310722 a skos:Concept ;
    skos:definition "Variable color term referring to any moderate to vivid red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blood red"@en .

aat:300310723 a skos:Concept ;
    skos:definition "Variable color term referring to any whitish or light gray color resembling an oyster shell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oyster white"@en .

aat:300310724 a skos:Concept ;
    skos:definition "Variable shades of light gray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pale drab gray"@en .

aat:300310748 a skos:Concept ;
    skos:definition "The worship of one god, particularly when it is recognized that other deities exist. In such a system, one god has a central and dominating position, although the principle of polytheism is not abandoned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monolatry"@en .

aat:300310749 a skos:Concept ;
    skos:definition "Literally \"gold brocaded\", these overglaze-enamelled wares, mainly bowls, were most likely produced in China in the 16th century chiefly for export to Japan although some may have also been manufactured in Japan during the 19th century. They became very popular in the West as well. The dominant color was usually red or white, with lesser amounts of red, yellow and green and they were embellished with gold, generally in a floral scroll pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinrande"@en .

aat:300310750 a skos:Concept ;
    skos:definition "Literally \"gold ground\" this type of lacquerware has a thickly applied gold ground and is polished to resemble an object made from gold. The term has also been used to refer to the gold background of paintings, particularly if they are made by applying gold foil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinji"@en .

aat:300310751 a skos:Concept ;
    skos:definition "Ornamental pieces made of metal or wood that were used in traditional Japanese architecture to cover the wooden pegs necessary to secure the crossing of the lintel and uprights. They were also used on doors to conceal the heads of large nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kugikakushi"@en .

aat:300310752 a skos:Concept ;
    skos:definition "Decorative motifs often found in Chinese and Japanese art which feature tendrils and spirals of climbing plants. They are seen on many objects including textiles, ceramics, metal work, lacquerware, and sculptural and architectural detailing. Literally \"Chinese grass motif\" this term is short for the longer \"karakusamon\" and is sometimes used interchangeably with \"karahanamon\", meaning \"Chinese floral motif\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karakusa"@en .

aat:300310756 a skos:Concept ;
    skos:definition "Sliding wooden shutters, translated roughly as \"rain panels\", that would slide in front of the doorways at night or during bad weather and were stored in special storage boxes attached to the wall of the building when not in use. They first appeared in the late 16th century and were found on a variety of buildings from temples to personal houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amado"@en .

aat:300310759 a skos:Concept ;
    skos:definition "Entrance halls or porches through which one enters a Japanese building and is greeted by the host, removes one's shoes, etc. Historically, this term referred only to alcoves found in Zen temple buildings, but now the term is used to refer to any entry alcove. These areas are often decorated with screen paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genkan"@en .

aat:300310761 a skos:Concept ;
    skos:definition "A period in Japanese culture lasting from 1688-1704 that marks the high point of Edo period culture. This period is known for its advanced art and literary production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Genroku"@en .

aat:300310764 a skos:Concept ;
    skos:definition "Flower vases that were intended to be hung during the celebration of the tea ceremony. They are generally flat on one side and can be made of basketwork or ceramic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanaike"@en .

aat:300310767 a skos:Concept ;
    skos:definition "A technique of lacquer decoration where patterns are cut into the lacquered surface, more lacquer is applied and gold foil or gold dust is placed in the incised areas, becoming cemented into the designs when the lacquer dries. This technique was introduced to Japan from China, where it was known as \"ts'ang-chin\", during the Muromachi period (1392-1573) and became particularly popular in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chinkin-bori"@en .

aat:300310768 a skos:Concept ;
    skos:definition "A technique of lacquer decoration employing gold and silver foil inlay where coats of lacquer are applied over the decoration and then polished to expose the design. It was sometimes used with \"maki-e\". This technique originated in China, where it was known as \"p'ing-t'o\", and came to Japan in the Nara period (710-794). Since the Heian period (794-1185), the term \"kanagai\" has also been used to refer to this technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heidatsu"@en .

aat:300310935 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of blue colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackish blue"@en .

aat:300310953 a skos:Concept ;
    skos:definition "Literally meaning \"narrow format\", this term refers to small format Japanese prints. The standard size was approximately 330 x 145 mm or 11.8 x 5.9 inches. This format was employed extensively for actor prints in the 18th century until it was replaced by the \"oban\", larger format prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosoban"@en .

aat:300310954 a skos:Concept ;
    skos:definition "Literally \"mirror lid\", these netsuke carvings contained a metal mirror, usually of copper, silver or an alloy of copper and gold, set on a bowl of ivory, wood or other material. They were devised after the prohibition against carrying swords in 1876 as an outlet for swordsmiths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kagamibuta"@en .

aat:300310955 a skos:Concept ;
    skos:definition "A Japanese term for Chinese style brocades where the ground is a twill weave and the design is a satin weave. These fabrics were often used for the most decorative and florid of the costumes for noh plays and so the term can also refer to the outer garment of the female costume in these plays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karaori"@en .

aat:300310956 a skos:Concept ;
    skos:definition "Beads with religious significance that were introduced to Japan from Korea. They are found in the prehistoric graves of ancient Japan and it is thought that they were worn on the body from the beginning of Japan's recorded history up until the Kofun period (300-710). These beads were carved from jadeite, agate, talc, glass or jasper usually into comma shapes and varied in size from a few millimeters to five centimeters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magatama"@en .

aat:300310957 a skos:Concept ;
    skos:definition "Type of Japanese lacquerware decoration, literally \"pear skin\", that may have originated in the Heian period (794-1185). This term refers to two different styles widely-used during the Kamakura period (1185-1333). In one, a fine metallic powder is applied to a lacquered surface and a transparent lacquer is applied on top. In the other, gold or silver flakes are scattered across a lacquered surface and then lacquer of the orange, \"nashiji urushi\" type is applied. This technique was often used to cover large, less important areas of lacquerware such as the bottoms of boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nashiji"@en .

aat:300310958 a skos:Concept ;
    skos:definition "A highly translucent or transparent lacquer that has an amber or orange tint. It was made by mixing ki urushi with gambodge or the sap of the Gardenia florida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nashiji urushi"@en .

aat:300310960 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of violet colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strong violet"@en .

aat:300311024 a skos:Concept ;
    skos:definition "Refers to a range of bluish and greenish colors resembling the turquoise mineral, typically a light to moderate greenish blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turquoise"@en .

aat:300311025 a skos:Concept ;
    skos:definition "Refers to various blue colors resembling those made with cerulean blue pigment, especially the color of a cloudless sky or a pure deep blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cerulean blue"@en .

aat:300311026 a skos:Concept ;
    skos:definition "Variable color in the range of strong greenish blues, resembling the color of a peacock's neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peacock blue"@en .

aat:300311027 a skos:Concept ;
    skos:definition "Variable color in the range of vivid or strong reddish or greenish blues, resembling pigment derived from the mineral cobalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt blue"@en .

aat:300311028 a skos:Concept ;
    skos:definition "Variable color in the range of vivid and bright cool blues, resembling pigment derived originally from the mineral lapis lazuli and named with reference to the foreign (\"overseas\") origin of this mineral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultramarine"@en .

aat:300311029 a skos:Concept ;
    skos:definition "Variable color in the range of brilliant greenish blues, resembling the color of the kingfisher bird."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kingfisher"@en .

aat:300311030 a skos:Concept ;
    skos:definition "Modifier describing a color of high intensity and high to medium value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bright"@en .

aat:300311031 a skos:Concept ;
    skos:definition "Modifier describing a color of high intensity and high to medium value, typically of a lower intensity than \"vivid.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brilliant"@en .

aat:300311032 a skos:Concept ;
    skos:definition "Modifier describing a color of high intensity and high to medium value, typically of a higher intensity than \"brilliant.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vivid"@en .

aat:300311033 a skos:Concept ;
    skos:definition "Modifier describing a saturated color of high intensity and medium to dark value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep"@en .

aat:300311034 a skos:Concept ;
    skos:definition "Modifier describing a saturated color of high intensity, and medium-light to medium-dark value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strong"@en .

aat:300311035 a skos:Concept ;
    skos:definition "Modifier describing a color of middle intensity and medium value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium"@en .

aat:300311036 a skos:Concept ;
    skos:definition "Modifier describing a color of middle intensity and medium value, often overlapping in meaning with the modifier \"medium.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moderate"@en .

aat:300311037 a skos:Concept ;
    skos:definition "Modifier describing a color of light intensity and light value; may be overlapping in meaning with the modifier \"pale.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light"@en .

aat:300311038 a skos:Concept ;
    skos:definition "Modifier describing a color of light intensity and light value; may be overlapping in meaning with the modifier \"light,\" although typically \"pale\" suggests less intensity than \"light.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pale"@en .

aat:300311039 a skos:Concept ;
    skos:definition "Modifier describing a color of moderate or light intensity and relatively light value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastel"@en .

aat:300311040 a skos:Concept ;
    skos:definition "Modifier describing a color of moderate to light intensity and dark value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark"@en .

aat:300311041 a skos:Concept ;
    skos:definition "Modifier describing a color of low intensity and medium-light to medium-dark value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dull"@en .

aat:300311042 a skos:Concept ;
    skos:definition "Modifier describing a color of any intensity or value, having overtones of green, blue, or violet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cool"@en .

aat:300311043 a skos:Concept ;
    skos:definition "Modifier describing a color of any intensity or value, having overtones of red, orange, or yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warm"@en .

aat:300311044 a skos:Concept ;
    skos:definition "Colors in a range of bright, deep geenish blues, resembling the color of the pigment of the same name that originally consisted chiefly of ferric ferrocyanide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prussian blue"@en .

aat:300311045 a skos:Concept ;
    skos:definition "Colors in a range of light greenish blue, bluish green, or light grayish blue or green colors, resembling the color of water in certain light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aqua"@en .

aat:300311046 a skos:Concept ;
    skos:definition "Colors in a range of deep greenish blues, resembling the pigment made from the minerals azurite or blue verditer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bremen blue"@en .

aat:300311047 a skos:Concept ;
    skos:definition "Literally \"Chinese floral motifs\" or \"Chinese flower designs\", this pattern characteristically merges intricate floral motifs into geometric, frequently circular or diamond-shaped, designs. It was introduced to China from Japan as early as the Nara period (710-794) and is sometimes used interchangeably with \"karakusa\", meaning \"Chinese grass motif\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karahanamon"@en .

aat:300311048 a skos:Concept ;
    skos:definition "Colors in a range of clear light blues, usually with little or no yellow overtone; so-named because it is often the color of clothes used for male infants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby blue"@en .

aat:300311049 a skos:Concept ;
    skos:definition "Colors in a range of greenish to purplish blues, resembling the color of the mineral azurite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azurite blue"@en .

aat:300311050 a skos:Concept ;
    skos:definition "Colors in a range of a greenish blue, used in photography and color printing; it is one of the primary subtractive colors. The name is ultimately based on cyanine, which it resembles in color, although it is distinguished by its status as a primary subtractive color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyan"@en .

aat:300311051 a skos:Concept ;
    skos:definition "Colors in a range of a bluish grayish green, resembling the color of certain patches feathers of the teal (a river duck)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teal"@en .

aat:300311052 a skos:Concept ;
    skos:definition "Range of deep greenish blue colors resembling the pigment phthalocyanine blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thalo blue"@en .

aat:300311053 a skos:Concept ;
    skos:definition "Arches characteristic of Renaissance and later classicizing styles, consisting of a large central opening under a semicircular arch flanked by two smaller rectangular openings. Illustrated in Serlio's 'Architettura' (1537), and considered a characteristic element of Palladian architecture. Named for Veneto architect Andrea Palladio, or in reference to Sebastiano Serlio, who wrote an architectural treatise describing similar arches of ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serliana"@en .

aat:300311054 a skos:Concept ;
    skos:definition "Small boxes which contained the powdered tea used in the tea ceremony. These containers were made from a variety of materials including wood, dry lacquer, ceramic, metal, and black quartz. They were decorated in a variety of ways and were only used during the summer months."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natsume"@en .

aat:300311055 a skos:Concept ;
    skos:definition "Small sliding beads that were used to suspend the inro, tobacco pouches and money purses from the wearer's belt. These beads were made out of a variety of materials such as glass, bone, wood, lacquer, jade and ivory. They sometimes featured intricate carved designs or were carved into the shape of animals or human figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ojime"@en .

aat:300311057 a skos:Concept ;
    skos:definition "Literally \"hanging objects\", these containers were used in conjunction with \"netsuke\" to suspend personal items such as tobacco, pipes, brushes and money from the waist sashes, or \"obi\", of Japanese men. The most common sagemono were boxes made of lacquer, called \"inrō\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sagemono"@en .

aat:300311058 a skos:Concept ;
    skos:definition "Literally \"seal caddy,\" these lacquerware containers were carried on the hip, suspended from the \"obi\" with a silk cord attached to a \"netsuke.\" During the Momoyama period (1573-1615) they were used to contain seals, but they did not become popular until the Edo period (1615-1868), when they were used instead as medicine boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inrō"@en .

aat:300311059 a skos:Concept ;
    skos:definition "Range of pure bright blues or purplish blues resembling the color of the sapphire gem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sapphire"@en .

aat:300311060 a skos:Concept ;
    skos:definition "Range of vivid deep purplish blues, so-named because the color is sometimes associated with clothing of kings, or resembling the color of ultramarine blue, which was also called \"royal blue.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal blue"@en .

aat:300311061 a skos:Concept ;
    skos:definition "Range of bright blues or violets, resembling the colors of blue and violet varieties of methyl dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl blue"@en .

aat:300311062 a skos:Concept ;
    skos:definition "Range of light, strong shades of blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copen blue"@en .

aat:300311063 a skos:Concept ;
    skos:definition "Range of strong blue colors, resembling the color of artificial ultramarine blue pigment, also known as \"French ultramarine.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French ultramarine"@en .

aat:300311064 a skos:Concept ;
    skos:definition "Range of blue or greenish colors resembling the color of the lapis lazuli gem, which is a semiprecious stone that is usually rich blue in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapis lazuli"@en .

aat:300311065 a skos:Concept ;
    skos:definition "Various colors ranging from pale or grayish blue to a deep blue, named for the color of powdered smalt that was formerly used in washing clothes as a bluing agent and in coloring porcelain; the smalt powder is deep blue, and the smalt diluted in water is a pale blue color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powder blue"@en .

aat:300311066 a skos:Concept ;
    skos:definition "Range of deep reddish blue colors resembling the color of indigo colorant, which is a vat dye obtained from indigo plants or artificially created."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigo"@en .

aat:300311067 a skos:Concept ;
    skos:definition "Range of deep grayish blues, originally named for the color of the British naval uniform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navy blue"@en .

aat:300311068 a skos:Concept ;
    skos:definition "Range of deep blue colors resembling the color of smalt, which is a deep blue paint and ceramic pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smalt"@en .

aat:300311069 a skos:Concept ;
    skos:definition "A range of blue colors resembling the clear medium blues used in ceramics, named after the distinctive blue glazing used as backgrounds and other details in works by the studio of Renaissance ceramicist, Luca della Robbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "della Robbia blue"@en .

aat:300311070 a skos:Concept ;
    skos:definition "A range of clear blue colors, resembling the blue in the coat of arms of the British royal Windsor family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Windsor blue"@en .

aat:300311071 a skos:Concept ;
    skos:definition "A range of medium blue colors resembling the color of glazed earthenware originally made in Delft, the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Delft blue"@en .

aat:300311072 a skos:Concept ;
    skos:definition "A range of greenish blue or green colors resembling verditer pigment, which is prepared by adding chalk or whiting to a solution of nitrate of copper, often used in making crayons and water colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verditer"@en .

aat:300311073 a skos:Concept ;
    skos:definition "A range of blue colors resembling the color of Berlin blue pigment, which is any of several deep blue pigments consisting chiefly of ferric ferrocyanide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berlin blue"@en .

aat:300311074 a skos:Concept ;
    skos:definition "A range of blue colors resembling the color of Antwerp blue pigment, which is any of several deep blue pigments consisting chiefly of ferric ferrocyanide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antwerp blue"@en .

aat:300311075 a skos:Concept ;
    skos:definition "A range of green or blue colors resembling Monastral green or blue pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monastral"@en .

aat:300311076 a skos:Concept ;
    skos:definition "A range of medium to dark bluish gray, greenish gray, and purplish gray colors resembling the color of slate, a metamorphic rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slate"@en .

aat:300311077 a skos:Concept ;
    skos:definition "Various colors ranging from a yellowish white to a slightly bluish medium gray, resembling the lustrous color of a pearl, which is an animal material that forms in the shells of certain mollusks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearl"@en .

aat:300311078 a skos:Concept ;
    skos:definition "A range of colors resembling variations of blue pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable blue colors"@en .

aat:300311079 a skos:Concept ;
    skos:definition "A range of colors resembling variations of brown pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable brown colors"@en .

aat:300311080 a skos:Concept ;
    skos:definition "A range of colors resembling variations of green pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable green colors"@en .

aat:300311081 a skos:Concept ;
    skos:definition "A range of colors resembling variations of olive pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable olive colors"@en .

aat:300311082 a skos:Concept ;
    skos:definition "A range of colors resembling variations of orange pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable orange colors"@en .

aat:300311083 a skos:Concept ;
    skos:definition "A range of colors resembling variations of pink pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable pink colors"@en .

aat:300311084 a skos:Concept ;
    skos:definition "A range of colors resembling variations of purple pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable purple colors"@en .

aat:300311085 a skos:Concept ;
    skos:definition "A range of colors resembling variations of red pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable red colors"@en .

aat:300311086 a skos:Concept ;
    skos:definition "A range of colors resembling variations of yellow pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable yellow colors"@en .

aat:300311087 a skos:Concept ;
    skos:definition "A range of colors resembling variations of yellow and green pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable yellow green colors"@en .

aat:300311088 a skos:Concept ;
    skos:definition "Includes colors based on neutral colors, but often having traces of hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable neutral colors"@en .

aat:300311090 a skos:Concept ;
    skos:definition "Standard comprising descriptions and names of 267 color blocks devised by the Inter-Society Color Council (ISCC) and the the United States Department of Commerce's National Bureau of Standards (NBS) (now called the National Institute of Standards and Technology)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Universal Color Language"@en .

aat:300311092 a skos:Concept ;
    skos:definition "Class containing hydras and hydra-like aquatic animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydrozoa"@en .

aat:300311093 a skos:Concept ;
    skos:definition "Class containing around 200 species of cup animals, including some jellyfish. Life histories commonly involve alternation of a very small polyp with a medusa that develops from an ephyra released by the polyp. They are divided by four longitudinal septa producing tetramerous radial symmetry; gonads are endodermal. They have marginal sensory structures (rhopalia) with statocysts and/or ocelli. They are most abundant in coastal waters, but oceanic species exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scyphozoa"@en .

aat:300311094 a skos:Concept ;
    skos:definition "Members of a class containing one order (Cubomedusae) of sea wasps and box jellyfish, box-like tropical medusae that swim strongly, have single or grouped tentacles arising above the four corners, and somtimes are fiercely stinging, causing human fatalities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cubozoa"@en .

aat:300311095 a skos:Concept ;
    skos:definition "Members of an order containing marine invertebrates that are bell-shaped with gonads on the stomach or sides of manubrium, sensory structures consisting of pigmented eyespots (ocelli), a skeleton, if present, that lacks a cup (hydrotheca) into which the polyp may withdraw. A few species have a calcareous exoskeleton. They are most abundant in bays and shallow coastal waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anthomedusae"@en .

aat:300311096 a skos:Concept ;
    skos:definition "Family containing the hydras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydridae"@en .

aat:300311097 a skos:Concept ;
    skos:definition "Members of a class of marine invertebrates including sea lilies and feather stars; some have a stalk securing them to the ocean bed, while others move from place to place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crinoidea"@en .

aat:300311098 a skos:Concept ;
    skos:definition "Family with one living member, the hoopoe of Eurasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upupidae"@en .

aat:300311099 a skos:Concept ;
    skos:definition "Genus with one living member, the hoopoe of Eurasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Upupa"@en .

aat:300311100 a skos:Concept ;
    skos:definition "Genus containing four living species of Eurasian grouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tetrao"@en .

aat:300311102 a skos:Concept ;
    skos:definition "Refers to a range of bluish gray colors resembling the color of pewter, an alloy of tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pewter"@en .

aat:300311103 a skos:Concept ;
    skos:definition "Refers to a range of bluish colors resembling the color of the metal alloy, steel, particularly the bluish colors taken on by steel while being tempered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel blue"@en .

aat:300311105 a skos:Concept ;
    skos:definition "Refers to a range of gray colors resembling the color of the mineral, graphite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphite"@en .

aat:300311106 a skos:Concept ;
    skos:definition "Refers to a range of yellow colors resembling the color of a yellow dye using aniline, a coal-tar derivative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aniline yellow"@en .

aat:300311107 a skos:Concept ;
    skos:definition "Refers to a range of dark bluish or purplish gray colors resembling the color of a dye made from aniline, a coal-tar derivative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aniline"@en .

aat:300311108 a skos:Concept ;
    skos:definition "Refers to a range of reddish to bluish grayish or blackish colors resembling the color of charcoal, which is graphitic carbon created from plant material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal"@en .

aat:300311109 a skos:Concept ;
    skos:definition "Refers to a range of dark grayish blue colors resembling the color of blue ink used for writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink blue"@en .

aat:300311110 a skos:Concept ;
    skos:definition "Refers to a range of dark gray or blackish colors resembling the color of black ink, which is a liquid material used for writing, drawing, and printing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ink black"@en .

aat:300311111 a skos:Concept ;
    skos:definition "Refers to a range of intense bluish or purplish black colors resembling the saturated black color of midnight, believed to be the darkest hour of the night."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "midnight"@en .

aat:300311112 a skos:Concept ;
    skos:definition "The representation of persons, natural forms, or scenes in a way that highlights their best features, minimizes imperfect features, or alters features to conform with what is considered most perfect or most beautiful."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idealization"@en .

aat:300311113 a skos:Concept ;
    skos:definition "In philosophy, a theory that affirms that the basic substance of the world is matter and that the world is known primarily through material forms and processes. It is opposed to idealism, the theory holding that spiritual and ideal is of central importance in the interpretation of experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "materialism"@en .

aat:300311114 a skos:Concept ;
    skos:definition "In philosophy, a theory that holds that in human knowledge objects are grasped and seen as they really are in their existence outside and independently of the mind. It is opposed to idealism, the theory holding that spiritual and ideal is of central importance in the interpretation of experience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "realism"@en .

aat:300311115 a skos:Concept ;
    skos:definition "A general term for a quality of art works in which the depiction is based on or seems to be based on the direct observation of the external world, particularly as such works are contrasted to works that are more stylized, abstract, or dependent on stereotypes. Although a work may be both naturalistic and realistic, naturalism is distinguished from realism because it does not tend to necessarily include or focus on the flaws and imperfections of the subject depicted; a work may be both naturalistic and somewhat idealized in the exclusion of major flaws and ugliness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naturalism"@en .

aat:300311116 a skos:Concept ;
    skos:definition "A range of blue colors resembling the color of blue pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue colors"@en .

aat:300311117 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of yellow pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow colors"@en .

aat:300311118 a skos:Concept ;
    skos:definition "A range of red colors resembling the color of red pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red colors"@en .

aat:300311119 a skos:Concept ;
    skos:definition "A range of green colors resembling the color of green pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green colors"@en .

aat:300311120 a skos:Concept ;
    skos:definition "A range of purple colors resembling the color of purple pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purple colors"@en .

aat:300311121 a skos:Concept ;
    skos:definition "A range of colors resembling the colors of yellow and green pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow green colors"@en .

aat:300311122 a skos:Concept ;
    skos:definition "A range of olive colors resembling the color of olive pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive colors"@en .

aat:300311123 a skos:Concept ;
    skos:definition "A range of brown colors resembling the color of brown pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brown colors"@en .

aat:300311124 a skos:Concept ;
    skos:definition "A range of orange colors resembling the color of orange pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange colors"@en .

aat:300311125 a skos:Concept ;
    skos:definition "A range of pink colors resembling the color of pink pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pink colors"@en .

aat:300311127 a skos:Concept ;
    skos:definition "A range of blackish blue to blackish red colors resembling the color of logwood colorant, a dye made from an American tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logwood"@en .

aat:300311128 a skos:Concept ;
    skos:definition "A range of blue colors resembling the color of French blue pigment, which is synthetic ultramarine blue, the name originating in the early 19th century when the pigment was first imported from France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French blue"@en .

aat:300311129 a skos:Concept ;
    skos:definition "A range of blue colors resembling the color of phenyl blue dye, a dark blue dye which is a phenylimide derivative of a quinone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phenyl blue"@en .

aat:300311130 a skos:Concept ;
    skos:definition "Dark blue dye that is a phenylimide derivative of a quinone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phenyl blue"@en .

aat:300311131 a skos:Concept ;
    skos:definition "A range of purplish or bluish colors resembling the color of flower of the lavender plant, which is a Mediterranean mint widely cultivated for its narrow aromatic leaves and spikes of flowers that are dried and used in sachets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavender"@en .

aat:300311132 a skos:Concept ;
    skos:definition "Genus containing around 30 species native to countries bordering the Mediterranean. Lavender species are common in herb gardens for their fragrant leaves and attractive flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lavandula"@en .

aat:300311133 a skos:Concept ;
    skos:definition "A range of blue colors resembling the color of artificial ultramarine blue pigment, also called \"permanent blue.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanent blue"@en .

aat:300311134 a skos:Concept ;
    skos:definition "A range of purplish blue colors resembling the color of the blooms of periwinkle plants, which are evergreen trailing subshrubs and herbaceous perennials with flattish flowers and glossy leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "periwinkle"@en .

aat:300311135 a skos:Concept ;
    skos:definition "Genus of flowering plants, including evergreen trailing subshrubs and herbaceous perennials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vinca"@en .

aat:300311136 a skos:Concept ;
    skos:definition "Genus of flowering plants containing between 525 to 600 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Viola"@en .

aat:300311137 a skos:Concept ;
    skos:definition "A range of purplish blue colors resembling the color of the blooms of cornflower plants or the blue colorant obtained from the petals of the cornflower plant, Centaurea cyanus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornflower"@en .

aat:300311138 a skos:Concept ;
    skos:definition "Species of hardy herbaceous, annual plant having flower heads with blue, pink, or white rays. It is native to the Mediterranean region and widely cultivated in North America. It is a common garden plant and also appears as a weed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Centaurea cyanus"@en .

aat:300311141 a skos:Concept ;
    skos:definition "Species of flowering plant, cultivated in Asia as a source for paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tetrapanax papyrifer"@en .

aat:300311142 a skos:Concept ;
    skos:definition "Species of small shrub native to the Himalayas and other mountainous areas of Asia. It has many slender branches from which fiber is obtained; it is used medicinally as treatment for diarrhea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wikstroemia canescens"@en .

aat:300311144 a skos:Concept ;
    skos:definition "Species of medium sized tree native to eastern Asia. It has red globular fruit and an inner bark that yields a fiber used in Japan and China for papermaking and in Polynesia for the manufacture of a coarse fabric called tapa cloth. It is a tough, fast-growing tree that tolerates city conditions; it is available in several varieties (cut-leaved, white-fruited, and variegated) used hardy ornamentals and in naturalized landscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Broussonetia papyrifera"@en .

aat:300311145 a skos:Concept ;
    skos:definition "Range of greenish gray or bluish gray colors, resembling the color of the ash-blue chemical product of copper and lime-water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyanine"@en .

aat:300311148 a skos:Concept ;
    skos:definition "An oily film of Prussian blue pigment formerly used in machine making; it was placed on machine fittings, then the parts were rubbed together; the removal of the pigment indicated the position of high spots or rubbing between the two surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineer's blue"@en .

aat:300311149 a skos:Concept ;
    skos:definition "A variety of Prussian blue that is often mixed with barium sulfate. Brunswick blue is not used in artist's paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brunswick blue"@en .

aat:300311150 a skos:Concept ;
    skos:definition "Term used to refer to some varieties of Prussian blue pigment having a metallic sheen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze blue"@en .

aat:300311152 a skos:Concept ;
    skos:definition "A high quality grade of ferric ferrocyanide that is usually blended with gypsum or barium sulfate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Milori blue"@en .

aat:300311153 a skos:Concept ;
    skos:definition "Term used to refer to any of several pigments producing special shades of blue, the pigments being composed of ultramarine, Prussian bue, or cobalt blue containing chromium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "new blue"@en .

aat:300311154 a skos:Concept ;
    skos:definition "A blue pigment composed of Prussian blue mixed with synthetic ultramarine blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oriental blue"@en .

aat:300311155 a skos:Concept ;
    skos:definition "A water soluble variety of Prussian blue; used in for printing lines on ruled paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soluble blue"@en .

aat:300311156 a skos:Concept ;
    skos:definition "A specific variety Prussian blue that is a high quality grade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steel blue"@en .

aat:300311157 a skos:Concept ;
    skos:definition "An inorganic blue pigment that is a complex ferric ferricyanide that is produced by reacting a ferrous salt with potassium ferricyanide, produced as an intermediate in the production of Prussian blue but not the same compound. Turnbull's blue is not used as a paint pigment, but in making blueprints. Blueprint paper is sensitized with ferric ammonium citrate and potassium ferricyanide. When the paper is exposed to light, the ferric ions are reduced to ferrous ions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turnbull's blue"@en .

aat:300311158 a skos:Concept ;
    skos:definition "Family containing 87 genera and nearly 1,700 species of flowering plants, which are annual and perennial herbs and, rarely, shrubs, native primarily to northern temperate areas of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gentianaceae"@en .

aat:300311159 a skos:Concept ;
    skos:definition "Range of blue colors resembling the color of the blooms of the gentian plants, specifically the numerous herbs of the Gentianaceae family having smooth leaves and showy usually blue flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentian"@en .

aat:300311160 a skos:Concept ;
    skos:definition "A range of purplish red colors resembling the color of magenta or fuchsine dye, which is a snynthetic aniline dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magenta"@en .

aat:300311161 a skos:Concept ;
    skos:definition "A range of purplish blue colors resembling the color of the aromatic blooms of the lilac plant, a European shrub that is also cultivated in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lilac"@en .

aat:300311162 a skos:Concept ;
    skos:definition "A European shrub of the olive family, now also growing in North America, having cordate ovate leaves and large panicles of fragrant pinkish, bluish purple, or white flowers. Syringa vulgaris (lilac or common lilac) is a species of flowering plant in the olive family Oleaceae, native to the Balkan Peninsula, where it grows on rocky hill"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syringa vulgaris"@en .

aat:300311163 a skos:Concept ;
    skos:definition "A colorless, crystalline compound derived from the fractional distillation of coal tar and composed of three attached aromatic rings. It is used to make synthetic alizarin pigment, and to manufacture other organic dyes, resins, plasticizers, and tanning agents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthracene"@en .

aat:300311164 a skos:Concept ;
    skos:definition "A range of purplish blue colors resembling the colors of colorants produced with anthracene, a chemical compound derived from coal tar and used to make synthetic alizarin pigment and other dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthracene"@en .

aat:300311165 a skos:Concept ;
    skos:definition "A range of bluish or reddish purple colors resembling the color of skin of the ripe fruit of the plum tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plum"@en .

aat:300311166 a skos:Concept ;
    skos:definition "A range of purplish blue colors resembling the color of the fluorochrome, diaminophenyl oxydiazole, used to stain specimens and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diamin azo blue"@en .

aat:300311167 a skos:Concept ;
    skos:definition "A bluish fluorochrome used to stain specimens and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaminophenyl oxydiazole"@en .

aat:300311168 a skos:Concept ;
    skos:definition "A dark grayish blue or gray pigment mixture generally composed of ivory black with small amounts of white and blue, namely synthetic ultramarine blue, Prussian blue, or phthalocyanine blue. The pigment is used for watercolors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Payne's gray"@en .

aat:300311169 a skos:Concept ;
    skos:definition "General term for 90 or more species of small to medium sized brightly colored birds in the order Coraciiformes, all having large heads, long, sharp, pointed bills, short legs, and stubby tails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kingfishers"@en .

aat:300311170 a skos:Concept ;
    skos:definition "Species of flowering tree native to southern Mexico and northern Central America. The leaves and bark are used in various medical applications. It was long a natural source of reddish and bluish dye, still an important source of haematoxylin used in histology for staining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haematoxylum campechianum"@en .

aat:300311171 a skos:Concept ;
    skos:definition "When used with a color term, refers to a lustrous appearance, resembling the sheen of a metal surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metallic"@en .

aat:300311172 a skos:Concept ;
    skos:definition "A range of dark reddish colors resembling the colors of the garnet mineral, particularly the gem-quality stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garnet"@en .

aat:300311173 a skos:Concept ;
    skos:definition "A range of dark reddish or purplish brown colors resembling the color of dyes or colorants made from chestnut bark, derived from trees or shrubs of the genus Castanea of the beech family; from the Italian word for chestnut, \"marrone.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maroon"@en .

aat:300311174 a skos:Concept ;
    skos:definition "A range of purplish colors resembling the color of the synthetic iron oxide pigment known as \"Mars violet.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars violet"@en .

aat:300311175 a skos:Concept ;
    skos:definition "Synthetically prepared red iron oxide pigment. It is a permanent pigment, having good tinting strength and good oil-drying properties, and ranging in color from scarlet to maroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars red"@en .

aat:300311178 a skos:Concept ;
    skos:definition "A mineral composed of lead tetroxide that has the same composition as red lead, an orange-red pigment used since ancient times. Minium deposits have been found in Egypt, however, most sources indicate that Egyptian red lead pigment was manufactured from lead metal and litharge rather than ground from minium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minium"@en .

aat:300311179 a skos:Concept ;
    skos:definition "A range of dark yellow colors resembling the color of the synthetic iron oxide pigment known as \"Mars yellow.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars yellow"@en .

aat:300311180 a skos:Concept ;
    skos:definition "A range of blackish colors resembling the color of the pigment known as \"Mars black.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars black"@en .

aat:300311181 a skos:Concept ;
    skos:definition "A range of red colors resembling the color of the synthetic iron oxide pigment known as \"Mars red.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars red"@en .

aat:300311182 a skos:Concept ;
    skos:definition "A range of orange colors resembling the color of the synthetic iron oxide pigment known as \"Mars orange.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars orange"@en .

aat:300311183 a skos:Concept ;
    skos:definition "A range of brownish colors resembling the color of the synthetic iron oxide pigment known as \"Mars brown.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mars brown"@en .

aat:300311184 a skos:Concept ;
    skos:definition "A range of reddish brown colors resembling the color of the pigment of the same name, which is prepared by calcining ferrous sulfate with lime or calcium carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian red"@en .

aat:300311185 a skos:Concept ;
    skos:definition "A range of reddish brown colors resembling the color of the pigment, iron oxide red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red oxide"@en .

aat:300311186 a skos:Concept ;
    skos:definition "A range of reddish or orange brown colors resembling the color of the clay product, terracotta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terracotta"@en .

aat:300311187 a skos:Concept ;
    skos:definition "Modifier describing a color that is not saturated and of low intensity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weak"@en .

aat:300311188 a skos:Concept ;
    skos:definition "Specular iron ore, that is ore having a luster that indicates its metallic nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron glance"@en .

aat:300311190 a skos:Concept ;
    skos:definition "A range of reddish or orange colors resembling the color of the metallic element, copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper"@en .

aat:300311191 a skos:Concept ;
    skos:definition "A range of yellowish colors, typically with undertones of red or brown, resembling the color of the lustrous metal, gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold"@en .

aat:300311192 a skos:Concept ;
    skos:definition "A paint containing red iron oxide and zinc chromate, having a brick red color and used as an exterior metal primer, particularly for metal roofs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red oxide"@en .

aat:300311193 a skos:Concept ;
    skos:definition "A range of reddish brown colors resembling the color of roofer's red paint, also called \"red oxide,\" used as a primer for exterior metal surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofer's red"@en .

aat:300311194 a skos:Concept ;
    skos:definition "A range of reddish brown colors resembling the color of Spanish red oxide pigment, which is an inexpensive colorant containing red iron oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish red"@en .

aat:300311195 a skos:Concept ;
    skos:definition "Fugitive brownish pigment, resembling natural Van Dyck brown, but synthetically made from from carbon black and iron oxide mixtures rather than derived from a natural bituminous source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic Van Dyck brown"@en .

aat:300311196 a skos:Concept ;
    skos:definition "A range of brownish colors resembling the color of natural or synthetic Vandyke brown pigment, also known as \"Cassel brown.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vandyke brown"@en .

aat:300311197 a skos:Concept ;
    skos:definition "A orange brown transparent pigment made from synthetic alizarin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubens brown"@en .

aat:300311198 a skos:Concept ;
    skos:definition "Species of Eurasian plant used to produce madder dyes and colorants from ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubia tinctorum"@en .

aat:300311200 a skos:Concept ;
    skos:definition "General term for any of several species of insect in several different genera, most native to Asia with one in Mexico, that produce scarlet resinous secretions used for resin and dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lac insects"@en .

aat:300311201 a skos:Concept ;
    skos:definition "A deep red lake color made from lac dye precipitated with precipitated with alumina trihydrate. Indian lake was once an important colorant used since ancient times. It has since been replaced by synthetic colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian lake"@en .

aat:300311202 a skos:Concept ;
    skos:definition "Resinous preparation of shellac and turpentine, or of beeswax and Venice turpentine with coloring matter, that is plastic when warm and used for sealing letters, attaching impressions of seals to documents, and sealing batteries and jars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealing wax"@en .

aat:300311203 a skos:Concept ;
    skos:definition "Refers to organic red lakes that are obtained from a scale insect, cochineal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cochineal carmine"@en .

aat:300311204 a skos:Concept ;
    skos:definition "Scale insect from which the crimson colorant cochineal is derived. It is a primarily sessile parasite native to tropical and subtropical South America and Mexico, preferring cacti from the genus Opuntia. It produces carminic acid, which deters predation. This substance is extracted from the bodies of dry females and eggs; the colorant was usually used as a red solution or precipitated to make carmine, an aluminum or aluminum-tin lake. Secretions of sticky, weblike strands of filamentous wax make the colonies' infestations on the cacti appear as furry white patches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dactylopius coccus"@en .

aat:300311205 a skos:Concept ;
    skos:definition "An unstandardized name for various red dye colorants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian madder"@en .

aat:300311206 a skos:Concept ;
    skos:definition "A natural orange-red dye extracted from the root of the of the munjeet plant, Rubia cordifolia, indigenous to the mountainous regions of Asia. Munjeet is a lightfast dye that was historically used for dying cotton in Asia. The principle colorant is munjistin, an anthraquinone, and it also contains smaller amounts of purpurin, pseudopurpurin, alizarin, and xanthopurpurin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "munjeet"@en .

aat:300311207 a skos:Concept ;
    skos:definition "An unstandardized hue name for either a madder obtained from the Near East or any synthetic colorant of the same hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkey red"@en .

aat:300311208 a skos:Concept ;
    skos:definition "A natural dark pink madder colorant extracted from madder roots with an acid, then the precipitate, primarily pseudopurpurin, is redissolved in alum then reprecipitated with calcium carbonate to produce a pink lake. It became popular as an artist pigment after the madder plant was imported to Holland in the 16th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose madder"@en .

aat:300311212 a skos:Concept ;
    skos:definition "In Medieval Spain, officials who were in charge of weights and measures, especially for comestibles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alamines"@en .

aat:300311214 a skos:Concept ;
    skos:definition "In Medieval Spain, individuals who were in charge of overseeing construction works, either as master builders or master masons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alarifes"@en .

aat:300311215 a skos:Concept ;
    skos:definition "Bags or containers used to carry portable bedding and other items when traveling, including mattresses, blankets, shoes, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almofrejs"@en .

aat:300311232 a skos:Concept ;
    skos:definition "Ceramic vessels of simple, rough construction, made by hand, and used as containers for liquids or solid food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cacharros"@en .

aat:300311235 a skos:Concept ;
    skos:definition "Structures, troughs, drinking fountains, or containers for clean water, particularly when intended to be consumed by animals or people in isolated places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bebederos"@en .

aat:300311237 a skos:Concept ;
    skos:definition "Villages or settlements in parts of colonial South America, established by Spanish colonists or missionaries to accommodate the indigenous population in a controlled environment where they could be converted to Christianity and assimilated into European culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian reductions"@en .

aat:300311245 a skos:Concept ;
    skos:definition "Land grants in colonial Latin America. These were given to subjects of the king to use territories for production and to regulate the rent of the territory’s inhabitants. This did not give the owner of the grant property rights to the land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercedes"@en .

aat:300311247 a skos:Concept ;
    skos:definition "Individuals who work on huacas (sacred sites), particularly those who clandestinely excavate for the purpose of obtaining marketable antiquities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huaqueros"@en .

aat:300311256 a skos:Concept ;
    skos:definition "Leather bags, used primarily in the Americas, to contain personal items; designed to be attached to a horse's saddle or to the frame of a bed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cujas"@en .

aat:300311268 a skos:Concept ;
    skos:definition "Type of tax used in Spanish colonial times. Each land owner or tenant had to pay an alcabala tax to the State to be able to carry out activities of buying and selling products in their respective establishments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcabalas"@en .

aat:300311271 a skos:Concept ;
    skos:definition "During the colonial period in Latin America, escribanos were public servants whose duty was confirming the validity of legal documents, such as deeds, fulfilling similar functions as contemporary notaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "escribanos"@en .

aat:300311272 a skos:Concept ;
    skos:definition "Certain types of rafts or floats. In the East Indies, formed of two or more boats fastened together. In Brazil and Peru, rafts consisting of four or five logs fastened together, and furnished with a seat and lateen sail. According to legend, the jangada was the Neolithic boat used by Ulysses' in \"The Odyssey.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jangadas"@en .

aat:300311286 a skos:Concept ;
    skos:definition "Refers to people in Spain and Latin America who work with sacred art and the carving of retables. Because of their drawing skills they were also known historically as “professors of architecture.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retablistas"@en .

aat:300311289 a skos:Concept ;
    skos:definition "Works in which paint is applied on a textile support with only a thin gesso preparation. The works were flexible, often rolled and transported as banners or for other purposes. Popular in Spain and its colonies. For similar works on textiles having a thin glue preparation, popular in northern Europe and Italy, prefer \"Tüchleins (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sargas"@en .

aat:300311291 a skos:Concept ;
    skos:definition "People in the workshop of a silversmith or goldsmith who create metal leaf by beating a piece of metal with special tools until the metal conforms to a very thin layer or leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal leaf beaters"@en .

aat:300311293 a skos:Concept ;
    skos:definition "Measures for land used in viceregal America, divided into four parts; corresponds to the modern \"manzana.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solares"@en .

aat:300311295 a skos:Concept ;
    skos:definition "In colonial Latin America, oidores were ministers of justice of the Real Audiencia of the Spanish court, who listened and passed judgment on civil cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oidores"@en .

aat:300311296 a skos:Concept ;
    skos:definition "Refers to religious groups in colonial Latin America that promoted Christian devotion through pious activities. They took charge of public and private activities for the benefit of the community such as paying for the mass, care of widows and orphans of deceased members, maintaining altars and images of patron saints, and processions and celebrations on holidays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cofradías"@en .

aat:300311297 a skos:Concept ;
    skos:definition "Artists in Nahua culture who made works with feathers by either cutting and gluing them into a mosaic or tying them by the calamus with maguey threads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amantecah"@en .

aat:300311298 a skos:Concept ;
    skos:definition "Painter-scribes who created codices in Aztec society. They were responsible for recording important historical events, religious knowledge, dynastic genealogies, and cultural landscapes. Codices were typically made using carbon and other pigments applied to gessoed amate paper, deer skin, woven cotton, or other materials. After the Spanish Conquest, the tlahcuilohqueh continued producing codices, but created a mixed system that combined glyphic writing, pictography, and the Latin alphabet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlahcuilohqueh"@en .

aat:300311299 a skos:Concept ;
    skos:definition "Individuals who allow their name to be used on behalf of others' affairs, similar to a proxy or guarantor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "testaferros"@en .

aat:300311300 a skos:Concept ;
    skos:definition "Magistrates in colonial Latin America with jurisdiction over certain territories. They had many administrative and governmental functions such as overseeing the initial trial in lawsuits, serving as the local people’s legal representatives in their business deals and contracts, and examination of the ordinances made by the cabildos (municipal councils)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corregidores"@en .

aat:300311305 a skos:Concept ;
    skos:definition "Motifs in the form of a snake, often stylized; seen in ceramics, textiles, and other works. For shapes that are sinuous but not necessarily resembling snakes, prefer \"serpentine (shape).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpentiforms"@en .

aat:300311310 a skos:Concept ;
    skos:definition "People in colonial Latin America who had the authority and power to replace another person in a given position, as a deputy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lugartenientes"@en .

aat:300311311 a skos:Concept ;
    skos:definition "In colonial Latin America, potters who specialized in the creation and/or sales of maiolica earthenware, especially dishware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loceros"@en .

aat:300311316 a skos:Concept ;
    skos:definition "Those who received encomienda grants from the Crown in colonial Latin America. An encomienda stated that the indigenous people must pay tribute in the form of commodities and service to the encomederos in return for protection and religious instruction. The Spanish were invested in this system during the period of the conquest since it permitted them to use large groups of Indians as forced labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encomenderos"@en .

aat:300311317 a skos:Concept ;
    skos:definition "Paths for herds and the passage of carts; associated with or adjacent to the course of a stream or river."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cañadas"@en .

aat:300311318 a skos:Concept ;
    skos:definition "A type of carpentry in old Spain. In contrast to 'carpentería de lo blanco,' carpentry classified as 'lo prieto' is typically not decorative. It may also constitute pieces that are heavier, rough-hewn, and irregularly shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpintería de lo prieto"@en .

aat:300311320 a skos:Concept ;
    skos:definition "Lacework carpentry associated with Mudéjar Spain and Portugal, and as such often called Mudéjar carpentry. Geometric and decorative, this type of structural woodwork is often seen in framing, paneling, and roofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpintería de lo blanco"@en .

aat:300311321 a skos:Concept ;
    skos:definition "Carpenters of old Spain who practiced rough woodwork without decoration or smooth finishes. The wood they worked with served as a base for the more refined and detailed work of the 'carpintero de lo blanco.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpinteros de lo prieto"@en .

aat:300311322 a skos:Concept ;
    skos:definition "Coachmen in colonial Latin America, usually depicted stereotypically as black men, usually slaves, who drove calesas, or carriages. Their extravagant uniforms and ornamentation were indications of their owners' wealth. In Cuba, caleseros are distinctive characters of the colonial period and are usually portrayed in images as garishly dressed dandies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caleseros"@en .

aat:300311325 a skos:Concept ;
    skos:definition "In Spanish colonial areas, taxes that were collected on products that were imported and exported through the ports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almojarifazgos"@en .

aat:300311326 a skos:Concept ;
    skos:definition "Domains of the admiral under the Real Hacienda, royal tax office, designated by the king of Spain. These domains contain their own jurisprudence and certain rights and responsibilities. Almirantazgos have the right to a significant percentage of the profits obtained from fleets that remain in the harbor. The profits from this percentage also included all activities relating to ships that arrived at the harbor including shipping cost rights, anchoring rights, entrance and exit fees, and loading and unloading fees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almirantazgos"@en .

aat:300311327 a skos:Concept ;
    skos:definition "Sculptors in colonial Latin America who created religious figures, usually representations of Christ, the Virgin, saints and angels for altars, processions, nativity, and passion scenes. Imagineros worked with a variety of materials including stone, bone, ceramic and shell, but primarily with polychromed wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imagineros"@en .

aat:300311330 a skos:Concept ;
    skos:definition "A complex gül in which a quartered diamond is nested either within a rectangle or stepped diamond, which in turn is nested within another diamond, which is nested within a rectangle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aina güls"@en .

aat:300311332 a skos:Concept ;
    skos:definition "A gül consisting of serrated or stepped diamonds, which may be concentric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ashik güls"@en .

aat:300311333 a skos:Concept ;
    skos:definition "A quartered gül which has both internal and external hooks; used in both Turkish and Turcoman weaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dyrnak güls"@en .

aat:300311336 a skos:Concept ;
    skos:definition "A pattern consisting of five elements arranged at each of the four corners of a square or rectangle, and one in the center. Often used in series as a motif in a border or field in textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quincunx"@en .

aat:300311338 a skos:Concept ;
    skos:definition "Anatolian rug motif said to represent the highly stylized mouth of a wolf, orignally an amulet of herdsmen for protection against wolves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wolf's mouth"@en .

aat:300311340 a skos:Concept ;
    skos:definition "A geometricized image of a woman with her hands on her torso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elibelinde"@en .

aat:300311341 a skos:Concept ;
    skos:definition "A diamond shaped figure with hooks projecting from the outermost diamond; a rectangular figure with lateral projecting hooks; or a triangular figure with a projecting hook serving as the tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scorpions"@en .

aat:300311342 a skos:Concept ;
    skos:definition "Genus of scale insect, including several species from which a red dye, kermes crimson colorant is obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kermes"@en .

aat:300311343 a skos:Concept ;
    skos:definition "Species of evergreen oak native to the eastern Mediterranean and southwest Asia. It was historically important as the food plant of the Kermes scale insect, from which a red dye called crimson was obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus coccifera"@en .

aat:300311344 a skos:Concept ;
    skos:definition "A wine-colored organic colorant from various sources; originally made with cochineal or brazilwood dye. In the 19th century, aniline dyes were used to make Vienna lake. None of the colorants are permanent and are usually restricted to interior house paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vienna lake"@en .

aat:300311345 a skos:Concept ;
    skos:definition "A range of purplish red colors resembling the color of crimson lake colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crimson"@en .

aat:300311346 a skos:Concept ;
    skos:definition "A range of strong purplish red colors resembling the color of carmine colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carmine"@en .

aat:300311347 a skos:Concept ;
    skos:definition "A range of pink and red colors resembling the color of alizarin colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alizarine"@en .

aat:300311348 a skos:Concept ;
    skos:definition "A range of purplish red or pink colors resembling the color of reddish lake pigments, which are organic pigments prepared by precipitation of a dye on a powdered, inorganic substrate. The color term \"lake\" refers particularly to the colors of cochineal, kermes, madder, lac, etc., which are all reddish in color and used in oil painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lake"@en .

aat:300311349 a skos:Concept ;
    skos:definition "Term used to describe pigments or dyes that fade or change color due to the action of light. It does not refer to color changes caused by chemical reactions with the atmosphere or surrounding materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fugitive"@en .

aat:300311351 a skos:Concept ;
    skos:definition "A range of brownish colors resembling the color of the mummy brown pigment, formerly produced by grinding Egyptian mummies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummy"@en .

aat:300311352 a skos:Concept ;
    skos:definition "A range of slightly greenish brown colors resembling the color of putty, which is a thick, pastey mixture of linseed oil and powdered calcium carbonate used to secure windows in their frame and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "putty"@en .

aat:300311353 a skos:Concept ;
    skos:definition "Meetings at which academic specialists deliver addresses on a topic or on related topics and then participate in a discussion on the topics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colloquiums"@en .

aat:300311354 a skos:Concept ;
    skos:definition "Refers to the styles of a disparate group of artists working around the coastal town of Saint Ives, Cornwall, England. Although there was a group of painters in St Ives active from the late 19th century, that group of artists was part of a landscape and plein-air tradition. Today, the term 'St Ives School' is most associated with the modernist school of painters active in Saint Ives from the mid-20th century. Notable artists in the St Ives School include Barbara Hepworth, Naum Gabo, Terry Frost, Peter Lanyon, Bryan Wynter, and Patrick Heron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "St Ives School"@en .

aat:300311355 a skos:Concept ;
    skos:definition "A range of brownish colors resembling the color of bronze metal, an alloy of copper and tin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze"@en .

aat:300311356 a skos:Concept ;
    skos:definition "General term for any of a large group of fossil resins occurring in deposits of brown lignite, peat, etc. These resins resemble succinite in appearance, but contain little or no succinic acid. Around 40 varieties of amber are recognized, divided into two main groups: those containing succinic acid make up the succinite group and those having little or no succinic acid belong to the retinite group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retinite"@en .

aat:300311357 a skos:Concept ;
    skos:definition "Fossil resin found in Romania. Similar to succinite, but it has been held to be of different botanical origin. Recent studies suggest that differences instead indicate that ruminite is a succinite that has suffered partial thermal degradation during the folding of the Oligocene Kliwa sandstone formation in which it is found."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rumanite"@en .

aat:300311358 a skos:Concept ;
    skos:definition "A hard translucent red, yellow, orange, or brownish-yellow fossil resin, found in Sicily. Used for making jewelry and other ornamental objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simetite"@en .

aat:300311359 a skos:Concept ;
    skos:definition "Variety of fossil resin found in deposits in Burma; usually red in color but may also be pale yellow, golden, or brown. It was used by the Chinese in the manufacture of art objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burmite"@en .

aat:300311360 a skos:Concept ;
    skos:definition "Variety of fossil resin, brown in color, having a high oxygen content. It is found in deposits in the Baltic and is characterized by being dense and polishing poorly. It had previously been classified as being mineralogically distinct from common Baltic succinite on the basis of physical properties such as density and chemical properties such as saponification number, although more recent testing has found this to be untrue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beckerite"@en .

aat:300311361 a skos:Concept ;
    skos:definition "A range of yellowish or brownish colors resembling the color of amber, which is a fossil resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amber"@en .

aat:300311363 a skos:Concept ;
    skos:definition "A broad range of brownish, yellowish, or reddish colors resembling the colors of pigments called \"earth color,\" which contain iron oxide and other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth"@en .

aat:300311364 a skos:Concept ;
    skos:definition "General term for several species in the genera Brassica and Sinapis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustard"@en .

aat:300311365 a skos:Concept ;
    skos:definition "Pungent yellow powder of the seeds of any of several common mustard plants, used as a condiment, dye, or in medicine as a stimulant and diuretic, an emetic, or a counterirritant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustard"@en .

aat:300311366 a skos:Concept ;
    skos:definition "A range of yellowish colors resembling the color mustard, which is a powder obtained from the seeds of a mustard plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustard"@en .

aat:300311368 a skos:Concept ;
    skos:definition "A range of grayish colors resembling the color of the lustrous metal, silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver"@en .

aat:300311369 a skos:Concept ;
    skos:definition "Species of small evergreen tree native to coastal areas of the eastern Mediterranean Basin, western Asia, northern Africa, and the northern Middle East. It has long been cultivated for its drupaceous fruit that is an important food and source of oil. The wood is resistant to decay; if the top dies back, a new trunk will often arise from the roots. The species may have arisen in northern tropical Africa, then spread to the Mediterranean Basin. It had been cultivated on Crete since 3,500 BCE; fossilized leaves of the genus date to 37,000 years before present. Sometimes divided into several subspecies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Olea europaea"@en .

aat:300311370 a skos:Concept ;
    skos:definition "Refers to a range of light green colors resembling the color of the peridot stone, which is a light green variety of olivine that is used as a gem stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peridot"@en .

aat:300311371 a skos:Concept ;
    skos:definition "The transparent, gem-quality variety of olivine, which is a magnesium iron silicate mineral characterized by an olive green color. Peridot was known in ancient Greece and in Egypt; many of the green stones known to be worn by Cleopatra were peridot. Peridot was called \"evening emerald\" because it appears to lose its yellowish cast at night. It has sometimes been misidentified as emerald and as green glass. The main old world source for peridot was the island of Zabargad on St. John's Island in the Red Sea. It is also found in Brazil, South Africa, Myanmar, Norway, British Columbia, and Arizona and Hawaii in the USA."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peridot"@en .

aat:300311372 a skos:Concept ;
    skos:definition "Refers to a range of greenish colors resembling the color of jade, which is a gemstone composed of nephrite or jadeite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jade"@en .

aat:300311373 a skos:Concept ;
    skos:definition "The grass green variety of jadeite obtained from Myanmar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ayah kyauk"@en .

aat:300311374 a skos:Concept ;
    skos:definition "Refers to a range of greenish colors resembling the color of ivy, which is a climbing or trailing evergreen plants with shiny dark green leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivy"@en .

aat:300311375 a skos:Concept ;
    skos:definition "Genus containing around 5 species of evergreen woody vines or shrubs in the ginseng family (Araliaceae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hedera"@en .

aat:300311376 a skos:Concept ;
    skos:definition "Refers to a range of yellowish green colors, the name coming from the common Irish name \"Kelly,\" referring to the association of Ireland with the color green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kelly green"@en .

aat:300311377 a skos:Concept ;
    skos:definition "Refers to a range of bright green colors resembling the color of Paris green, a very poisonous copper-based powder that is used as an insecticide and pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paris green"@en .

aat:300311379 a skos:Concept ;
    skos:definition "An early form of emerald green, which is copper acetoarsenite used as a pigment, but toxic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial green"@en .

aat:300311380 a skos:Concept ;
    skos:definition "A variety of emerald green (a toxic copper-based pigment), perhaps invented by Baron von Mitis in Vienna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mitis green"@en .

aat:300311381 a skos:Concept ;
    skos:definition "Pigment name for a variety of green pigments, originally referring to green created from a mixture of blue and yellow colors prepared by Paolo Veronese, a 16th century Venetian painter. It is also used for any pigment resembling that color, including green earth pigments, copper-based emerald green, viridian, and other pigments of similar color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Veronese green"@en .

aat:300311385 a skos:Concept ;
    skos:definition "Refers to a range of yellowish greens resembling the color of the lime, the fruit of a tropical citrus tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime"@en .

aat:300311386 a skos:Concept ;
    skos:definition "Refers to the styles of a disparate group of landscape painters active from the early 1880s in and around the town of Newlyn, in Cornwall. The artists in the group, such as Stanhope Forbes, Walter Langley, and Frank Bramleyl, were known to continue the French naturalist and English Pre-Raphaelite traditions in their work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Newlyn School"@en .

aat:300311387 a skos:Concept ;
    skos:definition "Variable color in the range of bright yellowish greens, resembling the color of Scheele's green pigment, a hydrated form of copper arsenite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scheele's green"@en .

aat:300311388 a skos:Concept ;
    skos:definition "Variable medium to dark green color resembling the color of the malachite mineral and gemstone, which is composed of basic copper carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malachite"@en .

aat:300311389 a skos:Concept ;
    skos:definition "A synthetic organic dye that is an aniline based dyestuff (a triphenylmethane salt) named for the mineral malachite because of its green color. It was first made by Dobner and Fisher in 1877. It is used for the direct dying of silk, wool, jute, and leather, to dye cotton after mordanting, in spot chemical tests for the detection of sulfurous acid and cerium, as an acid-base indicator, and to kill parasites, mold, and fungi in fish tanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "malachite green"@en .

aat:300311390 a skos:Concept ;
    skos:definition "A hydrous silicate of copper having a green or sky-blue, a shining luster, often opal-like in texture, and used as a gemstone. It has been gathered or mined as a semiprecious stone since 3000 BCE. The translucent to opaque stone is typically greenish or sky-blue in its natural state, but appears true green when ground into a fine powder, which is used as a pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrysocolla"@en .

aat:300311391 a skos:Concept ;
    skos:definition "Variable green color resembling the color of pigment ground from the chrysocolla mineral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrysocolla"@en .

aat:300311392 a skos:Concept ;
    skos:definition "A pale blue green pigment made from copper salts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper green"@en .

aat:300311393 a skos:Concept ;
    skos:definition "A pale blue green pigment made from copper salts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bremen green"@en .

aat:300311394 a skos:Concept ;
    skos:definition "Unstandardized term referring to several green pigments, including pigment created by adding yellow orpiment to smalt, pigment comprising synthetic copper carbonate, pigment comprising natural copper carbonate created by grinding the mineral malachite, green earth pigment, and viridian pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green bice"@en .

aat:300311395 a skos:Concept ;
    skos:definition "Unstandardized term referring to several green pigments, including malachite (natural copper carbonate), Bremen green (synthetic copper carbonate), and Scheele's green (copper arsenite), among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral green"@en .

aat:300311396 a skos:Concept ;
    skos:definition "An organic green colorant extracted from the crushed flowers of iris or lilies, producing a clear green color that was precipitated on alumina trihydrate and used in manuscript painting. It is no longer used. Iris green was replaced in the 17th century by sap green, which was made from unripe buckthorn berries. The color of the two materials were similar and the name, iris green, was sometimes used for the sap green extract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iris green"@en .

aat:300311397 a skos:Concept ;
    skos:definition "Genus containing around 100 species of shrubs and trees native to temperate areas in the Northern Hemisphere, having dark bark, often bearing spines, and dark green, oval leaves. The bark and berries of many yields a yellow or green dye; the small black fruits of some species are used as a purgative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhamnus"@en .

aat:300311398 a skos:Concept ;
    skos:definition "Species of small tree of the cashew family, having edible seeds; grown in dry lands in warm or temperate climates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pistacia vera"@en .

aat:300311399 a skos:Concept ;
    skos:definition "Refers to a range of light green colors resembling the color of the seed of the pistachio tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pistachio"@en .

aat:300311400 a skos:Concept ;
    skos:definition "Refers to a range of light gray green colors resembling the color celadon ceramic glaze, used on Asian stoneware since the third century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celadon"@en .

aat:300311401 a skos:Concept ;
    skos:definition "A soft, gray-green, iron silicate mineral that was first described in 1847 near Verona, Italy. It is a mica type mineral that has been found as a pigment in some Chinese and Indian paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celadonite"@en .

aat:300311402 a skos:Concept ;
    skos:definition "Mineral used to create chromium oxide pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eskolaite"@en .

aat:300311403 a skos:Concept ;
    skos:definition "An obsolete variety of hydrated chromic phosphate; it is the hemiheptahydrate form of chromic phosphate, comprising a powder having a bluish green color and used as a paint pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arnaudon's green"@en .

aat:300311404 a skos:Concept ;
    skos:definition "An early variety of chromium oxide green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dingler's green"@en .

aat:300311405 a skos:Concept ;
    skos:definition "An early variety of chromium oxide green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schnitzer's green"@en .

aat:300311406 a skos:Concept ;
    skos:definition "An industrial grade of chrome green that typically has an olive hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinnober green"@en .

aat:300311407 a skos:Concept ;
    skos:definition "A soft bluish variety of chrome green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrate green"@en .

aat:300311408 a skos:Concept ;
    skos:definition "An unstandardized term for various green pigments, most often corresponding to chrome green or green varieties of Bremen blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil green"@en .

aat:300311409 a skos:Concept ;
    skos:definition "A particular variety of chrome green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal green"@en .

aat:300311411 a skos:Concept ;
    skos:definition "An unstandardized term for various green pigments, including malachite green dye, pigment mixtures of lead chromate and Prussian blue, mixtures of zinc yellow and Prussian blue, of zinc chrome green and hydrated chrome oxide, of viridian and zinc yellow, and a ceramic color that is chemically the same as vernalis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Victoria green"@en .

aat:300311412 a skos:Concept ;
    skos:definition "Variable yellowish green colors resembling the color of chrome green pigment, which is a mixture of lead chromate and Prussian blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome green"@en .

aat:300311413 a skos:Concept ;
    skos:definition "Variable green colors resembling the color of viridian pigment, which is composed of hydrated chromium oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viridian"@en .

aat:300311414 a skos:Concept ;
    skos:definition "Variable yellowish green color resembling the color of cobalt green pigment, a composite green pigment composed of cobalt and zinc oxides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobalt green"@en .

aat:300311415 a skos:Concept ;
    skos:definition "Term used in a general sense to refer to various types of copper corrosion. Even though \"verdigris\" technically chemically refers only to basic copper acetate, the term is also used for natural green patinas composed of copper sulfate, copper chloride, or basic copper carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verdigris"@en .

aat:300311416 a skos:Concept ;
    skos:definition "Variable green color resembling the color of verdigris pigment, which is composed of basic copper acetate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verdigris"@en .

aat:300311417 a skos:Concept ;
    skos:definition "Refers to a range of dark green colors resembling the color of clothing worn by hunters in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunter green"@en .

aat:300311418 a skos:Concept ;
    skos:definition "Refers to a range of green colors resembling the green color used on some porcelain created during the Ming dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ming green"@en .

aat:300311419 a skos:Concept ;
    skos:definition "Refers to a range of green colors resembling the color of chromium oxide pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromium oxide"@en .

aat:300311420 a skos:Concept ;
    skos:definition "Genus containing around 25 species of fragrant herbs of the mint family (Lamiaceae), native to Eurasia, North America, southern Africa, and Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mentha"@en .

aat:300311421 a skos:Concept ;
    skos:definition "Refers to a range of cool green colors resembling either the dark green colors of the leaves of the aromatic mint plant or the light green colors of confections flavored with mint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mint green"@en .

aat:300311422 a skos:Concept ;
    skos:definition "Refers to a range of dark green colors resembling the green colors of the deep forest or, for the Scots, the green associated with the costume of Robin Hood in ballads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest green"@en .

aat:300311424 a skos:Concept ;
    skos:definition "Refers to a range of dark green colors resembling either the colors of the leaves of the hemlock plant, a poisonous herb of the carrot family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemlock green"@en .

aat:300311425 a skos:Concept ;
    skos:definition "A dull green mica mineral composed of hydrated potassium iron silicate, that -- unlike other micas -- usually occurs as pelletlike grains in marine environments and is sometimes called \"green sand.\" It is formed from the alteration of iron-bearing silicates by ocean water and organisms, is found along the Atlantic coast of the North and South America and on the ocean floors, and is sometimes used as a green earth pigment for paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glauconite"@en .

aat:300311426 a skos:Concept ;
    skos:definition "Refers to a range of green colors resembling the colors of green earth pigments, which comprise various minerals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green earth"@en .

aat:300311427 a skos:Concept ;
    skos:definition "Refers to a range of green colors resembling the color of Prussian green pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prussian green"@en .

aat:300311428 a skos:Concept ;
    skos:definition "A green pigment originally prepared by the nearly the same process as Prussian blue, but produced by omitting the hydrochloric acid step that converted the green to blue. Beginning in the mid-19th century, Prussian green sold commercially as a mixture of Prussian blue and a yellow pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prussian green"@en .

aat:300311429 a skos:Concept ;
    skos:definition "Variable dark or blackish color resembling the color of the hardwood, ebony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ebony"@en .

aat:300311431 a skos:Concept ;
    skos:definition "General term referring to various insects, spiders, and other arthropods, including but not restricted to \"true bugs,\" the Heteroptera order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bugs"@en .

aat:300311432 a skos:Concept ;
    skos:definition "Variable color term referring to a range of colors in the grayish or olive range, resembling the color of greige fabric, which is raw or unfinished textile prior to bleaching or dying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greige"@en .

aat:300311433 a skos:Concept ;
    skos:definition "Raw or unfinished textile prior to bleaching or dying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greige"@en .

aat:300311434 a skos:Concept ;
    skos:definition "General term referring to various green stones or minerals, particularly those used as gem stones, such as emerald, or those used as pigment, such as green earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prasine"@en .

aat:300311435 a skos:Concept ;
    skos:definition "Variable term referring to greenish colors resembling the colors of a prasine stone or pigment, or the color of the green stalks of leeks, which are culinary herbs allied to the onion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prasinous"@en .

aat:300311436 a skos:Concept ;
    skos:definition "Species of hardy biennial plant that is grown as a vegetable. The leek is an ancient crop and is native to eastern Mediterranean lands and the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Allium porrum"@en .

aat:300311437 a skos:Concept ;
    skos:definition "A clear, bright yellow variety of cadmium yellow pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aurora yellow"@en .

aat:300311438 a skos:Concept ;
    skos:definition "An unstandardized pigment name used for various yellow pigments, including but not limited to Naples yellow, a mixture of cadmium yellow with either lead white or zinc white, and a synthetic disazo dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brilliant yellow"@en .

aat:300311439 a skos:Concept ;
    skos:definition "Species of bulb-forming plant in the amaryllis family, widely cultivated for its trumpetlike flowers. Daffodils are native to northern Europe and are grown in temperate climates around the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Narcissus pseudonarcissus"@en .

aat:300311440 a skos:Concept ;
    skos:definition "An unstandardized name for the bright yellow dye extracted from daffodil flowers, especially the orange centers on the small white narcissus flowers, or for a light, bright yellow pigment made of cadmium sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daffodil"@en .

aat:300311441 a skos:Concept ;
    skos:definition "An orange pigment comprising a mixture of cadmium yellow and Venetian red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutral orange"@en .

aat:300311442 a skos:Concept ;
    skos:definition "The earliest form of cadmium yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium sulfide"@en .

aat:300311443 a skos:Concept ;
    skos:definition "Yellow pigments composed of lead stannate that were used in European painting from the beginning of the 14th century until the early years of the 18th century, when it was largely replaced by Naples yellow (lead antimonate yellow). Two distinct varieties are known, both made by heating together lead and tin oxides in a furnace, with one type having sand (silicon dioxide) introduced. Both pigments are stable, used as opacifiers, colorants in glass and ceramic glazes, and in all paint media. Lead-tin yellow was often used in mixtures with other pigments such as lead white, vermilion, azurite, verdigris, and indigo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead-tin yellow"@en .

aat:300311444 a skos:Concept ;
    skos:definition "Variable yellowish colors resembling the color of Naples yellow (antimony yellow) pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Naples yellow"@en .

aat:300311445 a skos:Concept ;
    skos:definition "Variable yellowish colors resembling the color of massicot, a pigment made of lead monoxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "massicot yellow"@en .

aat:300311446 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of cadmium red pigment, which is made of cadmium sulfoselenide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium red"@en .

aat:300311447 a skos:Concept ;
    skos:definition "Variable orange colors resembling the color of cadmium orange pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium orange"@en .

aat:300311448 a skos:Concept ;
    skos:definition "Variable yellowish colors resembling the color of cadmium yellow pigment, which is made of cadmium sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium yellow"@en .

aat:300311449 a skos:Concept ;
    skos:definition "Variable term referring to an imitation vermilion pigment composed of basic lead chromate, or a lake of synthetic red dye, such as eosin or scarlet dye, on a red base, such as red lead, orange mineral, or chrome red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American vermilion"@en .

aat:300311450 a skos:Concept ;
    skos:definition "An unstandardized name for many red pigments, included but not limited to Indian red, Persian Gulf oxide, light red, and a variety of chrome red colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian red"@en .

aat:300311451 a skos:Concept ;
    skos:definition "An unstandardized name for many red pigments, included but not limited to a variety of chrome reds, cinnabar, red mercuric sulfide, and vermilion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese red"@en .

aat:300311452 a skos:Concept ;
    skos:definition "A soft, dense, red, native ore composed of mercuric sulfide, found in deposits in veins near volcanic rocks or hot springs around the world. Cinnabar was mined in the Roman Empire for use as a pigment and for its mercury content; it has been the main source of mercury throughout the centuries. The toxic stone was also used for decoration and a talisman in Mayan tombs, as a colorant in Chinese carved lacquerware, in ink used by high officials in the Byzantine Empire, and other applications. Cinnabar is chemically identical to synthetic red mercuric sulfide, which is called vermilion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinnabar"@en .

aat:300311453 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of the mineral minium, which is composed of lead tetroxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minium"@en .

aat:300311456 a skos:Concept ;
    skos:definition "An unstandardized name that has been used for various pigments, including yellow ocher and king's yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese yellow"@en .

aat:300311458 a skos:Concept ;
    skos:definition "Synthetic arsenic disulfide first made in the 18th century as the counterpart to natural realgar. The synthetic variety was purer and less expensive, but is no longer used because of its toxicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arsenic orange"@en .

aat:300311459 a skos:Concept ;
    skos:definition "Variable reddish orange colors resembling the color of lead red pigment, lead tetroxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red lead"@en .

aat:300311460 a skos:Concept ;
    skos:definition "Variable purplish or reddish colors resembling the color of madder colorant, extracted from plant roots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madder"@en .

aat:300311461 a skos:Concept ;
    skos:definition "Variable orange colors resembling the color of sandarac resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandarac"@en .

aat:300311462 a skos:Concept ;
    skos:definition "Variable orange colors resembling the color of bricks, which are typically rectangular clay products used for building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brick red"@en .

aat:300311464 a skos:Concept ;
    skos:definition "Variable reddish orange colors resembling the color of Oriental lacquerware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacquer red"@en .

aat:300311465 a skos:Concept ;
    skos:definition "Variable reddish orange colors resembling the color of quinacridone red pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quinacridone red"@en .

aat:300311466 a skos:Concept ;
    skos:definition "Any non-urushi lacquer coating, first seen during the 18th century in Europe, when Oriental lacquerware became very popular and was often imitated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "European lacquer"@en .

aat:300311468 a skos:Concept ;
    skos:definition "Variable reddish orange colors resembling the color of various pigments called \"Pompeian red.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pompeian red"@en .

aat:300311469 a skos:Concept ;
    skos:definition "A dull reddish brown earth pigment known to have been used in inexpensive 18th-century paints, as well as in other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish earth"@en .

aat:300311470 a skos:Concept ;
    skos:definition "Variable reddish orange colors resembling the color of Spanish brown pigment, which is an earth pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish brown"@en .

aat:300311471 a skos:Concept ;
    skos:definition "Variable reddish orange colors resembling the color of Indian red pigment, which is a synthetically produced brick red color iron oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian red"@en .

aat:300311472 a skos:Concept ;
    skos:definition "A feebly basic compound (C5H4N4O2) allied to uric acid, found in various organs and secretions of the animal body and from plants, that forms a lemon-yellow compound with nitric acid. It is derived from guanine and hypoxanthine, and yields uric acid on oxidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xanthine"@en .

aat:300311473 a skos:Concept ;
    skos:definition "Variable orange colors resembling the color of xanthine, a secretion of various animal organs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xanthine"@en .

aat:300311474 a skos:Concept ;
    skos:definition "Any of a class of synthetic xanthene dyestuffs, chiefly reds, which are obtained by fusing an amino derivative of phenol with phthalic anhydride, used especially in coloring paper and as a biological stain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhodamine"@en .

aat:300311475 a skos:Concept ;
    skos:definition "Variable color name referring to bright bluish reds similar to those created by rhodamine dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhodamine"@en .

aat:300311476 a skos:Concept ;
    skos:definition "Genus containing around 105 species of flowering shrubs and trees, native to the tropical and subtropical regions of Central and South America and to New Zealand and Tahiti."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fuchsia"@en .

aat:300311477 a skos:Concept ;
    skos:definition "Variable color name referring to bright pinkish colors similar to those of blooms of the fuchsia plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuchsia"@en .

aat:300311478 a skos:Concept ;
    skos:definition "Family of flowering plants that are diverse and widespread, known for blooms that are often colorful and fragrant. Diverse and widespread family of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orchidaceae"@en .

aat:300311479 a skos:Concept ;
    skos:definition "Variable color name referring a wide range of pinkish purple colors similar to those of blooms of orchid plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orchid"@en .

aat:300311480 a skos:Concept ;
    skos:definition "Colors in a range of clear light pink, so-named because it is often the color of clothes used for female infants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby pink"@en .

aat:300311481 a skos:Concept ;
    skos:definition "Colors in a range of warm pinks, so-named because it resembles the colors of the skin of people indigenous to Western Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flesh pink"@en .

aat:300311483 a skos:Concept ;
    skos:definition "Species of small tree or large shrub that probably originated in the region around the Caucasus and the Caspian Sea. According to the earliest writings in which the plum is mentioned, the species is at least 2,000 years old. It has a fruit that is a fleshy drupe of variable size, usually having purple, red, or yellow skin with a dull powdery bloom when ripe, a sweet pulp, and a flattish pointed stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus domestica"@en .

aat:300311484 a skos:Concept ;
    skos:definition "A range of purplish colors resembling the color of the amethyst, a quartz mineral and gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amethyst"@en .

aat:300311485 a skos:Concept ;
    skos:definition "A range of purplish colors resembling the purple color of lithographic ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "litho purple"@en .

aat:300311486 a skos:Concept ;
    skos:definition "Variable purple color resembling manganese violet pigment, which is composed of a double salt of phosphoric acid with manganese and ammonium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese violet"@en .

aat:300311487 a skos:Concept ;
    skos:definition "A class of dark blue and black dyes made by the oxidation of aniline, used dying textiles, wood, leather, fur, inks, shoe polishes, and paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nigrosine"@en .

aat:300311488 a skos:Concept ;
    skos:definition "Variable blackish or dark purplish color resembling nigrosine, a dark dye made by the oxidation of aniline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nigrosin"@en .

aat:300311489 a skos:Concept ;
    skos:definition "A crystalline aromatic compound (C10H8) derived from coal tar, with a molecule consisting of two fused six-membered rings and a pungent mothball smell, used in dyes, synthetic resins, explosives, insecticide, fungicide, and moth repellent. It is not recommended for general use as an insecticide because it may recrystallize on specimens and can discolor wool in the presence of moisture, and its actual effectiveness against insects is questionable. It fluoresces purple in mercury light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naphthalene"@en .

aat:300311490 a skos:Concept ;
    skos:definition "Variable dark purplish color resembling dyes made with nigrosine, which is derived from coal tar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naphthalene violet"@en .

aat:300311491 a skos:Concept ;
    skos:definition "Perennial plant of the nightshade family (Solanaceae), grown for its edible fruits. Eggplant requires a warm climate and has been cultivated in its native Southeast Asia since remote antiquity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solanum melongena"@en .

aat:300311492 a skos:Concept ;
    skos:definition "Variable dark purplish color resembling the color of the fruit of the eggplant, a widely cultivated perennial herb of the nightshade family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggplant"@en .

aat:300311493 a skos:Concept ;
    skos:definition "Variable grayish color resembling the color of the stone, granite, which is a coarse-grained igneous rock often used in building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granite"@en .

aat:300311494 a skos:Concept ;
    skos:definition "Variable grayish color resembling the color of the sky and surroundings at dawn, the time when the day begins to grow light as the sun rises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dawn"@en .

aat:300311496 a skos:Concept ;
    skos:definition "A vegetable dye created from extract from the bark of chestnut trees, having a dark color that was used as a dye in 19th century Italy and southern France to make an inexpensive fast blackish dye for silk. Tannin of the chestnut bark produces a firm, heavy leather with a pale, reddish color. Chestnut extract is usually mixed with other tannins, such as quebracho, mimosa, or myrobalans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chestnut dye"@en .

aat:300311497 a skos:Concept ;
    skos:definition "Vessels, plates, and other typically utilitarian visual works that are coated or painted with enamel, which is a vitreous protective coating. For works that are set into a metalwork support and depict figures, scenes, or are otherwise primarily decorative rather than utilitarian, generally use \"enamels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enamelware"@en .

aat:300311498 a skos:Concept ;
    skos:definition "Visual works made of woven, coiled, inscribed, or carved bamboo, which is material derived from woody or treelike tropical and semitropical grasses of various genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bamboo work"@en .

aat:300311499 a skos:Concept ;
    skos:definition "Bamboo- or cane-colored porcelain biscuit, invented by Wedgwood. For objects made from woven or carved bamboo, use \"bamboo work (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bambooware"@en .

aat:300311500 a skos:Concept ;
    skos:definition "General term for any of around 480 species of woody or treelike tropical and semitropical grasses of various genera, including Bambusa, Phyllosyachys, Dendrocalamus, and allied genera, all having woody, hollow stems, stalked blades, and flowering only after years of growth. Bamboo has been used locally for constructing houses, rafts, poles, bridges, and scaffolding. In Europe and America, bamboo stems were popular for chairs, tables, cabinets, and other interior furniture during the 19th century. They are also split, flattened and woven into smaller items such as baskets, mats, hats, and fish traps. Bamboo has also become an important source of long, cellulose fibers for specialty papers. Additionally, a wax is extracted from the bamboo leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bamboo"@en .

aat:300311501 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of cochineal colorant, derived from scale insects of the New World."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cochineal"@en .

aat:300311502 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of kermes colorant, derived from female Kermes insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kermes"@en .

aat:300311503 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of geranium red pigment, a synthetic organic pigment made from the deposition of eosin on a alumina trihydrate base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geranium red"@en .

aat:300311504 a skos:Concept ;
    skos:definition "Variable red colors resembling the colors of red in the spectrum, which is the colored band into which a beam of light is decomposed by means of a prism or diffraction grating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectrum red"@en .

aat:300311505 a skos:Concept ;
    skos:definition "Variable red colors resembling the colors para red, a class of pigments created with paranitraniline, a coal tar derivative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "para red"@en .

aat:300311506 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of scarlet vermilion pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarlet vermilion"@en .

aat:300311507 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of scarlet lake pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarlet lake"@en .

aat:300311508 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of pigments called \"permanent red.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanent red"@en .

aat:300311509 a skos:Concept ;
    skos:definition "An unstandardized name referring to many pigments, including aniline red, Lithol red, and acid red."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanent red"@en .

aat:300311511 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of dragon's blood, a colorant derived from resinous material from the fruit of several types of palms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragon's blood"@en .

aat:300311513 a skos:Concept ;
    skos:definition "Variable red colors resembling the color of some cherries, fruit of numerous trees and shrubs of the genus Prunus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cerise"@en .

aat:300311514 a skos:Concept ;
    skos:definition "Genus of predatory sea snails of the Indo-Pacific region. The genus Murex was defined by Linnaeus to include many taxa that are now placed elsewhere in the superfamily Muricoidea, particularly those from which the red dye Tyrian purple was made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murex"@en .

aat:300311515 a skos:Concept ;
    skos:definition "Variable purple or reddish color resembling garments dyed with Tyrian purple dye, obtained from marine gastropods of the genus Murex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tyrian purple"@en .

aat:300311516 a skos:Concept ;
    skos:definition "Species of small, thorny tree or spreading bush producing an edible fruit; the acidic fruit that is botanically a many-seeded pale yellow oblong berry. Its young leaves have a decidedly reddish tint; later they turn green. In some varieties, the young branches of the lemon are angular; some have sharp thorns at the axils of the leaves. The large flowers have a sweet odor. Reddish-tinted in the bud, the petals are white above and reddish purple below."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus limon"@en .

aat:300311517 a skos:Concept ;
    skos:definition "A range of yellow or greenish yellow colors resembling the color of the fruit of the lemon tree or any of several pigments called \"lemon yellow.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon yellow"@en .

aat:300311518 a skos:Concept ;
    skos:definition "An unstandardized name referring to slightly greenish yellow pigments including but not confined to barium chromate, strontium chromate, zinc chromate, chrome yellow, and zinc yellow, or several organic yellow colorants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lemon yellow"@en .

aat:300311519 a skos:Concept ;
    skos:definition "An unstandardized name referring barium yellow, calcium chromate, and several other pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultramarine yellow"@en .

aat:300311520 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of barium yellow pigment, made from barium chromate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium yellow"@en .

aat:300311521 a skos:Concept ;
    skos:definition "Small song bird native to the Canary Islands, the Azores, and Madeira. Wild birds are yellow-green with brownish streaking on the back. The species in captivity exists in a several color varieties, most commonly yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serinus canaria"@en .

aat:300311522 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of the canary bird, a finch originally brought from the Canary Islands but now domesticated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canary yellow"@en .

aat:300311523 a skos:Concept ;
    skos:definition "A range of bright greenish yellow colors resembling the color of chartreuse, a distilled French liqueur flavored with herbs, named after the Grande Chartreuse monastery located in the Chartreuse Mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chartreuse"@en .

aat:300311524 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of the mineral, sulfur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfur yellow"@en .

aat:300311525 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of chrome yellow pigment, made from lead chromate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrome yellow"@en .

aat:300311526 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of Indian yellow pigment, originally made from the urine of cows fed exclusively on mango leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian yellow"@en .

aat:300311527 a skos:Concept ;
    skos:definition "A range of green colors resembling the color of cadmium green pigment, which is a mixture of cadmium yellow with chromium oxide (viridian), or a mixture of cadmium yellow and phthalocyanine green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cadmium green"@en .

aat:300311529 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of quercitron, a yellow vegetable dye extracted from the bark of the black oak tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quercitron"@en .

aat:300311530 a skos:Concept ;
    skos:definition "A range of brownish yellow colors resembling the color of asphaltum, an asphalt-based pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphaltum"@en .

aat:300311531 a skos:Concept ;
    skos:definition "A range of brownish yellow colors resembling the color of bitumen, the organic, or hydrocarbon, portion of asphalt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitumin"@en .

aat:300311532 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of aureolin pigment, made of potassium cobaltinitrite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aureolin"@en .

aat:300311533 a skos:Concept ;
    skos:definition "A variant of Turner's yellow that has a slightly different composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cassel yellow"@en .

aat:300311534 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of Turner's yellow pigment, which was made by mixing powdered lead chloride with lead carbonate, then fusing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turner's yellow"@en .

aat:300311535 a skos:Concept ;
    skos:definition "Genus containing 240 species of trees and shrubs found throughout the tropics, especially tropical areas of Africa, Asia, and Oceania (including Australia). Some species are characterized by having stiff leaves and small, thick-skinned, orange fruits with a juicy, acid, fragrant pulp. The resin is a source of dyes. The stems may be used as a source of fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Garcinia"@en .

aat:300311536 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of gamboge, a resin from an Asian tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gamboge"@en .

aat:300311537 a skos:Concept ;
    skos:definition "A range of greenish yellow colors resembling zinc yellow pigment, which is derived by reacting zinc oxide with potassium dichromate solutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc yellow"@en .

aat:300311538 a skos:Concept ;
    skos:definition "A range of whitish yellowish colors resembling the color of parchment, a material made from animal skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parchment"@en .

aat:300311539 a skos:Concept ;
    skos:definition "A range of whitish colors resembling the color of alabaster, a fine-grained marblelike variety of gypsum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alabaster"@en .

aat:300311540 a skos:Concept ;
    skos:definition "A range of yellow colors resembling the color of strontium yellow pigment, composed of strontium chromate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strontium yellow"@en .

aat:300311542 a skos:Concept ;
    skos:definition "Unstandardized term used for several pigments, including ultramarine ash, azurite pigment, and blue verditer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bleu cendres"@en .

aat:300311543 a skos:Concept ;
    skos:definition "The end-product of the refining process that is used to produce natural ultramarine blue pigment from lapis lazuli, ultramarine ash remaining after higher grades of ultramarine blue have been extracted. Ultramarine ash contains small blue particles mixed with a large proportion of colorless materials, such as calcite and silicates; it has been used for glazing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultramarine ash"@en .

aat:300311544 a skos:Concept ;
    skos:definition "Unstandardized name referring to various blue pigments, including azurite pigment and azurite substitutes, such as Bremen blue and blue verditer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain blue"@en .

aat:300311545 a skos:Concept ;
    skos:definition "A synthetically prepared azure blue pigment made from of copper hydroxide and copper carbonate, used as a substitute for natural azurite; it has particles that are more rounded and regular in size that natural azurite. Bremen blue was probably first made in the 18th century and was used in the 19th century for both distemper and oil based interior house paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bremen blue"@en .

aat:300311546 a skos:Concept ;
    skos:definition "A particular blue pigment that was distributed in drop form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neuwied blue"@en .

aat:300311547 a skos:Concept ;
    skos:definition "An unstandardized pigment name used for Bremen blue, azurite pigment, cupric sulfide, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper blue"@en .

aat:300311548 a skos:Concept ;
    skos:definition "Unstandardized name used for pigments that are blue with a greenish overtone, usually a composite pigment made from synthetic ultramarine blue and viridian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academy blue"@en .

aat:300311549 a skos:Concept ;
    skos:definition "Pigment name generally used for a mixture of ultramarine blue and zinc white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sky blue"@en .

aat:300311550 a skos:Concept ;
    skos:definition "Unstandardiized pigment name for several materials, including the synthetic copper carbonate (blue verditer), pigment produced from grinding the copper carbonate mineral azurite, smalt pigment, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blue bice"@en .

aat:300311551 a skos:Concept ;
    skos:definition "Master documents containing a standard or preset design, layout, format, and sometimes style, but lacking some or most content. Templates are intended to be used for creating content according to a prescribed and repeatable formula in electronic or paper media. Examples of the use of templates are to create form letters, pages in printed media, and HTML pages on a Web site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "templates"@en .

aat:300311552 a skos:Concept ;
    skos:definition "Vertical poles stayed by guys or guylines, which are attached ropes, chains, rods, or wires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guyed masts"@en .

aat:300311553 a skos:Concept ;
    skos:definition "Permanent pigment that, depending on conditions, can range in hue from orange to deep red. It is an unstable crystalline form and turns black when mixed with lead pigments. It is used in paint and to color ruby glass. It was invented and patented by Murdock in Scotland in 1847, it was replaced by cadmium red in the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antimony trisulfide"@en .

aat:300311554 a skos:Concept ;
    skos:definition "Nonstandardized name for a yellow earth pigment, typically having a warm yellow color, generally from a material produced in Italy and used in ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman ocher"@en .

aat:300311555 a skos:Concept ;
    skos:definition "General term referring to a modern blue pigment that is chemically similar to Egyptian blue, but tends to be purer and finer than the ancient pigment, or to commercial products containing a dye of the same hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pompeian blue"@en .

aat:300311556 a skos:Concept ;
    skos:definition "General term referring to a modern blue pigment that is chemically similar to Egyptian blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pozzuoli blue"@en .

aat:300311559 a skos:Concept ;
    skos:definition "Architectural order characterized by columns having spiraling shafts or spiraling lines incised in the shafts, designed to resemble the legendary columns of the lost Temple of Solomon in Jerusalem, which by tradition had spiraling columns. Although versions of this order were seen earlier, the elements of this order were described in detail by Jesuit theorists, particularly Juan Bautista Villalpando."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solomonic order"@en .

aat:300311560 a skos:Concept ;
    skos:definition "Order including the major lineages of polypod ferns, 80% of today's fern species found in most parts of the world including tropical, semitropical, and temperate areas. Characteristics include sporangia with a vertical annulus interrupted by the stalk and stomium; indusia laterally or centrally attached (or lost); gametophytes green, chordate, and surficial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polypodiales"@en .

aat:300311561 a skos:Concept ;
    skos:definition "Vases so-shaped specifically to hold flowers, ranging in size and shape for holding a large bouquet to a single stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower vases"@en .

aat:300311563 a skos:Concept ;
    skos:definition "Relatively small grease-burning pan lamps, often used in kitchens, in which animal fat was placed in a round or spade-shaped metal cup, and wicks made of cord or rags (called \"sluts,\" in reference to their being messy and dirty) were placed in one or two spouts at the side; the device was often attached to a large saucer to catch overflow or drippings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slut lamps"@en .

aat:300311564 a skos:Concept ;
    skos:definition "Small hanging lamps made of iron or earthenware having a handle at one end and a pinched spout for a wick at the other, utilizing a round bowl (called a \"cruse\") of about 3 inches in diameter to contain fuel, typically hard fat. The cruse lamp developed from the floating-wick pan lamps used by Mediterranean peoples in pre-Christian times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cruse lamps"@en .

aat:300311565 a skos:Concept ;
    skos:definition "Heads or highest parts of a mast of a ship, particularly the head of the lower mast used as a place for observation, or the highest part of the whole mast that is used as a place for flying a flag."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mastheads"@en .

aat:300311566 a skos:Concept ;
    skos:definition "Grouping consisting of placental mammals and all extinct mammals that are more closely related to living placentals than to living marsupials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eutheria"@en .

aat:300311567 a skos:Concept ;
    skos:definition "Shell white pigment derived from the shells of birds' eggs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggshell white"@en .

aat:300311568 a skos:Concept ;
    skos:definition "Species of shrub shrub that is an annual, biennial, or perennial, depending upon the climate. It was an original source of indigo dye. It is naturalized to tropical and temperate Asia and Africa, and cultivated elsewhere for centuries; its location of origin is uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indigofera tinctoria"@en .

aat:300311569 a skos:Concept ;
    skos:definition "Synthetic colorant made from anthranilic acid and chemically identical to natural indigo. Synthetic indigo was first produced in 1880 by Adolf von Baeyer. It has almost entirely replaced the natural dyestuff."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic indigo"@en .

aat:300311570 a skos:Concept ;
    skos:definition "Species of flowering plant native to the steppes and deserts of Central and Western Asia. It is the source of blue dye; it was cultivated in England, France, Greece, Italy, Egypt, and China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isatis tinctoria"@en .

aat:300311572 a skos:Concept ;
    skos:definition "A lake pigment colorant made from archil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French purple"@en .

aat:300311574 a skos:Concept ;
    skos:definition "Pigment created by a mixture of zinc yellow and Prussian blue. It is permanent to light but not to alkali or water. The term has also been used incorrectly to refer to cobalt green and zinc chrome green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc green"@en .

aat:300311575 a skos:Concept ;
    skos:definition "Refers to the clerical fanon garment as worn from the late twelfth century onward, when it was worn solely by the pope, as decreed by Pope Innocent III. The papal vestment was originally called an \"orale,\" but later became known as a \"fanon orale.\" The present collar-like form of the garment appeared in the sixteenth century or later."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal fanons"@en .

aat:300311576 a skos:Concept ;
    skos:definition "A serpentinite from the Italian Riviera having a red color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosso di Levanto"@en .

aat:300311577 a skos:Concept ;
    skos:definition "A serpentinite from the Italian Riviera having a green color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verde di Levanto"@en .

aat:300311578 a skos:Concept ;
    skos:definition "A synthetic, permanent, stable white pigment prepared from precipitated barium sulfate (barite) since ca.1820s. The pure white powder is transparent when used as a filler or base for lake pigments. The reproducible whiteness of high purity led to its use in the standard white tiles for reflectance spectrophotometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanc fixe"@en .

aat:300311580 a skos:Concept ;
    skos:definition "An unstandardized name for certain white pigments, referring often to blanc fixe, zinc white, or mixtures of barium sulfate with zinc white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanent white"@en .

aat:300311581 a skos:Concept ;
    skos:definition "A dense zinc oxide pigment first introduced in 1834 as a watercolor paint by Winsor and Newton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese white"@en .

aat:300311582 a skos:Concept ;
    skos:definition "A high quality zinc oxide pigment prepared by the French process, which is an indirect technique that vaporizes metallic zinc; the vapors react with air and precipitate as pure zinc oxide. Most commercial zinc oxide pigments are made by this method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French process zinc oxide"@en .

aat:300311583 a skos:Concept ;
    skos:definition "An infusible, insoluble white solid oxide of zinc (ZnO) in the form of a fine white powder used in compounding rubber, as a fungicide, as an absorber of ultraviolet radiation, in pharmaceuticals, in cosmetic preparations, in pigments, as a component in paint to toughen and prevent yellowing, as a semi-conductor, in photocopying processes (related to its photoconductivity), and in ceramic glazes, printing inks, glass colorants, enamels, and lubricants. Zinc oxide is prepared in either of two ways: by the oxidation of pure zinc or by roasting zinc ore. Zinc oxide has been used for various purposes since the Middle Ages, but was rarely used in making pigments until the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc oxide"@en .

aat:300311584 a skos:Concept ;
    skos:definition "A thin, tough, opaque paper made in imitation of India paper, but made of rags and hemp, and first manufactured by Oxford University Press in the late 19th century. It was used chiefly for the printing of Bibles and reference books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bible paper"@en .

aat:300311585 a skos:Concept ;
    skos:definition "A whitish, malleable, metallic element from the alkaline earth group, occurring primarily as a sulfate (barite) and less often as a carbonate (witherite). Salts of barium are used as pigments in paints, ceramics, glass, plastics, and rubber, as fillers, as pesticides, and to produce the green color in fireworks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium"@en .

aat:300311589 a skos:Concept ;
    skos:definition "The white and black variety of marble from Marmara Adasi, Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bianco e nero antico"@en .

aat:300311590 a skos:Concept ;
    skos:definition "Soft red ocher that is a natural mixture of hydrated silicate clays colored with red iron oxide. Since at least the 17th century, it has been used as a foundation for gold leaf and as a red earth pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian bole"@en .

aat:300311591 a skos:Concept ;
    skos:definition "A mineral allied to basalt, containing feldspar (labradorite) and augite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolerite"@en .

aat:300311592 a skos:Concept ;
    skos:definition "Artifacts created or produced in antiquity. For objects that are only a century old, use \"antiques.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antiquities"@en .

aat:300311593 a skos:Concept ;
    skos:definition "Underlayer of any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "substratum"@en .

aat:300311594 a skos:Concept ;
    skos:definition "Woollen fabric with a velvet pile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velours"@en .

aat:300311608 a skos:Concept ;
    skos:definition "Paper that contains no free acids, thus providing greater permanence and durability; the term does not necessarily imply that the paper is alkaline-buffered. Acid-free paper is typically produced from cotton linters, rags, esparto grass, or chemical wood pulp which minimizes the potential for acid and/or lignin in the pulp. Acid-free paper may also contain a buffering material to maintain a pH in the neutral to slightly alkaline range. This helps scavenge any acidic materials formed by bleaching residues, sizes, degradation products, or air pollutants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid-free paper"@en .

aat:300311617 a skos:Concept ;
    skos:definition "Paper having a buffer or reserve of an alkaline substance added to the material for the purpose of neutralizing future acidic components that may otherwise accumulate. As cellulosic materials are very sensitive to acid degradation, an alkaline reserve is sometimes added to archival papers and treated papers to minimize acid-produced embrittlement, yellowing, and deterioration. For example, a paper may have a reserve of 10% - 20% precipitated calcium or magnesium carbonate, which is an alkaline substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkaline paper"@en .

aat:300311622 a skos:Concept ;
    skos:definition "Exhibitions held once per year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annuals"@en .

aat:300311629 a skos:Concept ;
    skos:definition "An amount of money made available by a governing or funding body of a museum, library, archives, or other agency for expenditure according to established budgetary and accounting practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appropriation"@en .

aat:300311630 a skos:Concept ;
    skos:definition "Arrangements by which a publisher or a vendor assumes responsibility for selecting and supplying materials to fit an institution's profile, but with some right to return."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "approval plans"@en .

aat:300311640 a skos:Concept ;
    skos:definition "Institutions that provide training in the creation of fine and decorative arts, established primarily for the instruction of artists but often endowed with other functions, such as providing exhibition space for students and mature artists who have been accepted as members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art schools"@en .

aat:300311653 a skos:Concept ;
    skos:definition "Issues of a periodical preceding the current or most recent issue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "back issues"@en .

aat:300311664 a skos:Concept ;
    skos:definition "Agreements between a customer and supplier, by which the supplier will deliver goods or services on multiple delivery dates over a period of time, often negotiated to take advantage of predetermined pricing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanket orders"@en .

aat:300311670 a skos:Concept ;
    skos:definition "Small books consisting of a few sheets that are glued, stitched or stapled together between thin card or paper covers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booklets"@en .

aat:300311673 a skos:Concept ;
    skos:definition "A collection of books in a library or bookshop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bookstocks"@en .

aat:300311675 a skos:Concept ;
    skos:definition "People who take a thing on loan, security, or credit. Examples are those who use library materials on a loan basis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borrowers"@en .

aat:300311679 a skos:Concept ;
    skos:definition "A serial publication issued by an organization or society, especially a short account, alert, or report of public news or events issued by authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulletins"@en .

aat:300311682 a skos:Concept ;
    skos:definition "Standards of judgment or authority, such as a test, criterion, or means of discrimination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canons"@en .

aat:300311691 a skos:Concept ;
    skos:definition "Standard closed, often lightproof, covers or containers used to hold film, microfilm, magnetic audio tape, or video recording tape, having both supply and take-up spools enclosed, and so designed that the cassette needs merely to be inserted into a suitable tape recorder, camera, computer, or video recorder to be ready for use. Such cassettes are usually made of made of plastic or lightweight metal and are flat and rectangular in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cassettes"@en .

aat:300311696 a skos:Concept ;
    skos:definition "A flexible support or base used for photographic negatives and motion picture film from 1890 to the 1950s. It is made of cellulose nitrate with camphor as a plasticizer; it is unstable and flammable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cellulose nitrate film"@en .

aat:300311699 a skos:Concept ;
    skos:definition "Main divisions or sections of a book, typically designated in some way, such as with a special heading, title, number, or layout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapters"@en .

aat:300311705 a skos:Concept ;
    skos:definition "Bibliographic references to published or unpublished works, typically including the author name, title of the work, year of publication, and often the place of publication and publisher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citations"@en .

aat:300311706 a skos:Concept ;
    skos:definition "Numeric or alphanumeric codes, press-marks or shelf-mark, or other sets of symbols identifying a particular item or items in a library collection, expressing the subject contents of the item and its shelving location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "call numbers"@en .

aat:300311710 a skos:Concept ;
    skos:definition "Areas where library and archival materials are housed, which are not open to users."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closed stacks"@en .

aat:300311712 a skos:Concept ;
    skos:definition "Large, lavishly illustrated books suitable for displaying on a coffee table or similar surface in an area where visitors sit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coffee-table books"@en .

aat:300311714 a skos:Concept ;
    skos:definition "Examining a book, periodical, or other volume leaf by leaf, and by signature, or section, to describe and verify number and order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collating"@en .

aat:300311715 a skos:Concept ;
    skos:definition "Bibliographical descriptions of the physical composition of a book or book-like object, or critical comparisons of manuscripts or editions in order to ascertain the correct text, or the perfect condition of a particular copy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collations"@en .

aat:300311721 a skos:Concept ;
    skos:definition "Emblematic designs or devices of a printer or publisher. The printer's mark as an identifying device was used in typographic books with the invention of printing in the 15th century; printers gradually added a blank piece of paper at the front of a book to protect the first page from soiling. The identifying device, monogram, or emblem was applied to this page or with a brief sentence at the rear of the book; when the printer's mark was incorporated into the colophon, it is sometimes itself known as a \"colophon.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printer's marks"@en .

aat:300311725 a skos:Concept ;
    skos:definition "Any type of shelving which is designed to increase the storage capacity of library materials to be shelved in a given space, such as draw-out shelves, mobile ranges, and swinging-case shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compact shelving"@en .

aat:300311734 a skos:Concept ;
    skos:definition "Belonging to the same time, age, or period as something or someone else, as when the lives of two people occurred during the same time period. Also used in reference to a thing, person, or event that lives or exists in the present time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contemporary"@en .

aat:300311735 a skos:Concept ;
    skos:definition "Devices used to hold a camera and secure the printed material or other item to be photographed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copy stands"@en .

aat:300311737 a skos:Concept ;
    skos:definition "The bodies or complete collections of writings or the whole body of literature on any subject."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corpora"@en .

aat:300311741 a skos:Concept ;
    skos:definition "References from one part of a book, catalog, file, or other document to another part where the same or related topic is discussed or recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cross-references"@en .

aat:300311781 a skos:Concept ;
    skos:definition "Printed materials illustrating the prevailing style or a new style of dress, including both plates in a magazine and independent sheets; often serving as advertisements for a dressmaker or dress shop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion plates"@en .

aat:300311788 a skos:Concept ;
    skos:definition "Bindings produced as unique or limited editions and intended to be works of art in themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine bindings"@en .

aat:300311789 a skos:Concept ;
    skos:definition "Beautifully printed books issued by a private press, usually in a limited edition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fine press books"@en .

aat:300311807 a skos:Concept ;
    skos:definition "Portable books, treatises, or compendiums, covering one or more subjects, arranged for quick location of information and of a size such as may conveniently be held in the hand. Examples are instructional manuals and guides to museums' collections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handbooks"@en .

aat:300311820 a skos:Concept ;
    skos:definition "Books that include visual images to explain, augment, or embellish the text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "illustrated books"@en .

aat:300311826 a skos:Concept ;
    skos:definition "Groups of all copies printed at the same time. A single impression in publishing includes all of the copies of a book produced during one printing, or print-run, or an additional press-run made without revision of text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impressions"@en .

aat:300311832 a skos:Concept ;
    skos:definition "Data, ideas, and imaginative works that have been communicated, recorded, published and/or distributed formally or informally in any format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information"@en .

aat:300311841 a skos:Concept ;
    skos:definition "Words or verbal units chosen to indicate or represent the content of a larger document, text, record, etc., in an index, catalog, or database. Keywords may be used in a search expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "keywords"@en .

aat:300311843 a skos:Concept ;
    skos:definition "Format configured horizontally rather than vertically in the design of publications, documents, photographs, etc., where the width is greater than the height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape format"@en .

aat:300311855 a skos:Concept ;
    skos:definition "Tables incorporating a translucent screen illuminated from underneath, for tracing, viewing slides, and other activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light tables"@en .

aat:300311871 a skos:Concept ;
    skos:definition "The physical material or substance or electronic components upon and by which information can be recorded or stored, including electronic and physical materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "media"@en .

aat:300311879 a skos:Concept ;
    skos:definition "Periodical publications issued once per month."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monthlies"@en .

aat:300311885 a skos:Concept ;
    skos:definition "System of interconnected computers or any instances of two or more organisations or individuals engaged in a common pattern of information exchange through automated, online, or on air communications links."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "networks"@en .

aat:300311889 a skos:Concept ;
    skos:definition "Material things that can be perceived by the senses. In the context of art history or art information, the term may be restricted to works of art or cultural heritage, including architecture, art works such as paintings, drawings, graphic arts, sculpture, decorative arts, photographs, and other cultural artifacts. An object may be a single item or it may be made up of many physical parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "objects"@en .

aat:300311899 a skos:Concept ;
    skos:definition "A size larger than normal sizes, such as a book or other object too large to be housed in its expected place or sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oversize"@en .

aat:300311913 a skos:Concept ;
    skos:definition "Collections in a museum, gallery, special collection, or library comprising works that are owned by the institution, as distinct from works that are on the premises or in the institution's care or possession temporarily, such as loans and deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanent collections"@en .

aat:300311925 a skos:Concept ;
    skos:definition "In general, refers to the visual arts as opposed to literature, poetry, or other writing. In a narrower sense, it sometimes refers to all visual arts concerned with three-dimensional objects, but not two-dimensional visual arts. For works made of the material plastic, use \"plastic (organic material).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastic arts"@en .

aat:300311927 a skos:Concept ;
    skos:definition "Visual arts produced by or for the general public, often reflecting fads and as a response to the daily environment; works produced for mass audiences as distinct from fine art and folk art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popular art"@en .

aat:300311936 a skos:Concept ;
    skos:definition "Source material that is derived directly from a person or project without secondary interpretation or commentary. Used especially for unique, unpublished materials, but it may also refer to published materials, including transcriptions of interviews. Other examples of primary sources include correspondence, diaries, unique handwritten archival documents, works of art, manuscripts, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary sources"@en .

aat:300311945 a skos:Concept ;
    skos:definition "Periodicals published at regular intervals four times per year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarterlies"@en .

aat:300311954 a skos:Concept ;
    skos:definition "Citations or other sets of bibliographic elements that refer to a published or other work and are complete enough to provide unique identification of the work for a particular bibliographic function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "references"@en .

aat:300311955 a skos:Concept ;
    skos:definition "Libraries, either general or specialized, that are organized for consultation and research; generally non-circulating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reference libraries"@en .

aat:300311961 a skos:Concept ;
    skos:definition "The technique, technology, science, and practice of copying and reproducing documents or graphic materials in facsimile form by means other than conventional printing, for example photocopying, microfilm, and digitalization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reprography"@en .

aat:300311980 a skos:Concept ;
    skos:definition "Storage area or structure containing shelves upon which books, boxes, and other materials are stored, such as in a libary, archives, or museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelving"@en .

aat:300311986 a skos:Concept ;
    skos:definition "Devices used to look at slides and transparencies by projecting the image. A slide projector includes an electric light bulb, a reflector, a lens to direct the light to the slide, a focusing lens, and a carousel or other holder for the slides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slide projectors"@en .

aat:300311990 a skos:Concept ;
    skos:definition "Collections of library materials separated from the general collection because they are rare and valuable materials, such as prints and drawings, or they are of a certain form, subject, period, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special collections"@en .

aat:300311994 a skos:Concept ;
    skos:definition "Areas of shelves in a library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacks"@en .

aat:300312006 a skos:Concept ;
    skos:definition "Titles forming secondary portions of the title proper of a book or other work, usually consisting of an explanatory or limiting phrase, following a colon or semicolon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subtitles"@en .

aat:300312018 a skos:Concept ;
    skos:definition "Things that are valued and preserved as precious, wealth or riches stored or accumulated, especially in the form of precious metals or money."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treasures"@en .

aat:300312030 a skos:Concept ;
    skos:definition "Periodicals or newspapers published once a week."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weeklies"@en .

aat:300312031 a skos:Concept ;
    skos:definition "Process of using woodblocks, as distinct from type, in printing texts or images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xylography"@en .

aat:300312033 a skos:Concept ;
    skos:definition "Shapes or outlines laid out in large scale with rocks or boulders on bedrock or other outdoor surfaces, usually by ancient peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petroforms"@en .

aat:300312034 a skos:Concept ;
    skos:definition "Large scale low-relief carved, incised, or painted images on living rock, often created by ancient peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petroglyphs"@en .

aat:300312038 a skos:Concept ;
    skos:definition "Information, especially digital information. In common usage in computer science, used as a singular noun to refer to information that exists in a form that may be used by a computer, excluding the program code. In the sciences and other contexts, \"datum\" is the singular and \"data\" is the plural, referring to facts or numbers in a general sense. For general reference to facts, use \"information.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data"@en .

aat:300312040 a skos:Concept ;
    skos:definition "Sumptuous book editions produced to be admired for their appearance as much as, or rather than, to be read."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "editions de luxe"@en .

aat:300312044 a skos:Concept ;
    skos:definition "The dimensions of area or surface space occupied by a form on a horizontal plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footprint"@en .

aat:300312045 a skos:Concept ;
    skos:definition "Standardized means of organizing and storing audio recordings created using a binary numerical system in encoded forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital audio formats"@en .

aat:300312046 a skos:Concept ;
    skos:definition "Standardized means of organizing and storing images created using a binary numerical system electronically stored in the form of encoded image elements, or pixels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital image file formats"@en .

aat:300312047 a skos:Concept ;
    skos:definition "Refers to a digital audio-compression file format, or standard, designed specifically for transmitting files over the Internet. Appended to file names as .mp3."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MP3"@en .

aat:300312048 a skos:Concept ;
    skos:definition "Audio file format for uncompressed waveforms used to store sound with a high sampling rate. Primarily a recording format, for master files, or for reformatting from analog sound sources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "AIFF"@en .

aat:300312049 a skos:Concept ;
    skos:definition "File format for audio that can incorporate an audio bitstream with other data. Widely used for exchange of audio and for telephony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "WAVE"@en .

aat:300312050 a skos:Concept ;
    skos:definition "Standardized means of organizing and storing moving images created using a binary numerical system electronically stored in the form of encoded image elements, or pixels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital moving image formats"@en .

aat:300312051 a skos:Concept ;
    skos:definition "Compression scheme designed to reduce storage requirements of digital video. MPEG is an acronym for Motion Pictures Experts Group, a committee of the International Standards Organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MPEG-1"@en .

aat:300312052 a skos:Concept ;
    skos:definition "Compression scheme designed to reduce storage requirements of digital video and audio. MPEG is an acronym for Motion Pictures Experts Group, a committee of the International Standards Organization. MPEG-2 incorporates a variety of compression ratios that exchange picture quality for bandwidth and storage size. Intended to enable the transmission of compressed television via broadcast and satellite and later used in DVD production and online delivery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "MPEG-2"@en .

aat:300312053 a skos:Concept ;
    skos:definition "A lossless compression algorhythm for digital data that has become most associated with digital image compression. Named for creators Abraham Lempel, Jacob Ziv, and Terry Welch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "LZW"@en .

aat:300312054 a skos:Concept ;
    skos:definition "A platform-independent tagged file specification, or structure, that allows multimedia to be stored in a common format."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "RIFF"@en .

aat:300312055 a skos:Concept ;
    skos:definition "The most common technique for converting analog signals into digital form, involving sampling. Pulse Code Modulation is not a universally accepted standard, but rather a technique used in a variety of applications from telephony to CD production. CD quality music is sampled generally at 44.1 kHz at 32 bits per sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "PCM"@en .

aat:300312056 a skos:Concept ;
    skos:definition "Barrel-shaped or cylindrical lookout posts located near the top of the masts of whaling or other ships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crow's-nests"@en .

aat:300312057 a skos:Concept ;
    skos:definition "Phenomena, appearances, or other results that are considered spurious because they do not necessarily represent a real biological, physical, or other structures or processes, but are instead created by the experimental technique or procedure itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experimental artifacts"@en .

aat:300312058 a skos:Concept ;
    skos:definition "Hypostyle halls, such as a palace or audience hall, typically of stone construction with columns, in Persia or other places. Examples are reception halls in the palaces of Achaemenid rulers at Susa and Persepolis distinguished by six rows of six columns and three columned porticos, each with two rows of six columns. These structures may have functioned as audience halls for the king's court and visiting foreign vassals and ambassadors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apadanas"@en .

aat:300312059 a skos:Concept ;
    skos:definition "Poems written on or intended for a special occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occasional poems"@en .

aat:300312061 a skos:Concept ;
    skos:definition "Mineral composed of manganese carbonate (MnCO3), appearing transparent to opaque pink to deep red in color; used as an ornamental stone and source for manganese. Found in hydrothermal veins along with other manganese minerals in low temperature ore deposits as in the silver mines of Romania, Germany, and Britain; also found in South and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhodochrosite"@en .

aat:300312062 a skos:Concept ;
    skos:definition "Books containing versions of the same text in several languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyglots"@en .

aat:300312064 a skos:Concept ;
    skos:definition "Armor that protects a horse's forehead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prometopidions"@en .

aat:300312065 a skos:Concept ;
    skos:definition "Contemporary artists who create outdoor paintings, drawings, or three-dimensional works on walls, sidewalks, or street surfaces in public thoroughfares, sometimes intended to draw attention to urban issues. The term may also refer to anyone routinely creating works outdoors, for example painters who are set up on sidewalks to paint canvases or tatoo artists who decorate customers on sidewalks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street artists"@en .

aat:300312066 a skos:Concept ;
    skos:definition "Refers to people who create humorous, satiric, obscene, or gang-related writings or drawings that are executed anonymously in public places, usually on walls and typically illegally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graffiti artists"@en .

aat:300312067 a skos:Concept ;
    skos:definition "Materials relating primarily to individual visual artists, artist collectives, collectors, art historians, and curators, including announcements, architectural drawings, photographs, auction catalogs, biographical information, books, brochures, correspondence, exhibition catalogs, institutional publications, interviews, invitations, manuscripts, memorabilia, negatives, newspapers, official records, oral histories, pamphlets, postcards, posters, press releases, price lists, and any number of other types of materials related to artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artist files"@en .

aat:300312068 a skos:Concept ;
    skos:definition "Materials related to the office of an architect or architectural firm, including drawings, correspondence, and written documentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architect's files"@en .

aat:300312069 a skos:Concept ;
    skos:definition "Lists of merchandise located in or belonging to a retail sales establishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retail inventories"@en .

aat:300312070 a skos:Concept ;
    skos:definition "Lists of items located in a warehouse, often with location noted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warehouse lists"@en .

aat:300312071 a skos:Concept ;
    skos:definition "Records originating with or maintained by a government and available for access by the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public records"@en .

aat:300312072 a skos:Concept ;
    skos:definition "Court records limited to the daily court proceedings of a given court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court rolls"@en .

aat:300312073 a skos:Concept ;
    skos:definition "Records of the deliberations, decisions, and expenditures of the vestry board, which is an assembly of parishioners who originally met in the vestry of the parish church and ruled on certain temporal affairs of the parish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestry records"@en .

aat:300312074 a skos:Concept ;
    skos:definition "Labels affixed under, beside, or otherwise near a work in an exhibition or museum installation, noting the name of the artist, title, and other pertinent information. For the format and content of the information itself, use \"tombstone (document genres).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall labels"@en .

aat:300312075 a skos:Concept ;
    skos:definition "Standardized displays of information about an art object or other cultural material that include specific data elements that uniquely identify and describe the object, often the name of creator, title, date of creation, materials, dimensions, location and unique identifying number (such as an accession number), and copyright and credit line. Tombstones are used in wall labels, captions under illustrations in publications, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tombstones"@en .

aat:300312076 a skos:Concept ;
    skos:definition "Papers, research results, or other documents presenting the author's research and submitted in support of candidature for a doctoral degree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doctoral dissertations"@en .

aat:300312077 a skos:Concept ;
    skos:definition "Papers or other documents presenting a student's research on a particular topic and submitted as a qualification of completing a semester or other term of school or college."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "term papers"@en .

aat:300312078 a skos:Concept ;
    skos:definition "Those who have been awarded a master's degree in any field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masters"@en .

aat:300312079 a skos:Concept ;
    skos:definition "Those who have been awarded a doctoral degree in any field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doctors"@en .

aat:300312080 a skos:Concept ;
    skos:definition "Stages of achievement and proficiency in a discipline, course of study, art, or craft, typically reserved for an academic rank or distinction conferred by a university or college as a mark of proficiency in scholarship or skill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "degrees"@en .

aat:300312081 a skos:Concept ;
    skos:definition "The degrees of doctor, which is one of the highest earned academic degrees conferred by a university."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doctoral degrees"@en .

aat:300312082 a skos:Concept ;
    skos:definition "Companies that employ one or more licensed architects to practice the profession of design and production of architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural firms"@en .

aat:300312083 a skos:Concept ;
    skos:definition "Businesses formed by one or more lawyers to engage in the practice of law, which entails advising and representing in civil or criminal law cases, business transactions, and other matters for which legal advice is required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law firms"@en .

aat:300312084 a skos:Concept ;
    skos:definition "Film production companies that create and distribute motion pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion picture studios"@en .

aat:300312086 a skos:Concept ;
    skos:definition "A game derived from the sport of golf, where golf balls are hit with clubs over a novelty putting course, typically set with colorful and whimsical hazards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature golf"@en .

aat:300312087 a skos:Concept ;
    skos:definition "Tracks or roads prepared for fast transportation, including roads for horses or motor vehicles where the dirt surface has been packed or covered with asphalt or another material, and the course is generally straight and flat, where possible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speedways"@en .

aat:300312088 a skos:Concept ;
    skos:definition "Downhill paths on a mountain or large hill that are maintained for snow skiing, snowboarding, or other mountain sports, usually marked, patrolled, and graded according to difficulty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski runs"@en .

aat:300312089 a skos:Concept ;
    skos:definition "Assemblies of people, either ancient Roman citizens in the provinces who gathered for purposes of administration and justice, or in monasticism, groups of people of either sex belonging to a religious order and living together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convents"@en .

aat:300312090 a skos:Concept ;
    skos:definition "Places where construction is occurring, particularly construction of a building. For the more general meaning of a site where a building is or was located, whether or not the building is under construction, use \"building sites.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction sites"@en .

aat:300312091 a skos:Concept ;
    skos:definition "Vertical shafts in buildings, ships, or dug into the earth to provide access and circulation to lower levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wellways"@en .

aat:300312092 a skos:Concept ;
    skos:definition "Films made by visual artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artists' films"@en .

aat:300312093 a skos:Concept ;
    skos:definition "Small rackets made of parchment or rows of gut stretched across wooden frames."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battledores"@en .

aat:300312094 a skos:Concept ;
    skos:definition "Semi-liquid, loose sand which can suck down heavy objects that rest on its surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quicksand"@en .

aat:300312095 a skos:Concept ;
    skos:definition "Comics having a primary or only published format on a Web site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "webcomics"@en .

aat:300312096 a skos:Concept ;
    skos:definition "Plate guards of a Japanese sword that separate the blade from the handle. Typically, tsuba are round or kite- shaped, having a central opening for the tang of the blade and occasionally surrounded by a smaller perforations. They vary in size from about 8 to 15 centimeters, depending on the length of the blade. While tsuba were a functional part of the sword, they also evolved into an art form in their own right around the late 15th century and peaking in the 19th century. Materials can range from iron, brass, and steel to gold and silver, and rare ones of ivory or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tsuba"@en .

aat:300312097 a skos:Concept ;
    skos:definition "Baskets or hampers of various shapes and sizes in different regions, particularly referring to large round wicker baskets used to transport or weigh items such as grain or coal, often by default utilized as a unit of measurement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skeps"@en .

aat:300312098 a skos:Concept ;
    skos:definition "Heated structures used for raising young fowl, traditionally wood-framed, wood-floored, movable structures heated by electric or oil-fired stoves and built on skids. The chicks are housed from hatching until they are about six weeks old, when they no longer need heat. Commercial brooder houses may be very large, having several brooder units, underfloor heat or heat lamps, fan ventilation, automatic waterers and feeders, and large doors through which tractors and litter-removing equipment can pass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brooder houses"@en .

aat:300312099 a skos:Concept ;
    skos:definition "Standard tall lykythoi of cylindrical shape, typically white-ground, and used primarily in funerary rituals, which is known from their excavation from cemeteries and the subjects depicted on them. Late in the fifth century some massive examples of the shape were produced, serving perhaps as equivalents for stone grave markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder lekythoi"@en .

aat:300312100 a skos:Concept ;
    skos:definition "Rings, usually of plain gold or another precious metal, placed by the bridegroom on the finger of the bride as part of the marriage ceremony, and worn by her ever after to signify her marital status. In contemporary Western practice, the ring is placed on the third finger of the bride's left hand, and such a ring is similarly presented by the bride to the bridegroom, and worn afterwards by him. A bride's wedding ring may be, but is not necessarily, conjuncted with an engagement ring after the marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding rings"@en .

aat:300312101 a skos:Concept ;
    skos:definition "Rings placed by a man on the finger of his chosen mate's left hand to signify her status as the betrothed prior to their marriage. In modern Western tradition, such a ring is usually a gold band having one or more diamonds or other precious stones, placed on the third finger of the woman's left hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engagement rings"@en .

aat:300312102 a skos:Concept ;
    skos:definition "The style and culture of those Ojibwa who lived west of Lake Winnipeg in Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saulteux"@en .

aat:300312103 a skos:Concept ;
    skos:definition "The unauthorized reproduction or use of an invention or work of another, as a book, recording, computer software, intellectual property, etc., esp. as constituting an infringement of patent or copyright; plagiarism; an instance of this."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piracies"@en .

aat:300312107 a skos:Concept ;
    skos:definition "A periodically published official return of the deaths (later, also of the births) in a certain district."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bills of mortality"@en .

aat:300312109 a skos:Concept ;
    skos:definition "An S-shaped figure used as a motif, often in a horizontal position or in a chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "S-motifs"@en .

aat:300312111 a skos:Concept ;
    skos:definition "A naturalistic or geometricized motif derived from the species Dianthus caryophyllus, commonly used in Oriental carpets, especially in Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnation"@en .

aat:300312112 a skos:Concept ;
    skos:definition "General motif resembling a stylized tree as seen in the art and artifacts of many cultures, including Islamic and Judeo-Christian cultures, Ancient Egypt, Assyria, Greece, China, Japan, Africa, Nordic cultures, India, Turkey, pre-Columbian cultures, and more recent European culture. The tree motif takes various forms, from a two-dimensional vertical stalk to a three-dimensional trunk topped by a rounded head of foliage. The motif typically represents the cosmos, immortality, renewal and continuation of life, paradise or another abode of deities, or the connections between generations. For the motif specifically related to kilim textiles and other art of Turkey and Armenia, use \"hayat agaci.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tree of life"@en .

aat:300312113 a skos:Concept ;
    skos:definition "Motif in the form of a stylized chest that may symbolize either a desire to marry and have children or death and a coffin. The chest generally has another motif within its box shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandıklı"@en .

aat:300312114 a skos:Concept ;
    skos:definition "Rug motifs that are cuff-shaped, in which each cuff appears as a triangle with a narrow link between the two hypotaneuses. In some cases, the \"cuff\" is surrounded by a diamond, which may be stepped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fetters"@en .

aat:300312115 a skos:Concept ;
    skos:definition "Anatolian rug motif symbolizing a dragon, which frequently looks like a line with a row of protruding hooks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monster's feet"@en .

aat:300312118 a skos:Concept ;
    skos:definition "A stick, used with a frame loom, to which every other thread of the warp is attached. The heddle rod can either be lifted away from the frame loom to open the shed, or it holds one shed still while a shed stick is moved to create the shed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heddle rods"@en .

aat:300312121 a skos:Concept ;
    skos:definition "A part of a loom that controls tightening and loosening the warp threads. It usually consists of a friction brake or a pawl and ratchet wheel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brakes"@en .

aat:300312123 a skos:Concept ;
    skos:definition "Process of preparing the warp by calculating the appropriate length, winding off the appropriate number of warp threads, and removing the warp from the winder in a way that ensures the threads to not get tangled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warping"@en .

aat:300312126 a skos:Concept ;
    skos:definition "Tools used in weaving to beat the weft fiber tightly against previous rows of weaving. Also used in basketry work. Beaters may be of various shapes, sizes, and materials; may be handheld or incorporated into the mechanism of a loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaters"@en .

aat:300312129 a skos:Concept ;
    skos:definition "Species of birch tree abundant throughout northern Europe, Iceland, northern Asia, and Greenland. It is a deciduous tree growing to over 60 feet tall (18 m), with a slender crown and a trunk, having smooth dull gray-white bark finely marked with dark horizontal lenticels. It is closely related to, and often confused with the silver birch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula pubescens"@en .

aat:300312131 a skos:Concept ;
    skos:definition "Pottery that is unglazed and undecorated, intended for strictly utilitarian use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plain ware"@en .

aat:300312132 a skos:Concept ;
    skos:definition "Referring to the style and period generally of people of the Republic of the Congo or the Democratic Republic of the Congo. For the broader style and culture of the Congo River area, use \"Kongo.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Congolese"@en .

aat:300312133 a skos:Concept ;
    skos:definition "Styles and cultures of North and Northwest Africa (formerly known in Europe as Africa Minor or Barbary) between the Atlantic Ocean and Egypt, comprising the coastal plain and Atlas Mountains of Morocco, together with Algeria, Tunisia, and sometimes also Tripolitania (in present-day Libya). In recent use, the term specifically refers to the nations of Morocco, Algeria, and Tunisia when referred to collectively as a social, political, or economic grouping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maghreb"@en .

aat:300312134 a skos:Concept ;
    skos:definition "Style and culture of the historical group that dwelled in the Horn of Africa from the 11th century, comprising mostly Christian, Semitic-speaking peoples in a territory including Eritrea, Tigray, Gonder, and parts of Gojam, Shewa, and Welo in the territory of the modern nation of Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abyssinian"@en .

aat:300312135 a skos:Concept ;
    skos:definition "Style and culture of the historical section of the coast of the Gulf of Guinea in Africa extending approximately from Axim, Ghana, or nearby Cape Three Points, in the west to the Volta River in the east."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gold Coast"@en .

aat:300312137 a skos:Concept ;
    skos:definition "Styles and cultures of the eastern area of Africa including Kenya, Tanzania, and Uganda, that together with the Horn of Africa (Somalia, Djibouti, Eritrea, and Ethiopia) make up Eastern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East African"@en .

aat:300312139 a skos:Concept ;
    skos:definition "Lace in which the pattern is made using strips or tape set in a background of either thread bars (brides) or net. The quality is judged by whether the tape lies flat and curves continuously (which can be achieved only by using bobbins) or is ready-woven, in which case the tape is gathered at the bends and corners, and inevitably puckers. The best Genoese tape lace of the 17th century is bobbin-made; among the ready-woven tape laces are the Belgian and French laces of the 1880s, such as so-called Renaissance lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape lace"@en .

aat:300312140 a skos:Concept ;
    skos:definition "Style of Nubian fresco and panel painting that, among other stylistic characteristics, uses the color white more than had previous styles; it dated from the end of 11th century until around 1175."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "White Style"@en .

aat:300312141 a skos:Concept ;
    skos:definition "Fine, lightweight straw with a dull finish made from the young stalks of the species Corypha umbraculifera, from southeast Asia and the Philippines. Often used for hats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baku"@en .

aat:300312142 a skos:Concept ;
    skos:definition "Bookplates that are usually printed or engraved with an area reserved for additions in handwriting, for the purpose of noting to and by whom a book was given."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presentation bookplates"@en .

aat:300312143 a skos:Concept ;
    skos:definition "Lithographs obtained by means of lithographic chalk, also called crayon. Before its application the lithographic stone was roughened by grinding fine sand over its surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalk lithographs"@en .

aat:300312144 a skos:Concept ;
    skos:definition "An imaginary imprint used for the purpose of evading legal and other restrictions, to mask piracies, to protect anonymity of the author, etc. An imaginary imprint used for the purpose of evading legal and other restrictions, to mask piracies, to protect anonymity of the author, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fictitious imprints"@en .

aat:300312145 a skos:Concept ;
    skos:definition "Bookbindings having decorations on the four corners of the front cover, and sometimes on the back cover."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornerpiece bindings"@en .

aat:300312150 a skos:Concept ;
    skos:definition "Having a form that is loosely or irregularly structured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free-form"@en .

aat:300312153 a skos:Concept ;
    skos:definition "Style and culture of an aboriginal people inhabiting Luristan in western Iran. To refer specifically to the style of textiles, particularly carpets, made by the Lur people, use \"Lori (carpet style).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lur"@en .

aat:300312154 a skos:Concept ;
    skos:definition "Discrete bibliographical items which though once part of a larger whole (e.g., a periodical issue) have been disbound in order that may stand alone. Distinguished from \"excerpts\" and \"offprints\" which are printed separately, in that extracts were once physically part of a larger whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extracts"@en .

aat:300312155 a skos:Concept ;
    skos:definition "The style and culture of the aboriginal inhabitants of the Philippine islands, referring collectively to numerous peoples of dark skin and small stature, including the Aeta, Baluga, Ita, Agta, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Negrito"@en .

aat:300312156 a skos:Concept ;
    skos:definition "Style and culture of the Sikon tribe of the Kru group, located in the interior of Liberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sikon"@en .

aat:300312157 a skos:Concept ;
    skos:definition "Sound devices, either musical or non-musical, having a primarily ceremonial or ritual purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial sound devices"@en .

aat:300312158 a skos:Concept ;
    skos:definition "Objects used for a particular ritual activity, often as part of a ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ritual objects"@en .

aat:300312160 a skos:Concept ;
    skos:definition "A formal procedure or act in a religious or other solemn observance or ceremony, carried out according to established and prescribed rules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rites"@en .

aat:300312161 a skos:Concept ;
    skos:definition "Drinking cups formed of staves of wood in the manner of a miniature barrel, hooped with wood, metal, or cord, typically having a wooden bottom and often decorated with carved and painted decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stave tankards"@en .

aat:300312162 a skos:Concept ;
    skos:definition "Tool comprising two sticks with an adjustment mechanism in the center to control width. Their ends are stuck into the selvedge and the mechanism is then locked so that the weaving is locked at the desired width. Sometimes, a needle or hook may be inserted in the selvedge and tied to the frame to maintain width and tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stretchers"@en .

aat:300312169 a skos:Concept ;
    skos:definition "Beams onto which cloth is rolled as it is woven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloth beams"@en .

aat:300312172 a skos:Concept ;
    skos:definition "An unpaved, or earth, road."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dirt roads"@en .

aat:300312174 a skos:Concept ;
    skos:definition "Roads surfaced with a blackish material largely consisting of a mix of asphalt or bitumen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blacktop roads"@en .

aat:300312175 a skos:Concept ;
    skos:definition "Houses built from stone, whether dressed, rubblestone, river stone, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone houses"@en .

aat:300312178 a skos:Concept ;
    skos:definition "Mazes of interconnected underground rabbit burrows, including natural habitations for wild rabbits or habitations on a piece of land set aside by humans for rabbit breeding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbit warrens"@en .

aat:300312179 a skos:Concept ;
    skos:definition "Restaurants designed and optimized to allow customers to drive automobiles alongside the building to take away fast food without exiting the cars. The design usually incorporates a window or microphone station where orders are placed from the cars, and a window where the food is delivered and paid for."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drive-through restaurants"@en .

aat:300312180 a skos:Concept ;
    skos:definition "Ancient Roman inns that served cooked delicacies and full meals, usually having a narrow, long floor plan and vaulted ceilings, with serving boys attending and the proprieter sitting on a raised platform at one end. They were better-class establishments, distinguished from the lower-class inns, \"cauponae.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabernae meritoriae"@en .

aat:300312181 a skos:Concept ;
    skos:definition "Style of prayer rugs that, regardless of whether or not they actually come from Lâdik, share a motif derived from a 16th-century Ottoman court design, consisting of three arches of unequal height supported upon slender columns and surmounted by a panel as described earlier. Most column Ladiks have been found in Europe, and some possibly were made in the Balkans in the 17th and 18th centuries. A less sophisticated, more recent type, with bolder coloring, comes from the nearby city of Konya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "column Ladik"@en .

aat:300312182 a skos:Concept ;
    skos:definition "Refers to structures designed or used specifically to house markets; the term is usually reserved for relatively small, traditional structures in the historical center of a town or city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market houses"@en .

aat:300312183 a skos:Concept ;
    skos:definition "Originally referred to a distinctive type of arcade of shops in Italian cities, descendents of the ancient stoas. Now refers to covered shopping malls that architecturally resemble or were inspired by Italian gallerias. The term is also used to describe areas of a department store that are designed so as to appear to contain a number of separate shops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallerias"@en .

aat:300312184 a skos:Concept ;
    skos:definition "Malls or other arrangements of multiple corporate offices, generally for different companies, designed with pedestrian access between offices, and typically having only one story or a small number of stories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate plazas"@en .

aat:300312185 a skos:Concept ;
    skos:definition "Shops or small stores where baked goods are displayed and sold; usually the items are baked on the premises, but typically out of view of the customers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bake shops"@en .

aat:300312187 a skos:Concept ;
    skos:definition "People who sell and often create tools and other items made of iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ironmongers"@en .

aat:300312190 a skos:Concept ;
    skos:definition "General term for elevated structures, either open or enclosed, from which signals of any kind are sent, including telegraphic, electronic, or manual signals. Examples are towers in the Great Wall of China and towers used to relay railroad signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "signal towers"@en .

aat:300312191 a skos:Concept ;
    skos:definition "Houses having one rows of rooms in the floor plan, typically allowing access to rooms only through other rooms rather than via a corridor. Single-pile houses may have one or two stories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-pile houses"@en .

aat:300312192 a skos:Concept ;
    skos:definition "Aquariums that are availble to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public aquariums"@en .

aat:300312193 a skos:Concept ;
    skos:definition "A bookseller's ticket records the name and address of the bookseller as a modest advertisement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "booksellers' tickets"@en .

aat:300312195 a skos:Concept ;
    skos:definition "A merchant who sells writing materials and related articles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stationers"@en .

aat:300312198 a skos:Concept ;
    skos:definition "A club in which the subscriptions are expended in the purchase or borrowing of books for the common use of the members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book clubs"@en .

aat:300312200 a skos:Concept ;
    skos:definition "Works executed in the medium of wax (usually bees wax), particularly those representing objects or figures, including life-size effigies of persons, with head, hands, and bust of wax, colored and clothed to look life-like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waxworks"@en .

aat:300312201 a skos:Concept ;
    skos:definition "Circular ditches that stand alone or form part of a fortification or other earthworks system, often the remains of plowed-out barrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring ditches"@en .

aat:300312202 a skos:Concept ;
    skos:definition "Cabinet officers of king or queen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ministers of the crown"@en .

aat:300312203 a skos:Concept ;
    skos:definition "Dams built using materials that are excavated, transported, and placed by hydraulic methods. Coarse materials of the slush settle at the outer edge and finer materials settle towards the center, forming an impervious central core. Compaction is not done, and poor drainage and settlement may cause failure of this type of dam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic fill dams"@en .

aat:300312204 a skos:Concept ;
    skos:definition "Earth dams having a central core of thick masonry or concrete extending into the pervious underground strata and acting as a barrier against seeping water, while the surrounding banks of earth and rock fill provide stability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaphragm earth dams"@en .

aat:300312205 a skos:Concept ;
    skos:definition "Earth dams, usually relatively small in size, constructed of a single kind and consistency of material, often a sandy clay, to form an impervious foundation with relatively flat side slopes to ensure stability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homogenous earth dams"@en .

aat:300312206 a skos:Concept ;
    skos:definition "Components of modern sewage-treatment systems where waste water is passed through a series of tanks following coarse screening to remove large objects. Grit chambers settle out sand and cinders; primary settling tanks remove heavy organic solids; and aeration tanks mix the incoming sewage with activated, bacteria-rich sludge and fine air bubbles, causing the rapid oxidation of organic matter. Final settling tanks remove the remaining suspended solids from the mixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settling tanks"@en .

aat:300312207 a skos:Concept ;
    skos:definition "Elongated tunnel kilns utilizing railroad cars rather than a conveyor belt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "car tunnel kilns"@en .

aat:300312208 a skos:Concept ;
    skos:definition "A dispersion of cellulose fibers in water, used as the raw material for paper manufacture. It contains vegetable, mineral, or man-made fibers, and forms a matted or felted sheet on a screen when moisture is removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper pulp"@en .

aat:300312209 a skos:Concept ;
    skos:definition "People ultimately responsible for all creative and technical aspects of a motion picture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film directors"@en .

aat:300312211 a skos:Concept ;
    skos:definition "The people who oversee and control all aspects of the production of motion pictures. With commercial films, the producer is ultimately responsible for the motion picture's success or failure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film producers"@en .

aat:300312212 a skos:Concept ;
    skos:definition "Facilities that provide medical treatments outside a hospital on an outpatient basis, that is, without accomodating overnight admissions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "outpatient clinics"@en .

aat:300312213 a skos:Concept ;
    skos:definition "Hospitals that are not restricted to patients suffering from one particular class of disease or to those of a particular sex or age-group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general hospitals"@en .

aat:300312214 a skos:Concept ;
    skos:definition "Buildings that house establishments, often charitable institutions, for the reception, housing, and care of pilgrims, travellers, or the needy. The term was originally reserved for the similar establishments of the Knights Hospitallers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospitals"@en .

aat:300312215 a skos:Concept ;
    skos:definition "Buildings that house clinics treating diseases and injuries of many sorts, offering broad general care that is usually on an outpatient basis. Polyclinics include hospital outpatient departments at a general practitioner health center or hospital in an urban or town environment, as well as facilities attached to major factories or other work places. They often contain reception and waiting rooms, a registration desk, consulting and treatment rooms, a pathological laboratory, X-ray facilities, physiotherapy areas, and small operating theaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyclinics"@en .

aat:300312216 a skos:Concept ;
    skos:definition "Clinics that are located in vehicles or are otherwise mobile, typically intended to provide outpatient treatment and dispensing of medicine in rural areas or other areas that do not have access to regular nearby medical facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mobile clinics"@en .

aat:300312217 a skos:Concept ;
    skos:definition "Facilities specializing in the care of people recovering health and strength after illness or injury, but typically not in need of active medical treatment. Physical therapy, dispensing of medicines, and other services may be provided. They are typically arranged like a group home rather than like a hospital ward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "convalescent homes"@en .

aat:300312218 a skos:Concept ;
    skos:definition "Structures of any material having a plan consisting of a number of intercommunicating passages arranged in bewildering complexity, through which it is difficult or impossible to find one's way without guidance. The term was derived from structures so-named in classical Antiquity, perhaps derived from \"labrys\" (Greek for \"double axe\" or \"place of the double axes\"), because the structures were labeled with the sign of a double-axe. The earliest use of the term is usually associated with the mythical labyrinth at Knossos, Crete, in which Theseus killed the Minotaur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "labyrinths"@en .

aat:300312219 a skos:Concept ;
    skos:definition "Bars or shops where food and beverages are served, and often other provisions may be purchased, particularly such establishments located on a military base, school, factory, or other facility where many people of a particular group congregate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canteens"@en .

aat:300312220 a skos:Concept ;
    skos:definition "Stores selling food, equipment, and other merchandise, and often serving light meals, for people employed in a particular kind of work, such as at a film studio or military installation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissaries"@en .

aat:300312221 a skos:Concept ;
    skos:definition "Small restaurants or snack bars serving light daytime meals or snacks that are ready to serve or quickly prepared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luncheonettes"@en .

aat:300312222 a skos:Concept ;
    skos:definition "Broadly describes physical manifestations made from digital image files that are achieved by the application or generation of colorant to a substrate, and that are not struck directly from a material master matrix. This is in contrast to traditional prints struck from matrices such as printing plates, blocks, negatives or transparencies, though these may be the primary origin of imagery. Digital prints have as their immediate source electronic signals that drive any of a variety of printing mechanisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital prints"@en .

aat:300312226 a skos:Concept ;
    skos:definition "Civilian provisioners to a military post, typically having a shop in a garrison town and selling merchandise primarily to soliders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sutlers"@en .

aat:300312228 a skos:Concept ;
    skos:definition "Housing designed for or used by the army."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "army housing"@en .

aat:300312229 a skos:Concept ;
    skos:definition "Sensitivity to blue and green light, but not to red: usually designates black-and-white negative photographic materials that are low in red and high in blue light sensitivity. 'Panchromatic' designates sensitivity that is more equal between the red, blue, and green parts of the spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthochromatic"@en .

aat:300312230 a skos:Concept ;
    skos:definition "Fixed aperture settings on some photographic lenses referred to by a numbering system that is a ratio of the diameter of the aperture to the focal length of the lens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "f-stops"@en .

aat:300312231 a skos:Concept ;
    skos:definition "Representations of an object as opposed to the tangible object itself, as when distinguishing between a photograph or digital image, and the art object depicted in the photograph or digital image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual surrogates"@en .

aat:300312232 a skos:Concept ;
    skos:definition "Representations, particularly of two-dimensional art, other images, objects, or visual spaces, utilizing raised lines and surface textures to represent the visual image; typically intended for the visually impaired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tactile representations"@en .

aat:300312233 a skos:Concept ;
    skos:definition "Inns that receive all guests, in contrast to inns that received only upper classes of guests; typically only used in reference to ancient Greek, Roman, and Middle Eastern structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pandokeions"@en .

aat:300312234 a skos:Concept ;
    skos:definition "Houses in which people receive lodging and meals for a fixed fee, typically for an extended period of time rather than simply overnight. Boarding houses are often family homes in which the family's spare bedrooms are used for boarders and the paying guests sit at the family table to take meals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boardinghouses"@en .

aat:300312235 a skos:Concept ;
    skos:definition "Houses, sometimes family homes or other relatively small buildings, that offer for a fixed fee apartments or rooms and sometimes meals. Rooming houses typically differ from boardinghouses in that a rooming house offers fewer amenities and less social contact with the family or other operators. However, in nineteenth-century American usage, the term may overlap in meaning with \"boardinghouses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rooming houses"@en .

aat:300312236 a skos:Concept ;
    skos:definition "Places of worship that are distinguished from churches by not being of ecclesiastical architectural design, and by being temporary places of worship or the meeting houses of Protestant Nonconformists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabernacles"@en .

aat:300312239 a skos:Concept ;
    skos:definition "Buildings that housed urban prisons for debtors, particularly those in London, Southwark, Exeter, and other English cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compters"@en .

aat:300312240 a skos:Concept ;
    skos:definition "Degree-granting institutions that may include liberal arts undergraduate colleges, graduate schools, and undergraduate or graduate professional schools. A university is a group of schools for studies after secondary school, with at least one of these schools being a college where students receive a bachelor's degree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "universities"@en .

aat:300312241 a skos:Concept ;
    skos:definition "Institutions that curate a collection of books, periodicals, and other materials, organized to provide physical, bibliographic, and intellectual access by the public or members of a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libraries"@en .

aat:300312242 a skos:Concept ;
    skos:definition "Institutions that store, maintain, and care for non-active public records or other important historical documents that are arranged as an organized body. The documents in an archive were received or originated in connection with the activities of an organization, institution or individual, and are preserved because of their continuing value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archives"@en .

aat:300312243 a skos:Concept ;
    skos:definition "Establishments in which works of art are displayed for sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art galleries"@en .

aat:300312244 a skos:Concept ;
    skos:definition "Institutions focused on the worship of a deity or deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temples"@en .

aat:300312245 a skos:Concept ;
    skos:definition "Institutions conducting the regular assembly or congregation of Jews for liturgical services, assembly, and study apart from the service of the temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synagogues"@en .

aat:300312246 a skos:Concept ;
    skos:definition "Institutions that oversee Muslim places of worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosques"@en .

aat:300312247 a skos:Concept ;
    skos:definition "Institutions that maintain places for public Christian worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "churches"@en .

aat:300312248 a skos:Concept ;
    skos:definition "Prints on photographic materials achieved by controlled exposure to white, red, green, or blue light and processed chemically. Distinguished from 'electrophotographic laser prints' that create images via a beam of light to etch onto a photoconductive drum from which images are transferred by electrostatic copying to paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser prints"@en .

aat:300312249 a skos:Concept ;
    skos:definition "A large group of digital image file formats that contain minimally processed and uncompressed data. There is no standard raw file format. Many have been developed by manufacturers of digital equipment such as digital cameras and scanners, as well as open-source formats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "RAW"@en .

aat:300312252 a skos:Concept ;
    skos:definition "Folk shawm of Spain, with conical bore. The same instrument is also known as a bolingozo in the Basque region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dulzainas"@en .

aat:300312253 a skos:Concept ;
    skos:definition "Quadruple-reed pipe of Cambodia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sralais"@en .

aat:300312255 a skos:Concept ;
    skos:definition "Medical specialty concerned with the prevention, control, diagnosis, and treatment of injuries and diseases affecting the health of domestic and wild animals, including the prevention of transmission of animal diseases to other animals and to people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterinary medicine"@en .

aat:300312256 a skos:Concept ;
    skos:definition "Structures or chambers, often underground, that are reinforced against bombing and typically stocked with food and living essentials, intended to be used by civilians or military personnel in case of enemy bomb attack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bomb shelters"@en .

aat:300312257 a skos:Concept ;
    skos:definition "Generally refers to buildings housing prisons for those convicted of major crimes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penitentiaries"@en .

aat:300312258 a skos:Concept ;
    skos:definition "Subterranean rooms or structures that comprise strongly fortified cells or other rooms of confinement; the term originally derived from such areas below the keep or donjon of a castle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dungeons"@en .

aat:300312260 a skos:Concept ;
    skos:definition "Style and culture of an ethnic group of central Peru, in the Valle del Mantaro. They probably originated in the Huari culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huanca"@en .

aat:300312261 a skos:Concept ;
    skos:definition "Cap- or hood-like devices, usually of brass or glass and with openings in both ends, that fit onto the top of a candle. As the wax melts the candle follower retains the wick in a central position and keeps the wax from dripping down the side of the candle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candle followers"@en .

aat:300312262 a skos:Concept ;
    skos:definition "Three-dimensional, free-standing sculptures that are smaller than life-size and usually but not always figural. They are often reduced versions of larger works. While the term may be used interchangeably with \"figurine\" in certain situations, it differs in that a statuette is always free-standing while a figurine may be part of a larger work, such as a decorative detail on a candelabra or mirror. Also, a statuette may represent objects other than a figure, while a figurine always represents a human, animal, or mythical figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statuettes"@en .

aat:300312263 a skos:Concept ;
    skos:definition "The process of forming a whole from various parts, particularly the formation of a compound material by the combination of its elements or constituents, of the production of white or other compound light by the combination of its constituent colors, or of the production of a complex musical sound by the combination of its component simple tones. In philosophy, it is the action of proceeding in thought from causes to effects, or from laws or principles to their consequences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthesis"@en .

aat:300312264 a skos:Concept ;
    skos:definition "From the Latin for \"chairs\" or \"seats,\" refers to ancient Roman chairs of heavy structure that were derived from the klismos, which is a lighter, more delicate chair developed by the ancient Greeks. For chairs used by bishops in Christian cathedrals, use \"cathedrae (bishop's chairs).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedrae"@en .

aat:300312265 a skos:Concept ;
    skos:definition "An alkaline solution of soda ash, borax, or ammonia, used as a cleanser and stripper. Sig water was formerly made from a solution of stale urine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sig water"@en .

aat:300312266 a skos:Concept ;
    skos:definition "Distinctive badges, devices, or marks bearing a crest, heraldic bearing, coat of arms, or other mark worn by a person or company or attached to property, particularly such devices intended to denote ownership of property or affiliation of retainers to a noble house, whether the retainers bore arms or not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cognizances"@en .

aat:300312267 a skos:Concept ;
    skos:definition "Statues in the shape of a lion or a lion-dog, usually of terra cotta, stone, or wood, particularly such statues placed in pairs as guardians at the entrances of tombs, palaces, and government offices in China and other Buddhist sites in Asia and elsewhere. They represent the \"Dog of Fo,\" a mythical beast that was half lion and half dog. The figures first appeared in Han China in the late third century BCE, probably developing from Indian depictions of the lion as the protector of dharma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guardian lions"@en .

aat:300312268 a skos:Concept ;
    skos:definition "The variation of the Art Nouveau movement in Spain. From the 1890s to the early 1900s, the style appeared in the visual and decorative arts, and prominently in the architecture, with special relevance of Antoni Gaudí. Although as a cultural trend it appeared in the whole of Spain, as far as the arts are concerned, it was particularly widespread in Catalonia, and from there the style and the influences extended to other Spanish cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modernisme"@en .

aat:300312269 a skos:Concept ;
    skos:definition "Refers to tools, usually a combination of software and database accessible through the World Wide Web, which enable persistent computer-mediated relationships that encompass social networking, blogs, wikis, and social or collaborative tagging. For specific activities that use social media, use relevent terms such as \"social networking.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social media"@en .

aat:300312270 a skos:Concept ;
    skos:definition "World Wide Web-based activity conducted through Web sites that enable members to create profiles of personal details, maintain lists of contacts, and send messages to other members. Establishing relationships for play, business, or action with others with similar interests is the primary goal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social networking"@en .

aat:300312271 a skos:Concept ;
    skos:definition "Coverings designed or used to cover the eyes for the purpose of blocking out light to aid in sleep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eye masks"@en .

aat:300312272 a skos:Concept ;
    skos:definition "Brassieres in the form of a narrow band of fabric worn tightly around the bust, usually without shoulder straps; the term may refer to any women's strapless top in a similar style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bandeaux"@en .

aat:300312273 a skos:Concept ;
    skos:definition "Works of Japanese verse consisting of thirty-one syllables, the first and third lines containing five and the other three lines seven syllables. The tanka has historically been the basic form of Japanese poetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tankas"@en .

aat:300312274 a skos:Concept ;
    skos:definition "Silver or pewter cups traditionally used for mint juleps, a drink popularized in the American South and made with mint, bourbon, sugar, and water. The cup is a beaker in shape, having no handle and held only by the bottom and top edges of the cup, allowing frost to form on the outside of the cup when filled with the icy beverage. Mint juleps are today often served in various types of glass vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mint julep cups"@en .

aat:300312275 a skos:Concept ;
    skos:definition "A style that belongs to or resembles a style or fashion of an earlier time. The term refers not to an absolute time frame, but is relative to the period being discussed, not to the present. For example, a style popular in 1710 may in 2010 be said to have been \"old fashioned\" in 1750. \"Old fashioned\" differs from \"retro\" in implying that a style or object is antiquated, outdated, and sometimes unfashionable in form or character, while \"retro\" implies reference to a previous style (usually from the mid-20th century) that is still considered desirable and popular for its nostalgic value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "old-fashioned"@en .

aat:300312276 a skos:Concept ;
    skos:definition "Buildings constructed or used to weigh goods as a public service, particularly those buildings constructed before 1800 in European cities prior to the establishment of international standards for weights. Weigh-houses were particularly common in Germany, the Netherlands, and Poland, where they were typically constructed near the town market square, town gate, or port. Authorities also used the facilities to levy taxes on goods transported through or sold within the city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weigh-houses"@en .

aat:300312277 a skos:Concept ;
    skos:definition "Infants' garments worn over a diaper, usually triangular wrappers made of flannel, boiled wool, or tightly knitted wool, used in Western nations until the 1890s when more waterproof materials such as rubberized cloth were available. In modern usage, the term is sometimes used to refer to colorful pants lined with plastic or other waterproof material and used to cover infants' diapers. The term also refers to earlier outer garments for adults, made of animal skin with the fur turned inside and used as a lining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pilches"@en .

aat:300312279 a skos:Concept ;
    skos:definition "Buildings, lots, or other facilities where goods, materials, or vehicles are deposited or stored. For facilities where transportation vehicles stop along a route for the purpose of loading and unloading passengers or goods rather than primarily for the storage of vehicles or goods, use \"stations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depots"@en .

aat:300312280 a skos:Concept ;
    skos:definition "Low-speed carts, cars, or other vehicles that are used for the conveyance of passengers, or occasionally of light loads of goods, relatively short distances, and that use overhead cables or tracks of parallel rails. The rails were originally flat planks of wood; later, lengths of stone or plates of iron that form wheel-tracks for vehicles were used. The tracks may be raised above or flush with the road surface. Trams may be manually or automatically operated, and typically use electricity supplied by the overhead cable or the rails. To refer specifically to manually operated, electrically powered, public passenger rail vehicles running regularly on exclusive right of way along streets, use \"streetcars.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trams"@en .

aat:300312281 a skos:Concept ;
    skos:definition "Institutions that maintain places where objects of value such as works of art, antiquities, scientific specimens, or other artifacts are housed and displayed for public benefit. An institution devoted to the procurement, care, documentation, study and display of objects of lasting interest or value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museums"@en .

aat:300312283 a skos:Concept ;
    skos:definition "Traditional crown-like headdresses worn by Russian girls and women. Originally elements of folk costume intended to support a veil, they developed into diadem-shaped tiaras that were part of the official court dress for royalty and ladies-in-waiting in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kokoshniks"@en .

aat:300312284 a skos:Concept ;
    skos:definition "Early phonographic recording devices of the type invented by Léon Scott de Martinville in 1857, consisting of a horn or barrel focusing sound waves onto a membrane, and creating a visual analogue of soundwaves onto a lampblack-coated cylinder by means of a hog's hair bristle. It was the first sound recording device, but could not reproduce the recorded sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonautographs"@en .

aat:300312285 a skos:Concept ;
    skos:definition "Institutions of higher learning that provide general or liberal arts education leading to bachelor's degrees; may be independent or parts of universities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colleges"@en .

aat:300312286 a skos:Concept ;
    skos:definition "Businesses that employ engineers, who apply technical, scientific and mathematical principles to the design of structures, machines, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "engineering firms"@en .

aat:300312287 a skos:Concept ;
    skos:definition "Assemblies or bodies of people convened for consultation or to administer rules or advice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "councils"@en .

aat:300312289 a skos:Concept ;
    skos:definition "Inclined surfaces designed to facilitate launching of an object, such as missiles or rockets; boats into the water; vehicles or goods onto boats, trains or trucks; targets for trap shooting; or the launching of any other object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "launching ramps"@en .

aat:300312290 a skos:Concept ;
    skos:definition "Eastern Orthodox ecclesiastical stoles, in which the two ends are sewn together and hang straight down in front to the knees or to the floor, with an opening remaining at the top through which the head is passed. The front may also be made of a solid piece of fabric rather than two separate pieces. The sticharion and epitrachelion are held together by the zone (girdle), a narrow belt of stuff with clasps. It differs from the Western church stole in that it hangs straight instead of being crossed over the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epitrachelia"@en .

aat:300312291 a skos:Concept ;
    skos:definition "Buildings housing organizations, societies, or regular meetings for the promotion of a particular literary, scientific, artistic, professional, or educational endeavor that is labeled an \"institute.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "institutes"@en .

aat:300312292 a skos:Concept ;
    skos:definition "The buildings used by an institution, which is a formally structured organization, establishment, or association created for the promotion of a specific benevolent objective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "institutions"@en .

aat:300312294 a skos:Concept ;
    skos:definition "Studios in which one or more master painters create works, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painting studios"@en .

aat:300312295 a skos:Concept ;
    skos:definition "Studios in which one or more master glassmakers create works, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassmaking studios"@en .

aat:300312296 a skos:Concept ;
    skos:definition "Studios in which one or more master photographers create works, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photography studios"@en .

aat:300312297 a skos:Concept ;
    skos:definition "Studios in which one or more master sculptors create works, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture studios"@en .

aat:300312298 a skos:Concept ;
    skos:definition "Studios in which one or more master ceramicists create works, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramics studios"@en .

aat:300312299 a skos:Concept ;
    skos:definition "Studios in which one or more master printmakers create works, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printmaking studios"@en .

aat:300312300 a skos:Concept ;
    skos:definition "Studios in which one or more master designers create designs, supervise assistants, and instruct pupils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design studios"@en .

aat:300312301 a skos:Concept ;
    skos:definition "Institutions that are typically more like museums or archives than libraries, containing the papers and sometimes exhibits about a given U.S. president and his administration. In the U.S., there is a nationwide network of such libraries, administered by the Office of Presidential Libraries which is part of the National Archives and Records Administration (NARA)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presidential libraries"@en .

aat:300312302 a skos:Concept ;
    skos:definition "Institutions that collect and maintain works of art displayed for public benefit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art museums"@en .

aat:300312303 a skos:Concept ;
    skos:definition "Museums specializing in the history of and objects associated with fishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishery museums"@en .

aat:300312304 a skos:Concept ;
    skos:definition "Any of a wide variety of museums where collections are amassed and typically presented to give a chronological perspective of the history of a city, town, region, group of people, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history museums"@en .

aat:300312305 a skos:Concept ;
    skos:definition "Museums devoted to the art, history, and technology of motion pictures, television, and video."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museums of moving images"@en .

aat:300312306 a skos:Concept ;
    skos:definition "Museums specializing in the history of postage stamps, revenue stamps, stamped envelopes, postmarks, post cards, covers, and similar materials relating to postal or fiscal history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philatelic museums"@en .

aat:300312307 a skos:Concept ;
    skos:definition "Museums focusing on the history, tenets, writings, music, architecture, or objects associated with religion, either of one particular religion or on the general topic of religion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious museums"@en .

aat:300312308 a skos:Concept ;
    skos:definition "Museums that specialize in works made from wax, often realistic duplications of actual objects or sculptural portraits of people, especially historical characters. Human figures in wax museums are often dressed in real clothing and posed as if carrying out representative activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wax museums"@en .

aat:300312309 a skos:Concept ;
    skos:definition "Interdisciplinary museums that present the history and heritage of a particular community or region in the context of its society, culture, and natural environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecomuseums"@en .

aat:300312310 a skos:Concept ;
    skos:definition "Museums administered by a historical society, which is a group formed to study and disseminate information about the history of a place, usually a town, city, county, or state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical society museums"@en .

aat:300312311 a skos:Concept ;
    skos:definition "Museums in houses with historical importance locally, regionally, or internationally that have been restored and opened to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic house museums"@en .

aat:300312312 a skos:Concept ;
    skos:definition "Museums located in industrial buildings or complexes that have been expressly converted into a museum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "industrial museums"@en .

aat:300312313 a skos:Concept ;
    skos:definition "Museums dealing with the sea in general, navigation, or shipping, as distinct from \"naval museums,\" which deal with navies, warships, or ships in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maritime museums"@en .

aat:300312314 a skos:Concept ;
    skos:definition "Museums of collections of weapons, armor, uniforms, ammunition, documents, maps, photographs, and other records and artifacts of military forces, leaders, wars, and battles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military museums"@en .

aat:300312315 a skos:Concept ;
    skos:definition "Museums that specialize in the history, objects, vehicles, and other materials associated with flight and space travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeronautical museums"@en .

aat:300312316 a skos:Concept ;
    skos:definition "Museums that focus specifically on the history of space travel and astronauts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronautical museums"@en .

aat:300312317 a skos:Concept ;
    skos:definition "Museums that are founded, run or patronized by local communities, which serve the aspirations and educational needs of the community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community museums"@en .

aat:300312318 a skos:Concept ;
    skos:definition "Museums that are administered by a company, often highlighting the history or products of the company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "company museums"@en .

aat:300312319 a skos:Concept ;
    skos:definition "Museums that are administered by the county, an administrative subdivision in the U.S., the U.K., and other nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "county museums"@en .

aat:300312320 a skos:Concept ;
    skos:definition "Museums that are owned or administered by representatives of multiple nations, or that specializes in exhibitions from multiple nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international museums"@en .

aat:300312321 a skos:Concept ;
    skos:definition "Museums that are owned or administered by representatives of a nation, or that specializes in exhibitions from a given nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national museums"@en .

aat:300312322 a skos:Concept ;
    skos:definition "Museums with collections and exhibits aimed at an audience of children and their education, for example, with texts written at a child's level of understanding and hands-on exhibits intended to maintain a child's interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's museums"@en .

aat:300312323 a skos:Concept ;
    skos:definition "Buildings housing museums containing collections dealing with the properties of natural objects, plants, or animals, such as preserved specimens of birds, mammals, insects, and plants; rocks, minerals, and fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural history museums"@en .

aat:300312324 a skos:Concept ;
    skos:definition "Museums containing collections dealing with the properties of natural objects, plants, or animals, such as preserved specimens of birds, mammals, insects, and plants; rocks, minerals, and fossils. These museums have their origins in the cabinets of curiosities built up by prominent individuals in Europe during the Renaissance and Enlightenment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural history museums"@en .

aat:300312325 a skos:Concept ;
    skos:definition "Museums containing collections dealing with the development and application of science, scientific ideas, technology, and instrumentation. Like museums of natural science and natural history, science museums have their origins in the Enlightenment. Some of them developed from the collections of learned societies, others from private collections"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science museums"@en .

aat:300312326 a skos:Concept ;
    skos:definition "Buildings housing museums containing collections dealing with the development and application of science, scientific ideas, technology, and instrumentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science museums"@en .

aat:300312327 a skos:Concept ;
    skos:definition "Museums dealing with collections having to do with navies, warships, or ships in general; distinct from \"maritime museums,\" which deal with the sea in general, navigation, or shipping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval museums"@en .

aat:300312328 a skos:Concept ;
    skos:definition "Institutions that collect and care for living aquatic animals and plants, often in tanks, for purposes of observation, study, and display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquariums"@en .

aat:300312329 a skos:Concept ;
    skos:definition "Institutions that provide financial services for clients or members, usually able to both accept deposits and make loans. Examples include banks, credit unions, savings associations, trust companies, and industrial loan and thrift companies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "financial institutions"@en .

aat:300312330 a skos:Concept ;
    skos:definition "Institutions that maintain spaces for devices that project celestial images onto the interior of a dome for public viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planetaria"@en .

aat:300312331 a skos:Concept ;
    skos:definition "Buildings housing a learned society called an \"academy,\" which exists for the promotion and education in art, literature, science, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academies"@en .

aat:300312333 a skos:Concept ;
    skos:definition "Institutions that maintain gardens, parks, or other grounds in which wild animals, and sometimes also domestic animals, are kept for public exhibition, usually in enclosures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoos"@en .

aat:300312334 a skos:Concept ;
    skos:definition "Changes of color and texture of Oriental rugs or other textiles over time through wear and when different dyes have been used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrash"@en .

aat:300312335 a skos:Concept ;
    skos:definition "Culture and style of the Elymi, ancient inhabitants of the extreme west of Sicily, a people to whom a Trojan origin was assigned by ancient writers. Their chief centers were at Segesta and at Eryx (Erice). They are archaeologically indistinguishable in the Early Iron Age (ca. 1000-ca. 500 BCE) from their Sicanian neighbors. They were heavily influenced by the style of Greek colonists of Sicily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elymian"@en .

aat:300312336 a skos:Concept ;
    skos:definition "Culture and style of the ancient Siculi people who inhabited eastern Sicily, and for whom the island is named. They may have been relative latecomers to Sicily, arriving from mainland Italy. They are hard to identify archaeologically, although some words of their Indo-European language are known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siculi"@en .

aat:300312337 a skos:Concept ;
    skos:definition "Ancient inhabitants of Sicily in the area west of the Gelas River. According to ancient Greek writers, the Sicani were the aboriginal inhabitants of central Sicily, as distinguished from the Siculi of eastern Sicily and the Elymi of western Sicily. Archaeologically there is no substantial difference between Sicani and Siculi (Sicels) in historical times, but the Greek historian Thucydides believed the Sicani to be Iberians from Spain who were driven by the invading Siculi into the central parts of the island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sicani"@en .

aat:300312338 a skos:Concept ;
    skos:definition "The culture and style of the ancient people who settled in Boiotia during the 3rd millennium BCE, made Orchomenos their capital, and with whom the legends concerning Jason and the Argonauts are associated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minyan"@en .

aat:300312339 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the inhabitants of the island of Sicily, the largest in the Mediterranean, separated from the SW tip of Italy by the narrow Strait of Messina. Strategically positioned between Africa and Europe, Sicily has long been a center of trade routes between East and West and a crossroads for races, peoples and cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sicilian"@en .

aat:300312340 a skos:Concept ;
    skos:definition "Culture and styles of southern Italy, typically referring to any cultures south of Rome, usually those dating from the 18th century or earlier."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Italian"@en .

aat:300312341 a skos:Concept ;
    skos:definition "Professors with the highest ranking position on the staff of a university or college, having full rank and privliges, and in a position higher than associate professors or assistant professors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full professors"@en .

aat:300312342 a skos:Concept ;
    skos:definition "The degrees of academic master, which in modern usage typically indicates the completion of an academic program of one level beyond the bachelor's degree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master's degrees"@en .

aat:300312343 a skos:Concept ;
    skos:definition "The degrees of academic bachelor, which in modern usage typically indicates the completion of an undergraduate course of study that generally requires four years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bachelor's degrees"@en .

aat:300312344 a skos:Concept ;
    skos:definition "Nationality, style, and cultures of the ancient province or the modern geographical district of Apulia in southern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apulian"@en .

aat:300312345 a skos:Concept ;
    skos:definition "Nationality, culture, and styles that originated in Campania, located in southern Italy, on the Tyrrhenian Sea between the Garigliano River and the Gulf of Policastro."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Campanian"@en .

aat:300312346 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the Lucani, a branch of the Sabelline race that inhabited ancient Lucania, which is coextensive with the modern Italian region of Basilicata. For the culture of the city of Lucca, use \"Lucchese.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lucanian"@en .

aat:300312347 a skos:Concept ;
    skos:definition "The study of the nature of art, including interpretation, representation, expression, and form. It is closely related to \"aesthetics,\" which is the philosophical study of beauty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "philosophy of art"@en .

aat:300312348 a skos:Concept ;
    skos:definition "Art museums that contain primarily paintings and other two-dimensional works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pinacotecas"@en .

aat:300312349 a skos:Concept ;
    skos:definition "All examples of a set number or amount of multiples, such as coins, notes, stamps, prints, copies of a newspaper, books, periodicals, etc. that were issued at one time or otherwise sharply distinguished in pattern, design, color, or identifying numbers from those issued at another time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "issues"@en .

aat:300312352 a skos:Concept ;
    skos:definition "Political pamphlets or booklets that lampoon a public figure, particularly such works from France under the Ancien Régime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libelles"@en .

aat:300312353 a skos:Concept ;
    skos:definition "Minor works of literature or music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opuscules"@en .

aat:300312354 a skos:Concept ;
    skos:definition "Small immature leaves, or the individual segments of a compound leaf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaflets"@en .

aat:300312355 a skos:Concept ;
    skos:definition "Numeric, alphanumeric, or other identifying codes assigned when an art object, book, or other item enters the collection of a museum, library, or other repository. Such codes are unique within the set of codes, and specifically identify the particular item at hand. The numbers may be marked on the objects or not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accession numbers"@en .

aat:300312356 a skos:Concept ;
    skos:definition "Paper coated on one or both sides with a mixture of a binder and pigment. The coating provides a smooth, enamel -like surface for writing and printing, producing a brighter appearance, either glossy or matte, and improved printability by preventing ink absorption. A type of coated paper was used as early as 450 CE in China. Uniform machine-made coated papers have been used for over 100 years to provide optimum surfaces for printing. Some of the white pigments used in the coatings are barium sulfate, calcium carbonate, calcium sulfate, calcium sulfite, clay, diatomaceous earth, lead white, satin white, talc, zinc sulfide, lithopone, zinc oxide, and titanium dioxide. Over the years, the binders have changed from the early use of starch to include the use of linseed oil, gums, glues, and waxes. Recently, synthetic resins such as polyvinyl acetate, acrylic, and styrene-butadiene. The coatings are often burnished or calendered to produce a glossy finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coated paper"@en .

aat:300312357 a skos:Concept ;
    skos:definition "Hardware, typically used in the interior of a building, that is usually functional and treated as part of the decorative scheme, such as doorknobs and window latches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finish builders' hardware"@en .

aat:300312358 a skos:Concept ;
    skos:definition "Items of hardware, often made of brass or silver, including screwposts, brads, book clasps, hinges, book closures, coverplates, etc., that are added as functional and decorative finishes at the end of the bookbinding process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "binding finishing hardware"@en .

aat:300312359 a skos:Concept ;
    skos:definition "Small books adapted so as to be conveniently carried in a person's pocket. Use of the term to denote a printed book does not seem to have been common before the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket books"@en .

aat:300312360 a skos:Concept ;
    skos:definition "Flat, folding cases for holding banknotes and papers, and typically of a size designed to fit the inside pocket of a man's jacket of the 19th and early 20th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocketbooks"@en .

aat:300312361 a skos:Concept ;
    skos:definition "Purses, usually with handles or straps, that are designed to be carried in the hand or on the arm and intended as ladies' accessories. Handbags are large enough to carry banknotes, coins, and everyday personal items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handbags"@en .

aat:300312362 a skos:Concept ;
    skos:definition "Containers made of two long rectangular pieces of flexible material, usually leather or textile, sewn together on the two short sides and one long side and open on the remaining long side, designed to carry paper money. The billfold is usually only slightly larger than the bills and is folded in the center. Billfolds are typically men's accessories, carried in the pocket of the trousers or a jacket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billfolds"@en .

aat:300312363 a skos:Concept ;
    skos:definition "Bags of relatively small to medium size, closed at the mouth by drawing tight a thong or drawstrings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purses"@en .

aat:300312364 a skos:Concept ;
    skos:definition "Large, flexible containers made from flax, hemp, another textile, or plastic, oblong in shape, open at one end, and used for storing, transporting, or carrying corn, flour, fruit, potatoes, wood, coal, or other such items. For containers or receptacles of leather, cloth, paper, or other flexible material capable of being closed at the mouth, use \"bags (general containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacks"@en .

aat:300312365 a skos:Concept ;
    skos:definition "The alteration of the light transmission characteristics of glass as a result of prolonged exposure to visible or ultraviolet light. Deterioration can be evident as a change in the color of the glass due to a reaction between the iron and manganese oxides in the glass initiated by light. This irreversible alteration can be a deep purple color, but is more often a subtle change in hue to pink, violet, or yellow. Solarized glass most commonly seen is pink to violet because it contains manganese. Since at least the 2nd century BCE, manganese has been used as a glass decolorizer to diminish the greenish hue imparted by trace amounts of iron. However, with exposure to ultraviolet light, manganese can photo-oxidize to reform manganese dioxide which is violet in color. From the 20th century, seleium and cerium have also been used as decolorizers; when photo-oxidized they impart a yellow to golden hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solarization"@en .

aat:300312366 a skos:Concept ;
    skos:definition "Photographic prints that have been developed by using the sun as a light source, or prints that have been overexposed to light during development, resulting in bronze-tone shadows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solarized prints"@en .

aat:300312367 a skos:Concept ;
    skos:definition "Rooms or closets, usually having a cool temperature, for storage of wine, liquors, and originally also butter and cheeses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butteries"@en .

aat:300312368 a skos:Concept ;
    skos:definition "The physical components of a computer system or device as opposed to the software required for its operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hardware"@en .

aat:300312371 a skos:Concept ;
    skos:definition "Table-long centerpieces of silver or gilt that may carry flowers, fruit and condiments, as well as other items. They typically comprise a platform, often mirrored and set on feet, and upon which are typically placed two candelabras, an epergne, a large bowl on a stand, flat bowls or étagères, and other items, including flowers and various fruits, confections, and sweets displayed in a decorative manner and intended to be eaten as dessert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surtouts-de-table"@en .

aat:300312372 a skos:Concept ;
    skos:definition "Drawings of a pointing hand that were used as symbols in marginalia for marking noteworthy passages in texts, particularly during the 12th through 18th centuries in the Western world. In modern use, the manicule is a typographical symbol employed for similar purposes in texts, the Internet, as bullet symbols, and other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manicules"@en .

aat:300312373 a skos:Concept ;
    skos:definition "Labels applied to crates, usually wooden produce crates, to identify the contents and the grower, maker, or distributor of the fruit, vegetables, nuts, or other produce contained in the crates. Crate labels typically employ art and graphic design; they are often considered valuable by museums and collectors. The art of crate labels flourished in the late-19th through mid-20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crate labels"@en .

aat:300312374 a skos:Concept ;
    skos:definition "Labels applied to tin cans or other metal cans containing food or other household products. Can labels that employ art and graphic design are often considered valuable by museums and collectors. The art of can labels flourished in the late-19th through mid-20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "can labels"@en .

aat:300312377 a skos:Concept ;
    skos:definition "Labels applied by the manufacturer to bottles of liquor, wine, or another substance, noting the name of the maker, vineyard, vintage, ingredients, year of production, etc. Bottle labels may be considered valuable by collectors, and occasionally by museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle labels"@en .

aat:300312378 a skos:Concept ;
    skos:definition "General term for the period of an early culture dating prior to the introduction of ceramic artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pre-ceramic"@en .

aat:300343355 a skos:Concept ;
    skos:definition "Building material comprising squared stonework laid in regular courses of consistent height; though each course may vary in height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coursed ashlar"@en .

aat:300343357 a skos:Concept ;
    skos:definition "Building material comprising roughly squared stone blocks of different sizes laid in courses. The horizontal and vertical joints do not line up consistently and smaller stones may be used to fill in gaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "random ashlar"@en .

aat:300343358 a skos:Concept ;
    skos:definition "Small household items valued as curiosities or rarities, particularly articles of this kind from China, Japan, and elsewhere in the Far East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curios"@en .

aat:300343359 a skos:Concept ;
    skos:definition "Ancient forms of writing originating from Asia, dating to the Shang dynasty (ca. 1600-1046 BCE). Chinese calligraphy evolved from pictographs into the many characters that are written today. Early characters or pictographs have been discovered inscribed into pottery or bone dating back over 4000 years ago. There are five main types of Chinese calligraphy: seal script (zhuan-shu); official script know as clerical script (li-shu); block script called regular script or (kai-shu); semi-cursive script called running script (xing-shu); and cursive script known as grass script or (cao-shu)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese scripts"@en .

aat:300343361 a skos:Concept ;
    skos:definition "Optical, machine readable codes, usually representing numbers, rendered as black and white bars of varying width that carry information; used for entering data or making data legible to a computer system. Bar codes are often used to identify, for pricing, organizing, or distinguish information about one thing, person, or other entity from others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar codes"@en .

aat:300343362 a skos:Concept ;
    skos:definition "Formal descriptions of badges, banners, and flags, or in heraldry, coats of arts, which enables a person to construct or recontruct the appopriate image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blazon"@en .

aat:300343363 a skos:Concept ;
    skos:definition "System for tracking objects or animals using radio signals. Usually employed via a device such as a microchip which transmits radio signals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "RFID"@en .

aat:300343364 a skos:Concept ;
    skos:definition "In heraldry, the top one third of a shield."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chief"@en .

aat:300343365 a skos:Concept ;
    skos:definition "Foundations consisting of flat reinforced concrete slabs or mats or of reinforced concrete tubs with walls turned up around the edge of the mat to create a larger volume, either designed to move with the surface of the ground without structural damage, or used when the soil is so soft that even friction piles will not support the building load. In the latter case, the floating foundation is used because it makes the building like a boat in obeying Archimedes' principle: it is buoyed up by the weight of the earth displaced in creating the foundation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floating foundations"@en .

aat:300343366 a skos:Concept ;
    skos:definition "An early photo reproductive process developed around 1890 in France, using a negative; it was abandoned in favor of simpler halftone screen techniques as they became available. In the typogravure process, the printing plate was cast from a photosensitive gelatin relief, formed when exposed to sunlight through a negative and then washed out. The cast contained many raised peaks of varying sizes from where the gelatin was washed away in relationship to the amount of exposure it received. These peaks could be rolled with ink in the letterpress manner, creating a series of dots that gave the illusion of continuous tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typogravure"@en .

aat:300343367 a skos:Concept ;
    skos:definition "Prints made from half-tone blocks that were prepared by photoengraving using negatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typogravures"@en .

aat:300343368 a skos:Concept ;
    skos:definition "Institutions that exclusively or primarily store, maintain, and care for photographs. May also refer to collections of images stored digitally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photo archives"@en .

aat:300343369 a skos:Concept ;
    skos:definition "Institutions or departments in institutions that exclusively or primarily store, maintain, care for, and make available images in various formats, including slides, photographs, and digital images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual resources collections"@en .

aat:300343370 a skos:Concept ;
    skos:definition "Format configured vertically rather than horizontally in the design of publications, documents, photographs, etc., where the height is greater than the width."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portrait format"@en .

aat:300343371 a skos:Concept ;
    skos:definition "Objects that are specifically designed to be heavy in order to hold down or provide resistance. Examples include round disks designed to be used in lifting to improve physical strength, paperweights, sinkers used for fishing, and pieces of metal or ceramic sewn into a costume or drapery to weigh down a hem or sash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weights"@en .

aat:300343373 a skos:Concept ;
    skos:definition "Newspapers or other serials that are issued or published every day, or every week day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dailies"@en .

aat:300343374 a skos:Concept ;
    skos:definition "Symbol in Tibetan Buddhism and related cultures resembling a complex intertwining cord or ribbon, representing eternity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tibetan knots"@en .

aat:300343375 a skos:Concept ;
    skos:definition "Biologically destructive substances with names given by the company responsible for their production and sale to provide distinction and recognition between similar products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brand name biocides"@en .

aat:300343376 a skos:Concept ;
    skos:definition "Additives with names given by the company responsible for their production and sale to provide distinction and recognition between similar products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brand name additives"@en .

aat:300343377 a skos:Concept ;
    skos:definition "Preservatives with names given by the company responsible for their production and sale to provide distinction and recognition between similar products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brand name preservatives"@en .

aat:300343378 a skos:Concept ;
    skos:definition "Excavations or systems of excavations for the extraction of lead, which is a soft, dense, ductile metal of a dull gray color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead mines"@en .

aat:300343383 a skos:Concept ;
    skos:definition "Libraries containing collections specifically geared towards the needs of children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's libraries"@en .

aat:300343384 a skos:Concept ;
    skos:definition "In Canada and the United States, libraries designated to receive all or selected government publications, with the provision that public access to the collections be provided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depository libraries"@en .

aat:300343385 a skos:Concept ;
    skos:definition "Libraries responsible for films and other moving image materials, including stock footage, films, film clips and/or videotapes; some may include microfilm as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film libraries"@en .

aat:300343386 a skos:Concept ;
    skos:definition "Institutions owning or maintaining collections of photographs, sometimes including other visual resources in various formats and media, usually within larger libraries, archives, or collections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture libraries"@en .

aat:300343387 a skos:Concept ;
    skos:definition "Libraries maintained out of federal government funds and serving the nation as a whole. Their broad function is to collect and preserve the books, periodicals, and newspapers published in the country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national libraries"@en .

aat:300343388 a skos:Concept ;
    skos:definition "Libraries formed by the collections of individuals rather than as a public institution and often devoted to a particular subject or interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private libraries"@en .

aat:300343389 a skos:Concept ;
    skos:definition "Libraries that are available to the public and typically maintained by public funds, as distinguished from libraries available only to a certain group or individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public libraries"@en .

aat:300343390 a skos:Concept ;
    skos:definition "Libraries maintained by state funds, whose broad function is to preserve state records and publications for the use of state officials and citizens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state libraries"@en .

aat:300343391 a skos:Concept ;
    skos:definition "Libraries in a system other than the main or central library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "branch libraries"@en .

aat:300343392 a skos:Concept ;
    skos:definition "Libraries which serve an academic institution, such as a college or university, and which develop their collections to support the programs of their parent institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic libraries"@en .

aat:300343394 a skos:Concept ;
    skos:definition "Privately owned libraries established, supported, and administered by a business firm, private corporation, association, government agency, etc., to meet the needs of its members or staff in pursuing the goals of the organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special libraries"@en .

aat:300343395 a skos:Concept ;
    skos:definition "Libraries intended for the employees of and maintained by a corporation or other business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate libraries"@en .

aat:300343396 a skos:Concept ;
    skos:definition "Libraries consisting of specialized documents, and providing facilities for undertaking exhaustive investigation and research."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research libraries"@en .

aat:300343397 a skos:Concept ;
    skos:definition "Separate, independent, and generally self-sufficient institutions engaging in basic or applied research under contract or as nonprofit organizations. For institutions that support research conducted as part of a larger organization, use \"research centers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "research institutes"@en .

aat:300343399 a skos:Concept ;
    skos:definition "People concerned with the preservation, improvement, and restoration of the natural environment, as well as the policies and politics associated with environmental preservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmentalists"@en .

aat:300343400 a skos:Concept ;
    skos:definition "Refers to African people living in Libya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megarha"@en .

aat:300343401 a skos:Concept ;
    skos:definition "Refers to African people living in Darfur region of the Sudan and in Chad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daju"@en .

aat:300343402 a skos:Concept ;
    skos:definition "Refers to the cultures of the native peoples of Canada. First Nation is one of three groupings of Indigenous people in Canada, the other two being Métis and Inuit. Unlike Métis and Inuit, most First Nations hold reserve lands, and members of a First Nation may live both on and off these reserves. To refer more broadly to refer to all tribes in the Americas, use \"Indigenous Peoples of the Americas (culture).\" To refer collectively to tribes in North America, use \"Native American.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Nations"@en .

aat:300343403 a skos:Concept ;
    skos:definition "Books written specifically as entertainment for children, generally under age 12. These are often illustrated. This definition excludes comic books, books of cartoons, reference or school books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "children's books"@en .

aat:300343405 a skos:Concept ;
    skos:definition "Capitals of the Corinthian architectural order, characterized by having a bell-shaped echinus decorated with a combination of spiral and plant, usually acanthus, motifs; may be either two rows of acanthus leaves or one row of acanthus and one row of palm leaves, volutes, and a fleuron atop an abacus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian capitals"@en .

aat:300343407 a skos:Concept ;
    skos:definition "Motif in the form of the head of a lion, usually a maned African lion. Examples occur in Western and Asian art, for example in carpet designs, spouts and other elements on pottery, and ornamental elements on architecture or furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lion's head"@en .

aat:300343408 a skos:Concept ;
    skos:definition "Pottery characterized by a gray or brownish-gray color, having a relatively simple design that is painted or imprinted. It is common in ancient India, Korea, Native American culture, Greek, Minoan, Roman, Middle Eastern, and many other cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gray ware"@en .

aat:300343409 a skos:Concept ;
    skos:definition "Educational institutions at the elementary-secondary level in which students are in residence while enrolled in an instructional program."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boarding schools"@en .

aat:300343410 a skos:Concept ;
    skos:definition "Educational institutions having facilities and programs that are closely connected with the life and needs of, and may be shared by, the whole community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community schools"@en .

aat:300343411 a skos:Concept ;
    skos:definition "Educational institutions formed by the merging of two or more public schools, usually at the elementary level and often in rural areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consolidated schools"@en .

aat:300343412 a skos:Concept ;
    skos:definition "Educational institutions, usually elementary or secondary schools, where classes are held only on weekdays and that do not provide any boarding facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day schools"@en .

aat:300343414 a skos:Concept ;
    skos:definition "Privately run schools with programs organized as an alternative to traditional public or private schools, usually with a highly flexible or voluntaristic framework."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free schools"@en .

aat:300343415 a skos:Concept ;
    skos:definition "Schools for training horses and teaching people how to handle, breed, and manage horses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manèges"@en .

aat:300343416 a skos:Concept ;
    skos:definition "Schools where equitation is taught; usually including an arena, seating, and housing for horses and equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding schools"@en .

aat:300343417 a skos:Concept ;
    skos:definition "Educational institutions that train people for careers in the armed forces and for private schools organized following the discipline and dress codes of military life; both offer courses in military training and both are generally at university level with degree-granting programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military academies"@en .

aat:300343418 a skos:Concept ;
    skos:definition "Educational institutions for children, having facilities and structured program activities devoted to play, often convening only in the summer; established as an emergency measure during World War I; used both as places for children of working parents and as places for parents and teachers to study the playing habits of children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "play schools"@en .

aat:300343419 a skos:Concept ;
    skos:definition "Educational institutions for training individuals to become policemen, usually in accordance with state requirements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police academies"@en .

aat:300343420 a skos:Concept ;
    skos:definition "Educational institutions located in sparsely populated nonurban areas to provide public, usually elementary, education to local residents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural schools"@en .

aat:300343421 a skos:Concept ;
    skos:definition "Educational institutions administered by the navy, particularly those that provide undergraduate level education for prospective naval officers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval schools"@en .

aat:300343422 a skos:Concept ;
    skos:definition "Educational institutions distinguished from \"universities\" by traditionally providing training for technicians in business, industry, and commerce for an immediate local area, having fewer residence facilities, and offering more part-time classes. For educational institutions emphasizing training in agriculture or specific trades, use \"vocational schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polytechnics"@en .

aat:300343423 a skos:Concept ;
    skos:definition "Educational institutions for training students in the clerical aspects of business and commerce, such as typing and bookkeeping; for schools devoted to the professional study of the aspects of commercial enterprise, use \"business schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business colleges"@en .

aat:300343424 a skos:Concept ;
    skos:definition "Educational institutions devoted to the professional study of the organization and management of commercial enterprises, usually at the baccalaureate level and above. For buildings that house schools devoted to training students in the clerical aspects of business and commerce, use \"business colleges.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "business schools"@en .

aat:300343425 a skos:Concept ;
    skos:definition "Educational institutions devoted to training dentists, who are those whose medical practice is focused on teeth and associated structures of the mouth, involving the prevention, diagnosis, and treatment of disease, injury, or malformation of the teeth, gums, and jaws."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dental schools"@en .

aat:300343426 a skos:Concept ;
    skos:definition "Children's day schools teaching Jewish subject matter or the Hebrew language or both, usually synagogue-based and operated under Conservative or Reform Jewish auspices. For Orthodox Jewish day schools, use \"yeshivas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hebrew schools"@en .

aat:300343427 a skos:Concept ;
    skos:definition "Graduate schools that teach law and the legal profession, with the object of producing professional lawyers, scholars of law, or other professionals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law schools"@en .

aat:300343428 a skos:Concept ;
    skos:definition "Islamic theological or law schools, especially when associated with a mosque, or generally for places of study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madrasas"@en .

aat:300343429 a skos:Concept ;
    skos:definition "Graduate schools of a college or university in which medicine is taught, which is the study of human diseases and injuries, including their causes, treatment, and prevention, and with the diagnosis and management of patients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medical schools"@en .

aat:300343430 a skos:Concept ;
    skos:definition "Educational institutions, generally associated with universities, sponsoring degree-granting programs in a broad range of subjects pertaining to the field of music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music schools"@en .

aat:300343431 a skos:Concept ;
    skos:definition "Educational institutions for training rabbis; for schools providing training in Talmudic law generally, but not necessarily specifically for the rabbinate, use \"yeshivas.\" For schools providing education for the priesthood, use \"theological seminaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbinical seminaries"@en .

aat:300343432 a skos:Concept ;
    skos:definition "Educational institutions associated with Christian churches and mainly for children, in which religious instruction is given on Sundays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sunday schools"@en .

aat:300343433 a skos:Concept ;
    skos:definition "Educational institutions having four-year programs of courses for the training of primary and secondary school teachers and granting bachelor's degrees and often advanced degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teachers colleges"@en .

aat:300343434 a skos:Concept ;
    skos:definition "Educational institutions providing education in theology and religious history, primarily, but not exclusively, to prepare students for jobs as priests, ministers, or church workers; usually sponsored or controlled by a church or other religious organization. For buildings that house schools devoted especially to the training of rabbis, use \"rabbinical seminaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "theological seminaries"@en .

aat:300343435 a skos:Concept ;
    skos:definition "Educational institutions devoted to teaching veterinary medicine and to training veterinarians, who are those whose practice concerns the prevention, control, diagnosis, and treatment of injuries and diseases affecting the health of domestic and wild animals, including the prevention of transmission of animal diseases to other animals and to people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veterinary colleges"@en .

aat:300343436 a skos:Concept ;
    skos:definition "Educational institutions offering instruction in one or more skilled or semiskilled trades or occupations. For educational facilities traditionally training technicians in business, industry, and commerce, usually for an immediate local area, use \"polytechnics.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vocational schools"@en .

aat:300343437 a skos:Concept ;
    skos:definition "Educational institutions that are either Hebrew-English day schools providing both secular and religious instruction, usually operated under Orthodox Jewish auspices, or schools providing training in Talmudic law and which may ordain rabbis. For educational institutions specifically devoted to the training of rabbis, use \"rabbinical seminaries.\" For buildings that house day schools operated under Reform or Conservative Jewish auspices, use \"Hebrew schools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yeshivas"@en .

aat:300343438 a skos:Concept ;
    skos:definition "Independent professional schools of music emphasizing advanced instruction in performance for singers, conductors, and musicians; usually granting certificates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music conservatories"@en .

aat:300343439 a skos:Concept ;
    skos:definition "The absence of clothes in which the absence implies embarrassment at being deprived of clothes or in which the depiction of the nude is intended to cause embarrassment or salacious feelings in the viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nakedness"@en .

aat:300343440 a skos:Concept ;
    skos:definition "Educational institutions that are established, conducted, and primarily supported by a nongovernmental agency and available to a limited set of students."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "private schools"@en .

aat:300343441 a skos:Concept ;
    skos:definition "Educational institutions maintained at public expense for the education of children of a community or district as part of a free education system; generally includes elementary and high schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public schools"@en .

aat:300343442 a skos:Concept ;
    skos:definition "Elementary or secondary schools operated, controlled, or supported by a church or other religious body. While the term literally refers to a school's relationship to an ecclesiastical parish, in common usage, control of the school may instead belong to another division of a church other than parish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parochial schools"@en .

aat:300343443 a skos:Concept ;
    skos:definition "Private schools intended to prepare students for more advanced formal education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preparatory schools"@en .

aat:300343444 a skos:Concept ;
    skos:definition "Schools serving or supported by a parish, particularly an ecclesiastical parish and usually providing religious education as well as conventional education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parish schools"@en .

aat:300343445 a skos:Concept ;
    skos:definition "Schools that originated in medieval Europe and were run by cathedral clergy with the original goal of training priests. These schools later developed into institutions that also taught lay students, usually boys of noble families who were being prepared for high positions in church, state, or commercial affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedral schools"@en .

aat:300343446 a skos:Concept ;
    skos:definition "Schools serving or supported by an ecclesiastical diocese, often including training in theology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diocesan schools"@en .

aat:300343447 a skos:Concept ;
    skos:definition "Private schools, usually for girls, that emphasized training in domestic skills, cultural behavior, and social activities, allowing young ladies of certain social classes to be \"finished\" prior to their introduction into the traditional adult female role in polite society. In addition to limited training in general education, finishing schools typically taught subjects such as manners, posture, needlework, drawing, meal planning, wardrobe planning, the art of conversation, supervision of child care, singing, dance, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finishing schools"@en .

aat:300343448 a skos:Concept ;
    skos:definition "Buildings that house schools providing education between primary or elementary education and the higher or university level education, differing by school district in grades included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary schools"@en .

aat:300343449 a skos:Concept ;
    skos:definition "Educational institutions for the level between primary or elementary education and the higher or university level education, usually including the last three or four years of the twelve-year school education program. In most systems, secondary schools include the last years of middle or junior high school and all of high school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary schools"@en .

aat:300343450 a skos:Concept ;
    skos:definition "Educational institutions providing the first stage of compulsory education, generally extending from grade 1 through grades 6 or 8 and teaching the rudiments of learning; may house a kindergarten."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elementary schools"@en .

aat:300343451 a skos:Concept ;
    skos:definition "Educational institutions for the second stage of a three-tier educational system, falling intermediate between an elementary school and an upper, senior, or high school. The age ranges and grades or forms included in middle schools differ according to the system, but an example would be for children ages 13 to 16, covering grades 6 through 9."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "middle schools"@en .

aat:300343452 a skos:Concept ;
    skos:definition "Educational institutions for the third level of (usually compulsory) education for children, entered after elementary school and middle or junior high school. The grades or forms included in high schools vary by location, but often include grades 9 to 12. If the school district has no middle or junior high school, high school may include grades 7 to 12."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high schools"@en .

aat:300343453 a skos:Concept ;
    skos:definition "Educational institutions teaching at a level intermediate between elementary school and high school. The term is used primarily in North America, and usually covers grades 7 through 9. In some areas, usage with \"middle schools\" may overlap; however, most school systems that have a middle school typically do not also have a junior high school. Middle schools in most areas accept children a year or two younger than those in junior high schools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junior high schools"@en .

aat:300343454 a skos:Concept ;
    skos:definition "Second-level educational institutions, in France or based on a similar system, where the school is maintained by the state in contradistinction to a college or secondary school maintained by a municipality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lycées"@en .

aat:300343455 a skos:Concept ;
    skos:definition "Educational institutions in Britain or in a system based on or similar to Britain's, where students in the last two years of secondary school study for entry into advanced schools, including preparation for qualifying exams such as A-levels, GCSEs, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixth-form colleges"@en .

aat:300343456 a skos:Concept ;
    skos:definition "Plants with prostrate or low spreading growth that cover the surface of the earth and that smother weeds. Generally used in landscaping in place of turf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groundcover"@en .

aat:300343457 a skos:Concept ;
    skos:definition "Large bath structures filled with hot aerated water, originally made of wood but more frequently constructed with plastic or fiberglass impregnated with resin. Typically used for recreation or physical therapy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot tubs"@en .

aat:300343458 a skos:Concept ;
    skos:definition "Institutions that provide continuing education programs, which focus on postsecondary instruction designed to advance or update adults in areas of personal, academic, or professional development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continuing education centers"@en .

aat:300343459 a skos:Concept ;
    skos:definition "Institutions devoted to the instruction of adults. Types of lyceums include specific literary institutions established in the early 19th century and those established later to provide popular lectures on literary and scientific subjects, public discussions, concerts, and other activities for furthering general education. In some nations, the term is used for universities or colleges. The term is derived from the proper name of a garden with covered walks in Athens where Aristotle taught philosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lyceums"@en .

aat:300343460 a skos:Concept ;
    skos:definition "Universities that are financially supported by a state government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state universities"@en .

aat:300343461 a skos:Concept ;
    skos:definition "Universities located in and serving urban communities, although not necessarily maintained by municipalities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban universities"@en .

aat:300343462 a skos:Concept ;
    skos:definition "Educational institutions that are publically funded and without residential facilities, serving the educational needs of a specific community. The term may also refer to buildings housing secondary schools or sixth-form colleges that make the spaces available to the local community out of school hours for educational and recreational purposes; typically British usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community colleges"@en .

aat:300343463 a skos:Concept ;
    skos:definition "Educational institutions at the post-high school level, offering a two-year program of study of a terminal nature or in preparation for continued college studies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "junior colleges"@en .

aat:300343464 a skos:Concept ;
    skos:definition "Colleges that are financially supported by a state government, either the government of a U.S. state or the national government of certain other nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state colleges"@en .

aat:300343465 a skos:Concept ;
    skos:definition "Educational institutions serving pupils in the year prior to their entering the first grade, typically at age five. In many educational systems, kindergarten is part of a public school program, typically lasting half-days and serving as a transition from home to full days of formal schooling; children are taught to develop basic skills through creative play, social interaction, and rudimentary classroom education is begun. In the past, and today in some places, kindergarten includes very little or no classroom instruction, serving instead as a preschool or daycare program. The term comes from the German for \"garden for children.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kindergartens"@en .

aat:300343466 a skos:Concept ;
    skos:definition "Educational institutions for children too young for kindergarten and compulsory education, but old enough to take part in certain educational and social activities, typically from around ages three to five. Nursery school differs from day care in that facilities are typically staffed by qualified professionals who encourage and supervise educational play rather than simply providing childcare."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursery schools"@en .

aat:300343468 a skos:Concept ;
    skos:definition "Rooms or areas in domestic architecture set aside for the care of babies and young children, distinguished from \"night nurseries,\" which contain only bedding and supplies for nighttime care. Day nurseries typically serve as playrooms and schoolrooms. They are also distinguished from \"day care centers,\" which are public or private facilities for the care of groups of children, while the day nursery is in the children's home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day nurseries"@en .

aat:300343469 a skos:Concept ;
    skos:definition "Institutions for education and/or care of children before they are eligible for elementary or primary school."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pre-primary schools"@en .

aat:300343470 a skos:Concept ;
    skos:definition "Educational institutions that focus entirely or partially on religious instruction and theology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious schools"@en .

aat:300343472 a skos:Concept ;
    skos:definition "Institutions exclusively or primarily serving or sponsored by a particular religious group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious institutions"@en .

aat:300343473 a skos:Concept ;
    skos:definition "Institutions that are staffed and equipped for the diagnosis of disease, for medical and surgical treatment of the sick and the injured, and for their housing during this process. The modern hospital also often serves as a center for investigation and for teaching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospitals"@en .

aat:300343474 a skos:Concept ;
    skos:definition "Welfare institutions, often charitable, for the reception, care, and housing of pilgrims, travelers, or the needy. The term was originally reserved for the similar establishments of the Knights Hospitallers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospitals"@en .

aat:300343475 a skos:Concept ;
    skos:definition "Healthcare institutions for outpatient care, often where patients receive treatment, often at reduced fees. The term also refers to hospital departments devoted to a particular group of diseases, such as a psychiatric clinic, neurology clinic, or surgery clinic, whether or not fees are reduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinics"@en .

aat:300343476 a skos:Concept ;
    skos:definition "A lithographic printing process achieved by drawing with lithographic chalk, also called crayon, on a grained stone roughened by fine sand. The drawing chalk or crayon adheres to the grain, making shading possible. Applied ink adheres to the chalked area, and is then transferred to paper for the final print."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalk lithography"@en .

aat:300343477 a skos:Concept ;
    skos:definition "Buildings that house institutions of confinement and correction, using hard labor and strict discipline with a view to reformation of the inmates; especially those dating to the 16th century and later in Europe and colonial America. For general reference to buildings housing any institution of correction, use \"correctional institutions (buildings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "houses of correction"@en .

aat:300343478 a skos:Concept ;
    skos:definition "Institutions of a local government having facilities for both temporary detention of sentenced and unsentenced individuals and for persons serving sentences of less than one year; for longer periods of confinement and more secure than lockups, but less confining and for shorter confinements than prisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jails"@en .

aat:300343479 a skos:Concept ;
    skos:definition "Institutions having facilities where people are legally committed as punishment for a crime or while awaiting trial. In North America, the term specifically denotes a facility run by the state or federal government for those who have been convicted of serious crimes, in contrast to a locally run facility for those awaiting trial or convicted of minor offences. Use \"jails (institutions)\" for facilities for offenders sentenced either for lesser crimes or relatively short terms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prisons"@en .

aat:300343480 a skos:Concept ;
    skos:definition "Penal institutions that provide educational and vocational training among other methods for reforming behavior of youthful offenders or first offenders of minor crimes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reformatories"@en .

aat:300343481 a skos:Concept ;
    skos:definition "Institutions overseeing the confinement and labor of people impoverished or otherwise unable to pay debts, particularly during 17th-19th century in Europe and America, especially those established under the various Poor Laws of England. These institutions eventually degenerated into dumping places for impoverished people, criminals, infirm, elderly, and the mentally ill. For similar institutions intended to provide punishment and reformation of the criminal, use \"houses of correction (institutions).\" For institutions providing charitable care for the poor, use \"almshouses (institutions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workhouses"@en .

aat:300343482 a skos:Concept ;
    skos:definition "Prisons administered by a federal government; in the U.S., those managed by the U.S. Federal Bureau of Prisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federal prisons"@en .

aat:300343483 a skos:Concept ;
    skos:definition "Institutions tasked to hold and detain members of the armed forces, in the U.S., particularly who have been convicted of violations of the Uniform Code of Military Justice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military prisons"@en .

aat:300343484 a skos:Concept ;
    skos:definition "Prisons administered by the state, particularly a state in the U.S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state prisons"@en .

aat:300343485 a skos:Concept ;
    skos:definition "General term for institutions overseeing facilities in which people accused or convicted of breaking the law may be confined and which may or may not attempt some form of reform or rehabilitative correction of offenders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "correctional institutions"@en .

aat:300343487 a skos:Concept ;
    skos:definition "Locally administered public or private institutions for care of the homeless, disabled, and elderly without means; often operated in conjunction with a farm, with emphasis on meeting operating costs through the sale of farm produce. Almshouses incurred widespread criticism after the turn of the 20th century for failure to provide differentiated treatment for the varying problems presented by residents. For earlier institutions where the disabled, elderly poor, or vagrants were confined for reform and work, use \"workhouses (institutions).\" For institutions established solely for the distribution of alms, use \"almonries (institutions).\" Buildings where the indigent or otherwise helpless without further recourse are cared for and put to work at public expense; in the United States, established since the mid-18th century and usually funded by local or state governments or parishes; in England, originally under the administration of monasteries for dispensing alms, later endowed by private charities. For buildings where the disabled, elderly poor, or vagrants are confined for reformative and correctional purposes, use \"workhouses.\" For places established solely for the distribution of alms, use \"almonries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almshouses"@en .

aat:300343488 a skos:Concept ;
    skos:definition "Institutions founded by or maintained by a monastery, abbey, magistrate, nobleman, or private charity for the reception and support of the aged and poor; may also contain the residence of almoners; especially those dating from the Medieval and later periods in Europe. For institutions where the elderly, poor, or helpless were cared for and put to work at public expense, use \"almshouses (institutions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almonries"@en .

aat:300343489 a skos:Concept ;
    skos:definition "Particular types of institutions of confinement and correction, using hard labor and strict discipline with a view to reformation of the inmates; especially used for such institutions established in the 16th century and later in Europe and colonial America. For general reference to all institutions of correction, use \"correctional institutions (institutions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "houses of correction"@en .

aat:300343490 a skos:Concept ;
    skos:definition "Generally refers to prisons for those convicted of major crimes. The term derives from the type of prison authorized by the British 1779 Penitentiary Act, enforcing strict discipline and hard labor intended to reform as well as punish. Given that, in modern systems, most prisons include reformatory or correctional functions, the original distinction is lost and the term \"penitentiary\" often refers to any \"prison\" in common usage. In the United States, penitentiaries are state or federal prisons that are reserved for the detention of convicted felons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penitentiaries"@en .

aat:300343491 a skos:Concept ;
    skos:definition "In the United Kingdom, buildings placed on the Statutory List of Buildings of Special Architectural or Historic Interest. Such buildings are deemed to have unique architectural or historical importance, as identified through periodic surveys; they are protected from demolition or alteration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "listed buildings"@en .

aat:300343492 a skos:Concept ;
    skos:definition "Infrared spectroscopy having the range of 400-4,000 inverse centimeters [cm-1]."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mid-infrared spectroscopy"@en .

aat:300343493 a skos:Concept ;
    skos:definition "Infrared spectroscopy having the range of 10-400 inverse centimeters [cm-1]."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "far-infrared spectroscopy"@en .

aat:300343494 a skos:Concept ;
    skos:definition "Technique of painting on pottery and other supports, where the design is reserved in unpainted areas against a colored background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negative painting"@en .

aat:300343495 a skos:Concept ;
    skos:definition "Pulverized material made from flux, sand or other refractory that has been fused with heat but not fully vitrified; often used in making glazes and may contain a coloring ingredient which will give the glaze coloring throughout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frit"@en .

aat:300343497 a skos:Concept ;
    skos:definition "Preparing a clay object for firing by trimming away seams and other blemishes with a metal tool; especially used upon clay objects formed with molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fettling"@en .

aat:300343498 a skos:Concept ;
    skos:definition "Fur from a European polecat, dark in color. It is used in the fur trade. It is also used in paint brushes, valued for its elasticity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fitch"@en .

aat:300343499 a skos:Concept ;
    skos:definition "Mixture of beeswax and lampblack used for making rubbings and polishing the shoes, particularly the edges of the soles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heelball"@en .

aat:300343500 a skos:Concept ;
    skos:definition "Technique of blowing for the purpose of coloring or decorating. An example is in decorating porcelain, where powdered pigment is blown through a hollow tube, passing through a piece of gauze attached at the other end to ensure that the pigment spreads evenly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insufflation"@en .

aat:300343501 a skos:Concept ;
    skos:definition "An inferior type of gum arabic derived from various species of the Acacia genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "babool gum"@en .

aat:300343502 a skos:Concept ;
    skos:definition "A type of high quality gum arabic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acacia gum"@en .

aat:300343503 a skos:Concept ;
    skos:definition "The practice of arranging and modifying proportion so that the heads of figures are aligned at nearly the same horizontal level; particularly prevalent in Greek reliefs and friezes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isocephaly"@en .

aat:300343504 a skos:Concept ;
    skos:definition "The process by which something becomes firm and rubbery; particularly used to describe the hardening of oil paints in the tube or can caused by impurities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livering"@en .

aat:300343505 a skos:Concept ;
    skos:definition "Process of making a cast or an impression from a ready made or natural object, particularly part of the body; plaster of Paris frequently used in this technique; sometimes used for creating life masks and death masks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moulage"@en .

aat:300343506 a skos:Concept ;
    skos:definition "Corresponding nob and grove which hold the parts of a mold in alignment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natches"@en .

aat:300343507 a skos:Concept ;
    skos:definition "Additive color system devised by chemist Wilhelm Ostwald; based on 24 foundation colors arranged in a disc; each then have white and black added to form tints or shades; used predominantly in the mid-twentieth century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostwald system"@en .

aat:300343508 a skos:Concept ;
    skos:definition "A detail within a painting that is subordinate to the main theme of the work; an example would be a still life within a portrait painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parerga"@en .

aat:300343509 a skos:Concept ;
    skos:definition "General term for wood obtained from various Brazilian trees of the genera Aspidosperma or Paratecoma. The red or rosa peroba produces a pink hardwood while the white peroba gives wood that is a pale olive to a dark brown in color. The wood has a straight grain and a fine uniform texture. It is strongly resistant to insect, fungi and to acids. Peroba wood is used for furniture, flooring, paneling, veneers, and carving. All types are durable and fine-grained, used for fine furniture, cabinetry, flooring, and carvings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peroba"@en .

aat:300343510 a skos:Concept ;
    skos:definition "Areas in a fresco completed at the same level of a scaffolding leaving rectilinear seams in the finished work; generally appear in large Roman, Byzantine, and 13th century frescoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pontate"@en .

aat:300343511 a skos:Concept ;
    skos:definition "In plaster, the appearance of small, cone-shaped holes up to a quarter inch in diameter; caused by the expansion of lime or foreign material and occurring between three months and up to one year after the plaster has set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popping"@en .

aat:300343512 a skos:Concept ;
    skos:definition "Additions or details added to a work after the work was complete, usually signfying an addition that is inappropriate, superfluous, or in poor taste; generally used with architecture or sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postiches"@en .

aat:300343513 a skos:Concept ;
    skos:definition "Process by which clay is prepared for throwing; consists of cutting sections of clay with a wire and then pounding or kneading by hand to expel air pockets and to make the consistency of the clay more pliable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedging"@en .

aat:300343514 a skos:Concept ;
    skos:definition "Small pyramid or cone shaped made from various refractory materials and intended to melt at different temperatures; used in kilns where temperature is not automatically regulated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrometric cones"@en .

aat:300343515 a skos:Concept ;
    skos:definition "An oil paint glaze applied over flesh tones with the fingertips to form shadows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sfregazzi"@en .

aat:300343516 a skos:Concept ;
    skos:definition "Ceramic glaze defect stemming from poor glaze fit or high compression and causing pieces of glaze to flake or raise off the clay body; frequently occurs along ridges and rims."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shivering"@en .

aat:300343517 a skos:Concept ;
    skos:definition "Small fragments of glass, pottery, stone or other brittle object with a sharp or ragged edge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spalls"@en .

aat:300343518 a skos:Concept ;
    skos:definition "Systems of signaling by means of musical sounds devised by Sudré in 1828, and for other early forms of telephone systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telephony"@en .

aat:300343519 a skos:Concept ;
    skos:definition "Open land as opposed to woodland or land occupied by buildings; for land appropriated for pasture or tillage, use \"agricultural land.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fields"@en .

aat:300343520 a skos:Concept ;
    skos:definition "Pieces of soft, miry, or muddy ground, particularly areas of thoroughfares that are filled with wet mud or mire and impassable by vehicles, horses, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sloughs"@en .

aat:300343521 a skos:Concept ;
    skos:definition "Marshy or reedy pools, ponds, small lakes, backwaters, or inlets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slews"@en .

aat:300343522 a skos:Concept ;
    skos:definition "In ceramics, the application of clay formed in a press mold to the main form of a vessel to create relief decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprigging"@en .

aat:300343523 a skos:Concept ;
    skos:definition "Glaze used predominantly in Japan for stoneware but first developed in China during the Sung Dynasty; characterized by its dark black and brown coloration and streaking largely attributable to the iron-oxide it contains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temmoku"@en .

aat:300343524 a skos:Concept ;
    skos:definition "Technique of emphasizing shadows, darkness or night effects within a painting; generally the use of such shadowing obscures figures within the painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenebrism"@en .

aat:300343525 a skos:Concept ;
    skos:definition "Yellow wood with dark stripes obtained from the species Lavoa klaineana, native to Africa. Tigerwood has a naturally glossy surface with a fine uniform texture. It is used for furniture, veneer, gunstocks, inlay, billiard tables, and cabinets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tigerwood"@en .

aat:300343526 a skos:Concept ;
    skos:definition "The process of dispersing particles and breaking up lumps within a substance in order to create greater fluidity; frequently used in ceramics to convert clay into slip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deflocculation"@en .

aat:300343527 a skos:Concept ;
    skos:definition "In ceramics, cracking that occurs during firing or cooling due to a rapid changes in temperature; can occur in bisquits or glazed ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dunting"@en .

aat:300343528 a skos:Concept ;
    skos:definition "First firing of a clay object which turns the greenware into a hardened object that may be glazed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biscuit firing"@en .

aat:300343529 a skos:Concept ;
    skos:definition "The process of separating out finer particles in a mixture from courser ones by washing or decanting; often used in ceramics to create more finely grained clay body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elutriation"@en .

aat:300343530 a skos:Concept ;
    skos:definition "Portable slabs or flat surfaces used for throwing or hand-building clay objects, or supporting works in a kiln; may be attachments to potter's wheels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bats"@en .

aat:300343532 a skos:Concept ;
    skos:definition "The swelling of clay objects during firing as gases are released in the vitrification process; sometimes caused by overfiring and occurs either generally or in small areas; generally considered a defect in pottery but sometimes desirable in nonbearing bricks for construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bloating"@en .

aat:300343534 a skos:Concept ;
    skos:definition "Term used for the second firing of ceramic wares to achieve the fusing of the glaze and the biscuit fired ceramic object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glost firing"@en .

aat:300343536 a skos:Concept ;
    skos:definition "Works, such as keepsakes, made from hair; usually from human hair but occasionally also from the hair of a beloved pet. The hair is often braided and arranged in decorative patterns, entwined over wire forms, etc. While hair is the primary medium of such works, seed pearls, glass beads, ribbons, dried flowers, and other materials may be included. Hairworks are often memorials, typically worn or displayed as a mourning ornament in memory of the donor of the hair. However, they may also be made from the hair of living individuals, such as the members of a family or of a church congregation. Hairwork was popular during the Victorian era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairwork"@en .

aat:300343537 a skos:Concept ;
    skos:definition "Decorative works using human hair, sometimes animal hair of pets, formed into designs forming a horseshoe-shaped wreath that was typically placed on a silk or velvet background and framed. Hair wreaths were often memorials using the hair of one or more deceased family members. The arms of the horseshoe were placed at the top of the design, where additional hair from new donors could be placed over time, and symbolizing arms pointed heavenward. This craft was popular during the Victorian period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair wreaths"@en .

aat:300343538 a skos:Concept ;
    skos:definition "Hand work in textiles, wire, or other delicate materials that is decorative or ornamental, as opposed to strictly plain or functional. Fancy work includes needlework, crochet, knitting, hairwork, works using folded or woven paper as a medium (rather than or in addition to having paper as the support), metal wire, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fancy work"@en .

aat:300343545 a skos:Concept ;
    skos:definition "Seeds produced by the species Cicer arietinum. These yellow brown seeds are borne one or two to a pod and are an important food staple in India, Africa, and Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chick-pea"@en .

aat:300343549 a skos:Concept ;
    skos:definition "Trees considered to have supernatural powers, curative properties, or ritual significance, often marked by affixing rags or other objects on their branches. Trees venerated in this way are not specific to any culture or period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacred trees"@en .

aat:300343551 a skos:Concept ;
    skos:definition "Part of a loom that resembles a comb consisting of evenly spaced wires called dents. The warp threads are threaded between the dents. The reed controls the number of threads per inch and keeps their spacing even."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reeds"@en .

aat:300343554 a skos:Concept ;
    skos:definition "Stylized motif of the burdock plant, genus Arctium, used in carpet patterns to guard against bad luck or to symbolize abundance. It is a diamond shaped motif, often with a smaller diamond in the middle, of which the distinguishing aspect is the small lines or hooked lines radiating from the outermost diamond to represent small burrs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burdock"@en .

aat:300343565 a skos:Concept ;
    skos:definition "General term for the prickly leaved species of Carduus and Cirsium genera, or weedy species of Echinops, Sonchus, and other plant genera of the family Asteraceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thistle"@en .

aat:300343567 a skos:Concept ;
    skos:definition "A knot consisting of two interwoven ovals reminiscent of a cross, often with multiple strands. It may represent a labyrinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solomon's knots"@en .

aat:300343571 a skos:Concept ;
    skos:definition "A person who shines shoes for a living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe-shiners"@en .

aat:300343573 a skos:Concept ;
    skos:definition "Motifs in carpets and other contexts often consisting of a vertical row of triangles, diamonds or lozenges with a bar between each extending to the sides with another diamond on the end. There are usually diamonds or bars on the top and bottom of the motif. It represents a desire to marry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairbands"@en .

aat:300343574 a skos:Concept ;
    skos:definition "Earring-shaped motifs that may represent marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earrings"@en .

aat:300343575 a skos:Concept ;
    skos:definition "Four opposing sets of rams horns, usually with a diamond in the middle. The four sets often appear within a gül."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaikalaks"@en .

aat:300343576 a skos:Concept ;
    skos:definition "Specifically refers to a distinctive style of script having connecting strokes between characters and extremely fluid writing style, including the following distinctive characteristics: radicals are simplified into symbols or marks and one may stand for another; strokes are continuous and structures of characters are relatively plain; the text includes blank spaces between characters and rows; changes may occur in the thickness of each brushstroke and darkness of ink. It has been regarded as the script that can best represent a calligrapher's personal expressions and emotions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cursive script"@en .

aat:300343577 a skos:Concept ;
    skos:definition "Scripts cast or carved on Chinese bronze wares, appearing during the Shang, Western Zhou, and Eastern Zhou periods; were especially popular in the Western Zhou (11th century BCE to 771 BCE). Bronze scripts were derived from oracle bone scripts, and are considered by later antiquarians as containing primitive and archaic aesthetic values."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bronze script"@en .

aat:300343578 a skos:Concept ;
    skos:definition "An ancient Chinese calligraphic script developed during the Han dynasty (206 BC to 200 CE) and widely adopted for official and educational purposes. It developed from seal script (zhuanshu), originating in the brush writing of the later Zhou and Qin dynasties. It first appeared in the Qin Dynasty (221-226 BCE), and came into its mature form during the Eastern Han dynasty (late 3rd century BCE). Though somewhat square and angular, with strong emphasis on the horizontal strokes, the lishu is a truly calligraphic script type, making full use of the flexible brush to modulate the thickness of the line. Many Han examples survive, written with a brush on bamboo slips or carved in stone. Characters were approximately uniform in size and evenly spaced within a composition, but the construction of characters and individual strokes varied greatly. The main characteristics of the clerical script are its angular strokes, which replaced the rounded lines in the seal script, and its simplified character structures, which defied the six principles of Chinese characters. Clerical script laid the foundation for the development of later scripts, including the standard or regular script, the running or semi-cursive script, and the cursive script. A prisoner Cheng Miao is said to have created this script, and the new style of writing became popular among prison workers for clerical documents and transcriptions. At the end of the Han dynasty the lishu developed into the more supple and fluent kaishu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clerical script"@en .

aat:300343579 a skos:Concept ;
    skos:definition "Known as the earliest cursive writing in China, it appeared during the Eastern Han (25-220 CE) as an abbreviated form of clerical script. Though the strokes within a single character are connected together, each character stands alone without linking to another. The brushstrokes still preserve characteristics of clerical script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "draft cursive script"@en .

aat:300343580 a skos:Concept ;
    skos:definition "Chinese script narrowly defined as the writing carved on stones dated before the Qin dynasty (221-206 BCE), as represented by Zhou wen. Appearing around the Zhou dynasty, the great seal script evolved from the oracle bone script, but the character structures became neater and tidier. The term is used generally for all writings made before the Qin, including oracle bone inscriptions, bronze inscriptions, Zhou wen, and those used in the Six States during the Eastern Zhou."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great seal script"@en .

aat:300343581 a skos:Concept ;
    skos:definition "Style of Chinese clerical script characterized by an exaggeration of sweeping strokes that differs from Qin clerical script. The clerical script from the Western Han Dynasty seen in bamboo and wooden slips and silk manuscripts is very similar to the Qin clerical script; however, during the Eastern Han Dynasty, the script evolved into the so-called bafen script with aforementioned stroke exaggerations (visually similar to the tail of a goose). The typical works written in bafen were the engravings on stelae from the late Eastern Han. They were recognized as fine arts due to their well-balanced forms and fluent strokes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Han clerical script"@en .

aat:300343582 a skos:Concept ;
    skos:definition "Chinese script that evolved from the draft cursive script, and began to appear during the final years of the Han dynasty in the 2nd century CE. Its creation was accredited to Zhang Zhi and was later perfected by Wang Xizhi and his son Xianzhi in the 4th century CE. It is characterized by accelerated writing, continuous strokes, fluid movements, and expressiveness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern cursive script"@en .

aat:300343583 a skos:Concept ;
    skos:definition "Script of the most ancient Chinese writing so far discovered; the characters are inscribed on tortoise shells or animal bones as records of divination carried out by the royals in the latter half of the Shang dynasty (14th to 11th century BCE). The vast majority of the oracle bones were excavated from the modern Xiaotun Village of Anyang City, Henan Province (or Yinxu, the ruins of the last capital of the Shang dynasty)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oracle bone script"@en .

aat:300343584 a skos:Concept ;
    skos:definition "Early form of the Chinese clerical script that still retains many features of the seal script; was used primarily for writing office documents and for correspondence on daily matters. Examples are found among brushed writings on bamboo and wooden slips and silk manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qin clerical script"@en .

aat:300343585 a skos:Concept ;
    skos:definition "Semicursive Chinese script that developed out of the Han dynasty lishu script at the same time that the standard kaishu script was evolving (1st-3rd century CE). The characters of Chinese running script are not abbreviated or connected, but strokes within the characters are often run together. The characteristic continuous brushstrokes of this script are more easily written than the more formal clerical and standard/regular script, but the running characters are more controlled and legible than Chinese cursive script. This is the most common script used in daily informal writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running script"@en .

aat:300343586 a skos:Concept ;
    skos:definition "A type of Chinese running script that combines characteristics from both the running and the cursive scripts. It is similar to the cursive script, but strokes are more scratchy than the running script, while being more easily legible than the Chinese cursive script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running-cursive script"@en .

aat:300343587 a skos:Concept ;
    skos:definition "Style of Chinese script joining elements of running and the standard scripts. It is less cursive than the typical running script, and thus more easily legible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running-standard script"@en .

aat:300343588 a skos:Concept ;
    skos:definition "Script based on the stamping seal style. Generally refers to the ancient Chinese written scripts dating before the Han clerical script, including the great seal script and the small seal script. Generally speaking, written scripts before the Qin dynasty are called the great seal script. After the state of Qin united China in 211 BCE, a team of officials led by Li Si, the Prime Minister at that time, standardized the written scripts, and the new script is called the small seal script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seal script"@en .

aat:300343589 a skos:Concept ;
    skos:definition "Chinese script developed after the First Emperor of Qin unified China in 221 BCE, when he adopted Li Si's suggestion to standardize writing. The standardized script is called the small seal script, as opposed to the great seal scripts before the Qin. The standardized small seal script features round, neat, and well-balanced strokes and structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small seal script"@en .

aat:300343590 a skos:Concept ;
    skos:definition "Chinese script that is a simplified stylization of clerical script; the clerical script was transformed into a more fluent and easily written form. Characterized by clear-cut corners and straight strokes of varying thickness, this script emerged by the end of the Han Dynasty, and became popular during the Wei, Jin and Southern and Northern periods. It underwent its most vital period of development and was the most important type of script during the Tang dynasty (618-907), when a successful career in the civil service depended in part on skill as a calligrapher. It remains the standard script in use today and the model for public function and printed type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "standard script"@en .

aat:300343591 a skos:Concept ;
    skos:definition "Style of Chinese script that is the most unrestricted among cursive scripts, first seen in the 8th century CE. It is so named because it features writing in fast speed, linking strokes and characters together. In addition, the characters are sometimes greatly varied in size and shape. It is particularly valued for its untrammeled and uninhibited quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wild cursive script"@en .

aat:300343592 a skos:Concept ;
    skos:definition "Depictions in which the entire body of the person is portrayed, as contrasted to a portrait of only the face, a bust, or a half-length portrayal. The sitter may be standing or sitting in his or her entirety, and is often portrayed life-size or larger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-length figures"@en .

aat:300343594 a skos:Concept ;
    skos:definition "Paint mixed with metallic oxides, often extended with vinegar and diluted with a spirit-based or gum arabic-based thinner. Used in stained glass painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitreous paint"@en .

aat:300343595 a skos:Concept ;
    skos:definition "Persons who perform the dramatic entertainment known as mime, where action and emotion are conveyed without words, using gestures and bodily movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mimes"@en .

aat:300343596 a skos:Concept ;
    skos:definition "Paint having gold as a pigment, often in combination with another pigment of similar color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilt paint"@en .

aat:300343597 a skos:Concept ;
    skos:definition "The action of clasping in one's arms, usually referring to one person holding another person as a sign of fondness or friendship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embracing"@en .

aat:300343598 a skos:Concept ;
    skos:definition "Inlaid works in which pieces of hard, polished stone have been set into marble or another hard surface; a Florentine specialty often used for decorative table tops and small wall panels. The singular form, \"pietra dura,\" is used within Italy to refer to works incorporating a single type of stone; but outside Italy it refers to works using combinations of stones. Pietra dura works were carved in classical Rome, and the techniques for cutting such hard stones were revived in 16th-century Florence, where a workshop established under the patronage of Grand Duke Cosimo I de' Medici produced decorative panels; the workshop was refounded in 1588 as the Opificio delle Pietre Dure. The hardstones used are semi-precious stones, typically agate, chalcedony, jasper and lapis lazuli, but do not include marble or precious stones. Stones of the requisite hardness for such work generally fall between 6 and 10 on Mohs' scale of hardness, i.e. between orthoclase and diamond (lapis lazuli being the notable exception)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra dura"@en .

aat:300343599 a skos:Concept ;
    skos:definition "Order of monocotyledonous flowering plants, containing 16-24 families, 1,122 genera, and more than 26,000 species. The order has only recently been recognized in classification systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asparagales"@en .

aat:300343600 a skos:Concept ;
    skos:definition "The Iris family of perennial herbs is worldwide in distribution, numbering more than 2000 species. It includes many widely cultivated plants such as freesias, gladioli, and crocuses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iridaceae"@en .

aat:300343602 a skos:Concept ;
    skos:definition "Genus comprising around 300 species of flowering plants; from the Greek word for a rainbow, referring to the wide variety of flower colors found among species. Irises are natives of Europe, northern Africa, and temperate regions of Asia and America; most species have tuberous (less commonly bulbous or fibrous) roots, sword-shaped equitant leaves, and showy flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iris"@en .

aat:300343603 a skos:Concept ;
    skos:definition "Residences built for or inhabited by royalty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal residences"@en .

aat:300343604 a skos:Concept ;
    skos:definition "Social standing in the estimation of others; influence or reputation derived from achievements, associations, or character, or past success."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prestige"@en .

aat:300343606 a skos:Concept ;
    skos:definition "Actions intended to bring something or someone into renewed existence; rebirth or restoration of a person, thing, geographical area, etc. by improvements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regenerations"@en .

aat:300343607 a skos:Concept ;
    skos:definition "Family of the flowering plants consisting of 23 genera and 637 species of short-stemmed, often woody plants distributed throughout tropical, subtropical, and temperate areas of the world. Members of the family have narrow, lance-shaped, sometimes fleshy or toothed leaves that are clustered at the base of each plant. Most species have large flower clusters containing many flowers. The fruit is a capsule or berry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agavaceae"@en .

aat:300343608 a skos:Concept ;
    skos:definition "The skin of a lion, generally with hair including mane attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lion skins"@en .

aat:300343610 a skos:Concept ;
    skos:definition "Refers to the architectural, interior and product design style that generally describes mid-20th century trends from ca. 1933 to 1965. The term was first used in the book \"Mid-Century Modern: Furniture of the 1950s\" (1983) by Cara Greenberg. In architecture, the style is characterized by the International Style and Bauhaus movements, the work of Frank Lloyd Wright and Mies van der Rohe. In design, sleek Scandinavian style furniture and objects were influential."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mid-Century Modernist"@en .

aat:300343612 a skos:Concept ;
    skos:definition "Stately dances for two in moderate triple time, often taking the overall form of minuet-trio-minuet. The musical form was included in operas, Classical chamber works, and symphonies. The minuet originated in France and dominated aristocratic European ballrooms, particularly in France and England, from ca. 1650 to ca. 1750; over time, the dances became increasingly complex and stylized. Reputedly derived from the French folk dance \"branle de Poitou.\" Some forms of the dance acquired more specific names, notably the \"minuet de la cour.\" The court minuet used smaller steps and became slower and increasingly etiquette-laden and spectacular. It was especially popular at the court of Louis XIV of France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minuets"@en .

aat:300343613 a skos:Concept ;
    skos:definition "Women at the time of their marriage, or during the times just prior to or immediately after marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brides"@en .

aat:300343614 a skos:Concept ;
    skos:definition "Men at the time of their marriage, or during the times just prior to or immediately after marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bridegrooms"@en .

aat:300343615 a skos:Concept ;
    skos:definition "Papers, drawings, plans, letters, and other documents, either hard copy or digital, having to do with the construction of buildings, usually originating in an architect's office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural documents"@en .

aat:300343616 a skos:Concept ;
    skos:definition "Movements in the sea or other collection of water, by which a portion of the water rises above the normal level and then subsides, at the same time travelling over the surface; a moving ridge or swell of water between two depressions or troughs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waves"@en .

aat:300343617 a skos:Concept ;
    skos:definition "The beech order of dicotyledonous woody flowering plants, comprising nearly 1,900 species in 55 genera. Members of Fagales represent some of the most important temperate deciduous or evergreen trees of both hemispheres, including oaks, beeches, walnuts, hickories, and birches. Fagales contains eight families: Betulaceae, Fagaceae, Juglandaceae, Casuarinaceae, Nothofagaceae, Myricaceae, Rhoipteleaceae, and Ticodendraceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagales"@en .

aat:300343618 a skos:Concept ;
    skos:definition "Betulaceae is the birch family of flowering plants, usually placed in the order Fagales; some authorities, however, have placed the family in the order Betulales. The family contains six genera and 120-150 species. Although not done in this hierarchy, it is elsewhere sometimes divided into two subfamilies: Betuloideae, with the genera Betula (birch) and Alnus (alder); and Coryloideae, with the genera Carpinus (hornbeam), Corylus (hazel, or filbert), Ostrya, and Ostryopsis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betulaceae"@en .

aat:300343619 a skos:Concept ;
    skos:definition "Genus containing about 30 species of ornamental shrubs and trees that are primarily north temperate in distribution, but range south through the Andes to about latitude 20 degrees S. It is only in the Americas that members of the family extend along the mountains into the Southern Hemisphere. An alder may be distinguished from a birch by its usually stalked winter buds and by cones that remain on the branches after the small, winged nutlets are released. The scaly bark is grayish brown in some species and almost white in others. The oval leaves are alternate, serrate, and often shallowly lobed; sticky on unfolding but glossy when mature, they fall without changing colour. Male and female flowers are borne in separate catkins on the same tree; they form during the summer and usually blossom the following spring before the leaves open."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus"@en .

aat:300343620 a skos:Concept ;
    skos:definition "Points or period in the course of a day or of the diurnal cycle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "times of day"@en .

aat:300343621 a skos:Concept ;
    skos:definition "The first appearance of light in the sky at or immediately before sunrise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dawn"@en .

aat:300343622 a skos:Concept ;
    skos:definition "The time after sunset but before it is quite dark at night."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dusk"@en .

aat:300343623 a skos:Concept ;
    skos:definition "Species of aromatic-leaved green alder native to the Northeastern North America and Greenland. In some classifications, a subspecies of Alnus viridis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus crispa"@en .

aat:300343624 a skos:Concept ;
    skos:definition "Species of aromatic-leaved green alder native to western North America and far northeastern Siberia. In some classifications, a subspecies of Alnus viridis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus sinuata"@en .

aat:300343625 a skos:Concept ;
    skos:definition "Species of alder native to Europe, the British Isles, and Africa, and cultivated in the United States. Known as black alder for its dark bark and cones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus glutinosa"@en .

aat:300343626 a skos:Concept ;
    skos:definition "Species of European shrub having sharply pointed, bright green leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus viridis"@en .

aat:300343627 a skos:Concept ;
    skos:definition "Species of alder native to west coastal North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus rubra"@en .

aat:300343629 a skos:Concept ;
    skos:definition "Species of alder found in the United States, native to three distinct areas: Oklahoma, Georgia, and in Maryland and Delaware on the Delmarva Peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus maritima"@en .

aat:300343630 a skos:Concept ;
    skos:definition "The early part of the day, particularly the period from sunrise until noon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "morning"@en .

aat:300343631 a skos:Concept ;
    skos:definition "The time from mid-day to evening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "afternoon"@en .

aat:300343632 a skos:Concept ;
    skos:definition "Twelve o'clock in the day, or the time when the sun reaches the meridian. Originally, referred to the ninth hour of the day, reckoned from sunrise according to the Roman method, or about three o'clock in the afternoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noon"@en .

aat:300343633 a skos:Concept ;
    skos:definition "The latter part of the day, usually the time from about sunset until bedtime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening"@en .

aat:300343634 a skos:Concept ;
    skos:definition "The apparent ascent of the sun above the horizon, signaling the beginning of the day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunrise"@en .

aat:300343635 a skos:Concept ;
    skos:definition "The apparent descent of the sun below the horizon, signaling the closing of the day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunset"@en .

aat:300343637 a skos:Concept ;
    skos:definition "General name for any of several species of green alder that grow in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American green alder"@en .

aat:300343638 a skos:Concept ;
    skos:definition "Fast-growing tropical bombaceous tree native to the Caribbean region, Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ochroma lagopus"@en .

aat:300343639 a skos:Concept ;
    skos:definition "Genus of evergreen conifers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cedrus"@en .

aat:300343640 a skos:Concept ;
    skos:definition "Species of deciduous tree in the mahogany family that is native to India, southern China, and Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melia azedarach"@en .

aat:300343641 a skos:Concept ;
    skos:definition "Genus containing 12 species of ornamental and timber evergreen conifers native to warm temperate regions in the northern hemisphere, including western North America, Central America, northwest Africa, the Middle East, the Himalaya, southern China, and north Vietnam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cupressus"@en .

aat:300343643 a skos:Concept ;
    skos:definition "Genus containing around 50 species of evergreen conifers in the family Pinaceae. They are found through much of North and Central America, Europe, Asia, and North Africa, generally occurring in mountains. They are most closely related to the cedars (Cedrus); Douglas-firs are not true firs, being of the genus Pseudotsuga."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abies"@en .

aat:300343644 a skos:Concept ;
    skos:definition "Genus containing 14 species of coniferous evergreen trees native to North America and central and eastern Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsuga"@en .

aat:300343645 a skos:Concept ;
    skos:definition "Wood of the coniferous evergreen Juniperus virginiana species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red juniper"@en .

aat:300343646 a skos:Concept ;
    skos:definition "Species of juniper native to eastern North America, from southeastern Canada to the Gulf of Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juniperus virginiana"@en .

aat:300343647 a skos:Concept ;
    skos:definition "Genus containing 60 to 70 species of aromatic evergreen trees or shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juniperus"@en .

aat:300343648 a skos:Concept ;
    skos:definition "Genus comprising 10 to 12 species of coniferous trees native to cool and sub-Arctic parts of the northern hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Larix"@en .

aat:300343649 a skos:Concept ;
    skos:definition "Wood of the Arbutus menziesii tree, which is generally located in the Pacific Northwest of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pacific madrona"@en .

aat:300343650 a skos:Concept ;
    skos:definition "Species of Arbutus found on the west coast of North America, from British Columbia, chiefly Vancouver Island and the Gulf Islands, to California. It is a broadleaf evergreen tree with rich orange-red bark that peels away on the mature wood, leaving a greenish, silvery, smooth appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arbutus menziesii"@en .

aat:300343652 a skos:Concept ;
    skos:definition "Genus containing around 45 species of spiny, deep rooted trees and shrubs found in subtropical and tropical regions of the Americas, Africa, Western Asia, and South Asia. They form extensive thickets in areas from South America into the southwestern United States. Two races occur, one low (called running mesquite) and the other often growing into trees 15 m (50 feet) tall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prosopis"@en .

aat:300343653 a skos:Concept ;
    skos:definition "Species of mesquite of the Chilean Matorral ecoregion of central Chile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prosopis chilensis"@en .

aat:300343654 a skos:Concept ;
    skos:definition "Family of dicotyledon plants, placed within the order Myrtales. Myrtle, clove, guava, feijoa, allspice, and eucalyptus belong here. All species are woody, having essential oils and flowering parts in multiples of four or five."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myrtaceae"@en .

aat:300343655 a skos:Concept ;
    skos:definition "Genus, often classified as containing 2 species of flowering evergreen shrubs or small trees native to southern Europe, northern Africa, and found in Australia and New Zealand, having leaves containing a fragrant essential oil, a star-like flower, and a fruit that is a round blue-black berry containing several seeds. Authorities differ widely over the number of species the genus includes. True myrtles have a central midrib and a major vein just inside and parallel to the leaf margin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myrtus"@en .

aat:300343656 a skos:Concept ;
    skos:definition "Species of myrtle widespread in the Mediterranean region; commonly cultivated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myrtus communis"@en .

aat:300343657 a skos:Concept ;
    skos:definition "Species of small deciduous tree or large shrub belonging to the mulberry family, Moraceae, typically growing to 8-15 m (26-49 ft) tall. It is dioeceous, with male and female flowers on different plants. The multiple fruit is bumpy and spherical, 7-15 cm in diameter, filled with a sticky white latex sap. In fall, it turns a bright yellow-green color and has a faint odor similar to that of oranges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maclura pomifera"@en .

aat:300343658 a skos:Concept ;
    skos:definition "Genus containing about 90 species of ornamental and timber evergreen conifers in the family Pinaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus"@en .

aat:300343659 a skos:Concept ;
    skos:definition "General name referring to various species of cedar, pine, and sequoia of the cypress family, including the coast redwood, dawn redwood, giant sequoia, Japanese cedar, and Scotch pine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redwood"@en .

aat:300343660 a skos:Concept ;
    skos:definition "Species of coniferous evergreen timber tree of the cypress family, found in the fog belt of the coastal range from southwestern Oregon to central California, at elevations up to 1,000 metres (3,300 feet) above sea level. They are the tallest living trees, often exceeding 90 m (300 feet) in height. Trunks reach typical diameters of 3 to 6 m (10 to 20 feet) or more. The coast redwood tree takes 400 to 500 years to reach maturity, and some trees are known to be more than 1,500 years old. The leaves on the main shoots are spirally arranged, scalelike, and closely appressed to the branches; those of the lateral shoots are spreading, needlelike, and arranged in two rows. As the tree ages, the lower limbs fall away, leaving a clear, columnar trunk. When a tree is cut, sprouts arise from the sapwood below the cut surface. Natural reproduction occurs through seed production, although only a small percentage of the seeds germinate unless exposed to fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sequoia sempervirens"@en .

aat:300343661 a skos:Concept ;
    skos:definition "Genus of conifers represented by a single living species, Metasequoia glyptostroboides, from central China. Fossil representatives, such as M. occidentalis, dated to about 90 million years ago during the Late Cretaceous Period, are known throughout the middle and high latitudes of the Northern Hemisphere. Climatic cooling and drying that began about 65.5 million years ago and continued throughout the Cenozoic Era caused the geographic range of the dawn redwood to contract to its present relic distribution. The leaves are arranged in pairs on deciduous branchlets, and this deciduous character probably accounts for the tree's abundance in the fossil record. Metasequoia is closely related to the Sequoia and Sequoiadendron genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Metasequoia"@en .

aat:300343662 a skos:Concept ;
    skos:definition "Genus of conifers of the cypress family, comprising one living species, Sequoia sempervirens. The giant sequoia was formerly included in this genus. The sequoia is native in the fog belt of the Coast Ranges from southern Monterey county, California, to southern Oregon, U.S., and the big tree occurs in scattered groves on the westerly slopes of the Sierra Nevada from Placer to Tulare counties in California. Fossil remains of Sequoia as old as the Jurassic Period (about 200 to 145.5 million years ago) are widely dispersed in the Northern Hemisphere. The bald cypress and dawn redwood are closely related to Sequoia. The name for the genus commemorates the great Cherokee Indian Sequoyah (or Sequoya)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sequoia"@en .

aat:300343663 a skos:Concept ;
    skos:definition "Class of conifers dating from the Late Carboniferous to the present, comprising 6 living families, with 62 genera and 515 species. It includes primarily trees, having scalelike, needlelike, or flat and bladelike leaves and compact wood. Seeds are borne on the upper surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinopsida"@en .

aat:300343664 a skos:Concept ;
    skos:definition "Plan of a building or city that is arranged within a circle, usually a centralized plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular plan"@en .

aat:300343665 a skos:Concept ;
    skos:definition "Plan of a building or city that is arranged within a square, usually a centralized plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square plan"@en .

aat:300343666 a skos:Concept ;
    skos:definition "Order containing all living conifers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinales"@en .

aat:300343667 a skos:Concept ;
    skos:definition "The family of Taxodiaceae was formerly regarded as a distinct plant family containing ten genera of coniferous trees: Athrotaxis, Cryptomeria, Cunninghamia, Glyptostrobus, Metasequoia, Sciadopitys, Sequoia, Sequoiadendron, Taiwania, and Taxodium. Based on genetic research, it is now generally accepted that all genera except Sciadopitys are actually part of the family Cupressaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taxodiaceae"@en .

aat:300343668 a skos:Concept ;
    skos:definition "Conifer family containing around 30 genera (17 monotypic) with around 140 species with worldwide distribution. They are monoecious, subdioecious, or occasionally dioecious trees and shrubs from 1-116 m (3-379 ft) tall. The bark of mature trees is commonly orange- to red- brown and of stringy texture, often flaking or peeling in vertical strips, but smooth, scaly or hard and square-cracked in some species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cupressaceae"@en .

aat:300343669 a skos:Concept ;
    skos:definition "Genus of woody flowering plants, either trees or shrubs. Most are root parasites that photosynthesize their own food but tap the roots of other species for water and inorganic nutrients. Several species, most notably S. album, produce highly aromatic wood, used for scents and perfumes and for herbal medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santalum"@en .

aat:300343670 a skos:Concept ;
    skos:definition "Species of long-lived, woody, flowering plant; the most commonly known source of sandalwood. This species has been long valued, harvested, and cultivated for its fragrant wood and medicinal qualities of essential oil. Currently, the wild population is vulnerable to extinction; very few sizable trees exist, thus it is not currently much used for fine woodworking; harvest of new trees is viable only after 40 years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santalum album"@en .

aat:300343671 a skos:Concept ;
    skos:definition "Genus of around 35 species of coniferous evergreen trees in the family Pinaceae, order Pinales, found in northern temperate and boreal. Mature trees may be 20-60 m (66-200 feet) tall. They are distinguished from similar genera by whorled branches, conical form, with needle-like leaves attached singly to the branches in a spiral fashion, and rough rather than smooth branches. As needles are shed throughout the life of the tree, the branches retain a rough appearance from the pulvinus, to which the needles had been attached. Comprises around 40 species of evergreen ornamental and timber trees native to the temperate and cold regions of the Northern Hemisphere. They are pyramidal trees with whorled branches and thin, scaly bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea"@en .

aat:300343672 a skos:Concept ;
    skos:definition "Family of over 230 species, including cedars, firs, hemlocks, larches, pines, and spruces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinaceae"@en .

aat:300343673 a skos:Concept ;
    skos:definition "Genus containing 8 species of small coniferous trees or shrubs in the family Taxaceae, distributed throughout the Northern Hemisphere. They are relatively slow growing, long-lived, and reach heights of 1-40 m, with trunk diameters of up to 4 m. Yews have rich, dark-green foliage with branches that are erect or spreading, closely covered with flattened, linear leaves. Other trees are called \"yew,\" but are not true yews of this genus, including the plum-yew, Prince Albert yew, and stinking yew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taxus"@en .

aat:300343674 a skos:Concept ;
    skos:definition "Family containing 3 genera of 7 to 12 species of coniferous plants, or in alternative classifications, 6 genera of 30 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taxaceae"@en .

aat:300343675 a skos:Concept ;
    skos:definition "Wood from trees of the Thuja genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arborvitae"@en .

aat:300343676 a skos:Concept ;
    skos:definition "Genus containing 5 species of resinous, evergreen ornamental and timber conifers of the cypress family (Cupressaceae), native to North America and eastern Asia. The genus is monophyletic and sister to Thujopsis or false arborvitae. Arborvitae are trees or shrubs, usually pyramidal in habit, with thin, scaling outer bark and fibrous inner bark, horizontal or ascending branches, and characteristically flattened, spraylike branchlet systems. Each branchlet has four rows of tiny, scalelike leaves. Juvenile leaves are much longer and needlelike and in some species may persist along with the mature foliage. Male and female reproductive structures (cones) are borne at the tips of different branchlets of the same tree, the male cones rounded and reddish or yellowish, the female very small and green or tinged with purple. They are commonly known as arborvitae (from Latin for tree of life) or thujas; several species are widely known as cedar but they are not true cedars (Cedrus)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thuja"@en .

aat:300343677 a skos:Concept ;
    skos:definition "Species of ornamental and timber evergreen conifer of the cypress family, native to eastern North America, growing to 20 m (65 feet) tall. It is the most common and probably the hardiest of the arborvitae. Its trunk is sometimes forked near the ground into several main stems covered with reddish brown bark. The cones have 8 to 10 scales, of which only four are usually fertile. Most cultivated varieties are narrow, densely pyramidal shrubs, and many have interesting variations in foliage color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thuja occidentalis"@en .

aat:300343678 a skos:Concept ;
    skos:definition "Species of cedar native to the Atlas Mountains of Algeria and Morocco. Some classifications list it as a subspecies of Lebanon Cedar, as C. libani atlantica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cedrus atlantica"@en .

aat:300343679 a skos:Concept ;
    skos:definition "Species of large, evergreen, coniferous cedar tree native to the western Himalayas in eastern Afghanistan, northern Pakistan, northern India, southern Tibet, and western Nepal, occurring at altitudes of 1500-3200 m altitude, reaching heights of 40-50 m tall, with a conical crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cedrus deodara"@en .

aat:300343680 a skos:Concept ;
    skos:definition "Species native to western North America, from central western Oregon to northwest Mexico. It reaches heights of 40-60 m and a trunk diameter of up to 3 m, having a broad conic crown of spreading branches. This tree is the preferred host of a wood wasp, Syntexis libocedrii which lays its eggs in the smoldering wood immediately after a forest fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calocedrus decurrens"@en .

aat:300343681 a skos:Concept ;
    skos:definition "Genus containing 3 species of coniferous trees in the cypress family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calocedrus"@en .

aat:300343682 a skos:Concept ;
    skos:definition "The names for subfamilies Old World deer (subfamily Cervinae) and the New World deer (subfamily Capreolinae) reflect where the deer originally evolved; however, now it is not a geographical distinction but instead derives from their different foot structures. In the Old World deer the second and fifth hand bones (metapodia) have almost completely disappeared except for proximal, terminal remnants. In the New World deer the remnants are distal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cervinae"@en .

aat:300343683 a skos:Concept ;
    skos:definition "The names for subfamilies Old World deer (subfamily Cervinae) and the New World deer (subfamily Capreolinae) reflect where the deer originally evolved; however, now it is not a geographical distinction but instead derives from their different foot structures. In the Old World deer the second and fifth hand bones (metapodia) have almost completely disappeared except for proximal, terminal remnants. In the New World deer the remnants are distal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capreolinae"@en .

aat:300343684 a skos:Concept ;
    skos:definition "In some classifications, Hydropotes is considered a third subfamily of the family Cervidae, along with Old World deer (subfamily Cervinae) and New World deer (subfamily Capreolinae). This subfamily was created to contain the Chinese water deer (Hydropotes inermis), a very small Asian deer of the family Cervidae (order Artiodactyla), native to fertile river bottoms in Korea and the Yangtze River (Chang Jiang) valley in China. It is the only species of deer in which males lack antlers; instead, they are armed with long, curved, and sharp upper canine teeth that protrude from the mouth. These tusks may exceed 5 cm (2 inches) in length. The water deer is also the only deer with inguinal glands. Although water deer resemble extinct primitive deer in lacking antlers, they evolved from ancestors with antlers that were subsequently lost. Their morphology indicates that they are New World deer. Males stand about 50 cm (20 inches) tall at the shoulder and weigh up to 13 kg (29 pounds); females weigh up to 11 kg (24 pounds). They have a rather uniformly colored coat, yellowish brown above and yellowish white below. The tail is very short, and there is no rump patch. Their coarse, thick coat and fur-covered ears are adaptations to cold, snowy winters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydropotes"@en .

aat:300343685 a skos:Concept ;
    skos:definition "Soldier armed with a halberd, particularly certain civic guards carrying a halberd as a badge of office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halberdiers"@en .

aat:300343686 a skos:Concept ;
    skos:definition "Genus containing one living species of marsh deer (Blastocerus dichotomus)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Blastocerus"@en .

aat:300343687 a skos:Concept ;
    skos:definition "Genus containing the taruca (Peruvian guemal, north Andean deer, Hippocamelus antisensis) and Chilean huemul (south Andean deer, Hippocamelus bisulcus)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippocamelus"@en .

aat:300343688 a skos:Concept ;
    skos:definition "Genus containing several species of brocket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mazama"@en .

aat:300343689 a skos:Concept ;
    skos:definition "Genus containing the mule deer and white tail deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odocoileus"@en .

aat:300343690 a skos:Concept ;
    skos:definition "Genus containing the pampas deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ozotoceros"@en .

aat:300343691 a skos:Concept ;
    skos:definition "Genus containing two species of pudu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pudu"@en .

aat:300343692 a skos:Concept ;
    skos:definition "Subfamily containing the genus Muntiacus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muntiacinae"@en .

aat:300343693 a skos:Concept ;
    skos:definition "Genus containing several species of muntjacs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muntiacus"@en .

aat:300343694 a skos:Concept ;
    skos:definition "Genus containing 1 species, Thorold's deer (white-lipped deer, Przewalskium albirostris)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Przewalskium"@en .

aat:300343695 a skos:Concept ;
    skos:definition "Genus containing 3 species of deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rucervus"@en .

aat:300343696 a skos:Concept ;
    skos:definition "Genus containing 4 species of deer and sambar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rusa"@en .

aat:300343697 a skos:Concept ;
    skos:definition "Genus containing 4 species of deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Axis"@en .

aat:300343698 a skos:Concept ;
    skos:definition "Genus containing 1 species, Père David's deer (Elaphurus davidianus)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elaphurus"@en .

aat:300343699 a skos:Concept ;
    skos:definition "Genus containing 2 species of living deer and one extinct deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dama"@en .

aat:300343700 a skos:Concept ;
    skos:definition "Genus containing 2 species of extinct deer, the Giant Deer (Megaloceros giganteus) and the Sardinian dwarf deer (Megaloceros cazioti)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megaloceros"@en .

aat:300343701 a skos:Concept ;
    skos:definition "Species of medium-sized, gregarious deer of western North America distinguished by large ears, striking pelage markings, large antlers, a distinctive leaping run, scent glands, a black-tipped tail, male antlers that are bifurcated, or \"fork\" as they grow rather than as a white-tailed deer's branching from a single main beam. Recent DNA analysis indicates that the mule deer is apparently a rather recent form that arose from hybridization of female white-tailed and male black-tailed deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odocoileus hemionus"@en .

aat:300343702 a skos:Concept ;
    skos:definition "Species of deer found in western North America, primarily in the Pacific Northwest region. Some classifications regard it as a subspecies of mule deer. However, recent DNA analysis indicates that the mule deer is apparently a rather recent form that arose from hybridization of female white-tailed and male of the ancient black-tailed deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odocoileus columbianus"@en .

aat:300343703 a skos:Concept ;
    skos:definition "Species of medium-sized, common American deer that covers a huge range from the Arctic Circle in western Canada to 18 degrees south of the Equator in Peru and Bolivia. The white-tailed deer get its name from the long white hair on the underside of the tail and rump, which is evident during flight. The white-tailed deer predates the Ice Ages and is the oldest extant deer species. It became abundant only after the last glaciation when the indigenous Ice Age fauna of the Americas became extinct and competitive and predation pressures were lifted. Its high speed in running, its legendary skills at hiding, and its ability to move silently reflect severe pressure from extinct American Ice Age predators. Although the white-tailed deer of North and South America are currently classified as one species (with several subspecies), genetic research indicates that these deer are further apart than are white-tailed and black-tailed deer in North America so their classification is likely to change in the future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odocoileus virginianus"@en .

aat:300343704 a skos:Concept ;
    skos:definition "General term used for wood from any of several species of the genera Cedrela, Dysoxylon, Guazuma, and Icica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bastard cedar"@en .

aat:300343705 a skos:Concept ;
    skos:definition "Species of cedar native to the mountains of the Mediterranean region, in Lebanon, western Syria and south central Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cedrus libani"@en .

aat:300343706 a skos:Concept ;
    skos:definition "Species of mahogany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cedrela oaxacensis"@en .

aat:300343707 a skos:Concept ;
    skos:definition "Species of tropical American timber tree of the mahogany family (Meliaceae), prized for its aromatic wood, having small flowers borne in branched clusters; each fruit is a capsule containing many winged seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cedrela odorata"@en .

aat:300343708 a skos:Concept ;
    skos:definition "Wood of Toona sinensis, an Asian mahogany (not really cedar)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese cedar"@en .

aat:300343709 a skos:Concept ;
    skos:definition "Species of Toona native to eastern and southeastern Asia. Used as an ornamental, as a food, and for its hard and reddish timber in furniture making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toona sinensis"@en .

aat:300343710 a skos:Concept ;
    skos:definition "Species of mahogany tree growing throughout southern Asia from Afghanistan to Papua New Guinea and Australia. It grows best in an environment with high light levels; in the relative darkness of the rainforest understory it is susceptible to moth attack. Cultivated for timber and as a shade tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toona ciliata"@en .

aat:300343711 a skos:Concept ;
    skos:definition "Genus containing 5 species of trees in the mahogany family Meliaceae, native from Afghanistan south to India, and east to North Korea, Papua New Guinea and eastern Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toona"@en .

aat:300343712 a skos:Concept ;
    skos:definition "Species of medium-sized evergreen native to the eastern Mediterranean region, in northeast Libya, southeast Greece (Crete, Rhodes), southern Turkey, Cyprus, Northern Egypt, western Syria, Lebanon, Israel, Malta, Italy, western Jordan, and Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cupressus sempervirens"@en .

aat:300343713 a skos:Concept ;
    skos:definition "General term referring to wood from several species, including Chamaecyparis thyoides (Atlantic White Cypress), Cupressus lusitanica (Mexican White Cedar), and Thuja occidentalis (Eastern Arborvitae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white cedar"@en .

aat:300343714 a skos:Concept ;
    skos:definition "Species of evergreen native to Oregon and elsewhere in the U.S., growing to 60 m (200 feet) in height and 6 m (about 20 feet) in diameter. It is a very hardy tree, having over 200 forms cultivated as ornamentals in North America and Great Britain. Many of these are dwarfs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cupressus lawsoniana"@en .

aat:300343715 a skos:Concept ;
    skos:definition "Species of tree in North America, 21 to 27 m (70 to 90 feet) tall. It is an economically important timber tree, also having many cultivated varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chamaecyparis thyoides"@en .

aat:300343716 a skos:Concept ;
    skos:definition "Species of evergreen tree native to the west coast of North America, from the Kenai Peninsula in Alaska, south to northernmost California, typically occurring on wet sites in mountains, often close to the tree line, but sometimes also at lower altitudes. It reaches 40 m tall, commonly with pendulous branches. Due to morphological anomalies, its classification has been changed several times, and is likely to do so in the future due to recent research, perhaps moving it to a new genus Callitropsis or Xanthocyparis, together with the newly discovered Vietnamese Golden Cypress Xanthocyparis (Callitropsis) vietnamensis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chamaecyparis nootkatensis"@en .

aat:300343717 a skos:Concept ;
    skos:definition "Species of small to medium-sized North American fir, native to most of eastern and central Canada and the northeastern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abies balsamea"@en .

aat:300343718 a skos:Concept ;
    skos:definition "Species of fir tree native to the mountains of the eastern United States and Canada. It is closely related to Abies balsamea (balsam fir), of which it was formerly treated as a subspecies. It is cultivated as a Christmas tree due to its fragrance, shape, strong limbs, and ability to retain its soft needles after being cut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abies fraseri"@en .

aat:300343719 a skos:Concept ;
    skos:definition "Species of North American fir tree having several forms, one with reflexed bracts, that are sometimes considered to be separate species. Trees may reach heights in excess of 90 m (295 feet) and have diameters of more than 4 m (13 feet), but most contemporary stands are composed of trees that are much smaller, due to the fact that many old specimens have been logged. It is noted as one of the best timber trees in North America, as well as a popular ornamental and Christmas tree, and is used for reforestation along the Pacific Coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pseudotsuga menziesii"@en .

aat:300343720 a skos:Concept ;
    skos:definition "Wood from the species Pseudotsuga menziesii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coast Douglas fir"@en .

aat:300343721 a skos:Concept ;
    skos:definition "Genus containing 6 species of coniferous evergreen timber trees native to western North America and eastern Asia. Trees are characterized by having long, flat, spirally arranged needles that grow directly from the branch. Each yellow- or blue-green needle has a short stalk at the base and a grooved upper surface. Winter buds are brown, shiny, and pointed. Uniquely among conifers, the Douglas fir has cones with 3-lobed bracts sticking out between the scales. The cones hang down rather than sticking up as in true firs. Cones mature in one season and retain their scales when they fall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pseudotsuga"@en .

aat:300343722 a skos:Concept ;
    skos:definition "Species of aromatic-leaved green alder native to northeastern Europe, northern Asia, and northwestern North America. In some classifications, a subspecies of Alnus viridis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alnus fruticosa"@en .

aat:300343723 a skos:Concept ;
    skos:definition "Species of fir native to the Pacific Northwest of North America, from the extreme southeast of Alaska to the extreme northwest of California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abies amabilis"@en .

aat:300343724 a skos:Concept ;
    skos:definition "Wood of Abies alba, an ornamental and timber species tree native to the mountainous regions of central and southern Europe and Asia, much used in carpentry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver fir"@en .

aat:300343725 a skos:Concept ;
    skos:definition "Species of fir tree growing to a height of 150 feet; abundant in the mountainous regions of central and southern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abies alba"@en .

aat:300343726 a skos:Concept ;
    skos:definition "Wood of Abies amabilis, an ornamental and timber fir native to North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pacific silver fir"@en .

aat:300343731 a skos:Concept ;
    skos:definition "Refers to the art and certain artifacts of small-scale societies, even when the societies are not strictly speaking tribal in social structure. The rubric is typically applied to works of Native Americans, Oceania, and sub-Saharan Africa. The characteristics that define creators of tribal art are 1. isolation, politically and economically, from advanced civilizations; 2. oral traditions in rather than literacy; 3. small, independent population groupings, usually in villages of no more than a few hundred inhabitants who live a life of face-to-face social interaction and informal social control; 4. a low level of labor and craft specialization; 5. subsistence by hunting, fishing, and gathering and/or small-scale agriculture; 6. little technology beyond hand tools, often of stone rather than metal; and 7. slow rates of cultural change prior to European contact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribal art"@en .

aat:300343732 a skos:Concept ;
    skos:definition "Style and culture of the Iwellemmeden group of the same name inhabiting Mali and Burkina Faso."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irreganaten"@en .

aat:300343733 a skos:Concept ;
    skos:definition "Species of North American fir tree native to the mountains of southwest Oregon and California. It is a high altitude tree, typically occurring at 1,400-2,700 m (4,600-8,900 feet) altitude, though only rarely reaching tree line. The name red fir derives from the bark color of old trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abies magnifica"@en .

aat:300343734 a skos:Concept ;
    skos:definition "General term for wood from any of many species coniferous trees, including the Scots pine, Fraser fir, Douglas fir, red fir (silvertip fir), and silver fir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red fir"@en .

aat:300343735 a skos:Concept ;
    skos:definition "Style and culture of the African ethnic group of the same name inhabiting eastern Mali and western Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antessar"@en .

aat:300343736 a skos:Concept ;
    skos:definition "Wood from any of many species of pine, spruce, and hemlock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spruce pine"@en .

aat:300343737 a skos:Concept ;
    skos:definition "Species of small, shrubby pine tree found in Florida and Alabama in the U.S., growing 5-10 m (16-33 feet) tall, confined to infertile, well-drained, sandy habitats where competition from larger-growing species is minimized by the harsh growing conditions, as in the Florida scrub."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus clausa"@en .

aat:300343738 a skos:Concept ;
    skos:definition "Species of pine tree found on the coastal plains from southern South Carolina south to northern Florida and west to southern Louisiana in the U.S. This pine is a straight-growing, medium-sized species, attaining heights of 20-35 m."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus glabra"@en .

aat:300343739 a skos:Concept ;
    skos:definition "Species of coniferous tree native to eastern North America, from Minnesota, through southern Quebec, Nova Scotia, and in the Appalachian Mountains to Georgia and Alabama. Populations occur in several areas east and west of the Appalachians, including Pennsylvania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsuga canadensis"@en .

aat:300343740 a skos:Concept ;
    skos:definition "Species of coniferous tree native to China, Taiwan, Tibet and Vietnam. It includes many varieties, some of which are considered separate species in some classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsuga chinensis"@en .

aat:300343741 a skos:Concept ;
    skos:definition "Wood of species Tsuga chinensis, a coniferous Asian tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese hemlock"@en .

aat:300343742 a skos:Concept ;
    skos:definition "Species of large, evergreen hemlock native to the west coast of North America, from Alaska to California. It is distinguished by slightly pendulous branchlet tips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsuga mertensiana"@en .

aat:300343743 a skos:Concept ;
    skos:definition "Species of hemlock native to the west coast of North America, from Alaska to California; a timber tree often 60 m (200 feet) tall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tsuga heterophylla"@en .

aat:300343744 a skos:Concept ;
    skos:definition "Species of large, deciduous, coniferous larch native to the Alps, Carpathians, and lowlands of northern Poland and southern Lithuania. It is cultivated for tough and durable timber, Venetian turpentine, and bark, which is used in tanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Larix decidua"@en .

aat:300343745 a skos:Concept ;
    skos:definition "Species of medium-sized to large deciduous, coniferous larch tree reaching 20-40 m tall; cultivated for timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Larix kaempferi"@en .

aat:300343746 a skos:Concept ;
    skos:definition "Species of medium-size to large deciduous, coniferous larch tree native to western Russia, reaching 20-50 m tall. Hardy in cold weather and rot resistant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Larix sibirica"@en .

aat:300343747 a skos:Concept ;
    skos:definition "Species of large deciduous, coniferous larch tree reaching 30-60 m talll, native to the mountains of western North America, from British Columbia and Alberta, Canada, to Washington, Oregon, Idaho, and Montana in the U.S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Larix occidentalis"@en .

aat:300343748 a skos:Concept ;
    skos:definition "Species of medium-sized coniferous tree native to the mountains of eastern Africa, including Sudan, Zimbabwe, and the Arabian Peninsula. It is the only juniper south of the equator, probably a relatively recent colonist of Africa. It is closely related to Juniperus excelsa from southwestern Asia, probably deriving from a common ancestor with that species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juniperus procera"@en .

aat:300343749 a skos:Concept ;
    skos:definition "Species of small juniper tree native to western North America, in British Columbia and Alberta, Canada, from Washington to North Dakota and Arizona in the U.S., and in Sonora to Coahuila, Mexico. It can be very long-lived, with individuals as old as 1,500 years recorded. It is closely related to Juniperus virginiana, and often hybridizes with it where their ranges meet on the Great Plains. It is used as an ornamental garden plant and medicinally among the Plateau Indian tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juniperus scopulorum"@en .

aat:300343750 a skos:Concept ;
    skos:definition "The action or power of moving from one place to another, including progressive motion of a person, animal, or inanimate body by natural or artificial means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locomotion"@en .

aat:300343751 a skos:Concept ;
    skos:definition "Practice and discipline of designing the appearance, ergonomics, complex systems, and other aspects of motor vehicles, usually road vehicles such as automobiles, motorcycles, trucks, buses, coaches, and vans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automotive design"@en .

aat:300343752 a skos:Concept ;
    skos:definition "Species of large evergreen tree, growing to 20-55 m tall, native to Europe and western Asia. Its name, \"black pine,\" is derived from the somber appearance created by dark green, sharp, rigid, rather long needles and deeply fissured bark. It is widely cultivated as an ornamental."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus nigra"@en .

aat:300343753 a skos:Concept ;
    skos:definition "Wood from the Pinus caribaea, native to Central America, Cuba, the Bahamas, and the Turks and Caicos Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caribbean pine"@en .

aat:300343754 a skos:Concept ;
    skos:definition "Species of pine native to the eastern highlands of the island of Cuba. The closely related Hispaniolan pine (P. occidentalis), native to the neighboring island of Hispaniola, is treated as the same species as the Cuban pine in some classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus cubensis"@en .

aat:300343755 a skos:Concept ;
    skos:definition "Wood from any of various coniferous trees from which pitch or turpentine can be obtained and which yield very resinous wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitch pine"@en .

aat:300343756 a skos:Concept ;
    skos:definition "General term referring to any of various coniferous trees from which pitch or turpentine can be obtained and which yield very resinous wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitch pine"@en .

aat:300343757 a skos:Concept ;
    skos:definition "Species of hard pine native to Central America, Cuba, the Bahamas, and the Turks and Caicos Islands, found in tropical and subtropical coniferous forests. There are three varieties, which are treated as separate species in some classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus caribaea"@en .

aat:300343758 a skos:Concept ;
    skos:definition "Species of North American pine native to the area of the Northwest Territories to Nova Scotia, Canada, and Minnesota to Maine and Indiana, United States. In its far western range, it hybridizes readily with the closely related lodgepole pine (P. contorta)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus banksiana"@en .

aat:300343759 a skos:Concept ;
    skos:definition "Species of shrubby pine native to northeastern Asia, including the islands of Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus pumila"@en .

aat:300343760 a skos:Concept ;
    skos:definition "Species of white pine native to Japan, growing 15-25 m tall and typically as wide as it is tall. Needle-like leaves grow in bundles of five."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus parviflora"@en .

aat:300343761 a skos:Concept ;
    skos:definition "Species of North American pine related to Ponderosa Pine, found in the area from southwest Oregon, United States, to northern Baja California, Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus jeffreyi"@en .

aat:300343762 a skos:Concept ;
    skos:definition "Wood from any of several Australasian and American trees, most of them pines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrub pine"@en .

aat:300343763 a skos:Concept ;
    skos:definition "General term for any of several Australasian and American trees, most of them pines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrub pine"@en .

aat:300343764 a skos:Concept ;
    skos:definition "Species of medium-sized pine tree native to the U.S., in poorer soils from Long Island, New York, through the Appalachian Mountains to western Tennessee and Alabama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus virginiana"@en .

aat:300343765 a skos:Concept ;
    skos:definition "Wood from any of various trees, usually pines or other conifers having reddish bark or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red pine"@en .

aat:300343766 a skos:Concept ;
    skos:definition "General term referring to many species of trees, usually pines or other conifers having reddish bark or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red pine"@en .

aat:300343767 a skos:Concept ;
    skos:definition "Instruments with a curved blade, used by ancient Greeks and Romans to scrape sweat and dirt from the skin after exercise or while bathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strigils"@en .

aat:300343768 a skos:Concept ;
    skos:definition "Style and culture of the Berber group of the same name inhabiting Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Ferwan"@en .

aat:300343769 a skos:Concept ;
    skos:definition "Style and culture of the Tuareg group of the same name inhabiting Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Itesan"@en .

aat:300343770 a skos:Concept ;
    skos:definition "Plan of a building or city that is arranged within a hexagon (six sides of equal length), usually a centralized plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hexagonal plan"@en .

aat:300343771 a skos:Concept ;
    skos:definition "Plan of a building or city that is arranged within an octagon (eight sides of equal length), usually a centralized plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "octagonal plan"@en .

aat:300343772 a skos:Concept ;
    skos:definition "Species of pine tree native to the southeastern United States, from Texas to Florida and Delaware. It grows to 30-35 m (98-115 feet) tall. The needles usually fall only every two years, giving the species an evergreen character. The word \"loblolly\" refers to a low wet place, although the trees grow in other habitats as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus taeda"@en .

aat:300343773 a skos:Concept ;
    skos:definition "Species of pine known in several subspecies, growing as an evergreen shrub or tree, native to western North America. The name \"contorta\" refers to the twisted forms of some individuals growing at the coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus contorta"@en .

aat:300343774 a skos:Concept ;
    skos:definition "Species of large pine tree native to eastern North America, from Newfoundland to Minnesota and Manitoba, and south along the Appalachian Mountains to Georgia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus strobus"@en .

aat:300343775 a skos:Concept ;
    skos:definition "Pale, soft wood from any of many species of North American pines, generally native to eastern and central parts of the continent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white pine"@en .

aat:300343776 a skos:Concept ;
    skos:definition "General term for many species pines generally native to eastern and central parts of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white pine"@en .

aat:300343777 a skos:Concept ;
    skos:definition "Species of evergreen pine tree characterized by tall, straight growth in a variety of North American habitats, including Newfoundland to Manitoba, and south to Virginia, Pennsylvania, and West Virginia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus resinosa"@en .

aat:300343778 a skos:Concept ;
    skos:definition "Species of widespread and variable pine native to western North America and widely cultivated elsewhere for its timber and for ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus ponderosa"@en .

aat:300343779 a skos:Concept ;
    skos:definition "General term referring to any of many species of pine, spruce, and hemlock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spruce pine"@en .

aat:300343780 a skos:Concept ;
    skos:definition "Species of pine tree found along the Atlantic coastal plain of the eastern United States, recognizable by an irregular growth pattern and crooked limbs. At its northern range it hybridizes with P. rigida; in some classifications it is considered a subspecies of P. rigida."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus serotina"@en .

aat:300343781 a skos:Concept ;
    skos:definition "Species of evergreen coniferous pine tree growing up to 25 m in height, having a broad range in Eurasia; it is cultivated in North America and New Zealand. Many varieties exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus sylvestris"@en .

aat:300343782 a skos:Concept ;
    skos:definition "General term for any of several species of North American and European pines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yellow pine"@en .

aat:300343784 a skos:Concept ;
    skos:definition "Species of pine native to the mountains of Oregon and California, United States, and Baja California, Mexico. It is one of the largest species of pine, 40-60 m (130-200 feet) in height. The species is prominent in the Achumawi First People creation myth, in which the creator drops a seed from the tree to make one of the first people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus lambertiana"@en .

aat:300343785 a skos:Concept ;
    skos:definition "Wood of any of dozens of species of pine, particularly those having particularly resinous wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ocoté pine"@en .

aat:300343786 a skos:Concept ;
    skos:definition "General term for any of dozens of species of pine, especially those having particularly resinous wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ocoté pine"@en .

aat:300343787 a skos:Concept ;
    skos:definition "Wood from any of several pine trees of the southern United States, having foliage with a fragrance resembling the herb rosemary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosemary pine"@en .

aat:300343788 a skos:Concept ;
    skos:definition "General term for any of several pine trees of the southern United States noted for foliage having a fragrance resembling the herb rosemary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosemary pine"@en .

aat:300343789 a skos:Concept ;
    skos:definition "Wood from any of numerous species of pine native to the southern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southern pine"@en .

aat:300343790 a skos:Concept ;
    skos:definition "General term for any of numerous species of pine native to the southern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southern pine"@en .

aat:300343791 a skos:Concept ;
    skos:definition "Species of evergreen tree having long, tufted foliage and a tall, columnar trunk up to 35 m in height, found along the coastal plain of the southern U.S. from Texas to Virginia and Florida. The species is a principal source of turpentine, kraft paper, paperboard, and book paper made in the United States. The hard, stiff, durable lumber was also used for ships, boxes, flooring, heavy construction, and millwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus palustris"@en .

aat:300343792 a skos:Concept ;
    skos:definition "Species of pine tree native to the southeastern U.S., growing to 30 m (95 feet) in height. It is named \"slash pine\" is named for its habitat of swampy overgrown land, called \"slashes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus elliottii"@en .

aat:300343793 a skos:Concept ;
    skos:definition "Species of pine native to the southeastern area of North America, having a variable form and reaching 30 m in height. It produces soft, pale yellow, easily worked wood primarily used for millwork, interior trim, toys, and siding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus echinata"@en .

aat:300343794 a skos:Concept ;
    skos:definition "Species of conifer native to the Sichuan-Hubei region of China; single living species of its genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Metasequoia glyptostroboides"@en .

aat:300343795 a skos:Concept ;
    skos:definition "Style and culture of the Kel Ferwan people of the same name inhabiting Mali and Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Tadele"@en .

aat:300343796 a skos:Concept ;
    skos:definition "Style and culture of the Berber people of the same name inhabiting Niger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kel Fadey"@en .

aat:300343797 a skos:Concept ;
    skos:definition "The action or practice of observing, watching, or noticing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "observation"@en .

aat:300343798 a skos:Concept ;
    skos:definition "Species of enormous tree, living for hundreds or thousands of years, found in California and Oregon, United States, in scattered groves on the western slopes of the Sierra Nevada Range at elevations 900-2,600 m (3,000-8,500 feet). It is the only living species of its genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sequoiadendron giganteum"@en .

aat:300343799 a skos:Concept ;
    skos:definition "Wood from any of species of the Sequoia genus or related genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sequoia"@en .

aat:300343800 a skos:Concept ;
    skos:definition "Genus containing one species of giant sequoia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sequoiadendron"@en .

aat:300343801 a skos:Concept ;
    skos:definition "Wood from Picea mariana, found in North America. It is a yellow, lightweight wood with a straight grain logged primarily as pulp wood, but also used for piles, posts, and ship construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea mariana"@en .

aat:300343802 a skos:Concept ;
    skos:definition "Species of medium sized evergreen spruce growing at high altitudes in western North America, from Idaho and Wyoming to Utah, Colorado, Arizona, and New Mexico, United States. The blue spruce has a light bluish-gray tone to its needles and is commonly used for landscaping and gardens. Its weak and brittle timber is used locally for log cabins. Occasionally the name blue spruce is incorrectly used for black spruce trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea pungens"@en .

aat:300343803 a skos:Concept ;
    skos:definition "Species of large evergreen coniferous tree growing to 35-55 m, native to northern Europe; used in reforestation in Europe and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea abies"@en .

aat:300343804 a skos:Concept ;
    skos:definition "Species of coniferous spruce tree native to eastern North America, from eastern Quebec to Nova Scotia, Canada, and from New England to North Carolina, United States, reaching heights up to 40 m. It was almost lost to overharvesting, but was protected by a government act in 1911 which purchased considerable land for national forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea rubens"@en .

aat:300343805 a skos:Concept ;
    skos:definition "Species of large coniferous evergreen tree native to the west coast of North America, growing to 70 m tall and capable of living 700 years or more. It is the largest living spruce species and among the largest trees in the world of any genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea sitchensis"@en .

aat:300343806 a skos:Concept ;
    skos:definition "Species of large evergreen tree growing to 30 m in height, native to boreal forests of northern North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea glauca"@en .

aat:300343807 a skos:Concept ;
    skos:definition "Species of medium-sized, high altitude mountain spruce native to western North America, from British Columbia and Alberta, Canada, to California, Arizona, and New Mexico, United States, with isolated populations also in Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea engelmannii"@en .

aat:300343808 a skos:Concept ;
    skos:definition "Species of large evergreen spruce native to the western Himalaya and adjacent mountains, from Afghanistan to Nepal, 44 m in height and growing at altitudes of 3,600 m in forests together with deodar cedar, pindrow fir, and blue pine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picea smithiana"@en .

aat:300343809 a skos:Concept ;
    skos:definition "Genus containing 30 to 50 species of small deciduous trees or shrubs, many of which produce pome (fleshy) fruits, in which the ripened ovary and surrounding tissue both become fleshy and edible. Apple trees are native to the Caspian and Black Sea regions; they were introduced in America by the early settlers. Apple trees are primarily grown commercially for their fruit, but the timber is also used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malus"@en .

aat:300343810 a skos:Concept ;
    skos:definition "Family of flowering plants containing 95 genera and around 3,000 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosaceae"@en .

aat:300343811 a skos:Concept ;
    skos:definition "Order including 9 families of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosales"@en .

aat:300343812 a skos:Concept ;
    skos:definition "Vascular plants such as conifers, cycads, ginkgo and others that reproduce by means of an exposed seed or ovule, as opposed to an angiosperm or flowering plant, which have seeds enclosed by mature ovaries or fruits. Gymnosperm seeds develop either on the surface of scale- or leaf-like appendages of cones, or at the end of short stalks. In early classification schemes, Gymnospermae were regarded as a taxonomic group, although modern classifications recognize that the fossil record suggests that angiosperms are nested within gymnosperms (thus living gymnosperms are not actually a clade)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gymnospermae"@en .

aat:300343813 a skos:Concept ;
    skos:definition "The acquisition of learning, whether by means of books, observation, or experiment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studying"@en .

aat:300343814 a skos:Concept ;
    skos:definition "Sets of small books planned around themes and housed together in cases. The first of this type of collection was from the English publisher John Marshall circa 1800, who issued diminutive libraries with ornamental pediments added to the boxes to give the impression of glass-fronted bookcases. Sets such as these have appeared thereafter in various forms. Miniature libraries were typically collected for children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miniature libraries"@en .

aat:300343816 a skos:Concept ;
    skos:definition "A pejorative vernacular term for cheaply produced publications dedicated to sensational or morbid themes. The term is chiefly applied to literature of this type created in Victorian England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penny dreadfuls"@en .

aat:300343818 a skos:Concept ;
    skos:definition "A list of signatures attached to the end of early printed books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "registers"@en .

aat:300343819 a skos:Concept ;
    skos:definition "Electron microscopes designed for directly studying the surfaces of solid objects, utilizing a beam of focused electrons of relatively low energy as an electron probe that is scanned in a regular manner over the specimen. An electrical signal is obtained by collecting and amplifying secondary electrons emitted by the specimen and is applied to a cathode-ray tube scanned in synchronism with the electron beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scanning electron microscopes"@en .

aat:300343820 a skos:Concept ;
    skos:definition "The process and technique of creating two-dimensional decoration on pottery by using paint made of metallic oxides or other pigments held in suspension in slip or another medium.The pigments are typically applied to a fired body by using a brush or other tool. The painted object is typically fired again to fuse the pigment. The term is often reserved for Ancient Greek red- and black-figure works. See also \"porcelain painting (image making).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vase painting"@en .

aat:300343821 a skos:Concept ;
    skos:definition "Works created by applying paint to the back of a sheet of glass in reverse order, that is, with details and highlights first and background last. The finished picture is viewed from the front."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverse paintings on glass"@en .

aat:300343822 a skos:Concept ;
    skos:definition "Works done by painting on the front or the reverse of glass, including with vitrified pigments. In the context of stained glass windows and panels, refers to parts of the image that are painted on glass (often stained glass), especially the smaller details. Also includes works on flat surfaces, vessels, and other types of works. Painted glass mirrors and other glass decoration, and painted works in the manner of painting on canvas or wooden panels were known since ancient times. [painted glass, not same as stained glass]"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painted glass"@en .

aat:300343823 a skos:Concept ;
    skos:definition "A deep pit or distant land located under the earth or in a dark precinct where humans and other creatures exist after earthly death, common to many mythologies. The nature of the place varies from a dreary land where the dead are gathered and from which only a few exceptional human heroes are permitted to enter heaven, to a terrible precinct where sinners pay for misdeeds. In many religions, it is from the underworld that dreams, ghosts, and demons originate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underworld"@en .

aat:300343824 a skos:Concept ;
    skos:definition "Heaps or piles of wheat sheafs, typically arranged in fields at harvest time. The stacks comprise sheafs of grain, primarily to be used for bread. The stacks protect the sheafs from rain until the grain can be separated from the stalks by threshing. For stacks of grass to be used for an animal food, prefer \"haystacks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheatstacks"@en .

aat:300343825 a skos:Concept ;
    skos:definition "Genus containing various annual grasses of wide climatic adaptability that have been cultivated for food since prehistoric times and are now cultivated in most temperate areas for the grain they yield, particularly T. aestivum and T. turgidum. The tall stalks (about 1 m) have heads of grain that are primarily ground into flour for pasta and bread. Wheat grain is also used for making starch, alcohol (beer), and feeding livestock. It contains carbohydrates (70%), proteins (11-15%), minerals, and vitamins. The wheat straw (stalks) are used for fodder, papermaking, and bedding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Triticum"@en .

aat:300343826 a skos:Concept ;
    skos:definition "Genus containing various annual grasses of the family Poaceae (Gramineae), many producing edible grain. Barley was cultivated in Ethiopia and southeast Asia since prehistoric times. From biblical times through the Middle Ages, barley was the primary grain for producing unleavened bread and porridge throughout Europe, the Middle East, Egypt, and some parts of Asia. The grains are also been used to make malt beer. The residual stems, or straw, were used in Europe and Asia to make straw hats. The straw has also used used as a packing material, particularly for shipping glass and as an animal feed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hordeum"@en .

aat:300343827 a skos:Concept ;
    skos:definition "Genus containing 7 to 20 species that are often cultivated to produce an edible starchy cereal grain. It is generally an annual plant, but in tropical areas it can survive as a perennial. Many cultures have evidence of early rice cultivation, including China, India, and the civilizations of Southeast Asia. However, the earliest archaeological evidence comes from central and eastern China and dates to 7000-5000 BCE. With the exception of the type called upland rice, the plant is grown on submerged land. Seedlings are transplanted to a submerged field or paddy for the growing season. The most common species used for food in the modern world is Oryza sativa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oryza"@en .

aat:300343828 a skos:Concept ;
    skos:definition "Family containing over 8,000 genera and 10,000 species of perennial plants with long, cylindrical leaves that have been used for making paper, ropes, baskets, and fabric; many also produce edible grain, the most important food sources worldwide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poaceae"@en .

aat:300343829 a skos:Concept ;
    skos:definition "Piles, heaps, or groups of things, particularly such a piles having their constituents arranged in an orderly fashion, such as a stack of wheat or goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stacks"@en .

aat:300343830 a skos:Concept ;
    skos:definition "Business establishments for the design, display, and sale of high-quality clothing and accessories, usually limited to those designed by fashion designers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion houses"@en .

aat:300343831 a skos:Concept ;
    skos:definition "Dressmakers, usually limited to those creating clothing of high quality and those who are also fashion designers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couturiers"@en .

aat:300343832 a skos:Concept ;
    skos:definition "In Japan, ceremonies for the preparation and consumption of green tea, according to strict rules of ceremony as an expression of Zen Buddhist philosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea ceremonies"@en .

aat:300343833 a skos:Concept ;
    skos:definition "Those, usually in Japan, who are trained in and carry out the preparation and consumption of green tea, according to strict rules of ceremony, as an expression of Zen Buddhist philosophy. They are often monks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tea masters"@en .

aat:300343834 a skos:Concept ;
    skos:definition "People who are prominent in fashionable or wealthy society, often participating in social activities and entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socialites"@en .

aat:300343835 a skos:Concept ;
    skos:definition "Acts or processes of entering or making a hostile incursion into a country or territory as an enemy with armed force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invasions"@en .

aat:300343836 a skos:Concept ;
    skos:definition "Individuals who are killed, wounded, or injured in a battle, natural disaster, or other event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "casualties"@en .

aat:300343837 a skos:Concept ;
    skos:definition "Generally, figures sent on an errand; messengers. Specifically used in the context of Christian iconography to refer to the 12 witnesses sent forth to preach the words of Jesus Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apostles"@en .

aat:300343838 a skos:Concept ;
    skos:definition "Mirrors made from polished obsidian, which is a dark, shiny glass formed in nature by the rapid cooling of lava. Such mirrors were used since Paleolithic times. In ancient Mesoamerica and elsewhere, they were often used as instruments for seeing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obsidian mirrors"@en .

aat:300343840 a skos:Concept ;
    skos:definition "Visible masses of condensed watery vapor floating in the air at some considerable height above the general surface of the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clouds"@en .

aat:300343841 a skos:Concept ;
    skos:definition "Spanish colonial style and period as specifically limited to the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial Spanish American"@en .

aat:300343842 a skos:Concept ;
    skos:definition "One of two living species of camels. It has two humps and is native to the steppes of central Asia. It has been widely domesticated. It is thought that the Bactrian camel was domesticated sometime before 2500 BCE in the area of modern Iran. In some classifications, Camelus ferus is used to refer to the wild form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camelus bactrianus"@en .

aat:300343843 a skos:Concept ;
    skos:definition "One of two living species of camels. It has one hump and is probably native to the Arabian Peninsula. It is believed to have been domesticated as early as 4000 BCE in Arabia. It has been widely domesticated, with living populations that exhibit wild behavior existing only in Australia, where a feral population was introduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camelus dromedarius"@en .

aat:300343844 a skos:Concept ;
    skos:definition "Deep regret, guilt, or sorrow for having done something morally wrong or otherwise considered incorrect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "remorse"@en .

aat:300343845 a skos:Concept ;
    skos:definition "The state of desiring a person, thing, or event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longing"@en .

aat:300343846 a skos:Concept ;
    skos:definition "Having or characterized by a high temperature or the sensation of heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot"@en .

aat:300343847 a skos:Concept ;
    skos:definition "Having or characterized by a moderately high temperature or the sensation of heat, but not so high as indicated by \"hot.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warm"@en .

aat:300343848 a skos:Concept ;
    skos:definition "Having or characterized by a moderately low temperature, but not so low as indicated by \"cold.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cool"@en .

aat:300343849 a skos:Concept ;
    skos:definition "Usually restricted to references to the weather, season, or climate, indicating a persistently moderate state of warmth: neither too hot nor too cold; of mild and equable temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate"@en .

aat:300343850 a skos:Concept ;
    skos:definition "Beings holding the estate or rank of a god or other supremely divine entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deities"@en .

aat:300343851 a skos:Concept ;
    skos:definition "Masculine superhuman persons or other beings who are worshipped and believed to have power over nature and the fortunes of mankind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gods"@en .

aat:300343852 a skos:Concept ;
    skos:definition "Female superhuman persons or other beings who are worshipped and believed to have power over nature and the fortunes of mankind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goddesses"@en .

aat:300343853 a skos:Concept ;
    skos:definition "Female clergy, particularly in ancient times, who perform sacrificial, ritualistic, mediatorial, interpretative, or ministerial functions. In modern usage, females who perform the duties of priests are often called \"priests.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "priestesses"@en .

aat:300343854 a skos:Concept ;
    skos:definition "The action of exposing humans or animals to the free action of water by immersion or suffusion, For recreational immersion in water, use \"swimming.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathing"@en .

aat:300343855 a skos:Concept ;
    skos:definition "Genre of architectural drawings, prints, or designs in other media that suggest an unlikely or impossible arrangement and projected environment that is surprising to the viewer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural fantasies"@en .

aat:300343856 a skos:Concept ;
    skos:definition "Genus of tropical trees containing over 30 species noted for their broadly winged circular fruits and including many kinds valued for their hard, often red, wood, some of which are padauk, amboyna, mukwa, barwood, or narra. Some species are used produce a fugitive red dyestuff containing santalin that has been used for textiles and tanning leather. The dye is soluble in alcohol, but insoluble in water. It was used commercially to produce mock turkey red dyes. The scientific name is a Latinized ancient Greek term meaning \"winged fruit,\" in reference to the shape of the seed pod."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pterocarpus"@en .

aat:300343857 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to southeastern Asia: northeastern India, Burma, Laos, Vietnam, and Thailand, valued for its hard yellowish-red wood"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pterocarpus macrocarpus"@en .

aat:300343858 a skos:Concept ;
    skos:definition "Species of hardwood valued as source for wood veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pterocarpus soyauxii"@en .

aat:300343859 a skos:Concept ;
    skos:definition "Species of hardwood often harvested for burl veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pterocarpus dalbergioides"@en .

aat:300343860 a skos:Concept ;
    skos:definition "Species of large deciduous tree native to areas of southeastern Asia, northern Australasia, and the western Pacific Ocean islands, valued for hard, rose-colored wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pterocarpus indicus"@en .

aat:300343861 a skos:Concept ;
    skos:definition "Family of flowering plants (angiosperms), within the order Fabales. Fabaceae, which is the third largest family among the angiosperms after Orchidaceae (orchid family) and Asteraceae (aster family), consists of more than 700 genera and about 20,000 species of trees, shrubs, vines, and herbs and is worldwide in distribution. The most important commercial species include Glycine max (soybean), Pisum sativum (garden pea), Arachis hypogaea (peanut [groundnut]), and Medicago sativa (alfalfa [lucerne]). Most woody species are tropical; herbaceous (i.e., nonwoody) species occur mainly in temperate regions. The leaves usually are pinnately compound (feather formed), sometimes trifoliate (with three leaflets), or palmate (the leaflets radiating from a common point). The leaves of a few species are simple or reduced to scales. The fruit is typically a legume, or pod, which splits open as it dries, releasing the seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fabaceae"@en .

aat:300343862 a skos:Concept ;
    skos:definition "Order of dicotyledonous flowering plants in the Rosid I group among the core eudicots. The order comprises 4 families (Fabaceae, Polygalaceae, Quillajaceae, and Surianaceae), 754 genera, and more than 20,000 species. However, more than 95 percent of the genera and species belong to Fabaceae, the legume family. Fabaceae is the third largest family of angiosperms, exceeded only by Asteraceae (aster or sunflower family) and Orchidaceae (orchid family). Along with Poaceae (the grass family), Fabaceae is the most important plant family in the production of food for humans and livestock, as well as in the production of industrial products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fabales"@en .

aat:300343863 a skos:Concept ;
    skos:definition "Species of North American tree, growing to 10 m (35 feet) in height and bearing white or pink flowers in the summer and small apple-like berries in autumn. It exists in several varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malus ioensis"@en .

aat:300343864 a skos:Concept ;
    skos:definition "Genus containing around 70 species of trees and shrubs, primarily found in the Northern Hemisphere, some species extending into the tropical forests of Mexico and Java. The leaves of ash trees are opposite, usually deciduous, pinnately compound and having usually five to nine leaflets. Samaras, the fruits are one-seeded, narrow, and winged. Flowers typically are small, showy, and arranged in clusters. Most ash trees are small to medium in height, though some of the larger timber-providing species grow to 60-120 feet (8-34 m)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fraxinus"@en .

aat:300343865 a skos:Concept ;
    skos:definition "Family containing 24 extant genera and around 600 species of mesophytic shrubs, trees, and vines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oleaceae"@en .

aat:300343866 a skos:Concept ;
    skos:definition "Species of large, deciduous ash trees with 7 to 11 leaflets and having wide distribution throughout Europe. It is known in several varieties, including timber trees and those that have been cultivated for landscaping for centuries. Notable among these are forms with dwarflike or weeping habits, variegated foliage, warty twigs and branches, and curled leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fraxinus excelsior"@en .

aat:300343867 a skos:Concept ;
    skos:definition "One of 18 species of ash found in North America, found in mesophytic hardwood forests from Nova Scotia west to Minnesota, south to northern Florida, and southwest to eastern Texas. It is similar in appearance to the green ash and there is some overlap in habitat distribution between the two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fraxinus americana"@en .

aat:300343868 a skos:Concept ;
    skos:definition "One of 18 species of ash found in North America. It is similar in appearance to the white ash and there is some overlap in habitat distribution between the two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fraxinus pennsylvanica"@en .

aat:300343869 a skos:Concept ;
    skos:definition "Mint order of flowering plants belonging to the core asterid, or sympetalous lineage of flowering plants, in the Asterid I group of the Angiosperm Phylogeny Group II (APG II) botanical classification system. It includes 23 families and more than 23,000 species. The main families in the order are Lamiaceae, Verbenaceae, Plantaginaceae, Scrophulariaceae, Orobanachaceae, Acanthaceae, Gesneriaceae, Bignoniaceae, Oleaceae, Pedaliaceae, and the small carnivorous families Byblidaceae and Lentibulariaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lamiales"@en .

aat:300343870 a skos:Concept ;
    skos:definition "General name for wood derived from any of several hardwood species having yellow or orange color, including various mulberry, arariba, and tulip trees, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "canarywood"@en .

aat:300343872 a skos:Concept ;
    skos:definition "Genus of legume in the Fabaceae family. Wood of any of several species of the Centrolobium genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Centrolobium"@en .

aat:300343875 a skos:Concept ;
    skos:definition "Species of shrubby African tree harvested for its hardwood timber and to make a fugitive red dye that is soluble in alkali."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baphia nitida"@en .

aat:300343876 a skos:Concept ;
    skos:definition "Genus of legume having 15 or more species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baphia"@en .

aat:300343877 a skos:Concept ;
    skos:definition "Genus having ten species of deciduous, smooth-barked trees native to temperate regions of the northern hemisphere. Trees have pale reddish-brown, close-grained wood valued for flooring, cabinetry, furniture, panel painting, and other uses. Beech nuts provide forage for game animals and yield an edible oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagus"@en .

aat:300343878 a skos:Concept ;
    skos:definition "Family containing about 1,000 species of both evergreen and deciduous trees and shrubs in 7 or 8 genera, characterized by alternate simple leaves with pinnate venation, unisexual flowers in the form of catkins, and fruit in the form of cupule (cup-like) nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagaceae"@en .

aat:300343879 a skos:Concept ;
    skos:definition "Species of large deciduous tree up to 35 meters in height, native to eastern North America, from Nova Scotia to Texas, having a pale reddish-brown timber that is hard, tough, fine-grained, and used for furniture and other purposes. The bark is smooth and gray. Leaves are simple with veins and toothed edges. Fruit comprises a large husk containing 2 shiny brown edible nuts. The wood is acidic, pinkish brown in color with dark brown rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagus grandifolia"@en .

aat:300343880 a skos:Concept ;
    skos:definition "Species of Asian beech tree growing to around 20 m (65 feet) tall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagus engleriana"@en .

aat:300343882 a skos:Concept ;
    skos:definition "Species of large, long-lived beech tree found throughout England and Eurasia; it passes 30-40 years in the juvenile stage, during which time there is rapid growth but no flowering. It can grow to 49 m (160 feet) in height; it has a smooth gray bark and a hard, heavy wood. European beech trees are often grown in large hedgerows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagus sylvatica"@en .

aat:300343883 a skos:Concept ;
    skos:definition "Species of beech tree that grows to 24 m (79 feet) in height, with divisions at the base into several stems. It is one of the primary species of deciduous forests in Japan. It is grown as an ornamental in the western hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagus japonica"@en .

aat:300343884 a skos:Concept ;
    skos:definition "Species of beech tree reaching 35 m in height; one of the primary trees of the deciduous forests of Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagus crenata"@en .

aat:300343885 a skos:Concept ;
    skos:definition "Species of beech tree native to New Zealand. It is called Black Beech due to a sooty mold that often covers the trunk and branches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nothofagus solandri"@en .

aat:300343886 a skos:Concept ;
    skos:definition "Genus containing 35 species of trees and shrubs native to the Southern Hemisphere, including South America and Australasia, with fossil specimens having been found in Antarctica. Formerly these species were included in the family Fagaceae, but genetic tests proved that they are distinct, and they are now in a family their own, the Nothofagaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nothofagus"@en .

aat:300343887 a skos:Concept ;
    skos:definition "Family containing one extant genus and 35 species of trees and shrubs native to the Southern Hemisphere. Formerly these species were included in the family Fagaceae, but genetic tests proved that they are distinct, and they are now placed in Nothofagaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nothofagaceae"@en .

aat:300343888 a skos:Concept ;
    skos:definition "Species of Eurasian tree around 30 m (100 feet) in height and having a grayish-white trunk and wavy-margined, wedge-shaped leaves up to 15 cm (6 inches) in length. It is sometimes classified as a subspecies of Fagus sylvatica, to which it is closely related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fagus orientalis"@en .

aat:300343889 a skos:Concept ;
    skos:definition "Species of columnar, slender southern beech tree native to cooler regions of the Southern Hemisphere. It is used as an ornamental shrub in mild oceanic climates, and for making of flooring, toys, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nothofagus fusca"@en .

aat:300343890 a skos:Concept ;
    skos:definition "Endangered rainforest tree of eastern Australia. It was heavily logged in the 19th and 20th centuries and has not recovered. It fast growing and found on volcanic and alluvial soils. Although its common names include the words \"beech\" and \"teak,\" it is actually neither."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gmelina leichhardti"@en .

aat:300343891 a skos:Concept ;
    skos:definition "Genus of tree containing around 10 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gmelina"@en .

aat:300343892 a skos:Concept ;
    skos:definition "Fast growing deciduous tree, occurring naturally in India, Myanmar, Thailand, Laos, Cambodia, Vietnam, and southern China. It has been cultivated in Sierra Leone, Nigeria, Malaysia. It is also planted as an ornamental elsewhere, is harvested for its wood, and used for papermaking pulp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gmelina arborea"@en .

aat:300343893 a skos:Concept ;
    skos:definition "Family of flowering plants, most of which are annual or perennial herbs. It was formerly considered closely related to Verbenaceae, but phylogenetic studies at the end of the 20th century indicated that some of the woody genera formerly placed in Verbenaceae should be placed in Lamiaceae. Delimited this way, there are 236 genera and more than 7,000 species in Lamiaceae. The primary center of distribution of the mint family is the Old World, from the Canary Islands to the Himalayas, with lesser centers in Ethiopia, Madagascar, southern areas of Africa and India, Sri Lanka, and oceanic regions eastward. Centers of distribution in the New World range from the mountains in central Mexico into Argentina and Chile, with secondary centers radiating northward and eastward."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lamiaceae"@en .

aat:300343894 a skos:Concept ;
    skos:definition "Wood of the species Gmelina arborea, having a medium texture with a straight or roey grain. It is easy to work and polishes to a silky smooth finish with a high gloss. Gmelina wood is used for furniture, cabinetry, boatbuilding, musical instruments, and decorative boxes. The tree is also cultivated for papermaking pulp. Although a common name includes the word \"beech,\" it is not a beech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gmelina"@en .

aat:300343895 a skos:Concept ;
    skos:definition "Species of large evergreen tree native to southeastern Asia. The bark is pale in color and rough and fissured vertically; the leaves have are glossy and smell of camphor when crushed. The tree produces bright green foliage with masses of small white flowers, and clusters of small black fruits. Camphorwood has a pungent smell. The camphor tree is considered an invasive species in Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cinnamomum camphora"@en .

aat:300343896 a skos:Concept ;
    skos:definition "Genus containing around 350 species of tree and shrub, including those having bark from which the spice cinnamon is derived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cinnamomum"@en .

aat:300343897 a skos:Concept ;
    skos:definition "Group of flowering plants containing around 55 genera and 2000-4000 species located primarily in warm or tropical regions, especially Southeast Asia and Brazil. Most are aromatic evergreen trees or shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lauraceae"@en .

aat:300343898 a skos:Concept ;
    skos:definition "Order of flowering plants including 7 families of trees and shrubs and around 85-90 genera. Most of the species are tropical and subtropical, though a few genera reach the temperate zone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laurales"@en .

aat:300343899 a skos:Concept ;
    skos:definition "Genus of large, mainly deciduous trees native to eastern Asia, eastern North America, and the West Indies, having large leaves that provide shade and habitat for many birds and other animals. The name derives from the Catawba Native American name for these trees (the tribal totem), with the misspelling \"Catalpa\" being instituted by the describing botanist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Catalpa"@en .

aat:300343900 a skos:Concept ;
    skos:definition "Wood from the species Catalpa bignonioides, lightweight with a fine grain. It is used for ornamental items and cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian bean tree"@en .

aat:300343901 a skos:Concept ;
    skos:definition "Wood from the species Catalpa bignonioides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Catalpa bignonioides"@en .

aat:300343902 a skos:Concept ;
    skos:definition "Family of flowering plants containing around 120 genera and 650-750 species of primarily trees and shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bignoniaceae"@en .

aat:300343903 a skos:Concept ;
    skos:definition "Genus of 30-50 species of shrubs, trees, and herbs native to Europe, eastern Asia, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cornus"@en .

aat:300343904 a skos:Concept ;
    skos:definition "Order of flowering plants containing about 600 species. Plants within Cornales usually have four-parted flowers, drupaceous fruits, and inferior gynoecia topped with disc-shaped nectaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cornales"@en .

aat:300343905 a skos:Concept ;
    skos:definition "Family of flowering plants containing around 110 species, mostly trees and shrubs, either deciduous or evergreen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cornaceae"@en .

aat:300343906 a skos:Concept ;
    skos:definition "Wood from the species Ficus carica, indigenous to an area extending from Asiatic Turkey to northern India, but natural seedlings grow in most Mediterranean countries. Generally cultivated for edible fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common fig"@en .

aat:300343907 a skos:Concept ;
    skos:definition "Species of large, deciduous shrub or small tree native to southwest Asia and the Mediterranean region, widely grown for its edible fruit. It was one of the first plants cultivated by humans, with evidence dating to as long ago as 9400-9200 BCE, thus predating the domestication of wheat, barley, and legumes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ficus carica"@en .

aat:300343908 a skos:Concept ;
    skos:definition "Genus containing about 850 species of woody trees, shrubs, and vines native to tropical and semi-warm temperate zones. Fig species are characterized by their unique inflorescence and distinctive pollination syndrome, utilizing specific wasp species for pollination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ficus"@en .

aat:300343909 a skos:Concept ;
    skos:definition "Family of flowering plants comprising around 40 genera and over 1000 species, generally found in tropical and subtropical regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moraceae"@en .

aat:300343911 a skos:Concept ;
    skos:definition "Genus containing around 70 species slow-growing evergreen shrubs and small trees in the family Buxaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buxus"@en .

aat:300343912 a skos:Concept ;
    skos:definition "Family containing 4 or 5 genera of trees, shrubs, and herbs, native to North America, Europe, North Africa, and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buxaceae"@en .

aat:300343913 a skos:Concept ;
    skos:definition "Order of dicotyledonous flowering plants, comprising Buxaceae (90-120 species in 4-5 genera) and the small family Didymelaceae (2 species in 1 genus). These families are closely related and are sometimes merged into a single family, Buxaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buxales"@en .

aat:300343915 a skos:Concept ;
    skos:definition "Species of tree in the willow family"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Casearia praecox"@en .

aat:300343916 a skos:Concept ;
    skos:definition "General term used by the lumber trade for firm, close-grained woods that resemble true boxwood but are derived from several other species of tree, including Phyllostylon brasiliensis, Tabebuia pentaphylla, and several species in the genera Eucalyptus and Tristania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Indian boxwood"@en .

aat:300343917 a skos:Concept ;
    skos:definition "Very heavy, hard wood from the species Buxus sempervirens from Eurasia; used for cabinet-making, clarinets, engraving, marquetry, woodturning, tool handles, mallet heads, and as a substitute for ivory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common boxwood"@en .

aat:300343918 a skos:Concept ;
    skos:definition "Species of evergreen shrub or small tree growing to 1-9 m tall, with a trunk 20 cm in diameter, found in Africa, Western Europe, Eastern Europe, the Mediterranean, Oceania and southeast Asia. Used as an ornamental shrub and for its heavy, hard wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buxus sempervirens"@en .

aat:300343919 a skos:Concept ;
    skos:definition "Genus of hardy, deciduous trees of the family Betulaceae, common to North America, Europe and Asia. Birch tress are readily distinguished by their white bark and diamond-shaped leaves. The lightweight bark contains natural waxes, oils, and tannins that make it tough, durable, and waterproof. Thin sheets of bark were commonly used for paper in Central Asia and the Far East. The water-impervious bark was used for wigwams, canoes, and shoes for Native Americans. Birch produces a strong, pale yellow-brown wood with a close, straight grain and uniform texture that finishes to a smooth surface. Dyes can also be obtained from various parts of birch trees. The leaves, usually gathered before they develop a mature green color, produce a yellow dye. The bark produces a pale brown color. The female catkins (a long shoot bearing flowers with no leaves) are boiled to produce a dull yellow color. Birch bark oil and birch beer are made from sap obtained from the trees. The sap allows birch bark to burn even when it is wet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula"@en .

aat:300343921 a skos:Concept ;
    skos:definition "Species of small birch shrub native to arctic and cool temperate regions of northern Europe, northern Asia and northern North America. It is sometimes divided into two or more subspecies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula nana"@en .

aat:300343922 a skos:Concept ;
    skos:definition "Short-lived species of deciduous tree native to North America, ranging from Ontario to Nova Scotia, Pennsylvania, and New Jersey, with disjunct populations in Indiana, Virginia, and North Carolina. It prefers poor, dry upland soils, but is also found in moist mixed woodlands. It is a common pioneer species on abandoned fields and burned areas, thus the name \"oldfield birch.\"Gray birch grows quickly to 7 to 9 m tall and 0.3 m trunk diameter"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula populifolia"@en .

aat:300343923 a skos:Concept ;
    skos:definition "Species of birch tree native to the Himalayas, growing at elevations up to 4,500 m (14,800 feet). The bark is white and paper thin, used in ancient times for writing Sanskrit scriptures and texts, and today used for writing sacred mantras. The bark is also used for packaging, the wood is used as firewood. There are many named varieties and cultivars used in landscaping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula utilis"@en .

aat:300343924 a skos:Concept ;
    skos:definition "Species of fast growing, short-lived, ornamental, shade, and timber tree native to northern and central North America, typically around 18 meters (60 feet) in height, with a brown bark that whitens over time and peels into paper-thin layers marked by narrow horizontal pores or lenticels. On the copper-colored inner bark, the pores are bright orange. Short, pendulous branches and numerous flexible twigs create a lacy silhouette in winter. The close-grained, almost white wood is used for turned articles, flooring, furniture, woodenware, pulp, and fuel. North American Indians used the thin, water-impervious bark for roofing, canoes, and writing material (thus the name \"paper birch\"). It is a pioneer species after fire. The sap is boiled down to produce birch syrup. The tree is known in several varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula papyrifera"@en .

aat:300343925 a skos:Concept ;
    skos:definition "Species of ornamental tree found on riverbanks and swamps in the eastern one-third of the United States, growing 18-30 m (60 to 80 feet) in height. Because the lower trunk becomes very dark with age, the tree is sometimes called black birch. The red-brown, deeply furrowed bark on an old trunk breaks into ragged, closely appressed scales; the upper trunk and branches are smooth, salmon pink to rose cinnamon, with a metallic luster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula nigra"@en .

aat:300343926 a skos:Concept ;
    skos:definition "Species of medium-sized European birch, typically reaching 15-25 m tall with a slender trunk and a crown of drooping branches and small, sharp-pointed leaves about 6 cm (2 inches) long. The bark is white, often with black diamond-shaped marks or larger patches at the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula pendula"@en .

aat:300343927 a skos:Concept ;
    skos:definition "Species of North American ornamental and timber tree, usually around 18 m (60 feet) in height; on poor soil it may be stunted and shrublike. The smooth, shiny, nonpeeling outer bark, red brown on younger stems, is almost black on older trunks and deeply furrowed into irregular scales. The twigs and inner bark smell and taste like wintergreen. The hard, close-grained wood is similar to that of yellow birch but denser and of deeper color. Sweet birch is a source of birch oil, formerly a substitute for oil of wintergreen. Birch beer is made from the sap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula lenta"@en .

aat:300343928 a skos:Concept ;
    skos:definition "Species of ornamental and timber tree native to the northeastern part of North America. It is among the largest of birches, reaching 30 m (100 feet) on cool, moist bottomlands and on drier soils to elevations of 1,950 m. On limbs and young trunks the silvery yellow bark peels in paper-thin curls; on old trunks it is red-brown, deeply grooved, and broken into irregular plates. The pale green twigs are slightly aromatic. The hard, pale red-brown wood usually is not separated from that of sweet birch commercially."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Betula alleghaniensis"@en .

aat:300343929 a skos:Concept ;
    skos:definition "Genus having approximately 30 species native to the Northern Hemisphere. A few species are ornamental and shade trees, among the most graceful of deciduous trees, with heart-shaped, coarsely toothed leaves; fragrant cream-colored flowers; and small globular fruit hanging from a narrow leafy bract. This genus was placed in the family Tiliaceae, but genetic research resulted in its being placed in Malvaceae. They are generally, but not always, called \"lime\" in Britain and \"linden\" or \"basswood\" in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tilia"@en .

aat:300343930 a skos:Concept ;
    skos:definition "Pose in Asian art and dance comprising a standing body position characterized by three-bends, often with the weight on one leg, tilted head, and the body curved in opposite directions at the waist and neck to form an \"S\" shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribhanga"@en .

aat:300343931 a skos:Concept ;
    skos:definition "Species of large European linden growing 20-40 m tall with a trunk up to 1-2 m diameter. It is widely planted in rows as a street tree, famously in Berlin's Unter den Linden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tilia cordata"@en .

aat:300343932 a skos:Concept ;
    skos:definition "Order of mostly of woody plants, consisting of 10 families, 338 genera, and about 6,000 species. The plants grow in various habitats throughout much of the world, and a number of members are important commercially."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malvales"@en .

aat:300343933 a skos:Concept ;
    skos:definition "Family containing 243 genera and at least 4,225 species of herbs, shrubs, and trees, common in the tropics but found in all but the coldest regions. Economically, the most important member of the family is cotton (Gossypium). Several species of Hibiscus produce fibers that are of lesser importance. The green fruits of okra (H. esculentus) are cooked and eaten, and the mucilage secreted in tissues of some species has been used in certain confections and for other purposes. Genera now included in Malvaceae were long thought to be very closely related, but, until DNA studies were done at the end of the 20th century, they were placed in four different families: Malvaceae, Bombacaceae, Tiliaceae, and Sterculiaceae, this group of families alone constituting Malvales for some earlier botanists. DNA evidence has shown that many of the genera in these families are interdigitated, a finding used for including them in a larger, single family rather than maintaining artificial lineages (ones that do not share a common ancestor)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malvaceae"@en .

aat:300343934 a skos:Concept ;
    skos:definition "Species of large shade tree, reaching 40 m (130 feet) in height, native to eastern North America. It provides wood for beehives, crating, furniture, and excelsior. It is a popular bee tree, producing a pale, distinctively flavored linden honey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tilia americana"@en .

aat:300343935 a skos:Concept ;
    skos:definition "Large tree that is a natural hybrid between the big-leaf linden (T. platyphyllos) and little-leaf linden (T. cordata). It was frequently planted in towns and parks, thus known by the name \"common lime\" since the 17th century. It is easily propagated by layering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tilia europaea"@en .

aat:300343936 a skos:Concept ;
    skos:definition "Genus containing 13-19 species of deciduous or evergreen woody trees and shrubs native to the temperate northern hemisphere; there are also several hybrids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesculus"@en .

aat:300343937 a skos:Concept ;
    skos:definition "Order of flowering plants including citrus, maples, horse chestnuts, lychees and rambutans, mangos and cashew, frankincense and myrrh, mahogany and neem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sapindales"@en .

aat:300343938 a skos:Concept ;
    skos:definition "Family containing two or three genera of trees and shrubs. Some classifications include members of the Hippocastanaceae, along with members of the Aceraceae, in an enlarged family of Sapindaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippocastanaceae"@en .

aat:300343939 a skos:Concept ;
    skos:definition "Wood of the species Aesculus indica, common in the Himalayan lowlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian horse chestnut"@en .

aat:300343940 a skos:Concept ;
    skos:definition "Genus containing over 400 species of flowering shrubs and trees, including the cultivated almond, peach, plum, cherry, and apricot. Some classifications separate peaches, almonds, and flowering almonds into the separate genus Amygdalus. However, a recent DNA study concluded that Prunus is monophyletic and is descended from one Eurasian ancestor. The earliest known fossil Prunus dates from the middle Eocene of the Princeton Chert of British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus"@en .

aat:300374809 a skos:Concept ;
    skos:definition "The property of strength, influence, and dominance over others, which can be personal, political, or national."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "power"@en .

aat:300374810 a skos:Concept ;
    skos:definition "Instances or events where enemies or adversaries are overcome in battle, usually by force of arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "victories"@en .

aat:300374811 a skos:Concept ;
    skos:definition "Family containing 8 genera of trees and shrubs having large aromatic leaves and flowers usually arranged in catkins, and are wind-pollinated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juglandaceae"@en .

aat:300374812 a skos:Concept ;
    skos:definition "Genus containing around 21 species of walnut trees, including several species that produce edible nut kernels, found across the north temperate Old World from southeast Europe east to Japan, throughout the New World."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juglans"@en .

aat:300374813 a skos:Concept ;
    skos:definition "Genus of 7-11 species of tree native to North America and Asia, valued as a bee hive tree, producing a light, mild-tasting honey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyssa"@en .

aat:300374814 a skos:Concept ;
    skos:definition "Species of tall deciduous walnut tree native to eastern and mid-western sections of North America, having a strong, durable wood used for furniture and other products and edible nuts. A dark brown dye is made from the nut husks and tree leaves. A drying oil obtained from pressing the nut kernel is used for artists' paints. Powdered walnut shells are used as a filler in plastics. Where the range of J. nigra overlaps that of the Texas black walnut J. microcarpa, the two species sometimes interbreed, producing populations with characteristics intermediate between the two species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juglans nigra"@en .

aat:300374815 a skos:Concept ;
    skos:definition "Areas of tree growth where the grain has grown in a deformed manner, such as in small knots from dormant buds, forming rounded outgrowths on a tree trunk or branch and wavy and circular patterns in timber and veneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burl"@en .

aat:300374816 a skos:Concept ;
    skos:definition "Species of tree found in the eastern half of North America from Canada to Alabama to the Mississippi River. Butternut timber is used for carving and furniture. The bark, root, leaf, and seed hulls are used for dyeing; with aluminum mordants, butternut hulls produce of colorfast brown on wool and a grayish-green on cotton. The colors can be darkened by the addition of ferrous sulfate. Butternut dye was used for the Confederate Army uniforms in the U.S. Civil War."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juglans cinerea"@en .

aat:300374817 a skos:Concept ;
    skos:definition "Species of tree native to tropical Asia and Australia, growing around 24 m in height and bearing pods 23-30 cm in length; produces fragrant flowers. It is used for environmental management, as a shade tree, forage, medicine, and timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albizia lebbek"@en .

aat:300374818 a skos:Concept ;
    skos:definition "Genus containing around 150 species of flowering trees, shrubs, and lianas of tropical and subtropical regions, some of which are cultivated as ornamentals or for their timber. The genus was named after Filippo del Albizzi, a Florentine nobleman who in 1749 introduced A. julibrissin into cultivation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albizia"@en .

aat:300374819 a skos:Concept ;
    skos:definition "Greek state religious festival that honored Athena. It was eventually celebrated every fourth year with great splendor, probably in deliberate rivalry to the Olympic Games. The festival consisted solely of the sacrifices and rites proper to the season (mid-August) in the cult of Athena, the city's protector. At the Great Panathenaea, representatives of all the dependencies of Athens were present, bringing sacrificial animals. After the presentation of a new embroidered robe to Athena, the sacrifice of several animals was offered. The great procession, which included the heroes of Marathon, is the subject of the frieze of the Parthenon. Musical contests were held, and portions of epic poems were recited, a long-standing accompaniment of the festival. The contests took place in the odeum, originally built for the purpose by Pericles himself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panathenaia"@en .

aat:300374820 a skos:Concept ;
    skos:definition "Genus containing 70-165 tropical and subtropical woody plants. In ancient and medieval times, the brazilwood was imported to Europe from the Middle East (Caesalpinia braziliensis and other species). Caesalpinia echinata (called pau-brasil in Portuguese) is indigenous to the Brazilian coast and played a role in the naming of that country; it was an important wood and dye export from South America beginning in the 17th century. Its hard, red-color wood is used for violins and high quality furniture. It accepts a high polish. The wood contains the colorant brasilin, a hydroxyanthraquinone, that gives a deep red to brownish color. Brazilwood dye, has been used for textile and leather dyes, inks, paints, varnish tints, and wood stains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caesalpinia"@en .

aat:300374821 a skos:Concept ;
    skos:definition "Species of timber and dyewood tree native to the Middle East; type species for the genus. When referring to \"brazilwood\" as a wood rather than as a plant, note that the product of any of several species of this genus may be intended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caesalpinia brasiliensis"@en .

aat:300374822 a skos:Concept ;
    skos:definition "Species of timber and dyewood tree native to the Middle East; type species for the genus. When referring to \"brazilwood\" as a wood rather than as a plant, the product of any of several species of this genus may be intended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caesalpinia echinata"@en .

aat:300374823 a skos:Concept ;
    skos:definition "Species of tree native to Sri Lanka, India, and Malaya, used as medicine, as an anti-bacterial, as an anti-coagulant, for reddish dye called brazilin used for dyeing fabric as well as making red paints and inks, and for its wood, which is somewhat lighter in color than Brazilwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caesalpinia sappan"@en .

aat:300374824 a skos:Concept ;
    skos:definition "Describes material or content created in electronic form and saved as digital data, having had no initial or interstitial state as an analog or physical product. Usually used to refer to electronically produced drafts of text, correspondence or visual works such as photographs created with digital cameras. This material may be written or saved on personal computers, floppy disks, CDs, DVDs, hard drives, or any mode of digital storage media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "born digital"@en .

aat:300374825 a skos:Concept ;
    skos:definition "Fighting with fists, usually with gloves over the hands, and often as sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boxing"@en .

aat:300374826 a skos:Concept ;
    skos:definition "Red dye produced from the hot water extraction of any of several tropical trees of the Caesalpinia genus. Its principal colorant is brasilin, a hydroxyanthraquinone. Used to dye textiles as early as the 12th century in Europe; the color is not lightfast and fades when heated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brazilwood dye"@en .

aat:300374827 a skos:Concept ;
    skos:definition "A yellow dye obtained from the stems and roots of the barberry (Berberis vulgaris) bush and other plants. It is used to dye wool, leather, and silk. It has also been used as a yellow lake pigment for coloring prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berberis dye"@en .

aat:300374828 a skos:Concept ;
    skos:definition "A red dye obtained from the Caesalpinia sappan tree native to India and Sri Lanka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sappanwood dye"@en .

aat:300374829 a skos:Concept ;
    skos:definition "Genus containing about 500 species of deciduous and evergreen shrubs having thorny shoots, native to the temperate and subtropical regions of Europe, Asia, Africa, and North and South America. They are closely related to the genus Mahonia, which is included within Berberis in some classifications. Berberis shrubs have yellow wood, yellow six-petaled flowers, and usually three-branched spines at the base of leafstalks. The fruit is a red, yellow, blue, purple, or black berry, with one to several seeds. The fruits of several species are made into jellies. The wood from the barberry stems and roots can be cooked in water to extract a strong yellow dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berberis"@en .

aat:300374830 a skos:Concept ;
    skos:definition "Family containing 15 genera of flowering plants commonly called barberries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berberidaceae"@en .

aat:300374831 a skos:Concept ;
    skos:definition "Order containing 7 families, 199 genera, and 4,445 species of flowering plants. Members of the order range from annual and perennial herbs to herbaceous or woody vines, shrubs, and, in a few cases, trees. Ranunculales is part of a group of families and orders informally called the basal eudicots. One of the main characteristics that distinguish these families and other eudicots from the monocotyledons (species with one embryonic leaf in their seed) and basal angiosperms is the pollen, which typically has three openings (colpi) instead of one. They also lack ethereal oils, which characterize many orders among the basal flowering plants. In Ranunculales, the petals seem to have evolved from staminodes (sterile stamens) rather than bracts (floral leaves), and the carpels are unfused in most members of the order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ranunculales"@en .

aat:300374832 a skos:Concept ;
    skos:definition "Species of shrub native to central and southern Europe, northwest Africa and western Asia, naturalized in northern Europe and North America. The seeds and berries are used for food; other parts of the plant are both mildly poisonous and medicinal. The bark has been used as a raw material for a natural dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Berberis vulgaris"@en .

aat:300374833 a skos:Concept ;
    skos:definition "General term referring to all apple trees other than those cultivated for fruit, generally having smaller and more tart fruit than the cultivated varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crabapple"@en .

aat:300374834 a skos:Concept ;
    skos:definition "Genus containing around 10 species of tall , deciduous ornamental and timber trees having furrowed bark and lance-shaped leaves; native to temperate regions of native to temperate zones in the North America, Europe, Africa, and Asia. Some species produce a light reddish brown wood used for construction and other purposes, and also extracts producing a vegetable dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castanea"@en .

aat:300374835 a skos:Concept ;
    skos:definition "Species of large, deciduous timber and forest tree originally found throughout North America. However, a fungus, Oriental chestnut blight, imported in the early part of the 20th century killed most of the trees. Before the species was devastated, it was one of the most important forest trees throughout its range. There are now very few mature specimens of the tree within its historical range, although many small sprouts of the former live trees remain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castanea dentata"@en .

aat:300374836 a skos:Concept ;
    skos:definition "Species of chestnut native to China. Nuts of the tree have local importance as food and are exported in large quantities. When cultivated close to other species of chestnut, it readily cross-pollinates to form hybrids. This species has evolved over a long period in coexistence with the bark fungal disease chestnut blight, and it has evolved a very successful resistance to the blight; although it is not immune, it typically sustains no more than minor damage when infected. This is in stark contrast to the American chestnut, which had no resistance to the blight, and was nearly wiped out after its introduction from Asia to North America in the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castanea mollissima"@en .

aat:300374837 a skos:Concept ;
    skos:definition "Species of chestnut growing to 30 m in height, native to Eurasia and northern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castanea sativa"@en .

aat:300374838 a skos:Concept ;
    skos:definition "Species of small to medium-sized chestnut originally native to Japan and South Korea, but now widely cultivated in eastern China and Taiwan. It is an important tree in Japan for its sweet, edible nuts, known in various cultivars that have been selected for large nut size. It is resistant to chestnut blight that devastated the American chestnut; it has been used in the development of disease-resistant hybrids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castanea crenata"@en .

aat:300374839 a skos:Concept ;
    skos:definition "Genus containing around 500 species of deciduous or evergreen trees and shrubs, generally native to the tropics. They are commonly known as ebony or persimmon trees. The leaves, which lack teeth, are usually borne alternately on opposite sides of the twig. The fruit is a large juicy berry with 1 to 10 seeds. Some members of the genus are valuable for their timber; others are cultivated for their handsome foliage or edible fruit. The wood was used by the ancient kings of India for scepters, sculptures, and drinking cups, because it was believed to prevent poisoning. Herodotus states that the Ethiopians every three years sent a tribute of 200 logs of ebony to Persia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros"@en .

aat:300374840 a skos:Concept ;
    skos:definition "Species of tree native to Angola; valuable as timber tree with very black and hard heartwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros dendo"@en .

aat:300374841 a skos:Concept ;
    skos:definition "Large, diverse order of dicotyledons (flowering plant having two cotyledons or seed-lobes), such as tea, persimmon, blueberry, Brazil nut, and azalea. In some older classifications, families in this order were distributed in various separate orders, such as the Ebenales order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ericales"@en .

aat:300374842 a skos:Concept ;
    skos:definition "Family of trees and shrubs placed in four genera with about 490 species, found throughout the tropics and some also in temperate regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ebenaceae"@en .

aat:300374843 a skos:Concept ;
    skos:definition "Species of ebony tree found in abundance throughout the flat country west of Trincomalee in Sri Lanka. The tree is distinguished by the width of its trunk and its jet-black, charred-looking bark, beneath which the wood is pure white until the heart is reached. The heartwood excels in fineness and in the intensity of its dark color. Although the center of the tree alone is used, reduced logs 30 cm to almost 1 m (1 to 3 feet) in diameter can be obtained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros ebenum"@en .

aat:300374844 a skos:Concept ;
    skos:definition "Large ebony tree attaining 18-24 m in height and a circumference of 3 m, with irregular branches and oblong leaves; native to India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros melanoxylon"@en .

aat:300374845 a skos:Concept ;
    skos:definition "Important fruit-producing tree in China and Japan; it is the most widely cultivated species of the Diospyros genus and among the oldest plants in cultivation, known for its use in China for more than 2000 years. The fruit is sweet, slightly tangy, and soft to fibrous in texture. It is known in numerous cultivars throughout eastern Asia, California, southern Europe, and Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros kaki"@en .

aat:300374846 a skos:Concept ;
    skos:definition "Wood from any of various species producing decorative timber with mottled or banded grain resembling marble."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marblewood"@en .

aat:300374847 a skos:Concept ;
    skos:definition "General term for wood from any of several species of tree or shrub having ornamentally striped wood used by cabinet-makers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zebra wood"@en .

aat:300374848 a skos:Concept ;
    skos:definition "Species of ebony tree native to India and the Andaman Islands, valued for heavy, durable wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros kurzii"@en .

aat:300374849 a skos:Concept ;
    skos:definition "Genus containing around18 species of forest, timber, and ornamental shade trees native primarily to North Temperate areas. Many are cultivated for their height and attractive foliage. Prior to the industrial revolution, elms were also used as water pipes and in water pumps in large cities because they are durable in water. From 1925 to the mid 20th century, many of the native European and North American elms were killed by the Dutch elm disease. These trees are now being replaced by the disease resistant Chinese elm. Elm leaves are doubly toothed and often lopsided at the base. The petalless flowers appear before the leaves and are borne in clusters on jointed stems. The nutlike fruit, surrounded by a flat, sometimes hairy, winglike structure, is called a samara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmus"@en .

aat:300374850 a skos:Concept ;
    skos:definition "Family containing 15 genera of trees and shrubs distributed primarily throughout temperate regions, having watery sap and leaves that alternate along the stem. The leaves usually have toothed edges and often are lopsided at the base. The flowers lack petals. Male and female flowers are borne together or apart on the same plant. The fruit, a samara, may be winged, fleshy, or nutlike. In earlier classifications, the family was placed in the former order Urticales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmaceae"@en .

aat:300374851 a skos:Concept ;
    skos:definition "Describes the culture of Arabic-speaking Bedouins living in the Western Desert of Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Awlad ‘Ali"@en .

aat:300374852 a skos:Concept ;
    skos:definition "Describes an African people living in Cameroon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hide"@en .

aat:300374853 a skos:Concept ;
    skos:definition "Species of tall, deciduous tree that grew widely in the eastern half of North America, and was popularly used for lumber, shade, and ornamentation prior to the 1930's. The hard, tough coarse-grain wood was also used for ship building because it bends well and does not splinter. Dutch elm disease, a fungus carried by the elm-leaf beetle, has systematically killed many of these trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmus americana"@en .

aat:300374854 a skos:Concept ;
    skos:definition "Species of elm native to the northeastern United States, similar to American elm in general appearance, but more closely related to the European wych elm, which has a very similar flower structure. It has a gluelike substance in the inner bark, which was formerly steeped in water as a remedy for throat ailments, powdered for use in poultices, and chewed as a thirst-quencher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmus rubra"@en .

aat:300374855 a skos:Concept ;
    skos:definition "Species of elm native to China but now found throughout the world as an ornamental, having small, lustrous leaves and interesting mottled bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmus parvifolia"@en .

aat:300374856 a skos:Concept ;
    skos:definition "Species of tall, fast-growing European elm, found mainly in England and Wales; before the advent of Dutch elm disease, it was one of the most common deciduous trees in Europe. It probably originated in Italy or Turkey: a survey of genetic diversity in Spain, Italy and Britain shows that all of this species are genetically identical clones of a single tree, probably brought to the British Isles by Romans for the purpose of supporting and training vines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmus procera"@en .

aat:300374857 a skos:Concept ;
    skos:definition "Slow-growing species of elm native to North America from Ontario and Quebec to Tennessee, Kansas, and Minnesota, having hard, heavy wood used for various products, and twigs that often develop corky ridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmus thomasii"@en .

aat:300374858 a skos:Concept ;
    skos:definition "Large, relatively smooth-barked elm native found at elevations above 1500 meters throughout Europe, from Ireland to the Urals, to the polar circle south to the Peloponnese in Greece, and in Iran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ulmus glabra"@en .

aat:300374859 a skos:Concept ;
    skos:definition "Genus containing over 700 species of evergreen trees native to Australia, New Zealand, Tasmania, and nearby islands, but now grown in many subtropical locations around the world, including California, Spain, South America, India, and South Africa. Eucalyptus wood is used for construction, papermaking, and other purposes. The bark is high in tannins and used for leather production. Eucalyptus oil is obtained from the dry leaves of several species of eucalyptus trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus"@en .

aat:300374860 a skos:Concept ;
    skos:definition "Order of flowering plants composed of 14 families, 380 genera, and about 11,000 species distributed throughout the tropics and warmer regions of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myrtales"@en .

aat:300374861 a skos:Concept ;
    skos:definition "Species of large tree native to Australia, distinguished from other eucalyptus by having rough bark half way up the trunk, where white smooth bark appears, and leaves of a glossy dark green. It is a koala food tree, is cut for timber, but is mainly used commercially for its abundant, pungent oil, used in pharmaceuticals, as an antiknock agent in gasoline and for the manufacture of menthol. The common name, blackbutt, refers to appearance of the type specimen collected in 1794, which had a black base after fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus pilularis"@en .

aat:300374862 a skos:Concept ;
    skos:definition "Species of hardwood tree native to eastern Australia. In some current classifications, it is placed under the genus Corymbia, as Corymbia gummifera. Its heartwood is very strong and durable, but has extensive gum lines. It is used for poles, fencing, and mining timbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus gummifera"@en .

aat:300374863 a skos:Concept ;
    skos:definition "Wood from the species Eucalyptus gummifera, used for rough construction, for example, as mining timbers, poles, fences, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red bloodwood"@en .

aat:300374864 a skos:Concept ;
    skos:definition "Style indigenous to Los Angeles, California that combines many disparate styles such as Georgian, Federal, and English Regency itself with designs evocative of Hollywood film glamour. In architecture, the style is characterized by the use of boxy, Modernist forms, stucco walls, and the linking of indoor and outdoor spaces via French or glass doors. Furniture and design typically favor bold prints juxtaposed with white and gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hollywood Regency"@en .

aat:300374865 a skos:Concept ;
    skos:definition "Species of forest tree native to New South Wales, Victoria, and Queensland, Australia. It is used as a timber tree and for its nectar in honey production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus paniculata"@en .

aat:300374866 a skos:Concept ;
    skos:definition "Species of evergreen eucalyptus grown commercially in Morocco for the bark, which contains tannin valued for the soft, dark red color achieved when used for tanning leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus sideroxylon"@en .

aat:300374867 a skos:Concept ;
    skos:definition "Genus containing four extant species of large, deciduous trees, and several fossil species. The genus was much more widespread in the Tertiary, but has disappeared from Europe, western North America, and the Russian far East due to glaciation and climate change. The trees are valued for resin, timber, and ornament, producing bright red leaves in the fall. The resin from liquidambar trees (storax) has been used in perfumes and embalming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liquidambar"@en .

aat:300374868 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to warm temperate areas of eastern North America; it is a popular ornamental."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liquidambar styraciflua"@en .

aat:300374869 a skos:Concept ;
    skos:definition "Order of dicotyledonous flowering plants, consisting of 16 families, 112 genera, and nearly 2,500 species, encompassing a wide variety of plant types distributed throughout the world, including shrubs and trees, rock-garden plants, familiar garden ornamentals, and bushes that yield currants and gooseberries. It belongs to the core eudicots, and, although its phylogenetic position is not well resolved, it is probably sister to the Rosid group in the Angiosperm Phylogeny Group II botanical classification system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saxifragales"@en .

aat:300374870 a skos:Concept ;
    skos:definition "Small family containing three genera of trees that are wind-pollinated and produce hard, woody fruits containing numerous seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Altingiaceae"@en .

aat:300374871 a skos:Concept ;
    skos:definition "Genus of trees containing around 70 species in the hemp family (Cannabaceae), native to temperate and tropical areas of the northern hemisphere, valued for their wood and as ornamentals. Formerly was placed in the elm family. In some classifications, Celtis forms its own family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtis"@en .

aat:300374872 a skos:Concept ;
    skos:definition "Small family of flowering plants containing 11 genera and 270 species of aromatic herbs distributed throughout temperate parts of the northern hemisphere. Members of the family are erect or climbing plants with petalless flowers and dry, one-seeded fruits. Hemp (Cannabis) and hop (Humulus) are the only economically important genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cannabaceae"@en .

aat:300374873 a skos:Concept ;
    skos:definition "Species of deciduous tree native to slopes in East Asia, having gray bark and globose drupe fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtis sinensis"@en .

aat:300374874 a skos:Concept ;
    skos:definition "Species of hackberry native to Mediterranean climates and used as an ornamental elsewhere, having lance-shaped, gray-green leaves and relatively large edible fruit. This plant may have been the Lotus described by ancient writers as sweet and wholesome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtis australis"@en .

aat:300374875 a skos:Concept ;
    skos:definition "Fibers from plants of the nettle family, cultivated for centuries in Europe and Asia for making ropes and sails. Nettle fibers are light-color, soft, and strong They are used for twine, rope, canvas and sailcloth. Nettle fibers are also used as substitutes for flax and hemp."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nettle"@en .

aat:300374876 a skos:Concept ;
    skos:definition "Family containing around 45 genera of herbs, shrubs, small trees, and vines, distributed primarily in tropical regions. The family is typical of the nettle order (Urticales). Many species, especially the nettles (Urtica) and Australian nettle trees (Laportea), have stinging hairs on the stems and leaves. The leaves are varied and the sap is usually watery. The small, greenish flowers often form clusters in the leaf axils. Both male and female flowers may be borne on the same plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urticaceae"@en .

aat:300374877 a skos:Concept ;
    skos:definition "Members of this order are now under Rosales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Urticales"@en .

aat:300374878 a skos:Concept ;
    skos:definition "Species of shrub or small tree native to eastern North America, but very uncommon north of the Ohio River; designated as threatened. Found in dry upland habitats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtis tenuifolia"@en .

aat:300374879 a skos:Concept ;
    skos:definition "Wood of the species Celtis occidentalis; the wood is light-colored, yellowish gray to light brown with yellow streaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common hackberry"@en .

aat:300374880 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to North America, having bright green elm-like leaves with three prominent veins arising from the base of the blade, and edible pea-sized purplish-black fruits attractive to birds. The bark is sometimes covered with wartlike bumps. It is easily cultured and common as a street tree, attaining heights of 12-30 meters (40-100 feet)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtis occidentalis"@en .

aat:300374881 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to North America. It is easily confused with common hackberry, (C. occidentalis) where the ranges overlap, but the Mississippi hackberry is a shorter tree living in bottomland moist soils and having narrower leaves which are smoother above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtis laevigata"@en .

aat:300374882 a skos:Concept ;
    skos:definition "Letters given by one person to another as a means of acquainting the bearer with a third person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letters of introduction"@en .

aat:300374883 a skos:Concept ;
    skos:definition "Cards or papers intended to be returned to the sender of the document with information appended from a recipient, used variously regarding subscriptions, appointments, invitations, or surveys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reply cards"@en .

aat:300374884 a skos:Concept ;
    skos:definition "Porches, usually attached to residential buildings, that are enclosed with small mesh screening between the columns or pillars, to permit ventilation but bar insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screened porches"@en .

aat:300374886 a skos:Concept ;
    skos:definition "Genus containing around 400 species of red- or black-berried plants, including the popular Christmas hollies grown for ornamentation. Timber from the holly has a fine uniform texture. The trees provide shelter, protection from predators, and food for birds, other animals, and insects; the berries are mildly poisonous to humans. Ilex is the only living genus in the family Aquifoliaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ilex"@en .

aat:300374887 a skos:Concept ;
    skos:definition "Family containing one living genus of holly trees and shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aquifoliaceae"@en .

aat:300374888 a skos:Concept ;
    skos:definition "Order of flowering plants containing the holly family and other families of trees and shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aquifoliales"@en .

aat:300374889 a skos:Concept ;
    skos:definition "Genus containing around 25 species of hardy, slow-growing ornamental and timber trees distributed throughout the northern hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carpinus"@en .

aat:300374890 a skos:Concept ;
    skos:definition "Species of small to medium-sized hornbeam tree having a twisted trunk that branches profusely; may grow to 20 m (65 feet) in height. One variety bears normal and oaklike leaves on the same tree. It is used in landscape gardening, mainly as tall hedges and for topiary, as timber, slow-burning firewood, and as food for various animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carpinus betulus"@en .

aat:300374891 a skos:Concept ;
    skos:definition "Genus containing around 7 species of ornamental trees native to Eurasia and North America, having a shaggy, scaly bark and thin, translucent, green leaves with hairy leafstalks. The hoplike, green fruits are composed of many bladderlike scales, each bearing a small, flat nut."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostrya"@en .

aat:300374892 a skos:Concept ;
    skos:definition "Species of deciduous understory tree native to Canada and the United States. The buds and catkins are an important source of winter food for certain birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostrya virginiana"@en .

aat:300374893 a skos:Concept ;
    skos:definition "Species of medium-sized hop hornbeam plant found in Italy, France, Austria, Slovenia, Greece, the Balkans, southern Switzerland, and Anatolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostrya carpinifolia"@en .

aat:300374894 a skos:Concept ;
    skos:definition "Genus containing around 15 species of deciduous trees and large shrubs native to the temperate northern hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corylus"@en .

aat:300374895 a skos:Concept ;
    skos:definition "Species of horse chestnut native to California, the poisonous fruit of which was formerly used by Native Americans to stun game fish; the toxins are boiled from it and it is used for food and fodder; mildly toxic shoots are grazed by livestock and wildlife."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesculus californica"@en .

aat:300374896 a skos:Concept ;
    skos:definition "Species of large deciduous tree native to southeastern Europe but widely cultivated as a large shade and street tree; it grows to a height of 30 meters (100 feet). The Champs-Élysées in Paris is lined with rows of horse chestnut trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesculus hippocastanum"@en .

aat:300374897 a skos:Concept ;
    skos:definition "Species of small horse chestnut tree or bush having long clusters of pink to dark red tubular flowers; native to the southern and eastern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesculus pavia"@en .

aat:300374898 a skos:Concept ;
    skos:definition "Species of horse chestnut common in the Himalayan lowlands., between Kashmir and Western Nepal at elevations between 900 and 3,000 meters. It was introduced to the British Isles and is popular there in many parks and estates; having slender, pointed leaflets, has attractive feathery flower spikes with a bottlebrush effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesculus indica"@en .

aat:300374899 a skos:Concept ;
    skos:definition "Species of medium-sized horse chestnut native to the midwestern and lower Great Plains regions of the United States and some areas of Canada. The fruits contain tannic acid, and are poisonous for cattle and humans. Native Americans blanched them to extract tannic acid for processing leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesculus glabra"@en .

aat:300374900 a skos:Concept ;
    skos:definition "Species of medium-sized horse chestnut native to the Ohio Valley and Appalachian Mountains of the Eastern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aesculus octandra"@en .

aat:300374905 a skos:Concept ;
    skos:definition "Surgical tools for removing glands, particularly the adenoid glands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adenotomes"@en .

aat:300374906 a skos:Concept ;
    skos:definition "Devices used to meaure the angle of a horse's hoof to ensure it level to the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoof levelers"@en .

aat:300374908 a skos:Concept ;
    skos:definition "Genus containing balsa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ochroma"@en .

aat:300374909 a skos:Concept ;
    skos:definition "Family containing 51 genera and around 575 species of trees and rarely shrubs native to tropical and subtropical regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Meliaceae"@en .

aat:300374910 a skos:Concept ;
    skos:definition "Genus containing 7 species of evergreen or deciduous trees with pinnate leaves, native to the tropical and subtropical New World."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cedrela"@en .

aat:300374911 a skos:Concept ;
    skos:definition "Genus of flowering trees having pinnate or bipinnate leaves and axillary panicles of white or purple flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melia"@en .

aat:300374912 a skos:Concept ;
    skos:definition "Genus of conifers native to eastern Asia and western and eastern North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chamaecyparis"@en .

aat:300374913 a skos:Concept ;
    skos:definition "The genus Callitropsis is in the family Cupressaceae in the major group Gymnosperms (Conifers, cycads and allies)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Callitropsis"@en .

aat:300374914 a skos:Concept ;
    skos:definition "Genus of flower plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maclura"@en .

aat:300374915 a skos:Concept ;
    skos:definition "Genus containing 14 or more species of small, broad-leaved, evergreen, flowering trees or shrubs, having white or pink flowers in loose, terminal clusters and by many-seeded, fleshy, red or orange berries with a distinctive irregular surface; the leaves are alternate and stalked. The plants are native to southern Europe and western North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arbutus"@en .

aat:300374916 a skos:Concept ;
    skos:definition "Genus containing 14 or more species of small, flowering trees or shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ericaceae"@en .

aat:300374917 a skos:Concept ;
    skos:definition "General term for several species of various genera of the family Elapidae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobras"@en .

aat:300374918 a skos:Concept ;
    skos:definition "Family containing around 300 species of venomous snakes, characterized by short fangs fixed in the front of the upper jaw. Terrestrial elapids generally resemble the more abundant colubrids, whereas aquatic elapids may possess paddle-shaped tails and other structures adapted to marine environments. Most species lay eggs; a few, chiefly in Australia, bear living young."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elapidae"@en .

aat:300374919 a skos:Concept ;
    skos:definition "Family containing around 36 genera and more than 400 species of semiparasitic shrubs, herbs, and trees, distributed in tropical and temperate regions. Modern classifications with Santalaceae include the former family Viscaceae (mistletoes), previously considered distinct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santalaceae"@en .

aat:300374920 a skos:Concept ;
    skos:definition "Order containing 8 families, 151 genera, and about 1,000 species of flowering plants. All the families in Santalales are parasitic to some degree, attaching either to the roots or branches of their hosts. Members have a cosmopolitan distribution, but are most heavily concentrated in tropical and subtropical regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santalales"@en .

aat:300374922 a skos:Concept ;
    skos:definition "Adzes used specifically for railroad work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad adzes"@en .

aat:300374924 a skos:Concept ;
    skos:definition "Devices used for circulating air through milk. Often used to remove animal heat, gases, and odors from fresh milk before canning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milk aerators"@en .

aat:300374925 a skos:Concept ;
    skos:definition "Tools for gathering and measuring features or substances present in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aeroscopes"@en .

aat:300374926 a skos:Concept ;
    skos:definition "Instruments used to measure sensory discrimination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "esthesiometers"@en .

aat:300374927 a skos:Concept ;
    skos:definition "Devices partially composed of a differential thermometer and used to calculate variations in conditions of the sky, particularly solar radiation, and the resulting changes in temperature. Invented by Sir John Leslie."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aethrioscopes"@en .

aat:300374928 a skos:Concept ;
    skos:definition "Strings or bands worn around the head in order to secure a kaffiyeh in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agals"@en .

aat:300374932 a skos:Concept ;
    skos:definition "Unmanned aircraft, often guided by remote control, used for strategic reconnaissance, aerial surveys or to deploy weaponry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drone aircraft"@en .

aat:300374933 a skos:Concept ;
    skos:definition "Process of applying oil on or to; rubbing, smearing, covering, moistening, or lubricating with oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oiling"@en .

aat:300374934 a skos:Concept ;
    skos:definition "Describes African people living in southern Ethiopia. They are distinct from the Hamar but live in close proximity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banna"@en .

aat:300374935 a skos:Concept ;
    skos:definition "Genus containing around 1,000 species of evergreen shrubs and trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Casearia"@en .

aat:300374936 a skos:Concept ;
    skos:definition "Order containing about 16,000 species of diverse flowering plants divided into 32 to 42 families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malpighiales"@en .

aat:300374937 a skos:Concept ;
    skos:definition "Family containing 55 genera and more than 1,000 species of deciduous or evergreen shrubs and trees. The family is most common in the tropics and grows worldwide, except for New Zealand, and only a few species are found in Australia. Classification is disputed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salicaceae"@en .

aat:300374938 a skos:Concept ;
    skos:definition "Species of evergreen tree that is among the most widely cultivated trees native to Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus globulus"@en .

aat:300374939 a skos:Concept ;
    skos:definition "Species of Eucalyptus native to southeastern Australia, Tasmania, and Victoria. One of the tallest tree species in the world, reaching 100 meters (330 feet) in height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus regnans"@en .

aat:300374940 a skos:Concept ;
    skos:definition "Species of tree native to western Australia, distinctive among bloodwoods in having very large buds and fruit, \"honky nuts.\" The species is confused with the related red-flowering gum (Corymbia ficifolia), but differs in being much taller (50 meters, 160 feet); hybridization between the two makes identification difficult. Formerly classified in genus Eucalyptus, until the mid-1990s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corymbia calophylla"@en .

aat:300374941 a skos:Concept ;
    skos:definition "Genus containing around 113 species that were formerly classified as genus Eucalyptus until the mid-1990s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corymbia"@en .

aat:300374942 a skos:Concept ;
    skos:definition "Bound collections of autographs, writings, paintings, and drawings collected by the owner from his or her friends and acquaintances. Thought to have developed in German-speaking Europe in the mid-16th century; the custom was spread by students traveling from one university to another. Albums were soon compiled by people other than students, particularly men and women of the bourgeoisie. Albums belonging to members of the nobility usually contained drawings of coats-of-arms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alba amicorum"@en .

aat:300374943 a skos:Concept ;
    skos:definition "Airships constructed with partial frameworks consisting of rigid, or partially flexible keel frames along the long axis under an aerodynamic hull envelope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semi-rigid airships"@en .

aat:300374944 a skos:Concept ;
    skos:definition "The dominions, regions, or peoples, ruled by chieftans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiefdoms"@en .

aat:300374945 a skos:Concept ;
    skos:definition "Construction without the use of mortar, such as drywall construction, or construction out of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortarless construction"@en .

aat:300374946 a skos:Concept ;
    skos:definition "Genus of trees and shrubs native to Europe and North America, having simple leaves that are toothed or lobed, and clusters of white or pink flowers; fruit are red, blue, black and resemble small apples. Many cultivated varieties are valued as ornamentals for their attractive flowers and fruits, and for the growth habit of horizontal branching. The small red or black fruit are used in an ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crataegus"@en .

aat:300374947 a skos:Concept ;
    skos:definition "Wood of the species Crataegus monogyna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common hawthorn"@en .

aat:300374948 a skos:Concept ;
    skos:definition "Species of tree or shrub native to Europe, northwest Africa, and western Asia, used extensively for hedges. It bears white, red or pink blossoms (called 'may'); its fruit, the haw, is a small, round, dark red berry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crataegus monogyna"@en .

aat:300374949 a skos:Concept ;
    skos:definition "Genus containing around 18 species of deciduous timber and nut-producing trees native to eastern North America and eastern Asia. Fossil remains identifiable as belonging to the genus are found in western North America, Greenland, Iceland, and Europe. It has tough heavy wood, and drupes (mostly with a hard woody rind or husk) enclosing 'nuts,' the kernels of which in several species are edible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya"@en .

aat:300374950 a skos:Concept ;
    skos:definition "Species of slow-growing, long-lived tree native from Ontario to Minnesota, Florida and Mexico, but most prominent in the lower Ohio River region and south along the Mississippi River to central Arkansas. It is frequently found in the great river swamps of central Missouri and the Wabash River region in Indiana and Ohio. It has a long taproot and is thus hard to transplant; it is also subject to insect damage. Its sweet, edible nuts are the largest of all hickory nuts, though enclosed in a very hard shell. the nuts are harvested by humans and wildlife, including ducks, quail, wild turkeys, squirrels, chipmunks, deer, foxes, raccoons, and white-footed mice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya laciniosa"@en .

aat:300374951 a skos:Concept ;
    skos:definition "Species of large pecan hickory; living to around 200 years old, it is the shortest lived of the hickories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya cordiformis"@en .

aat:300374952 a skos:Concept ;
    skos:definition "Species of tree found in the Eastern United States and Canada, having pear-shaped nuts that are important foods for many wild animals. The wood is used for a variety of products, including fuel for home heating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya glabra"@en .

aat:300374953 a skos:Concept ;
    skos:definition "Species of hickory tree native to south-central North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya texana"@en .

aat:300374955 a skos:Concept ;
    skos:definition "Species of hickory tree native to the United States; most abundant of the hickories and very long-lived, sometimes reaching 500 years in age. Used for hard, durable wood and for its bark to produce a color-fast dye, giving a dark yellow (cotton) to golden (wool) color using an alum mordant. With a chrome mordant, it will give a brass color to wool and cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya tomentosa"@en .

aat:300374956 a skos:Concept ;
    skos:definition "Species of hickory tree native to the central and southern United States and Mexico; cultivated elsewhere. Its reddish wood is used for interior millwork. The hulls are used to dye wool a dark brown or cotton a gray color using an alum mordant. Pecan hull dyes have fair colorfastness. Its nut is rich and distinctive in flavor and texture, having one of the highest fat contents of any vegetable product and a caloric value close to that of butter. Its production is the basis of a considerable industry in the southeastern United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya illinoensis"@en .

aat:300374957 a skos:Concept ;
    skos:definition "Species of large tree native to the eastern United States and southeast Canada, growing up 27 meters tall and living to 200 years. Mature trees are recognized by their rough shinglelike bark; young trees have smooth bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carya ovata"@en .

aat:300374958 a skos:Concept ;
    skos:definition "Genus containing around 200 species of evergreen trees and shrubs distributed primarily in tropical and subtropical regions of Central America, South America, the West Indies, and Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ocotea"@en .

aat:300374959 a skos:Concept ;
    skos:definition "Genus of evergreen trees and shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phoebe"@en .

aat:300374960 a skos:Concept ;
    skos:definition "Genus of trees and shrubs containing 114 species distributed in tropical America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nectandra"@en .

aat:300374961 a skos:Concept ;
    skos:definition "Genus of African trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chlorophora"@en .

aat:300374962 a skos:Concept ;
    skos:definition "Family of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Clusiaceae"@en .

aat:300374963 a skos:Concept ;
    skos:definition "Genus of flowering plants native to tropical southern Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesua"@en .

aat:300374964 a skos:Concept ;
    skos:definition "Species of slow-growing tree that reaches 18 meters (60 feet) in height; cultivated in tropical climates for timber and for its form, foliage, and fragrant flowers. It has shining green, willowy foliage that is scarlet when young, and fragrant, yellow-centered, white flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesua ferrea"@en .

aat:300374965 a skos:Concept ;
    skos:definition "Species of small tree or shrub characterized by twigs with prominent swollen nodes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ixora ferrea"@en .

aat:300374966 a skos:Concept ;
    skos:definition "Order of flowering plants; some systems place families in this order within Gentianales order instead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubiales"@en .

aat:300374967 a skos:Concept ;
    skos:definition "Family of flowering plants containing around 610 genera and more than 13,000 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubiaceae"@en .

aat:300374968 a skos:Concept ;
    skos:definition "Genus containing over 525 species of tropical evergreen trees and shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ixora"@en .

aat:300374970 a skos:Concept ;
    skos:definition "Small removable cases that are part of pickup arms on phonographs, gramophones, or record players. Cartridges contain styluses and mechanisms for translating stylus motion into changing electrical voltage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartridges"@en .

aat:300374971 a skos:Concept ;
    skos:definition "Flanged cores around which magnetic tape media is wound for storage and playback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tape reels"@en .

aat:300374972 a skos:Concept ;
    skos:definition "Stands upon which microphones may be mounted for performance or recording."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microphone stands"@en .

aat:300374973 a skos:Concept ;
    skos:definition "Needles that reproduce the sounds of phonograph records as a result of their vibrations as they follow grooves on rotating discs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "styluses"@en .

aat:300374974 a skos:Concept ;
    skos:definition "Upright bars, props or supports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stanchions"@en .

aat:300374975 a skos:Concept ;
    skos:definition "Building block to be used with other similar building blocks in the construction of buildings. May be made of a variety of materials in a variety of shapes and sizes. Often standardized and/or modular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction block"@en .

aat:300374976 a skos:Concept ;
    skos:definition "Large units of building material made from a mixture of cement and an aggregate, usually 8 x 16 inches and of various thicknesses. A mixture of cement, aggregate, and water is vibrated and compacted in steel molds and then cured in air, steam, or under autoclaving processes. Became a very popular building material beginning in the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete blocks"@en .

aat:300374977 a skos:Concept ;
    skos:definition "Material made from glass, having a three-dimensional rectangular form and used architectural building or decorative elements; its function is to admit light while providing visual obscuration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass block"@en .

aat:300374978 a skos:Concept ;
    skos:definition "Stones on which the date of the construction of a building is inscribed, located on the exterior of the building. Date stones may appear over the main entrance, on a cornerstone, or in other locations on the building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "date stones"@en .

aat:300374979 a skos:Concept ;
    skos:definition "Doors or door systems, made with four partitions at right angles, which revolve on an axis in order to allow large numbers of people through, and to eliminate drafts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revolving doors"@en .

aat:300374980 a skos:Concept ;
    skos:definition "Decorative elements directly above doorways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorcaps"@en .

aat:300374981 a skos:Concept ;
    skos:definition "Species of large, deciduous tree native to the Himalayas, Iran, Lebanon, Asia Minor, and Greece, and growing in Britain and elsewhere since about the middle of the 15th century. It reaches heights to 35 meters with a trunk up to 2 meters in diameter. It has a short trunk and broad crown, though taller and narrower in dense forest competition; it thrives in full sun. It is a valuable timber tree; other portions of the tree also have commercial value. The nut kernels are used for cooking and the pale yellow fast-drying oil expressed from the nuts is used for artists' paints. Tannins and dyes are extracted from the nut hulls and shells that produce a brown color. Ground nut shells have been used as a soft abrasive and a plastic filler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juglans regia"@en .

aat:300374982 a skos:Concept ;
    skos:definition "Species of tree native to native to the islands of Cuba and Jamaica in the Caribbean. beautiful and durable timber that is widely used for cabinet making and also for making decorative objects such as picture frames, bowls and wood carvings. The inner bark of the tree is often referred to as Cuba bark because it was formerly used for tying bundles of Havana cigars. The wood has been traditionally used in the making of cuatros, a type of lute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hibiscus elatus"@en .

aat:300374983 a skos:Concept ;
    skos:definition "Genus containing around 350 species of herbs, shrubs, and trees native to warm temperate and tropical regions. Several are cultivated as ornamentals for their showy flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hibiscus"@en .

aat:300374984 a skos:Concept ;
    skos:definition "Species of tree growing 65 to 130 feet high tree; found in the Amazon region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mezilaurus itaúba"@en .

aat:300374985 a skos:Concept ;
    skos:definition "Genus of flowering plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mezilaurus"@en .

aat:300374986 a skos:Concept ;
    skos:definition "Genus containing two or three species of small lilac-like trees native to the mountains of southern Europe from France to the Balkan Peninsula. The trees have yellow flowers that develop into pods of poisonous seeds; all parts of the plant are poisonous: laburnum has proved fatal to cattle, although other animals, such as hares are immune. The wood of laburnums is prized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laburnum"@en .

aat:300374987 a skos:Concept ;
    skos:definition "Wood from the species Oxandra lanceolata from northern South America and the West Indies; the most important commercial timber source of the lancewood family. It has a smooth close grain; its elasticity has made it useful for making bows, fishing rods, billiard cues, tool handles, carriage shafts, wheel spokes, and cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "true lancewood"@en .

aat:300374988 a skos:Concept ;
    skos:definition "Species of slender tree native to Guaiana and harvested as taper poles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oxandra lanceolata"@en .

aat:300374989 a skos:Concept ;
    skos:definition "Order of flowering plants consisting of 5 families, 154 genera, and around 3,000 species. Members of Magnoliales include woody shrubs, climbers, and trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magnoliales"@en .

aat:300374990 a skos:Concept ;
    skos:definition "Family of flowering plants consisting of trees, shrubs, and lianas having around 130 genera and 2,500 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Annonaceae"@en .

aat:300374991 a skos:Concept ;
    skos:definition "Genus of flowering plants consisting of trees, shrubs, and lianas having around 130 genera and around 2,500 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oxandra"@en .

aat:300374992 a skos:Concept ;
    skos:definition "Genus of containing around 195 species of rainforest trees native to southeast Asia, from Northern India to Malaysia, Indonesia, and the Philippines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shorea"@en .

aat:300374993 a skos:Concept ;
    skos:definition "Family of largely South Asian and African timber trees, comprising 17 genera and 680 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dipterocarpaceae"@en .

aat:300374994 a skos:Concept ;
    skos:definition "Genus containing 3 species of evergreen trees. Fossils dating to before the Pleistocene glaciations suggest that species of Laurus were formerly distributed more widely around the Mediterranean and North Africa, when the climate was more humid and mild than at present. It is currently thought that the drying of the Mediterranean basin during the glaciations caused Laurus to retreat to the mildest climate refuges, including southern Spain, Portugal and the Macaronesian islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laurus"@en .

aat:300374995 a skos:Concept ;
    skos:definition "Wood the species Laurus nobilis native to the Mediterranean region; used for small novelties, carving, and marquetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bay laurel"@en .

aat:300374996 a skos:Concept ;
    skos:definition "Species of aromatic evergreen tree native to the Mediterranean region but widely cultivated elsewhere, growing 6-18 meters (20-60 feet) in height and having stiff, alternate, oval leaves that are dull and leathery, around 8 cm (3.5 inches) long; the leaf edges are smooth and often wavy, used as a cooking herb. In ancient Greece the wreath of honor placed upon the heads of heroes and winners of games was made from the leaves and branches of this species. The small and inconspicuous flowers are yellowish or greenish white. The fruit is a green, purple, or blackish berry containing a single seed, and when pressed, producing an aromatic oil. The wood is strong and elastic, used for carving and marquetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laurus nobilis"@en .

aat:300374997 a skos:Concept ;
    skos:definition "Wood of the species Calycohyllum candidissimum, native to Cuba, Mexico, Columbia and Venezuela. It has a non-durable heartwood ranging in color from light brown to tan, and is used for making archery bows, fishing rods, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calycophyllum candidissimum"@en .

aat:300374998 a skos:Concept ;
    skos:definition "Genus of medium to large tropical American trees having shiny reddish-brown shredding bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calycophyllum"@en .

aat:300374999 a skos:Concept ;
    skos:definition "Family family of woody shrubs and trees (and a few herbaceous perennials) and consisting of around 160 genera and 1,700 species distributed throughout the world, especially in warm temperate and tropical regions; the largest numbers are found in Africa and Australia, often in semiarid woodlands. Many members are valuable as sources of edible fruit and as ornamentals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rutaceae"@en .

aat:300375000 a skos:Concept ;
    skos:definition "Genus of plants that includes the citron, lemon, lime, orange, grapefruit, tangerine, shaddock, and their many varieties, most yielding pulpy fruits covered with fairly thick skins. The genus is believed to have originated in southeast Asia; citrus has been cultivated in an increasingly large area since ancient times. The precise number of natural species is unclear and their taxonomy is complex because many of the named species are clonally propagated hybrids. There is genetic evidence that even some wild breeding species are of hybrid origin: cultivated citrus may be derived from as few as four ancestral species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus"@en .

aat:300375001 a skos:Concept ;
    skos:definition "Genus containing several species of trees native to the New World tropics, having very hard wood and resin that is obtained from the wood by distillation; used to treat respiratory disorders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guaiacum"@en .

aat:300375002 a skos:Concept ;
    skos:definition "Order of flowering plants consisting of 2 families, 27 genera, and about 300 species. Members are herbs or shrubs, rarely hemiparasites, and largely restricted to tropical or temperate arid or saline regions. The flowers are showy and possess oil or nectar glands for bee pollination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zygophyllales"@en .

aat:300375003 a skos:Concept ;
    skos:definition "Family of flowering plants consisting of a loose-knit assemblage of 22 genera and 285 species that mainly grow in the desert or saline environments of temperate and tropical regions. Most members are shrubs to small trees, often resinous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zygophyllaceae"@en .

aat:300375004 a skos:Concept ;
    skos:definition "Species of large tree native to tropical western Africa, reaching 60 meters in height, having a domed or flat crown and a trunk that is branchless for much of its height. It bears a fruit, the samara, with two wings. The wood is used for various purposes, including musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Terminalia superba"@en .

aat:300375005 a skos:Concept ;
    skos:definition "Genus containing around 200 species of trees; some species are commercially important for products such as gums, resins, and tanning extracts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Terminalia"@en .

aat:300375006 a skos:Concept ;
    skos:definition "Family containing around 14 genera and 500 of trees and shrubs, many located along tropical seacoasts, in African savannas, and in Asiatic monsoon forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Combretaceae"@en .

aat:300375007 a skos:Concept ;
    skos:definition "Genus containing around 20 species of trees and shrubs, all occurring in eastern North America and Mexico, growing 4 to 25 meters in height. Some species of Robinia are used as food by larvae of moths and butterflies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Robinia"@en .

aat:300375008 a skos:Concept ;
    skos:definition "Species of tree native to the Appalachian mountain region of the United States, but widely cultivated in Europe, Asia, North Africa, and New Zealand as an ornamental and shade tree. It grows to 24 meters (80 feet) in height and bears long, compound leaves with 6 to 20 oblong leaflets. The fragrant white flowers hang in loose clusters. There are many varieties, some thornless. It has long been used for erosion control and as a timber tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Robinia pseudoacacia"@en .

aat:300375009 a skos:Concept ;
    skos:definition "Genus of evergreen trees and shrubs found primarily in Australia. Several commercial products are produced by these trees. Until 2005, around 1300 species found in Australia, Europe, Africa, southern Asia, and the Americas were classified in this genus. The genus has since been divided into 5 genera, with the name Acacia retained for the Australian species and a small number in tropical Asia, Madagascar, and the Pacific Islands. Most species outside Australia now belong to Vachellia and Senegalia, with small numbers of species placed in genera Acaciella and Mariosousa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acacia"@en .

aat:300375010 a skos:Concept ;
    skos:definition "Wood from the species Acacia melanoxylon, reddish brown to black in color and prized for attractive grain, appearing similar to rosewood. The strong, elastic, hardwood is used for furniture, walking sticks, and tool handles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acacia melanoxylon"@en .

aat:300375011 a skos:Concept ;
    skos:definition "Species of rainforest tree native to West Africa, Thailand, and the Philippines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heritiera javanica"@en .

aat:300375012 a skos:Concept ;
    skos:definition "Genus of flowering plant native to wet areas and rain forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heritiera"@en .

aat:300375013 a skos:Concept ;
    skos:definition "Family of flowering plants consisting of 7 genera and around 225 species. It is considered an ancient family; unlike most angiosperms, with flower parts arranged in rings, the stamens and pistils of Magnoliaceae are arranged in spirals on a conical receptacle, an arrangement found in some fossil plants. The flowers also have parts not distinctly differentiated into sepals and petals, while later angiosperms generally have distinctly differentiated sepals and petals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magnoliaceae"@en .

aat:300375014 a skos:Concept ;
    skos:definition "Genus containing around 210 species of ornamental, evergreen trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magnolia"@en .

aat:300375015 a skos:Concept ;
    skos:definition "Species of large evergreen tree, reaching over 25 meters in height, native to the southeastern United States, from coastal Virginia south to central Florida, and west to eastern Texas and Oklahoma. It has been widely cultivated with over 100 varieties worldwide, prized for its large dark green leaves and large white fragrant flowers. The wood from the tree is used for furniture, veneer, and other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magnolia grandiflora"@en .

aat:300375016 a skos:Concept ;
    skos:definition "Genus of evergreen trees from tropical America including at least 3 species, which hybridize easily when grown in proximity; thus the species are poorly defined biologically. The trees have a hard wood that turns reddish brown at maturity, valued as timber. The leaflets of each large leaf are arranged like a feather, but there is no terminal leaflet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swietenia"@en .

aat:300375017 a skos:Concept ;
    skos:definition "Mahogany having a pattern of curly, flamed, or tiger-striped marks, resembling the pattern seen in wood of violins, which are actually made of various woods other than mahogany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiddle-back mahogany"@en .

aat:300375018 a skos:Concept ;
    skos:definition "Genus of 7 species of large tropical trees, deciduous or evergreen depending upon the species. The leaves are harvested as animal food; the bark and other parts used for medicinal purposes; the swellable gum is used for many purposes; and the wood, which resembles true mahogany of the genus Swietenia, is harvested for dugout canoes, furniture, and many other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khaya"@en .

aat:300375020 a skos:Concept ;
    skos:definition "Wood of the species Swietenia mahagoni, native to southern Florida, the Bahamas, Cuba, Jamaica, and Hispaniola. It turns reddish brown at maturity. This is the species for which the term \"mahogany\" was first coined, derived from a Native American term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swietenia mahagoni"@en .

aat:300375021 a skos:Concept ;
    skos:definition "Species of true mahogany originally native to southern North America, Central and South America, including Mexico, Bolivia, Brazil, Colombia, Belize, Peru, Venezuela, Costa Rica, Dominica, Ecuador, El Salvador, French Guiana, Guadeloupe, Guatemala, Guyana, Honduras, Martinique, Montserrat, Nicaragua, Panama, Saint Lucia, Saint Vincent, and the Grenadines. It is now an endangered species threatened by habitat loss, and thus not harvested legally in its native areas; it has been introduced for cultivation in Asia, where it may become an invasive species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swietenia macrophylla"@en .

aat:300375022 a skos:Concept ;
    skos:definition "Species of large evergreen tree found in various African locations. Introduced in Puerto Rico and elsewhere. Not a true mahogany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khaya anthotheca"@en .

aat:300375023 a skos:Concept ;
    skos:definition "Species of tree native to Mexico and Central America, having striking trumpet-shaped yellow flowers that cover the crown after the leaves are shed, and firm, light-colored wood used for furniture and inlaying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tabebuia donnell-smithii"@en .

aat:300375024 a skos:Concept ;
    skos:definition "Genus containing around 100 species of neotropical trees native to southern North America, Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tabebuia"@en .

aat:300375025 a skos:Concept ;
    skos:definition "General term for any mahogany of particularly high quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baywood"@en .

aat:300375026 a skos:Concept ;
    skos:definition "Species of medium-sized, polymorphic, evergreen Caribbean tree native mostly to sandy beaches of the Caribbean and Gulf of Mexico, growing to 12 meters (40 feet) in height. All parts of the tree are poisonous. It has a highly caustic latex sap and an attractive, sweet-scented apple-like fruit that has regularly poisoned Spanish conquistadores, shipwrecked sailors, and present-day tourists. The manchineel is so poisonous that smoke from its burning wood irritates the eyes, and latex from its leaves and bark causes skin inflammation. Carib Indians used the sap to poison their arrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippomane mancinella"@en .

aat:300375027 a skos:Concept ;
    skos:definition "Large family containing around 275 genera and around 7,500 species of flowering plants, including herbs, shrubs or trees, and succulents that resemble cacti. Many members are important food sources; others are useful for their waxes and oils and as a source of medicinal drugs; dangerous for their poisonous fruits, leaves, or sap; or attractive for their colorful bracts (leaflike structures located just below flower clusters) or unusual forms. Although species of the family grow throughout the world, except in cold alpine or arctic regions, most of them are found in temperate and tropical regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Euphorbiaceae"@en .

aat:300375028 a skos:Concept ;
    skos:definition "Genus containing one species, H. mancinella; formerly held to contain several species, but in most classifications formerly designated species are now treated as one polymorphic species (a single species having multiple forms)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hippomane"@en .

aat:300375030 a skos:Concept ;
    skos:definition "Family of 16 genera and around 120 species of tropical and subtropical flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhizophoraceae"@en .

aat:300375031 a skos:Concept ;
    skos:definition "Species of tree, reaching 24 m (80 feet) in height. It is found in estuarine ecosystems throughout the tropics, growing on aerial prop roots that arch above the water level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhizophora mangle"@en .

aat:300375032 a skos:Concept ;
    skos:definition "General term referring to various trees and shrubs that form dense thickets in muddy coastal swamps and tidal estuaries in tropical and subtropical regions, marked by their ability to tolerate salt water and by their possession of different forms of aerial roots. The term is applied chiefly to species of the genera Rhizophora and Bruguiera (family Rhizophoraceae), Avicennia (family Avicenniaceae), Laguncularia (family Combretaceae), and Sonneratia (family Lythraceae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mangrove"@en .

aat:300375033 a skos:Concept ;
    skos:definition "Genus containing around 200 species of shrubs or trees widely distributed in the North Temperate Zone, but concentrated in China. Maples are used as ornamentals, tapped for syrup, and provide valuable, dense hardwood for furniture and other uses. All maples bear pairs of winged seeds, called samaras or keys. The leaves are arranged oppositely on twigs. Many maples have lobed leaves, but a few have leaves separated into leaflets. More recent classifications place the genus in the family Sapindaceae, although some have placed it in a family of its own, Aceraceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer"@en .

aat:300375034 a skos:Concept ;
    skos:definition "Family containing around 135 genera and 1,600 species occurring mainly in the tropical areas of the world, especially abundant in the American tropics. Species range from trees and shrubs to lianas or herbaceous vines. The family is found throughout the wetter tropics and subtropics, extending north to Japan and south to New Zealand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sapindaceae"@en .

aat:300375035 a skos:Concept ;
    skos:definition "Species of maple tree found in western North America, mostly near the Pacific coast. It has the largest leaves of any maple, with five deeply-incised palmate lobes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer macrophyllum"@en .

aat:300375036 a skos:Concept ;
    skos:definition "Species of maple closely related to sugar maple (A. saccharum), and in some classifications treated as a subspecies; the situation is complicated by the fact that the two species tend to form hybrids. The two species may be distinguished by number of leaf lobes: the black maple has three-lobed leaves and the sugar maple has five-lobed leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer nigrum"@en .

aat:300375037 a skos:Concept ;
    skos:definition "Species of maple tree native to the eastern half of North America, widely grown as an ornamental and shade tree. It is a commercially important source of maple syrup, maple sugar, and hardwood lumber. Some trees of this species tend to develop special grain patterns called \"bird's-eye maple.\" The tree has a smooth trunk, five-lobed leaves, and winged seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer saccharum"@en .

aat:300375038 a skos:Concept ;
    skos:definition "Species of small, usually fast-growing and fairly short-lived maple tree native to the northeastern North America east of the Rocky Mountains, reaching 10-25 meters (33-82 feet) in height. Unlike most other maples, this species is fully dioecious, requiring both a male and female tree to reproduce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer negundo"@en .

aat:300375039 a skos:Concept ;
    skos:definition "Strong, even-grained wood from the species Acer campestre, native to Europe, the Balkans, and Turkey. The wood is pale, yellow-brown in color. It has been used for boxes, utensils, furniture, tool handles, musical instruments, boats, wagons, and weapons"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field maple"@en .

aat:300375040 a skos:Concept ;
    skos:definition "Species of small Eurasian maple tree native to Europe, the Balkans, and Turkey. It grows to 15-25 m in height, having low branches and five-lobed palmate leaves, used commonly in hedgerows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer campestre"@en .

aat:300375041 a skos:Concept ;
    skos:definition "Species of deciduous shrub or small tree native to Japan, North Korea, South Korea, China, Mongolia, and southeast Russia; reaching 10 meters in height and typically an understory plant in shady woodlands. The tree may have multiple trunks joining close to the ground. Many different cultivars of this maple have been developed; even in the wild, seedlings from the same parent display remarkable variation in color and shape of leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer palmatum"@en .

aat:300375042 a skos:Concept ;
    skos:definition "Species of maple native to eastern North America, growing to 27 m (90 feet) in height and having leaves that turn bright red in autumn. It is known in many cultivars and often planted as an ornamental in cities, because it tolerates compact soil and urban pollution. The wood of the red maple is used in furniture, flooring, and veneer. The bark and leaves produce a dye that colors cotton and wool a cinnamon color with an alum mordant and a black color with an iron mordant. Syrup can be prepared from its sap. Seeds and shoots are food for squirrels, rabbits, and deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer rubrum"@en .

aat:300375043 a skos:Concept ;
    skos:definition "Species of rapid-growing shade tree, native to eastern North America and widely cultivated elsewhere. It grows to 18 m (60 feet) in height. Its wood is soft, but used for crating and inexpensive furniture. It can produce syrup, but is low yield. It drops branches and produces numerous shoots, making it problematic as an ornamental, although several useful varieties have been produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer saccharinum"@en .

aat:300375045 a skos:Concept ;
    skos:definition "Lights, often in elevators, that display floor numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "floor indicators"@en .

aat:300375046 a skos:Concept ;
    skos:definition "Frames that line or finish a doorway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doorcases"@en .

aat:300375048 a skos:Concept ;
    skos:definition "Devices that attach to the bottom of a door, minimizing the gap between door and floor. May be used to keep out dust, heat, cold, insects or rodents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "door sweeps"@en .

aat:300375049 a skos:Concept ;
    skos:definition "Decorative mouldings, usually mass-produced, for placement above windows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window caps"@en .

aat:300375050 a skos:Concept ;
    skos:definition "Parts of a human's or animal's body enclosed by the ribs and breast bone, forming the upper part of the trunk, and containing the heart and lungs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chests"@en .

aat:300375051 a skos:Concept ;
    skos:definition "The central portions a human's or animal's body, not including head and limbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "torsos"@en .

aat:300375052 a skos:Concept ;
    skos:definition "The external organ or organs of generation of a human or animal; expressed in the plural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genitals"@en .

aat:300375053 a skos:Concept ;
    skos:definition "Organs of flight of any flying animal, such as a bird, bat, or insect.In birds the wings are specially modified forelimbs; in bats (and the extinct pterodactyls, etc.), extensions of the skin attached to modified parts of the forelimbs; in insects, membranous expansions attached to the thorax in addition to the limbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wings"@en .

aat:300375054 a skos:Concept ;
    skos:definition "The anterior parts of the body of humans and animals containing the mouth, special sense organs such as the eyes, nose, and ears, and the brain; typically separated by a neck or otherwise distinguished from the rest of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heads"@en .

aat:300375055 a skos:Concept ;
    skos:definition "Dresses having a shirtwaist bodice, typically including a center front button or stud placket opening, cuffs, and a collar, imitating certain details of a man's shirt. The bodice is attached straight or full skirt, often having a belt at the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shirtwaist dresses"@en .

aat:300375056 a skos:Concept ;
    skos:definition "Genus containing around 105 species of main and sub-canopy lowland rainforest trees, distributed in Sri Lanka and southern India to southern China, the Malay peninsula, and New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hopea"@en .

aat:300375057 a skos:Concept ;
    skos:definition "Species of wide-canopied, Neo-tropical tree with a large symmetrical crown, growing to height of 25 meters (82 feet) in height. The name \"rain tree\" refers to the fact that the leaves fold in rainy weather and in the evening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samanea samán"@en .

aat:300375058 a skos:Concept ;
    skos:definition "Panels equipped with solar cells, designed to absorb the sun's rays for the express purpose of generating heat. For devices used to harness the sun's rays for the express purpose of generating electricity, use \"solar panels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar thermal panels"@en .

aat:300375059 a skos:Concept ;
    skos:definition "Water harvesting vessels that are used to collect rainwater (especially from roofs) for future use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rain barrels"@en .

aat:300375060 a skos:Concept ;
    skos:definition "Genus containing around 450 species of ornamental and timber trees and shrubs, found chiefly in north temperate regions and at high altitudes in the tropics. The durable wood has a distinctive coarse grain. The thick bark from some species is used for its buoyancy. Tannins and dyes can be extracted from the bark. Oak emits organic acids as it ages. Many plants commonly called \"oak\" are not Quercus, including African oak, Australian oak, bull oak, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus"@en .

aat:300375061 a skos:Concept ;
    skos:definition "Genus of flowering plant containing one living species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samanea"@en .

aat:300375062 a skos:Concept ;
    skos:definition "Electrical devices, usually located in sinks, used for grinding up garbage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disposals"@en .

aat:300375063 a skos:Concept ;
    skos:definition "Material made of excrescences produced on trees, usually the oak species Quercus infectoria in Europe and the Near East, and on the sumac species Rhus semialata in China and Japan, by the action of insects, chiefly of the genus Cynips. Galls are formed when gall-wasp eggs are deposited on tree branches in nut-like pockets; the gall grows until the larvae are completely enveloped. The mature insect bores a hole through the gall in order to escape. All galls contain 36-60% tannins; the bluish-green galls, gathered before the insect escapes, are richest in gallotannic acid. The tannins have been used for centuries for vegetable tanning of leather. When galls are combined with ferrous sulfate, a black dye is produced; alone, they produce a gray dye. Gall extract was also used as a mordant in the preparation of writing inks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gall"@en .

aat:300375064 a skos:Concept ;
    skos:definition "Species of oak native to the Near East; important source of nut galls, abnormal growths caused by a wasp and which contain tannins sued for leatherwork, making ink, and in medicines to treat burns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus infectoria"@en .

aat:300375065 a skos:Concept ;
    skos:definition "Species of large oak tree native to most of Europe, Anatolia, the Caucasus, and parts of North Africa; growing 25-40 meters in height, and having a bark that is grayish brown in color and having deep fissures with aging. The tree is valued for brown wood with a coarse but straight grain. The bark is used for tanning and dyeing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus robur"@en .

aat:300375066 a skos:Concept ;
    skos:definition "Species of large deciduous tree growing 25-40 meters in height, having glossy leaves and a dark gray, deeply furrowed bark often streaked orange near the base of the trunk. It is native to Europe and Asia Minor. It is used for timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus cerris"@en .

aat:300375067 a skos:Concept ;
    skos:definition "Wood of the species Quercus laevis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American turkey oak"@en .

aat:300375068 a skos:Concept ;
    skos:definition "Species of small, slow-growing deciduous shrubby tree native to the dry, sandy areas of the southeastern United States, on the coastal plain from Delaware to Florida and Louisiana. It reaches 10 meters in height, has deeply incised leaves with 3-7 slender lobes, and acorns that take 18 months to mature. It hybridizes easily with southern red oak (Q. falcata), bluejack oak (Q. incana), laurel oak (Q. laurifolia), and water oak (Q. nigra). Its name \"turkey oak\" is derived either from the turkey-footprint shape of its leaves or from the fact that wild turkeys eat the acorns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus laevis"@en .

aat:300375069 a skos:Concept ;
    skos:definition "Species of medium-sized, fast-growing oak tree distributed on rocky hillsides and sandy ridges throughout the eastern and Midwestern United States, having a black or dark brown bark. While the tree is occasionally used for lumber, its most important commercial product is a yellow dye obtained from the bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus velutina"@en .

aat:300375070 a skos:Concept ;
    skos:definition "Species of flowering plant native of Eurasia, and introduced to North America where it has become a weed. Source of natural yellow dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reseda luteola"@en .

aat:300375071 a skos:Concept ;
    skos:definition "Species of white oak timber tree native to North America, found in eastern and midwestern United States and south-central Canada. It is also called \"mossy-cup oak\" for its heavily fringed acorn cups. It is a popular ornamental and shade tree in urban areas because of its resistance to insect and fungal attack, drought, and air pollution. Previously common in oak savannas and prairies, the tree is well adapted to fire with its corky, fire-resistant bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus macrocarpa"@en .

aat:300375072 a skos:Concept ;
    skos:definition "Species of ornamental and shade tree, often 30 meters (100 feet) in height, having graceful, drooping branches, many-lobed dark green leaves, and large, distinctive acorns about 5 cm (1.7 inches) long. The ash-gray to light-brown bark, slightly orange-tinted, is fissured in irregular cubes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus lobata"@en .

aat:300375073 a skos:Concept ;
    skos:definition "Refers specifically to the wood of the species Quercus prinus (also called Q. montana), used in making furniture. The term \"chestnut oak\" is also used informally as a general term referring to any of several species of oaks having leaves similar to chestnut trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus prinus"@en .

aat:300375074 a skos:Concept ;
    skos:definition "Wood from the species Quercus michauxii, a valuable North American bottomland timber tree of the Atlantic and Gulf coastal plains and Mississippi Valley region; so-named because the wood is often cut into strips and used for making baskets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basket oak"@en .

aat:300375075 a skos:Concept ;
    skos:definition "Species of valuable North American bottomland timber tree of the Atlantic and Gulf coastal plains and Mississippi Valley region, growing 24-36 meters in height, with branches rising at narrow angles from a columnar trunk to a round, compact head. It has silver-white, red-tinged bark and bright green, glossy leaves, velvety and whitish beneath, usually 20 cm in length and turning red in autumn. Swamp chestnut oak is often called \"cow oak,\" because the acorns are eaten by cattle, or \"basket oak\" from local use of the wood strips for basket material. It was formerly considered a variety of Q. prinus (\"rock chestnut oak\" or simply \"chestnut oak\"). Q. michauxii is typically more massive than Q. prinus. A quick way to distinguish the two species is by habitat; if the tree grows on a ridge, it is probably Q. prinus; if it grows in wet bottomlands, it is probably Q. michauxii."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus michauxii"@en .

aat:300375076 a skos:Concept ;
    skos:definition "Species of spreading oak tree that is native to North American, in the greater Midwest, ranging downward to the deep South and over into the eastern edge of the Great Plains of the U.S. When in the open, it grows to 60 feet in height by 80 feet in width, often with wide-spreading lower branches of great diameter. Chinquapin oak prefers moist, well-drained, deep, rich, alkaline soils, but is often found near the summit of hills or uplands in dry soils that may be rich, clay, sandy, or rocky. It also tolerates neutral to acidic soils. It thrives in full sun to partial sun (but is shade tolerant in youth)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus muehlenbergii"@en .

aat:300375077 a skos:Concept ;
    skos:definition "Devices that treat water, usually by removing chemicals and contaminants. Water conditioners are directly applied to showers, heaters, and and other appliances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water conditioners"@en .

aat:300375078 a skos:Concept ;
    skos:definition "Nozzles from which water issues and is directed, in showers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shower heads"@en .

aat:300375079 a skos:Concept ;
    skos:definition "Fixtures and adapters, including ring-shaped, L-shaped, or T-shaped fittings, used in pipe and plumbing systems to connect pipe or tubing sections, to adapt piping to different sizes or shapes, to regulate flow, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe fittings"@en .

aat:300375080 a skos:Concept ;
    skos:definition "Vessels in which the feet are bathed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footbaths"@en .

aat:300375081 a skos:Concept ;
    skos:definition "Pumps used to drain accumulated water or other liquid from a sump basin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sump pumps"@en .

aat:300375085 a skos:Concept ;
    skos:definition "Used to describe both beams reinforced with one or more tie rods and beams in the form of trusses, braced by vertical posts and supported by inclined rods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "truss beams"@en .

aat:300375086 a skos:Concept ;
    skos:definition "Order containing more than 18,000 species of monocotyledons (flowering plants having a single seed leaf). The order consists of several lineages that have traditionally been recognized as groups, the members of which have often migrated from one group to another. The major groups included in Poales are the grass group (families Poaceae, Restionaceae, Anarthriaceae, Centrolepidaceae, Ecdeiocoleaceae, Flagellariaceae, and Joinvilleaceae), the cattail group (families Typhaceae and Sparganiaceae), and the sedge group (Juncaceae, Cyperaceae, and Thurniaceae). In addition, Poales includes families Xyridaceae, Eriocaulaceae, Bromeliaceae, Mayacaceae, and Rapateaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poales"@en .

aat:300375087 a skos:Concept ;
    skos:definition "Genus containing around 60 species of herbs and shrubs native to Europe, North Africa, and parts of Asia, but widely introduced elsewhere. Several species have become popular garden flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reseda"@en .

aat:300375088 a skos:Concept ;
    skos:definition "Family containing 6 genera and around 70 species of generally herbaceous dicotyledonous plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Resedaceae"@en .

aat:300375089 a skos:Concept ;
    skos:definition "Order of flowering plants containing around 14 families, whose members produce glucosinolate (mustard oil) compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brassicales"@en .

aat:300375091 a skos:Concept ;
    skos:definition "Wood of the species Quercus prinoides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarf chestnut oak"@en .

aat:300375092 a skos:Concept ;
    skos:definition "Species of small tree or shrub that forms dense thickets; it is a useful cover plant on dry, rocky ridges. It resembles chestnut oak (Quercus prinus); however, it is more closely related to chinkapin oak (Quercus muhlenbergii)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus prinoides"@en .

aat:300375093 a skos:Concept ;
    skos:definition "Species of large deciduous oak tree, growing to 20-40 meters in height; native to most of Europe and Anatolia . It is similar to Quercus robur (pedunculate oak), with which it overlaps extensively in range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus petraea"@en .

aat:300375094 a skos:Concept ;
    skos:definition "Species of medium sized oak tree native to the southeast of the United States, from coastal Virginia to central Florida to Texas, growing 20-25 m (65-80 feet) in height, and having a large, circular crown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus laurifolia"@en .

aat:300375095 a skos:Concept ;
    skos:definition "Wood of the species Quercus imbricaria, used primarily for making shingles and clapboard siding for houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shingle oak"@en .

aat:300375096 a skos:Concept ;
    skos:definition "Species of medium sized oak tree growing to 20 meters in height, native primarily to the Midwestern and southern United States, typically growing in uplands with good drainage, but occasionally at lowland streams. Its leaves are shaped like laurel leaves. The fruit is an acorn that is an important food source for squirrels and birds. The common names comes from its use in making making shingles and clapboard siding for houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus imbricaria"@en .

aat:300375097 a skos:Concept ;
    skos:definition "Canopies fitted above a stove to aid ventilation, sometimes equipped with an exhaust fan and attached to a flue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "range hoods"@en .

aat:300375098 a skos:Concept ;
    skos:definition "Cord made from twisted, and sometimes rubberized, paper; used for a variety of purposes including packaging and furniture upsholstery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper cord"@en .

aat:300375099 a skos:Concept ;
    skos:definition "The summits or rounded tops of a mountain or hill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knolls"@en .

aat:300375100 a skos:Concept ;
    skos:definition "Small hills, hillocks, or other protuberances of earth, rock, etc., that are conical or dome-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hummocks"@en .

aat:300375101 a skos:Concept ;
    skos:definition "Species of medium-sized oak tree native to lowland wetlands in the southeastern United States, from Delaware and southern Illinois south to northern Florida and southeast Texas. The common name refers to the acorn almost completely enclosed by the cup or its scale. The Latin name comes from the shape of the leaves, which resemble a lyre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus lyrata"@en .

aat:300375102 a skos:Concept ;
    skos:definition "The principal performer or bullfighter who both works the capes and performs the task of killing the bull by means of a sword. Matadors are almost exclusively male, but there have been female 'matadoras.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matadors"@en .

aat:300375103 a skos:Concept ;
    skos:definition "Refers to people who follow and provide services to military camps or armies, but who are not in official military service themselves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camp followers"@en .

aat:300375104 a skos:Concept ;
    skos:definition "Plates of steel or another material that are bolted together through the ends of two members to strengthen joints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishplates"@en .

aat:300375105 a skos:Concept ;
    skos:definition "Large blocks of masonry which are located at the base of architraves of doors or windows and against which wall skirting is stopped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plinth blocks"@en .

aat:300375106 a skos:Concept ;
    skos:definition "Rails attached to walls which are usually adjacent to stairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall rails"@en .

aat:300375107 a skos:Concept ;
    skos:definition "Fittings or panels in a kitchen or bathroom designed to shield walls and appliances from splashed liquid or food debris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backsplashes"@en .

aat:300375109 a skos:Concept ;
    skos:definition "Type of siding made from asphalt, often replicating the visual qualities of other materials such as stone or wood. Common from the late 19th century to the mid 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphalt siding"@en .

aat:300375110 a skos:Concept ;
    skos:definition "Board with regularly spaced holes holding pegs on which objects may be hung. Developed in the 20th century. May be considered a type of paneling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pegboard"@en .

aat:300375112 a skos:Concept ;
    skos:definition "Pits dug into the ground, often made from stones, used for keeping fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firepits"@en .

aat:300375113 a skos:Concept ;
    skos:definition "Class of circular or radiating boulder outlines built by ancient North American Indian peoples of the Great Plains. These enigmatic archaeological features are believed to have some religious, astronomical, territorial, or calendrical significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medicine wheels"@en .

aat:300375115 a skos:Concept ;
    skos:definition "Wheels that turns the axle of a windlass at a well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "well wheels"@en .

aat:300375116 a skos:Concept ;
    skos:definition "Drying houses built or used for drying fruit and vegetables specifically, fitted with shelves to lay out whole fruits or cut pieces fruit or hangers from which to suspend branches of fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fruit drying houses"@en .

aat:300375117 a skos:Concept ;
    skos:definition "Agricultural buildings designed to reduce labor, automate, and improve efficiency in milking cows. Several different designs are in use, but all parlors follow key components of milking procedures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milking parlors"@en .

aat:300375118 a skos:Concept ;
    skos:definition "Refers to any scripts written with a running hand, so that the characters are rapidly formed by raising the pen very little, and in consequence characters have rounded angles and become slanted, and letters or strokes are often combined in a continuous stroke (a ligature)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cursive scripts"@en .

aat:300375119 a skos:Concept ;
    skos:definition "Written or pictorial symbols intended to represent a whole word. Writing systems that make use of logograms include Chinese, Egyptian hieroglyphic writing, and early cuneiform writing systems. No known writing system is totally logographic; all such systems have both logograms and symbols representing particular sounds or syllables. In phonography, a logogram is a word-letter or a single stroke which, for brevity's sake, represents a word."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logograms"@en .

aat:300375120 a skos:Concept ;
    skos:definition "The action of ingesting food into the mouth, chewing, and swallowing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eating"@en .

aat:300375121 a skos:Concept ;
    skos:definition "Describes the action of giving or supplying food to another. For the intake of food by oneself, use \"eating,\" \"drinking,\" \"suckling,\" or another appropriate term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feeding"@en .

aat:300375124 a skos:Concept ;
    skos:definition "Rug motif in the form of a stylized water vessel with a handle and long spout."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ewer"@en .

aat:300375125 a skos:Concept ;
    skos:definition "Quartered güls with the internal compartments decorated with fleurons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tekke güls"@en .

aat:300375127 a skos:Concept ;
    skos:definition "Political entities have a government in which the chief power lies in the hands of those who are most distinguished by birth or fortune. In an aristocracy, power is in the hands of multiple people rather than a single ruler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aristocracies"@en .

aat:300375128 a skos:Concept ;
    skos:definition "In general, men of distinction in a society without precise designation of rank. May be used to mean specifically men in a society who are entitled to bear arms, though not ranking among the nobility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentlemen"@en .

aat:300375129 a skos:Concept ;
    skos:definition "In general, women of distinction without precise designation of rank. Women considered by the society to be of good birth or breeding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gentlewomen"@en .

aat:300375130 a skos:Concept ;
    skos:definition "Describes the state, condition, or appearance of being asleep, the natural physiological period of rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeping"@en .

aat:300375131 a skos:Concept ;
    skos:definition "Tall poles decorated with flowers and greenery, often painted with stripes, and erected in open spaces for May Day celebrants to dance around. Celebrants often wind ribbons or streamers around the pole in complex patterns. The rite is related to ancient spring fertility dances that began around living trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maypoles"@en .

aat:300375132 a skos:Concept ;
    skos:definition "Style of art and approach to pop culture in general that challenges the validity of a high or established art aesthetic. Critics disagree as to its relationship with the fine art world, and if it is to be considered a \"legitimate\" art movement on its own. The term was coined by artist Robert Williams in 1979 to refer to the populist nature of his own work. The style is characterized by both its influences, such as comic books, tattoos, and hot-rod street culture, and it approach, which is typically bright, garish, and infused with a sense of humor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lowbrow"@en .

aat:300375133 a skos:Concept ;
    skos:definition "Building used for union gatherings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "union halls"@en .

aat:300375134 a skos:Concept ;
    skos:definition "Genre of film obsessed with bringing to the screen sexual, exploitive, and typically horror-oriented subject matter. Grindhouse films are typically bloody, low-budget, and aimed at a young adult audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grindhouse"@en .

aat:300375135 a skos:Concept ;
    skos:definition "Film movement began in Italy near the end of World War II, typified by the use of both professional and non-professional actors, ordinary settings and themes, and the rejection of the happy-ending story. The films tend to focus on social issues and the everyday problems of its characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neorealism"@en .

aat:300375136 a skos:Concept ;
    skos:definition "French term meaning \"putting into the scene,\" originally used to describe the arrangement of visual components on a stage.The term was later used in film criticism to include discussion of camera position, the relationships between objects, people, and masses and how they collectively affect the work. Results of this technique are often montage sequences, careful editing, and careful composition within and individual film frame. The has been, but is rarely used outside of a film context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mise-en-scène"@en .

aat:300375137 a skos:Concept ;
    skos:definition "Stables that board horses and carriages for hire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "livery stables"@en .

aat:300375138 a skos:Concept ;
    skos:definition "Big tops, or circus tents, were first introduced ca. 1825 by the American itinerant company of J. Purdy Brown. This innovation soon became a standard of circus performances worldwide. Where a circus is made up of multiple tents, the big top is the main tent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "big tops"@en .

aat:300375139 a skos:Concept ;
    skos:definition "Structures such as a mounds, walls, or fences that act as barriers, particularly within the context of a sporting activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backstops"@en .

aat:300375140 a skos:Concept ;
    skos:definition "Structures that frame or enclose an area used to practice baseball batting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batting cages"@en .

aat:300375141 a skos:Concept ;
    skos:definition "In various team sports, upright posts, typically a pair, which form part of the demarcation of a goal line. Goalposts are typically joined by a crossbar and in some sports with a net or covered framework behind, which form an area or space into or through which players attempt to send the ball, puck, etc., as a means of scoring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goalposts"@en .

aat:300375142 a skos:Concept ;
    skos:definition "Small shanties or shacks typically placed on runners so they can be easily moved, used for fishing upon the ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice fishing shacks"@en .

aat:300375143 a skos:Concept ;
    skos:definition "Structures, often wooden, with platforms that are topped by small towers or huts, with pitched roofs. These structures are used by hunters to spot deer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deer stands"@en .

aat:300375144 a skos:Concept ;
    skos:definition "Defensive obstacles developed in the Medieval period. Made by affixing multiple iron or wooden spikes around a central axel. Primarily intended as anti-cavalry barriers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevaux de frise"@en .

aat:300375145 a skos:Concept ;
    skos:definition "A religious and political movement originating in Jamaica in the 1930s that identifies the former Emperor Haile Selassie of Ethiopia as the Messiah, and Africans as the chosen people of the Bible. Rastafarians, or Rastas adhere to codes of behaviour and dress, including the wearing of dreadlocks, the smoking of cannabis as a sacrament, and a diet that excludes pork and shellfish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rastafari"@en .

aat:300375146 a skos:Concept ;
    skos:definition "Structures, often enclosed, located at the tops of mining shafts, for housing hoisting machinery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shaft houses"@en .

aat:300375147 a skos:Concept ;
    skos:definition "Describes the collective production of films within a particular time and place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film movements"@en .

aat:300375148 a skos:Concept ;
    skos:definition "Describes the collective production of films in Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German film movements"@en .

aat:300375149 a skos:Concept ;
    skos:definition "Film movement that emerged in Germany before World War II and reached its peak in the 1920s, which used distortion and exaggeration as a means of transforming the physical world into a reflection of the inner self. Plots and themes of the films were often dark in nature, with an emphasis on long, dark shadows, unnatural spaces in compositions, stylized acting, and dream sequences. Notable films of this movement are \"The Cabinet of Dr. Caligari,\" and \"Nosferatu.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German Expressionist"@en .

aat:300375151 a skos:Concept ;
    skos:definition "Movement in German film lasting from about 1969 and into the 1980s that saw the emergence of a new group of director, among them Werner Rainer Fassbinder, Volker Schlöndorff, and Werner Herzog. In 1974, the Federal Republic's main broadcasters, ARD and ZDF, and the German Federal Film Board, provided for the television companies to make available an annual sum to support the production of films shown in theaters and on television. As a result, the films were artistically ambitious and critically acclaimed, despite their limited budgets. Well known films include Fassbinder's \"The Bitter Tears of Petra von Kant\" (1972) and Schlöndorff's \"The Tin Drum\" (1979)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "New German Cinema"@en .

aat:300375152 a skos:Concept ;
    skos:definition "Style and culture of a people of mixed Arab-Berber descent inhabiting the Western Sahara, neighboring parts of Morocco, Mali, Algeria, and the Islamic Republic of Mauritania. To refer to the products, style and culture of people living within the boundaries of Mauritania proper use \"Mauritanian.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maure"@en .

aat:300375153 a skos:Concept ;
    skos:definition "Film genre originally applied to plays with plots with moral issues where good versus evil were the main focus. Later, the films of D. W. Griffith, such as \"Way Down East in (1920), the personal and social problems of women are portrayed in particularly melodramatic way, and the emphasis become more on characters themselves. In films like Stella Dallas (1937) or Douglas Sirk's \"All That Heaven Allows,\" the happy ending plot gives way to the female character sacrificing everything to a more noble cause."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melodrama"@en .

aat:300375154 a skos:Concept ;
    skos:definition "Film genre that intends to cause fright and terror in the viewer for entertainment. Subjects can range from from violence and death and man-made monsters, to aliens from other worlds to madness to nuclear or natural disasters. Over the course of film history, horror has evolved with human history, mirroring current events and current fears. From the late 70s on, certain horror films have evolved into franchises such \"Halloween\" or \"Nightmare on Elm Street,\" continuing the saga of the popular charcaters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horror film"@en .

aat:300375155 a skos:Concept ;
    skos:definition "Film genre considered to be a sub-genre of horror or fantasy films, in the way that deal both deal with improbable creatures and improbable worlds. Science fiction films tend to use science fiction literature as their source material or it projects the possible development of a speculative future, such as the overpopulated and violent ones found such films as \"Soylent Green\" (1973) and \"Blade Runner (1982), Science fiction and horror can certainly created hybrid films such as \"The Terminator\" (1984)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science-fiction film"@en .

aat:300375156 a skos:Concept ;
    skos:definition "Film genre that presents fact and real situations and people rather than fiction. They typically feature the people, places, and events who are the subjects of the film, rather than actors or sets. Early examples were influenced by television news and used portable cameras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "documentary film"@en .

aat:300375157 a skos:Concept ;
    skos:definition "The style and culture of the Galicia area of Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galician"@en .

aat:300375158 a skos:Concept ;
    skos:definition "Padded tables for massage, chiropractic treatment, or other body work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "massage tables"@en .

aat:300375159 a skos:Concept ;
    skos:definition "Cabinets used to house various data storage media formats. May also refer to cabinets that house and sometimes conceal multimedia support equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "media cabinets"@en .

aat:300375160 a skos:Concept ;
    skos:definition "Furniture cabinets meant to hold and enclose television sets, presenting aesthetically pleasing screen views while hiding functional componets. For use in the home."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television cabinets"@en .

aat:300375164 a skos:Concept ;
    skos:definition "Species of medium-sized tree (35 feet in height) having a smooth gray bark, extending from southern Mexico through Central America to Peru, Bolivia, and Brazil. It has also been introduced to the Caribbean, the Antilles, Florida, and Africa. The tree is valued for its attractively variegated lumber and the bark, which is used as a narcotic, laxative, and insecticide. The tree has many names due to its wide distribution and multiple uses. The wood of the angelin was at first thought to belong to the partridge pea, thus the Caribbean French name for the partridge pea, bois perdrix, was misinterpreted as partridge wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andira inermis"@en .

aat:300375165 a skos:Concept ;
    skos:definition "Genus of trees, some species valued for hard wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andira"@en .

aat:300375166 a skos:Concept ;
    skos:definition "Species of tree found in Brazil, French Guiana, Guyana, Peru, and Suriname. It is threatened by habitat loss. It is valued for heavy, black, ebony-like wood used for furniture and highly resistant to insect attack. Recent genetic tests indicate it is highly similar to Connarus conchocarpus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andira aubletii"@en .

aat:300375167 a skos:Concept ;
    skos:definition "Heavy, black, ebony-like wood of the species Andira aubletii found in Brazil, French Guiana, Guyana, Peru, and Suriname. Used for furniture and valued as highly resistant to insect attack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acapou"@en .

aat:300375168 a skos:Concept ;
    skos:definition "Style of documentary filmmaking that combines improvisation with the manipulation of camera to unveil truth or highlight hidden subjects. Characteristics may include hand held camera, flat lighting, and less than perfect exposures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinéma vérité"@en .

aat:300375169 a skos:Concept ;
    skos:definition "Type of documentary film that shares many of the same characteristics with cinéma vérité, but lacks the smooth, spontaneous camera movements typically associated with that style. Instead, camera presence is down played and long-take shots film using a stationary tripod are more typical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct cinema"@en .

aat:300375170 a skos:Concept ;
    skos:definition "Physical evidence of organsms or parts of organisms, including plants, animals, fungi, bacteria, and single-celled living things; may include fosilized remains or impressions of the organism, rather than the organism itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living organisms' remains"@en .

aat:300375171 a skos:Concept ;
    skos:definition "Parts or components of plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plant components"@en .

aat:300375172 a skos:Concept ;
    skos:definition "Tattooed, dried human heads of the Maori culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toi moko"@en .

aat:300375173 a skos:Concept ;
    skos:definition "Visual effect in motion pictures in which one scene fades in to another. Both shots are seen briefly superimposed. The dissolve was first used to imply geographic or temporal transitions. Later, the optical nature of the dissolve was used for more tonal effects, such a character's state of mind, fantasy, or flashback sequences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissolve"@en .

aat:300375175 a skos:Concept ;
    skos:definition "A process in which a print, usually a photograph, is permanently adhered to a clear sheet of acrylic. This enhances the perception of color and sharpness, due to the acrylic's refractive qualities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "face mounting"@en .

aat:300375176 a skos:Concept ;
    skos:definition "A transitional visual effect used to indicate to beginning of one scene and the ending of another by means of an image gradually disappearing (fade-out), while another image grows stronger and gradually comes into view (fade-in). An image fading into black typically indicates a major separation of action, while a fade to white can indicate a character's loss of consciousness or death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fade"@en .

aat:300375178 a skos:Concept ;
    skos:definition "Genus containing around 30 species of medium sized trees native to coastal and mildly temperate regions of the Old World, from western Europe, north Africa, and Asia. It is one of the most important fruit trees of the world and is cultivated in all temperate-zone countries of both hemispheres. Valued for fleshy edible fruit (a pome), typically having a broad base and tapering or constricted towards the stalk, and having sweet taste, soft texture, and distinguished by the presence of hard cells in the flesh, the so-called grit, or stone cells. Pear trees are relatively long-lived (50 to 75 years), may reach considerable size unless carefully trained and pruned, and are valued for timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pyrus"@en .

aat:300375179 a skos:Concept ;
    skos:definition "Species of medium sized, fruit-bearing tree that is probably of European origin, and has been cultivated since long before the Christian era. Thousands of varieties have been bred and named since ancient times in Europe alone. It is propagated by budding or grafting onto a rootstock. In Europe the main rootstock used is quince, which produces a dwarfed tree that fruits at an earlier age than most of the trees on pear rootstocks. The common pear was introduced into the New World by British and other Europeans as soon as the colonies were established. Also at an early date, Spanish missionaries carried the fruit to Mexico and California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pyrus communis"@en .

aat:300375180 a skos:Concept ;
    skos:definition "Visual effect that occurs when film is advanced at less than twenty-four frames per second, so that when the film is projected at standard speed the action appears accelerated. Most silent films were shot around 16 frames per second, thus the motion appears fast, and sometimes this herky-jerky motion is associated with them. Fast motion was a favorite technique of director Mack Sennet, who used it in silent comedies and it has since been used in more modern pictures such as Tony Richardson's \"Tom Jones\" (1963)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fast motion"@en .

aat:300375181 a skos:Concept ;
    skos:definition "Wood obtained from the species Aspidosperma peroba, pink in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red peroba"@en .

aat:300375182 a skos:Concept ;
    skos:definition "Wood from the species Paratecoma peroba, pale olive to dark brown in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white peroba"@en .

aat:300375183 a skos:Concept ;
    skos:definition "Species of tall Brazilian hardwood tree, growing to 40 meters in height. Timber was formerly used for making houses in Brazil, but the species is now threatened with extinction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paratecoma peroba"@en .

aat:300375184 a skos:Concept ;
    skos:definition "Species of timber tree native to Brazil, Peru, Argentina, Colombia, and Paraguay. Also used for beekeeping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aspidosperma polyneuron"@en .

aat:300375185 a skos:Concept ;
    skos:definition "Genus including rain forest hardwood timber trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paratecoma"@en .

aat:300375188 a skos:Concept ;
    skos:definition "Genus containing 10 species; it is the only genus of the family Platanaceae. These large trees are native to North America, eastern Europe, and Asia. They are characterized by scaling bark; large, deciduous, usually palmately lobed leaves; and globose heads of flower and seed. They bear flowers of both sexes on the same tree but in different clusters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platanus"@en .

aat:300375189 a skos:Concept ;
    skos:definition "Order of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proteales"@en .

aat:300375190 a skos:Concept ;
    skos:definition "Family containing one genus of trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platanaceae"@en .

aat:300375191 a skos:Concept ;
    skos:definition "Dense, yellow wood of the species Platanus orientalis, having a fine texture that is similar to maple. It is used for furniture, butcher blocks, chairs, musical instruments, interior finishes, and cabinetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oriental plane"@en .

aat:300375192 a skos:Concept ;
    skos:definition "Tough, coarse-grained wood of the species Platanus racemosa. It is difficult to split and work, but is used for butchers' blocks and for other rough work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "California sycamore"@en .

aat:300375193 a skos:Concept ;
    skos:definition "Species that is a hybrid of Platanus occidentalis and Platanus orientalis. It combines characteristics of both in varying degrees. It is a little shorter and more squat than the American (occidentalis) tree and usually has bristly, paired seedballs. There are variegated forms of London plane. It is planted widely in cities for its resistance to air pollution and to diseases that more readily affect other plane trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platanus acerifolia"@en .

aat:300375194 a skos:Concept ;
    skos:definition "Plane tree native from southeastern Europe to India, known for its longevity and spreading crown. It has been known in cultivation in other areas from ancient times. It reaches 30 m (100 feet) in height, and has huge, often squat boles, some measuring nearly 10 m in circumference (3 m in diameter). Its bristly seedballs hang in clusters of two to six."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platanus orientalis"@en .

aat:300375195 a skos:Concept ;
    skos:definition "Dense, yellow wood of the species Platanus occidentalis, having a fine texture that is similar to maple. It is used for furniture, butcher blocks, chairs, musical instruments, interior finishes, and cabinetry.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American sycamore"@en .

aat:300375196 a skos:Concept ;
    skos:definition "Species of plane tree native to North America; the tallest of the plane trees, reaching more than 50 m (160 feet) in height. Its pendent, smooth, ball-shaped seed clusters usually dangle singly and often persist after leaf fall. It is distinguished from other trees by its mottled exfoliating bark, which flakes off in great irregular masses, leaving the surface mottled, and greenish-white, gray and brown. For trees known simply as \"sycamore,\" use Acer Pseudoplatanus, which is a species of maple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platanus occidentalis"@en .

aat:300375197 a skos:Concept ;
    skos:definition "Species of large maple tree native to central Europe and western Asia, but introduced into Britain in the 15th century. On young trees, the bark is smooth and grey but becomes rougher with age and breaks up in scales, exposing the pale-brown-to-pinkish inner bark. It is an important timber and shade tree in Europe, having many ornamental varieties. For other trees sometimes called simply \"sycamore,\" use \"Ficus sycamorus\" for the sycamore fig and \"Platanus occidentalis\" for the American sycamore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acer pseudoplatanus"@en .

aat:300375198 a skos:Concept ;
    skos:definition "Raised platforms or similar work surfaces situated in the middle of a room, especially a kitchen, permitting access from all sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "islands"@en .

aat:300375200 a skos:Concept ;
    skos:definition "Wood of trees belonging to the species Ficus sycomorus, native to Africa south of the Sahel and north of the Tropic of Capri. Used for furniture and caskets. For other woods sometimes called simply \"sycamore,\" use \"sycamore\" for wood from the sycamore maple Acer pseudoplatanus and \"American sycamore\" for wood from the plane tree species Platanus occidentalis"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sycamore fig"@en .

aat:300375201 a skos:Concept ;
    skos:definition "Any film presentation with an aspect ratio of 1.85, flat. Most wide-screen processes are anamorphic but some such as Panavision 70 and Todd-AO employ wide gauge film or overlapping multiple projectors such as with Cinerama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wide-screen"@en .

aat:300375202 a skos:Concept ;
    skos:definition "Species of fig tree native to Africa; it has been cultivated since ancient times. The ancient Egyptians used it from the Predynastic period in the third millennium BCE; it is this tree represented as the ancient Egyptian Tree of Life. The fruit, timber, even the twigs included in the tombs of Early, Middle and Late Kingdoms; caskets of some mummies are made from the wood of this species. It is also mentioned in several passages in the Bible. This species requires the presence of the symbiotic wasp Ceratosolen arabicus to reproduce sexually, but this insect is now extinct in Egypt. In tropical areas where the wasp is common, complex mini-ecosystems involving the wasp, nematodes, other parasitic wasps, and various larger predators revolve around the life cycle of the fig. For other trees that are sometimes called simply \"sycamore,\" use \"Acer pseudoplatanus\" for the sycamore maple and \"Platanus occidentalis\" for the American sycamore plane tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ficus sycomorus"@en .

aat:300375203 a skos:Concept ;
    skos:definition "Wide-screen process created by Fred Waller and used commercially beginning in 1952. The system employed a vast curved screen with three overlapping 35mm projectors each in a separate booth, with one on the right projecting onto the left third of the screen, the one in the center pointed straight ahead, and the one on the left projecting onto the right third of the screen. Most productions were travelogues, and \"How the West Was Won \"(1962) was one of the few fiction films produced in Cinerama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cinerama"@en .

aat:300375204 a skos:Concept ;
    skos:definition "Anamorphic wide-screen process developed and introduced by film technicians at Twentieth Century-Fox in the early 1950s. CinemaScope uses an aspect ratio varying from 2.66.1 to 1.66:1 and a special anamorphic lens, also referred to as a Cinemascope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CinemaScope"@en .

aat:300375206 a skos:Concept ;
    skos:definition "Groups of shelves, used for storage. Shelving units can be fixed or movable (on tracks), and made of wood, metal, or another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shelving units"@en .

aat:300375207 a skos:Concept ;
    skos:definition "Stands used to hold or support typewriters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriter stands"@en .

aat:300375208 a skos:Concept ;
    skos:definition "Tables used for the activity of knitting, typically outfitted with drawers or cubbyholes to hold wool or other supplies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knitting tables"@en .

aat:300375209 a skos:Concept ;
    skos:definition "High chests of deep drawers used for keeping priest's vestments, often with a table so that the garments can be laid out, and a mirror so that the priests can see that they are properly attired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vesting tables"@en .

aat:300375210 a skos:Concept ;
    skos:definition "Species of large plane tree native to to California and Baja California. The trunk generally divides into two or more large trunks splitting into many branches; it has an attractive bark that is white, beige, gray, and pinkish, with older bark becoming darker and peeling away. It is used for landscaping, for timber, the fruit is food for birds, and mammals eat its twigs and bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Platanus racemosa"@en .

aat:300375211 a skos:Concept ;
    skos:definition "Genus containing around 35 species and several natural hybrids of rapid-growing but relatively short-lived trees deciduous trees native to the Northern Hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus"@en .

aat:300375212 a skos:Concept ;
    skos:definition "Species of medium-sized, deciduous tree native to native to Europe, southwest and central Asia, and northwest Africa. Known in three or four subspecies. It has oval, fine-toothed leaves; is long-trunked, and grows to 35 meters (115 feet) in height. The timber is primarily used for paneling and other purposes. A yellowish dye can be extracted from the fresh leaves. On wool, it produces a brass color with a chrome mordant and a yellow-brown color with an alum mordant. The extract does not dye cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus nigra"@en .

aat:300375213 a skos:Concept ;
    skos:definition "Species of cottonwood poplar native to much of North America; it is known in three subspecies. It is one of the largest North American hardwood trees, growing to nearly 30 meters (100 feet) in height. It has thick glossy leaves and bark that is silver-white and smooth, becoming darker and deeply fissured on older trees. Due to the flat stem of the leaf, the leaf has the tendency to shake from even the slightest breeze. This is one of the identifying characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus deltoides"@en .

aat:300375214 a skos:Concept ;
    skos:definition "Common term for the wood of several trees, most in the genus Populus (poplars)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aspen"@en .

aat:300375215 a skos:Concept ;
    skos:definition "Trade name for wide-screen process and cameras developed by Panavision, Inc. that originally used an anamorphic camera lens to squeeze the picture onto 35mm film, which, when projected through the same type of lens, creates an image with an aspect ratio of 2.35:1."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panavision"@en .

aat:300375216 a skos:Concept ;
    skos:definition "Species of hardy, medium-sized poplar tree native to cool temperate regions of Europe and Asia, including the British Isles. The bark is pale greenish-gray, smooth on young trees with dark grey diamond-shaped lenticels. It turns darker and fissured on old trees. The leaves are especially liable to the tremulous motion common to all poplars, thus the name of the species; leaves have an unpleasant taste that discourages denuding by fallow deer. The wood has large, evenly-distributed pores that produce a soft fibrous texture, making it valuable for only limited use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus tremula"@en .

aat:300375217 a skos:Concept ;
    skos:definition "Common term for several poplar trees that are typically native to cold regions with cool summers, in the north of the Northern Hemisphere but extending south at high altitudes in the mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aspen"@en .

aat:300375218 a skos:Concept ;
    skos:definition "Optical lenses that differently magnify the horizontal and vertical axes of an image. In cinema, the term refers to the lens that compresses the width of a film's frame, and to the lens of the projector, so that when it is projected onto the screen, its normal width returns. The height in both lenses is left undistorted and the result is the wide-screen image. The aspect ratio was at first 2:55:1 and later 2.35:1 to adjust for the optical soundtrack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anamorphic lenses"@en .

aat:300375220 a skos:Concept ;
    skos:definition "Portable enclosures in which young children can play safely alone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "playpens"@en .

aat:300375221 a skos:Concept ;
    skos:definition "Interior walls made up of standardized moduals or units which are the basis for construction and allow for flexible arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modular walls"@en .

aat:300375222 a skos:Concept ;
    skos:definition "Small racks, stands, or shelves used to hold tobacco pipes. Usually made of wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe racks"@en .

aat:300375223 a skos:Concept ;
    skos:definition "Devices for holding and storing tobacco pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe holders"@en .

aat:300375224 a skos:Concept ;
    skos:definition "Relatively large jars, often in stoneware or glass, used to store powdered snuff. For smaller containers for carrying snuff on the person, use \"snuff bottles\" or \"snuffboxes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snuff jars"@en .

aat:300375225 a skos:Concept ;
    skos:definition "Ornamental electric lamps that consist of a transparent chamber housing a liquid, usually water, in which brightly colored blobs of wax are suspended. The wax moves and changes shape due to heat supplied by an electric bulb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lava lamps"@en .

aat:300375226 a skos:Concept ;
    skos:definition "Dense wood of the species Diospyros texana, native to Texas and Oklahoma in the United States, and northeastern Mexico. The sapwood is yellow, while the heartwood found in large trees is ebony black. It is used for furniture and printing blocks, among other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Texas persimmon"@en .

aat:300375227 a skos:Concept ;
    skos:definition "Species of handsome, broad-topped, slow-growing (to 80 feet (25 m) in height) tree native to eastern Mexico, Central America, and south to Colombia. It produces edible tomato-like fruit. It is used medicinally: the crushed bark and leaves are applied as a blistering poultice; the leaf decoction is employed as an astringent and is taken internally as a febrifuge; various preparations are used against leprosy, ringworm and itching skin conditions. Unripe black persimmon fruits are very astringent, irritant, caustic and bitter, and have been used as fish poison. It is unrelated to other plants called \"sapote,\" the mamey sapote (Sapotaceae), and the white sapote (Rutaceae)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros digyna"@en .

aat:300375228 a skos:Concept ;
    skos:definition "Wood of the species Diospyros digyna, native to eastern Mexico, Central America, and south to Colombia. The wood is yellowish to deep-yellow with black markings near the heart of old trunks; it is compact and suitable for cabinetwork. Reports of dark wood utilized for furniture are probably the result of confusion with other species of the genus Diospyros."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black persimmon"@en .

aat:300375229 a skos:Concept ;
    skos:definition "Wood of the species Diospyros texana, native to Texas and Oklahoma in the United States, and northeastern Mexico. The sapwood is yellow, while the heartwood found in large trees is ebony black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros texana"@en .

aat:300375230 a skos:Concept ;
    skos:definition "Species of small or shrubby tree native to North America, from New England to the Midwest, to the South Atlantic and Gulf states. The wild tree has been cultivated for its fruit and wood since prehistoric times by Native Americans. The fruit is round and orange in color. In the American South and Midwest, the fruits are referred to as simply \"persimmons,\" used in cooking and for making brandy. Folklore holds that the fruit is inedible prior to the first frost, but this is untrue. The peculiar astringency of the fruit is due to the presence of a tannin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Diospyros virginiana"@en .

aat:300375231 a skos:Concept ;
    skos:definition "Preserved animal hides mounted onto forms that replicate the animals' sub-dermal structures, resulting in lifelike representations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxidermy mounts"@en .

aat:300375232 a skos:Concept ;
    skos:definition "Racks for storing and/or displaying magazines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magazine racks"@en .

aat:300375233 a skos:Concept ;
    skos:definition "Racks for storing and/or displaying newspapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newspaper racks"@en .

aat:300375234 a skos:Concept ;
    skos:definition "Vessels used to hold paste, often including compartments for water in an effort to keep the paste from hardening."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paste pots"@en .

aat:300375235 a skos:Concept ;
    skos:definition "Poles used for raising or lowering window sashes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sash poles"@en .

aat:300375236 a skos:Concept ;
    skos:definition "Devices, often made of rubber, that prevent liquid from escaping a contained area such as a sink or an oil tank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drain plugs"@en .

aat:300375237 a skos:Concept ;
    skos:definition "Devices intended to eliminate impurities in the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air purifiers"@en .

aat:300375238 a skos:Concept ;
    skos:definition "Rings used to hold shower curtains from shower curtain rods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shower curtain rings"@en .

aat:300375239 a skos:Concept ;
    skos:definition "Built objects used for scraping the mud off of one's boots. Typically located in front of a house, particularly in wealthy areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boot scrapers"@en .

aat:300375240 a skos:Concept ;
    skos:definition "Oval or circular ringlike seats attached to the tops of toilet bowls. Usually made of wood or plastic and often covered with hinged tops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet seats"@en .

aat:300375242 a skos:Concept ;
    skos:definition "Objects used to warm a bed. Traditionally refers to a covered pan with an extended handle filled with hot coals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bed warmers"@en .

aat:300375243 a skos:Concept ;
    skos:definition "Constructed objects that mimic the appearance of logs, used accessorize a fireplace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial logs"@en .

aat:300375244 a skos:Concept ;
    skos:definition "Three-dimensional constructed objects that mimic the appearance of flowers and foliage. Materials may include porcelain, carved wood, ivory, silk, and paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial flowers"@en .

aat:300375245 a skos:Concept ;
    skos:definition "Bases or holders which sit in water and are used to hold flower arrangements in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower frogs"@en .

aat:300375246 a skos:Concept ;
    skos:definition "Stands or racks for holding boots. Some include a drip tray for drying wet boots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boot racks"@en .

aat:300375247 a skos:Concept ;
    skos:definition "Wall mounted racks for hanging keys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key racks"@en .

aat:300375248 a skos:Concept ;
    skos:definition "Sets of decorations for the tops of fireplace mantels usually made up of a clock and two matching vases. First popularized in 18th century France and common in the United States and Britain during the 19th century; out of fashion by early 20th century. For matching sets of vases, use \"garnitures (vases).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clock garnitures"@en .

aat:300375249 a skos:Concept ;
    skos:definition "Armors intended for show rather than for function, including armor used in ritual or formal events rather than in battle, or armor intended for display but not worn at all. Typically, display armor is decorative, elaborate, and incorporates precious materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display armors"@en .

aat:300375250 a skos:Concept ;
    skos:definition "Dolls used as decorations on beds and divans, often with elaborate or outrageous costuming and presentation; not intended as children's toys. Made in France, Italy, and the United States from 1915-1940."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boudoir dolls"@en .

aat:300375251 a skos:Concept ;
    skos:definition "Having the shape of a horseshoe, that is generally U-shaped but with the arms of the \"U\" turned inward to varying degree. Named for the protective narrow iron plate that is bent to the outline of the horse's hoof and nailed to the animal's foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horseshoe-shaped"@en .

aat:300375252 a skos:Concept ;
    skos:definition "Fluorescent lamps, available in two types, with ultraviolet emitting phosphors. Used in the ultraviolet investigation of cultural materials, conservation, and in many scientific contexts. Filtered black light blue bulbs produce a dark violet glow with phosphors releasing near 404.7 nm; non-filtered black light bulbs emit a light blue light with phosphors releasing near 360 nm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black light bulbs"@en .

aat:300375254 a skos:Concept ;
    skos:definition "Quartz bulbs with gas filling that includes a halogen. The halogen combines with the tungsten evaporated from the hot filament to form a compound that is attracted back to the filament, thus extending the filament’s life and preventing from condensation on the bulb that darkens, an effect that reduces the light output of ordinary incandescent lamps. First used in the late 1960s in the motion-picture industry, halogen bulbs are commonly used in automobile headlights, residential lighting, and underwater photography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halogen bulbs"@en .

aat:300375255 a skos:Concept ;
    skos:definition "Finials, attatched to the top most portion of a lamp, typically by way of a screw, and often used to secure a lamp shade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamp finials"@en .

aat:300375256 a skos:Concept ;
    skos:definition "Candles created from molds to have relatively wide columns and which generally burn in a way that forms an outer edge of unmelted wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pillar candles"@en .

aat:300375257 a skos:Concept ;
    skos:definition "Flexible tubes containing two solutions in separte chambers, which emit light as a result of the chemical reaction that occurs when the tube is bent and solutions combine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light sticks"@en .

aat:300375259 a skos:Concept ;
    skos:definition "Devices, considered a derivative of bow drills, specifically used to produce fire by friction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire bows"@en .

aat:300375262 a skos:Concept ;
    skos:definition "Portable devices, typically made up of burners and gas containers, used to ignite various materials such as fireplace logs or charcoal briquettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable igniters"@en .

aat:300375263 a skos:Concept ;
    skos:definition "Manufactured electric fans attached to ceilings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling fans"@en .

aat:300375264 a skos:Concept ;
    skos:definition "Electric instruments that create an artificial breeze, for cooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric fans"@en .

aat:300375265 a skos:Concept ;
    skos:definition "Combustible material used for starting fires."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kindling"@en .

aat:300375266 a skos:Concept ;
    skos:definition "Stoves heated by gas generated from alcohol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alcohol heaters"@en .

aat:300375267 a skos:Concept ;
    skos:definition "Heaters for the burning of coal. May be for industrial or domestic use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal heaters"@en .

aat:300375268 a skos:Concept ;
    skos:definition "Large swinging devices used for fanning rooms. Made up of cloth covered frames hung from ceilings and moved by servants or machinery. Used primarily in India. May also refer to large, hand-held fans, particularly those made of palmyra leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punkahs"@en .

aat:300375269 a skos:Concept ;
    skos:definition "Biofuel stoves that burn biomass solid fuel in pellet form to generate heat. Examples of biomass solid fuel include: corn kernels, wood pellets, and cherry pits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pellet stoves"@en .

aat:300375271 a skos:Concept ;
    skos:definition "Lids or plates, often iron, which are placed over burners on a stove."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stove lids"@en .

aat:300375272 a skos:Concept ;
    skos:definition "Pipes, typically made of lenths of angular or curved sheet metal, used as a stove chimney or to connect a stove to a flue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stovepipes"@en .

aat:300375273 a skos:Concept ;
    skos:definition "Boxes or enclosed places used to hold or store coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coalbins"@en .

aat:300375274 a skos:Concept ;
    skos:definition "Tanks designed for safe storage of oil used for fuel. Often made of metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil tanks"@en .

aat:300375275 a skos:Concept ;
    skos:definition "Rings that fit around a curtain rod and attach to a curtain, allowing it to be hung and moved from side to side. Curtain rings range in appearance from the simple and everyday to the ornately decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain rings"@en .

aat:300375276 a skos:Concept ;
    skos:definition "Everyday items that connect a curtain to curtain rings or a curtain rod, enabling the curtain to hang."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain hooks"@en .

aat:300375277 a skos:Concept ;
    skos:definition "Cords used to pull down window shades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shade pulls"@en .

aat:300375278 a skos:Concept ;
    skos:definition "Horizontally mounted rods from which curtains are hung, sometimes with the aid of curtain rings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain rods"@en .

aat:300375279 a skos:Concept ;
    skos:definition "Shutters, typically made of wood, mounted on the inside wall of a house, covering a window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior shutters"@en .

aat:300375280 a skos:Concept ;
    skos:definition "Combs used to hold the hair or a hat in place. Often highly ornamented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuck combs"@en .

aat:300375281 a skos:Concept ;
    skos:definition "Clasps or catches used to fasten the ends of a belt, sometimes ornamented with designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belt buckles"@en .

aat:300375282 a skos:Concept ;
    skos:definition "Pins used to fasten diapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaper pins"@en .

aat:300375283 a skos:Concept ;
    skos:definition "Small, metal plates attached to the heel of a shoe to protect it from wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heel plates"@en .

aat:300375284 a skos:Concept ;
    skos:definition "Decorative pins used to secure watches to dresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watch pins"@en .

aat:300375285 a skos:Concept ;
    skos:definition "Devices attached to or inserted into the openings of pockets either to keep objects from falling out or to protect garments from stains and wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket protectors"@en .

aat:300375286 a skos:Concept ;
    skos:definition "Items having a certain weight, that are sewn onto, clipped onto, or inserted into the hem or lower edge of a garment in order to improve the drape, causing the fabric to hang down properly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skirt weights"@en .

aat:300375287 a skos:Concept ;
    skos:definition "Japanese ankle-socks, usually of cotton, with a separate stall for the large toe, worn by both sexes. Often with a thick sole, and worn alone or with wooden clogs or 'geta.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabi"@en .

aat:300375288 a skos:Concept ;
    skos:definition "Shoes of a certain type, characterized by having laces along the instep and no tongue; typically of the type used for Scottish country dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghillies"@en .

aat:300375289 a skos:Concept ;
    skos:definition "Shoes which have pieces of leather sewn across the insteps, usually in a contrasting color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddle shoes"@en .

aat:300375290 a skos:Concept ;
    skos:definition "Prehistoric artifacts of uncertain function. Formed from short lengths of reindeer antler with a pierced end, and often decorated. 'Bâtons de commandement' was the term initially used for this class of artifacts, but made an assumption of function; bâtons percés, the more recent term, is descriptive of form rather than any presumed function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bâtons percés"@en .

aat:300375291 a skos:Concept ;
    skos:definition "A counterweighted pole with a bucket on one end to make drawing water from a well easier. Poles or pieces of timber attached to horizontal fulcrums and used to raise and lower buckets drawing water from wells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "well sweeps"@en .

aat:300375293 a skos:Concept ;
    skos:definition "Kazak rugs named after the historical province Loru Pambak, a mountainous region of Armenia that borders Georgia in the western Caucasus. Since ca. 1800, the rugs have been largely produced by Armenians living in this area, although earlier examples may have originated with the Persian Lori or Azeri. The style is distinguished by a central medallion containing a rough cross-shape in which two opposing arms are square with zigzag terminations, and the other two arms are stylized tulips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lori Pambak"@en .

aat:300375294 a skos:Concept ;
    skos:definition "Simple looms in which four stakes driven into the ground hold the tension on the breast beam and warp beam, with no other frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ground looms"@en .

aat:300375295 a skos:Concept ;
    skos:definition "Parts or components of wells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "well components"@en .

aat:300375296 a skos:Concept ;
    skos:definition "Dresses worn about the house, typically while doing cleaning. For similar garments functioning as dressing gowns, use \"housecoats.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "housedresses"@en .

aat:300375297 a skos:Concept ;
    skos:definition "Dresses made for expectant mothers, typically loose fitting or adjustable in the waist area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maternity dresses"@en .

aat:300375298 a skos:Concept ;
    skos:definition "Dresses with long skirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maxi dresses"@en .

aat:300375299 a skos:Concept ;
    skos:definition "Dresses of intermediate length. They are longer than mini dresses but shorter than maxi dresses, usually extending to mid-calf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "midi dresses"@en .

aat:300375300 a skos:Concept ;
    skos:definition "Knitted or crocheted dresses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweater dresses"@en .

aat:300375301 a skos:Concept ;
    skos:definition "Hats, typically with a broad brim worn in sunny climates to protect the head from the sun's rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sun hats"@en .

aat:300375302 a skos:Concept ;
    skos:definition "White cloth coverings for caps, incorporating a flap hanging over the neck. Worn by soldiers as sun protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "havelocks"@en .

aat:300375303 a skos:Concept ;
    skos:definition "Box-like, two or three story walk-up apartment buildings typically made of stucco and having sheltered parking at street level. The style was popular in Los Angeles, California in the 1950s and 1960s, and because of their mass proliferation, dingbats have come to be seen as signs of urban blight. In recent times, they have been the subject of aesthetic interest as examples of Mid-Century Modern kitsch, since many have themed names and specialized trim."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dingbats"@en .

aat:300375304 a skos:Concept ;
    skos:definition "Species of small deciduous tree native to the Middle East and South Asia, widely cultivated in Europe, east Africa and California. The fruit and oil from the sweet almond variety are used for food while the oil from the bitter almond variety is used for flavoring. Botanically, the fruit of the almond is not a true nut, but a drupe, consisting of an outer hull and a hard shell with the edible seed inside. Although the tree is grown commercially for its fruit and oils, the wood is also used. The water soluble gum that exudes from wounds on the tree has been mentioned as a watercolor binder. Almond trees are closely related to cherry trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus dulcis"@en .

aat:300375305 a skos:Concept ;
    skos:definition "Species of small, deciduous, fruit-bearing tree that originated in China but is now cultivated throughout the temperate regions of the world. The scientific name includes a reference to Armenia, where it has been cultivated since ancient times. The common name is derived from an Arabic word, dating to the Moorish occupation of Spain. The tree has also been cultivated in Persia and Egypt since ancient times. Seeds or kernels of the apricot may be substituted for almonds; the oil pressed from these kernels is called \"oil of almond\"; the Italian liqueur amaretto and amaretti biscotti are flavored with extract of apricot kernels rather than almonds. In Europe, apricots were long considered an aphrodisiac, as mentioned by Shakespeare. A clear, water soluble gum exudes from open cuts in the bark; the gum contains arabinose, galactose, mannose, and glucuronic acid. In modern agriculture, apricot cultivars are usually grafted on plum or peach rootstocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus armeniaca"@en .

aat:300375306 a skos:Concept ;
    skos:definition "General term referring to several species of trees and shrubs of the genus Prunus, native to Asia, Europe, and North America. Most produce small edible fruits, which are pale yellow to deep red or blackish smooth-skinned drupes enclosing a smooth seed. The wood is harvested. Some varieties are valued for their ornamental blossoms, for example, in Japan, where the annual appearance of cherry blossoms is a national observation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherry"@en .

aat:300375307 a skos:Concept ;
    skos:definition "Small to medium-sized deciduous tree that originated in China and cultivated in warmer climates throughout the world. The scientific name reflects that fact that Europeans formerly thought that the plant was native to Persia. Like other fruit trees from the rose family, peach trees exudes a water soluble gum from damaged locations on its truck and branches. The fruit has yellow or whitish flesh, a delicate aroma, and a skin that is either velvety (peaches) or smooth (nectarines) in different cultivars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus persica"@en .

aat:300375308 a skos:Concept ;
    skos:definition "General term for several trees of the genus Prunus. Plum trees have been cultivated for their fruit for over 2000 years; they bear small, sweet, reddish purple fruit with a smooth skin. The dark brownish-red wood from plum trees has been used for various purposes. The trees also exude a water-soluble gum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plum"@en .

aat:300375309 a skos:Concept ;
    skos:definition "Species of deciduous, fruit-bearing tree of North America, found in forest areas from Ontario to Florida and from the Dakotas to Texas. Valued for dense, close-grain wood and its gum, a water-soluble carbohydrate that has been used as a medium for watercolor paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus serotina"@en .

aat:300375310 a skos:Concept ;
    skos:definition "Species of small cherry tree native to much of Europe and southwest Asia, closely related to the wild cherry (P. avium) but having a fruit that is more acidic. Cultivated sour cherries were apparently selected from wild specimens from around the Caspian and Black Seas; they were popular in Persia and known to the Greeks by the 4th century BCE. The Romans introduced them into Britain by the 1st century CE. In Britain, their cultivation was popular in the time of Henry VIII; by 1640 over 20 named cultivars were recorded. English colonists to Massachusetts brought the sour cherry to America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus cerasus"@en .

aat:300375311 a skos:Concept ;
    skos:definition "Species of medium-sized deciduous Eurasian tree. All parts except the fruit are slightly toxic. The fruit is food for birds and mammals; some also crack open the stones to eat the kernel inside. The leaves provide food for some animals, including the case-bearer moth. The tree exudes a gum from wounds in the bark, by which it seals the wounds to exclude insects and fungal infections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus avium"@en .

aat:300375312 a skos:Concept ;
    skos:definition "Species of small tree or large shrub native to middle and southern Europe, western and central Asia, and northwestern Africa. It produces a small thin-fleshed cherry-like drupe, the kernel of which is used in perfumery and as a flavoring that tastes like bitter almond. It is also used in dye-making. The hard wood is used for small objects. The fruits are strung as beads in Africa and Asia. The tree is also used as dwarf stock for grafting branches of cultivated edible cherries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prunus mahaleb"@en .

aat:300375313 a skos:Concept ;
    skos:definition "Genus containing around 25 species of medium- to large-sized trees native to tropical regions of Central and South America. Valued for hard wood that becomes dark purplish brown upon exposure to UV light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peltogyne"@en .

aat:300375314 a skos:Concept ;
    skos:definition "Wood from the species Schinopsis lorentzii. It is extremely hard, polishes well, and has a spotted reddish brown appearance. It is generally stained black. It is used for carvings, railway sleepers, and heavy construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red quebracho"@en .

aat:300375315 a skos:Concept ;
    skos:definition "Species of tree native to the subtropical areas of Argentina, Paraguay, and Bolivia. It is valued for its hard, durable wood. Its tannin is the most important vegetable tanning agent used in the American leather industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schinopsis lorentzii"@en .

aat:300375316 a skos:Concept ;
    skos:definition "Species of tree native to northern Argentina, valued for its hard, durable wood and as medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aspidosperma quebracho-blanco"@en .

aat:300375317 a skos:Concept ;
    skos:definition "Wood from the species Aspidosperma quebracho-blanco. It is very hard, yellow in color, heavy, and well suited to bending and shock. If the drying process is not slow, the wood will crack. It is used for floors, carts, wheels, tool handles, furniture, chess pieces, and skis. In some places it is used as fuel because it burns slowly and does not produce sparks or large amounts of ash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white quebracho"@en .

aat:300375318 a skos:Concept ;
    skos:definition "Order of flowering plant containing 5 families with more than 1,100 genera and nearly 17,000 species. Many are ornamental plants or producers of drugs. Members are characterized in part by leaves that are opposite or whorled (two or more per node), with simple blades. The leaves are usually accompanied by stipules (small leaflike appendages at the base of the leaves)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gentianales"@en .

aat:300375319 a skos:Concept ;
    skos:definition "Family containing over 420 genera and around 1500 species of trees, shrubs, woody vines, and herbs. Many species are tall trees found in tropical rainforests. Members of the family have milky, often poisonous juice; smooth-margined leaves; and flowers in clusters (rarely solitary). The fruit may be berrylike or fleshy but usually is a dry pod (follicle) that splits open at maturity, releasing many winged or tufted seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apocynaceae"@en .

aat:300375320 a skos:Concept ;
    skos:definition "Genus of flowering plant containing over 20 species, including rain forest hardwood timber trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aspidosperma"@en .

aat:300375321 a skos:Concept ;
    skos:definition "Family containing 70 genera and around 650 species of evergreen or deciduous trees, shrubs, and woody vines native primarily to tropical and subtropical areas of the world, but with a few species occurring in temperate regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anacardiaceae"@en .

aat:300375322 a skos:Concept ;
    skos:definition "Genus of South American trees, most of which produce hard wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schinopsis"@en .

aat:300375323 a skos:Concept ;
    skos:definition "Acidic wood of the species Tieghemella heckelii, reddish to purplish-brown in color, typically with straight grain and dark streaks. It is used for furniture, cabinet work, joinery, decorative veneers, panelling, boat building, flooring, turnery, carving, pianos, and other musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "makore"@en .

aat:300375324 a skos:Concept ;
    skos:definition "Species of tree native to evergreen rainforests of Central and West Africa, important as a source of fruits and seeds eaten by elephants and other forest mammals. The wood is valued for furniture and musical instruments. The oil from the seed is eaten and the fruit is used to make soap locally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tieghemella heckelii"@en .

aat:300375325 a skos:Concept ;
    skos:definition "Genus containing a small number of rainforest trees in Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tieghemella"@en .

aat:300375326 a skos:Concept ;
    skos:definition "Family of largely tropical evergreen trees and shrubs, containing 53 genera and about 1,100 species. However, the generic limits in the family are notoriously difficult and changeable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sapotaceae"@en .

aat:300375327 a skos:Concept ;
    skos:definition "Genus containing 100 to 600 species of medium-size trees, shrubs and lianas; the number of species classified here varies with the authority. The genus is native to tropical Central and South America, Africa, Madagascar, and southern Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia"@en .

aat:300375328 a skos:Concept ;
    skos:definition "Copies of a book, film, print, document, data, software, or other tangible or digital objects that are maintained in a long-term storage facility or media rather than being made available for circulation or general use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival copies"@en .

aat:300375329 a skos:Concept ;
    skos:definition "Species of small tree native to the dry savanna woodlands of Africa and western India; valued as timber since ancient Egyptian times. Not a true ebony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia melanoxylon"@en .

aat:300375330 a skos:Concept ;
    skos:definition "Genus of trees, some members of which produce hardwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melanorrhoea"@en .

aat:300375331 a skos:Concept ;
    skos:definition "Correctly, wood from various trees of the genus Jacaranda, native to the West Indies, tropical Americas, Florida, and California. Jacaranda is a fragrant ornamental wood has been used for carvings, small decorative items, pianos, knife handles, cabinets, and expensive furniture. The term is also commonly used as a general term for Jacaranda as well as various varieties of rosewood, which itself is a general term referring to various species of the genera Dalbergia or Melanorrhoea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jacaranda"@en .

aat:300375332 a skos:Concept ;
    skos:definition "Genus containing around 50 species of trees and shrubs native to tropical America, yielding fragrant wood and valued as ornamentals, due to showy flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jacaranda"@en .

aat:300375333 a skos:Concept ;
    skos:definition "General term for any dark ornamental wood derived from various tropical American trees, especially of the genus Jacaranda, the species Dalbergia nigra (Brazilian rosewood), or the genus Peltogyne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palisander"@en .

aat:300375334 a skos:Concept ;
    skos:definition "Digital prints made with an ink jet process, originally used interchangeably with \"Iris prints,\" but now more often used to refer to high-volume editions of reproductions rather than high-quality original art. The term \"giclée\" was coined by the printmaker Jack Duganne in 1991 to refer to inkjet prints on high-quality paper, but the usage is now evolving to become broader."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giclée prints"@en .

aat:300375335 a skos:Concept ;
    skos:definition "Species of hardwood tree found only in Brazil, from Bahia to Rio de Janiero. Threatened by habitat loss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia nigra"@en .

aat:300375336 a skos:Concept ;
    skos:definition "Species of medium sized tree native to Bangladesh, China, India, Laos, Myanmar, Nepal, Pakistan, Sri Lanka, Thailand, Vietnam; found as an exotic in Burundi, Kenya, Malawi, Mozambique, and Zimbabwe. The leaves are fodder for cattle; monkeys eat the pods. Timber is used for furniture and construction. Fallen branches are used as fuel. The gum is used as an extender for other gums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albizia odoratissima"@en .

aat:300375337 a skos:Concept ;
    skos:definition "Species of tree native to Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia retusa"@en .

aat:300375338 a skos:Concept ;
    skos:definition "Wood from the species Brya ebenus native to Central America and the Caribbean islands. It comes from the black or rich brown heartwood. It is brittle, very heavy, exceedingly hard, having a fine uniform texture, and capable of receiving a high polish. It is used for inlays, brush backs, parquet, and musical instruments. Not a true rosewood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocuswood"@en .

aat:300375339 a skos:Concept ;
    skos:definition "Species of small West Indian tree native to Central America and the Caribbean islands. It is a slow-growing tree that has brittle, black heartwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brya ebenus"@en .

aat:300375340 a skos:Concept ;
    skos:definition "Genus of prickly shrubs and small trees of the Caribbean region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brya"@en .

aat:300375341 a skos:Concept ;
    skos:definition "Species of hardwood timber tree native from the Himalayas to the southern tip of India and on the island of Java in Indonesia. The foliage is used as fodder and the bark is used as a source of tannins extracted for medicinal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia latifolia"@en .

aat:300375342 a skos:Concept ;
    skos:definition "Species of hardwood tree native to the Indian subcontinent, primarily found growing along river banks. It is best known internationally as a premier timber species of the rosewood genus, but used locally to make the kartaalsan percussion instrument, as an important fuel, and for shade and shelter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia sissoo"@en .

aat:300375343 a skos:Concept ;
    skos:definition "Wood derived from the species Dalbergia sissoo, native to the Indian subcontinent. The heartwood is dark brown and durable; the sapwood is lighter in color and prone attack by fungi and borers. The wood is used for the finest cabinetry, veneer, flooring, plywood, agricultural tools, musical instruments, carvings, skis, and boats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shisham"@en .

aat:300375344 a skos:Concept ;
    skos:definition "Genus of trees native to tropical America; many valued for fruit and for timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brosimum"@en .

aat:300375345 a skos:Concept ;
    skos:definition "Species of hardwood tree native Central and South America, known for vivid red wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brosimum paraense"@en .

aat:300375346 a skos:Concept ;
    skos:definition "Wood of the species Chloroxylon swietenia, native to southeast Asia, India, and Sri Lanka. It is a silky, golden-colored wood used for fine cabinetwork, veneer, and farming tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceylon satinwood"@en .

aat:300375347 a skos:Concept ;
    skos:definition "Species of hardwood tree native to southern India and Sri Lanka. Sole species in genus Chloroxylon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chloroxylon swietenia"@en .

aat:300375348 a skos:Concept ;
    skos:definition "Genus containing one extant species of hardwood tree native to southern India and Sri Lanka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chloroxylon"@en .

aat:300375349 a skos:Concept ;
    skos:definition "Lustrous, dark yellow wood from the species Zanthoxylum flavum, native to South America, the Caribbean islands, and Africa. This oily timber has a close, irregular grain, smells like coconut, and polishes to a high gloss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Indian satinwood"@en .

aat:300375350 a skos:Concept ;
    skos:definition "Species of tree native to South America, the Caribbean islands, and Africa; valued for its timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zanthoxylum flavum"@en .

aat:300375351 a skos:Concept ;
    skos:definition "Genus containing around 250 species of deciduous and evergreen trees and shrubs native to warm temperate and subtropical areas of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zanthoxylum"@en .

aat:300375352 a skos:Concept ;
    skos:definition "Species of South American timber tree, several of the common names for which refer to the snakeskin-like or leopard-like markings of the wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brosimum guianense"@en .

aat:300375353 a skos:Concept ;
    skos:definition "Genus consisting of three species of deciduous trees and shrubs disjunct between eastern Asia (S. tzumu and S. randaiense) and eastern North America (S. albidum), and one extinct species. They are commercially known for their fragrant oil that is used in perfumes, root beer, and tea. The soft, lightweight wood is used for lumber. A rose-brown to gray color textile dye with good color fastness is extracted from the wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sassafras"@en .

aat:300375355 a skos:Concept ;
    skos:definition "Species of tree is native to sandy soils of eastern North America, from Maine to Ontario and Iowa and south to Florida and Texas. It is usually a small tree or shrub, but may attain a height of 65 feet 20 m). It has furrowed bark, bright green twigs, and small clusters of yellow flowers followed by dark blue berries. It is used for lumber and essential oils extracted from root bark, an ingredient in perfumes, root beer, and teas. Leaves and twigs are consumed by white-tailed deer, groundhogs, marsh rabbits, and American black bears; fruits are eaten by many species of birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sassafras albidum"@en .

aat:300375356 a skos:Concept ;
    skos:definition "Species of tree native to Taiwan, most likely derived from an ancestor from continental China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sassafras radaiense"@en .

aat:300375357 a skos:Concept ;
    skos:definition "Species of tree native to central and southwestern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sassafras tzumu"@en .

aat:300375358 a skos:Concept ;
    skos:definition "Oil extracted from the root bark sassafras trees, native to North America and Asia. Sassafras oil is used as an odorant in fabrics, a flavorant, and an ingredient in soaps and medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sassafras oil"@en .

aat:300375359 a skos:Concept ;
    skos:definition "Packs strapped to the waist and used to carry personal items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanny packs"@en .

aat:300375360 a skos:Concept ;
    skos:definition "Species of large tree native to south and southeast Asia, including India, Indonesia, Malaysia, and Myanmar; it is cultivated in many additional areas, including Africa and the Caribbean. Teak has been widely used in India for more than 2,000 years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tectona grandis"@en .

aat:300375361 a skos:Concept ;
    skos:definition "Boxes in which shoes are packed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoeboxes"@en .

aat:300375362 a skos:Concept ;
    skos:definition "Boxes used to store jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jewelry boxes"@en .

aat:300375363 a skos:Concept ;
    skos:definition "Bags, often similar in style to purses, used to hold and carry diapers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diaper bags"@en .

aat:300375364 a skos:Concept ;
    skos:definition "Bags used by doctors to carry equipment, particularly when making house calls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doctor's bags"@en .

aat:300375365 a skos:Concept ;
    skos:definition "Improvised bundles containing clothes and possessions, particularly bed-rolls carried by itinerant people. Likely an altered form of \"bundle.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bindles"@en .

aat:300375366 a skos:Concept ;
    skos:definition "Family containing 30 genera and over 1,100 species of plants, some of which are important for their flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Verbenaceae"@en .

aat:300375367 a skos:Concept ;
    skos:definition "Genus containing three species of tropical hardwood trees native to south and southeast Asia, particularly India, Pakistan, Bangladesh, Burma, Indonesia, and Thailand; commonly a component of monsoon forest vegetation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tectona"@en .

aat:300375368 a skos:Concept ;
    skos:definition "Bags with single straps worn over the shoulder and across the chest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "messenger bags"@en .

aat:300375369 a skos:Concept ;
    skos:definition "Devices used for splitting solid pills or tablets in half when only half a dose is required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pill splitters"@en .

aat:300375370 a skos:Concept ;
    skos:definition "Wheeled, assistive walkers, used to improve mobility for the disabled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rollators"@en .

aat:300375371 a skos:Concept ;
    skos:definition "A cloth covered bag containing an electrical element used for applying heat to the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heating pads"@en .

aat:300375372 a skos:Concept ;
    skos:definition "Adhesive strips worn on the outside of the nose to improve breathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nasal strips"@en .

aat:300375373 a skos:Concept ;
    skos:definition "Species of tree native to Africa, known for its wood, that has a naturally glossy surface with a fine uniform texture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lovoa trichilioides"@en .

aat:300375374 a skos:Concept ;
    skos:definition "Genus of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lovoa"@en .

aat:300375375 a skos:Concept ;
    skos:definition "Soft, fine-grained wood of the species Liriodendron tulipifera of North America. The sapwood is usually a creamy off-white color; heartwood is pale green, often with streaks of red, purple, or black. It is cheap, easy-to-work, can take a sharp edge, and is stable, used to seal pipes and valves in organs, for siding clapboards, coffin boxes, pattern timber, and wooden ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American tulipwood"@en .

aat:300375376 a skos:Concept ;
    skos:definition "Species of large, columnar tree native to North America, the common name referring to the large flowers that superficially resemble tulips, although the plants are instead closely related to magnolias. They provide food and shelter to butterflies and other animals. They are used for fine-grained, stable timber and landscaping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liriodendron tulipifera"@en .

aat:300375377 a skos:Concept ;
    skos:definition "Genus containing two living species of trees, L. tulipifera, native to eastern North America, and L. chinense, native to China and Vietnam. Both species often grow to great size, sometimes exceeding 32 m (100 feet) in height. Various extinct species of Liriodeondron have been described from the fossil record."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liriodendron"@en .

aat:300375378 a skos:Concept ;
    skos:definition "Species of timber tree restricted to a small area in Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia decipularis"@en .

aat:300375379 a skos:Concept ;
    skos:definition "Species of hardwood tree native to South America, mainly Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dalbergia cearensis"@en .

aat:300375380 a skos:Concept ;
    skos:definition "Devices placed in the ears to aid deafness, and meant to amplify sounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ear trumpets"@en .

aat:300375381 a skos:Concept ;
    skos:definition "Cushions filled with air rather than stuffed with material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air cushions"@en .

aat:300375382 a skos:Concept ;
    skos:definition "Polish used for shoe care. Used in particular to keep leather shoes waterproof and shiny."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoe polish"@en .

aat:300375383 a skos:Concept ;
    skos:definition "Devices outfitted with metal cleats designed to be strapped onto boots or shoes to prevent the foot from slipping on the ice or snow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice creepers"@en .

aat:300375384 a skos:Concept ;
    skos:definition "Genus containing around 400 species of shrubs and trees primarily native to north temperate areas, valued for ornament, shade, erosion control, and timber. Leaves and bark of the willow tree have been used medicinally in ancient Assyria, Sumer, Egypt, Greece, and by Native Americans, as a remedy for aches and fever: willows contain salicin, a substance that chemically resembles aspirin when metabolized by the human body. Willow species easily form hybrids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix"@en .

aat:300375385 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to eastern North America. It has been used for timber, as a substitute for quinine, and to make a bitter tea with similar chemical compounds to aspirin. The young branches and twigs were used by Native Americans to make baskets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix nigra"@en .

aat:300375386 a skos:Concept ;
    skos:definition "Subspecies of willow found from Alaska east to the Canadian Northwest Territory, and south to California and New Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix lucida ssp lasiandra"@en .

aat:300375387 a skos:Concept ;
    skos:definition "Species of willow native to northern and western North America, occurring in wetland habitats. Known in at least three subspecies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix lucida"@en .

aat:300375388 a skos:Concept ;
    skos:definition "Subspecies of willow native to northern and western North America, occurring in wetland habitats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix lucida ssp lucida"@en .

aat:300375389 a skos:Concept ;
    skos:definition "Subspecies of willow native to western North America from eastern British Columbia south to eastern California and Nevada. Included in subspecies lasiandra in some classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix lucida ssp caudata"@en .

aat:300375390 a skos:Concept ;
    skos:definition "Species of willow native to Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix gilgiana"@en .

aat:300375391 a skos:Concept ;
    skos:definition "Species of willow native to Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix cardiophylla"@en .

aat:300375392 a skos:Concept ;
    skos:definition "Species of willow native to Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix bakko"@en .

aat:300375393 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to the British Isles, Europe, and North Asia, but naturalized in the U.S. and elsewhere. Its wood is tough, strong, and lightweight, but is prone to decay. The stems (withies) are used for basketmaking. Charcoal made from the wood was used in the manufacture of gunpowder. The bark was used for tanning leather. The common name refers to the fact that the undersides of the leaves are white in color. In some classifications may be divided into subspecies, including Salix alba ssp vitellina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salix alba"@en .

aat:300375394 a skos:Concept ;
    skos:definition "Order of flowering plants containing only one family, Arecaceae, which comprises nearly 2,400 species of palms in 189 genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arecales"@en .

aat:300375395 a skos:Concept ;
    skos:definition "Family of flowering plants containing nearly 2,400 species of palms in 189 genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arecaceae"@en .

aat:300375396 a skos:Concept ;
    skos:definition "Genus containing around 325 species of palms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calamus"@en .

aat:300375397 a skos:Concept ;
    skos:definition "Genus of grasses containing five species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zea"@en .

aat:300375398 a skos:Concept ;
    skos:definition "Species of cereal plant native to the Americas but introduced to the rest of the world in the 16th century. It is a tall annual grass with a sturdy stalk; it produces rows of edible kernels along an oblong ears growing from the thick stalk. It is known in many varieties having yellow, red, blue, pink, and black kernels, often banded, spotted, or striped. Corn is used as livestock feed, as human food, a raw material in industry, fuel, corn oil, corn syrup, cornstarch, corn flour, and ethanol (whiskey, gasoline). In addition to biomass for fuel, the stalks have been used as additives for acoustical tiles. Corncobs have been carved into smoking pipes; cobs and husks have been used for dolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zea mays"@en .

aat:300375399 a skos:Concept ;
    skos:definition "Small projections located at the axil of a leaf, composed of tiny leaves resembling scales, and forming the rudiment of a branch, cluster of leaves, or blossom. Applied to a flower or leaf at any stage of growth until fully opened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buds"@en .

aat:300375400 a skos:Concept ;
    skos:definition "Genus comprising around 1100 species of flowering plants, native from Africa and Madagascar through southern Asia east through the Pacific."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syzygium"@en .

aat:300375401 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to Indonesia, now also grown in Madagascar, Zanzibar, Pakistan, Sri Lanka, India, and Vietnam. The dried bud of was very important in the earliest spice trade and believed to be originally indigenous to the Moluccas (Spice Islands) of Indonesia. Strong of aroma and hot and pungent in taste, cloves are used to flavor many foods, particularly meats and bakery products; in Europe and the United States the spice is a characteristic flavoring in traditional Christmas holiday foods including wassail, pumpkin pie, fruit cake, and mincemeat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syzygium aromaticum"@en .

aat:300375402 a skos:Concept ;
    skos:definition "Order of flowering plants including familiar members such as ginger, cardamom, turmeric, bananas and arrowroot. It evolved 80 million years ago in the Late Cretaceous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zingiberales"@en .

aat:300375403 a skos:Concept ;
    skos:definition "Family of plants native to the tropics of Africa and Asia, having leaves with overlapping basal sheaths forming a trunk-like shaft resembling woody trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musaceae"@en .

aat:300375404 a skos:Concept ;
    skos:definition "Genus containing around 50 species of bananas and plantains. The tall plants resemble trees, but their stems are not woody, but rather comprising the bases of the huge leaf stalks. Several distinct groups of edible bananas have been developed from species of Musa. Valued primarily for edible fruit, but several types of valuable fibers are obtained from the leaves of banana plants. Banana paper is a handmade, decorative paper produced from the pulp of banana stalks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musa"@en .

aat:300375405 a skos:Concept ;
    skos:definition "Species of medium-sized subtropical citrus tree known for its large, globular, bitter fruit. The grapefruit probably originated in Jamaica as a hybrid of C. grandis. It became well established as a fruit for home consumption in the islands of the West Indies before its culture spread to the American mainland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus paradisi"@en .

aat:300375406 a skos:Concept ;
    skos:definition "Species of medium-sized subtropical citrus tree, having elliptical oblong narrowly winged leaves and a small globose yellowish green fruit, native to Southeast Asia. It was introduced to the Middle East, North Africa, Sicily, and Spain. Limes were introduced to Europe about the 12th-13th century; Columbus took citrus fruit to the West Indies where they soon became widely distributed, including in the Florida Keys (hence its common name \"key lime\") and California. The fruit is usually picked green commercially, and is somewhat sweeter than other citrus fruits called \"lime.\" Lime oil is normally prepared by steam distillation. It is used in flavoring, perfumes, and as an insecticide and antiseptic The fruit is used as flavoring agent and as a source of vitamin C."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus aurantifolia"@en .

aat:300375407 a skos:Concept ;
    skos:definition "Pale green, volatile oil obtained from the rinds of the lime fruit. Lime oil is normally prepared by steam distillation; its components are limonene and citral. It is used in flavoring, perfumes, insecticide, antiseptic, cleaning products, aromatherapy, and as a source of vitamin C."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime oil"@en .

aat:300375408 a skos:Concept ;
    skos:definition "Species of medium-sized subtropical citrus tree producing a seedless lime with relatively thin, green rind; developed in the 19th century in California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus latifolia"@en .

aat:300375409 a skos:Concept ;
    skos:definition "Species of medium-sized subtropical citrus tree having a juicy fruit with a rind that is orange in color (reddish-yellow). Believed to have originated in southeast Asia and cultivated in China by 2500 BCE; it is probably an ancient hybrid of the pomelo (Citrus maxima) and mandarin (Citrus reticulata). It is the most widely distributed fruit tree having the most popular fruit in the world today."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus sinensis"@en .

aat:300375410 a skos:Concept ;
    skos:definition "Species of medium-sized subtropical citrus tree grown throughout the Mediterranean region, having a juicy fruit with a rind that is orange in color (reddish-yellow), with a taste that is sour compared to the sweet orange (C. sinensis). Many varieties are utilized for their essential oil, in perfume, as flavoring, herbal medicine, and appetite suppressant. Slivers of the rind are used to give marmalade its characteristic bitter taste. The hard white or light yellow wood is used in woodworking and for baseball bats in Cuba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus aurantium"@en .

aat:300375411 a skos:Concept ;
    skos:definition "Essential oil obtained from the rind of the orange and used in perfume, as flavoring, in herbal medicine, cleaning products, insecticide, and as an appetite suppressant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange oil"@en .

aat:300375412 a skos:Concept ;
    skos:definition "General term referring to any of the following: aggregate fruit, in which one flower contains several separate ovaries, which merge during development; multiple fruit, in which several flowers, each with an ovary, develop into small fruits that are clustered or fused together into a larger fruit; or a siimple fruit formed from a compound ovary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compound fruits"@en .

aat:300375413 a skos:Concept ;
    skos:definition "According to the botanical definition, fruits in which the edible part is not generated by the ovary, such as the strawberry. According to the botanical definition, fruits in which the edible part is not generated by the ovary, such as the strawberry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accessory fruits"@en .

aat:300375414 a skos:Concept ;
    skos:definition "Fruits of any species of the genus Fragaria. It is a soft bag-shaped receptacle, scarlet to yellowish in color, full of juicy acid pulp, and dotted over with small yellow seed-like achenes. The wild or wood strawberry is smaller than the cultivated kinds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strawberries"@en .

aat:300375415 a skos:Concept ;
    skos:definition "The edible, soft, berry-like fruits of the plant Rubus idaeus and its cultivated varieties, being a compound fruit consisting of many small, typically dark red, drupelets on a conical receptacle from which the ripe fruit is easily detached. The term is also sometimes applied to varous other fruits of the genus Rubus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raspberries"@en .

aat:300375416 a skos:Concept ;
    skos:definition "The edible, soft, berry-like fruit of the plant Rubus fruticosus and its varieties. It is botanically a compound fruit consisting of many small, typically dark purple, drupelets on a conical receptacle from which the ripe fruit is easily detached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blackberry"@en .

aat:300375417 a skos:Concept ;
    skos:definition "Fruits of several species of the genus Vaccinium, especially V. corymbosum of North America. The dark blue, sweet, edible fruits are cultivated in several U.S. states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blueberries"@en .

aat:300375418 a skos:Concept ;
    skos:definition "Small, roundish, dark red, very acid berry of two or more species of the genus Vaccinium, particularly V. oxycoccos, native to Britain, Northern Europe, Siberia, and North America, growing in turfy bogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cranberry"@en .

aat:300375419 a skos:Concept ;
    skos:definition "Genus containing around 450 species of shrubs or dwarf shrubs,, many of which produce edible berries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vaccinium"@en .

aat:300375420 a skos:Concept ;
    skos:definition "Species of medium-sized deciduous shrub native to moist acidic soils of eastern North America, from Nova Scotia and Ontario south to Alabama, and west to Wisconsin. It is commercially grown elsewhere. It has leaves that turn bright red in the Autumn, bell-shaped white flowers, and a dark blue edible berry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vaccinium corymbosum"@en .

aat:300375421 a skos:Concept ;
    skos:definition "Species of creeping shrub found in marshy land in northern North America, Asia, and in northern and central Europe. The leaves are evergreen, oval or elliptical. Its round, crimson berries are about the size of currants and are often spotted; they have an acid taste. Red dye may be made from the berries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vaccinium oxycoccos"@en .

aat:300375422 a skos:Concept ;
    skos:definition "Species of shrub found wild in the greater part of the northeastern United States. It is more robust than is the small cranberry (V. oxycoccus), having larger, round, oblong, or pear-shaped berries that vary in colour from pink to very dark red or mottled red and white. It is cultivated on acid soils of peat or vegetable mold with a surface layer of sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vaccinium macrocarpon"@en .

aat:300375423 a skos:Concept ;
    skos:definition "Genus containing around 20 species of of low-growing, flowering, fruit plants native to the temperate regions of the Northern Hemisphere but widely cultivated in the Southern Hemisphere as well. The plant has a fibrous root system and a crown from which arise basal leaves. The leaves are compound, with three leaflets, saw-toothed and hairy. The flowers, generally white, rarely reddish, are borne in small clusters on slender stalks arising, like the surface-creeping stems, from the axils of the leaves. The fruit is not a true berry, but rather a fleshy, edible receptacle for tiny seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fragaria"@en .

aat:300375424 a skos:Concept ;
    skos:definition "Large, complex genus of several hundred species of flowering shrubs, many of which produce edible fruit. The fruit is not a true berry; botanically it is termed an aggregate fruit, composed of small drupelets. The genus is believed to have existed as early as 36 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubus"@en .

aat:300375425 a skos:Concept ;
    skos:definition "Red-fruited species of shrub native to Europe and northern Asia and commonly cultivated in other temperate regions. The fruit is not a true berry; botanically it is termed an aggregate fruit, composed of small drupelets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubus idaeus"@en .

aat:300375426 a skos:Concept ;
    skos:definition "Red-fruited species of shrub widely distributed in North America. In many classifications, treated as a subspecies of Rubus idaeus. The fruit is not a true berry; botanically it is termed an aggregate fruit, composed of small drupelets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubus strigosus"@en .

aat:300375427 a skos:Concept ;
    skos:definition "Black- or purple-fruited species of shrub. The fruit is not a true berry; botanically it is termed an aggregate fruit, composed of small drupelets. The leaves and young shoots of the blackberry bush produce a dark brown or black dye that is rich in tannins. The roots give orange and greenish tones. The blackberry fruit, when ripe, makes red (no mordant), green (chromium mordant) or purple (aluminum or tin mordants) dyes. The addition of vinegar to the dye bath strengthens the purple tones. The primary colorants in the berries are anthocyanins, such as cyanidin, malvidin, and chrysanthemin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubus fruticosus"@en .

aat:300375428 a skos:Concept ;
    skos:definition "Genus containing one living species of coconut palm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cocos"@en .

aat:300375429 a skos:Concept ;
    skos:definition "Species of tropical tree having a slender, leaning, ringed trunk up to 25 m (80 feet) in height, a crown of large, featherlike leaves, and producing an edible fruit; the species probably originated somewhere in Indo-Malaya. Coconut fruits float readily and have been dispersed widely by ocean currents and by humans throughout the tropics. Marco Polo was among the first Europeans to describe coconuts. Today it is among the most important crops of the tropics. Mature fruits are drupes, not nuts: they are hard, ovoid in shape, and contain a small embryo with abundant endosperm, which comprises the edible meat and liquid that are both edible. In addition, oil derived from it is used in cooking, soaps, and cosmetics. Husks and leaves can be used as material to make shelter and furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cocos nucifera"@en .

aat:300375430 a skos:Concept ;
    skos:definition "Genus containing around 70 species of trees, nearly half of which produce edible fruit; native to subtropical and tropical Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mangifera"@en .

aat:300375431 a skos:Concept ;
    skos:definition "Species of large tree indigenous to eastern Asia, Myanmar (Burma), and Assam state of India. It appears to have been domesticated about 2,000 BCE in India, then brought to East Asia in the 5th century BCE. It produces a sweet orange-colored drupe fruit, one of the most important and widely cultivated fruits of the tropical world. The fruit varies greatly depending upon the variety, from those the size of plums to others weighing 4 to 5 pounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mangifera indica"@en .

aat:300375432 a skos:Concept ;
    skos:definition "Genus containing about 40 species of small trees and shrubs native to warm temperate and tropical regions of southern Europe, Africa, southern Asia and Australasia, having drupe fruit that is edible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Olea"@en .

aat:300375433 a skos:Concept ;
    skos:definition "Genus containing around 250 species of shrubs and small trees, native to temperate and subtropical zones. All sumacs have a milky or resinous sap, which in a few species can cause a contact dermatitis. The sap is used for tannins, dyes, medicines, the leaves for smoking, the fruits for beverages and ground as spice in Middle Eastern cuisine, and the trees as ornamentals, soil binders, and cover plants valued for brilliant Fall color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhus"@en .

aat:300375434 a skos:Concept ;
    skos:definition "Species of large tree native to Hawaii used for carvings, dugout canoes, early surfboards, and other items; tannin extracted from the bark is used for processing leather. Few koa forests remain, because the trees have been overharvested for their attractive wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acacia koa"@en .

aat:300375435 a skos:Concept ;
    skos:definition "Species of tree found in moist areas of the eastern U.S. from Maine south to the Gulf Coast and westward to Oklahoma. Its wood is light and soft, but tough. The black gum is sometimes grown as an ornamental, prized for brilliant scarlet autumnal foliage. The bark dye has good washfastness and fair lightfastness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyssa sylvatica"@en .

aat:300375436 a skos:Concept ;
    skos:definition "Species of uncommon North American tree, producing wood, edible fruits, and a fine honey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyssa ogeche"@en .

aat:300375437 a skos:Concept ;
    skos:definition "Species of tree found in swamps along the East coast and in the deep south of the U.S.; used for crates, furniture, and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nyssa biflora"@en .

aat:300375438 a skos:Concept ;
    skos:definition "Species of small tree native to Iran, particularly the Alborz mountains in the north. Its flowers, produced before the leaves, have drooping stamens, lack petals, and have brown, leaflike bracts. Cultivated for autumn leaf color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parrotia persica"@en .

aat:300375439 a skos:Concept ;
    skos:definition "Family of flowering plants including 27 genera and around 85 species of shrubs and small trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamamelidaceae"@en .

aat:300375440 a skos:Concept ;
    skos:definition "Genus containing one living species of small tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parrotia"@en .

aat:300375441 a skos:Concept ;
    skos:definition "Species of thorny tree native to regions in North and South America, Africa, and Asia. It produces a high quality wood. The long thorns were once used as nails. Currently, honey locusts are mainly grown as an ornamental tree; its slow growth minimizes potential for commercial use. It is not a significant honey plant; rather the common names derive from the sweet tasting pulp of the legume fruit, which was used for food by Native Americans and is fermented to make beer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gleditsia triacanthos"@en .

aat:300375442 a skos:Concept ;
    skos:definition "Genus containing around 12 species of locust trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gleditsia"@en .

aat:300375443 a skos:Concept ;
    skos:definition "Species of tall tree native to Australia and New Zealand, but naturalized in Chile, California, the Mediterranean, and other places. It is used for its wood, for tannins extracted from the bark, and as an ornamental."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acacia dealbata"@en .

aat:300375444 a skos:Concept ;
    skos:definition "Species of shrub or small tree native to Australia, best known as a souce of the psychoactive alkaloids phenylethylamine and beta-methylphenethylamine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acacia prominens"@en .

aat:300375446 a skos:Concept ;
    skos:definition "Wood of the species Quercus virginiana, native to the southeastern and gulf area of the United States into Mexico, and Cuba. It is the hardest of all American oaks. It is used in the construction of ships, wagons, and farm implements. Favored for shipbuilding because of its tolerance for salt water and its resistance to decay, it was famously used to build the USS Constitution sailing ship, nicknamed Old Ironsides, in the 1790s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "southern live oak"@en .

aat:300375447 a skos:Concept ;
    skos:definition "Species of evergreen tree native to the southeastern and gulf area of the United States into Mexico, and Cuba, having a coarse, reddish brown bark and reaching 50 feet in height. Valued for its hard, durable wood, formerly used in shipbuilding; today most often used for shade trees. It is readily hybridized, and thus confusion regarding varieties and certain common names has arisen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus virginiana"@en .

aat:300375448 a skos:Concept ;
    skos:definition "Species of oak native to the Pacific coastal regions of North America from California to the Baja peninsula; most often shrubby, but may reach heights of 20 m. Distinguished by holly-like leaves; may live to 250 years in age. The hard wood has been used for shipbuilding in the past, but now the tree is primarily used as an ornamental and for shade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus agrifolia"@en .

aat:300375449 a skos:Concept ;
    skos:definition "Species of tall oak native to eastern North America in Canada and the U.S., found in a variety of habitats, including stream valleys and low-lying fields, thus giving it the common name. It has bark that is gray and scaly with irregular ridges and fissures and a bowl-shaped cap of leaves. It grows rapidly and can live to 350 years of age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus bicolor"@en .

aat:300375450 a skos:Concept ;
    skos:definition "Species of tall, pyramidal tree native primarily to bottomlands and moist uplands of eastern North America, but found as far west as Oklahoma and Ontario, Canada. It is distinguished by having clusters of short, spiky twigs and leaves with bristle-tipped lobes, thus accounting for the common name \"pin oak.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus palustris"@en .

aat:300375451 a skos:Concept ;
    skos:definition "Hard, close-grained, durable wood of the species Quercus stellata, native to sandy soils of the central and southern United States. It is tough and rot-resistant, used for fence posts, rough construction, and as a fuel for barbequing meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus stellata"@en .

aat:300375452 a skos:Concept ;
    skos:definition "Group of oaks native to North, Central, and South America distinguished by having long, acorns that mature in 18 months, are very bitter, and the inside of the acorn shell is woolly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red oak"@en .

aat:300375453 a skos:Concept ;
    skos:definition "General term for types of oaks native to Europe, Asia, north Africa, and North America, characterized by having a short acorn that matures in six months, is sweet or slightly bitter, ahd the inside of the acorn shell hairless."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "white oak"@en .

aat:300375454 a skos:Concept ;
    skos:definition "Species of oak native to the eastern United States, reaching 45 m (50 feet) in height, having pale-gray, shallowly fissured, scaly bark, and glossy, bright green leaves that narrow toward the base and turn wine red in autumn. Specimens are known to have lived for up to 600 years. It is an important timber tree, having light brown, coarse-grained, strong wood, used for millwork and flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus alba"@en .

aat:300375455 a skos:Concept ;
    skos:definition "Species of oak native to northeastern United States and southeast Canada, but found north in Nova Scotia, south to Georgia, and west to the Great Lakes. It is used for timber but often cultivated as an ornamental; it grows rapidly into a round-headed, wide-spreading tree about 25 m (80 feet) in height, with leaves that turn red-orange in autumn and persist into winter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus rubra"@en .

aat:300375456 a skos:Concept ;
    skos:definition "Pale reddish brown wood of the species Quercus rubra, having sapwood that is dark, heavy, hard, strong, and coarse-grained. It cracks in drying, but is treated and used for furniture, construction, and the interior of houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "northern red oak"@en .

aat:300375457 a skos:Concept ;
    skos:definition "Species of medium-sized oak tree with a round crown native to the southeastern United States, but found from New York to Florida, Missouri, and Texas. It is a timber tree, and the bark is a source of tannin. It may occasionally form hybrids with other red oaks in the region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus falcata"@en .

aat:300375458 a skos:Concept ;
    skos:definition "Species of large oak native to the Atlantic Coastal Plain of the U.S., in the Mississippi and Ohio river valleys. It is also found in Michigan, Pennsylvania, Maryland, and Ontario, Canada. It is used for shade, for timber, and the acorns and leaves are food for various birds and mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus shumardii"@en .

aat:300375459 a skos:Concept ;
    skos:definition "Species of medium to large tree native to the central and eastern parts of North America. It is used for timber and as an ornamental, valued for its colorful autumn foliage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus coccinea"@en .

aat:300375460 a skos:Concept ;
    skos:definition "Species of oak tree native to the southern Mediterranean, Morocco, and Asia Minor. The tannin extracted from the large acorn cups was used in the 18th century for tanning leather and for dyeing. The acorns, themselves called \"valonia,\" are edible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus macrolepis"@en .

aat:300375461 a skos:Concept ;
    skos:definition "Species of medium-sized oak tree native to the western coast of North America, from British Columbia to southern California. Particularly common in the Willamette Valley, it hosts gall wasps and mistletoe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus garryana"@en .

aat:300375462 a skos:Concept ;
    skos:definition "Species of tall, fast-growing tree native to cooler areas of North America. The name refers to the tendency of leaves to tremble or quake in even a slight breeze due to their flattened petioles. It is most easily distinguished from a similar European species, P. tremula, by the shape of its leaves, which have more pointed tips, and by growing via root suckers: it propagates itself primarily through root sprouts, and extensive clonal colonies are common. The leaves are food for various insects. A substance in the bark was extracted by Native Americans and the pioneers of the American West as a quinine substitute. The soft, weak wood is used as paper pulp and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus tremuloides"@en .

aat:300375463 a skos:Concept ;
    skos:definition "Species of tree native to the northeastern United States, growing to 18 metres (59 feet) in height and having relatively large somewhat rounded, coarse-toothed leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus grandidentata"@en .

aat:300375464 a skos:Concept ;
    skos:definition "Species of tree native to Europe but introduced to North America. It has has deltoid leaves with woolly grayish undersides, accounting for its popular name. It is a close relative of the white poplar, P. alba. In many classifications, it is considered a hybrid of P. alba and the European aspen, P. tremula, having characteristics intermediate between the two."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus canescens"@en .

aat:300375465 a skos:Concept ;
    skos:definition "Species of medium-sized tree with broad, rounded crown, native from Spain and Morocco through central Europe and central Asia. It has been widely planted in the United States and elsewhere. White poplar was first introduced to North America in 1748, and is now found in 43 contiguous states, even considered weedy or invasive in some areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus alba"@en .

aat:300375466 a skos:Concept ;
    skos:definition "Species of large tree that grows in swampy soils in the northern U.S. and Canada. It is often cultivated as a shade tree, attractive for fragrant buds thickly coated with an aromatic resin, which is also used to make cough syrups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus balsamifera"@en .

aat:300375467 a skos:Concept ;
    skos:definition "Species of very large deciduous trees native to northwestern North America; planted elsewhere as an ornamental. In some classifications, a subspecies of Populus balsamifera. Noted as the first tree species for which the genome was sequenced. Used for timber and for extracts from the fragrant buds for use in perfume, medicines, and cosmetics. Native Americans of the Pacific Northwest used the inner bark as food and medicine, the anti-inflammatory, salicin, content making it useful for treating wounds and other purposes. The wood, roots, and bark were used for firewood, canoes, rope making, fish traps, baskets, and structures. The gum-like sap was used as glue and waterproofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus trichocarpa"@en .

aat:300375468 a skos:Concept ;
    skos:definition "Genus containing around 450 shrubs, undershrubs, climbers, or trees native to tropical and subtropical areas throughout both hemispheres. They are so named from the movements of the leaves in certain species that mimic animal sensibility, including rapidly moving when touched. Certain plants called \"mimosa\" were formerly assigned to this genus, including Albizia julibrissin (silk tree) and Acacia dealbata (silver wattle)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mimosa"@en .

aat:300375469 a skos:Concept ;
    skos:definition "Genus containing 6 to 40 species (depending upon the classification) of perennial grass cultivated for its juice in tropical regions. Sugar cane products include table sugar, falernum, molasses, rum, cachaca, bagasse, and ethanol. Most present-day commercial canes are hybrids of the species Saccharum officinarum, which was developed from a wild cane species, Saccharum robustom, and cultivated by native peoples of southern Pacific Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saccharum"@en .

aat:300375470 a skos:Concept ;
    skos:definition "Genus containing around 50 species of shrubs native to most subtropical areas of the world, long cultivated for fiber and oil. Many varieties of cotton have been developed by selective breeding and hybridisation of various species. Cotton cloth was made as early as 5000 BCE in India; by 3000 BCE, cotton fabrics were being woven in Egypt, China, and Peru. Cultivation of cotton became widespread in Europe in the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gossypium"@en .

aat:300375471 a skos:Concept ;
    skos:definition "Genus containing one or two species of grass native to the Mediterranean region. These species had traditionally been included in genus Stipa because of their similar elongated florets and persistent, long awns. It is now agreed that they differ from Stipa in other characteristics and in having a different chromosome base number."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macrochloa"@en .

aat:300375472 a skos:Concept ;
    skos:definition "Species of tough, coarse, spiky grass native to southern Spain and northern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macrochloa tenacissima"@en .

aat:300375473 a skos:Concept ;
    skos:definition "Genus containing around 12 species of tall, reedy marsh plants that bear brown, furry, fruiting spikes. They grow in a variety of wetland habitats, primarily distributed throughout the Northern Hemisphere. The leaves and fiber fluff are used for a variety of purposes. Several species are edible to humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Typha"@en .

aat:300375475 a skos:Concept ;
    skos:definition "Genus containing 120 to 300 species (depending upon the classification) of annual or perennial aquatic, grasslike species growing in ponds, marshes, and lakes. They bear solitary or small clustered spikes. Their stems are often used to weave strong mats, baskets, and chair seats. Bulrushes may act as a filter, absorbing poisonous metals and toxic microorganisms, thus helping to reduce water pollution. The taxonomy of the genus is complex and currently under review, which will likely result in some species being moved to other genera. In English translations of the Bible, the term \"bulrush\" is mistakenly used to refer to the papyrus plant, Cyperus papyrus. In Britain, the term \"bulrush\" is sometimes used to refer to species of genus Typha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scirpus"@en .

aat:300375476 a skos:Concept ;
    skos:definition "Family containing around 110 genera and 5,500 species of plants, many growing in wetlands; they superficially resemble grasses or rushes by stems that are triangular in cross-sections and having leaves that are spirally arranged in three ranks (while grasses have alternate leaves forming two ranks)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyperaceae"@en .

aat:300375477 a skos:Concept ;
    skos:definition "Family consisting of one or two genera containing around 15 perennial species native to wet habitats. The taxonomy under this family is under debate and is likely to change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Typhaceae"@en .

aat:300375478 a skos:Concept ;
    skos:definition "General term for many species of tall wetland grasses of various genera in the order Poales, including the families Poaceae, Cyperaceae, Sparganiaceae, Typhaceae, and Restionaceae. Some of the common characteristics of reeds are that they grow in water or marshy ground, often in large stands, and have tall, stiff stems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reed"@en .

aat:300375479 a skos:Concept ;
    skos:definition "Genus containing around 3 species of coarse, perennial grasses around one meter (3 feet) in height and native to sandy coasts of temperate Europe, North America, and northern Africa. The utility of these species in stabilizing beaches and forming sand dunes has resulted in the grasses being planted in many beach areas outside of their normal range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ammophila"@en .

aat:300375480 a skos:Concept ;
    skos:definition "Genus containing 1 to 4 species (depending upon the classification) of large perennial grasses found in wetlands throughout temperate and tropical regions of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phragmites"@en .

aat:300375481 a skos:Concept ;
    skos:definition "Species of broad-leafed grass, about 1.5 to 5 m (5 to 16.5 feet) in height, with feathery flower clusters and stiff, smooth stems, occurring along the margins of lakes, fens, marshes, and streams from the Arctic to the tropics. It is one of the most widely distributed plants in the world, with fruits borne in parachute-like containers that are carried by the wind. It is also one of the most successful plants in dominating appropriate habitats due to rhizomes that rapidly infest moist-to-saturated soils of swamps, ponds, streams, and banks to the eventual exclusion of almost all other plants. Dried stems have been used for millennia as thatching and construction material, in basketry, for arrows, pens, and musical instruments. They also are harvested for their cellulose content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phragmites australis"@en .

aat:300375482 a skos:Concept ;
    skos:definition "Genus containing around 80 species of sedges with a cosmopolitan distribution. This genus is closely related to genus Scirpus, and some species here were formerly included in Scirpus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schoenoplectus"@en .

aat:300375483 a skos:Concept ;
    skos:definition "Species of water plant found in marshy areas from southern and western North America to South America and on Pacific islands. It has tall, thin, dark green stems and woolly brown flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schoenoplectus californicus"@en .

aat:300375484 a skos:Concept ;
    skos:definition "Genus containing around 2,000 species of perennial grasses found often in wetlands around the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carex"@en .

aat:300375485 a skos:Concept ;
    skos:definition "Genus containing around 650 species of annual or perennial plants distributed throughout all continents, often in wetlands. The stems are circular or triangular in cross-section, usually leafless for most of their length with the slender grass-like leaves at the base of the plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cyperus"@en .

aat:300375486 a skos:Concept ;
    skos:definition "Species of perennial water plant found in wetlands in Canada and the United States, including marshes and lakes. It has cylindrical stems growing to 2 m in height. The leaves are sheathed around the base of the stem; the flower inflorescence is a panicle of cone-shaped spikelets on thin branches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schoenoplectus heterochaetus"@en .

aat:300375487 a skos:Concept ;
    skos:definition "Species of giant sedge native to freshwater marshes all over North America. It has thick, rounded green stems growing to 3 m (10 feet) in height, with long, grasslike leaves. The plants play an important ecological role at shorelines, buffering against wind and water forces, thereby allowing the establishment of other types of plants and reducing erosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schoenoplectus acutus"@en .

aat:300375488 a skos:Concept ;
    skos:definition "Species of grass native to Europe but naturalized elsewhere, often becoming an invasive weed spreading by long, white rhizomes. The foliage is used as forage for grazing mammals and as food by caterpillars; the seeds are eaten by finches, buntings, and other grassland birds. It has been used in herbal medicine since the Classical Greek period. It is used for medicinal purposes: it is believed that sick dogs will dig up and eat the root; it has antiseptic properties; mediaeval herbalists used it to treat urinary tract disorders and water retention. It also has antiseptic properties. Dried rhizomes have been used as incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elymus repens"@en .

aat:300375489 a skos:Concept ;
    skos:definition "Genus containing around 50 species of perennial forage grasses native to temperate and cool parts of the Northern Hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elymus"@en .

aat:300375490 a skos:Concept ;
    skos:definition "Genus containing around 12 species of grass growing in sandy substrates or in estuaries submerged or partially floating in saltwater environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zostera"@en .

aat:300375491 a skos:Concept ;
    skos:definition "Order of flowering plants containing 14 families, 166 genera, and about 4,500 species aquatic plants that grow submersed or partially exposed to the air in marshes and other freshwater and marine habitats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alismatales"@en .

aat:300375492 a skos:Concept ;
    skos:definition "Family containing 2 genera of of marine perennial flowering plants found in temperate and subtropical coastal waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zosteraceae"@en .

aat:300375493 a skos:Concept ;
    skos:definition "Genus containing around 10 species of grass native to temperate and tropical freshwater environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vallisneria"@en .

aat:300375494 a skos:Concept ;
    skos:definition "Family containing 18 genera of submerged and emergent, freshwater and saltwater aquatic herbs, mainly of warmer regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydrocharitaceae"@en .

aat:300375495 a skos:Concept ;
    skos:definition "Genus containing species that are distinguished by cylindrical stalks or hollow, stemlike leaves. They are found in temperate regions and particularly in moist or shady locations. Rushes are widely used for weaving into chair bottoms, mats, and basketwork; the pith also serves as wicks in open oil lamps and for tallow candles (rushlights)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juncus"@en .

aat:300375496 a skos:Concept ;
    skos:definition "Order containing two families of aquatic grasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juncales"@en .

aat:300375497 a skos:Concept ;
    skos:definition "Family containg 8 genera and about 400 species of slow-growing, rhizomatous, herbaceous plants that may superficially resemble grasses. Placed in order Poales in some classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Juncaceae"@en .

aat:300375498 a skos:Concept ;
    skos:definition "Genus containing around 20 species of aquatic plants found in shallow marshes, ponds, and streams, ranging from temperate to arctic regions. The plants provide food and cover for wildlife and waterfowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sparganium"@en .

aat:300375499 a skos:Concept ;
    skos:definition "Species of giant tussock-forming grass grass native to the Pampas and Patagonia of South America, but grown in Europe, North America, Australia, and elsewhere as a lawn ornamental and for dried flower arrangements. Grows up to 3 m (10 feet) in height; female plants bear silvery, plumelike flower clusters reaching 30 to 90 cm (1 to 3 feet) in height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cortaderia selloana"@en .

aat:300375500 a skos:Concept ;
    skos:definition "Genus containing around 25 species of tall, reedlike Central and South American and New Zealand grasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cortaderia"@en .

aat:300375501 a skos:Concept ;
    skos:definition "Genus containing over 70 species of flowering plants native to North and South America, including the species N. tabacum that is cultivated on a large scale. Tobacco is smoked or chewed for its sedative and narcotic effects; it was used ceremonially by Native American cultures by around 3000 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nicotiana"@en .

aat:300375502 a skos:Concept ;
    skos:definition "Family containing 102 genera and nearly 2,500 species of herbs, shrubs, trees, and vines, many of which are used by humans for food and medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solanaceae"@en .

aat:300375503 a skos:Concept ;
    skos:definition "Order containing 5 families with 165 genera and more than 4,000 species of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Solanales"@en .

aat:300375504 a skos:Concept ;
    skos:definition "Species of herbaceous annual, native to the area of the eastern Mediterranean and India; probably first cultivated in the Fertile Crescent. The plant grows to 4 m in height, bears blue flowers succeeded by pods that contain the seeds. It is cultivated both for its fiber, from which linen yarn and fabric are made, and for its seed, the source of linseed oil, which is an edible oil used as a nutritional supplement and as an ingredient in painting and many wood finishing products. Evidence of its use has been found in the prehistoric sites in Georgia and Switzerland. Fine linen fabrics are common in ancient Egyptian tombs. It was brought to Gaul and Britain by Phoenician traders; the Romans introduced linen manufacture throughout their empire. By the 17th century, linen manufacturing was an important industry in Western Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linum usitatissimum"@en .

aat:300375505 a skos:Concept ;
    skos:definition "Genus containing around 180 species of temperate to subtropical flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linum"@en .

aat:300375506 a skos:Concept ;
    skos:definition "Family comprising about 14 genera and 300 species of herbaceous plants and shrubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linaceae"@en .

aat:300375507 a skos:Concept ;
    skos:definition "Japanese paper produced from the short bast (inner bark) fibers of the species Wikstroemia canescens, native to the mountainous regions of Asia. It is first known from ca. 850 CE. Gampi is a fine, fibrous paper made on a papermaking screen that is covered with a waterproof silk cloth, resulting in a silk-like, woven appearance. While gampi is transparent, smooth, and strong, it has poor dimensional stability, used as tracing paper and as interleaves for beating gold, but not for linings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gampi"@en .

aat:300375508 a skos:Concept ;
    skos:definition "Family of flowering plants containing around 50 genera and 900 species, varying according to different classifications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thymelaeaceae"@en .

aat:300375509 a skos:Concept ;
    skos:definition "Genus containing around 70 species of flowering plants. In some classifications, species here are part of genus Daphne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wikstroemia"@en .

aat:300375510 a skos:Concept ;
    skos:definition "Species of annual herb reaching 5 m (16 feet) in height, native to temperate zones of central Asia, but widely cultivated elsewhere. Cultivation for fiber is recorded in China as early as 2800 BCE; it was cultivated throughout Europe by the Middle Ages. It was planted in South and North America by the 16th and 17th centuries. Fibers from the stems are used for making cloth and other products, seed is used as a caged-bird feed, and the flowers, leaves, stems, and seeds, which contain psychoactive chemical compounds, are consumed by humans for recreational, medicinal, and spiritual purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cannabis sativa"@en .

aat:300375511 a skos:Concept ;
    skos:definition "Genus of flowering plant comprising one species, C. sativa, a stout, aromatic, erect annual herb that originated in Central Asia and is now cultivated widely in the North Temperate Zone. A tall, canelike variety is raised for the production of hemp fiber, while the female plant of a short, branchier variety is prized as the more abundant source of marijuana. Some classifications include 3 species in this genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cannabis"@en .

aat:300375512 a skos:Concept ;
    skos:definition "Species of fast growing herbaceous annual plant, with stalks growing to 5.5 m (18 feet) in height. It is probably native to southern Asia, though its exact natural origin is unknown. It is widely dispersed now."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hibiscus cannabinus"@en .

aat:300375513 a skos:Concept ;
    skos:definition "Species of plant native to the Philippines, but cultivated in Central America, growing to 5 m (15 feet) in height. Fiber from the plant is used for cordage and many other purposes. Despite its common name, it is not related to hemp. The abaca plant is closely related to and resembles the banana plant, M. sapientum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Musa textilis"@en .

aat:300375514 a skos:Concept ;
    skos:definition "Species of agave plant native to Mexico, where it has been a source of textile fiber since pre-Columbian times. It was introduced to Cuba in the 19th century, becoming the country's chief fiber crop by the 1920s. In addition to fiber, it is used to make a traditional Mexican alcoholic drink, licor del henequén. The plant a sterile hybrid; the ovaries never produce seeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agave fourcroydes"@en .

aat:300375515 a skos:Concept ;
    skos:definition "Species. The fiber has been used since pre-Columbian times; the Aztecs are known to have made clothing from it. From the late 1930s sisal has been cultivated commercially in Central and South America as well as in Africa. It is a strong, stiff fiber with a pale cream color. Sisal is typically dyed bright colors with direct or acid dyes. Sisal is used for cordage, ropes, sacks, brushes, upholstery padding, rugs, matting, handbags, hats, and in papermaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agave sisalana"@en .

aat:300375516 a skos:Concept ;
    skos:definition "Genus containing 40 to 100 species of flowering plants, depending upon the classification. Most are tall, often annual, and native to tropical and subtropical regions throughout the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corchorus"@en .

aat:300375517 a skos:Concept ;
    skos:definition "Species of herbaceous plant found in India, Africa, and the Middle East. It is used for fiber, and also for the leaves as food, an ingredient in a sticky Middle Eastern herbal dish, molokhiya. The Biblical Book of Job mentions this food. The leaves and young shoots are eaten as a vegetable in Europe. C. olitorius fiber is softer, silkier, and stronger than white jute, C. capsularis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corchorus olitorius"@en .

aat:300375518 a skos:Concept ;
    skos:definition "Species of herbaceous plant found in Asia. Jute probably originated in the Mediterranean region and was taken to India and southeast Asia where it flourished. It is used for its fiber, which has long been used for rope and cloth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corchorus capsularis"@en .

aat:300375519 a skos:Concept ;
    skos:definition "General term for Japanese lining papers made from the inner bark of mulberry trees of the genus Broussonetia. Kozo papers are often used for backing when Asian scrolls are relined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kozo"@en .

aat:300375520 a skos:Concept ;
    skos:definition "Genus containing 3 or 4 species of small to medium sized trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Broussonetia"@en .

aat:300375521 a skos:Concept ;
    skos:definition "Species of large tropical tree native to the New World and Africa, was transported to Asia. It is now grown primarily in Java, Africa, Brazil, India, and Central America. The soft fibers covering the seeds are used for stuffing. Seeds may be processed to obtain oil for making soap, and the residue is used as fertilizer and cattle feed. The wood does not hold screws or nails well, but the timber is used for paper and other products. Local peoples have long used kapok logs for carving into canoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceiba pentandra"@en .

aat:300375522 a skos:Concept ;
    skos:definition "Genus containing around 20 species of large trees found in tropical areas of Mexico, Central America, South America, the Bahamas, Belize, the Caribbean, West Africa, and Southeast Asia. Formerly was placed in the now defunct family Bombacaceae; now generally placed in family Malvales, subfamily Bombacoideae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceiba"@en .

aat:300375523 a skos:Concept ;
    skos:definition "Species of bush native to China and cultivated in Japan for fiber, used for making paper. It is also known for bearing clusters of fragrant yellow flowers. The species was published twice in the same year, as E. papyrifera (Siebold & Zucc.) and E. chrysantha, but in the absence of evidence supporting earlier publication, the name E. chrysantha more often has priority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edgeworthia chrysantha"@en .

aat:300375524 a skos:Concept ;
    skos:definition "Genus containing 7 to 9 species of flowering shrubs native to Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Edgeworthia"@en .

aat:300375525 a skos:Concept ;
    skos:definition "Genus containing around 20 species of palm trees native primarily to Africa, with one species in Central and South America. They are distinguished by their compound pinnate leaves, the longest in the plant kingdom (some reaching 25 m in length)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raphia"@en .

aat:300375526 a skos:Concept ;
    skos:definition "Species of herbaceous perennial native to eastern Asia but cultivated elsewhere. Ramie is one of the oldest fiber crops. It has been used for fabric and other products for around 6,000 years; it is found in mummy cloths in China and ancient Egypt. It exists in several varieties, the fibers varying in color from white to green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boehmeria nivea"@en .

aat:300375527 a skos:Concept ;
    skos:definition "Genus containing around 100 species of herbaceous perennials, shrubs and small trees native to Asia and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boehmeria"@en .

aat:300375528 a skos:Concept ;
    skos:definition "Species of grass native to northern Africa, but cultivated widely for its edible grain. Sorghum has been cultivated since ancient times for its grain (couscous), as a source of syrup (molasses). It is also made into alcoholic beverages, as well as for biofuels. The tall, stiff, pithy stems are used for brooms, baskets, and construction. A reddish purple dye, guineense, is extracted from the leaves and stems, used for dyeing Niger goatskins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sorghum bicolor"@en .

aat:300375529 a skos:Concept ;
    skos:definition "Genus containing around 25 species of coarse grasses, many with with reddish to purplish-black panicles, growing to 2 m in height. These grasses are cultivated for food and forage worldwide, but some species have escaped cultivation and are troublesome agricultural weeds in temperate to tropical regions throughout the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sorghum"@en .

aat:300375530 a skos:Concept ;
    skos:definition "Refers to a white lead-glazed 'faïence fine' introduced by Jacques Chambrette at Lunéville in 1748 and there used unglazed for biscuit figures and groups and as a pipe clay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terre de Lorraine"@en .

aat:300375531 a skos:Concept ;
    skos:definition "Species of very tall fan palm native to Southeast Asia and the Philippines. It is cultivated in southeast Asia north to southern China. It is one of the largest palms in the world with specimens reaching 25 m in height and stems up to 1.3 m in diameter. It may live as long as 75 years before flowering, then fruiting just one time and dying. It has large palmate leaves measuring up to 5 m across, used for making fans, umbrellas, and thatching. Strips of leaves have historically been used for manuscripts, inscribed with iron styluses. Young stalks are used for weaving. The sap is tapped to make palm wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corypha umbraculifera"@en .

aat:300375532 a skos:Concept ;
    skos:definition "Genus containing 6 or 7 species of fan palms native to India, Malaysia, New Guinea, Indonesia, the Philippines, and northeastern Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corypha"@en .

aat:300375533 a skos:Concept ;
    skos:definition "Species of annual plant widely grown for its nutritious seeds, used in a variety of ways worldwide. Evidence of humans eating chick-peas dates to 7,000 BCE. They were one of the first plants cultivated, known from Neolithic Jericho. They have historically been used medicinally, thought to increase sperm and milk, to provoke menstruation, and to treat kidney stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cicer arietinum"@en .

aat:300375534 a skos:Concept ;
    skos:definition "Genus containing 43 species of annual and perennial herbs native to Middle East and Asia. It is best known for the widely cultivated member, C. arietinum, chickpea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cicer"@en .

aat:300375535 a skos:Concept ;
    skos:definition "Genus containing over 90 species of shrubs and small trees native to subtropical Africa and southern Asia. Seeds of several species are the source of a popular beverage. It was first cultivated in southern Arabia in the 15th century, then spread to Indonesia in the 17th century. By the 18th century, coffee plants were also being grown in Central and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coffea"@en .

aat:300375536 a skos:Concept ;
    skos:definition "Species of medium sized evergreen oak native to southwest Europe and northwest Africa, cultivated in Spain, Portugal, France, Italy, Morocco, Tunisia, and Algeria. The tree has a thick, insulating bark that helps it to recover quickly after forest fire; branches, having been protected from the fire by cork, quickly resprout and recompose the tree canopy, while other trees regrow from shoots or seeds. The lightweight, buoyant outer bark of the cork oak is used for stopping bottles, flooring, and many other purposes commercially. No trees are cut down during the harvesting process: the outer bark is stripped about every 10 years, and a new layer of cork grows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quercus suber"@en .

aat:300375537 a skos:Concept ;
    skos:definition "Species of tree native to the eastern Mediterranean region and cultivated elsewhere. It is highly drought resistant. The tree reaches about 15 m (50 feet) in height, has glossy evergreen leaves, and produces long leathery pods that contain up to 15 hard brown seeds embedded in a sweet, edible pulp. The ripened pods are food for animals and also ground for a variety of uses by humans. The seeds are ground to produce a gum. The seeds were a standard of weight measurement in the ancient world, from which the concept \"carat\" is derived. The common names referring to locusts or St. John's bread come from the belief that the so-called \"locusts\" on which John the Baptist fed in the Biblical story were carob pods, not grasshoppers. There are various other references to the tree in the Bible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceratonia siliqua"@en .

aat:300375538 a skos:Concept ;
    skos:definition "Genus containing 1 to 3 species found in the Mediterranean region of Europe, Asia, and Africa. It is believed to be an archaic remnant part its family. The genus was long believed to include only one living species, C. siliqua, although it is now believed by some scholars that some African examples are distinct species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceratonia"@en .

aat:300375539 a skos:Concept ;
    skos:definition "Gum produced from grinding the seeds of the carob tree to a fine powder, which dissolves in hot water and cools to form a stable gel that is an excellent film former. The gum is used as dye thickener, and as size for food, cosmetics, textiles, and paper. Locust bean gums have been detected in the wrappings of Egyptian mummies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locust bean gum"@en .

aat:300375540 a skos:Concept ;
    skos:definition "Species of tree native to central and northern India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sterculia urens"@en .

aat:300375541 a skos:Concept ;
    skos:definition "Pantropical genus containing around 150 species of flowering plants. Together with the African Cola genus (125 species), was part of the former family Sterculiaceae, whose members were noted for having separate male and female flowers borne in often quite large and branched inflorescences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sterculia"@en .

aat:300375542 a skos:Concept ;
    skos:definition "Species of shrub native to the arid regions of Iran, Asia Minor, and Greece. An exudate from this plant is produced spontaneously on the bark of the shrub, but the yield may be increased by making an incision and driving wooden wedges into it. This gum is one of the oldest drugs known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Astragalus gummifer"@en .

aat:300375543 a skos:Concept ;
    skos:definition "Genus containing around 3,000 species of herbs and small shrubs native to temperate regions of the northern hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Astragalus"@en .

aat:300375544 a skos:Concept ;
    skos:definition "Couches having raised head ends and various distinctive styles of legs, used in ancient Greece chiefly for sleeping and dining but also for laying out the dead during ritual mourning and in their tombs. The earliest depictions are in funerary scenes on Geometric vases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "klinai"@en .

aat:300375545 a skos:Concept ;
    skos:definition "Species of herbaceous perennial, probably a native of Guyana and western Brazil, cultivated throughout the West Indies, Southeast Asia, Australia, and South Africa. Its creeping rootstock has fleshy tubers harvested as starch; its many-branched stem reaches 1.5 m (5-6 feet) in height. Plants are harvested when the tubers are gorged with starch, just before the plant's dormant season. The roots are peeled and then grated in water. The resulting mixture is dried to a powder and purified by several washings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maranta arundinacea"@en .

aat:300375546 a skos:Concept ;
    skos:definition "Genus containing around 20 species of low-growing, evergreen plants native to tropical areas of Southwest Asia and the West Indies, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maranta"@en .

aat:300375547 a skos:Concept ;
    skos:definition "Family containing around 30 genera and 350 species of flowering plants. It originated in Africa, although this is not the center of its extant diversity; representatives are found in most tropical areas of the world except Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marantaceae"@en .

aat:300375548 a skos:Concept ;
    skos:definition "Species of woody shrub native to South America; cultivated for its edible tuberous root. It is the third-largest source of edible carbohydrates in the world, although most varieties of the plant are poisonous when not prepared properly. It is used for flour, breads, laundry starch, and an alcoholic beverage. Cassava probably was first cultivated by the Maya in Yucatán."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manihot esculenta"@en .

aat:300375549 a skos:Concept ;
    skos:definition "Genus containing around 160 species of flowering plant native to tropical North and South America, but cultivated in West Africa and elsewhere for their edible starchy tubers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manihot"@en .

aat:300375550 a skos:Concept ;
    skos:definition "Inorganic pigment produced by grinding a native ore, such as ocher, goethite, chalk, green earth, azurite, cinnabar, and malachite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral pigment"@en .

aat:300375551 a skos:Concept ;
    skos:definition "Materials with names given by the company responsible for their production and sale to provide distinction and recognition between similar materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brand name materials"@en .

aat:300375552 a skos:Concept ;
    skos:definition "Paint formulated particularly for the needs of art conservators, typically a retouching paint that is relatively easily reversible. Examples could include solvent-based or resin-based paints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation color"@en .

aat:300375553 a skos:Concept ;
    skos:definition "Genus containing around 30 species of flowering plants native to tropical and warm temperate regions of the Mediterranean basin and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acanthus"@en .

aat:300375554 a skos:Concept ;
    skos:definition "Species of species herbaceous plant with thick, fleshy leaves native to northern Africa, western Asia, and southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acanthus spinosus"@en .

aat:300375555 a skos:Concept ;
    skos:definition "Family containing around 250 genera and 2,500 species of tropical herbs, shrubs, and twining vines, with a few species found in temperate regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acanthaceae"@en .

aat:300375556 a skos:Concept ;
    skos:definition "Genus of biennial thistles native to Europe and Asia, naturalized throughout North America. They have dark green leaves and globular flower heads with prickly bracts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arctium"@en .

aat:300375557 a skos:Concept ;
    skos:definition "Family of around 1,600 genera and 24,000 species of herbs, shrubs, vines, and trees. Members of the family have flower heads composed of many small flowers (florets) surrounded by bracts (leaflike structures), with bell-shaped disk florets forming the center of each head. Fossils suggest that the first members of this family may have evolved in Argentina around 50 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asteraceae"@en .

aat:300375558 a skos:Concept ;
    skos:definition "Order containing 11 families of herbaceous plants, trees, and shrubs, having in common a unique nutrient storage molecule and stamen morphology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asterales"@en .

aat:300375559 a skos:Concept ;
    skos:definition "Species of herbaceous plant native to the Mediterranean area, but cultivated for 2,000 years. It is widely cultivated for its bright pink-purple, fringe-petaled flowers, which often have a spicy fragrance. Cultivars occur in a variety of pink colors, yellow, green, and white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dianthus caryophyllus"@en .

aat:300375560 a skos:Concept ;
    skos:definition "Genus containing around 300 species of herbs and shrubs native mainly to Europe and Asia, with a few native to Africa and arctic North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dianthus"@en .

aat:300375561 a skos:Concept ;
    skos:definition "Family containing 86 genera and around 2,200 species of herbaceous annuals and perennials, mainly of north temperate distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caryophyllaceae"@en .

aat:300375562 a skos:Concept ;
    skos:definition "Diverse order containing 33 families, 692 genera, and around 11,000 species of trees, shrubs, lianas, mangroves, stem or leaf succulents, annuals, and even insectivores. Nearly half of the families are very small, with less than a dozen species each. Many members of the order are ecologically specialized to tolerate salty or desertlike environments. Some have distinctive physiological adaptations to cope with these habitats, including carnivorous digestion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caryophyllales"@en .

aat:300375563 a skos:Concept ;
    skos:definition "General term for any decorative motif in the form of a flower, which is the showy reproductive part of flowering plants or angiosperms. Common examples are motifs resembling roses, tulips, lilies, or daisies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flower"@en .

aat:300375564 a skos:Concept ;
    skos:definition "Ornamental motif in the form of a stylized flower, foliage, diamond, star, or other graphic shape cast as a single unit in letterpress, used to separate paragraphs, indicate notes, etc., and which can be repeated to form a decorative border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printer's flower"@en .

aat:300375565 a skos:Concept ;
    skos:definition "Species of climbing shrub native to Eurasia; twines to 6 m (20 feet) in height. Its trumpet-shaped flowers arranged in whorled clusters are yellowish, purple-tinged blooms that are followed by red berries. Some of the garden varieties are prized for their fragrance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lonicera periclymenum"@en .

aat:300375566 a skos:Concept ;
    skos:definition "Genus containing around 200 species of ornamental shrubs and climbers native to temperate zones of both hemispheres, although they also grow in the Himalayas, southern Asia, and North Africa. Most species have two-lipped, fragrant flowers and red, orange, or black berries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lonicera"@en .

aat:300375567 a skos:Concept ;
    skos:definition "Family containing around 8 genera of vines, shrubs, and herbs native to Eurasia, Africa, and North America. The flowers of members are tubular funnel- or bell-shaped, usually with five outward spreading lobes or points, typically fragrant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caprifoliaceae"@en .

aat:300375568 a skos:Concept ;
    skos:definition "Order containing 45 genera and about 1,100 species of flowering plants, which are distributed worldwide but centred mainly in the Northern Hemisphere. The delimitation of families in this order is currently disputed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dipsacales"@en .

aat:300375569 a skos:Concept ;
    skos:definition "Genus containing about 100 species distributed in temperate regions of Europe, Asia, Africa, and North America. Classification of the members of the genus is currently undergoing revision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lotus"@en .

aat:300375570 a skos:Concept ;
    skos:definition "General term referring to several dissimilar plants. Among the best known lotuses are the following: The Egyptian lotus is a white water lily, Nymphaea lotus or the blue lotus (N. caerulea), seen as a motif in art and used ceremonially for its soporific and psychotropic properties. The lotus of the Greeks was the species Ziziphus lotus of the buckthorn family (Rhamnaceae), a bush native to southern Europe. It has large fruits containing a mealy substance that can be used for making bread and fermented drinks. In ancient times the fruits were an article of food among the poor, and a wine made from the fruit was thought to produce contentment and forgetfulness, as described in Homer. This is also probably the lotus mentioned in the Biblical Book of Job, where a large hippopotamus-like creature (behemoth) lies under the lotus tree. Homer also mentions the lotus as a kind of clover or trefoil that was food for horses, in this context perhaps Melilotus officinalis or a trefoil species of the Lotus genus. The sacred lotus of the Hindus was the waterlily Nelumbo nucifera, having white, blue, or pink flowers. The lotus tree, known to the Romans as the Libyan lotus, was probably the nettle tree of southern Europe, Celtis australis, a member of the elm family (Cannabaceae), with fruits like small cherries, first red and then black at maturity and mentioned by ancient writers for its hard, black wood, from which statues, flutes, etc. were carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lotus"@en .

aat:300375571 a skos:Concept ;
    skos:definition "Motif in the form of a stylized bellflower of the family Campanulaceae. Examples of the motif include northern and eastern European folk art and Japanese tiles. For motifs on 18th-century furniture and other items resembling strings of husk or bellflower shapes nestled together in a festoon, use \"husk (motif).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellflower"@en .

aat:300375572 a skos:Concept ;
    skos:definition "Family containing 84 genera and about 2,400 species of mostly herbaceous plants, many with showy, bell-like flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Campanulaceae"@en .

aat:300375573 a skos:Concept ;
    skos:definition "Species of waterlily found in East Africa and Southeast Asia, having lily pads that float on the water and white blossoms that rise above the water. The ancient Egyptians cultivated the plant in ponds. It was a symbol of strength and power, used in funerary garlands, temple offerings, and for female adornment. It is a popular aquarium plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphaea lotus"@en .

aat:300375574 a skos:Concept ;
    skos:definition "Species of waterlily probably native to the Nile and elsewhere in east Africa, but found already in ancient times in India and Thailand. It has pale- to sky-blue or mauve petals; the flower rises to the surface over the course of a few days when ready to bloom. Ancient Egyptians believed that the flowers open in the morning, rise to the surface, and then sink again at night, which symbolized the rising and setting of the sacred sun to them. When consumed, the plant has mild psycho-active properties, and was probably used ceremonially in ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphaea caerulea"@en .

aat:300375575 a skos:Concept ;
    skos:definition "Genus containing around 50 species of aquatic plants, many of which have showy flowers that float on the surface of the water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphaea"@en .

aat:300375576 a skos:Concept ;
    skos:definition "Family containing 6 genera and 58 species of aquatic plants, many of which have showy flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphaeaceae"@en .

aat:300375577 a skos:Concept ;
    skos:definition "Family containing 3 families, 9 genera, and 74 species found in quiet freshwater habitats throughout most of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nymphaeales"@en .

aat:300375578 a skos:Concept ;
    skos:definition "Species of aquatic perennial plant native to tropical Asia and Australia, having showy white or pink flowers. Under favorable circumstances its seeds may remain viable for many years, with the oldest recorded lotus germination occurring with seeds that were 1,300 years old, recovered from a dry lakebed in China. It is a sacred bloom in Hindu and Buddhist iconography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nelumbo nucifera"@en .

aat:300375579 a skos:Concept ;
    skos:definition "Genus containing aquatic plants with large, showy flowers resembling water lilies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nelumbo"@en .

aat:300375580 a skos:Concept ;
    skos:definition "Family of aquatic plants containing two species. Some authorities consider the two species to constitute a separate order (Nelumbonales) because of important botanical characteristics that suggest a different evolutionary origin from the other water lilies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nelumbonaceae"@en .

aat:300375581 a skos:Concept ;
    skos:definition "Long bast fibers obtained from the leaves of the species Ananas comosus, native to tropical America. The fibers are fine, soft, lustrous, and light cream in color. They are resistant to salt water, strong, wear resistant, and easy to clean; used for fabric, rope, twine, and paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piña"@en .

aat:300375582 a skos:Concept ;
    skos:definition "Species of bromeliad native to tropical and subtropical America, but introduced elsewhere and widely grown in greenhouses. It has 30 to 40 stiff, succulent leaves closely spaced in a rosette on a thick, fleshy stem. It bears a large multiple fruit that develops from a conical spike of flowers. It is used for food, winemaking, and fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ananas comosus"@en .

aat:300375583 a skos:Concept ;
    skos:definition "A juicy edible fruit of the tropical American bromeliad, Ananas comosus. The large multiple fruit develops from a conical spike of flowers; it has yellow flesh surrounded by a tough segmented skin and is topped by a tuft of stiff spiky leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pineapple"@en .

aat:300375584 a skos:Concept ;
    skos:definition "Genus containing around 2 species of flowering plant that bear a large edible fruit. The plants originated in Mesoamerica and were brought to the Caribbean Islands by the Carib natives; representations appear in the art of the Olmec civilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ananas"@en .

aat:300375585 a skos:Concept ;
    skos:definition "Family containing around 2,600 species of flowering plant, most native to the tropical New World and the West Indies. Most have fleshy fruit, but some produce dry pods. Bromeliads are one of the more recent plant groups to have emerged. The greatest number of primitive species reside in the Andean highlands of South America, where they originated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bromeliaceae"@en .

aat:300375586 a skos:Concept ;
    skos:definition "Motif representing a stylized tree that developed in kilim rug designs, but is also incorporated in other textile designs, mosaics, and other art, particularly in Asia Minor, Armenia, and the Middle East. It is characterized by a symmetrical vertical many-branched stalk or a Y-shaped design having a trunk and two parallel vertical branches. It is a symbol of immortality, symbolically evoking the cypress tree that has durable wood and was believed immortal. Rugs employing this design are often hung upside down, so the roots of the tree are in heaven; the imagery is inspired by passages in the Koran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hayat agaci"@en .

aat:300375587 a skos:Concept ;
    skos:definition "Species of fern native to Europe and found rarely in North America, having unusual simple, undivided fronds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asplenium scolopendrium"@en .

aat:300375588 a skos:Concept ;
    skos:definition "Genus containing around 700 species of ferns, often treated as the only genus in the family Aspleniaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asplenium"@en .

aat:300375589 a skos:Concept ;
    skos:definition "Family containing one genus and 700 species of ferns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aspleniaceae"@en .

aat:300375590 a skos:Concept ;
    skos:definition "Class containing 4 orders and around 9,000 species of ferns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polypodiopsida"@en .

aat:300375591 a skos:Concept ;
    skos:definition "Genus containing around 110 species of herbaceous flowering plants native primarily to the temperate northern hemisphere, growing from bulbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lilium"@en .

aat:300375593 a skos:Concept ;
    skos:definition "Botanical name for a class of flowering plants, which is various circumsripted depending upon the particular classification scheme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magnoliopsida"@en .

aat:300375594 a skos:Concept ;
    skos:definition "Family containing 16 genera and around 635 species of herbs and shrubs, native primarily to temperate and subtropical regions. Members typically have 6-segmented flowers and 3-chambered capsular fruits, occasionally berries. The leaves usually have parallel veins and are clustered at the base of the plant but may alternate along the stem or be arranged in whorls. Most species have an underground storage structure, such as a bulb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liliaceae"@en .

aat:300375595 a skos:Concept ;
    skos:definition "Family containing 16 genera and around 635 species of herbs and shrubs, native primarily to temperate and subtropical regions. Members typically have 6-segmented flowers and 3-chambered capsular fruits, occasionally berries. The leaves usually have parallel veins and are clustered at the base of the plant but may alternate along the stem or be arranged in whorls. Most species have an underground storage structure, such as a bulb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liliales"@en .

aat:300375596 a skos:Concept ;
    skos:definition "Genus containing 8 species of herbaceous plants native to North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydrophyllum"@en .

aat:300375597 a skos:Concept ;
    skos:definition "Family containing around 16 genera and 350 species of herbaceous plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hydrophyllaceae"@en .

aat:300375598 a skos:Concept ;
    skos:definition "Flavonoid compound used as a yellow dye, obtained from the bark of the black oak, Quercus velutina, native to the eastern and midwestern United States. The outermost layer of bark gives a bright yellow dye while the inner bark gives a darker oranges and tans. Used to dye wool bright yellow or orange. At one time this colorant was used with cochineal to produce scarlets of particular brilliance. Quercitron was introduced in England in 1775 by Edward Bancroft as a substitute for weld."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quercitron"@en .

aat:300375599 a skos:Concept ;
    skos:definition "Family containing 52 genera and more than 900 species of shrubs and trees, distributed worldwide, especially in the tropics and warm temperate region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhamnaceae"@en .

aat:300375600 a skos:Concept ;
    skos:definition "Fragrant myrrhlike oleoresin obtained from the small evergreen tree, Commiphora opobalsamum, native to the Middle East. Used in perfumes and medicines. Referred to in biblical Genesis as a healing balm; valued in medicine and perfume in ancient Greece and the Roman Empire. The term \"balm of Gilead\" has been incorrectly used to refer to \"Canada balsam,\" which is derived from a North American tree."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balm of Gilead"@en .

aat:300375601 a skos:Concept ;
    skos:definition "Oleoresinous exudation from the small cashew tree, Pistacia terebinthus, native to southern Europe and the Mediterranean region. Used in varnish recipes"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terebinth"@en .

aat:300375602 a skos:Concept ;
    skos:definition "The raw balsam of the French Maritime pine tree, Pinus pinaster. It is used to produce the distilled \"Burgundy turpentine\" and \"Burgundy pitch,\" which is not distilled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bordeaux turpentine"@en .

aat:300375603 a skos:Concept ;
    skos:definition "A sticky, viscous yellow sap obtained from conifers. The crude turpentine contains about 65 percent rosin (solid residue) and 18 percent oil of turpentine (volatile portion). It is distilled to create the volatile oil of turpentine, usually shortened to \"turpentine (oil).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turpentine"@en .

aat:300375604 a skos:Concept ;
    skos:definition "Species of medium-sized tree native to the western and southwestern Mediterranean region. It is widely planted for timber in its native area, being one of the most important trees in forestry in France, Spain and Portugal. Also used as an ornamental and for medicine and turpentine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus pinaster"@en .

aat:300375605 a skos:Concept ;
    skos:definition "Species of small deciduous tree or large shrub growing to 7 m in height, native to the Mediterranean region. Believed to have been mentioned in Mycenaean texts; known in Biblical texts and in Ancient Greece. Sap is used as a medicine, and to create an oil of turpentine; the fruit is used to make bread. The bark and galls are used for tanning leather and making a beverage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pistacia terebinthus"@en .

aat:300375606 a skos:Concept ;
    skos:definition "Genus containing around 10 to 20 species of flowering plants in the cashew family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pistacia"@en .

aat:300375607 a skos:Concept ;
    skos:definition "Genus of flowering plants, some members of which are important for resin production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Copaifera"@en .

aat:300375608 a skos:Concept ;
    skos:definition "Species of tall tree native to South America, cultivated in the West Indies. The resin is used in cough syrups, to treat asthma, in perfumery, as flavoring, in painting, and as a remedy for skin rashes, although in many people it actually causes contact dermatitis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myroxylon balsamum"@en .

aat:300375609 a skos:Concept ;
    skos:definition "Genus containing one species, and two varieties, of South American trees valued for aromatic resin and for dark brown wood and deep red heartwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Myroxylon"@en .

aat:300375610 a skos:Concept ;
    skos:definition "Species of tree native to the east coast of Africa. Produces a resinous copal. Some authors place this African species in a separate monotypic genus, Trachylobium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hymenaea verrucosa"@en .

aat:300375611 a skos:Concept ;
    skos:definition "Genus containing 14 living species and several extinct species of trees, most native to tropical America, but at least one native to the east coast of Africa. The trees are used for edible fruits, leaves to make tea, a dense wood used in making ships and furniture, thick bark to make canoes, seeds containing large amounts of a highly viscous polysaccharide used for food, paper, cosmetic and pharmaceutical, and hard resins used for varnish. Resin is gathered from living trees and as found in the ground, deposited by lost specimens of living species or extinct species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hymenaea"@en .

aat:300375612 a skos:Concept ;
    skos:definition "Thought to be the ancestor of living Hymenaea species. Copal deposited from these extinct trees is highly valued for varnish. It had an extensive range, from southern Mexico and northern South America to the African continent. Studies of morphology and DNA indicate that H. protera was more closely related to the only species of Hymenaea remaining in East Africa than it is to the numerous American species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hymenaea protera"@en .

aat:300375613 a skos:Concept ;
    skos:definition "A brown, sticky, aromatic resin obtained from trees of the genus Liquidambar, including L. orientalis, native to Turkey. A white solid powder that forms in the steam distillate obtained from storax is polystyrene. Storax resin is sometimes used as a mounting media for microscope slides. For the a brown, aromatic resin obtained from the genus Styrax, use \"benzoin.\" Resins from both Sytrax and Liquidambar trees were formerly called \"storax,\" but \"storax\" is no longer used for resin of genus Styrax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storax"@en .

aat:300375614 a skos:Concept ;
    skos:definition "Genus containing around 120 species of shrubs or small trees native to warm temperate and tropical regions of the Northern Hemisphere, in eastern and southeastern Asia and South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Styrax"@en .

aat:300375615 a skos:Concept ;
    skos:definition "Species of coniferous tree native to the Moluccas and the Philippines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agathis dammara"@en .

aat:300375616 a skos:Concept ;
    skos:definition "Genus containing around 13 species of pinelike plants native from the Philippines to Australia and New Zealand; cultivated elsewhere as ornamental plants in warm areas or in greenhouses. Several species yield hard resins or gums used in making varnishes, patent leather, sealing wax, and other products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agathis"@en .

aat:300375617 a skos:Concept ;
    skos:definition "Family of trees containing 3 genera and around 45 species of conifers. It is an ancient family of conifers that was distributed worldwide in the Jurassic and Cretaceous periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Araucaria"@en .

aat:300375618 a skos:Concept ;
    skos:definition "Family containing around 16 genera of resinous trees and shrubs. They are native primarily to tropical America, but a few species occur in Africa and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burseraceae"@en .

aat:300375619 a skos:Concept ;
    skos:definition "Reservoirs of water used as swimming pools or fish ponds inside a Roman home, or in a public bath, where they were used for cooling plunges. In Medieval monastic communities, piscinae were used as fish ponds, when fish was a staple item of diet. Piscinae are also seen in Classicizing architecture, particularly in the 18th century. For basins having drains, used in Christian churches during the liturgy, use \"piscinae (Christian fixtures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "piscinae"@en .

aat:300375620 a skos:Concept ;
    skos:definition "Genus of rattan palms native mainly to the tropics and subtropics of southeastern Asia. The stems are harvest for their cores, which is used for canes and furniture. The fruits of certain species produce a red resin that is one source for \"dragon's blood,\" used for medicine and varnish. The seeds of some species are harvested for the production of Buddhist prayer beads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daemonorops"@en .

aat:300375621 a skos:Concept ;
    skos:definition "Genus containing around about 40 species of trees and succulent shrubs native primarily to Africa, but also found in Asia and Central America. In earlier classifications, placed in family Agavaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dracaena"@en .

aat:300375622 a skos:Concept ;
    skos:definition "Family of flowering plants; the division of the family into subfamilies and genera has recently undergone revision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asparagaceae"@en .

aat:300375623 a skos:Concept ;
    skos:definition "Species of tree native to Indo-Malaysia; source of a valuable resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canarium indicum"@en .

aat:300375624 a skos:Concept ;
    skos:definition "Genus containing around 75 species of large evergreen, tropical and subtropical trees native to Africa, southern Asia, and Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canarium"@en .

aat:300375625 a skos:Concept ;
    skos:definition "Tape made from or coated with rubber, PVC, or another material, designed to provide electrical insulation and protection from liquids and corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical tape"@en .

aat:300375626 a skos:Concept ;
    skos:definition "Masking tape designed specifically for house or wall painting, having a coating to resist penetration of liquid paint and an adhesive that is both firmly adherent to prevent seepage and easily released. It is often blue, purple, or another easily visible color to assist in removal. It may be rated according to the time it may remain without leaving residue on the surface being masked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "painters tape"@en .

aat:300375627 a skos:Concept ;
    skos:definition "Tape, usually tan in color, having a very low tack. It is intended to hold blueprints to a drawing board or light table, and to pull off easily without damaging the drawing. Tape with low-tack adhesive that doesn't leave residue on surfaces, or tear paper when removed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drafting tape"@en .

aat:300375628 a skos:Concept ;
    skos:definition "The belief system, teachings, and practices of the fraternal order of Free and Accepted Masons, the world's largest secret society. Spread by the advance of the British Empire, Freemasonry remains most popular in the British Isles and in other countries associated the empire. It is said to have been established for mutual help and fellowship; members believe that it has historical roots traceable back through the Romans to the Egyptians and the building of the pyramids. Freemasonry incorporates traditions and rituals that make symbolic use of or reference to the tools of medieval stonemasons, notably the square and compasses. In medieval Europe, like other craft organizations of the period, many medieval associations of masons whose members included freemasons, had developed elaborate secret rituals for imparting the knowledge of their craft and for the initiation of new members. These rituals continued to evolve during the early modern period. In 16th-century Scotland Freemasonry began to incorporate elements of contemporary Hermetic thought. From the early 17th century, the lodges began to admit members who were not connected with the building trades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Freemasonry"@en .

aat:300375629 a skos:Concept ;
    skos:definition "Family containing around 10 genera and 17 species, however the circumscription of the family has varied widely. They have a wide, but scattered distribution throughout the tropics and temperate zones of the world. Predominantly African family of flowering plants, many members of which are popular garden ornamentals, especially in warm, dry regions of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asphodelaceae"@en .

aat:300375630 a skos:Concept ;
    skos:definition "Small genus of South American trees yielding latex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hevea"@en .

aat:300375631 a skos:Concept ;
    skos:definition "Genus of flowering plant, the sap of which is used as medicine, insecticide, and for rubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parthenium"@en .

aat:300375632 a skos:Concept ;
    skos:definition "Species of small cypress-like tree native to northwest of Africa, especially in southern Morocco in the Atlas mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tetraclinis articulata"@en .

aat:300375633 a skos:Concept ;
    skos:definition "Genus of evergreen coniferous tree containing only one species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tetraclinis"@en .

aat:300375634 a skos:Concept ;
    skos:definition "Genus containing 15 species of small to medium-sized trees and shrubs, 13 of which are native to Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Callitris"@en .

aat:300375635 a skos:Concept ;
    skos:definition "Species of resinous timber conifer native to the North Island of New Zealand. Kauri forests are among the most ancient in the world: antecedents of the kauri appeared during the Jurassic period as early as 190-135 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agathis australis"@en .

aat:300375636 a skos:Concept ;
    skos:definition "Species of tree that grows in China, Korea and Japan. It is cultivated and tapped for the toxic sap used for lacquer to make lacquerware. One active constituent of the sap of the lacquer tree is urushiol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toxicodendron vernicifluum"@en .

aat:300375637 a skos:Concept ;
    skos:definition "Species of Japanese tree grown for its waxy berries and stem juices that yield a natural lacquer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toxicodendron succedaneum"@en .

aat:300375638 a skos:Concept ;
    skos:definition "Genus of woody trees, shrubs, and vines that produce the skin-irritating oil urushiol, which can cause a severe allergic reaction and is used for lacquer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Toxicodendron"@en .

aat:300375639 a skos:Concept ;
    skos:definition "Species of bee native to Europe, Asia, and Africa; introduced to North America in the early 17th century. It is around 1.2 cm (0.5 inch) in length,has a somewhat bristly head and thorax, and varyies in color according to the strain. Two large compound eyes and three simple eyes, or ocelli, are located on top of the head. Keen eyesight is complemented by two sensitive, odor-detecting antennae. There are a number of races, subspecies, and strains of this species. As with other bees, honey bees are social insects and live together in nests or hives. Honey bee colonies have been cared for and managed by humans for many centuries, for the purpose of harvesting their honey and for their role in agriculture as pollinators of a wide variety of domesticated plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apis mellifera"@en .

aat:300375640 a skos:Concept ;
    skos:definition "Genus containing several species of bees native to tropical Eurasia and found in Africa. Members of the honey bee genus produce honey and are generalist floral visitors that pollinate a wide variety of plants. The body becomes dusted with pollen during foraging; this pollen is then transferred from plant to plant as the bee continues to visit flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apis"@en .

aat:300375641 a skos:Concept ;
    skos:definition "Large family of insects containing the honey bees, stingless bees, carpenter bees, orchid bees, cuckoo bees, bumble bees, and digger or mining bees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Apidae"@en .

aat:300375642 a skos:Concept ;
    skos:definition "Order that includes around 50,000-80,000 species of cicadas, aphids, planthoppers, leafhoppers, shield bugs, and other bugs, ranging from 1 mm (0.04 inches) to around 15 cm (6 inches) in length, all having a common arrangement of sucking mouthparts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hemiptera"@en .

aat:300375643 a skos:Concept ;
    skos:definition "Genus of soft scale insects. The females of many members may be covered with a waxy substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceroplastes"@en .

aat:300375644 a skos:Concept ;
    skos:definition "Family of scale insects the female members of which have flat, elongated oval bodies and a smooth integument which may be covered with wax. In some genera they possess legs but in others, they do not, and the antennae may be shortened or missing. The males may be alate or apterous."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coccidae"@en .

aat:300375645 a skos:Concept ;
    skos:definition "Species of toothed whale growing to 20.5 m (67 feet) in length, and having the largest brain of any animal. The name comes from the white, waxy substance, spermaceti, found in the animal's head. The sperm whale is the only living member of genus Physeter. The species feeds on squid and fish, diving as deep as 3 km (9,800 feet). The sperm whale's clicking vocalization is the loudest sound produced by any animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Physeter macrocephalus"@en .

aat:300375646 a skos:Concept ;
    skos:definition "Genus containing one living species of sperm whale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Physeter"@en .

aat:300375647 a skos:Concept ;
    skos:definition "Family containing 3 species of marine mammal in 2 genera: Physeter, the giant sperm whale; and Kogia, containing two species called pygmy and dwarf sperm whales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Physeteridae"@en .

aat:300375648 a skos:Concept ;
    skos:definition "Genus containing 2 species of marine mammals, pygmy and dwarf sperm whales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kogia"@en .

aat:300375649 a skos:Concept ;
    skos:definition "Species of shrub native to Mexico and the southwestern United States. The leafless stems are covered in a waxy substance to protect the plant from transpiration. The Latin name refers to the practice of the sap having been used to treat sexually-transmitted diseases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Euphorbia antisyphilitica"@en .

aat:300375650 a skos:Concept ;
    skos:definition "Genus containing around 2,500 species of annual or perennial herbs, woody shrubs, or trees with a caustic, poisonous milky sap. It is one of the largest flowering-plant genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Euphorbia"@en .

aat:300375651 a skos:Concept ;
    skos:definition "Species of palm tree native to northeastern Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Copernicia prunifera"@en .

aat:300375652 a skos:Concept ;
    skos:definition "Genus containing 24 species of fan palms native to South America and the Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Copernicia"@en .

aat:300375653 a skos:Concept ;
    skos:definition "Asphalt found in natural deposits, as distinguished from asphalt formed as a residue from the distillation of petroleum. Natural asphalt is found where crude oil seeps from the ground. It was formed during an early stage in the breakdown of organic marine deposits into petroleum. It characteristically contains minerals, while residual petroleum asphalt does not (although minerals may be added)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural asphalt"@en .

aat:300375654 a skos:Concept ;
    skos:definition "Dark brown or black solid to semisolid material that is the organic, or hydrocarbon, portion of asphalt. It was used in ancient times as a sealant, for example in ancient Egypt. It is currently is used in hot-melt adhesives, coating, paints, sealants, roofing, and road coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asphaltic bitumen"@en .

aat:300375655 a skos:Concept ;
    skos:definition "Cutback asphalt that has the adition of kerosene, which is less volatile than other additives, causing a slower evaporation process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium-curing asphalt"@en .

aat:300375656 a skos:Concept ;
    skos:definition "Asphalt mixture that includes and additive to liquify the material for easier blending and applicaiton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutback asphalt"@en .

aat:300375657 a skos:Concept ;
    skos:definition "A strongly alkaline cleaner having the primary ingredients sodium carbonate and sodium bicarbonate, used in textile processing and commercial laundry soaps. Such an alkaline soap causes cottons to yellow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laundry soda"@en .

aat:300375658 a skos:Concept ;
    skos:definition "Large group containing between 5,000 and 10,000 species, depending upon the classification, of mostly multicellular, marine algae, including many notable seaweeds and coralline algae. They are characterized by having eukaryotic cells without flagella and centrioles, using floridean starch as food reserve, having phycobiliproteins as accessory red pigments, lacking external endoplasmic reticulum, and using sexual reproduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhodophyta"@en .

aat:300375659 a skos:Concept ;
    skos:definition "Class including about 4,100 species of predominantly marine algae often found attached to other shore plants. Their morphological range includes filamentous, branched, feathered, and sheetlike thalli."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhodophyceae"@en .

aat:300375660 a skos:Concept ;
    skos:definition "Refers to the practice of designing for Websites, including graphical functional, and structural considerations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Web design"@en .

aat:300375661 a skos:Concept ;
    skos:definition "Secondary prints made from commercial photographic dye diffusion print products, such as Polaroid print film. The original negative is pressed onto a wet receptor such as watercolor paper, thus creating a second print from dyes leached from the photographic reagent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image transfers"@en .

aat:300375662 a skos:Concept ;
    skos:definition "Objects resulting from the process of transferring emulsion from a dye diffusion transfer print onto a secondary support. This support is most often paper but may be any other surface that the emulsion will adhere to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emulsion transfers"@en .

aat:300375663 a skos:Concept ;
    skos:definition "Process in which images are transferred by painting a wet acrylic medium on a paper print and subsequently rubbing the paper away, leaving only the colorant, toner, or ink embedded in the acrylic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic transfer"@en .

aat:300375664 a skos:Concept ;
    skos:definition "Type of Italian plate that is mounted on a high thin stem, often for use as a centerpiece or fruit bowl; sometimes a series of plates and stems is mounted on top of each other. The plates are usually made of glass or pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alzatas"@en .

aat:300375665 a skos:Concept ;
    skos:definition "Flat surfaces, blocks, or floors, generally raised above the adjoining floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platforms"@en .

aat:300375666 a skos:Concept ;
    skos:definition "Blocks, platforms, or other supporting structures used to keep something in an elevated position. An example is a block placed on the surface of a credenza, dresser, altar, or other piece of furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "risers"@en .

aat:300375667 a skos:Concept ;
    skos:definition "Small tray designed for supporting or carrying ampollae and other small bottles or flasks, often having a handle mounted vertically in the center of the tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ampullae trays"@en .

aat:300375668 a skos:Concept ;
    skos:definition "Doors consisting primarily of glass panels. May refer to doors that are entrances to architecture (e.g., an office building door) or components of furniture (e.g., a door on a cabinet)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass doors"@en .

aat:300375669 a skos:Concept ;
    skos:definition "In Jewish tradition, wooden coffers containing the Tables of the Law, kept in the holiest place of the synagogue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torah shrines"@en .

aat:300375670 a skos:Concept ;
    skos:definition "Seats for several people, having a storage chest below and a high back and arms. Examples include benches in the sacristy of a church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcibanchi"@en .

aat:300375673 a skos:Concept ;
    skos:definition "Devices incorporating a rack or tray and often a seat and hanger, designed for holding clothing and personal effects. Generally placed in a dressing room or bedroom, and intended for gentlemen's clothing rather than ladies'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing valets"@en .

aat:300375674 a skos:Concept ;
    skos:definition "Bindings created using a series of wire staples along the edge of gathered sheets of loose paper. Usually employed for speed and convenience rather than longevity. Often used for pamphlets or other slim publications rather than commercially produced books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staple bindings"@en .

aat:300375675 a skos:Concept ;
    skos:definition "Upright postlike stands, usually of wood or metal, having pegs or hooks around the top from which to hang coats, hats, or other clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coat trees"@en .

aat:300375676 a skos:Concept ;
    skos:definition "Family containing 44 genera and around 760 species of primarily herbaceous plants, but the family also includes some woody shrubs and a genus of small tropical trees. All species in the family have bisexual, regular, dish-shaped flowers with one superior pistil (female structure) and many stamens (male parts). The buds and flowers are usually large and often nodding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papaveraceae"@en .

aat:300375677 a skos:Concept ;
    skos:definition "Motif comprising a heavy-armed cross with a lighter-armed X-shape over it (that is, an eight-armed figure), with the heavier arms typically terminating in a ram's horn motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemche güls"@en .

aat:300375678 a skos:Concept ;
    skos:definition "Genus containing around 75-100 species of annual, biennial, and perennial herbaceous plants native to temperate and cold regions of Eurasia, Africa, and North America. They have showy solitary flowers and some species have a milky latex with narcotic properties. Poppies have been cultivated since ca. 5,000 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papaver"@en .

aat:300375679 a skos:Concept ;
    skos:definition "Species of herbaceous plant native to Turkey, and from which the narcotics opium, morphine, codeine, and heroin are derived from the milky fluid found in its unripe seed capsule. It is also a common garden annual, valued for its showy blue-purple or white flowers. It is also grown for its tiny black or bluish, kidney-shaped, non-narcotic ripe seeds, used in bakery products, seasoning, oil, and birdseed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papaver somniferum"@en .

aat:300375680 a skos:Concept ;
    skos:definition "Fugitive organic blue colorant obtained from cornflower petals (Centaurea dyanus); used in some 18th-century watercolor paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornflower blue"@en .

aat:300375681 a skos:Concept ;
    skos:definition "Genus containing 350-600 species of herbaceous, annual and perennial, thistle-like flowering plants, such as the garden cornflower (C. cyanus) and the basket-flower (C. americana). Others are variously known as knapweed, thornless thistle, cardo-del-valle, dusty miller, blue bottle, mountain bluet, sweet-sultan, hard heads, and Spanish buttons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Centaurea"@en .

aat:300375682 a skos:Concept ;
    skos:definition "Species of mammal native from northern Canada through the United States southward into South America. It has been introduced into Europe and Asia. It recognizable by a conspicuous black mask coloration across the eyes and a tail ringed with 5 to 10 black bands. Raccoons are intelligent and inquisitive; they are typically nocturnal and often arboreal. The hairless front feet are highly dexterous and resemble slender human hands, the hind feet are thicker and longer. Although classified as a carnivore, the raccoon is omnivorous, feeding on crayfish other arthropods, rodents, frogs, fruit, and other plant matter including crops. It may immerse food in water to soften the food and the pads of its hands, giving rise to the belief that it washes its food. It has been hunted for its fur and occasionally for food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Procyon lotor"@en .

aat:300375683 a skos:Concept ;
    skos:definition "Almond-shaped lights, auras, or series of lines surrounding the whole of a sacred figure, particularly in Buddhist and Christian imagery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandorlas"@en .

aat:300375684 a skos:Concept ;
    skos:definition "Glories that comprise a circle, disk, series of lines, or rays of light with which the head of the sacred personage is surrounded. In Hellenistic and Roman art, halos are worn by the sun-god Helios and Roman emperors often appear with a crown of rays. The imagery was picked up in Christian art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halos"@en .

aat:300375685 a skos:Concept ;
    skos:definition "Sets comprising a ewer and basin, particularly such sets intended to wash hands at table. The items may be composed of fine porcelain or silver plate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lavabo sets"@en .

aat:300375686 a skos:Concept ;
    skos:definition "Post WWII, Eastman Kodak introduced verifax copiers intended as an office reprographic tool. The process produced poor quality reproductions that were prone to fading, and required special paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verifax"@en .

aat:300375688 a skos:Concept ;
    skos:definition "Roof-like ornamented projections, suspended from one wall or from the ceiling, used in architecture or furniture design, typically placed over a niche, door, window, tomb, etc., to protect it from the sun or elements, or to draw attention to the feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural canopies"@en .

aat:300375689 a skos:Concept ;
    skos:definition "Tables on which monetary calculations were made using tokens or counters on a checkered background, similar in usage to an abacus. Often having a compartment beneath for money, tokens, and goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter tables"@en .

aat:300375690 a skos:Concept ;
    skos:definition "Boards or cloth panels used in counting houses, which were offices attached to a shop or residence of a merchant, having a checker pattern for the purpose of counting money or tokens representing accounts. The counter board was portable, placed upon a table or chest when used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counter boards"@en .

aat:300375691 a skos:Concept ;
    skos:definition "Flat working surfaces on top of waist-level cabinets, such as found near or adjacent to the sinks in kitchens and bathrooms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countertops"@en .

aat:300375692 a skos:Concept ;
    skos:definition "Buildings or rooms for the keeping of accounts, business, and correspondence, for example in a merchant's place of business or home prior to the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counting houses"@en .

aat:300375694 a skos:Concept ;
    skos:definition "Sofas with an attached platform upon which to rest a book, for the purpose of reading in a reclining position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reading sofas"@en .

aat:300375695 a skos:Concept ;
    skos:definition "Gowns worn by infants, having a very long skirt designed to somewhat restrict movement and to keep the baby's legs warm by being so long that he or she cannot easily kick the skirt off the legs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long clothes"@en .

aat:300375696 a skos:Concept ;
    skos:definition "Cloth, often decorated with embroidery, used to protect the top of a dresser from scratches or other damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dresser cloths"@en .

aat:300375697 a skos:Concept ;
    skos:definition "Chairs having a triangular seat and three turned legs, popular in 17th-century America and Britain. The seat may be upholstered. The type is heavily inspired by Late Gothic and Early Renaissance three-cornered chairs of continental Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Harvard chairs"@en .

aat:300375698 a skos:Concept ;
    skos:definition "Armchairs designed to sit in a corner, having a back continuing around two sides of the seat and over three legs, with the fourth leg placed under the middle front of the seat. The back is typically rounded, and the occupant may sit facing forward, or to either side. The form was popular in 18th-century Britain, Europe, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner chairs"@en .

aat:300375699 a skos:Concept ;
    skos:definition "Tables having a single slab as a top surface, usually having a slab of stone, typically marble or slate but also granite or another type of stone, or of concrete or heavy wood. The slab is set upon a plinth or frame, usually of stone, wood, or metal. The slab top is not enclosed or encased in a supporting structure. For 18th-century tables having a marble top, use the more specific \"marble slab tables.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slab tables"@en .

aat:300375700 a skos:Concept ;
    skos:definition "Stands or bookrests designed to hold a very large dictionary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dictionary stands"@en .

aat:300375701 a skos:Concept ;
    skos:definition "Forks designed for a toddler to feed itself. The traditional design includes a short handle and short, relatively blunt tines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby forks"@en .

aat:300375702 a skos:Concept ;
    skos:definition "Candy or sweets having a chocolate or fondant coating and fondant center that sometimes contains fruits and nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bonbons"@en .

aat:300375704 a skos:Concept ;
    skos:definition "Implements intended to spoon, scoop, and sometimes also to store, cosmetics. Best known as works from ancient Egypt, Greece, Rome, and elsewhere. These spoons were made from various materials such as wood, alabaster or ivory, and were often elaborately sculpted or decorated with symbolic imagery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetic spoons"@en .

aat:300375705 a skos:Concept ;
    skos:definition "Small containers designed to store cosmetics and other personal hygiene materials. Cosmetic boxes are found in the form of a cube, disk, or other shape, generally having a lid. Best known as works from ancient Egypt, Greece, Rome, and Asia, dating from the Late Bronze age, made from materials such as wood, ivory or bone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetic boxes"@en .

aat:300375706 a skos:Concept ;
    skos:definition "Small jar-like vessels designed to store cosmetics, typically made of stone, ceramic, or glass. Best known as works from ancient Egypt, Greece, Rome, Asia, and in Europe and North America through the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetic jars"@en .

aat:300375707 a skos:Concept ;
    skos:definition "Small palettes designed to mix cosmetics. Usually made of stone or ceramic. Best known as works from ancient Egypt, elsewhere in the Middle East, Greece, Rome, and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetic palettes"@en .

aat:300375708 a skos:Concept ;
    skos:definition "Stick-like implements intended to apply cosmetics or sticks composed of a cosmetic. Best known as works from ancient Egypt, Asia, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetic sticks"@en .

aat:300375709 a skos:Concept ;
    skos:definition "Small tubes of glass, metal, stone, or another material, designed to store cosmetics. Best known as glass works from ancient Egypt, Greece, and Rome. The cosmetic was extracted with a cosmetic stick or other device. Modern examples are made of pliable metal or plastic, and the cosmetic is extruded when pressure is applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetic tubes"@en .

aat:300375710 a skos:Concept ;
    skos:definition "Small flasks of glass, stone, or another material, designed to store cosmetics. Best known as works from ancient Egypt, elsewhere in the Middle East, Greece, and Rome. Usually distinguished from cosmetic tubes by having a foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosmetic flasks"@en .

aat:300375711 a skos:Concept ;
    skos:definition "The making of a design by pouring colored sands, powdered pigments from minerals or crystals, or pigments from other natural or synthetic sources onto a surface to make a fixed or unfixed image. They are often made on the ground or the floor rather than on a separate support. The works may be unfixed or fixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand painting"@en .

aat:300375712 a skos:Concept ;
    skos:definition "Refers to a form of minimalism credited to Southern California artists of the 1960s and 1970s characterized by a preoccupation with light, transparency, reflectivity, and color. These artists used glass, resin and cast acrylic, often forming site-specific installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Light and Space"@en .

aat:300375713 a skos:Concept ;
    skos:definition "Sections of hide or cloth that are attached to the tipi poles, often by rawhide strips or buffalo hair rope. Several liners were typically overlapped to provide coverage of the entire interior space. Tipi liners may be painted or decorated with quillwork or beadwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tipi liners"@en .

aat:300375715 a skos:Concept ;
    skos:definition "The style and culture of the people of the ancient Africa province, roughly comprising the territory of modern northern Tunisia, northeastern Algeria, and the Mediterranean coast of modern western Libya along the Syrtis Minor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African"@en .

aat:300375716 a skos:Concept ;
    skos:definition "Water drawn through taps from pipes in a dwelling or other structure. Due to its noncorrosive properties, tap water may be used in conservation of ancient stone materials in preference to distilled water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tap water"@en .

aat:300375717 a skos:Concept ;
    skos:definition "The study of emission and absorption spectra via absorption spectroscopy or reflectance spectroscopy over wavelengths in the ultraviolet and visible region of the electromagnetic spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet-visible spectroscopy"@en .

aat:300375718 a skos:Concept ;
    skos:definition "Refers to instances of formal written messages routed by a network of radio operators. These are plain text messages, with metadata, which are relayed through a chain of radio operators, the last of which volunteers to deliver the transcribed radiogram to its destination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiograms"@en .

aat:300375720 a skos:Concept ;
    skos:definition "The topmost components of maces, often rounded, carved or molded into a design or having sharp points. Mace heads are attached to the shafts of the mace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mace heads"@en .

aat:300375721 a skos:Concept ;
    skos:definition "Process identified by Situationist theory in which a radical or revolutionary concept is absorbed and commodified by the culture that opposes it. The theory posits that through this process the original intent of radical critique is rendered ineffective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recuperation"@en .

aat:300375722 a skos:Concept ;
    skos:definition "Brightly colored, synthetic dye produced by coupling aromatic ring compounds. Used as dyestuffs and food coloring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azo dye"@en .

aat:300375723 a skos:Concept ;
    skos:definition "Sodium dithionite (also known as sodium hydrosulfite) is a reductive bleaching chemical. Usage includes iron stain removal, and occasionally to treat corroded copper and silver artifacts in object conservation. It can also be used for purification of water and gas and as a sulfonating agent or a sodium ion source in industrial processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium dithionite"@en .

aat:300375724 a skos:Concept ;
    skos:definition "Haziness of a fluid caused by sediment or other particles in suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turbidity"@en .

aat:300375725 a skos:Concept ;
    skos:definition "Creatures, spirits, or other living entities that are imaginary, fictitious, or belonging to myth or legend. For human or human-like entities of legend, myth, or religion, prefer \"legendary characters\" or \"religious characters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legendary beings"@en .

aat:300375726 a skos:Concept ;
    skos:definition "Mythical monsters, represented as a huge and terrible reptile, usually combining ophidian and crocodilian structure, with strong claws, like a beast or bird of prey, and a scaly skin; it is generally represented with wings, and sometimes as breathing out fire. The heraldic dragon combines reptilian and mammalian form with the addition of wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragons"@en .

aat:300375728 a skos:Concept ;
    skos:definition "Scottish variation of Art Nouveau that originated at the Glasgow School of Art and flourished from ca. 1890 to ca. 1920. Chief among its proponents are Charles Rennie Mackintosh, Herbert MacNair and the sisters, Frances and Margaret MacDonald. When Francis H. Newbery (1853–1946) became director of the Glasgow School in 1885, his teachings were influenced by the Arts and Crafts Movement that stressed an art that combined functionalism with beauty while encouraging individuality and experimentation among its students. The journal “The Hobby Horse” (begun in spring 1884), expressed a desire for the unification of old and new and a harmonious relationship between abstract lines and masses. The style was further developed through the increasing popularity of Celtic revivalism taking root in Glasgow at the time. The style begins to dissipate with the coming of World War I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glasgow style"@en .

aat:300375729 a skos:Concept ;
    skos:definition "Refers to a French variation of Art Nouveau, literally meaning \"noodle style,\" referring to the interlacing lines characteristic of its designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Style nouille"@en .

aat:300375730 a skos:Concept ;
    skos:definition "Refers to a French variation of Art Nouveau, named after Paris Metro entrance structures designed by Hector Guimard, which emphasive the modern use of glass and steel. As a result, the term is often used in conjunction with \"Style Guimard.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Style Métro"@en .

aat:300375731 a skos:Concept ;
    skos:definition "Clubs consisting of a stick with a handle and often a strap, typically carried by the military or law enforcement personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military batons"@en .

aat:300375732 a skos:Concept ;
    skos:definition "Refers to a German variation of Art Nouveau, named after the work of Belgian artist Henry van de Velde. Term is often used in conjunction with \"Belgische (style).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Veldesche"@en .

aat:300375733 a skos:Concept ;
    skos:definition "German term for a variation of Art Nouveau that developed in Belgium, meaning \"tape worm style\"; term was particularly used in the cities of Dresden and Berlin. See also the related \"Schnörkelstil.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bandwurmstil"@en .

aat:300375734 a skos:Concept ;
    skos:definition "German term used to refer to the work of Belgian artist Henry van de Velde, meaning \"scroll style\" or \"flourish style\"; term was particularly used in the cities of Dresden and Berlin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Schnörkelstil"@en .

aat:300375735 a skos:Concept ;
    skos:definition "Refers to a Belgium variation of Art Nouveau, meaning \"eel style.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paling stijl"@en .

aat:300375736 a skos:Concept ;
    skos:definition "Refers to a Spanish variation of Art Nouveau, based on the work of a group of modernist writers and artists from Madrid; named after homonymous magazine founded by Pablo Picasso in 1901, the aim of which was to emulate Ramon Casas' magazine Pèl&Ploma (Barcelona)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arte Joven"@en .

aat:300375737 a skos:Concept ;
    skos:definition "Perjorative term for Art Nouveau coined by author Edmond de Goncourt after seeing an exhibition of Belgian artist Henry van de Velde, suggesting the style would be a suitable for pleasaure craft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yachting Style"@en .

aat:300375738 a skos:Concept ;
    skos:definition "Windows that are divided into adjacent panes with the use of mullions, which are vertical elements used to break up a space. Mullioned windows are especially associated with Gothic design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mullioned windows"@en .

aat:300375739 a skos:Concept ;
    skos:definition "Mythical creatures having a lion's body and a human head. Originating in Egypt, probably as a type of the king, the Sphinx became known early to Syrians, Phoenicians, and Mycenaean Greeks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sphinxes"@en .

aat:300375741 a skos:Concept ;
    skos:definition "Shaft-shaped iron tools terminating in a bulb, which is heated and used for smoothing the soldered lead joints of pipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grozing irons"@en .

aat:300375742 a skos:Concept ;
    skos:definition "German term for a variation of Art Nouveau; named after an English publication which promoted the works of the Arts and Crafts Exhibition Society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Studio-Stil"@en .

aat:300375743 a skos:Concept ;
    skos:definition "A variation of Art Nouveau based on French works and influenced by works of Edward Burne-Jones and William Morris; the term is particularly applied to architecture and furniture design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modern Style"@en .

aat:300375744 a skos:Concept ;
    skos:definition "Lengths of fur or furs, sewn together in a way to allow them to be wrapped and carried about the shoulders or arms. A fur stole is often the pelage or skin of a single animal (head included)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fur stoles"@en .

aat:300375745 a skos:Concept ;
    skos:definition "Balconies that are flush with or in a recess back from the surface of the exterior wall. They often have walls, sets of columns, or other supports on three sides; distinct from the general design of balconies, which are more typically set out from the surface of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recessed balconies"@en .

aat:300375746 a skos:Concept ;
    skos:definition "Receding or set back from the general surface or adjacent parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recessed"@en .

aat:300375747 a skos:Concept ;
    skos:definition "Level with the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flush"@en .

aat:300375748 a skos:Concept ;
    skos:definition "Collections of historical records and primary source documents that have accumulated over the course of an individual's or organization's lifetime, and are kept to show the function or history of the person or an organization. Documents may be tangible or digital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archives"@en .

aat:300375749 a skos:Concept ;
    skos:definition "Collections of books, periodicals, and other materials, organized to provide physical, bibliographic, and intellectual access by the public or members of a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libraries"@en .

aat:300375750 a skos:Concept ;
    skos:definition "Describes African people living in southern Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bashada"@en .

aat:300375751 a skos:Concept ;
    skos:definition "Stylized images of birds or birds' heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birds"@en .

aat:300375752 a skos:Concept ;
    skos:definition "Collections of tangible or digital materials that are unavailable for general access. Included are tangible materials preserved under optimal conditions but without public access, designed to safeguard the integrity and important artifactual characteristics of the archived materials for potential future use or uses. Also included are digital materials that are unavailable or accessible for only limited use, stored as a safeguard for disaster recovery, due to copyright restrictions, or for another reason."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark archives"@en .

aat:300375753 a skos:Concept ;
    skos:definition "Refers to formal letters intended as notice of resignation from a post, employment, political office, or other association or affiliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resignation letters"@en .

aat:300375754 a skos:Concept ;
    skos:definition "Structures comprising mounds of shattered stones and often charcoal, together with an adjacent hearth and trough. The troughs were made watertight by having been cut into the living rock and/or lined with wood or clay. Locations include Ireland, Britain, and various sites in northern continental Europe. Dates of the structures range from the Neolithic and Iron Age to the early Mediaeval period, with most dating during the span 1900-800 BCE. The shattered stone fragments are thought to be the remains of stones heated in fires, which were used to heat water in the trough for cooking, brewing, bathing, dyeing textiles, or treating leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnt mounds"@en .

aat:300375755 a skos:Concept ;
    skos:definition "Clothes or draperies customarily indicative of bereavement, often donned during a period designated for the conventional or ceremonial manifestation of sorrow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning dress"@en .

aat:300375756 a skos:Concept ;
    skos:definition "Describes prow figureheads that are neither bust figures, nor full-length figureheads, but those that terminate in a scroll rather than feet. Scroll skirts integrate into the ship stem, and give a clear, smooth profile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scroll skirts"@en .

aat:300378882 a skos:Concept ;
    skos:definition "Having the form or plan of two intersecting bars or lines of equal length, in which the intersection does not necessarily form right angles, and where the bars run diagonally across the vertical plane, that is, the base of the form rests on two arms that are not at right angles with the horizontal base plane. Resembling the letter \"X.\" Use \"cruciform\" for forms or plans having two intersecting lines or bars at right angles, whether or not the bars are of equal length, and where the base of the form is perpendicular to the horizontal plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "X-shaped"@en .

aat:300378883 a skos:Concept ;
    skos:definition "Institutions established by firms engaged in similar activities to enable them to offset transactions with one another in order to limit payment settlements to net balances. Clearinghouses play an important role in settling transactions related to banks, railroads, stock and commodity exchanges, and international payments. The first modern bank clearinghouse was established in London in 1773, although the clearinghouse idea had been applied to various forms of trade in such places as Tokyo, Florence, and Lyon many centuries earlier. The first bank clearinghouse in the United States was established in New York in 1853."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clearinghouses"@en .

aat:300378885 a skos:Concept ;
    skos:definition "Characteristics or qualities of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living organism attributes"@en .

aat:300378886 a skos:Concept ;
    skos:definition "Having, or abounding in, leaves. May also be used to describe forms resembling leaves, as with lichens and algae having bodies differentiated into stem and leaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foliose"@en .

aat:300378887 a skos:Concept ;
    skos:definition "Lines having a locus that may be conceived to be traced by a moving point, the direction of motion continuously changing or deviating from a straight line. A closed curve is a path that repeats itself, and thus encloses one or more regions; simple examples include circles, ellipses, and polygons. Open curves such as parabolas, hyperbolas, and spirals have infinite length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curves"@en .

aat:300378888 a skos:Concept ;
    skos:definition "Parts of the circumference of a circle or other curve in a two-dimensional plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arcs"@en .

aat:300378889 a skos:Concept ;
    skos:definition "Refers to the culture of people living in Oio region of northern Guinea-Bissau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oinca"@en .

aat:300378890 a skos:Concept ;
    skos:definition "Outline or form delimited by two ends that are equal and parallel circles, and the intervening curved surface is such as would be traced out by a straight line moving parallel to itself with its ends in the circumferences of these circles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylindrical"@en .

aat:300378891 a skos:Concept ;
    skos:definition "A Dutch variation of Art Nouveau, meaning \"new art\"; evident 1892/1910, mainly in and around The Hague. It is seen in various substyles, called constructive, decorative, and constructive-decorative. A distinctive characteristic of Nieuwe Kunst is the focus on rationalism, by which ornament is subordinate to form and construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nieuwe Kunst"@en .

aat:300378892 a skos:Concept ;
    skos:definition "Having a shallow, concave form or outline, like the shape of a shallow dish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dished"@en .

aat:300378894 a skos:Concept ;
    skos:definition "Having a form or outline comprising two joined curves that are open in opposite directions, like the shape of the letter S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "S-shaped"@en .

aat:300378895 a skos:Concept ;
    skos:definition "Having a form or outline comprising two crossed bars or lines, with one line meeting the second at a right angle in the center of the second line, resembling the uppercase letter T."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "T-shaped"@en .

aat:300378896 a skos:Concept ;
    skos:definition "Having the form or outline comprising two bars or lines that each meet the other at a right angle at one end, resembling the uppercase letter L."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "L-shaped"@en .

aat:300378897 a skos:Concept ;
    skos:definition "Having the shape or form of a cone, which is a geometric body for which the base is a circle, and the summit a point, and every point in the intervening surface is in a straight line between the vertex and the circumference of the base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conical"@en .

aat:300378898 a skos:Concept ;
    skos:definition "Having the shape or form of a sphere, which is a body that comprises all points in three-dimensional space lying the same distance (the radius) from a given point (the center)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spherical"@en .

aat:300378899 a skos:Concept ;
    skos:definition "Having the shape or form of a hemisphere, which is one of two portions of a sphere cut off by a plane through its center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemispherical"@en .

aat:300378900 a skos:Concept ;
    skos:definition "Having the shape or form of a cube, which is a geometric figure contained by six equal squares and eight rectangular solid angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cubic"@en .

aat:300378901 a skos:Concept ;
    skos:definition "Having the shape or form of a pyramid, which is a polyhedron having one face (the base) that is a polygon of any number of sides, and the other faces are triangles with bases forming the sides of the polygon meet at a common vertex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramidal"@en .

aat:300378902 a skos:Concept ;
    skos:definition "Refers to a German variation of Art Nouveau, named after the work of Belgian artist Henry van de Velde. As a result, the term is often used in conjunction with \"Veldesche.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgische"@en .

aat:300378903 a skos:Concept ;
    skos:definition "A variation of Art Nouveau in France, coined by architect Hector Guimard to describe his own style. Guimard was known for his Paris Métro entrances made of steel and glass and the term is often used in conjunction with \"Style Métro.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Style Guimard"@en .

aat:300378904 a skos:Concept ;
    skos:definition "Italian variation of Art Nouveau, as seen mostly prominently in architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arte Nuova"@en .

aat:300378905 a skos:Concept ;
    skos:definition "Refers to a French variation of Art Nouveau, so named for the style's imagery and emphasis on the fantastic as seen in the writings of author Jules Verne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Style Jules Verne"@en .

aat:300378906 a skos:Concept ;
    skos:definition "A Belgian variation of Art Nouveau named after the avant-garde group \"Les XX\" or \"Les Vingt,\" who were organized by lawyer Octave Maus and first exhibited in Brussels in 1884. The term is often used in conjunction with \"La Libre Esthéthique,\" as this group became the successor to Les XX after they were disbanded in 1893."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Le Style des Vingt"@en .

aat:300378907 a skos:Concept ;
    skos:definition "A Belgian variation of Art Nouveau, so-called after the exhibition of the same name, which was organized by lawyer Octave Maus in 1893. The term is often used in conjunction with \"Les Style des Vingt,\" as that group was its predecessor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "La Libre Esthétique"@en .

aat:300378908 a skos:Concept ;
    skos:definition "Refers to a Belgian variation of Art Nouveau, so named for the \"coup de fouet\" or whiplash motif common to the style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Style coup de fouet"@en .

aat:300378909 a skos:Concept ;
    skos:definition "A French variation of Art Nouveau, particularly used to describe artistic trends in various discplines such as architecture, the applied arts, and decorative arts around the turn of the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Style 1900"@en .

aat:300378910 a skos:Concept ;
    skos:definition "English variation of Art Nouveau, used primarily to describe mass-produced goods of many types, typically furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quaint Style"@en .

aat:300378911 a skos:Concept ;
    skos:definition "In geometry, a digons are polygons with two sides or edges and two vertices; pairs of vertices connected by two edges. A digon is degenerate in a Euclidean space, but may be non-degenerate in a spherical space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digons"@en .

aat:300378912 a skos:Concept ;
    skos:definition "Polygons having one edge and one vertex, considered an impossible object in Euclidean geometry. In spherical geometry, a finite henagon may be drawn by placing a single vertex anywhere on a great circle; two henagons may be used to construct a dihedron on a sphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monogons"@en .

aat:300378913 a skos:Concept ;
    skos:definition "Plane figures having seven angles and seven sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heptagons"@en .

aat:300378914 a skos:Concept ;
    skos:definition "Plane figures having nine angles and nine sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonagons"@en .

aat:300378915 a skos:Concept ;
    skos:definition "Plane figures having eleven sides and eleven angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hendecagons"@en .

aat:300378916 a skos:Concept ;
    skos:definition "Having the form or outline of a heptagon, which is a plane figure having seven angles and seven sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heptagonal"@en .

aat:300378917 a skos:Concept ;
    skos:definition "Having the form or outline of a nonagon, which is a plane figure having nine angles and nine sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonagonal"@en .

aat:300378918 a skos:Concept ;
    skos:definition "Having the form or outline of a hendecagon, which is a plane figure having eleven sides and eleven angles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hendecagonal"@en .

aat:300378919 a skos:Concept ;
    skos:definition "Refers to a Russian variation of Art Nouveau that incorporated elements of that style with Russian folk art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stil' Modern"@en .

aat:300378920 a skos:Concept ;
    skos:definition "Refers to an American variation of Art Nouveau, named after the lighting fixtures and interior designs of Louis Comfort Tiffany, which featured mosaics of opalescent glass and were based on natural forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tiffany style"@en .

aat:300378921 a skos:Concept ;
    skos:definition "A practice that addresses the role of cultural production or in the definition of physical space or its representation. The discipline of experimental geography may involve factors of human social or economic relationships rendered graphically, physically, or virtually. Products of this practice may be art objects or discursive scholarly practice, and often are a combination of these."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "experimental geography"@en .

aat:300378922 a skos:Concept ;
    skos:definition "Genus containing several species of scale insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dactylopius"@en .

aat:300378923 a skos:Concept ;
    skos:definition "Family containing two genera of scale insects found on cacti; abdomen not narrowed posteriorly; wax gland openings on dorsum; anal ring absent; wax gland ducts minute, arising from centre of cluster of sessile pores; setae stout and cut off at end. Molecular data suggest that cochineal scales are really just specialized eriococcids (Gullan and Cook 2001). These insects have been transported to all parts of the world as a potential source of red dyes, but are apparently endemic to the New World. Most occur in desert areas of the southwestern United States, Mexico, and central and South America. The true conchineal, D. coccus has been used as a source of red dyes for several centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dactylopiidae"@en .

aat:300378924 a skos:Concept ;
    skos:definition "Superfamily containing over 8,000 species of scale insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coccoidea"@en .

aat:300378925 a skos:Concept ;
    skos:definition "Suborder of insects including aphids or plant lice, phylloxerans, coccids, scales, whiteflies, and mealybugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sternorrhyncha"@en .

aat:300378926 a skos:Concept ;
    skos:definition "A collection wherein the constituent parts have in common a general subject, heading, topic, or composition, as distinguished from collections that reflect a common provenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "topical collections"@en .

aat:300378929 a skos:Concept ;
    skos:definition "Bottles, usually glass or ceramic, designed to hold medicines in an apothecary's establishment, often having matching glass stoppers or cork stoppers. The name of the contents was written on the bottles, on labels or molded into the glass. For vessels used to store medicines by an apothecary, but having wider necks and often made of ceramic, use \"drug jars.\" For smaller bottles used to store smaller household quantities of patent medicine or other medicine, use \"medicine bottles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apothecary bottles"@en .

aat:300378931 a skos:Concept ;
    skos:definition "Refers to the products of the African people living in northern Cameroon / northeastern Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Longuda"@en .

aat:300378933 a skos:Concept ;
    skos:definition "Genus containing several species of fungi that exist as asexual forms (or anamorphs) and are pathogenic (disease-causing) in humans. Aspergillus species are highly aerobic and are found in almost all oxygen-rich environments, where they commonly grow as molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aspergillus"@en .

aat:300378934 a skos:Concept ;
    skos:definition "Phylum including over 64,000 species of fungi characterized by a saclike structure, the ascus, which contains four to eight ascospores in the sexual stage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ascomycota"@en .

aat:300378935 a skos:Concept ;
    skos:definition "Order of sac fungi containing 3 families, 49 genera, and 928 species of green and blue molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eurotiales"@en .

aat:300378936 a skos:Concept ;
    skos:definition "Class of fungi having members that produce saclike structures (asci) containing ascospores in either a closed fruiting body (ascocarp) or spore balls. Best known examples of genera include Capronia (order Chaetothyriales), which includes some marine fungi, Pyrenula (order Pyrenulales), which includes wart lichens, and Eurotium (order Eurotiales), which includes species of Aspergillus for which a sexual phase of reproduction has been identified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eurotiomycetes"@en .

aat:300378937 a skos:Concept ;
    skos:definition "Family of fungi that are cosmopolitan in distribution, common in soil, and associates of decaying plant and food material, adaptable to extreme environmental conditions, and having aggressive colonization strategies. The family contains some of the most familiar fungi of the genera Penicillium and Aspergillus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trichocomaceae"@en .

aat:300378938 a skos:Concept ;
    skos:definition "Genus containing around 300 species of widespread fungi found on foodstuffs, leather, and fabrics; they are of economic importance in the production of antibiotics (penicillin), organic acids, and cheeses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Penicillium"@en .

aat:300378939 a skos:Concept ;
    skos:definition "Genus containing around 9 species of common saprobic fungi that reproduce by vegetative, asexual, and sexual methods by spores. Members are found on various plants and as specialized parasites on animals, including humans. They are found on a wide variety of organic substrates, including mature fruits and vegetables, feces, jellies, syrups, leather, bread, peanuts, and tobacco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhizopus"@en .

aat:300378940 a skos:Concept ;
    skos:definition "Order containing 12 or 13 families, 56 genera, and around 300 species of fungi characterized by being fast-growing and having wide hyphae that lack septa. Many members are best known because they cause damage to stored food and for causing mycosis in humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mucorales"@en .

aat:300378941 a skos:Concept ;
    skos:definition "Family containing contains 25 genera and around 129 species of fungi characterized by having a thallus that is not segmented or ramified. It includes the pathogenic genera Absidia, Apophysomyces, Mucor, Rhizomucor, and Rhizopus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mucoraceae"@en .

aat:300378942 a skos:Concept ;
    skos:definition "Class containing 3 orders, 61 genera, and 325 species of fungi, including rapidly-growing species, most of which are saprobes, plant pathogens, and mycoparasites, including those that induce human mycosis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mucoromycotina"@en .

aat:300378943 a skos:Concept ;
    skos:definition "Members in this phylum are subject to being moved to other phyla, due to research done in the 1990s that resulted in an improved understanding of relationships of fungi traditionally placed in the phyla Chytridiomycota and Zygomycota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zygomycota"@en .

aat:300378944 a skos:Concept ;
    skos:definition "Species of mold that is used in the making of some types of blue-veined cheese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Penicillium glaucum"@en .

aat:300378945 a skos:Concept ;
    skos:definition "Species of cosmopolitan and osmophilic fungus that is often found in house dust, plant material, and from soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aspergillus glaucus"@en .

aat:300378946 a skos:Concept ;
    skos:definition "Styles and cultures that originated in the area of southeastern France and northwestern Italy that was historically ruled by counts of Savoy from the 11th century as part of kingdom of Arles, but it eventually became independent and greatly expanded its territory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Savoyard"@en .

aat:300378947 a skos:Concept ;
    skos:definition "Painters who use the medium of encaustic paint, a paint created by mixing dry pigments with molten, refined wax and resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encaustic painters"@en .

aat:300378948 a skos:Concept ;
    skos:definition "Artists or craftspeople whose primary medium is shells, which are the hard outer coverings of invertebrate creatures such as oysters, snails, and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shellwork artists"@en .

aat:300378949 a skos:Concept ;
    skos:definition "People skilled in, or specializing in, the art of niello, which uses technique of decorating metal by engraving it with designs that are then filled with a black inlay. Prints are sometimes made from the engraved metal before inlaying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niellists"@en .

aat:300378950 a skos:Concept ;
    skos:definition "People who specialize in creating objects that are carved from or incised on ivory, which is dentine from tusked or large-toothed mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ivory carvers"@en .

aat:300378951 a skos:Concept ;
    skos:definition "People who create works executed in the medium of wax (usually bees wax), particularly those representing objects or figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wax workers"@en .

aat:300378952 a skos:Concept ;
    skos:definition "Objects made of pewter, which is an alloy of tin and lead, antimony, and copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pewterware"@en .

aat:300378953 a skos:Concept ;
    skos:definition "Metalworkers who form items of platinum, a lustrous, malleable, ductile, silvery white metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platinum workers"@en .

aat:300378954 a skos:Concept ;
    skos:definition "Classic Veracruz style and culture of Pre-Columbian art from the central-southern Gulf Coast, Mexico; named for the type site, Las Remojadas, Veracruz, which had an uninterrupted ceramic sequence from ca. 150 BCE to ca. 650 CE. The term is often applied incorrectly to ceramics of the central-southern Gulf Coast in general. Remojadas style includes distinctive pottery and hollow ceramic figurines, some of which have unusual wide smiles on triangular faces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Remojadas"@en .

aat:300378955 a skos:Concept ;
    skos:definition "Development and manufacture of objects 100 nanometers or less in size, or the manipulation of individual molecules and atoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanotechnology"@en .

aat:300378956 a skos:Concept ;
    skos:definition "Hosiery that covers the calf and thigh, having ties or garters attached at the top to hold them up at the level of the waist or crotch, worn especially in Medieval and Renaissance Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calzebrache"@en .

aat:300378960 a skos:Concept ;
    skos:definition "Species of small dioecious evergreen shrub or small tree native to the Mediterranean, growing up to 4 m (13 ft) tall; cultivated for its aromatic resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pistacia lentiscus"@en .

aat:300378962 a skos:Concept ;
    skos:definition "The resin collected from the Greek island of Chios, having the reputation for the highest quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chios mastic"@en .

aat:300378963 a skos:Concept ;
    skos:definition "The resin collected in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bombay mastic"@en .

aat:300378966 a skos:Concept ;
    skos:definition "General term for materials obtained from excretions from certain trees or shrubs. Natural resins are aromatic hydrocarbons that are generally soluble in alcohol or turpentine and insoluble in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural resin"@en .

aat:300378967 a skos:Concept ;
    skos:definition "Resin having a polymeric structure, that is, formed by a chemical reaction between two or more substances; used chiefly in plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic resin"@en .

aat:300378968 a skos:Concept ;
    skos:definition "Form of popular design or craft that began primarily in the field of home improvement, decoration repair, alteration, and conversion for reasons of cheapness and pleasure, having its peak years in the late 1950s and 60s. In recent years, the term has been used to describe a wider range of disciplines and genres, including the alternative, punk, and indie rock music scenes, radio and podcasts, and other forms of media not practiced by professional tradesmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DIY"@en .

aat:300378982 a skos:Concept ;
    skos:definition "Veils or shawls worn across the shoulders of altar servers, to cover their hands when carrying the mitre and crosier during liturgical functions and processions. For veils that are similar but larger, and worn by the priest or other celebrant, prefer \"humeral veils.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vimpae"@en .

aat:300378989 a skos:Concept ;
    skos:definition "Prints intended for viewing through special peepshow devices, giving the illusion of three-dimensionality and movement. The subjects of perspective view prints are usually views of cities, events, Biblical stories, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perspective view prints"@en .

aat:300378991 a skos:Concept ;
    skos:definition "The state or condition of a group of humans living in company with other people; the system of customs and organization adopted by a group of people for harmonious coexistence or mutual benefit. May also apply to the social life of animals that are not human."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "society"@en .

aat:300378993 a skos:Concept ;
    skos:definition "Adornments, embellishments, or ornamentation used to decorate the itnerior or exterior of a church, chapel, temple, city plaza, or other location, or the bier or coffin, where the deceased is laid out and honored during funerary rites. For ornaments worn by the deceased or attendees of the funeral, specifically designed for this purpose, use \"funeral ornaments (personal ornament).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral decorations"@en .

aat:300378995 a skos:Concept ;
    skos:definition "Decoration used to embellish parts of a building; usually in and of itself having no function, although it may decorate functional members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural ornament"@en .

aat:300378997 a skos:Concept ;
    skos:definition "Dramatic or mimic representations, usually of a light or humorous character, such as was commonly introduced between the acts of the long mystery-plays or moralities, or exhibited as part of an elaborate entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interludes"@en .

aat:300378999 a skos:Concept ;
    skos:definition "The science and discipline of designing products and processes by applying ergonomics, which is the study of and knowledge of human capabilities and limitations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human engineering"@en .

aat:300379001 a skos:Concept ;
    skos:definition "Any of various aqueous treaments to remove dirt or other unwanted surface materials. In commercial garment cleaning, the term is used interchangeably with \"green cleansing\" to describe gentle, environmentally friendly aqueous cleansing. In conservation context: washing of textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet cleaning"@en .

aat:300379002 a skos:Concept ;
    skos:definition "A yellow earth mineral that occurs naturally as an opaque crystalline material, primarily composed of iron hydroxide and varying in color from red to yellowish-brown. It is used for pigment and large clumps have also been carved for small ornamental items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goethite"@en .

aat:300379003 a skos:Concept ;
    skos:definition "Embellishments, adornments, or ornamentation, often specifically those that are temporarily put up on a holiday or another special occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorations"@en .

aat:300379004 a skos:Concept ;
    skos:definition "Generic term for ministering spirits or divine messengers known in several theologies, forming an order of spiritual beings superior to man in power and intelligence. In Jewish, Christian, Islamic, and other theologies, the attendants and messengers of the Deity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angels"@en .

aat:300379005 a skos:Concept ;
    skos:definition "In theology, evil or unclean spirits. In Christian theology, includes Satan and other fallen angels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devils"@en .

aat:300379006 a skos:Concept ;
    skos:definition "In theology, those who are doomed to or undergoing eternal punishment, condemned or consigned to hell."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damned"@en .

aat:300379007 a skos:Concept ;
    skos:definition "Incorporeal or immaterial beings, as opposed to beings having body and matter; used especially in theology. For spiritual beings who were once human or animal, see \"souls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirits"@en .

aat:300379008 a skos:Concept ;
    skos:definition "Those who are consecrated, hallowed, holy, including those consecrated by a religious rite or ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blessed"@en .

aat:300379012 a skos:Concept ;
    skos:definition "Indication in texts, databases, tables, and lists when information for the instance at hand is not determined. For information that is unavailable to the cataloger or other information provider, rather than being in general undetermined, prefer \"unavailable.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undetermined"@en .

aat:300379013 a skos:Concept ;
    skos:definition "The practice or sport of running horses in competitions of speed, in which the horse that finishes first is the winner; horses usually carry a rider astride or are pulling a conveyance with a driver. The sport is ancient, certainly predating its documentation in both four-hitch chariot and mounted (bareback) races held in the Olympic Games of Greece beginning ca. 700 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse racing"@en .

aat:300379015 a skos:Concept ;
    skos:definition "Services to commemorate the life of a person or people, usually those recently dead or on the anniversary or other occasion marking their death. Distinguished from a “funeral” in that the body of the deceased is not present and the ceremony is not necessarily religious."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memorial services"@en .

aat:300379019 a skos:Concept ;
    skos:definition "Choreographed dressage performances by mounted riders and typically set to music, particularly popular in Europe in the 16th-18th centuries. It grew out of cavalry maneuvers and Medieval tournaments. Equestrian ballets were performed outdoors or in large arenas. Costumed horsemen rode horses in patterns and conducted intricate maneuvers, including leaps and acrobatics. One of the earliest known equestrian ballets was performed in Paris for the wedding of the Duc de Joyeuse in 1581."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equestrian ballets"@en .

aat:300379024 a skos:Concept ;
    skos:definition "In the Christian calendar, the week immediately preceding Easter Sunday."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holy Week"@en .

aat:300379028 a skos:Concept ;
    skos:definition "Year designated by the Pope, during which special indulgences are granted and ceremonies held; in modern times, usually once every 25 years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holy Year"@en .

aat:300379030 a skos:Concept ;
    skos:definition "Dances in which the participants move in a circular fashion; examples are folk dances in which the dancers form a circle, and ballroom dances in which couples move in circles round the ballroom, such as a waltz or polka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round dances"@en .

aat:300379033 a skos:Concept ;
    skos:definition "Remedies to counteract the effects of a poison, toxin, or an attack of disease. Administered by mouth, intravenously, or sometimes on the skin, antidotes work by causing an opposite effect in the body, whether directly neutralizing the poison, binding to the poison to prevent its absorption, or otherwise inactivating it or blocking its action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antidotes"@en .

aat:300379037 a skos:Concept ;
    skos:definition "System of ecclesiastical or political government headed by the Pope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papacies"@en .

aat:300379039 a skos:Concept ;
    skos:definition "In the western Christian liturgical calendar, the first Sunday after Pentecost; in eastern Christianity, the Sunday of Pentecost. Instituted to honor the Holy Trinity: the Father, the Son, and the Holy Spirit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trinity Sunday"@en .

aat:300379041 a skos:Concept ;
    skos:definition "Performers who work along the streets or other public areas, typically hoping to earn tips from passersby for their performance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street entertainers"@en .

aat:300379043 a skos:Concept ;
    skos:definition "Annual carnival held in Bologna, Italy, in August, for over 500 years, celebrating the Feast of St Bartholomew and also the victory of Bolognese forces over Frederick II during the Battle of Fossalta in 1249. The carnival concluded with the city's nobles feasting on a roasted suckling pig."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Festa della Porchetta"@en .

aat:300379045 a skos:Concept ;
    skos:definition "Official ceremonial visits to a place by a dignitary, noble, pope, head of state, or other person of authority, often accompanied by a retinue in procession and ceremony, including a formal greeting by dignitaries of the visited location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visits of state"@en .

aat:300379047 a skos:Concept ;
    skos:definition "Loosely organized movement and group of landscapists, active mainly between 1825-1870, who became known for painting romanticized depictions of the American wilderness. The group was based in New York City and painted in numerous locations, though it was their works that featured the landscape of the Catskill region north of the city which gave them their name. Notable members of the school were painters Thomas Cole, Sanford Gifford, Albert Bierstadt, Worthington Whittredge, and Thomas Moran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hudson River School"@en .

aat:300379048 a skos:Concept ;
    skos:definition "Lists of the music used in a motion picture with the precise times it is meant to be played. Usually includes title, composer, and duration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cue sheets"@en .

aat:300379050 a skos:Concept ;
    skos:definition "Ceremonies joining a couple in matrimony, in which at least one of the two parties is of royal or noble birth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal weddings"@en .

aat:300379051 a skos:Concept ;
    skos:definition "Processions on horseback or with horse-drawn carriages, marking a festive or solemn occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavalcades"@en .

aat:300379052 a skos:Concept ;
    skos:definition "The act of eating the principal meal of the day, now usually taken at or after mid-day; taking dinner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dining"@en .

aat:300379053 a skos:Concept ;
    skos:definition "Customary or social occasions of taking food, typically at an approximately fixed time of day, such as breakfast, dinner, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meals"@en .

aat:300379054 a skos:Concept ;
    skos:definition "The chief meals of the day, customarily eaten about the middle of the day, although now eaten in the evening by the professional and fashionable classes. It is often a formally arranged meal generally having various courses; dinners include repasts given publicly in honor of someone or to celebrate some event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dinners"@en .

aat:300379055 a skos:Concept ;
    skos:definition "The first meals of the day, so-named because it is the meal with which a person breaks his or her overnight fast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breakfasts"@en .

aat:300379056 a skos:Concept ;
    skos:definition "Meals that are less substantial and less ceremonious than dinner, taken usually in the early afternoon; also a light meal at any time of the day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunches"@en .

aat:300379057 a skos:Concept ;
    skos:definition "Jewelry or other personal ornament that is worn by the deceased or by attendees at funerary rites, and is specifically designed for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral ornaments"@en .

aat:300379058 a skos:Concept ;
    skos:definition "Places that are imagined but do not exist in the real world, and have not existed in the past; typically derived from religious or literary traditions, including more modern video game materials. For places that are generally agreed to have existed, but for which the coordinates are unknown, use \"lost settlements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imaginary places"@en .

aat:300379063 a skos:Concept ;
    skos:definition "Assemblies of the clergy of designated ranks of a particular church, nation, province, or diocese, convened for discussing and deciding ecclesiastical affairs and regulating matters of church doctrine and discipline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synods"@en .

aat:300379066 a skos:Concept ;
    skos:definition "The quality, principle, or habit of being morally just or righteous, striving to render to each and to all what belongs to them. It is one of the four cardinal virtues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "justice"@en .

aat:300379068 a skos:Concept ;
    skos:definition "The act or condition of inflicting retributive injury or punishment in retaliation for an injury or offense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vengeance"@en .

aat:300379069 a skos:Concept ;
    skos:definition "The actions or acts of persuading or inducing a person to err in conduct or belief, particularly in the sense of causing a woman to surrender her chastity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seductions"@en .

aat:300379071 a skos:Concept ;
    skos:definition "The collective bodies of religious and lay counselors, officers, courtiers, family members, and attendants constituting the retinue of a pope. For the judicial bodies of popes, use \"papal tribunals.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal courts"@en .

aat:300379073 a skos:Concept ;
    skos:definition "Application of foil to a surface by use of heat and a die, in order to cover or to create a design or printing on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foil stamping"@en .

aat:300379075 a skos:Concept ;
    skos:definition "The state barges in which historically the Doge of Venice traveled to wed the Adriatic by dropping a ring into it on Ascension Day; also any large ships or barges that are gaily decorated and resemble the original Venetian barges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucentaurs"@en .

aat:300379077 a skos:Concept ;
    skos:definition "Women, typically of noble birth, who attend upon a queen, princess, or other royal female."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ladies-in-waiting"@en .

aat:300379078 a skos:Concept ;
    skos:definition "Events in which men ceremonially fight with, and in most traditions kill, bulls according to formal ritual in an arena for sport and public entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullfights"@en .

aat:300379080 a skos:Concept ;
    skos:definition "Acts of formal coming or going into a place, often with a procession and retinue, such as a king entering a town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial entries"@en .

aat:300379081 a skos:Concept ;
    skos:definition "Actions of taking, or the conditions of maintaining, possession or control of a land, country, building, etc., typically by military force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupations"@en .

aat:300379082 a skos:Concept ;
    skos:definition "The state of being under a legal process because of insolvency, or otherwise unable to pay debts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bankruptcy"@en .

aat:300379084 a skos:Concept ;
    skos:definition "An undue increase in the quantity of money in relation to the goods available for purchase; an inordinate rise in prices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inflation"@en .

aat:300379085 a skos:Concept ;
    skos:definition "Expiation or atonement for a crime, sin, or offence, including a release from punishment. In theology, deliverance from sin and damnation by atonement or, in Christianity, by the salvation of Christ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redemption"@en .

aat:300379088 a skos:Concept ;
    skos:definition "Those who take part in a revolution opposed to a previous revolution or reversing its results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterrevolutionaries"@en .

aat:300379091 a skos:Concept ;
    skos:definition "Meaning \"joint rule\" or \"harmonious rule,” the term refers to several political ideologies, the most prominent of which were prominent in France in the 19th century and in Mexico in the 1930s. The term was used by Alexandre Saint-Yves d'Alveydre (1842-1909) in \"La France vraie\" to describe a form of government in reaction to the emergence of anarchist ideologies and movements; this political formula would include social differentiation and hierarchy, but with collaboration between social classes. It also refers to an ideology and political movement in Mexico beginning in the 1930s, historically originating in the Roman Catholic extreme right, and violently opposed to the populist and secularist policies of the revolutionary governments in power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Synarchism"@en .

aat:300379093 a skos:Concept ;
    skos:definition "Christian holiday celebrating the birth of St. John the Baptist, held on June 24. It may include festivities, lights, and fireworks, reminiscent of the earlier feasts of Midsummers for the summer solstice, which occurs at around the same time (on a day between June 21 and 24)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint John the Baptist’s Day"@en .

aat:300379094 a skos:Concept ;
    skos:definition "In poetry, units comprising four lines of verse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quatrains"@en .

aat:300379100 a skos:Concept ;
    skos:definition "Units of length in the imperial and United States customary systems of measurement, the twelfth part of a foot, 1/36 of a yard. Derived from the Old English ince, or ynce, and from the Latin unit uncia, one-twelfth of a Roman foot, or pes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inches"@en .

aat:300379101 a skos:Concept ;
    skos:definition "Standardized linear units of measure made up of twelve inches, 1/3 of a yard; equal to 0.3048 meters. It was a unit of length in both the imperial and US customary systems of measurement; since 1959, both units have been defined as the same by international agreement. Originally the unit was based on the length of a man's foot, varying in exact length at different periods and in different countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feet"@en .

aat:300379102 a skos:Concept ;
    skos:definition "Units of length comprising 3 feet or 36 inches; by international agreement in 1959 standardized as exactly 0.9144 meters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yards"@en .

aat:300379103 a skos:Concept ;
    skos:definition "In the metric system, units of length containing 1000 meters, equal to 3280.89 feet and nearly 5/8 mile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kilometers"@en .

aat:300379104 a skos:Concept ;
    skos:definition "Any of several European units of measurement of distance, usually estimated roughly at about 3 miles but extending from 2.4 to 4.6; often occurring in poetical or rhetorical statements of distance. In English-speaking countries the land league is generally accepted as 3 statute miles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leagues"@en .

aat:300379105 a skos:Concept ;
    skos:definition "Units of distance in English-speaking countries, equal to 1760 yards or approximately 1609 meters. It is derived from Roman units of distance of 1000 paces, or approximately 1618 yards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miles"@en .

aat:300379106 a skos:Concept ;
    skos:definition "The ceremonies surrounding the sending of a deputy or representative, especially a papal legate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legations"@en .

aat:300379107 a skos:Concept ;
    skos:definition "Generous or spontaneous goodness, characterized by love, kindness, or natural affection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charity"@en .

aat:300379108 a skos:Concept ;
    skos:definition "Genre of African-influenced Brazilian percussive music, usually performed by an ensemble, known as a Bateria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batucada"@en .

aat:300379109 a skos:Concept ;
    skos:definition "Processions that take place on water, using boats and rafts rather than horses or wheeled carts for transportation, marking a festive or solemn occasion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water processions"@en .

aat:300379110 a skos:Concept ;
    skos:definition "Staged battles, often with costumes and choreography. Sometimes staged during a triumphal entry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mock battles"@en .

aat:300379111 a skos:Concept ;
    skos:definition "Items taken as spoils, remembrances, or proof of victory in battle. Examples are scalps taken from the fallen enemy and the piles of arms and armor collected and displayed after Greek and Roman military victories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trophies of war"@en .

aat:300379112 a skos:Concept ;
    skos:definition "Persons who compete, or engage in a competition; those who seek an object in rivalry with others also seeking it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "competitors"@en .

aat:300379113 a skos:Concept ;
    skos:definition "Processions associated with a wedding or other marriage ceremony. Included are processions to the place of the marriage ceremony, with either the bride or both bride and groom or both partners of the same sex, often accompanied by the wedding party. Wedding processions may take place on foot, mounted on a horse or other animal, or carried by a cart, carriage, automobile, or other conveyance. The simpler parading of the bride down the aisle of the church may also be considered a wedding procession. Also included are processions after the ceremony, as when the married couple and their entourage proceed through the town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding processions"@en .

aat:300379114 a skos:Concept ;
    skos:definition "Spirits or deities who inhabit the forest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sylvans"@en .

aat:300379115 a skos:Concept ;
    skos:definition "Cylindrical projectiles that can be propelled to a considerable height or distance by the combustion of the contents and the backward ejection of waste gases, usually giving a burst of light and used for signalling, in maritime rescue, for entertainment, and as a firework, typically giving a brilliant visual display at the apex of its ascent. For weaponized rockets, use \"missiles (weapons).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rockets"@en .

aat:300379116 a skos:Concept ;
    skos:definition "Walking, dancing, or performing other balancing skills on a tightly stretched rope, wire, or wire cable for entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tightrope walking"@en .

aat:300379118 a skos:Concept ;
    skos:definition "The practice of stealing money or other items by stealth from another person's pockets or bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickpocketing"@en .

aat:300379119 a skos:Concept ;
    skos:definition "Tradesmen who buy and sell in in large quantities (i.e., in the gross), particularly food items, including spices, dried fruits, sugar, etc., and other articles of domestic consumption, often excluding products sold in specialty stores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grocers"@en .

aat:300379120 a skos:Concept ;
    skos:definition "Evil, immoral, or wicked habits or conduct, resulting in a state of depravity or corruption of morals, and sin. The number and type of vice varies by culture. In traditional western or Christian culture, as outlined by Dante, they include pride or vanity, envy or jealousy, wrath or anger, sloth or laziness, avarice, gluttony, and lust; others could include blasphemy, indifference, and hatred."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vice"@en .

aat:300379122 a skos:Concept ;
    skos:definition "Voluntary conformity of one’s life and conduct with the principles of morality and standards of right conduct, including abstention on moral grounds from wrong-doing or vice. The virtues vary by culture. In traditional western or Christian culture, they include faith, hope, charity, prudence, justice, temperance, courage, chastity, diligence, patience, and humility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virtue"@en .

aat:300379123 a skos:Concept ;
    skos:definition "Violation of trust or confidence or an abandonment of something committed to one's charge, such as a revelation or divulging of something which it is desirable to keep secret or a treacherous giving up to an enemy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "betrayal"@en .

aat:300379125 a skos:Concept ;
    skos:definition "Military strategic plans that are large scale, of long duration, include combat operations in a given area, and incorporate a number of military operations or battles as part of a larger conflict or war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military campaigns"@en .

aat:300379127 a skos:Concept ;
    skos:definition "Acts of extreme cruelty, heinousness, savage enormity, or horrible wickedness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atrocities"@en .

aat:300379129 a skos:Concept ;
    skos:definition "Actions on the part of an army to surround or hem in a town, castle, etc., with a hostile force so as to cut off approach or escape in order to cut off all outside communication, and finally to take the town or castle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sieges"@en .

aat:300379131 a skos:Concept ;
    skos:definition "Ancient French board game, popular in Europe during the Middle Ages, though said to have been derived from the Greeks. It was played with counters on a board depicting a jardin de l’oie (goose garden) and divided into compartments, in some of which a goose was depicted; other emblems included an inn, a death’s head, a bridge, and a labyrinth. The object of the game was to land one’s counter on number 63. The game was usually played for a stake, and special fines were exacted for landing on certain spaces. At the end of the 18th century, a variation of the game was called jeu de la revolution française (game of the French Revolution)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goose"@en .

aat:300379135 a skos:Concept ;
    skos:definition "Feasts in the Christian liturgical calendar devoted to the Virgin Mary, for example, the Annunciation to the Virgin, the Assumption of the Virgin, the Nativity of the Virgin, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marian feasts"@en .

aat:300379137 a skos:Concept ;
    skos:definition "Theological or religious opinion or doctrine maintained in opposition to the official or orthodox doctrine of a given church, creed, or religious system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heresy"@en .

aat:300379138 a skos:Concept ;
    skos:definition "The condition or ideal of uniformity in treatment, status, dignity, rank, or privileges, particularly as recognized by those in a society who are in a position to affect or influence these standards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equality"@en .

aat:300379141 a skos:Concept ;
    skos:definition "Four voices or instruments, particularly when having four stringed instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartets"@en .

aat:300379142 a skos:Concept ;
    skos:definition "Two string quartets, often arranged antiphonally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double quartets"@en .

aat:300379143 a skos:Concept ;
    skos:definition "Script associated with Western Europen manuscripts of the 12th century. It is a transitional script between late Carolingian and Gothic textura that assumes an oval aspect and some lateral compression of minims."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Protogothic"@en .

aat:300379144 a skos:Concept ;
    skos:definition "The action or ceremony of clothing in the insignia of an office, or other ceremonial, official, or formal investing of a person with an office or rank, including the formal putting a person in possession of a fief or benefice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "investitures"@en .

aat:300379145 a skos:Concept ;
    skos:definition "Radical partisans of the lower classes during the French Revolution; term refers to a man shabbily dressed, not wearing the breeches of the middle and upper classes of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sansculottes"@en .

aat:300379146 a skos:Concept ;
    skos:definition "Soft conical hats worn as a symbol of liberty, particularly in the French Revolution, having a shape similar to \"Phrygian caps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liberty caps"@en .

aat:300379147 a skos:Concept ;
    skos:definition "The action of asking questions, typically in a pointed or aggressive manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interrogating"@en .

aat:300379148 a skos:Concept ;
    skos:definition "Collections of equipment, instruments, machines, tools, parts, or other items used for a particular purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apparatuses"@en .

aat:300379149 a skos:Concept ;
    skos:definition "The quality of being fertile, that is, bearing or producing in abundance; the state of being fruitful or prolific."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fertility"@en .

aat:300379150 a skos:Concept ;
    skos:definition "Processions celebrating military victories. Primary examples were the large spectacles surrounding the procession of the Roman army entering the city by a dedicated gate, accompanied by captured leaders, slaves, and booty of the conquered. Later use of the phrase connotes any procession celebrating victory as is common in allegorical and symbolic visual art, especially since the Renaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triumphal processions"@en .

aat:300379151 a skos:Concept ;
    skos:definition "Scripts used for writing by the Syriac Christians from the 1st century ad until about the 14th century. Using a Semitic alphabet, it is descendent Aramaic cursive with 22 letters, all representing consonants, and was typically written from right to left, although occasionally vertically downward. Diacritical marks used to represent vowels were introduced in the 8th century and two systems of vocalization were developed, one similar to the system in Arabic, and one using small Greek letters above or below the line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syriac scripts"@en .

aat:300379152 a skos:Concept ;
    skos:definition "Rounded version of the Syriac script in almost exclusive use up until about 500 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Estrangela"@en .

aat:300379153 a skos:Concept ;
    skos:definition "Eastern form of Syriac script that remained in use in Central Asia and Siberia until the 13th or 14th century. It is seen on inscriptions on gravestones in southern Siberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nestorian"@en .

aat:300379154 a skos:Concept ;
    skos:definition "Syriac script that appeared around the 8th century CE, taking on a more cursive appearance than Estrangela. By 700 CE, Serto adopted Greek vowel letters, modifying them with diacritics typically written above the consonant letter that the vowel follows. In cases where the consonant letter takes up a lot of vertical space, the vowel diacritic can occur under it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serto"@en .

aat:300379155 a skos:Concept ;
    skos:definition "Performances encompassing two distinct minor genres, evolved from courtly entertainment: operas and serenatas. They are of abbreviated length and generally concern events such as royal weddings or birthdays. The focus is on drama, spectacle, and chorus, rather than elaborate musical composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festa teatrales"@en .

aat:300379156 a skos:Concept ;
    skos:definition "A desert breed of horse known for hardiness, stamina, and a fiery temperament. It has a powerful front end, high withers, short back, a sloping croup, and carries its tail low. It is hardy with clean legs, and small, round, sound hooves. The origins of the breed are uncertain, but it may have originated in northern Africa during the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barb horses"@en .

aat:300379157 a skos:Concept ;
    skos:definition "Ecclesiastical assemblies for which bishops and others entitled to vote are convoked from the whole world under the presidency of the pope or his legates, and through which decrees receive papal confirmation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecumenical councils"@en .

aat:300379158 a skos:Concept ;
    skos:definition "The process of setting upright or causing to stand up. For the process of lifting something into the air from the ground, use \"lifting (transporting).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raising"@en .

aat:300379159 a skos:Concept ;
    skos:definition "Semi-divine spirits who take the form of a maiden inhabiting the sea, rivers, mountains, woods, trees, or other natural places, and often portrayed in poetry as attendants on a particular god."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nymphs"@en .

aat:300379160 a skos:Concept ;
    skos:definition "Taking part in a picnic, which is a meal eaten out of doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picnicking"@en .

aat:300379161 a skos:Concept ;
    skos:definition "Meals eaten out of doors, especially when part of an excursion to the countryside, coast, or other outdoor location. Originally, a meal for which each guest contributed a share of the food; this may be true of contemporary picnics, but is not necessarily so."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picnics"@en .

aat:300379162 a skos:Concept ;
    skos:definition "Souls of deceased persons, spoken of as appearing in a visible form, or otherwise manifesting their presence, to the living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghosts"@en .

aat:300379163 a skos:Concept ;
    skos:definition "Game in which one player is blindfolded, and tries to catch and identify any one of the others, who, on their part, push him about, and make sport with him."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind man's buff"@en .

aat:300379164 a skos:Concept ;
    skos:definition "Activities and principles for preserving or promoting health."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hygiene"@en .

aat:300379165 a skos:Concept ;
    skos:definition "Activities surrounding washing and attiring oneself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilette"@en .

aat:300379166 a skos:Concept ;
    skos:definition "Tools used to pound, hammer, or tap materials to be flattened or mashed. The term is extended in particular to wooden tools used to pound the bark or bast of trees in the manufacture of bark cloth in African and Oceanic cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaters"@en .

aat:300379167 a skos:Concept ;
    skos:definition "Tournaments in which knights, divided into companies (quadrilles) and distinguished by liveries, are engaged in various plays and exercises; to this were often added chariot races, and other shows and entertainments. For specific tournaments, races, or balletic exercises involving horses, use \"equestrian ballet\" or \"horse races.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carousels"@en .

aat:300379168 a skos:Concept ;
    skos:definition "The activity of killing cattle, sheep, or other animals, usually for food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slaughtering"@en .

aat:300379169 a skos:Concept ;
    skos:definition "People who own or run art galleries, or those who promote artists by exhibiting in galleries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallerists"@en .

aat:300379170 a skos:Concept ;
    skos:definition "Competitions of speed in which horses are run, usually mounted or pulling a conveyance with driver, in which the horse that finishes first is the winner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horse races"@en .

aat:300379171 a skos:Concept ;
    skos:definition "Holidays celebrated in a local area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local holidays"@en .

aat:300379172 a skos:Concept ;
    skos:definition "Organs of the papal government that historically could hear cases, petitions, and other causes, and administer justice in civil, criminal, and ecclesiastical matters in the Vatican and other territories under papal dominion. The jurisdiction of the papacy in modern times is limited to ecclesiastical matters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal tribunals"@en .

aat:300379173 a skos:Concept ;
    skos:definition "Sports or contests involving bloodshed. Examples include hunting, cockfighting, bullfighting, and ancient gladiator games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blood sports"@en .

aat:300379174 a skos:Concept ;
    skos:definition "Sport in which a bull is first baited and, in most cases, finally slain by a swordsman. Historic fighting venues are in the Iberian Peninsula, southern France, and Hispanic America. Bullfighting traces its roots to prehistoric bull worship and sacrifice in several cultures, including Mycenaean Greece and in prehistoric cave paintings in Spain. The sport in Europe probably developed from Roman soldiers practicing rituals of the cult of Mithras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullfighting"@en .

aat:300379175 a skos:Concept ;
    skos:definition "The sport of pitting gamecocks (male chickens) to fight each other, often with metal spurs afixed to their feet; the sport was formerly was commonly practiced, but is now illegal in most countries. It was popular in ancient times in India, China, and Persia; it spread to Greece, Asia Minor, Europe, and the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cockfighting"@en .

aat:300379176 a skos:Concept ;
    skos:definition "The sport of pitting domestic dogs to fight each other; now illegal in most countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogfighting"@en .

aat:300379177 a skos:Concept ;
    skos:definition "Sporting events in the Roman Republic and Roman Empire where armed combatants called \"gladiators\" entertained audiences in violent and usually lethal confrontations with other gladiators, wild animals, and condemned criminals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gladiatorial games"@en .

aat:300379178 a skos:Concept ;
    skos:definition "The sport involving the racing of automobiles, which are self-propelled vehicles, for competition, on specially designed tracks, city streets, or roads. The first organized automobile race took place in 1887 in Paris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automobile racing"@en .

aat:300379179 a skos:Concept ;
    skos:definition "Equestrian sport in which horse-drawn vehicles raced around a track in competition; popular in the ancient Greek, Roman, and Byzantine world. Driver and horse frequently suffered serious injury and even death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chariot racing"@en .

aat:300379180 a skos:Concept ;
    skos:definition "Spectacles in ancient Rome that included chariot races and various kinds of theatrical performances, held at regular intervals in honor of any of several gods. They are distinct from the gladiatorial contests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ludi publici"@en .

aat:300379181 a skos:Concept ;
    skos:definition "European celebration centered upon the summer solstice, which takes place on an evening between June 21 and June 24. It is typically accompanied by gathering flowers and greenery, lighting of fires, and feasting. It was originally related to ancient fertility practices and ceremonies performed to ensure a successful harvest. With the advent of Christianity, St. John the Baptist's Day was set during this same period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Midsummer’s Eve"@en .

aat:300379182 a skos:Concept ;
    skos:definition "The activity or condition of resistance to or defiance of authority, or a refusal to obey orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insubordination"@en .

aat:300379183 a skos:Concept ;
    skos:definition "Revolts against a government that are less organized than an \"insurrection\" and smaller than a \"revolution,\" and that are not recognized as beligerency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "insurgencies"@en .

aat:300379184 a skos:Concept ;
    skos:definition "The study of the role of the government in the economy; the branch of economics that assesses government revenue and government expenditure of the public authorities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public finance"@en .

aat:300379186 a skos:Concept ;
    skos:definition "Executions by decapitation, or other actions of cutting off the head of a human or animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beheadings"@en .

aat:300379187 a skos:Concept ;
    skos:definition "Events comprising the apprehending or restraining of a person, usually under legal authority, in order to be questioned or prosecuted for an alleged or suspected crime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrests"@en .

aat:300379188 a skos:Concept ;
    skos:definition "Events comprising the indiscriminate and brutal slaughter of people; indescriminate butchery of animals or people in in large numbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "massacres"@en .

aat:300379190 a skos:Concept ;
    skos:definition "Loosely organized political group during the French Revolution. The Girondists advocated for the overthrow of the monarchy; ultimately they were supplanted by their rivals, the Montagnards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Girondins"@en .

aat:300379192 a skos:Concept ;
    skos:definition "Sudden and great changes in the government carried out violently or illegally, usually by a small group within the existing state establishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coups d'état"@en .

aat:300379193 a skos:Concept ;
    skos:definition "Violation by a subject of his allegiance to his sovereign or to the state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high treason"@en .

aat:300379195 a skos:Concept ;
    skos:definition "Legal exemptions from a service, obligation, or duty, or freedom from liability to taxation or other jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immunities"@en .

aat:300379197 a skos:Concept ;
    skos:definition "In economics, significant disparity in the distribution of income between individuals, groups, populations, social classes, or countries. Income inequality is a major dimension of social stratification and social class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economic inequality"@en .

aat:300379198 a skos:Concept ;
    skos:definition "Rights to property that is destined for the support of ministers of Christian religion or of an ecclesiastical office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benefices of clergy"@en .

aat:300379207 a skos:Concept ;
    skos:definition "Certain chieftans or other leaders, originally of aboriginal peoples of the West Indies, Mexico, and elswhere in America, later also applied to European leaders in these areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caciques"@en .

aat:300379215 a skos:Concept ;
    skos:definition "Series of colored arcs that can appear when light, usually from the sun, interacts with water. Colors emerge as distinct bands after light in the water goes through a process of refraction, dispersal, reflection, and refraction again."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rainbows"@en .

aat:300379217 a skos:Concept ;
    skos:definition "Groups comprising two people united by love, marriage, betrothal, or sexual union. To specify people joined by marriage, use \"spouses.\" For people who cohabitate, use \"domestic partners.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "couples"@en .

aat:300379219 a skos:Concept ;
    skos:definition "The action of renouncing past deeds and vowing to undertake reform in the future. In religious contexts as remorse for past sins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repentance"@en .

aat:300379223 a skos:Concept ;
    skos:definition "Standard measurement of the weight of gemstones, equal to 0.200 grams. Until 1913, the carat's weight varied in different countries, generally defined around 3.17 grains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carats"@en .

aat:300379224 a skos:Concept ;
    skos:definition "Measurement of the fineness of gold. The gold karat expresses the proportion of pure gold and is equal to 1/24 part of gold in an alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karats"@en .

aat:300379225 a skos:Concept ;
    skos:definition "In the Metric System, units of mass or weight used especially in the centimeter-gram-second system of measurement. One gram is equal to 0.001 kilogram."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grams"@en .

aat:300379226 a skos:Concept ;
    skos:definition "Metric units of mass equal to about 2.205 pounds. One kilogram is approximately equal to the weight of 1000 cubic centimeters of water. The kilogram is the base unit of mass in the International System of Units (SI) (the Metric system); defined as being equal to the mass of the International Prototype of the Kilogram. It is the only SI unit that is still directly defined by an artifact rather than a fundamental physical property that can be reproduced in different laboratories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kilograms"@en .

aat:300379228 a skos:Concept ;
    skos:definition "Units of weight, in Great Britain legally equal to 2240 lbs and in the United States and elsewhere, equal to 2000 lbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tons"@en .

aat:300379229 a skos:Concept ;
    skos:definition "Units of weight equal to 1/16 of a pound avoirdupois (approximately 28 grams). Originally equaled 1/12 of a pound in troy and apothecaries' measure, equal to 480 grains (approx. 31.1 grams)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ounces"@en .

aat:300379230 a skos:Concept ;
    skos:definition "Crescent-shaped knives with a handle set transversely, used by leatherworkers and for other purposes. This type of knife was known in ancient Egypt and other early civilizations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moon knives"@en .

aat:300379231 a skos:Concept ;
    skos:definition "Units of land area equal to 4,840 square yards (0.405 hectare). Originally, a measure of land that a yoke of oxen could plough in one day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acres"@en .

aat:300379232 a skos:Concept ;
    skos:definition "Poles, rods, sticks, or stakes placed in a horizontal position and used for any of various purposes, typically as a prop or support. Examples include bars provided as resting places for birds, rods supporting the body of a cart, bars on which to hang clothes or other things, and bars over which pieces of cloth or leather are secured for working."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perches"@en .

aat:300379233 a skos:Concept ;
    skos:definition "Metric units of square measure, equal to 100 ares, which is 2.471 acres or 10,000 square meters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hectares"@en .

aat:300379234 a skos:Concept ;
    skos:definition "Measurements of length equal to 5.5 yards, 16.5 feet, or about 5.03 meters. Also used as area measurements where square rods are equal to 30.25 square yards or about 25.3 square meters. Rods are also called poles or perches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rods"@en .

aat:300379235 a skos:Concept ;
    skos:definition "Measurements of length equal to 0.001 inch or 0.0254 mm. Specifically used for measuring thickness of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mils"@en .

aat:300379236 a skos:Concept ;
    skos:definition "Old measurements of length equal to 6 feet or about 1.83 meter. Specifically used to measure the depth of water. Also used as measurements of volume equivalent to 6 cubic feet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fathoms"@en .

aat:300379237 a skos:Concept ;
    skos:definition "Units of weight equal to 1,000 kilograms, around 2204.6 pounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metric tons"@en .

aat:300379239 a skos:Concept ;
    skos:definition "Measurements of time equal to 1/60 part of a minute or 1/3600 part of an hour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seconds"@en .

aat:300379240 a skos:Concept ;
    skos:definition "Units of time equal to 60 seconds or 1/60 of an hour."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minutes"@en .

aat:300379241 a skos:Concept ;
    skos:definition "Measurements of time equal to 60 minutes, 3600 seconds, or 1/24th of a solar day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hours"@en .

aat:300379242 a skos:Concept ;
    skos:definition "Units of time equivalent to the 24-hour time interval between midnights, or the period of one full rotation of the Earth on its axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "days"@en .

aat:300379243 a skos:Concept ;
    skos:definition "Units of time equivalent to the seven-day period from Sunday to Saturday."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weeks"@en .

aat:300379244 a skos:Concept ;
    skos:definition "Units of time equivalent to nearly 365.25 days, 12 months, or the period of one full circuit of the Earth around the Sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "years"@en .

aat:300379245 a skos:Concept ;
    skos:definition "Units of time equal to approximately 1/12th of a year or the 4-week time period of one full circuit of the Moon around the Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "months"@en .

aat:300379246 a skos:Concept ;
    skos:definition "Time units equal to a 10-year length of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decades"@en .

aat:300379247 a skos:Concept ;
    skos:definition "Units of time equal to 100-year periods; more specifically, around the Christian era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centuries"@en .

aat:300379248 a skos:Concept ;
    skos:definition "Time periods of 1000 years; more specifically, of the Christian era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "millennia"@en .

aat:300379254 a skos:Concept ;
    skos:definition "In avoirdupois measure, standardized units of weight and mass equal to 16 ounces (7000 grains, exactly 0.45359237 kg). The pound was originally made up of 12 ounces, as in the system of troy weight which is still used in stating the weight of precious metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounds"@en .

aat:300379255 a skos:Concept ;
    skos:definition "Metric measurements of length equivalent to 10 centimeters or 0.1 meter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decimeters"@en .

aat:300379256 a skos:Concept ;
    skos:definition "In architecture, measurements of height equivalent to one story."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stories"@en .

aat:300379257 a skos:Concept ;
    skos:definition "Style of Maya pottery painting in which figures and objects are drawn in black on a cream slip in a way suggesting their affiliation with contemporaneous, now lost, painted manuscripts; exemplified by a group of cylindrical vessels. The term is also used for wall paintings in this style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "codex-style"@en .

aat:300379258 a skos:Concept ;
    skos:definition "Distinctive grafitti that serves as the signature of the maker and marks the boundaries of a gang's territory in an urban area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "placas"@en .

aat:300379259 a skos:Concept ;
    skos:definition "Sketchbooks in which graffiti artists develop ideas, practice tags, and acquire other artists’ signatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black books"@en .

aat:300379260 a skos:Concept ;
    skos:definition "Books recording lists of any of various types, including expenditures, financial administration, laws, or names and contact information; the term is derived from the books originally having been typically bound in simple black binding. Examples include ledgers relating to finance or administration; codes of rules, such as those relating to maritime law; the names of people liable to censure or punishment; and address books recording names and contact details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black books"@en .

aat:300379261 a skos:Concept ;
    skos:definition "Small pellet bells having a short, light ringing sound, or a succession of such sounds. For larger pellet bells making a louder sound, use \"sleigh bells.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jingle bells"@en .

aat:300379262 a skos:Concept ;
    skos:definition "Hairstyles worn on the face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facial hairstyles"@en .

aat:300379263 a skos:Concept ;
    skos:definition "Hair growing on the human face, particularly on the chin and cheeks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beards"@en .

aat:300379264 a skos:Concept ;
    skos:definition "Facial hair grown in varied shapes on the upper lip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moustaches"@en .

aat:300379265 a skos:Concept ;
    skos:definition "Side-whiskers; more specifically, large and worn with moustaches. Named after the U.S. Civil War general Burnside who popularized this style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sideburns"@en .

aat:300379266 a skos:Concept ;
    skos:definition "Small beards shaped like a pointed tuft on the chin, similar to the beards of he-goats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goatees"@en .

aat:300379267 a skos:Concept ;
    skos:definition "Tuft-like beards grown underneath the lower lip, resembling the beard style of the French emperor Napoleon III."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperials"@en .

aat:300379268 a skos:Concept ;
    skos:definition "Short new-sprung beards close to the unshaven look, but often shaped and cultivated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stubble"@en .

aat:300379269 a skos:Concept ;
    skos:definition "Pointed shortly-trimmed beards named for the Flemish painter Van Dyck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vandykes"@en .

aat:300379270 a skos:Concept ;
    skos:definition "The appearance of subtle beard growth on men's faces, imparting an unshaven look. For more advanced facial hair growth, often trimmed and stylized, use 'stubble.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "five-o’clock shadows"@en .

aat:300379271 a skos:Concept ;
    skos:definition "Large moustaches with curved ends similar to the shape of a bicycle's handlebars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handlebar moustaches"@en .

aat:300379272 a skos:Concept ;
    skos:definition "Long bristly moustaches sagging down at the ends, similar to the moustaches of walruses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walrus moustaches"@en .

aat:300379273 a skos:Concept ;
    skos:definition "Large groomed moustaches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mustachios"@en .

aat:300379274 a skos:Concept ;
    skos:definition "The hair grown on the sides of a man's face extending the hairline along the cheeks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiskers"@en .

aat:300379275 a skos:Concept ;
    skos:definition "Side-whiskers which are narrow at the ears and round at the ends, widening along the jaw and resembling the shape of mutton chops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muttonchops"@en .

aat:300379276 a skos:Concept ;
    skos:definition "Long bushy whiskers named after the sideburns of the actor Edward A. Sothern who played the character of Lord Dundreary in T. Taylor's comedy \"Our American Cousin\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dundrearies"@en .

aat:300379277 a skos:Concept ;
    skos:definition "Areas of jurisdiction of a prince-bishop, who is a bishop of noble rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prince-bishoprics"@en .

aat:300379278 a skos:Concept ;
    skos:definition "People having princely or noble rank who also hold the authority of a bishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prince-bishops"@en .

aat:300379279 a skos:Concept ;
    skos:definition "Activity involving the execution of precise movements by a horse in response to its rider, where the horse has been trained in specific types of obedience and deportment. Horse and rider are expected to precisely and harmoniously execute a wide range of maneuvers, ranging from the simplest riding gaits to the most intricate and difficult airs and figures. Classical dressage is believed to be an ancient art that evolved from cavalry movements and training for the battlefield. From this, competitive dressage developed into a modern equestrian sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressage"@en .

aat:300379280 a skos:Concept ;
    skos:definition "Performances and displays on a large scale that are specially prepared or arranged for viewing, usually by the public, with the intent of forming an impressive or interesting show or entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectacles"@en .

aat:300379281 a skos:Concept ;
    skos:definition "Divisions or areas designated for the management, utilization, and conservation of forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest management districts"@en .

aat:300379282 a skos:Concept ;
    skos:definition "Structures or complexes serving as a base of operations for rangers or other wardens of a forest, and typically also accessible to the public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ranger stations"@en .

aat:300379283 a skos:Concept ;
    skos:definition "Branch of forestry concerned with the overall administrative, economic, legal and social matters regarding the protection and regulation of forests for wildlife, recreation, aesthetics, preventing fire, and harvesting of wood products, with the aim of balancing conservation and economics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest management"@en .

aat:300379284 a skos:Concept ;
    skos:definition "Wardens of a national or state park or forest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rangers"@en .

aat:300379285 a skos:Concept ;
    skos:definition "The science of planning and overseeing the preservation, maintenance, use, and development of land, often public land, including the wildlife habitats, plant and animal species, timber, minerals, oil and gas, geothermal energy, recreation areas, areas of cultural importance, rivers and other water bodies, conservation and wilderness areas, open-spaces, and construction found on the land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land management"@en .

aat:300379286 a skos:Concept ;
    skos:definition "A type of garnet composed of a calcium iron silicate. Colors include yellow, red, green, brown, and black. Gemstone quality andradite is mined in the Ural Mountains, Italy, Switzerland, Norway, France, and in the United States (Arkansas and New Jersey). It is valued because of its high dispersion (separation of light into colors), which is even greater than that of diamond, and refractive index."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "andradite"@en .

aat:300379287 a skos:Concept ;
    skos:definition "Bright green variety of andradite having a brilliant luster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demantoid"@en .

aat:300379289 a skos:Concept ;
    skos:definition "Species of medium to large podocarp tree endemic to New Zealand throughout the North Island and northeastern South Island in lowland, montane and lower subalpine forest at elevations of up to 600 m."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Podocarpus totara"@en .

aat:300379290 a skos:Concept ;
    skos:definition "Staff weapons of the Maori."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pouwhenua"@en .

aat:300379291 a skos:Concept ;
    skos:definition "General term for greenstone found on South Island, New Zealand. The term refers to any of three different types of stone: nephrite, bowenite, and serpentinite. Maori do not classify pounamu by geological origin, but by appearance according to color, markings, and translucency. There are many local names for different pounamu, but four main varieties are widely recognized: inanga, kahurangi, kawakawa, and tangiwai."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pounamu"@en .

aat:300379292 a skos:Concept ;
    skos:definition "Maori pounamu stone that is paler than other varieties, often of a pearly-white or gray-green nephrite, ranging from translucent to opaque. It can change color over time, developing a light-olive tint as it ages and oxidizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inanga"@en .

aat:300379294 a skos:Concept ;
    skos:definition "Species of small tree containg several subspecies endemic to New Zealand on North Island, Lord Howe Island, Norfolk Island, and the Kermadec Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Piper excelsum"@en .

aat:300379295 a skos:Concept ;
    skos:definition "Surgical reconstruction or replacement of a joint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arthroplasty"@en .

aat:300379296 a skos:Concept ;
    skos:definition "Maori walking sticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tokotoko"@en .

aat:300379297 a skos:Concept ;
    skos:definition "Fiber product used by Maori in weaving. It is prepared by scrapping, pounding and washing New Zealand flax, which are plants of the Phormium genus, not true flax. Muka is a key material in Maori traditional textiles where it is usually used in tāniko or twined weaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muka"@en .

aat:300379298 a skos:Concept ;
    skos:definition "Rarest variety of Maori pounamu stone; usually a variety of nephrite, it is highly translucent and often comes in vivid shades of green."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kahurangi"@en .

aat:300379299 a skos:Concept ;
    skos:definition "Carved heads or faces, usually having fierce expressions, exagerated features, and bulbous eyes. Examples are faces of ancestors located on Maori meeting houses. For faces carved with a more realistic appearance, used for gables of houses or canoes, use parata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koruru"@en .

aat:300379300 a skos:Concept ;
    skos:definition "Long timbers on a Maori threshold, usually having the front surface carved. The paepae roa extends across the front of the porch with a piece usually cut away in front of the door to facilitate access."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paepae roa"@en .

aat:300379302 a skos:Concept ;
    skos:definition "The teeth of a shark, which is any fish of the order Selachii. Sharks continually shed and replace their teeth during life, thus some may shed up to 35,000 teeth in a lifetime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shark teeth"@en .

aat:300379303 a skos:Concept ;
    skos:definition "Freestanding carved full-length human figures, usually at the front apex of a Maori house and named after an ancestor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tekoteko"@en .

aat:300379305 a skos:Concept ;
    skos:definition "Maori war adzes, used mainly as ceremonial objects rather than in war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toki poutangata"@en .

aat:300379306 a skos:Concept ;
    skos:definition "Maori adzes, used for war, ceremonial purposes, or for building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toki"@en .

aat:300379307 a skos:Concept ;
    skos:definition "The most common variety of Maori pounamu stone that comes in many shades, from strong rich green to dark green; often a translucent nephrite. It is often characterized by small dark inclusions, which is considered an addition to its character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kawakawa"@en .

aat:300379308 a skos:Concept ;
    skos:definition "Variety of Maori pounamu stone that is clear like glass, and ranges in color from olive-green to bluish-green. It is the stone used earliest as pounamu. The composition is typically bowenite rather than nephrite. Most tangiwai is comes from two isolated areas at Piopiotahi (Milford Sound)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tangiwai"@en .

aat:300379309 a skos:Concept ;
    skos:definition "A type of serpentine that is soft, coarse-grained, with a dull, waxy color. Antigorite was used in Egypt in the Pharaonic period for small vessels, amulets, and scarabs. It is named after the community of Antigorio, Italy, site of the specimen that was first described."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antigorite"@en .

aat:300379310 a skos:Concept ;
    skos:definition "A type of serpentine that is hard, compact, and translucent, resembling nephrite. It was a favorite of Chinese carvers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowenite"@en .

aat:300379311 a skos:Concept ;
    skos:definition "Cord drills of a style unique to the Maori; used to create holes in hard materials such as basalt, pounamu (New Zealand greenstone) or bone. The holes were made by applying downward pressure and a twirling motion by pulling cords, creating friction at the drill point to bore through solid material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pirori"@en .

aat:300379312 a skos:Concept ;
    skos:definition "A type of fine-grained, platy serpentine that is mottlish yellow with dark gray or black patches. The name refers to its resemblance to a snake's skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lizardite"@en .

aat:300379314 a skos:Concept ;
    skos:definition "Maori style or period, 1100-1300."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ngä Käkano"@en .

aat:300379315 a skos:Concept ;
    skos:definition "Maori style or period, 1300-1500."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Te Tipunga"@en .

aat:300379316 a skos:Concept ;
    skos:definition "Maori ornamental hair combs made of whale bone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heru"@en .

aat:300379317 a skos:Concept ;
    skos:definition "Masks used during dance performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance masks"@en .

aat:300379318 a skos:Concept ;
    skos:definition "Braided cordage made from strands of hemp or grass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sennit"@en .

aat:300379319 a skos:Concept ;
    skos:definition "Genus of containing roughly 600-700 known dioecious trees and shrubs native to Malaysia, tropical Africa, and Australasia. They resemble palms but are not closely related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pandanus"@en .

aat:300379320 a skos:Concept ;
    skos:definition "Short-bladed hand weapons made of greenstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mere pounamu"@en .

aat:300379321 a skos:Concept ;
    skos:definition "Species of shrub or small tree found in regions of Africa, the Americas, southern Asia, and Australasia. extremely tough and durable. In New Zealand its heavy wood is traditionally used by the Maori for making weapons, ax handles, walking sticks, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dodonaea viscosa"@en .

aat:300379322 a skos:Concept ;
    skos:definition "Motif found in Maōri art depicting an unfurling fern frond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koru"@en .

aat:300379323 a skos:Concept ;
    skos:definition "General term for traps designed to catch fish, lobster, or other animals living in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish traps"@en .

aat:300379324 a skos:Concept ;
    skos:definition "Species of shrub-like plant, know in several cultivated varieties; having white to rose-red flowers and gray-green to brownish leaves. The stems are used in basketry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Leptospermum scoparium"@en .

aat:300379325 a skos:Concept ;
    skos:definition "Wooden wind instruments of the Maori, made from two split pieces of wood, hollowed, and bound together. At one end is a mouth piece through which the performer exhales into, while at the other extremity is either a solid end-point, or a small pierced hole. The putorino has no series of note-stops, but rather a single oval aperture in the centre of the instrument, usually forming the mouth of a carved face, which the performer uses to regulate the sound. The putorino has a feminine voice representing the female ancestor Hineraukatauri, who pesonifies flute music. It's sound has been described as the sound of water being poured from a gourd, 'Me te wai e utuutu ana'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "putorino"@en .

aat:300379326 a skos:Concept ;
    skos:definition "The first of three upright posts that support the tāhuhu (ridge pole) of a large whare tupuna (ancestral house) or whare runanga (tribal council house), providing structural stability and supporting the roof. They usually incorporate carved figures, often a significant ancestor of the tribe. When seen in museums today, the figures have usually been sawn off the pole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pou tokomanawa"@en .

aat:300379328 a skos:Concept ;
    skos:definition "General term for sculpture that is carved from or applied to surfaces of architectural members, usually exterior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural sculpture"@en .

aat:300379329 a skos:Concept ;
    skos:definition "Maori kinetic percussion instruments comprising light circular balls attached to a cord that is twirled with the twist of the wrists in combinations of movements, around and against the hands and body. The are used as visul and rhythmic accompaniments in Māori cultural song and dance performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poi"@en .

aat:300379330 a skos:Concept ;
    skos:definition "Species of densely branched, brittle, woody climber native to New Zealand; leaves are used in Māori weaxing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Freycinetia banksii"@en .

aat:300379331 a skos:Concept ;
    skos:definition "Coastal sedge endemic to New Zealand; its fibers are used by Māori in weaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ficinia spiralis"@en .

aat:300379332 a skos:Concept ;
    skos:definition "Extinct species of wattlebird, formerly endemic to the North Island of New Zealand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heteralocha acutirostris"@en .

aat:300379333 a skos:Concept ;
    skos:definition "Fine Maori cloaks, formerly among the most prestigious of garments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaitaka"@en .

aat:300379334 a skos:Concept ;
    skos:definition "A unique Māori variation of whatu (twining); may be used to weave the colorful, intricate borders of cloaks. Māori weavers developed tāniko by introducing coloured horizontal threads to the whatu twining technique. They worked out that they could combine full and half twists to bring one or another colour to the front. In this way, they could create intricate geometric patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tāniko"@en .

aat:300379336 a skos:Concept ;
    skos:definition "Maori woven baskets or bags made of flax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kete"@en .

aat:300379337 a skos:Concept ;
    skos:definition "Tea services designed to fit into a special box or carrying case, intended to be portable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traveling tea services"@en .

aat:300379338 a skos:Concept ;
    skos:definition "Botanically, a berry, more or less globular, within the juicy pulp of which lie the seeds, derived from the deciduous woody vines of the botanical genus Vitis; grapes range in colors from black, purple, reddish, amber, and green. Grapes can be eaten fresh, dried, or fermented to make wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grape"@en .

aat:300379340 a skos:Concept ;
    skos:definition "Vases designed for or used to hold offerings of food, libations, or flowers at a grave or tomb. Examples include those from ancient Egypt, Greece, Rome, and China, where they were often designed in pairs. They remain common as flower receptacles in modern cemeteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave vases"@en .

aat:300379341 a skos:Concept ;
    skos:definition "Clothing designed for or worn by men; often used in commercial contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menswear"@en .

aat:300379343 a skos:Concept ;
    skos:definition "Removal of stains from textiles and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stain removal"@en .

aat:300379344 a skos:Concept ;
    skos:definition "Clothing designed for or worn by women; often used in commercial contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "womenswear"@en .

aat:300379345 a skos:Concept ;
    skos:definition "The hair or hair-and-skin of the moose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moose hair"@en .

aat:300379346 a skos:Concept ;
    skos:definition "Women who sell fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishwives"@en .

aat:300379348 a skos:Concept ;
    skos:definition "Clothing designed for or worn by children; often used in commercial contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "childrenswear"@en .

aat:300379349 a skos:Concept ;
    skos:definition "Members of common society having civic rights, includng a burgess, citizen, or any other below below the rank of a peer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commoners"@en .

aat:300379350 a skos:Concept ;
    skos:definition "A thin layer of gold or other metal that has been applied as a decorative surface finish, whether the metal was applied as a thin leaf, by electroplating, or as a thin paint layer. Examples of gilding include that applications on paintings, furniture, frames, sculptures, and the edges of pages of books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gilding"@en .

aat:300379351 a skos:Concept ;
    skos:definition "Sharp, horny, narrow, arched structures on the digits of birds, reptiles, many mammals, and some amphibians. Claws are composed of hardened (keratinized) modifications of the epidermis. Claws may be adapted for scratching, clutching, digging, or climbing. The term is also used for similar structures on the feet of insects, crustacea, and other lower animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "claws"@en .

aat:300379353 a skos:Concept ;
    skos:definition "Instruments or weapons having three prongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tridents"@en .

aat:300379354 a skos:Concept ;
    skos:definition "High-frequency electromagnetic waves with wavelengths between one meter and 30 centimeters. Microwaves have many applications including communications, heating, radar, astronomy, and navigation. In conservation, microwave radiation has been used for dehydrating water-logged materials and for pest control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microwaves"@en .

aat:300379355 a skos:Concept ;
    skos:definition "Thin sheets peeled from the inner bark of the birch tree and prepared by drying and treating with oil. Used as a material used as a textile, writing paper and other purposes in India and the Far East from at least the 2nd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birch bark"@en .

aat:300379356 a skos:Concept ;
    skos:definition "Procedures to make a material safe from damage by moths; an example is the use of chemical agents to repel moths from textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mothproofing"@en .

aat:300379357 a skos:Concept ;
    skos:definition "Excavations or systems of excavations for the extraction of flint, which is a dark gray or black variety of chert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flint mines"@en .

aat:300379358 a skos:Concept ;
    skos:definition "Damage caused by water. Usage often refers to water damaged library materials and buildings, and includes but is not limited to flood damage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water damage"@en .

aat:300379360 a skos:Concept ;
    skos:definition "A combination of wax and resin used as a preservative, adhesive, and in thermal transfer technologies. In the conservation of paintings, it has been used reinforce works by applying a paper or fabric lining attached with a wax-resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wax-resin"@en .

aat:300379361 a skos:Concept ;
    skos:definition "Archaeological sites that accomodate tourism and public use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological parks"@en .

aat:300379362 a skos:Concept ;
    skos:definition "Refers to the use of a buffering agent to stabilize acidity or alkalinity. In the context of conservation, this action is often applied to prevent damage due to acidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buffering"@en .

aat:300379363 a skos:Concept ;
    skos:definition "Describes the culture or style of Roman artifacts whose provenance is from within the borders of modern Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romano-German"@en .

aat:300379364 a skos:Concept ;
    skos:definition "Originally applied works of metal, but also used for works in plastic, glass, or other similar materials, pieces of design that are created separately and intended to be attached to the main visual work or other object. For works of textile, prefer \"appliqué (visual works).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appliqué"@en .

aat:300379366 a skos:Concept ;
    skos:definition "An act of documentation via photography to record the conditon or state of an object or the status of a project. Examples include excavations or art conservation treatments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photodocumentation"@en .

aat:300379368 a skos:Concept ;
    skos:definition "Reinterment. In conservation context, refers to reburial of human remains or cultural artifacts unearthed or exposed during excavation. Motivations for reburial may be ethical in nature (as with regard to what was purposely buried) or protective (e.g. the reburial of an ancient mosaic pavement exposed to the elements). For the filling in of earth removed, use \"backfilling.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reburial"@en .

aat:300379369 a skos:Concept ;
    skos:definition "Refilling of an excavation with the earth removed. For reinterment of human remains or artifacts removed or exposed in course of excavation, use \"reburial.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backfilling"@en .

aat:300379370 a skos:Concept ;
    skos:definition "Describes the maintenance, preservation, and conservation of collection materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collections care"@en .

aat:300379371 a skos:Concept ;
    skos:definition "Describes all interventions pursued by architectural conservators to preserve the integrity of built objects, directed toward the long-term safekeeping of architectural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural conservation"@en .

aat:300379372 a skos:Concept ;
    skos:definition "Detailed examination principles and empirical processes of discovery and demonstration considered characteristic of scientific investigation, generally involving the observation, formulation of a hypothesis, experimentation, and development of a conclusion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific analysis"@en .

aat:300379376 a skos:Concept ;
    skos:definition "Emergency measures taken by archaeologists to survey, excavate, and salvage at sites imminently threatened by land modification projects such as roads, buildings, and reservoir construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rescue archaeology"@en .

aat:300379377 a skos:Concept ;
    skos:definition "Past restoration, preservation, or conservation process, especially as it affects present condition and appearance of artifacts and their future treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "previous intervention"@en .

aat:300379378 a skos:Concept ;
    skos:definition "Study of the development of technology over time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history of technology"@en .

aat:300379379 a skos:Concept ;
    skos:definition "Study of the development over time of the discipline of conservation science."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history of conservation"@en .

aat:300379380 a skos:Concept ;
    skos:definition "Ecological monitoring of air, water, land to infer quality of an environment and to evaluate the impact of factors such as pollution and other potentially harmful effects of human activity. In a preventive conservation and conservation of cultural heritage context this includes the measuring, recording, and interpretation of relative humidity (RH), temperature, ultraviolet and visible light levels, pests, and both gaseous and particulate pollutants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental monitoring"@en .

aat:300379381 a skos:Concept ;
    skos:definition "Management of cultural heritage and other protected sites (natural as well as man-made environments) which may include, but is not limited to, securing and maintenance of the site; ensuring its sustainability; outreach, tourism, and education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site management"@en .

aat:300379382 a skos:Concept ;
    skos:definition "Baby goats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kids"@en .

aat:300379383 a skos:Concept ;
    skos:definition "Analysis of a sample of some material by any means to determine and quantify its elemental composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elemental analysis"@en .

aat:300379384 a skos:Concept ;
    skos:definition "Manufactured fiber made wholly or in part from metal, sometimes consisting of a textile fiber core wound with a metal thread or strip."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metal thread"@en .

aat:300379385 a skos:Concept ;
    skos:definition "Branch of site management dedicated to the safeguarding of cultural heritage and other sites; including natural environments such as park lands and aquifers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site protection"@en .

aat:300379386 a skos:Concept ;
    skos:definition "Administrative efforts to preserve and present cultural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heritage management"@en .

aat:300379388 a skos:Concept ;
    skos:definition "Being in existence at this time; although the time frame varies depending upon context, the term generally refers to a person, place, thing, or event dating no earlier than 75 years from the present time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern"@en .

aat:300379389 a skos:Concept ;
    skos:definition "Having relatively little extension between opposite surfaces; of little thickness or depth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thin"@en .

aat:300379390 a skos:Concept ;
    skos:definition "Having relatively great extension between the opposite surfaces or sides; of comparatively large measurement through."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thick"@en .

aat:300379391 a skos:Concept ;
    skos:definition "Parts or subdivisions separated or divided off from the remainder; portions into which a thing is cut or divided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sections"@en .

aat:300379393 a skos:Concept ;
    skos:definition "Existing, constituted, or carried on between different nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "international"@en .

aat:300379394 a skos:Concept ;
    skos:definition "Existing, constituted, or carried on within a given nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national"@en .

aat:300379395 a skos:Concept ;
    skos:definition "Existing, constituted, or carried on within a small area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local"@en .

aat:300379396 a skos:Concept ;
    skos:definition "The action of working together towards the same end, purpose, or effect, as in a joint operation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cooperation"@en .

aat:300379397 a skos:Concept ;
    skos:definition "The action of clashing or being in a state of variance between opposed principles, statements, arguments, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conflict"@en .

aat:300379398 a skos:Concept ;
    skos:definition "In the context of art and cultural heritage, the process of making an image or images, including all depictions and representations in two or three dimensions of an object, building, person, animal, plant, place, or phenomenon, whether the optical counterpart exists in reality or only in imagination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "image-making"@en .

aat:300379399 a skos:Concept ;
    skos:definition "Sum of money or its equivalent that is paid or payable, usually in return for goods or services, or in discharge of a debt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "payment"@en .

aat:300379401 a skos:Concept ;
    skos:definition "Governing principles that serve as guidelines for decision-making and action in preservation and conservation of cultural heritage. Concept covers collection materials in institutional context as well as governmental policy set at civic, regional, or national level for built objects and other historic landmarks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation policy"@en .

aat:300379402 a skos:Concept ;
    skos:definition "Philosophical principles underlying and guiding approaches chosen for conservation of monuments, sites, and objects.The ethics and values regulating conservation practice fall under this heading."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation philosophy"@en .

aat:300379403 a skos:Concept ;
    skos:definition "Method of obtaining infrared spectra absorption, emission, photoconductivity or Raman scattering solids, liquids or gas by first collecting an interferogram of a sample signal using an interferometer, and then performing a Fourier Transform (FT) on the interferogram to obtain the spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fourier transform infrared spectroscopy"@en .

aat:300379405 a skos:Concept ;
    skos:definition "Any substance introduced into a deteriorated or otherwise fragile material where it strengthens and stabilizes parts into a whole, solid, or compact mass. In the conservation of sculpture, stone that has lost cohesive strength must be reinstated by the introduction of a consolidant. Materials used in this context may include epoxy, silicates, or acrylics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consolidant"@en .

aat:300379406 a skos:Concept ;
    skos:definition "A branch of archaeology that reconstructs prehistoric interactions of human or animal populations and their environment through pollen samples, skeletal and seed remains, soil analysis and other such techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental archaeology"@en .

aat:300379407 a skos:Concept ;
    skos:definition "Any individual or group with a stake in an organization or enterprise who may be vitally effected by its actions and should be consulted or considered. Includes stockholders, financially invested parties with a governing interest, but also employees of a business and the community at large. Usage applied by practitioners of fields such as archaeology and heritage management."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stakeholders"@en .

aat:300379408 a skos:Concept ;
    skos:definition "Moral standards or principles held by a person, community, or participants in an enterprise which may philosophically inform the activities that these parties plan and undertake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "values"@en .

aat:300379409 a skos:Concept ;
    skos:definition "Degradation of a material caused by exposure to light, specifically the chemical changes to photodegradable molecules induced by absorption of photons, especially those wavelengths found in sunlight. The process by which a material is damaged due to prolonged exposure to ultraviolet radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photodegradation"@en .

aat:300379410 a skos:Concept ;
    skos:definition "Environments during a fixed period in the past, usually predating historical records and often of the remote past, as reconstructed by such disciplines as paleobotany and environmental archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleoenvironments"@en .

aat:300379411 a skos:Concept ;
    skos:definition "Climatic conditions of a particular geological epoch, also known as geologic climate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleoclimate"@en .

aat:300379412 a skos:Concept ;
    skos:definition "Branch of ecology that studies interactions between ancient plants and animals and their environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleoecology"@en .

aat:300379413 a skos:Concept ;
    skos:definition "Branch of science that studies disease in ancient organisms as revealed in prehistoric human and animal remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleopathology"@en .

aat:300379414 a skos:Concept ;
    skos:definition "The branch of botany that studies fossil plants of the geologic past."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleobotany"@en .

aat:300379415 a skos:Concept ;
    skos:definition "Diet of Paleolithic man as revealed by the archaeological record and studied by nutritional analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paleodiet"@en .

aat:300379416 a skos:Concept ;
    skos:definition "Subdiscipline of petrology which describes rocks by means of microscopic examination with the goal of classification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "petrography"@en .

aat:300379417 a skos:Concept ;
    skos:definition "Use of laser technology for cleaning material surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser cleaning"@en .

aat:300379418 a skos:Concept ;
    skos:definition "Gas chromatography–mass spectrometry (GC-MS) uses the techniques of gas- chromatography and mass spectrometry in tandem to identify substances in complex mixtures within a test sample. It is a standard tool of forensics. In conservation, GC-MS is employed to determine the presence and type of organic compounds in paintings and other artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas chromatography-mass spectrometry"@en .

aat:300379419 a skos:Concept ;
    skos:definition "A broad term applied to various printmaking processes used mainly by French engravers in the late 18th century, and which imitated the look of ink, gouache, or watercolor drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wash manner"@en .

aat:300379420 a skos:Concept ;
    skos:definition "The marks made on copperplates by steel tools when engraving or etching. Tool work can sometimes be identified (such as stipple work), however, most tool work cannot be specifically identified when examining prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tool work"@en .

aat:300379421 a skos:Concept ;
    skos:definition "Businesses, establishments, or other administrative organizations that oversee the action or process of making goods, particularly such establishments in operation after the Industrial Revolution of the mid-19th century, often employing at least some mechanical production methods rather than creating strictly handmade items. Modern factories organize their operations to meet the need for production on a large scale, usually with power-driven machinery. For earlier organizations that created handmade works, use \"manufactories.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factories"@en .

aat:300379422 a skos:Concept ;
    skos:definition "General term referring to doers of actions, including any people, corporate bodies, animals, or inanimate things that act upon something or someone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agents"@en .

aat:300379423 a skos:Concept ;
    skos:definition "The implementation of disaster planning, incident preparedness, a disaster recovery plan; and a subset of business continuity. In conservation context, interventions on behalf of structures and artifacts affected by man made or natural disaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disaster recovery"@en .

aat:300379424 a skos:Concept ;
    skos:definition "Eroded matter from preexisting rocks which is carried and deposited by water, wind, or ice, forming layers on the Earth's surface and fluvial deposits. Sedimentary rock.is composed of consolidated sediment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sediment"@en .

aat:300379425 a skos:Concept ;
    skos:definition "One of a class of organic acids marked by both an amine group and a carboxyl acid group. The 25 amino acids are the building blocks of protein and the end result of protein digestion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amino acid"@en .

aat:300379426 a skos:Concept ;
    skos:definition "A chemical compound containing chlorine and another element; a salt of hydrochloric acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chloride"@en .

aat:300379427 a skos:Concept ;
    skos:definition "Refers to use of terrestrial photogrammetry to measure, survey, or map architectural structures, particularly historical monuments and sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural photogrammetry"@en .

aat:300379428 a skos:Concept ;
    skos:definition "Study of scientific concepts and practice throughout human history in a global, social, and cultural context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history of science"@en .

aat:300379429 a skos:Concept ;
    skos:definition "In the sciences, taking of samples for technical analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sampling"@en .

aat:300379430 a skos:Concept ;
    skos:definition "Repositories specializing primarily in the preservation of digital materials, which may or may not be searchable and available for use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital archives"@en .

aat:300379431 a skos:Concept ;
    skos:definition "Refers to preservation of all digital materials, and of digital heritage generally, which aims to ensure access to such content over the long term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital preservation"@en .

aat:300379432 a skos:Concept ;
    skos:definition "The quantity of water in a given substance; its weight as a percentage of the total dry weight of the material (as measured on the dry basis) or percentage of the weight per unit mass of the wet material (the wet basis)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moisture content"@en .

aat:300379433 a skos:Concept ;
    skos:definition "The branch of zoology that studies reptiles and amphibians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "herpetology"@en .

aat:300379434 a skos:Concept ;
    skos:definition "Fine black powder composed of antimony used as a cosmetic to darken eyelids and eyebrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kohl"@en .

aat:300379435 a skos:Concept ;
    skos:definition "The act of transferring public assets from national control to private ownership."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "privatization"@en .

aat:300379436 a skos:Concept ;
    skos:definition "The study or investigation of abnormality, malfunction, or disease. In conservation, the term may be used to describe afflictions to which artifacts are subject, as in \"paper pathology\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pathology"@en .

aat:300379437 a skos:Concept ;
    skos:definition "The emission of light produced in chemical reaction by living organisms and the light so produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioluminescence"@en .

aat:300379438 a skos:Concept ;
    skos:definition "Application of coatings and other means pursued to render impervious to weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weatherproofing"@en .

aat:300379439 a skos:Concept ;
    skos:definition "A fume collection device in an enclosed ventilated space used in a laboratory to confine poisonous or noxious fumes and gases for exhausting or filtered recirculation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fume hoods"@en .

aat:300379440 a skos:Concept ;
    skos:definition "The technique accomplishing the measurement of atmospheric humidity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hygrometry"@en .

aat:300379441 a skos:Concept ;
    skos:definition "Microscopic fossilized remains of organisms usually less than 2mm in size. Subject studied by micropaleontology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfossils"@en .

aat:300379442 a skos:Concept ;
    skos:definition "Alcoholic beverage made from fermented grapes. The term has been used for beverages made from other fermented plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine"@en .

aat:300379443 a skos:Concept ;
    skos:definition "The branch of science that treats weights and measures and accurate measurement. Also used to signify a system of measurement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metrology"@en .

aat:300379444 a skos:Concept ;
    skos:definition "The act of purification, clarification, or distillation of a substance or product, by a series of industrial processes. Examples may include the processing of sugar, crude oil, or metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refining"@en .

aat:300379445 a skos:Concept ;
    skos:definition "Branch of anatomy which studies tissue structure in organisms using microscopic examination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "histology"@en .

aat:300379446 a skos:Concept ;
    skos:definition "The measurement of light, specifically the intensity of a light source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photometry"@en .

aat:300379447 a skos:Concept ;
    skos:definition "The branch of science that studies climates and their phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climatology"@en .

aat:300379448 a skos:Concept ;
    skos:definition "Fossilized fecal material; indirect evidence of prehistoric life, particularly as pertains to ancient diet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coprolites"@en .

aat:300379449 a skos:Concept ;
    skos:definition "Technique in which paint, usually water-based, is applied directly to textiles, such as linen or silk, with only a very thin glue preparation or no preparation. The result was a subdued tonality and matte surface; however, the advantages were that it was less expensive than other contemporary painting techniques and this technique allowed the work to be rolled and transported. Examples include works by German, Netherlandish, and north Italian artists during the 15th and early 16th centuries. For the technique preferred in Spain and its colonies, where the ground was a thin layer of gesso, prefer \"sarga (technique).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tüchlein"@en .

aat:300379450 a skos:Concept ;
    skos:definition "Coarse grained, veined marble ranging in color from white to salmon-pink, quarried in and around Candoglia, Piedmont, Italy. It is primarily known as the building material used for Milan Cathedral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Candoglia marble"@en .

aat:300379451 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Lithuania, or in general to cultures that have occupied the Eastern European state on the Baltic sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lithuanian"@en .

aat:300379452 a skos:Concept ;
    skos:definition "A colorless, unstable liquid prepared in an aqueous solution for commercial use, employed as a sterilizing, oxidizing and bleaching agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogen peroxide"@en .

aat:300379453 a skos:Concept ;
    skos:definition "The condition characterized by a total depletion in the level of oxygen or an oxygen level at or below 0.1%. Absence of oxygen in atmospheric or aquatic environments normally results in the death of living organisms. In a conservation context, anoxia may be deliberately induced as a means of insect control, by sealing objects in oxygen-free environments that are then purged with non-oxygen gas. For a low oxygen condition, use \"hypoxia.\" For a medical condition characterized by lack of oxygen in the blood, use \"anoxemia.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anoxia"@en .

aat:300379454 a skos:Concept ;
    skos:definition "A measure of the tensile strength of paper as determined by a testing method that establishes paper's ability to be repeatedly folded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding endurance"@en .

aat:300379456 a skos:Concept ;
    skos:definition "An ester of methacrylic acid, methyl methacrylate is a monomer used for the production of polymethyl methacrylate resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl methacrylate"@en .

aat:300379457 a skos:Concept ;
    skos:definition "The action, process, or technique of making slight linear abrasions on a surface of any kind. May refer to damage, or to a technique for creation of art, such as in printmaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratching"@en .

aat:300379458 a skos:Concept ;
    skos:definition "Polymerized methyl methacrylate is a compound having a hard and glasslike appearance, with softening temperature from 105-125 C. Classified as bioinert. As a resin, widely used as a glass substitute (e.g., Plexiglass (TM)) and a bonelike material for prosthetics. First commercially sold in 1933 as a glass substitute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymethyl methacrylate"@en .

aat:300379459 a skos:Concept ;
    skos:definition "People skilled in magic and the occult arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wizards"@en .

aat:300379460 a skos:Concept ;
    skos:definition "Deteriorative weathering mechanism caused by cycle of fluctuation in temperature below and above the freezing point of water. At temperatures above freezing, liquid water seeps into cracks, expanding within them in the form of ice as temperature falls below the freezing point. Repeated freeze-thaw cycles may lead to deterioration of stone and such effects as spalling in masonry, and potholes in roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freeze-thaw cycle"@en .

aat:300379461 a skos:Concept ;
    skos:definition "The maximum amount of axially-directed pressure a material can withstand before being crushed or fracturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compressive strength"@en .

aat:300379462 a skos:Concept ;
    skos:definition "Refers to a set of statistical techniques that analyze data sets with more than one variable when there is inherent interdependence between them. Techniques of multivariate analysis include cluster and factor analysis. Multivariate analysis is often used in archaeology, e.g. to aid classification of artifact compositional data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multivariate analysis"@en .

aat:300379463 a skos:Concept ;
    skos:definition "The customs and course of living as to food and ways of feeding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diet"@en .

aat:300379464 a skos:Concept ;
    skos:definition "Multivariate statistical technique that reduces variables in a large data set to a smaller number of determining factors underlying otherwise loosely related data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "factor analysis"@en .

aat:300379465 a skos:Concept ;
    skos:definition "Distinctive type of ancient lost-wax casting technique named after the Dhokra tribes, who are the traditional metalworkers of West Bengal. It is distinguished by decoration made using a pipette to squeeze out long strings of wax that are applied as coils, spirals, strips, or other designs to the mold. Among the items produced by this technique are folk deity figures, votive horsemen, lamps, dowry rice bowls, animal figures, and fish-shaped openwork brass purses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhokra"@en .

aat:300379466 a skos:Concept ;
    skos:definition "Multivariate statistical technique that arranges objects from a data set in clusters, each of which binds objects more similar to one another than those in other clusters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cluster analysis"@en .

aat:300379467 a skos:Concept ;
    skos:definition "Protective measures such as rejection coatings and filters intended to eliminate and reduce deleterious effects of ultraviolet radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet protection"@en .

aat:300379468 a skos:Concept ;
    skos:definition "The action of making a substance more physically soft or pliable; to lessen hardness or rigidity. This may refer to applications of softening agents or processes in treatment of materials such as leather or parchment to increase softness, smoothness, or plasticity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "softening"@en .

aat:300379469 a skos:Concept ;
    skos:definition "Making or becoming dirty, tarnished, or stained; damage to the surface or substrate of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soiling"@en .

aat:300379470 a skos:Concept ;
    skos:definition "Impressions left of prehistoric foot traffic made by humans or animals; fossil foot prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trackways"@en .

aat:300379471 a skos:Concept ;
    skos:definition "In archaeology, a dating technique which places artifactual samples in serial order according to prescribed typological criteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seriation"@en .

aat:300379472 a skos:Concept ;
    skos:definition "Deterioration of rock caused by salt crystallization, or haloclasty, salt hydration, or thermal expansion of salts in rock pores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt weathering"@en .

aat:300379473 a skos:Concept ;
    skos:definition "The formation of biominerals by a living organism as in bone, teeth, and shell. In conservation context, the process may be induced through introduction of biomineralizing agents into deteriorating stone, an intervention known as \"biomediated reinforcement.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biomineralization"@en .

aat:300379474 a skos:Concept ;
    skos:definition "Removal of contaminants such as radioactive material or dangerous gases from areas, objects, living things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decontamination"@en .

aat:300379475 a skos:Concept ;
    skos:definition "A data set that describes and provides information about other data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metadata"@en .

aat:300379476 a skos:Concept ;
    skos:definition "Refers to the culture of the general region of Bengal, roughly encompassing West Bengal in India and all of Bangladesh. It was an ancient Hindu region, into which was introduced Buddhism in the 3rd century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bengali"@en .

aat:300379477 a skos:Concept ;
    skos:definition "The thin, lighter colored, softer outer layer of more recently formed wood that lies between the bark and the heartwood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sapwood"@en .

aat:300379478 a skos:Concept ;
    skos:definition "General term for the culture and style of certain nomadic tribes who were historically scattered over Bengal and elsewhere in Central and Eastern India; they are traditionally metalworkers, known for a distinctive technique named for their culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dhokra"@en .

aat:300379479 a skos:Concept ;
    skos:definition "The concentration of a pigment in a coating expressed as percentage of total volume of a paint film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pigment volume concentration"@en .

aat:300379480 a skos:Concept ;
    skos:definition "Refers to fabrics, natural or man-made, that are bonded into sheets by means other than weaving, knitting, or spinning. Also, the textiles made of nonwoven fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonwovens"@en .

aat:300379481 a skos:Concept ;
    skos:definition "The branch of science that studies the use of plants and plant products in human societies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnobotany"@en .

aat:300379482 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Iceland, or in general to the cultures that have occupied the island that borders the Arctic Ocean, between Norway and Greenland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Icelandic"@en .

aat:300379483 a skos:Concept ;
    skos:definition "All sediment particles, regardless of mineral origin, that fall within a specified size range between those of sand and clay. An unconsolidated aggregation of particles is also called silt; a consolidated aggregate, silt-stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silt"@en .

aat:300379484 a skos:Concept ;
    skos:definition "Discolorations appearing as irregular dark lines on paper or board, created by a dried liquid. These lines indicate the limit of liquid migration. The visible lines are dirt transported by the liquid, which is embedded deeply into the paper fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tidelines"@en .

aat:300379485 a skos:Concept ;
    skos:definition "The process of preserving bodies of human beings or animals, resulting in a mummy, whether it occurs by chance (natural mummification) or is intentionally pursued through embalming or treatment for burial using preservatives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummification"@en .

aat:300379486 a skos:Concept ;
    skos:definition "Buildings and other architectural structures constructed wholly or primarily of earth. For engineering works, such as trenches, created in the earth, use \"earthworks (engineering works).\" For structures built on a hillside rather than into it, use \"hillside architecture.\" For structures built under the surface of the ground, but not made primarily of earth, use \"underground structures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earthen architecture"@en .

aat:300379487 a skos:Concept ;
    skos:definition "Refers to an enhanced technique of liquid chromatography developed in the late 1960s in which stationary phase particles are smaller and packed more densely than in traditional liquid chromatography. The mobile phase solvent is then forced through the dense adsorbent by means of a pump. The technique was initially known as \"high pressure liquid chromatography\" (HPLC). The acronym remains but with a shift in emphasis to the high performance the method attains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high performance liquid chromatography"@en .

aat:300379488 a skos:Concept ;
    skos:definition "Refers to light-induced oxidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photooxidation"@en .

aat:300379489 a skos:Concept ;
    skos:definition "The preservation of natural or cultural resources through managed use. For example, as an ecological concept, the preservation of natural resources through responsible use and stewardship; a component of sustainable development. In context of conservation, preserving cultural heritage resources through maintenance and limited use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sustainability"@en .

aat:300379490 a skos:Concept ;
    skos:definition "In physics, plasma is an electrically conductive gas of low density, affected by magnetic fields. It is fully ionized and contains approximately equal numbers of positive and negative ions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasma"@en .

aat:300379491 a skos:Concept ;
    skos:definition "To make or become dark in shade, value, or color; a form of discoloration: the blackening or browning of materials due to such causes as chemical process, exposure to light, the passage of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darkening"@en .

aat:300379492 a skos:Concept ;
    skos:definition "Towns designated by a governing body as being culturally or historically significant, or embodying distinctive characteristics of a period, method of construction, or inhabitants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic towns"@en .

aat:300379493 a skos:Concept ;
    skos:definition "The capacity of a material to retain its shape and resist change to its physical size under set conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimensional stability"@en .

aat:300379494 a skos:Concept ;
    skos:definition "To wrap, protect, or place items of any kind in a container for transport or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packing"@en .

aat:300379497 a skos:Concept ;
    skos:definition "Discolorations produced by the penetration of foreign matter into a fabric, wood, or coating. This term designates material damage and is not to be confused with a substance that is used as a protective coating or colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stains"@en .

aat:300379498 a skos:Concept ;
    skos:definition "Structures that provide protection from sun, weather, and other damaging elements for archaeological sites and other heritage sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protective shelters"@en .

aat:300379500 a skos:Concept ;
    skos:definition "institutions dedicated to the pursuit of conservation science. They host laboratories and may have other facilities and programs related to the field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation centers"@en .

aat:300379501 a skos:Concept ;
    skos:definition "Formats of paintings, prints, photographs, sculptures, or other works or other things that fall within a large range of size for the norm. For example, the term is used for film format in photography, usually reserved for sheet film formats 4x5 inches and larger, but may be extended to describe the fields of related imaging detectors, or spectroscopic equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "large-format"@en .

aat:300379505 a skos:Concept ;
    skos:definition "The physical materials that make up the mass of an archive. Distinguished from AAT \"archives (groupings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archival materials"@en .

aat:300379506 a skos:Concept ;
    skos:definition "Theory of conservation technique with emphasis on practical application; for theory of ethics and conservation science, see conservation philosophy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation theory"@en .

aat:300379507 a skos:Concept ;
    skos:definition "Physical handling of cultural objects and other artifactual objects as a component of their transportation to exhibits, care, conservation, storage, and display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handling"@en .

aat:300379508 a skos:Concept ;
    skos:definition "Refers to all non-technical analysis of artifactual objects and art works according to precepts of such critical approaches as typology, morphology, or connoisseurship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stylistic analysis"@en .

aat:300379509 a skos:Concept ;
    skos:definition "Any of a family of water-soluble polymers that range in viscosity from liquid to wax-like solid. They are present in organic solvents for dyes and resins; and used as wetting agents, emulsifiers, and plasticizers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyethylene glycol"@en .

aat:300379510 a skos:Concept ;
    skos:definition "Interdisciplinary study of the maintenance, care, and protection of art, architecture, and other cultural works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation science"@en .

aat:300379511 a skos:Concept ;
    skos:definition "A synthetic wax made by catalytic polymerization of low molecular weight, high-density ethylene. It may be used as a reversible protective coating in many applications including the conservation of outdoor sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyethylene wax"@en .

aat:300379514 a skos:Concept ;
    skos:definition "Gas chromatography initiated by pyrolysis of the solid state. The molecular breakdown effected by high temperature may result in molecules that are more stable than those separated through standard vaporisation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrolysis gas chromatography"@en .

aat:300379515 a skos:Concept ;
    skos:definition "State or condition of existing or moving in a city or other urban area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban"@en .

aat:300379516 a skos:Concept ;
    skos:definition "State or condition of existing or operating in the country as opposed to a town or city."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural"@en .

aat:300379517 a skos:Concept ;
    skos:definition "Refers to any venture in which individuals or organizations work together, especially in an intellectual endeavor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collaboration"@en .

aat:300379518 a skos:Concept ;
    skos:definition "The application of testing methods to materials or objects in order to analyze their composition and manufacture. In a conservation science context, this may refer to movable art works and artifactual objects in a conservation lab. For a broader range of testing methods, prefer \"scientific analysis.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical analysis"@en .

aat:300379519 a skos:Concept ;
    skos:definition "A spectoscopic technique which employs the Mössbauer effect. After the recoil-free absorption of a beam of Gamma radiation by a solid sample, spectroscopy detects minute changes in the nuclear environment of atoms investigated. In archaeology and conservation contexts, the technique is of special use in studying crystalline structure in iron artifacts, and iron-bearing phases of pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mössbauer spectroscopy"@en .

aat:300379520 a skos:Concept ;
    skos:definition "Highly energetic electromagnetic radiation with a very short wavelength emitted during radioactive decay. Gamma rays are essentially very short x-rays and penetrate matter deeply. Gamma radiation is used in radiography and as an exterminant and sterilizing agent, which kills insects, molds, bacteria, or fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gamma radiation"@en .

aat:300379521 a skos:Concept ;
    skos:definition "The activity of using a polarizing light microscope, which uses polarized light to reveal characteristics of the submicroscopic structures of objects examined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polarized light microscopy"@en .

aat:300379522 a skos:Concept ;
    skos:definition "In science, business, policy, and other fields, a careful item-by-item comparison of two or more comparable characteristics, alternatives, processes, products, qualifications, sets of data, or other features in order to draw an authoritative conclusion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comparative analysis"@en .

aat:300379523 a skos:Concept ;
    skos:definition "The branch of conservation science involving treatment, preventive care, and research directed toward archaeological sites and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological conservation"@en .

aat:300379525 a skos:Concept ;
    skos:definition "Any materials manufactured through advanced technology, that differ physically from materials known throughout human history, specifically before the 20th century. This term is most often used to describe various polymers and synthetic materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modern materials"@en .

aat:300379526 a skos:Concept ;
    skos:definition "General term for processes and techniques used for construction and assembling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction techniques"@en .

aat:300379527 a skos:Concept ;
    skos:definition "General term for the techniques and processes used in the manufacture of goods, materials, or other things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manufacturing techniques"@en .

aat:300379528 a skos:Concept ;
    skos:definition "Officials in any of the senior grades of the former imperial Chinese civil service. Mandarins were chosen by examination, and there were nine grades, each of which was distinguished by a distinctive round ornament or button on top of the official headgear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandarins"@en .

aat:300379529 a skos:Concept ;
    skos:definition "Paint and similar coatings designed specifically to add color or to protect architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural paint"@en .

aat:300379531 a skos:Concept ;
    skos:definition "A technique that measures variations in temperature of an area, object, or organism by creating infrared images (thermograms) to detect discontinuities such as voids in solid structures, deteriorations in frescoes, biotic infestations of a surface, or tumors in human tissue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared thermography"@en .

aat:300379532 a skos:Concept ;
    skos:definition "Refers to the oldest form of microscopy, which employs visible light to view objects that are too small to be seen with the naked, unaided eye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical microscopy"@en .

aat:300379533 a skos:Concept ;
    skos:definition "In analytical chemistry, sample preparation refers to the phase of scientific investigation that follows sampling and precedes measuring. It encompasses all the processes involved in readying a sample for examination, including extraction from a larger sample, and all the techniques of reduction and processing required to produce a representative test sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sample preparation"@en .

aat:300379534 a skos:Concept ;
    skos:definition "Formats of paintings, prints, photographs, sculptures, or other works that fall within a medium range of size for the norm. For example, the term is used for film formats encompassing 120/220 and 70mm roll sizes and sheet films to 3.25 x 4.25 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medium-format"@en .

aat:300379535 a skos:Concept ;
    skos:definition "Formats of paintings, prints, photographs, sculptures, or other works or other things that fall within a small range of size for the norm. For example, the term is used to describe photographic film formats 35mm and smaller."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small-format"@en .

aat:300379536 a skos:Concept ;
    skos:definition "Soluble salts are dissolved minerals whose crystallization on the surface and in the substrate of materials causes efflorescence and deterioration.The presence of water-soluble salts is a key factor in the degradation of masonry and other highly porous stone building materials. Surface efflorescence is a serious threat to ancient mural paintings. Conservation seeks to identify soluble salts in objects affected, and extract them or otherwise halt the degradation they inflict."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soluble salt"@en .

aat:300379537 a skos:Concept ;
    skos:definition "An inductively coupled plasma (ICP) is a type of high-temperature plasma (ionized gas) source generated by electric currents produced by electromagnetic induction. It is used to determine elemental content of materials in ICP spectrometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inductively coupled plasma"@en .

aat:300379538 a skos:Concept ;
    skos:definition "Infrared reflectography is a digital imaging technique that allows study of layers beneath the surface of a painting by capturing absorption/emission characteristics of reflected infrared radiation. A complementary technique to x-radiography, IRR uncovers somewhat different information.The longer wavelengths of infrared radiation penetrate most surface pigments and reveal charcoal or graphite underdrawings, the underlying initial stages of a composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared reflectography"@en .

aat:300379539 a skos:Concept ;
    skos:definition "A technique of elemental analysis in which a small area on a surface is bombarded with charged particles (non-electrons, usually protons) to produce fluorescent X-rays specific to an element. The method is used in conservation science, archaeology, and geology to obtain an elemental map which may guide research regarding dating, provenance and authenticity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particle-induced x-ray emission"@en .

aat:300379540 a skos:Concept ;
    skos:definition "Refers to an emerging interdisciplinary field which seeks to integrate scientific study of art into the practice of art history; and the interpretative methods of the art historian into the conservation lab. An outgrowth of the subdiscipline of art history once known as Technical Studies, the field has recently established itself within graduate program curricula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technical art history"@en .

aat:300379541 a skos:Concept ;
    skos:definition "Radiant energy emitted as rays, particles, or waves; for example, light, x-rays, or beta particles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiation"@en .

aat:300379542 a skos:Concept ;
    skos:definition "Field of archaeology that recovers, preserves, and analyzes data from human settlements in order to study the history of city life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban archaeology"@en .

aat:300379543 a skos:Concept ;
    skos:definition "Systematic assessments of the condition of a group, collection, or system, for example, the contents of a library or archive. For reports on individual items, use \"condition reports.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "condition surveys"@en .

aat:300379544 a skos:Concept ;
    skos:definition "Systematic assessment of the condition of collection holdings conducted periodically with the aim of identifying and prioritizing conservation needs. A conservation survey is a core part of a collection's long range plan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation surveys"@en .

aat:300379545 a skos:Concept ;
    skos:definition "Strontium (symbol: Sr) is a soft silver-white metallic element that turns yellow when exposed to air. Strontium is used commercially in luminous paint, fireworks and television tubes, and the compound strontium-oxide serves as a non-toxic replacement for lead in ceramic glazes. Paleontologists study strontium levels in human and animal bone for information about ancient diet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strontium"@en .

aat:300379547 a skos:Concept ;
    skos:definition "Refers to the style and culture of the historical and linguistic region of peninsular India, comprising the north-central and northeastern portions of present-day Andhra Pradesh state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Telingana"@en .

aat:300379549 a skos:Concept ;
    skos:definition "In an archaeological context, analysis of stable strontium isotopes in ancient objects and materials can supply information about date and provenance. Strontium in its isotopic form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strontium isotopes"@en .

aat:300379550 a skos:Concept ;
    skos:definition "Refers to any methylated derivative of cellulose. Methyl cellulose is a white powder that swells in water and is used as a substitute for natural gums, functioning in various commercial contexts as emulsifying, thickening, or sizing agent, lubricant, and suspension aid. In textile and paper conservation, it is used as an adhesive and as a poulticing material for removal of stains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl cellulose"@en .

aat:300379552 a skos:Concept ;
    skos:definition "Visible fluorescence emitted by materials in paintings and other objects exposed to ultraviolet radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultraviolet fluorescence"@en .

aat:300379553 a skos:Concept ;
    skos:definition "The style and culture of the area including Andhra and Karnataka, India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andhra Karnataka"@en .

aat:300379554 a skos:Concept ;
    skos:definition "Acts of destroying, damaging, or carrying off booty in time of war or unrest. In the context of heritage management and cultural diplomacy, use \"looting (social issue)\" rather than the more general \"theft (crime)\" with reference to cultural property, often taken with the aim of illicit trafficking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "looting"@en .

aat:300379555 a skos:Concept ;
    skos:definition "Refers to a statistical technique, a form of multivariate analysis, used by archaeologists and conservation scientists in conjunction with multispectral analysis to organize compositional data among a set of objects, such as the differential distribution and concentrations of a metallic element in ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "principal component analysis"@en .

aat:300379558 a skos:Concept ;
    skos:definition "Refers to the identification and study of archaeological sites without recourse to excavation. Archaeological fieldwork encompasses the battery of non-destructive techniques undertaken when searching for sites in the course of a field survey. Such research done in the field is published as field reports."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field archaeology"@en .

aat:300379559 a skos:Concept ;
    skos:definition "A thermoplastic heat-seal adhesive designed by Gustav Berger for art conservators. Beva 371 was created for relining of paintings but is now also used as a consolidant for paintings, textiles, and leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BEVA 371 (TM)"@en .

aat:300379560 a skos:Concept ;
    skos:definition "Benzotriazole (BTA) is a heterocyclic compound with many applications. In conservation, the silvery powder is chiefly used as a corrosion inhibitor for copper and its alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benzotriazole"@en .

aat:300379561 a skos:Concept ;
    skos:definition "Refers to the creation of salts or esters of sulfuric acid that occurs when sulfate ions are incorporated into molecules. In a conservation science context sulfation most often refers to chemical weathering of stone by airborne pollution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfation"@en .

aat:300379562 a skos:Concept ;
    skos:definition "Refers to portable lab equipment used by scientists for in situ analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable equipment"@en .

aat:300379563 a skos:Concept ;
    skos:definition "Trademark for a line of tough epoxy adhesives manufactured by Huntsman Advanced Materials and designed for industrial applications. Araldite is also widely and variously used as a structural adhesive in conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Araldite (TM)"@en .

aat:300379564 a skos:Concept ;
    skos:definition "A salt of oxalic acid, calcium oxalate can form naturally on calcareous stones as a reaction to oxalic acid excretions of mosses and lichens. In a conservation context, calcium oxalate is generally considered in its role as a form of bioterioration but its cultivation as a protective film for limestone surfaces has been investigated as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium oxalate"@en .

aat:300379565 a skos:Concept ;
    skos:definition "A colorless gas used commerically as a fumigant and disinfectant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethylene oxide"@en .

aat:300379566 a skos:Concept ;
    skos:definition "Surveys which assess the condition of a set of historic buildings and prioritize preservation and repair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural surveys"@en .

aat:300379567 a skos:Concept ;
    skos:definition "In archaeology, describes prehistoric chipped-stone artifacts and debitage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithics"@en .

aat:300379568 a skos:Concept ;
    skos:definition "Electromagnetic radiation emitted by high-energy particles following a curved path at close to the speed of light as in the variety of particle accelerator known as a synchrotron. It is also produced naturally by charged particles moving through magnetic fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synchroton radiation"@en .

aat:300379569 a skos:Concept ;
    skos:definition "Technique applying x-ray diffraction to crystalline or powder samples in order to ascertain their structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray powder diffraction"@en .

aat:300379570 a skos:Concept ;
    skos:definition "Refers to a thin, resistant layer of mucilage and the imbedded bacteria and other microorganisms that created it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biofilm"@en .

aat:300379571 a skos:Concept ;
    skos:definition "A wax-like volatile cyclic alkane used as a consolidant for various materials; and as a temporary fixative for water-sensitive media on paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclododecane"@en .

aat:300379572 a skos:Concept ;
    skos:definition "A salt or ester of oxalic acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxalate"@en .

aat:300379573 a skos:Concept ;
    skos:definition "Refers to he incorporation and absorption of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydration"@en .

aat:300379574 a skos:Concept ;
    skos:definition "The branch of chemistry that analyzes chemical processes occuring in extremely minute regions, using techniques modified to treat microscopic quantities of reagents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microchemistry"@en .

aat:300379575 a skos:Concept ;
    skos:definition "The science that measures diffraction by matter of x-rays, neutrons, or electrons to study crystal atomic structure; the use of a diffractometer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diffractometry"@en .

aat:300379576 a skos:Concept ;
    skos:definition "The branch of geology which studies water on or below the surface of the earth in relation to its geologic environment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogeology"@en .

aat:300379577 a skos:Concept ;
    skos:definition "Removal of fat or grease from material by various means. In a conservation context, the concept chiefly refers to the cleaning of skeletons and skins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "degreasing"@en .

aat:300379578 a skos:Concept ;
    skos:definition "Refers to the global integration of economic, political, cultural and social institutions as motivated by objectives which include fostering international cooperation and coordination, universalizing regulatory standards, and enabling free flow of capital and free trade. The term is also used to imply the loss of national identity that globalization is perceived to bring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "globalization"@en .

aat:300379579 a skos:Concept ;
    skos:definition "Large group of heterocyclic compounds, providing many natural colorants. Many natural dyes and pigments (e.g., quercitron, anthocyanin) are flavonoids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flavonoids"@en .

aat:300379580 a skos:Concept ;
    skos:definition "The process in which a material leaves the surface of the solid into which it was absorbed or adsorbed; it is the reverse of those processes. In conservation, adsorption may refer as well to intentional removal of absorbed or adsorbed material from a substrate through increased heat, decreased pressure, or other measures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desorption"@en .

aat:300379581 a skos:Concept ;
    skos:definition "Nonmetallic chemical element (H). It is a colorless, odorless, tasteless gas, the lightest chemical element, and is used in rocket fuels and balloons. Its most important compound (with oxygen) is water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogen"@en .

aat:300379582 a skos:Concept ;
    skos:definition "A protective acrylic coating designed for use on outdoor bronze scultptures. Incralac contains thermoplastic resin Paraloid B-44 and a benzotriazole corrosion inhibtor. In its original formulation, Incralac has proven susceptible to biodeterioration and is subject to cracking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Incralac (TM)"@en .

aat:300379583 a skos:Concept ;
    skos:definition "Refers to a strong organic acid derived from sorrel and other plants. A crystalline powder, oxalic acid lends itself to many commercial applications, principally as a bleaching agent and as a reducing agent to remove tarnish, rust and ink stains. In art manufacture and conservation, further uses include removal of paint and varnish, and cleaning of encrustations from sculptures and paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxalic acid"@en .

aat:300379584 a skos:Concept ;
    skos:definition "Any materials added to increase optical density and make opaque. In ceramics, opacifiers are substances added to glaze or enamels for this purpose. They include tin oxide, titanium dioxide, and lead chromate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opacifiers"@en .

aat:300379585 a skos:Concept ;
    skos:definition "Refers to materials whose particle constituents are of nanoscale dimensions, especially nano-engineered materials produced by nanotechnology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanomaterials"@en .

aat:300379586 a skos:Concept ;
    skos:definition "The branch of geology that studies sediments and sedimentary rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sedimentology"@en .

aat:300379587 a skos:Concept ;
    skos:definition "Marine crustaceans and molluscs which bore into wood in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine borers"@en .

aat:300379588 a skos:Concept ;
    skos:definition "Wood boring beetles in their larval and adult states. As larvae, commonly known as woodworms. Termites, though wood eating, are not beetles and thus not wood borers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood borers"@en .

aat:300379589 a skos:Concept ;
    skos:definition "Any natural aging process and its effects on materials. In conservation science refers to effects on paper and other materials; as opposed to accelerated (or \"artificial\") aging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural aging"@en .

aat:300379590 a skos:Concept ;
    skos:definition "Conservation of ethnographic objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethnographic conservation"@en .

aat:300379591 a skos:Concept ;
    skos:definition "Zoological, botanical, or mineralogical samples chosen for scientific study or display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural history specimens"@en .

aat:300379592 a skos:Concept ;
    skos:definition "Electon scanning microscopy using a focused beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scanning transmission electron microscopy"@en .

aat:300379593 a skos:Concept ;
    skos:definition "Rulers who hold lands by feudal tenure; dependent lords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feudatories"@en .

aat:300379594 a skos:Concept ;
    skos:definition "Composite mythological creatures with the head and wings of a bird (usually that of an eagle) and the body and hind quarters of a lion. Was a favorite decorative motif in the ancient Middle Eastern and Mediterranean area, probably having originated in the Levant in the 2nd millennium BCE; the griffin had spread throughout western Asia and into Greece by the 14th century BCE. The Asiatic griffin had a crested head, whereas the Minoan and Greek griffin usually had a mane of spiral curls. It was shown either recumbent or seated on its haunches, often paired with the sphinx; its function was often protective. The Greeks believed griffins inhabited Scythia to keep jealous watch over the gold of that country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "griffins"@en .

aat:300379595 a skos:Concept ;
    skos:definition "Fabulous and legendary animals usually regarded as having the body of a horse with a single horn projecting from the forehead. The unicorn has at various times been identified or confused with the rhinoceros, with various species of antelope, or with other animals having a horns or a horn-like projection from the head. The horn of the narwhal was passed off as unicorn horn; the unicorn horn was valuable, reputed to possess medicinal or magical properties"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unicorns"@en .

aat:300379596 a skos:Concept ;
    skos:definition "Imaginary, partly human sea creatures with the head and trunk of a woman and the tail of a fish or cetacean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mermaids"@en .

aat:300379597 a skos:Concept ;
    skos:definition "Imaginary species of sea serpent, derived from the Latin vulgate of a passage in Isaiah. Also generic, imaginary sea creatures who are part woman, including the Sirens of Classical mythology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sirens"@en .

aat:300379598 a skos:Concept ;
    skos:definition "Young children within the first year or few years of being able to walk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toddlers"@en .

aat:300379599 a skos:Concept ;
    skos:definition "Study and analysis of handwriting for evidence of identity, provenance, authenticity, character, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graphology"@en .

aat:300379600 a skos:Concept ;
    skos:definition "The branch of chemistry that deals with the amounts of heat evolved or absorbed in chemical reactions and physical change of state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermochemistry"@en .

aat:300379601 a skos:Concept ;
    skos:definition "The branch of biology that studies airborne transport, distribution, and effects of biological materials as pollens, pollutants, viruses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerobiology"@en .

aat:300379602 a skos:Concept ;
    skos:definition "Process of removing calcium or calcium compounds from a calcified material such as bone, soil, mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decalcifying"@en .

aat:300379603 a skos:Concept ;
    skos:definition "Refers to impregnation of matter with salt. In the ecological context, refers to a land degradation process caused by excessive soil salinity in arid regions. The accumulation of salts in soil layers close to the surface produced by various causes (e.g., capillary transport of salts in the water table; fertilizers or excessive irrigation precipitating salts in the soil) can inhibit crop growth and may result in eventual desertification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salinization"@en .

aat:300379604 a skos:Concept ;
    skos:definition "Trademarked general term for daylight fluorescent and glow-in-the-dark paints and pigments, including objects colored by the pigments. Originally used only for products manufactured by Day-Glo Color Corporation, Cleveland, although the term is commonly used generally for flourescent pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Day-Glo (TM)"@en .

aat:300379605 a skos:Concept ;
    skos:definition "Trademark for a series of fast drying solvent-based opaque white correction fluids applied by brush to cover unwanted letters and other mistakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wite-Out (TM)"@en .

aat:300379606 a skos:Concept ;
    skos:definition "Trademark for a highly durable low-permeability polyethylene plastic used for storage containers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tupperware (TM)"@en .

aat:300379607 a skos:Concept ;
    skos:definition "Trademark for a series of extremely tough and stiff acetal homopolymer resins manufactured by DuPont and used in injection molded parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Delrin (TM)"@en .

aat:300379608 a skos:Concept ;
    skos:definition "In medicine, a biologic or biologically derived diagnostic indicator of biologically normal or pathogenic processes or of pharmacological response to therapeutic interventions.The term is borrowed by archaeology to signify markers of past biological activities that survive in the form of organic residue that survives in a wide variety of locations and deposits at archaeological sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biomarkers"@en .

aat:300379609 a skos:Concept ;
    skos:definition "Fossiliferous limestone composed of coral and shell and oolite particles or debris from erosion of older limestones. Calcarenites have been used as a building and ornamental stone, especially in the Apulia region of South Eastern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcarenite"@en .

aat:300379610 a skos:Concept ;
    skos:definition "A carboxylic acid found naturally in ants and stinging nettles, formic acid is used industrially in textile dyeing, leather tanning, and in the manufacture of insecticides and other products. Formic acid is also encountered as a corrosive agent, deleterious to metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formic acid"@en .

aat:300379611 a skos:Concept ;
    skos:definition "In the US, specifically refers to goggles, helmets, respirators and all other protective wear and equipment required in the workplace by Federal law to limit risk from occupational hazards. The Occupational Safety and Health Administration (OSHA) sets standards for personal protective equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal protective equipment"@en .

aat:300379612 a skos:Concept ;
    skos:definition "In heritage and other cultural management, a component of a preservation survey which determines and factors in cultural value and significance of a landmark site or a collection to its stakeholders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "significance assessments"@en .

aat:300379613 a skos:Concept ;
    skos:definition "Refers to the specific temperature midway in the temperature range at which a material reversibly changes from an amorphous, glassy solid to a soft, elastic liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass transition temperature"@en .

aat:300379614 a skos:Concept ;
    skos:definition "Refers to creation of molds for casting purposes. For the process of making a positive from material pressed into the mold use \"molding,\" or \"casting\" for objects cast from liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mold-making"@en .

aat:300379615 a skos:Concept ;
    skos:definition "Any act of reconstruction from disassembled parts. In conservation science context, refers to reassembly of objects taken apart for conservation or restoration treatment; or to reconstruction of an object from a more or less complete set of fragments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reassembling"@en .

aat:300379616 a skos:Concept ;
    skos:definition "In chemistry, a substance for use in chemical reaction to detect or test or produce other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reagent"@en .

aat:300379617 a skos:Concept ;
    skos:definition "Refers to a carbonate of ammonium commonly known as hartshorn. It is a white powder used in smelling salts, baking powder, textile dyeing, and other applications. In conservation, a solution of ammonium carbonate is used as a solubilizing agent for extraction of soluble salts present on deteriorated stone surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium carbonate"@en .

aat:300379618 a skos:Concept ;
    skos:definition "Conversion of carbon-containing organic matter into carbon or carbonic residue. The formation of coal is an example of carbonization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbonization"@en .

aat:300379619 a skos:Concept ;
    skos:definition "The action of rendering a metal inert in order to inhibit corrosion; in electronics, coating of semiconductors for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passivation"@en .

aat:300379620 a skos:Concept ;
    skos:definition "A crystalline phenol first isolated in 1719, formerly much used as a fungicide and disinfectant in conservation of works of art. While it is effective as a mold and mildew inhibitor, thymol dissolves oil paints and varnishes over time, and discolors paper to which it has been applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thymol"@en .

aat:300379621 a skos:Concept ;
    skos:definition "The process by which an ordered structure within input data (e.g., speech, blocks of text, images) is recognized as a meaningful array distinct from surrounding stimuli. While first recognized and studied as a mental process, pattern recognition is now most widely pursued by computer science and engineering in attempts to create artificial perceptual systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern recognition"@en .

aat:300379622 a skos:Concept ;
    skos:definition "Spontaneous decay of photographic film on a cellulose triacetate base characterized by a strong vinegar aroma. Such deterioration is irreversible. The term is used most often in the context of motion picture film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinegar syndrome"@en .

aat:300379624 a skos:Concept ;
    skos:definition "In chemistry, refers to a large class of compounds containing at least one molecule of carbon. The only carbon compounds not considered organic are its oxides and carbonates. As distinct from \"inorganic compounds\"."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic compounds"@en .

aat:300379625 a skos:Concept ;
    skos:definition "The making of radiographs using neutron beams aquired from nuclear reactors, accelerators, or radioactive materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutron radiography"@en .

aat:300379626 a skos:Concept ;
    skos:definition "Refers to use of an ultrasonic humidifier to apply extremely small, finely controlled, amounts of dilute solutions to a material. In conservation this is typically an art object or artifact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultrasonic misting"@en .

aat:300379627 a skos:Concept ;
    skos:definition "Geological samples elected for examination, display, or study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological specimens"@en .

aat:300379628 a skos:Concept ;
    skos:definition "Plant trace fossils, microscopic mineral particles secreted by plants which are highly resistant to deterioration. Phytoliths can be a source of important palaeobotanical information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phytoliths"@en .

aat:300379629 a skos:Concept ;
    skos:definition "In the context of micro-climate and climate control, refers to combined measurement of temperature and humidity and the study of their interaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermohygrometry"@en .

aat:300379630 a skos:Concept ;
    skos:definition "Maps used by insurance companies and emergency management agencies such as FEMA in assessing risk to property. In conservation and heritage management contexts, maps used in vulnerability analysis, assessing risk to cultural heritage areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "risk maps"@en .

aat:300379631 a skos:Concept ;
    skos:definition "Refers to fluorescent brightening agents used in bleaching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical brightener"@en .

aat:300379632 a skos:Concept ;
    skos:definition "Used in an ecological context to describe a large class of nitrogen oxide gases produced in combustion which occur as atmospheric pollutants. Colorless, poisonous gas formed when nitric acid reacts with copper or when ammonia reacts with platinum. It is produced in combustion engine processes such as automobile emissions, resulting in acid rain and photochemical smog. It is also an important messenger molecule in mammals and other animals, produced through cellular metabolism, and involved in oxygen transmission, blood pressure regulation, and other physiological activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrogen oxides"@en .

aat:300379633 a skos:Concept ;
    skos:definition "Damage caused by birds, including pecking damage, damage from nest building, and from droppings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird damage"@en .

aat:300379634 a skos:Concept ;
    skos:definition "General term for any of a large and varied group of prokaryotic, usually photosynthetic, microorganisms that contain (blue) photocyanin and (green) chlorophyll. They closely resemble eukaryotic algae in many respects, leading to past misidentification as such."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyanobacteria"@en .

aat:300379635 a skos:Concept ;
    skos:definition "The act of adding biological agents to contaminated environments in order to neutralize, remove, or break down contaminants; e.g., the process of biodeterioration induced by the introduction of bacteria into an oil spill. Bioremediation is of use in stone conservation for the removal of algae and other organisms, and in collections care for nontoxic pest control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioremediation"@en .

aat:300379636 a skos:Concept ;
    skos:definition "A class of compounds whose molecular structure consists of chains or networks of alternating oxygen and silicon atoms. Polymerized siloxanes include the class of silicones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siloxane"@en .

aat:300379637 a skos:Concept ;
    skos:definition "A class of toxic organic chemicals that readily evaporate as hydrocarbon gases. Volatile organic compounds (VOCs) are widely used as fuels, in the production of plastics, as solvents and paint thinners. Their emissions contribute to air pollution directly or in chemical reactions which form secondary pollutants such as ozone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volatile organic compounds"@en .

aat:300379638 a skos:Concept ;
    skos:definition "Odorless, non-flammable, highly toxic gas formerly used extensively as a fumigant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl bromide"@en .

aat:300379639 a skos:Concept ;
    skos:definition "Initial forge in an ironworks in which ore is transformed into 'blooms,' or malleable iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bloomeries"@en .

aat:300379640 a skos:Concept ;
    skos:definition "Stable oxygen atoms that have the same atomic number as the element oxygen, but differ in atomic weight. O-17 and O-18 are examples of stable oxygen isotopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxygen isotopes"@en .

aat:300379641 a skos:Concept ;
    skos:definition "The branch of paleontology which studies processes of decay and preservation of plant and animal remains, including fossilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taphonomy"@en .

aat:300379642 a skos:Concept ;
    skos:definition "Isotopes of nitrogen: nitrogen-14 and the uncommon isotope, nitrogen-15."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrogen isotopes"@en .

aat:300379644 a skos:Concept ;
    skos:definition "Isotopes of lead; examples of use are for medical and scientific purposes and also a target in the production of super heavy elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead isotopes"@en .

aat:300379645 a skos:Concept ;
    skos:definition "The measure of unsaturated fatty acid in a fat, oil, or wax obtained by counting the number of grams of iodine absorbed by 100 grams of the material. The more saturated the substance, the smaller the iodine number will be. Relatively unsaturated oils, waxes, fats will have a higher iodine value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iodine number"@en .

aat:300379646 a skos:Concept ;
    skos:definition "Pure metallic element having as symbol Bi. Bismuth is brittle with a low melting point; a grayish-white lustrous metal oxidized by air. It is chiefly used in the arts as an alloy, as in bronze, and is used ground as a pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bismuth"@en .

aat:300379647 a skos:Concept ;
    skos:definition "A large and varied class of crystalline metal aluminosilicate minerals containing loosely held water molecules. They are often found in the cavities of igneous rocks. Specialized zeolite matrices can be prepared by varying heat and pressure to aluminum oxide and silicon dioxide. Zeolites have numerous technical applications; e.g., as ion exhange resins, absorbents, or molecular sieves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zeolite"@en .

aat:300379648 a skos:Concept ;
    skos:definition "Anything located beneath the surface of the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground"@en .

aat:300379649 a skos:Concept ;
    skos:definition "Refers to the analytical technique which uses an instrument, a profilometer,to evaluate irregularities of a surface; e.g., measuring gloss and surface roughness of paint films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "profilometry"@en .

aat:300379650 a skos:Concept ;
    skos:definition "Any member of a class of carbohydrates that contain 9 or more monosaccharides linked by glycosidic bonds. Starch, agar, cellulose are polysaccharides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polysaccharides"@en .

aat:300379651 a skos:Concept ;
    skos:definition "Alkyd resins mixed with oils to form commercialized paints, used artists' paints, house paints, varnishes since the 1920's. Alkyds modified by smaller amounts of oil are used for baked enamel finishes in manufacturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkyd paint"@en .

aat:300379652 a skos:Concept ;
    skos:definition "Refers to the property of a dye or a material to retain its color and resist fading or discoloration by washing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "washfastness"@en .

aat:300379653 a skos:Concept ;
    skos:definition "Action or function of the determination of value of non-market properties and services, chiefly cultural and environmental goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contingent valuation"@en .

aat:300379654 a skos:Concept ;
    skos:definition "A polymer featuring ether functionality, perfluoropolyether (PFPE) refers to one branch of a family of synthetic lubricants developed by DuPont, the oil form of the line commercially known as Krytox (TM). In a conservation context, it is used primarily for waterproofing stone. Its repellent powers also recommend it as an anti-graffiti agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perfluoropolyether"@en .

aat:300379655 a skos:Concept ;
    skos:definition "Refers to gels, such as Carbopol (TM), used in conservation as a non-invasive alternative to aqueous cleaning for paintings and other media, including wood and stone. Solvent gel poultices have also proven effective in removing adhesive tape from paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solvent gel"@en .

aat:300379656 a skos:Concept ;
    skos:definition "In archaeology, refers to all water-saturated archaeological sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet sites"@en .

aat:300379657 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the city of Venice and also of its historic Republic, which flourished from the late 7th century until 1797."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian"@en .

aat:300379658 a skos:Concept ;
    skos:definition "In textile chemistry and conservation: the quality, condition, or degree of whiteness in dyed, undyed, and whitened textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiteness"@en .

aat:300379659 a skos:Concept ;
    skos:definition "Refers to the measurement of a material’s ability to deflect light, and is the ratio of the speed of light in a vacuum to the speed of light in the material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refractive index"@en .

aat:300379660 a skos:Concept ;
    skos:definition "The original, or earliest known, inhabitants of a colony or country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigenous people"@en .

aat:300379661 a skos:Concept ;
    skos:definition "In chemistry, a rapid identification technique which introduces a drop of reagent into a drop of an unknown mixture held on a “spot plate”, on paper or on a microscopic slide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spot test"@en .

aat:300379663 a skos:Concept ;
    skos:definition "Highly controlled laser cleaning technique which allows removal of very thin layers from solid surfaces without damaging substrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser ablation"@en .

aat:300379664 a skos:Concept ;
    skos:definition "Organic chemical compounds capable of forming coordinate bonds with metals. Chelating agents are used to sequester or remove residual trace metal ions from materials to which they have attached. In a conservation context, uses of chelants include stabilizing of paper containing iron-gall ink, removal of iron residue from platinum prints; treatment of excavated copper objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chelating agent"@en .

aat:300379665 a skos:Concept ;
    skos:definition "The quality of being worthy of attention; importance, or consequence. In the conservation and management of cultural heritage contexts, significance is a paradigm of preservation which focuses on the cultural meaning and integrity of what is being preserved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "significance"@en .

aat:300379666 a skos:Concept ;
    skos:definition "Modified nylon developed by DuPont in the 1940's; formerly used in conservation as an adhesive and sizing agent for fragile paper, and as a consolidant for stone and friable pigments. Its use was discontinued following the discovery that over time it becomes insoluble and opaque, and is unsafe to remove."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soluble nylon"@en .

aat:300379668 a skos:Concept ;
    skos:definition "Damage caused by bats, usually chewing damage or damage from droppings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bat damage"@en .

aat:300379669 a skos:Concept ;
    skos:definition "Removal of sizing from textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desizing"@en .

aat:300379670 a skos:Concept ;
    skos:definition "Following slaughter, the extraction of meat from animals for consumption; the trade of a butcher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butchering"@en .

aat:300379671 a skos:Concept ;
    skos:definition "Culture and nationality of ancient Thrace, which occupied territory now shared by Turkey, Southern Bulgaria, and the modern region of Thrace in Northeastern Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thracian"@en .

aat:300379672 a skos:Concept ;
    skos:definition "Technique of activation analysis induced by gamma rays to determine chemical elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gamma ray spectrometry"@en .

aat:300379674 a skos:Concept ;
    skos:definition "In emission spectroscopy, use of an energetic medium promotes the excitation of atoms in a sample. The resulting spectrum of electromagnetic radiation emitted is monitored and analysed using a spectrometer. The most important variant of the technique is atomic emission spectroscopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emission spectroscopy"@en .

aat:300379675 a skos:Concept ;
    skos:definition "An analytical technique which measures quantifiable aspects of a stone’s porosity by forcing a non-wetting liquid, such as mercury, into the pores of the material using a porosimeter. The technique is used in archaeological conservation to determine the durability and behavior of ancient stone and the choice of conservation methods"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porosimetry"@en .

aat:300379676 a skos:Concept ;
    skos:definition "Porosimetry which uses mercury as the non-wetting liquid pressed into the pores of a material by the porosimeter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercury porosimetry"@en .

aat:300379677 a skos:Concept ;
    skos:definition "A toxic and reactive reddish gas, NO2, nitrogen dioxide is an atmospheric pollutant (as in photochemical smog) produced by combustion of fossil fuels. Exposure to nitrogen oxide can cause fading of dyes and organic colorants in paints, textiles, and photographs, as well as deterioration of calcareous stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrogen dioxide"@en .

aat:300379678 a skos:Concept ;
    skos:definition "Refers to any of the various double stranded nucleic acids found in chromosomes of higher organisms which store and transfer genetic information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DNA"@en .

aat:300379679 a skos:Concept ;
    skos:definition "Any of a class of complex organic acids found in chromosomes of cells and viruses that store genetic information or translates the instructions inscribed in this information to the cell’s protein manufacturing sites. The two chief types of nucleic acid are DNA (deoxyribonucleic acid ) and RNA (ribonucleic acid)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nucleic acid"@en .

aat:300379680 a skos:Concept ;
    skos:definition "Refers to DNA recovered from ancient specimens. Ancient DNA is studied by the newly established subdiscipline of archaeology, archaeogenetics, also known as ancient genomics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient DNA"@en .

aat:300379681 a skos:Concept ;
    skos:definition "Any of a class of nucleic acid containing ribose and uracil involved in translating the genetic information inscribed in DNA to the cell’s protein manufacturing sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "RNA"@en .

aat:300379682 a skos:Concept ;
    skos:definition "Refers to conversion of organic material into silica; a form of permineralization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicification"@en .

aat:300379683 a skos:Concept ;
    skos:definition "A technique for cleaning of flesh and grease from skeletal remains of vertebrate specimens for study or display. Bones are steeped in a liquid, usually a chemical or enzymatic solution, for several days to allow soluble matter to dissolve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macerating"@en .

aat:300379684 a skos:Concept ;
    skos:definition "Refers to documentary methods and techniques engaged to provide a detailed record of a particular piece of land, for example an archaeological site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site documentation"@en .

aat:300379685 a skos:Concept ;
    skos:definition "In medicine, direct examination of the interior parts of the body by an optical instrument introduced through insertion or ingestion, the endoscope; in conservation, endoscopy may be performed on objects with hollow bodies, such as musical instruments, globes, or mummies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "endoscopy"@en .

aat:300379686 a skos:Concept ;
    skos:definition "Refers to the culture of a Germanic people who in the early centuries of the Christian era lived in the area of modern Schleswig and along the Baltic coast, and who occupied Germany and the coasts of Gaul and Britain during the 5th and 6th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saxon"@en .

aat:300379687 a skos:Concept ;
    skos:definition "In Egyptology, refers to plastered layers of linen or papyrus tightly pressed and glued together. Used in ancient Egyptian funerary workshops to produce mummy masks and mummy cases by fitting the wet material closely to all or part of the embalmed and wrapped body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartonnage"@en .

aat:300379688 a skos:Concept ;
    skos:definition "A plaster (usually a mix of sand, stone, lime, and water) applied directly to structural walls as a decorative or weather-resistant finish; the coating so produced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "render"@en .

aat:300379689 a skos:Concept ;
    skos:definition "Branch of mechanics that deals with the flow deformation of materials in terms of force (stress, strain) and time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rheology"@en .

aat:300379690 a skos:Concept ;
    skos:definition "In polymer science, refers to the molecular deterioration of polymers caused by overheating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal degradation"@en .

aat:300379691 a skos:Concept ;
    skos:definition "Size of pores in porous materials as related to porosity, pore structure, and pore size distribution; and as measured and described by techniques such as porosimetry and particle characterization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pore size"@en .

aat:300379692 a skos:Concept ;
    skos:definition "Act of leaving something immersed in a liquid for an extended period of time so as to saturate it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soaking"@en .

aat:300379693 a skos:Concept ;
    skos:definition "Photogrammetry performed using digital image capture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital photogrammetry"@en .

aat:300379694 a skos:Concept ;
    skos:definition "Refers to any water-soluble vegetable adhesive created from cooked starch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starch paste"@en .

aat:300379695 a skos:Concept ;
    skos:definition "Refers to aged wheat starch paste, a traditional adhesive used to bond layers of paper and/or silk in the mounting of Japanese scrolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furunori"@en .

aat:300379696 a skos:Concept ;
    skos:definition "A seaweed-derived adhesive similar to agar that is traditionally used by Japanese scroll mounters as a consolidant. In Western conservation, Funori is often used as an adhesive for flaking media. It dries into an extremely smooth matte film, which makes it well suited for adhering fills in very thin paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funori"@en .

aat:300379697 a skos:Concept ;
    skos:definition "Living or animate beings, including animals or people that are fantastic or of anomalous or uncertain aspect or nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creatures"@en .

aat:300379698 a skos:Concept ;
    skos:definition "The act of consuming fluids through the mouth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drinking"@en .

aat:300379701 a skos:Concept ;
    skos:definition "A very strong, controlling, or overpowering emotion or impulse, particularly lust, other desire, hate, or fear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passion"@en .

aat:300379702 a skos:Concept ;
    skos:definition "Genus containing around 100 species of periennial flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anemone"@en .

aat:300379703 a skos:Concept ;
    skos:definition "Genus of bulbous flowering plants native to the eastern Mediterranean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hyacinthus"@en .

aat:300379705 a skos:Concept ;
    skos:definition "Genus of perennial, bulbous plant having showy flowers, native to Eurasia; there are around 100 wild species and over 4,000 horticultural varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tulipa"@en .

aat:300379706 a skos:Concept ;
    skos:definition "Female servants or attendants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maids"@en .

aat:300379708 a skos:Concept ;
    skos:definition "Species of flowering plant native to central and eastern Russia, Kazakhstan, Mongolia, and northwestern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lychnis chalcedonica"@en .

aat:300379710 a skos:Concept ;
    skos:definition "Common term used for members of several families of clams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mussels"@en .

aat:300379712 a skos:Concept ;
    skos:definition "Priestesses, priests, or votaries of the Roman god Bacchus or the counterpart Greek god Dionysus. Typically a male/female distinction is made through spelling, bacchant vs. bacchante."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bacchantes"@en .

aat:300379713 a skos:Concept ;
    skos:definition "Paint containing metallic silver as the primary pigment component, for use in art, for covering a surface, or for conductive purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver paint"@en .

aat:300379715 a skos:Concept ;
    skos:definition "Family of around 900 species of beetles having mandibles (jaws) that are greatly developed in the male and resemble the antlers of a stag. In many species the elaborately branched and toothed mandibles may be as long as the beetle itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lucanidae"@en .

aat:300379717 a skos:Concept ;
    skos:definition "The act of delivering a sermon or religious address."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preaching"@en .

aat:300379719 a skos:Concept ;
    skos:definition "Participating in activities that typically involve conversation and various positive interactions with other people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socializing"@en .

aat:300379721 a skos:Concept ;
    skos:definition "Services comprising a complex of prayers and ceremonies commemorating the crucifixion of Jesus Christ in the Roman Catholic rites. The term is derived from the rite’s Latin formula of dismissal, \"Ite, missa est\" (“Go, it is ended”). The term is also used to refer to the Eucharist in certain Protestant sects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masses"@en .

aat:300379723 a skos:Concept ;
    skos:definition "The expectation of something desired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hope"@en .

aat:300379724 a skos:Concept ;
    skos:definition "Generally, the act of making a request in a humble manner. Specifically, the act of addressing a deity or spirit with supplication, adoration, confession, or thanksgiving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "praying"@en .

aat:300379726 a skos:Concept ;
    skos:definition "Holiday taking place on the first day of May or another day near that date, traditionally marked by springtime festivals and later in many countries also celebrated working people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "May Day"@en .

aat:300379727 a skos:Concept ;
    skos:definition "The aggregate of real things and actual existence as opposed to what is theorized, imagined, or desired. Reality is that which underlies and is the truth of appearances or phenomena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reality"@en .

aat:300379730 a skos:Concept ;
    skos:definition "Evil, malignant beings of superhuman nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demons"@en .

aat:300379732 a skos:Concept ;
    skos:definition "Fictitious woodland creatures, partly human and partly bestial, often having the body of a lion, the tail and horns of an antelope, and the face of an old man."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satyrs"@en .

aat:300379733 a skos:Concept ;
    skos:definition "Imaginary, partly human sea creatures with the head and trunk of a man, usually bearded, and the tail of a fish or cetacean; in Heraldry and elsewhere, often holding a trident and a shell-trumpet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tritons"@en .

aat:300379734 a skos:Concept ;
    skos:definition "Upper surfaces of tables, placed upon legs or other supporting elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabletops"@en .

aat:300379738 a skos:Concept ;
    skos:definition "Real or mythical animals, as distinct from humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beasts"@en .

aat:300379740 a skos:Concept ;
    skos:definition "Legendary creatures having the head, trunk, and arms of a man joined to the body and legs of a horse. The term derives from early Greek literature where it referred to a savage tribe of Thessaly, who were said to be expert horse riders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "centaurs"@en .

aat:300379741 a skos:Concept ;
    skos:definition "Migratory species of slim dove native to Africa, Asia, and Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Streptopelia turtur"@en .

aat:300379743 a skos:Concept ;
    skos:definition "Species of common Eurasian thrush; the male has black plumage and a yellow bill and is noted for its melodious song, and the female is dark brown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turdus merula"@en .

aat:300379745 a skos:Concept ;
    skos:definition "Species of bird in the crow family, found across Europe, western Asia, and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corvus monedula"@en .

aat:300379747 a skos:Concept ;
    skos:definition "General term for various species in the Charadriidae family, generally distinguished by being small to medium-sized, short-billed, gregarious, and typically feeding beside water but sometimes frequenting grassland, tundra, and mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plovers"@en .

aat:300379749 a skos:Concept ;
    skos:definition "Mythical birds resembling an eagle but having red and gold plumage. The phoenix was said to live for hundreds of years, then it would burn itself in a funeral pyre or temple sacrifice, only to rise from the ashes with renewed youth. Variations of the myth place the birds in the deserts of Arabia or in ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phoenixes"@en .

aat:300379750 a skos:Concept ;
    skos:definition "General term for several genera of mid-sized birds in the Galliformes order, in the families Phasianidae and Odontophoridae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quails"@en .

aat:300379752 a skos:Concept ;
    skos:definition "Encounters or fights, often armed, between two persons, parties, animals, or machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combat"@en .

aat:300379753 a skos:Concept ;
    skos:definition "The action or martial art of using specially designed swords as weapons of offense or defense, for sport or in a duel, incorporating defined methods of parries, attacks, and returns. Fencing is of Medieval, and possibly Ancient, origin; it has evolved into several distinct forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fencing"@en .

aat:300379755 a skos:Concept ;
    skos:definition "The state or condition of being unoccupied or inactive, or a habitual avoidance of work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "idleness"@en .

aat:300379756 a skos:Concept ;
    skos:definition "Unrestrained desire, appetite, or inclination for something or someone, usually sexual, and contrary to a culture's moral sense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lust"@en .

aat:300379758 a skos:Concept ;
    skos:definition "Term for all members of the subfamily Threskiornithinae that do not have a spoonbill. They are medium-sized wading birds who inhabit shallow lagoons, lakes, bays, and marshes and use their slender, down-curved bills to feed on small fishes and soft mollusks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ibises"@en .

aat:300379760 a skos:Concept ;
    skos:definition "Legendary creatures, from the Greek meaning \"every wild beast,\" that often take the form of a large cat with a multi-colored coat, but may also be in the form of another animal or a composite creature. The ancient Greeks believed the panther was one of the favored mounts of the god Dionysus. In Medieval legend, the panther would sleep in a cave after feasting upon prey, and after three days emitted a sweet odor from its mouth, to draw additional prey into the cave."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panthers"@en .

aat:300379761 a skos:Concept ;
    skos:definition "The formation or creation of a patina, whether produced naturally as an effect of weathering or artifically induced in the lab."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patination"@en .

aat:300379762 a skos:Concept ;
    skos:definition "The proccess or act of forming into a gel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gelation"@en .

aat:300379763 a skos:Concept ;
    skos:definition "The activity and process of working in stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone-working"@en .

aat:300379764 a skos:Concept ;
    skos:definition "Disturbance of soil and sediment by flora or fauna; in an archaeological context, bioturbation serves to displace and move buried artifacts such as grave goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioturbation"@en .

aat:300379765 a skos:Concept ;
    skos:definition "Practices used to prevent infestation and the health hazards caused by it and to prevent damage to materials and artifacts caused by unwanted rodents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rodent control"@en .

aat:300379766 a skos:Concept ;
    skos:definition "Dwellings built for or inhabited by one or more popes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal residences"@en .

aat:300379767 a skos:Concept ;
    skos:definition "Dwellings built for or inhabited by the president of a nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presidential residences"@en .

aat:300379768 a skos:Concept ;
    skos:definition "The act of sorbing, the taking up and holding of one substance by another. Sorption encompasses the actions of absorption and adsorption performed individually or in combination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sorption"@en .

aat:300379769 a skos:Concept ;
    skos:definition "Signifies the act of drawing forth a material from that which holds it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extracting"@en .

aat:300379770 a skos:Concept ;
    skos:definition "Pure metallic element having symbol TH and atomic number 90; a radioactive, soft, silvery metal most often extracted from the phosphate mineral, monazite. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thorium"@en .

aat:300379771 a skos:Concept ;
    skos:definition "Branch of anatomy that studies bone structure and function. In paleontology, the interpretation of skeletal remains of past populations of organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "osteology"@en .

aat:300379773 a skos:Concept ;
    skos:definition "Domestic architecture designed for a single, extremely specialized purpose or activity, rather than for general or broad use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special use structures"@en .

aat:300379774 a skos:Concept ;
    skos:definition "Refers to the styles and cultures that developed in Egypt under the influence of Roman rule and culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romano-Egyptian"@en .

aat:300379775 a skos:Concept ;
    skos:definition "Carbon dioxide held at or above its critical temperature and pressure in a fluid state. Like all supercritical fluids, its properties are intermediate between those of gases and liquids. Supercritical carbon dioxide has numerous applications as a cleaning, protecting, and consolidating agent in the conservation of materials such as paper, waterlogged wood, stone, and deteriorated textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supercritical carbon dioxide"@en .

aat:300379776 a skos:Concept ;
    skos:definition "Any substance held at or above its critical temperature and pressure in a fluid state. The properties of a supercritical fluid are intermediate between those of the substance in its gaseous and liquid states. A supercritical fluid can both penetrate material like a gas and dissolve material like a liquid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supercritical fluid"@en .

aat:300379777 a skos:Concept ;
    skos:definition "Refers to treatment with steam for such purposes as heating, cleaning, cooking, and disinfecting; in paper conservation, removal of tapes and adhesives after softening with steam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steaming"@en .

aat:300379778 a skos:Concept ;
    skos:definition "Refers to the directed application of a steam producing device, as in spot cleaning of delicate materials such as paper and silk; use of a power steamer to clean stone; removal of dirt from carpets or cleaning of frescoes by means of steam-generating equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steam cleaning"@en .

aat:300379779 a skos:Concept ;
    skos:definition "An ester or salt of phosphoric acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphate"@en .

aat:300379780 a skos:Concept ;
    skos:definition "Compound formed by interaction of free calcium and phosphate. Calcium phosphate is a component of bone and tooth enamel and the chief source of calcium in bovine milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium phosphate"@en .

aat:300379781 a skos:Concept ;
    skos:definition "Any of the salts of magnesium and phosphate, which may appear in monobasic, dibasic, or tribasic form. Deposits of magnesium phosphates bobierrite, newberyte and struvite are found in ivory artifacts and excavated mammoth and elephant tusks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium phosphate"@en .

aat:300379782 a skos:Concept ;
    skos:definition "A complex calcium phosphate, a naturally occuring mineral form of calcium apatite, that serves as an important component of tooth enamel and vertebrate bone. In an archaeological context, hydroxyapatite from human and animal remains is studied to reconstruct ancient diet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydroxyapatite"@en .

aat:300379783 a skos:Concept ;
    skos:definition "A class of volcanic rocks, light in color and density, chiefly composed of alkali feldspar in which a small amount of quartz or oligoclase may also be present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trachyte"@en .

aat:300379784 a skos:Concept ;
    skos:definition "A device which operates as a feedback control system, emitting a signal that measures or detects a physical stimulus such as heat or motion to which it responds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sensors"@en .

aat:300379785 a skos:Concept ;
    skos:definition "Any miniaturized probe with physical dimensions in the submicrometer to millimeter range. Microsensors are manufactured using microelectromechanical systems (MEMS) technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microsensors"@en .

aat:300379786 a skos:Concept ;
    skos:definition "The building and repair of stringed instruments, particularly of the violin family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lutherie"@en .

aat:300379787 a skos:Concept ;
    skos:definition "A silver ore, also known as argentite, acanthite, and silver glance, used in niello work and as a colorant in ceramic glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver sulfide"@en .

aat:300379788 a skos:Concept ;
    skos:definition "Game of medieval origins, the indoor precursor of lawn tennis; originally played by hitting a ball with the hands without rackets, thus the name meaning \"palm game.\" Rackets were eventually introduced. It is now played on an indoor court with four irregularly sized walls, using pear-shaped, lopsided rackets to hit cloth balls that are much harder than those used in lawn tennis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jeu de paume"@en .

aat:300379789 a skos:Concept ;
    skos:definition "Magnetite that possesses polarity. Lodestones, or natural magnets, have been found in Siberia, the Island of Elba, and in Arkansas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lodestone"@en .

aat:300379790 a skos:Concept ;
    skos:definition "Compilations of recorded information, often standardized in format and content and treated as a unit, that are machine readable and created, modified, stored, retrieved, and distributed by digital means. Although analog data is also electronic, this concept does not typically include analog data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic records"@en .

aat:300379791 a skos:Concept ;
    skos:definition "An interpretation of a heritage site offered to the public through display and communication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site interpretation"@en .

aat:300379792 a skos:Concept ;
    skos:definition "Compounds containing silicon, oxygen, and one or more metals. The overwhelming majority of minerals and many rocks and clays are silicates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicates"@en .

aat:300379793 a skos:Concept ;
    skos:definition "A glass-forming soluble silicate salt with many applications. In conservation, potassium silicate in solution has been applied, for example, as a consolidant for fragile stone and earthen structures and as a binder for the pictorial reintegration of outdoor mural paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium silicate"@en .

aat:300379794 a skos:Concept ;
    skos:definition "Molecular breakdown effected by the action of heat; the chemical process by which a compound is converted into one or more products initiated by this thermal reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrolysis"@en .

aat:300379796 a skos:Concept ;
    skos:definition "Translation of data from one particular arrangement of data or characters to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reformatting"@en .

aat:300379797 a skos:Concept ;
    skos:definition "Refers to art produced by Orthodox Christians living in lands once part of the Byzantine empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post-Byzantine"@en .

aat:300379798 a skos:Concept ;
    skos:definition "Portions or limbs of trees or other plants that grow out of the stem or trunk, or out of one of the boughs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "branches"@en .

aat:300379799 a skos:Concept ;
    skos:definition "The activity of cutting with a quick and heavy blow with a hewing, hacking instrument, such as an ax, cleaver, sword, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopping"@en .

aat:300379800 a skos:Concept ;
    skos:definition "General term for various small to medium-sized falconiform birds, most in the families Accipitridae and Falconidae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hawks"@en .

aat:300379802 a skos:Concept ;
    skos:definition "The activity of cutting down a grass or grain crop or stand, such as wheat, corn, a grassy lawn, etc. by using a scythe or machine operating with a similar cutting action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mowing"@en .

aat:300379803 a skos:Concept ;
    skos:definition "The activity of cutting and usually gathering a grain or similar crop, originally by using a sickle or scythe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reaping"@en .

aat:300379804 a skos:Concept ;
    skos:definition "The action of scattering seed for the purpose of producing a crop or other plant cultivation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sowing"@en .

aat:300379805 a skos:Concept ;
    skos:definition "The activity of making furrows in and turning up soil with a plough, generally as a preparation for sowing or planting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plowing"@en .

aat:300379806 a skos:Concept ;
    skos:definition "Stars in the center of a solar system around which planets orbit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suns"@en .

aat:300379807 a skos:Concept ;
    skos:definition "Shrubs or small trees having close branches arising from or near the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bushes"@en .

aat:300379808 a skos:Concept ;
    skos:definition "People who shoot with bow and arrows, whether used in hunting, competition, or war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archers"@en .

aat:300379809 a skos:Concept ;
    skos:definition "Representations that visualize architectural projects in three dimensions, often including a representation of the surrounding site or context, and usually, but not necessarily, built to scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural models"@en .

aat:300379810 a skos:Concept ;
    skos:definition "Refers to mechanics, aesthetics, and installation of hanging textiles, paintings, and other objects for display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging"@en .

aat:300379812 a skos:Concept ;
    skos:definition "The culture and style of the Azores, a group of volcanic islands in the northern Atlantic Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Azorean"@en .

aat:300379813 a skos:Concept ;
    skos:definition "Individuals who were elected pope in opposition to a pope held to be canonically chosen. Primary examples are those who resided at Avignon during the \"great schism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antipopes"@en .

aat:300379814 a skos:Concept ;
    skos:definition "An event characterized by the explosive discharge of lava, gas, steam, ash, and other materials from a volcanic vent or fissure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volcanic eruptions"@en .

aat:300379815 a skos:Concept ;
    skos:definition "A honey-brown calcareous sandstone quarried in Fiesole and other locations in the vicinity of Florence, where it is used as a building stone. The Ponte Vecchio, Pitti Palace, and Palazzo Vecchio are all pietraforte constructions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietraforte"@en .

aat:300379817 a skos:Concept ;
    skos:definition "Marks resulting from contact between a tool and some surface or object that has been shaped, worked by, or otherwise impacted by the tool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tool marks"@en .

aat:300379818 a skos:Concept ;
    skos:definition "Any alteration in regional or global climate as during the five glacial periods of the past 450,000 years. The term is often applied to the recent changes in global climatic patterns, attributed to emission of greenhouse gases, also known as global warming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "climate change"@en .

aat:300379819 a skos:Concept ;
    skos:definition "Silicate ester-based compounds, often used as consolidants. Hydrolysis of the silicic acid ester takes place slowly, so that the silicic acid ester can penetrate deeply into the stone to be strengthened; only in this way can a uniform degree of strength be achieved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicic acid ester"@en .

aat:300379820 a skos:Concept ;
    skos:definition "Strong chelating agent used to sequester and remove metallic salts. A colorless crystalline compound, EDTA is used in medicine as an anticoagulant; stabilizes bleach in detergents; is used in conservation to clean stains from stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "EDTA"@en .

aat:300379821 a skos:Concept ;
    skos:definition "The essential, immaterial, or spiritual part of people or animals, as opposed to the physical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "souls"@en .

aat:300379822 a skos:Concept ;
    skos:definition "State or place of spiritual cleansing and purification, allowing a purging of sins. A notable example is in the doctrine of the Roman Catholic Church, where it is defined as a state where the souls of those who die in grace undergo such punishment as necessary to expiate their unforgiven venial sins before entering heaven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purgatory"@en .

aat:300379823 a skos:Concept ;
    skos:definition "Family of rays having a long flat rostrum lined with sharp transverse teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pristidae"@en .

aat:300379824 a skos:Concept ;
    skos:definition "The act or process of reducing to powder, pulverization; in conservation science context refers to granular disintegration of stone and pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powdering"@en .

aat:300379825 a skos:Concept ;
    skos:definition "A mass of aggregated mineral matter found in sedimentary rocks, usually around a nucleus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concretion"@en .

aat:300379826 a skos:Concept ;
    skos:definition "Refers to granular disintegration of calcite grains in marble caused by dissolution in rainwater, or to similar degradation of glass into millimeter-size fragments resembling granulated sugar, caused by the constant presence of moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugaring"@en .

aat:300379827 a skos:Concept ;
    skos:definition "A sampling technique used in conjunction with infrared spectroscopy; samples may be examined directly in solid or liquid state without further preparation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attenuated total reflectance"@en .

aat:300379828 a skos:Concept ;
    skos:definition "Auxiliary technique of analysis which artificially colors (with stain or dye) portions of the organic material examined to provide contrast between parts, thus facilitating examination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staining"@en .

aat:300379829 a skos:Concept ;
    skos:definition "Refers to polyester polymers used as fibers woven into fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyester"@en .

aat:300379830 a skos:Concept ;
    skos:definition "The movement of charged, heterogeneous particles in a suspension gel under the influence of an electric field created by electrodes of opposite charge set on either side of the suspension; used as technique for analysis of macromolecular substances such as DNA and proteins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrophoresis"@en .

aat:300379831 a skos:Concept ;
    skos:definition "Thin mineral coating composed of iron and manganese oxides deposited on rock surfaces in desert areas. The reddish brown or black desert varnish layers form as moisture evaporates leaving behind dissolved mineral residue which wind abrasion polishes over the course of centuries. Some petroglyphs are images incised in desert varnish, a technique which exposes the lighter stone beneath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desert varnish"@en .

aat:300379832 a skos:Concept ;
    skos:definition "A creamy white or golden colored limestone dating from the Miocene period that is quarried in Lecce, a city in the Salento region of South East Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di Lecce"@en .

aat:300379833 a skos:Concept ;
    skos:definition "Epidemics or pandemics of infectious disease that spread rapidly and have a high mortality rate, whether among people or animals. A prime example is the Black Death, an infectious fever caused by the bacillus Yersinia pestis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plagues"@en .

aat:300379834 a skos:Concept ;
    skos:definition "The action of taking someone away by force, deception, or otherwise without the full, informed consent of the person or his or her legal guardian. In historical usage, the term also implied rape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abduction"@en .

aat:300379835 a skos:Concept ;
    skos:definition "In criminal law, the action of assault in which a person or people have sexual intercourse with another person without that person's consent. The term formerly referred to abduction for this purpose; it was used for the action of carrying off a person, usually a woman, and typically for the purpose of sexual violation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raping"@en .

aat:300379836 a skos:Concept ;
    skos:definition "Porous, fossiliferous limestone, yellowish white in color, quarried near Verona, Italy; used as a construction material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di Vicenza"@en .

aat:300379837 a skos:Concept ;
    skos:definition "A fine grain dolomitic limestone, yellow, white, or pink in color, quarried along the eastern shore of Lago Maggiore near Angera in the Lombardy region of northern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angera stone"@en .

aat:300379838 a skos:Concept ;
    skos:definition "A durable, fossiliferous limestone quarried near Verona, Italy; used as a building material since ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di Prun"@en .

aat:300379839 a skos:Concept ;
    skos:definition "Calcareous tufa stone used for building and sculptural decoration originating in quarries near the town of Mendicino in Calabria, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di Mendicino"@en .

aat:300379840 a skos:Concept ;
    skos:definition "Beige colored limestone used as a building and construction material quarried near town of San Lucido in province of Cosenza, Calabria, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di San Lucido"@en .

aat:300379841 a skos:Concept ;
    skos:definition "System of chronological notation, characterized by the numbering of years from an event or some other particular point of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "era"@en .

aat:300379842 a skos:Concept ;
    skos:definition "Identification of a person with a particular state or nation. In a modern sense, the it is the legal status of being a citizen or subject of a particular state, usually involving mutual obligations of support and protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nationality"@en .

aat:300379843 a skos:Concept ;
    skos:definition "Refers to several groups of greenschist found in the Italian Central Alps which contain carvable soapstone; much used in the Middle Ages as a material for the production of food preparation and storage vessels, and of stoves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra ollare"@en .

aat:300379844 a skos:Concept ;
    skos:definition "Institutions that were originally based on the model of art museums, with the mission of collecting films and other moving image materials for posterity and making important works available for public appreciation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film archives"@en .

aat:300379845 a skos:Concept ;
    skos:definition "Buildings housing archives of films and other moving image materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film archives"@en .

aat:300379846 a skos:Concept ;
    skos:definition "Bluish sandstone used as a building material; quarried near the towns of Oggiono and Sirone in Lombardy, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra d'Oggiono"@en .

aat:300379847 a skos:Concept ;
    skos:definition "An easily worked yellow-brown fossiliferous limestone quarried in the Berici Hills south of Vicenza. It has been used since ancient times as a building and ornamental stone; the cathedral of Padua is a pietra di Nanto construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di Nanto"@en .

aat:300379848 a skos:Concept ;
    skos:definition "The action of drawing milk from a teat or breast by hand, or more recently, mechanically; usually performed on a cow, goat, or other domesticated mammal. For infants or baby mammals taking nourishment with their mouths directly from a breast or teat, use \"suckling.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milking"@en .

aat:300379849 a skos:Concept ;
    skos:definition "Written solemn invocations of blessedness, for the purpose of being officially pronounced by an ecclesiastical functionary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benedictions"@en .

aat:300379850 a skos:Concept ;
    skos:definition "A red colored limestone quarried near Verona, Italy from the \"Rosso Ammonitico Veronese\" formation; used as a construction material in buildings and monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra di Verona"@en .

aat:300379851 a skos:Concept ;
    skos:definition "Solid carbon dioxide; used as a refrigerant. In the conservation science dry ice is sometimes used for cryogenic blasting of objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry ice"@en .

aat:300379852 a skos:Concept ;
    skos:definition "A finish containing resins, also called durable press, applied to fabric to stabilize its shape and make it crease-resistant. By extension, fabrics so finished."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "permanent press"@en .

aat:300379854 a skos:Concept ;
    skos:definition "Styles, periods, and cultures of ancient Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient European"@en .

aat:300379855 a skos:Concept ;
    skos:definition "Pertaining to the style and culture of the Gauls in the area of Western Europe including present day France, Luxembourg, Belgium, Switzerland, Northern Italy, and parts of the Netherlands and Germany on the west bank of the Rhine, particularly during the Iron Age and Roman era. For the style and culture of the Gauls under the influence of the Romans, use \"Gallo-Roman.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gallic"@en .

aat:300379856 a skos:Concept ;
    skos:definition "Sacred songs that may be sung or recited in religious worship, particularly those contained in the Book of Psalms in the Old Testament and Hebrew Scriptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "psalms"@en .

aat:300379857 a skos:Concept ;
    skos:definition "Lidded boxes, often decorated, that were placed on the dressing table and contained pins, ribbons, feathers, and other adornments for dressing; they may also contain separate lidded cosmetic canisters. Often used for a lady's toilette, although men used them as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toilet caskets"@en .

aat:300379859 a skos:Concept ;
    skos:definition "The action, mental attitude, or state of holding or treating someone, something, a situation, etc. as vile, worthless, or unimportant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contempt"@en .

aat:300379860 a skos:Concept ;
    skos:definition "Any infusion of carbon dioxide into a liquid. In geology, refers to interaction of dissolved carbon dioxide with minerals, especially limestone, in water; a form of chemical weathering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbonation"@en .

aat:300379861 a skos:Concept ;
    skos:definition "The process of obtaining or generating a visual representation of something by means of photography, radar, ultrasound, X-rays, or other technique, typically for a purpose such as examination, research, medical diagnosis, or reconnaissance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imaging"@en .

aat:300379862 a skos:Concept ;
    skos:definition "Refers to approach involving knowledge and methods drawn from several disciplines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multidisciplinarity"@en .

aat:300379863 a skos:Concept ;
    skos:definition "A salt or ester of nitric acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrate"@en .

aat:300379864 a skos:Concept ;
    skos:definition "Refers to glazing that considers values including reflectivity, strength, weight, color, heat transfer, and ultraviolet absorption, for a variety of protective applications including architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protective glazing"@en .

aat:300379866 a skos:Concept ;
    skos:definition "A chamber designed to create a vacuum environment by removal of air and gasses with a pump. In conservation science practice, vacuum chambers are used for such purposes as drying, degassing, fumigation, resin impregnation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum chambers"@en .

aat:300379867 a skos:Concept ;
    skos:definition "The theory and practice of planning, organizing, coordinating, and leading a project in order to meet specific goals and objectives in a timely and cost-efficient manner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "project management"@en .

aat:300379868 a skos:Concept ;
    skos:definition "Large wooden cabinets having subdivisions, drawers, shelves, and usually doors or a fall front, designed particularly for housing rare, precious, or interesting items. For small, private chambers designed for this purpose, use \"cabinets of curiosities.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "display cabinets"@en .

aat:300379869 a skos:Concept ;
    skos:definition "Substances of animal, vegetable, mineral, or synthetic origin that are used as an ingredient in pharmacy, in the prevention or treatment of disease, as a medicine, or to otherwise obtain a physiological effect on a living organism. Also includes substances having intoxicating, stimulant, or narcotic effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drugs"@en .

aat:300379870 a skos:Concept ;
    skos:definition "Named after the first-century BCE physician Philon of Tarsus. To relieve pain, induce sleep, prevent miscarriages, and reduce the pain of hemorrhoids and of heavy menstruation, pharmacists offered this drug, made from such ingredients as opium, saffron, white pepper, pearls, and amber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian philonium"@en .

aat:300379871 a skos:Concept ;
    skos:definition "Management of all stages of the life cycle of data assets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data management"@en .

aat:300379872 a skos:Concept ;
    skos:definition "A water-soluble compound created by bubbling carbon dioxide through a suspension of magnesium carbonate in water. In conservation, magnesium bicarbonate solutions are used for deacidifcation of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium bicarbonate"@en .

aat:300379874 a skos:Concept ;
    skos:definition "People who apply color to sculpture or other carvings, including adding details, shading, and decorations. Medieval and Renaissance polychromers were considered artists who could be as important as the sculptor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polychromers"@en .

aat:300379875 a skos:Concept ;
    skos:definition "The activity of putting to death, depriving of life, slaying, or slaughtering a living thing. Originally implied personal agency, often with violence or the use of a weapon, but later usage extends to ending life by any means or cause, including an accident, over-work, grief, drink, a disease, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "killing"@en .

aat:300379876 a skos:Concept ;
    skos:definition "A water-soluble polymer, commonly known as carboxymethylcellulose (CMC), composed of the sodium salt of modified cellulose. A viscous gel when dispersed in water at low concentrations, CMC forms a tough, non-soluble film in reaction with heavy metal salts. In conservation, it is used as an adhesive and as a poultice for cleaning stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium carboxymethyl cellulose"@en .

aat:300379877 a skos:Concept ;
    skos:definition "General term for techniques involving heat. For example, for metalworking and other activities, may include annealing, tempering, carburizing, normalizing, and quenching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heat treatment"@en .

aat:300379878 a skos:Concept ;
    skos:definition "Any correction or removal of errors. In techniques such as photogrammetry and aerial photography, rectification refers to compensation for predictably distortive data routinely added to procedures in order to produce correct results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectification"@en .

aat:300379879 a skos:Concept ;
    skos:definition "Legislation that exhaustively covers a complete system of laws or a particular area of law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "law codes"@en .

aat:300379880 a skos:Concept ;
    skos:definition "A branch of civil engineering which applies principles of rock and soil mechanics to the study of subsurface conditions. In a conservation context, geotechnical engineering is used in the monitoring and preservation of monuments and historic sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geotechnical engineering"@en .

aat:300379881 a skos:Concept ;
    skos:definition "Matreial made of thermoplastic polymer or copolymer of ethylene, forming a durable, lightweight, resilient, closed-cell material. Often used for packaging fragile goods due to its excellent vibration dampening and insulation properties. It also offers high resistance to chemicals and moisture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyethylene foam"@en .

aat:300379882 a skos:Concept ;
    skos:definition "Refers to any of several commercially prepared oxygen absorbing powders to be deployed in a sealed environment for insect eradication and oxygen-free storage in museums and archives; they are also used to extend the shelf-life of commercial food items. All contain a chemical compound the active ingredient of which is a finely divided iron oxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxygen absorber"@en .

aat:300379883 a skos:Concept ;
    skos:definition "Electroanalytical technique used in analytical chemistry to determine the chemical makeup of small concentrations of metals in a substance by measuring electrical activity on electrodes placed in the substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voltammetry"@en .

aat:300379884 a skos:Concept ;
    skos:definition "Panoramic picture painted on a cylindrical wall surface designed to afford a viewer in the middle of the room a 365 degree view of the painting seen in natural perspective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cycloramas"@en .

aat:300379885 a skos:Concept ;
    skos:definition "Geographical migration of technology and technological processes from place of origin as with the transfer of bronze casting technology from major cultural centers of China to peripheral areas in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "technology transfer"@en .

aat:300379887 a skos:Concept ;
    skos:definition "A surface designed for relining of oil paintings patented by art restorer George T. Oliver in 1937. Instead of ironing a new canvas onto the old one, the most practiced method to date, this technique bonds the two canvases, which have been coated with a molten adhesive, on a hot metal plate. A pump evacuates oxygen between the canvases and adhesion occurs upon cooling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum hot tables"@en .

aat:300379888 a skos:Concept ;
    skos:definition "Type of metaphor where an explicit comparison is made between two different things in order to create a new meaning, generally using the words \"like\" or \"as.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "simile"@en .

aat:300379889 a skos:Concept ;
    skos:definition "A sodium compound which in its anhydrous form occurs in nature as a chemical precipitate found in the minerals thenardite and mirabilite. It may also be obtained synthetically by mixing sodium chloride and sulfuric acid. As a solid or powder, sodium sulphate is used in the manufacture of various products. In conservation science it is addressed as an agent of salt damage to stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium sulfate"@en .

aat:300379890 a skos:Concept ;
    skos:definition "Sheets, typically of paper or vellum, that were formerly parts of manuscripts or other volumes, but have been disconnected, separated, unattached, or otherwise removed from the volume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "detached leaves"@en .

aat:300379892 a skos:Concept ;
    skos:definition "The state or status of legal dissolution of marriage by a court or other authoritative body, or according to forms recognized by a country, nation, culture, or tribe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divorce"@en .

aat:300379895 a skos:Concept ;
    skos:definition "Refers to procedures and techniques which determine range of sizes or mean or average size of particles in a granular or powder sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particle size analysis"@en .

aat:300379896 a skos:Concept ;
    skos:definition "The body or bodies of a deceased person or people, in whole or in parts, regardless of the stage of decomposition or preservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human remains"@en .

aat:300379898 a skos:Concept ;
    skos:definition "Priestesses in ancient Roman religion who tended the state cult of Vesta, the goddess of the hearth; the cult existed from ca. 7th century BCE until it was banned in 394 CE by Theodosius I. Each vestal virgin served for 30 years, during which time she remained chaste and tended to the rituals of the temple, such as tending the perpetual fire in the Temple of Vesta, fetching water from a sacred spring, preparing ritual food, and officiating at the annual Vestalia festival. The virgins lived in the House of the Vestal Virgins on the Roman Forum, near the Temple of Vesta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vestal virgins"@en .

aat:300379899 a skos:Concept ;
    skos:definition "Dishes that are broad, round, open, and have a flat bottom, with straight or concave sides that are deeper than a plate but not so deep as a basin or bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep dishes"@en .

aat:300379900 a skos:Concept ;
    skos:definition "Symbolical or ornamental monogram for the name of Jesus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "IHS"@en .

aat:300379901 a skos:Concept ;
    skos:definition "Racks in which letters and papers are kept, typically located on a desk or mounted on a wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter racks"@en .

aat:300379902 a skos:Concept ;
    skos:definition "Something written, said, or done to excite laughter or amusement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jokes"@en .

aat:300379903 a skos:Concept ;
    skos:definition "Drinking glasses designed to be as difficult as possible to drink from without spilling the alcoholic beverage within, often including a tube that served as a straw. The goal was to amuse the onlookers at the expense of the imbiber: in drinking competitions, the drinker had to guess how to drink from the vessel; if any liquor was spilled, he was required to start again with a full glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joke glasses"@en .

aat:300379904 a skos:Concept ;
    skos:definition "The action of tossing and catching a number of objects continuously, keeping at least one of them in the air while handling the others, usually as a form of entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "juggling"@en .

aat:300379905 a skos:Concept ;
    skos:definition "The action of a human infant or other baby mammal taking milk by mouth from the breast or teat a female, usually their mother. For drawing milk from a breast or teat by hand or mechanically, use \"milking.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nursing"@en .

aat:300379907 a skos:Concept ;
    skos:definition "Surveys which gather geophysical data for a location systematically. In archaeology, refers to prospection techniques, such as ground penetrating radar and magnetic survey, used to locate artefacts and map subsurface archaeological features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geophysical surveys"@en .

aat:300379908 a skos:Concept ;
    skos:definition "The use of or investigation with a Raman microscope, a laser-based device employed as a component of a Raman spectroscopic system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raman microscopy"@en .

aat:300379909 a skos:Concept ;
    skos:definition "Refers to radioactive dating employing techniques which exploit the properties of the radioisotopic decay of uranium; in archaeology and paleontology, used especially for dating fossilized bones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uranium-series dating"@en .

aat:300379910 a skos:Concept ;
    skos:definition "A multivariate forecasting technique used to predict group membership from a linear combination of two or more interval dependent variables. Used in archaeology, as for example to develop classification functions for otoliths from fish which once lived in an archeological site in order to differentiate the species they belonged to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discriminant analysis"@en .

aat:300379911 a skos:Concept ;
    skos:definition "The activity of breaking up or loosening the surface of the ground, dislodging weeds, or covering plants with soil using a specialized agricultural implement that has a thin, flat blade set transversely at the end of a long handle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoeing"@en .

aat:300379912 a skos:Concept ;
    skos:definition "Broadly refers to the quality of coexisting harmoniously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compatibility"@en .

aat:300379913 a skos:Concept ;
    skos:definition "Meetings having to do with international relations at the highest level, occurring between heads of state or governments or their foreign ministers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "summit meetings"@en .

aat:300379914 a skos:Concept ;
    skos:definition "Clemency and compassion shown to a person who is in a position of powerlessness or subjection, or where severity is merited or expected, usually in giving legal judgment or passing sentence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercy"@en .

aat:300379915 a skos:Concept ;
    skos:definition "Activities that are intended to be pettily irritating, annoying, playfully taunting, or vexing to another person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teasing"@en .

aat:300379916 a skos:Concept ;
    skos:definition "Use of or investigation with any microscope employing a laser illumination source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser microscopy"@en .

aat:300379917 a skos:Concept ;
    skos:definition "A measure of the stiffness of a material, its resistance to bending; the ratio of stress to strain in flexural deformation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flexural modulus"@en .

aat:300379918 a skos:Concept ;
    skos:definition "Movement of molecules of a liquid through a semipermeable biological membrane from a less concentrated field into one of greater solute concentration under the influence of an electric field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electroosmosis"@en .

aat:300379919 a skos:Concept ;
    skos:definition "Drawings created by incorporating only or primarily the strokes and marks used for calligraphy. Examples are found in Western and Middle Eastern manuscripts, Asian art, and Western works of the 18th and 19th century that were created as exercises of skill during penmanship training."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calligraphic drawings"@en .

aat:300379920 a skos:Concept ;
    skos:definition "Movement of molecules of a liquid through a semipermeable membrane from a region of high solute concentration into a less concentrated field; a reversal of normal flow that occurs when hydrostatic pressure exceeds the osmotic pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reverse osmosis"@en .

aat:300379921 a skos:Concept ;
    skos:definition "The branch of science that deals with the detection or measurement of radiant photomagnetic energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiometry"@en .

aat:300379922 a skos:Concept ;
    skos:definition "The characteristic of being not harmful to living organisms or biological processes; not causing a toxic or harmful response."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biocompatibility"@en .

aat:300379923 a skos:Concept ;
    skos:definition "Hydrous sodium carbonate found in nature as evaporative residues. Used widely as a silica source in early glass manufacture; in ancient Egypt used as well as a bleach for linen, a preservative in mummification, and as an ingredient of incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natron"@en .

aat:300379924 a skos:Concept ;
    skos:definition "Treatment of cotton yarn or fabric by immersion in a caustic solution of sodium hydroxide or other chemical base. Fibers so treated swell permanently, and the cotton is made stronger and more lustrous. Named after Alexander Mercer (1791-1866), who perfected the process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercerizing"@en .

aat:300379925 a skos:Concept ;
    skos:definition "White crystalline salt that occurs in nature as the mineral magnesite and may be prepared artificially by precipitation. It is used in pigments, inks, glass, ceramic glazes, and dentifrice. Magnesium carbonate has also been used as a sorbent powder for water-free (dry) cleaning of jewelry, doll hair, and other items. Aqueous solutions of magnesium carbonate are used for neutralization and alkalization of paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium carbonate"@en .

aat:300379926 a skos:Concept ;
    skos:definition "In chemistry, application of statistical and mathematical methods to chemical data and experimental design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemometrics"@en .

aat:300379927 a skos:Concept ;
    skos:definition "Institutions that collect and maintain geological specimens displayed for public benefit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological museums"@en .

aat:300379928 a skos:Concept ;
    skos:definition "Refers to the calcium salt of phytic acid. In conservation, used in a solution to inhibit iron gall corrosion on manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium phytate"@en .

aat:300379929 a skos:Concept ;
    skos:definition "Hydroxypropyl cellulose (HPC) is a water-soluble cellulose ether used as an emulsifier, thickener, and suspending agent in many types of solutions. In conservation, HPC is used as a consolidant for leather afflicted by \"red rot\", and as a fixative for pigments and dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydroxypropyl cellulose"@en .

aat:300379930 a skos:Concept ;
    skos:definition "Technique developed by John Fenn in the late 1980s, an improved method of ionizing samples for use in mass spectrometry. Electrospray ionization (ESI) discharges a solution of a sample into an electric field that disperses the sample as fine droplets. ESI is especially useful for samples containing macromolecules, prone to fragmenting in other techniques of ionization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrospray ionization"@en .

aat:300379931 a skos:Concept ;
    skos:definition "Limonite refers to any hydrated iron ore. A brownish yellow deposit, it is formed by precipitation in marshy areas and is found mixed in clay and sand as loose powder or as a mass. Limonite is also called bog iron ore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limonite"@en .

aat:300379932 a skos:Concept ;
    skos:definition "A turquoise colored pigment used in ancient Egyptian and Mediterranean wall painting, Egyptian green is similar in chemical composition to Egyptian blue with which it is sometimes confused."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian green"@en .

aat:300379933 a skos:Concept ;
    skos:definition "A variant on traditional electrophoresis, capillary electrophoresis (CE) is designed to separate particles by species. A sample is placed in a capillary tube subjected to a high-voltage charge which separates the constituent ions by differences in size, shape, and charge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capillary electrophoresis"@en .

aat:300379934 a skos:Concept ;
    skos:definition "Refers to the culture of the Basque region in the western Pyrenees, spanning the borders of modern France and Spain, which is inhabited by a people of unknown origin who spaek a non-Aryan language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basque"@en .

aat:300379935 a skos:Concept ;
    skos:definition "The hard nut or seed of several types of palm tree which resembles ivory in hardness and appearance and serves as a substitute. Vegetable ivory is used for small, carved, ornamental items such as buttons and figurines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetable ivory"@en .

aat:300379936 a skos:Concept ;
    skos:definition "Any of a large class of dyes that contain sodium salts of sulfonic or carboylic acid which react with polyamides (such as silk, wool, and nylon) to create a uniform, lightfast color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acid dye"@en .

aat:300379937 a skos:Concept ;
    skos:definition "Events, usually murders or executions, resulting in the deaths of people who are willing to sacrifice their lives for the sake of religion or principle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martyrdoms"@en .

aat:300379938 a skos:Concept ;
    skos:definition "In metallurgy, a technique for hardening and encrusting metal in which molten metal is plunged into cold water or oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quenching"@en .

aat:300379940 a skos:Concept ;
    skos:definition "Refers to national and international voluntary groups and organizations, unaffiliated with any government and usually nonprofit, such as the UN (from which body the term originated), charity groups, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nongovernmental organizations"@en .

aat:300379941 a skos:Concept ;
    skos:definition "Hollow microscopic spheres made of glass or ceramic used as filler, especially in bulk for insulation or buoyancy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microballoons"@en .

aat:300379942 a skos:Concept ;
    skos:definition "Any compound joining fluorine to another element or to an organic group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluoride"@en .

aat:300379943 a skos:Concept ;
    skos:definition "Surveying instruments, comprising an electronic theodolite integrated with an electronic distance meter. The data they record in the field can be downloaded directly to a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "total stations"@en .

aat:300379944 a skos:Concept ;
    skos:definition "To mend by covering a hole or weakened area on a surface with a patch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patching"@en .

aat:300379945 a skos:Concept ;
    skos:definition "Measuring of fluorescence with a fluorimeter; a technique that stimulates substances with monochromatic radiation causing them to emit fluorescence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorimetry"@en .

aat:300379946 a skos:Concept ;
    skos:definition "A mineral composed of aluminum sulfate and hydrous basic calcium often formed by the reaction of sulfates and concrete or mortar. Ettringite crystal formation induces sulfate decay in the cement paste matrix. Conservation interventions seek to remove ettringite or limit its attack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ettringite"@en .

aat:300379947 a skos:Concept ;
    skos:definition "Loud crying, uproar, or vocal clamor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shouting"@en .

aat:300379948 a skos:Concept ;
    skos:definition "Relatively small, flat objects, often rectangular, used to cover roofs, floors or walls, as game pieces, as lids, or for other purposes. Originally referred to such objects made of baked earth or earthenware, but modern usage includes such items made of other materials, including metal or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiles"@en .

aat:300379949 a skos:Concept ;
    skos:definition "A game played with rectangular pieces or tiles, usually 28, having various numbers of pips marked on the pieces; players position ends of tiles having the corresponding number of pips in contact with each other as long as this can be done; the player who has the lowest number of pips on his or her remaining tiles is the winner."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dominoes"@en .

aat:300379952 a skos:Concept ;
    skos:definition "To become opaque, darken and lose clarity, mist up. In conservation context, refers to opacification of stained glass and enamels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opacification"@en .

aat:300379953 a skos:Concept ;
    skos:definition "A subjective state of feeling defined as bad or harmful."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negative emotions"@en .

aat:300379954 a skos:Concept ;
    skos:definition "A subjective state of feeling defined as good or beneficial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "positive emotions"@en .

aat:300379955 a skos:Concept ;
    skos:definition "The process or action of rendering magnetic; the condition of being magnetized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetization"@en .

aat:300379956 a skos:Concept ;
    skos:definition "The action, process, or state of floating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flotation"@en .

aat:300379958 a skos:Concept ;
    skos:definition "In science, the taking of minute samples for technical analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microsampling"@en .

aat:300379959 a skos:Concept ;
    skos:definition "Genus of flowering plant native to Asia and Europe, but cultivated elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chrysanthemum"@en .

aat:300379961 a skos:Concept ;
    skos:definition "Fruit of Punica granatum, a bush or small tree of Asia. The fruit is the size of a large orange, obscurely six-sided, with a smooth, leathery skin that ranges from brownish yellow to red; within, it is divided into several chambers containing many thin, transparent vesicles of reddish, juicy pulp, each surrounding an angular, elongated seed. The fruit is eaten fresh, and the juice is the source of grenadine syrup, used in flavorings and liqueurs. Throughout the East, the pomegranate has since earliest times occupied a position of importance alongside the grape and the fig."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pomegranates"@en .

aat:300379962 a skos:Concept ;
    skos:definition "The action of moving or turning a door, gate, window, tap, lid, or other component away from its closed position so as to allow passage or access."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opening"@en .

aat:300379963 a skos:Concept ;
    skos:definition "The action of moving or turning a door, gate, window, tap, lid, or other component away from its open position so as to stop or prevent passage or access."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "closing"@en .

aat:300379964 a skos:Concept ;
    skos:definition "The activity of saying farewell and going away from a person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leave-taking"@en .

aat:300379965 a skos:Concept ;
    skos:definition "Officers, for example in ancient Rome, whose functions were to attend upon a magistrate, bearing the fasces before him, and to execute sentence of judgement upon offenders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lictors"@en .

aat:300379966 a skos:Concept ;
    skos:definition "To speak or reason in opposition, to raise objections, contend, or dispute as a way to prove, evince, or show weighty reasons for supposing a proposition or for refuting another’s position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arguing"@en .

aat:300379967 a skos:Concept ;
    skos:definition "To contend, strive for victory, struggle, or engage in conflict in any of various senses, both physically and verbally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fighting"@en .

aat:300379968 a skos:Concept ;
    skos:definition "Standard mosaic process and technique using small cubes of uniform size known as tesserae, made of hard materials such as stone and glass, applied to a ground to form ornamental patterns and pictures. While opus tessellatum was initially a cheap substitute for finer mosaic work executed in the more complex technique of \"opus vermiculatum,\" it eventually became the dominant technique and remained so throughout the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus tessellatum"@en .

aat:300379969 a skos:Concept ;
    skos:definition "Technique producing pavement made of concrete mixed with crushed tiles, stones, or gravel favored in Roman houses from the 1st century BCE through the 1st century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus signinum"@en .

aat:300379970 a skos:Concept ;
    skos:definition "Technique in ancient Roman construction, using hydraulic-setting brick-faced concrete; most used during the late Roman Republic and the Roman Imperial period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus caementicium"@en .

aat:300379971 a skos:Concept ;
    skos:definition "Ancient Roman construction technique in which fired clay bricks or tiles were laid upon a core of concrete: opus caementicium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus latericium"@en .

aat:300379972 a skos:Concept ;
    skos:definition "Late Roman and Byzantine pierced metalwork technique performed upon a soft metal such as gold using a drill and chisel to produce arabesques and other lacey ornamental designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus interrasile"@en .

aat:300379973 a skos:Concept ;
    skos:definition "Ancient Roman ashlar masonry technique adopted from Etruscan stone construction; squared, cut blocks laid in regular courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus quadratum"@en .

aat:300379975 a skos:Concept ;
    skos:definition "Branch of medical science which treats distribution of disease in populations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epidemiology"@en .

aat:300379976 a skos:Concept ;
    skos:definition "The pumps at a service station that supply motor vehicles with gasoline drawn from underground storage tanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gasoline pumps"@en .

aat:300379977 a skos:Concept ;
    skos:definition "A sweet-tasting, white, crystalline amino acid that is a constituent of many animal proteins; found in sugar cane, animal glue, and gelatin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glycine"@en .

aat:300379978 a skos:Concept ;
    skos:definition "Binary compound formed from a halogen and another element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halide"@en .

aat:300379979 a skos:Concept ;
    skos:definition "White, water soluble crystalline or granular powder, commonly known as baking soda or bicarbonate of soda. It is used as a leavening agent for baking; in medicine as an antacid; as a whitening agent in toothpastes; a fire retardant; a stain-absorbing ingredient in dry cleaning preparations. Chemical formula: NaHC03."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium bicarbonate"@en .

aat:300379980 a skos:Concept ;
    skos:definition "To sift or strain by passing through a screen. In archaeology, refers to sieving of archaeological sediments to collect fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sieving"@en .

aat:300379981 a skos:Concept ;
    skos:definition "Refers to a type of maiolica earthenware, distinguished by its milky white base glaze, made in and around the city of Puebla, Mexico since the sixteenth century. Talavera's name derives from Talavera de la Reina, Spain, whose tin-glazed earthenware served as the initial model for this colonial variant introduced by Spanish craftsmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Talavera"@en .

aat:300379982 a skos:Concept ;
    skos:definition "The skin of a bird, generally with feathers still attached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bird skin"@en .

aat:300379983 a skos:Concept ;
    skos:definition "A class of binary boron-hydrogen compounds; a derivative of such a compound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borane"@en .

aat:300379984 a skos:Concept ;
    skos:definition "Refers to the manufacture of rope and the stages of that process, from spinning through twisting or braiding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ropemaking"@en .

aat:300379985 a skos:Concept ;
    skos:definition "Various activities or disciplines concerning combat and self defense that arose as the fighting arts of the warrior and are now often practiced as sport. They include both armed and unarmed forms of combat, as well as non-combative styles. Martial arts traditionally emphasize control, spiritual training, and the unity of body and mind. Many are of East Asian origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martial arts"@en .

aat:300379986 a skos:Concept ;
    skos:definition "The process of separating, shredding, pulling asunder, carding, or back-combing fibers or hairs in order to draw fibers or hairs in a given direction for the purpose of separating, forming a nap, or increasing volume. Examples of use of the term include in fiber processing, weaving textiles, and in hairdressing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teasing"@en .

aat:300379987 a skos:Concept ;
    skos:definition "Beginning in the 1980s, sites designated by US Congress and administered by non-profit organizations or state governments where natural, cultural, and historic resources combine to form a nationally important landscape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "National Heritage Areas"@en .

aat:300379988 a skos:Concept ;
    skos:definition "Refers to a process of endothermic reaction in which thermal decomposition or a phase transition of a solid material without fusing is induced by heating it at temperatures below the melting point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcining"@en .

aat:300379989 a skos:Concept ;
    skos:definition "Churches incorporated into hospitals, especially in complexes of the Middle Ages and Renaissance, as with S. Maria della Scala, Siena."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospital churches"@en .

aat:300379990 a skos:Concept ;
    skos:definition "In biology, a modification of a protein’s structure brought about by heat, alkalis, and other factors, which causes it to collapse into a disordered mass. The process Is irreversible for most proteins. In conservation science, the denaturation of leather and parchment is studied by various analytical techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denaturation"@en .

aat:300379991 a skos:Concept ;
    skos:definition "Refers to any rock or mineral from which iron can be extracted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron ore"@en .

aat:300379992 a skos:Concept ;
    skos:definition "Colorless, noxious, highly flammable, poisonous gas, a combination of phosphorous and hydrogen. While it has been employed as a fast-acting, inexpensive fumigant which leaves no residue, health hazards associated with phosphine, as well as the compound's capacity to damage such materials as leather, feathers, and fur, have restricted its use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphine"@en .

aat:300379993 a skos:Concept ;
    skos:definition "The removal of lignin from woody tissue, usually by industrial chemical processes. Delignification is undertaken in the pulping of wood for applications such as paper-making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "delignification"@en .

aat:300379994 a skos:Concept ;
    skos:definition "Refers to countries with low per capita income and an undeveloped industrial base relative to other countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developing countries"@en .

aat:300379995 a skos:Concept ;
    skos:definition "Removal of gum or gummy substance from a material, deglutination. In textile conservation, refers specifically to removal of sericin from raw silk by various methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "degumming"@en .

aat:300379996 a skos:Concept ;
    skos:definition "A method of removing or reducing the acid content, usually of paper, that uses water as the solvent carrier of the alkaline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aqueous deacidification"@en .

aat:300379997 a skos:Concept ;
    skos:definition "A colorless, flammable, quickly evaporating gas, vinyl chloride is a monomer principally used, in its refrigerated liquid form, to make polyvinyl chloride (PVC)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vinyl chloride"@en .

aat:300379998 a skos:Concept ;
    skos:definition "In regions of southwestern Asia and northern Africa, a valley or ravine which becomes a watercourse during rainy season."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wadis"@en .

aat:300379999 a skos:Concept ;
    skos:definition "Any process or agent that destroys bacteria. Irradiation, chemicals like chlorophenol, or other organisms, such as bacteriophages, can act as bactericides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bactericide"@en .

aat:300380000 a skos:Concept ;
    skos:definition "Refers to hard cast steel made by various techniques, all of which involve heating of materials in crucibles. Modern equipment, such as the electric arc furnace, has made these methods obsolete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crucible steel"@en .

aat:300380001 a skos:Concept ;
    skos:definition "Removal or deprivation of color. In discussion of textiles, decolorizing refers to removal of a dyestuff, whether by physical separation methods such as washing, or by chemical means such as bleaching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decolorizing"@en .

aat:300380002 a skos:Concept ;
    skos:definition "Structures created by animals other than humans, most commonly by various mammals, birds, insects, and arachnids, occasionally by fish, reptiles, amphibians, crustaceans, mollusks, annelids, marine filter feeders, and others. Building materials may be collected material or self-secreted material. Animals create structures primarily to make protected habitats for thermo-regulation and safety from predators, to trap prey, and for display between members of the same species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal architecture"@en .

aat:300380003 a skos:Concept ;
    skos:definition "Structures made or places chosen and adapted by a bird, insect, or other animal in which to lay and incubate its eggs and usually to rear its young. The term may also be used for structures or places used by animals who do not lay eggs, but use nests to shelter newborn young."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nests"@en .

aat:300380004 a skos:Concept ;
    skos:definition "General term for devices or tools used for compressing, flattening, giving a denser consistency to, holding, or shaping an object or substance by exerting pressure, whether mechanical or not."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presses"@en .

aat:300380005 a skos:Concept ;
    skos:definition "Any of several laboratory testing techniques based on the binding of antigen to antibody that are used to detect or measure biochemical substances involved in immunological reactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immunoassaying"@en .

aat:300380006 a skos:Concept ;
    skos:definition "Parties, specifically those in ancient Greece, which featured drinking and intellectual conversation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symposia"@en .

aat:300380007 a skos:Concept ;
    skos:definition "Oxide of magnesium, a highly refractive, white, powdery material used in ceramic glazes, bricks, magnesia cement, and other industrial processes. In paper conservation, magnesium oxide has been used as a nonaqueous alkalization agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium oxide"@en .

aat:300380008 a skos:Concept ;
    skos:definition "Immunoassay technique in which the substance to be detected or measured is tagged with a radioactive tracer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radioimmunoassaying"@en .

aat:300380009 a skos:Concept ;
    skos:definition "A yellowish-gold artificial pigment composed of stannic sulfide. Mosaic gold was used in gilding and by illuminators from the 13th century until the 19th century when it was superseded by bronze powders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mosaic gold"@en .

aat:300380010 a skos:Concept ;
    skos:definition "Any action or technique used to prevent shrinkage in textile materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrinkproofing"@en .

aat:300380011 a skos:Concept ;
    skos:definition "Chlorine compound commonly used as a bleaching agent for textiles and paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium chlorite"@en .

aat:300380012 a skos:Concept ;
    skos:definition "Refers to the process of combining a substance with carbon. In metallurgy. the diffusion of carbon into wrought iron at high temperature to produce steel; or into low carbon steel to increase surface hardness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carburization"@en .

aat:300380013 a skos:Concept ;
    skos:definition "Refers to the style and culture of the Middle East and other places, influenced and spread by the religion of Islam. The term is used for the style and culture regardless of whether or not the context is religious."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic"@en .

aat:300380014 a skos:Concept ;
    skos:definition "Salt or ester of boric acid. Borate has many applications, chief among them as wood preservative and corrosion inhibitor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borate"@en .

aat:300380015 a skos:Concept ;
    skos:definition "Any secondary mineral deposit formed by water in a cave such as a stalactite or stalagmite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "speleothems"@en .

aat:300380016 a skos:Concept ;
    skos:definition "Decay in plants and plant-derived materials such as timber marked by deterioration of tissues and caused chiefly by fungi and bacteria. By extension, decomposition of stone, leather, textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rot"@en .

aat:300380017 a skos:Concept ;
    skos:definition "An incrustation or deposit, more or less like an inverted stalactite, on the floor of a cavern, formed by the dropping from the roof of some material in solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stalagmites"@en .

aat:300380018 a skos:Concept ;
    skos:definition "Refers to the act of dissolving or the condition of being dissolved. In chemistry, molecular dispersion of a substance in a liquid, the transfer of a solid into a solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissolution"@en .

aat:300380019 a skos:Concept ;
    skos:definition "Beehives made of baskets placed open-end-down, in use for over 2,000 years in beekeeping. Early examples were made of wicker plastered with mud and dung; later examples were made of straw or coils of grass. Typically there is a single entrance at the bottom of the bee skep. There is no internal structure provided for the bees, as the colony produces its own honeycomb attached to the inside of the bee skep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bee skeps"@en .

aat:300380021 a skos:Concept ;
    skos:definition "Beehives located in a hollow tree or log. The term derives from the use of Black Gum trees for this practice in the southern United States. Natural hollowed trees, often modified by humans, have long been used by beekeepers of Europe; the practice continued in the Americas. Eventually, practice evolved so that harvested sections of hollow trees were set upright in apiaries, often with sticks inserted for support of the honeycomb. As with bee skeps, harvest of honey from a bee gum destroys the colony. For a general reference to bee nests, use the broader \"beehives (apiaries).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bee gums"@en .

aat:300380022 a skos:Concept ;
    skos:definition "A colorless, somewhat cloudy alkaline solution of slaked lime used medicinally as an antacid and as an ingredient in calamine lotion. In art, limewater is used in buon fresco technique to impregnate fresh plaster before application of secco colors, a process related to whitewashing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limewater"@en .

aat:300380023 a skos:Concept ;
    skos:definition "Paratacamite is a basic chloride of copper sometimes used as a green pigment in painting. In a conservation context, its presence as a deposit on bronze and copper artifacts indicates bronze disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paratacamite"@en .

aat:300380024 a skos:Concept ;
    skos:definition "All chemical elements possess one or more types of unstable as well as stable isotopes. The former are known as radioisotopes or radioactive isotopes. Their nuclei dissipate excess energy as alpha, beta, and gamma rays. This radioactive decay forms the basis for the measuring processes of radioactive dating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radioisotopes"@en .

aat:300380025 a skos:Concept ;
    skos:definition "Traditional Japanese alloy of copper and gold. It is often subjected to a chemical process that produces a blue-black patina. Shakudo has historically been used for ornamental fittings as on katana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shakudo"@en .

aat:300380026 a skos:Concept ;
    skos:definition "Chinese purple (also called Han purple) is a synthetic barium copper silicate pigment developed in China at least 2,000 years ago. Chinese purple fades and decomposes over time, particularly in contact with acids or heat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese purple"@en .

aat:300380027 a skos:Concept ;
    skos:definition "Heritage sites and the lands related to them committed to providing a cultural, recreational, and cultural resource for the public at large."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural parks"@en .

aat:300380028 a skos:Concept ;
    skos:definition "A traditional crucible steel of southern India used for wire and sharp edged tools. Although associated in the popular imagination with Damascene swords, and legendarily a supersteel, wootz has a brittle structure subject to shattering, making it more suitable for ceremonial blades than for actual use in battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wootz"@en .

aat:300380029 a skos:Concept ;
    skos:definition "General term for over 1,500 species of single-celled fungi in the phyla Ascomycota and Basidiomycota."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yeast"@en .

aat:300380030 a skos:Concept ;
    skos:definition "Broadly refers to any sulfide of copper, more specifically to the blackish crystalline sulfide CuS used in textile dyeing and as a black pigment in ancient painting. The presence of copper sulfide on the surface of ancient bronze artifacts has generated much debate over whether it should be seen as symptomatic of copper corrosion or as an intentional patination technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper sulfide"@en .

aat:300380031 a skos:Concept ;
    skos:definition "Refers to technique that induces a viewer wearing spectroscopic glasses to see a pair of two dimensional images of the same object captured from slightly different angles as a single entity existing in three dimensions in space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereoscopy"@en .

aat:300380032 a skos:Concept ;
    skos:definition "A substance that adds oxygen or removes hydrogen in chemical reaction with another compound. Used as bleaches that whiten or decolorize in conjunction with oxidizing agents. Examples of reducing agents include: sulfites, bisulfites, dithionite, and sodium borohydride."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reducing agent"@en .

aat:300380033 a skos:Concept ;
    skos:definition "Any material intended to resemble genuine tortoise shell, which is a material made from the thinly sliced horny plates covering the shells of some turtles and tortoises."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation tortoise shell"@en .

aat:300380034 a skos:Concept ;
    skos:definition "Synthetic dissacharide used as sugar substitute in low calorie foods and as an osmotic laxative. In conservation, lactitol has found use as a consolidant for waterlogged wood, a superior substitute for natural sugars used traditionally in this role."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lactitol"@en .

aat:300380035 a skos:Concept ;
    skos:definition "Study of fractured surfaces of materials, visually or with a microscope. By determining type of crack growth, fractography aims to identify the mode of failure and the conditions which might cause it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fractography"@en .

aat:300380036 a skos:Concept ;
    skos:definition "Radiation counters into which the sample is introduced in the form of a gas through the counter tube. The phenomenon of gas multiplication is used to increase pulse size which facilitates processing of the sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proportional counters"@en .

aat:300380037 a skos:Concept ;
    skos:definition "Chipping stone, especially flint, with sharp, quick blows to manufacture tools through a process of lithic reduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knapping"@en .

aat:300380038 a skos:Concept ;
    skos:definition "Collective term for all clastic material ejected from a volcano during an eruption, especially ash."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tephra"@en .

aat:300380039 a skos:Concept ;
    skos:definition "To apply wax to a surface for protection, impermeability, or as decorative finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waxing"@en .

aat:300380040 a skos:Concept ;
    skos:definition "Any enzyme which splits triglyceride fats into their component fatty acids and glycerol. Lipase, found in the body, aids in the digestion of food. Lipase, added to detergents, aids cleaning. In conservation, lipase is sometimes used for removal of oil-based varnishes from paintings and of oil stains from drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lipase"@en .

aat:300380041 a skos:Concept ;
    skos:definition "Zirconium is a metallic element having symbol Zr and atomic weight 91.22. It is obtained from zircon and other minerals and is commercially the most important ore. A hard metal resistant to heat and corrosion, it is much used in nuclear reactors, in alloys, refractories, and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zirconium"@en .

aat:300380042 a skos:Concept ;
    skos:definition "A hard, crystalline solid solution of carbon in iron, martensite is the chief constituent of hardened steel. It is a decomposition product of austenite formed by rapid quenching from high temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martensite"@en .

aat:300380043 a skos:Concept ;
    skos:definition "The style and culture of Illyria, an ancient country and later a Roman province that comprised the European eastern Adriatic coast and hinterland, inhabited by the Indo-European Illyrians. The name was apparently reference to a single Illyrian tribe that was the first to come into contact with the ancient Greeks, but the Greeks applied the name \"Illyrian\" to all people of similar language and customs in the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Illyrian"@en .

aat:300380044 a skos:Concept ;
    skos:definition "Digestive enzyme that breaks down starch by hydrolysis into its basic sugars. In conservation, used for removal of starch adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amylase"@en .

aat:300380045 a skos:Concept ;
    skos:definition "White, crystalline compound formerly used extensively as wood preservative, antiseptic and disinfectant, insecticide, and, in archival conservation, a fungicide for paper and books. Due to its toxicity mercuric chloride's use is now restricted in the U.S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercuric chloride"@en .

aat:300380047 a skos:Concept ;
    skos:definition "A white, amorphous mineral composed of silicate, carbonate, and calcium sulfate. It is often formed by the reaction of sulfates and concrete or mortar. Thaumasite crystal formation induces sulfate decay in the cement paste matrix. Conservation interventions seek to remove thaumasite or limit its attack."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thaumasite"@en .

aat:300380048 a skos:Concept ;
    skos:definition "Electrophoresis in which the migration of proteins occurs under an applied electric field through a gel medium having a pH gradient towards a region where they are isoelectric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isoelectric focusing"@en .

aat:300380049 a skos:Concept ;
    skos:definition "Any liquid, gaseous, or solid foreign body enclosed within the matrix of another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inclusions"@en .

aat:300380051 a skos:Concept ;
    skos:definition "Chitosan is the deacetylated form of chitin, the chief component in the exoskeletons of crustaceans, insects, and beetles. It is used in horticulture and agriculture as a biopesticide, and plant growth enhancer; and in medicine as a coagulant. As a sprayed coating, cyanoethylated chitosan is used to protect historic paper material. Chitosan is also found as an organic component incorporated into polymer materials to form a self-healing coating which promises to render the painted surfaces it is applied to scratch-free."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chitosan"@en .

aat:300380052 a skos:Concept ;
    skos:definition "The only genus in the flowering plant family Paeoniaceae. They are native to Asia, Southern Europe and Western North America. Boundaries between species are not clear and estimates of the number of species range from 25 to 40."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paeonia"@en .

aat:300380053 a skos:Concept ;
    skos:definition "Refers to hydrophobic silane used as coating on stone or concrete to repel water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkylalkoxysilane"@en .

aat:300380054 a skos:Concept ;
    skos:definition "A luminous paint which reflects absorbed ultraviolet energy as visible light. Fluorescent paints appear to glow in daylight because they emit more than one hundred percent of visible incident radiation. They contain metal salts whose strongly fluorescing organic molecules absorb energy from light and give it back in the form of photons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescent paint"@en .

aat:300380055 a skos:Concept ;
    skos:definition "A trademarked name for polytetrafluoroethyelene (PTFE) which was discovered by Roy Plunkett 1938 and first marketed as Teflon (TM) by DuPont in 1943. This fluorinated polymer is known for its resistance to adhesion, heat, oxidation, light, and chemicals. It is used chiefly for molding articles and for nonstick cookware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Teflon (TM)"@en .

aat:300380056 a skos:Concept ;
    skos:definition "Compounds derived from barberry (Berberis vulgaris) bush, both from the berry and from the bark. Used as pigment and medicinally for antimicrobial properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "berberine"@en .

aat:300380057 a skos:Concept ;
    skos:definition "A byproduct of the sulfate pulping paper making process, dimethyl sulfoxide is a compound used as a solvent and a methylating agent. It is also used medicinally as an anti-inflammatory agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimethyl sulfoxide"@en .

aat:300380058 a skos:Concept ;
    skos:definition "A chemical compound; in conservation, a chelating agent of ammonium salt of citric acid used in solution for surface cleaning of paper, paintings, and other materials. May also be used as a buffering agent, preservative, and food additive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triammonium citrate"@en .

aat:300380059 a skos:Concept ;
    skos:definition "Trademarked name for water soluble polymers composed of cellulose ethers used as protective colloids. In conservation, Tylose (TM) has been used to resize brittle paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tylose (TM)"@en .

aat:300380060 a skos:Concept ;
    skos:definition "Trademarked name for a sheer openweave monofilament polyester fabric produced until 2004. Stabiltex (TM) has been used as a support fabric in textile conservation, a polyester crepeline for covering fragile textiles. Tetex TR (TM), produced by Sefar, is essentially the same material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stabiltex (TM)"@en .

aat:300380061 a skos:Concept ;
    skos:definition "Nymphs who preside over bodies of freshwater, including springs, streams, rivers, fountains, and wells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naiads"@en .

aat:300380062 a skos:Concept ;
    skos:definition "Refers to any polymerized olefin. Polypropylene and polyethylene are the two most common polyolefins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyolefin"@en .

aat:300380063 a skos:Concept ;
    skos:definition "A granitoid rock found in southern India used as a material in local construction and sculpture. Named (by T.L. Walker in 1902) after regional tribe, the Konds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khondalite"@en .

aat:300380064 a skos:Concept ;
    skos:definition "General term for any of the red, green, or brown marine algae that grow along seashores. Seaweeds are generally anchored to the sea bottom or other solid structures by rootlike “holdfasts,” which perform the sole function of attachment and do not extract nutrients as do the roots of higher plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seaweed"@en .

aat:300380065 a skos:Concept ;
    skos:definition "Refers to any English-Viking cultural interaction during the middle ages. Anglo-Scandinavian also more narrowly denotes the period and style in York, England between the death of Eric Bloodaxe in 954 and the arrival of the Normans in 1068 during which Viking influence coexisted with English rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Scandinavian"@en .

aat:300380066 a skos:Concept ;
    skos:definition "A liquid compound used as an anesthetic in obstetrics, and in conservation as a degreasing solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trichloroethylene"@en .

aat:300380067 a skos:Concept ;
    skos:definition "Generic name for any of a class of compounds formerly used as a fire-extinguishing agent. When exposed to flame, these chlorofluorocarbon gases release halogen atoms which interact with hydrogen atoms, suppressing combustion in the process. They also deplete the earth's ozone when exposed to solar ultraviolet light and have consequently been withdrawn from use. Included in the group are Halon: dichlorodifluoromethane, CCl2F2; Halon 1211: bromochlorodifluoromethane, CBrClF2; and Halon 1301: trifluorobromomethane, CBrF3."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halon"@en .

aat:300380068 a skos:Concept ;
    skos:definition "Class of compounds derived from isocyanic acid used in manufacture of polyurethane resins for use in foam, coatings, and adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isocyanate"@en .

aat:300380070 a skos:Concept ;
    skos:definition "Refers to members of the most commonly used group of non-aqueous liquid solvents, organic compounds that contain carbon atoms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic solvent"@en .

aat:300380071 a skos:Concept ;
    skos:definition "Refers to the process of creating data models in software engineering by applying formal techniques such as probability theory and statistics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data modeling"@en .

aat:300380072 a skos:Concept ;
    skos:definition "Technique for determining measurement of the size distribution of granular material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granulometry"@en .

aat:300380073 a skos:Concept ;
    skos:definition "The style and culture that existed during the period of the Persian Empire, primarily dating to the late 6th-late 4th centuries BCE, as seen in gems and other objects created in Anatolia (Turkey) and elsewhere, combining Greek style and subjects with Persian style and subjects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greco-Persian"@en .

aat:300380074 a skos:Concept ;
    skos:definition "In chemistry, a process of separation in which components of a mixture are removed in successive stages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fractionation"@en .

aat:300380075 a skos:Concept ;
    skos:definition "Any of a class of low molecular-weight synthetic varnish resins, also known as ketone resins, composed of polymerized cyclohexanone and/or methyl cyclohexanone and widely used for picture varnishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polycyclohexanone"@en .

aat:300380076 a skos:Concept ;
    skos:definition "Trademarked commercial name for a series of paraxylylene-based polymers used as a vapor-formed conformal coating highly resistant to organic solvents, inorganic reagents, and acids. Among its applications, Parylene is used as a protective coating in conservation of paper, photographs, book bindings, and other archival materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parylene (TM)"@en .

aat:300380077 a skos:Concept ;
    skos:definition "An open, sheer, linen-weave fabric, made in silk or synthetic fibers. It is often used as a support fabric in the conservation of fragile textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crepeline"@en .

aat:300380078 a skos:Concept ;
    skos:definition "A volatile, organozinc liquid compound used in mass deacidification of library materials. Because it ignites upon exposure to air, diethyl zinc can only be used in conservation under controlled conditions, released within a specially designed vacuum chamber from which oxygen has been evacuated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diethyl zinc"@en .

aat:300380079 a skos:Concept ;
    skos:definition "Refers to oxalate with ammonia commercially produced as colorless crystals used for dyeing textiles and in other applications. In conservation, ammonium oxalate in solution is used as a treatment for calcium carbonate based surfaces (such as limestones, marbles, historical wall paintings). It forms a protective layer of calcium oxalate on surfaces through chemical reaction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium oxalate"@en .

aat:300380080 a skos:Concept ;
    skos:definition "Melinex is the trademarked name for one in a series of clear polyethylene terephthalate (PET) polyester films produced by DuPont."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Melinex (TM)"@en .

aat:300380081 a skos:Concept ;
    skos:definition "Trademarked name for a series of polyoxazoline compounds marketed as high performance water soluble polymers with many applications. In conservation, Aquazol compounds are applied to a wide range of object materials as a consolidant, adhesive, inpainting medium, fill material, and barrier coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aquazol (TM)"@en .

aat:300380082 a skos:Concept ;
    skos:definition "Any member of a class of organic compounds that contain the carbonyl group (in which a carbon atom is doubly bonded to an oxygen atom), and in which the group is bonded to at least one hydrogen. With the exception of formaldehyde, a gas, aldehydes are acrid, volatile liquids. Their chief use is as chemical intermediates in polymer production for manufacture of solvents, dyes, resins, plasticizers, and pharmaceuticals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aldehyde"@en .

aat:300380083 a skos:Concept ;
    skos:definition "Trademarked name for a series of low molecular weight, hydrogenated hydrocarbon resins. In conservation, it is used as a varnish for furniture and pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Regalrez (TM)"@en .

aat:300380086 a skos:Concept ;
    skos:definition "The action or process by which a polymer is decomposed into its constituent monomers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depolymerization"@en .

aat:300380087 a skos:Concept ;
    skos:definition "Genus containing about 250 species of fern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dryopteris"@en .

aat:300380089 a skos:Concept ;
    skos:definition "Endoscopy assisted by a video camera on the tip of the endoscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "videoendoscopy"@en .

aat:300380090 a skos:Concept ;
    skos:definition "Visual works and other objects made of more than one material; for example, an object made of bronze, terracotta, and amber. The term is used in archaeological conservation and other disciplines. For modern works where the artist employs multiple materials, use \"multimedia works.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite objects"@en .

aat:300380091 a skos:Concept ;
    skos:definition "Refers to any variety of paper that has been processed to make it transparent; for use especially in tracing and in overlay. Types include natural tracing, imitation parchment, and glassine papers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparent paper"@en .

aat:300380092 a skos:Concept ;
    skos:definition "Trademarked name for series of spunbonded sheet products made of olefin fiber. This durable, tear resistant, waterproof polyethylene fabric has many applications. These include use as paper, garments, a protective liner in packing crates and display, and is widely used as a material in book conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tyvek (TM)"@en .

aat:300380093 a skos:Concept ;
    skos:definition "Refers to the culture of the indigenous Arctic people, also referred to as Lapp, who have inhabited portions of northern Scandinavia and Russia for thousands of years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sami"@en .

aat:300380094 a skos:Concept ;
    skos:definition "Trademarked name for an impregnating agent, an acetal copolymer used in conservation of damaged and acid paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Regnal (TM)"@en .

aat:300380097 a skos:Concept ;
    skos:definition "People employed to deliver mail to residences or businesses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter carriers"@en .

aat:300380098 a skos:Concept ;
    skos:definition "People taking part in boisterous mirth or merrymaking, or involved in wild or noisy festivities, especially those involving drinking of alcoholic beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revelers"@en .

aat:300380099 a skos:Concept ;
    skos:definition "The act of discharging urine, which is liquid excretion of metabolic waste in vertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urinating"@en .

aat:300380101 a skos:Concept ;
    skos:definition "Occasions of prolonged, extreme, and general scarcity of food in an area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "famines"@en .

aat:300380102 a skos:Concept ;
    skos:definition "Coarse homespun cloth, usually reddish or brownish in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "russet"@en .

aat:300380105 a skos:Concept ;
    skos:definition "Imaginary figures who are naked, winged boys, often holding a bow and arrow. So-called from their origin with the Roman god, Cupid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cupids"@en .

aat:300380106 a skos:Concept ;
    skos:definition "Intimate sexual contact between two individuals involving penetration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sexual intercourse"@en .

aat:300380107 a skos:Concept ;
    skos:definition "Weights used in athletic training, as depicted in classical Greek sculpture and vase painting. Two shaped weights joined by a leather strap are swung by a long-jumper to increase momentum. The weights themselves have been depicted in various forms from half-moon to cylindrical hourglass shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jumping-weights"@en .

aat:300380109 a skos:Concept ;
    skos:definition "Fantastical creatures having the body of a locust insect and often the face of a devil, tasked with tormenting people rather than crops; particularly as described in the Bible, Revelations. Alternatively, they may be described as having the body of a scorpion or of a horse. Ultimately derived from folkloric descriptions of real plagues of locusts or stinging insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demon locusts"@en .

aat:300380110 a skos:Concept ;
    skos:definition "Gold applied over a silver object using the fire-gilding method or by electrolysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver gilding"@en .

aat:300380115 a skos:Concept ;
    skos:definition "Greek headdresses as depicted on Attic vases, often appearing with dotted motifs or patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saccoi"@en .

aat:300380118 a skos:Concept ;
    skos:definition "Drivers of chariots, which are ancient, animal-drawn, wheeled vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charioteers"@en .

aat:300380119 a skos:Concept ;
    skos:definition "Legendary marine animals that are dangerous and of terrifying proportions and shape, often resembling a huge fish or cetacean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea monsters"@en .

aat:300380120 a skos:Concept ;
    skos:definition "A type of red garnet composed of iron aluminum silicate. Almandine can range in color from pale violet to bright red, or from purplish to brownish black. Almandine was a popular gemstone in antiquity, particularly in ancient Rome and Egypt. Today, gemstone quality almandine is mined in Asia Minor, Sri Lanka, Australia, Alaska, Africa, Norway, Sweden, and Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almandine"@en .

aat:300380122 a skos:Concept ;
    skos:definition "A particular type of breccia marble, composed of fragments of rocks of several different colors, found in Provence, France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brèche d'Alep"@en .

aat:300380124 a skos:Concept ;
    skos:definition "The process of coating an object with a thin adherent layer of silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver plating"@en .

aat:300380125 a skos:Concept ;
    skos:definition "In Greek mythology and elsewhere, beings having human form but of superhuman stature, found frequently in mythic or pseudo-historical traditions and in romantic fiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "giants"@en .

aat:300380126 a skos:Concept ;
    skos:definition "Honorary rewards, usually involving monetary compensation, awarded in recognition of excellence or work done, or as a fee for services rendered; distinguished from salary and other forms of payment. For the actions and functions surrounding honors in general, without the connotation of monetary compensation, use \"honors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honoraria"@en .

aat:300380127 a skos:Concept ;
    skos:definition "Male domestic fowls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roosters"@en .

aat:300380129 a skos:Concept ;
    skos:definition "Erotic embrace of a sex act. The term is used in art history, classical studies, and archaeology to refer to explicit depictions of complex and unusual sexual positions, or unusual pairings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symplegma"@en .

aat:300380130 a skos:Concept ;
    skos:definition "New World hardwood derived from several species of the Swartzia genus, having a dark reddish brown, purplish, or nearly black heartwood and pale yellowish white sapwood that is sharply demarcated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wamara"@en .

aat:300380134 a skos:Concept ;
    skos:definition "A white, medium-grain marble composed of greater than 90% calcium magnesium carbonate. Dolomitic marbles were quarried in Cape Vathy on Thasos from antiquity to about the 5th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolomitic marble"@en .

aat:300380135 a skos:Concept ;
    skos:definition "Formulas of words spoken or chanted, intended to produce a magical effect; may include magical ceremonies or arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incantations"@en .

aat:300380136 a skos:Concept ;
    skos:definition "A disorder of the brain that causes periodic seizures, and sensory or psychic malfunction in an individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epilepsy"@en .

aat:300380137 a skos:Concept ;
    skos:definition "A pink to light violet variety of garnet; is used as a gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhodolite"@en .

aat:300380138 a skos:Concept ;
    skos:definition "Family of large and highly terrestrial birds, related to the cranes and rails; found primarily in dry open country and steppes in Europe, Asia, Australia, and part of New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Otididae"@en .

aat:300380140 a skos:Concept ;
    skos:definition "General term for several species of medium-sized water birds that are members of the rail family Rallidae, most but not all in the genus Gallinula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moorhens"@en .

aat:300380141 a skos:Concept ;
    skos:definition "The actvity of visiting monuments, landscapes, and other places of interest in a particular location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sightseeing"@en .

aat:300380145 a skos:Concept ;
    skos:definition "Having to do with the formation or following of a cult, which is a religious group having beliefs that differ significantly from dominant or orthodox religions or society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultism"@en .

aat:300380146 a skos:Concept ;
    skos:definition "Describes depictions of human habitation of countryside or pastoral areas, most often including some aspect of farming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural life"@en .

aat:300380148 a skos:Concept ;
    skos:definition "Photographic negatives printed on paper used to make contact prints on other photosensitized materials. The first paper negatives were themselves contact prints of physical objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper negatives"@en .

aat:300380150 a skos:Concept ;
    skos:definition "Accumulated learning and soundness of judgment in the choice of means and ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wisdom"@en .

aat:300380151 a skos:Concept ;
    skos:definition "People, usually women, employed by a family to care for one or more children for an extended period, typically living in the household and attending to the children day and night."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nannies"@en .

aat:300380152 a skos:Concept ;
    skos:definition "People who have traveled in space as crew members on board a spacecraft or on a space mission."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronauts"@en .

aat:300380156 a skos:Concept ;
    skos:definition "The action of inhaling and exhaling smoke, usually that of burning leaves of various forms of vegetation, from a cigarette, pipe, cigar, or other controlled implement for inhalation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoking"@en .

aat:300380157 a skos:Concept ;
    skos:definition "People whose occupation or trade is to transport, mine, or otherwise procure or process coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colliers"@en .

aat:300380159 a skos:Concept ;
    skos:definition "Fabulous marine animals resembling a sea horse or equine, having two front legs and a lower body ending in a dolphin's or fish's tail. Often accompanying the chariot of Neptune and other sea deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hippocampi"@en .

aat:300380160 a skos:Concept ;
    skos:definition "Mass meetings of people for the purpose of showing support for a cause or protest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rallies"@en .

aat:300380161 a skos:Concept ;
    skos:definition "Slight bounds or springs performed in succession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skipping"@en .

aat:300380162 a skos:Concept ;
    skos:definition "Plants that are cultivated for food, typically restricted to the edible parts of a herbaceous plant (such as leaves, stems, or roots) that are traditionally served as a savory course of a meal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetables"@en .

aat:300380164 a skos:Concept ;
    skos:definition "Occasions when the Sun is obscured to observers on Earth by the Moon coming between the Sun and Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar eclipses"@en .

aat:300380165 a skos:Concept ;
    skos:definition "The act of placing oneself or another person or object upon a surface in a horizontal position, usually on the back. The term may also modify a representation of a figure in a recumbent posture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reclining"@en .

aat:300380166 a skos:Concept ;
    skos:definition "Type of heavily armed foot soldiers of ancient Greece in use from ca. late 8th century BCE, specializing in close-formation fighting. Prior to the appearance of hoplites, individual combat between heroes predominated in warfare. New, heavier armor and the thrusting sword, rather than throwing spear, gave the hoplites stronger protection as foot soldiers, enabling the formation of a compact phalanx that was very successful. Greek hoplites were renowned as the best fighters in the Mediterranean world and in great demand as mercenaries in ancient Lydia, Babylonia, and Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoplites"@en .

aat:300380167 a skos:Concept ;
    skos:definition "Hot springs that intermittently throw up jets of water and steam in a fountain-like column. Geysers result from the heating of groundwater by shallow bodies of magma; they are generally associated with areas that have been the site of volcanic activity in the past."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geysers"@en .

aat:300380169 a skos:Concept ;
    skos:definition "Trademarked name for an acrylic resin used in solution as a consolidant and adhesive in painting conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plexisol P550 (TM)"@en .

aat:300380170 a skos:Concept ;
    skos:definition "Pure metallic element having symbol MO and atomic number 42; a gray silvery metal. Use also for this metal as processed and formed, usually in combination with other substances, to make objects and materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molybdenum"@en .

aat:300380171 a skos:Concept ;
    skos:definition "Fine, soft, light wool from merino sheep resembling cashmere; also yarn or fabric made from the wool, sometimes in combination with cotton. By extension any fine woolen yarn used in knitwear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "merino"@en .

aat:300380172 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Ir and atomic number 77; a hard, brittle silvery-white metal of the platinum family. Iridium is the most corrosion-resistant metal and the second densest chemical element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iridium"@en .

aat:300380173 a skos:Concept ;
    skos:definition "Subtractive process which progressively removes base metals from a gold-containing alloy to produce a nearly pure layer of gold. Depletion gilding was used in ancient Greece, in Egypt in the second century BC, and in pre-Columbian America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depletion gilding"@en .

aat:300380174 a skos:Concept ;
    skos:definition "Groups of atoms capable of selective absorption of electromagnetic radiation, usually in the ultraviolet region, resulting in the coloration of organic compounds. The carbonyl and diazo groups are examples of chromophores."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chromophores"@en .

aat:300380175 a skos:Concept ;
    skos:definition "Monosulfide of iron found in nature as pyrrhotite and troilite. It is synthesized to use in generating hydrogen sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrous sulfide"@en .

aat:300380176 a skos:Concept ;
    skos:definition "White, sweet tasting, crystalline alcohol found in berries, fruits, algae. This simple sugar is used as a humectant in conservation of leather, paper, vellum, and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sorbitol"@en .

aat:300380177 a skos:Concept ;
    skos:definition "Polymers containing relatively few monomers, usually less than five."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oligomers"@en .

aat:300380178 a skos:Concept ;
    skos:definition "White, sweet-tasting, crystalline sugar alcohol which occurs naturally in many plants and algae. Mannitol is used widely as a dietary supplement and dietetic sweetener. In conservation, mannitol is used in tandem with sucrose for impregnation of waterlogged wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mannitol"@en .

aat:300380179 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Rb and atomic number 37; soft, silvery white, and very reactive, rubidium is found as a trace constituent of various alkali minerals. It is used in photoelectric cells and as a catalyst."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubidium"@en .

aat:300380180 a skos:Concept ;
    skos:definition "The practice of identifying and describing terrestrial objects pictured in aerial photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photointerpretation"@en .

aat:300380181 a skos:Concept ;
    skos:definition "Silane used as a crosslinking agent of silicone rubber and a coupling agent of glass fiber and treatment agents of reinforced plastic laminated product. It is also used as a consolidant in combination with Paraloid B-72 (TM) acrylic resin to treat deteriorated limestones, sandstones, and marbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyltrimethoxysilane"@en .

aat:300380182 a skos:Concept ;
    skos:definition "Process or action of transforming a molecule into an isomer of itself, i.e. a molecule whose atoms remain the same but are differently arranged."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isomerization"@en .

aat:300380183 a skos:Concept ;
    skos:definition "Toxic, flammable, colorless gas that smells like rotten eggs. Hydrogen sulfide may be created by decay of organic matter or obtained as a byproduct of refining carbonaceous fuels such as natural gas, crude oil, and coal. As an atmospheric pollutant, hydrogen sulfide blackens lead pigments, and tarnishes silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogen sulfide"@en .

aat:300380184 a skos:Concept ;
    skos:definition "Practice of measuring distance indirectly using a tacheometer, an instrument that allows rapid location of points on a survey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tacheometry"@en .

aat:300380185 a skos:Concept ;
    skos:definition "Mass deacidication process using magnesium titanium alkoxid developed by the Battelle Institute, Switzerland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papersave Process (TM)"@en .

aat:300380186 a skos:Concept ;
    skos:definition "Lines on weather maps joining locations of equal temperature at a given time or equal mean temperature over a given period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isotherms"@en .

aat:300380187 a skos:Concept ;
    skos:definition "Generic term for the class of electrostatic copying techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrography"@en .

aat:300380188 a skos:Concept ;
    skos:definition "Damage caused by rodents, including chewing, nesting, and droppings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rodent damage"@en .

aat:300380189 a skos:Concept ;
    skos:definition "Applied decoration comprising tinfoil pressed into a mold to create a surface of lines and patterns that suggest brocaded fabric. Warm wax or wax resin-based paste was then applied to the surface. This resulted in a pattern which was gilded and painted and then roundly cut with the foil. The molded product was then applied to the surface of a painting or sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pressbrokat"@en .

aat:300380190 a skos:Concept ;
    skos:definition "Resistance of a material to mildew as conferred by natural properties or by application of a fungicidal agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mildew resistance"@en .

aat:300380191 a skos:Concept ;
    skos:definition "Sheet material in which the medium is made from cardboard with a honeycomb core. Acid-free honeycomb board is used in conservation as a support panel in treatment of materials and objects such as parchment, textiles, maps, and drawings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honeycomb board"@en .

aat:300380192 a skos:Concept ;
    skos:definition "Traditional apparel expressing the regional, national, community, or ethnic identity of a population. Folk costume may be reserved for ceremonial events or be found in everyday use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folk costume"@en .

aat:300380193 a skos:Concept ;
    skos:definition "Wood of the Thuja plicata species, having a reddish to dull brown heartwood with a faint, sweetish odor. The wood is used for shingles, boat making, and other purposes for which resistance to moisture, decay, and insect damage is important."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "western red cedar"@en .

aat:300380194 a skos:Concept ;
    skos:definition "Information gathered and used for analysis pertaining to the geographic location and characteristics of natural or constructed features and boundaries on, above, or below the earth’s surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geospatial data"@en .

aat:300380195 a skos:Concept ;
    skos:definition "Naturally occurring lipid found in plants and animals, triglyceride is a chemical compound in which three molecules of a fatty acid are united by oxygen to one molecule of glycerol. Triglycerides function as stores of energy and are the chief components in most animal and vegetable fats and oils. Triglycerides are named according to fatty acid components, e.g. stearin is the triglyceride of stearic acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triglyceride"@en .

aat:300380196 a skos:Concept ;
    skos:definition "Method of ionizing atoms with low ionization potentials for use in mass spectrometry by contact with the heated surface of a metal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal ionization mass spectrometry"@en .

aat:300380197 a skos:Concept ;
    skos:definition "A mechanically ventilated appliance to enclose use of spray paint and to confine the escape of spray vapor, exhausting it safely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spray booths"@en .

aat:300380198 a skos:Concept ;
    skos:definition "Process or action of setting, hardening, solidifying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solidification"@en .

aat:300380199 a skos:Concept ;
    skos:definition "A double salt of sodium bicarbonate and sodium carbonate, forming in white crystalline needles. It is used in the treatment of water for softening or cleaning applications. In conservation, used in solution to stabilize corrosion by removing chlorides and other salts from iron and bronze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium sesquicarbonate"@en .

aat:300380200 a skos:Concept ;
    skos:definition "Radiography by secondary electron emission, an imaging technique. An example is for technical examination of painting, that records differences in intensity of electron emissions from adjacent pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray emissiography"@en .

aat:300380201 a skos:Concept ;
    skos:definition "A melamine-formaldehyde resin product formerly used as a consolidant in conservation treatment of waterlogged wood. It was retired from the market in the nineteen seventies and has been replaced by a similar resin, Lyofix (TM), produced by Ciba-Geigy, Basel ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arigal C (TM)"@en .

aat:300380202 a skos:Concept ;
    skos:definition "Refers to a process of planning and managing construction projects from inception of a facility to its eventual demolition through digital information models (e.g. 4D CAD) placed in shared knowledge resources."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building information modeling"@en .

aat:300380203 a skos:Concept ;
    skos:definition "Aromatic, yellow gum resin obtained from various African, Arabian, and Indian trees of the Commiphora genus. Myrrh contains approximately 25% resin (mostly triterpenoids), 60% gum, and 15% volatile oils. Translucent yellow resins have been used for incense and perfumes since ancient times. Myrrh has also been used for its healing properties in traditional medicines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "myrrh"@en .

aat:300380204 a skos:Concept ;
    skos:definition "In an optical system, use of magnifying lens or other technology to increase the apparent size of an object. The term may also be used to designate a measurement of degree along a spectrum of enlargement and reduction within an optical system; the size of an image relative to the size of the object creating it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnification"@en .

aat:300380205 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Li and atomic number 3; a soft, silver-white metal, the lightest element in the alkali metal series. It is obtained from minerals, such as spodumene, in which it occurs or as a byproduct of potash and borax. Use also for this metal as processed and formed for use as a heat transfer medium in nuclear reactors or as a strengthener in alloys and many manufactured products such as ceramics and glass. Its salt is used in psychiatric medications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithium"@en .

aat:300380206 a skos:Concept ;
    skos:definition "Trademarked name for a series of styrene acrylate and pure acrylate aqueous dispersions used for preservation purposes in libraries and archives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sokrat (TM)"@en .

aat:300380207 a skos:Concept ;
    skos:definition "Trademarked name for a series of polyacrylic acids sold as gelling agents. Used in paper conservation as an alternative to cellulose ether poultices for the local removal of moisture-sensitive adhesives on paper artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carbopol (TM)"@en .

aat:300380208 a skos:Concept ;
    skos:definition "Thermoplastic polymer of the polyester family made by condensing ethylene glycol and terephthalic acid. It is used to make textile fibers, disposable beverage bottles, photographic film, and magnetic recording tape. Polyethylene terephthalate (PET) was the first commercially marketed polyester, sold as Dacron (TM) in the U.S."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyethylene terephthalate"@en .

aat:300380209 a skos:Concept ;
    skos:definition "Spectroscopic technique for selective analysis of components of heterogeneous samples on a micrometer scale allowed by the coupling of a Raman spectrometer to an ultraviolet microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro-Raman spectroscopy"@en .

aat:300380210 a skos:Concept ;
    skos:definition "A composite material whose grain size is measured in nanometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanocomposite"@en .

aat:300380211 a skos:Concept ;
    skos:definition "Trademarked name for a series of glass fiber reinforced aluminum honeycomb boards used for sailboat contruction; and in art conservation as support panels for objects such as mosaics and wall paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexlite (TM)"@en .

aat:300380212 a skos:Concept ;
    skos:definition "Trademarked name for a series of water-miscible cellulose fillers used in conservation for repair of materials such as marble, alabaster, and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polyfilla (TM)"@en .

aat:300380213 a skos:Concept ;
    skos:definition "A brown-black insoluble compound used as an oxidant, a depolarizer of battery cells, for paint pigments, to decolorize glass, and in manufacture of ceramics and glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese dioxide"@en .

aat:300380214 a skos:Concept ;
    skos:definition "Genus containing around 40 species of succulent plants native to southern North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yucca"@en .

aat:300380215 a skos:Concept ;
    skos:definition "Any of the group of metallic elements whose oxides are classed as rare earths. These include the lanthanide series, yttrium and scandium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rare earth elements"@en .

aat:300380216 a skos:Concept ;
    skos:definition "An organosulfur compound with antioxidant properties used as a chelating agent. It has been used for the removal of arsenic- and mercury-based pesticide residues in museum objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alpha-lipoic acid"@en .

aat:300380217 a skos:Concept ;
    skos:definition "A nonmetallic element of the halogen family with atomic number 53 and symbol I. It is a dark crystalline solid used as an additive to salt to prevent iodine insufficiency and is used in dyes, photographic film, x-ray contrast media, and other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iodine"@en .

aat:300380218 a skos:Concept ;
    skos:definition "Preservation or conservation technique used for biological specimens that replaces fluids and fat with synthetic materials such as polyester polymers, epoxy resins, and silicone rubber. The technique has been used for the consolidation of organic archaeological materials. Plastinated specimens can be cured with gas, heat or UV- light in order to harden them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plastination"@en .

aat:300380219 a skos:Concept ;
    skos:definition "A colorless, pungent carboxylic acid which polymerizes in the presence of oxygen. Acrylic acid is used in the manufacture of acrylic resins, plastics, fibers, and coatings. Acrylic acid was first synthesized in 1843. Formula is formula CH2=CHCOOH"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic acid"@en .

aat:300380220 a skos:Concept ;
    skos:definition "A type of glass manufactured by German-American John Frederick Amelung’s New Bremen Glass Manufactory in Maryland, U.S. between 1784 and ca. 1795. Amelung brought over German craftsmen and sought financial support from German and American businessmen and the U.S. government in establishing a permanent crafts community. His industry failed after the U.S. Congress rejected Amelung’s request for a loan in 1790. Our understanding of the technique and style of this glass is largely speculative and fragmentary as few examples survive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amelung glass"@en .

aat:300380221 a skos:Concept ;
    skos:definition "A resin extracted from birch bark. It has been identified as a component of archaeological tars found in Austrian sites, demonstrating that the Iron Age tars were made from birch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "betulin"@en .

aat:300380222 a skos:Concept ;
    skos:definition "Semi-metallic element having symbol Ge and atomic number 32. A silvery gray metalloid, germanium occurs in sulfide ores and is used as a semiconductor, in alloys, and in the manufacture of infrared transmitting glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "germanium"@en .

aat:300380223 a skos:Concept ;
    skos:definition "Trademarked name for a synthetic, layered clay composed of sodium magnesium lithium silicate. Combined with water, Laponite (TM) forms a gel used to stabilize emulsions in paints, cosmetics, and other industrial products. It is also used as a film forming agent to produce conductive, antistatic, and barrier coatings; and, in conservation, as a poulticing material for cleaning paper and stone and ceramic objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laponite (TM)"@en .

aat:300380224 a skos:Concept ;
    skos:definition "Wood of the Chamaecyparis obtusa tree, an evergreen native to Japan and East Asia. Wood is reddish-brown, fragrant, durable and fine grain. It is used for Shinto and Buddhist temples and other construction, furniture, and sculpture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese cypress"@en .

aat:300380225 a skos:Concept ;
    skos:definition "Collections of sound recordings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound archives"@en .

aat:300380226 a skos:Concept ;
    skos:definition "Wood of the Cryptomeria japonica tree, an evergreen native to eastern Asia. It is reddish brown, soft, fragrant, and used for construction, furniture, and ornamental carving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese cedar"@en .

aat:300380227 a skos:Concept ;
    skos:definition "The blue used by the Seri Indians of Sonora Mexico in face painting. It is a prepared pigment derived from root bark of Franseria dumosa which is ground with a light-colored local clay and green organic resin of the flowering plant Guaiacum coulteri."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seri blue"@en .

aat:300380228 a skos:Concept ;
    skos:definition "Metallic element having symbol Nb and atomic number 41, formerly named columbium; soft grayish-white transition metal used in superconducting alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "niobium"@en .

aat:300380229 a skos:Concept ;
    skos:definition "The action of administering a fine mist, especially for the purpose of moisturization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "misting"@en .

aat:300380230 a skos:Concept ;
    skos:definition "Lamps in which light is produced by an electric arc between two electrodes in a quartz bulb filled with xenon gas. They give off a constant high intensity light and are used in motion picture projection, flash photography, and serve as light sources in accelerated aging chambers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xenon lamps"@en .

aat:300380231 a skos:Concept ;
    skos:definition "Thin, protective coating of tin applied to sheet iron or steel by electroplating or dipping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinplate"@en .

aat:300380232 a skos:Concept ;
    skos:definition "A blue-purple dye known from Biblical references, said to be derived from shellfish, although the source species is debated. Used for priestly garments, the tapestries in the Tabernacle, and tassels attached to a garment, the tallit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tekhelet"@en .

aat:300380233 a skos:Concept ;
    skos:definition "Water-soluble anionic surfactant used in detergents and other cleaning products such as toothpaste. In conservation, used in the aqueous cleaning of painted surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium lauryl sulfate"@en .

aat:300380234 a skos:Concept ;
    skos:definition "Downslope bulk movements of rock debris and soil in response to gravitational body forces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass wasting"@en .

aat:300380235 a skos:Concept ;
    skos:definition "Stones carved with runic inscriptions. Usage extends to small stones used for divination as well and monumental standing stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rune stones"@en .

aat:300380236 a skos:Concept ;
    skos:definition "Increased rate of chemical reaction caused by radiant energy in the form of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photocatalysis"@en .

aat:300380237 a skos:Concept ;
    skos:definition "Yellow surface coating of friable material that forms on unprotected realgar exposed to light; this light-induced transformation product is found occasionally in paintings in association with the pigment. In the past, pararealgar has been confused with the pigment orpiment to which this sulfide arsenic mineral is closely related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pararealgar"@en .

aat:300380238 a skos:Concept ;
    skos:definition "Layered composite wood board consisting of cross-oriented thin, rectangular strips compressed and glued together with resin adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oriented strand board"@en .

aat:300380239 a skos:Concept ;
    skos:definition "Emulsion in which droplet size is very small, often 10 nanometers or less. Uses include the cleaning of paintings, used along with micellar solutions and gels as a minimally invasive tool for selective removal of degraded ploymers used in past restorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microemulsion"@en .

aat:300380240 a skos:Concept ;
    skos:definition "General term for great variety of chemical compounds formed with flourine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorinated compounds"@en .

aat:300380241 a skos:Concept ;
    skos:definition "A dynamic x-ray imaging technique used to examine the internal structure of an object, fluoroscopy produces real time video images by converting x-rays into light (via a fluorescent screen) which is captured by a TV camera. Fluoroscopy is used primarily for medical imaging, but also in the examination of archaeological finds and works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluoroscopy"@en .

aat:300380242 a skos:Concept ;
    skos:definition "Tools comprised of a conjoined hygrometer and thermograph, which record temperature and relative humidity conditions in which sensitive objects are displayed or stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hygrothermographs"@en .

aat:300380243 a skos:Concept ;
    skos:definition "Migration of ions in an electric field under the influence of an electrical potential difference."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electromigration"@en .

aat:300380244 a skos:Concept ;
    skos:definition "The skin of a bear, usually with the hair left on, prepared for any of various uses such as in garments or as rugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bearskin"@en .

aat:300380245 a skos:Concept ;
    skos:definition "Water-soluble white, crystalline solid used as a bleaching agent, disinfectant, fungicide, and bactericide. It is the standard source of chlorine in water treatments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium hypochlorite"@en .

aat:300380246 a skos:Concept ;
    skos:definition "Structural sheet of iron, usually galvanized for weather resistance, shaped in alternating ridges and grooves; used as roofing, siding, and the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corrugated iron"@en .

aat:300380247 a skos:Concept ;
    skos:definition "Institutions that provide specialized resources for pursuing investigation and research of topics pertaining to art, architecture and design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art libraries"@en .

aat:300380248 a skos:Concept ;
    skos:definition "Pigment composed largely of the mineral aerinite, a light blue clay mineral. An example of usage as a pigment is in Romanesque mural paintings of southwestern France. It is resistant to chemicals, heat, and light although it changes to a green-blue shade when heated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerinite"@en .

aat:300380249 a skos:Concept ;
    skos:definition "The protection of surfaces by application of anti-graffiti coatings or other methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graffiti proofing"@en .

aat:300380250 a skos:Concept ;
    skos:definition "Gradual gravitational downslope movement of water-saturated seasonally thawed soil and other surface materials over permanently frozen subsoil; a type of mass wasting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solifluction"@en .

aat:300380251 a skos:Concept ;
    skos:definition "A colorless, solid, water soluble carbonate perhydrate, sodium percarbonate is a highly concentrated source of anhydrous hydrogen peroxide used as a bleaching agent in many applications including paper and textile conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium percarbonate"@en .

aat:300380252 a skos:Concept ;
    skos:definition "A very hard crust in or on soil formed of sand grains or pebbles glued together by silica; a quartzite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silcrete"@en .

aat:300380253 a skos:Concept ;
    skos:definition "Refers to the magnesium salt of phytic acid. In conservation, used in a solution to inhibit iron gall corrosion on manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium phytate"@en .

aat:300380254 a skos:Concept ;
    skos:definition "Repetitive sedimentary rock stratification-formed over the course of a year reflecting seasonal sedimentation variations, usually alternating finer and coarser layers (or ‘varves’) of sand or clay which often exhibit contrasting colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "varved clay"@en .

aat:300380255 a skos:Concept ;
    skos:definition "Water-cooled nozzles through which air is forced into a forge or blast furnace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuyeres"@en .

aat:300380256 a skos:Concept ;
    skos:definition "Climate characterized by mild winters and hot summers. Rainfall patterns vary considerably throughout the subtropics which include deserts as well as humid forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subtropical climate"@en .

aat:300380257 a skos:Concept ;
    skos:definition "In chemistry, the process or action of converting a material by heating from a solid to a gaseous state without it becoming a liquid. All substances will sublimate if the pressure is low enough. Substances that can sublimate at atmospheric pressure include carbon dioxide, iodine, mercuric sulfide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sublimation"@en .

aat:300380258 a skos:Concept ;
    skos:definition "White fatty acid found mixed in tallow and other hard fats with palmitin and olein. Commercial products mix the three under the name stearic acid for use as lubricant, softener, and dispersing agent in soaps, cosmetics, coatings, and other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stearic acid"@en .

aat:300380259 a skos:Concept ;
    skos:definition "White hygroscopic crystals, the sodium salt of nitrous acid; used in dye manufacture, as a fixative for color photographs, a meat preservative, and as a corrosion inhibitor when applied to steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium nitrite"@en .

aat:300380261 a skos:Concept ;
    skos:definition "A weakly acidic semi-solid substance obtained by acidifying a solution of sodium silicate. It is used for textile and paper coatings. When silicic acid is dried it forms silica gel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silicic acid"@en .

aat:300380262 a skos:Concept ;
    skos:definition "Procedures employed to make materials such as timber, textiles, and others resistant to rot, which is decay or deterioration of tissues; typically uses antifungal and antibacterial agents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotproofing"@en .

aat:300380263 a skos:Concept ;
    skos:definition "Yellow colored liquid solvent derived from coal tar. It is valued in conservation for its ability to dissolve dried linseed oil in paints and varnishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyridine"@en .

aat:300380264 a skos:Concept ;
    skos:definition "Viscous liquid alcohol with a wide variety of uses, especially as an antifreeze, and as a solvent and emulsifier for synthetic resins and essential oils. It is much like ethylene glycol but is non-toxic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propylene glycol"@en .

aat:300380265 a skos:Concept ;
    skos:definition "Diagrams used to show conditions, of temperature and pressure, under which the solid, liquid, and gaseous states of a substance can coexist in equilibrium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phase diagrams"@en .

aat:300380266 a skos:Concept ;
    skos:definition "Religious anniversaries that are typically observed with rejoicing or reflection rather than sorrow, in commemoration of a given event or in honor of a saint or other personage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feast days"@en .

aat:300380267 a skos:Concept ;
    skos:definition "Colorless crystalline alcohol used in making synthetic resins, paints, adhesives, and varnishes. Reacting pentaerythritol with nitric acid creates pentaerythritol tetranitrate (PETN), a highly explosive organic compound related to nitroglycerine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pentaerythritol"@en .

aat:300380268 a skos:Concept ;
    skos:definition "Agents added or applied to a material in order to protect against or minimize photochemical degradation or other deleterious effects of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light stabilizer"@en .

aat:300380269 a skos:Concept ;
    skos:definition "Insoluble black compound that occurs naturally as galena, the chief ore mineral of lead. It can also be synthesized by reacting a soluble lead salt with hydrogen sulfide or sodium sulfide. When crushed, lead sulfide becomes a powder which is used in photoconductive cells, and as a pigment in ceramic glaze."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lead sulfide"@en .

aat:300380270 a skos:Concept ;
    skos:definition "Structures designed for the isolation of menstuating women from the rest of the social group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menstrual huts"@en .

aat:300380271 a skos:Concept ;
    skos:definition "Structures designed or used for the isolation of women giving birth from the rest of the social group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth huts"@en .

aat:300380273 a skos:Concept ;
    skos:definition "Structures designed or used exclusively for the dying process and death of members of the society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "death huts"@en .

aat:300380274 a skos:Concept ;
    skos:definition "The salt of formic acid, sodium formate is used as a neutral buffering agent. It sometimes appears spontaneously as a layer of white crystalline efflorescence on sodium-rich glass artefacts exposed to the pollutant gas formaldehyde."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium formate"@en .

aat:300380275 a skos:Concept ;
    skos:definition "In mathematics, the analysis of functionals, or the functions of functions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "functional analysis"@en .

aat:300380276 a skos:Concept ;
    skos:definition "Ancient war or racing chariots drawn by three horses abreast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trigas"@en .

aat:300380277 a skos:Concept ;
    skos:definition "Chemical compound, originally developed for hair-perming preparations, used in conservation of paleontological artifacts. It is applied in solution to fossil materials for neutralization and removal of sulfates and pyrite oxidation products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ethanolamine thioglycollate"@en .

aat:300380278 a skos:Concept ;
    skos:definition "Refers to the styles and cultures developed by the peoples dwelling in the range of mountains extending northeast from the modern central Czech Republic to the Polish-Czech border and into Romania and the Ukraine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carpathian"@en .

aat:300380279 a skos:Concept ;
    skos:definition "Generic name for nonfibrous proteins that have been reconfigured to take a fibrous form. Azlon fibers have been obtained from such materials as peanuts, corn, and casein. Blended with natural fibers or synthetics, they have been used for weaving, often to produce silk-like fabrics. Azlon has now largely been replaced by other synthetic fibers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "azlon"@en .

aat:300380280 a skos:Concept ;
    skos:definition "Chemical compound applied to contact paper in order to indicate the presence of iron ions in test samples of materials adversely affected by iron such as textiles, paper, or parchment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bathophenanthroline"@en .

aat:300380281 a skos:Concept ;
    skos:definition "Filmless x-ray examination technique which produces images that can be stored as a computer file. Sensed analog signals representing intensity of x-ray photons at all points are converted to digital signals via laser scanning of the image receptor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital radiography"@en .

aat:300380282 a skos:Concept ;
    skos:definition "Traditional textile painting technique practiced in parts of India which combines hand painting and block printing through the medium of vegetable dyes on prepared cotton fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalamkari"@en .

aat:300380283 a skos:Concept ;
    skos:definition "Acid that occurs in sour milk as a thick water-soluble liquid. It is induced by bacterial decomposition of sugar, a process of fermentation; it may also be found in molasses, many fruits, beer and wine. Lactic acid is used in dyeing and leather processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lactic acid"@en .

aat:300380284 a skos:Concept ;
    skos:definition "Along with quartz and tridymite, one of the three principal forms of silica. It is a high temperature form of quartz found naturally formed in volcanic rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cristobalite"@en .

aat:300380285 a skos:Concept ;
    skos:definition "People of any sex who live together in a marriage-like relationship, in some cases officially registered as such and so entitled to all or some of the same legal rights or employee benefits as married spouses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domestic partners"@en .

aat:300380286 a skos:Concept ;
    skos:definition "Legal or personal recognition of a committed, marriage-like partnership, usually of a couple, in which the members are of any sex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domestic partnership"@en .

aat:300380287 a skos:Concept ;
    skos:definition "Letters, packages, and other physical materials delivered to or intended for one individual or for one address, usually but not always delivered by an official postal system. For electronic mail, prefer \"electronic mail.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail"@en .

aat:300380288 a skos:Concept ;
    skos:definition "Visual works with subject matter or form that is fantastical, fabulous, imaginary, unreal, or whimsical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fantasies"@en .

aat:300380289 a skos:Concept ;
    skos:definition "Buildings that house specialized resources and facilities for pursuing investigation and research of art, architecture and design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art libraries"@en .

aat:300380290 a skos:Concept ;
    skos:definition "Literary genre in which works are of a whimsical or visionary nature, having suppositions that are speculation or resting on no solid grounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fantasies"@en .

aat:300380291 a skos:Concept ;
    skos:definition "Musical compositions that are free in form and inspiration, usually for an instrumental soloist. Examples include 16th- and 17th-century English fugal compositions (i.e., based on melodic imitation) for consorts of string or wind instruments, and earlier 16th-century works for lute or keyboard consisting of short sections based on one or more musical motives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fantasias"@en .

aat:300380292 a skos:Concept ;
    skos:definition "Trademarked name for moisture-sensitive silica beads used as a humidity controlling sorbent for paintings, paper, textiles and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Art Sorb (TM)"@en .

aat:300380293 a skos:Concept ;
    skos:definition "Compound of copper containing up to 0.5% arsenic which, at elevated temperatures imparts higher tensile strength and a reduced tendency to scaling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arsenical copper"@en .

aat:300380295 a skos:Concept ;
    skos:definition "Powdery alkaline compound used in paper pulp manufacture and mass deacidification treatments. Magnesium hydroxide is found in nature as the mineral brucite. It is used medicinally as a laxative and antacid. As a suspension in water it is commonly known as milk of magnesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium hydroxide"@en .

aat:300380296 a skos:Concept ;
    skos:definition "Term used in ancient times for a fiber (and by extension, fabric) highly prized for its fineness, which was once the basis of a small textile manufacturing industry centered around the Italian Mediterranean. 'Byssus' was used to describe a variety of substances, leading to confusion and controversy over its proper denotation. Some scholars view byssus as simply a generic term covering a host of fiber proteins and products manufactured from them; others insist that the term specifically describes shellfish derived 'sea-silk'. Usage extends to both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "byssus"@en .

aat:300380298 a skos:Concept ;
    skos:definition "A dark green to black member of the amphibole mineral group, hornblende is common constituent of metamorphic and igneous rocks such as granite, basalt, and schist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornblende"@en .

aat:300380299 a skos:Concept ;
    skos:definition "The branch of paleontology that studies fossil traces such as footprints, trails, and burrows as evidence of animal and plant activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ichnology"@en .

aat:300380300 a skos:Concept ;
    skos:definition "Occasions when the Moon is obscured to observers on Earth by the Moon passing through the Earth's shadow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunar eclipses"@en .

aat:300380301 a skos:Concept ;
    skos:definition "Events that occur when three celestial objects become aligned, from the perspective of an observer. They are interceptions or obscurations of the light of the Sun, Moon, or other luminous heavenly body by the intervention of some other body, either between it and the eye or between the luminous body and that illuminated by it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eclipses"@en .

aat:300380302 a skos:Concept ;
    skos:definition "Having or relating to the three dimensions of length, width, and height, plus time, or another spatial dimension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "four-dimensional"@en .

aat:300380303 a skos:Concept ;
    skos:definition "Substance that promotes a combination with oxygen; causing conversion into an oxide or oxygen-containing compound; sometimes contributing to the degradation of a surface, such as in corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxidant"@en .

aat:300380304 a skos:Concept ;
    skos:definition "Narrative accounts of the suffering or martyrdom of Jesus Christ, a saint, or other character."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passions"@en .

aat:300380305 a skos:Concept ;
    skos:definition "A glassy blue mineral, named for its copper content and its similarity to rivaite, that is a component of the artificial inorganic pigment, Egyptian blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuprorivaite"@en .

aat:300380306 a skos:Concept ;
    skos:definition "Materials designed with the built-in ability to detect and repair damage and defects, such as concrete in which integrated bacteria promote self-healing of cracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-healing materials"@en .

aat:300380307 a skos:Concept ;
    skos:definition "The drilling of holes as small as 2.5 mm (0.10 inch) in diameter using a high precision tool made of cobalt steel or micrograin tungsten carbide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microdrilling"@en .

aat:300380308 a skos:Concept ;
    skos:definition "Concrete mix that can be placed purely by means of its own weight, with little or no vibration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-consolidating concrete"@en .

aat:300380310 a skos:Concept ;
    skos:definition "White marble with grey/black veins or speckling quarried in Val Venosta, Alto Adige, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lasa marble"@en .

aat:300380311 a skos:Concept ;
    skos:definition "Wilhelmine refers to the period of German history beginning with the proclamation of Wilhelm I as Kaiser in 1871 and ending with the abdication of Wilhelm II in 1918. Wilhelmine (or 'Wilhelminist') style is marked by imperial grandiosity expressed in a neo-Baroque vocabulary of forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wilhelmine"@en .

aat:300380312 a skos:Concept ;
    skos:definition "Eggs created for and consumed at Easter. They are often gaily painted or dyed eggs (usually hardboiled or blown) decorated for Easter as gifts, or display pieces, or the objects of an Easter egg hunt. By extension, egg shaped trinkets of wood, porcelain, or other materials, sometimes bejewelled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Easter eggs"@en .

aat:300380313 a skos:Concept ;
    skos:definition "Detention camps for enemy combatants captured in time of war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prisoner-of-war camps"@en .

aat:300380314 a skos:Concept ;
    skos:definition "Yellow essential oil with a camphor-like odor derived from the dry leaves of various species of eucalyptus tree. This oil is used in medicine, in perfumery, in leather conditioning, and in other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eucalyptus oil"@en .

aat:300380315 a skos:Concept ;
    skos:definition "Pale yellow, lemon-scented essential oil derived from the tropical lemongrass Cymbopogon nardus, native to South Asia. This oil is used in perfumes, soaps, and insect repellents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citronella oil"@en .

aat:300380316 a skos:Concept ;
    skos:definition "A calcium hydroxide mineral, a member of the brucite group, that is a product of the hydration of portland cement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portlandite"@en .

aat:300380317 a skos:Concept ;
    skos:definition "Dating of volcanic activity by studying tephra deposits, which include volcanic ash and other ejecta, especially in a stratigraphic deposit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tephrochronology"@en .

aat:300380318 a skos:Concept ;
    skos:definition "Refers to cleavage of the bonds that hold a polymer chain together, as in rubber as a result of heating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chain scission"@en .

aat:300380319 a skos:Concept ;
    skos:definition "A method of deacidifying paper that involves treating manuscript material to a gaseous alkali compound. It is now rarely used because of evidence that the vapor is toxic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vapor-phase deacidification"@en .

aat:300380320 a skos:Concept ;
    skos:definition "Refers to the style of soft-paste porcelain first produced by the factory at the Palazzo di Capodimonte in 1743, Naples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capodimonte"@en .

aat:300380321 a skos:Concept ;
    skos:definition "The process by which the performance of a professional person is evaluated by a group of independent experts in the same field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peer review"@en .

aat:300380322 a skos:Concept ;
    skos:definition "Medical procedure that examines breasts by means of x-rays; chiefly used for early detection of cancer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mammography"@en .

aat:300380323 a skos:Concept ;
    skos:definition "A plaque or sign or other marker placed to commemorate an historic site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical markers"@en .

aat:300380324 a skos:Concept ;
    skos:definition "Eastern Han artifacts, money trees were good luck charms placed in tombs; so named because of their cast bronze branches laden with leaves made of coins. The branches also contain mythological figures and objects important to Han belief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "money trees"@en .

aat:300380325 a skos:Concept ;
    skos:definition "Paint that contains a varnish which produces a glossy finish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gloss paint"@en .

aat:300380326 a skos:Concept ;
    skos:definition "Compressible piece of packing material (as of rubber) used to seal a joint and make it water- or airtight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaskets"@en .

aat:300380327 a skos:Concept ;
    skos:definition "Generic term for any inflammatory skin condition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dermatitis"@en .

aat:300380328 a skos:Concept ;
    skos:definition "Monoclinic crystalline mineral with a combined salt of sodium sulfate and sodium nitrate. Darapskite is found naturally in nitrate ores and in limestone caves. It is more rarely found as a strong saline efflorescence on surfaces of walls and buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "darapskite"@en .

aat:300380329 a skos:Concept ;
    skos:definition "Soluble red or purple-brown powder extracted from the dried female scale insect Dactylopius coccus. The percentage of acidity changes the color of Carminic acid from a bright red to yellow or deep violet. It is the primary ingredient in cochineal dyestuff and is used in paint pigments, color photography, and textile dyeing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carminic acid"@en .

aat:300380330 a skos:Concept ;
    skos:definition "Wild or noisy festivities, especially those involving the drinking of alcoholic beverages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "revelries"@en .

aat:300380331 a skos:Concept ;
    skos:definition "Artificially produced, radioactive metallic chemical element with symbol Cf and 98 as atomic number. Californium has a few specialized uses as in neutron activation analysis of metals in ancient coins, and in airport security full body scanning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "californium"@en .

aat:300380333 a skos:Concept ;
    skos:definition "A bleaching agent used in textle conservation as an alternative to or in tandem with the more commonly used sodium borohydride."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium borohydride"@en .

aat:300380334 a skos:Concept ;
    skos:definition "One of three naturally occurring crystalline mineral forms (or polymorphs) of calcium carbonate. The other forms are aragonite and calcite. Spherical precipitates of vaterite have been recognized on microbial mats and biofilms in volcanic substrates as found in Roman catacombs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaterite"@en .

aat:300380335 a skos:Concept ;
    skos:definition "Ankerite is a carbonate mineral, a member of the dolomite group in which the magnesium is replaced in substantial part by iron, with or without manganese. Ankerite occurs in deposits of iron ore and is also found in thin veins in coal seams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ankerite"@en .

aat:300380336 a skos:Concept ;
    skos:definition "Refers to the style of soft-paste porcelain first produced at the Real Fábrica del Buen Retiro near Madrid in 1759 under the auspices of King Charles III of Spain. The factory reestablished the equipment, craftsmen, and designs formerly of the factory that Charles oversaw at Palazzo di Capodimonte in Naples from 1743 to 1758. Production of Buen Retiro porcelain continued until 1808 when the factory closed; then resumed in 1817, at La Monocloa, continuing until 1850."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buen Retiro"@en .

aat:300380337 a skos:Concept ;
    skos:definition "Crystalline sugar, a disaccharide, stored instead of starch in some fungi, algae, and insects. Industrially manufactured trehalose has been used in combination with lactitol as a sugar-alcohol saturation treatment in the conservation of archaeological waterlogged wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trehalose"@en .

aat:300380338 a skos:Concept ;
    skos:definition "Blue-green monoclinic crystalline mineral, a hydrated basic phosphate of copper and zinc. Technical examination in 2008 revealed that veszelyite was used as a pigment in mosaic and polychrome masks and funerary offerings from the royal tombs of Calakmul, Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "veszelyite"@en .

aat:300380339 a skos:Concept ;
    skos:definition "Carbonated magnesium propylate dissolved in heptafluoropropane used in a nonaqueous impregnation process. The manufacturer distributes the formula as a deacidifying aerosol spray for mass deacidification in paper conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "CSC Book Saver (TM)"@en .

aat:300380340 a skos:Concept ;
    skos:definition "Designates structures in which charged particles, generally subatomic particles such as protons or electrons, are accelerated by means of an alternating electric field whose frequency is kept constant to remain synchronous with the particles.They are confined to a closed circular orbit by a changing magnetic field, the strength of which is increased to keep the path’s radius constant as the particles gain mass and their momentum increases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synchrotons"@en .

aat:300380341 a skos:Concept ;
    skos:definition "A heavy inert noble gas with symbol Xe or X and atomic number of 54, used principally in lamps, lasers, and as a general anaesthetic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xenon"@en .

aat:300380342 a skos:Concept ;
    skos:definition "Any of a class of sugar acids occuring in various polysaccharides and in urine with both an aldehyde and a carboxyl group. It is the product of a monosaccharide in which the terminal group has been oxidized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uronic acid"@en .

aat:300380343 a skos:Concept ;
    skos:definition "Refers to the culture of the modern nation of Ukraine, or to the cultures that have occupied the principal lands of historic Ukraine in Eastern Europe north of the Black Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ukrainian"@en .

aat:300380344 a skos:Concept ;
    skos:definition "Refers to an embroidered or tapestry-woven inscription band in Islamic textiles, or fabric with an inscription band added in a technique different from the ground weave. Tiraz garments embroidered in silver or gold were a luxury good in Medieval Europe and are represented in portal sculptures on Chartres Cathedral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiraz"@en .

aat:300380345 a skos:Concept ;
    skos:definition "Gray or black crystalline copper oxide mineral found as earthy masses in copper deposits and as thin metallic scales on lava as at Vesuvius and Etna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenorite"@en .

aat:300380346 a skos:Concept ;
    skos:definition "Syngenite is a hydrous sulfate of calcium and potassium occurring in tabular crystals. It is sometimes found as a salt deposit on masonry surfaces, a gray-white bloom on walls facing the prevailing wind and rain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syngenite"@en .

aat:300380347 a skos:Concept ;
    skos:definition "A light, porous, siliceous sedimentary rock composed almost entirely of sponge spicules. Spongolite was much used as a building stone in medieval Bohemia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spongolite"@en .

aat:300380348 a skos:Concept ;
    skos:definition "Refers to any salt or ester of nitrous acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitrite"@en .

aat:300380349 a skos:Concept ;
    skos:definition "A compound constituting the essential part of woody cell walls of plants in which cellulose fibril aggregates are embedded in a matrix material consisting of hemicelluloses and lignin. Lignocellulosic biomass is used as fuel and is the feedstock for the paper and pulp industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lignocellulose"@en .

aat:300380350 a skos:Concept ;
    skos:definition "Measurement of the size of lichens on rock surfaces as a method for dating geomorphic features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lichenometry"@en .

aat:300380351 a skos:Concept ;
    skos:definition "Trademarked name for a series of glues and impregnating resins made from urea, melamine and/or phenol with formaldehyde. In conservation, Kauramin (TM) impregnating resins are used for consolidation of archaeological wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kauramin (TM)"@en .

aat:300380352 a skos:Concept ;
    skos:definition "Hair of bison as used for rope, jewelry, other items. Bison shed their coats in the spring; this luxury hair was first used by Native Americans for rope and as stuffing for insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bison hair"@en .

aat:300380353 a skos:Concept ;
    skos:definition "Collections of preserved web pages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Web archives"@en .

aat:300380354 a skos:Concept ;
    skos:definition "Skins of rabbits, usually including fur, used for apparel or other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbit skin"@en .

aat:300380355 a skos:Concept ;
    skos:definition "Hair of Bos grunniens, the domestic yak; with or without skin included, used for apparel and other application."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yak hair"@en .

aat:300380356 a skos:Concept ;
    skos:definition "The act of digging up or otherwise removing a body from a grave, disinterment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exhumation"@en .

aat:300380357 a skos:Concept ;
    skos:definition "Material that mimics suede, of various compositions, usually a synthetic fabric; used in making clothing, shoes, furniture, and for other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "faux suede"@en .

aat:300380358 a skos:Concept ;
    skos:definition "Rare metallic element, the penultimate in the lanthanide series, having the symbol Yb and atomic number 70. Ytterbium is a soft, lustrous silver-white metal. Some of its isotopes generate gamma rays when irradiated and are used as a radiation source-substitute for portable X-ray machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ytterbium"@en .

aat:300380359 a skos:Concept ;
    skos:definition "Vulcanite is an old trade name for a dark, brittle, moldable hard rubber that was produced by heating (‘vulcanizing’) a preparation of india rubber and sulfur. It was marketed in the U.S. as vulcanite and in England as ebonite. Vulcanite was used for small items such as buttons, brooches, and combs, finishes on camera bodies, and for insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vulcanite"@en .

aat:300380360 a skos:Concept ;
    skos:definition "Secure, evironmentally-controlled storage spaces for photographic film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film vaults"@en .

aat:300380361 a skos:Concept ;
    skos:definition "The hair of any breed of canis familiaris, which is sometimes spun into fiber for weaving textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog hair"@en .

aat:300380362 a skos:Concept ;
    skos:definition "Refers to the culture, as well as works created in Galilee, the northernmost province of ancient Palestine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galilean"@en .

aat:300380363 a skos:Concept ;
    skos:definition "Refers to a forked or triangular double-sided pennant; a standard carried to identify a military unit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guidons"@en .

aat:300380364 a skos:Concept ;
    skos:definition "Traditonal Korean bridal robe, a topcoat with flowing sleeves made of embroidered silk. It has been a culturally significant article of female wedding apparel since the early Choson dynasty. The hwalot evolved from Chinese costume styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hwalot"@en .

aat:300380365 a skos:Concept ;
    skos:definition "A carbonate of sodium and aluminum found as a low-temperature hydrothermal mineral in shale. It crystallizes in the orthorhombic crystal system. It is not mined for ore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dawsonite"@en .

aat:300380366 a skos:Concept ;
    skos:definition "Granito del foro is an igneous rock which was once quarried at Mons Claudianus in Egypt. It is in fact a granodiorite rather than a granite, and is named for its use in buildings of the Roman Forum especially during the reigns of Trajan and Hadrian and in Tetrarchic imperial architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "granito del foro"@en .

aat:300380367 a skos:Concept ;
    skos:definition "The branch of science which measures intensity of incident radiant energy by the speed of a photochemical reaction with the aid of an actinometer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "actinometry"@en .

aat:300380368 a skos:Concept ;
    skos:definition "A fuming liquid soluble in benzene, chloroform, and ether; used for dye manufacture and in organic synthesis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetyl bromide"@en .

aat:300380370 a skos:Concept ;
    skos:definition "Trade in furs. An example is historic trading in North America in which pelts were exchanged for money or goods at trading stations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fur trade"@en .

aat:300380371 a skos:Concept ;
    skos:definition "Tradename for Fujifilm film. There were two lines of daylight-balanced color reversal films, Provia and Velvia, which require an E6 process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fujichrome (TM)"@en .

aat:300380372 a skos:Concept ;
    skos:definition "A sack filled with feed that is tied onto the head of a horse or other livestock. Printed cotton feed bags were recycled as inexpensive women's wear and quilting during the US Depression in the 1930s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feed bags"@en .

aat:300380374 a skos:Concept ;
    skos:definition "Style and culture of a Native American tribe in Virginia, once a part of the Powhatan paramountcy of Algonquian-speaking Indians. Known today as the \"Pamunkey Indian Tribe,\" federally recognized in 2016."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pamunkey"@en .

aat:300380376 a skos:Concept ;
    skos:definition "A fine, lightweight cotton canvas, usually finished with a gloss and dyed in one colour, used especially for bookbinding and lining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "percaline"@en .

aat:300380377 a skos:Concept ;
    skos:definition "Refers to the culture of the Numic people who inhabited parts of the Great Basin, especially the wetlands in the Carson and Owens valleys, in prehistoric times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Numic"@en .

aat:300380378 a skos:Concept ;
    skos:definition "A photographic coating composed of layers of gelatin and tannic acid introduced by Louis-Désiré Blanquart-Évrard in 1857 to resolve the problem of image impermanence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vernis cuir"@en .

aat:300380379 a skos:Concept ;
    skos:definition "Any very large molecules having a much larger number of atoms and a higher molecular weight than ordinary molecules. Plastics, rubbers, proteins, nucleic acids are examples of substances composed of macromolecules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "macromolecules"@en .

aat:300380380 a skos:Concept ;
    skos:definition "In Greek and Roman history, the title of a military commander of 1000 men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiliarchs"@en .

aat:300380381 a skos:Concept ;
    skos:definition "Colorless crystalline acid derived from plants. It is used as in dyes and writing inks and as a tanning agent and photographic developer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallic acid"@en .

aat:300380382 a skos:Concept ;
    skos:definition "Any of several coarse-grained, pale-colored marbles quarried in northern Georgia. White Georgia is used for statuary. The others, such as Georgia Cherokee and Silver Georgia gray, are used as interior and exterior building stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Georgia marble"@en .

aat:300380383 a skos:Concept ;
    skos:definition "Monoclinic mineral of the amphibole (double-chain silicate) group. Glaucophane occurs as blue-gray sheets in dense metamorphic rocks such as schists, especially blueschist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glaucophane"@en .

aat:300380384 a skos:Concept ;
    skos:definition "A plant found chiefly in the Mediterranean and West Asia. A red natural organic dye may be prepared from the root."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Onosma echioides"@en .

aat:300380385 a skos:Concept ;
    skos:definition "A yellow natural organic dye believed to originate from the Amur cork tree, Phellodendron amurense, of which berberine is the principal colorant. The paper of roughly 40,000 early printed Chinese documents was dyed yellow by this extract."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "huangbo"@en .

aat:300380386 a skos:Concept ;
    skos:definition "Wood from the species Fraxinus floribunda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Himalayan ash"@en .

aat:300380387 a skos:Concept ;
    skos:definition "Traditional Korean decoration technique developed during the Yi dynasty in which brightly colored patterns or pictures are drawn on thinned, semitransparent sheets of ox horn which are then applied to chests and other household accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hwagak"@en .

aat:300380388 a skos:Concept ;
    skos:definition "Rare halide mineral, oxy-chloride of lead, occuring as colorless, transparent striated crystals. Laurionite forms when salt water comes in contact with lead bearing slag, or as an oxidation product in lead ore deposits. The presence of laurionite in some ancient Egyptian cosmetics suggests that the mineral was purposely synthesized by the Egyptians using \"wet\" chemistry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laurionite"@en .

aat:300380389 a skos:Concept ;
    skos:definition "Refers to fermented urine, formerly exploited for its ammonia content in various industrial applications. Lant was once commonly used in the textile industry as a scouring agent for wool and as a dyebath with indigo and other dyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lant"@en .

aat:300380390 a skos:Concept ;
    skos:definition "Almandine that is cabochon-cut (a rounded, convex polished surface) and deep red in color. Its base is often hollowed to lighten its color. May display a four-rayed asterism (star-shaped), if rutile needles are included in the almandine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbuncle"@en .

aat:300380391 a skos:Concept ;
    skos:definition "The process of weathering or hydrothermal alteration by which minerals, especially feldspars and micas, are converted to kaolin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaolinization"@en .

aat:300380392 a skos:Concept ;
    skos:definition "Any compound containing the cyano group, for example, sodium cyanide. Organic compounds carrying the group are known as nitriles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyanide"@en .

aat:300380393 a skos:Concept ;
    skos:definition "Measurement of the intensity of transmitted or reflected light by means of a densitometer in order to measure the optical density of a substance or object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "densitometry"@en .

aat:300380394 a skos:Concept ;
    skos:definition "Electricity produced by the direct action of heat, especially in a closed circuit made of two dissimilar metals heated unequally, through two related mechanisms, the Peltier effect and the Seebeck effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermoelectricity"@en .

aat:300380395 a skos:Concept ;
    skos:definition "Porous volcanic stone, a dark reddish pumice, used as a construction and building material in Mexico since prehistoric times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tezontle"@en .

aat:300380397 a skos:Concept ;
    skos:definition "Little Colorado White Ware is a decorated black-on-white ceramic made by the Anasazi in the southwestern United States from approximately CE 1050 to 1250. Potsherds of the ceramic are found in archaeological sites located in the narrow strip flanking the Little Colorado River as it runs through northern Arizona."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Little Colorado White Ware"@en .

aat:300380398 a skos:Concept ;
    skos:definition "Negative photographic materials that are sensitive to violet, blue, green, and yellow, but not to red, light. Formerly used for general photography, but now employed mainly for photographing of phosphor screens, such as cathode-ray tubes, and for other purposes requiring green, but not red, sensitivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthochromatic film"@en .

aat:300380400 a skos:Concept ;
    skos:definition "Family of flowering plants native to the tropics and subtropics of the Old World, containing four genera in about 900 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pandanaceae"@en .

aat:300380401 a skos:Concept ;
    skos:definition "Order of Liliopsida including four families of flowering trees and shrubs, native mainly to tropical regions of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pandanales"@en .

aat:300380402 a skos:Concept ;
    skos:definition "Refers to the material woven from the fiber of Pandanus leaves, used traditionally, for example, as sails for canoes constructed on the Society Islands of the South Pacific."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pandanus"@en .

aat:300380403 a skos:Concept ;
    skos:definition "Cordage fiber obtained from leaves of several plants from the genus Agave, especially Agave cantala, native to Mexico and introduced to the Philippines, Indonesia, and India. Maguey is woven into textile, rope, twine, and netting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maguey"@en .

aat:300380404 a skos:Concept ;
    skos:definition "Any hygroscopic additive used to promote moisture retention. Humectants are added to commercial products such as cosmetics, tobacco, baked goods, and to leather to restore suppleness. Glycerine is an example of a humectant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humectant"@en .

aat:300380405 a skos:Concept ;
    skos:definition "Aromatic gum resin containing a volatile oil that was valued since ancient times in worship, as a medicine, and as an incense resin. It is obtained from the Boswellia sacra trees and others. It contains resins (mostly triterpenoids), gums, volatiles oils (pinene, dipentene), and bassorin. It is usually found in the form of hard yellow grains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frankincense"@en .

aat:300380406 a skos:Concept ;
    skos:definition "A dark brown or black powder prepared by combining an aqueous solution of silver nitrate and an alkali hydroxide. It is used in silver-oxide batteries, as a laboratory reagent, and as a carbon dioxide scrubber. Salt-free silver oxide showed promise as a bronze disease treatment used at excavation sites but its application has proven a complex and labor consuming method with aesthetically unappealing results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver oxide"@en .

aat:300380407 a skos:Concept ;
    skos:definition "Grayish white poisonous powder once commonly used as an herbicide and insecticide but retired due to its high toxicity. It is currently used for preservation of color in zoological and botanical specimens; in taxidermy, as ingredient in soap used for cleaning and sterilizing hides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium arsenite"@en .

aat:300380408 a skos:Concept ;
    skos:definition "Colorless, odorless, crystalline salt used in very dilute solutions to fluoridate water and treat tooth decay. In higher concentrations, sodium fluoride is used as a fumigant, and a preservative for zoological specimens, paint, plaster, wood, and masonry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium fluoride"@en .

aat:300380409 a skos:Concept ;
    skos:definition "White, odorless, water-soluble crystalline powder found in almost all laundry soaps. It is a mild alkaline oxidizing agent which serves to increase detergency. It is also used as a deodorant and antiseptic. Dilute compounds of sodium perborate have been used in the conservation field to remove stains from textiles and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium perborate"@en .

aat:300380410 a skos:Concept ;
    skos:definition "Water soluble white crystals or powder used as a disinfectant and bleach. Sodium bisulfite produces sulfur dioxide when heated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium bisulfite"@en .

aat:300380411 a skos:Concept ;
    skos:definition "A white crystalline solid, usually encountered as a powder, used as a bleach for wood pulp, and as a versatile reducing agent which converts ketones and aldehydes to the related alcohols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium borohydride"@en .

aat:300380412 a skos:Concept ;
    skos:definition "Information that is communicated, recorded, distributed formally or informally in any digital format, which is an electronic format that uses a series of discrete values (commonly the numbers 0 and 1) to record data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital information"@en .

aat:300380413 a skos:Concept ;
    skos:definition "The phenomenon, similar in principle to electron diffraction, whereby a beam of neutrons scattered by the regularly spaced atoms of a solid produces diffraction patterns characteristic of the solid’s crystal structure. Neutron diffraction may be used in place of x-ray crystallography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutron diffraction"@en .

aat:300380414 a skos:Concept ;
    skos:definition "Genus containing several species of trees or shrubs native to Africa and Asia; known for fragrant oleo-gum resin used for incense, embalming, and pharmacological applications, including as anti-inflammatories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boswellia"@en .

aat:300380415 a skos:Concept ;
    skos:definition "Species of small deciduous tree, 2 to 8 meters in height; native to northeastern Africa and the Arabian Peninsula. It has a paper-like bark that can be removed easily. Its sap is harvested through incisions; the milk-like juice hardens on exposure to air and is used as incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boswellia sacra"@en .

aat:300380416 a skos:Concept ;
    skos:definition "Species of small deciduous tree native to northern Somalia. Noted for resin that is used as incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boswellia frereana"@en .

aat:300380417 a skos:Concept ;
    skos:definition "Species of small deciduous tree native to Rajasthan, Madhya Pradesh, and Andhra Pradesh, India. Noted for resin that is used as incense and as medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boswellia serrata"@en .

aat:300380418 a skos:Concept ;
    skos:definition "Refers to a Ukrainian woodwind, a small transverse flute resembling a fife with six to ten fingerholes; by extension may refer to a variety of woodwinds of the flute family played by Ukrainian folk instrumentalists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sopilkas"@en .

aat:300380419 a skos:Concept ;
    skos:definition "General term referring to many types of grass distinguished by a pleasant scent or taste, and used as animal feed, bedding, and incense, among other uses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweetgrass"@en .

aat:300380420 a skos:Concept ;
    skos:definition "Genus containing several species of perennial rhizomatous grasses known for their sweet scent; found in temperate regions in the Northern Hemisphere. In some classifications, Hierochloe is considered a section of the genus Anthoxanthum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hierochloe"@en .

aat:300380421 a skos:Concept ;
    skos:definition "Species of aromatic grass found in North America and northern Eurasia, noted for its distinctive sweet scent. It is used in herbal medicine, in the production of distilled beverages, flavoring, and in ceremonial observations. Examples include in Europe, where the grass is laid at the church entrance on certain saints days. It was widely used by North American indigenous peoples, considered a sacred plant used as incense in peace and healing rituals. In some classifications, part of the genus Anthoxanthum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hierochloe odorata"@en .

aat:300380422 a skos:Concept ;
    skos:definition "Granite quarried at Aswan, Egypt with a mineral composition that results in a rose color. It is the type of granite most used in Egyptian architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rose granite"@en .

aat:300380423 a skos:Concept ;
    skos:definition "Framing or form made of wood, steel, or plastic that serves as a support during construction, particularly as used to support the load of an arch, vault or dome during construction, for the pouring of liquid concrete in a foundation, and in other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formwork"@en .

aat:300380424 a skos:Concept ;
    skos:definition "Dressing or trimming so as to allow the creation of a lapped joint, where pieces overlap rather than abutting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shiplapping"@en .

aat:300380425 a skos:Concept ;
    skos:definition "A trademarked translucent, white petroleum jelly first manufactured in 1870 by Robert Chesebrough, an English-born chemist. It is composed of a mixture of aliphatic hydrocarbons ranging from about C15 to C20; used as an ointment, lubricant, water repellent, release agent, and temporary adhesive. It is not recommended for contact with any art object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vaseline (TM)"@en .

aat:300380426 a skos:Concept ;
    skos:definition "Species native to the Mediterranean, the Middle East, India, Pakistan, and Central Asia. Noted as the source of the blue-purple colorant \"turnsole.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chrozophora tinctoria"@en .

aat:300380427 a skos:Concept ;
    skos:definition "Species of flowering plant, with the native range from India to China (S. Yunnan), Jawa to Lesser Sunda Islands (Bali); the source of a natural red dye and used for medicinal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ventilago maderaspatana"@en .

aat:300380428 a skos:Concept ;
    skos:definition "A natural yellow dyestuff obtained from the wood of the smoketree, Cotinus coggygria (formerly Rhus cotinus). This small tree, also called Venetian sumac, is native to southern Europe, the Middle East, India and China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cotinus coggygria"@en .

aat:300380429 a skos:Concept ;
    skos:definition "Species of small tree native to southern Europe, the Middle East, India and China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maclura tinctoria"@en .

aat:300380430 a skos:Concept ;
    skos:definition "Dye that is dissolved in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "water soluble dye"@en .

aat:300380431 a skos:Concept ;
    skos:definition "A carbon black pigment made by pyrolyzing yeast and wine lees, formerly commonly used in printing inks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yeast black"@en .

aat:300380432 a skos:Concept ;
    skos:definition "A black pigment produced by the pyrolysis of cork. Cork black is a soft, light pigment that has been used in printing inks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cork black"@en .

aat:300380433 a skos:Concept ;
    skos:definition "A black pigment prepared from burnt animal bones mixed with water and glue then formed into lumps or drops; was commercially sold as pellets, used in the 18th and 19th century for house paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drop black"@en .

aat:300380434 a skos:Concept ;
    skos:definition "The condition of combining two or more branches of academic, scientific, or artistic disciplines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interdisciplinarity"@en .

aat:300380435 a skos:Concept ;
    skos:definition "Genus containing around 350 species of flowering plants native to tropical Asia and Madagascar, but with a few species in temperate regions of Asia. Many species are cultivated for their two-lipped, hooded flowers in shades of blue, pink, white and purple; some are used as a source for blue pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Strobilanthes"@en .

aat:300380436 a skos:Concept ;
    skos:definition "Versatile plastic foam used as casting, mounting, packing, and transfer material in applications such as upholstery, thermal insulation, garments, material for sculpture, and in objects conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyurethane foam"@en .

aat:300380437 a skos:Concept ;
    skos:definition "Analytical method used in archaeology and petrography that characterizes stones by comparing isotopic ratios of elements such as oxygen, carbon, or sulfur. SIA has been used in geological evaluation of environmental variables impacting the chemical characteristics and isotopic composition of stone samples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stable isotope analysis"@en .

aat:300380438 a skos:Concept ;
    skos:definition "Trademarked name for a series of polyvinyl acetate emulsions used in conservation as paint binders, coatings, consolidants, and adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mowilith (TM)"@en .

aat:300380439 a skos:Concept ;
    skos:definition "Species of perennial herb used as a flavoring, in confections, as a pigment, as insect repellant, and in folk medicines; native to the Middle East and southern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glycyrrhiza glabra"@en .

aat:300380440 a skos:Concept ;
    skos:definition "The thin, flat pieces of glass on which specimens are mounted for the purpose of microscopic examination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slides"@en .

aat:300380442 a skos:Concept ;
    skos:definition "Pigment of the color orange, which is produced by light having a spectrum dominated by energy with a wavelength of about 590–630nm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orange pigment"@en .

aat:300380443 a skos:Concept ;
    skos:definition "A permanent, opaque, synthetic pigment having a pale red or reddish orange color. It is composed of red iron oxide, obtained by either roasting yellow ocher or as a by-product from steel-mill waste. It is used in artists' paints, marine paints, metal primers, and as a filler in rubbers and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light red"@en .

aat:300380444 a skos:Concept ;
    skos:definition "Material comprising bole clay that is red in color and applied as a ground for gilding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red burnish gold size"@en .

aat:300380445 a skos:Concept ;
    skos:definition "Soft, crumbly erasers made of natural rubber or caoutchouc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "India rubbers"@en .

aat:300380446 a skos:Concept ;
    skos:definition "Yellow oil derived from the Atlantic Cod and related fishes; a rich source of vitamins A and D used in medicine as a treatment for rickets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cod-liver oil"@en .

aat:300380447 a skos:Concept ;
    skos:definition "An unstandardized name for various red pigments, including iodine scarlet as well as for other fugitive synthetic organic colorants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal scarlet"@en .

aat:300380448 a skos:Concept ;
    skos:definition "Compound HgI2, in the form of a dense, bright red powder that is used as a paint preservative and as an antiseptic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercuric iodide"@en .

aat:300380449 a skos:Concept ;
    skos:definition "Nannofossils are microfossils with a diameter less than 50 microns; one micron being equal to one millionth of a meter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nannofossils"@en .

aat:300380450 a skos:Concept ;
    skos:definition "Material with formula Co3(PO4)2∙8H2O that is used in painting porcelain and coloring glass, glazes, enamels, and plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobaltous phosphate"@en .

aat:300380451 a skos:Concept ;
    skos:definition "Material having the formula Co3(AsO4)2, used as a colorant in paints, glass, glazes, and enamels. It occurs in nature as cobalt bloom or erythrite; it was synthetically produced in 1880. It is highly toxic by ingestion, inhalation, and skin contact."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobaltous arsenate"@en .

aat:300380453 a skos:Concept ;
    skos:definition "An unstandardized name for whitish pigment made from bismuth nitrate, bismuth oxychloride, or from a calcium carbonate powder obtained from pulverizing and calcining mother-of-pearl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearl white"@en .

aat:300380454 a skos:Concept ;
    skos:definition "A naturally occurring oxide of titanium, having the chemical formula TiO2. It is a very stable compound with a high refractive index, used in food coloring, sunscreen, as a pigment, and in other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanium dioxide"@en .

aat:300380455 a skos:Concept ;
    skos:definition "Genus of flowering plants in the legume family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Haematoxylum"@en .

aat:300380456 a skos:Concept ;
    skos:definition "Species of shrub native to northern South America, Central American, and Mexico, and cultivated worldwide. Used as a source for food and pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bixa orellana"@en .

aat:300380457 a skos:Concept ;
    skos:definition "A deep yellow lake pigment prepared from quercitron; it is a darker version of Dutch pink that is prepared with a ferrous sulfate mordant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brown pink"@en .

aat:300380458 a skos:Concept ;
    skos:definition "Pigment made available in liquid form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet color"@en .

aat:300380461 a skos:Concept ;
    skos:definition "To standardize the settings for a measuring instrument so that its readings are absolute rather than relative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calibration"@en .

aat:300380462 a skos:Concept ;
    skos:definition "Size exclusion chromatography (SEC) is a type of chromatography that separates compounds based on differences in molecular size in solution. It uses a separation column containing a porous, semisolid medium which retards transport of larger particle while allowing small molecules to pass quickly through. SEC (also known as gel permeation chromatography) is primarily used for characterizing molecular weight distribution of synthetic polymers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "size exclusion chromatography"@en .

aat:300380463 a skos:Concept ;
    skos:definition "Reciprocal and reversible transfer of ions of the same charge between a solution and a relatively insoluble solid in contact with it. Cation exchange and anion exchange are, respectively, the exhange of positively and negatively charged ions. Ion exchange is used in such applications as kidney dialysis, water purification, and chemical analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ion exchange"@en .

aat:300380464 a skos:Concept ;
    skos:definition "Any of the range of synthetically polymerized organic compounds suitable for use in ion exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ion-exchange resin"@en .

aat:300380465 a skos:Concept ;
    skos:definition "Yellowish-brown powder that absorbs moisture from the air to form green crystals soluble in water. Copper chloride is used as a fixative in dyeing and printing fabrics, as a wood preservative, and in refining of copper, gold, and silver. The hydrolysis and oxidation of copper chloride is responsible for the destructive formation of bronze disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper chloride"@en .

aat:300380466 a skos:Concept ;
    skos:definition "Aragonite is a widespread mineral, a crystalline form of calcium carbonate that is found in deposits formed at low temperatures near the surface of the earth, occurring as stalactites, in sediments, iron-ore deposits, and basic rocks. It is also commonly found in pearls, coral, and shells. It was used in antiquity for beads and other decorative artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aragonite"@en .

aat:300380467 a skos:Concept ;
    skos:definition "The use of a vacuum cleaner to clean objects or surfaces by suction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum cleaning"@en .

aat:300380468 a skos:Concept ;
    skos:definition "A form of very high resolution scanning probe microscopy in which a sample in solution is moved under an atomically sharp (i.e. only a few atoms wide) stylus mounted on a cantilevered spring. A detector senses deflections of the cantilever, measuring the force between stylus and surface, and transmits this information to an electronic display system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atomic force microscopy"@en .

aat:300380469 a skos:Concept ;
    skos:definition "System for detecting the presence of objects or ascertaining their position or motion; works on the principle of radar, but uses laser radiation instead of microwaves. A lidar device emits intense pulses of light generated by lasers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lidar"@en .

aat:300380470 a skos:Concept ;
    skos:definition "Trademarked commercial name for a synthetic thermal plastic resin that does not embrittle or discolor over time, having a liquid density of 8.3 pounds per gallon, a flash point of 60 degrees Fahrenheit, and a viscosity of 3700-6200 cps. It is widely used in conservation treatments, and in clear and pigmented coatings, aerosols, printing inks, product finishes, and specification lacquers. Formerly called Acryloid B-72 (TM) in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paraloid B-72 (TM)"@en .

aat:300380471 a skos:Concept ;
    skos:definition "Trademarked name for a series of acrylic copolymer resins. They are applied to a wide range of object materials as an adhesive, consolidant, and protective coating. Paraloid (TM) resins are widely used in conservation treatments. Formerly marketed as Acryloid (TM) in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paraloid (TM)"@en .

aat:300380472 a skos:Concept ;
    skos:definition "Clear, colorless acrylic resin composed of a highly water-resistant isobutyl methacrylate polymer. It is a coatings oil and varnish modifier used for enamel paints, clear varnishes, and as a modifier to alkyd paints; formerly called Acryloid B-67 in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paraloid B-67 (TM)"@en .

aat:300380473 a skos:Concept ;
    skos:definition "Trademarked name for a thermoplastic acrylic resin composed of an ethyl acrylate and a methyl methacrylate copolymer. It supplies a hard, clear protective coating for metals but is subject to biodeterioration, and yellowing over time; formerly called Acryloid B-44 in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paraloid B-44"@en .

aat:300380474 a skos:Concept ;
    skos:definition "The state or characteristic of having a high degree of distinctness in an image. Examples are images achieved through the spacing of individual optical elements, such as grains of light-sensitive chemicals in a photograph or pixels in an electronic image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high resolution"@en .

aat:300380475 a skos:Concept ;
    skos:definition "A colorless hydrocarbon gas, the simplest of the alkynes, also called ethyne. Acetylene burns much more brightly than other gases and was used for stage lighting before electric lights were introduced. It burns with an intensely hot flame and is widely used as a fuel in oxyacetelene welding, soldering, and cutting of metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acetylene"@en .

aat:300380476 a skos:Concept ;
    skos:definition "A clear, colorless, poisonous liquid which can be polymerized to form acrylic and modacrylic fibers. It is coplymerized with butadiene to create nitrile rubber. Acrylonitrile is also used as an insecticide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylonitrile"@en .

aat:300380477 a skos:Concept ;
    skos:definition "Carbonaceous material, especially charcoal, activated by heat at high temperature, or otherwise treated to increase its porosity and adsorptive power. Activated carbon is used in removal of pollutants from gas and liquids and in other purification processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "activated carbon"@en .

aat:300380478 a skos:Concept ;
    skos:definition "Trademarked name for a series of oxygen absorbers used to extend the shelf-life of commercial food items; they are also used for insect eradication and oxygen-free storage in museums and archives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ageless (TM)"@en .

aat:300380479 a skos:Concept ;
    skos:definition "One of a group of amino alcohols of the aliphatic series; they are viscous, water-soluble liquids used as absorbents for acidic gases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkanolamine"@en .

aat:300380480 a skos:Concept ;
    skos:definition "Any of the silicates found in the earth’s crust, such as clays, micas and feldspars, in which aluminum replaces some of the silicon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminosilicate"@en .

aat:300380481 a skos:Concept ;
    skos:definition "A white granular solid that is soluble in water and slightly soluble in alcohol. It is used as a corrosion inhibitor, a mordant for printing cotton fabric; a mild cleaning agent for various metals, varnish and coated painted surfaces, and for removal of sulfate crust from stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium citrate"@en .

aat:300380482 a skos:Concept ;
    skos:definition "A colorless to white rock-forming mineral, named from the Greek “anhydrous” meaning without water. It is anhydrous calcium hydrate. An evaporate mineral, anhydrite hydrates readily to gypsum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anhydrite"@en .

aat:300380483 a skos:Concept ;
    skos:definition "The cultivation of fresh water and marine species of fish, shellfish, and aquatic plants; the aquatic equivalent of agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquaculture"@en .

aat:300380484 a skos:Concept ;
    skos:definition "Catalytic reaction produced by the product of a reaction that was itself catalytic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autocatalysis"@en .

aat:300380485 a skos:Concept ;
    skos:definition "Utensils employed to remove water, typically from watercraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bailers"@en .

aat:300380486 a skos:Concept ;
    skos:definition "Two-color pottery excavated in Palestine, Cyprus, and Coastal Syria; generally assigned to the 15th-16th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bichrome ware"@en .

aat:300380487 a skos:Concept ;
    skos:definition "A branch of biology that uses information from biological systems in order to mimic their microstructure in man-made materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biomimetics"@en .

aat:300380488 a skos:Concept ;
    skos:definition "Any of various natural polymers; long chained macromolecules occurring as DNA, protein, cellulose, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biopolymers"@en .

aat:300380489 a skos:Concept ;
    skos:definition "Enzyme-catalyzed synthesis of complex molecules from simpler ones in cells of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biosynthesis"@en .

aat:300380490 a skos:Concept ;
    skos:definition "Process in which heat converts a liquid into its gaseous state at a fixed temperature for that liquid known as the boiling point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boiling"@en .

aat:300380491 a skos:Concept ;
    skos:definition "A white ash composed chiefly of phosphate of lime; obtained by burning bones in air. Bone ash is used in cleaning jewelry; bone ash cupels have been related in Medieval and later archaeological contexts to the refining of noble metals in alchemy, assaying, jewelry, and coin minting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone ash"@en .

aat:300380492 a skos:Concept ;
    skos:definition "A colorless, non-combustible gas which hydrolyzes when exposed to air. It is used to catalyze chemical reactions in industry, and as a detector of slow neutrons in radiation measurement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boron trifluoride"@en .

aat:300380493 a skos:Concept ;
    skos:definition "Creating brushes for artists's use; made either from animal hair or synthetic material in a variety of shapes and sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brushmaking"@en .

aat:300380494 a skos:Concept ;
    skos:definition "Acrylate monomer used to form elastomers; a colorless flammable liquid that polymerizes easily upon heating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butyl acrylate"@en .

aat:300380495 a skos:Concept ;
    skos:definition "Gas chromatography technique using an open tubular column to convey the gaseous sample. Adsorption occurs on a medium spread on the walls of the capillary tube."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capillary gas chromatography"@en .

aat:300380496 a skos:Concept ;
    skos:definition "Preparation of pyroxylin dissolved in ethanol-ether used in microscopy for embedding specimens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celloidin"@en .

aat:300380497 a skos:Concept ;
    skos:definition "Metallic element having symbol Ce and atomic number 58; a gray, ductile metal, a lanthanite, cerium is the most abundant of the rare-earth group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cerium"@en .

aat:300380498 a skos:Concept ;
    skos:definition "Metallic element having symbol Cs and atomic number of 132.905. Cesium is a soft, silvery gold alkali metal with a very low melting point; it is the most reactive and electropositive of all the elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cesium"@en .

aat:300380499 a skos:Concept ;
    skos:definition "A natural fine-grained, greenish-blue corrosion product associated with cuprite and atacamite observed on ancient Egyptian bronzes. The formation of chalconatronite seems to have been due to the presence of hydrated sodium carbonates in the arid soils of certain parts of Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalconatronite"@en .

aat:300380500 a skos:Concept ;
    skos:definition "A thermosetting resin resulting from the carbonization of bituminous coal. It is used as protective coating in many applications, including for marbles and stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal-tar epoxy"@en .

aat:300380501 a skos:Concept ;
    skos:definition "A branch of chemistry that generates systems of chemical interest using a digital computer programmed with mathematical models representing the essential physics that determines molecular behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computational chemistry"@en .

aat:300380502 a skos:Concept ;
    skos:definition "A coloring agent found in pyrotechnics and in many pigments. It occurs naturally in crystalline form as blue colored azurite and green hued malachite. Copper carbonate is synthesized by adding sodium carbonate to a solution of copper sulfate; the product is then filtered and dried resulting in a colored powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper carbonate"@en .

aat:300380503 a skos:Concept ;
    skos:definition "A rare light blue corrosion product found as a contributing factor to the greenish chromatic degradation of azurite in mural paintings, and in the patina of outdoor bronze monuments such as the horses of San Marco in Venice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper oxalate"@en .

aat:300380504 a skos:Concept ;
    skos:definition "A sulfate of copper, blue crystals in hydrous form, white when dehydrated. Copper sulfate is used as a preservative for wood, leather and paper; as a mordant and dye for textiles; as a biocide, and for a wide range of other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper sulfate"@en .

aat:300380505 a skos:Concept ;
    skos:definition "A solvent added during chemical processing to an original solvent, the two, thanks to synergism, forming a mixture with solvent powers more than the sum of its parts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cosolvent"@en .

aat:300380506 a skos:Concept ;
    skos:definition "Brand name for a putty and other products made of fine resin. An example of use is a solidifying agent used to restore bronze wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Devcon (TM)"@en .

aat:300380507 a skos:Concept ;
    skos:definition "The measurement of thermal expansion of a liquid’s volume or the dimensions of a solid caused by phenomena such as compression and magnetostriction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dilatometry"@en .

aat:300380508 a skos:Concept ;
    skos:definition "A green, calcium magnesium silicate mineral sometimes used as a gemstone; a pyroxene-type mineral with short, monoclinic crystals. The transparent to translucent crystals have either a square or octagonal cross section. The color of diopside crystals ranges from light to dark green. Powdered diopside is used as a matting agent in ceramic glazes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diopside"@en .

aat:300380509 a skos:Concept ;
    skos:definition "Class of dense metamorphic rocks consisting of red-brown garnet and green pyroxene omphacite; with trace amounts of jadeite, diopside, almandine, pyrope, grossular, and rarely, diamond."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eclogite"@en .

aat:300380510 a skos:Concept ;
    skos:definition "A geophysical technique of surveying involving the measurement of lateral and vertical variations in resistivity of the earth to an electric current passing between metal electrodes; used in archaeology for 3D reconstruction of the subsurface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical resistivity tomography"@en .

aat:300380511 a skos:Concept ;
    skos:definition "Technique by which one computer is enabled to interpret and execute the instruction set of another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emulation"@en .

aat:300380512 a skos:Concept ;
    skos:definition "Assay technique in which a monoclonal antibody is bound to an enzyme to detect and measure the presence of an antigen in a sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enzyme-linked immunosorbent assay"@en .

aat:300380513 a skos:Concept ;
    skos:definition "Hydrous magnesium sulfate mineral usually found as a crust, efflorescence, or tiny crystals on mine and cave walls. Neutralized and purified, epsomite is sold as epsom salts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epsomite"@en .

aat:300380514 a skos:Concept ;
    skos:definition "A secondary mineral produced by the surface oxidation of primary cobalt. Erythrite is a violet to peach red arsenate once used as a pigment in paints, glass, and ceramics; replaced for these purposes by its synthetic form, cobaltous arsenate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erythrite"@en .

aat:300380515 a skos:Concept ;
    skos:definition "Vitreous green iron silicate mineral, a member of the olivine group, named for the type locality, Fayal Island, Azores. The brittle stone was also produced synthetically as a component of slag separated in smelting at ancient iron working furnaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fayalite"@en .

aat:300380516 a skos:Concept ;
    skos:definition "Chemical oxidant; a solution of hydrogen peroxide and iron sulfate used for in-situ oxidation of organic contaminants such as trichloroethylene."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fenton’s reagent"@en .

aat:300380517 a skos:Concept ;
    skos:definition "A lightweight fiber usually made from polyester used as a filling material for cushions and insulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiberfill"@en .

aat:300380518 a skos:Concept ;
    skos:definition "Colorless liquid, an aldehyde of furan, which is used chiefly as a solvent, a biocide, and in the manufacture of synthetic resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furfural"@en .

aat:300380519 a skos:Concept ;
    skos:definition "Species of perennial plant grown for its flavorful bulbs; native to central Asia but grows wild in Italy and southern France, and is a classic ingredient in many national cuisines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Allium sativum"@en .

aat:300380520 a skos:Concept ;
    skos:definition "UNESCO designation and brand for unified areas with outstanding geological heritage of international significance, where low impact recreation, scientific research, and educational activities can be pursued."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geoparks"@en .

aat:300380521 a skos:Concept ;
    skos:definition "In magnetometry, devices with multiple sensors that measure the gradient of magnetic fields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gradiometers"@en .

aat:300380522 a skos:Concept ;
    skos:definition "Oil expressed from the seeds of Vitis vinifera grapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grape seed oil"@en .

aat:300380523 a skos:Concept ;
    skos:definition "Beverage of Asian origin derived from unfermented leaves, cut and steamed, of the plant Camellia sinensis; used for many medicinal applications as well as for refreshment. ‘Black tea’ is derived from the same plant. It is produced by allowing the leaves to oxidize. In the context of conservation, green tea catechins have been used as environmentally friendly formaldehyde scavengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "green tea"@en .

aat:300380524 a skos:Concept ;
    skos:definition "A method of differential thermal analysis using a thermocouple which is mounted on a microscope stage and can simultaneously function as a microfurnace and thermometer. The technique allow continuous monitoring and recording of the cooling curves of melt droplets or the heating curves of glass beads between any two pre-selected temperatures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high temperature microscopy"@en .

aat:300380525 a skos:Concept ;
    skos:definition "A colorless corrosive gas, the hydride of fluorine and an extremely powerful halogen acid, hydrogen fluoride is used as a catalyst and a fluorinating agent. Its chief use is in making fluorine-containing refrigerants such as freons. In a conservation context, hydrogen fluoride is considered as an atmospheric pollutant which damages metal structures, and buildings or monuments made of limestone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrogen fluoride"@en .

aat:300380526 a skos:Concept ;
    skos:definition "Transparent, naturally-occurring calcite crystal used in demonstrating the polarization of light. An oblong stone made of Iceland spar found in the wreck of a 16th-century English warship in 2013 has led archaeologists to speculate that the crystal is one and the same as the sunstone, a near-mythical navigational aid said to have been used by Viking mariners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iceland spar"@en .

aat:300380527 a skos:Concept ;
    skos:definition "Active, passive, or facilitated movement of salts and other electrolytes in the form of ions across energy-transducing cell membranes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ion transport"@en .

aat:300380528 a skos:Concept ;
    skos:definition "Colorless liquid polymer used as a water-repellent synthetic resin varnish and barrier coating. It is resistant to discoloring, aging, temperature changes, and exposure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isobutyl methacrylate"@en .

aat:300380529 a skos:Concept ;
    skos:definition "Salt formed by adding hydrochloric acid to lithium. Lithium chloride is the compound used to produce lithium metal by electrolysis. Thanks to its hygroscopic capacity, it is used for controlling relative humidity within a sealed environment. It is also used as a soldering flux, and to produce red colors in pyrotechnics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithium chloride"@en .

aat:300380530 a skos:Concept ;
    skos:definition "The most important of the lithium compounds, lithium hydroxide is a white crystalline powder. Among its applications, it is a sorbent for carbon dioxide, an additive to storage batteries, and is used in the manufacture of alkyd resins and other lithium salts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithium hydroxide"@en .

aat:300380531 a skos:Concept ;
    skos:definition "Any of several silicates containing magnesium; they are generally inert minerals used as fireproofing materials, abrasives, or fillers in paint and paper. The most common hydrated forms of magnesium silicate found in nature are asbestos and talc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium silicate"@en .

aat:300380532 a skos:Concept ;
    skos:definition "A Japanese box or cabinet made of paulownia wood and used for storing objects or art works such as ceramics or tsuba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiri-bako"@en .

aat:300380533 a skos:Concept ;
    skos:definition "Manganite is an oxide ore mineral of manganese that forms dark steel gray to iron black crystal bundles or fibrous masses. A pigment derived from manganite was used in prehistoric cave paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganite"@en .

aat:300380534 a skos:Concept ;
    skos:definition "A technique for studying turbidity which records the decrease in intensity of a light beam resulting from its passage through a suspension of particles. A detector, the nephelometer, measures the scattered light and may thus indirectly measure the size and concentration of particles in the suspension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nephelometry"@en .

aat:300380535 a skos:Concept ;
    skos:definition "Colorless, odorless, highly flammable gas, the simplest alkane. Methane occurs in natural gas, as firedamp in coal mines, and is produced by decaying vegetation and in the guts of ruminants. Methane is used as a fuel, and as a starting material in manufacture of chemicals. Methane carried into the stratosphere by rising air acts as a greenhouse gas and degrades the ozone layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methane"@en .

aat:300380536 a skos:Concept ;
    skos:definition "Testing techniques that cause minimal damage to the sample. The designation is the middle term in characterizing destructivity of scientific analysis, falling between ‘destructive testing’ and 'non destructive testing’."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro-destructive testing"@en .

aat:300380537 a skos:Concept ;
    skos:definition "X-ray diffraction technique which uses x-ray optics to focus an excitation beam to a small spot on the sample surface so that extremely small features on the sample can be analyzed at much higher resolution than with conventional XRD."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro x-ray diffraction"@en .

aat:300380538 a skos:Concept ;
    skos:definition "Study of topographic irregularities on a very small or microscopic scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microtopography"@en .

aat:300380539 a skos:Concept ;
    skos:definition "In multispectral imaging, images simultaneously obtained of an object at different wavelengths are made into a composite that displays the discrete spectral bands as colors. The resulting color patterns can be used to identify surface features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multispectral imaging"@en .

aat:300380540 a skos:Concept ;
    skos:definition "A compound in which nitrogen is paired with a more electropositive element, such as silicon, boron, and most metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitride"@en .

aat:300380541 a skos:Concept ;
    skos:definition "Anglo-Saxon technique of welding together and hammering out alternate bands of iron and steel to forge a decoratively contrasting sword blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pattern welding"@en .

aat:300380542 a skos:Concept ;
    skos:definition "Measurement of the intensity of odors produced by a gaseous substance using an olfactometer; used, for example, to evaluate the success of applied methods of odor reduction on used polyolefins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olfactometry"@en .

aat:300380543 a skos:Concept ;
    skos:definition "One of a group of organic compounds containing carbon-silicon bonds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organosilicon"@en .

aat:300380544 a skos:Concept ;
    skos:definition "The geometric correction of spatial distortions such as tilt and relief in aerial photographs, resulting in uniformity of scale. Orthocorrected images may be used to measure true distances; a basis of aerial photogrammetry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthophotography"@en .

aat:300380545 a skos:Concept ;
    skos:definition "Colorless, nonflammable chlorinated hydrocarbon used widely as a dry cleaning solvent and an industrial degreaser."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetrachloroethylene"@en .

aat:300380546 a skos:Concept ;
    skos:definition "Rare mineral that occurs as pale yellow crystals. Phosgenite is formed in the oxidation zone of lead ore deposits. Phosgenite has been identified as a constituent in ancient Egyptian cosmetic powders; it appears to have been synthetically produced using “wet” chemistry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosgenite"@en .

aat:300380547 a skos:Concept ;
    skos:definition "Any salt or ester of a phosphonic acid. Phosphonates have been tested in recent years as potential crystallization inhibitors for sodium sulfate, a soluble salt that damages historic buildings and sculptures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphonate"@en .

aat:300380548 a skos:Concept ;
    skos:definition "The measurement of plane surfaces, as in a planimetric survey of an architectural landmark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planimetry"@en .

aat:300380549 a skos:Concept ;
    skos:definition "The process of making light or other electromagnetic waves vibrate in a single plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polarization"@en .

aat:300380552 a skos:Concept ;
    skos:definition "Yellow, soluble crystalline compound used as an etching liquid, as a fungicide in paper, in dyes and pigments. In reaction with iron ions it becomes ferric ferrocyanide, the chief component of Prussian blue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium ferrocyanide"@en .

aat:300380553 a skos:Concept ;
    skos:definition "Minerals that have assumed the shapes of the substances they have replaced; such as mineralized textiles in a burial environment formed through the replacement of the organic matrix of fiber with a largely inorganic one."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudomorphs"@en .

aat:300380554 a skos:Concept ;
    skos:definition "Method of dating by measuring, on an exposed surface of quartz, the thickness of the hydration layer caused by the natural intake of water on that surface from the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz hydration dating"@en .

aat:300380555 a skos:Concept ;
    skos:definition "Radioactive chemical element having symbol Rn and atomic number 86. It is a colorless, odorless, tasteless inert gas. Radon is formed during the natural decay of radium. It is produced in rock and soil and migrates to the surface, sometimes entering buildings through basement walls, resulting in low level exposure. Radon’s health risk is associated with the products of radon decay and not with the gas itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radon"@en .

aat:300380556 a skos:Concept ;
    skos:definition "A gear-driven drilling instrument which inserts a three-millimeter-diameter probe into a tree, and graphically or digitally records resistance to the probe; used to detect decay and defects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Resistograph (TM)"@en .

aat:300380557 a skos:Concept ;
    skos:definition "A starchy powder made from the root of several species of the Orchis genus containing a nutritive starch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salep"@en .

aat:300380558 a skos:Concept ;
    skos:definition "A nitrogen-rich, combustible, sludge-like black sedimentary deposit that occurs as a result of the decomposition of microorganisms in anaerobic conditions on the bottoms of lakes and seas. Compressed into hard rock, sapropel becomes oil shale or sapropelic coal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sapropel"@en .

aat:300380559 a skos:Concept ;
    skos:definition "Decorative glassware in which metal particles, precious stones, or other materials are embedded in the glass. Particularly used to describe ancient Roman glass. For a distinctive kind of ornamental glass, similar to millefiore, made by fusing together rods of variously colored glass and then cutting the fused rods into cross-sections, use \"mosaic glass.\" Also, although the names are similar and sometimes confused, murrhine glass differs from “Murano glass.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "murrhine glass"@en .

aat:300380560 a skos:Concept ;
    skos:definition "One of a group of rock forming minerals composed of silicates of calcium, sodium and aluminum. Marialite, meionite, ekbergite are members of the scapolite group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scapolite"@en .

aat:300380561 a skos:Concept ;
    skos:definition "Distinctive glass produced on the island of Murano, located off Venice, Italy. Murano was well-known for glassmaking by the 10th century. Even though Murano glassmakers have emigrated elsewhere, experts and commercial markets usually hold that authentic Murano glass is fabricated only in Murano. Most Murano glass is made using the lampworking technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Murano glass"@en .

aat:300380562 a skos:Concept ;
    skos:definition "Surface damage produced by grinding contact; sharp-edged, narrow furrows often involving loss of surface material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratches"@en .

aat:300380563 a skos:Concept ;
    skos:definition "Gelatinous protein that cements silk fibers together in the cocoon. Sericin is secreted along with fibroin by the insect. It is usually removed, by boiling the raw silk in soap and water, during fabric manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sericin"@en .

aat:300380564 a skos:Concept ;
    skos:definition "In medical science, that branch of immunology which studies antibodies in the serum or other bodily fluids, and antigens present on cells of blood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serology"@en .

aat:300380565 a skos:Concept ;
    skos:definition "Identification of the sex of human or animal subjects, typically prenatal or as remains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sex determination"@en .

aat:300380566 a skos:Concept ;
    skos:definition "Shape memory alloys are imprinted with a shape so that even after they are deformed, a threshold temperature will bring about a return to the original configuration. Copper-aluminium-nickel, and nickel-titanium are the two main types of shape memory alloy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shape memory alloy"@en .

aat:300380567 a skos:Concept ;
    skos:definition "Drawings made by using an implement comprising thin, sharpened rods of silver, usually in a holder, on a support of paper, parchment, or wood treated with a prepared wash or gesso. Ivory may also be used as a support. The silver lines oxidize quickly, making the drawing more distinct, but still delicate and fine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silverpoint drawings"@en .

aat:300380568 a skos:Concept ;
    skos:definition "Colorless, crystalline compound that forms naturally as caliche in mineral deposits, chiefly in Chile and Peru. Sodium nitrate is used in the manufacture of fertilizers, glass, and explosives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium nitrate"@en .

aat:300380569 a skos:Concept ;
    skos:definition "An ancient fabric creation technique that predates knitting and crochet; it involves braiding parallel threads with fixed threads on a frame. The term refers as well to the net-like fabric so produced. Sprang headgear, belts, and other artifacts dating from Bronze age onward have been found at archaeological sites in Scandinavia, Europe and Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sprang"@en .

aat:300380570 a skos:Concept ;
    skos:definition "Steroscopic display of paired radiographs taken from slightly different angles producing a three-dimensional effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereoradiography"@en .

aat:300380571 a skos:Concept ;
    skos:definition "Colorless or pale yellow unsaturated crystalline hydrocarbon used in dyestuffs and as a fabric brightener."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stilbene"@en .

aat:300380572 a skos:Concept ;
    skos:definition "Refers to examples of the knitting machine invented by William Lee of Cambridge, England in 1589. It produced net composed of the basic looped ‘stocking stitch’ and thus superseded hand-knitting. The introduction of this technology initiated the process of mechanizing the textile industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stocking frames"@en .

aat:300380573 a skos:Concept ;
    skos:definition "A yellow colored secondary uranium mineral containing peroxide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studtite"@en .

aat:300380574 a skos:Concept ;
    skos:definition "Any of several gaseous compounds of sulfur and oxygen, most importantly sufur dioxide and sulfur trioxide. Sulfur oxides are responsible for about 18 percent of the total average pollutant content of air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfur oxide"@en .

aat:300380575 a skos:Concept ;
    skos:definition "Oxide appearing as an olive-brown or blue-black anhydrous powder when stannous oxalate is heated out of contact with the air. Uses include manufacturing of other tin compounds, as a reducing agent, and as an ingredient in creating ruby glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stannous oxide"@en .

aat:300380576 a skos:Concept ;
    skos:definition "Titanium carbide is a refractory ceramic material widely used for cutting tools because of its extreme hardness and wear resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "titanium carbide"@en .

aat:300380577 a skos:Concept ;
    skos:definition "Any salt or ester containing three phosphate groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triphosphate"@en .

aat:300380578 a skos:Concept ;
    skos:definition "Apparatus that allows separation of ions in a single drop of solution; used for analysis of minute samples. Vaporizarion of solvent from filter paper is effected, leaving the solute in a ring shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Weisz ring ovens"@en .

aat:300380579 a skos:Concept ;
    skos:definition "Refers to several liquors made from a fermented mash of cereal grain; distilled chiefly from matted barley in Ireland, Scotland and in the British Isles; and from corn and maize in the US."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whiskey"@en .

aat:300380580 a skos:Concept ;
    skos:definition "Chemical element having symbol Y and atomic number 39. Yttrium resembles lanthanide metals very closely and is often classified as a ‘rare earth element.' Yttrium’s most important use is for making the phosphors used in television screen displays and in LEDs. Yttrium phosphors emit a clear red light when excited by electrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yttrium"@en .

aat:300380581 a skos:Concept ;
    skos:definition "Japanese floor cushions for sitting or kneeling; relatively large, flat throw pillows. The Japanese word zabuton means \"sitting mat.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zabutons"@en .

aat:300385930 a skos:Concept ;
    skos:definition "Maps having decorative panels of views, monuments, costumed figures, or other illustrations that surround the actual cartographic representation. Illustrations were often arranged around the borders, particularly in early examples from the 16th and 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartes à figures"@en .

aat:300385931 a skos:Concept ;
    skos:definition "The religion of the autonomous, self-governing churches that preserve ancient eastern Christian theological, liturgical, and devotional traditions that depend originally on the Eastern Empire at Constantinople, but today Eastern Catholic churches remain in full communion with the Pope and the western church centered in Rome. Differences include that the Eastern Catholic church allows married clergy and the immediate admission of baptized infants to the sacraments of the Eucharist and Confirmation, which happen later in childhood within the western church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Catholic"@en .

aat:300385932 a skos:Concept ;
    skos:definition "Religion of eastern Christian churches that recognize three of the ecumenical councils, the First Council of Nicaea, the First Council of Constantinople, and the First Council of Ephesus, but they reject the dogmatic definitions of the Council of Chalcedon of 451 CE, particularly the tenet that Jesus is one person in two complete natures, one human and one divine. The Oriental Orthodox maintain that this view is too close to the Nestorian heresy, which held that Christ was two distinct beings, the divine Logos and the human Jesus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oriental Orthodox"@en .

aat:300385933 a skos:Concept ;
    skos:definition "Oriental Orthodox Christian religion in Eritrea, which has had a large Christian population since the 4th century. It is in dispute whether or not the Eritrean Orthodox church is a division of the Ethiopian Orthodox church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eritrean Orthodox"@en .

aat:300385935 a skos:Concept ;
    skos:definition "Oriental Orthodox Christian religion based in the Indian state of Kerala, by tradition tracing its origins to St. Thomas the Apostle in the first century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian Orthodox"@en .

aat:300385936 a skos:Concept ;
    skos:definition "Oriental Orthodox Christian religion based in Armenia, which was the first country to adopt Christianity as its official religion in 301 CE. By tradition, it originated in missionary work of the apostles Bartholomew and Thaddeus in the first century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian Apostolic"@en .

aat:300385937 a skos:Concept ;
    skos:definition "The belief system, teachings, and practices of the Worldwide Brotherhood or Rosicrucians, first documented in 1614. The legendary founder was named Christian Rosenkreuz, said to have been born in 1378. The name probably actually derives from the order’s symbol, a rose on a cross, which is similar to the family coat of arms of Martin Luther. Rosicrucian teachings are a combination of occultism and other religious beliefs and practices, including Hermeticism, Jewish mysticism, and Christian Gnosticism. The core of their beliefs is that they possess esoteric wisdom handed down from ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosicrucian"@en .

aat:300385938 a skos:Concept ;
    skos:definition "Architectural movement and style which began in England ca. 1715-1770, and was later seen in The United States in the early 19th century. Taking its inspiration from the work of 16th century Venetian architect Andrea Palladio (1508-1580) and his 17th century British disciple Inigo Jones (1573-1652), the style is seen as a reaction to the Baroque architecture of the time, and was based on the symmetry and forms of classical Greek and Roman temples. Palladian Revival is seen mostly in residential architecture and large country estates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palladian Revival"@en .

aat:300385939 a skos:Concept ;
    skos:definition "General term for the belief systems of thousands of small-scale societies who have distinct languages, kinship systems, mythologies, ancestral memories, and homelands, but whose religious and spiritual beliefs fall outside the realm of world religions such as Buddhism or Christianity. Central to indigenous religious traditions is an awareness of the integral and whole relationship of symbolic and material life, often incorporating ritual practices and cosmological ideas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigenous religions"@en .

aat:300385948 a skos:Concept ;
    skos:definition "General term for the period, cultures, and styles of ancient Germany, typically up to the Medieval period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient German"@en .

aat:300385950 a skos:Concept ;
    skos:definition "The culture and style of the ancient Greek kingdom of Macedonia and its other political configurations, the area of which was centered in the northeastern part of the Greek peninsula. For the culture of modern Macedonia, use \"Macedonian (modern).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Macedonian"@en .

aat:300385952 a skos:Concept ;
    skos:definition "General term for the ancient cultures and styles of the Fertile Crescent and Eastern Arabia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Syrian"@en .

aat:300385953 a skos:Concept ;
    skos:definition "The style or culture of Andalusia, a southern province of Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andalusian"@en .

aat:300385954 a skos:Concept ;
    skos:definition "The style and culture of Andorra, an ancient principality located in the Pyrenees between France and Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andorran"@en .

aat:300385955 a skos:Concept ;
    skos:definition "Having to do with the style or culture of the south polar region of the earth, which comprises the continent of Antarctica together with the seas and islands of the Southern Ocean. Also refers to the flora, fauna, geography, oceanography, or climate of the region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antarctic"@en .

aat:300385956 a skos:Concept ;
    skos:definition "The style, culture, or nationality of the island nation Antigua and Barbuda, in the in the West Indies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antiguan Barbudan"@en .

aat:300385957 a skos:Concept ;
    skos:definition "Refers to style elements or influence deriving from the Arabic language, alphabet, or script, wherever in the world it is found. For a reference to the culture of the Arabian peninsula, use \"Arabian (culture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabic"@en .

aat:300385958 a skos:Concept ;
    skos:definition "Style and culture of the mountainous northern regions of the Pyrenees in Spain, bound by common ethnicity and language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aragonese"@en .

aat:300385959 a skos:Concept ;
    skos:definition "In the context of art and culture, the culture of the indigenous peoples of the northern polar region of the earth, including the Arctic Ocean and the northernmost parts of Asia, Europe, and North America. The term may also refer to the animals, plants, climate, geology, geography, and oceanography of the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arctic"@en .

aat:300385960 a skos:Concept ;
    skos:definition "The culture and style of ancient Argos, Peloponnese, Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Argive"@en .

aat:300385961 a skos:Concept ;
    skos:definition "The culture and style of ancient Arianá, Aegean Islands, Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arian"@en .

aat:300385962 a skos:Concept ;
    skos:definition "Designates the styles, culture, and heritage of Americans of Asian descent in North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asian-American"@en .

aat:300385963 a skos:Concept ;
    skos:definition "Nationality or culture of the modern nation of Armenia, a mountainous country in the South Caucasus region of Eurasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian"@en .

aat:300385964 a skos:Concept ;
    skos:definition "Style and culture of the city of Athens. For the culture of the larger region of Attica, use \"Attic.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Athenian"@en .

aat:300385965 a skos:Concept ;
    skos:definition "Belonging to the nationality or culture of Austria-Hungry and the Habsburg Empire, existing primarily between 1867 and 1918."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Austro-Hungarian"@en .

aat:300385966 a skos:Concept ;
    skos:definition "The nationality of the Commonwealth of the Bahamas, or style or culture of the Bahama islands, a group of over 700 islands, cays, and islets in the Atlantic Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bahamian"@en .

aat:300385967 a skos:Concept ;
    skos:definition "The nationality, style, or culture of Bahrain, an archipelago and small island country situated near the western shores of the Persian Gulf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bahraini"@en .

aat:300385968 a skos:Concept ;
    skos:definition "The nationality, style, or culture of Bangladesh, located at the northeast corner of the Indian subcontinent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bangladeshi"@en .

aat:300385969 a skos:Concept ;
    skos:definition "The nationality, style, or culture of the island of Barbados, which is today a sovereign country in the Lesser Antilles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barbadian"@en .

aat:300385971 a skos:Concept ;
    skos:definition "The style and culture of the ancient Batavi from around the Rhine delta, in the area currently in the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Batavian"@en .

aat:300385972 a skos:Concept ;
    skos:definition "The nationality, style, and culture of Bavaria in what is today southeast Germany; either the historical duchy or kingdom, or the modern state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bavarian"@en .

aat:300385974 a skos:Concept ;
    skos:definition "The nationality, style, or culture of the Bermuda islands located in the North Atlantic Ocean, off the east coast of the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bermudian"@en .

aat:300385975 a skos:Concept ;
    skos:definition "The culture and style of ancient Bœotia, on Mainland Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boeotian"@en .

aat:300385976 a skos:Concept ;
    skos:definition "The nationality, style, or culture of Bologna, in north central Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolognese"@en .

aat:300385977 a skos:Concept ;
    skos:definition "The nationality, culture, or style of Bosnia in southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bosnian"@en .

aat:300385978 a skos:Concept ;
    skos:definition "The nationality of Bosnia Herzegovina, a nation in southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bosnian Herzegovinian"@en .

aat:300385979 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the historic region of Bretagne or modern Britanny, France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Breton"@en .

aat:300385980 a skos:Concept ;
    skos:definition "The culture and style of the Brittonic-speaking peoples originally inhabiting all of Great Britain south of the Firth of Forth, and Brittany in northern France, before and during the Roman occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient British"@en .

aat:300385981 a skos:Concept ;
    skos:definition "Nationality, culture, or style of British Columbia, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British Columbian"@en .

aat:300385982 a skos:Concept ;
    skos:definition "The nationality, style, or culture of Brunei, located on the north coast of the island of Borneo in Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bruneian"@en .

aat:300385983 a skos:Concept ;
    skos:definition "The culture and style of an ancient Finnish Bulgar tribe who conquered the Slavs of Moesia in the seventh century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bulgar"@en .

aat:300385984 a skos:Concept ;
    skos:definition "The nationality, style, or culture of the region of Calabria, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calabrian"@en .

aat:300385986 a skos:Concept ;
    skos:definition "The group of religions comprising Judaism, Christianity, and Islam, that trace their origin to the prophet Abraham."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abrahamic religions"@en .

aat:300385989 a skos:Concept ;
    skos:definition "Style and culture of one of the largest Indian scheduled tribes; they are a Dravidian people of central India, many of them were or still are jungle-dwellers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gond"@en .

aat:300385990 a skos:Concept ;
    skos:definition "Style and culture of the Bhil central Indian people, one of the largest Indian scheduled tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bhil"@en .

aat:300385991 a skos:Concept ;
    skos:definition "Style and culture of one of the largest Indian scheduled tribes; the Santal are a Kolarian people of northeastern India and Bangladesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santal"@en .

aat:300385992 a skos:Concept ;
    skos:definition "Culture or style of an ancient Indian people of pre-Aryan origin, now living scattered in central India and in a region extending from east central India towards Bangladesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Munda"@en .

aat:300385993 a skos:Concept ;
    skos:definition "Nationality, style, and culture of one of the largest Indian scheduled tribes, found in the Indian state of Jharkhand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ho"@en .

aat:300385994 a skos:Concept ;
    skos:definition "North Dravidian language of the Oraons, akin to Gondi and other tribal languages of central India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oraon"@en .

aat:300385995 a skos:Concept ;
    skos:definition "The nationality, culture, or style of the Canton province on the South China Sea coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cantonese"@en .

aat:300385996 a skos:Concept ;
    skos:definition "The nationality, style, or culture of Cappadocia, an ancient kingdom of Asia Minor, now a part of Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cappadocian"@en .

aat:300385997 a skos:Concept ;
    skos:definition "Nationality, style, or culture of Carinthia, now in modern Austria; refers to the historical duchy, principality, or margraviate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carinthian"@en .

aat:300385998 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the Castile area of central Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castilian"@en .

aat:300385999 a skos:Concept ;
    skos:definition "Cultures and styles of the region lying between Eastern and Western Europe, variously defined but usually including Austria, Czech Republic, Germany, Hungary, Liechtenstein, Poland, Slovakia, Slovenia, and Switzerland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Central European"@en .

aat:300386000 a skos:Concept ;
    skos:definition "Nationality, culture, or style of ancient Chalcis, the chief city of Eubœa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chalcidian"@en .

aat:300386001 a skos:Concept ;
    skos:definition "The culture of ancient Latium or the ancient Latini tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latini"@en .

aat:300386002 a skos:Concept ;
    skos:definition "General term for the culture, style, and periods of China in ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Chinese"@en .

aat:300386003 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the city of Florence, Tuscany, in central Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Florentine"@en .

aat:300386004 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Siena, Tuscany, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sienese"@en .

aat:300386005 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of ancient Sparta, a prominent city state in ancient Greece on the banks of the Eurotas River in Laconia, in the southeastern Peloponnese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spartan"@en .

aat:300386006 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Taranto, Apulia, southeastern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tarantine"@en .

aat:300386007 a skos:Concept ;
    skos:definition "The condition of low oxygen; it is typically defined as a level below 20.9% in an atmospheric environment and in the range between 1%-30% saturation in an aquatic environment. Hypoxic conditions are detrimental to living organisms. In a conservation context, hypoxia may be deliberately induced as a means of preservation of materials or pest control. For the extreme condition in which oxygen is below 0.1% or absent, use \"anoxia.\" For a medical condition characterized by low blood oxygen, use \"anoxemia,\" for which \"hypoxemia\" is a used for term."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypoxia"@en .

aat:300386008 a skos:Concept ;
    skos:definition "The culture or style of Americans of Chinese descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese-American"@en .

aat:300386009 a skos:Concept ;
    skos:definition "The culture, style, and period in the development of a peoples when they begin using very small stone tools, often combined with wood, bone, resin and fiber to form a composite tool or weapon, such as the points of spears and arrows. Microlithic culture developed at different times in different places throughout the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microlithic"@en .

aat:300386011 a skos:Concept ;
    skos:definition "Nationalilty, style, and culture of an ancient district of southern Asia Minor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cilician"@en .

aat:300386012 a skos:Concept ;
    skos:definition "Nationality, style, period, and culture of people of British origin in the British colonies of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial British American"@en .

aat:300386013 a skos:Concept ;
    skos:definition "Styles, period, culture, and natinality of Canada during the period when it was colonized by the Britsh and French."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial Canadian"@en .

aat:300386014 a skos:Concept ;
    skos:definition "Styles, period, culture, and nationality of people of French origin in French American colonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Colonial French American"@en .

aat:300386015 a skos:Concept ;
    skos:definition "Broad designation encompassing cultures of all European peoples who speak languages descended from Latin; originally with the erroneous implication that these peoples are of Roman descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin"@en .

aat:300386016 a skos:Concept ;
    skos:definition "Culture or style belonging to ancient Corinth in the Peloponnese, south central Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corinthian"@en .

aat:300386017 a skos:Concept ;
    skos:definition "Nationality, culture, or style of Corsica, an island in the Mediterranean Sea located west of Italy, southeast of the French mainland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corsican"@en .

aat:300386018 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Costa Rica, in Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Costa Rican"@en .

aat:300386019 a skos:Concept ;
    skos:definition "The style and culture of the ancient Gallo-Germanic Belgæ tribes living from the 3rd century BCE onward in northern Gaul, between the English channel and the west bank of the Rhine. They were later found in Britain and Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belgic"@en .

aat:300386020 a skos:Concept ;
    skos:definition "The nationality, culture, and style of Dacia, an ancient country of southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dacian"@en .

aat:300386021 a skos:Concept ;
    skos:definition "The prehistoric cultures of the regions surrounding the Danube river and beyond, particularly the agrarian societies in central and eastern Europe, from the Balkans to the Low Countries and the Paris Basin. In addition to establishing the distinctive pottery traditions of Linear Pottery culture, stroked pottery culture, and Rössen culture, the early phases of Danubian peoples cleared forests, cultivated fertile loess soils, kept domesticated cows, goats, pigs, sheep, and dogs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Danubian"@en .

aat:300386023 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the Dominican Republic on the island of Hispaniola, part of the Greater Antilles archipelago in the Caribbean region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dominican"@en .

aat:300386024 a skos:Concept ;
    skos:definition "Nationality and culture making up one of the four major divisions of the ancient Greek people, along with the Aeolians, Achaeans and Ionians; distinguished by a well-marked dialect and social subdivisions. They probably originated in Macedonia and Epirus, and moved southward into central Greece and then into the southern Aegean area in successive migrations beginning ca. 1100 BCE, at the end of the Bronze Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Doric"@en .

aat:300386025 a skos:Concept ;
    skos:definition "Nationality, culture, and style of one of the four major divisions of the ancient Greek people, along with the Aeolians, Doric, and Ionians. The area of historical Achaea, comprising a strip of land between the gulf of Corinth in the north and Elis and Arcadia in the south, containing twelve cities that leagued together prior to the Roman conquest in 146 BCE. As identified in Homer, the culture earlier was more broadly dispersed in the area basically comprising the Mycenaean civilization of the 14th-13th centuries BCE. Thus some scholars identify the culture as synonymous with the Mycenaean, while others believe Achaeans held power in the Mycenaean world only for a few generations. The Achaeans of the northern Peloponnese in historic times were believed by Herodotus to be descendants of these earlier Achaeans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Achaean"@en .

aat:300386026 a skos:Concept ;
    skos:definition "Nationality, culture, and style of one of the four major divisions of the ancient Greek people, along with the Doric, Achaeans and Ionians. They came from the area of Aeolia, comprising a group of ancient cities on the west coast of Anatolia, founded beginning ca. 1130-1000 BCE by Greeks speaking an Aeolic dialect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aeolian"@en .

aat:300386027 a skos:Concept ;
    skos:definition "Nationality, culture, and style of one of the four major divisions of the ancient Greek people, along with the Aeolians, Achaeans and Doric. the Ionians were an ancient Hellenic people inhabiting Attica, parts of western Asia Minor, and the Aegean Islands in pre-classical times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionian"@en .

aat:300386028 a skos:Concept ;
    skos:definition "The styles and cultures of various indigenous tribal populations located within the Indian subcontinent and retaining their ancient African/Austric languages, generally limited to those whose ancestral presence in the area precedes the Dravidian settlement of ca. 2000 BCE and various Aryan (Indo-European) invasions ca. 1500 BCE. In the constitution of India, in 1950 most of these groups were listed as Scheduled Tribes, targeted for social and economic development; used as the general term for the Indian scheduled tribes, who are usually descendents of these people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Adivasi"@en .

aat:300386029 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the area of ancient Erétria, Central Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eretrian"@en .

aat:300386030 a skos:Concept ;
    skos:definition "Nationality, styles, and culture belonging to the island of Euboea, Central Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Euboean"@en .

aat:300386033 a skos:Concept ;
    skos:definition "Aerial photography using a camera mounted or held in a hot-air balloon or other large balloon traveling in the atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balloon photography"@en .

aat:300386034 a skos:Concept ;
    skos:definition "Chalcolithic culture active ca. 1500 BCE in Maharashtra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jorwe"@en .

aat:300386035 a skos:Concept ;
    skos:definition "Genre of literature native to India concerning the previous births of Gautama Buddha. These are the stories that tell about the previous lives of the Buddha, in both human and animal form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jātakas"@en .

aat:300386037 a skos:Concept ;
    skos:definition "In traditional Indian art and dance, an active, standing pose with one leg bent and the other outstretched. An example of usage is when depicting a deity trampling an adversary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alidha"@en .

aat:300386039 a skos:Concept ;
    skos:definition "The earth, floor, or foundation, symbolically stages of enlightenment in Buddhist practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhūmi"@en .

aat:300386040 a skos:Concept ;
    skos:definition "Libraries in Jain temple spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhandārs"@en .

aat:300386043 a skos:Concept ;
    skos:definition "Parts or components of curtains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curtain components"@en .

aat:300386044 a skos:Concept ;
    skos:definition "Works of art in any medium in which an animal or animals are the primary focus; includes real and imaginary animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal art"@en .

aat:300386045 a skos:Concept ;
    skos:definition "Pictorial or three-dimensional representations in any medium of an event or story, including historical and fictional events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "histories"@en .

aat:300386046 a skos:Concept ;
    skos:definition "Established systems of spoken or written communication, distinct from other such systems and used by a particular nation, culture, people, or community, typically consisting of words used within a regular grammatical and syntactic structure. The concept may include established sign languages as well. For the general concept of verbal or non-verbal communication, use \"language (general communication).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "languages"@en .

aat:300386048 a skos:Concept ;
    skos:definition "Korean writing system and alphabet, comprising 24 consonant and vowel letters. Consists of characters composed in part of smaller elements representing phonetic features such as place of articulation, which are combined into larger units representing syllables. Traditionally ascribed to King Sejong (ruled 1419-1450)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hangul"@en .

aat:300386050 a skos:Concept ;
    skos:definition "A long single-edged Japanese sword traditionally worn by the samurai class of feudal Japan, commonly referred to as a \"samurai sword.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "katana"@en .

aat:300386051 a skos:Concept ;
    skos:definition "Frameworks used to assist mobility for the disabled or infirm, or designed to support babies learning to walk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walkers"@en .

aat:300386052 a skos:Concept ;
    skos:definition "Panels equipped with solar cells, designed to absorb the sun's rays for the express purpose of generating electricity. For devices used to harness the sun's rays for the express purpose of generating electriciry, use \"solar panels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar panels"@en .

aat:300386053 a skos:Concept ;
    skos:definition "Computer drawings, digital artwork, animation, videos, films, html pages, or projects in other media that have gone through a production process and have then been formatted in a way suitable for viewing by a user. The term is used in reference to architectural projects, and to other projects as well. May also be used to refer to projects that are highly finished and ready for viewing, even if done by hand rather than with a computer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rendered projects"@en .

aat:300386054 a skos:Concept ;
    skos:definition "Style of painting that flourished in Italy and northern Europe for three decades after the death of Michelangelo Caravaggio (1571-1610). The style was strongly influenced by Caravaggio’s use of everyday, common or lower class scenes and figures; the style employed the lighting effects of tenebrism (figures and objects in a dark background, with some details picked out as strongly lit from a single light source)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caravaggism"@en .

aat:300386055 a skos:Concept ;
    skos:definition "An gnawing or painful sensation caused by a lack of food, as well as the chronic exhaustion caused by continuous starvation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunger"@en .

aat:300386058 a skos:Concept ;
    skos:definition "Species of small evergreen tree or shrub, cultivated in Mediterranean countries and the West Indies for its fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus medica"@en .

aat:300386060 a skos:Concept ;
    skos:definition "People that are born with both male and female sex organs. Historically the term 'hermaphrodite' has been used in this context, but now prefer 'intersex people'. Reserve use of the term 'hermaphrodite' for the context of organisms that can produce both gametes associated with male and female sexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intersex people"@en .

aat:300386062 a skos:Concept ;
    skos:definition "Extramarital sexual relations between a married person and another partner, in many cultures considered objectionable on social, religious, moral, or legal grounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adultery"@en .

aat:300386065 a skos:Concept ;
    skos:definition "Masked, comic actors referred to as \"gossips\" in farces adopted from Greek Middle Comedy plays and especially popular in southern Italy in the 4th and 3rd centuries BCE. Known principally from vase paintings, these are grotesque figures meant to satirize aspects of everyday life, or as burlesques of mythology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phlyakes"@en .

aat:300386067 a skos:Concept ;
    skos:definition "Mythical Biblical creatures having six wings, hands and feet, and a human voice, derived from Isaiah's vision as hovering above the throne of God."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seraphim"@en .

aat:300386068 a skos:Concept ;
    skos:definition "Gaps in a fortification made by battering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breaches"@en .

aat:300386070 a skos:Concept ;
    skos:definition "The experience of a series of eidetic images, ideas, and emotions occurring during sleep."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dreaming"@en .

aat:300386071 a skos:Concept ;
    skos:definition "Persons who resist authority or control, politically or socially, extending to those who reject divine or spiritual authority."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebels"@en .

aat:300386072 a skos:Concept ;
    skos:definition "Various types of rural deities of Roman mythology. In early representations, they appear like men with horns and the tail of a goat; in later representations, they also have goats' legs like the satyrs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fauns"@en .

aat:300386073 a skos:Concept ;
    skos:definition "Players of the lutelike chordophone known as a fiddle, especially those who do so for hire in the context of live entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiddlers"@en .

aat:300386075 a skos:Concept ;
    skos:definition "One of the large divisions of an army; military units in the form of a headquarters and a large body of soldiers commanded by a field-grade officer. The term has been used variously in Western culture for centuries with a variety of shifts in meaning and context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battalions"@en .

aat:300386077 a skos:Concept ;
    skos:definition "Dutch sport played on a course that measures 17.5 metres long and 5 metres wide, marked with looping scoring lines and ornate wooden posts at each end. First played on ice, then on enclosed courses. Players hit a ball over a certain distance, the first to reach their opponent's starting point wins. The sport's popularity has declined since the late 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kolven"@en .

aat:300386079 a skos:Concept ;
    skos:definition "Worship place of the Chinese folk religion Shenism, where people revere ethnic Chinese gods and ancestors. The term is now generally considered pejorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joss houses"@en .

aat:300386081 a skos:Concept ;
    skos:definition "Human behavior as an external manifestation of displeasure or sorrow, displayed as a sobbing sound usually accompanied by tears. Animal's ability to make a particular cry specific to their species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crying"@en .

aat:300386082 a skos:Concept ;
    skos:definition "The act of remaining stationary in expectation of some expected event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waiting"@en .

aat:300386083 a skos:Concept ;
    skos:definition "Material comprising the aromatic leaves of several species of trees in the families Lauraceae or Myrtaceae, used for many purposes by humans. Fillets and other head gear made of bay leaves were used in antiquity and other contexts to indicate honor or status. Bay leaves are used as seasoning in cooking. Bay leaves are used in entomology as the active ingredient in killing jars, where vapors kill insects prior to mounting. Bay leaves are also used in cabinets and other contexts to discourage the growth of molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bay leaf"@en .

aat:300386084 a skos:Concept ;
    skos:definition "Buildings housing businesses that specialize in objects of art or bric-à-brac, valued as curiosities or for their rarity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "curio shops"@en .

aat:300386085 a skos:Concept ;
    skos:definition "Motifs comprising a semicircle, suggesting a half moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half moons"@en .

aat:300386087 a skos:Concept ;
    skos:definition "Species of perennial herbaceous plant native to Europe and Asia. Traditionally used as a cough suppressant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tussilago farfara"@en .

aat:300386089 a skos:Concept ;
    skos:definition "The radiance of the Earth's moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moonlight"@en .

aat:300386092 a skos:Concept ;
    skos:definition "A type of religious complex that houses Buddhist monks and serves the greater community during festivals and other occasions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kyaungs"@en .

aat:300386094 a skos:Concept ;
    skos:definition "Events, usually competitive, focusing on the act of chasing wild animals for the purpose of catching or killing them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunts"@en .

aat:300386095 a skos:Concept ;
    skos:definition "Marksmen of accurate aim; in naval and military use and also extended to those engaged in sport or exhibition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sharpshooters"@en .

aat:300386096 a skos:Concept ;
    skos:definition "Members of an American, British, Foreign, or other Legion, though in modern times the term refers particularly to members of the French Légion étrangère."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legionnaires"@en .

aat:300386098 a skos:Concept ;
    skos:definition "Mythical race of one-eyed men inhabiting northern Europel they endeavor to wrest gold from the griffins who guard it. They are sometimes depicted on Greek vases, fighting with griffins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arimasps"@en .

aat:300386099 a skos:Concept ;
    skos:definition "Photography that represents humanity in its natural condition, often with the intent of social critique or with the purpose of reforming social ills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social documentary photography"@en .

aat:300386101 a skos:Concept ;
    skos:definition "Boys who sell newspapers in the streets; a newspaper delivery boy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newsboys"@en .

aat:300386103 a skos:Concept ;
    skos:definition "Depictions of people and activity on urban streets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street scenes"@en .

aat:300386105 a skos:Concept ;
    skos:definition "The use of children as a labor force in industry or business. Now widely considered inhumane, it has been rendered illegal in most developed countries, though it was common until the early 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "child labor"@en .

aat:300386106 a skos:Concept ;
    skos:definition "Actions comprising putting to death on the gallows, or otherwise suspending a person from the neck until dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hangings"@en .

aat:300386108 a skos:Concept ;
    skos:definition "The action of asking earnestly; specifically for alms, performed by indigent people or mendicants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "begging"@en .

aat:300386109 a skos:Concept ;
    skos:definition "Genus of freshwater fish; the only living genus in the family Esocidae, which were endemic to North America, Europe, and Eurasia during the Paleogene through present. They are distinguished by an elongate body, small scales, long head, shovellike snout, and large mouth armed with strong teeth. The dorsal and anal fins are far back on the tail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Esox"@en .

aat:300386110 a skos:Concept ;
    skos:definition "Drawing rooms in private houses as distinguished from a 'salon de famille;' designated as a meeting place for guests and found only in houses where the primary drawing room is so large that a more intimate space is required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salons de compagnie"@en .

aat:300386112 a skos:Concept ;
    skos:definition "The regularly repeated, typically elliptical courses of a celestial object, satellite, spacecraft, or other object, around a more massive body to which it is bound by gravity. Examples are the orbits of planets around the sun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orbits"@en .

aat:300386114 a skos:Concept ;
    skos:definition "Parts of a fluid body of air or water moving continuously in a certain direction through a surrounding body of water or air in which there is less movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "currents"@en .

aat:300386116 a skos:Concept ;
    skos:definition "General term for various species in the family Scolopacidae, characterized by having a long straight bill, and by frequenting marshy places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snipes"@en .

aat:300386117 a skos:Concept ;
    skos:definition "Eurasian garden and field bird; it gathers in large flocks in the Autumn for migration to northern Africa and the Middle East. The bird's common name is French, from the Latin \"hortulanus,\" meaning the \"gardener bird.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Emberiza hortulana"@en .

aat:300386119 a skos:Concept ;
    skos:definition "Species of evergreen conifer native to the Pacific coast of North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thuja plicata"@en .

aat:300386120 a skos:Concept ;
    skos:definition "The culture of Canadians of French ancestry, or of early French settlers in Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French-Canadian"@en .

aat:300386121 a skos:Concept ;
    skos:definition "Nationality or culture of the Frisian tribe or the Friesland area along the North Sea, corresponding to the modern northern Netherlands and northwest Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Frisian"@en .

aat:300386122 a skos:Concept ;
    skos:definition "Nationality or culture of people of the Friuli area of northeastern Italy, who speak the Friuli Rhaeto-Romance dialect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Friulian"@en .

aat:300386123 a skos:Concept ;
    skos:definition "Nationality or culture the Gascony historical region in southwestern France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gascon"@en .

aat:300386124 a skos:Concept ;
    skos:definition "Nationality or culture of Genoa, Liguria, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Genoese"@en .

aat:300386125 a skos:Concept ;
    skos:definition "Nationality and culture of Granada, a province of southern Spain and formerly a Moorish kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Granadine"@en .

aat:300386126 a skos:Concept ;
    skos:definition "Nationality and culture of the island or dependent state of Greenland, in the Arctic and Atlantic Oceans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greenlandic"@en .

aat:300386127 a skos:Concept ;
    skos:definition "Nationality and culture of the island of Grenada and surrounding smaller islands, in the southeastern Caribbean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Grenadian"@en .

aat:300386128 a skos:Concept ;
    skos:definition "Nationality or culture of Guadeloupe, a Caribbean island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guadeloupean"@en .

aat:300386129 a skos:Concept ;
    skos:definition "Nationality or culture of Guyana (formerly British Guiana), on the northern coast of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guyanese"@en .

aat:300386130 a skos:Concept ;
    skos:definition "The style or culture of the ancient Hellenes, including the Iron Age Greek culture to the death of Alexander the Great in 323 BCE, in Greece and all its colonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hellenic"@en .

aat:300386131 a skos:Concept ;
    skos:definition "Nationality and culture of the Hamburg, Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hamburger"@en .

aat:300386132 a skos:Concept ;
    skos:definition "Culture of the the Semitic tribe or nation that is, according to tradition, descended from Abraham, Isaac, and Jacob. In modern usage, it refers to the culture of the Israelites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hebrew"@en .

aat:300386134 a skos:Concept ;
    skos:definition "In traditional Indian art and dance a standing pose in which the body has a slight bend in both upper and lower halves, through which a perpendicular axis would pass to the right of the navel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abhanga"@en .

aat:300386135 a skos:Concept ;
    skos:definition "Hand gesture indicating divine protection, approachability, and dispelling of fear. The right hand is represented palm outward, raised to shoulder height, with the fingers upward. The gesture is ancient, probably originally demonstrating that the hand is empty of weapons and indicating peace. In Buddhism it represents the absence of fear of death. In Indian art, a hand gesture of assurance or protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abhayamudrā"@en .

aat:300386137 a skos:Concept ;
    skos:definition "Hollow spaces or features in designs, notably in mandalas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kosthas"@en .

aat:300386138 a skos:Concept ;
    skos:definition "Styles and cultures that developed in Spain and elsewhere under Spanish influence, especially those that developed under the influence of colonists from Spain and their descendants in the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hispanic"@en .

aat:300386139 a skos:Concept ;
    skos:definition "Settlements for the Brahman priestly class where they were encouraged to devote themselves to the study of the Vedas and the subsidiary studies associated with them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agraharas"@en .

aat:300386140 a skos:Concept ;
    skos:definition "Nationality, style, or culture of the general region of Hesse or Hessia in north central Germany, or of the modern German state of Hesse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hessian"@en .

aat:300386141 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the city and territory of Pisa, central Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pisan"@en .

aat:300386142 a skos:Concept ;
    skos:definition "In traditional Indian art and dance, a squatting or sitting figural pose, often with one leg raised. An example of usage is to represent deities in an angry aspect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ardhaparyanka"@en .

aat:300386143 a skos:Concept ;
    skos:definition "Symbolic gesture of the body, often particularly focused on the hand and fingers, used in in Indian dance, Hindu and Buddhist ritual, ceremonies, and art, and other contexts. Also used in yoga, meditation, and other activities. Types of mudra represent various concepts, such as reassurance or meditation. These symbolic or ritual hand positions have deep roots in Indic religious tradition. Types of mudra in sculpture and other visual arts are relatively restricted in number, given that movement is necessarily not incorporated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mudra"@en .

aat:300386144 a skos:Concept ;
    skos:definition "Military commanders or commanders-in-chief. They may work in the service of a king or emperor, or they may have a regional power base that is ruled independently of the central government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "warlords"@en .

aat:300386145 a skos:Concept ;
    skos:definition "In Indian temple architecture, the main shrines representing the residence or sanctum of the deity, sometimes used to describe the temple as a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deuls"@en .

aat:300386146 a skos:Concept ;
    skos:definition "Weapons comprising thin, razor-edged rings of flat steel; as traditionally used by Sikhs. Primarily used as a throwing weapon, but can also be used hand-to-hand. For symbols of the wheel of the law or the symbol of dharma, see \"chakras (motifs).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cakras"@en .

aat:300386148 a skos:Concept ;
    skos:definition "Nationality and culture of the region between India and China, the areas of the current nations Burma, Kampuchea (Cambodia), Laos, Thailand, Vietnam and Malaysia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indochinese"@en .

aat:300386149 a skos:Concept ;
    skos:definition "Culture of Islam in Iraq, particularly that of the large Sunni Islamist political party in Iraq."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iraqi Islamic"@en .

aat:300386151 a skos:Concept ;
    skos:definition "Door-like niches on the exterior walls of Hindu temples. These contain figural images, usually of deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devakōṣṭhas"@en .

aat:300386152 a skos:Concept ;
    skos:definition "Garments worn as loose skirtlike loincloths, the fabric wound around the waist and passed between the legs and tucked in at the waist from behind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhotīs"@en .

aat:300386154 a skos:Concept ;
    skos:definition "General term referring to a person, people, place, or thing for which the identity has not been established ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unidentified"@en .

aat:300386155 a skos:Concept ;
    skos:definition "General term for people who have an unspecified familial relationship, either by blood or marriage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relatives"@en .

aat:300386158 a skos:Concept ;
    skos:definition "People who act as architects, which are those who design and oversee the building of habitable structures, as a pastime rather than as a profession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amateur architects"@en .

aat:300386166 a skos:Concept ;
    skos:definition "Architects who specialize in the design, renovation, and remodeling of golf courses, which are large outdoor areas where the sport of golf is played, consisting of a teeing ground, fairway, rough, hazards, and a series of greens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf course architects"@en .

aat:300386167 a skos:Concept ;
    skos:definition "Clarified butter used as both a staple food and for religious rites on the Indian subcontinent. Ghee made from cow's milk is used in almost all Hindu ceremonies including birth, initiation rituals, weddings, and gift-giving at death. Images of deities are washed in ghee, and it is used as fuel in holy lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghee"@en .

aat:300386168 a skos:Concept ;
    skos:definition "People or corporate bodies who design the plan and features of gardens, which are open space where flowers, shrubs, trees, vegetables, or fruits are grown. Garden designers may be amateurs or professionals. For those who practice the branch of architecture dealing with the design of the scenic environment, including plants and surrounding roads and structures, use \"landscape architects.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden designers"@en .

aat:300386170 a skos:Concept ;
    skos:definition "People or groups of people who own and oversee the high-level operation of plantations, which are agricultural complexes usually worked by resident labor, often reserved for those in tropical or sub-tropical locations. The term often has negative connotations in modern usage, because many plantations relied upon the labor of enslaved people in the 17th through 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plantation owners"@en .

aat:300386171 a skos:Concept ;
    skos:definition "Firms who practice the branch of architecture that deals with the design of the scenic environment, including the development and planting of all types of planned outdoor green spaces, often with accompanying structures and roadways, outdoor public areas, landmarks, and structures with the aim of creating a natural setting for human structures and settlements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landscape architecture firms"@en .

aat:300386173 a skos:Concept ;
    skos:definition "Foresters specializing in silviculture, which is the cultivation and study of forest trees, especially those raised for timber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silviculturists"@en .

aat:300386174 a skos:Concept ;
    skos:definition "People who design, make, form, set up, or bring into existence an art work or other thing or activity, particularly where the creation is imaginative or inventive. For makers who execute the designs of other people, use the more general \"makers\" or the specific \"executors (makers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creators"@en .

aat:300386175 a skos:Concept ;
    skos:definition "Crowning, altar-like superstructures railing the summit of a stupa's cupola, and enclosing the pole representing the world axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmikās"@en .

aat:300386176 a skos:Concept ;
    skos:definition "Successions of rulers from the same family, line, stock, or group, during a particular period of time; extended to include all the people and culture surrounding this succession of rulers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynasties"@en .

aat:300386177 a skos:Concept ;
    skos:definition "In the context of archival description, the original person, people, deparment, or other corporate body who created or assembled the group, collection, or other arrangement of records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "originators"@en .

aat:300386178 a skos:Concept ;
    skos:definition "People who who act as subordinates to an artist or otherwise in a subordinate capacity during the creation of art or architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assistant artists"@en .

aat:300386179 a skos:Concept ;
    skos:definition "People who create the visual arts, such as painting, sculpture, graphic arts, or others, as a pastime rather than as a profession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amateur artists"@en .

aat:300386180 a skos:Concept ;
    skos:definition "Artists, often but not always portrait painters, who have no permanent studio but instead journey across a region to create works in various centers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "itinerant artists"@en .

aat:300386181 a skos:Concept ;
    skos:definition "Artists who specialize in the marketing of products and other sales, including typography, advertising, packages, television commercials, mailings, and other visual materials having to do primarily or exclusively with sales, including design for the Internet and social media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising artists"@en .

aat:300386182 a skos:Concept ;
    skos:definition "Artists who create mail art, which is usually in post card format, typically intended to be mailed to other artists and then shared or displayed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mail artists"@en .

aat:300386183 a skos:Concept ;
    skos:definition "Artists who specialize in creating any in a range of artistic works that use digital technology as an essential part of the creative or presentation process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital artists"@en .

aat:300386184 a skos:Concept ;
    skos:definition "People who create works using primarily paper, which is thin matted or felted sheets or webs of fiber, as both the support (if any) and the media. For people who make paper, use \"papermakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper artists"@en .

aat:300386185 a skos:Concept ;
    skos:definition "Artists who specialize in the creation of fraktur, an art form characterized by a particular style of calligraphy and illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraktur artists"@en .

aat:300386186 a skos:Concept ;
    skos:definition "Artists of any medium who specialize in depicting the human body and figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figure artists"@en .

aat:300386187 a skos:Concept ;
    skos:definition "Components of Buddhist stupa architecture that surmount the dome and represent the world axis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yaṣṭis"@en .

aat:300386188 a skos:Concept ;
    skos:definition "Artists in any medium whose primary subjects are battles and war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battle artists"@en .

aat:300386189 a skos:Concept ;
    skos:definition "Artists who create decorative arts, which are primarily utilitarian in form or function, but that have aesthetic value provided by the design, decoration, or embellishment, including ceramics, furniture, textiles, and other household or utilitarian objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decorative artists"@en .

aat:300386190 a skos:Concept ;
    skos:definition "Artists who specialize in creating silhouettes, which are portraits or other shapes cut from paper and mounted on a contrasting background. The art form was particularly popular in Europe and the United States during the 18th and 19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silhouette artists"@en .

aat:300386191 a skos:Concept ;
    skos:definition "Artists whose primary creations are painting, sculpture, or graphic art with subject matter that does not include forms that represent objects from the visible world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abstract artists"@en .

aat:300386192 a skos:Concept ;
    skos:definition "Artists, particularly those who flourished in the 1960s-1970s and later revivals, who are often also conceptual artists or performance artists, who employ their own bodies as the medium of expression."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body artists"@en .

aat:300386193 a skos:Concept ;
    skos:definition "Style, culture, or ethnicity of American people of Japanese heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese-American"@en .

aat:300386195 a skos:Concept ;
    skos:definition "General term referring to the culture surrounding the rule of any of the eight kings of Cambodia called Jayavarman."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jayavarman"@en .

aat:300386196 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the the Kazak ethnic group of Kazakhstan, China, Mongolia, and Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kazak"@en .

aat:300386197 a skos:Concept ;
    skos:definition "of the West Indies islands or nation of Saint Kitts and Nevis"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kittian Nevisian"@en .

aat:300386198 a skos:Concept ;
    skos:definition "Nationality and culture of the island of St. Kitts, West Indies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kittian"@en .

aat:300386200 a skos:Concept ;
    skos:definition "People whose employment is staining, particularly those who color wood or other building or furniture materials with pigments that penetrate below the surface. Stainers belonged to special guilds in Europe from the Middle Ages onward. For those who apply pigment to cloth, use \"dyers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stainers"@en .

aat:300386201 a skos:Concept ;
    skos:definition "Artists who specialize in painting altarpieces, which are objects in a Christian church, usually framed and either set on the rear part of the altar or hung on the wall behind the altar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altarpiece painters"@en .

aat:300386202 a skos:Concept ;
    skos:definition "Artists who specialize in painting frescoes, which are made with permanent pigments, dispersed in water, then painted on freshly laid lime plaster"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fresco painters"@en .

aat:300386203 a skos:Concept ;
    skos:definition "Artists who specialize in painting ceilings; usage is restricted to those who paint scenes or illusionistic devices on ceilings of grand buildings, not including house painters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceiling painters"@en .

aat:300386204 a skos:Concept ;
    skos:definition "People whose occupation is to make wagons, which are heavily constructed four-wheeled vehicles designed to carry bulk commodities and heavy loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wagon makers"@en .

aat:300386205 a skos:Concept ;
    skos:definition "People who work in the arts, a handicraft, or a skilled trade, particularly when utilizing traditional or non-mechanized methods. Typically not applied to makers of fine arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artisans"@en .

aat:300386206 a skos:Concept ;
    skos:definition "People who specialize in decorating pottery, which are objects made of various hard, brittle, heat-resistant, and corrosion-resistant materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery painters"@en .

aat:300386207 a skos:Concept ;
    skos:definition "Artists who specialize in creating batik, a type of resist dyeing of textiles in which wax is used as the resist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batik artists"@en .

aat:300386208 a skos:Concept ;
    skos:definition "Artists in any medium who specialize in depicting animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal artists"@en .

aat:300386209 a skos:Concept ;
    skos:definition "People or corporate bodies that make coaches, which are carriages, usually drawn by draft animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coach makers"@en .

aat:300386210 a skos:Concept ;
    skos:definition "Artists in any media who focus primarily on subject matter having to do with sports and sports players."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sports artists"@en .

aat:300386211 a skos:Concept ;
    skos:definition "Refers to people or corporate bodies who own or run manufacturing plants for making automobiles, which are self-propelled vehicles designed primarily to transport passengers over ordinary roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automobile manufacturers"@en .

aat:300386212 a skos:Concept ;
    skos:definition "Artists in any medium whose primary subject matter is architecture, including buildings, gardens, or other aspects of the built environment. The term may be used to distinguish those who design architecture as art, rather than designing only constructions having purely a functional purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural artists"@en .

aat:300386213 a skos:Concept ;
    skos:definition "Artists in any medium whose works contain as subject matter primarily cityscapes or townscapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cityscape artists"@en .

aat:300386214 a skos:Concept ;
    skos:definition "Artists in any media whose primary focus in subject matter is mythology and mythological characters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mythological artists"@en .

aat:300386215 a skos:Concept ;
    skos:definition "Artists in any media who specialize in scenes depicting historical events.Lake: Adrienne Martyn : Waikato Museum of Art and History Artist in Residence. Adrienne Martyn, John Hurrell, Waikato Museum of Art and History, 2001 - Taupo, Lake (N.Z.) Waikato Museum of Art and History - 2001"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "history artists"@en .

aat:300386216 a skos:Concept ;
    skos:definition "Artists in any media who specialize in depictions of ships, shipbuilding, or harbors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine artists"@en .

aat:300386217 a skos:Concept ;
    skos:definition "Artists in any media who specialize in depicting scenes or events from everyday life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "genre artists"@en .

aat:300386218 a skos:Concept ;
    skos:definition "Artists in any medium whose primary subject matter is still life, which depicts inanimate objects such as bowls of fruit, bottles, and flowers, which are often arranged in an aesthetic composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "still life artists"@en .

aat:300386220 a skos:Concept ;
    skos:definition "Artists in any media who focus primarily on religious objects and subjects in their works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious artists"@en .

aat:300386221 a skos:Concept ;
    skos:definition "People who design representations that symbolize and suggest other objects or ideas, particularly popular as an occupation and hobby in Europe from the 15th through 17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emblem makers"@en .

aat:300386222 a skos:Concept ;
    skos:definition "People or corporate bodies who design and construct stained glass works, which are windows or other objects made of glass colored by adding metallic oxides to the molten glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stained glass artists"@en .

aat:300386223 a skos:Concept ;
    skos:definition "People or corporate bodies who design glassware or other objects to be executed in glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass designers"@en .

aat:300386224 a skos:Concept ;
    skos:definition "People whose profession is to collect, write, edit, or deliver the subject matter of televised news."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "television journalists"@en .

aat:300386225 a skos:Concept ;
    skos:definition "Craftsmen who specialize in staining glass, which is coloring glass by adding metallic oxides to the molten glass. To distinguish those who design and create the stained glass windows or other works, use \"stained glass artists.\" For those who paint details on stained glass or othewise paint on glass, use \"glass painters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass stainers"@en .

aat:300386226 a skos:Concept ;
    skos:definition "Craftsmen who carve, engrave, or cut designs into glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass carvers"@en .

aat:300386228 a skos:Concept ;
    skos:definition "Experts in orthography, which is the art of correct or proper spelling according to standard accepted usage or convention."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthographers"@en .

aat:300386229 a skos:Concept ;
    skos:definition "Painters who worked in the medium of oil paint, which is pigment held in a drying oil such as linseed oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil painters"@en .

aat:300386230 a skos:Concept ;
    skos:definition "Painters whose primary medium is tempera, which is paint formed of an emulsion of egg or another fatty material and water, usually on wooden panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tempera painters"@en .

aat:300386231 a skos:Concept ;
    skos:definition "Artists who specialize in creating paintings on a wooden support, including altarpieces, portraits, and other art works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel painters"@en .

aat:300386232 a skos:Concept ;
    skos:definition "Artists or craftsmen who use papier mâché, which is a composite material made of repulped or pulverized paper and a liquid adhesive binder, as their primary material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papier-mâché artists"@en .

aat:300386233 a skos:Concept ;
    skos:definition "Artists who specialize in assemblages, which are three-dimensional works of art created by combining found objects and other elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assemblage artists"@en .

aat:300386234 a skos:Concept ;
    skos:definition "Artists who create photomontages, which are combinations of photographic images, or of photographic and other images such as architectural drawings, usually arranged into a somewhat unified image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomontagists"@en .

aat:300386235 a skos:Concept ;
    skos:definition "People who produce work in the visual arts using mixed media, which is any combination of a variety of materials plus the associated techniques, used in the making of a single work of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed-media artists"@en .

aat:300386236 a skos:Concept ;
    skos:definition "People who make contemporary works of art that employ several distinct art forms, such as sculpture and music or painting and light art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multimedia artists"@en .

aat:300386237 a skos:Concept ;
    skos:definition "People who assemble, revise, correct, or arrange the contents of motion pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film editors"@en .

aat:300386239 a skos:Concept ;
    skos:definition "Artists who specialize in creating art on billboards, which are large flat surfaces typically designed for advertisements and displayed in public areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billboard artists"@en .

aat:300386240 a skos:Concept ;
    skos:definition "People or corporate body who specialize in making posters, which are decorative or pictorial notices of a medium to large size, intended to be posted to advertise, promote, or publicize."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "poster artists"@en .

aat:300386242 a skos:Concept ;
    skos:definition "People who specialize in creating photographs that depict current fashions, usually for advertising or commercial use and often published in fashion magazines or journals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fashion photographers"@en .

aat:300386243 a skos:Concept ;
    skos:definition "Photographers who primarily use digital cameras, which are cameras that acquire images via an electronic sensor and storing them as digital information on a memory device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital photographers"@en .

aat:300386244 a skos:Concept ;
    skos:definition "Famous, well-known, or celebrated people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celebrities"@en .

aat:300386245 a skos:Concept ;
    skos:definition "Experts or skilled technicians in the manufacture or use of fireworks. May also refer to those skilled in the use of gunpowder or explosives for military purposes or for display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrotechnicians"@en .

aat:300386246 a skos:Concept ;
    skos:definition "Professional or paid drivers of motor vehicles such as automobiles or limousines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chauffeurs"@en .

aat:300386247 a skos:Concept ;
    skos:definition "People who write or give orally critical reviews of motion pictures and the art of filmmaking for broadcast or publication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film critics"@en .

aat:300386248 a skos:Concept ;
    skos:definition "People who report on, write about, analyze, or evaluate music, which is the art concerned with the combining of vocal or instrumental sounds in measured time to communicate emotions, ideas, or states of mind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music critics"@en .

aat:300386249 a skos:Concept ;
    skos:definition "People skilled in the practice of exegesis, which is exposition or explanation, especially with regard to the critical interpretation of a portion of Scripture or other text."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exegetes"@en .

aat:300386251 a skos:Concept ;
    skos:definition "Those who write, invent, promote, investigate or propound a theory or theories about music, which is the art concerned with the combining of vocal or instrumental sounds in measured time to communicate emotions, ideas, or states of mind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music theorists"@en .

aat:300386252 a skos:Concept ;
    skos:definition "People of superior intellect, particularly those who pursue academic or cultural interests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intellectuals"@en .

aat:300386253 a skos:Concept ;
    skos:definition "People or corporate bodies that represent artists and engage in the buying and selling of works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art dealers"@en .

aat:300386255 a skos:Concept ;
    skos:definition "People who study or practice art therapy, which is the therapeutic use of images and objects to foster nonverbal communication, creativity, and physical interaction, and to uncover verbal associations and interpretations helping to identify and understand patients' emotional, motor, and perceptual dysfunctions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art therapists"@en .

aat:300386256 a skos:Concept ;
    skos:definition "Rooms, buildings, or groups of buildings specifically equipped with apparatus for scientific experiments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "science laboratories"@en .

aat:300386257 a skos:Concept ;
    skos:definition "Advocates for or experts in architectural conservation, which is the practice of preserving the integrity of built objects, directed toward the long-term safekeeping of architectural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural conservationists"@en .

aat:300386258 a skos:Concept ;
    skos:definition "People who are specialists in microscopy, which is the use of or investigation with a microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microposcopists"@en .

aat:300386259 a skos:Concept ;
    skos:definition "Specialists or experts in astrophysics, which is the study of astronomical phenomena in terms of the underlying physical processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astrophysicists"@en .

aat:300386260 a skos:Concept ;
    skos:definition "People, usually women, trained to assist women in childbirth. Midwives may also be qualified to give prenatal and postnatal care."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "midwives"@en .

aat:300386261 a skos:Concept ;
    skos:definition "Students, specialists, or experts in mycology, which is a branch of biology devoted to the study of fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mycologists"@en .

aat:300386262 a skos:Concept ;
    skos:definition "Specialists or experts in genetics, which is a biological science that deals with the phenomena of heredity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geneticists"@en .

aat:300386263 a skos:Concept ;
    skos:definition "Students, specialists, or advocates of eugenics, which is a science that deals with improving the hereditary qualities of the human population, especially through social control of human mating and reproduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eugenists"@en .

aat:300386264 a skos:Concept ;
    skos:definition "Experts in criminology, which is a branch of sociology devoted to the scientific study of offenders, of crime as a social phenomenon, and of the criminal justice system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "criminologists"@en .

aat:300386265 a skos:Concept ;
    skos:definition "People who study or practice hypnotism, which is the science of inducing an artifically induced trance-like state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypnotists"@en .

aat:300386266 a skos:Concept ;
    skos:definition "People who act as presiding officers of organizations, boards, committees, or events. May also refer to the administrative heads of academic departments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chairpersons"@en .

aat:300386267 a skos:Concept ;
    skos:definition "Refers to the official heads of museums, which are institutions that maintain places where objects of value such as works of art, antiquities, scientific specimens, or other artifacts are housed and displayed for public benefit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museum directors"@en .

aat:300386268 a skos:Concept ;
    skos:definition "People who manage and oversee the operations of a manufactory, which is an operation that makes articles primarily by hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manufactory directors"@en .

aat:300386269 a skos:Concept ;
    skos:definition "Female leaders or wives of doges, who were rulers and chief magistrates of the former republics of Venice and Genoa, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dogaressas"@en .

aat:300386270 a skos:Concept ;
    skos:definition "General term referring to people who are qualified to participate and have registered to vote in an election. For the individual people who cast votes in an election, prefer \"voters,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electors"@en .

aat:300386271 a skos:Concept ;
    skos:definition "Partners in wedded or parental relations, most often applicable when the person holds certain titles, such as Queen-Consort, the wife of a king, or King-Consort, Prince-Consort, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consorts"@en .

aat:300386272 a skos:Concept ;
    skos:definition "Citizens or inhabitants of boroughs or towns, particularly those belonging to the middle class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burghers"@en .

aat:300386273 a skos:Concept ;
    skos:definition "Business partnerships of two or more persons working under a common name in the area of design, which is the discipline comprising the creation of conceptual schemes for the organization or appearance of graphic works, objects, structures, or systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "design firms"@en .

aat:300386275 a skos:Concept ;
    skos:definition "People who create conceptual schemes for the organization or appearance of lighting for theater, television, or film productions using color, form, surface, and space to create a visual language capable of communicating ideas relevant to the production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lighting designers"@en .

aat:300386276 a skos:Concept ;
    skos:definition "Businesses in the construction industry that undertake work as detailed in a legally binding contractual agreement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contracting firms"@en .

aat:300386277 a skos:Concept ;
    skos:definition "People or corporate body who make products that are intended to be assembled or compiled as part of a larger product."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "part makers"@en .

aat:300386278 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in making scientific instruments, which are crafted instruments used for scientific purposes and research, in all branches of science."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific instrument makers"@en .

aat:300386279 a skos:Concept ;
    skos:definition "People who make barometers, which are instruments for measuring atmospheric pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barometer makers"@en .

aat:300386280 a skos:Concept ;
    skos:definition "Members of a monastery or friary who devote themselves only to manual labor and other secular affairs, remaining exempt from the studies and choir duties required of the other members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lay brothers"@en .

aat:300386281 a skos:Concept ;
    skos:definition "Clerics who observe a simple rule embodying the common duties of and afford mutual assistance to their ministry, but who make no profession and follow no religious rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secular priests"@en .

aat:300386282 a skos:Concept ;
    skos:definition "Adherents of or experts in occultism, which is the belief in or study of hidden, mysterious, or supernatural powers, as manifested in all fields of human endeavor or creativity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occultists"@en .

aat:300386283 a skos:Concept ;
    skos:definition "Those who take the lead or guide the actions and opinions of followers of religions, which are belief systems that encompass various personal and institutional relationships between human beings and what they regard as holy, sacred, or divine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious leaders"@en .

aat:300386284 a skos:Concept ;
    skos:definition "People who specialize in making tiles, which are small, flat objects, often rectangular and decorated, used to cover roofs, floors, or other surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile makers"@en .

aat:300386285 a skos:Concept ;
    skos:definition "Heads of monasteries or convents in the Eastern church; comparable to abbots in the Western church. Occasionally used to refer to superiors of groups of monasteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archimandrites"@en .

aat:300386286 a skos:Concept ;
    skos:definition "People who specialize in making puppets, which are representations of figures that are designed to be animated by human effort, including the use of strings, wires, sticks, or directly by the hand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puppet makers"@en .

aat:300386287 a skos:Concept ;
    skos:definition "People or corporate bodies who make dollhouses, which are miniature scale houses or sets of rooms and furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dollhouse makers"@en .

aat:300386288 a skos:Concept ;
    skos:definition "People who make music boxes, which are mechanical musical instruments that incorporate tuned steel prongs and moving parts driven by a clockwork mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "music box makers"@en .

aat:300386289 a skos:Concept ;
    skos:definition "People or corporate bodies who make furniture, which includes movable or fixed objects or equipment for sitting, reclining, storage, etc. in a dwelling, business, or public space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture makers"@en .

aat:300386291 a skos:Concept ;
    skos:definition "Manufactories that specialize in making furniture, which includes movable or fixed objects, such as chairs, tables, chests, beds, etc., for use in a dwelling, business, or public space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture manufactories"@en .

aat:300386292 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in designing furniture, which includes movable or fixed objects or equipment for sitting, reclining, storage, etc. in a dwelling, business, or public space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "furniture designers"@en .

aat:300386293 a skos:Concept ;
    skos:definition "People who have forsaken or renounced religious beliefs, moral allegiances, parties, or causes to which they once subscribed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apostates"@en .

aat:300386294 a skos:Concept ;
    skos:definition "People or corporate bodies that make and/or decorate frames, which are cases or structures that surround or enclose such items as works of art, mirrors, or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "framemakers"@en .

aat:300386295 a skos:Concept ;
    skos:definition "Inhabitants of cities or towns, particularly those who are entitled to civic rights and privileges. Also, native or naturalized members of a nation or state who owe allegiance to the government are entitled to its protection in return."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citizens"@en .

aat:300386296 a skos:Concept ;
    skos:definition "People who are famous or had significant roles in history; also, those who are not necessarily famous, but whose existence is recorded, as distinguished from those who are fictional or legendary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical figures"@en .

aat:300386298 a skos:Concept ;
    skos:definition "People who make wooden panels to be used for panel paintings. For example, in Europe, In the Middle Ages and beyond, the panel maker was a skilled craftsman who belonged to guilds and signed his work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel makers"@en .

aat:300386299 a skos:Concept ;
    skos:definition "People who specialize in creating engraved designs for coins. Historically, coin engravers were guild members who created coins in mints. The coin engraver creates dies for coins that incorporate engraving on the face of the die, distinguished from dies created from punches that displace the metal of the die instead of removing it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coin engravers"@en .

aat:300386300 a skos:Concept ;
    skos:definition "Usually refers to the wives of presidents of the United States. May also refer to women chosen by presidents to act as hostesses at the White House or to the wives of the heads of any country or jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first ladies"@en .

aat:300386301 a skos:Concept ;
    skos:definition "Architects who were official members of and worked for a noble court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court architects"@en .

aat:300386302 a skos:Concept ;
    skos:definition "Artists in any media who were official members of and worked for a noble court."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "court artists"@en .

aat:300386303 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in making sound-producing apparatuses with the primary function of playing music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "musical instrument makers"@en .

aat:300386304 a skos:Concept ;
    skos:definition "People or corporate bodies who make harpsichord, which are zitherlike chordophones having a keyboard which operates a plucking mechanism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harpsichord makers"@en .

aat:300386305 a skos:Concept ;
    skos:definition "Artists who who perform official artistic duties as a representative of a family, government, organization, or other entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "official artists"@en .

aat:300386308 a skos:Concept ;
    skos:definition "Manufactories that specialize in creating articles made of ceramic, which is a hard, brittle, heat-resistant and corrosion-resistant material, including earthenware, porcelain, and brick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramics manufactories"@en .

aat:300386310 a skos:Concept ;
    skos:definition "People who specialize in decorating works made of porcelain, which is an impermeable translucent ceramic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain painters"@en .

aat:300386311 a skos:Concept ;
    skos:definition "People or corporate bodies who make or decorate visual works made of porcelain, which is an impermeable translucent ceramic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain makers"@en .

aat:300386313 a skos:Concept ;
    skos:definition "Commissioned military officers ranking above brigadier generals and below lieutenant generals. Major generals command military units called divisions, which are made up of 7,000-22,000 troops, and their insignia are two stars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "major generals"@en .

aat:300386315 a skos:Concept ;
    skos:definition "People belonging to a militia, which is an organized body of part-time, volunteer citizen soldiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "militiamen"@en .

aat:300386316 a skos:Concept ;
    skos:definition "Pilots of heavier-than-air aircraft, especially airplanes, which are fixed-wing aircraft designed to lift and transport people and cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aviators"@en .

aat:300386317 a skos:Concept ;
    skos:definition "People who commit murder, especially those who murder prominent people either for hire or for fanatical reasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assassins"@en .

aat:300386318 a skos:Concept ;
    skos:definition "People who keep record of scores, particularly those who act as officials in games or sports contests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "score keepers"@en .

aat:300386319 a skos:Concept ;
    skos:definition "People who practice bodybuilding, which is the process of developing the muscles and physique of the human body through exercise and diet, sometimes for competitive exhibition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodybuilders"@en .

aat:300386320 a skos:Concept ;
    skos:definition "Artists or craftsmen who specialize in pietra dura works, which are inlaid works in which pieces of hard, polished stone have been set into marble or another hard surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietra dura artists"@en .

aat:300386321 a skos:Concept ;
    skos:definition "Women who cohabit with a man without being his wife. The term today has a negative connotation, and is generally only used in the context of certain historical periods, particularly in Asia or ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concubines"@en .

aat:300386322 a skos:Concept ;
    skos:definition "Artists who specialize in intarsia, which is art comprising designs or patterns assembled from small pieces of veneer in various shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intarsia artists"@en .

aat:300386323 a skos:Concept ;
    skos:definition "Assistants at Mass or other liturgy who arrange the altar, assist the celebrant, and make the responses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "servers"@en .

aat:300386324 a skos:Concept ;
    skos:definition "People who make lacquerware, which are objects, usually made of thin wood, that are coated and decorated with layers of lacquer, a particular paint or varnish that dries with a high gloss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacquer artists"@en .

aat:300386325 a skos:Concept ;
    skos:definition "Groups comprising a master metalworker and his or her assistants, who specialize in shaping things out of metal or of decorating with metal. For structures that contain industrial metalworking operations, use \"metalworking plants.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metalworking studios"@en .

aat:300386327 a skos:Concept ;
    skos:definition "Those who make dies, which are stamps used for impressing a design upon a softer material. Die making may involve forging and engraving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "die makers"@en .

aat:300386328 a skos:Concept ;
    skos:definition "People or corporate bodies that produce artillery, which are firearms generally having a bore of over one inch in diameter, designed to be supported on a gun mount or carriage when operated, and requiring a crew of at least two people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artillery makers"@en .

aat:300386329 a skos:Concept ;
    skos:definition "People or corporate bodies who make weapons, which are implements or mechanisms used for defense or attack in combat, hunting, or war."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weapons makers"@en .

aat:300386330 a skos:Concept ;
    skos:definition "Painters and other artists who make signs, which are lettered notices or other displays that bear names, directions, warnings, advertisements, or symbols that are displayed or posted for public view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sign painters"@en .

aat:300386331 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in making or finishing works or architectural elements with plaster, which is a soft, plastic material mixture of water, lime, and sand, often combined with other materials, such as animal hair. For workman who apply plaster but not for artistic effect, use \"plasterers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plasterwork artists"@en .

aat:300386332 a skos:Concept ;
    skos:definition "People who specialize in creating pargeting, which is ornamental relief plasterwork stamped or carved between the studwork on the outside of half-timber houses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pargeters"@en .

aat:300386333 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in creating works from textile materials, which are plant, animal, and synthetic fibers used in weaving, sewing, knitting, felting, knotting, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile artists"@en .

aat:300386334 a skos:Concept ;
    skos:definition "Studios in which one or more master textile artist creates works, supervises assistants, and instructs pupils in creating textiles or works made of textiles, which are works that use plant, animal, or synthetic fibers to construct practical or decorative items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile studios"@en .

aat:300386335 a skos:Concept ;
    skos:definition "People and corporate bodies who specialize in the design of textiles, which are materials produced by weaving, felting, knotting, twining, or otherwise processing natural or synthetic fibers. Included may be those who create designs for finished textile art works, or designs for the textile materials, such as patterns to be printed on fabrics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile designers"@en .

aat:300386336 a skos:Concept ;
    skos:definition "People skilled in the practice of taxidermy, which is the preparation of lifelike representations of animals by stuffing the skin or molding it around a model of the specimen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taxidermists"@en .

aat:300386337 a skos:Concept ;
    skos:definition "Refers to people or corporate bodies who own or run manufacturing plants for making clothing, which is covering for the torso, limbs, hands, feet, and head for warmth, fashion, or to cover nudity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothing manufacturers"@en .

aat:300386338 a skos:Concept ;
    skos:definition "People who are employed to arrange, dress, or cut hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairdressers"@en .

aat:300386339 a skos:Concept ;
    skos:definition "People who create, decorate, or paint designs or scenes on fans, which are hand-held implements used to produce a current of air or that serve as purely decorative accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan makers"@en .

aat:300386340 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in making lamps, which are lighting devices of relatively small size and used in households or public buildings. Examples include those having a vessel to contain fuel used as a source of illumination, or those using a candle, oil, gas-jet, or incandescent wire inside a light bulb, often having a decorative shade to shield users from direct light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lamp makers"@en .

aat:300386341 a skos:Concept ;
    skos:definition "People who make candles, which are cylindrical objects composed of tallow or wax containing a wick that is set afire to create illumination."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chandlers"@en .

aat:300386342 a skos:Concept ;
    skos:definition "Enterprises that specialize in making tapestries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry manufactories"@en .

aat:300386343 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in designing tapestries, which are heavy, woven textiles incorporating a design or scene, and used as wall hangings, curtains, upholstery, or for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tapestry designers"@en .

aat:300386344 a skos:Concept ;
    skos:definition "People or corporate bodies engaged in the making of rugs and carpets, which are textiles having the primary purpose of covering a flat surface, usually a floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpet makers"@en .

aat:300386345 a skos:Concept ;
    skos:definition "People who specialize in making sundials, which are instruments that indicate approximate time of day from a shadow cast in sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sundial makers"@en .

aat:300386346 a skos:Concept ;
    skos:definition "Artists who specialize in bookworks, which are art works that exploit the book form or alter its physical structure as part of the content of the work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "book artists"@en .

aat:300386347 a skos:Concept ;
    skos:definition "Business enterprises centered on the printing press, having the main objective of printing books, journals, art prints, or other works. For enterprises having the primary objective of making printed products available to the public, but who may also print these products, use \"publishing houses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing firms"@en .

aat:300386348 a skos:Concept ;
    skos:definition "Professionals who apply the principles of engineering to the planning, design, and construction of buildings and other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural engineers"@en .

aat:300386349 a skos:Concept ;
    skos:definition "People trained in the branch of engineering focused on demolition, which is the act of destroying buildings or other structures"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demolition engineers"@en .

aat:300386350 a skos:Concept ;
    skos:definition "People training or working in the planning field having to do with the establishment of objectives, procedures, and resources for architectural projects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "architectural planners"@en .

aat:300386351 a skos:Concept ;
    skos:definition "Businesses that specialize in urban planning, which concerms the designing and improving the spacial organization and content of urban areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban planning firms"@en .

aat:300386352 a skos:Concept ;
    skos:definition "Business partnerships of two or more persons working under a common name in the area of construction, which is the process of creating something by combining parts or elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction firms"@en .

aat:300386353 a skos:Concept ;
    skos:definition "People who are notably skilled in the art of building, particularly those who have achieved proficiency in one of the building arts and are licensed or qualified to supervise construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "master builders"@en .

aat:300386354 a skos:Concept ;
    skos:definition "People or corporations who invest in and accomplish the building of railroads, which are transportation systems comprising tracks upon which trains are run."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad builders"@en .

aat:300386355 a skos:Concept ;
    skos:definition "People or corporate bodies who specialize in designing and constructing staircases and their components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stair builders"@en .

aat:300386356 a skos:Concept ;
    skos:definition "Craftsmen or artists who specialize in carving or cutting figures, designs, or shapes out of stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone carvers"@en .

aat:300386357 a skos:Concept ;
    skos:definition "People or corporate bodies who make windows; often, but not always, refers to makers of stained glass windows. To distinguish makers of stained glass windows, use \"stained glass artists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "window makers"@en .

aat:300386359 a skos:Concept ;
    skos:definition "Business partnerships of two or more persons working under a common name in the area of demolition, which is the destruction of buildings or other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demolition firms"@en .

aat:300386360 a skos:Concept ;
    skos:definition "Lovers of the fine arts. Also, people who are interested in an art or science on a superficial level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dilettantes"@en .

aat:300386361 a skos:Concept ;
    skos:definition "Organized, identifiable groups of people working together in a particular place and within a defined period of time, including legally incorporated entities and people more loosely bound, such as an artist's workshop, who work together to perform duties or activities. To refer specifically to incorporated groups that are considered in law as legal persons having an existence and rights and duties distinct from those of the individuals who form them, use \"corporations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate bodies"@en .

aat:300386362 a skos:Concept ;
    skos:definition "People who are organized and united in purpose due to mutual or common activities or interest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groups"@en .

aat:300386363 a skos:Concept ;
    skos:definition "Offices, departments, or other branches or representatives of a government, having official powers to act on behalf of the government, for example, having legal power to enforce regulations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governmental bodies"@en .

aat:300386364 a skos:Concept ;
    skos:definition "Organizations, agencies, departments, or other entities that coordinate, direct, and oversee the implementation of multiple interrelated projects or activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "programs"@en .

aat:300386365 a skos:Concept ;
    skos:definition "Accumulations or groupings of works of art that are acquired and assembled by private individuals or public instiutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art collections"@en .

aat:300386366 a skos:Concept ;
    skos:definition "Periodic programs of festive activities and cultural events with a specified focus on objects, environments, or experiences that are visual in nature, were created by the use of skill and imagination, and possess an aesthetic that is valued and of a quality and type that would be collected by art museums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "art festivals"@en .

aat:300386367 a skos:Concept ;
    skos:definition "Departments or administrative entities, often governmental, responsible for particular activities or duties, having a head and senior officials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offices"@en .

aat:300386368 a skos:Concept ;
    skos:definition "Formally structured organizations, establishments, or associations primarily involved with education, which is the imparting of knowledge, attitudes, skills, or socially valued qualities of character or behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "educational institutions"@en .

aat:300386369 a skos:Concept ;
    skos:definition "Organizations of people having a common interest in the areas of activity that encompass both performing and visual arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arts associations"@en .

aat:300386371 a skos:Concept ;
    skos:definition "Bodies of men associated or formally organized into social, professional, or honorary societies for some common purpose or interest. Often used to refer specifically to social fraternities, which are local or national organizations of male college students and which typically have names composed of two or three Greek letters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternities"@en .

aat:300386372 a skos:Concept ;
    skos:definition "Bodies of women associated or formally organized into social, professional, honorary, or religious clubs or societies for some common purpose or interest. Often used to refer specifically to social sororities, which are local or national organizations of female college students and which typically have names composed of two or three Greek letters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sororities"@en .

aat:300386373 a skos:Concept ;
    skos:definition "General term for offices, departments, or other branches or representatives that are no longer in existence, but formerly had authority to oversee, direct, manage, and administer on behalf of an institution or other group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former administrative bodies"@en .

aat:300386374 a skos:Concept ;
    skos:definition "Organizations that oversee and enable the production of operas, which are dramatic musical works in which singing forms an essential part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opera companies"@en .

aat:300386375 a skos:Concept ;
    skos:definition "Institutions that maintain cafélike facilities that support both the sale of alcohol and the presentation of entertainment generally of an improvisational, satirical, topical, or musical nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabarets"@en .

aat:300386376 a skos:Concept ;
    skos:definition "Nationality or culture of the region or nation of Kosovo in southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kosovan"@en .

aat:300386377 a skos:Concept ;
    skos:definition "Nationality or culture of the Micronesian island of Kosrae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kosraen"@en .

aat:300386378 a skos:Concept ;
    skos:definition "Ethnicity or culture of those speaking the Kwa languages of the Ivory Coast, Ghana, and Togo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kwa"@en .

aat:300386380 a skos:Concept ;
    skos:definition "Nationality and culture of the Turkic Kyrgyz people, today living primarily in the Kyrgyz Republic and the Pamir Mountains on the border between Tajikistan, Afghanistan, and China, Central Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kyrgyz"@en .

aat:300386381 a skos:Concept ;
    skos:definition "As a general term, belonging to Spanish-derived culture, especially referring to those of Spanish origin in North, Central, or South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latino"@en .

aat:300386382 a skos:Concept ;
    skos:definition "Nationality, culture, or style of Latium in central western Italy, now having Rome as its capital."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latian"@en .

aat:300386383 a skos:Concept ;
    skos:definition "Nationality, culture, and general style of ancient Laconia, a region in the southeastern part of the Peloponnese peninsula, for a time having its capital at Sparta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Laconian"@en .

aat:300386384 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the historical region of Languedoc in southern France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Languedocian"@en .

aat:300386387 a skos:Concept ;
    skos:definition "Nationality, culture, or style of Latvia, in the Baltic region of northern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latvian"@en .

aat:300386388 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the landlocked German-speaking alpine country and a microstate in Central Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liechtenstein"@en .

aat:300386389 a skos:Concept ;
    skos:definition "The style and culture of the ancient people of Liguria, a coastal region of north-western Italy in Cisalpine Gaul, including Genoa, parts of Piedmont, and Savoy,"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ligurian"@en .

aat:300386390 a skos:Concept ;
    skos:definition "Nationality, culture, or styles of Limburg, an area western Europe in the modern Netherlands and Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Limburger"@en .

aat:300386391 a skos:Concept ;
    skos:definition "Nationality, culture, and style of Livonia, a historic region on the eastern shores of the Baltic Sea, located in present-day Latvia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Livonian"@en .

aat:300386392 a skos:Concept ;
    skos:definition "Ethnicity, culture, and styles of the Lorraine region, currently in present-day northwestern France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lorraine"@en .

aat:300386396 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Luxembourg in western Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luxembourgeois"@en .

aat:300386397 a skos:Concept ;
    skos:definition "Nationality, culture, and style of Macao, on the southern coast of China, on the western side of the Pearl River Delta across from Hong Kong. May be reserved for the ethnicity of those of mixed Chinese and Portuguese descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macanese"@en .

aat:300386398 a skos:Concept ;
    skos:definition "Describes the culture and style related to the modern Republic of North Macedonia in southeastern Europe. The republic changed its name from \"Macedonia\" to \"North Macedonia\" in 2019, putting an end to a dispute over the name with Greece. However, North Macedonia prefers \"Macedonian\" as an adjectival form to describe anything related to cultural or ethnic identity. This is distinct and separate from the adjective \"Macedonian\" used in Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macedonian"@en .

aat:300386399 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Magadha, an ancient kingdom of northeastern India, situated in what is now west-central Bihar state, in northeastern India. It was the nucleus of several larger kingdoms or empires between the 6th century BCE and the 8th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magadha"@en .

aat:300386400 a skos:Concept ;
    skos:definition "Finno-Ugric people inhabiting Central Europe for many centuries and forming the majority of the population in the modern state of Hungary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magyar"@en .

aat:300386401 a skos:Concept ;
    skos:definition "Hair of the caribou or reindeer, used by the Inuit people for clothing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caribou hair"@en .

aat:300386402 a skos:Concept ;
    skos:definition "The skin of fish used as a material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish skin"@en .

aat:300386403 a skos:Concept ;
    skos:definition "Damage caused by fire, including burning and ash residue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire damage"@en .

aat:300386404 a skos:Concept ;
    skos:definition "Nationality, styles, or culture of the Maldive Islands in the Indian Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maldivian"@en .

aat:300386405 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the island Mallorca, located in the Mediterranean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mallorcan"@en .

aat:300386406 a skos:Concept ;
    skos:definition "Nationality, styles, or culture of Malta, a southern European archipelago and currently a nation in the Mediterranean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maltese"@en .

aat:300386409 a skos:Concept ;
    skos:definition "Nationality or culture of the Canadian province of Manitoba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Manitoban"@en .

aat:300386410 a skos:Concept ;
    skos:definition "Nationality, style, or culture of Mantua, Lombardy, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mantuan"@en .

aat:300386411 a skos:Concept ;
    skos:definition "Nationality, culture, or style of The Marches region, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marchigiano"@en .

aat:300386412 a skos:Concept ;
    skos:definition "Nationality, culture, or style of Martinique Island or the dependency of Martinique, in the eastern Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Martiniquan"@en .

aat:300386414 a skos:Concept ;
    skos:definition "The style and culture of the ancient people of Megara, living on the Saronikós Gulf within Attica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megarian"@en .

aat:300386415 a skos:Concept ;
    skos:definition "Nationality, style, or culture of Milan, Lombardy, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Milanese"@en .

aat:300386416 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the city of Modena, Emilia-Romagna, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modenese"@en .

aat:300386417 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Moldova in eastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moldovan"@en .

aat:300386418 a skos:Concept ;
    skos:definition "Nationality or culture of Monaco, a small independent principality on the Mediterranean coast of France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monégasque"@en .

aat:300386419 a skos:Concept ;
    skos:definition "An honorific parasol or disk-shaped culminating ornament carved from wood or stone, mounted at the summit of a stupa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chattras"@en .

aat:300386420 a skos:Concept ;
    skos:definition "Mortar containing minute, regularly shaped air bubbles that improve its workability and frost resistance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-entrained mortar"@en .

aat:300386421 a skos:Concept ;
    skos:definition "The ability of a material's surface to withstand wear due to mechanical action against it such as rubbing, scraping, or erosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abrasion resistance"@en .

aat:300386422 a skos:Concept ;
    skos:definition "A mold inhibiting calcium salt used as a food preservative. In conservation, used for reduction of acidity and fungi in aged paper documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium propionate"@en .

aat:300386423 a skos:Concept ;
    skos:definition "Extremely hard carbide of iron, a synthetic phase in technical iron alloys; in its naturally occurring form it is known as cohenite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cementite"@en .

aat:300386424 a skos:Concept ;
    skos:definition "Diseases transmitted by a specific infectious agent between persons or other species, either directly or through an intermediate vector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communicable disease"@en .

aat:300386425 a skos:Concept ;
    skos:definition "A vapor phase inhibitor used in steam generation and distribution systems required for heating or humidification to protect the ferrous components of these systems from corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclohexylamine"@en .

aat:300386426 a skos:Concept ;
    skos:definition "Compounds or materials deposited as a film on a metal surface that provides physical protection against corrosive attack during vapor phase; as used, for example, in steam generation and distribution systems required for heating or humidification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vapor phase inhibitor"@en .

aat:300386427 a skos:Concept ;
    skos:definition "Reduction of data needed for storage or transmission. Data is reduced in volume by means of encoding information to require fewer bits to be stored than the original."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "data compression"@en .

aat:300386428 a skos:Concept ;
    skos:definition "Removal of chlorine from water or another substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dechlorination"@en .

aat:300386429 a skos:Concept ;
    skos:definition "A pattern formed on a fabric, especially velvet, by burning the pile away with acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devoré"@en .

aat:300386430 a skos:Concept ;
    skos:definition "An animal glue solution used for sizing Japanese paper and silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dosa"@en .

aat:300386431 a skos:Concept ;
    skos:definition "Force required to drill a specimen under standardized conditions. Measurement of drilling resistance allows scientists to detect forms of deterioration in wood and address adequate conservation actions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drilling resistance"@en .

aat:300386432 a skos:Concept ;
    skos:definition "A red solid colorant obtained from ground madder treated with sulfuric acid, precipitated and oxidized. The process for making garacine was perfected in 1839 by Lagier and Thomas. Garancine had about 4 to 5 times the dyeing power of madder, but the final product was not as lightfast or wash resistant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garancine"@en .

aat:300386433 a skos:Concept ;
    skos:definition "Gelatinous, water-soluble polysaccharide substance used as an inexpensive substitute for agar in bacteriological media. In conservation, used in cleaning interventions on works of art on paper. Applications of rigid gelan gum allows a constant and controlled release of water onto paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gellan gum"@en .

aat:300386434 a skos:Concept ;
    skos:definition "A fermented tea made by incubating the kombucha culture, a symbiotic colony of bacteria and yeast. In conservation, this tea has an enzyme content that has been applied successfully in the cleaning of crystal fouling on archaeological silk objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kombucha"@en .

aat:300386435 a skos:Concept ;
    skos:definition "Carbon dioxide used in its liquid state as a non-toxic, environmentally friendly solvent for cleaning, degreasing, and decontaminating materials. Liquid carbon dioxide is also used to promote plant growth in a greenhouse environment, and, stored under pressure in a tank, as a carbon dioxide fire extinguisher. And has been used in the treatment of ethnological and natural history museum collections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquid carbon dioxide"@en .

aat:300386436 a skos:Concept ;
    skos:definition "A colorless crystalline solid used industrially as a crosslinking agent to form stable alcohol gels. Dissolved in methanol or Freon and deposited on paper as an aerosol spray, has been used as a nonaqueous deacidication treatment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium methoxide"@en .

aat:300386437 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the modern nation of Mongolia. For the historical Central Asian ethnographic group of closely related tribal peoples who live mainly on the Mongolian Plateau, use \"Mongol (culture or style).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mongolian"@en .

aat:300386438 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Montenegro in southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Montenegrin"@en .

aat:300386440 a skos:Concept ;
    skos:definition "A non-aqueous deacidifying agent applied to paper via spray or immersion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl magnesium carbonate"@en .

aat:300386442 a skos:Concept ;
    skos:definition "Olive colored magnesium-rich secondary phosphate mineral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mitridatite"@en .

aat:300386444 a skos:Concept ;
    skos:definition "Crystalline ester prepared from salicylic and carbolic acids, also known as salol; it is an ultraviolet-absorbing compound used in sun screen preparations and as a stabilizer for cellulosic and vinyl plastics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phenyl salicylate"@en .

aat:300386445 a skos:Concept ;
    skos:definition "Vegetable oil derived from the seeds of the European Pinus species, especially Pinus pinea. Early written works on painting attest that pine seed oil was used as a drying oil by Spanish painters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pine seed oil"@en .

aat:300386446 a skos:Concept ;
    skos:definition "Naturally occurring mineral form of lead dioxide; black crystals or blackish brown masses. In mural paintings, lead-based pigments may convert to plattnerite over time, causing deterioration and blackening to the pictorial surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plattnerite"@en .

aat:300386447 a skos:Concept ;
    skos:definition "Species of shrubby plant native to Central America and the southern United States with large, tapering bright red bracts that surround clusters of small yellow flowers. Sold as an ornamental at Christmastime. The poinsettia is native to Mexico and Central America; grows in moist, wet, wooded ravines and on rocky hillsides. It was named for Joel R. Poinsett, who popularized the plant and introduced it to floriculture while he was U.S. minister to Mexico in the late 1820s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Euphorbia pulcherrima"@en .

aat:300386448 a skos:Concept ;
    skos:definition "A secondary sulfate mineral found in mine waste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rozenite"@en .

aat:300386449 a skos:Concept ;
    skos:definition "An uncommon copper phosphate mineral found in the oxidized zones of copper deposits in Chile and as a rare mineral in caves. It is also found as a corrosion product on ancient copper alloy objects from Memphis, Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sampleite"@en .

aat:300386450 a skos:Concept ;
    skos:definition "Style and culture of the people of Tasek Bara, Pahang, Malaysia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Semelai"@en .

aat:300386451 a skos:Concept ;
    skos:definition "The state of being rigid to a degree or in part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semi-rigidity"@en .

aat:300386452 a skos:Concept ;
    skos:definition "Collective term for large scale Japanese paintings pasted to wall surfaces of one sort or another, such as fusuma (sliding door panels); typically treating landscape, figural or bird-and-flower themes. It is often translated as \"screen and wall paintings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shohekiga"@en .

aat:300386455 a skos:Concept ;
    skos:definition "Cultures and styles of the indigenous people of Mexico, North and Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native Mexican"@en .

aat:300386457 a skos:Concept ;
    skos:definition "Nationality and culture of Nauru, today an island country in Micronesia in the South Pacific."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nauruan"@en .

aat:300386458 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the city of Naples, Italy, and its historic kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neapolitan"@en .

aat:300386459 a skos:Concept ;
    skos:definition "Nationality, style, or culture of Nevis, an island in the Caribbean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nevisian"@en .

aat:300386460 a skos:Concept ;
    skos:definition "Nationality or culture of Newfoundland, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Newfoundland"@en .

aat:300386461 a skos:Concept ;
    skos:definition "General term for the Islamic cultures of Morocco, Algeria, Tunisia, Libya, and Mauritania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North African Islamic"@en .

aat:300386462 a skos:Concept ;
    skos:definition "Cultures and styles of the northern area of the continent of Europe in historic or current times; in the modern world, defined by the United Nations to include Denmark (with Faroe Islands), Estonia, Finland (with Åland), Iceland, Ireland, Latvia, Lithuania, Norway (Svalbard and Jan Mayen), Sweden, and the UK (with Guernsey, Isle of Man and Jersey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern European"@en .

aat:300386463 a skos:Concept ;
    skos:definition "The introduction of concentrated sulfuric acid into the structure of a molecule or ion in place of a hydrogen atom thereby forming a sulphonic acid; usually performed in aromatic organic chemistry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfonation"@en .

aat:300386464 a skos:Concept ;
    skos:definition "Cultures and styles of the southern area of the continent of Europe; in modern times, as defined by the United Nations to include Albania, Andorra, Bosnia and Herzegovina, Croatia, Gibraltar, Greece, Italy, Republic of Macedonia, Malta, Montenegro, Portugal, San Marino, Serbia, Slovenia, Spain, and Vatican City"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Southern European"@en .

aat:300386465 a skos:Concept ;
    skos:definition "Cultures and styles of the western nations of Europe. In modern times, as defined by the United Nations, it includes Andorra, Austria, Belgium, Denmark, Finland, France, Germany, Greece, Iceland, Ireland, Italy, Liechtenstein, Luxembourg, Monaco, Netherlands, Norway, Portugal, San Marino, Spain, Sweeden, Switzerland, and the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Western European"@en .

aat:300386466 a skos:Concept ;
    skos:definition "Nationality, culture, and styles associated with the eastern portion of Europe; in modern times defined by the United Nations as including Belarus, Bulgaria, Czech Republic, Hungary, Moldova, Poland, Romania, Russia, Slovakia, and Ukraine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern European"@en .

aat:300386467 a skos:Concept ;
    skos:definition "Nationality and culture of Northern Ireland, the part of the United Kingdom in the northeast of the island of Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Irish"@en .

aat:300386468 a skos:Concept ;
    skos:definition "Culture and styles of the north of Italy, including the Aosta Valley, Liguria, Lombardy, Piedmont, Emilia-Romagna, Friuli-Venezia Giulia, Trentino-Alto Adige/Südtirol, and the Veneto."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Italian"@en .

aat:300386469 a skos:Concept ;
    skos:definition "Nationality and culture of the northern half of the Korean Peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North Korean"@en .

aat:300386470 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the area roughly comparable to the modern Netherlands, not including Flanders, during the period ca. 800 - 1600."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "North Netherlandish"@en .

aat:300386472 a skos:Concept ;
    skos:definition "Nationality or culture of Nova Scotia, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nova Scotian"@en .

aat:300386473 a skos:Concept ;
    skos:definition "Paper manufactured using man-made fibers, typically synthetic resin derived from petroleum, which are bonded together with adhesives or heat and pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic paper"@en .

aat:300386474 a skos:Concept ;
    skos:definition "The Catalan word trencadís (broken tiles) applies to a kind of mosaic process made up of broken multi-colored ceramic tiles used to cover architectural surfaces. Antoni Gaudí and Josep Maria Jujol made extensive use of this technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trencadís"@en .

aat:300386475 a skos:Concept ;
    skos:definition "An alternative to ethyl silicate surface treatments for consolidation of stone which involves sealing the object or architectural element, dehumidifying it, evacuating the air from around the object, and introducing the agent, which then permeates the stone surface in a vacuum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum impregnation"@en .

aat:300386476 a skos:Concept ;
    skos:definition "Pale to emerald green orthorhombic hydrated aluminum phosphate mineral. It is formed by phosphate bearing water reacting with aluminum rich rocks. Variscite is sometimes used in jewelry as a semi-precious stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variscite"@en .

aat:300386477 a skos:Concept ;
    skos:definition "Screening wet sediment in plastic state for aggregate particles larger than a certain size. In construction, refers to removal of particles from fresh concrete. In archaeology, a method of recovering animal and plant remains from archaeological deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet sieving"@en .

aat:300386478 a skos:Concept ;
    skos:definition "Species of domesticated South American ruminant occupying the upper Andes and closely allied to the llama and alpaca. Their silky wool is used for textile fabrics. Most vicuñas inhabit Peru, with smaller numbers found in Bolivia, Chile, and Argentina. Some classification place the vicuña in the Lama genus, but because of differences in the incisor teeth, most authorities now place the vicuña in the Vicugna genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vicugna vicugna"@en .

aat:300386479 a skos:Concept ;
    skos:definition "The deel is a traditional Mongolian garment, little changed since the 13th century, a wide, colorful, calf-length silk robe with long sleeves that buttons up the right side."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deels"@en .

aat:300386480 a skos:Concept ;
    skos:definition "The process in which a crystalline solid absorbs atmospheric water vapor until the crystal eventually melts or liquefies into a saturated solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deliquescence"@en .

aat:300386481 a skos:Concept ;
    skos:definition "Trademarked name for a brand of alkyd-based paint distributed internationally since 1931."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dulux (TM)"@en .

aat:300386482 a skos:Concept ;
    skos:definition "A poisonous evergreen shrub in the genus Daphne with dense, narrow, dark green leaves. It is a native of the Mediterranean region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daphne gnidium"@en .

aat:300386483 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of Oman, on the southeast coast of the Arabian Peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Omani"@en .

aat:300386484 a skos:Concept ;
    skos:definition "Nationality or culture of Ontario province, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ontarian"@en .

aat:300386485 a skos:Concept ;
    skos:definition "Style and culture of one of the largest Indian scheduled tribes, an aboriginal people of the Choṭa Nāgpur region in the state of Bihār, India. They call themselves Kurukh; they once lived farther to the southwest on the Rohtās Plateau, but they were dislodged by other populations and migrated to Choṭa Nāgpur, where they settled in the vicinity of Munda-speaking tribes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oraon"@en .

aat:300386486 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Padua, the Veneto, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paduan"@en .

aat:300386487 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Panama, in southern Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panamanian"@en .

aat:300386488 a skos:Concept ;
    skos:definition "Nationality, culture, and style of ancient Pannonia, a region and a province of the Roman Empire, area east of the Adriatic Sea and west of the Carpathian Mountains, corresponding to early-21st century western Hungary, parts of eastern Austria, Slovenia, and northern Yugoslavia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pannonian"@en .

aat:300386489 a skos:Concept ;
    skos:definition "Nationality, culture, and style of Papua New Guinea in Oceania, comprising the eastern half of the island of New Guinea and numerous offshore islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papua New Guinean"@en .

aat:300386490 a skos:Concept ;
    skos:definition "Nationality, culture, or style of Perugia, Umbria, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Perugian"@en .

aat:300386491 a skos:Concept ;
    skos:definition "Culture and styles of the Peloponése, a peninsula forming the southernmost part of the Greek mainland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peloponnesian"@en .

aat:300386492 a skos:Concept ;
    skos:definition "Genus which contains about 50 species of flowering shrubs. It belongs to the Thymelaeaceae family and is native to Eurasia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Daphne"@en .

aat:300386493 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Piedmont, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Piedmontese"@en .

aat:300386494 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the North Pacific Micronesian volcanic island of Pohnpei."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pohnpeian"@en .

aat:300386495 a skos:Concept ;
    skos:definition "Nationality, culture, and styles belonging to Provence, France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Provençal"@en .

aat:300386496 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of the German kingdom and historic state Prussia, in northern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Prussian"@en .

aat:300386497 a skos:Concept ;
    skos:definition "Nationality, the part of the Punjab that lies within India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Punjabi"@en .

aat:300386498 a skos:Concept ;
    skos:definition "Nationality of that part of the Punjab that lies within Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Punjabi"@en .

aat:300386499 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Qatar, on the Arabian Peninsula, on the west coast of the Persian Gulf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qatari"@en .

aat:300386501 a skos:Concept ;
    skos:definition "Pumps for evacuating air or other gas from a confined space."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum pumps"@en .

aat:300386502 a skos:Concept ;
    skos:definition "Traditional whitework embroidery originating in Lucknow, India that typically involves stitching of delicate patterns in white cotton thread onto white muslin or other sheer material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chikankari"@en .

aat:300386503 a skos:Concept ;
    skos:definition "A colorless or white mineral consisting of potassium chloride, occurring typically as cubic crystals. It is rarer than halite (sodium chloride) and occurs as soft, bitter-tasting, white or grayish, glassy cubes or as masses with halite and gypsum in evaporite deposits in Germany, New Mexico, and Mount Vesuvius."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sylvite"@en .

aat:300386504 a skos:Concept ;
    skos:definition "Naturally occuring mineral composed of sodium chloride, usually colorless, cubic crystals. It is found as evaporite deposits in dry lakebeds, near the ocean, or as salt domes underground. Halite deposits occur in Germany, Austria, Russia, France, India, Canada, and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halite"@en .

aat:300386505 a skos:Concept ;
    skos:definition "Sodium chloride that occurs naturally as, or obtained mechanically from, a mineral deposit and sold as large crystals. Rock salt is used to melt ice, as a food preservative, and for the production of soda ash by the glass industry. To refer to the mineral composed of sodium chloride, use \"halite.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock salt"@en .

aat:300386506 a skos:Concept ;
    skos:definition "Sodium chloride crystals prepared for use as a food seasoning and preservative. Table salt contains sodium chloride with small amounts of a free-flowing agent (calcium silicate or magnesium carbonate), an anti-caking agent (sodium ferrocyanide), an iodizing salt (potassium iodide or sodium iodide), and an iodide stabilizer (sodium carbonate and sodium thiosulfate)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table salt"@en .

aat:300386508 a skos:Concept ;
    skos:definition "Form of sodium chloride, with small amounts of magnesium chloride, magnesium sulfate, and calcium sulfate, that is obtained from the evaporation of salt water; often comprising larger crystals than table salt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sea salt"@en .

aat:300386509 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the province of Québec, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Québécois"@en .

aat:300386510 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Réunion, Africa, located in the Indian Ocean, east of Madagascar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Reunionese"@en .

aat:300386511 a skos:Concept ;
    skos:definition "Cultures and styles of the area surrounding the Rhine river, Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhenish"@en .

aat:300386512 a skos:Concept ;
    skos:definition "Nationality, culture, or styles of the historical area of Rhodesia, Africa. For the nationality of the modern nation, use \"Zimbabwean.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhodesian"@en .

aat:300386513 a skos:Concept ;
    skos:definition "Nationality, style, or culture of the island of Rhodes, now in Greece, in the Aegean Sea off the southwest coast of Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhodian"@en .

aat:300386515 a skos:Concept ;
    skos:definition "Culture of Americans of Romanian descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romanian-American"@en .

aat:300386516 a skos:Concept ;
    skos:definition "The culture of Americans of Russian descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian-American"@en .

aat:300386517 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Rwanda, in central-eastern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rwandan"@en .

aat:300386518 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Saint Lucia island, in the eastern Caribbean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Lucian"@en .

aat:300386519 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Saint Vincent island, in the Caribbean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Vincentian"@en .

aat:300386520 a skos:Concept ;
    skos:definition "Nationality, style, and culture of El Salvador, Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salvadoran"@en .

aat:300386521 a skos:Concept ;
    skos:definition "Nationality, culture, or style of San Marino, on the Italian peninsula, on the northeastern side of the Apennines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "San Marinese"@en .

aat:300386523 a skos:Concept ;
    skos:definition "Nationality and culture of historical Serbia and Montenegro in the Balkans, Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serbian-Montenegrin"@en .

aat:300386524 a skos:Concept ;
    skos:definition "Cleaning pads made of natural sponge or other porous materials such as rubber or cellulose. Used generally for wiping surfaces or absorbing liquids."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponges"@en .

aat:300386525 a skos:Concept ;
    skos:definition "Glass that is impenetrable by light, neither transparent nor translucent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opaque glass"@en .

aat:300386526 a skos:Concept ;
    skos:definition "An opaque glass whose red color is generally caused by cuprous oxide crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opaque red glass"@en .

aat:300386527 a skos:Concept ;
    skos:definition "A copper sulfate hydrate mineral used historically as a green pigment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "posnjakite"@en .

aat:300386528 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of ancient Sicyon, in the northern Peloponnesus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sicyonian"@en .

aat:300386530 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Silesia, a historical region of Central Europe located mostly in Poland, with smaller parts in the Czech Republic and Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Silesian"@en .

aat:300386532 a skos:Concept ;
    skos:definition "Nationality or culture of Singapore, a Southeast Asian island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Singaporean"@en .

aat:300386533 a skos:Concept ;
    skos:definition "Nationality, culture, or styles of Slovakia, in Central Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Slovak"@en .

aat:300386534 a skos:Concept ;
    skos:definition "Culture, nationality, and styles of the Slavic linguistic and ethnic group that came from Asia in the third or second millennium BCE, spread steadily across eastern Europe, and played an important role in the Medieval world, particularly during the Slavic migrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Slavic"@en .

aat:300386535 a skos:Concept ;
    skos:definition "The styles and cultures of the Balkan Peninsula, in southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Balkan"@en .

aat:300386536 a skos:Concept ;
    skos:definition "Nationality or culture of South Korea, in the southern part of the Korean Peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Korean"@en .

aat:300386537 a skos:Concept ;
    skos:definition "Culture and styles of the area of Flanders, but not including the northern sections of the modern Netherlands; often used only in the context of culture and styles prior to the 15th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "South Netherlandish"@en .

aat:300386538 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Suriname, in northern South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Surinamese"@en .

aat:300386539 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Swabia, a historical region in southwestern Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swabian"@en .

aat:300386540 a skos:Concept ;
    skos:definition "Sytle and culture of Islam in Spain, particularly during the period 709 until 1614."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish Islamic"@en .

aat:300386541 a skos:Concept ;
    skos:definition "The Islamic culture and style of Syria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syrian Islamic"@en .

aat:300386542 a skos:Concept ;
    skos:definition "Nationality, styles, or culture of Taiwan, East Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taiwanese"@en .

aat:300386543 a skos:Concept ;
    skos:definition "Nationality, styles, or culture of Tajikistan, in Central Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tajik"@en .

aat:300386546 a skos:Concept ;
    skos:definition "Culture and styles of the ancient Khmer people, distinguished in part by speaking the Khmer language, which is part of the larger Mon-Khmer language family today found throughout Southeast Asia. It is believed that the Khmer people originated in northern Asia, then migrated from northern territories to become established in Southeast Asia ca. 3,000 years ago, long before the Tai arrived. The more recent history of the Khmer people is bound to the history of Cambodia. Most of Khmer are followers of the Khmer Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khmer"@en .

aat:300386547 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of historic region and land of Thüringen, in east-central Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thuringian"@en .

aat:300386548 a skos:Concept ;
    skos:definition "Nationality, culture, and style of Tobago, in the southern Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tobagonian"@en .

aat:300386550 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Torino, Piedmont, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Torinese"@en .

aat:300386551 a skos:Concept ;
    skos:definition "Nationality, styles, or culture of Transylvania, now in Romania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Transylvanian"@en .

aat:300386552 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Trieste, Friuli-Venezia Giulia, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Triestan"@en .

aat:300386553 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Trinidad, the southernmost island in the Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trinidadian"@en .

aat:300386554 a skos:Concept ;
    skos:definition "Nationality of Trinidad and Tobago, in the Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Trinidadian Tobagonian"@en .

aat:300386555 a skos:Concept ;
    skos:definition "Nationality, styles, or culture of Chuuk (Truk), Micronesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chuukese"@en .

aat:300386556 a skos:Concept ;
    skos:definition "Styles and culture of Tuscany, central Italy. For the culture of the ancient people who inhabited this and surrounding areas, use \"Etruscan.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuscan"@en .

aat:300386557 a skos:Concept ;
    skos:definition "Nationality, culture, or styles of Tuvalu, a Polynesian island in the Pacific Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tuvaluan"@en .

aat:300386558 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Tyrol, Austria, which was formerly a crown land of Austria-Hungary, embracing the present Austrian province of Tyrol and parts of northern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tyrolean"@en .

aat:300386559 a skos:Concept ;
    skos:definition "Synthetic fiber in which the fiber forming substance is composed of at least 85% acrylic resin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acrylic"@en .

aat:300386560 a skos:Concept ;
    skos:definition "Adenosine triphosphate is an energy-carrying chemical found in the cells of all living things. It is a nucleotide composed of ribose, adenine, and a triphosphate group. ATP captures chemical energy obtained from the breakdown of food molecules and releases it to fuel other cellular processes such as biosynthesis, ion transport, and muscle contraction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adenosine triphosphate"@en .

aat:300386561 a skos:Concept ;
    skos:definition "Adipic acid is a crystalline carboxylic acid used in the production of nylon and polyurethane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adipic acid"@en .

aat:300386562 a skos:Concept ;
    skos:definition "A colorless crystalline compound of the composition HNO3 used in the production of explosives and fertilizers. As nitrate runoff from agricultural land it is a toxic pollutant which may cause eutrophication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium nitrate"@en .

aat:300386563 a skos:Concept ;
    skos:definition "Colorless, crystalline compound of ammonia and phosphoric acid. Ammonium phosphate is used as a fire retardant, in fertilizers, and as a flux for soldering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium phosphate"@en .

aat:300386564 a skos:Concept ;
    skos:definition "A feldspar mineral used in the production of glass and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anorthite"@en .

aat:300386565 a skos:Concept ;
    skos:definition "A white or steel-gray mineral, iron arsenic sulfide, which occurs in crystalline rock and as the principal ore of arsenic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arsenopyrite"@en .

aat:300386566 a skos:Concept ;
    skos:definition "A rare lead compound, a transparent to pale white mineral in the monoclinic system. It was first identified in the lead-antimony vein at the southwestern end of Bounds Cliff, Cornwall by Cornish mineral collector Richard A. Barstow. It has also been found as a corrosion product on lead artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barstowite"@en .

aat:300386567 a skos:Concept ;
    skos:definition "Small painted wooden panels (and later, canvases) created as the covers for official documents of the Biccherna, the finance ministry of Siena between the thirteenth and eighteenth centuries. At some point in their history, the covers, which typically portrayed scenes of office life, were detached from their documents and treated as paintings which were hung on the office walls. Only 136 of these painted covers have been preserved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biccherne"@en .

aat:300386569 a skos:Concept ;
    skos:definition "Nationality, culture, or styles of Umbria, Italy. The term is typically used for periods from the Middle Ages forward. For the ancient cultures in this area, use \"Ancient Umbrian (culture or style).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Umbrian"@en .

aat:300386570 a skos:Concept ;
    skos:definition "Culture and style of the Umbri, an ancient pre-Etruscan people who gradually concentrated in Umbria (in central Italy) in response to Etruscan and Gallic pressure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Umbrian"@en .

aat:300386572 a skos:Concept ;
    skos:definition "The culture, nationality, and styles of Valencia, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Valencian"@en .

aat:300386574 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the Veneto region, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetan"@en .

aat:300386575 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Verona, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Veronese"@en .

aat:300386576 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Vienna, Austria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Viennese"@en .

aat:300386577 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the Virgin Islands, in the Caribbean, the westernmost islands of the Lesser Antilles; today they are divided between Great Britain and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Virgin Islands"@en .

aat:300386578 a skos:Concept ;
    skos:definition "Nationality, culture, or styles of the historical and geographical region Wallachia, Romania, central Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wallachian"@en .

aat:300386579 a skos:Concept ;
    skos:definition "Culture, style, or nationality of the people of Gaulish origin and speaking a French dialect, from the area that now forms the southeastern provinces of Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Walloon"@en .

aat:300386580 a skos:Concept ;
    skos:definition "Colonization and contamination of surfaces, as on machinery or other structures, by a diversie array of living organisms; especially after prolonged immersion in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biofouling"@en .

aat:300386581 a skos:Concept ;
    skos:definition "A manufactured compound of bismuth that occurs naturally as the mineral bismite. It is a heavy yellow powder, insoluble in water and soluble in acids, used as a pigment for enamels and ceramics. Also used in reflectance/transmittance testing as a colorant that permits \"tagging\" of a fill or coating in order to evaluate its effectiveness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bismuth oxide"@en .

aat:300386582 a skos:Concept ;
    skos:definition "Calcium stearate is a white, waxy powder, insoluble in water, created by heating calcium oxide and stearic acid. It is used industrially as a water repellent, as in paints and emulsions, and as a food additive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium stearate"@en .

aat:300386583 a skos:Concept ;
    skos:definition "A mineral found as efflorescence on some calcareous specimens and archaeological ceramics stored in oak museum cases. Its name alludes to its components: calcium, chlorine, and acetate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calclacite"@en .

aat:300386585 a skos:Concept ;
    skos:definition "Nationality and culture of the historical Federal Republic of Germany (founded 1949) before reunification, excluding the Soviet-occupied parts of Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West German"@en .

aat:300386586 a skos:Concept ;
    skos:definition "Cultures and styles belonging to the West Indies, a crescent-shaped group of over 1,200 islands separating the Gulf of Mexico and the Caribbean Sea from the Atlantic Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "West Indian"@en .

aat:300386587 a skos:Concept ;
    skos:definition "Small wine glasses of distinctive shape and size, designed for drinking sherry, a fortified wine of Spanish origin. Sherry glasses have a round foot, a stem, and small bowl; a common design has a tapering bowl that is colored at the lip and fades to a light color or clear at the top of the stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sherry glasses"@en .

aat:300386588 a skos:Concept ;
    skos:definition "Small wine glasses of distinctive shape and size, designed for drinking port, a type of sweet, dark red fortified wine, originally from Portugal. Port glasses have a round foot, a stem, and small bowl of any of several shapes; in a set of glasses having similar-shaped bowls, a port glass is distinguished by being smaller than the sherry glass, but not so small as the liqueur glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "port glasses"@en .

aat:300386589 a skos:Concept ;
    skos:definition "Drinking glasses having a small bowl and relatively short stem, intended for serving liqueurs, which are strong alcoholic drinks sweetened and flavored with aromatic substances. In a set of matching glasses, a liqueur glass is generally the smallest of the set, smaller than a port glass. While the meaning overlaps with \"cordial glasses,\" cordial glasses typically have a very tall stem proportionally to the size of the small bowl, while liqueur glasses have a short stem. Modern liqueur glasses may lack a stem entirely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liqueur glasses"@en .

aat:300386590 a skos:Concept ;
    skos:definition "Very small, deep pots or pans made of metal, intended to warm brandy over a flame or heater. The vessels sometimes have a spout; often having a long handle,."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brandy warmers"@en .

aat:300386591 a skos:Concept ;
    skos:definition "Any silicate of calcium as occurs crystallized in diopside and other minerals. Hydrated calcium silicate with inorganic fiber reinforcement is commonly molded into a high temperature insulation material, a safe alternative to asbestos. Calcium silicates are also used in the manufacture of materials such as glass, porcelain, and cement, and as fillers for plastics and paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium silicate"@en .

aat:300386592 a skos:Concept ;
    skos:definition "Transparent to translucent orthorhombic mineral, a member of the baryte group. It is colorless with faint shades of blue (alluded to by its name), red, white and other hues. Celestine occurs mainly in sedimentary rocks, especially dolomites and dolomitic limestones, and is mined for its strontium content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celestine"@en .

aat:300386593 a skos:Concept ;
    skos:definition "Starch derived from the endosperm of the corn kernel, separated from glutens and fibrous particles by sieving, wet grinding, and wash flotation. Heated with water it forms a viscous medium which thickens into an opaque gel with cooling. Cornstarch is used as a thickener in liquid based foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornstarch"@en .

aat:300386594 a skos:Concept ;
    skos:definition "A mineral consisting of lead chromate that occurs in the oxidized zone of lead mineral veins. It is compositionally identical to the pigment chrome yellow but only secondarily related. The element chromium was found in this rare secondary mineral in 1787 and became the basis for the pigment which was subsequently produced synthetically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crocoite"@en .

aat:300386595 a skos:Concept ;
    skos:definition "Historical itineraries such as the Silk Road across Asia or the St. James pilgrimage route to Santiago de Compostela recognized as heritage sites by administrative bodies such as the Council of Europe and UNESCO. Some are developed as scenic routes for cultural tourism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural routes"@en .

aat:300386596 a skos:Concept ;
    skos:definition "A traditional jewelry casting technique. The elliptical back plate or cuttlebone of the ordinary squid serves as the mold material. The desired pattern is carved into one half of the divided cuttlebone. The two halves are attached and heated metal is poured through a rounded channel cut into the top of the bone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuttlefish casting"@en .

aat:300386597 a skos:Concept ;
    skos:definition "An oily liquid ketone used as an industrial solvent for paints, coatings and plastics. It is also used to clean metals, remove spots in fabrics, and as an activator in oxidation reactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyclohexanone"@en .

aat:300386598 a skos:Concept ;
    skos:definition "Structural examination with the aim of obtaining information on the variation of composition with depth below the initial surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depth profiling"@en .

aat:300386600 a skos:Concept ;
    skos:definition "Refers to culture of the Native North American people living on the coast of Vancouver Island, British Columbia. The people and culture were known as Nitinaht until an official change of name in 1984."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ditidaht"@en .

aat:300386601 a skos:Concept ;
    skos:definition "Treatment added to laundered fabrics to make them softer. Historical softeners were typically based on water emulsion of soap and oils. Contemporary softeners are primarily based on quaternary ammonium salts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric softener"@en .

aat:300386602 a skos:Concept ;
    skos:definition "Color rendering that replaces normal, human- percievable color with assigned colors to highlight the visual display of phenomena, or to enhance contrasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false color"@en .

aat:300386603 a skos:Concept ;
    skos:definition "Aqueous formaldehyde solution containing 37% by weight of formaldehyde. In conservation it has been used as a fluid preserving medium, and, as an aerosol and fumigant, to treat algae on stone at sites such as the Lascaux caves. Formerly a brand name, now in common usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formalin"@en .

aat:300386604 a skos:Concept ;
    skos:definition "Dense subsurface soil layer that restricts water flow and root penetration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fragipan"@en .

aat:300386605 a skos:Concept ;
    skos:definition "Steel coated with a thin layer of zinc to prevent corrosion. The application may be effected by electroplating or spraying the steel with molten zinc, or by coating the heated steel with zinc powder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galvanized steel"@en .

aat:300386606 a skos:Concept ;
    skos:definition "Web-based mapping system administered by search engine company Google Inc. that allows users to search its database for detailed satellite images of nearly all locations on earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Google Earth"@en .

aat:300386607 a skos:Concept ;
    skos:definition "Pine tree native to the Mediterranean region, occurring in Southern Europe, North Africa, and the Levant, known for its edible seeds, which are also used for a variety of products including pine seed oil used in painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus pinea"@en .

aat:300386608 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of Yap, Micronesia, in the western Pacific Ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yapese"@en .

aat:300386609 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Yemen, Western Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yemeni"@en .

aat:300386610 a skos:Concept ;
    skos:definition "Sytles and cultures found along the Zambezi River, flowing into the Indian Ocean from Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zambezi River"@en .

aat:300386612 a skos:Concept ;
    skos:definition "Traditional hip- or knee-length long sleeved kimono-like jacket originating in Japan. Both men and women wear haori; women’s are typically longer than men’s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haori"@en .

aat:300386613 a skos:Concept ;
    skos:definition "Style and culture of ancient Germanic tribe that occupied territory extending from Franconia to Thuringia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hermunduri"@en .

aat:300386614 a skos:Concept ;
    skos:definition "The amino sugar derivative of the monosaccharide hexose in which the hydroxyl group is replaced with an amine group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hexosamine"@en .

aat:300386615 a skos:Concept ;
    skos:definition "Period of the Himyarite kingdom. The society was marked by its intensive agricultural regime dependent on irrigation, which flourished in southern Arabia from the first century BCE to the early sixth century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Himyarite"@en .

aat:300386616 a skos:Concept ;
    skos:definition "An igneous rock consisting mainly of the amphibole mineral hornblende."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornblendite"@en .

aat:300386617 a skos:Concept ;
    skos:definition "A marble-like mixed-mineral stone. Its name alludes to its composition: a hydrated magnesium composite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydromagnesite"@en .

aat:300386618 a skos:Concept ;
    skos:definition "A rare, naturally occurring metallic element with symbol In and atomic number 49. Indium is a soft, silver-white metal collected as a residue of zinc-processing operations and chiefly used in the manufacture of semiconductors. Also appears as an impurity in ancient metal objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indium"@en .

aat:300386619 a skos:Concept ;
    skos:definition "International Klein Blue (IKB) is a powdery ultramarine pigment created by Yves Klein in 1956 and patented by the artist in 1960. He used the color, symbolic of purity of spirit, exclusively from 1957 on."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "International Klein Blue"@en .

aat:300386620 a skos:Concept ;
    skos:definition "An amber or brownish yellow-colored hydrous sulfate of iron and potassium found as rhombohedral crystals is sulfurous layers of iron ore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jarosite"@en .

aat:300386621 a skos:Concept ;
    skos:definition "Strongly magnetic iron oxide mineral closely related to hematite and sometimes found as a corrosion product on archaeological objects made of iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maghemite"@en .

aat:300386622 a skos:Concept ;
    skos:definition "A white salt used medicinally as a laxative and anticonvulsant. In conservation science it is encountered as a salt weathering deposit on stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium sulfate"@en .

aat:300386623 a skos:Concept ;
    skos:definition "Melanterite is hydrated iron sulfate formed after decomposition of pyrite or other iron materials by action of surface waters in mines. It occurs as dull, translucent green crystals on mine walls. Formerly used to make an inky pigment, melanteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "melanterite"@en .

aat:300386624 a skos:Concept ;
    skos:definition "A thiol used as a corrosion inhibitor or a sulfide mineral flotation collector. In conservation science, used in treatment of metal artifacts of archaeological origin to treat tarnish and as a fungicide in paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mercaptobenzothiazole"@en .

aat:300386625 a skos:Concept ;
    skos:definition "An alkoxysilane used as a consolidant in treatment of stone and waterlogged wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyltriethoxysilane"@en .

aat:300386626 a skos:Concept ;
    skos:definition "Artists who specialize in accurate depictions of plants and their parts for use as illustrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botanical illustrators"@en .

aat:300386627 a skos:Concept ;
    skos:definition "Businesses that make books and other works of writers and songwriters available to the public, traditionally through books or other printed materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "publishing houses"@en .

aat:300386628 a skos:Concept ;
    skos:definition "Minimally invasive stone cleaning treatments for historic masonry in sculpture and architecture that aim to avoid damage to surface topography of material while mechanically removing the soiling agent or coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microabrasive cleaning"@en .

aat:300386629 a skos:Concept ;
    skos:definition "People who practice or perform writing, particularly those whose business or occupation consists of writing longhand or on a keyboard, whether or not they are also responsible for the content. Included are functionaries, officers, clerks, and others who perform clerical or secretarial duties. To distinguish those who compose content, particularly those responsible for the creative and intellectual content of books and other literary works, use \"authors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writers"@en .

aat:300386630 a skos:Concept ;
    skos:definition "Describes the artifacts and culture of the prehistoric Polynesian residents of Chatham Islands, New Zealand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moriori"@en .

aat:300386631 a skos:Concept ;
    skos:definition "In general, those who give directions or instructions on a particular topic or activity. Specifically, college teachers who are inferior in rank to a professor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instructors"@en .

aat:300386632 a skos:Concept ;
    skos:definition "A type of Japanese folk, or mingei, ceramic first produced in the Edo period. Its name (“West Plate Mountain” in English) refers to its production area in Fukuoka prefecture.in northern Kyushu. A distinct ceramic style peculiar to the reddish brown stoneware soy sauce jars, sake flasks, and mortars manufactured by the kilns of Nishi Sarayama has been identified by scholars in recent years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nishi Sarayama"@en .

aat:300386633 a skos:Concept ;
    skos:definition "People appointed to perform liturgical duties or other services in a Christian church, or who hold authority by virtue of their rank within a Christian religious order or similar organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ministers"@en .

aat:300386635 a skos:Concept ;
    skos:definition "People of either sex who run their own household as their primary job or activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "homemakers"@en .

aat:300386636 a skos:Concept ;
    skos:definition "Fossil bone or tooth consisting of the phosphate mineral fluoroapatite colored blue by vivianite. It is used as a gemstone closely resembling turquoise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odontolite"@en .

aat:300386637 a skos:Concept ;
    skos:definition "An alcohol soluble protein from maize, analogous to gluten, used in making textile fibers, plastics, adhesives, coatings and sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zein"@en .

aat:300386638 a skos:Concept ;
    skos:definition "A gaseous form of hydrogen peroxide applied as a low temperature antimicrobial sterilant used to decontaminate sealed spaces. In a conservation science context, vaporized hydrogen peroxide has been used to decontaminate works of art and heritage sites colonized by microorganisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vaporized hydrogen peroxide"@en .

aat:300386639 a skos:Concept ;
    skos:definition "Radiometric dating method which measures the age of igneous calcium carbonate materials. The technique calculates the degree to which radioactive thorium-230 isotopes within a sample have reestablished secular equilibrium with their parent uranium-234 isotopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uranium-thorium dating"@en .

aat:300386640 a skos:Concept ;
    skos:definition "People who own and manage restaurants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "restaurateurs"@en .

aat:300386641 a skos:Concept ;
    skos:definition "People who hold an office, function, or mandate within an organization or government, and who perform official duties as a representative of the organization or government."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "officials"@en .

aat:300386642 a skos:Concept ;
    skos:definition "Members of a ship's company below the rank of officer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sailors"@en .

aat:300386643 a skos:Concept ;
    skos:definition "Pre-Columbian culture and style of coastal Colombia and Ecuador."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tumaco La Tolita"@en .

aat:300386644 a skos:Concept ;
    skos:definition "Offices, businesses, agencies, or departments for the transaction of public business, having a specified function and often coordinating related activities and the distribution of information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bureaus"@en .

aat:300386645 a skos:Concept ;
    skos:definition "Interdisciplinary science and technology of interactive sliding surfaces. The three chief branches of tribology are lubrication, friction, and wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribology"@en .

aat:300386646 a skos:Concept ;
    skos:definition "People who hold an office, function, or mandate within a state government, usually a U.S. state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state officials"@en .

aat:300386647 a skos:Concept ;
    skos:definition "People who hold an office, function, or mandate within the government of a city, town, district, or municipality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal officials"@en .

aat:300386648 a skos:Concept ;
    skos:definition "General term referring to systems of quantities taken as unified standards of measure, usually represent a uniform system established by a nation. The regulation of weights and measures is necessary for science, industry, and commerce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weights and measures"@en .

aat:300386649 a skos:Concept ;
    skos:definition "A mineral consisting of calcium oxalate dihydrate found as tiny white, glassy crystals. Originally found in mud at the bottom of the Weddell sea, Antarctica, which gave the mineral its name. Weddellite, and whewellite form on the surface of carbonaceous minerals in the presence of microbiological organisms such as lichens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weddellite"@en .

aat:300386650 a skos:Concept ;
    skos:definition "Refers to methods of making storage areas in openly accessible. Collections on view are often only a small portion of an institution’s total holdings. Physical objects previously hidden from view may be shared with the public through such means as glass wall bays exposing contents of storage areas; or by visitable study collections in storage space available for viewing and research by students, scholars, and the general public."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visible storage"@en .

aat:300386651 a skos:Concept ;
    skos:definition "Shiny white crystalline compound used in photography as a toner and to remove stains from negatives. Capable of dissolving silver salts, thiourea is often an active ingredient in silver-dip tarnish removal solutions. It is also used to accelerate the vulcanization of rubber. Its composition is the same as that of urea but with a sulfur atom in place of the oxygen atom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thiourea"@en .

aat:300386652 a skos:Concept ;
    skos:definition "A class of materials used as an alternative to fiber reinforced polymer (FRP) for shear strengthening and seismic retrofitting of concrete structures. A mortar incorporates textile comprised of woven or knitted fiber rovings in two or more, usually orthogonal, directions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile-reinforced mortar"@en .

aat:300386653 a skos:Concept ;
    skos:definition "Small boxes, usually black leather, containing biblical texts attached by straps to the forehead and left arm of observant Jews during weekday morning prayers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tefillin"@en .

aat:300386654 a skos:Concept ;
    skos:definition "Black, resinous fatty by-product from the kraft paper pulping of pine wood. In addition to being an important source of rosin, tall oil is used in the manufacture of soaps, resins, greases, inks, and other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tall oil"@en .

aat:300386655 a skos:Concept ;
    skos:definition "Institutions, groups, or other corporate bodies who oversee the finances, management, and maintenance of a garden, which is an open space where plants are cultivated; generally reserved for those managing a large public or private garden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gardens"@en .

aat:300386656 a skos:Concept ;
    skos:definition "Corporation or other corporate body engaged in securing, managing, and maintaining mass transportation of passengers, generally limited to buses, trains, and other ground or underground transportation methods in an urban area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transit systems"@en .

aat:300386657 a skos:Concept ;
    skos:definition "Organizations, businesses, or companies, either public or private, that oversee the operation and finances of a railroad system infrastructure and its trains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroads"@en .

aat:300386658 a skos:Concept ;
    skos:definition "Technique of wood design in which smaller pieces of various colors are laid into a solid ground to create a pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wood inlay"@en .

aat:300386660 a skos:Concept ;
    skos:definition "Elements of temple architecture of the Indian subcontinent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indian religious building fixtures"@en .

aat:300386661 a skos:Concept ;
    skos:definition "General term referring to any of several breeds of domesticated rabbits having long hair. The Angora rabbit is native to Asia Minor, domesticated by the Trelicians in the 6th century. It has been bred in France, England, and elsewhere in Europe since the early 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angora rabbits"@en .

aat:300386663 a skos:Concept ;
    skos:definition "Meaning \"egg,\" refers to the distinctive domes of Indian temples and other architecture, usually hemispherical or egg-shaped; sometimes refers to other egg-shaped elements of Indian architecture. In North Indian temple architecture, a spirelet form found in the Śekharī temple superstructure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aṇḍas"@en .

aat:300386669 a skos:Concept ;
    skos:definition "Hair derived from rabbits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rabbit hair"@en .

aat:300386671 a skos:Concept ;
    skos:definition "In Indian architecture, a hall of worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caityagrha"@en .

aat:300386672 a skos:Concept ;
    skos:definition "The long, fine hair from any breed of Angora rabbit. The white French rabbit is favored for its high-quality, soft hair. Angora dyes readily, but is difficult to spin because of its fine texture and it does not felt like common rabbit hair. It is usually mixed with sheep wool or other fibers for weaving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angora"@en .

aat:300386675 a skos:Concept ;
    skos:definition "Distinctive handbells or gongs, used as an instrument in Indian music and in Buddhist ritual. A ghanta may be paired with a vajra; use the more specific \"vajras-ghantas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghantas"@en .

aat:300386678 a skos:Concept ;
    skos:definition "Refers to people or corporate bodies who own or run manufacturing plants for making vehicles that navigate through the air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aircraft manufacturers"@en .

aat:300386679 a skos:Concept ;
    skos:definition "Refers to people or corporate bodies who own or run manufacturing plants for making electronic equipment, devices, or components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronics manufacturers"@en .

aat:300386680 a skos:Concept ;
    skos:definition "Associations of persons carrying on commercial or industrial enterprises focused on the development and manufacture of software, which includes computer system programs, procedures, and associated documentation concerned with the operation of data processing systems, and which require hardware for use to be made of them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "software companies"@en .

aat:300386681 a skos:Concept ;
    skos:definition "Refers to people or corporate bodies who own or run manufacturing plants for making devices used in a domestic context that facilitate such tasks as food preparation, food storage, cleaning, and grooming."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appliance manufacturers"@en .

aat:300386682 a skos:Concept ;
    skos:definition "Associations of persons carrying on commercial enterprises focused on the discovery, development, and manufacture of pharmaceuticals, which are medicinal drugs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pharmaceutical companies"@en .

aat:300386683 a skos:Concept ;
    skos:definition "People or corporate bodies who make cameras, which are lightproof boxes fitted with a lens through the aperture of which the image of an object is recorded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camera makers"@en .

aat:300386684 a skos:Concept ;
    skos:definition "Individuals, companies, or corporations engaged in the development of software, which includes computer system programs, procedures, and associated documentation concerned with the operation of data processing systems, and which require hardware for use to be made of them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "software developers"@en .

aat:300386685 a skos:Concept ;
    skos:definition "Name given to a mixture used for stone consolidation. It was introduced to the field of conservation in the late 1970s in Bologna, Italy. The Bologna cocktail consists of an acrylic resin copolymer and a partially prepolymerized dimethylpolysiloxane in a solvent mixture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bologna cocktail"@en .

aat:300386686 a skos:Concept ;
    skos:definition "Support for developing countries, international organizations and non-governmental organizations to improve their ability to implement and observe goals and treaty or charter obligations. Capacity building focuses on identifying obstacles to success and developing strategies to overcome them. Capacity-building programs are generally supplied by multilateral and regional organizations, multilateral banks or bilateral programs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capacity building"@en .

aat:300386687 a skos:Concept ;
    skos:definition "The mechanism of \"chalk\" formation in the deterioration of paints or plastic triggered by oxidative degradation of the binder exposing a layer of pigment or filler. The process results in a dry, powdery surface appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalking"@en .

aat:300386688 a skos:Concept ;
    skos:definition "Material applied as outer layer of a surface for protection or decoration, in architecture and other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facing"@en .

aat:300386689 a skos:Concept ;
    skos:definition "The ability of a material to withstand degradation by frost. It may be enhanced in some materials through frostproofing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frost resistance"@en .

aat:300386690 a skos:Concept ;
    skos:definition "A branch of landscape archaeology which emerged during the 1980’s in the context of historical restoration. Garden archaeology investigates diverse questions, from studies of natural history and rural economy to recovery of ancient garden layouts. Excavations at Castle Bromwich Hall Gardens in Birmingham and at the Privy Garden of Hampton Court are examples of garden archaeology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garden archaeology"@en .

aat:300386691 a skos:Concept ;
    skos:definition "Any of various rocks that are green in color, including altered igneous rocks colored green by feldspar, hornblende, augite, nephrite, or other minerals, or low-grade metamorphic rock containing actinolite, epidote, or albite. Greenstone has been used for carving and construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "greenstone"@en .

aat:300386692 a skos:Concept ;
    skos:definition "Scaly oxide coating that forms on red-hot steel when it is hammered. Also known as forge scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hammerscale"@en .

aat:300386693 a skos:Concept ;
    skos:definition "Refers to large scale digitizing projects, usually of books digitized in order to create a digital library."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mass digitization"@en .

aat:300386694 a skos:Concept ;
    skos:definition "Refined, dehydroxylated form of the clay mineral kaolinite. Like other pozzolans, it will chemically react with calcium hydroxide at ordinary temperatures to form compounds possessing cementitious properties; and is used as a substitute for cement in some concrete mixtures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "metakaolin"@en .

aat:300386695 a skos:Concept ;
    skos:definition "Drying materials such as paper books and documents with a microwave oven."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microwave drying"@en .

aat:300386696 a skos:Concept ;
    skos:definition "A yellow or brown-colored siliceous alteration product resulting from the hydration of basaltic volcanic glass that has undergone rapid chilling. It is found as pyroclastic cones in areas where basaltic eruptions come in contact with water, as in the Galapagos Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palagonite"@en .

aat:300386697 a skos:Concept ;
    skos:definition "Historical Flemish painting technique identified by Karel Van Mander: a flesh colored first layer of paint above the white ground providing the initial tone. It is visible as a substratum beneath the translucent layers of glaze. Primuersel is equivalent to the Italian imprimatura."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primuersel"@en .

aat:300386698 a skos:Concept ;
    skos:definition "General term referring to people, places, things, events, activities, or attributes that are not firmly established or can be any of various options."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miscellaneous"@en .

aat:300386699 a skos:Concept ;
    skos:definition "A facet is a fundamental, homogeneous, and mutually exclusive category of information in a thesaurus (for example, the AAT has seven facets: Associated Concepts, Physical Attributes, Styles and Periods, Agents, Materials, Activities, Objects)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "facets"@en .

aat:300386700 a skos:Concept ;
    skos:definition "A guide term is a record represented by a term or phrase that is created as a hierarchical level to provide order and structure to thesauri by grouping narrower terms according to a given logic. Guide terms are not used for indexing and are often enclosed in angled brackets or otherwise distinguished from other terms in displays (for example, <photographs by form>)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guide terms"@en .

aat:300386701 a skos:Concept ;
    skos:definition "Vegetable oil with many culinary uses; also used traditionally as a binder for body paint by Native Americans of Baja California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pumpkin seed oil"@en .

aat:300386702 a skos:Concept ;
    skos:definition "Oil derived from turmeric (Curcuma longa), a tuberous rhizome of the ginger family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "turmeric oil"@en .

aat:300386703 a skos:Concept ;
    skos:definition "A quartz crystal microbalance is an extremely sensitive sensor which weighs mass per area by measuring change in the freqency of an acoustic resonator. It is composed of a specially cut quartz crystal set between two electrodes that oscillates at its resonance frequency when AC power is applied through the electrodes due to the piezoelectric effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartz crystal microbalances"@en .

aat:300386704 a skos:Concept ;
    skos:definition "Quaternary ammonium compounds are salts of quaternary ammonium cations with an anion. They are prepared by alkylation of tertiary amines. The compounds are used in softener formulations in the textile industry and in hair conditioner formulas. In conservation, they are used as wood preservatives, and as surfactant fungicides in treatment of textiles and paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quaternary ammonium compounds"@en .

aat:300386705 a skos:Concept ;
    skos:definition "Species of perennial, rhizomatous, herbaceous plant native to the Indian subcontinent and Southeast Asia, valued for its root-stock, which is used as a spice, as a yellow dye, as a chemical test for alkalinity, and also medicinally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Curcuma longa"@en .

aat:300386707 a skos:Concept ;
    skos:definition "Art and design that focuses narrowly on the marketing of products and other sales, including typography, layout, packages, mailings, and other visual materials having to do primarily or exclusively with sales. It may include design for the Internet and social media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "advertising art"@en .

aat:300386708 a skos:Concept ;
    skos:definition "Refers to very thin sections of a petrographic sample ground down to a flat surface and prepared for examination by a microscrope or microprobe. A thin section is 30 microns or less in thickness as a rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thin sections"@en .

aat:300386709 a skos:Concept ;
    skos:definition "Recreational activity in which a person rides a skateboard, a narrow board mounted on roller-skate wheels, usually in a standing position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skateboarding"@en .

aat:300386710 a skos:Concept ;
    skos:definition "Film genre in which the humor is derived from pratfalls, physical confrontation, chases, and other violently energetic activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slapstick comedy"@en .

aat:300386711 a skos:Concept ;
    skos:definition "Drawings, prints, or other pictures that illustrate plants and their parts, often accurately rendered from life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botanical illustrations"@en .

aat:300386712 a skos:Concept ;
    skos:definition "Artists in any media that focus on subjects depicting natural objects and beings, for example from the realms of zoology, botany, and minerology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural history artists"@en .

aat:300386713 a skos:Concept ;
    skos:definition "An unstable compound, the simplest silicon alcohol, consisting of silicon atoms to which hydroxyl substituents bond directly. Silanol groups occur naturally (as in silicic acid and on silicate rocks) or may be synthesized by reacting dimethyldichlorosilane with water. They play an important role in many industrial situations such as the manufacture of silicones and in sol-gel processes, or in water repellent products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silanol"@en .

aat:300386714 a skos:Concept ;
    skos:definition "A white, powdery inorganic compound, the sodium salt of the polyphosphate penta-anion. It is manufactured for use as an emulsifier and chelating agent in water softeners and detergents. In conservation it has been used as a sequestering agent for the treatment of excavated copper and bronze objects, a chelating agent in the conservation of paper objects, and as a surfactant in the cleaning of photographs. It has been suspected of contributing to water pollution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium tripolyphosphate"@en .

aat:300386715 a skos:Concept ;
    skos:definition "Zinc titanate, also known as zinc titanium oxide, is an inorganic compound, a white powder insoluble in water, that exists in several major forms. It is used as an antimicrobial stone or metal coating, a regenerable catalyst, a pigment, and a sorbent for high temperature desulfurization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc titanate"@en .

aat:300386716 a skos:Concept ;
    skos:definition "Native culture and style of East Sepik Province in Papua, New Guinea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wosera"@en .

aat:300386717 a skos:Concept ;
    skos:definition "Culture and styles of the dominant element in the population of Palestine in the 1st millennium BCE, particularly the ancient Hebrew nation dating from the 12th to 6th centuries BCE, from the Exodus to the Babylonian Captivity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Israelite"@en .

aat:300386718 a skos:Concept ;
    skos:definition "Stolzite is a lead tungstate, a rare secondary mineral that is nearly identical in chemical composition to wulfenite with which it is often associated in the oxidized zones of tungsten-bearing lead deposits. It is named for Joseph Alexander Stolz of Bohemia who first identified it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stolzite"@en .

aat:300386719 a skos:Concept ;
    skos:definition "Culture and styles of Judaea, the southernmost of the three traditional divisions of ancient Palestine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Judaean"@en .

aat:300386720 a skos:Concept ;
    skos:definition "In metallurgy, removal of carbon content from metal, usually steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decarburization"@en .

aat:300386721 a skos:Concept ;
    skos:definition "A naturally occurring red colorant derived from any of several lichens. It was widely used in antiquity for textile dyeing. Orcein is the essential constituent of archil and is used as a biological stain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orcein"@en .

aat:300386722 a skos:Concept ;
    skos:definition "Treatment or impregnation of a substance or compound with ozone. Ozonation may be part of a purification process or used to induce a change in color as in ozone treatment of resonant wood to obtain the appearance of old wood, desirable in restoration of violins as well as for production of new musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ozonation"@en .

aat:300386723 a skos:Concept ;
    skos:definition "People who make works or perform activities that were conceived and designed by other people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executors"@en .

aat:300386724 a skos:Concept ;
    skos:definition "People who work metal by employing a forge to heat it and then hammering and beating it into shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forgers"@en .

aat:300386725 a skos:Concept ;
    skos:definition "Communications field concerned with using photographs to document significant events, often in the context of news and related commentary through the mass media, both print and electronic. For journalism focusing on images other than photographs, use \"pictorial journalism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photojournalism"@en .

aat:300386726 a skos:Concept ;
    skos:definition "Communicaton to a mass audience of news and related commentary through prints, photographs, or other images, without accompanying text or with written material subordinate to the pictorial elements. Where the images comprise only modern photographs, \"photojournalism (discipline)\" is more commonly used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictorial journalism"@en .

aat:300386727 a skos:Concept ;
    skos:definition "Culture and period of ancient nomadic people who formed a state in Mongolia north of the empire of the Han Dynasty. What little is known of the culture is offered by Chinese literary sources and a few archaeological sites and artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xiongnu"@en .

aat:300386728 a skos:Concept ;
    skos:definition "Sodium dehydroacetate is the sodium salt of dehydroacetic acid. It is a preservative and antimicrobial agent that has been used as a food additive and in aqueous deacidification of manuscripts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium dehydroacetate"@en .

aat:300386729 a skos:Concept ;
    skos:definition "Amorphous sodium polyphosphate used as water softener (marketed in powdered form as Calgon T and other copyrighted names), sequestering agent, and corrosion inhibitor. In conservation, sodium hexametaphosphate is used in the cleaning of wood, stone, textiles, and ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium hexametaphosphate"@en .

aat:300386730 a skos:Concept ;
    skos:definition "Aromatic vegetative products such as ginger root, black pepper, and nutmeg, added to food as a flavoring or condiment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spices"@en .

aat:300386731 a skos:Concept ;
    skos:definition "A milky beverage produced by soaking, grinding, and boiling dried soy beans. It is a traditional staple of Chinese and Japanese cuisine and has been promoted as a substitute for cow’s milk elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soy milk"@en .

aat:300386732 a skos:Concept ;
    skos:definition "Art created for billboards, which are large flat surfaces typically designed for advertisements and displayed in public areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "billboard art"@en .

aat:300386733 a skos:Concept ;
    skos:definition "Textile art made using resist dyeing in which wax is used as the resist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batik art"@en .

aat:300386734 a skos:Concept ;
    skos:definition "Visual works that are usually ultimately based on ancient or traditional practices, and comprise adornment or embellishment applied to the human body. In body art in this sense, generally the body is the support upon which media are applied, either temporarily or permanently, or where the body is permanently altered. Examples include scarification, tattooing, body piercing and painting, and hair styling. For the art form that arose in the 1960s among performance artists and conceptual artists, where the human body is the medium of the artist, use \"body art (performance art).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body art"@en .

aat:300386735 a skos:Concept ;
    skos:definition "To draw out and twist fibers after cording in preparation for spinning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slubbing"@en .

aat:300386736 a skos:Concept ;
    skos:definition "People who specialize in applying decoration, modification, and embellishment to the human body for purposes of cultural identity, beautification, or self expression. Their art includes such forms as scarification, tattooing, body piercing and painting, and hair styling. Body artists in this sense are typically practicing techniques that are based in ancient and traditional body modification; they thus differ from \"body artists (performance artists)\" who arose in the 1960s and whose art is closely related to performance art and conceptual art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "body artists"@en .

aat:300386737 a skos:Concept ;
    skos:definition "A handwoven textile of Japan made from twisted paper thread. Shifu was manufactured from the 1600s for use in paper products such as book covers and for two sorts of cloth: a coarse fabric for work clothes; a very fine material used and sold by the Samurai. Shifu production declined with the disappearance of the Samurai class."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shifu"@en .

aat:300386738 a skos:Concept ;
    skos:definition "Refers to the culture of the Sherpa, a nomadic people dwelling chiefly in the mountainous Khumbu region of eastern Nepal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sherpa"@en .

aat:300386739 a skos:Concept ;
    skos:definition "Rare-earth metallic element having symbol Sc and atomic number 21. Scandium is a soft, silvery-white metal which does not tarnish in air. It was discovered in 1879 but predicted a decade earlier and given its initial name, ekaboron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scandium"@en .

aat:300386740 a skos:Concept ;
    skos:definition "Tree bark employed historically as writing material for important manuscripts in Assam, India. To write on Sanchipat, a waterproof ink was used, prepared with Silikha seed, Kehraj (a type of grass),ashes and minerals and applied with a bird’s feather. The material and associated technique are now rarely used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sanchipat"@en .

aat:300386741 a skos:Concept ;
    skos:definition "Bodies that exercise continuous authority on behalf of a nation, state, community, or other administrative entity over the actions of subjects or citizens, by authoritative direction or regulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governments"@en .

aat:300386742 a skos:Concept ;
    skos:definition "Yellow crystalline acidic compound found in tobacco leaves, forsythia flowers, common rue, and other plants. Rutin is used medicinally for its antioxidant properties and as a colorant. It is yellow upon precipitation, and becomes brown with exposure to heat or light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rutin"@en .

aat:300386743 a skos:Concept ;
    skos:definition "A rare secondary mineral occurring as brownish, yellow or gray prismatic crystals in the oxidized zones of tungsten-bearing hydrothermal base metal deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raspite"@en .

aat:300386744 a skos:Concept ;
    skos:definition "An instrument used in radio astronomy for detecting and recording radio emissions from space between wavelengths of about 30 megahertz and 300 gigahertz. Radio telescopes essentially consist of a large, concave metal bowl that serves as a directional aerial, capturing and focusing radio waves; along with a receiver and recording equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio telescopes"@en .

aat:300386745 a skos:Concept ;
    skos:definition "Pungent, heterocyclic, organic liquid derived from coal tar or synthesized. Quinoline is used as a food preservative and in dyes and antiseptics. It is also a useful reagent for the detection of a number of cations as a group reagent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quinoline"@en .

aat:300386747 a skos:Concept ;
    skos:definition "Generally, collateral relatives more distant than a brother or sister. Specifically, the sons or daughters of one's uncle or aunt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cousins"@en .

aat:300386748 a skos:Concept ;
    skos:definition "The children of one's son or daughter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandchildren"@en .

aat:300386749 a skos:Concept ;
    skos:definition "The daughters of one's son or daughter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandaughters"@en .

aat:300386750 a skos:Concept ;
    skos:definition "The sons of one's son or daughter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandsons"@en .

aat:300386751 a skos:Concept ;
    skos:definition "The parents of one's parent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandparents"@en .

aat:300386752 a skos:Concept ;
    skos:definition "The mother of one's parent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandmothers"@en .

aat:300386753 a skos:Concept ;
    skos:definition "The father of one's parent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grandfathers"@en .

aat:300386754 a skos:Concept ;
    skos:definition "The parents of one's grandparents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great grandparents"@en .

aat:300386755 a skos:Concept ;
    skos:definition "The children of one's grandchildren."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "great grandchildren"@en .

aat:300386756 a skos:Concept ;
    skos:definition "One's relatives who are related by marriage rather than by blood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "in-laws"@en .

aat:300386757 a skos:Concept ;
    skos:definition "A mother-in-law is the mother of one's spouse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mothers-in-law"@en .

aat:300386758 a skos:Concept ;
    skos:definition "A father-in-law is the father of one's spouse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fathers-in-law"@en .

aat:300386759 a skos:Concept ;
    skos:definition "A brother-in-law is the brother of one's spouse, or the husband of one's sibling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brothers-in-law"@en .

aat:300386760 a skos:Concept ;
    skos:definition "A sister-in-law is the sister of one's spouse, or the wife of one's sibling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sisters-in-law"@en .

aat:300386761 a skos:Concept ;
    skos:definition "Relatives who are bound to one through the marriage of a blood relative to another person after the death or divorce of the spouse of that blood relative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "step-relatives"@en .

aat:300386762 a skos:Concept ;
    skos:definition "A stepmother is a woman who has married one's father after their natural mother's death or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepmothers"@en .

aat:300386763 a skos:Concept ;
    skos:definition "In geology, the cementing of rock sediments or remains of microscopic marine organisms by the precipitation of minerals (silica, carbonate, iron oxide), which are deposited as microcrystals into the pore spaces. It is the final stage in the formation of sedimentary rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cementation"@en .

aat:300386764 a skos:Concept ;
    skos:definition "A stepfather is a man who has married one's mother after their natural father's death or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepfathers"@en .

aat:300386765 a skos:Concept ;
    skos:definition "A stepbrother is a male child of a step-parent who has married one's parent after thier natural parent's death or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepbrothers"@en .

aat:300386766 a skos:Concept ;
    skos:definition "A stepsister is a female child of a step-parent who has married one's parent after thier natural parent's death or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepsisters"@en .

aat:300386767 a skos:Concept ;
    skos:definition "A stepchild is a child of one's spouse, whom one has married after the child's natural parent's death or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepchildren"@en .

aat:300386768 a skos:Concept ;
    skos:definition "A stepson is a male child of one's spouse, whom one has married after the child's natural parent's death or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepsons"@en .

aat:300386769 a skos:Concept ;
    skos:definition "A stepdaughter is a female child of one's spouse, whom one has married after the child's natural parent's death or divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepdaughters"@en .

aat:300386770 a skos:Concept ;
    skos:definition "Sons of a one's brother or sister."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nephews"@en .

aat:300386771 a skos:Concept ;
    skos:definition "Daughters of a one's brother or sister."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nieces"@en .

aat:300386772 a skos:Concept ;
    skos:definition "Sisters of a one's parent or wives of one's parent's brother."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aunts"@en .

aat:300386773 a skos:Concept ;
    skos:definition "Brothers of a one's parent or husbands of one's parent's sister."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncles"@en .

aat:300386774 a skos:Concept ;
    skos:definition "A machine-supported conservation technique developed by Christopher Clarkson for reattaching book boards which have detached due to very thin covering material at the joints, a problem that frequently arises with nineteenth-century books. A milling machine creates a slot in the spine edge of the board, into which a new cloth flange is inserted to form the new attachment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board slotting"@en .

aat:300386775 a skos:Concept ;
    skos:definition "A son-in-law is the spouse of one's child."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sons-in-law"@en .

aat:300386776 a skos:Concept ;
    skos:definition "A daughter-in-law is the female spouse of one's child."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daughters-in-law"@en .

aat:300386779 a skos:Concept ;
    skos:definition "Style and culture of the White Mountain Apache Tribe of Fort Apache Reservation which occupies parts of Apache, Gila, and Navajo counties, Arizona."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "White Mountain Apache"@en .

aat:300386781 a skos:Concept ;
    skos:definition "Ceramic ware of the late Middle Bronze Age first excavated at Tell el-Yahudiyeh in the eastern Nile Delta of Egypt, but of uncertain origin. The ware, generally black or brown juglets with incised or punctured decoration filled in with white chalk, are widely distributed in a large number of Levantine and Cypriot sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tell el-Yahudiyeh ware"@en .

aat:300386782 a skos:Concept ;
    skos:definition "A borane-amine compound that has been tested as a reducing agent to inhibit degradation of cellulose based materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tert-butyl amine borane"@en .

aat:300386783 a skos:Concept ;
    skos:definition "Pressure-sensitive non-magnetic adhesive tape suitable for splicing magnetic tape. It is attached to the two ends of film or tape to be spliced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splicing tape"@en .

aat:300386784 a skos:Concept ;
    skos:definition "A durable, dense, pink dolerite granite from quarries in and around Porriiño, Galicia, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosa Porriiño granite"@en .

aat:300386785 a skos:Concept ;
    skos:definition "Orthotic devices such as braces or sprints applied externally to the body which limit or control movement of a body part."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orthoses"@en .

aat:300386786 a skos:Concept ;
    skos:definition "People in an executive position in an arts organization or theater company whose responsibilities include making the final choice of the material staged in a season, the hiring of creative and production personnel, and other high level management tasks. For those in non-executive positions who formulate concepts and supervise the execution of the visual appearance of a publication or performing arts production, use \"art directors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artistic directors"@en .

aat:300386787 a skos:Concept ;
    skos:definition "Religion with ancient origins that revolves primarily around the ideologies, mythic visions, and rituals contained in the Vedas, a compilation of religious literature. Vedism is based on the religious ideas and expressions of the Indo-Europeans who gradually entered the valley of the Indus River in successive waves in the second millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vedism"@en .

aat:300386788 a skos:Concept ;
    skos:definition "Sacred literature in the form of a collection of poems or hymns composed in archaic Sanskrit and known to the Indo-European-speaking peoples who entered India during the 2nd millennium BCE. The corpus of Vedic literature includes the Samhitas, the Brahmanas, the Aranyakas, and the Upanishads, and is believed to be derived from divine revelation. The Vedas were long preserved orally, perhaps with now-lost early manuscripts to assist memory. Several of these works are yet today recited with subtleties of intonation and rhythm that have been handed down from the early days of Vedic religion in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vedas"@en .

aat:300386789 a skos:Concept ;
    skos:definition "A major class of silicate minerals and its members which include about twenty mineral species, among them diopside, rhodonite, jadeite. Pyroxenes are found in many igneous and metamorphic rocks. They are distinguished from the second major class of silicate minerals, amphiboles, by their cleavage planes, characterized by prismatic cleavage at nearly 90 degrees, and a structure of single chains of SiO4 tetrahedra as distinct from amphiboles' double chains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyroxene"@en .

aat:300386790 a skos:Concept ;
    skos:definition "Branch of metallurgy which extracts metals from raw materials at high temperatures using processes of reduction, oxidizing, refining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrometallurgy"@en .

aat:300386791 a skos:Concept ;
    skos:definition "Refers to the scientific description and study of rocks, especially at the macroscopic level; as distinct from petrology which deals with microscopic details."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithology"@en .

aat:300386792 a skos:Concept ;
    skos:definition "Bones in the hindlimbs of tetrapods; in humans, the bone that articulates with the acetabulum of the pelvis at the hip, and with the tibia and patella at the knee."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "femurs"@en .

aat:300386793 a skos:Concept ;
    skos:definition "Ancient culture and style of a certain non-Indo-European people who flourished in South Asia, and who continue today in southern India, Sri Lanka, and elsewhere. Among distinguishing characteristics are architectural styles, distinctive clothing and hair styles, and as well as language. Many scholars believe that Dravidian languages are unrelated to any other extant language family, although there is extensive lexical borrowing, with Tamil being the oldest existing Dravidian language. Dravidian loanwords in Sanskrit date to around 1500 BCE, meaning the culture and its influence were firmly established prior to that date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dravidian"@en .

aat:300386794 a skos:Concept ;
    skos:definition "Ancient cultures of the peoples associated with broad class of cognate languages that are still spoken over the greater part of Europe and extending into Asia as far as northern India. Included are the cultures associated with the existing and extinct language families of Anatolian, Hellenic, Indo-Iranian, Italic, Celtic, Germanic, Tocharian, Balto-Slavic, Armenian, Albanian, Illyrian, Venetic, Liburnian, Messapian, Phrygian, Paionian, Thracian, Ancient Macedonian, Ligurian, Sicel, and Lusitanian, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-European"@en .

aat:300386795 a skos:Concept ;
    skos:definition "Refers to the styles that arose under or were influenced by the ideals of the German Nazi regime (1933-1945), particularly regarding inhabitants of Germany and elsewhere who were of what the Nazis considered the white race of ancient Germanic origin, excluding those of Jewish heritage. The ideas have earlier origins, in the 19th-century writings of Joseph-Arthur de Gobineau and others regarding what they perceived as the inferiority of certain races."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aryan"@en .

aat:300386796 a skos:Concept ;
    skos:definition "Refers to the angle at which a liquid or vapor makes contact with a solid surface. Contact angle quantifies the ability of a liquid to maintain contact with a solid surface. It is used, for example, as a measure of comparison for water droplets deposited on a flat stone surface before and after a water repellent coating has been applied to it, the difference in contact angle supplying information about surface hydrophobization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contact angle"@en .

aat:300386797 a skos:Concept ;
    skos:definition "Compound of sulfur and manganese. It occurs naturally as the mineral alabandite. It may be synthesized by reacting ammonium sulfide with a manganese salt. Compound of sulfur and manganese. It occurs naturally as the mineral alabandite. It may be synthesized by reacting ammonium sulfide with a manganese salt. Found as in inclusion in cast iron to which it has been added to aid in solidification."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manganese sulfide"@en .

aat:300386799 a skos:Concept ;
    skos:definition "Curtains located behind the royal door of an iconostasis, separating the nave from the sanctuary. Some Eastern churches have only the curtains without the iconostasis. In Christian theological interpretation, the New Testament reference to the rending of the temple curtains at Jesus' death came to signify his passing through the heavenly boundary, thus the curtain was continued in certain liturgies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iconostasis curtains"@en .

aat:300386800 a skos:Concept ;
    skos:definition "Designates given materials used to close off the reverse side of paintings on canvas. Such materials include but are not limited to simple cardboard, Perspex (acrylic), Melinex (polyester). Backboards are applied either on the stretcher or on the frame, using screws, nails, or tape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backboards"@en .

aat:300386801 a skos:Concept ;
    skos:definition "Insulated enclosures in which conditions such as temperature and humidity are tightly controlled to regulate growth of living things."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incubators"@en .

aat:300386803 a skos:Concept ;
    skos:definition "People or corporate bodies in the manufacturing industry who make jigs, fixtures, dies, molds, machine tools, cutting tools, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tool and die makers"@en .

aat:300386804 a skos:Concept ;
    skos:definition "Trademarked name for an aqueous wax emulsion used as a protective coating for metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Poligen (TM)"@en .

aat:300386805 a skos:Concept ;
    skos:definition "Trademarked name for a moldable, self-sealing plastic film composed of polyolefins and paraffin wax which is permeable to oxygen and carbon dioxide and resistant to many common reagents. It is used as a moisture barrier film for short-term storage. In conservation it has been used to repair splits and as temporary backing for ivory miniatures; and tested as an adhesive for strip lining of twentieth century paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parafilm M (TM)"@en .

aat:300386806 a skos:Concept ;
    skos:definition "Extremely small particles and droplets suspended in air. They may include organic chemicals, acids, metals, and dust or soil particles. Also known as particle pollution, particulate matter is used as a measure of air pollution. The EPA groups inhalable pollutants which pass through the throat and nose and enter the lungs into two categories: “inhalable coarse particles” (between 2.5 micrometers and 10 micrometers in diameter); and “fine particles” (2.5 micrometers in diameter and smaller)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particulate matter"@en .

aat:300386808 a skos:Concept ;
    skos:definition "Any of a class of solvents which has an electronegative nitro group attached to a methane, ethane, or propane molecule. They are also known as nitroalkanes. Nitroparaffins are versatile compounds. They are used as solvent additives in coatings; as a solvent in separation processes; as chemical stabilizers and intermediates; as a component in fuels; to displace water from metal surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nitroparaffin"@en .

aat:300386809 a skos:Concept ;
    skos:definition "A non-woven, acid free viscose fabric stabilized by acrylic binder. It is used for gentle aqueous cleaning of water-sensitive articles, such as paper objects, via capillary action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paraprint OL 60 (TM)"@en .

aat:300386810 a skos:Concept ;
    skos:definition "Visual works created or modified using a computer or other digital medium. These products are exhibited in a variety of ways: statically or as interactive concepts that may reveal or obscure their computer origins. For works that use computer machinery intrinsically as a part of the work, use \"computer art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital art"@en .

aat:300386811 a skos:Concept ;
    skos:definition "Describes safe materials; often chosen deliberately as an alternative to toxic substances traditionally used for some purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nontoxicity"@en .

aat:300386812 a skos:Concept ;
    skos:definition "Photography using digital cameras, which are cameras that acquire images via an electronic sensor and storing them as digital information on a memory device."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital photography"@en .

aat:300386813 a skos:Concept ;
    skos:definition "Architecture that focuses on the design, renovation, and remodeling of golf courses, which are large outdoor areas where the sport of golf is played, consisting of a teeing ground, fairway, rough, hazards, and a series of greens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golf course architecture"@en .

aat:300386814 a skos:Concept ;
    skos:definition "Art that uses new means of mass communication, specifically electronic and digital technology, inclusive of video and other forms of motion and sound media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "new media art"@en .

aat:300386815 a skos:Concept ;
    skos:definition "Artists that use new means of mass communication to create their work, specifically electronic and digital technology, inclusive of video and other forms of graphic, motion picture, and sound media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "new media artists"@en .

aat:300386816 a skos:Concept ;
    skos:definition "People or corporate bodies in the construction industry that undertake work as detailed in a legally binding contractual agreement, and whose services are limited to the construction of commercial buildings and single-dwelling or multiple-dwelling residential buildings. For contractors on a construction project whose services are unlimited, use \"general contractors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "building contractors"@en .

aat:300386818 a skos:Concept ;
    skos:definition "Art works comprising designs or patterns assembled from small pieces of veneer in various shapes, often applied to furnishings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intarsias"@en .

aat:300386819 a skos:Concept ;
    skos:definition "The practice of placing soil and turf on the tops of historic walls as a preservation strategy. Traditionally, “hard caps” of cement have been used, but are not as effective in extreme weather, especially harsh frosts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soft capping"@en .

aat:300386820 a skos:Concept ;
    skos:definition "Paper, prepared as thin strips, containing a reagent that indicates the presence of a specific chemical compound by changing color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indicator paper"@en .

aat:300386821 a skos:Concept ;
    skos:definition "Synthesis of styles and cultures occurring in Portuguese-colonized Goa, India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-Portuguese"@en .

aat:300386822 a skos:Concept ;
    skos:definition "Tools of various designs used for cutting glass by scoring a line on a piece of glass. The scoring makes a split in the surface of the glass, allowing the glass to be snapped or broken along the score."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass cutters"@en .

aat:300386823 a skos:Concept ;
    skos:definition "A tertiary alcohol found in linaloe oil and other essential oils. It is used in perfumery and is a common component of flower odors. In conservation, it is used as a mild antifungal agent on paper, silver photographs, and leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linalool"@en .

aat:300386824 a skos:Concept ;
    skos:definition "A range of means of extending credit, such as small loans with no collateral, to nontraditional clients, chiefly impoverished people in undeveloped areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfinance"@en .

aat:300386825 a skos:Concept ;
    skos:definition "Elegant seaside villas built along the coasts of Italy by members of the Roman elite beginning by the late second century BC. The extravagant pursuits associated with the villa maritima were contrasted in ancient Roman literature with the austere and responsible virtues of its countryside counterpart, the villa rustica, which came equipped with working farm. Villae maritimae generally conformed to one of two basic architectural types, the peristyle and porticus villa plans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villae maritimae"@en .

aat:300386826 a skos:Concept ;
    skos:definition "A hydrated mineral form of sodium sulfate, the sodium salt of sulfuric acid, occuring in nature as colorless prismatic crystals near salt water springs or lakes, and in caves. Mirabilite is unstable and quickly dehydrates when exposed to dry air, turning into the powder thenardite. It owes its name to Johann Rudolph Glauber who dubbed it “sal mirabile” (“wonderful salt”) when he inadvertently synthesized it while working with sulfuric acid and salt. It is also known as Glauber’s salt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mirabilite"@en .

aat:300386827 a skos:Concept ;
    skos:definition "Historic barn design that flourished between the late 19th and early 20th centuries in the United States and Canada. Round barns were built in a variety of shapes: octagonal, polygonal, or circular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round barns"@en .

aat:300386828 a skos:Concept ;
    skos:definition "Islands, surrounded by stream branches or waterways, that have established permanent vegetation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluvial islands"@en .

aat:300386829 a skos:Concept ;
    skos:definition "Narrow gorges or passes between mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defiles"@en .

aat:300386830 a skos:Concept ;
    skos:definition "Faiths that occurred in the early years of Buddhism, in South and Southeast Asia. In Hindu-Buddhism, ideas and dieties of the two faiths were combined, as Buddhism first grew out of Hinduism in India in the 6th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindu-Buddhism"@en .

aat:300386831 a skos:Concept ;
    skos:definition "A series of mountains or mountain ridges closely aligned in formation, direction, and age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain ranges"@en .

aat:300386832 a skos:Concept ;
    skos:definition "Groups of mountain ranges with similarities in form, and thought to have originated from the same geologic events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain systems"@en .

aat:300386833 a skos:Concept ;
    skos:definition "Prehistoric culture of the American Southwest, which flourished from the mid-thirteenth through sixteenth centuries, and was centered in the Tonto Basin of southeastern Arizona. A farming and trading people, the Salado lived in walled adobe compounds, practiced burial (rather than cremation) of their dead, and created distinctive polychrome ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salado"@en .

aat:300386834 a skos:Concept ;
    skos:definition "Low places located in ridges, and not used for transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gaps"@en .

aat:300386836 a skos:Concept ;
    skos:definition "Lines of high ground that separate adjacent drainage basins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divides"@en .

aat:300386837 a skos:Concept ;
    skos:definition "Natural, stone structures that have holes through their centers formed by selective erosion. For similar natural structures that were formed by a current of water, use \"natural bridges.\" Historically, usage of \"natural bridges\" and \"natural arches\" has overlapped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural arches"@en .

aat:300386838 a skos:Concept ;
    skos:definition "Residual landforms, usually located on slopes of valleys, formed by rain erosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural pillars"@en .

aat:300386839 a skos:Concept ;
    skos:definition "Caves that are open at both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural tunnels"@en .

aat:300386840 a skos:Concept ;
    skos:definition "A neutral cellulose derivative, hydroxyethyl cellulose (HEC) is a granular, water-soluble thermoplastic polymer used as an emulsifier, thickener and film former in many types of solutions. It is also used as a sizing material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydroxyethyl cellulose"@en .

aat:300386841 a skos:Concept ;
    skos:definition "Small depressions, hollows, or valleys found in sandy terrain, caused by wind or wind erosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blowouts"@en .

aat:300386842 a skos:Concept ;
    skos:definition "Relatively undissected uplands located in between adjacent stream valleys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interfluves"@en .

aat:300386843 a skos:Concept ;
    skos:definition "Visual works, particularly works of art or high craft, that are created from textile materials, which are plant, animal, and synthetic fibers used in weaving, sewing, knitting, felting, knotting, etc. Textile art uses exclusively, or nearly exclusively, textiles as both the support and media, if any media are applied. Embroidery is a textile art, because the support is textile and also the material used to create the design is a textile. However, in another example, oil paintings are generally painted on canvas, which is a textile material: but oil paintings are not considered textile art because the medium is paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile art"@en .

aat:300386844 a skos:Concept ;
    skos:definition "Hydrazine is a hydronitrogen compound and a powerful reducing agent. It is a colorless liquid synthesized for use in pesticides and as a corrosion inhibitor in boilers. It is also a component in rocket fuels. In conservation, hydrazine has been used to reduce manganese content in medieval stained glass and thus to lighten browning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrazine"@en .

aat:300386845 a skos:Concept ;
    skos:definition "Natural depressions or low areas enclosed by higher land. For tracts of land that have been drained by a river and its tributaries, use \"drainage basins.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basins"@en .

aat:300386846 a skos:Concept ;
    skos:definition "Tapering pieces of land projecting into a body of water, less prominent than a cape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "points"@en .

aat:300386847 a skos:Concept ;
    skos:definition "Visual works created primarily or exclusively from cloth, such as appliqué work and quilting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fabric art"@en .

aat:300386848 a skos:Concept ;
    skos:definition "Narrow projections of land into a body of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spits"@en .

aat:300386849 a skos:Concept ;
    skos:definition "A compound with mineral bonding properties used in aqueous solution for consolidation of mural paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium aluminate"@en .

aat:300386850 a skos:Concept ;
    skos:definition "Style and culture of the region of Attica. For culture particular to the capital of Attica, Athens, use \"Athenian.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Attic"@en .

aat:300386851 a skos:Concept ;
    skos:definition "Land that was formerly an island but is now submerged or no longer surrounded by water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former islands"@en .

aat:300386852 a skos:Concept ;
    skos:definition "Little islands; can also be used to refer to small areas of land that are different in character than the land that surrounds them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "islets"@en .

aat:300386853 a skos:Concept ;
    skos:definition "Configurations of two or more islands that are related by proximity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "island groups"@en .

aat:300386854 a skos:Concept ;
    skos:definition "Areas of dry or relatively dry land or islands surrounded by water or low wetland; island groups considered archipelagos are characterized by compactness and adjacency. The original Greek meaning referred to the water in which such islands were located."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archipelagos"@en .

aat:300386855 a skos:Concept ;
    skos:definition "Connections between two land masses, usually used in a prehistoric context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land bridges"@en .

aat:300386856 a skos:Concept ;
    skos:definition "Interior regions of land that are high in elevation relative to adjacent low-lying areas. Such areas have low to moderate surface relief but are not considered mountainous. Distinct from \"highlands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uplands"@en .

aat:300386857 a skos:Concept ;
    skos:definition "Mountainous or elevated lands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "highlands"@en .

aat:300386858 a skos:Concept ;
    skos:definition "Isolated peaks of bedrock that protrude above a glacier’s surface and are surrounded by glacial ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nunataks"@en .

aat:300386859 a skos:Concept ;
    skos:definition "Bowl-shaped hollows that are partly surrounded by cliffs or steep slopes, and situated at the head of a glaciated valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cirques"@en .

aat:300386860 a skos:Concept ;
    skos:definition "Low areas that are surrounded by higher land and usually characterized by interior drainage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "depressions"@en .

aat:300386861 a skos:Concept ;
    skos:definition "Areas of level land that flank hills, ridges or mountains, where slopes rise on one side, and descend on the opposite level. More specifically can refer to bedrock platforms bounded by steep slopes that overlook bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benches"@en .

aat:300386862 a skos:Concept ;
    skos:definition "The length of river or channel segments, which can be demarcated by their location between two bends or visibility from a single vantage point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reaches"@en .

aat:300386863 a skos:Concept ;
    skos:definition "Asymmetric ridges formed on tilted strata."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuestas"@en .

aat:300386864 a skos:Concept ;
    skos:definition "A barrier layer, or coating, is a reversible bond applied as a film between an irreversible adhesive and the surface it is mated to. In paper conservation, for example, a barrier layer is a thin film, such as gelatin or methylcellulose, deposited between the original paper surface and inpainting media applied to compensate for loss or damage. Such barrier layers allow for reversibility of the inpainting treatments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrier layers"@en .

aat:300386865 a skos:Concept ;
    skos:definition "Flat areas at high altitude that are covered with large angular rocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boulder fields"@en .

aat:300386866 a skos:Concept ;
    skos:definition "The culture and styles of the Semitic tribes who lived in Mesopotamia, Palestine, and Syria in the third and second millennia BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amorite"@en .

aat:300386867 a skos:Concept ;
    skos:definition "Cultures of peole having related languages, presumably derived from a common language, generally including the Arabs, Akkadians, Canaanites, some Ethiopians, and Aramaean tribes including Hebrews. Mesopotamia, the western coast of the Mediterranean, the Arabian Peninsula, and the Horn of Africa have all been proposed as possible sites for the prehistoric origins of Semitic-speaking peoples, but no location has been definitively established. By 2500 BCE Semitic-speaking peoples had become widely dispersed throughout western Asia. In Phoenicia they became seafarers. In Mesopotamia they blended with the civilization of Sumer. The Hebrews settled with other Semitic-speaking peoples in Palestine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Semitic"@en .

aat:300386868 a skos:Concept ;
    skos:definition "Fields or areas of crushed rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gravel fields"@en .

aat:300386869 a skos:Concept ;
    skos:definition "Quantities of rock fractured from mountain cliffs, slopes, or other vertical rock formations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rockfalls"@en .

aat:300386870 a skos:Concept ;
    skos:definition "Areas of lands covered with sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sand areas"@en .

aat:300386871 a skos:Concept ;
    skos:definition "Shallow basins or flats where salt has accumulated after periodic flooding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt areas"@en .

aat:300386872 a skos:Concept ;
    skos:definition "Nationality or culture of the former nation, the Union of Soviet Socialist Republics (USSR). For the nationality of Russia, use \"Russian.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Soviet"@en .

aat:300386873 a skos:Concept ;
    skos:definition "Mounds of earth material massed at the base of a slope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slides"@en .

aat:300386874 a skos:Concept ;
    skos:definition "Ceramic ware made of the material porcelain, which is white kaolin and a feldspathic rock that react when fired to form a natural glass. In China, porcelain ware includes all highly fired ware that produces a ringing sound when struck. In Europe, it is limited to hard-fired ceramic ware that is translucent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain"@en .

aat:300386875 a skos:Concept ;
    skos:definition "Affiliation or culture of the Hanseatic League, or Hanse towns, a historical association of northern German trading towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanseatic"@en .

aat:300386876 a skos:Concept ;
    skos:definition "Any of a class of three-membered cyclic ring ethers including ethylene oxide, propylene oxide, and butylene oxide. Epoxides have been used as a permanent wood preservative treatment based on the chemical modification of the wood components."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epoxide"@en .

aat:300386877 a skos:Concept ;
    skos:definition "A type of plaster composed of calcium oxide (lime). Lime plaster has been used since antiquity, prepared by heating limestone to remove carbon dioxide and convert it to anhydrous calcium oxide (quicklime). When quicklime is mixed with water, it converts to calcium hydroxide (slaked lime)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lime plaster"@en .

aat:300386879 a skos:Concept ;
    skos:definition "Visual works made of ceramic, especially art works in the form of sculptures, vessels, and other decorative and utilitarian objects made of bone china, porcelain, or stoneware. For the general classification of anything made of ceramic, use \"ceramic (object genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramic ware"@en .

aat:300386880 a skos:Concept ;
    skos:definition "Slopes formed by loose rock fragments piled at the base of a cliff or steep slope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talus slopes"@en .

aat:300386881 a skos:Concept ;
    skos:definition "Coastal islands connected to the mainland by barrier beaches, levees, or dikes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "land-tied islands"@en .

aat:300386882 a skos:Concept ;
    skos:definition "Valleys, usually in glaciated areas, with floors that are higher than the valleys themselves, or higher than the shores that they lead to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hanging valleys"@en .

aat:300386883 a skos:Concept ;
    skos:definition "Small, shallow terrestrial depressions or basins located in arid and semiarid regions that contain ephemeral bodies of water from periods of rainfall, leaving residual deposits of salt, sand, or mud. Distinct from \"dry lakes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pans"@en .

aat:300386884 a skos:Concept ;
    skos:definition "Broad, open passes connecting two higher elevations, such as between ridges, hills, or mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddles"@en .

aat:300386885 a skos:Concept ;
    skos:definition "Shallow ridges or mounds of coarse material located in stream channels, as well as at the mouths of streams, estuaries, or lagoons, and along coasts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bars"@en .

aat:300386886 a skos:Concept ;
    skos:definition "Areas of uncultivated dry or wet land that are populated with low vegetation, such as grass and shrubs, and often flat with poor drainage systems. Often associated with regions within the British Isles. Distinct from \"bogs,\" in which the land is regularly wet and comprised of peaty soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moors"@en .

aat:300386887 a skos:Concept ;
    skos:definition "Upland moors or sandy areas dominated by low shrubby vegetation including heather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heaths"@en .

aat:300386888 a skos:Concept ;
    skos:definition "Large masses or areas of solidified, or flowing, erupted magmas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lava flows"@en .

aat:300386889 a skos:Concept ;
    skos:definition "Exposed forests on the earth's surface that have been fossilized by geologic activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fossilized forests"@en .

aat:300386890 a skos:Concept ;
    skos:definition "Treeless areas located in forests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clearings"@en .

aat:300386891 a skos:Concept ;
    skos:definition "Plant communities comprising low trees, bushes, and shrubs, often together with herbs and grasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scrublands"@en .

aat:300386892 a skos:Concept ;
    skos:definition "Physical features located in the oceans below sea level, whether natural or man-made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea features"@en .

aat:300386893 a skos:Concept ;
    skos:definition "Gently inclined slopes rising from the deep ocean towards the foot of continental slopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continental rises"@en .

aat:300386894 a skos:Concept ;
    skos:definition "The state or technique of not having been subjected or exposed to firing. An example is greenware, which is pottery that has not been fired."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unfired"@en .

aat:300386895 a skos:Concept ;
    skos:definition "Areas of broad elevation that rise gently, and generally smoothly, from the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea shelf rises"@en .

aat:300386896 a skos:Concept ;
    skos:definition "Broad elevations on the sea floor that gently rise."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea rises"@en .

aat:300386897 a skos:Concept ;
    skos:definition "Slopes that run seaward from the shelfs edge to the beginning of continental rises, or to points where the slopes are reduced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea slopes"@en .

aat:300386898 a skos:Concept ;
    skos:definition "Mountain ranges located beneath of the surface of the ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea mountain chains"@en .

aat:300386899 a skos:Concept ;
    skos:definition "Undersea elevations that do not break the surface of the ocean. Seamounts rise more than 1,000 meters from the seafloor and are of limited extent across the summit; often but not always formed by extinct volcanoes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seamounts"@en .

aat:300386900 a skos:Concept ;
    skos:definition "Prominent elevations, typically pointed, located beneath the surface of the ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea peaks"@en .

aat:300386901 a skos:Concept ;
    skos:definition "Series of associated undersea ridges or seamounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea ranges"@en .

aat:300386902 a skos:Concept ;
    skos:definition "Long narrow elevations with steep sides, located on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea ridges"@en .

aat:300386903 a skos:Concept ;
    skos:definition "High, narrow, tower-like formations of rock or coral, located beneath the surface of the ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea pinnacles"@en .

aat:300386904 a skos:Concept ;
    skos:definition "Seamounts with flat tops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guyots"@en .

aat:300386905 a skos:Concept ;
    skos:definition "Hills on the sea floor, usually rising more than 500 meters and less than 1,000 meters, and with limited extent across summits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea knolls"@en .

aat:300386906 a skos:Concept ;
    skos:definition "Hills on the sea floor with elevations, usually rising less than 500 meters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea hills"@en .

aat:300386907 a skos:Concept ;
    skos:definition "Low rounded hills located on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea mounds"@en .

aat:300386908 a skos:Concept ;
    skos:definition "Tongue-like extensions of a flat sea floor into adjacent, higher features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea tongues"@en .

aat:300386909 a skos:Concept ;
    skos:definition "Subordinate elevations, ridges, or rises on the sea floor that project outward from larger features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea spurs"@en .

aat:300386910 a skos:Concept ;
    skos:definition "Small terraces below the surface of the ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea benches"@en .

aat:300386911 a skos:Concept ;
    skos:definition "Underwater elevations, typically located on a shelf, covered by relatively shallow water, but sufficient for safe surface navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea banks"@en .

aat:300386912 a skos:Concept ;
    skos:definition "Gradual slopes, typically with a smooth surface, such as those found around island groups and seamounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea aprons"@en .

aat:300386913 a skos:Concept ;
    skos:definition "Smooth features that slope away from the lower termination of canyons, on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea fans"@en .

aat:300386914 a skos:Concept ;
    skos:definition "Areas or mounds of unconsolidated material undersea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea shoals"@en .

aat:300386915 a skos:Concept ;
    skos:definition "Zones adjacent to continents (or around islands) that extend from low water lines to a depth at which there are marked increases of slopes towards oceanic depths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea shelves"@en .

aat:300386916 a skos:Concept ;
    skos:definition "Lines along which there are marked increases of slope, at the outer margins of continental shelves or island shelves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea shelf edges"@en .

aat:300386917 a skos:Concept ;
    skos:definition "Steep to perpindicular slopes on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea cliffs"@en .

aat:300386918 a skos:Concept ;
    skos:definition "Rocky projections or outcroppings on the sea floor, usually located near shore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea ledges"@en .

aat:300386919 a skos:Concept ;
    skos:definition "Low parts of an underwater gap that are separated by basins; includes similar features at the mouthes of fjords."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea sills"@en .

aat:300386920 a skos:Concept ;
    skos:definition "Flat or gently sloping underwater surfaces, extending seaward from shorelines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea platforms"@en .

aat:300386921 a skos:Concept ;
    skos:definition "Flat horizontal or gently inclined surfaces on the sea floor, often long and narrow, and which are bounded by steeper ascending and descending slopes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea terraces"@en .

aat:300386922 a skos:Concept ;
    skos:definition "Flat, gently sloping regions located beneath the surface of the ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea plains"@en .

aat:300386923 a skos:Concept ;
    skos:definition "Underwater, flat areas of a seafloor, usually appearing adjacent to continents and covered with a layer of sediment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abyssal plains"@en .

aat:300386924 a skos:Concept ;
    skos:definition "Undersea mountain systems, including subordinate ranges, basins, and plateaus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea cordilleras"@en .

aat:300386925 a skos:Concept ;
    skos:definition "Relatively shallow, wide depressions, usually with continuous gradient, and located on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea valleys"@en .

aat:300386926 a skos:Concept ;
    skos:definition "Valleys on shelves on the sea floor; generally the shoreward extensions of canyons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea shelf valleys"@en .

aat:300386927 a skos:Concept ;
    skos:definition "Axial depressions of the mid-oceanic ridge system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea median valleys"@en .

aat:300386928 a skos:Concept ;
    skos:definition "Small canyons, located on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea ravines"@en .

aat:300386929 a skos:Concept ;
    skos:definition "Narrow, steep-sided depressions located on the ocean floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea canyons"@en .

aat:300386930 a skos:Concept ;
    skos:definition "Depressions on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea basins"@en .

aat:300386931 a skos:Concept ;
    skos:definition "Low parts of the sea floor that resemble a saddle, located on undersea ridges or between contiguous seamounts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea saddles"@en .

aat:300386932 a skos:Concept ;
    skos:definition "Narrow breaks in ridges on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea gaps"@en .

aat:300386933 a skos:Concept ;
    skos:definition "Small depressions on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea holes"@en .

aat:300386934 a skos:Concept ;
    skos:definition "Currents of running water, located undersea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea channels"@en .

aat:300386935 a skos:Concept ;
    skos:definition "Branches of canyons or valleys on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea forks"@en .

aat:300386936 a skos:Concept ;
    skos:definition "Embankments found near undersea canyons, valleys, or seachannels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea levees"@en .

aat:300386937 a skos:Concept ;
    skos:definition "Culture of the subject Muslims who, during the Christian reconquest of the Iberian peninsula from the Moors in the 11th to 15th centuries, were allowed to retain Islamic laws, customs, and religion and to live in their own quarters in return for owing allegiance and paying tribute to a Christian monarch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mudéjar"@en .

aat:300386938 a skos:Concept ;
    skos:definition "Depressions on the sea floor with characteristically flat bottoms and steep sides; usually more shallow than undersea trenches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea troughs"@en .

aat:300386939 a skos:Concept ;
    skos:definition "Depressions that may not be continuous, located at the base of many seamounts, islands, and other isolated undersea landforms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea moats"@en .

aat:300386940 a skos:Concept ;
    skos:definition "Deep, narrow, asymmetrical depressions on the sea floor, with somewhat steep sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea trenches"@en .

aat:300386941 a skos:Concept ;
    skos:definition "Linear, closed, and shallow depressions on the sea floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea furrows"@en .

aat:300386942 a skos:Concept ;
    skos:definition "Zones of irregular topography on the sea floor, which include ridges, escarpments, or troughs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea fracture zones"@en .

aat:300386943 a skos:Concept ;
    skos:definition "Large groups or systems of stars, gas, and dust, held together by gravitation and matter, that are found throughout the universe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galaxies"@en .

aat:300386945 a skos:Concept ;
    skos:definition "Assemblages of non-stellar objects that are gravitationally bound and orbiting a star or star system. Planetary systems may include one or more planets and other bodies, such as dwarf planets, moons, asteroids, meteoroids, comets, and cosmic dust."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planetary systems"@en .

aat:300386946 a skos:Concept ;
    skos:definition "The style and period of the French Revolution, and the times preceding and following it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Revolutionnaire"@en .

aat:300386947 a skos:Concept ;
    skos:definition "Ideology, doctrines, and practices of the Bolsheviks, who advanced the communistic form of government adopted in Russia in the Bolshevik Revolution of October 1917."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolshevism"@en .

aat:300386948 a skos:Concept ;
    skos:definition "Processes having to do with the carving and working of stone, particularly in the context of building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stonemasonry"@en .

aat:300386949 a skos:Concept ;
    skos:definition "General term for bodies in space that are low enough in mass so that they do not generate nuclear energy in their interior (as a star), and are large enough so their shape is primarily determined by gravity. Examples would be planets, moons, asteroids, and satellites in the outer solar system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planetary bodies"@en .

aat:300386950 a skos:Concept ;
    skos:definition "Planetary-mass objects that are neither a planet nor a moon. As defined by the International Astronomical Union (IAU), a dwarf planet is a celestial body in direct orbit of a star, massive enough for its shape to be controlled by gravitation, but it differs from a planet in that a dwarf planet has not cleared its orbital region of other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dwarf planets"@en .

aat:300386951 a skos:Concept ;
    skos:definition "Relatively large satellites that orbit a planet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moons"@en .

aat:300386952 a skos:Concept ;
    skos:definition "Regions of space where asteroids are found; primarily this refers to the area between Mars and Jupiter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asteroid belts"@en .

aat:300386953 a skos:Concept ;
    skos:definition "Nationality, culture, and styles of the Tungus or Evenki people of eastern Siberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tungus"@en .

aat:300386954 a skos:Concept ;
    skos:definition "Natural satellites that orbit relatively close to their parent planet on a prograde, uninclined circular orbit. Regular satellites are believed to have been formed out of the same collapsing region of the protoplanetary disk that created its primary planet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regular satellites"@en .

aat:300386955 a skos:Concept ;
    skos:definition "In astronomy, moons or other natural satellites having a distant, inclined, eccentric, and retrograde orbit around a planet. Irregular satellites were likely captured by their parent planet rather than having been formed in situ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irregular satellites"@en .

aat:300386956 a skos:Concept ;
    skos:definition "Nationality, styles, and culture of the Tamil people, originally of southern India and speaking Tamil, one of the principal languages of the Dravidian family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tamil"@en .

aat:300386957 a skos:Concept ;
    skos:definition "Objects that are made by humans rather than being natural. Used primarily in the context of distinguishing man-made objects from natural objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "man-made objects"@en .

aat:300386958 a skos:Concept ;
    skos:definition "Structures, which are constructions of any kind artificially fabricated, that no longer exist. Examples include structures known from archaeological evidence or historical records, but now destroyed or lost. For structures that exist in ruins or are abandoned, use \"abandoned structures.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former structures"@en .

aat:300386959 a skos:Concept ;
    skos:definition "Landscapes considered to have picturesque features and a pleasing appearance, generally including natural features and vegetation, with or without manmade structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scenery"@en .

aat:300386960 a skos:Concept ;
    skos:definition "Structures, which are constructions of any kind artificially fabricated, that are deemed significant in the history of architecture or engineering, or that played significant historic roles in local cultural or social development. Includes not just buildings, but other structures, for example oil wells, bridges, docks, and railroads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic structures"@en .

aat:300386961 a skos:Concept ;
    skos:definition "Structures, including constructions of any kind that are fabricated of parts joined together, that formerly were used, but are now deserted by former owners, users, or inhabitants. Includes not just buildings, but other structures, for example oil wells, bridges, docks, and railroads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned structures"@en .

aat:300386962 a skos:Concept ;
    skos:definition "Non-hydraulic lime is a slower setting low cost alternative to hydraulic lime. Whereas hydraulic lime sets by hydrolysis (chemical reaction with water), non-hydraulic lime, also known as 'air lime', sets by carbonation. It needs air to carbonate and thus set. Unlike hydraulic lime, which is powder derived from lime stone containing impurities, non-hydraulic lime is drawn from pure calcium lime stone and turned into a putty through a process of high temperature heating, slaking, and maturing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "non-hydraulic lime"@en .

aat:300386963 a skos:Concept ;
    skos:definition "Ethnicity, culture, and styles of various peoples whose members speak Turkic languages and who are historically connected with the Tujue, the name given by the Chinese to the nomadic people who in the 6th century CE founded an empire stretching from what is now Mongolia and the northern frontier of China to the Black Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkic"@en .

aat:300386964 a skos:Concept ;
    skos:definition "Large mounds of earth or debris that were constructed for ceremonial purposes, usually built by ancient peoples and sometimes with an unknown purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial mounds"@en .

aat:300386965 a skos:Concept ;
    skos:definition "Buoyed channels of sufficient depth for the safe navigation of vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navigation channels"@en .

aat:300386966 a skos:Concept ;
    skos:definition "Reservoirs that have been drained or otherwise no longer exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former reservoirs"@en .

aat:300386967 a skos:Concept ;
    skos:definition "Natural or man-made basins that control the runoff from large storms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flood control basins"@en .

aat:300386968 a skos:Concept ;
    skos:definition "Areas where vessals anchor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchorages"@en .

aat:300386969 a skos:Concept ;
    skos:definition "Man-made slands created by landfill, or diking and filling in a body of water. Human-made islands; examples are those created by landfill or by diking and filling in a wetland, bay, or lagoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial islands"@en .

aat:300386970 a skos:Concept ;
    skos:definition "Elevations, typically located on shelves, over which the depth of water is relatively shallow but sufficient for most surface navigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banks"@en .

aat:300386971 a skos:Concept ;
    skos:definition "Buildings that house schools providing education in theology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seminaries"@en .

aat:300386972 a skos:Concept ;
    skos:definition "Structures, caves, or other accommodations that were designed or adapted for residential occupancy or other personal activity, and that are abandoned by their occupants or owners."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned dwellings"@en .

aat:300386973 a skos:Concept ;
    skos:definition "Sites of the remains of wrecked vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wrecks"@en .

aat:300386974 a skos:Concept ;
    skos:definition "Used for reference to the regions in and around the Pacific Ocean, largest of the world's oceans and situated between North and South America to the east and Asia and Australasia to the west. For reference to the islands and cultures of this area, excluding the ocean itself, typically prefer \"Oceanic (cultures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pacific"@en .

aat:300386975 a skos:Concept ;
    skos:definition "Areas designated for protection by a governing body due to the natural, ecological, or cultural value or fragility of the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protected areas"@en .

aat:300386976 a skos:Concept ;
    skos:definition "Forests administered or protected by an agency of a state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state forests"@en .

aat:300386977 a skos:Concept ;
    skos:definition "Areas containing properties and buildings of historical significance, and extending to include significant natural features as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical parks"@en .

aat:300386978 a skos:Concept ;
    skos:definition "General term for parks that preserve areas associated with military history."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military parks"@en .

aat:300386979 a skos:Concept ;
    skos:definition "Historic sites where significant battles are memorialized; used specifically in reference to Civil War battlefield sites in the United States, some of which are also National Parks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battlefield parks"@en .

aat:300386980 a skos:Concept ;
    skos:definition "General term for facilities that allow the movement of people and goods from one location to another, including rails, roads, bridges, and other facilities for air, rail, road, water, cable, pipeline, and space transport and travel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation infrastructure"@en .

aat:300386981 a skos:Concept ;
    skos:definition "Places or routes where boats, goods, etc., are carried overland between navigable waters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portages"@en .

aat:300386982 a skos:Concept ;
    skos:definition "Culture of the Angami, one of the tribal peoples living in the state of Nagaland, Assam, northeast India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Angami"@en .

aat:300386983 a skos:Concept ;
    skos:definition "Particulars of the place where a person, organization, building, or monument can be found on a street or other thoroughfare; typically consisting of a number, street name, the name of the administrative area (a town or district). May also include a postcode, as the street address may also be the \"mailing address.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street addresses"@en .

aat:300386984 a skos:Concept ;
    skos:definition "Complexes, which are aggregations of buildings, other structures, and/or open spaces, that were formerly occupied but are now deserted by former inhabitants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned complexes"@en .

aat:300386985 a skos:Concept ;
    skos:definition "Essential oil derived from the rind of the bergamot orange, Citrus bergamia, which is cultivated principally in Calabria, southern Italy. The aromatic oil is used in teas, confectionery, and perfumery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bergamot oil"@en .

aat:300386986 a skos:Concept ;
    skos:definition "Conical landforms made of volcanic material or mud."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cones"@en .

aat:300386987 a skos:Concept ;
    skos:definition "Cracks in the earth associated with volcanic activity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fissures"@en .

aat:300386988 a skos:Concept ;
    skos:definition "Narrow, deep slots, grooves, or notches, specifically located in coastal cliffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clefts"@en .

aat:300386989 a skos:Concept ;
    skos:definition "Craters, usually measuring kilometers across, formed by the collapse of a volcanic mountain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calderas"@en .

aat:300386990 a skos:Concept ;
    skos:definition "Areas of shrubs and grasses that are used for grazing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grazing areas"@en .

aat:300386991 a skos:Concept ;
    skos:definition "Circular or bowl-shaped depressions caused by volcanic action, the impact of meteorites or man-made projectiles such as bombs or mines. Craters may exist on earth or other planets and moons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craters"@en .

aat:300386992 a skos:Concept ;
    skos:definition "General term for landforms created by volcanic activity. These include volcanoes, lava flows, calderas, and plutons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "volcanic landforms"@en .

aat:300386993 a skos:Concept ;
    skos:definition "Pits, tunnels, or open-air excavations originally made for underground extraction of metals, metallic ores, coal, or another substance, that are now not used or abandoned."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inactive mines"@en .

aat:300386994 a skos:Concept ;
    skos:definition "Military installations or reservations, or defense-related industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defense installations"@en .

aat:300386995 a skos:Concept ;
    skos:definition "Extensive treeless plains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steppes"@en .

aat:300386996 a skos:Concept ;
    skos:definition "General term for government facilities or complexes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "governmental installations"@en .

aat:300386997 a skos:Concept ;
    skos:definition "Location where two or more streams meet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stream junctions"@en .

aat:300386998 a skos:Concept ;
    skos:definition "Sites considered in the past or present as consecrated or important to a deity or a religion; sites include natural features, such as springs and caves, as well as sites upon which built works have been constructed, such as standing stones and pilgrimage churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacred sites"@en .

aat:300386999 a skos:Concept ;
    skos:definition "Salt encrusted flats or plains subject to periodic inundation from flooding or high tides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabkhas"@en .

aat:300387000 a skos:Concept ;
    skos:definition "Sites that are used for ceremonial purposes; often an ancient site, sometimes the purpose of which is unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial sites"@en .

aat:300387001 a skos:Concept ;
    skos:definition "Consecrated grounds that surround religious sites or places of worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy precincts"@en .

aat:300387002 a skos:Concept ;
    skos:definition "Offshoots of mountain ranges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spurs"@en .

aat:300387003 a skos:Concept ;
    skos:definition "Marshes flooded or overflowed by the sea, typically foliated by grassy, salt-tolerant plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt marshes"@en .

aat:300387004 a skos:Concept ;
    skos:definition "Any place where burials have taken place, generally restricted to human or other hominin burials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial sites"@en .

aat:300387005 a skos:Concept ;
    skos:definition "Sites that contain prehistoric, megalithic monuments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "megalithic sites"@en .

aat:300387006 a skos:Concept ;
    skos:definition "Sites that contain evidence of prehistoric human activity, often through archaeological investigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prehistoric sites"@en .

aat:300387007 a skos:Concept ;
    skos:definition "General term for relatively small and contained places where archeological remains, old structures, or cultural artifacts are or were located."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient sites"@en .

aat:300387008 a skos:Concept ;
    skos:definition "Caves used for human burials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial caves"@en .

aat:300387009 a skos:Concept ;
    skos:definition "Sites that contain evidence of protohistoric human activity, often through archaeological investigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protohistoric sites"@en .

aat:300387010 a skos:Concept ;
    skos:definition "Borehole heat exchangers are used to extract heat stored in the ground by means of a vertical borehole with a “closed loop” collector installation with the help of a geothermal heat pump. A collector hose filled with a carrier fluid is installed in the borehole which is drilled into a geothermal aquifer. This circulating carrier fluid absorbs heat from the surrounding bedrock, which is then extracted by the heat pump for use in space-heating via piping connected to the heat exchanger."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borehole heat exchangers"@en .

aat:300387011 a skos:Concept ;
    skos:definition "Wetlands that appear at intervals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermittent wetlands"@en .

aat:300387012 a skos:Concept ;
    skos:definition "Tracts of land or regions of ice or ocean in the Arctic region of the earth, characterized by distinctively polar conditions of climate, plant, and animal life, and other physical features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arctic areas"@en .

aat:300387013 a skos:Concept ;
    skos:definition "Areas of eroded land characterized by sparse vegetation and uneven terrain. Often used in the plural, referring specifically to regions in the American midwest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "badlands"@en .

aat:300387014 a skos:Concept ;
    skos:definition "Deserts characterized by a surface covering of rock and stones. Examples include desert plains having a surface veneer of gravel and stones or deserts on mesas or plateaus where constant weathering has stripped them of sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rocky deserts"@en .

aat:300387015 a skos:Concept ;
    skos:definition "Deserts comprised of large areas of shifting sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandy deserts"@en .

aat:300387016 a skos:Concept ;
    skos:definition "Places, usually small in size, where man-made features in a transportation network are located, including stations, docks, platforms, and other spot features; excludes roads and tracks. For large communities that are hubs for transportation, use \"transportation centers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transport points"@en .

aat:300387017 a skos:Concept ;
    skos:definition "Stations or inns located on a stage route that provide change of horses for couriers and provisions for passengers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stage stations"@en .

aat:300387018 a skos:Concept ;
    skos:definition "Natural depressions or courses in the Earth's surface that in the past have been filled with water but currently are not filled with water or otherwise do not exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former bodies of water"@en .

aat:300387019 a skos:Concept ;
    skos:definition "Natural depressions or courses in the earth's surface that are filled with water seasonally or for other reasons fluctuate between wet and dry, depending upon rainfall, snowmelt, or other factors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermittent bodies of water"@en .

aat:300387020 a skos:Concept ;
    skos:definition "Natural underground water reservoirs in limestone sinkholes. Examples are in the Yucatán."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cenotes"@en .

aat:300387021 a skos:Concept ;
    skos:definition "Bodies of water located below the earth's surface, such as those found in caves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground lakes"@en .

aat:300387022 a skos:Concept ;
    skos:definition "Rivers located beneath the earth's surface, such as those found in caves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground rivers"@en .

aat:300387023 a skos:Concept ;
    skos:definition "Limestone formed from pelagic sediment, specifically the ancient ocean bottom layer of soft mud, or “ooze,\" made from the shells of dead sea creatures belonging to the genus Globigerina. It is the chief building material of the Maltese islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Globigerina limestone"@en .

aat:300387024 a skos:Concept ;
    skos:definition "Pale yellow, fatty oil made from boiling the shinbones and heels of cattle; used to dress leather and as a lubricant. In conservation, used to restore the elasticity of leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neat's-foot oil"@en .

aat:300387025 a skos:Concept ;
    skos:definition "Terminals that are used for the purpose of transferring, transporting, storing, or processing oil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil terminals"@en .

aat:300387026 a skos:Concept ;
    skos:definition "Parts of bodies of water that are deep enough for navigation through areas that are otherwise not navigable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine channels"@en .

aat:300387027 a skos:Concept ;
    skos:definition "Building or complex where activities having to do with any branch of science take place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific facilities"@en .

aat:300387028 a skos:Concept ;
    skos:definition "Navigable parts of lakes between islands, shoals, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lake channels"@en .

aat:300387029 a skos:Concept ;
    skos:definition "Depressions in the earth that contains water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waterholes"@en .

aat:300387030 a skos:Concept ;
    skos:definition "Bodies of water that flow in a constant circular motion in opposition to the main current."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whirlpools"@en .

aat:300387031 a skos:Concept ;
    skos:definition "Scientific facilities used as bases from which research is carried out or monitored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scientific research bases"@en .

aat:300387032 a skos:Concept ;
    skos:definition "Areas comprising a portion of a watercourse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sections of watercourses"@en .

aat:300387033 a skos:Concept ;
    skos:definition "Points on the earth whose position has been determined by triangulation, typically marked by a concrete pillar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triangulation stations"@en .

aat:300387034 a skos:Concept ;
    skos:definition "Points on the earth characterized by coordinates that are determined by observation of celestial bodies. The expression is usually used in connection with positions on land determined with great accuracy for survey purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical stations"@en .

aat:300387035 a skos:Concept ;
    skos:definition "Sources and upper parts of streams, including upper drainage basins; generally used in plural form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headwaters"@en .

aat:300387036 a skos:Concept ;
    skos:definition "Landforms existing within or extending into a body of water, typically composed of sand, seminent, or pebbles, similar to sandbars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoals"@en .

aat:300387038 a skos:Concept ;
    skos:definition "Portions of bodies of water that are shallow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shallows"@en .

aat:300387039 a skos:Concept ;
    skos:definition "Complexes or structures having as a main purpose the launching of vehicles or rockets into the atmosphere or space, or having other functions having to do with space or air travel, for example designing testing space vehicles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerospace facilities"@en .

aat:300387040 a skos:Concept ;
    skos:definition "Deep areas within the confines of larger features, such as a trough, basin or trench; can refer to such features in the ocean or on land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deeps"@en .

aat:300387041 a skos:Concept ;
    skos:definition "Holes in coastal rock formations through which sea water is forced by the tide or waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blowholes"@en .

aat:300387042 a skos:Concept ;
    skos:definition "Shallow parts of rivers, or tracts of shallow water in general, which can be crossed on foot or by vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fords"@en .

aat:300387043 a skos:Concept ;
    skos:definition "The hollow bed of a stream."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stream channels"@en .

aat:300387044 a skos:Concept ;
    skos:definition "Navigable channels connecting bodies of water with the sea, usually at the mouth of deltas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passes"@en .

aat:300387045 a skos:Concept ;
    skos:definition "Small streams of fast flowing and low turbulence water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runs"@en .

aat:300387046 a skos:Concept ;
    skos:definition "Areas where two or more streams or intermittent streams are joined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confluences"@en .

aat:300387047 a skos:Concept ;
    skos:definition "Politically organized bodies having a single government; usually reserved for primary political units such as nations or empires, or for the upper levels of administration under these primary units, such as states or administrative regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "political entities"@en .

aat:300387048 a skos:Concept ;
    skos:definition "Political entities of any size that are dependent upon another country or power. These political units are generally regarded as territories that are fully or partially subject to the other state. Examples of dependent political entities are American Samoa and Guam, which are dependent on the United States, and Bermuda and the Virgin Islands, which are dependent on the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dependent political entities"@en .

aat:300387049 a skos:Concept ;
    skos:definition "States that are allied with another, usually larger power by a Compact of Free Association or other agreement, by which the states retain international sovereignty and control over their territory but receive benefits, such as protection or economic cooperation. An example is the Marshall Islands, associated with the nation, the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freely associated states"@en .

aat:300387050 a skos:Concept ;
    skos:definition "Areas where a river or any linear body of water curves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bends"@en .

aat:300387051 a skos:Concept ;
    skos:definition "A rock bolt is a steel or fiberglass rod used as a long anchor bolt to stabilize the roof or walls of a rock formation in underground mining and tunneling. It is inserted and anchored in a hole drilled into the rock and transfers load from the exterior to the much stronger interior of the rock mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock bolts"@en .

aat:300387052 a skos:Concept ;
    skos:definition "Political entities of any size that are partially dependent upon another country or power, but typically have a significant extent of control over internal and external affairs. An example is Macau, which, by agreeement, may operate with a high degree of autonomy from China until 2049."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semi-independent political entities"@en .

aat:300387053 a skos:Concept ;
    skos:definition "Political entities of any size that are not independent upon another country or power, and that may exercise the full range of power over external affairs that an independent state possesses as defined under International Law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "independent political entities"@en .

aat:300387054 a skos:Concept ;
    skos:definition "General term for political entities that are typically but not always independent, usually nations or empires, and considered of the highest order or level in a political hierarchical arrangement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary political entities"@en .

aat:300387055 a skos:Concept ;
    skos:definition "Streams that form branches or man-made streams that flow away from the main stream. Examples are deltas and irrigation canals. For streams flowing into and contributing to the flow of a larger body, use \"tributaries (streams).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distributaries"@en .

aat:300387056 a skos:Concept ;
    skos:definition "Streams contributing its flow to a larger stream or lake. For streams flowing away from a larger stream, use \"distributaries (streams).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tributaries"@en .

aat:300387057 a skos:Concept ;
    skos:definition "Points where rivers open into larger bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river mouths"@en .

aat:300387058 a skos:Concept ;
    skos:definition "In the context of international relations, states controlling the foreign relations of a vassal state, but allowing it sovereign authority of its internal affairs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suzerains"@en .

aat:300387059 a skos:Concept ;
    skos:definition "Extensive coverings of ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice sheets"@en .

aat:300387060 a skos:Concept ;
    skos:definition "Depressed areas on icecaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icecap depressions"@en .

aat:300387061 a skos:Concept ;
    skos:definition "Elevated areas on ice caps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "icecap domes"@en .

aat:300387062 a skos:Concept ;
    skos:definition "Nations made up in large part or entirely of islands. Examples are Barbados and Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "island nations"@en .

aat:300387063 a skos:Concept ;
    skos:definition "Bodies of ice that project outward from glaciers or ice sheets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice tongues"@en .

aat:300387064 a skos:Concept ;
    skos:definition "General term for administrative divisions, usually of a nation, that represent the highest unit or level under the nation itself. Examples are the states of the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first level subdivisions"@en .

aat:300387065 a skos:Concept ;
    skos:definition "Places or districts under the jurisdiction of bailiffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bailiwicks"@en .

aat:300387066 a skos:Concept ;
    skos:definition "Designation given to certain municipalities that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous municipality\" varies from nation to nation, and is typically assigned to the municipality by the nation, rather than being assigned by an outside body. Examples of autonomous municipalities are in Mexico and Puerto Rico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous municipalities"@en .

aat:300387067 a skos:Concept ;
    skos:definition "Cities or other administrative areas having the rank of an administrative division higher than other cities. Examples are in South Korea and Lithuania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special cities"@en .

aat:300387068 a skos:Concept ;
    skos:definition "Cities or towns that are not controlled by another local government entity such as a county."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "independent cities"@en .

aat:300387069 a skos:Concept ;
    skos:definition "Designation given to certain cities that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous city\" varies from nation to nation, and is typically assigned to the city by the nation, rather than being assigned by an outside body. Examples of autonomous cities are in South Korea, Russia, and Argentina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous cities"@en .

aat:300387070 a skos:Concept ;
    skos:definition "Channels formed by streams that cut through the necks of meanders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cutoffs"@en .

aat:300387071 a skos:Concept ;
    skos:definition "Particular types of local administrative divisions that have a single tier and are often responsible for all local government functions within their area. Examples are in the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unitary authorities"@en .

aat:300387072 a skos:Concept ;
    skos:definition "Particular type of administrative territorial subdivision. Examples are in Grenada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local councils"@en .

aat:300387073 a skos:Concept ;
    skos:definition "Governing entities that encompass and serve a multi-jurisdictional regional community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional councils"@en .

aat:300387074 a skos:Concept ;
    skos:definition "Particular districts that include limited local areas, as opposed to bigger areas. The term is often used in a generic sense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local districts"@en .

aat:300387075 a skos:Concept ;
    skos:definition "Ceramic ware produced by the Kirkcaldy pottery of David Methven and Sons, decorated in an imitation of Wemyss ware. The Kirkcaldy pottery is near the Fife Pottery which produced Wemyss ware. Abbotsford ware may indeed have been decorated by artists from the Fife Pottery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abbotsford ware"@en .

aat:300387076 a skos:Concept ;
    skos:definition "Distinctive pottery produced near Fukuchiyama in northern Kyushu from the early 17th century onward, including tea untensils and other objects. Characterized by thick white ash and dark brown iron glazes in the early 17th century, and raku and bluish-green copper glazes in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Agano ware"@en .

aat:300387077 a skos:Concept ;
    skos:definition "Manganese silicate occurring as rose-pink or brownish crystals sometimes used as a gemstone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rhodonite"@en .

aat:300387078 a skos:Concept ;
    skos:definition "Ceramics made of the distinctive type of clay found in the Arita area of Japan; first manufactured in the early 17th century. Characterized by early unglazed blue and white porcelain to colorful enamel ware perfected in the 1640s. Arita ware was produced in large quantities in the 17th century and mass-produced by the Meiji period (1868-1912)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arita ware"@en .

aat:300387079 a skos:Concept ;
    skos:definition "Regions administered by local government agencies rather than larger entities. The term is often used in a generic sense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "local regions"@en .

aat:300387080 a skos:Concept ;
    skos:definition "Designation given to certain districts within a nation that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous district\" varies from nation to nation, and is typically assigned to the district by the nation, rather than being assigned by an outside body. Examples of autonomous districts are in Indonesia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous districts"@en .

aat:300387081 a skos:Concept ;
    skos:definition "Particular subdivisions that are under the level of nation. Examples are in the Bahamas and Latvia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national districts"@en .

aat:300387082 a skos:Concept ;
    skos:definition "Particular subdivisions that are under the level of nation. Examples are in Alaska and Myanmar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national divisions"@en .

aat:300387083 a skos:Concept ;
    skos:definition "Particular districts comprising areas outside of urban areas, often in agricultural regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural districts"@en .

aat:300387084 a skos:Concept ;
    skos:definition "Creeks or other channels in a coastal wetland that are subject to bi-directional tidal currents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tidal watercourses"@en .

aat:300387085 a skos:Concept ;
    skos:definition "Particular administrative districts. Examples are in Puerto Rico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senatorial districts"@en .

aat:300387086 a skos:Concept ;
    skos:definition "Lakes that appear at intervals, generally with predictable cycles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermittent lakes"@en .

aat:300387087 a skos:Concept ;
    skos:definition "Level or nearly level areas that occupy the lowers parts of topographical basins. Dry lakes become temporary lakes during periods of rainfall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry lakes"@en .

aat:300387088 a skos:Concept ;
    skos:definition "Streams or distributaries that no longer carry flowing water but whose trace is still evident due to lakes, wetland, topographic, or vegetation patterns along their former course. For watercourses that no longer exist, use \"lost watercourses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned watercourses"@en .

aat:300387089 a skos:Concept ;
    skos:definition "Rivers, streams, creeks, or any other type of watercourses that formerly existed but no longer do, or that currently exist for some distance but then disappear into an underground channel or dry up in an arid area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost watercourses"@en .

aat:300387090 a skos:Concept ;
    skos:definition "Bronze Age culture, style, and period of the western Caucasus which takes its name from the site of a 3rd millennium BCE burial chamber excavated in 1897. Maikop overlaps territorially with Yamna culture to the north. The Maikop people lived in fortress settlements, practiced terrace agriculture, and raised livestock. Maikop grave goods are remarkably rich in silver and gold artifacts, including bull figurines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maikop"@en .

aat:300387091 a skos:Concept ;
    skos:definition "Natural or artificial well-defined channels that carry flowing water; may be either produced by the flowing water or artificially designed to carry flowing water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watercourses"@en .

aat:300387092 a skos:Concept ;
    skos:definition "Particular type of civil administrative divisions. Examples are in the United Kingdom and in the US state, Louisiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parishes"@en .

aat:300387093 a skos:Concept ;
    skos:definition "Porcelain works decorated with a coat of arms as the main decorative motif, particularly Chinese export porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armorial ware"@en .

aat:300387094 a skos:Concept ;
    skos:definition "Particular subdivisions comprising an urban area, usually under the administration or government of a prefect. Examples are in Japan and ancient Rome."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban prefectures"@en .

aat:300387095 a skos:Concept ;
    skos:definition "Roman provinces during the Principate where the Roman Senate had the right to appoint the governor or proconsul."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "senatorial provinces"@en .

aat:300387096 a skos:Concept ;
    skos:definition "Provinces of an empire. Primary examples are the Roman provinces over which the Roman Emperor had the sole right to appoint the governor (legatus Augusti). These provinces were often the strategically located border provinces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial provinces"@en .

aat:300387097 a skos:Concept ;
    skos:definition "Features that were formerly above water but are now underwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submerged features"@en .

aat:300387098 a skos:Concept ;
    skos:definition "Large areas of land that were formerly surrounded by water, such as continents and islands, but now are submerged or otherwise no longer exist as such."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former landmasses"@en .

aat:300387099 a skos:Concept ;
    skos:definition "Features that comprised physical geography, but now no longer exist or are changed from their earlier form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former physical features"@en .

aat:300387100 a skos:Concept ;
    skos:definition "In geology, the fundamental units of lithostratigraphy comprising distinctive assemblages, layers, or units of rock in an area, characterized as being of homogeneous origin and appearance. The designation and limits of a given geological formation may vary, depending upon the criteria imposed by the cataloging body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological formations"@en .

aat:300387101 a skos:Concept ;
    skos:definition "Provinces outside the borders of, but under the jurisdiction and sovereignty of a primary political entity, such as a nation or empire. A historical example was Portugal's Overseas Province of Angola."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overseas provinces"@en .

aat:300387102 a skos:Concept ;
    skos:definition "Nose art is the name given to the talismanic graffiti painted by war theater servicemen on the fuselage of military aircraft, usually located near the nose, for the purpose of individualizing aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nose art"@en .

aat:300387103 a skos:Concept ;
    skos:definition "Fine Roman pottery that is a type of Terra sigillata pottery produced primarily during the Augustine period. Strictly speaking, the term applies only to such pottery produced in Arezzo, Italy, however, it is also used to refer to other Roman pottery found in Italy that imitates the style of Arezzo. It is characterized by a relatively early date, a fine quality, and distinctive patterns and figural compositions, imitating silverware, that were either punched individually with designs or cast from molds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arretine ware"@en .

aat:300387104 a skos:Concept ;
    skos:definition "Tectonic plates that are comprised of continental lithosphere (as opposed to oceanic plates)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continental plates"@en .

aat:300387105 a skos:Concept ;
    skos:definition "Features on earth that comprise physical geography rather than administrative boundaries or manmade built works. May also refer to features on other planets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "physical features"@en .

aat:300387106 a skos:Concept ;
    skos:definition "Early Minoan pottery named for a site near Phaistos, characterized by extensive use of painted lines instead of the earlier scored or burnished patterns and is known in two iterations. In the earlier phase, design typically was made of parallel or crosshatched painted red lines that swept around the curvature of buff clay vessels. In the later phase, painted red decoration was more formally designed, did not relate as much to the round form of the vessel, and typically was composed of crosshatched triangles or other simple geometric designs applied to the upper shoulder of jugs and jars, and to the interior or exterior of bowls and cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ayios Onouphrios ware"@en .

aat:300387107 a skos:Concept ;
    skos:definition "Designation given to certain regions within a nation that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous region\" varies from nation to nation, and is typically assigned to the region by the nation, rather than being assigned by an outside body. Examples of autonomous regions are in China, Finland, Papua New Guinea, India, Iraq, Italy, Mexico, Greece, the Philippines, and several other places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous regions"@en .

aat:300387109 a skos:Concept ;
    skos:definition "Designation given to certain provinces within a nation that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous province\" varies from nation to nation, and is typically assigned to the province by the nation, rather than being assigned by an outside body. Examples of autonomous provinces are in Indonesia, Serbia, Italy, and South Korea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous provinces"@en .

aat:300387110 a skos:Concept ;
    skos:definition "Designation given to certain divisions within a nation that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous republic\" varies from nation to nation, and is typically assigned to the division by the nation, rather than being assigned by an outside body. Examples of autonomous republics are found in the successor states of the Soviet Union, including Azerbaijan, Georgia, Tajikistan, Ukraine, and Uzbekistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous republics"@en .

aat:300387111 a skos:Concept ;
    skos:definition "Designation given to certain sectors within an administrative division that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous sectors\" varies from nation to nation, and is typically assigned to the sector by the nation, rather than being assigned by an outside body. Examples of an autonomous sector is found in Guinea-Bissau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous sectors"@en .

aat:300387112 a skos:Concept ;
    skos:definition "Pottery created by the Bandkeramik Central European Neolithic culture. It is characterized by decorations of incised bands of lines, strokes, and indentations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banded ware"@en .

aat:300387113 a skos:Concept ;
    skos:definition "Designation given to certain communities within a nation that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. The precise definition of \"autonomous community\" varies from nation to nation, and is typically assigned to the community by the nation, rather than being assigned by an outside body. Examples of autonomous communities are in Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous communities"@en .

aat:300387114 a skos:Concept ;
    skos:definition "General term for the styles and cultures of the Paleo-Indians of the Americas; also may refer generally to any of the cultures of Americas prior to the arrival of European colonists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient American"@en .

aat:300387115 a skos:Concept ;
    skos:definition "Generic term for subdivisions under the level of nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national subdivisions"@en .

aat:300387116 a skos:Concept ;
    skos:definition "Administrative areas of particular kinds. An example is in Nairobi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special areas"@en .

aat:300387117 a skos:Concept ;
    skos:definition "Territories, usually non-self-governing, that lie outside the borders of the nation to which they are bound, but typically not so distant as overseas territories"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "external territories"@en .

aat:300387118 a skos:Concept ;
    skos:definition "Territories that are defined in United States law as under the control of the government of the USA, and where fundamental rights apply as a matter of law, but certain other constitutional rights are not available. Examples are Puerto Rico and Guam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unincorporated territories"@en .

aat:300387119 a skos:Concept ;
    skos:definition "Pottery first created in the late 18th century by the merchant Numani Rozan near Kuwana in Ise and later continued inTokyo; now manufactured in and around Yojjaichi, Mie Prefecture. Productions typically include tea ceremony wares, dishes, bowls and candlesticks covered with a pale yellow milky glaze and decorated with a three-color design mostly of red, green and blue or purple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Banko ware"@en .

aat:300387120 a skos:Concept ;
    skos:definition "Territories outside the borders of, but under the jurisdiction and sovereignty of a primary political entity, such as a nation or empire. Examples include territories held by Australia, Denmark, France, the United Kingdom, and the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overseas territories"@en .

aat:300387121 a skos:Concept ;
    skos:definition "Administrative departments outside the borders of, but under the jurisdiction and sovereignty of a primary political entity, such as a nation or empire. An example is the overseas department of France, French Guiana."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overseas departments"@en .

aat:300387122 a skos:Concept ;
    skos:definition "Particular types of administrative divisions. Examples are in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "union territories"@en .

aat:300387123 a skos:Concept ;
    skos:definition "Territories that are ruled directly by a central government within a federation. Examples are in Venezuela and Malaysia. For entities that are part of a federation and that share sovereignty, use “federated states.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federal territories"@en .

aat:300387124 a skos:Concept ;
    skos:definition "Administrative territories having the primary purpose of containing the federal capital. Examples are in Nigeria and Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federal capital territories"@en .

aat:300387125 a skos:Concept ;
    skos:definition "Ceramic ware produced in and around the village of Inbe, Bizen Province (now Okayama Prefect), Japan, including kitchen mortars (suribachi), narrow-necked jars (tsubo), wide-necked jars (kame), agricultural wares in graded sizes, and other objects. By the 14th and 15th centuries, Bizen ware was among the most widely traded in western Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bizen ware"@en .

aat:300387126 a skos:Concept ;
    skos:definition "Territories that have historical, geographical, or political special status within or outside a primary political entity; the special status may be established by treaty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special territories"@en .

aat:300387127 a skos:Concept ;
    skos:definition "Political subdivisions in the modern day country of Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eparchies"@en .

aat:300387128 a skos:Concept ;
    skos:definition "Nationality or culture of Honduras (formerly Spanish Honduras) in Central America. For the nationality and culture of the nation that was formerly British Honduras, use \"Belizean.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Honduran"@en .

aat:300387130 a skos:Concept ;
    skos:definition "General designation for any autonomous place within the sphere of a larger adminisrative entity. Specifically, the term is given to certain divisions within a nation that have a degree of independence, administer their own affairs, or are otherwise self-governing to some degree. In this context, the precise definition of \"autonomous area\" varies from nation to nation, and is assigned to the area by the nation rather than being assigned by an outside body. Examples of autonomous areas in this sense are in Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autonomous areas"@en .

aat:300387131 a skos:Concept ;
    skos:definition "Particular subdivisions under a region. Examples are in Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional divisions"@en .

aat:300387132 a skos:Concept ;
    skos:definition "Computers intermediate in size between a laptop and a smartphone that use a touch-activated screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tablet computers"@en .

aat:300387133 a skos:Concept ;
    skos:definition "Countries that are economically, politically, or militarily dependent on a more powerful country or empire. The term is one of several terms with overlapping meanings used to describe the subordination of one state to a more powerful state in international affairs. Examples of client states are Cappadocia as affiliated with the Roman Republic and Poland as affiliated with the Soviet Union."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "client states"@en .

aat:300387134 a skos:Concept ;
    skos:definition "General term for dependent communities, nations, or territories that are under the protection or domination of a foreign power, but where this relationship is not necessarily defined by international treaty. To distinguish such entities that are bound by international treaty, use \"protectorates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protected states"@en .

aat:300387136 a skos:Concept ;
    skos:definition "Regions in one country that are controlled by another country or power. An example of a historical controlled region was when the Dutch controlled Taiwan in the 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "controlled regions"@en .

aat:300387137 a skos:Concept ;
    skos:definition "States that are subordinate to the ruler of another state, usually providing military assistance or tribute to the dominant state. Examples are Troy, which was a vassal state of the Hittites, and historical Tibet, which was a vassal state of China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vassal states"@en .

aat:300387138 a skos:Concept ;
    skos:definition "Territories subject to a king or ruler; often refers particularly to countries outside of the United Kingdom that are under the sovereignty of England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dominions"@en .

aat:300387139 a skos:Concept ;
    skos:definition "Territories belonging to or recently having belonged to one political entity, but through military occupation or other provisional control are held by another political entity without the volition of original entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupied territories"@en .

aat:300387140 a skos:Concept ;
    skos:definition "Areas area that are neutral, not claimed by any political power, often created as buffer zones between powers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutral zones"@en .

aat:300387141 a skos:Concept ;
    skos:definition "Inorganic compound applied as a metal-specific nonaqueous antioxidant treatment to stabilize iron gall ink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetrabutylammonium bromide"@en .

aat:300387142 a skos:Concept ;
    skos:definition "Territories for which jurisdiction is in dispute between two or more powers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disputed territories"@en .

aat:300387143 a skos:Concept ;
    skos:definition "Areas or districts on or near the border between two countries or districts. An example is the border area district between England and Scotland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borderlands"@en .

aat:300387144 a skos:Concept ;
    skos:definition "Distinct territories that are surrounded by foreign dominions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enclaves"@en .

aat:300387145 a skos:Concept ;
    skos:definition "General term for administrative divisions, usually of a nation, that represent the second highest unit or level under the nation itself, under the first level subdivision. Examples are the counties of the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second level subdivisions"@en .

aat:300387147 a skos:Concept ;
    skos:definition "The process of wrapping a flat, flexible work or material around a cylinder or onto itself for the purpose of storage or transport. Examples include the following: the rolling of scrolls around a rod or onto themselves; the rolling of drawn, painted, printed, or inscribed works on parchment, paper, or canvas; the rolling of textiles, film, or other flexible works or materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rolling"@en .

aat:300387148 a skos:Concept ;
    skos:definition "Early Roman pottery that is characterized by having a fine, hard, and thin fabric, generally made of reddish clay that may be fired brownish gray and may contain some mica."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brittle ware"@en .

aat:300387149 a skos:Concept ;
    skos:definition "Etruscan pottery made between the end of the 7th and the beginning of the 5th centuries BCE. Produced as a substitute for metalware, its forms, decorative motifs, black color, and polished finish mimic the style of metalware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bucchero ware"@en .

aat:300387150 a skos:Concept ;
    skos:definition "Hellenistic pottery, usually vessels such as cups, bowls, or lamp feeders, decorated with distinctive relief designs. The ware originated in Cales, Caserta, Italy. It is characterized by reliefs that imitate metal work, often taken from molds that copied contemporary Hellenistic and earlier prototypes. In other cases reliefs are appliqué work that has been applied to black-glazed vases of various shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Calene ware"@en .

aat:300387151 a skos:Concept ;
    skos:definition "Trademarked name for a nontoxic method of insect eradication that uses a microprocessor-based system that targets susceptibility of insects to elevated temperatures while keeping moisture content and dimensions of organic materials stable during heating. In conservation, used for eradication of woodworm and moths in art and antiques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thermo Lignum (TM)"@en .

aat:300387152 a skos:Concept ;
    skos:definition "Hellenistic pottery characterized by very sumptuous decoration, combining plastic ornamentation with painted decoration in a technique where white slip covers the surface and design is added in tempera colors. It is named after the town of Canosa, Apulia, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canosa ware"@en .

aat:300387153 a skos:Concept ;
    skos:definition "Hellenistic pottery characterized by the use of a combination of relief decoration and painted scenes, which are distinctive in depicting figures painted in various colors, imitating mural paintings. The name refers to a site at Centuripe, Sicily."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Centuripe ware"@en .

aat:300387154 a skos:Concept ;
    skos:definition "Porcelain ware made in China and shipped to France by the Compagnie des Indes. It is distinguished by the use of shapes derived from metal or silver models and European style decoration, sometime taken from contemporary engravings"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Compagnie des Indes ware"@en .

aat:300387155 a skos:Concept ;
    skos:definition "Any of a class of wash-fast sulfur-containing synthetic organic dyes dissolved in a heated alkaline bath of sodium sulfide and then absorbed by cellulose fibers to which they are applied; they are made insoluble within the fibers by oxidation upon exposure to air. They are the dyes most commonly used for cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfur dye"@en .

aat:300387156 a skos:Concept ;
    skos:definition "Middle Minoan pottery characterized by the use of new technology, the potter's wheel, to create sophisticated shapes that have extremely delicate walls, so thin as to be reminiscent of an eggshell. It was produced primarily at the palaces of Knossos, Phaistos, and Mallia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggshell ware"@en .

aat:300387157 a skos:Concept ;
    skos:definition "Ancient pottery, typically goblets, produced on the Greek mainland between circa 1600 and 1050 BCE, and characterized by a single, abstract, decorative element often representing marine or plant life, on an otherwise plain surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ephyraean ware"@en .

aat:300387159 a skos:Concept ;
    skos:definition "Pottery, usually large buff ware vessels, from 5th millennium BCE in Anatolia, distinguished by thick walls and a gritty face."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gritty buff ware"@en .

aat:300387160 a skos:Concept ;
    skos:definition "Stoneware manufactured from the early 17th century in Nagato Province, now Yamaguchi Prefecture. It is distinguished by having thickly formed bowls, typically for tea, flaring from foot to lip and set on a sometimes notched foot rim and covered with a semi-transperent feldspathic glaze. It was called Matsumoto ware or Fukawa ware until 1668."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hagi ware"@en .

aat:300387161 a skos:Concept ;
    skos:definition "Blue-and-white Japanese porcelain manufactured at the Mikawachi kilns for the Prince of Hirado. Productions are usually small and of fine quality with the finest pieces made between 1751 and 1830. Only low-grade pieces made after 1843 are marked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hirado ware"@en .

aat:300387162 a skos:Concept ;
    skos:definition "Used generally for porcelain produced in Hizen province (now Saga prefecture), Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hizen ware"@en .

aat:300387163 a skos:Concept ;
    skos:definition "Unglazed Japanese pottery manufactured at kilns in the Mie Prefecture at the close of the 16th century and the beginning of the 17th century. Productions are typically tea untensils, flower vases and water jugs, with vigorous spatula marks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iga ware"@en .

aat:300387164 a skos:Concept ;
    skos:definition "Arita porcelain ware made from the beginning of the 18th century onwards, characterized by dense, crowded decorations based on native textiles and brocades, painted in several colors, typically with a blackish underglaze and strong blues and reds. It is so named for the port of Imari from where it is shipped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Imari ware"@en .

aat:300387165 a skos:Concept ;
    skos:definition "Japanese porcelain produced in the Arita district of Hizen province by the Sakaida family during the Tokugawa period. Wares were generally of hexagonal, octagonal, or square shape. They initially featured an underglaze blue-and-white, and later a polychrome overglaze technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kakiemon ware"@en .

aat:300387166 a skos:Concept ;
    skos:definition "Middle Minoan pottery found mainly at Knossos, Phaistos, and the Kamáres cave sanctuary, for which it is named. It is characterized by a dark lustrous ground to which ornament is added in red and white, with sophisticated designs in curvilinear abstract patterns, and stylized plant, marine, and figural motifs. It often employed the distinctive compositional device of torsion, where the balance of opposing compositional forces was emphasized, for example, with two opposed diagonal compositions twisting around the vase. The potter's wheel was generally used for smaller vessels, and larger vessels were made by hand using the older method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kamares ware"@en .

aat:300387167 a skos:Concept ;
    skos:definition "Glazed pottery manufactured at Karatsu, Hizen Province, in the late 16th century. Early productions are typically untensils for everyday use, grainy in texture and painted with neutral feldspathic glaze. Later productions, after Korean potters were brought to Japan, were mostly fine tea sets with contrasting glazes, underglaze painting, and inlay designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karatsu ware"@en .

aat:300387168 a skos:Concept ;
    skos:definition "Japanese porcelain ware that was developed in the 18th century in modern-day Hakoda, within the city of Kasama. Ware includes a household goods, kitchen containers, mixing bowls, and jugs; after WW II, export goods such as tea vessels, flower vases, and sake containers were manufactured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kasama ware"@en .

aat:300387169 a skos:Concept ;
    skos:definition "Attic Greek red-figure pottery, primarily vases, found at Kerch in the Ukraine and North Africa. It is characterized by the adoption of new techniques, the use of gold and other colors, and tall figures. The term was first applied in the 19th century, but is rarely used by modern scholars, who generally do not feel that the common characteristics of the individual painters are distinctive enough to define a separate style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kerch ware"@en .

aat:300387170 a skos:Concept ;
    skos:definition "Japanese porcelain manufactured in Kaga Province, now part of Ishikawa Prefecture from 1655 to 1704 and again from 1807 to the present. Older productions are typically tableware in dark overglazed enamels, the bodies being coarse-grained and the glazes varying from dull to shiny. Later productions feature more eclectic, colorful, and intricate designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kutani ware"@en .

aat:300387171 a skos:Concept ;
    skos:definition "Societies or groups of people characterized by common ideas, customs, social behavior, products, or way of life within a particular nation, people, or period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural groups"@en .

aat:300387172 a skos:Concept ;
    skos:definition "Particular subdivisions of a nation. Examples are in Saudi Arabia and Slovakia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national regions"@en .

aat:300387174 a skos:Concept ;
    skos:definition "Nations whose residents, or some portion thereof, exercise self-government and hold sovereignty over their territory. Examples are the nations listed by the United Nations as having undisputed sovereignty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "independent sovereign nations"@en .

aat:300387175 a skos:Concept ;
    skos:definition "Nations whose residents, or some portion thereof, exercise self-government, and usually but not always hold sovereignty over the territory. To specifically designate independent nations having sovereignty, use \"independent sovereign nations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "independent nations"@en .

aat:300387176 a skos:Concept ;
    skos:definition "General term for states that do not exercise a full range of power over external affairs. For dependent territories and other political units, \"dependencies\" may be used, although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dependent states"@en .

aat:300387177 a skos:Concept ;
    skos:definition "Societies or groups of people who once existed and were characterized by common ideas, customs, or social behavior within a particular nation or people and period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical cultural groups"@en .

aat:300387178 a skos:Concept ;
    skos:definition "Areas that were bound in the past by culture, economics, topography, or another characteristic, and that have historical importance. For administrative areas that are officially designated by a governmental or preservation body as of historic importance, use \"historic districts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historical regions"@en .

aat:300387179 a skos:Concept ;
    skos:definition "Divisions of a political entity, of any administrative level, that formerly were in place but are now defunct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former administrative divisions"@en .

aat:300387180 a skos:Concept ;
    skos:definition "Domains of a burgrave, who is a person in medieval Germany and later who was appointed as the judicial and military representative of the king in a fortified town and the surrounding domain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burgraviates"@en .

aat:300387181 a skos:Concept ;
    skos:definition "Political entities having a democratic form of government in which the party or a coalition of parties with the greatest representation in the parliament form the government, its leader becoming prime minister or chancellor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parliamentary democracies"@en .

aat:300387182 a skos:Concept ;
    skos:definition "States or principalities under the rule of a despot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "despotates"@en .

aat:300387183 a skos:Concept ;
    skos:definition "Political entities having governments in which the political power resides with the military."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miltary regimes"@en .

aat:300387184 a skos:Concept ;
    skos:definition "Territories that are ruled by a grand duke or grand duchess."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grand duchies"@en .

aat:300387185 a skos:Concept ;
    skos:definition "Territories or domains ruled by an earl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earldoms"@en .

aat:300387186 a skos:Concept ;
    skos:definition "Territories under the sovereignty of feudal lords; also designate specific districts or provinces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lordships"@en .

aat:300387187 a skos:Concept ;
    skos:definition "The process of decorating fabrics by applying a thick paste of dye or pigment. Major methods of textile printing include: block printing (design raised in relief on a flat surface); stencil or screen printing (cutting the design through a flat sheet of paper or metal); roller printing (engraved printing rollers, one for each color, are pressed against the fabric). In each, the dye or pigment is first applied, and then fixed, usually by steaming or heating; at which point excess color is removed by washing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile printing"@en .

aat:300387188 a skos:Concept ;
    skos:definition "Political entities having a strong monarch in the executive branch, but also having a parliament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parliamentary monarchies"@en .

aat:300387189 a skos:Concept ;
    skos:definition "Political entities havin democratic governments in which a nonpolitical monarch acts as head of state within the boundaries of a constitution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constitutional monarchies"@en .

aat:300387190 a skos:Concept ;
    skos:definition "Administrative bodies subject to a lord superior or a supreme lord, such as a feudal superior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overlordships"@en .

aat:300387191 a skos:Concept ;
    skos:definition "Political entities in which a small group of people rule, usually a a few people or families. In later usage, frequently restricted to rule by the wealthy elite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oligarchies"@en .

aat:300387192 a skos:Concept ;
    skos:definition "The provinces or jurisdictions of a patriarch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patriarchies"@en .

aat:300387193 a skos:Concept ;
    skos:definition "Principalities for which genealogical inheritance has been replaced by succession of a religious office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecclesiastical principalities"@en .

aat:300387194 a skos:Concept ;
    skos:definition "Political entitites officially bound in agreement to a joint action or policy. The European Union is an example."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unions"@en .

aat:300387195 a skos:Concept ;
    skos:definition "Districts under the jurisdiction of a church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ecclesiastical districts"@en .

aat:300387196 a skos:Concept ;
    skos:definition "Areas of jurisdiction of a deacon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deaconries"@en .

aat:300387197 a skos:Concept ;
    skos:definition "Districts under ecclesiastical control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archdeaconries"@en .

aat:300387198 a skos:Concept ;
    skos:definition "General term for administrative divisions, usually of a nation, that represent the third highest unit or level under the nation itself, typically under the second level subdivision. Examples are in Italy and China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "third level subdivisions"@en .

aat:300387199 a skos:Concept ;
    skos:definition "General term for administrative divisions, usually of a nation, that represent the fourth highest unit or level under the nation itself, typically under the third level subdivision. Examples could be townships in the United States, which are smaller than counties, the third level subdivisions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourth level subdivisions"@en .

aat:300387200 a skos:Concept ;
    skos:definition "Inhabited areas that are directly under an adminisrative division but typically not within a city. Examples are in the Netherlands and Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locales"@en .

aat:300387201 a skos:Concept ;
    skos:definition "Administrative centers of operation. Used often to refer to military headquarters or installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bases"@en .

aat:300387202 a skos:Concept ;
    skos:definition "Process of decorating or painting scenes on porcelain by applying mineral pigments blended in a medium to the surface, usually glazed. After the porcelain has been painted, it is fired again. The process typically includes several stages of painting and firing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain painting"@en .

aat:300387203 a skos:Concept ;
    skos:definition "Settlements comprising groups or bodies of people who live together but have not organized into a village or town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communities"@en .

aat:300387204 a skos:Concept ;
    skos:definition "Paintings of scenes or decorations on a support, usually an object, made of porcelain, which is an impermeable translucent ceramic material. Mineral pigments blended in a medium are used to create the paintings, and the work is fired multiple times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain paintings"@en .

aat:300387205 a skos:Concept ;
    skos:definition "Areas, often of undefined boundaries. that are typically directly under the administration of a city. Examples are in the United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "localities"@en .

aat:300387206 a skos:Concept ;
    skos:definition "Ancient Greek visual works comprising pottery objects on which black decoration appears silhouetted on a red ground. Details were incised into the black figures or applied in purple or white pigment. The works gave way to red-figure vase paintings. Works appeared by 720 BCE in Corinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-figure vase paintings"@en .

aat:300387207 a skos:Concept ;
    skos:definition "Ancient Greek visual works comprising pottery objects having primarily black decoration on a red ground, with figures reserved in red. Details were painted on the red of the background clay, allowing overall more sophisticated works than with black-figure vase paintings. Works appeared in Athens ca. 530 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red-figure vase paintings"@en .

aat:300387208 a skos:Concept ;
    skos:definition "Technique used on Ancient Greek pottery in which background and outlines of the figures were painted in black slip, leaving the design in the void of the background red clay, thus the figures were red in color. Details could be added in black with a brush, leading to greater sophistication than with black-figure vase painting. It appeared in Athens ca. 530 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red-figure vase painting"@en .

aat:300387209 a skos:Concept ;
    skos:definition "Technique used on Ancient Greek pottery in which black decoration appears silhouetted on a red ground through painting and a two-stage firing process. In the process, a refined slip of clay, iron oxide, wood ash, and rain water was used to paint decorations on the object. Details were incised into the black figures or applied in purple or white pigment. It developed in Corinth ca. 720 BCE; the technique was later replaced by the more sophisticated red-figure vase painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-figure vase painting"@en .

aat:300387210 a skos:Concept ;
    skos:definition "Communities, usually small in size, located outside urban areas in isolated or undeveloped areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rural communities"@en .

aat:300387212 a skos:Concept ;
    skos:definition "Ancient walled towns or fortresses, particularly in Germany; also can refer generically to contemporary towns or cities that are growing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burgs"@en .

aat:300387213 a skos:Concept ;
    skos:definition "Municipal areas having special administrative ranking. Examples are in Taiwan, the Netherlands, and Cuba."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "special municipalities"@en .

aat:300387214 a skos:Concept ;
    skos:definition "Types of Roman planned settlements that were designed as regional market towns having a forum, basilica, and facilities for administrative and economic management. They were distinguished from settlements that arose ad hoc around military garrisons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "civitates"@en .

aat:300387215 a skos:Concept ;
    skos:definition "Historical European settlements, generally dating from the Medieval period through the 18th century, that were established by a ruler, usually by charter, in a previously undeveloped area. The purpose of a ville neuve was typically to populate and secure territory or expand borders. If the historical settlement was fortified, use \"bastides.\" For modern planned towns developed in previously unpopulated areas, use \"new towns (modern settlements).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "villes neuves"@en .

aat:300387216 a skos:Concept ;
    skos:definition "Settlements used for the isolation and treatment of people with leprosy, historically used to prevent the spread of the disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leper colonies"@en .

aat:300387217 a skos:Concept ;
    skos:definition "Nautical channels or routes where ships can pass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passages"@en .

aat:300387218 a skos:Concept ;
    skos:definition "Principal centers of any size that are seats of government for an administrative area, including towns, cities, or municipalities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capitals"@en .

aat:300387219 a skos:Concept ;
    skos:definition "Capital towns or cities for the jurisdiction of a nation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "national capitals"@en .

aat:300387220 a skos:Concept ;
    skos:definition "Capital towns or cities for administrative regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regional capitals"@en .

aat:300387221 a skos:Concept ;
    skos:definition "Capital towns or cities for administrative states."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "state capitals"@en .

aat:300387222 a skos:Concept ;
    skos:definition "Capital towns or cities for administrative districts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "district capitals"@en .

aat:300387223 a skos:Concept ;
    skos:definition "Capital towns or cities for administrative provinces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "provincial capitals"@en .

aat:300387224 a skos:Concept ;
    skos:definition "Ridges on sea beds that separate bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sills"@en .

aat:300387225 a skos:Concept ;
    skos:definition "Capital towns or cities for administrative departments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "department capitals"@en .

aat:300387226 a skos:Concept ;
    skos:definition "Capital towns or cities for administrative subregions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subregional capitals"@en .

aat:300387227 a skos:Concept ;
    skos:definition "The practice and technique of applying designs in pigment on pottery, which are objects made of hard, brittle, heat-resistant and corrosion-resistant materials. Pottery painting is usually followed by firing of the pottery to make the design permanent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery painting"@en .

aat:300387228 a skos:Concept ;
    skos:definition "Works comprising designs of scenes painted on pottery, which includes various objects made of hard, brittle, heat-resistant, and corrosion-resistant materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pottery paintings"@en .

aat:300387229 a skos:Concept ;
    skos:definition "Permanent purple pigment historically used to make ruby glass and to create vitreous ceramic glazes used in painting, porcelain, and coloring enamels. It is synthesized by precipitating fine gold particles onto tin oxide particles. Adding potassium carbonate to the solution deepens the purple hue. The pigment is named for Andreas Cassius who first made it in 1676. It was largely replaced in the 19th century by the less costly equivalent cobalt violet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purple of Cassius"@en .

aat:300387230 a skos:Concept ;
    skos:definition "Temporary settlements used for laborers during railroad construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad camps"@en .

aat:300387231 a skos:Concept ;
    skos:definition "Inhabited places established in areas that are newly colonized or under the rule of a colonial power."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonial settlements"@en .

aat:300387232 a skos:Concept ;
    skos:definition "Inhabited places established as an outpost or for another reason on the frontier of a nation, empire, or other ruling entity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontier settlements"@en .

aat:300387233 a skos:Concept ;
    skos:definition "Towns that are market centers for cattle; also used to refer to isolated, provincial small towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cow towns"@en .

aat:300387234 a skos:Concept ;
    skos:definition "Towns where the principal industry is the mining and refining of precious metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold towns"@en .

aat:300387235 a skos:Concept ;
    skos:definition "Cities or towns that are the seat of a bishop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "episcopal sees"@en .

aat:300387236 a skos:Concept ;
    skos:definition "The seat of an archbiship, the capital of his area of jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archiepiscopal sees"@en .

aat:300387237 a skos:Concept ;
    skos:definition "The seat of a patriarch, the capital of his area of jurisdiction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patriarchal sees"@en .

aat:300387238 a skos:Concept ;
    skos:definition "Settlements of any kind with defensive structures such as moats, enclosures, or ramparts. Fortification became necessary from the Neolithic period onward, as people began to settle in one place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fortified settlements"@en .

aat:300387239 a skos:Concept ;
    skos:definition "Inhabited places that are the seats of an empire or sovereign or independent states directly under the control of an emperor. Examples are the cities and towns of the Holy Roman Empire that were subject only to the authority of the emperor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imperial cities"@en .

aat:300387240 a skos:Concept ;
    skos:definition "Inhabited places or estates in which the a noble ruling house is established."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noble seats"@en .

aat:300387241 a skos:Concept ;
    skos:definition "Communities of any size that formerly existed but are now disbanded or abandoned. For communities for which the location is unknown, use \"lost settlements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former communities"@en .

aat:300387242 a skos:Concept ;
    skos:definition "Settlements of any size that have been buried due to volcanic eruption, landslide, accumulation of sediment, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buried settlements"@en .

aat:300387243 a skos:Concept ;
    skos:definition "Inhabited places of any size that are populated on a temporary basis. An example is a short-lived mining camp. For summer camps or ancient sites populated seasonally by hunter-gatherers, use \"seasonally inhabited places.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ephemeral communities"@en .

aat:300387244 a skos:Concept ;
    skos:definition "Areas that are historically documented or otherwise surmised, but are now gone or the location is unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost areas"@en .

aat:300387245 a skos:Concept ;
    skos:definition "Public archaeology, known as community archaeology in the UK, aims to engage the public by a wide array of means (books, television presentations, excavations open to visitors, and so forth) in order to share archaeological findings, promote interest in the discipline, and involve the community in archaeological matters that are relevant to them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public archaeology"@en .

aat:300387246 a skos:Concept ;
    skos:definition "Region of land or settlement that has self-government, typically having a mayor and city council."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "incorporated areas"@en .

aat:300387247 a skos:Concept ;
    skos:definition "Inhabited places, such as cities, towns, or villages, that are inhabited during only part of the year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seasonally inhabited places"@en .

aat:300387248 a skos:Concept ;
    skos:definition "Porcelain ware having walls of extreme thinness and delicacy, said to be comparable to the shell of a chicken's egg."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggshell china"@en .

aat:300387249 a skos:Concept ;
    skos:definition "Communities of any size that are dependent on or engaged in the harvest or processing of fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing communities"@en .

aat:300387250 a skos:Concept ;
    skos:definition "Communities that acted or continue to act as trading centers for fur."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fur stations"@en .

aat:300387251 a skos:Concept ;
    skos:definition "Places on land, beside a body of water, where fishermen gather or otherwise from which fishing is practiced. For hydrographic features where fishing is done offshore, use \"fishing areas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing spots"@en .

aat:300387252 a skos:Concept ;
    skos:definition "Porcelain ware made of clay mixed with bone dust or phosphate of lime, having walls that are pure white and translucent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bone china"@en .

aat:300387253 a skos:Concept ;
    skos:definition "Ports in China, Japan, Taiwan, and Korea that were opened to foreign trade as a result of special treaties signed during the second half of the 19th century and the first half of the 20th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treaty ports"@en .

aat:300387254 a skos:Concept ;
    skos:definition "Ports where goods are received and shipped free of customs regulations and duties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "free ports"@en .

aat:300387255 a skos:Concept ;
    skos:definition "Ports located on rivers, as opposed to being situated on seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inland ports"@en .

aat:300387256 a skos:Concept ;
    skos:definition "Ports that are located inland, on rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river ports"@en .

aat:300387257 a skos:Concept ;
    skos:definition "Places such as harbors, airports, or border crossing facilities through which people and goods may lawfully enter a country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ports of entry"@en .

aat:300387258 a skos:Concept ;
    skos:definition "A rare brown or black mineral resembling brookite occurring in volcanic rocks as tabular crystals. It has been identified as an element in the yellow slip of Gallo-Roman marbled ware excavated in Graufensenque, France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pseudobrookite"@en .

aat:300387259 a skos:Concept ;
    skos:definition "A colorless, flexible thermoplastic resin produced by the condensation of polyvinyl alcohol with formaldehyde that is used as a structural adhesive. In conservation, plasticized polyvinyl formal film has been used to fill losses in ancient textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinyl formal"@en .

aat:300387260 a skos:Concept ;
    skos:definition "A hydrophilic silicone elastomer introduced in the 1970s. It is used in dentistry for dental and gingival impressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyvinyl siloxane"@en .

aat:300387261 a skos:Concept ;
    skos:definition "Inorganic compound occurring in nature as green blue crystals; it is a green powder in its industrial form. Copper nitrate has a wide variety of applications. It is used to create patinas on metals; as a mordant and oxidizing agent in textile dyeing; as a pigment; as an ingredient in polishing agents for metals and pyrotechnics; as a fungicide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper nitrate"@en .

aat:300387262 a skos:Concept ;
    skos:definition "Works created primarily using he medium of papier mâché, which is a composite material made of repulped or pulverized paper and a liquid adhesive binder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papier-mâché art"@en .

aat:300387263 a skos:Concept ;
    skos:definition "Process for making beam-shaped reinforced plastic products such as fiberglass window frames. Bundled glass fibers are drawn through low viscosity resin and then pushed into a heated die where the resin is brought to a rigid state by polymerization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pultrusion"@en .

aat:300387268 a skos:Concept ;
    skos:definition "Locations that were or are the site of a concentration camp internment center."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concentration camp sites"@en .

aat:300387274 a skos:Concept ;
    skos:definition "Narrow channels, such as branches of streams."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guts"@en .

aat:300387282 a skos:Concept ;
    skos:definition "Inhabited place of any size that serve as the headquarters for one or more companies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corporate headquarters"@en .

aat:300387285 a skos:Concept ;
    skos:definition "Communities of any size that hold a market or otherwise provide a variety of retail functions for the surrounding area. For larger centers of business and commerce on a grander scale, use \"commercial centers (inhabited places).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market centers"@en .

aat:300387287 a skos:Concept ;
    skos:definition "Communities of any size that have shipping as a major industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipping centers"@en .

aat:300387288 a skos:Concept ;
    skos:definition "Communites of any size that have shipbuilding as a major industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shipbuilding centers"@en .

aat:300387290 a skos:Concept ;
    skos:definition "Communites of any size known for the production of textiles and fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile centers"@en .

aat:300387294 a skos:Concept ;
    skos:definition "Resort settlements typically developed around a medicinal spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spa centers"@en .

aat:300387297 a skos:Concept ;
    skos:definition "Refers to an adhesive formulation that is a hybrid of properties typical of pressure sensitive adhesives and heat seal adhesives. It was developed to create a preservation quality adhesive for application to resin-coated (RC) print photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ultra-cool melt adhesive"@en .

aat:300387301 a skos:Concept ;
    skos:definition "Chinese landscapes typically depicting mountains and bodies of water, often in an allegorical manner. Shan shui produced during the Northern Song dynasty (960-1127) was monumental in scale, while Southern Song (1127-1279) shan shui was more intimate, providing horizontal, misty views of lakes and rivers. Shan shui can assume multiple symbolic dimensions, serving as a microcosmic illustration of the universe or a form of allegorical human portraiture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shan shui"@en .

aat:300387314 a skos:Concept ;
    skos:definition "Human settlements, ancient or modern, that exist along a coastline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal settlements"@en .

aat:300387315 a skos:Concept ;
    skos:definition "Human settlements located on hills; hill settlements can be prehistoric and defensive in origin, or contemporary settlements built on higher ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hill settlements"@en .

aat:300387316 a skos:Concept ;
    skos:definition "Human settlements of any size situated near rivers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river settlements"@en .

aat:300387317 a skos:Concept ;
    skos:definition "Communities of varying size, located in a fertile region of a desert and with productive land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oasis settlements"@en .

aat:300387318 a skos:Concept ;
    skos:definition "Settlements established for the purpose of containing prisoners or other detainees and punishing them through forced labor, whether overseas or within the boundaries of the founding state. For inhabited places containing prisons, but not necessarily established as settlements for penal purposes, use \"prison centers (inhabited places).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penal settlements"@en .

aat:300387319 a skos:Concept ;
    skos:definition "Inhabited places where craftsmen's work is a significant industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "craftsman settlements"@en .

aat:300387322 a skos:Concept ;
    skos:definition "Operational centers of any size used for activities surrounding hunting; may be contemporary or prehistoric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunting bases"@en .

aat:300387323 a skos:Concept ;
    skos:definition "Areas inhabited by primarily indigenous tribal peoples. The term is used particularly in India, but may also apply to other areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribal areas"@en .

aat:300387325 a skos:Concept ;
    skos:definition "Areas inhabited by primarily indigenous peoples. The term is used particularly in Australia, but may also apply to other areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aboriginal reserves"@en .

aat:300387326 a skos:Concept ;
    skos:definition "Tracts of land set aside by a government for aboriginal, tribal, or native populations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "native peoples reservations"@en .

aat:300387327 a skos:Concept ;
    skos:definition "Communities founded by or inhabited by indigenous peoples of the Americas, inclusive of any native peoples of North America, Central America, South America, or the West Indies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amerindian communities"@en .

aat:300387329 a skos:Concept ;
    skos:definition "A term is a word or group of words representing a single concept; a vocabulary record comprises terms and other information, including relationships, scope note, sources, etc. Additionally, in the jargon of thesaurus construction, the word term is often used as shorthand to actually refer to the concept that is represented by that term (for example, BT and NT actually refer to the relationships between concepts). The distinction between a term in the strict sense and term meaning a record must often be inferred from the context of the discussion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terms"@en .

aat:300387330 a skos:Concept ;
    skos:definition "Small administrative districts of many countries, especially in Europe. A distinct form of government is implied by the term, for example, government by a mayor and municipal council."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communes"@en .

aat:300387331 a skos:Concept ;
    skos:definition "General term for administrative divisions of a city or other inhabited place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parts of inhabited places"@en .

aat:300387332 a skos:Concept ;
    skos:definition "Generic designation for divisions of an urban area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban subdivisions"@en .

aat:300387333 a skos:Concept ;
    skos:definition "Boroughs or districts, in Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bezirke"@en .

aat:300387334 a skos:Concept ;
    skos:definition "Designation for various types of subdivisions in Italian cities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contrade"@en .

aat:300387335 a skos:Concept ;
    skos:definition "Particular subdivisions of a city or town, particularly when there are six districts total. Examples are in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sestieri"@en .

aat:300387336 a skos:Concept ;
    skos:definition "Particular districts or administrative divisions, particularly divisions of towns and cities in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rioni"@en .

aat:300387337 a skos:Concept ;
    skos:definition "Particular subdivisions of an urban area Examples are in the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban districts"@en .

aat:300387338 a skos:Concept ;
    skos:definition "Particular subdivisions comprising an urban area. Examples are in colonial Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban divisions"@en .

aat:300387339 a skos:Concept ;
    skos:definition "Particular type of administrative territorial subdivision, such as of a comune. Examples are in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frazioni"@en .

aat:300387340 a skos:Concept ;
    skos:definition "Particular type of administrative territorial subdivision. Examples are in Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ortsteile"@en .

aat:300387341 a skos:Concept ;
    skos:definition "Urban areas that are historically significant and retain characteristics and buildings from an historical period or periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic quarters"@en .

aat:300387342 a skos:Concept ;
    skos:definition "Particular types of subdivisions of towns or cities, particularly where there are four divisions total. Examples are in Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quartieri"@en .

aat:300387343 a skos:Concept ;
    skos:definition "Boundary lines that separate one country from another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borders"@en .

aat:300387344 a skos:Concept ;
    skos:definition "Distinctive landscapes, usually located on soluble rock such as irregular limestone, and characterized by caverns, sinkholes, fissures, ridges, and underground drainage. The term is derived from the Karst region of Slovenia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karst areas"@en .

aat:300387345 a skos:Concept ;
    skos:definition "Physical features that may be considered part of another larger feature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sections of physical features"@en .

aat:300387346 a skos:Concept ;
    skos:definition "Areas that are distinguished by historical or other criteria, but not by political administrative boundaries. An example is the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "general regions"@en .

aat:300387347 a skos:Concept ;
    skos:definition "Regions having human habitation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inhabited regions"@en .

aat:300387348 a skos:Concept ;
    skos:definition "General term for areas of land that are underwater, either fresh water or saline."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater areas"@en .

aat:300387349 a skos:Concept ;
    skos:definition "Gentle slopes located on the sea floor, which connect areas of varying elevations. [For PH - no add'l warrant for \"undersea ramps\" though some warrant for \"submarine ramps.\"]"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea ramps"@en .

aat:300387350 a skos:Concept ;
    skos:definition "Objects that are used in the exchange of goods and services and in the settlement of debts, and typically assigned a specific value."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exchange media"@en .

aat:300387351 a skos:Concept ;
    skos:definition "Lines of pipe that facilitate the movement of crude and refined liquid petroleum products by pumping. Crude oil pipelines carry unprocessed petroleum to refineries, while product pipelines transport refined petroleum products such as gasoline, kerosene, jet fuel, and heating oil from refineries to the market."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil pipelines"@en .

aat:300387352 a skos:Concept ;
    skos:definition "Areas that contain subterranean stores of natural gas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gas fields"@en .

aat:300387353 a skos:Concept ;
    skos:definition "Political entities, such as city states or nations, that worked or governed together, but are historical and no longer exist. Examples are Etruria and the Hanseatic League."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groups of political entities"@en .

aat:300387354 a skos:Concept ;
    skos:definition "Political entities that worked or governed together, but are historical and no longer exist. Examples are Etruria and the Hanseatic League."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former groups of political entitites"@en .

aat:300387355 a skos:Concept ;
    skos:definition "Areas of various kinds designated as significant due to high population density, economic significance, or other reasons. They may be administrative areas, or the term may be used in a generic sense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statistical areas"@en .

aat:300387356 a skos:Concept ;
    skos:definition "General term for political entities considered of the highest order or level in a political hierarchical arrangement, but where the entity is historical and no longer exists. Examples are former nations, states, or empires, such as the Byzantine Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "former primary political entities"@en .

aat:300387357 a skos:Concept ;
    skos:definition "Objects, performances, or written or intellectual compilations, that are considered creative and require effort or labor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "works"@en .

aat:300387360 a skos:Concept ;
    skos:definition "The total of images, objects, and other visuality that has been built up by a group of people and transmitted from one generation to another. It includes art media such as painting, drawing, prints, and installations; architecture and design; utilitarian artifacts of a culture such as tools and costime; media such as photography, film, television, and digital media, covering topics of news, popular culture, advertising and consumerism, politics, law, religion, and science and medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visual culture"@en .

aat:300387362 a skos:Concept ;
    skos:definition "Ware produced by the earlier phase of Bandkeramik culture, characterized by pottery decorated with scratches, grooves, and relief patterns arranged in bands of meanders, curves, spirals, and wave-shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Linear ware"@en .

aat:300387363 a skos:Concept ;
    skos:definition "Ware produced on the Greek mainland and dating from the Middle Helladic, characterized by wheelmade, angular shapes, and unornamented surfaces. The pottery was named by Schliemann after the legendary inhabitants of Orchomenus in central Greece, where he first came upon it; today it is believed unlikely that the Minyans were the original creators of Minyan ware"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minyan ware"@en .

aat:300387364 a skos:Concept ;
    skos:definition "Japanese porcelain ware produced at the Nabeshima clan’s kiln at Ōkawauchiyama from ca. 1677 to 1871. Production consisted of sometsuke (underglaze cobalt blue, blue-and-white), aoki (celadon), and iroe (polychrome overglaze enamel) wares. In addition to developing original decorative processes, the kiln copied the Chinese doucai techniques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nabeshima ware"@en .

aat:300387365 a skos:Concept ;
    skos:definition "Pottery objects from the northern and central Pre-Columbian Andes that uses a negative painting technique, in which the design is reserved in unpainted areas against a colored background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negative ware"@en .

aat:300387366 a skos:Concept ;
    skos:definition "Mondragone marble is a slightly metamorphosed yellow or gray carbonate rock, which was widely employed as monumental stone in the 18th-century royal palaces of Naples and Caserta. Named for Mondragone, Campania where the marble is quarried."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mondragone marble"@en .

aat:300387367 a skos:Concept ;
    skos:definition "A tenet of contemporary Western conservation theory, minimal intervention means minimal interference with materials in physical treatment of objects. This widely accepted framework promotes the application of preventive conservation measures for the preservation of collections while suppressing other more interventive and active conservation approaches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "minimal intervention"@en .

aat:300387368 a skos:Concept ;
    skos:definition "Rock weathering processes whose effects can be seen only at the microscopic level."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microerosion"@en .

aat:300387369 a skos:Concept ;
    skos:definition "A number of interrelated hardware and software components that work together to store and convert data into information by using electronic processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer systems"@en .

aat:300387370 a skos:Concept ;
    skos:definition "Collected components that work together to store and manage data and assemble it into intelligible information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "information systems"@en .

aat:300387371 a skos:Concept ;
    skos:definition "Systems for describing and indexing works or images, particularly in a collections management system or other automated system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cataloging systems"@en .

aat:300387372 a skos:Concept ;
    skos:definition "Database systems that allow institutions to control aspects of collections, including description (artist, title, measurements, media, style, subject, etc.) as well as administrative information regarding acquisitions, loans, and conservation information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collection management systems"@en .

aat:300387373 a skos:Concept ;
    skos:definition "Refers to the style of artistic production in colonies of the Republic of Venice featuring a combination of Venetian and native characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian Colonial"@en .

aat:300387374 a skos:Concept ;
    skos:definition "Pottery from Paestum, Italy, characterized by vases of various shapes decorated with distinctive motifs and scenes such as women's daily life and Dionysiac subjects. Distinctive palmettes that are placed below the handle often serve as a frame for the figural scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paestan ware"@en .

aat:300387375 a skos:Concept ;
    skos:definition "Minoan pottery from Crete dating to the Late Neolithic and Early Minoan periods. It is characterized by a surface fired to a dark brown or black and burnished with a smooth pebble or wooden burnisher to produce a linear decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pyrgos ware"@en .

aat:300387376 a skos:Concept ;
    skos:definition "Pottery, primarily household wares, characterized by a brown glaze, originally made by the Rockingham Ceramic Factory in Yorkshire, England. Similar wares called \"Rockingham ware\" were later made in the United States in Chelsea, Massachusetts, Baltimore, Maryland, and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rockingham ware"@en .

aat:300387377 a skos:Concept ;
    skos:definition "Polymerizable liquid used in the manufacture of rubbers, ion-exchange resins, polyesters, and other polymers. It consists of two vinyl groups bonded to a benzene ring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divinylbenzene"@en .

aat:300387378 a skos:Concept ;
    skos:definition "Distinctive porcelain ware made in a Kutani revival style in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wakasugi ware"@en .

aat:300387379 a skos:Concept ;
    skos:definition "Pottery originating in Samos, an island in the Aegean Sea. May refer to Roman pottery made on Samos or of clay from Samos, as a variety of Terra sigillata pottery. May also refer to Greek Geometric and Orientalizing pottery made or excavated on Samos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Samian ware"@en .

aat:300387380 a skos:Concept ;
    skos:definition "Chinese porcelain wares made in China during the T'ang dynasty (618-906 BCE) and later in the Ming and Ching dynasties (1368-1912). It is characterized by streaks and spots of three colors, typically dark blue, turquoise and aubergine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-color ware"@en .

aat:300387381 a skos:Concept ;
    skos:definition "Ceramic wares made at kiln sites in Kagoshima Prefecture (formerly the Satsuma domain) in southern Kyushu, from the early 17th century to the present. Wares include items used for tea ceremonies and everyday use, such as \"sharkskin\" ware and copies of Sawankhalok ware, a Thai ware decorated with underglazed iron-oxide painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Satsuma ware"@en .

aat:300387382 a skos:Concept ;
    skos:definition "Japanese glazed ceramic ware produced in Seto by one of the so-called Six Ancient Kilns, dating from the 12th century to the end of the 15th century. Included are ash-glazed bottles, bowls, dishes and jars with four small handles, new shapes, patterns, iron glazed-wares and utensils for Buddhist rituals, and items household use, typically tea ceremony ware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Seto ware"@en .

aat:300387383 a skos:Concept ;
    skos:definition "Materials with adaptive capabilities that react to external stimuli such as load, heat, and vibrations. Examples of smart materials include self-healing concrete which releases reserves of a strong adhesive when under stress, mending cracks; shape-memory alloys and polymers which can undergo and reverse deformation by heat or stress thanks to pseudoelasticity; or chromogenic systems which change their color, such as sun glasses that darken when exposed to bright sunlight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smart materials"@en .

aat:300387384 a skos:Concept ;
    skos:definition "The process of discovering an archaeological site to be excavated by aerial photography, remote sensing, or by other means such as statistically predicting archaeological sites from environmental variables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "site location"@en .

aat:300387385 a skos:Concept ;
    skos:definition "The four largest moons of Jupiter (Io, Ganymede, Europa, and Callisto), discovered in 1610 by Italian astronomer Galileo Galilei."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galilean satellites"@en .

aat:300387386 a skos:Concept ;
    skos:definition "Relatively large celestial masses that are gravitationally coupled to a larger mass. Examples are the Earth, which orbits the Sun, and the Moon, which orbits the Earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellites"@en .

aat:300387387 a skos:Concept ;
    skos:definition "Structures of masonry or large stones that serve as a pier or breakwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moles"@en .

aat:300387388 a skos:Concept ;
    skos:definition "Supreme executive legislatures, especially the assemblies of citizens having the highest deliberative functions in a government, currently or historically summoned by a monarch for the discussion of important matters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parliaments"@en .

aat:300387389 a skos:Concept ;
    skos:definition "Pottery found predominantly in the Diyala region of Mesopotamia at the start of the Early Dynastic period from about 2900 to 2750 BCE; characterized by generally large, broad-shouldered pots with painted red designs, often outlined in black, on a buff or yellow ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scarlet ware"@en .

aat:300387390 a skos:Concept ;
    skos:definition "A class of compounds containing nitrogen and chlorine. Two types of chloramine have been used in the past as a bleach for paper. Chloramine-B, introduced in 1937, was eventually replaced by the more easily controllable chloramine-T which itself proved problematic: it reacts with aluminum and other metals precipitating residues that are hard to remove. Chloramine-T is now used as a disinfectant, antiseptic, and biocide. In conservation it is used for removing fungal stains from stone and in bleaching treatments of aged paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chloramine"@en .

aat:300387391 a skos:Concept ;
    skos:definition "Pottery created in the later phase of Bandkeramik culture, characterized by rows of incisions, punctures, impressions, and notches arranged to suggest bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stroked ware"@en .

aat:300387392 a skos:Concept ;
    skos:definition "General term for tracts of the earth's surface marked off by natural, political, or cultural boundaries, or considered as an integral section of the globe. Examples include territories and countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lands"@en .

aat:300387393 a skos:Concept ;
    skos:definition "Ceramic ware produced at Sultanabad (modern Arak, Iran), especially from 13th-14th centuries. Types were minai (a method that preserved colors through firing), lusterware, faience in green and dark blue tones, often with molded ornamentation, and tiles richly decorated in luster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sultanabad ware"@en .

aat:300387394 a skos:Concept ;
    skos:definition "Particular type of administrative subdivisions. Examples are in Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plazas"@en .

aat:300387395 a skos:Concept ;
    skos:definition "Roman pottery characterized by its red color, smooth finish, and sometimes having decorations of stamped figures or patterns. It was found in Italy, Gaul, and Germany, and throughout the Roman Empire 1st century BCE-3rd century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terra sigillata ware"@en .

aat:300387396 a skos:Concept ;
    skos:definition "Early Minoan pottery named after a site in eastern Crete, and characterized by the invention of unusual shapes, including teapots with exaggerated, long spouts and jugs with tall, beaked spouts. Distinctive decoration was created by covering the entire pot with a coat of slip, which was mottled during firing to achieve a variegated effect in brilliant red and black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vasiliki ware"@en .

aat:300387397 a skos:Concept ;
    skos:definition "Roman pottery that has a fine, hard, thin fabric and is decorated with painted designs and distinctive wedge-shaped projections resembling thorns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thorn ware"@en .

aat:300387398 a skos:Concept ;
    skos:definition "Ceramic ware manufactured since the mid-18th century in Thuringia, Germany. The works consists of predominently hard-paste porcelain tableware, often in a Baroque style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thuringian ware"@en .

aat:300387399 a skos:Concept ;
    skos:definition "Scottish pottery dating 19th-early 20th-century, originally named for Lady Grosvenor of Wemyss Castle. It is characterized by flowers, fruit, or animals painted in bright colors on a white ground often in a sketchy style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wemyss ware"@en .

aat:300387400 a skos:Concept ;
    skos:definition "Term used by the Association for Preservation Technology (APT) which promulgates structural engineering as a component of architectural conservation in the United States. Buildings preservation initially developed in this country without including engineers since older buildings tended to be relatively small and engineers were engaged in constructing large new structures. The aging of those large structures, along with public interest in preserving relatively recent architecture, recommends the development and implementation of preservation engineering."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preservation engineering"@en .

aat:300387401 a skos:Concept ;
    skos:definition "Japanese stoneware found in the Shigaraki valley, Southern Shiga prefecture,1185-1333. Included were vessels for domestic use such as narrow-mouthed jars and mortar bowls. In 1632, Shigaraki ware became the official ware for tea storage vessels for the Tokugawa Shogunate. Since the 19th century, production has shifted to various wares such as planters, braziers and sake jugs. Typically, the style is characterized by reddish brown and coarse grained wares, with white specks of feldspar or quartz that melt during firing and protrude from the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shigaraki ware"@en .

aat:300387402 a skos:Concept ;
    skos:definition "Ceramic ware produced in the Mino Province from the 7th century to the present. Included are large-mouth jars, small-mouth jars, mortars, ash-glazed and iron-glazed utensils, and tea ceremony wares."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mino ware"@en .

aat:300387403 a skos:Concept ;
    skos:definition "Japanese stoneware that is gray in color, that originated in Korea, but was seen in Japan by the 5th-10th centuries. It is typically coil-made, unglazed, with simple combed or punctate designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sue ware"@en .

aat:300387404 a skos:Concept ;
    skos:definition "Chinese porcelain ware made during the T'ang dynasty (618-907 BCE), including pure white, simple shaped bowls and dishes, and more rarely in elaborately carved vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hsing ware"@en .

aat:300387405 a skos:Concept ;
    skos:definition "The process of rejoining and fixing a part or parts of a whole that have become detached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reattaching"@en .

aat:300387406 a skos:Concept ;
    skos:definition "Thin supporting strips, usually of wood, used to hold together boards, panels, or planks of wood in order to join them, give them strength, and prevent warping. Examples of battens are on the reverses of panel paintings and the cross boards on board-and-batten shutters and doors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "battens"@en .

aat:300387407 a skos:Concept ;
    skos:definition "English ware produced by Thomas Minton in Staffordshire beginning in 1793, including majolica, Parian ware, Palissy ware, and blue-printed earthenware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Minton ware"@en .

aat:300387408 a skos:Concept ;
    skos:definition "Fine white translucent porcelain with a thick white glaze made at Dehua (Te Hua) from the late Ming period and exported to Southeast Asia and to Europe from the 18th century.Characteristic forms were small figures depicting Buddhist deities and dignitaries, cups, and vases. The term is also used for similar ware produced elsewhere in Japan and Europe, such as in Saint-Cloud, France and Chelsea and Bow, England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanc de chine ware"@en .

aat:300387409 a skos:Concept ;
    skos:definition "Porcelain ware that is made and decorated in China to European order, as distinct from porcelain in native taste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese export porcelain"@en .

aat:300387410 a skos:Concept ;
    skos:definition "Chinese ware dating from the Ming period, especially during the reign of Wan li (1573-1619). Characterized by white porcelain decorated with five colors; apple green, iron red, yellow, aubergine, and violet blue. Eventually the name came to be applied to all types of enamel decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wucai ware"@en .

aat:300387411 a skos:Concept ;
    skos:definition "Soft-paste porcelain ware that was first produced by the factory at the Palazzo di Capodimonte in 1743 under the auspices of Charles VII of Naples and continued until 1758 when Charles became the king of Spain, dismantling the concern and reestablishing it as the Real Fábrica del Buen Retiro near Madrid. The style was developed by chief modeler Giuseppe Grieci from prototypes by Meissen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Capodimonte ware"@en .

aat:300387413 a skos:Concept ;
    skos:definition "Period, style, and culture of historicTangut state, occupying an area in what is now northwestern China, that flourished from ca. 997 until 1227 when it was conquered by Genghis Khan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Xixia"@en .

aat:300387414 a skos:Concept ;
    skos:definition "Culture of Tibetan-related ethnic group historically living at the terminus of the Silk Road in what is now northwestern China. The Tangut kingdom of Xixia flourished from 1038 until 1227."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tangut"@en .

aat:300387415 a skos:Concept ;
    skos:definition "Pointillistic single tone in-painting technique used as compensation for loss; an adaptation of the tratteggio technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rigattino"@en .

aat:300387416 a skos:Concept ;
    skos:definition "Culture and style of the Chinchorro people who lived in what is now northern Chile and southern Peru from about 7,000 BCE to 500 BCE. The culture is named for the archaeological site of Chinchorro in Arica which contained a collection of mummies, among the earliest in the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinchorro"@en .

aat:300387417 a skos:Concept ;
    skos:definition "Sturdy stoneware made in Cizhou or in a similar style at other locations from the Sui dynasty into the early Ming dynasty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cizhou"@en .

aat:300387418 a skos:Concept ;
    skos:definition "Pencils that produce a permanent mark, non-erasable with any pencil eraser.The component materials of copying pencil cores are graphite, kaolin clay, and an aniline dye as colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copying pencils"@en .

aat:300387419 a skos:Concept ;
    skos:definition "White crystals soluble in water, acetone, and alcohol used in the production of a wide range of organic chemicals including fertilizers, explosives, epoxy laminates, pharmaceuticals, and dyestuffs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dicyandiamide"@en .

aat:300387420 a skos:Concept ;
    skos:definition "Substances that conduct electric current resulting from positive and negative ions discharged at terminals (cathode and anode) of an electric circuit, specifically the conducting fluid used in a battery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrolytes"@en .

aat:300387421 a skos:Concept ;
    skos:definition "Information indicator used when a work contains media that are unconventional or may vary. An example of use could be to index collection containing conceptual, minimalist, and video art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "variable media"@en .

aat:300387423 a skos:Concept ;
    skos:definition "Technical term used in wood pulp and paper research that refers to the stiffening of the polymer structure that takes place in lignocellulosic materials upon drying or water removal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornification"@en .

aat:300387425 a skos:Concept ;
    skos:definition "Formerly copyrighted name for a series of alkyd resins used for surface coatings such as varnishes, shellacs and paints. Glyptal is made by heating phthalic anhydride and glycerin together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Glyptal"@en .

aat:300387427 a skos:Concept ;
    skos:definition "Things or substances that are generated or produced, by human activity or by natural processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "products"@en .

aat:300387428 a skos:Concept ;
    skos:definition "Non-white paper uniformly tinted with pigments or dye, usually during manufacture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colored paper"@en .

aat:300387429 a skos:Concept ;
    skos:definition "Collocation of living organisms from the kingdom Plantae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groupings of plants"@en .

aat:300387430 a skos:Concept ;
    skos:definition "Bunches or arrangements of cut flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouquets"@en .

aat:300387431 a skos:Concept ;
    skos:definition "An aromatic liquid phenol, isoeugenol is a constituent of the essential oils of several plants including nutmeg. It may also be synthesized from closely related eugenol by isomerization with alkali. Isoeugenol is used in perfumery and in the synthesis of vanillin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isoeugenol"@en .

aat:300387432 a skos:Concept ;
    skos:definition "Soft pliable rubber eraser of material resembling putty or gum that adsorbs and removes charcoal and graphite particles from paper. Its primary use is by artists. It is also sometimes used in conservation to remove surface dirt from paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kneadable erasers"@en .

aat:300387434 a skos:Concept ;
    skos:definition "Carved objects, usually of wood, in the form of a duck or other waterfowl, having the original intent of luring flocks of birds onto bodies of water so that hunters could shoot them. Modern duck decoys may be molded. Duck decoys are considered valuable collectibles, generally the creations of folk artists or other craftsmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duck decoys"@en .

aat:300387435 a skos:Concept ;
    skos:definition "Ephemeral works or more substantive works that are displayed specifically during a holiday period for interior or exterior decoration, including garlands, ornaments, candles, electric lights, hangings, and many other types of works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holiday decorations"@en .

aat:300387437 a skos:Concept ;
    skos:definition "Species of weasellike carnivore native to woodlands of Eurasia and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mustela putorius"@en .

aat:300387439 a skos:Concept ;
    skos:definition "Motif resembling rope and twisted rope like patterns, including raised convex or painted architectural decoration, ceramics, metalwork, and furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ropework"@en .

aat:300387440 a skos:Concept ;
    skos:definition "Motif resembling ribbon, often in swirling, windblown forms, or in the form of a tied bow, with long streamer ends, seen in used on furniture, metalwork, ceramics, and textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ribbonwork"@en .

aat:300387441 a skos:Concept ;
    skos:definition "Approach to heritage and art conservation that aims to effect a balance of structural, environmental, and financial sustainability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sustainable conservation"@en .

aat:300387442 a skos:Concept ;
    skos:definition "Methods for projecting cinematic materials digitally first set forth in the Digital Cinema System Specification, a proposal authored by the Digital Cinema Initiatives (DCI), a group of six Hollywood studios, in 2005. Traditional film containing the movie is replaced by an electronic copy contained on a storage device. Instead of projecting light through print film, digital cinema uses technologies such as DLP and LCOS to accomplish the task. The DCI has mandated industry-wide compliance with digital projection standards by 1 January 2014."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital projection"@en .

aat:300387443 a skos:Concept ;
    skos:definition "A cushioning system of cored-out hexagonal recesses developed by Reebok for use in shoes. Its honeycomb structure is made of rubbery thermoplastic urethane. Hexalite has been adapted for use as a support for wallpapers and textiles in museum display."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexalite (TM)"@en .

aat:300387445 a skos:Concept ;
    skos:definition "Yellowish white ornamental material with a vibrant, brownish-red coating traditionally used for carving in China and other Asian countries. It is derived from the solid keratin casque atop the beak of the helmeted hornbill (Rhinoplax vigil)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hornbill ivory"@en .

aat:300387447 a skos:Concept ;
    skos:definition "Microscopic cracks typically less than one millimeter in width and a few centimeters long."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microcracks"@en .

aat:300387448 a skos:Concept ;
    skos:definition "Denotes the culture or styles of locally born persons in Southeast Asia who are descendants of marital unions between native-born people and foreigners. Typically refers to the Peranakan communities in Southeast Asia and their hybrid cultures, which became well established by the 19th century. The traditional heartland of Peranakans is said to be present-day Singapore, Malaysia, Indonesia and Brunei. In Singapore and Malaysia, the Peranakan males are called Baba and the females, Nyonya. The Peranakan communities may include the Peranakan Chinese, who are also known as Straits Chinese, Pashu (in Myanmar), Chetti Melaka and Jawi Peranakan amongst others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peranakan"@en .

aat:300387449 a skos:Concept ;
    skos:definition "Laminate made of one or more superimposed layers of a material(paper board, paper sheets, metal foil, plastic film) adhered to a sheet of paper. Laminated paper is stronger and thicker than single-ply paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laminated paper"@en .

aat:300387450 a skos:Concept ;
    skos:definition "Traditional Venetian flooring process in which colored marble chips are set in polished mortar and honed, creating a smooth surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seminato"@en .

aat:300387451 a skos:Concept ;
    skos:definition "Sodium copper formate acetate found as a corrosion product on objects in which copper alloys are in contact with glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socoformacite"@en .

aat:300387452 a skos:Concept ;
    skos:definition "The sodium salt of pentachlorophenol, a soluble white or tan powdered solid which has many applications, among them as herbicide, fungicide, biocide; and preservative for leather, and wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium pentachlorophenate"@en .

aat:300387453 a skos:Concept ;
    skos:definition "The branch of molecular biology which maps and analyzes the set of proteins expressed by an organism; an adjunct to genomics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proteomics"@en .

aat:300387454 a skos:Concept ;
    skos:definition "Lumber produced by overlaying and adhering multiple layers of thin wood. This composite wood product is stronger and more uniform than conventional milled lumber and less likely to warp or shrink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laminated veneer lumber"@en .

aat:300387455 a skos:Concept ;
    skos:definition "Conically shaped devices used in conjunction with polycapillary optics to collimate and guide divergent x-rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polycapillary conic collimators"@en .

aat:300387456 a skos:Concept ;
    skos:definition "A mixture of naturally occuring mineral material used by the Maya in the preparation of plasters and mortars. It has been employed as a building and paving material in Mesoamerica since antiquity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sascab"@en .

aat:300387457 a skos:Concept ;
    skos:definition "The process of electronic conversion of handwritten or printed characters into machine-encoded text by means of an optical scanner, special software that identifies text images, and an output interface which reproduces them in electronic form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical character recognition"@en .

aat:300387458 a skos:Concept ;
    skos:definition "Refers to aluminum honeycomb-core solid support panels. These may be used in various capacities including as an auxiliary support for paintings on fabric in the conservation field: they supply an alternative to bonding to another piece of fabric as method of consolidation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum honeycomb supports"@en .

aat:300387459 a skos:Concept ;
    skos:definition "Oxygen in its atomic form as it exists at altitudes over 12 miles above Earth's surface. It is the result of photo dissociation of molecular oxygen enabled by the ultraviolet radiation found in space. Atomic oxygen comprises 96% of low Earth orbit atmosphere. In conservation, an atmospheric atomic oxygen beam is effective in removing through oxidation organic materials that are typical of graffiti or other contaminant defacements which may occur to the surfaces of paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atomic oxygen"@en .

aat:300387460 a skos:Concept ;
    skos:definition "Sequences of DNA immobilized on a solid support such as a membrane or glass slide. DNA arrays are used in the identification and sequencing of a sample and to measure the expression of many genes simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DNA microarrays"@en .

aat:300387461 a skos:Concept ;
    skos:definition "Pre-Columbian culture which developed during the middle Horizon and late intermediate period (before 900 to 1350 CE) in the far south of Peru and Northern Chile, reaching its zenith of population during the 13th and 14th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chiribaya"@en .

aat:300387462 a skos:Concept ;
    skos:definition "In silver gelatin photographic processing, a fixing bath contains a chemical, either sodium thiosulfate or ammonium thiosulfate, used to remove light sensitive silver halides from a photographic image and thus stabilize prints or film, fixing it, after it has been exposed to light. Ammonium thiosulfate was later adopted as a fixing salt because it acts three to four times faster, though is less stable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fixer"@en .

aat:300387464 a skos:Concept ;
    skos:definition "Consolidant used to treat deteriorated limestones, sandstones, and marbles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl polysiloxane"@en .

aat:300387465 a skos:Concept ;
    skos:definition "Visual display technology which uses liquid crystals that change their alignment and become visible when electrical voltage is applied to them. Liquid crystals do not emit light directly. They reflect light from an external source, or can be illuminated from behind. LCDs may be made up of any number of segments, large as in the elements of a digital clock, or tiny, representing pixels on a computer or video monitor. They may be in color or monochrome, depending on the application."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquid crystal displays"@en .

aat:300387466 a skos:Concept ;
    skos:definition "Treatment of objects under elevated temperature and nitrogen atmosphere by high energy electrons for various purposes including cross-linking of polymers and sterilization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron beam processing"@en .

aat:300387467 a skos:Concept ;
    skos:definition "In soil mechanics, the study of static and dynamic stability of soil in natural slopes and other forms of embankment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slope stability"@en .

aat:300387468 a skos:Concept ;
    skos:definition "In molecular biology a technique for rapidly replicating a sequence of genomic DNA by a simple enzyme reaction. The process is used to produce a sufficient quantity of DNA for detailed analysis and manipulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polymerase chain reaction"@en .

aat:300387471 a skos:Concept ;
    skos:definition "Creation of graft copolymers, a special type of branched copolymers in which long chains have occasional branches comprising repeat units different from those of the main chain. Such copolymers are created for a variety of diverse applications including enhanced tensile strength, controlled wettability, better pigment dispersion, and enhanced thermal stability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graft copolymerization"@en .

aat:300387472 a skos:Concept ;
    skos:definition "Works that are based upon one or more pre-existing works, such as a translation, musical arrangement, dramatization, fictionalization, motion picture version, sound recording, art reproduction, abridgment, condensation, or any other form in which a work may be recast, transformed, or adapted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "derivative works"@en .

aat:300387473 a skos:Concept ;
    skos:definition "A recrystallized limestone composed largely of calcite and brucite; named for a locality near Predazzo, in the Tyrol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "predazzite"@en .

aat:300387477 a skos:Concept ;
    skos:definition "Binary compound of oxygen and iron as occurs naturally, for example, in the mineral hematite. There are sixteen known iron oxides and oxyhydroxides. The corrosion product rust is a form of iron oxide. Iron oxides have many applications including chemical catalyst, pigment and colorant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "iron oxide"@en .

aat:300387478 a skos:Concept ;
    skos:definition "In mounting of canvas, textiles, leather, and other stretched materials, proper calibration of tension."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tensioning"@en .

aat:300387479 a skos:Concept ;
    skos:definition "Trademarked name for group of alcohol ethoxylate nonionic surfactants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Synperonic (TM)"@en .

aat:300387480 a skos:Concept ;
    skos:definition "An ester that yields methanol when hydrolyzed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "methyl ester"@en .

aat:300387481 a skos:Concept ;
    skos:definition "Developed in 1939 at I.G. Farbenindustrie (which marketed it as Perlon), nylon 6 was developed as a dyable, durable nylon fiber intended to compete with DuPont's nylon 6,6. It is very similar but has a lower melting point and a greater affinity for dyes. The two types of polyamide fiber remain the most commonly used by the textile and plastics industries worldwide. It is formed by polymerizing caprolactam under high pressure and is thus also known as polycaprolactam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nylon 6"@en .

aat:300387482 a skos:Concept ;
    skos:definition "A durable, dyable nylon fiber formed from hexamethylenediamine and adipic acid. Nylon 6,6 was developed at DuPont in 1935. It is very similar in structure to nylon 6, a rival product created ny I.G. Farbenindustrie four years later, and the two types of polyamide fiber remain the most commonly used by the textile and plastics industries worldwide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nylon 6,6"@en .

aat:300387483 a skos:Concept ;
    skos:definition "A 3D imaging and laser scanning technique which records millions of 3D points when a laser beam is swept over a scene or object. These measurements can be imported into CAD or 3D application and displayed on a monitor as a “point cloud” with photographic qualities portrayed in one-color, gray-scale, false-color or true color. The files can be viewed, measured and analyzed as 3D models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrestrial laser scanning"@en .

aat:300387484 a skos:Concept ;
    skos:definition "Virtual representation of a physical museum, or of a collection without physical counterpart, accessed through electronic media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virtual museums"@en .

aat:300387485 a skos:Concept ;
    skos:definition "General name for confectionery or beverages derived from cocoa, an extract of the beans of the cocoa tree, Theobroma cacao."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocolate"@en .

aat:300387487 a skos:Concept ;
    skos:definition "Compounds that provide a chemical bond between two dissimilar materials, usually an inorganic and an organic material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coupling agents"@en .

aat:300387488 a skos:Concept ;
    skos:definition "Process used for holograms captured and processed at up to 40 frames per second, allowing video-rate holographic imaging. Potential uses for this technology include holographic video display for examination of objects, medical imaging, 3-D video conferencing, and other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video holography"@en .

aat:300387489 a skos:Concept ;
    skos:definition "Ancient pottery that is solid red in color, has a satiny gloss, and comes from Rome, the Near East, or Greece. To refer specifically to Roman red gloss ware, use \"terra sigillata ware.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red-gloss ware"@en .

aat:300387490 a skos:Concept ;
    skos:definition "Italian red-gloss pottery dating to before the flourishing of terra sigillata in the first century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presigillata"@en .

aat:300387491 a skos:Concept ;
    skos:definition "Fine ware that was widely produced in the Mediterranean region from the 4th to the 1st centuries BCE. It is distinguished by being wholly or in part covered with a black slip or gloss, which is not actually a glaze (although it is sometimes called \"black-glaze ware\"). This ware developed from later Attic production, but by the Hellenistic period (about 330-30 BCE), it had become the most popular fine ware throughout the Mediterranean. It was the first pottery to be exported in quantity from southern Italy by the 3rd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-gloss ware"@en .

aat:300387493 a skos:Concept ;
    skos:definition "The style or culture of ancient Paestum, a major ancient Greek city on the coast of the Tyrrhenian Sea in Magna Graecia, modern Campania, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paestan"@en .

aat:300387494 a skos:Concept ;
    skos:definition "Refers to a type of dagger-axe, or halberd, used for display by Shang elite in Bronze Age China. They are single- or double-edged blades with short hafts, though length, shape, and motif varied and evolved over time. Many bronze ge were functional weapons, while later examples are ground from materials such as nephrite and are presumed to be purely ceremonial. Bronze ge may have been among the first objects created in Chinese foundries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ge"@en .

aat:300387495 a skos:Concept ;
    skos:definition "Nationality and culture of territories over which the Pope had sovereignty, generally referring to those held from 756 to 1870 in central Italy, but technically encompassing more lands and a longer historical period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papal States"@en .

aat:300387496 a skos:Concept ;
    skos:definition "Culture and style of the island of Ceylon (now called \"Sri Lanka\"), particularly prior to the establishment of the modern nation of Sri Lanka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ceylonese"@en .

aat:300387497 a skos:Concept ;
    skos:definition "Style and culture of the Central Asian Mongol ethnographic group of closely related tribal peoples who live mainly on the Mongolian Plateau and share a common language and nomadic tradition. For the nationality of culture of the modern nation of Mongolia, use \"Mongolian (modern).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mongol"@en .

aat:300387498 a skos:Concept ;
    skos:definition "Areas of land drained by a river and its tributaries. For the area from which waters flow into different rivers or river basins, use watersheds \"(drainage divides).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drainage basins"@en .

aat:300387499 a skos:Concept ;
    skos:definition "High projections of land extending into a large body of water beyond the line of the coast. For lower land areas projecting into the sea and marking a notable change in coastal direction, use \"capes (landforms).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "headlands"@en .

aat:300387500 a skos:Concept ;
    skos:definition "Protected areas having boundaries that include some area of ocean or a large lake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine sanctuaries"@en .

aat:300387501 a skos:Concept ;
    skos:definition "Waterside facilities for servicing, repairing, and building small vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boatyards"@en .

aat:300387502 a skos:Concept ;
    skos:definition "Large, usually commercialized, agricultural landholdings with associated buildings and other facilities. The term is often used for former European colonial land holdings, similar to plantations. For landholdings that are intended primarily or in large part as the residence of the private owner, even if there are crops and tenant farmers, use \"estates (residential complexes).\" Meaning and usage of \"estates\" overlap with \"plantations,\" although plantations are usually larger enterprises than agricultural estates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "estates"@en .

aat:300387503 a skos:Concept ;
    skos:definition "Buildings or collections of buildings and facilities for carrying out forest management."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest stations"@en .

aat:300387504 a skos:Concept ;
    skos:definition "Organizations that consists of a number of parties or groups united in an alliance or league."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confederations"@en .

aat:300387505 a skos:Concept ;
    skos:definition "Collections of people, groups, or nations that join for mutual protection or cooperation, or for another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leagues"@en .

aat:300387506 a skos:Concept ;
    skos:definition "Independent states, or regions once independent and still distinct in race, language, institutions, or historical memories. For example, England, Scotland, and Northern Ireland are countries in the nation of the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "countries"@en .

aat:300387507 a skos:Concept ;
    skos:definition "General term for areas of a country forming the border, particularly applied to the regions at the edge of settled or inhabited regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontiers"@en .

aat:300387508 a skos:Concept ;
    skos:definition "Towns or other locations where formal conferences or councils convened, especially an assembly of magnates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parlements"@en .

aat:300387509 a skos:Concept ;
    skos:definition "Towns on the outskirts of larger metropolitan areas that are independent of the larger city's jurisdiction but dependent on its economic and social orbit. For planned communities designed to be socially or economically independent of larger metropolitan areas use \"new town.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite towns"@en .

aat:300387510 a skos:Concept ;
    skos:definition "Communities of any size, but typically of small to medium size, located on the outskirts of larger metropolitan areas that are independent of the larger city's jurisdiction but dependent on its economic and social orbit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satellite communities"@en .

aat:300387511 a skos:Concept ;
    skos:definition "Ports on a seacoast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seaports"@en .

aat:300387513 a skos:Concept ;
    skos:definition "Programming whose source code is open to all rather than proprietary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open source software"@en .

aat:300387514 a skos:Concept ;
    skos:definition "An electrode which has a high degree of selectivity for one ion over others present in a sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ion-selective electrodes"@en .

aat:300387515 a skos:Concept ;
    skos:definition "The strong outer works of a fortification, usually low enough to permit defensive fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulwarks"@en .

aat:300387516 a skos:Concept ;
    skos:definition "The highest levels of hierarchies, from which all branches descend."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hierarchy roots"@en .

aat:300387517 a skos:Concept ;
    skos:definition "Settlements or urban or suburban environments of any size that are developed according to a single plan, usually on a previously undeveloped site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planned communities"@en .

aat:300387518 a skos:Concept ;
    skos:definition "Refers to art and culture of the Karen, or Kayin, people, members of a Thai-Chinese ethnic group dwelling mainly in southern and southeastern Myanmar and in northern Thailand near the Myanmar border."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Karen"@en .

aat:300387519 a skos:Concept ;
    skos:definition "Concrete that conforms to a set of standards for high workability, high strength, and high durability established by the Strategic Highway Research Program (SHRP), an infrastructure research initiative authorized by the U.S. Congress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high performance concrete"@en .

aat:300387520 a skos:Concept ;
    skos:definition "Small communities that were typically built to accommodate the workforce of a large employer, often providing a relatively high standard of housing. Prime examples are those constructed from the late 18th century onwards by industrialists to house their workers near the factory site."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "model villages"@en .

aat:300387522 a skos:Concept ;
    skos:definition "A barrier film composed of a polymer matrix to which copper particles are bonded which blocks contaminants, ozone, bacteria, and corrosive gasses from passing through. It is used for protection and long term storage of a wide variety of metal artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Corrosion Intercept (TM)"@en .

aat:300387524 a skos:Concept ;
    skos:definition "Core or central areas of cities or towns that are either the oldest areas of the city or the core business areas. The term is thought to derive from these areas, as the oldest areas, having the lowest street numbers; alternatively, term may derive from the development of New York City, where the oldest section is in the south, at the bottom of a map."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downtowns"@en .

aat:300387525 a skos:Concept ;
    skos:definition "Areas of cities or towns that are residential or more prosperous areas, but still remaining within the central urban boundaries, not the suburbs. The term is thought to derive from these areas, in historic times, having been laid out radiating away from the older business center, thus having higher street numbers than the older areas; alternatively, the term may derive from the development of New York City, where the historical newer residential sections were in the north of Manhattan Island, at the top of a map."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uptowns"@en .

aat:300387527 a skos:Concept ;
    skos:definition "Communities, modest in size, that have economies centered on a university and the university population."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "university towns"@en .

aat:300387528 a skos:Concept ;
    skos:definition "Communities, modest in size, that grew up around or have economies centered on a cathedral and its activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedral towns"@en .

aat:300387529 a skos:Concept ;
    skos:definition "Communities of any size that are the location of a cathedral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cathedral centers"@en .

aat:300387530 a skos:Concept ;
    skos:definition "Refers to all polymerized siloxanes, especially the silicones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polysiloxane"@en .

aat:300387531 a skos:Concept ;
    skos:definition "Tracts of land set aside by the Canadian government, for the use of one or more native peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "First Nations reserves"@en .

aat:300387532 a skos:Concept ;
    skos:definition "A super-absorbent polymer, the sodium salt of polyacrylic acid, with broad commercial applications. In a conservation context, it is used as a moisture buffer material for humidity control in museum exhibit cases and in historic structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium polyacrylate"@en .

aat:300387533 a skos:Concept ;
    skos:definition "An inorganic compound used in the form of a white crystalline powder used variously as an antioxidant, a disinfectant, and a preservative in foods. In a conservation context, it has been used for removing rust stains from paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium metabisulfite"@en .

aat:300387534 a skos:Concept ;
    skos:definition "Japanese marbled paper created using the ancient technique of suminagashi, literally ‘ink dropped in water’; in which inks mixed with pine resin are dropped onto a bath of water in the marbling tray, and gently manipulated into a pattern then transferred to a sheet of plain paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suminagashi paper"@en .

aat:300387535 a skos:Concept ;
    skos:definition "Sites that are underwater and where archaeological excavations or exploration takes place. Included are shipwrecks, harbor and dock remains, fishing structures, and flooded land sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater archaeological sites"@en .

aat:300387537 a skos:Concept ;
    skos:definition "Paint formulated with a corrosive-resistant pigment and a chemical- and moisture-resistant binder. It is applied to objects made of steel and other metals that are exposed to atmospheric corrosion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anticorrosive paint"@en .

aat:300387538 a skos:Concept ;
    skos:definition "Geomorphic features of the earth's surface that are located underwater, but not undersea. For features under the surface of the ocean, use \"undersea features.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underwater landforms"@en .

aat:300387539 a skos:Concept ;
    skos:definition "White crystalline salt found naturally as mineral alunogenite; made synthetically by treating bauxite with sulfuric acid. It is used as a dye mordant, in tanning, as a flocculant in water purification, and for sizing paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum sulfate"@en .

aat:300387540 a skos:Concept ;
    skos:definition "Experimental technique used to analyze short-lived chemical intermediates created when molecules are split by an intense flash of light. Analysis by spectrophotometry follows during a second, less intense, flash. This technique is useful in the study of the mechanisms of fast chemical reactions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash photolysis"@en .

aat:300387541 a skos:Concept ;
    skos:definition "Genus of shrubby succulent plants in the family Asphodelaceae, containing hundreds of species native to Africa, Madagascar, and the Arabian Peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aloe"@en .

aat:300387542 a skos:Concept ;
    skos:definition "A white, hard, insoluble powder that naturally occurs in some feldspars, alumina trihydrate, corundum, gibbsite, bauxite, ruby, and sapphire. It is used for abrasives, refractories, electrical insulation, high temperature crucibles, dental restoration, filler for paints, glass, and ceramics. When added to glaze mixtures, aluminum oxide increases viscosity during firing, prevents devitrification during cooling and adds durability to the final surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum oxide"@en .

aat:300387543 a skos:Concept ;
    skos:definition "A synthetically produced aluminum oxide, a white or nearly colorless crystalline substance that is used as a starting material for the smelting of aluminum metal, as the raw material for a broad range of advanced ceramic products, and as an active agent in chemical processing. Alumina is derived from bauxite, a naturally occurring ore containing variable amounts of hydrous aluminum oxides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alumina"@en .

aat:300387544 a skos:Concept ;
    skos:definition "A soft, aluminum-containing ore; it is an impure mineral that contains hydrous aluminum oxides and aluminum hydroxides. It is named for one location where it was mined, Baux, France, near Arles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bauxite"@en .

aat:300387545 a skos:Concept ;
    skos:definition "Culture of Iban people in Sarawak, central Borneo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iban"@en .

aat:300387546 a skos:Concept ;
    skos:definition "In pricing studies, largest amount of money that a defined number of consumers is prepared to pay for a product or service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "willingness to pay"@en .

aat:300387547 a skos:Concept ;
    skos:definition "Isotopes of the element neodymium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neodymium isotopes"@en .

aat:300387549 a skos:Concept ;
    skos:definition "A geothermal heat pump (also known as a ground-source heat pump) transfers energy from the ground as a component of heating, cooling, and water-heating systems. A collector hose filled with a carrier fluid (water or a combination of water and antifreeze) is installed in a borehole which is drilled into a geothermal aquifer. In colder months, this circulating carrier fluid absorbs heat from the surrounding bedrock, which is then extracted by the heat pump for use in space-heating via piping connected to the heat exchanger. During the warmer months the process is reversed: heat from the air is transferred to the heat exchanger and into the fluid. As it moves through the pipes, the heat is dispersed to the rocks, soil, and groundwater."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geothermal heat pumps"@en .

aat:300387550 a skos:Concept ;
    skos:definition "A secondary mineral found in the oxidized zones of antimony-bearing lead deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bindheimite"@en .

aat:300387551 a skos:Concept ;
    skos:definition "Statutory obligation requiring all individuals and organizations to submit one or more copies of a document or publication to a recognized national institution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "legal deposit"@en .

aat:300387552 a skos:Concept ;
    skos:definition "Massive pieces of solid rock comprising the earth's crust, or lithosphere. There are two types of tectonic plates: continental and oceanic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tectonic plates"@en .

aat:300387553 a skos:Concept ;
    skos:definition "Tropical evergreen tree native to rainforests of Uganda and West Kenya named for its scarlet-orange flowers which resemble tulips in shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spathodea campanulata"@en .

aat:300387554 a skos:Concept ;
    skos:definition "Class of protective proteins, naturally present in the body or produced by the immune system, which target harmful foreign substances, called antigens, in order to remove them from the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antibodies"@en .

aat:300387555 a skos:Concept ;
    skos:definition "The use of digital technology to overlay visual real-life representations, usually provided through video, with computer-generated data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "augmented reality"@en .

aat:300387556 a skos:Concept ;
    skos:definition "Vulture species formerly common in the mountains of the western United States. Once nearly extinct, the species has been sustained by breeding in captivity. A carefully controlled conservation program has led to inreasing numbers of birds released into the wild."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gymnogyps californianus"@en .

aat:300387557 a skos:Concept ;
    skos:definition "Entities that share sovereignty in constitutional federal union, and have transferred a portion of their sovereign powers to a federal government. Federated states may be called provinces, states, Lands, cantons, or other terms, depending upon usage within a particular nation. Examples of federated states are in the United States, Brazil, Canada, and many other nations. For entities retaining complete sovereignty, use \"sovereign states.\" For territories within a federation that do not share sovereignty, use \"federal territory.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "federated states"@en .

aat:300387558 a skos:Concept ;
    skos:definition "The New World vulture family of carnivorous birds, containing seven species in five genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cathartidae"@en .

aat:300387559 a skos:Concept ;
    skos:definition "Genus of the New World vulture family containing a single species, Gymnogyps californianus, the California condor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gymnogyps"@en .

aat:300387561 a skos:Concept ;
    skos:definition "Strong internal rectangular supports for the rails in railroad tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad ties"@en .

aat:300387562 a skos:Concept ;
    skos:definition "Materials-related distress arising from a simple acid-base reaction between alkali hydroxyl ions in portland cement and siliceous minerals. Found in many aggregates, it results in premature deterioration of concrete structures including bridges, dams, and pavements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkali-silica reaction"@en .

aat:300387563 a skos:Concept ;
    skos:definition "Refers to papers made by traditional papermaking traditions of Korea; may be made from a variety of materials, chiefly mulberry bark, but also hemp, bamboo leaves, rice-straw and pine-needles. Korean paper is typically denser than most Chinese paper and is known for its high purity and durability."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Korean paper"@en .

aat:300387565 a skos:Concept ;
    skos:definition "Geographic latitude is the angular distance north or south of the equator, measured along a meridian. Parallels of latitude are equidistant circles drawn around the globe parallel to the equator."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "latitude"@en .

aat:300387566 a skos:Concept ;
    skos:definition "A copper arsenic sulfide mineral found in hydrothermal veins and contact metamorphic sites, usually containing some antinomy and grading into closely related mineral tetrahedrite, in which antinomy takes the place of arsenic. It is a minor ore of copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tennantite"@en .

aat:300387567 a skos:Concept ;
    skos:definition "The angular distance east or west of the Prime Meridian, which runs through Greenwich, England. Meridians are imaginary north-south lines on the Earth's surface that connect both geographic poles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "longitude"@en .

aat:300387568 a skos:Concept ;
    skos:definition "A copper antinomy sulfide mineral found in hydrothermal veins and contact metamorphic sites, usually containing some arsenic and grading into closely related mineral tennantite, in which arsenic takes the place of antinomy. It is a minor ore of copper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetrahedrite"@en .

aat:300387569 a skos:Concept ;
    skos:definition "Geographic coordinates are sets of two magnitudes used indicate a point on the globe, typically expressed in degrees/ minutes/ seconds/ direction or decimal fractions of degrees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coordinates"@en .

aat:300387570 a skos:Concept ;
    skos:definition "Testing and evaluation techniques that do not require touching the sample, as when there is a distance between the probe and the tested object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noncontact testing"@en .

aat:300387571 a skos:Concept ;
    skos:definition "The transformation of a substance from a solid or gaseous state to a liquid state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquefaction"@en .

aat:300387572 a skos:Concept ;
    skos:definition "Various forms of remote education in which the instructor and students are physically separated and communication is effected by written, audiovisual, or electronic media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "distance learning"@en .

aat:300387573 a skos:Concept ;
    skos:definition "Anaerobic bacteria which obtain energy by converting sulfate compounds into sulfide compounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfate-reducing bacteria"@en .

aat:300387574 a skos:Concept ;
    skos:definition "Direct positive collodion images made on glass and transferred to a secondary support, originally black waxed linen, but also patent leather, black oil cloth, or black enameled paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pannotypes"@en .

aat:300387575 a skos:Concept ;
    skos:definition "General term for natural or administrative expanses having rough boundaries and located on the surface of Earth or another planet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "areas"@en .

aat:300387576 a skos:Concept ;
    skos:definition "Refers to museum methods of classification, description and display of objects; the practical application of the body of theory known as museology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "museography"@en .

aat:300387577 a skos:Concept ;
    skos:definition "Frames that incorporate microclimate systems to reduce fading and preserve sensitive works of art, particularly photographs and works on paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microclimate frames"@en .

aat:300387578 a skos:Concept ;
    skos:definition "The liquid phase that forms on the melting or dissolving of an ionic compound and which is composed of the dissociated ions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ionic liquid"@en .

aat:300387580 a skos:Concept ;
    skos:definition "Unique numeric, alphabetic, alphanumeric, or other codes that identify or reference a thing, concept, or record, and that are reliable and longlasting. An example of a persistent identifier is as used for digital objects. Persistent identifier systems include \"persistent object identifiers\" (POIDs) and \"digital object Identifiers\" (DOIs)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "persistent identifiers"@en .

aat:300387581 a skos:Concept ;
    skos:definition "Geomorphic features of the earth's surface that are located below the sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "undersea landforms"@en .

aat:300387582 a skos:Concept ;
    skos:definition "Gum derived from the tree Butea Monosperma native to parts of Southeast Asia and India. Used variously in cooking; as an astringent in medicine; and is valued for its tannin content in leather working."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butea gum"@en .

aat:300387583 a skos:Concept ;
    skos:definition "General term for works, particularly contemporary works, that integrate sound and the visual arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound art"@en .

aat:300387584 a skos:Concept ;
    skos:definition "Evaluation tests used for museum storage materials in order to detect any emission of faint amounts of chemicals that can damage objects over time. Created in 1973 by conservation scientist Andrew Oddy.The test material is enclosed in an airtight reaction vessel with three small metal coupons: copper, silver and lead. The container is sealed with a small amount of water to maintain a high humidity, then heated at 60 degrees Celsius for 28 days. An identical container with three metal coupons acts as a control. At the end of the trial, the metal coupons are monitored for corrosion effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oddy test"@en .

aat:300387585 a skos:Concept ;
    skos:definition "Interdisciplinary art installations that incorporate sound into physical environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound installations"@en .

aat:300387586 a skos:Concept ;
    skos:definition "Self-stick slips of note paper with a re-adherable adhesive strip on the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sticky notes"@en .

aat:300387587 a skos:Concept ;
    skos:definition "Granular elemental bismuth used as a pigment. Bismuth black was first identified during technical examination of the works of late 15th-century manuscript illuminator Jean Bourdichon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bismuth black"@en .

aat:300387588 a skos:Concept ;
    skos:definition "Artists that integrate sound with visual art, often in the form of sound sculptures and sound installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound artists"@en .

aat:300387589 a skos:Concept ;
    skos:definition "Relatively large areas of land that have boundaries formed by oceans, seas, or other bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landmasses"@en .

aat:300387590 a skos:Concept ;
    skos:definition "Aluminum compound used in solution to stabilize deteriorated leather. The basis of this treatment is cross linking of aluminium ions with the collagen in the degraded leather and the introduction of an alkaline buffer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aluminum alkoxide"@en .

aat:300387591 a skos:Concept ;
    skos:definition "A thread count is a measurement technique that determines the compactness of a fabric by counting the number of warp yarns and filling yarns in 1 square inch of fabric."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thread count"@en .

aat:300387592 a skos:Concept ;
    skos:definition "Online publishing model that allows users to access texts for free and to copy, distribute, and print without copyright restrictions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open access publishing"@en .

aat:300387593 a skos:Concept ;
    skos:definition "Hydrographic features, including grounds, banks, or other watery areas, where fishermen go to catch fish. For places on land where fishermen gather, use \"fishing spots.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fishing areas"@en .

aat:300387594 a skos:Concept ;
    skos:definition "Extremely sensitive gas chromatography detectors that allow man-made chemicals to be detected in low concentrations through the attachment of electrons via electron capture ionization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron capture detectors"@en .

aat:300387595 a skos:Concept ;
    skos:definition "Size exclusion chromatography technique that uses electrophoresis to resolve and separate large biomolecules; also known as electropherography."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrochromatography"@en .

aat:300387596 a skos:Concept ;
    skos:definition "A non-destructive testing method that is a form of themographic inspection involving imaging of the thermal patterns on a sample surface heated by a brief pulse of light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash thermography"@en .

aat:300387597 a skos:Concept ;
    skos:definition "In structural engineering, quantification and rating of damages and potential damages to structures; for example, measures of seismic damage potential based on ground motion records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damage indices"@en .

aat:300387598 a skos:Concept ;
    skos:definition "Plant communities that are dominated by trees and other woody vegetation. A typical forest is composed of the overstory and the understory; the understory may be subdivided into the lower tree layer, shrub layer, herb layer, moss layer, and soil microbes. Today forests occupy approximately one-third of the earth's land area. For forests in the sense of cultural landscape rather than as a plant community, use \"forests (cultural landscapes).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forests"@en .

aat:300387599 a skos:Concept ;
    skos:definition "Genus of Old World tropical trees and shrubs of the madder family (Rubiaceae), containing more than 140 species. Gardenias have fragrant, tubular, white or yellow flowers, evergreen leaves, and berry-like fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gardenia"@en .

aat:300387601 a skos:Concept ;
    skos:definition "Forests located near the equator, within the area bounded by latitudes 23.5 degrees N and 23.5 degrees S. Tropical forests include the rainforest, the cloud forest, and the dry forest, such as the pine savanna and others. One of the major characteristics of tropical forests is their distinct seasonality: winter is absent, and only two seasons are present, rainy and dry. The length of daylight is 12 hours and varies little. Of all earth’s environments, they harbor the greatest diversity of species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tropical forests"@en .

aat:300387602 a skos:Concept ;
    skos:definition "Refers to the activity of creating photographic images covering a very wide angle of view. In the digital realm, it has been applied to the construction of virtual reality; as with panoramic exhibits of cultural heritage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panoramic photography"@en .

aat:300387603 a skos:Concept ;
    skos:definition "Forests of coniferous or broad-leaved trees, characterized by well-defined seasons with a distinct winter. Such forests have a moderate climate with 4 to 6 frost-free months and a growing season of 140-200 days. They are located in eastern North America, northeastern Asia, and western and central Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate forests"@en .

aat:300387604 a skos:Concept ;
    skos:definition "Massive upright ceramic jars historically used for burial in parts of southeastern Asia such as the Yeongsan River area, South Korea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jar coffins"@en .

aat:300387605 a skos:Concept ;
    skos:definition "A soft, gray or black antimony sulfide mineral; the chief ore of antimony. In powdered form, it was occasionally used as an eye paint in Egypt from the Amarna period onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stibnite"@en .

aat:300387606 a skos:Concept ;
    skos:definition "Tropical forests characterized by dense canopies of broad-leaved trees and other vegetation that form three different layers; located in areas having no dry season; an example is the Amazon rainforest in Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evergreen rainforests"@en .

aat:300387607 a skos:Concept ;
    skos:definition "Tropical forests of coniferous or broad-leaved trees that lose their leaves during the dry season; trees do not grow close together and there are few climbing plants. Seasonal rainforests are found in areas having short dry periods in an otherwise very wet tropical region. They are located between the tropical rain forests and the tropical savannas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seasonal rainforests"@en .

aat:300387608 a skos:Concept ;
    skos:definition "Tropical forests with an upper story of deciduous trees and a lower story of evergreen, located in areas having a longer dry season than a seasonal rainforest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semi-evergreen forests"@en .

aat:300387609 a skos:Concept ;
    skos:definition "Tropical forests deciduous trees, located in areas having a considerable dry season in the low-sun part of the year, huge precipitation totals in the high-sun period, and no freezing temperatures. Examples are in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moist/dry deciduous forests"@en .

aat:300387610 a skos:Concept ;
    skos:definition "Temperate forests of conifer and evergreen broad-leaved trees, located in areas having wet winters and dry summers; rainfall is concentrated in the winter months and winters are relatively mild."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moist conifer and evergreen broad-leaved forests"@en .

aat:300387611 a skos:Concept ;
    skos:definition "Temperate forests of coniferous trees that dominate higher elevation zones in areas having low precipitation. Examples are in the northern Rocky Mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry conifer forests"@en .

aat:300387612 a skos:Concept ;
    skos:definition "Temperate forests of differing vegetation types as influenced by variations in topography, soil, and exposure to wind, sun, and fire. Woody vegetation in the mediterranean forest is usually sclerophyll, having small, dark leaves covered with a waxy outer layer to retain moisture. Mediterranean forests are located where precipitation is less than 100 cm per year, concentrated in the winter season."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mediterranean forests"@en .

aat:300387613 a skos:Concept ;
    skos:definition "Temperate forests of primarily coniferous evergreen trees, located in areas having mild winters and high annual precipitation of greater than 200 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate coniferous forests"@en .

aat:300387614 a skos:Concept ;
    skos:definition "Temperate forests of broad-leaved trees in areas having mild, frost-free winters and high precipitation of more than 150 cm annually, evenly distributed throughout the year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate broad-leaved rainforests"@en .

aat:300387616 a skos:Concept ;
    skos:definition "The earth's major animal and plant communities, classified according to the predominant vegetation and characterized by adaptations of organisms to that particular environment. The number and description of biomes varies depending upon the classification used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biomes"@en .

aat:300387617 a skos:Concept ;
    skos:definition "Biomes surrounding freshwater environments, defined as having a low salt concentration of less than 1%. Plants and animals in freshwater regions are adjusted to the low salt content and would not be able to survive in areas of high salt concentration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freshwater biomes"@en .

aat:300387618 a skos:Concept ;
    skos:definition "Biomes surrounding marine environments surrounding oceans, coral reefs, and estuaries. Marine algae supply much of the world's oxygen supply and take in a huge amount of atmospheric carbon dioxide; the evaporation of the seawater provides rainwater for the land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine biomes"@en .

aat:300387619 a skos:Concept ;
    skos:definition "Biomes surrounding desert environments occurring where rainfall is less than 50 cm annually. Most deserts occur at low latitudes, although cold deserts occur elsewhere. Most deserts have a considerable amount of specialized vegetation, as well as specialized vertebrate and invertebrate animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "desert biomes"@en .

aat:300387620 a skos:Concept ;
    skos:definition "Biomes surrounding forest environments, which in the present day include biological communities dominated by trees and other woody vegetation. The first forests were dominated by giant horsetails, club mosses, and ferns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forest biomes"@en .

aat:300387621 a skos:Concept ;
    skos:definition "Biomes surrounding grassland environments, which occur in lands dominated by grasses rather than large shrubs or trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grassland biomes"@en .

aat:300387622 a skos:Concept ;
    skos:definition "Biomes surrounding tundra environments, which occur in frost-molded landscapes, having extremely low temperatures, little precipitation, poor nutrients, and short growing seasons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tundra biomes"@en .

aat:300387623 a skos:Concept ;
    skos:definition "A movement originating in the United States during the 1950s that began primarily with literature but encompasses other social and artistic modes. Mostly an urban phenomenon, centers included artist communities in San Francisco’s North Beach and Greenwich Village in New York City. In popular culture participants of this loose movement were referred to derisively as “beatniks.” Progenitors of the movement are considered to be the writers Jack Kerouac, Allen Ginsburg and William Burroughs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beat generation"@en .

aat:300387625 a skos:Concept ;
    skos:definition "Refers to a diverse class of organic carbon compounds into which fluorine has been introduced creating a remarkably strong carbon-fluorine bond. This unusual property has led to the development of organofluorine compounds targeting specific needs in medicine, plastics, textiles, refrigeration and other areas. Some like the fluorocarbons also serve as ozone depletors and pollutants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organofluorine"@en .

aat:300387626 a skos:Concept ;
    skos:definition "Large natural depressions in the earth's surface that contain water, usually salt water, including oceans and seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine bodies of water"@en .

aat:300387627 a skos:Concept ;
    skos:definition "Natural depressions or courses in the earth's surface that contain standing or flowing freshwater, including rivers and lakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bodies of freshwater"@en .

aat:300387628 a skos:Concept ;
    skos:definition "Variety of andesite produced by now-extinct volcanoes in the Inland Sea area of Japan. It was used during the Paleolithic and Postglacial periods for stone implements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanukite"@en .

aat:300387631 a skos:Concept ;
    skos:definition "Reefs or banks of rock in warm, shallow ocean waters that are formed by the growth and deposit of coral. They can be found as barriers along continents, and fringing islands, and atolls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coral reefs"@en .

aat:300387632 a skos:Concept ;
    skos:definition "Marine areas surrounding coral reefs, which are formed by the growth and deposit of coral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coral reef areas"@en .

aat:300387633 a skos:Concept ;
    skos:definition "One of two long-lived species of bristlecone pine (the other is Pinus aristata) that grow at high altitudes in the Western U.S. Pinus longaeva lives longer than any other tree. Dendrochronological studies have produced a continuous tree-ring sequence back to 6700 BC for a sample in the White Mountains of California. Like other bristlecone pines, its cones have long curving spines on each scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pinus longaeva"@en .

aat:300387635 a skos:Concept ;
    skos:definition "Deserts having seasons that are generally warm throughout the year and very hot in the summer; winters usually bring little rainfall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hot and dry deserts"@en .

aat:300387636 a skos:Concept ;
    skos:definition "Deserts having summers that are moderately long and dry, and like hot deserts, the winters normally bring low concentrations of rainfall. Summer temperatures usually average between 21-27 degrees C. Soil may be sandy or rocky."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "semiarid deserts"@en .

aat:300387637 a skos:Concept ;
    skos:definition "Deserts along coasts, having cool winters followed by moderately long, warm summers. The average summer temperature ranges from 13-24 degrees C; the average rainfall measures 8-13 cm annually. The soil is fine-textured with a moderate salt content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coastal deserts"@en .

aat:300387638 a skos:Concept ;
    skos:definition "Deserts having cold winters with snowfall and high overall rainfall throughout the winter and occasionally over the summer. They have short summers averaging 21-26 degrees C with long, cold winters averaging -2 to 4 degrees C. Winters may receive significant snow, with annual precipitation 15-26 cm. Examples are in the Antarctic, Greenland, and the Nearctic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cold deserts"@en .

aat:300387639 a skos:Concept ;
    skos:definition "Art works that have a temporal immediacy or are built with the recognition that they will disintegrate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ephemeral art"@en .

aat:300387640 a skos:Concept ;
    skos:definition "Lands having grasses as the dominant vegetation, with trees and large shrubs absent. Temperatures vary more from summer to winter, and the amount of rainfall is less in temperate grasslands than in savannas. Examples are in South Africa, Hungary, Argentina and Uruguay, Russia, and the plains and prairies of central North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate grasslands"@en .

aat:300387642 a skos:Concept ;
    skos:definition "Tundras located in the northern hemisphere, encircling the north pole and extending south to the coniferous forests. Arctic tundras have cold, desert-like conditions, with a growing season from 50 to 60 days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arctic tundras"@en .

aat:300387643 a skos:Concept ;
    skos:definition "Tundras located on mountains throughout the world at high altitude where trees cannot grow. The growing season is approximately 180 days."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alpine tundras"@en .

aat:300387644 a skos:Concept ;
    skos:definition "A zinc compound dark in color when found in nature as the mineral sphalerite but a fluorescent white once cleaned of impurities. Zinc sulfide was first sythesized as a pigment in 1852."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zinc sulfide"@en .

aat:300387645 a skos:Concept ;
    skos:definition "Biomes characterized by hot, dry summers, and cool, moist winters and vegetation comprising aromatic herbs (sage, rosemary, thyme, oregano), shrubs, acacia, chamise, and grasses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shrubland biomes"@en .

aat:300387646 a skos:Concept ;
    skos:definition "Biomes that are warm and frost-free, characterized by tempratures ranging 20-25 degrees C and with precipitation 98-180 inches per year. Typical vegetation includes vines, palm trees, orchids, and ferns. There are two types of rainforests, tropical and temperate. Tropical rainforests are found closer to the equator and temperate rainforests are found farther north near coastal areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rainforest biomes"@en .

aat:300387647 a skos:Concept ;
    skos:definition "Biomes that have cold, long, snowy winters, and warm, humid summers, with well-defined seasons and at least four to six frost-free months; temperatures range -40 to 20 degrees C, and rainfall is 300-900 mm per year. They are characterized by coniferous-evergreen trees and are located in North America, Europe, and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coniferous forest biomes"@en .

aat:300387648 a skos:Concept ;
    skos:definition "Biomes that go through four season: leaves change color in autumn, fall off in the winter, and grow back in the spring; this adaptation allows plants to survive cold winters. Temperatures range -30 to 30 degrees C, with annual percipitation 750-1500 mm. Vegetation includes broadleaf trees, shrubs, perennial herbs, and mosses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate deciduous forests biomes"@en .

aat:300387649 a skos:Concept ;
    skos:definition "Temperate forests of broadleaf trees (e.g., oaks, maples, beeches), shrubs, perennial herbs, and mosses in areas that go through four seasons. Examples are in the Eastern United States, Canada, Europe, China, and Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temperate deciduous forests"@en .

aat:300387650 a skos:Concept ;
    skos:definition "Settlements of relatively large size for which precise locations are no longer known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost cities"@en .

aat:300387651 a skos:Concept ;
    skos:definition "Settlements of relatively small size for which precise locations are no longer known."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost villages"@en .

aat:300387652 a skos:Concept ;
    skos:definition "Physical features that contain water, either natural or man-made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydrographic features"@en .

aat:300387653 a skos:Concept ;
    skos:definition "Natural physical features that do not contain water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrestrial features"@en .

aat:300387654 a skos:Concept ;
    skos:definition "Massive self-luminous celestial bodies of gas that shine by radiation derived from internal energy sources. There are tens of billions of trillions of stars composing the visible universe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stars"@en .

aat:300387655 a skos:Concept ;
    skos:definition "Sites that were originally on dry land but have been submerged or flooded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "submerged sites"@en .

aat:300387656 a skos:Concept ;
    skos:definition "Concepts related to the universe beyond the earth's atmosphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "astronomical concepts"@en .

aat:300387657 a skos:Concept ;
    skos:definition "Tree that produces a type of sour orange; it is a hybrid grown in the Mediterranean region, chiefly in Calabria, Italia, Citrus bergamia is most probably a hybrid between sour orange (C. aurantium L.) and lemon (C. limon (L.) Burm.f.), or a mutation of the latter. Common Bergamot is commercially cultivated for the essential oil derived from the rind, the fruit itself is not eaten. The oil is used in the production of perfumes and confectionery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Citrus bergamia"@en .

aat:300387658 a skos:Concept ;
    skos:definition "Natural arches that have been formed by a current of water, often leaving a formation that resembles a bridge. For similar structures that were not formed by a current of water, use the broader \"natural arches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural bridges"@en .

aat:300387659 a skos:Concept ;
    skos:definition "Communities of small size where the central economic activities are built around tourism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourist villages"@en .

aat:300387660 a skos:Concept ;
    skos:definition "Painting technique that explores luminosity through the use of fluorescent paints which reflect absorbed ultraviolet energy as visible light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescent painting"@en .

aat:300387661 a skos:Concept ;
    skos:definition "Creative works in the medium of fluorescent paint which reflects absorbed ultraviolet energy as visible light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescent paintings"@en .

aat:300387662 a skos:Concept ;
    skos:definition "Communities of modest size in which a prison and activities supporting the prison are primary industries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prison towns"@en .

aat:300387664 a skos:Concept ;
    skos:definition "German Renaissance double-reed wind instruments; wind cap shawms in the soprano range with a reedy tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rauschpfeifes"@en .

aat:300387665 a skos:Concept ;
    skos:definition "People in medieval Germany and later who were appointed as the judicial and military representatives of the king in a burg, which was a fortified town. Eventually the title became hereditary and was associated with not only the burg but also the surrounding domain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burgraves"@en .

aat:300387666 a skos:Concept ;
    skos:definition "A red, nodular limestone; a Jurassic sedimentary that crops out in the Trento Plateau in the Southern Alps. It is a common building stone in Northern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosso ammonitico Veronese"@en .

aat:300387667 a skos:Concept ;
    skos:definition "Refers to a type of bronze, square four-legged ceremonial food vessel type popular in Anyang, the last capital of the Shang dynasty, during the Erligang period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fang ding"@en .

aat:300387668 a skos:Concept ;
    skos:definition "Communities of very small size that hold a market, typically agricultural centers in a rural area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market hamlets"@en .

aat:300387669 a skos:Concept ;
    skos:definition "Communities of relatively small size that hold a market, typically agricultural centers in a rural area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "market villages"@en .

aat:300387670 a skos:Concept ;
    skos:definition "Types of feudal lords to whom vassals paid tribute. If the vassal broke the feudal contract, the suzerain regained his fief by escheat. For the entities in modern international relations, where state has supremacy over another state which possesses its own ruler or government but cannot act as an independent power, use \"suzerains (states).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suzerains"@en .

aat:300387671 a skos:Concept ;
    skos:definition "Formerly classed as a species of hibiscus, now assigned to the genus Abelmoschus: an edible leafy green malvaceous plant closely related to okra (Abelmoschus esculentus). It is native to tropical Africa, Asia and northern Australia. In cooking, its seedpods are fried or used to thicken soups and stews. The roots of Abelmoschus manihot are used for cordage and are also the source of a mucilaginous substance used as a dispersion aid in traditional papermaking in East Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abelmoschus manihot"@en .

aat:300387672 a skos:Concept ;
    skos:definition "A genus containing about 15 malvaceous plants native to tropical Africa, Asia and northern Australia. Its members were formerly grouped within the genus Hibiscus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abelmoschus"@en .

aat:300387673 a skos:Concept ;
    skos:definition "Evolved gas analysis (EGA) is a technique whereby temperature-resolved, volatile species generated from a sample placed within a microfurnace are analyzed using mass spectrometry. It is the most useful technique to determine the nature and amount of volatile products formed during the thermal degradation of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evolved gas analysis"@en .

aat:300387674 a skos:Concept ;
    skos:definition "Cost-effectiveness analysis (CEA) is a form of economic evaluation that compares the relative costs and effects of alternative courses of action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cost-effectiveness analysis"@en .

aat:300387675 a skos:Concept ;
    skos:definition "Type of banded wine cup common throughout the Mediterranean in the sixth and seventh centuries BCE. The designation is something of a misnomer as the cups were made in several parts of the Greek world including Sicily and Southern Italy. Nonetheless, they are ultimately dependent on an East Greek model."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ionian cups"@en .

aat:300387676 a skos:Concept ;
    skos:definition "Refers to culture and artifacts of the original Paleo-Indian inhabitants of the San Diego coastal belt, ca. 7500 BC. It is characterized by manufacture of scrapers and percussively flaked knives made from fine grain volcanic stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "San Dieguito"@en .

aat:300387677 a skos:Concept ;
    skos:definition "Apparatuses, instruments, or other objects used to produce sound, whether musical or nonmusical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sound devices"@en .

aat:300387679 a skos:Concept ;
    skos:definition "Calcium hydroxide particles with submicrometric dimensions synthesized by a chemical precipitation process. The nanoparticles dispersed in ethanol have been used as a conservation treatment for consolidating calcareous historic materials damaged by water uptake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanolime"@en .

aat:300387680 a skos:Concept ;
    skos:definition "Refers to special effect pigments that mimic the luster of pearl. These include 'fish silver' (also known as 'natural pearl essence'), a pigment suspension derived from fish scales, skin, or bladder. It is the oldest pearl luster pigment known. In modern times, mica is the most important substrate for pearlescent pigments. Metal oxide-coated mica pigments have been used in commercial artists' paints since 1985 and are widely accepted as retouching pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearlescent pigment"@en .

aat:300387681 a skos:Concept ;
    skos:definition "Peptide mass fingerprinting (PMF) is an analytic technique for protein identification. Proteins extracted from the proteome of a sample are individually digested using a protease into a series of smaller peptides. The set of masses of these peptide fragments is then measured with a mass spectrometer, forming a peptide mass fingerprint of the protein which can then be compared with known protein sequences for this organism in a protein sequence database."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peptide mass fingerprinting"@en .

aat:300387683 a skos:Concept ;
    skos:definition "Species of large bird in the hornbill family, found in the Malay peninsula, Sumatra, and Borneo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhinoplax vigil"@en .

aat:300387685 a skos:Concept ;
    skos:definition "The motion of air or the act of causing a current of air through a space. An example is the admission of a proper supply of fresh air to a room, building, mine, or other place where the air readily becomes stagnant or unhealthy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ventilation"@en .

aat:300387686 a skos:Concept ;
    skos:definition "General term for the form of information artifacts created by gathering and binding together folded leaves. Primary examples are books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gathered matter"@en .

aat:300387688 a skos:Concept ;
    skos:definition "Refers to networks of autonomous sensor nodes monitoring environmental or physical conditions at diverse locations that pass their data via wireless technology to a central location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wireless sensor networks"@en .

aat:300387689 a skos:Concept ;
    skos:definition "The design, graphic forms, or shapes of letters or symbols, either as written by hand or as represented in a particular type font. Referenced most often in the fields of typography, paleography, calligraphy, and epigraphy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letterforms"@en .

aat:300387691 a skos:Concept ;
    skos:definition "Organisms whose presence or absence, numbers, and/or condition in an environment or ecosystem serve as an indicator of a pollutant’s presence and its effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioindicators"@en .

aat:300387692 a skos:Concept ;
    skos:definition "Non-invasive neutron diffraction technique that characterizes the size distribution and surface characteristics of various substances at a scale of about 1-1000 nanometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small angle neutron scattering"@en .

aat:300387693 a skos:Concept ;
    skos:definition "Made of a liquid other than water or pertaining to an activity alternative to one that otherwise employs water: for example, nonaqueous cleaning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nonaqueous"@en .

aat:300387694 a skos:Concept ;
    skos:definition "Agricultural complexes used for growing lemons. Composed of high perimiter walls and interconnected pillars often with with movable shutters, opened or closed in correspondence to warm and cold weather. Limonaie are chiefly associated with the area surrounding Lake Garda in Northern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limonaie"@en .

aat:300387695 a skos:Concept ;
    skos:definition "Techniques used to create images that display a higher luminous dynamic range than is possible with a single conventional exposure. This may be achieved with a series of conventional exposures captured with differing values, or via a laser scanner with high dynamic range (HDR) texture compression that records a range in excess of what normal digital imaging techniques allow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high dynamic range imaging"@en .

aat:300387696 a skos:Concept ;
    skos:definition "Field of study surrounding the earth's topologic features above sea level, especially the measurement and mapping of land features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypsography"@en .

aat:300387698 a skos:Concept ;
    skos:definition "Physical features located on land, particularly those above sea level; either natural or man-made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypsographic features"@en .

aat:300387699 a skos:Concept ;
    skos:definition "The details, manner, or position in which anything is set, fixed, or placed. Examples include the props and surroundings of a figure in a portrait or the literary framework of a narrative or other composition. For the sets or aggregates of physical things, conditions, and influences surrounding and affecting an organism, object, or structure, use \"environments (object groupings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "setting"@en .

aat:300387700 a skos:Concept ;
    skos:definition "Armatures or frameworks of metal or another material in which a jewel is mounted or set. The purpose of a setting is to protect the jewel or to allow it to be worn or displayed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "settings"@en .

aat:300387701 a skos:Concept ;
    skos:definition "Features that contain water and are man-made rather than natural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "man-made hydrographic features"@en .

aat:300387703 a skos:Concept ;
    skos:definition "Construction of digital, virtual objects or structures based on historic, archaeological, or other similar evidence. Includes manipulation via software of digital copies of damaged objects to effect a virtual restoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital reconstruction"@en .

aat:300387704 a skos:Concept ;
    skos:definition "Features above sea level that are man-made rather than natural. Included are large mounds and other features that resemble natural features; excluded are buildings and bridges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "man-made hypsographic features"@en .

aat:300387705 a skos:Concept ;
    skos:definition "Features comprising communities of plants, whether natural or artificial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vegetation features"@en .

aat:300387706 a skos:Concept ;
    skos:definition "Laser-based instruments operating on the time of flight principle for determining the distance from an observer to particular objects; used for topographic measurement as used, for example, by space probes to profile the surface of Mars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser rangefinders"@en .

aat:300387707 a skos:Concept ;
    skos:definition "Method for capturing 3D data of large areas using an airborne laser illuminating device to scan successive narrow strips of the ground, producing a picture of the terrain over which an aircraft is flying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "airborne laser scanning"@en .

aat:300387708 a skos:Concept ;
    skos:definition "Features comprising communities of plants that are grown by man rather than being natural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "man-made vegetation features"@en .

aat:300387709 a skos:Concept ;
    skos:definition "Features that are located in the sea under sea level and are made artificially rather than being natural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "man-made undersea features"@en .

aat:300387710 a skos:Concept ;
    skos:definition "Human-made underwater structures built to promote marine life in areas with a generally featureless bottom, to control erosion, or for another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial reefs"@en .

aat:300387712 a skos:Concept ;
    skos:definition "In geography, the perimeters of each continent and the associated coastal plain; now, during the current interglacial period, submerged under relatively shallow seas. Much of the continental shelves' area was exposed during glacial periods. In international law, under the United Nations Convention on the Law of the Sea, the \"continental shelf\" is defined as the stretch of the seabed adjacent to the shores of a particular country to which it belongs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "continental shelves"@en .

aat:300387713 a skos:Concept ;
    skos:definition "Luminescence spectroscopy is a collective name given to three related spectroscopic techniques dependent on emission of light from a substance. They are: molecular fluorescence spectroscopy; molecular phosphorescence spectroscopy; and chemiluminescence spectroscopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luminescence spectroscopy"@en .

aat:300387714 a skos:Concept ;
    skos:definition "Collective term used to refer to all art works which employ electronic media or technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic art"@en .

aat:300387715 a skos:Concept ;
    skos:definition "Any crystalline substance belonging to the class of zeolites as used for separation and filtering. Molecular sieves are honeycombed with regularly spaced cavities of uniform and very small size that block larger, foreign molecules and let smaller ones pass. A typical use is as response to vinegar syndrome in film. The molecular sieve has been employed as a scavenger for the acetic acid emitted during acetate-based negative degradation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "molecular sieves"@en .

aat:300387716 a skos:Concept ;
    skos:definition "Inhabited places in which a government, ruling house, or court is established or set up over a region or realm; often also the capital of the region or realm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seats"@en .

aat:300387717 a skos:Concept ;
    skos:definition "Styles and cultures characteristic of the Alps, a major European mountain chain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alpine"@en .

aat:300387718 a skos:Concept ;
    skos:definition "The styles and cultures characteristic of Alsace, a general region now in France but formerly in Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alsatian"@en .

aat:300387719 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the city of Paris, France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parisian"@en .

aat:300387720 a skos:Concept ;
    skos:definition "The nationality and culture of the German Democratic Republic (1949-1990), or the area corresponding to this (prior to 1949, the Soviet-occupied parts of Germany; after 1990, the area of reunified Germany which was formerly the GDR)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "East German"@en .

aat:300387721 a skos:Concept ;
    skos:definition "Related to the style or culture of the Abruzzo region of central Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Abruzzese"@en .

aat:300387722 a skos:Concept ;
    skos:definition "Nationality and culture of the historical Emilia region of northern Italy, corresponding to the western and northeastern portions of modern Emilia-Romagna. It takes its name from the Roman road, Via Aemilia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Emilian"@en .

aat:300387723 a skos:Concept ;
    skos:definition "Nationality, culture, and style of Ferrara, a city in Emilia-Romagna, northern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ferrarese"@en .

aat:300387724 a skos:Concept ;
    skos:definition "Nationality or culture of the city of Rome and surrounding areas in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman"@en .

aat:300387725 a skos:Concept ;
    skos:definition "Nationality, culture, or style of Estonia, a country stretching along the south coast of the Gulf of Finland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Estonian"@en .

aat:300387726 a skos:Concept ;
    skos:definition "Nationality or culture of Herzegovina, a country in southeastern Europe, now part of Bosnia and Herzegovina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Herzegovinian"@en .

aat:300387727 a skos:Concept ;
    skos:definition "General term for the cultures and styles, regardless of period, of the westernmost protrusion of Asia, which makes up the majority of the modern Republic of Turkey. To refer to the ancient cultures of this region, use \"Anatolian,\" although there is overlap in usage. To distinguish the nationality of the modern nation of Turkey, use \"Turkish.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asia Minor"@en .

aat:300387729 a skos:Concept ;
    skos:definition "Nationality and culture of the United Arab Emirates, which is diverse, including heritage from the Arabian Peninsula, East Africa, Iran, Baluchistan, India, Pakistan, and Bangladesh."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Emirati"@en .

aat:300387730 a skos:Concept ;
    skos:definition "The Islamic culture and styles that developed in Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian Islamic"@en .

aat:300387731 a skos:Concept ;
    skos:definition "The Islamic style and culture of Anatolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian Islamic"@en .

aat:300387733 a skos:Concept ;
    skos:definition "Nationality, period, and culture of ancient Herakleopolis or Heracleopolis Magna, the capital of the Twentieth nome of ancient Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Heracleopolitan"@en .

aat:300387734 a skos:Concept ;
    skos:definition "Culture and styles of historic Turkestan, a region in Central Asia inhabited by Turkic and other peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turkestani"@en .

aat:300387735 a skos:Concept ;
    skos:definition "Nationality and culture of Hong Kong, a region on the southern coast of China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hong Kong"@en .

aat:300387737 a skos:Concept ;
    skos:definition "Style or culture containing characteristics and derivations from both Africa and Asia, particularly as related to the Middle East and North Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afro-Asiatic"@en .

aat:300387739 a skos:Concept ;
    skos:definition "The nationality, style, or culture of Belize on the Caribbean coast of Central America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Belizean"@en .

aat:300387741 a skos:Concept ;
    skos:definition "Nautical charts issued by the United Kingdom Hydrographic Office and subject to Crown Copyright."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "admiralty charts"@en .

aat:300387742 a skos:Concept ;
    skos:definition "In algebraic geometry, smooth vector bundle maps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transport maps"@en .

aat:300387743 a skos:Concept ;
    skos:definition "Concepts related to the physical features of the earth and its atmosphere, and with human activity as it affects and is affected by these features."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geographic concepts"@en .

aat:300387744 a skos:Concept ;
    skos:definition "The styles and cultures related to the area of the river Amazon or its basin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amazonian"@en .

aat:300387745 a skos:Concept ;
    skos:definition "The style and culture of the Canadian province of Alberta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albertan"@en .

aat:300387747 a skos:Concept ;
    skos:definition "Concepts related to the physical structure and substance of the earth, the processes which act on these, and the earth's development since its formation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geological concepts"@en .

aat:300387748 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the city of Lucca in northwest Tuscany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lucchese"@en .

aat:300387749 a skos:Concept ;
    skos:definition "General term for the culture and styles of ancient Jews, up to the Medieval period, including culture that does not have strictly to do with religion per se."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Jewish"@en .

aat:300387750 a skos:Concept ;
    skos:definition "Nationality or culture of the island of Jersey and surrounding islands, off the coast of Normandy, France, currently a dependency of the United Kingdom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jerseyan"@en .

aat:300387751 a skos:Concept ;
    skos:definition "Style and culture of the ancient city of Gnathia (now Egnazia) in Eastern Apulia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gnathian"@en .

aat:300387752 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the Faröe Islands, an autonomous dependency of the kingdom of Denmark situated between Great Britain and Iceland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Faroese"@en .

aat:300387753 a skos:Concept ;
    skos:definition "The culture and the styles of art produced in the Southern Netherlands during the 15th and early 16th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Netherlandish"@en .

aat:300387755 a skos:Concept ;
    skos:definition "Nationality, culture, and style of the Netherlands Antilles autonomous Caribbean country within the Kingdom of the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch Antillean"@en .

aat:300387756 a skos:Concept ;
    skos:definition "Style and culture of the island of Aruba in the southern Caribbean Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aruban"@en .

aat:300387757 a skos:Concept ;
    skos:definition "The nationality or culture of French Guiana, an overseas department and region of France, on the north Atlantic coast of South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French Guianese"@en .

aat:300387758 a skos:Concept ;
    skos:definition "Nationality or culture of Montserrat island in the eastern Caribbean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Montserratian"@en .

aat:300387760 a skos:Concept ;
    skos:definition "Culture of the Tla-o-qui-aht bands of indigenous Canadians, now living along the Pacific Rim National Park on Vancouver Island, British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tla-o-qui-aht First Nations"@en .

aat:300387762 a skos:Concept ;
    skos:definition "Any ties that are designed to be broken off at a specified depth, for example after the concrete slab has hardened. Typically, snap ties are metal wire ties for concrete or other materials that combine the function of the traditional tie and wooden spreaders, comprising a metal tie rod and tie holders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snap ties"@en .

aat:300387763 a skos:Concept ;
    skos:definition "Audio productions intended for broadcast on radio, whether recurring in a regular series or as one-time presentations of informational or entertainment content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radio programs"@en .

aat:300387764 a skos:Concept ;
    skos:definition "Hangers of various designs used for the storage of neckties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie hangers"@en .

aat:300387783 a skos:Concept ;
    skos:definition "Large family of related languages, including around 300 living languages and dialects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Afro-Asiatic"@en .

aat:300387801 a skos:Concept ;
    skos:definition "Small language family of South America, without known relationships to any other American language family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Alacalufan"@en .

aat:300387803 a skos:Concept ;
    skos:definition "Language documented by at least 15th century CE and now the present-day republic of Albania. It presumably continues one of the very poorly attested ancient Indo-European languages of the Balkan Peninsula, but which one is not clear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Albanian"@en .

aat:300387807 a skos:Concept ;
    skos:definition "Language family of indigenous North America, including the Algonquian family of languages of the area from the Rocky Mountains to Atlantic Canada, and the Yurok and Wiyot of northwestern California."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Algic"@en .

aat:300387810 a skos:Concept ;
    skos:definition "Language family of central Eurasia and Siberia, now believed by some to be a sprachbund rather than a family; a sprachbund would be a group of languages that have common features resulting from geographical proximity and language contact, but not necessarily otherwise related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Altaic"@en .

aat:300387822 a skos:Concept ;
    skos:definition "General term for the varieties of English spoken primarily in the United States. The chief differences between British and American English are in the pronunciation of certain individual vowels and diphthongs, and the spelling of certain words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American English"@en .

aat:300387823 a skos:Concept ;
    skos:definition "Languages of the native peoples of the Americas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amerindian language"@en .

aat:300387831 a skos:Concept ;
    skos:definition "General term for the forms of Latin used in ancient Rome, as distinguished from Latin used from the Medieval period onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Latin"@en .

aat:300387832 a skos:Concept ;
    skos:definition "Language families comprising two groups of indigenous languages of the Andaman Islands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Andamanese"@en .

aat:300387838 a skos:Concept ;
    skos:definition "The English language as spoken before ca. 1150. Anglo/Saxon is distinguished from Middle English in having a fully inflected grammar and relatively few direct lexical borrowings from French and Latin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anglo-Saxon"@en .

aat:300387870 a skos:Concept ;
    skos:definition "Language that forms a separate branch of the Indo-European language family, spoken primarily in Armenia, but also in Georgia, Russia, Iran, and elsewhere. Armenian, like Greek, is a single language. Speakers of Armenian are recorded by the 6th century BCE, but the oldest Armenian texts date from the 5th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian"@en .

aat:300387882 a skos:Concept ;
    skos:definition "West Iberian Romance language spoken primarily in the Principality of Asturias, Spain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asturian"@en .

aat:300387892 a skos:Concept ;
    skos:definition "Language families and isolates that are spoken by Aboriginal Australians of mainland Australia and a few nearby islands; there are around 30 families in this group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Australian Aboriginal"@en .

aat:300387902 a skos:Concept ;
    skos:definition "Language family, which along with Quechuan, is one of the primary language families of the indigenous central Andes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aymaran"@en .

aat:300387906 a skos:Concept ;
    skos:definition "Language of the Aztec empire; used as a lingua franca in much of Mesoamerica from the 7th century CE until the Spanish conquest in the 16th century. The modern dialects of Nahuatl spoken in the Valley of Mexico are closest to Classical Nahuatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Classical Nahuatl"@en .

aat:300387946 a skos:Concept ;
    skos:definition "Language family spoken in Colombia and Ecuador."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Barbacoan"@en .

aat:300387955 a skos:Concept ;
    skos:definition "A language isolate, the only remnant of the languages spoken in southwestern Europe before the region was Romanized in the 2nd through 1st century BCE. At the beginning of the Common Era, dialects of Basque were probably spoken north and south of the Pyrenees and as far east as the Aran Valley in northeastern Spain. It is known in several dialects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basque"@en .

aat:300387997 a skos:Concept ;
    skos:definition "A language group of the Philippines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bisayan"@en .

aat:300388027 a skos:Concept ;
    skos:definition "Refers to the variety of English traditionally the official language of England and the usual spoken language of educated people in London and southeastern England. It is codified in the British Received Pronunciation (RP)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "British English"@en .

aat:300388052 a skos:Concept ;
    skos:definition "Family of Native American languages, spoken in parts of the Great Plains, from North Dakota to Oklahoma."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Caddoan"@en .

aat:300388054 a skos:Concept ;
    skos:definition "Set of two related languages, Chayahuita and Jebero, and several dialects, now spoken only in Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cahuapanan"@en .

aat:300388071 a skos:Concept ;
    skos:definition "Variety of Spanish spoken in north and central Spain; was the basis of modern standard Spanish. The dialect arose in Cantabria in the 9th century. It is the standard language used for radio and TV speakers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Castilian Spanish"@en .

aat:300388072 a skos:Concept ;
    skos:definition "Occitano-Romance language named for its origins in Catalonia, in what is northeastern Spain and adjoining parts of France. It was derived from Vulgar Latin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Catalan"@en .

aat:300388105 a skos:Concept ;
    skos:definition "Family of South American indigenous languages, based on a language, also called Chibchan, that was spoken before 1500 CE in the area now comprising Nicaragua, Costa Rica, Panama, western Colombia, and Ecuador."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chibchan"@en .

aat:300388110 a skos:Concept ;
    skos:definition "Language family comprising one endangered language and one extinct language, so far as is known; spoken in northwestern Washington state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chimakuan"@en .

aat:300388133 a skos:Concept ;
    skos:definition "A language of the Han in China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese, Wu"@en .

aat:300388143 a skos:Concept ;
    skos:definition "Small family of Native American languages in Colombia and Panama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Choco"@en .

aat:300388159 a skos:Concept ;
    skos:definition "Family of languages that were spoken on the southern California coast and islands; languages are virtually extinct, but well documented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chumash"@en .

aat:300388167 a skos:Concept ;
    skos:definition "Language family of the indigenous people of south Texas and adjacent Mexico; it is uncertain how closely or if these languages were all actually related, because documentation is scarce. However, the term is still used as a term of convenience for the languages of this region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coahuiltecan"@en .

aat:300388208 a skos:Concept ;
    skos:definition "Language spoken in Afghanistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dari"@en .

aat:300388247 a skos:Concept ;
    skos:definition "Family of around 70 languages spoken in South Asia, primarily in India, Pakistan, and Sri Lanka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dravidian"@en .

aat:300388256 a skos:Concept ;
    skos:definition "West Germanic language that is the national language of the Netherlands; it largely developed in the historical province of Holland. Although it is basically the same language that is, with French and German, one of the three official languages of Belgium, for the language as used in Belgium prefer \"Flemish.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch"@en .

aat:300388277 a skos:Concept ;
    skos:definition "West Germanic language of the Indo-European language family that is closely related to Frisian, German, and Dutch (in Belgium called Flemish) languages. It is spoken in England and also used in many varieties throughout the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English"@en .

aat:300388301 a skos:Concept ;
    skos:definition "The varieties of the Dutch language spoken historically in Flanders and today in Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flemish"@en .

aat:300388306 a skos:Concept ;
    skos:definition "General term for the French language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French"@en .

aat:300388308 a skos:Concept ;
    skos:definition "West Germanic language spoken primarily in areas along the North Sea in the Netherlands, including the offshore islands. There are three dialects: West Frisian, East Frisian, and North Frisian. Frisian is considered to be the West Germanic language that is most closely related to English."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Frisian"@en .

aat:300388310 a skos:Concept ;
    skos:definition "A non-tonal language of the Atlantic branch of the Niger-Congo family, known in 9 or more dialects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fula"@en .

aat:300388323 a skos:Concept ;
    skos:definition "One of the two branches of the Insular Celtic languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gaelic (general)"@en .

aat:300388333 a skos:Concept ;
    skos:definition "Member of the Bantu branch of Niger-Congo languages; it is now spoken in Uganda, in the southeast, primarily Buganda province, Lake Victoria northwest shore to Lake Kyoga and Tanzania border. It is spoken by around million Baganda people, who live mainly in the Buganda region of Uganda, and elsewhere in Uganda as a second language. The name Uganda is the Swahili version of Baganda."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ganda"@en .

aat:300388344 a skos:Concept ;
    skos:definition "West Germanic language that is the national language of Germany and Austria, one of the three official languages of Switzerland, and known in various communities in North and South America, South Africa, and Australia. As a written language German is quite uniform, although there are numerous regional differences in pronunciation and dialect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "German"@en .

aat:300388345 a skos:Concept ;
    skos:definition "Languages that developed in the middle of the 1st millennium BCE with Germanic tribes who lived in southern Scandinavia and northern Germany. Their expansions and migrations from the 2nd century BCE onward are largely recorded in history. The oldest Germanic language is the Gothic of the 4th century CE. Other languages include English, German, Dutch, Danish, Swedish, Norwegian, and Icelandic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Germanic"@en .

aat:300388363 a skos:Concept ;
    skos:definition "An Eskimo-Aleut language spoken by Greenlandic Inuit people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greenlandic"@en .

aat:300388401 a skos:Concept ;
    skos:definition "A Northwest Semitic language spoken by the Israelites, and the liturgical language of Judaism, which was revived as a spoken language in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hebrew"@en .

aat:300388410 a skos:Concept ;
    skos:definition "Variety of German descended from Middle High German dialects and now spoken in the central and southern highlands of Germany, Austria, and Switzerland, and as the language of administration, higher education, literature, and the mass media in the Low German speech areas as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "High German"@en .

aat:300388414 a skos:Concept ;
    skos:definition "Transliteration of the form of Hindi with a large admixture of Arabic, Persian, and other foreign elements used as the lingua franca of northern India and Pakistan, with two variants Urdu and Hindi, which are official languages in Pakistan and India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindustani (transliterated)"@en .

aat:300388420 a skos:Concept ;
    skos:definition "Family of languages spoken in southern China, northern Vietnam, Laos, and Thailand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hmong-Mien"@en .

aat:300388424 a skos:Concept ;
    skos:definition "Grouping of around 12 small language families that were spoken mainly in California, Arizona, and Baja California. Different versions of the Hokan hypothesis include different member languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hokan"@en .

aat:300388432 a skos:Concept ;
    skos:definition "Uto-Aztecan language of the states of Chihuahua and Sonora in northwestern Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huarijio"@en .

aat:300388433 a skos:Concept ;
    skos:definition "Branch of the Mayan language family incuding Huastec (Wastek) and Chikomuseltek (Chicomuceltec)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huastecan Mayan"@en .

aat:300388434 a skos:Concept ;
    skos:definition "Language isolate having several dialects, spoken by indigenous people of the Pacific coast in the Mexican state of Oaxaca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Huavean"@en .

aat:300388458 a skos:Concept ;
    skos:definition "Family of languages spoken in most of Europe and areas of European settlement and in much of Southwest and South Asia. The well-attested languages of the Indo-European family fall into 10 main branches documented in sizable texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-European"@en .

aat:300388459 a skos:Concept ;
    skos:definition "Indo-Iranian comprises two main subbranches, Indo-Aryan (Indic) and Iranian. Indo-Aryan languages have been spoken in what is now northern and central India and Pakistan since before 1000 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indo-Iranian"@en .

aat:300388468 a skos:Concept ;
    skos:definition "Family of around 16 North American indigenous languages spoken in the Middle Atlantic and South USA."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iroquoian"@en .

aat:300388475 a skos:Concept ;
    skos:definition "Languages that were once spoken in the Apennine Peninsula (modern Italy) and in the eastern part of the Po valley. The principal language of the Italic group is Latin, originally the speech of the city of Rome and the ancestor of the modern Romance languages: Italian, Romanian, Spanish, Portuguese, French, and so on. The earliest Latin inscriptions apparently date from the 6th century BCE, with literature beginning in the 3rd century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Italic"@en .

aat:300388486 a skos:Concept ;
    skos:definition "East Asian language spoken primarily in Japan. Held by many modern scholars to be a member of the Japonic (or Japanese-Ryukyuan) family of languages, while others maintain that it is a language isolate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Japanese"@en .

aat:300388504 a skos:Concept ;
    skos:definition "Small language family of northern Peru and eastern Ecuador."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jivaroan"@en .

aat:300388564 a skos:Concept ;
    skos:definition "Language family in Brazil comprising of two languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Katukinan"@en .

aat:300388593 a skos:Concept ;
    skos:definition "Group of African languages spoken mainly in southern Africa, with two outlying languages found in eastern Africa. Although they seem to have no direct relationships, they are unified by use of click consonants and they do not belong to other language families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Khoisan"@en .

aat:300388633 a skos:Concept ;
    skos:definition "The agglutinative language of Korea. Korean is generally regarded as being a language isolate, with no recognized genealogical relationship to other language families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Korean"@en .

aat:300388668 a skos:Concept ;
    skos:definition "Language that is a member of the Turkic subfamily of Altaic languages, spoken by the Kyrgyz Turkic people, now living primarily in the Kyrgyz Republic and the Pamir Mountains on the border between Tajikistan, Afghanistan, and China. Is written in a Cyrillic alphabet or the Arabic alphabet; Latin script is used in Turkey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kyrgyz"@en .

aat:300388672 a skos:Concept ;
    skos:definition "Romance language spoken by Sephardic Jews in Israel, the Balkans, North Africa, Greece, and Turkey. It combines a very archaic form of Castilian Spanish with Hebrew, along with elements from Aramaic, Arabic, Turkish, Greek, French, Bulgarian, and Italian. Ladino originated in Spain and was carried to its present speech areas by the descendants of the Spanish Jews who were expelled from Spain after 1492."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ladino"@en .

aat:300388693 a skos:Concept ;
    skos:definition "The Indo-European language in the Italic group that was originally spoken by small groups of people living along the lower Tiber River, and later spread around the world with the increase of Roman political power The oldest existing example of Latin dates to the 7th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Latin"@en .

aat:300388709 a skos:Concept ;
    skos:definition "A Moselle-Franconian dialect of the West Middle German group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Luxembourgish"@en .

aat:300388724 a skos:Concept ;
    skos:definition "Transliteration of varieties of Greek used in Eastern and early Western Christianity; often but not always Koine Greek."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liturgical Greek (transliterated)"@en .

aat:300388725 a skos:Concept ;
    skos:definition "Form of the Latin language used in the Roman Rite of the Catholic Church for liturgical, documentary, and legal purposes. It is distinguished from Classical Latin by a simplified syntax, lexical variations,new idioms and words, and Italianate pronunciation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Liturgical Latin"@en .

aat:300388737 a skos:Concept ;
    skos:definition "A vernacular dialect of German, spoken in much of northern Germany; it is more closely related to Dutch than to Standard German."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Low German"@en .

aat:300388760 a skos:Concept ;
    skos:definition "Language belonging to the modern area of Macedonian, part of the eastern group of the South Slavic branch of Slavic languages in the Indo-European language family, together with Bulgarian and the extinct Old Church Slavonic. The modern Macedonian language is unrelated to the Ancient Macedonian language. T"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macedonian"@en .

aat:300388779 a skos:Concept ;
    skos:definition "Most widespread and largest dialect of Punjabi.Developed in the 12th century and gained prominence when Sufi poets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Majhi"@en .

aat:300388782 a skos:Concept ;
    skos:definition "Language family in Brazil, Colombia, and Venezuela."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maku"@en .

aat:300388787 a skos:Concept ;
    skos:definition "A scheduled language of India; a Dravidian language spoken by by the Malayali people in the Indian state of Kerala and the union territories of Lakshadweep and Puducherry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Malayalam"@en .

aat:300388791 a skos:Concept ;
    skos:definition "Language that is closely related to Sinhalese, spoken in the Maldive Islands and on the island of Minicoy, which is part of India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maldivian"@en .

aat:300388796 a skos:Concept ;
    skos:definition "Semitic language spoken on Malta, in the Mediterranean; descended from Siculo-Arabic (the Arabic dialect that developed in Sicily and later in Malta, between the end of the ninth century and the end of the twelfth century)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maltese"@en .

aat:300388834 a skos:Concept ;
    skos:definition "Small language family of closely related languages of Paraguay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mascoian"@en .

aat:300388844 a skos:Concept ;
    skos:definition "Family of languages spoken by people indigenous to southern Mexico, Guatemala, and Belize; Mayan languages were also formerly spoken in western Honduras and western El Salvador."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mayan"@en .

aat:300388857 a skos:Concept ;
    skos:definition "Form of Latin used in the Middle Ages and later as a medium of scholarly exchange, the language of science, literature, law, and administration. Despite the clerical origin of many of its authors, Medieval Latin differs from Liturgical Latin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medieval Latin"@en .

aat:300388861 a skos:Concept ;
    skos:definition "Algonquian language spoken by members of the Menominee Indian Tribe of Wisconsin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Menominee"@en .

aat:300388869 a skos:Concept ;
    skos:definition "The English language in the period between Anglo/Saxon and Modern English, usually considered spoken between 1066 and 1485 CE (or more broadly, ca. 1100/1150-1450/1500). Middle English is characterized by a reduced system of grammatical inflections, an increased lexical borrowing from other languages, especially French and Latin, and great dialectal diversity in writing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Middle English"@en .

aat:300388883 a skos:Concept ;
    skos:definition "Small family of languages spoken by indigenous Native American peoples on the east coast of Nicaragua and nearby areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Misumalpan"@en .

aat:300388919 a skos:Concept ;
    skos:definition "A language of Amazonas, Brazil, having one remaining dialect. Linguistically it is characterized by agglutinativity, a small number of phonemes, whistled speech, and the use of tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mura"@en .

aat:300388923 a skos:Concept ;
    skos:definition "Language family of the Native Americans of the southeastern United States, consisting several other language groupings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muskogean"@en .

aat:300388929 a skos:Concept ;
    skos:definition "Family of North American Native American languages including the Eyak, Athapaskan, and Tlingit languages, and (in some classifications) Haida. Some scholars believe the Na-Dene may be related to the Yeniseian languages of central Siberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Na-Dene"@en .

aat:300388932 a skos:Concept ;
    skos:definition "General term for the Uto-Aztecan language spoken by about 1.5 million people in Mexico today. May include varieties of contemporary Huasteca Nahuatl. To specifically reference the language of the Aztecs, use Classical Nahuatl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nahuatl"@en .

aat:300388937 a skos:Concept ;
    skos:definition "Small language family spoken in the state of Mato Grosso in Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nambiquaran"@en .

aat:300388976 a skos:Concept ;
    skos:definition "Large language family that includes those spoken by most of the indigenous peoples of western, central, and southern Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Niger-Congo"@en .

aat:300388978 a skos:Concept ;
    skos:definition "Family of African languages that includes the Nilotic languages together with certain other languages of the northern half of Africa between Mali and Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nilo-Saharan"@en .

aat:300388988 a skos:Concept ;
    skos:definition "Southern Wakashan Language used by the Nuu-chah-nulth, the indigenous people whose ancestral lands are in present-day coastal British Columbia, Canada."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "T'aat'aaqsapa"@en .

aat:300389030 a skos:Concept ;
    skos:definition "Indo-Aryan language that is the official language in Odisha (Orissa), India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odia"@en .

aat:300389037 a skos:Concept ;
    skos:definition "Large family of indigenous American languages; includes several subfamilies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oto-Manguean"@en .

aat:300389042 a skos:Concept ;
    skos:definition "Language family of Colombia and Ecuador, defined differently by various experts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paezan"@en .

aat:300389057 a skos:Concept ;
    skos:definition "Indo-Aryan languages and dialects of the Punjab, also spoken in Punjabi communities elsewhere. It is closely related to Hindi and Urdu (differences in the sound-system, grammar and vocabulary). Panjabi has been particularly cultivated by the Sikhs; it is their religious language, always written with the Gurmukhi script."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panjabi (general)"@en .

aat:300389058 a skos:Concept ;
    skos:definition "The standard form of the Punjabi language as used in India, but not in Pakistan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Panjabi, Eastern"@en .

aat:300389081 a skos:Concept ;
    skos:definition "Sotho-Tswana language spoken in the northeastern provinces of South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sotho, Northern"@en .

aat:300389084 a skos:Concept ;
    skos:definition "North American Indian language grouping comprising the Utian (Miwok-Costanoan), Wintuan, Maiduan, and Yokutsan language families."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Penutian"@en .

aat:300389102 a skos:Concept ;
    skos:definition "An East Low German dialect used by Mennonite settlers to the south west of the Russian Empire starting in the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Plautdietsch"@en .

aat:300389115 a skos:Concept ;
    skos:definition "Refers broadly to the Romance language that is spoken in Portugal, Brazil, and other Portuguese colonial and formerly colonial territories. Galician, spoken in northwestern Spain, is closely related to Portuguese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Portuguese"@en .

aat:300389128 a skos:Concept ;
    skos:definition "Family of languages of the former Inca Empire in South America and the principal native languages of the central Andes today. The original languages were probably spoken in a small area in the southern Peruvian highlands; after ca. 1450 the language was spread by the Inca conquests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quechuan"@en .

aat:300389146 a skos:Concept ;
    skos:definition "In some classifications, a subfamily of Romance languages that are spoken in SE Switzerland and NE Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rheto-Romance languages"@en .

aat:300389150 a skos:Concept ;
    skos:definition "Indo-Aryan language of the Romany or Rom people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Romani"@en .

aat:300389193 a skos:Concept ;
    skos:definition "Language family of Native American languages that are spoken or formerly spoken in the Pacific Northwest and adjoining areas of Idaho, Montana, and southern British Columbia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salishan"@en .

aat:300389194 a skos:Concept ;
    skos:definition "Language family in Venezuela and Colombia, indigenous of the middle Orinoco Basin in an area of dominated by peoples of Carib and Arawakan affiliation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Salivan"@en .

aat:300389220 a skos:Concept ;
    skos:definition "The earliest recorded form of Low German, spoken by the Saxon tribes between the Rhine and Elbe rivers and between the North Sea and the Harz Mountains from the 9th until the 12th century. A distinctive characteristic of Old Saxon, shared with Old Frisian and Old English, is its preservation of the voiceless stops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Saxon"@en .

aat:300389247 a skos:Concept ;
    skos:definition "Standardized variety of the Serbo-Croatian language used primarily by Serbs. Standard Serbian is based on the most widespread dialect of Serbo-Croatian, Shtokavian. Serbian is written with complete synchronic digraphia, having both Latin and Cyrillic expressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serbian"@en .

aat:300389248 a skos:Concept ;
    skos:definition "Serbo-Croatian language is a term of convenience used to refer to the forms of speech employed by Serbs, Croats, and other South Slavic groups (such as Montenegrins and Bosniaks, as Muslim Bosnians are known). The term Serbo-Croatian was coined in 1824 by German dictionary maker and folklorist Jacob Grimm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serbo-Croatian"@en .

aat:300389252 a skos:Concept ;
    skos:definition "Language of the Southern African Batswana people; official language and lingua franca of Botswana and South Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Setswana"@en .

aat:300389257 a skos:Concept ;
    skos:definition "Mixed language of the community of travelling people in Ireland, based heavily on Hiberno-English with heavy influences from Irish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Shelta"@en .

aat:300389282 a skos:Concept ;
    skos:definition "Family of languages in indigenous North America spread primarily across the Great Plains, extending from Canada to Mississippi to North Carolina."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Siouan"@en .

aat:300389308 a skos:Concept ;
    skos:definition "Southern Bantu language of the Sotho-Tswana people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sotho, Southern"@en .

aat:300389311 a skos:Concept ;
    skos:definition "Language now spoken in Spain and as a first language by around 360 million people worldwide. Given that the Castilian dialect is the source from which modern standard Spanish developed, this language overall may be called \"Castilian\"; however, for the dialect spoken in Castile and elsewhere in northern and central Spain, use \"Castilian Spanish.\" Refers broadly to the Romance language that developed from Vulgar Latin with contributions from the pre-Roman languages that were spoken in the territory of the Astures, an ancient tribe of the Iberian peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spanish"@en .

aat:300389312 a skos:Concept ;
    skos:definition "Language spoken in the Amazon areas of Peru, Brazil, and Colombia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Loreto-Ucayali"@en .

aat:300389318 a skos:Concept ;
    skos:definition "The variety of German, primarily spoken German, used in radio, television, public lectures, the theatre, schools, and universities. It is relatively uniform in pronunciation, although speakers may reveal regional accents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Standard German"@en .

aat:300389337 a skos:Concept ;
    skos:definition "Dialect of Middle Aramaic that was once spoken across much of the Fertile Crescent and Eastern Arabia, dating to at least the 4th century BCE as a spoken language. It is known as a script from the 1st century CE. Classical Syriac became a major literary language throughout the Middle East from the 4th to the 8th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syriac"@en .

aat:300389342 a skos:Concept ;
    skos:definition "Language family of northwest Bolivia and southeastern Peru."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tacanan"@en .

aat:300389435 a skos:Concept ;
    skos:definition "Language of the Tonkawa people, considered by some to belong to the Coahuiltecan family of languages and by others to be a distinct linguistic stock in the Macro-Algonquian group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tonkawa"@en .

aat:300389466 a skos:Concept ;
    skos:definition "Language family of lowland South America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tupian"@en .

aat:300389482 a skos:Concept ;
    skos:definition "A language of a Northwest Coast Native American people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Twana"@en .

aat:300389501 a skos:Concept ;
    skos:definition "Large language family of Eurasia, comprising languages and major dialects spoken by Caucasoid and Mongoloid populations in a territory extending from northern and central Europe in the west, to western and southern Siberia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uralic"@en .

aat:300389507 a skos:Concept ;
    skos:definition "Large family of Native American languages in North and Central America, distributed from Oregon to Panama."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Uto-Aztecan"@en .

aat:300389523 a skos:Concept ;
    skos:definition "Venetan language variant as spoken historically in Venice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetian"@en .

aat:300389538 a skos:Concept ;
    skos:definition "Family of Native American languages spoken in British Columbia in Washington state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wakashan"@en .

aat:300389614 a skos:Concept ;
    skos:definition "Language family spoken in Eastern Siberia, Russia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yukaghir"@en .

aat:300389622 a skos:Concept ;
    skos:definition "Language family of southeastern Bolivia and northern Paraguay."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zamucoan"@en .

aat:300389643 a skos:Concept ;
    skos:definition "Indicator, reserved specifically for use when language is not applicable in an indexing scenario."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "not applicable"@en .

aat:300389644 a skos:Concept ;
    skos:definition "A language containing lexical and other features from two or more languages including English, characterized by simplified grammar and a smaller vocabulary than the languages from which it is derived."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pidgin English"@en .

aat:300389646 a skos:Concept ;
    skos:definition "File format intended for the exchange of audio content between broadcast environments operating with varying computer platforms. Built on the Microsoft WAVE audio file format, Broadcast Wave adds a \"Broadcast Audio Extension\" (bext) with the minimum information necessary for broadcast applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "BWF"@en .

aat:300389647 a skos:Concept ;
    skos:definition "Open-source bitstream encoding format designed for lossless compression of LPCM audio data, with many default parameters tuned to CD-quality music data. The format includes elements indicating the file format for the encoded data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "FLAC"@en .

aat:300389648 a skos:Concept ;
    skos:definition "The process of updating and redecorating a building or other work, particularly with the implication of making it more energy efficient, eco-friendly, or sustainable. Used primarily in the context of built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refurbishment"@en .

aat:300389649 a skos:Concept ;
    skos:definition "Tongs having a hollow bit with lips forming an angular opening, for gripping stock that is square in cross section. Each side of the tong tip forms a V-shape, and when brought together, the opening of the tips forms a square shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-lip tongs"@en .

aat:300389650 a skos:Concept ;
    skos:definition "Nails made of relatively soft metal or so cut that the pointed end may be bent over easily for clinching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinch nails"@en .

aat:300389651 a skos:Concept ;
    skos:definition "The process of securing a nail, bolt, or other rod-like piece that has been driven through a substance by beating back the point or end of the nail or bolt with a hammer or other tool so that the end is turned over and driven back into the substance through which it has passed. Also, the process in which the end of a bolt is beaten down and flattened upon a metal ring or washer put around it for the purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clinching"@en .

aat:300389652 a skos:Concept ;
    skos:definition "Small sharp-pointed nails, with flat thin heads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat nails"@en .

aat:300389653 a skos:Concept ;
    skos:definition "Nails having with sharp points and flat shanks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sharp nails"@en .

aat:300389654 a skos:Concept ;
    skos:definition "Weaving strings of seed beads or other tiny beads, either on a specialized loom or off-loom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bead weaving"@en .

aat:300389655 a skos:Concept ;
    skos:definition "Genus contains a single species: Spathodea campanulata, of the evergreen family Bignoniaceae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spathodea"@en .

aat:300389656 a skos:Concept ;
    skos:definition "Relatively short, stout nails made of copper or another nonferrous metal, designed for nailing down slates to a slate roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slating nails"@en .

aat:300389657 a skos:Concept ;
    skos:definition "Thin, narrow, flat pieces of wood used for many purposes, such as in constructing lattices of trellis work, Venetian blinds, or to form a groundwork upon which to fasten the slates or tiles of a roof or the plaster of a wall or ceiling. For groundwork of any material upon which plaster or another such material is applied, use \"lath (grounding surface).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laths"@en .

aat:300389658 a skos:Concept ;
    skos:definition "Box vises for which the threaded nut and flange \"boxes\" were made in solid pieces, originally with screw threads being hand turned on a lathe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid box vises"@en .

aat:300389659 a skos:Concept ;
    skos:definition "Bolts with threads on both ends, used for securing two lengths of handrail timber or other members together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint bolts"@en .

aat:300389660 a skos:Concept ;
    skos:definition "Bolts designed to attach newel posts to stairway railing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "newel bolts"@en .

aat:300389661 a skos:Concept ;
    skos:definition "In sheet metal work, various types of seams where tabs are cut from the sheet of metal and folded or bent over the collar or another sheet to form a seam. Dovetail seams are typically used on round or elliptical pipe in joining collars to flange; rarely used on rectangular duct."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dovetail seams"@en .

aat:300389662 a skos:Concept ;
    skos:definition "Process of comparing photometrically the relative intensities of light absorbed, reflected, or emitted by a microscopic specimen in different parts of a spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microspectrophotometry"@en .

aat:300389663 a skos:Concept ;
    skos:definition "Fluorocarbon elastomer-based synthetic rubber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluoro rubber"@en .

aat:300389664 a skos:Concept ;
    skos:definition "Heritage trails having an emphasis primarily on more ancient history, including archaelogical remains and sites. The trail itself may also be of archaeological significance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "archaeological trails"@en .

aat:300389665 a skos:Concept ;
    skos:definition "Cation-ratio dating involves the analysis of biogenic rock varnish, a micrometer-thick coating of manganese, silicon, aluminum and iron, believed to age predictably and thus serve as a chronometer. In particular, the ratio of certain cations, (calcium + potassium)/titanium, has been posited to decrease as the varnish ages. In recent decades, some scholars have challenged these assumptions and questioned the usefulness of the technique as a reliable way to date lithic artifacts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cation-ratio dating"@en .

aat:300389666 a skos:Concept ;
    skos:definition "Medieval Mudéjar textile type, a two sided non-reversible silk fabric with a herringbone twill ground with patterned motifs such as lozenge shapes, fleurs-de-lis, or lions. It is a complex silk weave with one warp system and two equal weft systems. Cloth of Aresta is preserved in many European churches as well as Las Huelgas, Burgos."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cloth of Aresta"@en .

aat:300389667 a skos:Concept ;
    skos:definition "A kind of magnetometer used in aerial surveys consisting of one or more high-magnetic-permeability cores surrounded by primary and secondary windings. The signal picked up by the latter represents the direction and magnitude of the external magnetic field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluxgate magnetometers"@en .

aat:300389668 a skos:Concept ;
    skos:definition "An element with atomic number 35 and symbol Br belonging to the halogen family. It is the only nometallic element that is liquid at room temperature. Bromine is extracted from sea water by reaction with chlorine and is used in dyes, fumigants, and other applications."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bromine"@en .

aat:300389669 a skos:Concept ;
    skos:definition "Refers to the products of a relief-photography process patented in 1898. A sculptograph is a composite object consisting of a solar enlargement overpainted with pastels and adhered to a sculpted metal sheet, which gives the image the appearance of a bas relief."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculptographs"@en .

aat:300389670 a skos:Concept ;
    skos:definition "Species of cypress tree native to central Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chamaecyparis obtusa"@en .

aat:300389671 a skos:Concept ;
    skos:definition "Species of conifer native to Japan; the only species in its genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cryptomeria japonica"@en .

aat:300389672 a skos:Concept ;
    skos:definition "Manufactories specializing in making glass and glassware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassworks"@en .

aat:300389673 a skos:Concept ;
    skos:definition "Species of tree native to eastern Asia, northern China, Manchuria, Korea, Ussuri, Amur, and Japan; invasive in America. It is a major source of an important substance used in traditional Chinese medicine"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phellodendron amurense"@en .

aat:300389674 a skos:Concept ;
    skos:definition "Genus containing around 10 species of eastern Asian trees, usually having corklike bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phellodendron"@en .

aat:300389675 a skos:Concept ;
    skos:definition "Species of ash tree native to the Himalayas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fraxinus floribunda"@en .

aat:300389678 a skos:Concept ;
    skos:definition "Any of various assembling techniques that press additions firmly onto finished parts. In the context of bookbinding, the process of flattening the leaves or gatherings of a text block before sewing or stitching by striking them repeatedly with a beating hammer, in order to compress and flatten them, or, in rebinding, to remove the backing shoulders. Similarly, in the context of weaving or similar activities, the process of using a beater or comb to press each new weft into correct position against existing wefts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beating"@en .

aat:300389679 a skos:Concept ;
    skos:definition "Genus of flowering plants. Until 2005, species were considered members of Acacia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Senegalia"@en .

aat:300389680 a skos:Concept ;
    skos:definition "Genus of flowering plants. Until 2005, species were considered members of Acacia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vachellia"@en .

aat:300389681 a skos:Concept ;
    skos:definition "Genus of flowering plants. Until 2005, species were considered members of Acacia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Acaciella"@en .

aat:300389682 a skos:Concept ;
    skos:definition "Genus of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mariosousa"@en .

aat:300389683 a skos:Concept ;
    skos:definition "Species of small deciduous tree having prickly branches with leaves and brush-like inflorescences; native to semi-desert regions of Sub-Saharan Africa, Oman, Pakistan, and northwestern India. It is the source of gum arabic considered to have superior properties over other sources of gum arabic. Formerly classified in genus Acacia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Senegalia senegal"@en .

aat:300389684 a skos:Concept ;
    skos:definition "Species of small tree with pale greenish or reddish bark and feathery leaves having two thorns at their base, native to Africa from Egypt to Kenya, west Senegal, and in the Sahara. It is a source of gum arabic. The wood was used in Ancient Egypt to make coffins; it is noted in the Bible as the material out of which the Ark of the Covenant was made. Formerly classified in genus Acacia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vachellia seyal"@en .

aat:300389685 a skos:Concept ;
    skos:definition "The chief supporting substances used in the fabrication of works created by applying media to a support. The distinction of \"primary support\" is often reserved for situations where a mount or other \"secondary support\" is also employed. For example, chalk may be applied to a primary support, paper, to make a drawing; and the paper support could then be mounted to a secondary support, cardboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary supports"@en .

aat:300389686 a skos:Concept ;
    skos:definition "Substances to which a primary support for a work are attached. The distinction of \"secondary support\" is reserved for situations where a \"primary support\" is also employed. For example, chalk may be applied to a primary support, paper, to make a drawing; and the paper support could then be mounted to a secondary support, cardboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary supports"@en .

aat:300389687 a skos:Concept ;
    skos:definition "A substance designed to seal a surface or container against the passage of a gas or liquid, or to fill up cracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealant"@en .

aat:300389688 a skos:Concept ;
    skos:definition "Decorated ceramic ware that, rather than being hand-painted, has a design that has been transferred to the ceramic item from a printed design on paper, gelatinous bat, or another substance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transferware"@en .

aat:300389689 a skos:Concept ;
    skos:definition "v"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whipstitching"@en .

aat:300389690 a skos:Concept ;
    skos:definition "Attaching a drawing, print, photograph, or other work of art done on paper to a cardboard or other backing by using a water-based adhesive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet mounting"@en .

aat:300389691 a skos:Concept ;
    skos:definition "Cylinder augers designed for removing columns of soil for study and monitoring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soil column cylinder augers"@en .

aat:300389692 a skos:Concept ;
    skos:definition "In wooden barrel-making, bung borers designed to allow the boring of the bunghole and tap hole in one step, rather than the two-step process of a drilling pilot hole and then enlarging the pilot hole to the correct size with a tapered reamer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylindrical bung borers"@en .

aat:300389693 a skos:Concept ;
    skos:definition "Augers used for boring bung holes, which have tapered sides, in barrels; also used for boring such holes in wood for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bung borers"@en .

aat:300389694 a skos:Concept ;
    skos:definition "Tools, usually having a straight or tapered shank, designed for piercing, perforating, or making or enlarging a hole, especially when piercing by means of a rotatory movement; common examples include tools for boring through rocks or through wood. For tools used for piercing or making holes, but having a fluted or spiral shank, use \"drills (tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borers"@en .

aat:300389695 a skos:Concept ;
    skos:definition "Mallets or hammers used to make noise, for commanding attention or confirming an action; often used with a striking block. Examples are as used by a judge or presiding officer, or by an auctioneer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gavels"@en .

aat:300389696 a skos:Concept ;
    skos:definition "Tools, usually hand-held or hand-powered, having a sharp edge, used for punching out holes or designs in paper or other such materials. Punches are standard office supplies and used in papercrafts and leather crafts. For punches having a shaped tip at one end and struck by a hammer, designed to make an indentation rather than cutting out holes or shapes, use \"punches (marking tools).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punches"@en .

aat:300389697 a skos:Concept ;
    skos:definition "Punches designed specifically for punching holes in paper; usually reserved for the types of punches that are office tools used to punch holes in sheets of paper so that the sheets can be inserted into binders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paper punches"@en .

aat:300389698 a skos:Concept ;
    skos:definition "Shutters having louvers or slats positioned vertically in a frame rather than horizontally; distinct from \"vertical blinds,\" which have vertical slats or panels, but are typically lighter-weight and attached at the top rather than in a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vertical shutters"@en .

aat:300389699 a skos:Concept ;
    skos:definition "Interior shutters used to cover the bottom half a a window for privacy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "café-style shutters"@en .

aat:300389700 a skos:Concept ;
    skos:definition "Transducers whose operation is based on magnetostriction, the change of length of a ferromagnetic substance when it is magnetized. They are used for the reception and transmission of high-frequency sound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetostrictive transducers"@en .

aat:300389701 a skos:Concept ;
    skos:definition "Sets of shutters are vertically mounted one above the other within the same opening, allowing each set to function independently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-hung shutters"@en .

aat:300389702 a skos:Concept ;
    skos:definition "Window or door shutters consisting of a number of horizontal slats hinged together and configured so they may be raised by rolling them onto a roller; operated by hand or motorized."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roller shutters"@en .

aat:300389703 a skos:Concept ;
    skos:definition "Window or door shutters having louvers, which are horizontal slats that are movable and may be angled to admit light and air, but to keep out rain and snow. The louvers are set into a frame to make a shutter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "louvered shutters"@en .

aat:300389704 a skos:Concept ;
    skos:definition "Window or door shutters having panels rather than louvers set into a frame."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panel shutters"@en .

aat:300389705 a skos:Concept ;
    skos:definition "Louvered shutters having deep louvers, over 2 inches wide; typically installed into the casement of a window."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plantation shutters"@en .

aat:300389706 a skos:Concept ;
    skos:definition "Window shutters having a vertical folding blade system in a frame, designed to cover a large expanse quickly. An example of such shutters is for hurricane protection. For window coverings with lighter weight vertical slats attached only at the top, use \"vertical blinds.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accordion shutters"@en .

aat:300389707 a skos:Concept ;
    skos:definition "Shutters comprising vertical planks or boards held together by horizontal or diagonal battens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "board-and-batten shutters"@en .

aat:300389708 a skos:Concept ;
    skos:definition "Exterior shutters, usually louvered shutters or jalousies, characterized by being hinged at the top and opening from the window like an awning instead of horizontally. They are designed to provide protection from severe storms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bermuda shutters"@en .

aat:300389709 a skos:Concept ;
    skos:definition "Shutters of various types, designed or used to provide protection for doors and windows from severe wind and weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storm shutters"@en .

aat:300389710 a skos:Concept ;
    skos:definition "Wooden or metal fences acting as portable barriers, particularly in animal husbandry and otherwise in fields. Examples include fences made of oaken laths nailed onto supports, and fences made of a frame with horizontal bars interwoven or wattled with withes of hazel or willow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hurdles"@en .

aat:300389711 a skos:Concept ;
    skos:definition "Material comprising thin, usually rectangular, pieces of slate and other varieties of stone which split readily into laminae, used especially for the purpose of covering the roofs of buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slate"@en .

aat:300389712 a skos:Concept ;
    skos:definition "Double rabbet wood joints made by mating two rabbets in a way suitable for cladding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shiplap joints"@en .

aat:300389713 a skos:Concept ;
    skos:definition "Recessed joints where a space is left between two members. An example is with joints in drywall or metal, where there is a narrow space between two adjoining panels, often allowing movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reveal joints"@en .

aat:300389714 a skos:Concept ;
    skos:definition "Recessed joints designed to give a particular surface appearance of very narrow joints between members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shadow joints"@en .

aat:300389715 a skos:Concept ;
    skos:definition "Sheet metal seams having a bottom plate with a turned edge that overlaps the side plate; the seam may be secured by welding, soldering, or riveting at the overlapping joint. An example of a lap bottom seam is the seam of the bottom of a tin or steel can."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lap seams"@en .

aat:300389716 a skos:Concept ;
    skos:definition "Masonry joints having no mortar, or having the appearance of no mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dry-stacked joints"@en .

aat:300389717 a skos:Concept ;
    skos:definition "Doors, usually unframed, formed of narrow vertical boards or planks held together by cross-pieces, battens, nailed to them. They may be constructed with two layers of planks, positioned on either side of the battens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "batten doors"@en .

aat:300389718 a skos:Concept ;
    skos:definition "The action or process of making notches, which are grooves, incisions, or indentations. An example of notching is in carpentry, where notches are made as a method of joining timbers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "notching"@en .

aat:300389719 a skos:Concept ;
    skos:definition "Boards that have a tongue cut along one edge and a groove along the opposite edge, so that one board can be fitted together with similar board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matchboard"@en .

aat:300389720 a skos:Concept ;
    skos:definition "Wood joints of various designs where members overlap or interlock end-to-end; often employed when structural elements are required in longer lengths than the available material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splice joints"@en .

aat:300389721 a skos:Concept ;
    skos:definition "Any form of recess made in one member of wood, metal, stone, or another material, particularly when the recess is made in order to receive another member. Included are rabbets, which are channels or grooves cut along the edge or face of a member, or rectangular recesses made along a projecting angle to form a step or shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rebates"@en .

aat:300389724 a skos:Concept ;
    skos:definition "Condition is the overall state of an object, being, or environment, including physical characteristics such as appearance, pristineness, level of damage, completeness, working order, or quality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conditions"@en .

aat:300389725 a skos:Concept ;
    skos:definition "The physical results of an action, process, physical circumstances, or spontaneous physical or chemical change; usually observable with the eye, other senses, or with specialized equipment, and typically having a measurable quantity, dimension, or other measurable characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "effects"@en .

aat:300389726 a skos:Concept ;
    skos:definition "Order consisting of the single family Vitaceae, which contains 16 genera and about 770 species, mostly in the tropics or warm temperate regions of the world. The affinities of Vitaceae have long been uncertain, with no obvious close relatives to the family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitales"@en .

aat:300389727 a skos:Concept ;
    skos:definition "Family of flowering plants containing 16 genera and about 770 species, mostly in the tropics or warm temperate regions of the world. The affinities of Vitaceae have long been uncertain, with no obvious close relatives to the family"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitaceae"@en .

aat:300389728 a skos:Concept ;
    skos:definition "Strong, tough, waxy, nonflammable synthetic resin produced by the polymerization of tetrafluoroethylene; has numerous applications. It is distinguished by its slippery surface, high melting point, and resistance to attack by almost all chemicals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polytetrafluoroethylene"@en .

aat:300389729 a skos:Concept ;
    skos:definition "Genus containing two plant species endemic to New Zealand and Norfolk Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phormium"@en .

aat:300389730 a skos:Concept ;
    skos:definition "Species of evergreen perennial plant native to New Zealand and Norfolk Island. The Maori grew many varieties for specific purposes: for clothing, fishing nets, bindings, baskets, mats, and medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phormium tenax"@en .

aat:300389731 a skos:Concept ;
    skos:definition "Traditional Maori cloaks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kākahu"@en .

aat:300389732 a skos:Concept ;
    skos:definition "Traditional loincloth of Swaziland, formerly made of leopard skin; now sometimes made of faux skin due to the endangered status of the leopard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emajobo"@en .

aat:300389733 a skos:Concept ;
    skos:definition "Languages of the Celts; in the first millennium BCE, these languages were spoken across a wide area of Europe and Asia Minor. Surviving Surviving Celtic languages are now spoken in Ireland, Scotland, Wales, Brittany, Cornwall, and the Isle of Man, and Cape Breton Island."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic"@en .

aat:300389734 a skos:Concept ;
    skos:definition "Language, known in numerous dialects, but which has been a single language throughout its history. It has been spoken in Greece probably since the late 3rd millennium BCED. The earliest texts are the Linear B tablets, some of which may date from as far back as 1400 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek"@en .

aat:300389735 a skos:Concept ;
    skos:definition "Objects with names given by the company responsible for their production and sale to provide distinction and recognition between similar products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brand name objects"@en .

aat:300389736 a skos:Concept ;
    skos:definition "Prints made from Fujifilms Pictrography Photo Printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pictrography (TM)"@en .

aat:300389737 a skos:Concept ;
    skos:definition "Books or other documents containing organized, prescriptive instructions regarding a certain procedure, activity, or topic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rules"@en .

aat:300389741 a skos:Concept ;
    skos:definition "Organized, regular methods of representing information and communicating thoughts or ideas, typically tied to a language. Writing systems use a set of visible marks, forms, or structures called characters or graphs that are related to some structure in the linguistic system. Examples containing general attributes or categories of writing systems include alphabets, syllabaries, logographies, and others; any one system may comprise attributes of more than one category."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "writing systems"@en .

aat:300389742 a skos:Concept ;
    skos:definition "Process by which one animal provides information that other animals can incorporate into their decision making. The vehicle for the provision of this information is called a signal. Signals may include sound, posture, movement, color pattern, electrical discharge, touch, release of an odorant, or some combination of these."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "animal communication"@en .

aat:300389743 a skos:Concept ;
    skos:definition "Languages characterized by the existence of people still living who learned the language as a first language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living languages"@en .

aat:300389744 a skos:Concept ;
    skos:definition "Languages characterized as no longer living, having gone extinct in recent times, namely in the last few centuries. Typically, extinct languages also have no descendent languages; the criteria for identifying distinct languages in these case are based on intelligibility (as defined for individual languages)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "extinct languages"@en .

aat:300389745 a skos:Concept ;
    skos:definition "Languages characterized by having gone extinct in ancient times, thta is, more than a millennium ago. Ancient languages are identified by having a distinct literature and as treated distinctly by the scholarly community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient languages"@en .

aat:300389746 a skos:Concept ;
    skos:definition "Languages characterized by being distinct from any modern languages, even languages that are descended from it. For example, Old English and Middle English are distinct from modern English. A criterion is that the language has a literature that is treated distinctly by the scholarly community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "historic languages"@en .

aat:300389747 a skos:Concept ;
    skos:definition "Languages that were consciously devised for communication, with invented phonology, grammar, and vocabulary, as contrasted to languages that developed naturally. Constructed languages are typically characterized by being artificial, but possessing a literature and designed for the purpose of human communication. Specifically excluded are reconstructed languages and computer programming languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "constructed languages"@en .

aat:300389748 a skos:Concept ;
    skos:definition "Writing systems using alphabets, which represent the basic phonological structure of the language, the phonemes being the constituent parts of syllables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alphabetic writing systems"@en .

aat:300389749 a skos:Concept ;
    skos:definition "Writing systems that represent the consonantal value of a syllable while ignoring the vocalic element. Such systems have graphs for consonant sounds but not for vowel sounds, with the result that a certain amount of guesswork is involved in determining which syllable is being represented."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consonantal writing systems"@en .

aat:300389750 a skos:Concept ;
    skos:definition "Writing systems that use logograms, which are written or pictorial symbols intended to represent a whole word. Writing systems that make use of logograms include Chinese, Egyptian hieroglyphic writing, and early cuneiform writing systems. No known writing system is totally logographic; all known systems have both logograms and symbols representing particular sounds or syllables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logographic systems"@en .

aat:300389751 a skos:Concept ;
    skos:definition "Writing systems that use pictures and drawings having a communicative aim. These pictures and drawings (called pictographs) are usually considered to be a forerunner of true writing and are characterized by stereotyped execution and by omission of all details not necessary for the expression of the communication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pictographies"@en .

aat:300389752 a skos:Concept ;
    skos:definition "Writing systems that use a set of written symbols used to represent the syllables of the words of a language. Writing systems that use syllabaries wholly or in part include Japanese, Cherokee, the ancient Cretan scripts (Linear A and Linear B), and various Indic and cuneiform writing systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "syllabaries"@en .

aat:300389753 a skos:Concept ;
    skos:definition "Signs or characters representing words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logograms"@en .

aat:300389754 a skos:Concept ;
    skos:definition "The status or condition of being greatly damaged or spoiled, with the original appearance invisible. Often used to refer to settlements and architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ruined"@en .

aat:300389755 a skos:Concept ;
    skos:definition "People who study myths and mythology; also, people who write myths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mythologists"@en .

aat:300389756 a skos:Concept ;
    skos:definition "People who study or are expert in heraldry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heraldists"@en .

aat:300389757 a skos:Concept ;
    skos:definition "The discipline concerned with data communication and storage in secure and usually secret form, including the science, study, or practice of encrypting and decrypting information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryptology"@en .

aat:300389758 a skos:Concept ;
    skos:definition "The practice of writing in code or symbols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryptography"@en .

aat:300389759 a skos:Concept ;
    skos:definition "People who study codes as a discipline, and who may also write in code or decode."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cryptologists"@en .

aat:300389760 a skos:Concept ;
    skos:definition "People who tap trees for sap or juice, which involves boring holes into the trunk, tapping a metal or wooden spile into the hole, and collecting the exuded sap the sap or juice without killing the tree. Examples include those who tap maple trees and rubber trees."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tappers"@en .

aat:300389761 a skos:Concept ;
    skos:definition "Administrators of a commandery, usually associated with a medieval religious military order, such as the Knights Hospitallers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commanders"@en .

aat:300389762 a skos:Concept ;
    skos:definition "Absolute rulers, particularly as applied to rulers of dependent or tributary provinces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "despots"@en .

aat:300389763 a skos:Concept ;
    skos:definition "Leaders, including Saracen or Arab princes, who were governors of a province; also military commanders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emirs"@en .

aat:300389764 a skos:Concept ;
    skos:definition "People designated by title \"kahn,\" supreme rulers over certain Turkish, Tartar, and Mongol tribes, as well as emperors of China, during the Middle Ages; successors of Chingīz Khan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khans"@en .

aat:300389765 a skos:Concept ;
    skos:definition "German rulers, originally counts having jurisdiction over a territory, and having under him several inferior counts; later, the title of certain German princes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "landgraves"@en .

aat:300389766 a skos:Concept ;
    skos:definition "Senior magistrates or governors, or those holding any of various positions of command or superintendence; especially as in the ancient Roman or medieval worlds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prefects"@en .

aat:300389767 a skos:Concept ;
    skos:definition "Governors of a province, particularly as under the ancient Persian monarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satraps"@en .

aat:300389768 a skos:Concept ;
    skos:definition "Chiefs of an Arab family or tribe, the headmen of an Arabian village, or other types Arab rulers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheikhs"@en .

aat:300389770 a skos:Concept ;
    skos:definition "Local rulers in various parts of southeastern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "voivodes"@en .

aat:300389771 a skos:Concept ;
    skos:definition "People who drive elephants, especially in south Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahouts"@en .

aat:300389772 a skos:Concept ;
    skos:definition "Genus containing one living species of Asian elephant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elephas"@en .

aat:300389773 a skos:Concept ;
    skos:definition "Species of elepahnt distributed in southeast Asia from India to Borneo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elephas maximus"@en .

aat:300389774 a skos:Concept ;
    skos:definition "Prints made by siderography, which uses steel plates for the production of documents requiring long runs with precise replication."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siderographs"@en .

aat:300389775 a skos:Concept ;
    skos:definition "Works or parts of works made of stones, particularly precious or semi-precious stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lapidary work"@en .

aat:300389776 a skos:Concept ;
    skos:definition "Works or parts of works made of leather, particularly worked and decorated leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherwork"@en .

aat:300389777 a skos:Concept ;
    skos:definition "Works or parts of works made with wood, especially such work used in the construction of buildings and other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carpentry work"@en .

aat:300389778 a skos:Concept ;
    skos:definition "Performances typically involving rhythmical skipping and stepping, with regular turnings and movements of the limbs and body, usually to the accompaniment of music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dances"@en .

aat:300389779 a skos:Concept ;
    skos:definition "The activity characterized by rhythmical skipping and stepping, with regular turnings and movements of the limbs and body, usually to the accompaniment of music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dancing"@en .

aat:300389780 a skos:Concept ;
    skos:definition "Dramatic entertainments consisting of dance and mime performed to music. Ballets are characterized by stylized poses and steps that are combined with light and flowing figures and movements, such as leaps and turns; often combined with music, scenery, costume, and sometimes pantomime or speech to convey a story, theme, or atmosphere to the audience."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballets"@en .

aat:300389781 a skos:Concept ;
    skos:definition "Rhythmic movements of the body, usually to the accompaniment of music; as a performative work, or as part of tradition or ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dances"@en .

aat:300389782 a skos:Concept ;
    skos:definition "Choreographed dances that typically involve rhythmic steps and movements of the limbs and body, usually to the accompaniment of music and that adhere to acknowledged standards, models, or formal traditions of any particular culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "classical dances"@en .

aat:300389783 a skos:Concept ;
    skos:definition "Dances of popular origin that may originate as ritual among inhabitants of a region and that are transmitted through generations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folk dances"@en .

aat:300389784 a skos:Concept ;
    skos:definition "General term for dances intended to be performed by groups or couples for communal or recreational purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social dances"@en .

aat:300389785 a skos:Concept ;
    skos:definition "Paintings created with the medium tempera, which is paint formed of an emulsion of watery and fatty constituents, usually egg-based."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tempera paintings"@en .

aat:300389786 a skos:Concept ;
    skos:definition "Singers who are trained in and specialize in singing opera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opera singers"@en .

aat:300389787 a skos:Concept ;
    skos:definition "Organized bodies of singers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choirs"@en .

aat:300389788 a skos:Concept ;
    skos:definition "Artists whose work aims chiefly at 'expression,' especially a visual artist, composer, writer, or other who exhibits the style or technique of Expressionism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Expressionists"@en .

aat:300389789 a skos:Concept ;
    skos:definition "Painters who endeavor to express the general impression produced by a scene or object, to the exclusion of minute details or elaborate finish. The term is also used for writers who practice a similar method in prose or verse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Impressionists"@en .

aat:300389790 a skos:Concept ;
    skos:definition "The management or administration of the money, financial resources, or material resources of a community, a nation, or the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economy"@en .

aat:300389791 a skos:Concept ;
    skos:definition "The art and science of constructing architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "construction"@en .

aat:300389792 a skos:Concept ;
    skos:definition "Disciplines concerned with the use of specialist or theoretical knowledge in functional contexts, that engage with pragmatic concerns of a state or community."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "practical disciplines"@en .

aat:300389793 a skos:Concept ;
    skos:definition "The art and practice of preparing and cooking foods. For art works incorporating edible materials, prefer \"edible art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culinary art"@en .

aat:300389794 a skos:Concept ;
    skos:definition "The discipline of extinguishing or limiting the spread of fires, as performed by members of organizations dedicated and trained for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "firefighting"@en .

aat:300389795 a skos:Concept ;
    skos:definition "The dedicated practice of making photographs as an applied art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photography"@en .

aat:300389798 a skos:Concept ;
    skos:definition "People who cremate the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cremators"@en .

aat:300389799 a skos:Concept ;
    skos:definition "People who arrange services for the dead. For people who prepare the dead for burial, use \"undertakers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral directors"@en .

aat:300389800 a skos:Concept ;
    skos:definition "People who ceremonially taunt and kill bulls in an arena for public entertainment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bullfighters"@en .

aat:300389801 a skos:Concept ;
    skos:definition "Those whose occupation or profession it is to engage in a game played indoors or out of doors with a large inflated ball, which is thrown from player to player, the object being to score by casting it into one's opponents' goal, a basket fixed ten feet above the ground at each end of the field of play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basketball players"@en .

aat:300389802 a skos:Concept ;
    skos:definition "Those whose occupation or profession is to play games played with a ball and a bat, in which a player strikes the ball with the bat and attempts to run to one or more bases to score points."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baseball players"@en .

aat:300389804 a skos:Concept ;
    skos:definition "Those whose occupation or profession it is to engage in a game played with a ball and rackets on a rectangular court consisting of a smooth grass lawn, or a floor of hard gravel, cement, or asphalt, divided with a net and outlined with smaller boundaries into which the ball is aimed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tennis players"@en .

aat:300389805 a skos:Concept ;
    skos:definition "Athletes whose occupation or profession is to play the game of golf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "golfers"@en .

aat:300389806 a skos:Concept ;
    skos:definition "Those whose occupation or profession is a game in which a heavy ball is rolled down a long, narrow lane toward a group of objects known as pins, the aim being to knock down more pins than an opponent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowlers"@en .

aat:300389807 a skos:Concept ;
    skos:definition "Those who run, particularly athletes engaged in competitive short or long-distance footracing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "runners"@en .

aat:300389808 a skos:Concept ;
    skos:definition "Refers to persons who are currently alive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living"@en .

aat:300389809 a skos:Concept ;
    skos:definition "Refers to persons who are no longer living."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dead"@en .

aat:300389810 a skos:Concept ;
    skos:definition "The collective actions or processes of felling trees and sawing them into short lengths to be transported to a sawmill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "logging"@en .

aat:300389811 a skos:Concept ;
    skos:definition "General term for distinct substances or compounds, having constant chemical composition and characteristic properties; usually refering to such substances that have been purified or prepared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chemicals"@en .

aat:300389812 a skos:Concept ;
    skos:definition "Material comprising the finer portion of grain meal, whether from wheat or another grain, that is separated by bolting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flour"@en .

aat:300389813 a skos:Concept ;
    skos:definition "The flesh of animals used as food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat"@en .

aat:300389814 a skos:Concept ;
    skos:definition "Disciplines having to do with a particular culture or set of cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural disciplines"@en .

aat:300389815 a skos:Concept ;
    skos:definition "Discipline having to do with the culture and history of Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African studies"@en .

aat:300389816 a skos:Concept ;
    skos:definition "The discipline of study that focuses on a period of time intervening between periods designated as ancient and modern; specifically the academic interdisciplinary study of the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Medieval studies"@en .

aat:300389817 a skos:Concept ;
    skos:definition "The discipline of interdisciplinary study that focuses on the late medieval through early modern period, and that may incorporate art and architectural history, literature, music, science, philosophy, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Renaissance studies"@en .

aat:300389818 a skos:Concept ;
    skos:definition "Applied broadly to the cultures of native peoples of North America, Central America, South America, or the West Indies; typically used in anthropological and linguistic contexts. For the native cultures of North America, excluding Inuit and Aleut peoples, use \"Native American (culture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indigenous peoples"@en .

aat:300389819 a skos:Concept ;
    skos:definition "The fatty substance obtained from cream by churning; used chiefly for spreading on bread and in cookery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butter"@en .

aat:300389821 a skos:Concept ;
    skos:definition "Drinkable liquids; often excludes water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beverages"@en .

aat:300389822 a skos:Concept ;
    skos:definition "Drinks usually made from the combination of alcoholic and non-alcoholic ingredients, typically wine or spirits mixed with water, fruit juice, spices, and sugar, or any similar beverage that may exclude the alcohol content, most frequently served on festive occasions from a communal bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch"@en .

aat:300389823 a skos:Concept ;
    skos:definition "Liquid food usually prepared over heat consisting of any combination of ingredients with a stock derived from vegetables or animal products such as meat or bone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soup"@en .

aat:300389824 a skos:Concept ;
    skos:definition "The fruit of Piper nigrum, the pepper plant, dried and typically ground into powder to use as a condiment. It has a hot, pungent flavor and is most frequently paired with some form of salt. The ground spice appears in two forms, the more pungent black pepper, produced from black peppercorns, and the milder white pepper, produced from white peppercorns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pepper"@en .

aat:300389825 a skos:Concept ;
    skos:definition "The flesh of fish used as food."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish"@en .

aat:300389826 a skos:Concept ;
    skos:definition "In the context of a formal or casual meal, the last course, consisting of a sweet food, such as fruit, sweetmeats, cake, ice cream, or the like."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dessert"@en .

aat:300389827 a skos:Concept ;
    skos:definition "A clear liquid broth derived by straining water in which meat or vegetables have been reduced by boiling. This then may be used as a base for soups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bouillon"@en .

aat:300389828 a skos:Concept ;
    skos:definition "A conserved food substance made by boiling fruit and sugar to a thick consistency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jam"@en .

aat:300389829 a skos:Concept ;
    skos:definition "Stiff dough made from flour, salt, and fat; usually in the form of butter, and some liquid. Also collectively, articles of food of which pastry forms an essential part, specifically pies or tarts after being baked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastry"@en .

aat:300389830 a skos:Concept ;
    skos:definition "Confections, sugared cakes or pastry, candied or crystallized fruit, sugared nuts, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweetmeats"@en .

aat:300389831 a skos:Concept ;
    skos:definition "Group defined within the Angiospermae, distinguished as \"typical dicots\" for which molecular-based evidence supports members being a single evolutionary lineage (monophyletic), characterized by pollen that fundamentally has three furrows or pores (tricolpate), in contrast to the single pore or furrow of the monocot and basal dicot group (monosulcates)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eudicots"@en .

aat:300389832 a skos:Concept ;
    skos:definition "In the APG IV system (2016) for the classification of flowering plants, denotes a clade (a monophyletic group) containing about 70,000 species, more than a quarter of all angiosperms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rosids"@en .

aat:300389833 a skos:Concept ;
    skos:definition "Order of flowering plants, consisting of the single family Vitaceae, which contains 16 genera and about 770 species, mostly in the tropics or warm temperate regions of the world. It is a basal member in the rosid group of the core eudicots in the Angiosperm Phylogeny Group III (APG III) botanical classification system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitales"@en .

aat:300389834 a skos:Concept ;
    skos:definition "Family of dicotyledonous flowering plants containing 14 genera and around 910 known species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitaceae"@en .

aat:300389835 a skos:Concept ;
    skos:definition "Genus containing around 60 species of vining plants, predominantly from the Northern hemisphere and important as the source of grapes. Usually having a woody vine, climbing by means of tendrils (modified branches) and producing juicy fruits in clusters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vitis"@en .

aat:300389836 a skos:Concept ;
    skos:definition "Dinosaurs belonging to the suborder Theropoda were primarily carnivorous, although a number of theropod groups evolved herbivory, omnivory, and insectivory. Theropods first appeared during the Carnian age of the late Triassic period about 230 Ma and included the sole large terrestrial carnivores from the Early Jurassic until at least the close of the Cretaceous, about 66 Ma. In the Jurassic, birds evolved from small specialized coelurosaurian theropods, and are today represented by 10,500-18,000 living species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theropoda"@en .

aat:300389837 a skos:Concept ;
    skos:definition "Family of the true weevils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Curculionidae"@en .

aat:300389838 a skos:Concept ;
    skos:definition "Genus of weevils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anthonomus"@en .

aat:300389839 a skos:Concept ;
    skos:definition "Beetle that feeds on cotton buds and flowers. Thought to be native to Central America, it migrated into the United States from Mexico in the late 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anthonomus grandis"@en .

aat:300389840 a skos:Concept ;
    skos:definition "A family of perciform fish with around 385 species in about 29 genera comprised of damselfish and clownfish. Usually saltwater dwelling, with some inhabiting brackish or freshwater environments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pomacentridae"@en .

aat:300389841 a skos:Concept ;
    skos:definition "Clownfish or Anemonefish are fishes from the subfamily Amphiprioninae in the family Pomacentridae. Thirty species are recognized, one in the genus Premnas, while the remaining are in the genus Amphiprion. In the wild, they all form symbiotic mutualisms with sea anemones. Depending on species, Clownfish are overall yellow, orange, or a reddish or blackish color, and many show white bars or patches. The largest can reach a length of 18 centimetres (7.1 in), while the smallest barely can reach 10 centimetres (3.9 in)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Amphiprioninae"@en .

aat:300389842 a skos:Concept ;
    skos:definition "Genus comprised of a single species: Premnas biaculeatus, which inhabits lagoons and outer reef slopes in 1 to 16 metres. Commensal with sea anemones, usually Radianthus gelam. Also reported to be associated with the anemone Entacmaea quadricolor, found mainly in protected coastal waters and lagoons. Feeds primarily on zooplankton and benthic algae."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Premnas"@en .

aat:300389844 a skos:Concept ;
    skos:definition "Military training that may include drills of various kinds to develop precision behavior in preparation for military operations, in advance of actual combat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military exercises"@en .

aat:300389845 a skos:Concept ;
    skos:definition "Military excercises that involve that part of a military force consisting of horse-mounted troops."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cavalry exercises"@en .

aat:300389846 a skos:Concept ;
    skos:definition "Drills conducted by that part of an army which consists of men who march and maneuver on foot and are armed with small arms or rifles, in preparation for actual combat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infantry exercises"@en .

aat:300389847 a skos:Concept ;
    skos:definition "Seats for a rider, made of various materials including wood, leather or textiles, which may be secured to the back of a camel by means of a girth passing under the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camel saddles"@en .

aat:300389849 a skos:Concept ;
    skos:definition "Buildings that house glass manufactories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glassworks"@en .

aat:300389851 a skos:Concept ;
    skos:definition "Artworks combining oil painting with mother-of-pearl inlay. These are particular to colonial Latin America and may have been influenced by goods imported from Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "enconchados"@en .

aat:300389852 a skos:Concept ;
    skos:definition "The discipline surrounding the cultivation of grapes, which is a very ancient agricultural activity and usually associated with wine-making."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viticulture"@en .

aat:300389853 a skos:Concept ;
    skos:definition "Impressions of a hand upon a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handprints"@en .

aat:300389854 a skos:Concept ;
    skos:definition "Painting technique in which paint is applied to a wet ground or onto wet paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet on wet"@en .

aat:300389855 a skos:Concept ;
    skos:definition "Painting technique in which wet paint is applied to a dry ground. Given that this is the more usual way of applying paint, the term is typically used only when needed to distinguish it from painting techniques that apply wet paint to a wet ground or wet paint. For example, with the art of Jackson Pollock, where the artist used both methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wet on dry"@en .

aat:300389856 a skos:Concept ;
    skos:definition "Works comprising primarily raised letters or designs on a surface, typically by means of stamping or molding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "embossed works"@en .

aat:300389857 a skos:Concept ;
    skos:definition "The process of making maps. For the discipline and science of the representation of a geographical area, use \"cartography (discipline).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mapmaking"@en .

aat:300389858 a skos:Concept ;
    skos:definition "Artists, usually graphic artists or painters, who specialize in drawing or otherwise representing the surface of the earth or another planet on a flat surface, showing the distribution of physical or geographical features. To distinguish those who are scientists in the discipline of cartography, who may also be artists who make maps, use \"cartographers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mapmakers"@en .

aat:300389859 a skos:Concept ;
    skos:definition "During the Iron Age, settlements were the settings for ritual activities which included the making of special deposits. A series of rectangular ditched enclosures known as Viereckschanzen is concentrated in the temperate regions of central Europe. Many include deposits of iron weapons and tools in the ditches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Viereckschanzen"@en .

aat:300389860 a skos:Concept ;
    skos:definition "Refers to objects made from translucent materials that are illuminated by transmitted light. Used for the decoration of royal festivals, marriages, funerals, or processions in the Baroque period, transparent paintings became an art form in their own right from the end of the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparent paintings"@en .

aat:300389862 a skos:Concept ;
    skos:definition "Enhanced Raman scattering technique performed on electrochemically roughened metal surfaces; used to identify chemicals at very low concentrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "surface enhanced Raman spectroscopy"@en .

aat:300389863 a skos:Concept ;
    skos:definition "The practice of writing with the pen, often in a particular style or following certain rules. Penmanship was, and in certain cultures remains, a skill emphasized in children's education. Distinguished from calligraphy, which is typically an art form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penmanship"@en .

aat:300389864 a skos:Concept ;
    skos:definition "The technique of adding white or light media on a medium-toned or dark ground. The term is usually reserved for drawing, but painting and other image-making processes may also employ highlighting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "highlighting"@en .

aat:300389865 a skos:Concept ;
    skos:definition "Technique measuring the intensity of electromagnetic radiation over a range of wavelengths using a spectroradiometer, a combination of spectroscope and radiometer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectroradiometry"@en .

aat:300389866 a skos:Concept ;
    skos:definition "Graduated series of tones ascending or descending in order of pitch by fixed intervals; such a series used as the basis of musical composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scales"@en .

aat:300389867 a skos:Concept ;
    skos:definition "The rendering of a photographic plate developable by agents other than light such as a resin, metal, volatile liquid, or printing ink; Discovered by English chemist William James Russell in 1897."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russell effect"@en .

aat:300389868 a skos:Concept ;
    skos:definition "Drawings in which forms are deliberately constructed in light tones against a dark ground. For drawings that are rendered in silverpoint on toned paper with heightening, use \"three-tone drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiaroscuro drawings"@en .

aat:300389869 a skos:Concept ;
    skos:definition "Any material agent which weakens or debases the substance it is added to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adulterant"@en .

aat:300389870 a skos:Concept ;
    skos:definition "Ammonium salt made from a reaction of sulfuric acid and ammonia. It is primarily produced by the destructive distillation of coal. Ammonium sulfate is a commercially important chemical used as a fertilizer, food additive, and tanning agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ammonium sulfate"@en .

aat:300389871 a skos:Concept ;
    skos:definition "Colorless, toxic liquid derived from the amide of formic acid. It is used as a solvent for a wide variety of organic and inorganic compounds including most synthetic and natural resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimethylformamide"@en .

aat:300389872 a skos:Concept ;
    skos:definition "Method of chemical analysis in which the sample is subjected to pyrolysis and the pyrolysate is then analyzed by mass spectrometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyrolysis mass spectrometry"@en .

aat:300389873 a skos:Concept ;
    skos:definition "A form of pyrolysis mass spectrometry in which the temperature of the sample is raised gradually to separate compounds in the evaporation phase from those in the crosslinked fraction of the pyrolysis phase. It is used to provide qualitative views of the broad-band molecular-level characteristics of complex organic samples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct temperature-resolved mass spectrometry"@en .

aat:300389874 a skos:Concept ;
    skos:definition "A chemical compound with the property of making silver salts water-soluble. This property was discovered by Sir John Herschel in 1819, who recommended it as a fixer in photographic processing. It is also used in conservation practice as a cleaning agent for silver and silver-gilt surfaces, and removing silver chloride from wet-washed paper and wet-washed textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium thiosulfate"@en .

aat:300389875 a skos:Concept ;
    skos:definition "The quantitative relationship between a varying magnetic field and the electric field created by the change. This potential difference, or electromotive force, by motion of a conductor in a magnetic field is the fundamental operating principle of electrical transformers, inductors, and electrical motors. It was first observed by Michael Faraday ca. 1831, and is described by Faraday’s law of induction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electromagnetic induction"@en .

aat:300389876 a skos:Concept ;
    skos:definition "Branch of mechanics which studies the generation of cracks in materials using methods of analytical and experimental mechanics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fracture mechanics"@en .

aat:300389877 a skos:Concept ;
    skos:definition "Institutions that specialize in the history, objects, vehicles, and other materials associated with self-propelled vehicles designed primarily to transport passengers over ordinary roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automotive museums"@en .

aat:300389878 a skos:Concept ;
    skos:definition "Buildings housing museums that specialize in the history, objects, vehicles, and other materials associated with self-propelled vehicles designed primarily to transport passengers over ordinary roads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automotive museums"@en .

aat:300389879 a skos:Concept ;
    skos:definition "A logic based on the idea that propositions can be graded in value, rather than simply being true or false. Fuzzy logic has applications in expert systems and artificial intelligence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fuzzy logic"@en .

aat:300389880 a skos:Concept ;
    skos:definition "Hiberno-Norse refers specifically to the culure of Vikings linked to the Gaelic-speaking areas of Ireland. It was once used in a broader sense by scholars to characterize all Scandinavian culture in Gaelic-speaking areaw of North England as well as Ireland; and used in contrast to the related concept 'Anglo-Dane'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hiberno-Norse"@en .

aat:300389881 a skos:Concept ;
    skos:definition "Creation of images by hyperspectral remote sensors which collect data simultaneously in dozens or hundreds of narrow, adjacent spectral bands. The images thus created are more detailed than those of other multispectral sensors with just a few relatively broad wavelength bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyperspectral imaging"@en .

aat:300389882 a skos:Concept ;
    skos:definition "Hydrophilic organic monomer used in the manufacture of flexible contact lenses. In conservation used as a water-absorbing poultice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydroxyethyl methacrylate"@en .

aat:300389883 a skos:Concept ;
    skos:definition "Refers to analysis of materials on a microscopic or macroscopic scale using a beam of positively charged light ions. Ion beam analysis (IBA) techniques are often used to study works of art, because of their noninvasive and nondestructive character. These techniques exploit the products of interactions between beams of accelerated charged particles and the target in order to determine its elemental composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ion beam analysis"@en .

aat:300389884 a skos:Concept ;
    skos:definition "Refers to fabrics engineered with nanofibers having a width of less than 1000 nanometers. These have many applications thanks to such advantageous properties as extreme water-resistance and elasticity. There has been concern expressed regarding environmental and health effects of nanomaterials in nanotextiles released into air, soil, or groundwater or in direct contact with wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanotextiles"@en .

aat:300389885 a skos:Concept ;
    skos:definition "Spectroscopic techniques using laser sources; include Raman laser spectroscopy; laser induced breakdown spectroscopy (LIBS); laser ablation inductively coupled plasma mass spectrometry (LA–ICP–MS); laser induced fluorescence [LIF]; lidar; time-resolved absorption spectroscopy; laser desorption ionization mass spectrometry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser spectroscopy"@en .

aat:300389888 a skos:Concept ;
    skos:definition "Describes a phenomenon of photosensitivity in which a material undergoes a change of color when illuminated with light of the appropriate wavelength; and reverts to its original state either in the dark or upon treatment with irradiation of a different wavelength."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photochromism"@en .

aat:300389889 a skos:Concept ;
    skos:definition "Microfadeometry is a recently developed technique that measures color changes and evaluates light stability in individual objects of art that are sensitive to light exposure. A microfade tester (MFT) uses a powerful xenon arc lamp and filters to focus a beam of very intense light through a fiber optic onto a tiny spot on the surface of the artwork. A second fiber optic collects the reflected light and delivers it to a miniature spectrometer. As the lamp fades the surface of the artwork, the resulting color change is monitored by the spectrometer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfadeometry"@en .

aat:300389890 a skos:Concept ;
    skos:definition "Refers to the gum extracted from perennial grass of the genus Triodia. Australian Aborigines harvest and produce the resin for use as an adhesive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spinifex resin"@en .

aat:300389891 a skos:Concept ;
    skos:definition "In archaeology, the reordering of available remains digitally to virtually reassemble something that existed in the past.This process makes a 3D model assembling surveyed fragments, present in the excavation site, with elements philologically reconstructed on the basis of historical knowledge and documentation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virtual anastylosis"@en .

aat:300389892 a skos:Concept ;
    skos:definition "Refers to digital recreation of art works (such as paintings, sculpture) and other objects (furniture, relics, etc.) by reassembling known parts and filling in lacunae to create realistic, full-color hypothetical models."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virtual restoration"@en .

aat:300389893 a skos:Concept ;
    skos:definition "The filling in of losses and lacunae in the course of virtual anastylosis and virtual restoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital reconstruction"@en .

aat:300389894 a skos:Concept ;
    skos:definition "The external areas of buildings, potentially including the façade and other features, but not necessarily restricted to surface features. Often used with cardinal direction references, such as \"west front\" or \"north front.\" For the vertical arrangements of exterior or interior features, use \"elevations (building divisions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fronts"@en .

aat:300389896 a skos:Concept ;
    skos:definition "Controlled drying technique introduced into printmaking and hand papermaking workshops to shorten drying time and ensure planarity of paper. To do this a material that features open air ducts that promote air exchange is integrated into the structure of the drying stack. Drying is carried out in stacks of corrugated cardboard and other paperboard materials under slight pressure. The stack is equipped with a blower that provides a continuous air-stream through the open channels. The water is removed by continuous evaporation through the moisture-absorbing board until equilibrium with the ambient air is reached."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "air-stream drying"@en .

aat:300389897 a skos:Concept ;
    skos:definition "Refers to a computational model used for machine learning that is inspired by the operations of biological neural networks. Artificial neural networks do not store and process information as conventional digital computers do. Their operation is based instead on the notion of connection as forged by signals transmitted between nodes, feeding information throughout the network. Such networks can be trained by example in cognitive tasks such as pattern recognition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "artificial neural networks"@en .

aat:300389898 a skos:Concept ;
    skos:definition "A theory of mathematical structure in which steady, gradual changes to a system result in sudden, discontinuous results."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catastrophe theory"@en .

aat:300389899 a skos:Concept ;
    skos:definition "Conglomerate rock composed of alluvial gravels and sands which is found in Lombardy, Italy. Ceppo has been used as building material, as well as for statues and carved decorations, since Roman times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceppo"@en .

aat:300389900 a skos:Concept ;
    skos:definition "Order of insects containing 2,400 species and about 430 genera in 15 families, found in temperate and tropical habitats globally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mantodea"@en .

aat:300389901 a skos:Concept ;
    skos:definition "Class of marine invertibrates distinguished by a pair of long, feathery, contractile tentacles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tentaculata"@en .

aat:300389902 a skos:Concept ;
    skos:definition "Order of marine invertibrates distinguished from other ctenophores by having smaller tentacles with flattened lobes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lobata"@en .

aat:300389903 a skos:Concept ;
    skos:definition "Family of marine invertibrates containing three genera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolinopsidae"@en .

aat:300389904 a skos:Concept ;
    skos:definition "Family of marine snails containing around 1,600 living species and 1,200 fossil species. Distinguished by usually having an elongated or heavy shell that is elaborately spined or frilled. The family occurs throughout the world but mainly in the tropics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Muricidae"@en .

aat:300389905 a skos:Concept ;
    skos:definition "Genus of sea snails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolinus"@en .

aat:300389906 a skos:Concept ;
    skos:definition "Species of predatory sea snail, native to central and western parts of the Mediterranean Sea, the Indian Ocean, and South China Sea. It was used to make expensive purple dye since Antiquity; it produces a milky secretion that turns into a powerful and lasting dye when exposed to air."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bolinus brandaris"@en .

aat:300389907 a skos:Concept ;
    skos:definition "Genus of sea snails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexaplex"@en .

aat:300389908 a skos:Concept ;
    skos:definition "Species of predatory sea snail, native to the Mediterranean Sea and the Atlantic coasts of Europe and Africa. It was used to make expensive purple-blue indigo dye since ancient times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hexaplex trunculus"@en .

aat:300389909 a skos:Concept ;
    skos:definition "Genus containing one species of perennial herbaceous plant native to Europe and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tussilago"@en .

aat:300389910 a skos:Concept ;
    skos:definition "Term for animals whose normal representative size is smaller than expected or smaller than that of similar animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pygmies"@en .

aat:300389911 a skos:Concept ;
    skos:definition "Genus of medium-sized mostly insectivorous or omnivorous birds found in Europe, Asia, Africa, the Americas, and Australia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Turdus"@en .

aat:300389912 a skos:Concept ;
    skos:definition "Family of small- to medium-sized birds, including coots, crakes, and gallinules. Many species are associated with wetlands, although members are also found in many terrestrial habitats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rallidae"@en .

aat:300389913 a skos:Concept ;
    skos:definition "Genus containing medium-sized water birds; they are close relatives of coots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gallinula"@en .

aat:300389914 a skos:Concept ;
    skos:definition "Family of large wading birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Threskiornithidae"@en .

aat:300389915 a skos:Concept ;
    skos:definition "Group containing around 26 species of medium-sized wading birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Threskiornithinae"@en .

aat:300389916 a skos:Concept ;
    skos:definition "Family of around 60 genera, 1,700 species of flowering plants found globally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ranunculaceae"@en .

aat:300389918 a skos:Concept ;
    skos:definition "Tree native to India, Nepal, Bhutan, and China. It is known for aromatic leaves that are used for culinary and medicinal purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cinnamomum tamala"@en .

aat:300389919 a skos:Concept ;
    skos:definition "Ovate acidic, juicy tree-fruits with a pale yellow rind. The citron is yellow in color, but larger, less acidic, and has a thicker rind than the lemon. Formerly the term included the lemons and the limes, as well as the fruits to which it is now restricted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citrons"@en .

aat:300389920 a skos:Concept ;
    skos:definition "Genus containing slim, small to medium-sized species of birds in the dove family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Streptopelia"@en .

aat:300389921 a skos:Concept ;
    skos:definition "Genus of legumes, ranging from trees to shrubs, that are native to the New World Tropics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Swartzia"@en .

aat:300389923 a skos:Concept ;
    skos:definition "Family containing quails of North and South America, distantly related to their Old World cousins, and generally having shorter wings and tails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Odontophoridae"@en .

aat:300389924 a skos:Concept ;
    skos:definition "Large family of birds of seed-eating birds with a distinctively finch-like bill, including many commonly known as buntings, finches, grosbeaks, sparrows, and juncos; many are known as buntings in the Old World and sparrows in the New World."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Emberizidae"@en .

aat:300389925 a skos:Concept ;
    skos:definition "Old World genus of songbirds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Emberiza"@en .

aat:300389927 a skos:Concept ;
    skos:definition "Order of ray-finned fish, with two families. This order is closely related to the Salmoniformes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Esociformes"@en .

aat:300389928 a skos:Concept ;
    skos:definition "Family of bony fish having only one living genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Esocidae"@en .

aat:300389929 a skos:Concept ;
    skos:definition "Family of ray-finned fish located in freshwater environments in temperate regions across the Northern hemisphere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Umbridae"@en .

aat:300389930 a skos:Concept ;
    skos:definition "Family of birds that includes the plovers, dotterels, and lapwings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Charadriidae"@en .

aat:300389931 a skos:Concept ;
    skos:definition "Family of wading birds, including sandpipers, curlews, and snipes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scolopacidae"@en .

aat:300389932 a skos:Concept ;
    skos:definition "Mythical creatures represented in ancient Middle Eastern art as a lion or bull with eagles' wings and a human face. Regarded in traditional Christian angelology as an angel of the second highest order of the ninefold celestial hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cherubim"@en .

aat:300389933 a skos:Concept ;
    skos:definition "The process of coating an object with a thin adherent layer of gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold plating"@en .

aat:300389934 a skos:Concept ;
    skos:definition "Genus of containing around 20 species of flowering plants native to Europe, Asia, and north Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lychnis"@en .

aat:300389935 a skos:Concept ;
    skos:definition "Belonging to or of the nature of a hermaphrodite, combining male and female characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hermaphroditic"@en .

aat:300389936 a skos:Concept ;
    skos:definition "Micellar electrokinetic chromatography (MEKC) is a separation mode of capillary electrophoresis (CE). Its separation principle is based on the differential migration of the ionic micelles (surfactant molecules) and surrounding aqueous buffer solution under electrophoresis conditions and on the interaction between the analyte and the micelle. Unlike conventional CE, the solution contains a surfactant at a concentration that is greater than the critical micelle concentration MEKC is a useful technique for the separation of small molecules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micellar electrokinetic chromatography"@en .

aat:300389937 a skos:Concept ;
    skos:definition "Scales or listings of colors, often with each color listed assigned a name and number that reflect its composition, chemical class, and shade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "color indexes"@en .

aat:300389938 a skos:Concept ;
    skos:definition "Windows made of composite material such as fiberglass and resin compounds or chemically–bonded blends of wood and plastic resins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite windows"@en .

aat:300389939 a skos:Concept ;
    skos:definition "Earthen construction material formed into a compressed brick in a mechanical press."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compressed earth block"@en .

aat:300389940 a skos:Concept ;
    skos:definition "Refers to management tasks surrounding the storage, access, retrieval, display, distribution, and stewardship of digital media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital asset management"@en .

aat:300389941 a skos:Concept ;
    skos:definition "Refers to commercial archaeological work in advance of development."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developer-funded archaeology"@en .

aat:300389942 a skos:Concept ;
    skos:definition "Protection measure for copyright violations which occur with the use of digital technologies. Digital watermarking is the process by which identifying data recognized by special software detectors is encrypted in digital content."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital watermarking"@en .

aat:300389943 a skos:Concept ;
    skos:definition "Method of rock fragmentation which employs pulsed power in short, high power bursts of electrical energy to create high internal tensile stresses which fracture materials along grain boundaries. Electric pulse disaggregation (EPD) is an efficient method for separating a rock's constituents with applications that include separation of single crystals for isotopic measurement, and fossil preparation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric pulse disaggregation"@en .

aat:300389944 a skos:Concept ;
    skos:definition "The process by which a decorative or protective coating of any material is deposited onto metal by means of an electrolytic bath. Examples include electroplating which is the electrodeposition of metal; and electrodeposition of paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrodeposition"@en .

aat:300389945 a skos:Concept ;
    skos:definition "Application of electron diffraction in the backscattering mode as used in analysis of crystallographic structure of textured materials that show a preferred orientation of crystalline components. Electron backscatter diffraction (EBSD) is based on the measurement of the diffraction pattern formed by the electrons backscattered toward a phosphor screen positioned at an angle from the sample surface. The visible lines generated by the impinging electrons are called Kikuchi bands; thus the technique is also known as backscatter Kikuchi diffraction (BKD)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron backscatter diffraction"@en .

aat:300389946 a skos:Concept ;
    skos:definition "Genus of conifer containing one species; native to Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cryptomeria"@en .

aat:300389947 a skos:Concept ;
    skos:definition "Genus of sea snails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Monetaria"@en .

aat:300389948 a skos:Concept ;
    skos:definition "Sample extraction technique used for chromatographic analysis of dilute solutions in difficult matrices, liquid and gaseous. Solid-phase microextraction (SPME) has two discrete steps. Extraction is achieved by solute absorption from the sample matrix into a thick layer of silicone or related adsorptive material. Analytes are then transferred into a chromatography inlet system by gaseous or liquid means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solid-phase microextraction"@en .

aat:300389949 a skos:Concept ;
    skos:definition "Refers to the use of nuclear magnetic resonance for medical diagnosis; a non-invasive method of demonstrating internal anatomy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnetic resonance imaging"@en .

aat:300389951 a skos:Concept ;
    skos:definition "Ware, originally produced in South China but later found elsewhere in China, in Japan, Vietnam, and elsewhere in Asia. It includes green-glaze ware and other color-glaze wares with distinctive low relief decoration. Objects include tea ware, decorations for the walls and roof ridges of temples, and figures, including human figures, animals, birds, and flowers in bright, glossy colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cochin ware"@en .

aat:300389952 a skos:Concept ;
    skos:definition "Testing techniques that do not penetrate or alter the sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "noninvasive testing"@en .

aat:300389953 a skos:Concept ;
    skos:definition "A nondestructive, noninvasive optical technique used to test the dielectric properties of thin films. Spectroscopic ellipsometry (SE) employs broadband light sources to measure refractive index, absorption coefficient, and film thickness from the polarization characteristics of linearly polarized incident light reflected from the sample's surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectroscopic ellipsometry"@en .

aat:300389954 a skos:Concept ;
    skos:definition "White crystalline solid used as a mordant in textile dyeing; as a base for lake pigments; in solution for tin-plating of steel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stannous chloride"@en .

aat:300389955 a skos:Concept ;
    skos:definition "Triethanolamine (TEA) is a yellow viscous organic compound used as a surfactant and emulsifier. It is both an amine and a triol, a class of alcohols that have three hydroxyl groups per molecule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triethanolamine"@en .

aat:300389956 a skos:Concept ;
    skos:definition "In art context refers to modern paintings with matte surfaces and rough, unvarnished finishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unvarnished"@en .

aat:300389957 a skos:Concept ;
    skos:definition "Colorless liquid polymer used as a a water-repellent synthetic resin varnish and barrier coating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polybutyl methacrylate"@en .

aat:300389958 a skos:Concept ;
    skos:definition "Polyester web sheeting used as an interleaving; as a paste-resisting work surface; as facing material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rayon paper"@en .

aat:300389959 a skos:Concept ;
    skos:definition "Genus containing around 80 species of perennial scrambling or climbing herbs and shrubs native to Europe, Africa, Asia, and America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubia"@en .

aat:300389960 a skos:Concept ;
    skos:definition "Order of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boraginales"@en .

aat:300389961 a skos:Concept ;
    skos:definition "Family of flowering plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Boraginaceae"@en .

aat:300389962 a skos:Concept ;
    skos:definition "Genus of flowering plant native to the Mediterranean and western Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Onosma"@en .

aat:300389963 a skos:Concept ;
    skos:definition "Analytical technique used to measure changes in energy of a material as a sample and a reference are individually heated at a predetermined rate. Heat-generating or absorbing processes are detected as differences in electrical energy supplied to either the sample or the reference material. The heat flow into or out of the sample is due to the occurrence of a physical or chemical process such as melting, crystallization, or ceramic firing temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "differential scanning calorimetry"@en .

aat:300389964 a skos:Concept ;
    skos:definition "Polyacrylamide gel electrophoresis (PAGE) subjects proteins coated in an anionic detergent to electrophoresis in a polyacrylamide gel in order to determine their molecular weight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polyacrylamide gel electrophoresis"@en .

aat:300389965 a skos:Concept ;
    skos:definition "Nondestructive technique of activation analysis induced by neutrons. The prompt gamma rays immediately emitted by the sample are measured with a gamma ray spectrometer, allowing the identification of a wide variety of neutron-capturing elements simultaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prompt gamma activation analysis"@en .

aat:300389966 a skos:Concept ;
    skos:definition "Refers to a class of techniques used to generate selective, permeable membranes. These processes rely on the phase separation of polymer solutions producing porous polymer films."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phase inversion"@en .

aat:300389968 a skos:Concept ;
    skos:definition "Voltage gradient at which a particular type of ion or other particle passes equally easily in either direction across a cell membrane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equilibrium potential"@en .

aat:300389969 a skos:Concept ;
    skos:definition "Polymeric emulsifier used in art conservation to clean painted surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pemulen TR-2"@en .

aat:300389970 a skos:Concept ;
    skos:definition "In its general sense, stewardship refers to the act of assuming responsibility for the welfare of someone or something. In the context of heritage management, it specifically refers to responsible maintenance and dissemination of cultural heritage by those institutions and individuals it is entrusted to."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stewardship"@en .

aat:300389971 a skos:Concept ;
    skos:definition "Refers to the act of assigning and enhancing value. In a heritage management context, valorization is used in the sense of highlighting and promoting aspects of cultural patrimony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valorization"@en .

aat:300389973 a skos:Concept ;
    skos:definition "Small, extravagant devotional objects, typically dating from the Middle Ages. A prayer nut is composed of two hemispherical pieces of carved wood connected with a hinge to form a round 'nut.' The halves of an actual nut shell, such as a walnut shell, may be used instead. The two halves customarily contain richly carved religious scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer nuts"@en .

aat:300389974 a skos:Concept ;
    skos:definition "Group portraits, usually paintings, representing members of the civil militia or civic guard. The genre was common in the Netherlands of the 16th and 17th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "militia pieces"@en .

aat:300389975 a skos:Concept ;
    skos:definition "Style of ceramic ware produced in Hangzhou in Zheijang province after the Song dynasty established its court there following the invasion of Kaifeng in 1127. Guan (‘official’) wares replaced and to an extent imitated the Ru wares that had been favored by the last two Northern emperors. Guan pieces have a thin, iron-rich body, and a distinctive crackled glaze ranging in color from blue-green to greenish-gray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guan"@en .

aat:300389976 a skos:Concept ;
    skos:definition "In historical western fashion, particularly in the 18th and 19th centuries, attire worn near the end of the period of mourning, when colors of mauve and lavender and more sumptuous fabrics are appropriate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light mourning"@en .

aat:300389978 a skos:Concept ;
    skos:definition "A polyethylene glycol in the form of an odourless and non volatile hygroscopic liquid characterised by two hydroxyl groups and three ether linkages. It is a mixture comprising some high and low molecular weight glycols, but consisting mainly of tetraglycol. It has been used in conservation to stabilize waterlogged archaeological wooden objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetraethylene glycol"@en .

aat:300389979 a skos:Concept ;
    skos:definition "Seismic reflection surveying is a form of geophysical surveying based on the principle that acoustic energy imparted into the earth by an impact source (such as a sledgehammer or explosives) will bounce, or \"reflect,\" off subsurface interfaces. Seismographs and acoustic sensors (\"geophones\") record the reflections. Reflection seismic techniques study the arrival times, amplitude, and shape of the reflected waves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seismic reflection surveying"@en .

aat:300389980 a skos:Concept ;
    skos:definition "Vehicles with two wheels in tandem propelled by the rider straddling a diamond-shaped frame mounting wheels seat and steering handle bars, with a horizontal bar as the top element joining the handlebars to the seat post. These are the basic elements of most bicycles with the exception of those that have eliminated or dropped the top horizontal bar to accommodate women's skirts. Historically some bicycles with identical structure have been marketed as either \"men's bicycles\" or \"women's bicycles\" as fashions changed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "men's bicycles"@en .

aat:300389981 a skos:Concept ;
    skos:definition "Elaborately decorated metal feet and stems onto which ordinary glasses can be clamped thus forming an elegant vessel. They were made as prestige objects to adorn the table. In the 15th century glass holders were often commissioned by city councils and aristocrats. By the 17th century, wealthy burghers had acquired a taste for these objects, although the fashion declined after 1650. Most glass holders were made of bronze, silver or silver gilt. The clamps often incorporated a human figure, a sea-horse or an animal head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass holders"@en .

aat:300389982 a skos:Concept ;
    skos:definition "Compact, portable radiotransmitter-receivers for very high frequencies that have a limited transmitting power and are usable within a limited area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "walkie-talkies"@en .

aat:300389983 a skos:Concept ;
    skos:definition "Settlements in which almost all the habitations are confined to a defined area. The nucleus is usually surrounded by agricultural land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nucleated villages"@en .

aat:300389984 a skos:Concept ;
    skos:definition "Peel strength is the measure of the average force required to separate two bonded materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peel strength"@en .

aat:300389985 a skos:Concept ;
    skos:definition "Depictions of a specific ship. The genre was developed to a great extent in the Netherlands, beginning in the 17th-century; but it also flourished in the art of several other western maritime nations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship portraits"@en .

aat:300389987 a skos:Concept ;
    skos:definition "Refers to the most commonly used flourescence microscopy technique. Exciting radiation is mounted above ('epi') the specimen and is reflected downwards, passing through the microscope objective lens on its way toward the specimen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epifluorescence microscopy"@en .

aat:300389988 a skos:Concept ;
    skos:definition "Workers who are charged with tending fires or furnaces for steam-powered tools or on vehicles such as locomotives and steamships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stokers"@en .

aat:300389989 a skos:Concept ;
    skos:definition "Cation-exchange capacity (CEC) is defined as the quantity of nutrient cations a soil can adsorb and exchange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cation exchange capacity"@en .

aat:300389990 a skos:Concept ;
    skos:definition "Smart materials that have the capacity to clean themselves. Examples are silicone-based architectural coatings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "self-cleaning materials"@en .

aat:300389991 a skos:Concept ;
    skos:definition "Digital Image Correlation (DIC) is an optical image analysis method, based on gray value digital images captured by an optical sensor at a rate of 1,500 images per second. It employs tracking and image registration techniques to measure deformation, displacement, and strain on almost any material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital image correlation"@en .

aat:300389992 a skos:Concept ;
    skos:definition "Predictive modeling refers to any process used to create a statistical model of future behavior. In archaeological predictive modeling, analysis of quantifiable attributes from land that has undergone archaeological survey, such as soil types, vegetation, geomorphology, etc., is used to predict the archaeological sensitivity of unsurveyed areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "predictive modeling"@en .

aat:300389993 a skos:Concept ;
    skos:definition "Materials derived from any of several species of sphagnum moss, particularly the polysaccharides known for strong antibacterial properties used medicinally. This extract has also been used as a fungal inhibitor in art conservation, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sphagnum moss extract"@en .

aat:300389994 a skos:Concept ;
    skos:definition "General term for either a blue (BaCuSi4O10) or purple (BaCuC2O6) pigment found in paints and ceramic glazes on Chinese artifacts; made by melting silica with copper and barium at very high temperatures. Developed in China and used to create Chinese blue and Chinese purple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barium copper silicate"@en .

aat:300389995 a skos:Concept ;
    skos:definition "Bioreceptivity is defined as the ability of a material to be colonised by living organisms. In the context of conservation this concept is extended to water repellents and consolidants applied on stone objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioreceptivity"@en .

aat:300389996 a skos:Concept ;
    skos:definition "A type of warping usually associated with wood when one face of a length of lumber shrinks more than the other, resulting in a bowed curvature. Less commonly this process may occur in stone such as marble, due to residual stresses, anisotropic thermal expansion of calcitic grains, variation of fluid contents, and dissolution processes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowing"@en .

aat:300389997 a skos:Concept ;
    skos:definition "Finely granulated copper with numerous metallurgical applications produced by various techniques such as electrolysis, atomization, hydroscopy. Each method of manufacture yields a powder with its own inherent characteristics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper powder"@en .

aat:300389998 a skos:Concept ;
    skos:definition "Refers to photogrammetric techniques applied in scanning electron microscopy to obtain highly accurate three dimensional morphology characteristics for microstructures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microphotogrammetry"@en .

aat:300389999 a skos:Concept ;
    skos:definition "Thermoplastic polyester manufactured from corn starch or other renewable resources. First developed for use as a synthetic fiber during World War 2 when organic materials were in short supply. In conservation used as a protective covering for stone materials exposed outdoors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polylactic acid"@en .

aat:300390000 a skos:Concept ;
    skos:definition "An acoustic imaging technique in which information is received from beams of acoustic radiation that have passed through an object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acoustic tomography"@en .

aat:300390001 a skos:Concept ;
    skos:definition "Ability of cement paste, aggregate, or mixtures thereof to resist attack by dissolved sulfates in water or soil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfate resistance"@en .

aat:300390002 a skos:Concept ;
    skos:definition "Refers to a natural or manmade soil moisture regime and its effects on the physical, chemical, and biological properties of irrigated soils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wetting-drying cycle"@en .

aat:300390503 a skos:Concept ;
    skos:definition "Entities having life, ranging from single-celled prokaryotes and eurkaryotes to multicellular fungi, plants, and animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "living organisms"@en .

aat:300390504 a skos:Concept ;
    skos:definition "Genus of birds in the finch family, including canaries, seedeaters, and siskins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serinus"@en .

aat:300390505 a skos:Concept ;
    skos:definition "A genus of hornbills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhinoplax"@en .

aat:300390506 a skos:Concept ;
    skos:definition "Phylum of bacteria, most having gram-positive cell wall structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Firmicutes"@en .

aat:300390507 a skos:Concept ;
    skos:definition "Class of bacteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bacilli"@en .

aat:300390508 a skos:Concept ;
    skos:definition "Order of bacteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bacillales"@en .

aat:300390509 a skos:Concept ;
    skos:definition "Family of bacteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bacillaceae"@en .

aat:300390510 a skos:Concept ;
    skos:definition "Order of cartilaginous fish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chimaeriformes"@en .

aat:300390511 a skos:Concept ;
    skos:definition "Order having only one living family of ray-like fish with long, flat, toothed rostrums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pristiformes"@en .

aat:300390512 a skos:Concept ;
    skos:definition "Phylum of fungi."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Basidiomycota"@en .

aat:300390513 a skos:Concept ;
    skos:definition "Froth produced by yeast that forms on the top of fermenting malt liquors; it is used to leaven bread and to cause fermentation in other liquors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barm"@en .

aat:300390514 a skos:Concept ;
    skos:definition "Edible substance consisting of the curd of milk (coagulated by rennet), separated from the whey, and pressed into a solid mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese"@en .

aat:300390515 a skos:Concept ;
    skos:definition "Family of scale insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kermesidae"@en .

aat:300390516 a skos:Concept ;
    skos:definition "Japanese culture and period lasting from December 1830 through December 1844; also known as Tempō. It was initiated to signal a break with the Bunsei era after disasters of earthquake and fire. The name means: \"Heavenly Imperial Protection\". It was a culturally rich period marked by ambitious, if ultimately failed, campaigns of reform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tenpō"@en .

aat:300390517 a skos:Concept ;
    skos:definition "The measure of the resistance that an electrical circuit presents in response to the passage of a current when a voltage is applied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impedance"@en .

aat:300390518 a skos:Concept ;
    skos:definition "Method of ionizing samples for use in mass spectrometry allowing the analysis of fragile biomolecules and organic molecules which fragment when ionized by other methods. The analyte is prepared in or on an organic matrix that is coated on a surface which is then irradiated by laser photons, removing the analyte from the surface and ionizing it for analysis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "matrix-assisted laser desorption ionization"@en .

aat:300390519 a skos:Concept ;
    skos:definition "Type of emission spectroscopy in which electrical energy in the form of a spark or an arc is used to excite the analyte prior to measuring the intensity of emitted radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atomic emission spectroscopy"@en .

aat:300390520 a skos:Concept ;
    skos:definition "Emission spectroscopy technique used to determine elemental content of materials. The material is heated to a high temperature causing the electrons in the sample to emit light which is converted into a spectral pattern. In the broader sense, optical emission spectroscopy includes ICP optical emission spectrometry, which uses an inductively coupled plasma as the excitation source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical emission spectroscopy"@en .

aat:300390521 a skos:Concept ;
    skos:definition "A form of electron microscopy in which the electron beam passes through a very thin sample, deflecting or scattering some of the electrons which are focused by magnetic lenses onto a screen or photographic plate. The technique is used to visualize the interior structure of such specimens as cells and tissues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transmission electron microscopy"@en .

aat:300390522 a skos:Concept ;
    skos:definition "Technique of elemental analysis funamentally similar to and most often practiced in conjunction with particle-induced x-ray emission (PIXE) with the difference that gamma rays are measured instead of x-rays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "particle-induced gamma ray emission"@en .

aat:300390523 a skos:Concept ;
    skos:definition "Christian religious monument in the form of a column and dedicated to the Virgin Mary, erected as a gesture of public faith, as a plague column, or for another purpose. Common in Catholic countries of Europe, especially in the 17th and 18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Marian columns"@en .

aat:300390524 a skos:Concept ;
    skos:definition "Christian religious monuments in the form of a column and erected in thanksgiving for surviving the plague. They may be dedicated to the Holy Trinity, the Virgin Mary, a saint, or with another dedication. They were common in Catholic countries of Europe, especially in the 17th and 18th centuries"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plague columns"@en .

aat:300390525 a skos:Concept ;
    skos:definition "Lines of closely spaced hedges typically interspersed with trees, usually planted on a low earthen wall or base and trained to form a barrier or mark the boundary of an area, particularly in fields or between properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hedgerows"@en .

aat:300390526 a skos:Concept ;
    skos:definition "Trees planted in hedgerows that are allowed to reach their full height, interspersed with low hedges to form a hedgerow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hedgerow trees"@en .

aat:300390527 a skos:Concept ;
    skos:definition "Trees or shrubs trained to form a hedge, with the primary purpose of defense against animals or intruders, but also used as boundary markers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "defensive hedges"@en .

aat:300390528 a skos:Concept ;
    skos:definition "A type of atomic emission spectroscopy which employs a highly energetic laser pulse as the excitation source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser-induced breakdown spectroscopy"@en .

aat:300390529 a skos:Concept ;
    skos:definition "Spectroscopic flow visualization technique that uses ultrashort pulse lasers for the study of dynamics on extremely short time scales; fluorescent markers are excited by a laser beam; used to make visible disturbances that occur in fluid flow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser-induced fluorescence"@en .

aat:300390530 a skos:Concept ;
    skos:definition "Construction system of interlocking patterned concrete blocks especially associated with Frank Lloyd Wright who built four textile-block homes from 1923-1925."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile block construction"@en .

aat:300390531 a skos:Concept ;
    skos:definition "Hollow cylindrical molecules in the form of tubes measuring nanometers in diameter and composed entirely of carbon atoms. Carbon nanotubes have many potential commercial applications. They possess extraordinary strength and unique electrical properties, and are efficient conductors of heat. Nanotubes are already used in many common products, such as bicycle frames, automobile bodies, and tennis rackets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon nanotubes"@en .

aat:300390532 a skos:Concept ;
    skos:definition "A small-dimension fiber composed of ceramic oxide used in insulation, packing, and filtration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceramic fiber"@en .

aat:300390533 a skos:Concept ;
    skos:definition "The three types of perspective found in Chinese landscape painting, comprising “level-distance,” “high distance,” and “deep distance.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three distances"@en .

aat:300390534 a skos:Concept ;
    skos:definition "In Chinese landscape painting, perspective created through a view across a low, broad expanse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "level-distance"@en .

aat:300390535 a skos:Concept ;
    skos:definition "In Chinese landscape painting, perspective created through a view of lofty mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high distance"@en .

aat:300390536 a skos:Concept ;
    skos:definition "In Chinese landscape painting, perspective created through a view past high mountains into the distance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep distance"@en .

aat:300390537 a skos:Concept ;
    skos:definition "Brush strokes found in traditional Chinese painting. These long, loose strokes often are used to define rock and mountain formations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemp-fiber brush strokes"@en .

aat:300390538 a skos:Concept ;
    skos:definition "Brush strokes found in traditional Chinese painting. Associated with the Northern Song dynasty painter Guo Xi (active 1068-1078), these curved strokes resemble gathering clouds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roiling cloud brush strokes"@en .

aat:300390539 a skos:Concept ;
    skos:definition "Brush strokes found in traditional Chinese painting. Associated with the Northern Song dynasty painter Mi Fu (1051-1107), after whom they are named, these wet, inky strokes create a misty, atmospheric effect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mi dots"@en .

aat:300390540 a skos:Concept ;
    skos:definition "Brush strokes found in traditional Chinese painting. These wedge-shaped strokes resembles the cuts made by an ax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ax-cut brush strokes"@en .

aat:300390541 a skos:Concept ;
    skos:definition "Family of plants comprising a large assemblage of 338 genera and some 3,710 species of mostly herbaceous plants with peppery-flavoured leaves. The family includes many plants of economic importance that have been extensively altered and domesticated by humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brassicaceae"@en .

aat:300390542 a skos:Concept ;
    skos:definition "Genus of plants including food crops such as cabbage, cauliflower, broccoli, Brussels sprouts, and some types of seeds, including mustard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brassica"@en .

aat:300390543 a skos:Concept ;
    skos:definition "Genus of plants including food crops, such as mustard and various greens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sinapis"@en .

aat:300390545 a skos:Concept ;
    skos:definition "Genus containing around 125 species of flowering plants native to Eurasia and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orchis"@en .

aat:300390546 a skos:Concept ;
    skos:definition "Polymeric fiber having a width of less than 1000 nanometers. The material may be fashioned into nanotextiles which have advantageous properties such as extreme water-resistance and elasticity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanofiber"@en .

aat:300390547 a skos:Concept ;
    skos:definition "Trade name for a purified and standardized form of funori, a Japanese glue extracted from the red algae genus Gloiopeltis. It was developed specifically for use by conservators for the consolidation of matte paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "JunFunori (TM)"@en .

aat:300390548 a skos:Concept ;
    skos:definition "Quaternary ammonium salt used as a basic solvent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetramethylammonium hydroxide"@en .

aat:300390549 a skos:Concept ;
    skos:definition "Nanocomposite materials consisting of magnetic nanoparticles and a gel matrix used as active sponge-like nanomagnetic container for water-based formulations as oil-in-water microemulsions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanosponges"@en .

aat:300390550 a skos:Concept ;
    skos:definition "Artists, particularly painters, who specialize in a style emphasizing shadows, darkness, or night effects; particularly used for artists having this style in 17th-century Europe and as influenced by Caravaggio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenebrists"@en .

aat:300390552 a skos:Concept ;
    skos:definition "A group of chemically reactive silane compounds (organofunctional alkoxysilanes) Used in the context of paper conservation to deacidify and strengthen degraded paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aminosilane"@en .

aat:300390553 a skos:Concept ;
    skos:definition "Any of several silicates containing lithium. Used as sealer and hardener in concrete surface treatments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lithium silicate"@en .

aat:300390554 a skos:Concept ;
    skos:definition "A reddish-brown leather usually made from sheepskin that is vegetable tanned. A decorative pattern is applied by sandwiching the leather between a heated metal plate and a mold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scorched leather"@en .

aat:300390555 a skos:Concept ;
    skos:definition "Type of mounting in which an artwork shows the edges of the paper within the window mat, and appears to float above the backing board."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "float mounting"@en .

aat:300390556 a skos:Concept ;
    skos:definition "The action of removing a coating, as of paint or ink, from the surface of a support with a cloth or similar material to leave empty zones or a film behind as an effect, to efface, or to clean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wiping"@en .

aat:300390557 a skos:Concept ;
    skos:definition "Often imitated painting technique associated with Rembrandt of gouging in wet paint with the wooden end of a brush or other utensil to create texture and manipulate tone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouging"@en .

aat:300390558 a skos:Concept ;
    skos:definition "Collaborative research approach that incorporates those affected by the issues studied for the ends of education and taking action to effect change."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "participatory action research"@en .

aat:300390560 a skos:Concept ;
    skos:definition "The act or process of finishing something as in an architecutral context; completion of a protracted building campaign such as the construction of a cathedral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "completion"@en .

aat:300390561 a skos:Concept ;
    skos:definition "Refers to biomimetic products modeled on the adhesion properties of the underside of gecko toes which has layered ridges with very fine keratinous hairs (setae) that provide intimate contact with virtually any surface. Research has been carried out to study the degrees of adhesion provided by different shapes and arrangements of nanofiber arrays and to mimic the setae in synthetic materials. Gecko adhesion is dry and mechanically activated, which offers a solution for some problems, such as solvent damage and inadequate reversibility, with existing museum adhesives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gecko synthetic adhesive"@en .

aat:300390562 a skos:Concept ;
    skos:definition "Bronze drum-shaped vessels, often elaborately decorated with relief or free-standing animal figures, fashioned to contain cowrie-shell money in the ancient Dian kingdom of southwestern China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cowrie-shell containers"@en .

aat:300390564 a skos:Concept ;
    skos:definition "Refers to third millennium Chalcolithic culture of the ancient Baden region which spread over much of central Europe, and developed out of late Stone Age Lengyel culture. It is characterized by metal objects such as axe handles and plain, dark pottery. Images of domesticated horses are appear in artifacts as are four-wheeled carts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baden"@en .

aat:300390565 a skos:Concept ;
    skos:definition "Painted ware of mid-late Neolithic widely diffused in southern Italy during the fifth millennium. It is named for a site near Matero and is characterized by necked and flat-bottomed vessels with distinctive spiral handles. Serra d'Alto ware, which is often found among grave goods, may have been created as a prestige item intended for trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Serra d'Alto ware"@en .

aat:300390566 a skos:Concept ;
    skos:definition "Any of various preparations made from the seeds, fruits, leaves, or bark of the neem tree, used for medicinal purposes, as an insecticide, and for other purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neem"@en .

aat:300390567 a skos:Concept ;
    skos:definition "A numerical method used in computing the stresses and displacements of a large number of small particles such as grains of sand. Often used in combination with the finite element method to address engineering questions involving granular and discontinuous materials in continuous physical systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discrete element method"@en .

aat:300390569 a skos:Concept ;
    skos:definition "Pottery characterized by a tan color, having a relatively simple design that is painted or imprinted, and is common to ancient Troy, Cyprus, and many other cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tan ware"@en .

aat:300390570 a skos:Concept ;
    skos:definition "Silicates organically modified by the sol-gel process. In conservation, applied as protective coatings for stone and stained glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organically modified silica"@en .

aat:300390571 a skos:Concept ;
    skos:definition "Analysis that measures how spending associated with an event flows through a regional economy as measured by positive changes in aspects of the economy such as profits, wages, and jobs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "economic impact analysis"@en .

aat:300390572 a skos:Concept ;
    skos:definition "A form of mass spectrometry commonly used for surface analysis. When a primary beam of accelerated ions strikes a solid surface, secondary ions are among the elements displaced in a process called sputtering. These ions may be directly studied to gain information about the target material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary ion mass spectrometry"@en .

aat:300390573 a skos:Concept ;
    skos:definition "Term used broadly for video art that uses a single electronic source with a single playback system that is exhibited on a single display. An example would be a videotape source being played on a videocassette recorder, being displayed on a single monitor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-channel video"@en .

aat:300390574 a skos:Concept ;
    skos:definition "Video art that utilizes two or more display devices for the same work of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multi-channel video installations"@en .

aat:300390575 a skos:Concept ;
    skos:definition "Sensitive surface analytical technique that measures secondary electrons excited by an incident electron beam. This technique is used to determine elemental composition of the top few nanometers of solid, electrically conductive materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Auger electron spectroscopy"@en .

aat:300390576 a skos:Concept ;
    skos:definition "Tomographic technique using lasers for imaging of subsurface tissue structure with sub-micrometer axial and lateral resolution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical coherence tomography"@en .

aat:300390577 a skos:Concept ;
    skos:definition "Method of infrared spectroscopic analysis that measures the ways a molecule can vibrate. Radiation is passed through a sample and its absorption is detected in terms of characteristic frequencies associated with normal modes of vibration of molecules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vibrational spectroscopy"@en .

aat:300390578 a skos:Concept ;
    skos:definition "Removal of liquid from a material under reduced air pressure, allowing a lower temperature of drying than under normal pressure. In conservation, used in mass drying of waterlogged objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum drying"@en .

aat:300390579 a skos:Concept ;
    skos:definition "Describes the inelastic scattering of light which occurs in a small percentage of photons scattered by an excitation, resulting in a frequency shift due to an energy exchange between the incident light photons and the scattering atoms. The phenomenon was identified by Chandrasekhara Raman in 1928. It forms the subject of study of Raman spectroscopy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Raman scattering"@en .

aat:300390580 a skos:Concept ;
    skos:definition "Computerized tomography that uses neutrons as the form of penetrative radiation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neutron tomography"@en .

aat:300390581 a skos:Concept ;
    skos:definition "A surface-sensitive mass spectrometry technique in which an ion's mass-to-charge ratio is determined by a time measurement. Particles removed from the atomic monolayers of a surface are accelerated into a flight tube and their mass is measured by the time it takes them to reach the detector."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time-of-flight mass spectrometry"@en .

aat:300390582 a skos:Concept ;
    skos:definition "A form of ion beam analysis named for Lord Ernest Rutherford. It yields information on the thickness and elemental composition of a sample by detection of the backscattered protons from crystalites or other particles of the analysed sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rutherford backscattering spectroscopy"@en .

aat:300390583 a skos:Concept ;
    skos:definition "Scanning electron microscopy performed using a field-emission cathode in the instrument's electron gun, producing clearer, less electrostatically distorted images than conventional SEM."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field-emission scanning electron microscopy"@en .

aat:300390584 a skos:Concept ;
    skos:definition "Form of scanning electron microscopy that provides electron imaging at a relatively high degree of sample pressure. It allows the option of capturing photomicrographs of wet or uncoated specimens by offering a gaseous environment within the specimen chamber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "environmental scanning electron microscopy"@en .

aat:300390585 a skos:Concept ;
    skos:definition "A surface analysis technique which measures the elastically scattered ion created when a primary ion beam is directed at the sample surface. The kinetic energy of the reflected primary ion depends on the mass of the surface atom involved in scattering, thus revealing information about the sample surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ion scattering spectroscopy"@en .

aat:300390586 a skos:Concept ;
    skos:definition "Refers to partial heat denaturation of DNA strands performed on a high-performance liquid chromatograph (HPLC). It uses heteroduplex formation between wild-type and mutated DNA strands to identify mutations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denaturing high performance liquid chromatography"@en .

aat:300390587 a skos:Concept ;
    skos:definition "Nondestructive analytic technique used to monitor oxygen consumption. It is based on the dynamic quenching of the fluorescence or phosphoresence of luminescent dyes by molecular oxygen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "optical oxygen sensing"@en .

aat:300390588 a skos:Concept ;
    skos:definition "A type of structural lumber product composed of a wood core with several layers of wood veneer bonded to the front and back by durable adhesive known as laminating stock. Glue-laminated timber beams are used as an alternative to steel beams in construction due in part to the relative energy-efficiency of their manufacture which produces far less greenhouse gas emissions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glue-laminated timber"@en .

aat:300390589 a skos:Concept ;
    skos:definition "Fluorescence microscopy technique used for specific identification of molecules. It uses the specificity of antibodies to their antigen to target fluorescent dyes to specific targets within a cell, and therefore allows visualization of the distribution of the target molecule through the sample. In conservation science, the technique has been used for the highly sensitive and specific identification of proteins in artistic and archaeological materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "immunofluorescence microscopy"@en .

aat:300390590 a skos:Concept ;
    skos:definition "Optical emission spectral analysis technique in which excitation employs glow discharge, a plasma created by passing an electric current between metal electrodes in a tube containing a gas. In GD-OES a sample located in the cathode is bombarded by a glow discharge lamp. Sputtered neutral atoms excited in the plasma give off characteristic light in deexcitation which is collected by a spectrophotometer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glow discharge optical emission spectrometry"@en .

aat:300390591 a skos:Concept ;
    skos:definition "Electron energy loss spectroscopy measures the energy of scattered electrons reemitted from surfaces after bombardment by an electron beam, thus determining the distribution of energy loss. Provides data complementary to Auger electron spectroscopy which operates according to the same principle but uses a different process to produce the electrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron energy loss spectroscopy"@en .

aat:300390592 a skos:Concept ;
    skos:definition "Generally, people who dig in the earth as an occupation, including laborers. Specifically, an archaeologist who uncovers artifacts according to controlled methods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "excavators"@en .

aat:300390593 a skos:Concept ;
    skos:definition "Fluorescence-lifetime imaging microscopy or FLIM is an imaging technique for producing molecular images based on the fluorescence lifetime (the average time that the molecule spends in the excited state) from a fluorescent sample.The lifetime of the fluorophore signal, rather than its intensity, is used to create the image in FLIM. The fluorescence lifetime can function as a molecular stopwatch to observe a variety of events.The technique is thus particularly suitable for live-cell imaging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fluorescence lifetime imaging microscopy"@en .

aat:300390594 a skos:Concept ;
    skos:definition "A computational imaging technique that creates a virtual three-dimensional digital surrogate of a subject that can be interactively relit from any direction. An RTI file is a composite of multiple images of a subject photographed from a fixed position for which a light source has been repositioned at a constant radius from the subject, thus creating a hemisphere of positions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflectance transformation imaging"@en .

aat:300390596 a skos:Concept ;
    skos:definition "Any of a class of synthetic aluminosilicate materials, chains or networks of mineral molecules linked with covalent bonds, used in concrete-polymer composites as an alternative to Portland cement; in resins and binders; and as a decorative cast stone-like material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geopolymers"@en .

aat:300390597 a skos:Concept ;
    skos:definition "A technique based on the Doppler-effect for determining vibration velocity and displacement at a fixed point. It uses a two beam laser interferometer measuring the difference in frequency between a test beam and an internal reference beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser Doppler vibrometry"@en .

aat:300390598 a skos:Concept ;
    skos:definition "A phenomenon by which the effects in a property lag behind the changes in the forces acting upon it such as magnetizing force or stress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hysteresis"@en .

aat:300390599 a skos:Concept ;
    skos:definition "Nondestructive ion beam analysis technique using accelerated particles in which specific target elements in the sample undergo a nuclear reaction. The emitted ionizing radiation is characteristic for this reaction and can be detected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear reaction analysis"@en .

aat:300390600 a skos:Concept ;
    skos:definition "Impact-echo is a nondestructive evaluation technique for masonry construction which detects flaws by monitoring impact-generated sound waves that are disseminated through a structure and are reflected by internal flaws and external surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "impact-echo"@en .

aat:300390601 a skos:Concept ;
    skos:definition "Texture mapping is the application of a two-dimensional image file containing texture, color, or surface detail to a 3D model or computer-generated graphic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "texture mapping"@en .

aat:300390602 a skos:Concept ;
    skos:definition "Nondestructive technique for determining the surface topographical features of three dimensional objects by means of laser triangulation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser profilometry"@en .

aat:300390603 a skos:Concept ;
    skos:definition "Measurement of character and extent of respiration by using a respirometer, a tool which monitors the concentration of a gas contained within an enclosed space into which the material being monitored is respiring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "respirometry"@en .

aat:300390604 a skos:Concept ;
    skos:definition "Reinforced concrete that contains embedded textile material reinforcements instead of the typical metal bars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "textile-reinforced concrete"@en .

aat:300390605 a skos:Concept ;
    skos:definition "Colorless double salt first prepared in La Rochelle, France, and thus also known as Rochelle salt. It is used as an analytical reagent, as a laxative, and in making mirrors.In conservation science, it is used in saturated solution as a cleaning agent on bronze and other metal objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "potassium sodium tartrate"@en .

aat:300390606 a skos:Concept ;
    skos:definition "Communities of animals or plants that are temporary or in a constant state of flux. Examples include groups of animals that stop temporarily during a migration, or communities of plants that appear and disappear with changing climate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ephemeral communities"@en .

aat:300390894 a skos:Concept ;
    skos:definition "A yellow-orange compound of copper and vanadate. Used as a pigment; and a member of the vanadium group of natural and synthesized pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper vanadate"@en .

aat:300390895 a skos:Concept ;
    skos:definition "A white ore composed of hydrous zinc silicate. It is a minor ore of zinc that occurs in zinc mines worldwide with significant deposits in Siberia, Romania, Sardinia, Slovenia, Belgium, Germany, Poland, England, Mexico, and the United States. Formerly confused with smithsonite, and both were called calamine; see \"calamine (mineral admixture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemimorphite"@en .

aat:300390897 a skos:Concept ;
    skos:definition "Reddish brown dye prepared from the leaf of the Lawsonia inermis. Henna is used mainly as a cosmetic dye for hair, hands or nails or as a pigment for dying leather or other fabrics. The colors can vary from dark brown to light orange."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "henna"@en .

aat:300390898 a skos:Concept ;
    skos:definition "Wooden blocks in the form of a hat, used by hat makers to shape a felt or straw hat. Modern hat blocks may be made of other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hat blocks"@en .

aat:300390899 a skos:Concept ;
    skos:definition "Lever or hook used in cooperies to fit the last hoops on a barrel or tub."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hoop drivers"@en .

aat:300390901 a skos:Concept ;
    skos:definition "Small keys for winding up watches, particularly pocket watches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watch keys"@en .

aat:300390902 a skos:Concept ;
    skos:definition "Pieces of bread that are consecrated and form one of the principle elements of the Christian eucharistic sacrament. In modern western rites, the hosts are often thin wafers of unleavened bread. Most eastern churches use leavened bread. Early in Christian history, loaves of bread and wine for the eucharistic sacrifice were brought to the altar by the faithful, each contributing his or her share. Eventually, the hosts were prepared under controlled conditions, assuming a round form of moderate thickness, often stamped with a cross or another significant religious emblem. In modern western rites, hosts are often so thin as to be wafer-like. The term \"host\" derives from Latin \"hostia,\" meaning the victim or host for a sacrifice, which is symbolized by the consecration of the bread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosts"@en .

aat:300390904 a skos:Concept ;
    skos:definition "Covered vessels, usually circular in shape, used by Christian churches for storing unconsecrated hosts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "host boxes"@en .

aat:300390905 a skos:Concept ;
    skos:definition "Punches, resembling cookie-cutters, designed specifically to cut round wafers for hosts from a larger piece of wafer material; the hosts are used in Christian eucharistic liturgies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "host cutters"@en .

aat:300390906 a skos:Concept ;
    skos:definition "Circular, perforated plate sieves, typically made of wood and parchment, having raised sides. They are designed especially for the preparation of communion wafers for liturgical use; the sieves are used for separating the wafers from the edge remnants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion wafer sieves"@en .

aat:300390907 a skos:Concept ;
    skos:definition "Devices for carrying lightweight tree trunks, telephone poles and similar. The version designed for two persons consists of a pair of hinged chisel-bill hooks used as pincers mounted on pivots at the middle of a wooden pole, which is grasped at either side of the object being carried. The weight of the log forces the hooks to sink into the wood. There are verions for single-person operation with a number of interconnected levers between handle and hooks and is used for carrying relatively short pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "timber carriers"@en .

aat:300390908 a skos:Concept ;
    skos:definition "Two-dimensional works, usually on paper, in which the image is created with charcoal, which is a black, porous carbonaceous material made from burned wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "charcoal drawings"@en .

aat:300390909 a skos:Concept ;
    skos:definition "Altars in a domestic setting rather than a public space. Examples have existed since ancient times in many cultures and religions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house altars"@en .

aat:300390910 a skos:Concept ;
    skos:definition "Blessings for the home, including cards and plaques, often displayed near the entrance of the home. Common to several cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "house blessings"@en .

aat:300390911 a skos:Concept ;
    skos:definition "Distinctive types of popular prints containing Chrsitian prayers or blessings, often with images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer prints"@en .

aat:300390912 a skos:Concept ;
    skos:definition "Candles used during a marriage ritual and/or in commemoration of a marriage, in the later case often with the date and names of the couple inscribed. The ritualistic use of candles during a marriage has roots in the ancient \"taeda,\" essential in ancient Greek and Roman marriage ceremonies. In more modern western usage, several traditions exist: Included are carrying the candle in the bridal procession to the church; the solemn presentation of the candle to the bride by the bridegroom; the lighting of the candle in the home of the newly married couple; or in the liturgy, the couple may each have separate candles, which they extinguish to allow the single marriage candle to remain; or the couple may each contribute to lighting the marriage candle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage candles"@en .

aat:300390913 a skos:Concept ;
    skos:definition "Medal issued to recognize or to commemorate a marriage, often having representations and names of the couple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage medals"@en .

aat:300390914 a skos:Concept ;
    skos:definition "Prints commemorating a marriage, often of a ruling family or otherwise of a marriage important to the community. The subject typically includes portraits and particulars of the event, or allegorical subjects referring to the couple. The genre was particularly popular in Europe from 16th-19th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marriage prints"@en .

aat:300390915 a skos:Concept ;
    skos:definition "Cordage fiber derived from the stems of a few species in the Garcinia genus of evergreen trees and shrubs, particularly in tropical Africa and Brazil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imbe"@en .

aat:300390916 a skos:Concept ;
    skos:definition "Any material that resembles gemstone, but is typically less expensive and used in place of genuine gems. Examples of imitation gemstones include rhinestones and cubic zirconia (imitation diamonds)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation gemstone"@en .

aat:300390917 a skos:Concept ;
    skos:definition "Any material that is not the fine, soft, thick, hairy coat of a mammal, but resembles genuine fur. To refer specifically to the fashion textile having a very long pile, prefer the narrower term \"fake fur fabric.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation fur"@en .

aat:300390918 a skos:Concept ;
    skos:definition "Any metallic alloy used as a substitute for gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation gold"@en .

aat:300390919 a skos:Concept ;
    skos:definition "Any material used to resemble or substitute for natural hair, particularly human hair."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation hair"@en .

aat:300390920 a skos:Concept ;
    skos:definition "Material resembling pearls, often inexpensive. Imitation pearls, first made in the 19th century, were constructed by injecting hollow beads of glass with a mixture of aqueous ammonia and fish scales; this deposited a layer of guanine crystals as an iridescent film on the interior surface of the beads. In the 20th century, another process made imitation pearls by coating the exterior of solid glass beads with the fish scale mixture; the nacreous coating was sealed with a protective varnish layer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation pearl"@en .

aat:300390922 a skos:Concept ;
    skos:definition "Distinctive pointers used during the liturgies of certain Christian churches to indicate to the congregation which text will be read."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indexes"@en .

aat:300390923 a skos:Concept ;
    skos:definition "Registries made of metal plates, usually round or rectangular and of relatively small size, into which the hallmarks of registered metalworkers are stamped with the maker's original stamp. The metal plates were easily transportable, and could be used to validate authenticity of works of gold, silver, and other metals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plaques d'insculpation"@en .

aat:300390924 a skos:Concept ;
    skos:definition "The red-coloured wood of the mahogany gum-tree (Eucalyptus marginata) of West Australia that is strong, hard, reasonably fire-resistant and rot resistant. Known to be used for flooring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jarrah"@en .

aat:300390925 a skos:Concept ;
    skos:definition "A kind of fine stoneware developed by Josiah Wedgwood. White in its natural state, it is stained with metallic oxide colouring agents to achieve shades of pale blue, dark blue, lilac, sage green, black, and yellow, though blue and white ware is most common. Used for cameos, vases, plaques, tableware, furniture mounts, and portrait medallions. The earliest formed was stained integrally and was known as “solid,” Later varieties had surface coloring and were known as “dip.” Decorations, in the Neoclassical style and usually white, were made in separate molds and applied to the body of the piece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jasperware"@en .

aat:300390928 a skos:Concept ;
    skos:definition "Distinctive clothing worn by members of monastic religious orders, by which their membership is typically identified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monastic clothing"@en .

aat:300390929 a skos:Concept ;
    skos:definition "Material comprising the leaf from the tall annual grass cereal plant Zea mays. The leaves have been used as paper and the casing of cigarettes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maize leaf"@en .

aat:300390930 a skos:Concept ;
    skos:definition "Ancient ivory originating from the tusks of extinct mammoths, usually from individuals that are 10,000 years old or older, but preserved in frozen environments. Mammoth ivory was formerly abundant in Siberia; it was exported to China and Europe from medieval times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mammoth ivory"@en .

aat:300390931 a skos:Concept ;
    skos:definition "Double-sided statues of the Virgin Mary in a mandorla, best known in Medieval churches in Germany and the Netherlands. The sculpture is suspended from a vaulted ceiling at the division between the choir and nave. From the Latin adjective meaning \"of Mary.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marianums"@en .

aat:300390933 a skos:Concept ;
    skos:definition "Bobbin lace characterized by a fine twisted-and-plaited ground with solid (usually floral) designs outlined with a flat gimp. It was originally produced at Mechelen, now in Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mechlin bobbin lace"@en .

aat:300390934 a skos:Concept ;
    skos:definition "Rakes of various design, intended to gather and distribute manure, or for clearing debris from ponds or waterways."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muckrakes"@en .

aat:300390936 a skos:Concept ;
    skos:definition "Pieces of parchment inscribed on one side with the required Pentateuchal texts and on the other with the divine name Shaddai, enclosed in a container and attached to the doorpost of a Jewish house in fulfilment of religious law."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezuzahs"@en .

aat:300390937 a skos:Concept ;
    skos:definition "Waste material produced by the process of coal mining, that may include coal gangue found in mining heaps, the light gray, washed waste produced during coal preparation, the red-colored burnt coal gangue caused by pyrite oxidation, and a high percentage of coal itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal mining waste"@en .

aat:300390938 a skos:Concept ;
    skos:definition "Collars worn to signify the status of an acolyte, who is an attendant, assistant, or novice, usually in a ceremonial context, religious order, etc. The collar is distinctive in color and style; it may be worn over another garment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acolyte's collars"@en .

aat:300390939 a skos:Concept ;
    skos:definition "Cover in the liturgical colour of the day that completely covers the Missal stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "missal stand covers"@en .

aat:300390940 a skos:Concept ;
    skos:definition "Ring-shaped extrusions or objects that are positioned below the opening of a bottle or other vessel from which a liquid is poured, on a candlestick or other object, with the purpose of impeding or stopping drips of the liquid from running down the body of the vessel. For drip catchers on candlesticks, use \"bobeches.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drip rings"@en .

aat:300390941 a skos:Concept ;
    skos:definition "Long-handled, paddle-like instruments, usually wooden, metal, or polypropylene, used to stir or rouse beer at various stages of its production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brewer's paddles"@en .

aat:300390942 a skos:Concept ;
    skos:definition "Early modern devices used to mint coins from metal blanks. These consisted of a large screw carrying the die in a holder mounted at its lower end. The screw was operated by workers pulling the weighted end of a long horizontal bar, which descended with great force to hit the blank on the bottom die."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "screw presses"@en .

aat:300390943 a skos:Concept ;
    skos:definition "Tabernacles in Christian churches or chapels that hold the consecrated host and are built into the wall, usually near the main altar, rather than being free-standing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall tabernacles"@en .

aat:300390944 a skos:Concept ;
    skos:definition "Calendars that note the feast days and the anniversaries of Christian saints for each day of the year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calendars of saints"@en .

aat:300390945 a skos:Concept ;
    skos:definition "Christian devotional prints made primarily for wide public distribution, depicting a saint or events in the saint's life. Such prints date from the Middle Ages and later. They were sometimes distributed as mementos for accomplishing a pilgrimage to a sacred site associated with the saint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hagiographic prints"@en .

aat:300390946 a skos:Concept ;
    skos:definition "Short cloaks covering the shoulders and designed to be worn at night, as is required by some religious orders. Such scapulars may be of various designs; an example is joined by bands at the side and has the hood attached to it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nighttime scapulars"@en .

aat:300390947 a skos:Concept ;
    skos:definition "Letters written by young children in Belgium to be read aloud to their parents and other elders on New Year's Day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nieuwjaarsbrieven"@en .

aat:300390948 a skos:Concept ;
    skos:definition "Drinking beakers characterised by small masses of glass, often in the form of round blobs or tear-drop shapes, applied to the body primarily for decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prunted beakers"@en .

aat:300390949 a skos:Concept ;
    skos:definition "Candles designed for use during a novena, which is Christian private or public devotion, special prayer, or service that is observed on nine successive days, or on the same day for nine successive weeks. An example of a novena candle is a thick candle poured into a glass jar, large enough to remain burning for nine days. The jar may be decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novena candles"@en .

aat:300390950 a skos:Concept ;
    skos:definition "Asian wood derived from the genus Palaquium beccarianum. Used variously including the construction of musical instruments, sometimes as a substitute for mahogany wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nyatoh"@en .

aat:300390952 a skos:Concept ;
    skos:definition "Distinctive vessels in certain Protestant churches that are used to contain monetary offerings by the congregation; usually having a slotted lid. Vases of this type were formerly used to contain notes for those receiving communion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offervazen"@en .

aat:300390953 a skos:Concept ;
    skos:definition "Small Japanese ornamental sculptures, displayed in the tokonoma alcove of a traditional Japanese house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "okimonos"@en .

aat:300390954 a skos:Concept ;
    skos:definition "Fancy yarn with a spiral effect obtained by twining a coarse yarn around a much finer and more tightly tensioned core yarn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spiral yarn"@en .

aat:300390955 a skos:Concept ;
    skos:definition "The metal plates or mountings of a scabbard or sheath; particularly those that cover the point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chapes"@en .

aat:300390956 a skos:Concept ;
    skos:definition "Automata that operate by hidden clockwork and play out biblical or other inspirational scenes, often at given times of day; the art form flourished in medieval northern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oordeelspelen"@en .

aat:300390957 a skos:Concept ;
    skos:definition "Distinctive clothing worn by clerics and members of religious orders; the term often refers primarily to Christian religious orders, but it may apply to habits used by any religious group. For the ceremonial garments worn of priests and others officiating at religious rituals, use \"vestments.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "religious habits"@en .

aat:300390958 a skos:Concept ;
    skos:definition "Heraldic devices in the form of a cross, including many varieties; generally belonging to a Christian religious or secular order."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "heraldic crosses"@en .

aat:300390959 a skos:Concept ;
    skos:definition "The identifying mark of an order or congregation, usually worn on special occasions such as a patron's day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "order insignias"@en .

aat:300390960 a skos:Concept ;
    skos:definition "Ordinals, directories, or books of rubrics, specifically annually published guides for the clergy of the Catholic church setting out the Holy Masses and Divine Offices according to the liturgical calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ordos"@en .

aat:300390961 a skos:Concept ;
    skos:definition "Candlesticks designed for the paschal candle. Pascal candlesticks are typically conspicuous and decorative features of the Easter celebration. They may be made of a variety of materials, including metal, wood, or stone; the candlesticks themselves may be of such large and substantial design that they form permanent adjuncts of the ambo or pulpit, rather than being brought out only for the Easter season (although the candlestick would be without the candle outside the Easter season)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paschal candlesticks"@en .

aat:300390962 a skos:Concept ;
    skos:definition "Plant oil extracted from the mesocarp of the fruit of some palms, particularly the West African oil palm (Elaeis guineensis). The outer fleshy portion of the fruit is steamed to destroy the lipolytic enzymes and then pressed to recover the palm oil, which is highly coloured from the presence of carotenes. Palm oil is used in making soaps, candles, and lubricating greases and in processing tinplate and coating iron plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palm oil"@en .

aat:300390964 a skos:Concept ;
    skos:definition "Curved knives used in shoemaking for for taking the lip off the insole and the welt after finishing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plow knives"@en .

aat:300390965 a skos:Concept ;
    skos:definition "Cards entitling the holder to a ration of goods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ration cards"@en .

aat:300390966 a skos:Concept ;
    skos:definition "Boxes or other portable containers formerly used for holding medications to treat ailments or accidents while traveling. For modern portable kits containing medical supplies, prefer \"first aid kits.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel medicine kits"@en .

aat:300390967 a skos:Concept ;
    skos:definition "Decorated panels or more substantial monuments in recognition of or memorial to members of a brotherhood, guild, or other group; often inscribed with their names; typically displayed in a church, guild hall, or other public place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guild monuments"@en .

aat:300390968 a skos:Concept ;
    skos:definition "Registers of the names and information on the members of a brotherhood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brotherhood registers"@en .

aat:300390969 a skos:Concept ;
    skos:definition "Insignia in the form of shields that identify membership in a fraternal organization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brotherhood escutcheons"@en .

aat:300390970 a skos:Concept ;
    skos:definition "Tokens entitling the bearer to a portion of bread; usually minted from non-precious metals. Historically these have been issued at different times for various reasons: examples include bronze tokens issued in ancient Rome to citizens to exchange for 'panis civilis,' and in later times, tokens issued to the needy, for example on the occasion of a person's death, often nobility, at their requiem mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bread tokens"@en .

aat:300390971 a skos:Concept ;
    skos:definition "Wood derived from either of two species in the Guibourtia genus of western Africa; it has a light red, brown, or violet background with evenly spaced pink or purple stripes. The wood is of medium texture and polishes to a high gloss. It is used, often as veneer, for cabinets, pianos, other furniture, and for smaller decorative items such as handles and boxes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bubinga"@en .

aat:300390973 a skos:Concept ;
    skos:definition "Stands or racks designed to store collection bags or other receptacles that are used to gather offertory gifts in churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offertory bag stands"@en .

aat:300390974 a skos:Concept ;
    skos:definition "Metal receptacles of a standardized volume, sealable and suitable for re-use, designed to be stacked and secured together for shipping. These are suited to various modes of transport including marine, railroad, and trucking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "intermodal containers"@en .

aat:300390975 a skos:Concept ;
    skos:definition "A mass made from flour or meal moistened and kneaded into a paste, which forms the raw material for various types of baked goods such as bread or pastry. Dough may be leavened or unleavened."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough"@en .

aat:300390976 a skos:Concept ;
    skos:definition "Implements of various design having sharp-edged wheels attached to handles, used to cut rolled-out dough."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dough wheels"@en .

aat:300390978 a skos:Concept ;
    skos:definition "Tools used for thatching, primarily in northern European traditions, combining features of a hay knife and a thatching crook. These tools comprise a handle from which extends a flat, blade-like metal piece having a hook on one end and a blunt or pointed tip on the other end, with a number of broad teeth between. The tool is used during the process of securing crosspieces to the courses of thatch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roofer's crooks"@en .

aat:300390980 a skos:Concept ;
    skos:definition "Timetables listing the arrival and departure schedules, routes, and names of the stops for a transportation service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation timetables"@en .

aat:300390981 a skos:Concept ;
    skos:definition "Instruments for estimating the percentage of butter fat in milk. The instrument comprises a cylindrical bottle that tapers off at one end to a graduated tube with a conical bulb termination. It is often used with instruments gauging the purity of milk, \"lactometers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butyrometers"@en .

aat:300390982 a skos:Concept ;
    skos:definition "Formerly, the term referred to a non-crystalline or fibrous form of apatite. In current usage, it is a general term referring to any sedimentary rock containing a high proportion of calcium phosphate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphorite"@en .

aat:300390984 a skos:Concept ;
    skos:definition "Decorative discs that are baked into or otherwise affixed to baked goods; today typically limited to cakes for children, particularly in the southern Netherlands, but formerly also in Britain and elsewhere. Patakons were formerly ceramic, now may be edible. The tradition probably derived from an original practice of placing a coin in the baked item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patakons"@en .

aat:300390985 a skos:Concept ;
    skos:definition "Packaging comprising pieces of paper shaped like a cone, and twisted at the apex; used for packaging small goods such as candy or nuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cornets"@en .

aat:300390986 a skos:Concept ;
    skos:definition "Pieces of hardware, usually metal, that form a right angle and are used to secure or reinforce the corners of a picture frame, a window frame, furniture, or other object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "corner braces"@en .

aat:300390987 a skos:Concept ;
    skos:definition "Coupon that is exchanged for a specific product that is in short supply, often food or fuel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ration coupons"@en .

aat:300390988 a skos:Concept ;
    skos:definition "Chasubles, which are sleeveless outer ecclesiastical vestments, that are designed for travel. Examples include lightweight, unlined chasubles and chasubles that are reversible in two different liturgical colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "travel chasubles"@en .

aat:300390989 a skos:Concept ;
    skos:definition "Calculating devices of the slide rule type, but having a circular rather than straight form; they comprise disks that form circular scales located in one plane."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circular slide rules"@en .

aat:300390990 a skos:Concept ;
    skos:definition "Reliquaries representing the saint whose relics are contained within, made in the form of a bust, which is a representation of only the head and shoulders of a human figure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reliquary busts"@en .

aat:300390991 a skos:Concept ;
    skos:definition "Cabinets of relics that are divided into days, weeks, and months with relics of a saint, martyr, deity, or other holy person mounted or displayed within."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calendars of relics"@en .

aat:300390992 a skos:Concept ;
    skos:definition "Tools for cocking the mechanism of wheel lock pistols."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wheel lock keys"@en .

aat:300390993 a skos:Concept ;
    skos:definition "Generally, the Christian sacrament in which the bread and wine are consecrated. The belief surrounding the nature of the sacrament differs in various denominations: for example, the Baptist view is memorialism, the Reformed view is spiritual presence, the Lutheran view is consubstantiation, and the Roman Catholic view is transubstantiation. Specifically, the term is often used to distinguish Protestant liturgies from the Catholic mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lord's Suppers"@en .

aat:300390994 a skos:Concept ;
    skos:definition "Crowns that appear at the four corners or surmounting the peaks of baldachins. These may be portable or permanently fixed, and may be ornamented in various ways, often with ostrich feathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baldachin crowns"@en .

aat:300390996 a skos:Concept ;
    skos:definition "Bells that are used in a carillon, which is a set of stationary hanging bells. Carillon bells are typically cast bronze, thick sided, cup-shaped bells, which are serially played to produce a melody, or sounded together to play a chord. They are typically played with a keyboard, by which keys mechanically activate levers and wires that connect to metal clappers that strike the inside of the bells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carillon bells"@en .

aat:300390997 a skos:Concept ;
    skos:definition "Hammers comprising heavy iron or wooden blocks that are lifted by hand or with a mechanized pile driver to drive piles, which are columns serving as subsurface supports for vertical loads, into the earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pile hammers"@en .

aat:300390999 a skos:Concept ;
    skos:definition "Fenders comprising wooden beams, cables, inflatable rubber, or another material that are hung along the outside of a boat or ship to protect against damage when docking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ship fenders"@en .

aat:300391000 a skos:Concept ;
    skos:definition "Corporal punishment whips or scourges consisting of narrow straps or ropes, often tied at the end with buttons, lead pellets, or iron nails. For similar devices having nine straps, use \"cat-o'-nine-tails.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knouts"@en .

aat:300391001 a skos:Concept ;
    skos:definition "Instruments for execution by beheading. They operate by means of a heavy blade falling between two grooved posts. These were used particularly during the French Revolution, but also in Belgium, Germany, Sweden and some Swiss cantons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guillotines"@en .

aat:300391002 a skos:Concept ;
    skos:definition "Simple vices, sometimes with protruding studs on the interior surfaces, designed as a torture instrument. The victim's thumbs or fingers were placed in the vice and slowly crushed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thumbscrews"@en .

aat:300391003 a skos:Concept ;
    skos:definition "Works, in any medium, in which the primary or only subject is the human figure or figures. Used especially when no other iconography is depicted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "figure works"@en .

aat:300391004 a skos:Concept ;
    skos:definition "Distinctive women's headgear unique to the Netherlands. The earliest forms comprised simple iron bands holding lace caps in place. Later versions were more decorative; by the 19th century they had become elaborate headdresses often made of gold and worn over an under cap. The style indicated the province of origin and social status of the wearer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oorijzers"@en .

aat:300391006 a skos:Concept ;
    skos:definition "Military uniform coats that are typically mid-hip-length and designed to fit under an overcoat if necessary; usually single-breasted and often belted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service coats"@en .

aat:300391007 a skos:Concept ;
    skos:definition "Jackets that formed part of the military costume of the hussars, between hip and knee length. The jackets were decorated with five rows of braid frogging, looped into rosettes at the ends, with toggle closures incorporated into the frogging. Matching piping adorned the collar, front edge, bottom hem, back seams, and rear skirts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attilas"@en .

aat:300391008 a skos:Concept ;
    skos:definition "Goggles for protecting eyes and face against explosions. First developed in World War I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballistic eyewear"@en .

aat:300391010 a skos:Concept ;
    skos:definition "Hats of various designs made of bamboo strips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bamboo hats"@en .

aat:300391011 a skos:Concept ;
    skos:definition "Badges won on military headgear, often as regiment insignia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap badges"@en .

aat:300391012 a skos:Concept ;
    skos:definition "Plastic protective helmets usually outfitted with a face shield and provisions for a gas mask."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riot helmets"@en .

aat:300391013 a skos:Concept ;
    skos:definition "Liners for helmets that create a web-based system to create a small amount of space to absorb energy and separate the interior shell of the helmet and the wearer's head; typically comprising intersecting straps and a headband that rest directly on the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "web suspension"@en .

aat:300391015 a skos:Concept ;
    skos:definition "Short uniform jackets designed to be worn under military jackets or coats, or worn alone when the outer jacket is not necessary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field jacket liners"@en .

aat:300391016 a skos:Concept ;
    skos:definition "Trousers worn as an extra layer of clothing made of waterproof or other protective material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overtrousers"@en .

aat:300391017 a skos:Concept ;
    skos:definition "Decorations in the form of charges or devices consisting of a bar bent like two meeting rafters; multiple chevrons may be grouped together, forming inverted V-shaped stripes. Examples occur on heraldic escutcheons and as worn on the sleeve of a uniform to indicate rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chevrons"@en .

aat:300391019 a skos:Concept ;
    skos:definition "Uniform jackets of the Hussars, with heavily braided front openings. These were lighter jackets worn under the heavier fur-lined pelisse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dolmans"@en .

aat:300391020 a skos:Concept ;
    skos:definition "Tall metal or leather helmets worn by cavalry soldiers, with combs surmounted by pompons or tails made of various materials such as horsehair, and front and rear visors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dragoon helmets"@en .

aat:300391021 a skos:Concept ;
    skos:definition "Eyewear that protected the eyes from gas and other irritant agents; developed during WWI. Following the introduction of the Small Box Respirator, anti-gas goggles were considered obsolete and their use declined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anti-gas goggles"@en .

aat:300391022 a skos:Concept ;
    skos:definition "Face veils having camouflage pattern. Examples are military-issued netting used by soldiers to hide the face and keep insects out of the eyes and nose; these were intended to be worn over the helmet to cover the face, respirator, and gas cape. Other examples are used by hunters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "camouflage face veils"@en .

aat:300391023 a skos:Concept ;
    skos:definition "In modern warfare, helmets for military use, especially those intended for the battlefield. Originally of metal, today also of Kevlar; usually provided with a suspension system or liner and chin strap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combat helmets"@en .

aat:300391024 a skos:Concept ;
    skos:definition "Special rucksacks designed to be worn into combat and outfitted to carry basic supplies and equipment, especially pre 19th century, made of stiff material, with a waist belt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "combat rucksacks"@en .

aat:300391025 a skos:Concept ;
    skos:definition "Miter-shaped military headgear, tall, and with a pointed top, originally worn by grenadiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grenadier miters"@en .

aat:300391028 a skos:Concept ;
    skos:definition "Coarse camouflage nets worn over helmets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helmet nets"@en .

aat:300391029 a skos:Concept ;
    skos:definition "Military uniform service coats intended for wear in warm climates, having short or long sleeves and of a breathable fabric such as linen or cotton."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tropical service coats"@en .

aat:300391030 a skos:Concept ;
    skos:definition "Detachable shoulder straps for military rucksacks or haversacks. Often with hooks for attaching cartridge pouches and fitted with cinch buckles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "L-straps"@en .

aat:300391032 a skos:Concept ;
    skos:definition "Crash helmets that completely enclose the head, and that usually have transparent full-face visors; especially worn by motorcycle riders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-face helmets"@en .

aat:300391033 a skos:Concept ;
    skos:definition "Military decoration of an orange and blue lanyard presented to Dutch soldiers of the Princess Irene Brigade who took part in the Normandy landing in 1944: also worn by the Dutch Fusiliers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "invasiekoorden"@en .

aat:300391034 a skos:Concept ;
    skos:definition "Cases or bags for keeping maps, often in the context of military campaigns, but also used by travelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "map cases"@en .

aat:300391035 a skos:Concept ;
    skos:definition "Colored tabs attached to both sides of collars to distinguish military function or rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorget patches"@en .

aat:300391036 a skos:Concept ;
    skos:definition "Overcoats with hoods made of duffle (woollen cloth with a thick nap) and with toggle fastenings. Made famous by the British General Montgomery in World War II, so also known as 'monty coats'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duffle coats"@en .

aat:300391037 a skos:Concept ;
    skos:definition "Goggles worn by motorcycle riders to prevent dust, debris, or liquid from entering the eyes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motorcycle goggles"@en .

aat:300391038 a skos:Concept ;
    skos:definition "Waistcoats that are woven, usually woolen, and that open the full length of the center front. An example is the short woollen waistcoat with sleeves, formerly part of the garrison uniform worn by U.S. and British troops ca. WWI."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cardigan waistcoats"@en .

aat:300391039 a skos:Concept ;
    skos:definition "Knitted wool cylinders that are pulled over the head and fashioned into caps by rolling up one end of the tube. Cap comforters evolved from informal British military headgear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cap comforters"@en .

aat:300391040 a skos:Concept ;
    skos:definition "Sturdy panels or flaps attached to headwear to protect the neck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck protectors"@en .

aat:300391042 a skos:Concept ;
    skos:definition "Neck-scarves worn with combat uniforms or service uniforms. Square or rectangular shape with closures at the back of the neck. Often in a regimental color with its emblem placed centrally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bib scarves"@en .

aat:300391043 a skos:Concept ;
    skos:definition "Pants worn over another pair to protect them, or to provide protection to the wearer from extreme cold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overpants"@en .

aat:300391044 a skos:Concept ;
    skos:definition "Mittens worn over thinner mittens or gloves as extra protection for extreme weather conditions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "over-mittens"@en .

aat:300391045 a skos:Concept ;
    skos:definition "Helmets created for ceremonial use, often richly decorated with requirements for battle subordinated to purposes of display, but in form similar to those used in combat. Usage is particularly applied to objects created during the Renaissance that were meant to evoke classical antiquity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parade helmets"@en .

aat:300391046 a skos:Concept ;
    skos:definition "Helmets worn by parachutists; of metal with a liner system and chin strap. Often similar in appearance to the combat helmet, but with an extra liner system behind the head and an extra chin piece on the chinstrap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "para helmets"@en .

aat:300391048 a skos:Concept ;
    skos:definition "German spiked helmets before and early during WWI. They were made ​​of pressed leather, pressed horsehair, or metal. A metal spike or sphere was mounted on the top of the helmet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickelhaubes"@en .

aat:300391049 a skos:Concept ;
    skos:definition "Headwear with a stiff visor at a right angle to the forehead. The crown is wider than the head. The shape is held by internal stiff support material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "peaked caps"@en .

aat:300391050 a skos:Concept ;
    skos:definition "Helmets of varied design worn by those who are charged with law enforcement and crime prevention. These usually incorporate emblems or decals to indicate police use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police helmets"@en .

aat:300391052 a skos:Concept ;
    skos:definition "Jackets of various design meant to be worn while mounted on horseback."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "riding jackets"@en .

aat:300391053 a skos:Concept ;
    skos:definition "Fabric sleeves slipped over shoulder straps on military uniforms that bear insignias of rank or service division. For similar objects made of stiffened material, use 'shoulder boards.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoulder marks"@en .

aat:300391054 a skos:Concept ;
    skos:definition "Military caps having a distinctive square plate on the crown. Originally Polish, the style was later adopted by other European armies, including that of Napoleon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "czapki"@en .

aat:300391055 a skos:Concept ;
    skos:definition "Goggles designed especially for use while skiing to protect the eyes from glare and wind."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ski goggles"@en .

aat:300391056 a skos:Concept ;
    skos:definition "Straps for securing helmets or hats under the chin. For ribbons or strings used to tie on hats under the chin, particularly when they are decorative, use \"chin ties.\" For bands of cloth or another material tied around the top of the head and under the chin, use \"chin bands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chin straps"@en .

aat:300391057 a skos:Concept ;
    skos:definition "Low, folding fur caps made of astrakhan fleece, worn by artillery regiments and others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rifle busbies"@en .

aat:300391058 a skos:Concept ;
    skos:definition "Protective headwear for tank crews, in a variety of designs since the advent of the tank as a modern war machine during WWI. Meant to protect against bumps and projectiles; more recent versions are provided with fixtures for the attachment of communication devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tank helmets"@en .

aat:300391060 a skos:Concept ;
    skos:definition "Short uniform jackets, distinguished by a particular breast panel and cut. First worn by lancers in the First French Republic and used in various countries until World War I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kurtkas"@en .

aat:300391061 a skos:Concept ;
    skos:definition "Brimless, close fitting headwear with peak; made of fabric, often khaki-coloured. Worn in the field in addition to the helmet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field caps"@en .

aat:300391062 a skos:Concept ;
    skos:definition "Goggles of various form designed for the use of pilots or flight crews, usually in a military context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flying goggles"@en .

aat:300391063 a skos:Concept ;
    skos:definition "Sunglasses designed with a wire frame and large lenses, similar in shape to those worn by early aviators to accommodate face masks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aviator sunglasses"@en .

aat:300391064 a skos:Concept ;
    skos:definition "Protective helmets for the benefit of fighter pilots. From the advent of jet aircraft these have been equipped with visors and provisions for communications, breathing, or other equipment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flight helmets"@en .

aat:300391065 a skos:Concept ;
    skos:definition "Thick, heavy cloaks or coats worn by seamen, soldiers, or watchmen when on duty in bad weather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watch-coats"@en .

aat:300391066 a skos:Concept ;
    skos:definition "Masks fitting over the nose and mouth through which oxygen or oxygen-enriched air is supplied."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxygen masks"@en .

aat:300391068 a skos:Concept ;
    skos:definition "Ornamental braid or lacing of various patterns in gold and silver, used to trim coats, particularly elements of uniforms. For similar trimming material with scalloped edges, use \"galloon.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "orris lace"@en .

aat:300391077 a skos:Concept ;
    skos:definition "Machines capable of automatically carrying out a complex series of movements, especially one that is programmable. In historical usage, as depicted in science fiction, inspired by the mass-produced workers in a play by Karel Čapek, robots were intelligent artificial beings typically made of metal and resembling in some way a human or other animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robots"@en .

aat:300391078 a skos:Concept ;
    skos:definition "Ewers used for ritual ablution, for example in Jewish, Christian, and Islamic rites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablution ewers"@en .

aat:300391079 a skos:Concept ;
    skos:definition "Chalices used in some Christian rites for ablution or rinsing; the ablution chalice holds unconsecrated wine or water, which is used after the eucharistic ceremony to rinse away the remains of the consecrated host."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablution chalices"@en .

aat:300391080 a skos:Concept ;
    skos:definition "Prayers that are associated with donning official priestly vestments or transfer of vestments, most commonly in Christian contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vesting prayers"@en .

aat:300391081 a skos:Concept ;
    skos:definition "Small lidded vessels, almost always cup-shaped and sometimes having handles, used to wash the celebrant's fingers in the context of a Christian communion service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablution cups"@en .

aat:300391082 a skos:Concept ;
    skos:definition "Candleholders, usually in a circular arrangement, designed to hold the four or five candles that are lit successively on the four Advent Sundays before Christmas, with the optional fifth candle lit on Christmas Eve. Advent candleholders may be decorative items in themselves, or concealed within an Advent wreath."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Advent candleholders"@en .

aat:300391083 a skos:Concept ;
    skos:definition "Candlesticks designed to stand on an altar, especially as used on the altars of Christian churches. Use of candles in the context of Christian liturgies is first documented in the tenth century, when acolytes carried candlesticks to the altar, but placed them on the floor of the sanctuary or near the corners of the altar, as is still the custom in the Eastern Church. Candlesticks designed to be placed on the altar typically include five parts: the foot, the stem, the knob about the middle of the stem, the bowl to receive the drippings of wax, and the pricket on which the candle is fixed. Altars typically have two candlesticks, placed on either side of a crucifix. However, sets of altar candlesticks may comprise two, four, or six identically designed candlesticks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar candlesticks"@en .

aat:300391085 a skos:Concept ;
    skos:definition "Sets of steps used to provide access to an altar; particularly as used with altars in a temple or church. They may be permanent steps or a portable set of steps. The uppermost step is often decorated. The number of steps varies, but for symbolic reasons is typically an uneven number, usually three, five, or seven, including the upper platform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar steps"@en .

aat:300391086 a skos:Concept ;
    skos:definition "Curtains hung around the altar, particularly in a temple or church. They were hung in front of, or to close off the sides of, an altar during the service. As with rood screens, altar veils were liturgical barriers marking the boundaries between the congregation's space and the holy of holies; the Lenten veil is a type of altar veil, used in Catholic and other churches in the season prior to Easter. Beginning in the early days of the Reformation, altar vela began to be used in certain Protestant churches during the entire liturgical year. In some cases, altar veils may be associated with the \"altar canopy.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar veils"@en .

aat:300391087 a skos:Concept ;
    skos:definition "Small implements to grip pieces of cheese, comprising discs, often decorative and silver, with spikes on the bottom."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cheese grips"@en .

aat:300391088 a skos:Concept ;
    skos:definition "Tags of metal or plastic, attached to the collar of a dog and containing information such as his owner's contact information and verification of the licensing of the dog."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dog tags"@en .

aat:300391089 a skos:Concept ;
    skos:definition "The processing of flax, hemp, cotton, or another fiber by separating the fine fibers from the impurities such as the seeds, straw, and woody stems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fiber scutching"@en .

aat:300391090 a skos:Concept ;
    skos:definition "Persons trained in the feudal Japanese art of ninjutsu or a modern equivalent. Collectively, a mercenary force that specialized in spying and executing attacks. Originally these agents had differing names in each region of Japan based on tasks they performed. In most historical Japanese texts they are referred to as 'shinobi'."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ninjas"@en .

aat:300391091 a skos:Concept ;
    skos:definition "Hydrometers for the determination of the alcoholic content expressed in Gay-Lussac degrees. The device was invented by French physicist and chemist Louis Gay-Lussac."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gay-Lussac alcoholometers"@en .

aat:300391092 a skos:Concept ;
    skos:definition "Small hand-held bells placed on or near the altar in a religious service or for a funerary altar. Altar bells may be attached to a wooden or other handle, or the handle may be cast as a piece with the bell. The device typically accommodates one or two small bells. An example of such devices is on Christian altars after the 8th century, but similar bells were known in ancient Babylonia, ancient Egypt, Jewish temples, the altars of the Romans and Greeks, and in cultures in Africa, China, and Hindustan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar bells"@en .

aat:300391093 a skos:Concept ;
    skos:definition "Distinctive chests, often portable, designed for the altar to be collapsible or otherwise fit into a chest, along with the other essential items required for the liturgy. The term may also apply to chests associated with a separate altar, whether or not they are portable or were intended to be hidden. Well-known examples of collapsible portable altar chests, intended to be hidden, were those used in northern Europe in the 17th-18th centuries, during times of prohibition of the celebration of Catholic Mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar chests"@en .

aat:300391094 a skos:Concept ;
    skos:definition "Cushioned steps or detached cushions for the step located in front of or around an altar, used at a Mass or other Christian service. An example of usage is by kneeling acolytes, deacons, and sub-deacons during solemn segments of the worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar kneelers"@en .

aat:300391096 a skos:Concept ;
    skos:definition "In the context of Christian churches, guards, usually comprising a wooden or metal strip, used to protect the altar frontal from injury or wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antependium guards"@en .

aat:300391097 a skos:Concept ;
    skos:definition "Bells used in Christian services to mark the most important parts of the service, the eucharistic celebration. Sanctus gongs are located on or near the altar; they have a louder, deeper tone than altar bells, and are often struck with a mallet from the outside rather than with a clapper on the inside of the bell. In modern services, the altar bells are often used universally for all alerts during the Mass rather than using different bells for different purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanctus gongs"@en .

aat:300391098 a skos:Concept ;
    skos:definition "Sets of particular items designed to fit together, comprising a tray and two or more ampullae, which are small bottles or flasks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ampullae sets"@en .

aat:300391099 a skos:Concept ;
    skos:definition "Sliding rattles found in Indonesia. They are constructed from bamboo tubes with cut-back tongues, inserted into a frame; when the frame is shaken, the tubes slide back and forth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "angklungs"@en .

aat:300391100 a skos:Concept ;
    skos:definition "Wands or small rods used in a ritual, such as a coronation, or a religious sacrament to anoint a person with sacred oil or chrism. Depending upon the rules of the various rites, anointing wands may be made of simple wood or they may be more decorative, made of precious materials. The practice was known from ancient times. In modern contexts, anointing wands are used most commonly to anoint a sick or dying person in Christian rites. In some rites of the Eastern church, seven cotton-wrapped wands are used to anoint the sick or dying. In Western rites, although the anointing is usually done using the thumb, anointing rods may be used in certain circumstances, such as for the anointing of the sick with contagious diseases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anointing wands"@en .

aat:300391102 a skos:Concept ;
    skos:definition "Devices used to secure a metal cap-like plate with pins, which is typically marked with the identify of the vinyard or other information, over the bung of a wine barrel so that it is sealed and ready for transport. The device is usually spring-loaded."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "label presses"@en .

aat:300391103 a skos:Concept ;
    skos:definition "Books containing the rites and ceremonies to be observed at the Catholic mass, vespers, and other functions, by bishops and prelates of inferior rank, in metropolitan, cathedral, and collegiate churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caeremonial episcopora"@en .

aat:300391104 a skos:Concept ;
    skos:definition "Cloths or clothing, usually white, worn to cover the chrism, which is a holy material comprising oil and balsam, used in various rituals and sacraments, especially Christian baptism. Examples includes white strips of fabric or cloths wrapped around the heads of the newly baptized, over the place where the chrism had been applied. Other examples are long white-hooded robes in which the newly-baptized were clothed for several weeks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrismales"@en .

aat:300391105 a skos:Concept ;
    skos:definition "Containers for the chrism and consecrated oil used in Christian ritual. The term usually refers to vessels, either having one containing unit or, in some designs, having three flasks, for the oil for baptism, confirmation, and anointing of the sick. The term is also used for a small container or opening built into the interior church architecture, where the consecrated oil is stored."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrismatories"@en .

aat:300391106 a skos:Concept ;
    skos:definition "Coverings made of cloth, generally of precious material and decorated, designed to cover the ciborium, which is a vessel for the Christian eucharistic bread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ciborium veils"@en .

aat:300391107 a skos:Concept ;
    skos:definition "Mills that employ cylinders or are in the shape of a cylinder. Examples include cylindrical containers built to varying length-to-diameter ratios and are partially filled with flint stones, iron or steel balls, or other grinding bodies that tumble under the influence of gravity by revolving the container. Other examples include devices that grind grain or other materials by means of two counter-rotating roughened cylinders turning at different speeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cylinder mills"@en .

aat:300391108 a skos:Concept ;
    skos:definition "Bobbin lace with continuous threads decorated with geometric motifs. Inspired by 17th century Genoese bobbin lace, Cluny has become one of the most widely produced hand-made laces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cluny bobbin lace"@en .

aat:300391109 a skos:Concept ;
    skos:definition "Hard, shiny, tear-shaped seeds of a tropical grass; the seeds are sometimes used for jewelry or rosaries. The seed kernel is edible, and varieties are used as food product in parts of East Asia and in the Philippines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Job's tears"@en .

aat:300391110 a skos:Concept ;
    skos:definition "In the Netherlands, distinctive uniforms or clothing worn by those who collect for charities or in churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectantenkleding"@en .

aat:300391111 a skos:Concept ;
    skos:definition "In Christian churches or places of other religious services, stands or tables used for the collection plate or other offertory gifts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offertory tables"@en .

aat:300391112 a skos:Concept ;
    skos:definition "Collection bags, baskets, or other containers placed on one end of a long handle, typically used to allow the attendant in a religious service or other such event to reach the collection receptacle deep into the row to access participants further from the aisles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collection receptacles with handle"@en .

aat:300391114 a skos:Concept ;
    skos:definition "In the Netherlands, distinctive bags by which offertory money from churches is transported. For the bags used to collect the money, use \"collection bags.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectetassen"@en .

aat:300391115 a skos:Concept ;
    skos:definition "In churches in the Netherlands, distinctive funnels used for transferring the collection money into bags or boxes"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collectetrechters"@en .

aat:300391116 a skos:Concept ;
    skos:definition "Bags used to collect money, often made of cloth or leather, usually mounted on a support having handles; a primary example is in collecting money from members of the congregation during religious services."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collection bags"@en .

aat:300391117 a skos:Concept ;
    skos:definition "Printed cards used in several Christian denominations, either given by a minister or deacon to identify those of proper status in the church to receive the eucharist, or given at the time of a person's first communion, serving as both documentation of the event and as a commemorative token."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion cards"@en .

aat:300391118 a skos:Concept ;
    skos:definition "Church registers used by various Christian denominations to record the names of people and dates when they have received the eucharist for various reasons, such as for an annual obligation or at the time of death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion registers"@en .

aat:300391119 a skos:Concept ;
    skos:definition "Dishes or shallow or deeper bowls used to hold the consecrated hosts during their distribution during the Christian liturgy. This bowl or dish is used for the distribution of communion in place of a ciborium. For bowls, often two-handled, used to hold consecrated wine, use \"communion bowls (vessels for wine).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion dishes"@en .

aat:300391120 a skos:Concept ;
    skos:definition "Place settings or other combinations of cups, saucers, and plates that were given as a traditional gift on the occasion of a person's first solemn communion, which was a rite of passage among young adults in some Christian denominations. The items are typically made of porcelain or silver. The dishes are distinguished by decoration or text commemorating the event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion services"@en .

aat:300391121 a skos:Concept ;
    skos:definition "Ribbons or sashes, usually white in color and tied in a bow, formerly worn by both boys and girls in some Christian churches when they received their first communion or their solemn communion. The item was often retained as a souvenir of the event. Where this practice is continued today, the bow is often smaller and attached to a sleeve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion ribbons"@en .

aat:300391122 a skos:Concept ;
    skos:definition "General term for all ornamental canopy-like coverings of cloth, stone, wood, or metal used in a Christian church, such as to crown an altar, tabernacle, throne, pulpit, or statue. Examples are the structure covering an altar, formerly fitted with curtains and supported on four pillars; the covering suspended over the throne occupied by dignitaries of the Church or princes; the covering under which the Blessed Sacrament is sometimes borne in processions; or the parasol-like object sometimes placed on the north side of the altar in a stand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conopea"@en .

aat:300391124 a skos:Concept ;
    skos:definition "Small vessels, in which a sacred object is kept or carried; particularly in the Christian Church, a vessel or box used for holding or carrying the Eucharist, such as a pyx or ciborium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "custodes"@en .

aat:300391125 a skos:Concept ;
    skos:definition "Devices comprising a timber or other narrow surface that is suspended by a rope or attached by hooks to a roof that is being thatched, to serve as a platform or foothold for the thatcher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thatching horses"@en .

aat:300391126 a skos:Concept ;
    skos:definition "Christian religious articles comprising a string of 10 or more beads woven in a ladder-like formation to allow a bead to be slid up and down the string to count sacrifices, good deeds, and prayers throughout the day. The string typically has a medal of St. Therese on one end and a crucifix on the other; modern sacrifice beads may be in the form of a bracelet. According to tradition, the beads originated in the childhood of St. Therese of Lisieux, who was said to have used a string of prayer beads for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacrifice beads"@en .

aat:300391127 a skos:Concept ;
    skos:definition "Special lamps that are lit with the intention of expressing devotion for a religious purpose. Devotional lamps have existed since ancient times; they are found in many cultures, including in Hinduism, Judaism, and Christianity. Examples are lamps that burn before images or statues in Christian churches. To distinguish lamps lit specifically in recognition of a vow, prayer, or desire, use \"votive lamps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional lamps"@en .

aat:300391128 a skos:Concept ;
    skos:definition "Medals having a religious or devotional subject, found in Christian and other religious contexts; often having a loop to allow the medal to be worn on a necklace or otherwise attached to clothing. To specifically distinguish small medals without a loop, intended to be carried in a pocket or pouch, use \"devotional tokens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional medals"@en .

aat:300391129 a skos:Concept ;
    skos:definition "Small items, often in the form of a disk or resembling a coin, having a religious or devotional subject imprinted, carved, cast, or otherwise marked upon them. They are found in Ancient, Christian, Hindu, and other religious contexts. The tokens may be considered holy in themselves, conferring luck or grace upon those who carry them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional tokens"@en .

aat:300391130 a skos:Concept ;
    skos:definition "Relatively small plaques or plates, made of any material and having a devotional image as the subject; often having a loop or pierced holes to allow attachment to a wall or object. Devotional plaques are common in Christian, Hindu, Buddhist, and other religious contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional plaques"@en .

aat:300391131 a skos:Concept ;
    skos:definition "Pendants, brooches, or any other jewelry that has as a primary focus a devotional or religious subject or theme. Devotional jewelry has been common since ancient times, and is known in many religions, including Hinduism and Christianity. Wearing of devotional jewelry may be thought to convey blessings, health, or good luck."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devotional jewelry"@en .

aat:300391132 a skos:Concept ;
    skos:definition "Medical or surgical instruments used to dilate or distend an opening, passage, or organ of the body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dilators"@en .

aat:300391133 a skos:Concept ;
    skos:definition "One of the long bars between a pair of which an animal is harnessed to a carriage or other vehicle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shafts"@en .

aat:300391135 a skos:Concept ;
    skos:definition "Plates, usually metal and either discs or rectangular in shape, decorated or inscribed, and surmounted on a pole to be used in sports shooting as a target pointer, an indicator of where the marksman was to stand, and to be carried in processions of archery or shooting clubs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shooting marks"@en .

aat:300391136 a skos:Concept ;
    skos:definition "Sunken pools or above-ground tubs designed and used for Christian baptism by immersion. The earliest examples resemble Jewish mikveh pools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal baths"@en .

aat:300391137 a skos:Concept ;
    skos:definition "Decorative cups presented to infants or their parents on the occasion of their baptism or christening; often of silver or other precious material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening cups"@en .

aat:300391138 a skos:Concept ;
    skos:definition "Small cloaks covering the shoulders of the child or adult being baptized; often decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal scapulars"@en .

aat:300391139 a skos:Concept ;
    skos:definition "Vessels in the shape of a scallop shell, either a natural shell or a shell-shaped dish of metal, often precious metal. They are used to scoop and pour the baptismal water over the head of the baptized, usually over a baptismal basin or baptismal font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal shells"@en .

aat:300391140 a skos:Concept ;
    skos:definition "Plates commemorating a child's baptism or christening, of metal or ceramic and often having decorations or an inscription. Examples would be particular types of plates of brass, ceramic, or tin that were common in the 17th-18th centuries in Gelderland, the Netherlands; these plates were sometimes used as offertory plates for well-wishers of the child, often given by the godparents to commemorate the baptism. The tradition grew, in part, out of the earlier tradition of the \"birth trays.\" Modern christening plates may be both commemorative and utilitarian, used by the child to hold food for consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening plates"@en .

aat:300391141 a skos:Concept ;
    skos:definition "Syringes having an extended tube for intrauterine administration of holy water, refined in the 19th century. The devices were used to baptize a fetus in utero prior to a spontaneous abortion, or when it was othewise feared the unborn infant would die in delivery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal syringes"@en .

aat:300391142 a skos:Concept ;
    skos:definition "Annular objects used to stabilize objects on the head when carrying them, often made from cloth or reed material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ring-pads"@en .

aat:300391143 a skos:Concept ;
    skos:definition "Tabernacles in Christian churches having multiple compartments or niches, usually two or three, each of which can be revealed or brought forward using a rotating device. The compartments typically could hold a monstrance, a ciborium, and a crucifix; the niches could be highly decorated. Rotating tabernacles were considered mechanical marvels, and were relatively rare, most common in 18th-century northern European Roman Catholic churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotating tabernacles"@en .

aat:300391144 a skos:Concept ;
    skos:definition "Crown-sized silver coins struck in the 16th through the 18th centuries. The term is extended to the \"silver rider\" coins struck as currency in the United Netherlands from 1659."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ducatoons"@en .

aat:300391145 a skos:Concept ;
    skos:definition "Flutes with two finger holes and one thumbhole. Usually played in tandem with a drum. A full diatonic scale could be achieved by over-blowing and many folk tunes and dances were thus playable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "one-hand flutes"@en .

aat:300391146 a skos:Concept ;
    skos:definition "Millinery tools consisting of cast-iron, egg-shaped balls of various sizes mounted on metal shanks and fixed to a short wooden handle. Used to iron the inside of convex surfaces on bonnets, sleeves, bows, or waistbands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "egg irons"@en .

aat:300391149 a skos:Concept ;
    skos:definition "Containers in Christian churches, made in the form of a dove and designed to be hung by chains over the altar. They had a door, sometimes hidden under a wing or on the back, that concealed a small cavity once used to hold the eucharistic bread. Eucharistic doves were formerly part of the standard liturgical furnishings for churches that could afford them. They were typically made of gold, silver, or another metal with enamelwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eucharistic doves"@en .

aat:300391150 a skos:Concept ;
    skos:definition "Liturgical objects in the form of small lances or spears, used in the Greek Church used in the preparatory rite of prothesis, during which the host is separated from a loaf before consecration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liturgical lances"@en .

aat:300391151 a skos:Concept ;
    skos:definition "Poles to which people, judicially condemned or not, are bound and then executed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "execution poles"@en .

aat:300391152 a skos:Concept ;
    skos:definition "Tubes of various dimensions used to dispense consecrated wine, or wine and bread, at communion. Used occasionally up until the sixteenth century; use contintued by the Pope and his deacons up until the Second Vatican Council (1962-1965) during papal Masses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fistulae"@en .

aat:300391153 a skos:Concept ;
    skos:definition "Lanterns used in processions; often comprising a glass-enclosed vessel with a candle or other light within, mounted upon a pole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional lanterns"@en .

aat:300391154 a skos:Concept ;
    skos:definition "Badges or plaques, often metal, attached to the pole of a processional lantern, bearing the heraldic device or other emblem to identify the participants in the procession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lantern badges"@en .

aat:300391155 a skos:Concept ;
    skos:definition "Boards covered with flannel or felt on which images or cut-out figures can be attached as a teaching aid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flannelgraphs"@en .

aat:300391158 a skos:Concept ;
    skos:definition "Flags or banners on which prayers are inscribed. Prominent examples are known in Buddhist practice, especially in Tibet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayer flags"@en .

aat:300391159 a skos:Concept ;
    skos:definition "Medals, often of brass or precious metal, that commemorate the birth of a child and are inscribed with a name and birth date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth medals"@en .

aat:300391160 a skos:Concept ;
    skos:definition "Medals cast to mark special occasions. Examples include those bestowed upon individuals for service."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative medals"@en .

aat:300391161 a skos:Concept ;
    skos:definition "Small crosses displayed together in a designated area, usually a church, each intended as a remembrance of a deceased person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gedachteniskruisjes"@en .

aat:300391162 a skos:Concept ;
    skos:definition "Devices for sorting and counting paper money or coins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "money counting machines"@en .

aat:300391163 a skos:Concept ;
    skos:definition "Collectible spoons made to commemorate events or places, often intended as souvenirs. On the handle or bowl of the spoon may appear an engraved text, a scene portraying the event, or a location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative spoons"@en .

aat:300391167 a skos:Concept ;
    skos:definition "Ornamental wood or stone projections where the ribs intersect at the apex of a vault. They may serve as the keystone; may be painted or carved."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roof bosses"@en .

aat:300391168 a skos:Concept ;
    skos:definition "Panel paintings installed in churches with religious texts appropriate to the the guild responsible for sponsoring the panel. These often have an ornamented frame bearing references to the guild itelf."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guild boards"@en .

aat:300391169 a skos:Concept ;
    skos:definition "Visual works, often windows, or components of visual works or architecture, made of bits or pieces of glass, often chipped along the edges to resemble faceting, set in a matrix of concrete or epoxy resin. The first glass in concrete windows appeared ca. 1929 in Europe; the technique is now used to create other objects as well. For cement reinforced with glass fibers, use \"glass reinforced cement.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass in concrete"@en .

aat:300391171 a skos:Concept ;
    skos:definition "Special weights, often of decorative shape, used with scales for weighing gold or gold dust, particularly as used where gold is currency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold-weights"@en .

aat:300391172 a skos:Concept ;
    skos:definition "Altars that contain or are placed over a grave, sometimes of grand scale and serving as both a funerary altar and a commemorative monument. The form was highly developed in ancient Rome and was continued in the Christian era; particularly lavish examples date to the Baroque period. For tombs that mimic the form of an altar, but are not actually used as altars, use \"altar tombs.\" To distinguish grave altars that held ashes rather than a corpse or other remains, use the more specific \"cineraria (sepulchral monuments).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave altars"@en .

aat:300391173 a skos:Concept ;
    skos:definition "Grave markers in the form of a Christian cross; may be made of any material, ranging from simple wooden crosses to ornately carved stone crosses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave crosses"@en .

aat:300391174 a skos:Concept ;
    skos:definition "Posts used to mark the location of a grave and in commemoration of the deceased; known in many cultures. They were originally made of a single timber, often decorated with totemic emblems or other iconography. Grave posts may also be made of materials other than wood, but in form resemble the tall, verticality of a tree trunk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave posts"@en .

aat:300391175 a skos:Concept ;
    skos:definition "Registers that record the names of the deceased, date of death, and the location of their graves within a given cemetery or crypt. Occasionally additional information may be included, such as payment for the grave or associated services. When cemeteries are maintained by a church, these registers are church records."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave registers"@en .

aat:300391176 a skos:Concept ;
    skos:definition "Markers or memorials of any kind that designate the site of a grave, ranging from the ephemeral, such as special flower arrangements, to the permanent, such as tombstones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave markers"@en .

aat:300391177 a skos:Concept ;
    skos:definition "Sepulchral monuments in the form of freestanding pillars; distinguished by being taller and generally having less breadth than a tombstone or a stele, but often having more depth. Grave pillars were common in several ancient cultures and continue in modern usage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave pillars"@en .

aat:300391178 a skos:Concept ;
    skos:definition "Bolts on which the shafts have barbs or sharp projections oriented toward the head of the bolt, and that prevent the bolt from being withdrawn once set."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barb bolts"@en .

aat:300391179 a skos:Concept ;
    skos:definition "Ankle-length, black underskirts worn by acolytes in the old Dutch Catholic Church; worn under the cassock when the young man had outgrown it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hallelujas"@en .

aat:300391180 a skos:Concept ;
    skos:definition "Gilt crescent-shaped badges suspended from the neck or on a uniform, derived from an article of medieval armour designed to protect the neck and throat, and formerly worn by officers on duty."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gorgets"@en .

aat:300391181 a skos:Concept ;
    skos:definition "Shrines that are small in size and intended for personal use. Included are personal shrines for traditional ritual and religious devotional purposes, dating from ancient through modern times in many cultures. Also included are modern works made in the form of devotional shrines: examples are personal shrines made according to New Age aesthetics and shrines designed as craft objects in themselves, made to display small trinkets or other objects without religious meaning. For large shrines, use \"shrines (structures).\" For relatively small shrines containing sacred relics, such as the relics of a saint, use \"reliquaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "personal shrines"@en .

aat:300391182 a skos:Concept ;
    skos:definition "Architectural glass introduced in the early 20th century used for interior and exterior wall surfaces. Products included glass building blocks, reinforced plate glass, and pigmented structural glass known under such trade names as Carrara Glass, Sani Onyx (or Rox), and Vitrolite. Structural glass was a popular building material of the Art Deco period, and is no longer manufactured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structural glass"@en .

aat:300391183 a skos:Concept ;
    skos:definition "In archaeology, refers to deposit sites formed at the bottom of or along the shores of depressions in the earth that are filled with water, and that are smaller than an ocean or sea and ranging in size from just a few square meters to thousands of square kilometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lacustrine environments"@en .

aat:300391185 a skos:Concept ;
    skos:definition "In nuclear magnetic resonance imaging, the measurement of the time it takes for excited nuclei to return to their relaxed base state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nuclear magnetic resonance relaxometry"@en .

aat:300391186 a skos:Concept ;
    skos:definition "Flexural tensile strength as expressed by the ratio of stress placed on an object such as a beam to its maximum bending angle at the point of rupture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "modulus of rupture"@en .

aat:300391187 a skos:Concept ;
    skos:definition "In technical examination of artifacts, use of light-sources, such as light-emitting diodes, to excite pigments to emit infrared radiation as luminescence in the visible range. The emission is recorded by a digital camera equipped with suitable filters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visible-induced luminescence imaging"@en .

aat:300391188 a skos:Concept ;
    skos:definition "Bindings for albums used as presentation formats for traditional East Asian painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folded album bindings"@en .

aat:300391189 a skos:Concept ;
    skos:definition "Monitors specifically designed and used to display types of video signals, including analog, digital, S-video, or composite video."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "video monitors"@en .

aat:300391190 a skos:Concept ;
    skos:definition "Theorized by French curator and critic Nicolas Bourriaud in the late 1990s, relational art describes a set of art practices in which the production of human relations and their social context are privileged over a discrete, portable, autonomous work. The artist, acting as a facilitator, establishes spaces, situations, or \"platforms\" designed to host social activities and information exchange between audience participants. Participatory in nature, a relational work emphasizes the social interactions created by the installation or event and conceives the audience as a community. Key practitioners include Liam Gillick, Pierre Huyghe, Maurizio Cattelan, Carsten Höller, and Rirkrit Tiravanija."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Relational art"@en .

aat:300391191 a skos:Concept ;
    skos:definition "Bindings for albums used as a presentation format for traditional East Asian painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butterfly album bindings"@en .

aat:300391192 a skos:Concept ;
    skos:definition "Bindings for albums used as a presentation format for traditional East Asian painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "accordion album bindings"@en .

aat:300391193 a skos:Concept ;
    skos:definition "A form of spectroscopy in which photoelectrons excited by a beam of monochromatic x-rays are measured in order to find the characteristic binding energies of electrons at particular levels of the sample, thus identifying elements present there."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray photoelectron spectroscopy"@en .

aat:300391194 a skos:Concept ;
    skos:definition "A traditional and popular form of East Asian painting, screen fan paintings typically appear on round or ovoid pieces of silk, held taut by a circular outer frame attached to bamboo or wooden handles. Curved folding fan paintings, typically on paper, are mounted on long, thin ribs of wood, bamboo, or ivory, joined at a pivot which allows the fan to close."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fan paintings"@en .

aat:300391195 a skos:Concept ;
    skos:definition "Semisolid fat oil derived from fresh coconuts, often used in the production of cosmetics and candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coconut oil"@en .

aat:300391196 a skos:Concept ;
    skos:definition "Buddhist saints, the most accomplished of the four types of who have defeated all afflictions and will enter nirvana upon death. Typically depicted as 16 in number, who vowed to remain alive to preserve his teachings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arhats"@en .

aat:300391197 a skos:Concept ;
    skos:definition "The processional approaches to tomb sites, flanked by pillars, stelae, and stone carvings which often take the form of guardian figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spirit ways"@en .

aat:300391198 a skos:Concept ;
    skos:definition "Lords who are superior in rank to other lords or rulers, such as a supreme feudal superior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overlords"@en .

aat:300391199 a skos:Concept ;
    skos:definition "Members of a small group holding power in a state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oligarchs"@en .

aat:300391200 a skos:Concept ;
    skos:definition "Mythical animals with a single horn, sometimes identified as a type of unicorn. In legend, the appearance of the qilin coincided with the birth or death of a great ruler or sage, such as Confucius. Representations of qilin often appear on a spirit way, lining the path to a tomb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "qilin"@en .

aat:300391201 a skos:Concept ;
    skos:definition "Tile architectural ornaments that anchor the end of a roof ridge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiwei"@en .

aat:300391202 a skos:Concept ;
    skos:definition "Tile architectural ornaments that anchor the ends of a roof ridges. A development of the chiwei form, the chiwen takes the form of a dragon head with the body of a fish. The mouth of the dragon appears to swallow the ridge, providing additional stability and support for the roof structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiwen"@en .

aat:300391205 a skos:Concept ;
    skos:definition "Automatic pumps that use the kinetic energy of descending water to raise the water above its original height."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hydraulic rams"@en .

aat:300391206 a skos:Concept ;
    skos:definition "A statistical analysis method engaging a variety of principal component techniques to fit a selected geometric model to a body of multivariate data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "multidimensional scaling"@en .

aat:300391207 a skos:Concept ;
    skos:definition "Large floating masses of ice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice floes"@en .

aat:300391208 a skos:Concept ;
    skos:definition "Refers to a weathering phenomenon commonly found on rock surfaces in salt-rich environments whereby cracks follow the surface detailing of a stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contour scaling"@en .

aat:300391209 a skos:Concept ;
    skos:definition "Measurement method originally used to to detect properties of electrical transmission lines; and more recently as a technique to determine dielectric water content in stone structures and in soil. It involves applying stepped voltage in pulses and observing reflected waveforms which reflect discontinuities by amplitude. The distance to the reflecting impedances is measured by the time it takes a pulse to return."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "time-domain reflectometry"@en .

aat:300391210 a skos:Concept ;
    skos:definition "The use of an optical interferometer for a wide variety of metrological and spectroscopic applications that study the interference pattern (or \"fringe\") established when a single beam of light multiply divided into beams traveling unequal paths is reunited."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interferometry"@en .

aat:300391211 a skos:Concept ;
    skos:definition "Optical interferometry technique which involves study of the fringe pattern created when holograms capturing three dimensional information about the surface of the same object are reconstructed and superimposed. After a stress is applied to the object, its new surface geometry is compared with a previously recorded state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holographic interferometry"@en .

aat:300391212 a skos:Concept ;
    skos:definition "Refers to any of various green to brown silicate glass materials formed when a meteorite impact melts the local rock."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tektite"@en .

aat:300391213 a skos:Concept ;
    skos:definition "In churches, cloths and coverings used to conceal paintings, sculptures, and other items of luxury and beauty during the solemn Lenten season. For the curtains used to conceal the altar during Lent, use \"Lenten veils.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lenten cloths"@en .

aat:300391214 a skos:Concept ;
    skos:definition "Species of plant containing the various varieties of cabbage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Brassica oleracea"@en .

aat:300391217 a skos:Concept ;
    skos:definition "Fruit of plants of the genus Cucurbita, in the gourd family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "squash"@en .

aat:300391218 a skos:Concept ;
    skos:definition "Technique in microanalytical chemistry in which a finely focused proton beam is used to excite an x-ray spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "proton probe microanalysis"@en .

aat:300391219 a skos:Concept ;
    skos:definition "Jewish ritual pools used for immersion during various purification procedures and rituals. The Jewish code of law prescribes the requirements for the quantity and nature of ritually appropriate water for ritual cleansing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mikvehs"@en .

aat:300391220 a skos:Concept ;
    skos:definition "Receptacles or sources for water, oil, or another liquid. A type of font is a baptismal font."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fonts"@en .

aat:300391221 a skos:Concept ;
    skos:definition "Trays or platters, usually of circular or octagonal shape and made of various materials: wood panel upon which a scene or symbolism had been painted, ceramics having similar scenes or family crests, or metal. The trays were important symbolic gifts made on the occasion of a successful birth in late medieval and Early Modern Europe, particularly in Italy. Food, clothing, or other gifts were often presented stacked upon the tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birth trays"@en .

aat:300391222 a skos:Concept ;
    skos:definition "Carved ‘serpent stones’ commissioned by Indian women that evoke symbolic properties of the tree and the serpent. These are set beneath sacred trees, and are thought to bestow fertility, especially to the barren. Stone or terracotta nāgakals bearing Shaivite or Vaishnavite symbolism may be found side by side under the same tree-shrine. Most often these are carved by local craftsmen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nāgakals"@en .

aat:300391223 a skos:Concept ;
    skos:definition "Circular arrangements of natural or artificial flowers, leaves, branches, or other such materials, usually hung from doors, windows, walls, or other locations, for various purposes, such as for decoration or to honor or in commemoration of a person or event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wreaths"@en .

aat:300391224 a skos:Concept ;
    skos:definition "Decorative wreaths for the display of Advent candles, typically made from evergreen foliage and set upon a table or other surface. There are usually four candles, three purple and one rose-colored. One candle is lit on each of the four Sundays of Advent, optionally with a fifth, white candle lit on Christmas Eve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Advent wreaths"@en .

aat:300391226 a skos:Concept ;
    skos:definition "Large bells, often in a set of bells, hung in the tower of a church and rung for various purposes, including the following: to call people to worship services; to mark an event such as a wedding, funeral, festival, etc.; or to mark the hours of the day, in order to keep time for the community. For handbells used at an altar in a church, use \"altar bells.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "church bells"@en .

aat:300391227 a skos:Concept ;
    skos:definition "Candelabra or oil lamps having seven branches, modeled after the item that is said to have been used in the ancient temple in Jerusalem. The cup atop the central shaft, which is somewhat elevated to signify the Sabbath, is flanked by three lights on each side. For the eight-branched candelabra or lamps used for Hannukah, use \"Hanukkah lamps.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menorahs"@en .

aat:300391229 a skos:Concept ;
    skos:definition "Christian private or public devotions, special prayers, or services that are observed on nine successive days, or on the same day for nine successive weeks. The purpose of novenas is to request special graces of God or to express mourning; a novena is not, strictly speaking, a ceremony or liturgical event. The practice derives from Jewish tradition, although Jewish prayer periods were of seven days rather than nine. The tradition of nine days derives from the ancient Romans, who had official religious ceremonies that were nine days in duration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novenas"@en .

aat:300391230 a skos:Concept ;
    skos:definition "Computerized axial tomography in which the pixel sizes of the cross-sections of the 3-D object examined by radiography are in the micrometer range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray microtomography"@en .

aat:300391231 a skos:Concept ;
    skos:definition "A spectrometer-based OCT technique using a broadband light source and an interferometer. A low-loss spectrometer measures the spectrum of the interference pattern of light returned from the reference and sample arms of the interferometer. SDOCT has been used in a conservation science context for noninvasive and noncontact assessment of varnish layer thickness and structure on easel paintings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spectral domain optical coherence tomography"@en .

aat:300391232 a skos:Concept ;
    skos:definition "Irregularly occuring phenomenon in which a southward current of warm equatorial water displaces the northward Peru or Humboldt Current. It is characterized by unusually warm sea surface temperatures in the equatorial Pacific Ocean and its disruption of the ocean-atmosphere system in the Tropical Pacific has important consequences for weather and climate worldwide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "El Niño"@en .

aat:300391233 a skos:Concept ;
    skos:definition "Pottery decorated primarily with slip that is black in color. Examples are from 12th-3rd century BCE Nepal, 3d-2nd century Praeneste, ancient Gaul, and other places."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-slipped ware"@en .

aat:300391234 a skos:Concept ;
    skos:definition "Display cabinets having many openings or drawers, that were originally designed to hold and display multiple relics of a saint, martyr, deity, or other holy person. Later the term came to mean similar cabinets intended to hold historical artifacts or curiosities of any kind, usually modest in size and having a common theme."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinets of relics"@en .

aat:300391235 a skos:Concept ;
    skos:definition "A fluorescence microscopy technique that obtains higher resolution images of very small objects than conventional optical microscopy. Rather than flooding the entire specimen evenly with light, which causes simultaneous excitation of all parts and results in a large out-of focus background part captured by the microscope's photodetector, confocal microscopy uses a condenser lens to focus the light from a pin-hole onto a very small spot on the plane of the specimen. An optical system rapidly scans the object in synchrony with the illumination. The reflected and emitted rays entering the collector lens are focused onto a plate which generates a signal that forms a display of the image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confocal microscopy"@en .

aat:300391236 a skos:Concept ;
    skos:definition "A noncontact, light microscopy imaging system allowing for three-dimensional surface analysis. The objective lens has its image distance set to infinity. This depth of field is combined with vertical scanning to traverse the surface of a sample providing a high resolution topographical image with a large field of view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infinite focus microscopy"@en .

aat:300391237 a skos:Concept ;
    skos:definition "Tablets produced for a variety of functions, as souvenirs for pilgrims, icons for portable shrines, models for artists, or for insertion into images or stupas to enhance their potency. These may incorporate carved images of deities or inscriptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "votive tablets"@en .

aat:300391238 a skos:Concept ;
    skos:definition "Vessels with dual openings, originally used in Buddhist ceremonies for sprinkling water for purification. The form originated in India and was later transmitted to China and Korea. The kundika is one of the usual attributes of the Bodhisattva Avalokiteshvara. Scholarship notes that Brahmanical hermits used these vessels to dispense water for their personal use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kundikas"@en .

aat:300391239 a skos:Concept ;
    skos:definition "The arrangement and layout of spaces inside architectural structures or parts of structures that are the result of conscious construction, are of practical use, are relatively stable and permanent. The term typically excludes the moveable works located within the space, such as furniture or accessories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior architecture"@en .

aat:300391240 a skos:Concept ;
    skos:definition "A spectroscopic technique in which short pulses of terahertz radiation probe intermolecular interactions, allowing characterization of solid materials. The detection scheme is sensitive to the material's effect on both the amplitude and the phase of the terahertz radiation. In conservation science used as a nondestructive subsurface analysis of paintings which can reveal buried layer information such as underdrawings or highlight interfaces between layers in a stratigraphic buildup."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terahertz time-domain spectroscopy"@en .

aat:300391241 a skos:Concept ;
    skos:definition "In traditional Indian art and dance, a pose of ease and relaxation, with the figure having one leg folded on the seat while the other is pendant, hanging or extending downward, sometimes resting on a stool or other support. posture of royal ease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lalitasana"@en .

aat:300391242 a skos:Concept ;
    skos:definition "A sulfite having a base that is alkaline. Examples of uses include in a chloride extraction treatment to stabilize corroded marine cast iron, and in wood pulping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alkaline sulfite"@en .

aat:300391244 a skos:Concept ;
    skos:definition "A form of thermal analysis rooted in the science of rheology, a branch of mechanics that deals with the flow deformation of materials in terms of force (stress, strain) and time. DMA is a technique in which rheological data for a particular material is generated using a rheometer and software. The material is characterized in terms of its modulus, elasticity, viscosity, damping behavior, and glass transition temperature, and the changes of these with strain, strain rate, temperature, and oscillatory frequency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dynamic mechanical analysis"@en .

aat:300391245 a skos:Concept ;
    skos:definition "Infrared photography technique commonly applied to a variety of techniques including aerial photography and art examination. False color infrared is preferred for vegetative and hydrologic studies. False color infrared film is sensitive to ultraviolet, visible and infrared radiation to approximately 900 nm. When the film is exposed with a yellow filter, the emulsion layers become sensitive to only green, red and infrared wavelengths. Blue radiation is absorbed by the filter; hence, the greater haze penetration ability of infrared film. In art conservation, the resulting false color images can be used as a noninvasive means of identifying the pigments that have been used in a painting or underdrawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "false-color infrared photography"@en .

aat:300391246 a skos:Concept ;
    skos:definition "Refers to the characteristic pottery produced by the Northern Black Polished Ware (NBPW) culture, an Iron Age culture in north India from ca. 700 BCE-ca. 200 BCE. The ware is recognizable by its black or bluish lustre."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Northern Black Polished ware"@en .

aat:300391247 a skos:Concept ;
    skos:definition "Sensitive technique for detection and measurement of radioactivity using a detector which flashes when substances known as 'scintillator' materials, incorporated into solid plastics or liquid solvents, convert radiation into flashes of light. The resulting photons are amplified after being converted into electric pulses, and are finally displayed as individual counts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquid scintillation counting"@en .

aat:300391248 a skos:Concept ;
    skos:definition "In computing, a spin-image is a data level shape descriptor that is used to match surfaces represented as surface meshes in 3D shape-based object recognition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spin-images"@en .

aat:300391249 a skos:Concept ;
    skos:definition "Refers to an optical technique which enables interferometric measurements of surface displacements. When laser light is scattered by a rough surface it generates a random intensity distribution known as a speckle pattern.The technique allows visualization and measurement of the three dimensional distribution of displacement and strain/stress on the object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic speckle pattern interferometry"@en .

aat:300391250 a skos:Concept ;
    skos:definition "An internationally recognized time scale of Earth's history since the planet's formative period subdivided into eons, eras, periods, and epochs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geologic time scale"@en .

aat:300391251 a skos:Concept ;
    skos:definition "The Phanerozoic is the current eon in the geologic time scale. It extends from approximately 542 million years ago until the present and is marked by the rapid expansion and evolution of life forms allowed by the development of plants carrying out photosynthesis, thus releasing oxygen into the atmosphere. It contains the Paleozoic, Mesozoic, and Cenozoic eras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phanerozoic"@en .

aat:300391252 a skos:Concept ;
    skos:definition "A pigment that is red or reddish in color and contains two or more basic ingredients."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "composite red pigment"@en .

aat:300391253 a skos:Concept ;
    skos:definition "Composite mixture of pigment having a pinkish hue, often available pre-mixed, and intended for use as a flesh color resembling Caucasian flesh tones. Typically used only in western art prior to the early 1900s. Types and proportions of the pigments used for this mixture varied. For the technique of painting to resemble flesh tones, particularly Caucasian, use \"encarnacione (technique).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnation"@en .

aat:300391254 a skos:Concept ;
    skos:definition "The first era of the Phanerozoic. It extends from 542 to 251 million years ago and includes the Cambrian, Ordovician, Silurian, Devonian, Carboniferous, and Permian periods .The Paleozoic begins with the Cambrian explosion, an unparallelled diversification of organisms, and ends with the Permian extinction, the largest mass extinction in Earth's history. It precedes the Mesozoic era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paleozoic"@en .

aat:300391255 a skos:Concept ;
    skos:definition "The middle era of the Phanerozoic eon externding from about 251 to 65 million years ago. It follows the Paleozoic and precedes the Cenozoic. It is divided into the Triassic, Jurassic, and Cretaceous periods. The Mesozoic is popularly known as the age of the dinosaurs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesozoic"@en .

aat:300391256 a skos:Concept ;
    skos:definition "The youngest era of the Phanerozoic. It follows the Mesozoic, extending from about 65 million years ago to the present. During the Cenozoic, flora and fauna evolved toward their present state and the continents assumed their modern configuration. The Cenozoic comprises two periods: the Tertiary (with its five epochs) and the Quaternary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cenozoic"@en .

aat:300391257 a skos:Concept ;
    skos:definition "The first period of the Mesozoic, extending from about 250 to 208 million years ago. Following the mass extinctions of the Permian, many new forms of flora and fauna emerged in the Triassic including ocean reptiles and terrestrial vertebrates such as dinosaurs. The first mammals, small shrew-like creatures, appeared in the late Triassic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Triassic"@en .

aat:300391258 a skos:Concept ;
    skos:definition "Small prints, often on stiff paper, having a Christian theme. Holy cards often bear the image of Jesus, Mary, or a saint on one side, and a prayer or commemoration, as for a deceased person, on the reverse side. They are often collected or used as bookmarks in missals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "holy cards"@en .

aat:300391259 a skos:Concept ;
    skos:definition "The second period of the Mesozoic era, following the Triassic and preceding the Cretaceous. During the Jurassic period, dinosaurs were the dominant form of terrestrial life and the first birds appeared."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jurassic"@en .

aat:300391260 a skos:Concept ;
    skos:definition "The last period of the Mesozoic, extending from about 145 to 65 million years ago. The sudden extinction of the dinosaurs occurred at the end of the period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cretaceous"@en .

aat:300391261 a skos:Concept ;
    skos:definition "A form of porcelain decoration that combines underglaze blue outlines with filled-in overglaze enamel colors. The technique was difficult and required two firings: the first outline is painted in underglaze blue, then fired at a high temperature. The outlines were then coloured in with red, yellow, green and aubergine overglaze and the object was fired again at a lower temperature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doucai"@en .

aat:300391262 a skos:Concept ;
    skos:definition "A term meaning “averter of evil,” and applied to lion-like mythological Chinese guardian creatures. Stone sculptures of bixie are often placed along spirit roads to protect tomb occupants from evil influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bixie"@en .

aat:300391263 a skos:Concept ;
    skos:definition "The earliest period of the Paelozoic, extending from about 542 to 488 million years ago. It is characterized by rapid diversification of marine life. Cambrian rocks are the first to contain an abundance of fossils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cambrian"@en .

aat:300391264 a skos:Concept ;
    skos:definition "The second period of the Paleozoic, following the Cambrian and preceding the Silurian. It extends from about 448 to 443 million years ago. It is marked by a significant radiation of marine life and the first colonization of land, by nonvascular plants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ordovician"@en .

aat:300391265 a skos:Concept ;
    skos:definition "In the geologic time scale, the third period of the Paleozoic Era. It began 443.4 million years ago and ended 419.2 million years ago, following the Ordovician Period and preceding the Devonian Period. It is characterized by a rise in sea levels and a proliferation of fish species. Vascular plants colonized coastal lowlands but continental interiors were mostly devoid of life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Silurian"@en .

aat:300391266 a skos:Concept ;
    skos:definition "Special cloths placed over a Christian altar. Chrismales altar cloths are impregnated with wax to make them impermeable. They are placed directly on the brick or stone, under the other altar cloths, for the purpose of preventing chrism or other oils used in the consecration of the altar from seeping into the other, upper altar cloths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chrismales"@en .

aat:300391267 a skos:Concept ;
    skos:definition "Appearing commonly in China beginning in the eighth century CE, pagoda crypts are used to enshrine relics. Frequently composed of a collection of separate chambers, the crypts sometimes contain murals which thematically complement their contents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pagoda crypts"@en .

aat:300391268 a skos:Concept ;
    skos:definition "Stone monuments with either incised text and/or images. The inscriptions found on bei in northern China heavily influenced the epigraphic school of calligraphy and painting during the Qing dynasty (1644-1911) and early Republican era (1912-1949)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bei"@en .

aat:300391269 a skos:Concept ;
    skos:definition "A fine grade of green-glazed Yue ware produced in China’s Zhejiang province during the late Tang and Five Dynasties (ca. 755-960 CE). Mi se, or “secret color,” refers to a type of stoneware representing the apex of the Yue kilns’ production."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mi se"@en .

aat:300391270 a skos:Concept ;
    skos:definition "Chinese calligraphic script developed by the Northern Song dynasty emperor Huizong (1082-1135). Slender Gold script is characterized by taut, angular lines which expand or contract depending on their place in a stroke. Highly controlled, it projects an air of studied elegance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "slender gold script"@en .

aat:300391271 a skos:Concept ;
    skos:definition "Brush-written specimens of Chinese calligraphy. The term is also used to refer to rubbings of calligraphy from steles and woodblock prints of calligraphy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tie"@en .

aat:300391272 a skos:Concept ;
    skos:definition "First period of the Cenozoic, comprising the major portion of the era. It extends from 65.8 million to 2.6 million years ago. The Tertiary is subdivided into five epochs: Paleocene, Eocene, Oligocene, Miocene, and Pliocene. Some authorities, chiefly European, have lately replaced the Tertiary with two new time divisions: Paleogene (comprising the earlier three epochs of the period) and Neogene (covering the final two)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tertiary"@en .

aat:300391273 a skos:Concept ;
    skos:definition "On the geologic time scale, oldest of five epochs of the Tertiary period, or the last of the more recently designated Paleogene period of the Cenozoic era. The Paleocene extends from about 65 million to 55 million years ago. It followed the Cretaceous period and preceded the Eocene epoch. It is marked by the rapid proliferation and evolution of mammals, including the first primates, and by the formation of the Rocky Mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paleocene"@en .

aat:300391274 a skos:Concept ;
    skos:definition "On the geologic time scale the second epoch of the Tertiary period of the Cenozoic era, or the second of the more recently designated Paleogene. It extends from about 55 to 34 million years ago and is marked by warm climate, the proliferation of many modern groups of organisms, especially mammalian families and molluscs, and the emergence of what is now the Himalayan range."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eocene"@en .

aat:300391275 a skos:Concept ;
    skos:definition "On the geologic time scale the third epoch of the Tertiary period, following Eocene and preceding Miocene, or the first period of more recently designated Paleogene. It extends from about 34 million to 22 million years ago. The epoch is marked by the further development of mammals. The name Oligocene refers to the relatively few moder animals originating during the epoch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Oligocene"@en .

aat:300391276 a skos:Concept ;
    skos:definition "The Miocene is the fourth epoch of the Tertiary period, or the second of the more recently designated Neogene, following Oligocene and preceding Pliocene. It extends from about 23 million to 5 million years ago. The epoch is marked by the expansion of grasslands and the development of modern grazing mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Miocene"@en .

aat:300391277 a skos:Concept ;
    skos:definition "On the geologic time scale, the youngest epoch of the Tertiary, or of the more recently designated Neogene, following Miocene and preceding the Pleistocene epoch of the Quaternary period. It extends from about 5 million to 1.8 million years ago. The Pliocene is marked by the change to a cooler, dry seasonal climate and the presence of essentially modern flora and fauna."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pliocene"@en .

aat:300391278 a skos:Concept ;
    skos:definition "The Quaternary is the second major division of geologic time in the Cenozoic era, following the Tertiary period. It extends from about 1.8 million years ago to the present. It is divided into Pleistocene and Holocene epochs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Quaternary"@en .

aat:300391279 a skos:Concept ;
    skos:definition "On the geologic time scale the earlier and longer epoch of the Quaternary. The Pleistocene extends from about 1.8 million years ago to 10,000 BCE. It is best known as the time when Earth entered its most recent period of glaciation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pleistocene"@en .

aat:300391280 a skos:Concept ;
    skos:definition "The second epoch of the Quaternary and the most recent geologic interval of time. It extends from about 10,000 BCE to the present. It coincides with the late and post-Stone Age history of the human species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holocene"@en .

aat:300391281 a skos:Concept ;
    skos:definition "The older of the two epochs belonging to the Cretaceous period on the geologic time scale. It extends from about 146 million to 100 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Cretaceous"@en .

aat:300391282 a skos:Concept ;
    skos:definition "The younger of the two epochs belonging to the Cretaceous period on the geologic time scale. It extends from about 105.5 million to 66 million years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Cretaceous"@en .

aat:300391284 a skos:Concept ;
    skos:definition "Vessels used to contain or receive water that is used in practices involving washing the body of oneself or of another, or of a thing; common in many religions, or as cultural practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablution vessels"@en .

aat:300391285 a skos:Concept ;
    skos:definition "Relatively broad, bowl-like vessels intended to collect water used during ablution rites; used in several religions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ablution basins"@en .

aat:300391286 a skos:Concept ;
    skos:definition "Refers to any low pressure suction table whether equipped with heating, air circulation, or humidification capabilities. Vacuum tables are used in conservation science to carry out tasks such as relining and relaxing canvases, cleaning paper and textiles, mending tears in various materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum tables"@en .

aat:300391287 a skos:Concept ;
    skos:definition "Raman spectroscopy which employs Fourier transform-based signal treatment to improve the quality of the measured spectra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fourier transform Raman spectroscopy"@en .

aat:300391288 a skos:Concept ;
    skos:definition "Fourier transform infrared spectroscopy adapted for selective analysis of components of heterogeneous samples on a micrometer scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Fourier transform infrared microspectroscopy"@en .

aat:300391289 a skos:Concept ;
    skos:definition "In conservation science, an informal code of conduct.; the working assumptions shared by professionals that form the basis of ethically responsible conservation practice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation principles"@en .

aat:300391290 a skos:Concept ;
    skos:definition "Drinking bowls, almost always having two handles and footed base, used in Christian eucharistic liturgies to hold consecrated wine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion bowls"@en .

aat:300391291 a skos:Concept ;
    skos:definition "A class of natural red dyes derived from various plants of the genus Galium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bedstraw"@en .

aat:300391292 a skos:Concept ;
    skos:definition "Drinking cups, usually footed and having two handles but sometimes only one handle; typically refers to ancient vessels of this type. They are distinguised from kylikes by having deeper bowls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scyphi"@en .

aat:300391293 a skos:Concept ;
    skos:definition "Small plate or saucer-shaped item, often having or mounted on a handle and made of precious metal, used in Christian services during the distribution of the eucharist to prevent crumbs from the host from falling to the ground as the celebrant places the host in the mouth of the faithful. For the general term referring to any type of metal objects used for the liturgy, use \"church plate.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion plates"@en .

aat:300391294 a skos:Concept ;
    skos:definition "Glass objects that are decorated with designs cut or engraved in gold leaf and sandwiched between two fused layers of clear glass. Prime examples are Hellenistic and ancient Roman bowls and plates. In order to fit together, the inner and outer bowls or plates had to be made to an exact and predetermined shape and size, by a hot process that included slumping the glass into or over a ceramic mold or form. The gold foil decoration was stuck to the outer wall of the inner bowl or other shape, using an adhesive such as gum arabic. The two glass bowls or plates were then fused together by heating in a kiln."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold glass"@en .

aat:300391295 a skos:Concept ;
    skos:definition "Technique that quantitatively measures the amount of electrochemical corrosion resistance provided by a coating to a metal substrate. In conservation science it is used extensively for evaluating the anticorrosion performance of coatings to metal works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrochemical impedance spectroscopy"@en .

aat:300391296 a skos:Concept ;
    skos:definition "Iron instruments similar to waffle irons, composed of two palettes that come together with the aid of two handles acting as a lever; designed to create Eucharistic hosts for Christian liturgies. A Christian symbol is typically engraved in the iron bed and stamped onto the hosts. Early examples produced hosts of around one-fourth inch thickness; later examples produced wafer-like hosts. The existence of host irons is established as early as the ninth century, although the earliest surviving example dates to the twelfth century. Seventeenth- and eighteenth-century host irons have been preserved in large numbers, and are quite similar to those now in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "host irons"@en .

aat:300391297 a skos:Concept ;
    skos:definition "A technique used in thermal analysis which examines the change of a mechanical property of a sample while it is subjected to a temperature regime."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermomechanical analysis"@en .

aat:300391298 a skos:Concept ;
    skos:definition "Analytical technique which combines properties of thermal analysis and microscopy to enable the solid state characterization of materials as a function of temperature. A sample substance is placed on a metal strip with a temperature gradient, a melting-point apparatus known as a Kofler bench, thereby revealing its thermal behavior at the temperature at that point when studied with a suitable polarized-light microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermomicroscopy"@en .

aat:300391299 a skos:Concept ;
    skos:definition "X-ray spectroscopy technique in which an intense, tunable X-ray beam of variable frequency from a synchrotron radiation source is directed at a sample and the absorption of the X-rays is measured as a function of frequency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray absorption spectroscopy"@en .

aat:300391300 a skos:Concept ;
    skos:definition "X-ray absorption spectroscopy technique that analyzes the modelling of the dominant edge feature, and its pre-edge, that occur at the frequencies that correspond to transitions between atomic levels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "x-ray absorption near-edge structure"@en .

aat:300391301 a skos:Concept ;
    skos:definition "Genus of the Fabaceae family whose sole species is Spartium junceum (Spanish broom)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spartium"@en .

aat:300391302 a skos:Concept ;
    skos:definition "Hosts, which are pieces of consecrated bread in Christian liturgies, that are small, very thin, and wafer-like, typically round with a meaningful Christian symbol stamped upon them. They are created in a special wafer iron. Communion wafers have been common in the western churches for hundreds of years. The first reference to small, round hosts, but not necessarily as thin as wafers, is mentioned in the eighth century; the small, regular hosts were seen as advantageous in eliminating the need to break up a piece of bread that could crumble easily. Eventually the hosts became very thin wafers that were widely adopted in the west. With the Second Vatican Council of the Roman Catholic Church, other forms of bread have again become increasingly common for consecration as hosts, as a reference to the original, ancient Christian practices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion wafers"@en .

aat:300391303 a skos:Concept ;
    skos:definition "Chromatographic technique used in analysis of alkyds in which pyrolysis is effected in the presence of an alkaline reagent. The technique was developed to identify the components in these polymers (oil-modified polyesters), rates of cross-linking, and mechanical properties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermal hydrolysis and methylation"@en .

aat:300391305 a skos:Concept ;
    skos:definition "Devices, traditionally made of iron, having two palettes designed so that batter may be placed between them for baking. Historically, the devices had two long, lever-like handles for placing the iron in a fire or in an oven. Modern baking irons may operate as separate electrical appliances. The palettes are often stamped or molded with a pattern or design that is transferred to the baked item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baking irons"@en .

aat:300391306 a skos:Concept ;
    skos:definition "Surface elemental analysis technique widely used for identification and characterization of pigments in conservation science. It is an x-ray fluorescence technique in which an incident beam strikes a sample below the critical angle of external total reflection for X-rays resulting in nearly total reflection of the excitation beam photons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "total reflection x-ray fluorescence"@en .

aat:300391307 a skos:Concept ;
    skos:definition "Refers to any one-dimensional array of hundreds or thousands of photodiodes. Photodiode arrays are used as position sensors and incorporated in UV detectors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photodiode arrays"@en .

aat:300391308 a skos:Concept ;
    skos:definition "Cartography in which the points and lines that comprise a map are digitized as computer data."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital mapping"@en .

aat:300391310 a skos:Concept ;
    skos:definition "Designates an archaeological period, extending roughly from 6,000-1,000 BCE, when Native Americans of California turned towards a broader range of food resources, including plant matter, as reflected by extensive use of milling stones and other grinding technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Milling Stone Horizon"@en .

aat:300391311 a skos:Concept ;
    skos:definition "Nondestructive evaluation technique similar to electron speckle pattern interferometry (ESPI) used to discover cracks, deformations, and other flaws in materials. It employs coherent laser light to create an interference pattern, or speckle, on the surface it illuminates. Shearography uses the test object itself as reference, creating a sheared, or double image, which superimposes the object with speckle pattern on the sample with reference light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shearography"@en .

aat:300391312 a skos:Concept ;
    skos:definition "Scanning technique that involves a pattern of lines projected onto a 3-D object and the subsequent mathematical measurement of the deformations caused by the geometry of the object to create a virtual model."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "structured light scanning"@en .

aat:300391313 a skos:Concept ;
    skos:definition "The strengthening by plastic deformation of a material that is strained to beyond its elastic limit. It occurs because of dislocation generation within the material's crystal structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strain hardening"@en .

aat:300391314 a skos:Concept ;
    skos:definition "Refers to types of diffraction-limited microscopy that either combine infrared spectroscopy and optical visualization; or use focal plane array detection for infrared chemical imaging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared microscopy"@en .

aat:300391315 a skos:Concept ;
    skos:definition "Christian ceremonies in which a person first receives the eucharist. In many denominations, those receiving the first communion are typically children."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first communions"@en .

aat:300391316 a skos:Concept ;
    skos:definition "Special Christian eucharistic ceremonies that are accompanied by ritual and prayers outside the usual, often including the renewal of baptismal vows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solemn communions"@en .

aat:300391317 a skos:Concept ;
    skos:definition "Vases intended to contain offerings or to themselves serve as an offering in a religious or funerary context. Examples exist from ancient times and in many cultures, including the following: ancient Egypt, Greece, and Rome; Asian cultures; the Pre-Columbian Americas; and in modern western culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "offering vases"@en .

aat:300391318 a skos:Concept ;
    skos:definition "Deciduous shrub common to the Mediterranean region whose gray-green rush-like shoots are used in basket-making and provide a fiber employed in products as cords, coarse cloth, and canvas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spartium junceum"@en .

aat:300391319 a skos:Concept ;
    skos:definition "Natural fiber from the floss of the pod of the common milkweed. Compressed floss has a silky sheen and is added to nonwovens to enhance softness, insulating properties, absorbency, bulk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "milkweed floss"@en .

aat:300391320 a skos:Concept ;
    skos:definition "Ordinances that outline how land developers may be granted concessions in exchange for providing amenities a community feels are desirable, such as low-income housing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zoning incentives"@en .

aat:300391321 a skos:Concept ;
    skos:definition "Ceramics medium used widely, but perfected in the Islamic world during 10th-11th centuries. Fritware (also known as stonepaste) employs a body made primarily of ground quartz with small amounts of refined clay and fused glass. This fabric allows for a firmer and whiter body than earthenware."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fritware"@en .

aat:300391324 a skos:Concept ;
    skos:definition "Rods, sticks, or shafts used to point to text or other material. Typical use of a pointer is by teachers or lecturers to indicate something on a blackboard, map, diagram, or other visual material. For pointers that use a laser light rather than a rod, use \"laser pointers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pointers"@en .

aat:300391325 a skos:Concept ;
    skos:definition "Hand held devices that emit a very intense, narrow, parallel beam of highly monochromatic and coherent light, used as a pointer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laser pointers"@en .

aat:300391326 a skos:Concept ;
    skos:definition "Devices used to measure respiratory function, particularly the volume of air moved during breathing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "respirometers"@en .

aat:300391327 a skos:Concept ;
    skos:definition "Distinctive torches used in ancient Greek and Roman marriage ceremonies, employed to accompany the bride in the wedding procession and to decorate the home of the groom. The torches used the pitchy sap that issued from a fir or pine tree that they called \"taeda.\" They were so universally present in ancient weddings, that the marriage itself was sometimes called \"taeda.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taedas"@en .

aat:300391328 a skos:Concept ;
    skos:definition "The milkweed subfamily of the flowering-plant family Apocynaceae, including more than 214 genera and about 2,400 species. Formerly treated as its own family Asclepiadaceae. However, molecular evidence suggests that the group is evolutionarily derived from Apocynaceae, and thus it has been recategorized as a subfamily by the Angiosperm Phylogeny Group III (APG III) botanical classification system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Asclepiadoideae"@en .

aat:300391329 a skos:Concept ;
    skos:definition "Ceremonies involving the reception of the consecrated bread and wine by Christians, usually in the context of a eucharistic ceremony."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communions"@en .

aat:300391330 a skos:Concept ;
    skos:definition "A set of standards proposed by the World Wide Web Consortium to promote common data formats, including a semantic component, in order to convert currently unstructured web documents into a shared framework and a web of data that can be processed by machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Semantic Web"@en .

aat:300391331 a skos:Concept ;
    skos:definition "Cases used to contain the mezuzah parchment and that are thus attached to the doorframe of a Jewish home. The cases are usually of linear, tubular design and of various materials, including wood, silver, gold, ceramic, or plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mezuzah cases"@en .

aat:300391332 a skos:Concept ;
    skos:definition "Repair treatment used to combat carbonation-induced corrosion of steel in concrete and restore alkalinity. Realkalization, also known as electrochemical realkalization treatment (ERT), applies an electric field between the reinforcement in the concrete and an externally mounted anode mesh. An alkaline electrolyte is transported into the concrete, increasing the alkalinity of the cover zone, returning the steel reinforcement to a passive condition in the process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "realkalization"@en .

aat:300391333 a skos:Concept ;
    skos:definition "The extraction of metals from minerals using naturally occurring microorganisms instead of chemical solutions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioleaching"@en .

aat:300391334 a skos:Concept ;
    skos:definition "Any of a class of purple, red, orange and yellow pigments, including the carotenes, the xanthophylls, and fucoxanthin, found widely in plants and animals and are characterized by solubility in fats and oils. They provide the color of such things as carrots, bananas, corn, and crustaceans. Carotenoids are used in food coloring and in dyes applied to textiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carotenoid"@en .

aat:300391335 a skos:Concept ;
    skos:definition "X-ray scattering technique that characterizes solution structures of biological macromolecules and synthetic nanoparticles at a scale of about 1-2 nanometers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small-angle x-ray scattering"@en .

aat:300391336 a skos:Concept ;
    skos:definition "Refers to archival repositories of digital materials that are made accessible to individuals"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital libraries"@en .

aat:300391337 a skos:Concept ;
    skos:definition "Colorless, extremely volatile liquid once primarily used as racing fuel but now banned for safety reasons. Propylene oxide is chiefly used in production of polyurethane plastics. It is also employed as a fumigant for use in agriculture and cultural heritage protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "propylene oxide"@en .

aat:300391338 a skos:Concept ;
    skos:definition "Genus containing 16 species of evergreen trees native to tropical regions of Africa and South America, located primarily in swampy areas or near rivers or lakes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guibourtia"@en .

aat:300391339 a skos:Concept ;
    skos:definition "Species of tree native to western Africa, prized for its reddish, striped wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guibourtia tessmannii"@en .

aat:300391340 a skos:Concept ;
    skos:definition "Species of tree native to western Africa, prized for its reddish, striped wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guibourtia demeusei"@en .

aat:300391341 a skos:Concept ;
    skos:definition "Corporal punishment tools consisting of nine narrow straps or ropes tied at the end with buttons, lead pellets, or iron nails. Served to whip the back and loins. The name is derived from whips with nine knotted lashes that were an authorized instrument of punishment in the British navy and army until 1881. For similar whips or scourges, but not necessarily having nine straps, use \"knouts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cat-o'-nine-tails"@en .

aat:300391342 a skos:Concept ;
    skos:definition "Genus of grass native to Southeast Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coix"@en .

aat:300391343 a skos:Concept ;
    skos:definition "Species of tall grain-bearing tropical plant native to Southeast Asia; it is cultivated elsewhere as a garden annual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coix lacryma-jobi"@en .

aat:300391344 a skos:Concept ;
    skos:definition "Cutting wand that operates by punch-tip action, cutting by perforating paper rather than slicing it. Designed for use in children's arts and crafts; used as well by paper conservators for preparing hinges, inlays, and fills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Crayola Cutter (TM)"@en .

aat:300391345 a skos:Concept ;
    skos:definition "Any of various materials used to replicate gold leaf. Genuine gilding has been imitated since medieval times by using a transparent yellow glaze over silver or tin leaf. In the 19th century, bronze leaf was also used as a gilding imitation. Currently, imitation gold leaf is typically made from tinted sheets of aluminum or white gold (palladium and platinum)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imitation gilding"@en .

aat:300391347 a skos:Concept ;
    skos:definition "Refers to revival of historical styles, often in eclectic combination, in 19th-century architecture after Neo-Classicism beginning in the 1820s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Historicism"@en .

aat:300391348 a skos:Concept ;
    skos:definition "Fluorimetry practiced on a micrometer scale. In conservation science used for the characterization of lake pigments and dyes in works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microspectrofluorimetry"@en .

aat:300391349 a skos:Concept ;
    skos:definition "Technique closely related to secondary ion mass spectroscopy (SIMS), varying from it only in the strict separation between emission and ionization of the sputtered particles from the sample surface. Neutral atoms are detected by post-ionising any atoms that are ejected from the surface. This post-ionisation can be accomplished by using lasers or electron bombardment of the atoms entering the mass analyser."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary neutral mass spectrometry"@en .

aat:300391350 a skos:Concept ;
    skos:definition "Tags, tickets, or labels attached to an item for sale, to show its price. The tag may be attached to the item with a cord or string, or it may be attached to the item by an adhesive backing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "price tags"@en .

aat:300391351 a skos:Concept ;
    skos:definition "Tags or labels attached to luggage, containing an identification of the owner and his or her contact information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "luggage tags"@en .

aat:300391352 a skos:Concept ;
    skos:definition "Labels, often having an adhesive backing, bearing the name and address of the intended recipient of mail or packages, to facilitate the dispatch of the items by a postal service or other delivery agent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mailing labels"@en .

aat:300391353 a skos:Concept ;
    skos:definition "The work or industry of capturing, killing, and rendering seals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sealing"@en .

aat:300391354 a skos:Concept ;
    skos:definition "Artificial black pigment made of the sediment of white wine mentioned in historic documents of the 17th-19th centuries. Frankfurt black was the preferred pigment for making intaglio printing ink. Production of the pigment centered in the vineyard areas east of Frankfurt, Germany in the villages along the banks of the river Main. For unknown reasons, Frankfurt black disappeared after 1900. It is not to be confused with the mixture of bone black and Berlin blue still used as a painting pigment and known as Frankfurt or Parisian black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Frankfurt black"@en .

aat:300391355 a skos:Concept ;
    skos:definition "Waist-length army jackets of a particular style and khaki color, resembling jackets worn by U.S. General Dwight D. Eisenhower during World War II. The jacket became standard issue for U.S. troops beginning in November 1944."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eisenhower jackets"@en .

aat:300391356 a skos:Concept ;
    skos:definition "Military or personal coats for formal or evening wear."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dress coats"@en .

aat:300391357 a skos:Concept ;
    skos:definition "Crystalline amino acid present in proteins and peptides. It has been explored as a non-toxic alternative to benzotriazole (BTA) for the conservation of archaeological objects with bronze disease."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cysteine"@en .

aat:300391358 a skos:Concept ;
    skos:definition "A traditional technique used in East Asian garden architecture which incorporates a distant landscape into a garden composition. This is done by creating a framing device, usually created with trees or hedges, located some distance from the viewer. This trims the raw view, obscuring spatial depth cues, and has the effect of bringing the distant natural scene forward so as to appear part of the built foreground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "borrowed view"@en .

aat:300391359 a skos:Concept ;
    skos:definition "Windows typically made of brick set in diverse openwork patterns, placed in walls for ornamental purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "open-tracery windows"@en .

aat:300391360 a skos:Concept ;
    skos:definition "A manner of arranging stones in Asian gardens, in which a large, interestingly-shaped rock is placed in an isolated area to provide visual enjoyment, or several rocks are grouped together to form a peak."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "isolated placement"@en .

aat:300391361 a skos:Concept ;
    skos:definition "A manner of arranging stones in Asian-style gardens, in which rocks are scattered to accentuate the surrounding environment. A number of stones frequently are placed together to form a group, or used to enliven the surroundings in conjunction with other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scattered placement"@en .

aat:300391362 a skos:Concept ;
    skos:definition "Rocks prized by Chinese scholar-officials for their distinctive shapes and crevices, seen as suggestive of the transformational powers of nature. Larger stones were placed in gardens as unique focal features, while smaller rocks often adorned scholars’ desks, a microcosmic representation of the natural world within the space of the study."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scholar's rocks"@en .

aat:300391363 a skos:Concept ;
    skos:definition "Among the most important types of rock used for garden building in China. A type of limestone categorized according to its northern and southern varieties, it is found both underwater and in the mountains. The type found in Lake Taihu in Jiangsu province is the most well-known variety, and thus “Taihu rock” has become a general designation for such stones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Taihu rock"@en .

aat:300391364 a skos:Concept ;
    skos:definition "Horizontal inscribed tablets hung in halls or pavilions, often bearing the name of the structure or room, or a poetic verse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bian e"@en .

aat:300391365 a skos:Concept ;
    skos:definition "Pavilions in which winding grooves were chiseled into the stone slab flooring; flowing water was then diverted into the grooves. Guests invited to a banquet would place wooden or extremely thin chinaware cups of wine in the water and allow them to flow along the grooves. The person in front of whom a cup stopped would drink the wine and compose an impromptu poem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flowing-cup pavilions"@en .

aat:300391366 a skos:Concept ;
    skos:definition "An open, single-story hall often seen in gardens, generally built at minor scenic spots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xuan"@en .

aat:300391367 a skos:Concept ;
    skos:definition "Multistory building in gardens used for enjoying the scenery in the distance, or for relaxation and recreation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lou"@en .

aat:300391368 a skos:Concept ;
    skos:definition "A form of building often found in gardens, its location and function similar to those of multi-storied buildings, but usually smaller in size. It is often built on flat land, but occasionally found against hillsides or on the edge of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ge"@en .

aat:300391369 a skos:Concept ;
    skos:definition "Terraced pavilions, one of the principal forms of buildings in East Asian gardens. Such buildings are generally constructed beside water, and thus are called “water pavilions.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xie"@en .

aat:300391370 a skos:Concept ;
    skos:definition "Grand reception halls. In gardens, tang are generally located in central, public areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tang"@en .

aat:300391371 a skos:Concept ;
    skos:definition "Covered walkways or gallerys found in gardens. Used to connect buildings or gateways, lang also divide spaces in the manner of a standing screen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lang"@en .

aat:300391372 a skos:Concept ;
    skos:definition "An association formed between private and government sectors to fund and operate a venture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public-private partnership"@en .

aat:300391373 a skos:Concept ;
    skos:definition "A technique of creating scenery in gardens by piling up stones. Instead of using the stones to form a hill, they are placed at key points to enhance the scenery and draw attention to these locations. Rocks selected are chosen for their interesting shape, or for the effect they generate when grouped together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zhi shi"@en .

aat:300391374 a skos:Concept ;
    skos:definition "Walls often found in gardens, usually whitewashed, also referred to as an “undulating wall.” The top of the wall has a rhythmical, wave-like appearance, and is covered by small dark tiles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cloud-like walls"@en .

aat:300391375 a skos:Concept ;
    skos:definition "Bridges surmounted by pavilions; may be found in gardens and used for water-viewing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pavilion bridges"@en .

aat:300391376 a skos:Concept ;
    skos:definition "Paint that is applied as an atomized mist, through dispensers such as an aerosol container of compressed gas or a spray gun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spray paint"@en .

aat:300391377 a skos:Concept ;
    skos:definition "Architectural elements found mounted on the walls of roofed walkways in gardens. Stone slates are typically inscribed with the calligraphy or drawings of well-known figures. An inscription recording the construction of the garden also occasionally appears on the slates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone slates"@en .

aat:300391378 a skos:Concept ;
    skos:definition "Estimation of the number of visitors a protected area can accommodate without causing environmental damages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tourism carrying capacity assessment"@en .

aat:300391379 a skos:Concept ;
    skos:definition "A medicinal or cosmetic preparation, in the form of a viscous or semisolid paste, applied to the skin; formerly used for ceremonial or sacramental anointing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ointment"@en .

aat:300391380 a skos:Concept ;
    skos:definition "Describes institutions that specialize in the history, objects, vehicles, and other materials associated with transportation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transportation museums"@en .

aat:300391381 a skos:Concept ;
    skos:definition "A salt of sulfurous acid, usually with a qualifying term indicating the base, such as magnesium sulfite, sodium sulfite, or copper sulfite. The sulfites are recognized by their giving off the smell of sulfurous acid when acted on by a stronger acid."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfite"@en .

aat:300391382 a skos:Concept ;
    skos:definition "Sulfur dioxide dissolved in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfurous acid"@en .

aat:300391383 a skos:Concept ;
    skos:definition "A type of handmade drawing paper that was textured and of high quality. It was a laid paper with a surface having rows of narrow parallel ridges on one side and a rougher, bumpy surface on the other side. A paper of this name is still produced by the Ingres paper mill, but scholars debate whether this paper is the same paper that was so prized by Seurat and other 19th-century artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Michallet paper"@en .

aat:300391384 a skos:Concept ;
    skos:definition "Fine linen of very light weight and slightly translucent. It is so-named for its use in making handkerchiefs, although it is also used for blouses, skirts, lingerie, children's clothing, and for other purposes as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "handkerchief linen"@en .

aat:300391386 a skos:Concept ;
    skos:definition "Compounds in which sulfur is bonded to two organic groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "organic sulfide"@en .

aat:300391387 a skos:Concept ;
    skos:definition "Ionic compounds or salts that contain a negatively charged sulfide ion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inorganic sulfide"@en .

aat:300391388 a skos:Concept ;
    skos:definition "Sulfides that occur when the sulfur atom reacts with organic phosphines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphine sulfide"@en .

aat:300391389 a skos:Concept ;
    skos:definition "The magnesium salt of magnesium sulfite in sulfurous acid appearing as colorless crystals or white, crystalline powder. It oxidizes to sulfate on exposure to air and loses all its water at 200 degrees fahrenheit. It is used as an adsorbent and absorbent, as an agricultural chemical, in the manufacture of paper pulp, as a wastewater treatment, and etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium sulfite"@en .

aat:300391390 a skos:Concept ;
    skos:definition "A soluble sodium salt of sulfurous acid (sulfite), appearing as small crystals or powder. Sodium sulfite is used in multiple industries and exhibits bleaching, reducing, de-sulfurizing, and dechlorinating functions. In the food industry it is used to maintain the appearance of freshness, and to preserve meat. It is also a component in many drugs, to help stabilize and maintain potency. It is used in the pulp and paper industry as a water treatment, and in photography it has been used in developer solutions, and as a hypo clear solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sodium sulfite"@en .

aat:300391391 a skos:Concept ;
    skos:definition "A sulfite of copper. Uses include in herbicides applied to water to kill plants, but they are toxic to fish and other water animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper sulfite"@en .

aat:300391392 a skos:Concept ;
    skos:definition "General term designating a culture, style, or period occurring or existing before the colonial period of a country. Often used in reference to indigenous cultures prior to European colonization."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pre-colonial"@en .

aat:300391393 a skos:Concept ;
    skos:definition "In heritage and other cultural management, the process that determines cultural value and significance of a landmark site or a collection for its stakeholders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "significance assessment"@en .

aat:300391394 a skos:Concept ;
    skos:definition "Institutions that house and display horse-drawn carriages and related objects or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage museums"@en .

aat:300391395 a skos:Concept ;
    skos:definition "Buildings that house and display horse-drawn carriages and related objects or documents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carriage museums"@en .

aat:300391399 a skos:Concept ;
    skos:definition "Transliteration of Maldivian, the language that is closely related to Sinhalese, spoken in the Maldive Islands and on the island of Minicoy, which is part of India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maldivian (transliterated)"@en .

aat:300391418 a skos:Concept ;
    skos:definition "Written standard for the Norwegian language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Norwegian (Bokmål)"@en .

aat:300391424 a skos:Concept ;
    skos:definition "Inhabited places noted for cultural institutions and activities, such as museums, performances of music and dance, etc., particularly when the places serve as the hub of cultural activity in an area or region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural centers"@en .

aat:300391425 a skos:Concept ;
    skos:definition "English as spoken from ca. 1450- ca. 1700. It is the language preserved in several great literary works, including Shakespeare and the King James Bible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Early Modern English"@en .

aat:300391426 a skos:Concept ;
    skos:definition "English as spoken from ca. 1700 through the present."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Modern English"@en .

aat:300391427 a skos:Concept ;
    skos:definition "The stage of English that follows Middle English. Modern English is characterized by simplified inflectional systems, by an increasingly standardized and stable system of orthography, and by the introduction of new vocabulary, especially as a result of significant social changes over the period and the development of English as a world language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modern English"@en .

aat:300391428 a skos:Concept ;
    skos:definition "The English language as spoken ca. 900-1066, it is the final stage of the English language leading up to the Norman conquest of England and the subsequent transition to Early Middle English."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Late Old English"@en .

aat:300391430 a skos:Concept ;
    skos:definition "The Germanic and Anglo-Saxon feast of the winter solstice, observed in December in pre-Christian Britain and northern Europe; later Christianized as Christmas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Yule"@en .

aat:300391432 a skos:Concept ;
    skos:definition "Culture and style of Bronze Age culture that thrived ca. 3300-ca. 1300 BCE Indus Valley culture ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pre-Harappan"@en .

aat:300391433 a skos:Concept ;
    skos:definition "Cultures or styles of the ancient area of the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Middle Eastern"@en .

aat:300391434 a skos:Concept ;
    skos:definition "Cultures and styles of any nations or peoples of Asia in ancient times; the time frame generally includes centuries BCE, sometimes including periods up to around 1000 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Asian"@en .

aat:300391435 a skos:Concept ;
    skos:definition "Organic compound used variously as a catalyst and also as a consolidant in stone conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calcium alkoxide"@en .

aat:300391436 a skos:Concept ;
    skos:definition "Sites known by archaeological evidence of hominind activity, but not known to be a settled community. Distinguished from \"inhabited places,\" which are known to be communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "occupation sites"@en .

aat:300391437 a skos:Concept ;
    skos:definition "The culture of any group of the Hominidae family, generally referring to cultures of the hominid relatives of humans. To distinguish the cultures of humans, particularly very early cultures that overlap with other hominid cultures, use \"human (culture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hominid"@en .

aat:300391438 a skos:Concept ;
    skos:definition "Organic compound used as a catalyst and as an ingredient in consolidant in stone conservation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium alkoxide"@en .

aat:300391439 a skos:Concept ;
    skos:definition "Dating from the Ming (1368-1644) and Qing (1644-1912) dynasties, large screen walls built of glazed bricks and tiles with reliefs of nine dragons, an imperial motif in China. These function as symbolic walls demonstrating imperial power, or screen walls, shielding the people behind it from malevolent spirits and influences."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nine-dragon walls"@en .

aat:300391440 a skos:Concept ;
    skos:definition "High platforms or terraces built in early China for emperors to offer sacrifices to Heaven. The emperor was able to see far into the distance from the top of the platforms, and so they became a symbol for the mountains. In later centuries, they became a type of structure used in gardens for entertaining."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tai"@en .

aat:300391441 a skos:Concept ;
    skos:definition "Family containing about 620 species in 31 genera of trees, small shrubs, and perennial herbs, growing primarily in warm regions of both the Old World and the New World and is especially diverse in South America and Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lythraceae"@en .

aat:300391442 a skos:Concept ;
    skos:definition "Genus of tropical Old World shrubs in the Lythraceae family having tetramerous flowers and a four-celled capsular fruit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lawsonia"@en .

aat:300391443 a skos:Concept ;
    skos:definition "Tropical shrub or small tree of the loosestrife family, native to northern Africa, Asia, and Australia. The plant bears small opposite leaves and fragrant, white to red flowers. It is the source of dye used for temporary tattooing and to dye skin, hair and fingernails, as well as fabrics including silk, wool and leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lawsonia inermis"@en .

aat:300391444 a skos:Concept ;
    skos:definition "The style and culture of the Acolhua people of Texcoco, a major city-state in the central Mexican plateau region of Mesoamerica during the Late Postclassic period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Texcocan"@en .

aat:300391445 a skos:Concept ;
    skos:definition "Nanomaterial composed of a hydrogel (a hydrophylic polymer network) used for varied applications including medicine, DNA sequencing, and in conservation as a surface coating and protectant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nanogel"@en .

aat:300391446 a skos:Concept ;
    skos:definition "The cultures of the areas geographically positioned to the east of the Mediterranean Sea, commonly including Syria plus Cyprus, also known as the Levant; sometimes also including Greece, Turkey, and Egypt as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eastern Mediterranean"@en .

aat:300391447 a skos:Concept ;
    skos:definition "Computer software technique for rendering virtual models of surfaces in three-dimensions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital surface modeling"@en .

aat:300391448 a skos:Concept ;
    skos:definition "Refers to the early cultures of humans and other hominins marked by reliance on wild plants and animals for subsistence. They were often nomadic, following the wild herds or moving with the seasons. Until about 12,000 years ago or somewhat earlier, when agriculture and animal domestication emerged in southwest Asia and in Mesoamerica, all peoples were hunters and gatherers. This stage in human development was retained for different amounts of time in different areas; in some environments not conducive to farming or where natural plants and animals remain plentiful, hunter-gatherer cultures still exist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hunter-gatherer"@en .

aat:300391449 a skos:Concept ;
    skos:definition "Refers to the cultures associated with human community-building prior to the development of farming, where groups were sedentary and took advantage of plant and animal food sources native to the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sedentary hunter-gatherer"@en .

aat:300391451 a skos:Concept ;
    skos:definition "An alcoholic beverage made by mixing wine with fruit juice, and frequently also soda water and sugar; served chilled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wine cooler"@en .

aat:300391452 a skos:Concept ;
    skos:definition "An alcoholic beverage of Spanish origin, composed of red wine diluted with fruit juice or various other ingredients; sweetened and served chilled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sangria"@en .

aat:300391453 a skos:Concept ;
    skos:definition "Large liquor cabinets having spaces designed specifically for holding bottles of liquor, wine, glasses, other utensils, ice, and a shelf or surface needed for making and serving drinks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar cabinets"@en .

aat:300391454 a skos:Concept ;
    skos:definition "Cabinets of any size having shelves or horizontal slots designed specifically for holding bottles of liquor and wine, and also glasses. For chests or smaller cabinets for holding liquor or wine bottles, use \"cellerets.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liquor cabinets"@en .

aat:300391456 a skos:Concept ;
    skos:definition "Semiconductor lasers used in Raman spectroscopy that reverse, or flip, the direction of conduction-band electrons as they spin on an axis in the direction of the magnetic field."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spin flip lasers"@en .

aat:300391457 a skos:Concept ;
    skos:definition "A broad term that includes all aspects of an organism's physical condition; often reserved for abnormal conditions, including diseases, disorders, illnesses, and injuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "medical condition"@en .

aat:300391458 a skos:Concept ;
    skos:definition "The medical condition of low oxygen in the blood or tissues of a human or other animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anoxemia"@en .

aat:300391459 a skos:Concept ;
    skos:definition "A technique in which localized regions of a sample are examined with spatial resolution on the micrometer scale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro x-ray fluorescence"@en .

aat:300391461 a skos:Concept ;
    skos:definition "Elastic scattering of beam electrons from a sample in a direction approximately opposite to that of the incident radiation. Backscattered electron (BSE) imaging is a technique used in examination of archaeological artifacts to make surfaces of materials visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electron backscattering"@en .

aat:300391462 a skos:Concept ;
    skos:definition "Style and culture of the Ostiones people of the Caribbean islands, dating ca. 500-1500 CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ostionoid"@en .

aat:300391463 a skos:Concept ;
    skos:definition "Emission spectroscopy that uses the inductively coupled plasma to produce excited atoms and ions that emit electromagnetic radiation at wavelengths characteristic of a particular element. The intensity of this emission is indicative of the concentration of the element within the sample."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inductively coupled plasma atomic emission spectrometry"@en .

aat:300391464 a skos:Concept ;
    skos:definition "Spectroscopic technique that measures the absorption of infrared radiation by a sample. A molecule with a dipole moment, that is one end with a positive charge and the other end a negative charge, can absorb infrared light, but only at certain fixed frequencies. Hence, an infrared spectrum of light reflected from the surface will show absorption peaks which are characteristic of the molecule and its method of bonding to the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "infrared reflection absorption spectroscopy"@en .

aat:300391465 a skos:Concept ;
    skos:definition "The automated action or practice of creating three-dimensional objects from a digital file or other original, used for rapid prototyping, model making, additive manufacturing, etc. In an additive process, an object is created by laying down successive layers of material until the object is created; the process uses 3-D printers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "3-D printing"@en .

aat:300391466 a skos:Concept ;
    skos:definition "Machines used to create a physical object from a three-dimensional digital model, typically by laying down thin layers of a material in succession."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "3-D printers"@en .

aat:300391467 a skos:Concept ;
    skos:definition "The language of the ancient Greek state of Macedonia. The modern Macedonian language is unrelated to the Ancient Macedonian language."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Macedonian"@en .

aat:300391468 a skos:Concept ;
    skos:definition "An interval of the Paleozoic Era that followed the Silurian Period and preceded the Carboniferous Period, spanning between about 419.2 million and 358.9 million years ago. This period featured diverse and abundant aquatic life. Forests and marine organisms known as ammonites appeared early in the Devonian, and later amphibians appeared, the first vertebrates on land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Devonian"@en .

aat:300391469 a skos:Concept ;
    skos:definition "The fifth interval of the Paleozoic Era in the geologic time scale, following the Devonian Period and preceding the Permian Period. The Carboniferous Period began approximately 358.9 million years ago and ended 298.9 million years ago, the longest period of the Paleozoic Era and the second longest period of the Phanerozoic Eon. The first reptiles and seed-bearing plants appeared during this period, accompanied by widespread coral reefs, coal-forming swamp forests, and extensive limestone deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carboniferous"@en .

aat:300391470 a skos:Concept ;
    skos:definition "The final period of the Paleozoic Era. The Permian Period began 298.9 million years ago and ended 252.2 million years ago, following the Carboniferous and preceding the Triassic. Glaciation was widespread in the early Permian, but the climate warmed throughout the period resulting in hot and dry conditions that caused a crisis in marine and terrestrial life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Permian"@en .

aat:300391471 a skos:Concept ;
    skos:definition "The second of three divisions of the Cenozoic Era encompassing the interval between 23 million and 2.6 million years ago and including the Miocene and the Pliocene epochs, preceded by the Paleogene period. Marine and terrestrial life of this time were more closely related to each other than to those of the Paleogene. The Neogene and Paleogene periods are new additions to the geologic time scale and together represent what was formerly referred to as the Tertiary period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neogene"@en .

aat:300391472 a skos:Concept ;
    skos:definition "Oldest of the three divisions of the Cenozoic Era spanning between 66 million and 23 million years ago. It includes the Paleocene, Eocene and the Oligocene epochs. This period was formerly considered a part of the Tertiary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paleogene"@en .

aat:300391473 a skos:Concept ;
    skos:definition "Period of the geologic time scale that extends from about 4.6 billion years ago, from the Earth's formation, to the beginning of the Cambrian Period, 542 million years ago. The Precambrian represents more than 80 percent of the total geologic record, and contains the earliest evidence for the advent of life; microfossils that resemble algae, cysts of flagellates, tubes interpreted to be the remains of filamentous organisms, and mounded colonies of photosynthetic bacteria called stromatolites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Precambrian"@en .

aat:300391474 a skos:Concept ;
    skos:definition "The period of Earth's history that began 2.5 billion years ago and ended 542.0 million years ago, following the Archean. In this period stable continents first appeared and began to accrete, and also the first abundant fossils of living organisms, mostly bacteria and archaeans, then eukaryotic cells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proterozoic"@en .

aat:300391475 a skos:Concept ;
    skos:definition "On the geologic time scale, the period preceding the Proterozoic Eon, spanning about 1.5 billion years, in which the Earth's atmosphere was probably of methane, ammonia, and other gases, and the surface cooled enough that rocks and continental plates began to form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Archean"@en .

aat:300391476 a skos:Concept ;
    skos:definition "A building type found in gardens, built in secluded, quiet areas and used for studies or studios. Such buildings are generally enclosed and located deep within the garden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "zhai"@en .

aat:300391477 a skos:Concept ;
    skos:definition "In ancient China, stone structures resembling watchtowers which marked the entrance to a building complex. Generally built in pairs, they stand on opposing sides of a road or walkway, and are typically found in front of citadels, palaces, mansions, ancestral temples, and mausoleums."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "que"@en .

aat:300391478 a skos:Concept ;
    skos:definition "Imperial resorts, specifically palace buildings built outside the capital city for the residence or entertainment of emperors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "li gong"@en .

aat:300391479 a skos:Concept ;
    skos:definition "Used in a garden context, this term refers to accentuating scenic spots. At key scenic points, steps are taken to augment their remarkable appearance. The surrounding structures often are given names related to details of the natural environs, or inscribed with poetry describing the essence of the scenery, thereby contributing details that enhance the aesthetic appeal of the location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dian jing"@en .

aat:300391480 a skos:Concept ;
    skos:definition "Settlements having a certain designated size and configuration, especially a township or commune of ancient or modern Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "demes"@en .

aat:300391481 a skos:Concept ;
    skos:definition "Counties, particularly in Hungary that act as administrative capitals, and have the responsibilities of both a county and a municipality."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban counties"@en .

aat:300391482 a skos:Concept ;
    skos:definition "Centers or sites having religious sanctuaries as a primary focus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sanctuary centers"@en .

aat:300391483 a skos:Concept ;
    skos:definition "The culture associated with the Middle Palaeolithic fossil hominid, Homo neanderthalensis, who flourished in Eurasia 200,000 to 28,000 years ago. Among other cultural attributes, Neanderthals are associated with the Mousterian flint industry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neanderthal"@en .

aat:300391484 a skos:Concept ;
    skos:definition "Nationality, style, and culture of Carthage, an ancient city of north Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carthaginian"@en .

aat:300391486 a skos:Concept ;
    skos:definition "Chairs by means of which an electric current can be passed through a person sitting in it, especially those in which convicted criminals are executed by electrocution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electric chairs"@en .

aat:300391487 a skos:Concept ;
    skos:definition "Instruments of torture, consisting of a bedlike frame on which a victim was stretched by turning two rollers fastened at each end to the wrists and ankles. Introduced into the Tower of London about 1420 by the Duke of Exeter. Known colloquially as “The Duke of Exeter’s Daughter,” it was used to extract confessions and incriminating information. Similar devices were known in Ireland in the 17th century and later in Portugal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "racks"@en .

aat:300391488 a skos:Concept ;
    skos:definition "Composite volumes comprising two or more works, whether printed, manuscript, or both, that were created separately and later bound together, sometimes with additional pages tipped in. A Sammelband differs from an anthology, which contains intellectual content from multiple works, but which is typically originally made as a single physical object. For volumes containing separate treatises or other works, but having parts that were not necessarily physically created separately, use \"miscellanies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sammelbände"@en .

aat:300391489 a skos:Concept ;
    skos:definition "In archaeology, geology, and related disciplines, sites having features or characteristics that are used to define, or are paradigmatic of, a culture, stratigraphic level, or other pertinent feature or characteristic. For example, in archaeology, a type site could contain artifacts in an assemblage that are typical of that culture. The type site is often the eponym for the culture or feature, that is, the site after which the culture or feature is named."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "type sites"@en .

aat:300391490 a skos:Concept ;
    skos:definition "Ancient period, style, and culture dating from ca. 3200-2500 BCE in Tuscany and Latium. It is characterized by the development of copperworking, using minerals extracted from the Colline Metallifere. The type site for the culture is Rinaldone, Lazio."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rinaldone"@en .

aat:300391491 a skos:Concept ;
    skos:definition "African tree cultivated as a source of oil in West and Central Africa, where it originated, and in Malaysia and Indonesia, and as an ornamental tree in many subtropical areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elaeis guineensis"@en .

aat:300391492 a skos:Concept ;
    skos:definition "Monoecious trees with large leaves, having two accepted species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Elaeis"@en .

aat:300391494 a skos:Concept ;
    skos:definition "Ancient burial places covered with a large mound of earth, specific to England and dating from the Neolithic (ca. 4000 BCE) until late pre-Christian times (ca. 600 CE). For similar mounds, but of a type specific to Scotland, Ireland, and Wales, use \"cairns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "barrows"@en .

aat:300391495 a skos:Concept ;
    skos:definition "Ancient sepulchral mounds, particularly those created by the Bronze Age Tumulus culture evident in Europe from around 1600 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tumuli"@en .

aat:300391496 a skos:Concept ;
    skos:definition "Small to medium-sized settlements or groups of buildings that are constructed in long, narrow area, typically to follow a transport route, such as a road, river, or canal, or a coast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear settlements"@en .

aat:300391497 a skos:Concept ;
    skos:definition "Open expanses of elevated land, most often used in the plural. Examples are the treeless undulating chalk uplands of the southern England."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "downs"@en .

aat:300391498 a skos:Concept ;
    skos:definition "Monuments comprising rectangular or trapezoidal tumuli or earth mounds, often believed to be collective tombs. They are found at Neolithic sites in the British Isles and at later sites of Celtic, Slavic, and Baltic cultures of Northern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long barrows"@en .

aat:300391499 a skos:Concept ;
    skos:definition "Artificial earthen mounds, usually burial mounds, that are round and dome-shaped, sometimes with a very narrow, pointed top. Such mounds were especially prevalent with early indigenous inhabitants of midwest North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conical mounds"@en .

aat:300391500 a skos:Concept ;
    skos:definition "Prehistoric burial mounds or barrows of a distinctive type found in southern Russia and the Ukraine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kurgans"@en .

aat:300391501 a skos:Concept ;
    skos:definition "Tree species of Western Australia grows up to 130 feet high with a trunk up to 9.8 feet in diameter. Growing in gray sand, clay, or sandy loam, on hills or rises.The species exhibits a rough, gray-brown, vertically grooved, fibrous bark. The leaves are often curved, 3.1–5.1 inches long and 0.59–1.18 inches wide, shiny dark green above and paler below, with a light colored border. Its flowers roughly half an inch in diameter, are white or cream to pink, and appear in clusters, blooming in spring and early summer. The fruits are ovoid, 0.35–0.63 inches long and broad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus marginata"@en .

aat:300391502 a skos:Concept ;
    skos:definition "Administrative divisions or districts of the former Soviet Union, and presently used in other Eastern European countries, such as Moldova."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raions"@en .

aat:300391503 a skos:Concept ;
    skos:definition "The culture and style of the Hurrians, an ancient people of the Middle East during the 2nd millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hurrian"@en .

aat:300391504 a skos:Concept ;
    skos:definition "Vehicles with two wheels in tandem propelled by the rider straddling a frame mounting wheels seat and steering handle bars. These are the basic elements of most bicycles with the exception of those that have eliminated or dropped the top horizontal bar to accommodate women's skirts. Historically some bicycles with identical structure have been marketed as either \"men's bicycles\" or \"women's bicycles\" as fashions changed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "women's bicycles"@en .

aat:300391505 a skos:Concept ;
    skos:definition "An era following the Palaeozoic era, comprising both the Mesozoic and Cenozoic (Cainozoic) eras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neozoic"@en .

aat:300391506 a skos:Concept ;
    skos:definition "Genus of the family Sapotaceae containing over 100 species grows from Southeast Asia to the Pacific. The genus is best known as the source of gutta-percha, a product obtained from the latex of the tree (mainly Palaquium gutta of Sumatra, Malaya, Java, and Borneo) after tapping or cutting it down."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palaquium"@en .

aat:300391507 a skos:Concept ;
    skos:definition "The style and culture the originated with the Phocaeans, an ancient Ionian people from the Gulf of Smyrna, Anatolia (now the Gulf of İzmir, Turkey)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Phocaean"@en .

aat:300391508 a skos:Concept ;
    skos:definition "Species in the Sapotaceae family that grows up to 70 feet tall with dark brown outer bark, and pink inner. Inflorescences bear up to five flowers. Fruits are ellipsoid, up to 1 inch long. Named for the Italian naturalist Odoardo Beccari. Endemic to Borneo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palaquium beccarianum"@en .

aat:300391509 a skos:Concept ;
    skos:definition "Settlements or temporary stations featuring ports or harbors that are a safe place for pirates to dwell, repair their vessels, resupply, or avoid capture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pirate havens"@en .

aat:300391510 a skos:Concept ;
    skos:definition "Culture and style of the Faliscans, an ancient people of southern Etruria in Italy who, although Latin in origin, were culturally closer to the Etruscans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Faliscan"@en .

aat:300391511 a skos:Concept ;
    skos:definition "The culture and style of the ancient Venetii, people of northeastern Italy who arrived about 1000 BCE and occupied an area stretching south to the Po river and west to the Vero river. This culture is unrelated to the ancient Celto-Venetic culture of Britanny."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetic"@en .

aat:300391512 a skos:Concept ;
    skos:definition "The culture and style of the Celtiberians, a Celtic people of the Iberian Peninsula in the final centuries BCE who spoke the Celtiberian language. Archaeologically, the Celtiberians participated in the Hallstatt culture in what is now north-central Spain. Extant tribal names include the Arevaci, Belli, Titti, Lusones, and Berones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtiberian"@en .

aat:300391513 a skos:Concept ;
    skos:definition "Culture and style of the Qiang people, who were evident by 3,000 years ago and thought to be of Tibetan-Burmese origin; they were prominent in ancient Chinese culture in various areas. The Tangut people of the Tang, Sung, and Yuan Dynasties may be of a people of Qiang descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qiang"@en .

aat:300391515 a skos:Concept ;
    skos:definition "General term for relatively large areas, usually named but having undefined boundaries, where ancient cultures existed. For ancient administrative areas that are defined by historical boundaries, use \"former primary political entities\" or \"former administrative divisions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancient regions"@en .

aat:300391516 a skos:Concept ;
    skos:definition "The culture or style of the ancient Piceni, the Early Iron Age inhabitants of the Adriatic coast of Italy from Rimini to the Sangro River."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Picene"@en .

aat:300391517 a skos:Concept ;
    skos:definition "Writing system for Korean using Chinese ideograms. Distinct, although similar to \"kanji,\" which is used for writing Japanese."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hanja"@en .

aat:300391518 a skos:Concept ;
    skos:definition "Language of the ancient Akkadians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akkadian"@en .

aat:300391520 a skos:Concept ;
    skos:definition "Principal governing bodies of a town."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "town councils"@en .

aat:300391521 a skos:Concept ;
    skos:definition "Moribund language of the Finnic division of Finno-Ugric languages; closely related to Estonian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Livonian"@en .

aat:300391522 a skos:Concept ;
    skos:definition "The culture and style of the Volsci, an Italic tribe documented in the first century of the Roman Republic, when they inhabited the area south of Latium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Volscan"@en .

aat:300391523 a skos:Concept ;
    skos:definition "Vessels in the form of a caster, typically in order to match the other casters in a set, but lacking a pierced lid or having an interior sleeve to protect the contents. They may have a domed lid that may be opened or removed, to allow the contents to be extracted with a small spoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blind casters"@en .

aat:300391524 a skos:Concept ;
    skos:definition "Pigment prepared from jarosite mineral. Jarosite has been found on ancient Egyptian pottery, but this occurs in a context that makes it extremely unlikely to be an alteration product, as had been suggested previously. Previously not known as a historical pigment, jarosite has been identified as the yellow pigment in the murals of the temples of Karnak, Egypt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jarosite"@en .

aat:300391525 a skos:Concept ;
    skos:definition "Casters intended primarily for sprinkling table salt, particularly in historical and formal usage. Salt casters are usually of baluster or cylindrical shape, often of silver or other precious material, and have a pierced domed cover which was sometimes screwed to the container. They were often part of a set of casters, set on a tray at table, although caster sets often included saltcellars rather than casters. For similar items used to sprinkle salt, but forming one of a set of only two with a pepper shaker, particularly when made of more modest materials and intended for daily use in a household or restaurant, use \"saltshakers,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salt casters"@en .

aat:300391526 a skos:Concept ;
    skos:definition "Dishes or shallow bowls, usually of porcelain or glass, intended to contain pickles at table."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pickle dishes"@en .

aat:300391527 a skos:Concept ;
    skos:definition "Casters of various shapes intended for sprinkling cinammon or other spices, particularly such casters that were designed for general use at the dining table. For small casters designed specifically to be used to sprinkle sugar or cinammon on muffins in historical usage, use \"muffineers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spice casters"@en .

aat:300391528 a skos:Concept ;
    skos:definition "Casters of metal, glass, or porcelain, having finely pierced or meshed openings, intended for sprinkling powdered sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "powdered sugar casters"@en .

aat:300391529 a skos:Concept ;
    skos:definition "Vessels for pouring sugar, typically comprising a cylindrical container of glass or another material and a spout or other relatively large opening to allow pouring or dispensing of table sugar into a cup of coffee or tea. Sugar dispensers are typically found in diners, coffee shops, or other casual restaurants, and are intended to replace the sugar bowl with a more hygienic and neater device for dispensing sugar. For vessels to sprinkle sugar, use “sugar shakers” or \"sugar casters.\" For lidded bowls from which sugar is dispensed with a spoon at table, use \"sugar bowls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar dispensers"@en .

aat:300391530 a skos:Concept ;
    skos:definition "Vessels made of metal, glass, or ceramic and used in a kitchen or sometimes at table to sprinkle table sugar or powdered sugar over a bowl of fruit, cake, or other relatively large confection. Sugar shakers are generally, but not always, larger than a caster, often cylindrical in shape and have a pierced or mesh-covered lid; they are of a size that can be held comfortably in the hand or they may have a handle. For relatively large vessels having a spout from which to pour sugar into a cup, use \"sugar dispensers.\" For small casters, especially when they are part of a set of casters and intended for sugar, use \"sugar casters.\" For small casters used in historical contexts to sprinkle sugar on a muffin at breakfast or tea time, use \"muffineers (casters).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar shakers"@en .

aat:300391531 a skos:Concept ;
    skos:definition "Areas that are rich in coal deposits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coalfields"@en .

aat:300391532 a skos:Concept ;
    skos:definition "Language spoken in southern France, Italy's Occitan Valleys, Monaco, and Spain's Val d'Aran; collectively, these regions are sometimes referred to unofficially as Occitania. Occitan is also spoken in the linguistic enclave of Guardia Piemontese (Calabria, Italy). However, there are strong polemics about the unity of the language, as some think that Occitan is a macrolanguage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Occitan"@en .

aat:300391533 a skos:Concept ;
    skos:definition "Continental islands that are attached to the mainland by dry land, often forming peninsulas, at low tide."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tidal islands"@en .

aat:300393145 a skos:Concept ;
    skos:definition "The style and culture of the ancient Semitic people whose language was Paleo-Hebrew or Biblical Hebrew."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ancient Hebrew"@en .

aat:300393147 a skos:Concept ;
    skos:definition "A white to colorless mineral composed of calcium oxalate monohydrate. Whewellite is formed on the surface of marble and limestone due to the presence of microorganisms, such as lichen. It also occurs in geodes, or septarian nodules; associated with coal measures and surrounding rocks with organic material, and in some uranium deposits. As microscopic crystals in living plant cells and as calculi or as a sediment in the human urinary tract. Named for William Whewell an English naturalist, scientist, and inventor of the system of crystallographic indexing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "whewellite"@en .

aat:300393148 a skos:Concept ;
    skos:definition "Landscapes considered in the past or present as consecrated or important to a deity or a religion particularly including natural features, such as springs and caves. Also natural areas used for spiritual inspiration and to guide their contemplation of the divine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacred landscapes"@en .

aat:300393149 a skos:Concept ;
    skos:definition "The extinct Indo-European language of the Celtiberians, of the western part of the Iberian Peninsula."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtiberian"@en .

aat:300393150 a skos:Concept ;
    skos:definition "The culture and style of an ancient Celtic tribe formerly living on the coast of Brittany. This culture is distinct from the ancient Venetic culture from the area now comprising modern Venice, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celto-Venetic"@en .

aat:300393152 a skos:Concept ;
    skos:definition "Cultures and styles that thrived after ca. 1300 BCE, followint the Harappan period in the Indus Valley."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Post-Harappan"@en .

aat:300393154 a skos:Concept ;
    skos:definition "Portuguese expression of the Art Nouveau movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arte Nova"@en .

aat:300393155 a skos:Concept ;
    skos:definition "Refers to the style and culture of an African people living in Chad and Central African Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mbaï"@en .

aat:300393156 a skos:Concept ;
    skos:definition "Ropes, cords, or straps used as harnesses to guide or restrain mount or pack animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halters"@en .

aat:300393157 a skos:Concept ;
    skos:definition "Refers to the style or culture of a Bantu language speaking people living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tongwe"@en .

aat:300393158 a skos:Concept ;
    skos:definition "Refers to the style and culture of an African people living in Tanzania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bungu"@en .

aat:300393159 a skos:Concept ;
    skos:definition "The emotion comprising sympathetic pity and concern for the suffering, distress, or misfortune of another, accompanied by the desire to relieve it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compassion"@en .

aat:300393160 a skos:Concept ;
    skos:definition "Sheets of glass coated with light-sensitive emulsion that have been exposed and developed, and that are intended as matrices for the creation of positive photographic prints on another support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass plate negatives"@en .

aat:300393161 a skos:Concept ;
    skos:definition "Substances added to food for non-nutritional purposes, but for purposes such as to preserve the food, enhance flavor, or to improve or retain appearance. Additives such as salt, spices, and sulfites have been used since ancient times to preserve foods and make them more palatable. With the increased processing of foods from the 20th century onwards, there came a need for both the greater use of and new types of chemical food additives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "food additive"@en .

aat:300393162 a skos:Concept ;
    skos:definition "Large dinner plates, typically decorative and measuring 10-13 inches in diameter, that are placed on a formal dining table prior to dinner participants being seated and before food is served. The service plate remains at the place setting, with the bowls and plates of the dinner service placed on top of it, until the main entré is served, or until dessert is served; service plate use and etiquette varies by location and time period. For ceramic or metal platters for serving the meat course, use \"chargers (platters).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service plates"@en .

aat:300393163 a skos:Concept ;
    skos:definition "General term for any tool or instrument having a handle surmounted by prongs, usually two to six in number, used for digging, lifting, or securing food, earth, or many other substances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forks"@en .

aat:300393164 a skos:Concept ;
    skos:definition "Small, narrow, usually three-pronged forks made with short tines and a long handle, intended for eating appetizers or small pieces of seafood or oysters; often resembling a trident."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cocktail forks"@en .

aat:300393165 a skos:Concept ;
    skos:definition "In formal dining services, the plate of appropriate size for and used for serving the main course."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrée plates"@en .

aat:300393166 a skos:Concept ;
    skos:definition "In formal dining services, the plate of appropriate size for and used for serving the fish course. Such plates may have designs of fish upon them."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fish plates"@en .

aat:300393167 a skos:Concept ;
    skos:definition "Knives in a formal place setting, designed for use with the entrée, including cutting meat. The entrée knife is located on the right side closest to the plate, and is usually larger than the other knives in the setting. Usage and appearance may overlap with \"table knives,\" which have general purpose use at meals with less formal settings. For knives with serrated edges, made of more modest materials and used for cutting meat in informal dining, use \"steak knives.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrée knives"@en .

aat:300393168 a skos:Concept ;
    skos:definition "Dishes, often covered, that are designed and used to serve the main course at table. Entrée dishes are usually fine silver dishes, intended for formal use, and often date to the 17th-19th centuries. They may have a means of keeping the food warm, such as having a space for hot water or a candle. For more modern dishes used for keeping food warm at table or at a buffet, use \"chafing dishes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrée dishes"@en .

aat:300393169 a skos:Concept ;
    skos:definition "Forks in a formal place setting, designed for use with the entrée; located on the left side closest to the plate, and usually larger than the other forks in the setting. Usage and appearance may overlap with \"table forks,\" which have general purpose use at meals with less formal settings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "entrée forks"@en .

aat:300393170 a skos:Concept ;
    skos:definition "General term for sets of utensils for use when dining at table, particularly for formal dining; may include silver plate items as well as porcelain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table services"@en .

aat:300393171 a skos:Concept ;
    skos:definition "Musical works not in a specific form or of a specific type in which sound is generated or composed solely by computers or other electronic data-processing machinery via software or other means."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "computer music"@en .

aat:300393172 a skos:Concept ;
    skos:definition "Distinctive wooden spoons of the Middle East and North Africa, used for drinking the beverage sherbet; the same term is also used for such spoons intended for soup, rice, or pickles. Often having leaf-shaped bowls. Exquisitely carved spoons were a sign of status for the well-to-do. They were featured prominently at dinner gatherings, where they were the only utensils used. For drinking sherbet, the spoons were placed in ceramic basins full of the beverage, with their handles balanced on the side and their bowls floating atop the sherbet. A guest would drink from the spoon, then place it back in the basin for the use of the other guests. Spoons may appear in various sizes, depending upon the food item or beverage intended for consumption. The largest spoons were reserved for sherbet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sherbet spoons"@en .

aat:300393173 a skos:Concept ;
    skos:definition "Species of evergreen shrub or small tree native to Asia, but today cultivated widely in tropical and subtropical regions. It is known in several varieties. The leaves and leaf buds are used to produce the beverage tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camellia sinensis"@en .

aat:300393174 a skos:Concept ;
    skos:definition "A beverage originating in the Middle East and North Africa, made of fruit juice and water, sweetened, and often cooled with snow. In the European imitation, it is an effervescing drink."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sherbet"@en .

aat:300393175 a skos:Concept ;
    skos:definition "Glasses having tall, narrow conical-shaped bowls designed expressly for champagne and other sparkling wine. Used especially for modern glasses with this form, where the bowl is not typically not as tall as early flutes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "champagne flutes"@en .

aat:300393176 a skos:Concept ;
    skos:definition "Stemmed glasses designed for champagne, having a shallow broad bowl."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "champagne coupes"@en .

aat:300393177 a skos:Concept ;
    skos:definition "Of people and corporate bodies, the state of being professionally active. A common example is in reference to dates associated with people or corporate bodies, where the specific dates, and sometimes loci, of birth and death are unknown; the term is commonly so-used in the discipline of art history for estimated life dates based on the oeuvre or other documentation of the artist. It may refer to the time of the artist's apprenticeship through old age, regardless of whether this was his or her most prolific period. For people other than artists and architects, prefer \"flourished,\" which has the connotation of demarking that time when the person has achieved full development or success. However, usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "active"@en .

aat:300393178 a skos:Concept ;
    skos:definition "Of people, corporate bodies, styles, disciplines, etc., the activity or state of having achieved full development or success. A common example is in reference to dates associated with people or corporate bodies, where the specific dates, and sometimes loci, of birth and death are unknown; the term is commonly so-used in the discipline of library science for estimated life dates based on the publications of the author or other person. In the discipline of art history, prefer the term \"active,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flourishing"@en .

aat:300393179 a skos:Concept ;
    skos:definition "The activity or state of abiding in a particular place for any length of time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "residing"@en .

aat:300393180 a skos:Concept ;
    skos:definition "People, or sometimes animals, who occupy, dwells, or have an abode in a given place, typically on a long-term basis."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "residents"@en .

aat:300393181 a skos:Concept ;
    skos:definition "The state or activity of recording, or sometimes of being recorded in, a census, which is an official, usually periodic, lists of persons or property with varying degrees of descriptive detail."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "censusing"@en .

aat:300393182 a skos:Concept ;
    skos:definition "The state or activity of having or causing a beginning or a bringing into existence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "origination"@en .

aat:300393183 a skos:Concept ;
    skos:definition "Originally used in reference to sailing vessls, now used to refer to the state of people having come from a certain place. One common example of usage is when cataloging biographical information, the term is used to refer to a place where a person resided early in life, when the birth place is unknown or uncertain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hailing from"@en .

aat:300393184 a skos:Concept ;
    skos:definition "Sets of matching porcelain vases and other vessels, intended to be displayed together in a linear arrangment, as on a table or a wide mantel. For such arrangements having a clock as the central piece, use \"clock garnitures.\" For sets of matching armor, use \"garnitures (armor).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garnitures"@en .

aat:300393185 a skos:Concept ;
    skos:definition "Sets of decorative items, such as vases or candelabra, of a proper scale and design to be displayed together on a mantel. For groups of vases, whether or not to be displayed on a mantel, use \"garnitures (vases).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantel garnitures"@en .

aat:300393187 a skos:Concept ;
    skos:definition "The actions of legally, or sometimes informally, taking a child or other person who is not one's offspring into the relationship of parent/child. The term may also refer to similar arrangements between people and animals or between two animals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adoptions"@en .

aat:300393188 a skos:Concept ;
    skos:definition "The actions, rites, ceremonies, or agreements surrounding a formal arrangement between a man and a woman to marry at some future time. An engagement or betrothal is a promise to wed, and also the period of time between a marriage proposal and a marriage which may be lengthy or trivial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "betrothals"@en .

aat:300393189 a skos:Concept ;
    skos:definition "The ceremonies or procedures used to dissolve a marriage contract between a husband and wife, either by process of law or otherwise through ritual or other agreement of the society."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "divorces"@en .

aat:300393190 a skos:Concept ;
    skos:definition "The actions of separating or parting. A common example is the parting of a couple who are married, but who have not gone through a divorce."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "separations"@en .

aat:300393191 a skos:Concept ;
    skos:definition "The actions of declaring a status or state void or invalid. A common example is when a marriage between two people is annulled, returning each person's status to single, never married, rather than having been married and divorced."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "annulments"@en .

aat:300393192 a skos:Concept ;
    skos:definition "The condition of a person or animal having a bodily wound, hurt, sore, or loss."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "injury"@en .

aat:300393193 a skos:Concept ;
    skos:definition "The action or function of expelling a person from a country or state; an enforced status of exile and expatriation. For the general concept of prolonged absence from one's native land endured by compulsion, by circumstances, or voluntarily, prefer \"exile (sociological concept).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "banishment"@en .

aat:300393194 a skos:Concept ;
    skos:definition "The acts of coming to a place, such as landing on a shore or in a country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arrivals"@en .

aat:300393195 a skos:Concept ;
    skos:definition "The acts of leaving a place, such as exiting a country."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "departures"@en .

aat:300393196 a skos:Concept ;
    skos:definition "Trips taken by newly wedded couples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "honeymoons"@en .

aat:300393197 a skos:Concept ;
    skos:definition "The activities and period of time, such as an academic year, taken by a student as a break from formal education, either the period when leaving high school and starting a university or college course, or the period when leaving college and starting a profession. The time is often spent travelling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gap years"@en .

aat:300393198 a skos:Concept ;
    skos:definition "The process or status of having completed a course of learning and having received recognition of the completion. For the ceremonies surrounding graduation, use \"commencements.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "graduation"@en .

aat:300393199 a skos:Concept ;
    skos:definition "Activities associated with the order or authorization, often including a contract, for the production of a thing, performance, written work, or other such activity. Common examples are commissions for artists, architects, engineers, or construction companies for designs or construction of a building, piece of equipment, or work of art. For the work orders produced by the process of commissioning, use \"commissions (orders for work).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissioning"@en .

aat:300393200 a skos:Concept ;
    skos:definition "The undertaking of the responsibilities and duties of an office or position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assumptions"@en .

aat:300393201 a skos:Concept ;
    skos:definition "Occupations or other recurring activities that require an expert level of knowledge and achievement in some subject, field, science, or discipline, especially those activities that involve prolonged training and a formal qualification. For recurring jobs or livlihoods that do not necessarily involve this same high level of expertise, use \"occupations.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "professions"@en .

aat:300393202 a skos:Concept ;
    skos:definition "The state, condition, or activity of having left office, employment, or service permanently, especially when the person is older, has reached pensionable age, and wishes to pursue activities other than a profession or occupation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retirement"@en .

aat:300393203 a skos:Concept ;
    skos:definition "People who have left office, employment, or service permanently, especially when the person is older, has reached pensionable age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retirees"@en .

aat:300393204 a skos:Concept ;
    skos:definition "People newly admitted into some society, office, or position, often a novice or unpracticed person; it may carry the connotation of having been instructed in some secret knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "initiates"@en .

aat:300393205 a skos:Concept ;
    skos:definition "People who are unpracticed and newly admitted into some religious order, society, office, or position. For people newly admitted to an order or position, but without the connotation of necessarily being unpracticed, use \"initiates.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "novices"@en .

aat:300393206 a skos:Concept ;
    skos:definition "The activity and status of rule by a monarch, usually associated with a defined period of time and delimitation of the area ruled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reigns"@en .

aat:300393207 a skos:Concept ;
    skos:definition "General activity, condition, or employment of a domestic servant, a public servant, or in the military."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "service"@en .

aat:300393208 a skos:Concept ;
    skos:definition "The activity or condition of being active as a member of a branch of the military."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military service"@en .

aat:300393209 a skos:Concept ;
    skos:definition "The activity or condition of being employed as a servant attached to a household."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "domestic service"@en .

aat:300393210 a skos:Concept ;
    skos:definition "The activity or condition of being employed or otherwise working as a primary endeavor in the government or other public function."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public service"@en .

aat:300393211 a skos:Concept ;
    skos:definition "The action of placing or determining the place of something, or the state of existing in a place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "location"@en .

aat:300393212 a skos:Concept ;
    skos:definition "The action or condition of causing something, such as a group or society, to exist. Examples include establishment through the granting of legal status or by an official gathering together of members of a group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "establishment"@en .

aat:300393213 a skos:Concept ;
    skos:definition "The action or condition of causing something, such as a group of people or a settlement, to exist. Founding usually involves official documents and official naming, and occurs on a specific date. For reference to less formal beginnings of groups of people or other things, use \"establishment (action or condition).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundation"@en .

aat:300393214 a skos:Concept ;
    skos:definition "The action or condition of causing an organization or group of people to cease to exist. Dissolution may involve official documents and usually occurs on a specific date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dissolution"@en .

aat:300393215 a skos:Concept ;
    skos:definition "The activity or state of confinement to or accommodation in a hospital, which is a building equipped for the diagnosis of disease and for medical and surgical treatment of the ill and injured."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hospitalizations"@en .

aat:300393216 a skos:Concept ;
    skos:definition "The action or state of being officially consigned to the custody of others or to confinement. A common example is when a person is committed to a psychiatric hospital due to their being judged a danger to themselves or others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commitment"@en .

aat:300393217 a skos:Concept ;
    skos:definition "Refers to the early cultures marked by the development of cultivating plants. It usually coincides with the development of a sedentary lifestyle and the building of communities. This stage in human development occurred at different times in different areas; in some environments not conducive to farming or where natural plants and animals remain plentiful, this phase of culture did not develop."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farmer"@en .

aat:300393218 a skos:Concept ;
    skos:definition "People who gather flowers, fruit, or other wild plants or produce, whether for livlihood or sustenance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gatherers"@en .

aat:300393219 a skos:Concept ;
    skos:definition "Artificial earthen mounds with a flat summit, intended to support a structure or activity. They were particularly prominent in the Pre-Columbian American cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platform mounds"@en .

aat:300393220 a skos:Concept ;
    skos:definition "Formerly used to refer to prehistoric North American people who inhabited the Ohio and Mississippi valleys and other areas, characterized by the erection of mounds. It is now understood that this was not an identifiable culture, but that the mounds were instead constructed by a variety of peoples for various purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mound Builder"@en .

aat:300393221 a skos:Concept ;
    skos:definition "Distinctive culture of ancient Sardinia, dating 1900-400 BCE. It is characterized by, among other things, thousands of truncated conic structures made of huge blocks of basalt taken from extinct volcanoes; it predates the Phoenicians, who arrived here ca. 800 BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nuraghic"@en .

aat:300393222 a skos:Concept ;
    skos:definition "Culture of a pre-Nuraghic people of Sardinia living near what is now Ozieri."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ozieri"@en .

aat:300393223 a skos:Concept ;
    skos:definition "Styles and cultures found on the island of Sardinia and territories within its domain, including ancient and modern cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sardinian"@en .

aat:300393224 a skos:Concept ;
    skos:definition "Distinctive religious songs associated with African-American Christians of the southern United States; they were originally derived from African slaves having applied African musical elements to hymns that were ultimately European in origin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Negro spirituals"@en .

aat:300393225 a skos:Concept ;
    skos:definition "The language of the ancient people of Sumer in the Middle East."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumerian"@en .

aat:300393227 a skos:Concept ;
    skos:definition "Shiny black coating that is well-known on Athenian pottery. It is created by painting with a black slip mixture before a three-stage firing process. Oxygen is removed from the kiln in the first stage and the lack of oxygen and high temperature causes the clay to turn black while the slip mixture melts into black gloss. Oxygen is then re-introduced, causing the un-coated surface to turn red-orange. The black gloss is unaffected at this stage, and the coated area remains black."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black gloss"@en .

aat:300393228 a skos:Concept ;
    skos:definition "A technique that chemically analyzes a substance by measuring changes in its weight due to increasing temperature. It can be used to study the stability of materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermogravimetry"@en .

aat:300393229 a skos:Concept ;
    skos:definition "Moldable transparent plastic material made of compounds derived or synthesized from biological and/or palaeontological materials. Unlike traditional plastics, which are derived from petroleum, bioplastics are made from renewable resources and are biodegradable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bioplastics"@en .

aat:300393230 a skos:Concept ;
    skos:definition "The action or function of joining a professional guild."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guilding"@en .

aat:300393231 a skos:Concept ;
    skos:definition "Language of the ancient Akkadians in transliteration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Akkadian (transliterated)"@en .

aat:300393232 a skos:Concept ;
    skos:definition "The language of the ancient people of Sumer in the Middle East in transliteration)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Sumerian (transliterated)"@en .

aat:300393233 a skos:Concept ;
    skos:definition "Material that may be in the form of a gas, liquid, or solid that binds to and forms a film or layer on other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adsorbent"@en .

aat:300393234 a skos:Concept ;
    skos:definition "Nationality, culture, or style of the area of Hebei, China."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hebei"@en .

aat:300393235 a skos:Concept ;
    skos:definition "A species of Eucalyptus trees also known as Australian tallowwood. A tree is approximately 40 meters tall with red-brown or brown-black bark."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eucalyptus microcorys"@en .

aat:300393236 a skos:Concept ;
    skos:definition "Photographs produced by using photosensitive plant material. An emulsion of crushed flower petals or light-sensitive plants, fruit, or vegetables is created, then spread onto a sheet of paper and dried. The material to be imaged is placed on the paper and exposed to direct sunlight. The technique to create anthotypes was discovered by Sir John Frederick William Herschel ca. 1842."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anthotypes"@en .

aat:300393237 a skos:Concept ;
    skos:definition "Instruments that measure color changes and evaluate light stability in individual objects of art that are sensitive to light exposure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microfadeometers"@en .

aat:300393239 a skos:Concept ;
    skos:definition "Genre of Ottoman poetry that describes and honors beautiful people of a city or provincial town. The genre was most popular 16th-18th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "șehrengiz"@en .

aat:300393240 a skos:Concept ;
    skos:definition "A period in United States history following the U.S. Civil War and characterized by industrialization, political corruption, globalization, mass immigration, Western expansion, and widespread cultural and artistic activity. Historians generally agree that the Gilded Age lasted from about 1865 to around 1900."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gilded Age"@en .

aat:300393241 a skos:Concept ;
    skos:definition "Sculptures or statues in the United States that represent U.S. soldiers from World War I. The sculptures were commissioned around the country and are nameless."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doughboys"@en .

aat:300393242 a skos:Concept ;
    skos:definition "The language or dialect spoken in the Emilia area of Italy, and surrounding areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Emilian"@en .

aat:300393243 a skos:Concept ;
    skos:definition "Category of paintings derived from a description by the French Academy in 1717 of Antoine Watteau's variations of the \"fête champêtre\" genre. Fête champêtre (\"rural festival\") paintings portray costumed figures in an idealized, poetic setting, while fête galante (\"courtship party\") paintings are usually small in scale, and show groups of aristocratic men and women in pastoral settings engaged in amorous play."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fêtes galantes"@en .

aat:300393244 a skos:Concept ;
    skos:definition "Rococo paintings that portrays costumed figures in an idealized, poetic setting. The term translates to \"rural festival\" or \"outdoor feast,\" and the paintings are representations of rural feasts or open-air entertainment. The figures are often engaged in pleasurable activities such as eating, dancing, flirting, or listening to music. \"Fête galante\" is sometimes used as a synonym, but these are more graceful, usually aristocratic scenes with well-dressed figures in pastoral settings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fêtes champêtres"@en .

aat:300393245 a skos:Concept ;
    skos:definition "A form of iambic verse that consists of sets of three lines in which the middle line of each set rhymes with the first and last lines of the succeeding line. The series ends with a line that rhymes with the second line of the last stanza. Terza rima is in the following format: a b a, b c b, c d c, . . ., y z y, z. The first use is attributed to Dante's 'Divina Commedia.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terza rima"@en .

aat:300393247 a skos:Concept ;
    skos:definition "Textile hangings that are hung at the back of shrines behind images or objects in temples. Pichhavai translates to English as \"of behind\" or backdrop. The imagery painted on pichhavais varies with festivals and the seasons. They may be decorated with brocade, embroidery, appliqué work, jewels, or paint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pichhavais"@en .

aat:300393248 a skos:Concept ;
    skos:definition "Refers to the style or culture of the Australian Aboriginal people that traditionally inhabited land now known as the Yarra River Valley and Melbourne."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Wurundjeri"@en .

aat:300393249 a skos:Concept ;
    skos:definition "A principal dialect of central India, belonging to the Kolarian group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ho"@en .

aat:300393250 a skos:Concept ;
    skos:definition "The culture of the species of Homo sapiens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human"@en .

aat:300393251 a skos:Concept ;
    skos:definition "Hollow wooden memorial poles that were used by the ancient Yolngu peoples of Central and Eastern Arnhem Land to store the bones of the deceased during mortuary ceremonies. Modern artists produce new larrakitj to educate Indigenous and non-Indigenous people. Larrikitj are often painted with designs and symbols representing clans or relationships."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larrakitj"@en .

aat:300393252 a skos:Concept ;
    skos:definition "Aboriginal Australian hollow-log funerary poles that were used during the second mortuary ceremony of Central Arnhem Land. The second mortuary ceremony symbolized the transition of the soul of the deceased from this world to the afterlife. Made from a tree trunk, dupun are hollowed out, cleaned, and painted with a clan's totemic design. After the mourning period, the bones of the deceased are painted and put inside the dupun."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dupun"@en .

aat:300393253 a skos:Concept ;
    skos:definition "General term for organized belief systems having large numbers of adherents world-wide. The twelve religions typically included among the world religions are the following: Baha'i, Buddhism, Christianity, Confucianism, Hinduism, Islam, Jainism, Judaism, Shinto, Sikhism, Taoism, and Zoroastrianism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "world religions"@en .

aat:300393254 a skos:Concept ;
    skos:definition "A contemporary artistic movement that began in 1971 in Papunya, a settlement west of Alice Springs, Australia. In the early years of the movement, Western Desert men painted traditional designs on small boards. The artistic movement now is characterized by an increasing abstraction of motifs and includes women artists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Papunya"@en .

aat:300393255 a skos:Concept ;
    skos:definition "Long-handled wooden Maori clubs or fighting staffs that have a sharp tip at one end with carved or feather decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taiahas"@en .

aat:300393256 a skos:Concept ;
    skos:definition "Traditional Maori cloaks or mats made of flax and decorated with black twisted thrums or tassels that could be worn by both men and women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "korowais"@en .

aat:300393257 a skos:Concept ;
    skos:definition "Documents that enumerate and describe items, events, or presentations relevant to a festival, such as a film festival, art festival, or music festival."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festival catalogs"@en .

aat:300393258 a skos:Concept ;
    skos:definition "Ethnicity, culture, or styles from the area bordering upon the almost landlocked Baltic sea in northern Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baltic"@en .

aat:300393259 a skos:Concept ;
    skos:definition "Japanese art form and spiritual discipline that involves the formal placement and arrangement of flowers, branches, and sometimes other natural objects. Those who practice ikebana organize the objects according to strict rules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ikebana"@en .

aat:300393260 a skos:Concept ;
    skos:definition "Ceremonial mens' houses with highly symbolic decorative elements that are located in Papua New Guinea. They are used as meeting places for ceremonies, rituals, production workshops for making ritual objects, and sacred housing for ritual objects. Traditionally, women and uninitiated men were not allowed access to haus tambaran."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haus tambaran"@en .

aat:300393261 a skos:Concept ;
    skos:definition "Historical language or dialect spoken in the city of Lucca and the surrounding area in northwest Tuscany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lucchese"@en .

aat:300393262 a skos:Concept ;
    skos:definition "Portuguese-based creole language spoken in Macao."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Macanese"@en .

aat:300393263 a skos:Concept ;
    skos:definition "Catalan dialect of Mallorca."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mallorquin"@en .

aat:300393264 a skos:Concept ;
    skos:definition "Cambodian silk textile hangings in temples. These temple hangings are pictorial and are placed above and behind images of the Buddha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pidans"@en .

aat:300393266 a skos:Concept ;
    skos:definition "The school of philosophy and logic founded ca. 400 BCE by Euclides of Megara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Megaric"@en .

aat:300393267 a skos:Concept ;
    skos:definition "Very small stone tools, usually only a few centimeters in size and typically made of flint or chert, used by hunter-gathers and other ancient people throughout the world, at different times in Africa, Asia, and Europe. Microliths were often combined with wood, bone, resin and fiber to form composite tools or weapons, such as the points of spears and arrows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microliths"@en .

aat:300393755 a skos:Concept ;
    skos:definition "Romanian language in the Republic of Moldova, since 2013 not classified as a separate language. Officially written in Roman alphabet, although it may also be written in Cyrillic. It is a variant of the principal dialect of Romania, differing only in minor points of phonetics and vocabulary. It was treated as a separate language during Soviet rule and was accorded the status of national language in Moldova's 1994 constitution. Moldovan is officially written in the Roman alphabet, although for less formal writing many Moldovans continue to use the Cyrillic alphabet adopted under Soviet rule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Moldovan"@en .

aat:300395444 a skos:Concept ;
    skos:definition "Group of several Austroasiatic languages spoken by the Munda people in northern and central India. Some scholars divide the languages into two subfamilies. Characteristics of the Munda languages include three numbers (singular, dual, and plural), two gender classes (animate and inanimate) for nouns, and the use of either suffixes or auxiliaries for indicating the tenses of verb forms. In Munda sound systems, consonant sequences are infrequent, except in the middle of a word. Except in Korkū, where syllables show a distinction between high and low tone, accent is predictable in the Munda languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Munda"@en .

aat:300395460 a skos:Concept ;
    skos:definition "Nationality, style, and culture of the people inhabiting the shores of the Baltic Sea east of the Vistula up to the 17th century, related linguistically to the Lithuanians and Latvians."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Prussian"@en .

aat:300395461 a skos:Concept ;
    skos:definition "A West Baltic language formerly spoken on the shores of the Baltic Sea east of the Vistula, related linguistically to the Lithuanian and Latvian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old Prussian"@en .

aat:300395462 a skos:Concept ;
    skos:definition "Nationality and culture of the Punjab, a geographical region in South Asia comprising vast territories of eastern Pakistan and northern India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Punjabi"@en .

aat:300395463 a skos:Concept ;
    skos:definition "The dialect or viariety of French spoken Quebec."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Québécois"@en .

aat:300395464 a skos:Concept ;
    skos:definition "Buddhist sculptures that represent the footprint of the Buddha as he walked on the earth. The sculptures originated in India and are important symbolic devices."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhapadas"@en .

aat:300395465 a skos:Concept ;
    skos:definition "Textiles created by a particular technique and known for intense colors, fineness of weave, and dramatic designs. Patola-making developed in India. They are created through the technique of double ikat, where both the warp and weft threads are tie-dyed with patterns before weaving. When the silk threads are woven together, the dyed sections are aligned to form clear motifs. The process is complex, difficult, and labor intensive; the slightest misalignment of threads leads to indistinct motifs. Examples of usage of patolas include as saris for women and as shoulder cloths for men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patolas"@en .

aat:300395466 a skos:Concept ;
    skos:definition "East Central German dialects that emerged during the medieval German Ostsiedlung migration from about 1100. It is characterized by a rounding of the vowels and the weakening of consonants of Standard German."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thuringian"@en .

aat:300395467 a skos:Concept ;
    skos:definition "Ancient Italic language spoken in central Italy by the ancient Umbrians, particularly in the area of the Tiber River valley; it was displaced by Latin at an unknown date. It is closely related to Oscan and Volscian and more distantly related to Latin and Faliscan. Modern knowledge of the language is derived primarily from the Iguvine Tables, a set of bronze tablets discovered near Gubbio (ancient Iguvium) in 1444."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Umbrian"@en .

aat:300395468 a skos:Concept ;
    skos:definition "A variety of the Catalan language as spoken in Valencia, Spain, belonging to the Western group of Catalan dialects. A standardized form exists, based on the Southern Valencian subdialect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Valencian"@en .

aat:300395469 a skos:Concept ;
    skos:definition "A group of dialects of Italian spoken in northeastern Italy. It includes the dialects spoken in Venice (Venetian), Verona (Veronese), Treviso (Trevisan), and Padua (Paduan)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Venetan"@en .

aat:300395470 a skos:Concept ;
    skos:definition "Cultures of several Latin peoples from what is now Romania, Moldova, and the southern Balkan Peninsula, south and west of the Danube River; the term was used by Germanic people to distinguish the Roman descendants from the indigenous people in this area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vlach"@en .

aat:300395471 a skos:Concept ;
    skos:definition "Registries or other lists containing names, dates, and other information about members of a guild."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guild lists"@en .

aat:300395472 a skos:Concept ;
    skos:definition "Instruments used for seizing and holding objects or delicate tissues such as blood vessels, mainly in surgical operations, but in extended use as tools with a variety of purposes. They have long handles with grips like manicure scissors, a provision for clamping into fixed positions, and curved or straight tips."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hemostatic clamps"@en .

aat:300395473 a skos:Concept ;
    skos:definition "Dough wheels or other utensils for crimping, and usually sealing, a pie crust by pressing together the edges of the top and base in a series of indentations"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pie crimpers"@en .

aat:300395476 a skos:Concept ;
    skos:definition "General term for tools used to cut, shape, sew, or otherwise work leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leatherworking tools"@en .

aat:300395477 a skos:Concept ;
    skos:definition "Roofs comprising beams that are covered with plant material, such as reeds or straw, in thick mats arranged and connected to the beams and battens in a way so that rain water is shed. In European tradition, an underlayer of plant material is permanent, and the upper weathering layer is replaced or repaired as needed over time. In tropical traditions, thatching may cover the roof as well as one or more walls."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thatched roofs"@en .

aat:300395478 a skos:Concept ;
    skos:definition "People whose skill and profession is in thatching roofs of houses, corn or hay ricks, or other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thatchers"@en .

aat:300395479 a skos:Concept ;
    skos:definition "Rakes having relatively short, curved teeth and a handle, used for arranging and straightening the thatching material as it is laid on the roof or for removing the thatch (cut shafts of grass) after mowing. When used for roofing, the handle may be perpendicular to the rake or it may be attached on one end along the same plane as the rake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thatch rakes"@en .

aat:300395480 a skos:Concept ;
    skos:definition "Portable sets of equipment, bandages, and medications used for treating minor ailments or for administering aid a sick or injured person until full medical treatment is available."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first aid kits"@en .

aat:300395481 a skos:Concept ;
    skos:definition "Large spiked hooks, usually square-angled, that are driven into the rafter during roof thatching in order to secure courses of thatch as the thatcher works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thatching crooks"@en .

aat:300395482 a skos:Concept ;
    skos:definition "Extinct genus of the elephant family that lived from the Pliocene epoch (5 million years ago) into the Holocene (5,000 years ago) in Africa, Europe, Asia, and North America. They were characterized by having long, curved tusks a coat of long hair in colder climates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mammuthus"@en .

aat:300395483 a skos:Concept ;
    skos:definition "Tools made from a flat board attached to a handle, often studded with nails, coins, or the like, used for pounding, driving, and dressing the reeds or straws into place during thatching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leggets"@en .

aat:300395484 a skos:Concept ;
    skos:definition "Process of creating windows or other visual works using glass in cement or another matrix. Pieces of glass, usually slab glass, are laid out in a design or pattern; the pieces of glass may be cut, shaped, and chipped along the edges to resemble faceting. Cement or another material is poured between the pieces of glass, often with metal reinforcements, and allowed to harden."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass in concrete"@en .

aat:300395486 a skos:Concept ;
    skos:definition "In the strictest sense, very specialized blades that are disc-shaped, with a hole in the center for gripping, used in leatherworking primarily to thin the leather. For semi-circular or other rounded blades set transversely in a handle, but not fully round sharpened dics, use \"head knives\" or \"moon knives.\" For rotatable sharpened discs set into a handle or device, use \"rotary cutters.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "round knives"@en .

aat:300395487 a skos:Concept ;
    skos:definition "Cutting tools or machines having one or more disc-shaped blades that rotate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rotary cutters"@en .

aat:300395488 a skos:Concept ;
    skos:definition "Knives of various designs, usually with a curved blade, used to soften leather while it is stretched and hanging from a support that is called a \"perch.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "perching knives"@en .

aat:300395489 a skos:Concept ;
    skos:definition "Culture and style of ancient Pergamum, in northwest Anatolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pergamene"@en .

aat:300395490 a skos:Concept ;
    skos:definition "The culture or period of the Holy Roman Empire, a multi-ethnic complex of territories in central Europe during the medieval and early modern periods until its dissolution in 1806."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Holy Roman Imperial"@en .

aat:300395491 a skos:Concept ;
    skos:definition "Small printed cards on coated cardstock having a glossy surface resembling porcelain, usually bearing tradesmen's advertisements and often images. They may be lithographed or printed in combination with hand painting for metallic details. Production ceased in the late 19th or early 20th-centuries because the materials contained lead, which was toxic to the printers and painters who made the cards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porcelain cards"@en .

aat:300395492 a skos:Concept ;
    skos:definition "Culture and styles relating to the kingdom or tribe of Judah."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Judahite"@en .

aat:300395493 a skos:Concept ;
    skos:definition "Describes the culture or style of an African people living in Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Guji"@en .

aat:300395494 a skos:Concept ;
    skos:definition "Brief outlines or explanations of the features comprising a particular musical performance. These usually include the names of participants, titles of pieces, and other relevant criteria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concert programs"@en .

aat:300395495 a skos:Concept ;
    skos:definition "Cultures of ancient Pontus, a region and state of Anatolia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pontian"@en .

aat:300395496 a skos:Concept ;
    skos:definition "Cultures and styles of ancient Bithynia, a region of western Asia Minor, bordering the Black Sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bithynian"@en .

aat:300395497 a skos:Concept ;
    skos:definition "Culture and styles of ancient Epirus, located in modern northwestern Greece and southern Albania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Epirot"@en .

aat:300395498 a skos:Concept ;
    skos:definition "Extinct Germanic language that was spoken by the Goths. It is known primarily from the Codex Argenteus, a 6th-century copy of a 4th-century translation of the Bible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gothic"@en .

aat:300395499 a skos:Concept ;
    skos:definition "The culture and styles of Hindustan, an area in northern India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindustani"@en .

aat:300395500 a skos:Concept ;
    skos:definition "Style of ceramic made in China during the Qing-period (1644-1911) by commercial kilns for the domestic and export markets. It is characterized as overglazed enamel porcelain having a delicate rose pink derived from colloidal gold, in addition to a wide palette that facilitated a meticulous style of painting. For ceramics made in this style but manufactured elsewhere, use the broader term, “famille rose.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fencai"@en .

aat:300395501 a skos:Concept ;
    skos:definition "Administrative divisions of Russia. Similar to oblasts, but generally covering larger territories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "krays"@en .

aat:300395503 a skos:Concept ;
    skos:definition "Pans, often with legs, that are used to safely move hot coals from one location to another, or that fit under the grate of a coal stove and double as ash catchers. For small pails, generally made of metal, for holding or carrying coals, use \"coal hods.\" For similar equipment that allows the containment of coals but also the heating of a room or the cooking of food, use \"braziers (cooking, heating equipment.).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coal pans"@en .

aat:300395504 a skos:Concept ;
    skos:definition "Medals with Philip II of Spain, ruler of the Netherlands, on one side and on the other two hands clasped through a beggar's pouch. These were worn as a pendants from 1566 by rebellious noblemen to mark membership of their closed group."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beggar's medals"@en .

aat:300395505 a skos:Concept ;
    skos:definition "Special bells reserved for the death knell, which in monasteries and Christian settlements was rung originally to announce that a member of the community was dying. Later it was used to announce a death and solicit prayers for the soul. In some traditions, the tone of the ringing could be varied to distinguish between the death of an adult or child, and the number of strikes was used to indicate if the person was male or female."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "passing bells"@en .

aat:300395506 a skos:Concept ;
    skos:definition "Wood planks, with an integral handle, most often with detailed decorative carving on one side, used to press and smooth linen. Examples date from the 16th century, and are common to northern European countries such as Denmark, Sweden, Norway, and Holland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mangle boards"@en .

aat:300395507 a skos:Concept ;
    skos:definition "Platforms or racks on stands for holding votive candles, in churches or other devotional settings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "votive candle stands"@en .

aat:300395508 a skos:Concept ;
    skos:definition "Figures representing characters in the Christmas story, including infant Jesus in the manger, the Virgin Mary and Saint Joseph, sheep, the ox and ass, and other attending figures, such as shepherds, magi, and angels. The term is usually reserved for figures in the round, excluding relief sculptures or paintings. According to legend, Saint Francis of Assisi popularized the Christmas crèche in 1223 when he used live actors to portray the scene. Nativity figures are known in most Christian countries; the height of nativity figure development occurred in 17th-19th-century Naples, when churches competed with grad displays of large figures dressed in clothing, and elaborate village scenes were included."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nativity figures"@en .

aat:300395509 a skos:Concept ;
    skos:definition "Wood of Paulownia tomentosa, used in China, Korea and Japan to make objects including musical instruments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiri"@en .

aat:300395510 a skos:Concept ;
    skos:definition "Straight-sided glass vessels, often decorated, with a bulging wall that narrows slightly near the rim, resembling a club weapon. The largest of these glasses held half a liter of beer. Smaller examples were used for wine. The creation of such glasses flourished during the second half of the 15th century, particularly in the Netherlands and Germany."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "club-shaped beakers"@en .

aat:300395511 a skos:Concept ;
    skos:definition "Large candlesticks designed to stand in the choir of a Christian church, often at the choir stalls. For the large candlesticks used for the Paschal candle, use \"paschal candlesticks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choir candlesticks"@en .

aat:300395512 a skos:Concept ;
    skos:definition "Liturgical vestments comprising a shield-shaped panel of embroidery, artificially stiffened and sometimes adorned with a fringe, attached to the back of the cope. Cope shields evolved from the cappa or hood on the oldest form of copes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cope shields"@en .

aat:300395513 a skos:Concept ;
    skos:definition "Devices of metal or wood with rounded handles and cylindrical shafts that are inserted into holes in pinrails on traditionally rigged sailing ships to secure lines of rigging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "belaying pins"@en .

aat:300395514 a skos:Concept ;
    skos:definition "Drawings executed in chalk, which is a fine-grained limestone, or soft, earthy form of calcium carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chalk drawings"@en .

aat:300395515 a skos:Concept ;
    skos:definition "Very large clocks, typically those that are a feature of city embellishment in important squares and buildings. In addition to the clock itself, the mechanism may include various animations, for example those having astonomical or animated figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumental clocks"@en .

aat:300395516 a skos:Concept ;
    skos:definition "Instruments for gauging the purity of milk, such as for ascertaining the comparative value of each cow's milk in a dairy. The instrument is made of glass with a weighted bulb at the end and a graduated stem at the top. If the milk sample is pure, the lactometer floats on it and if it is adulterated or impure, the lactometer sinks. It is often used with instruments to determine the percentage of butterfat in milk, \"butyrometers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lactometers"@en .

aat:300395517 a skos:Concept ;
    skos:definition "Shoemaker's tools for extracting the last, which is a model of the foot, from a finished shoe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "last hooks"@en .

aat:300395518 a skos:Concept ;
    skos:definition "Boards on which type is placed or to which letters may be fixed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "letter boards"@en .

aat:300395520 a skos:Concept ;
    skos:definition "Leatherworking tools of various designs and made of bone, ivory, or smooth wood, designed to burnish and smooth leather, for example, in shoemaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polishing bones"@en .

aat:300395521 a skos:Concept ;
    skos:definition "Candlelabra with three, five or seven candleholders on a slanting or semi-circular arm, mostly belonging to a set of two or three. Are usually set out for the midday Benediction (blessing) on Sundays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benediction candelabras"@en .

aat:300395522 a skos:Concept ;
    skos:definition "Chisel-like tools designed for use in plumbing, typically having a blunt end and curved blades, pushed ans struck with a hammer to force lead and oakum in the collars of pipes to make them watertight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plumber's caulking irons"@en .

aat:300395523 a skos:Concept ;
    skos:definition "Stringed instruments that combine six-stringed guitar setups on a lute bowl; later versions had up to 11 strings. They were common in Germany and elsewhere from around 1850. They resemble medieval and Renaissance bass lutes harps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lute guitars"@en .

aat:300395524 a skos:Concept ;
    skos:definition "In the context of Christian liturgical accessories, the holders that secure the host in the monstrance. Originaly lunettes were crescent-shaped clips made of gold or silver-gilt, used for securing the host in a monstrance. In more recent centuries, the host is enclosed in a pyx the same size as the host, with two glass faces, and this pyx is itself is inserted into the apperture of the monstrance. This newer-style holder is also called a lunette, although it is no longer crescent-shaped."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lunettes"@en .

aat:300395525 a skos:Concept ;
    skos:definition "Transverse beams in Christian churches that span the nave at the entrance to the chancel or choir, and that separated the area around the altar from the area set aside for the laity. They are most common in the Middle Ages or early Renaissance Later, 'rood screens' developed between the beam and the floor. The rood beam may bear carved or painted portraits of the apostles, but most often is surmounted by a triumphal cross or crucifix. Rood lofts also later evolved above the rood beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rood beams"@en .

aat:300395526 a skos:Concept ;
    skos:definition "Appliqué in which cut pieces of fabric with embroidery stitches are applied to a secondary ground fabric, or in which the embroidery itself acts to attach the applied material to the ground."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appliqué embroidery"@en .

aat:300395527 a skos:Concept ;
    skos:definition "Prints, photographs, or drawings that have been decorated or enhanced by affixing cut-outs of fabric or paper, using watercolor, or other adornments. Creating such works became a popular hobby in the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "appliqué prints"@en .

aat:300395528 a skos:Concept ;
    skos:definition "Benches designating the location where food and other donations for impoverished or unfortunate people are distributed. Primarily used in historical contexts, for such benches on the premises of churches, hospitals, guilds, private estates, or other establishments that distributed alms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almoners benches"@en .

aat:300395529 a skos:Concept ;
    skos:definition "Tokens distributed by any civil, church, or parish council to needy citizens or parishioners. These could be exchanged for clothing, food, fuel, drink or a coffin, all according to the symbol, letter or text it bore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alms tokens"@en .

aat:300395530 a skos:Concept ;
    skos:definition "Benches designed to allow the detainment of prisoners or others. The benches may be enclosed or open, and may be designed to allow the attachment of restraints. The purpose of the benches varied in periods of history and various contexts: purposes include as a temporary means of detainment prior to imprisonment or trial, to shame the citizen in a public place, or to allow the detainees to attend a religious service or other event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prisoners' benches"@en .

aat:300395531 a skos:Concept ;
    skos:definition "Containers or dishes for holding the ashes used for Ash Wednesday rites or similar Christian rituals. The ashes usually comprise burnt palm fronds that had been blessed at Palm Sunday of the previous year, to be sprinkled or annointed on the forehead of participants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ash pyxes"@en .

aat:300395532 a skos:Concept ;
    skos:definition "Hides or skins that have been stripped from a dead animal, with hair, wool, or feathers attached; the legs, tail, and head may also be attached. For skins with hair that are used as a material, prefer \"pelt (animal material).\" For pelts mounted and represented as a three-dimensional animal, use \"taxidermy mounts.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pelts"@en .

aat:300395533 a skos:Concept ;
    skos:definition "Liturgical containers, often in the shape of coffins, that hold sacred earth or ashes from Ash Wednesday that are meant to be buried in the coffin of a deceased person, so that the dead is considered buried in consecrated ground. This practice dates from a period in which Catholics were forbidden to perform religious rites in Dutch cemeteries. In Old Catholic parishes this practice is still in use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaardingskistjes"@en .

aat:300395534 a skos:Concept ;
    skos:definition "Guides required when chiseling with percussion drills. The adapters prevent the chisel rotating with the drill."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chisel adapters"@en .

aat:300395535 a skos:Concept ;
    skos:definition "Pieces of cloth that are used to envelop the hands of the celebrant when holding the monstrance during the Benediction of the Blessed Sacrament and on other occasions. It takes the place of the humeral veil, which is also used for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benediction cloths"@en .

aat:300395536 a skos:Concept ;
    skos:definition "Ecclesastical stoles that are of shorter length and designed for travel, used when the priest administers sacraments outside the church building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visitation stoles"@en .

aat:300395537 a skos:Concept ;
    skos:definition "Distinctive Christian visual works having the hortus conclusus (enclosed garden) iconographical theme; best known from the late medieval period through the 17th century, often in female monastic settings. They typically took the form of low-relief panels or assemblages, for example with a central sculpture and elaborate textile or wax flowers, embroidery work. They portrayed the Virgin Mary, Crucifixion, or other sacred figure surrounded by flowers and plants. They developed in the southern Netherlands, but were found in northwestern Germany and elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "besloten hofjes"@en .

aat:300395538 a skos:Concept ;
    skos:definition "Crowns having a circlet surmounted by one or more arched bands that connect opposite points on the circlet. The hooped crown seems to have first developed in Carolingian states in the 8th century, perhaps derived from a hooped helmet. Hooped crowns may have two or more arches that intersect, or the hoops may comprise half-arches, often with an orb surmounting the intersection. Hooped crowns are generally royal or imperial crowns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooped crowns"@en .

aat:300395540 a skos:Concept ;
    skos:definition "Lists or menus of the different types of alcoholic drinks obtainable in a bar, generally including prices or units of sale."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar tariffs"@en .

aat:300395541 a skos:Concept ;
    skos:definition "Printed paper that is added to the packaging of trademarked medicines, and that contains data on ingredients, dosage, method of administeration, indications and contraindications, possible side effects, and precautions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patient package inserts"@en .

aat:300395543 a skos:Concept ;
    skos:definition "Shirts or longer garments made of haircloth, which is a stiff, unsupple fabric. Hairshirts were worn next to the skin, sometimes under other clothing, by ascetics and penitents of several religions. They were also worn by certain ancient troops, to make them tougher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hairshirts"@en .

aat:300395545 a skos:Concept ;
    skos:definition "Scapulars of cloak-style or small scapulars worn by Christian penitents, typically under clothing; they may be made of rough wool and decorated with the crucifix and instruments of the Passion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penitential scapulars"@en .

aat:300395546 a skos:Concept ;
    skos:definition "Wooden mallets, often having ribbed striking surfaces, that are used to crush, break down, and flatten stalks of flax, hemp, reed, or another plant, as part of the process of producing fiber."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bruising mallets"@en .

aat:300395547 a skos:Concept ;
    skos:definition "Poles mounted with hooks on one end that are used to pull or push a boat to or from another boat or fixed object. Usually the working part is comprised of a half rounded, pointed hook used to pull, and a straight point used to push. These are forged together on a socket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "boat hooks"@en .

aat:300395548 a skos:Concept ;
    skos:definition "Ceremonial chains worn to signify membership in a specific guild or order; often incorporating various forms of links and shields or plates. They may be attached to a textile support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guild chains"@en .

aat:300395549 a skos:Concept ;
    skos:definition "Mould for making chocolate bars, truffles and hollow chocolate figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chocolate molds"@en .

aat:300395550 a skos:Concept ;
    skos:definition "Tokens engraved with name of a person and date to commemorate the baptism. Early tokens are of brass or precious metal; later examples may be made of various materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening tokens"@en .

aat:300395551 a skos:Concept ;
    skos:definition "Prints notifying the birth and baptism of a child, generally with baptismal names listed, as well as the names of godparents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening cards"@en .

aat:300395554 a skos:Concept ;
    skos:definition "Small rakes used to tend domestic hearths, fireplaces, or coal stoves. They often form part of a set of fire irons. For larger hand-held rakes used in fighting wildfires, use \"fire rake ( firefighting equipment).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fireplace rakes"@en .

aat:300395556 a skos:Concept ;
    skos:definition "Coopers' tools for ploughing the groove or channel in cask staves, for the attachment of the barrel heads; the channels themselves are also called \"crozes.\" The tools may be mounted with a channel-cutting tooth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crozes"@en .

aat:300395558 a skos:Concept ;
    skos:definition "Shallow drinking cups or bowls, with curved sides and flattened bases, typically made from forest glass. Often decorated with ribs or moderately high bosses or prunts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maigeleins"@en .

aat:300395559 a skos:Concept ;
    skos:definition "Sleeveless knee-length vestments worn by cardinals, bishops, and certain other high-ranking ecclesiastics.The color of the garment indicates rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mantellettas"@en .

aat:300395560 a skos:Concept ;
    skos:definition "Vertical architectural wall elements comprising wooden posts; used often, but not exclusively, in interior roof construction. For posts carried on corbels or other elements partway up the wall in open-timber roof trusses, use \"pendant posts\"; see also \"crown posts.\" For solid supports of masonry or another material that extend the full height of the wall, and that are designed to sustain vertical pressure, use \"piers (supporting elements).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wall posts"@en .

aat:300395562 a skos:Concept ;
    skos:definition "Tools comprising bent or straight blades attached to wood handles or helves. The blades are usually sharpened and smooth, and are used variously as cutting or gathering tools. As a cutting tool, reaping hooks are used to cut grain with a rapid chopping motion. For similar tools used to cut grain with a short sawing motion, use \"sickles.\" Serrated cutting edges generally distinguish sickles from reaping hooks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reaping hooks"@en .

aat:300395563 a skos:Concept ;
    skos:definition "Keys having a special faceted, splined, or slotted shank. An example of use is for mortise rack bolts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bolt keys"@en .

aat:300395564 a skos:Concept ;
    skos:definition "Slender tubes, usually glass, of small caliber and used for obtaining a known small volume of a liquid, especially in laboratory work; often incorporating a swollen central reservoir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipettes"@en .

aat:300395565 a skos:Concept ;
    skos:definition "Large wooden puck-like objects used in the Dutch game of platte bol and for other traditional Dutch games. For similar objects used for ice hockey, use \"hockey pucks.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plattebollen"@en .

aat:300395566 a skos:Concept ;
    skos:definition "Sculpted figures in mourning displayed on sepulchral monuments or tombs. Based on Antique examples, they became popular as small figures, often family members, in niches on European sepulchral monuments in the 13th century. By the 14th century the first representations appear of the heavily cloaked and cowled professional mourners who were normally employed to follow the coffin in a funeral procession. In later centuries, weeping or fainting angels or female figures became common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "weepers"@en .

aat:300395567 a skos:Concept ;
    skos:definition "Costume accessories comprising a wire frame for supporting a large ruff or collar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "supportasses"@en .

aat:300395568 a skos:Concept ;
    skos:definition "Monumental altars having a superstructure resembling a portico, originally including two or more pillars and a pediment, usually with a sculptural group or altarpiece. The Christian form developed from ancient altars, such as the Pantheon; it was most common in the Renaissance and Baroque periods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portico altars"@en .

aat:300395569 a skos:Concept ;
    skos:definition "Round, broad-brimmed ecclesiastical hats with low crowns made of felt or beaver hair. Prelatial hats are black, except those worn by the pope or cardinals. A silk band or cord with tassels encircles the crown, with the color indicative of the wearer's rank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prelatial hats"@en .

aat:300395571 a skos:Concept ;
    skos:definition "Books containing litanies, hymns, and other materials for use in religious processions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processionals"@en .

aat:300395572 a skos:Concept ;
    skos:definition "Toys for very young children, consisting of a hollow object enclosing small, loose beads that strike against each other when they are shaken."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby rattles"@en .

aat:300395573 a skos:Concept ;
    skos:definition "Womens' fashion accessories comprising clamps, typically metal and decorative, that were attached to long, trailing skirts to hold them up off the floor; used particularly in the later 19th century. The skirt lifter was often attached to a cord or ribbon that was hung from the waist by a chatelaine. The wearer used the skirt lifter when necessary, such as when walking up stairs or dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skirt lifters"@en .

aat:300395575 a skos:Concept ;
    skos:definition "Coverings and curtains, usually black in color, placed over sculptures, paintings, mirrors, and other elements at an altar or elsewhere in a church, or in another public or private building; used to signify mourning, such as during a requiem service or during a mourning period. For similar coverings designed particularly for the Lenten season, prefer \"Lenten veils.\" For banners used in procession or hung in funerary settings, use \"mourning banners.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning cloths"@en .

aat:300395576 a skos:Concept ;
    skos:definition "Tokens distributed at funerals, often guild funerals and particularly in the Netherlands and Belgium, as evidence of attendance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funeral tokens"@en .

aat:300395577 a skos:Concept ;
    skos:definition "Shrines erected by the side of the road as stations devoted to honor or worship of a deity or sacred figure of any faith. It may incorporate an altar or image of the deity; it may mark a crossroad. Examples include those found in ancient Egypt, Greece, Rome, India, Japan, and in Christian Europe and the Americas. For crosses serving as roadside markers, use \"wayside crosses.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wayside shrines"@en .

aat:300395578 a skos:Concept ;
    skos:definition "Altars for which the mensa rests on a sarcophagus containing relics. These developed from the Early Christian practice of celebrating the Eucharist slabs placed directly on the tombs saints. The creation of sarcophagus altars flourished in the 16th-17th centuries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sarcophagus altars"@en .

aat:300395579 a skos:Concept ;
    skos:definition "Hand held cutting devices similar to scissors, designed to cut the woolen fleece from sheep. The earliest examples date to Bronze Age Crete."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheep shears"@en .

aat:300395580 a skos:Concept ;
    skos:definition "Devices used to ring bells, often decorative and comprising long, narrow embroidered textiles attached to a bell-wire, hanging against an interior wall. Used to ring servant bells, and later as purely decorative objects hung on walls or laid over furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell-pulls"@en .

aat:300395581 a skos:Concept ;
    skos:definition "Medals that are formed by two halves that screw together to form a shallow, medal-shaped box.These usually contain one or more images on the inside surfaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "box talers"@en .

aat:300395582 a skos:Concept ;
    skos:definition "Stoppers for uncorked bottles that have decorative or whimsical tops. The object may have a shaft of cork or another material; modern stoppers are often made of metal and plastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ornamental corks"@en .

aat:300395583 a skos:Concept ;
    skos:definition "Hollow tubular objects used to hold cigars while they are being smoked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigar-holders"@en .

aat:300395584 a skos:Concept ;
    skos:definition "Mechanical devices of various form designed for rolling cigarettes in bulk or individually."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cigarette rollers"@en .

aat:300395585 a skos:Concept ;
    skos:definition "Drinking glasses that have a complex, often twisting and intertwined, stem. The glasses may be flutes, goblets, wine glasses, or of many other forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serpent-stem glasses"@en .

aat:300395586 a skos:Concept ;
    skos:definition "Hard, dense, often shiny, mineral composed of zinc carbonate. Smithsonite was the principal source for zinc prior to 1880. It has been found in Greece, Germany, Austria, Poland, Italy, Rhodesia, and the United States. Smithsonite can be white, gray, green, blue, yellow, purple, pink, or brown. It occurs as a secondary mineral in the oxidized zones of hydrothermal ore deposits. Formerly confused with hemimorphite, and both were called calamine; see \"calamine(mineral admixture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smithsonite"@en .

aat:300395587 a skos:Concept ;
    skos:definition "Personal accessory comprising wide lengths of lightweight fabric worn at night over styled moustaches to help them retain their shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moustache bands"@en .

aat:300395588 a skos:Concept ;
    skos:definition "Recorders with a range of two octaves from the C above middle C upward. They are the type most commonly used in schools for music education."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soprano recorders"@en .

aat:300395589 a skos:Concept ;
    skos:definition "Hand-held medical tools or implements designed for insertion into and viewing within body orifices. Various forms are based on the specific use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "specula"@en .

aat:300395590 a skos:Concept ;
    skos:definition "Lutes constructed so that the neck penetrates the sound box, having long thin necks and small bodies, usually covered with skin. The strings are normally lifted well above the neck by a high bridge. The form developed into \"spike fiddles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pierced lutes"@en .

aat:300395591 a skos:Concept ;
    skos:definition "Tools with t-shaped handles mounted on a screwing device on a support used to pull bungs from barrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bung-drawers"@en .

aat:300395592 a skos:Concept ;
    skos:definition "Medals bearing images that satirize public figures or events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satirical medals"@en .

aat:300395593 a skos:Concept ;
    skos:definition "Locks of various designs that are key operated or keyless letter-combination type, originating in China. When they are locked, the sliding bolt is trapped by the opening springs against the inner wall of the lock-body. They are often decorative objects as well as utilitarian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "splitting-spring locks"@en .

aat:300395594 a skos:Concept ;
    skos:definition "Steel helmets of a distinctive style developed by the Imperial German Army to replace the traditional boiled-leather \"pickelhaubes\" (spiked combat helmets) in 1916 during World War I. Stahlhelms comprised a steel outer shell with a liner made of a headband and padding materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Stahlhelms"@en .

aat:300395595 a skos:Concept ;
    skos:definition "Leatherworking hand tools of varying form, comprising metal shafts with flattened ends, mounted in wooden grips; used primarily but not exclusively in shoemaking. The metal end is pressed between the welt outsole stitches in order to separate, tighten, and make the stitches stand above of the welt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stitch pricks"@en .

aat:300395596 a skos:Concept ;
    skos:definition "Oversized chalices, bowls, or urns used for collecting ballots by a papal conclave, monastic election, or other religious institutions' election, typically when choosing a leader."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ballot chalices"@en .

aat:300395597 a skos:Concept ;
    skos:definition "Pegs around which the strings of a stringed instrument are passed, and by turning which they are tuned to the correct pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tuning pegs"@en .

aat:300395598 a skos:Concept ;
    skos:definition "Instruments used for examining the chest or other part by auscultation, the sounds of the heart, lungs, or other internal organs being conveyed by means of it to the ear of the observer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stethoscopes"@en .

aat:300395599 a skos:Concept ;
    skos:definition "Medals, usually Dutch but also found in South Africa and elsewhere, issued to raise money for the victims of wars or natural disasters, for arts patronage, nature preservation, or another cause. They are considered numismatic collectibles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "steunpennings"@en .

aat:300395600 a skos:Concept ;
    skos:definition "Tools comprising a pole to which one or more hooks are affixed, such as carriage poles, boat hooks, poles used to retrieve items from high shelves, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pole hooks"@en .

aat:300395601 a skos:Concept ;
    skos:definition "Bell-shaped jars, placed open-end down on a base and usually sealed, for display or storage of artifacts, natural specimens, dried flower arrangements, figurines, objets d'art, or other decorative items. For bell-shaped glass covers used to protect living plants, use \"bell glasses (horticultural containers).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell jars"@en .

aat:300395602 a skos:Concept ;
    skos:definition "Neckwear comprising narrow strips of fabric, typically white in color and sometimes trimmed with lace, that are basted as liners inside the neck of an ecclesiastical stole or other similar non-ecclesiastical garment to protect it from soiling due to contact with the skin. For medium-sized to large outerwear collars that resemble fashion stoles, use \"stole collars (outerwear collars).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stole collars"@en .

aat:300395603 a skos:Concept ;
    skos:definition "Monstrances in which the circular theca is encircled with stylized rays, indicating a glory emanating from the host within. The form dates from the 16th century, and has persisted to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sunburst monstrances"@en .

aat:300395604 a skos:Concept ;
    skos:definition "Game pieces used in the game of the same name that originated in Belgium The piece comprises a sculpted wooden bird, often decorated, with a metal pin in the beak, that is suspended from the ceiling or a cross beam by rope. The bird is aimed at a target by players, not unlike a game of darts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "struifvogels"@en .

aat:300395606 a skos:Concept ;
    skos:definition "Drinking glasses, usually crystal or glass, in the shape of a handbell, having a bell-shaped bowl, a stem without a foot, and often a clapper. The bell is rung when the glass has been emptied. The glass can only stand when empty and turned upside down. For bells found on tables to call attendants during meals, use \"table bells (clapper bells).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tafelbels"@en .

aat:300395607 a skos:Concept ;
    skos:definition "Pots, usually terracotta, with conical lids, traditionally used in North Africa to slowly simmer sweet and spiced fruit, vegetables and meat, or other foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tagines"@en .

aat:300395608 a skos:Concept ;
    skos:definition "Large, often mace-like batons wielded by a drum major to keep measure in marching bands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drum major batons"@en .

aat:300395609 a skos:Concept ;
    skos:definition "Key with teeth that lifts the levers or catches in a lever tumbler lock to free the bolt to move."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bitted keys"@en .

aat:300395610 a skos:Concept ;
    skos:definition "Candlesticks, triangular in shape with candles ascending from the two upper arms, used in the Christian service of Tenebrae, which includes Matins and Lauds during the last three days of Holy Week. The use of these candlesticks fell into disuse in Catholic churches after the Second Vatican Council, but has since been revived in various places. The form of the candlestick developed from candles on the original hearses, which were supporting structures that had trench-like bars with candles, and which were originally used to support or transport coffins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenebrae hearses"@en .

aat:300395611 a skos:Concept ;
    skos:definition "Receptacles of various types that contain holy relics. Usage has varied over time. In modern usage, the term refers to relatively small disc-shaped, glass-faced metal receptacles for relics, often designed so that they may be inserted into reliquary monstrances. In Early Christian usage, the term referred to cells or openings dug into walls to hold the corpse. For discs or clips that secure a host in a monstrance, use \"lunettes (monstrance clips).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thecae"@en .

aat:300395612 a skos:Concept ;
    skos:definition "Brand name vessels with double insulating walls separated by a vacuum that serve to regulate the temperature of liquids stored within. For the generic object originally invented by Sir James Dewar use \"vacuum flasks.\" Thermos (TM) is a proprietary name for these objects. With a small initial 'thermoses' is frequently applied loosely to vacuum flasks in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Thermoses (TM)"@en .

aat:300395613 a skos:Concept ;
    skos:definition "Boxes used to store tinder, which is a flammable substance that readily takes fire from a spark and burns or smolders such as partially charred linen or corkwood. The box also typically contained the flint and steel with which the spark was struck, and sometimes the brimstone matches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tinder boxes"@en .

aat:300395614 a skos:Concept ;
    skos:definition "Tower-shaped monstrances, having decorative architectural elements such as pinnacles, for displaying the Host (the bread consecrated in the Eucharist) in Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tower monstrances"@en .

aat:300395615 a skos:Concept ;
    skos:definition "Devices or appliances intended to toast sandwiches, which are food items comprising two pieces of bread with meat or other fillings between. Sandwich toasters have two grills or heated elements that enclose or press the sandwich between them. Modern devices may be electric. Designs for manual use resemble tongs; the earliest examples were cast-iron clamps with long handles that could be plunged into a kitchen fireplace or outdoor camp fire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sandwich toasters"@en .

aat:300395616 a skos:Concept ;
    skos:definition "Baroque traversos are the forerunners of modern transverse flutes. They were commonly made of wood, and have simpler system of valves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baroque traversos"@en .

aat:300395618 a skos:Concept ;
    skos:definition "Forceps designed to assist childbirth, usually consisting of two branches that are positioned around the fetal head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "obstetric forceps"@en .

aat:300395619 a skos:Concept ;
    skos:definition "Chairs designed for the use of the priest or other celebrant presiding at a Christian mass or other service. The chairs are usually of substantial size and having arms, placed in the choir of the church. For a set of three chairs or seats on a recessed bench for the celebrant, deacon, and sub-deacon, use \"sedilia.\" For the chairs of a presiding bishop, use \"cathedrae (bishop's chairs).\" For chairs specifically for a presiding Protestant preacher, use \"preacher's chairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "presider's chairs"@en .

aat:300395620 a skos:Concept ;
    skos:definition "Presses of various designs used to squeeze out excess fat from meat, in order to to extract the fat for use as lard or tallow or to make the meat healthier for consumption."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fat presses"@en .

aat:300395621 a skos:Concept ;
    skos:definition "Rings used to say the Christian rosary prayer beads. The surface of the ring is marked with a decade, ten beads or protruding knobs and a cross, to serve as counters to track number of prayers said."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "finger rosaries"@en .

aat:300395622 a skos:Concept ;
    skos:definition "Metal racks, usually comprising a round metal band supporting multiple hooks, that were hung from the ceiling or another support and used to hang meat. The racks are usually historical. Antique crown meat racks are sometimes used in modern kitchens as pot racks"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crown meat racks"@en .

aat:300395623 a skos:Concept ;
    skos:definition "Contrivances of various forms designed for luring and trapping flies or other flying insects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fly traps"@en .

aat:300395624 a skos:Concept ;
    skos:definition "Describes a variety of glass beakers, usually conical in shape, that incorporate round, flat, or semi-conical feet at their bases. Most often applied to beakers produced between 1300-1700."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footed beakers"@en .

aat:300395625 a skos:Concept ;
    skos:definition "Keys that are hinged and can be folded to take less space or to protect the blade. These often have multiple keys hinged together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding keys"@en .

aat:300395626 a skos:Concept ;
    skos:definition "Wall coverings comprising fabric. In traditional wall-upholstering, fabric is attached to the wall by a series of clips, tacks, or tracks that hold the fabric tautly in place. Another method calls for the mounting of fabric on light frameworks of wood or another material, often fitted with an infill layer of batting. The latter method in particular is used to provide acoustical panels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upholstered walls"@en .

aat:300395627 a skos:Concept ;
    skos:definition "Fasteners used to attach washed laundry to clotheslines. There are two common types: a one-piece forked peg, and a clamp made of two pieces of wood or plastic held together with a tensioned spring, forming a pincer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clothespins"@en .

aat:300395628 a skos:Concept ;
    skos:definition "Dense, dark-colored wood obtained from the Millettia laurentii trees native to tropical regions of Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wenge"@en .

aat:300395629 a skos:Concept ;
    skos:definition "Hand held weapons, usually wooden, with amalgamated striking and throwing properties such as weighted heads and long, often curved handles. These can be of varied form and appear in many cultures. Related weapons are \"throwing sticks,\" which are generally smaller and flat or cylindrical in form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throwing clubs"@en .

aat:300395630 a skos:Concept ;
    skos:definition "Items comprising incense in wax or another carrier, resembling the head of a large nail, that are attached to the pascal candle during the Christian Easter Vigil rites. The incense may be in the form of a nail or a nail head attached to a tack-like point, used to secure it to the candle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nails of incense"@en .

aat:300395631 a skos:Concept ;
    skos:definition "Stands of varied design that support containers with perforated covers used for burning incense in a ritual context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "censer stands"@en .

aat:300395632 a skos:Concept ;
    skos:definition "Cross-shaped fixtures or painted marks in Catholic churches, most often on the walls or columns at the places consecrated with chrism during the consecration of the church. The symbolism for the crosses is laid out in liturgical treatises, such as the \"Rationale\" of Durandus; there are twelve consecration crosses to symbolize the twelve apostles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consecration crosses"@en .

aat:300395633 a skos:Concept ;
    skos:definition "Ancient mortars, usually of simple design, comprising bowls or basins used for pounding, grinding, or squeezing. Some Roman examples were made of stone having quartz grains are embedded in the internal surface, providing a rough surface for grinding. Some Middle Eastern examples were mold-made ceramic vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mortaria"@en .

aat:300395634 a skos:Concept ;
    skos:definition "Small Christian devotional statues that are typically carried as amulets in a pocket or elsewhere on a person's clothing. For items having a similar function but in the shape of a disc, use \"devotional tokens.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pocket statues"@en .

aat:300395635 a skos:Concept ;
    skos:definition "Trademarked name for a group of alloys having zinc as the main component. The alloys have a relatively low melting point and can be easily cast. The name is an acronym derived from the German names for the metals from which the material is composed: Zink, Aluminium, Magnesium, Kupfer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zamak (TM)"@en .

aat:300395637 a skos:Concept ;
    skos:definition "Reaping tools with L-shaped wooden handles and a blade. Siths allowed the user to stand upright, holding the crop with the mathook in the left hand, and cutting the crop with the sith in the right, which was different than with scythes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siths"@en .

aat:300395638 a skos:Concept ;
    skos:definition "Altars in Christian churches that are under the same ecclesiastical canons as the high altar, but considered subordinate to the high altar. Side altars are typically placed at the head of a side aisle, along the sides of the aisle, or in a bay or chapel; they are often decorated with an altarpiece, wall paintings, windows, or other art referring to the titular saint to whom the altar is dedicated. Rules may state the allowable size, number of steps, or absence of a tabernacle for a side altar. Side altars were ranked in importance; the side altar on the Gospel side of the high altar had the highest status, and the counterpart on the Epistle side had the second highest rank. Side altars appeared in church architecture by the 6th century; they became prime places for members of the congregation to display their wealth and importance through patronage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side altars"@en .

aat:300395639 a skos:Concept ;
    skos:definition "Fiber or fiber-like material made wholly or in part from silver."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver thread"@en .

aat:300395640 a skos:Concept ;
    skos:definition "Leather-finishing tools, often used by shoemakers, that consist of one or more small wheels with a crimped edge mounted on a handle; the wheels are rolled over the leather to create a broken line."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crow wheels"@en .

aat:300395641 a skos:Concept ;
    skos:definition "Matches that use sulfur as the lighting tip, often comprising wooden sticks dipped in melted sulfur. Sulfur matches were recorded as early as 577 CE in China. By the 19th century, improvements to the sulfur match were invented, including impregnating the wood or paper with stearic acid, wax, resin, or paraffin to allow faster lighting and less offensive odor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sulfur matches"@en .

aat:300395642 a skos:Concept ;
    skos:definition "Leatherworking tools that combine gripper and hammer; used particularly in shoemaking. Examples of use are to pull leather taut over a mold, or to hammer in nails."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lasting pliers"@en .

aat:300395644 a skos:Concept ;
    skos:definition "Small to medium-sized figures comprising a carved or molded bust or half-figure, set upon a cage, which may resemble a cage crinoline or may be of simpler design. The cage is usually made of wood or metal. The figures are designed to wear clothing, with long skirts covering the cage. Many cage dolls are religious statues, representing the Virgin Mary, angels, or saints, including but not limited to such figures in the Hispanic tradition of \"santos.\" Another use of cage dolls was as \"fashion dolls,\" to display dresses in miniature in order to allow the customer to choose a fashion. For porcelain or wooden objects representing a figure, often female, from the waist up, intended to be sewn or attached to a base or lower body but not to a cage, use \"half dolls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cage dolls"@en .

aat:300395645 a skos:Concept ;
    skos:definition "Figures, dolls, or statues designed to be contained under a bell jar, which is a bell-shaped jar turned upside down on a base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell jar figures"@en .

aat:300395646 a skos:Concept ;
    skos:definition "Process used to reconstruct the three-dimensional structure of blood vessels by replacing the blood with low viscosity resin; the vascular architecture may then be removed from surrounding tissues."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vascular corrosion casting"@en .

aat:300395647 a skos:Concept ;
    skos:definition "Ink-soaked pads used for applying ink; examples include a pad in a shallow box used for inking a rubber stamp or taking fingerprints, as parts of typewriters, or automatic numbering machines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inkpads"@en .

aat:300395650 a skos:Concept ;
    skos:definition "The figwort family of flowering plants, the order Lamiales, containing species with worldwide distribution. Notable for many ornamental garden plants, such as butterfly bush (Buddleja), Diascia, Nemesia, and many others. Some, such as the mullein (Verbascum), are troublesome weeds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Scrophulariaceae"@en .

aat:300395652 a skos:Concept ;
    skos:definition "Hereditary commanders-in-chief of the Japanese army; until 1867, the virtual rulers of Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shoguns"@en .

aat:300395653 a skos:Concept ;
    skos:definition "Genus of deciduous tree in the family Paulownaceae or Scrophulariaceae, native to east Asia. Bears large heart-shaped, usually hairy leaves. Cultivated for its lightweight and fine-grained timber, and as an ornamental with massed sweetly-scented violet to cream-colored, trumpet-shaped flowers that appear in Spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paulownia"@en .

aat:300395654 a skos:Concept ;
    skos:definition "An Asian species naturalized in eastern North America. It grows to 35-50 feet high. Leaves are five to ten inches long and deep green. Flowers are lavender or purple with yellow stripes and appear at branch tips before leaves sprout in Spring."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paulownia tomentosa"@en .

aat:300395655 a skos:Concept ;
    skos:definition "The culture or style of Parma, Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Parmesan"@en .

aat:300395656 a skos:Concept ;
    skos:definition "Nationality or culture of the kingdom of Saxony, the Prussian province of Saxony, or the state of Saxony in the German Democratic Republic, until 1952 when it was replaced as an administrative district by Leipzig, Karl-Marx-Stadt, and Dresden. For the ancient Saxon culture, use \"Saxon (historical culture or style).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saxon"@en .

aat:300395657 a skos:Concept ;
    skos:definition "Historical Roman rulers of one of four divisions of a country or province; at a later period applied to subordinate rulers generally, especially in Syria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tetrarchs"@en .

aat:300395658 a skos:Concept ;
    skos:definition "Nationality or culture of Syrause, Italy; especially used with reference to ancient Syracuse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syracusian"@en .

aat:300395659 a skos:Concept ;
    skos:definition "Hindu semi-divine beings that are half human and half serpentine. They are often associated with waters, such as rivers, lakes, rain, and seas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nāgas"@en .

aat:300395660 a skos:Concept ;
    skos:definition "Discipline that focuses on the arrangement and layout of spaces and architectural elements inside architectural structures or parts of structures. For the discipline that focuses on the placement of moveable works located within the space, such as furniture or accessories, and often also on the design of the space itself, prefer \"interior design.\" For the discipline focusing more on the flow of users of the space, building codes, etc., prefer \"space planning.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior architecture"@en .

aat:300395661 a skos:Concept ;
    skos:definition "People whose profession focuses on the arrangement and layout of spaces and architectural details inside architectural structures or parts of structures. For people whose profession focuses on the designs, colors, and placement of moveable works located within buildings' spaces, such as furniture or accessories, and perhaps also on the design of the space itself, prefer \"interior designers.\" For those who focus exclusively on the color, textures, furnishings, accessories, etc. of interior spaces, use \"interior decorators.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interior architects"@en .

aat:300395662 a skos:Concept ;
    skos:definition "People who claim or aspire to a title or a throne, often when considered to have no just title or otherwise did not achieve the position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pretenders"@en .

aat:300395663 a skos:Concept ;
    skos:definition "An Iron Age Indian culture of the western Gangetic plain and the Ghaggar-Hakra valley on the Indian subcontinent; named for the pottery associated with the culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Painted Gray Ware"@en .

aat:300395664 a skos:Concept ;
    skos:definition "Indian carved memorials commemorating the honorable death of a hero in battle. Most examples date to 3rd century BCE/18th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vīragals"@en .

aat:300395665 a skos:Concept ;
    skos:definition "People who hold an office or position temporarily, as substitutes in place of the person to whom the office belongs. For those who assume the position of head of a monarchy in the minority or disability of the rightful monarch, use \"regents.\" For those who claim a title or throne to which they have no just right, use \"pretenders.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "locum tenentes"@en .

aat:300395666 a skos:Concept ;
    skos:definition "Hindu sacred bathing places or reservoirs, often natural features such as a river or lake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tirthas"@en .

aat:300395667 a skos:Concept ;
    skos:definition "Historical leaders having a high rank, especially the chief magistrates of the Dutch republic; earlier viceroys or lieutenant governors of a province or provinces in the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stadtholders"@en .

aat:300395668 a skos:Concept ;
    skos:definition "Expatriation or prolonged absence from one's native land, endured by compulsion or by circumstances, or voluntarily undergone for any purpose. For the legal state of having been forcibly exiled, use \"banishment.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "exile"@en .

aat:300395669 a skos:Concept ;
    skos:definition "Nationality, culture, and style of Burgundy, an area of eastern France, particularly the dutchy or county dating from the early medieval period and later. For the culture of the early tribes, use \"Burgundian (Migration period).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Burgundian"@en .

aat:300395670 a skos:Concept ;
    skos:definition "Nationality and culture of the modern nation of Syria, the Syrian Arab Republic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Syrian"@en .

aat:300395671 a skos:Concept ;
    skos:definition "Groups of attendants, warriors, or others. Primary examples in Hinduism are spirits or demi-gods who are attendants of Shiva."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ganas"@en .

aat:300395672 a skos:Concept ;
    skos:definition "Buddhist or Hindu celestial beings or spirits who are part human and animal, either horse or bird."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiṁnaras"@en .

aat:300395673 a skos:Concept ;
    skos:definition "Reaping tools with metal hooks mounted on wooden handles of about 40 inches in length. These were grasped in the left hand to hold crops which were then cut with siths held in the right."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mathooks"@en .

aat:300395675 a skos:Concept ;
    skos:definition "Hindu spiritual teachers, guides, or mentors that already has gained spiritual knowledge. The word \"guru\" means \"venerable\" in Sanskrit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gurus"@en .

aat:300395676 a skos:Concept ;
    skos:definition "Bowls made of human skulls, used in Hindu and Buddhist rituals, often containing offerings to deities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kapālas"@en .

aat:300395677 a skos:Concept ;
    skos:definition "The event or status of having control, government, or dominion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rules"@en .

aat:300395678 a skos:Concept ;
    skos:definition "Genus containing several species of large flightless birds of the Australo-Papuan region. They stand about five feet high; the wings are of no use for flight, but are furnished with stiff featherless quills, like spines, which serve for combat or defence"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Casuarius"@en .

aat:300395679 a skos:Concept ;
    skos:definition "Species of large, flightless bird of Australia; it is the sole living member of the family Dromaiidae, several other forms having been exterminated by settlers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dromaius novaehollandiae"@en .

aat:300395680 a skos:Concept ;
    skos:definition "Bodies, typically tending to spheroidal shapes, that are produced by the female of birds, reptiles, fish, amphibians, and other animal species. Eggs are the organic vessels in which an animal embryo develops enclosed within a shell or membrane. For the egg cells of mammals and other animals, use \"ova.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eggs"@en .

aat:300395681 a skos:Concept ;
    skos:definition "The female gametes or reproductive cells in animals, usually produced by an ovary and capable of developing into a new individual after, or in some cases without, fertilization by the male sperm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ova"@en .

aat:300395682 a skos:Concept ;
    skos:definition "The male gametes or reproductive cells in animals, especially in vertebrates, which fertilizes the female gamete, the ovum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sperm"@en .

aat:300395683 a skos:Concept ;
    skos:definition "Compound known as a hygroscopic, blue-gray powder that occurs naturally as the mineral \"vivianite (mineral).\" Used in the pigment \"blue ocher\"; has been found in Roman paint residues. Ferrous phosphate is also used as a colorant in ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferrous phosphate"@en .

aat:300395684 a skos:Concept ;
    skos:definition "Mineral comprising naturally occuring ferrous phosphate. Vivianite was described after discovery in the St. Agnes mine in Cornwall in 1817. Used in the pigment \"blue ocher\"; has been found in Roman paint residues. Ferrous phosphate is used as a colorant in ceramics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vivianite"@en .

aat:300395685 a skos:Concept ;
    skos:definition "The food matter in the cytoplasm of an ovum or a cell, as distinguished from the active or true protoplasm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deutoplasm"@en .

aat:300395686 a skos:Concept ;
    skos:definition "The complex, translucent, colorless, colloidal material comprising the living part of a cell, including the membrane-bound cytoplasm, nucleus, and other organelles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protoplasm"@en .

aat:300395687 a skos:Concept ;
    skos:definition "Paired deciduous outgrowths of bone, projecting from the frontal bones of ungulates of the deer family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antlers"@en .

aat:300400462 a skos:Concept ;
    skos:definition "Genus of legume consisting of approximately 150 species found in tropical and subtropical regions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Millettia"@en .

aat:300400463 a skos:Concept ;
    skos:definition "Tree species native to a limited area in Central Africa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Millettia laurentii"@en .

aat:300400464 a skos:Concept ;
    skos:definition "Long pointed teeth, particularly such teeth that project beyond the mouth, as in the elephant, wild boar, and various other animals. Tusks are generally seen in living mammals, but existed in other extinct animals. Tusks are used by the animal for mating competition, display, defense, offensive fighting, digging, and occasionally for hunting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tusks"@en .

aat:300400465 a skos:Concept ;
    skos:definition "Instruments in the form of pincers used for grasping or manipulating objects, often in the context of surgery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forceps"@en .

aat:300400467 a skos:Concept ;
    skos:definition "Bone-like structures found in the mouths of many vertebrates, used for biting and chewing. Some also use teeth for hunting and defensive purposes. The roots of teeth anchor the teeth in the jaw; they are covered by gums. Teeth are not technically made of bone, but rather of multiple tissues of varying density and hardness. The cellular tissues that develop as teeth originate in the the ectoderm. The general structure of teeth is similar across the vertebrates, but there is variation in placement and form. Monophyodonts develop only one set of teeth for use in adulthood, while polyphyodonts develop many sets of teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "teeth"@en .

aat:300400468 a skos:Concept ;
    skos:definition "Protein filaments that grow from follicles in the dermis of mammals. Hair takes the form of characteristic threadlike outgrowths, forming the animal’s coat, or pelage. Hair is present in differing degrees on all mammals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hair"@en .

aat:300400469 a skos:Concept ;
    skos:definition "The characteristic reproductive bodies of both angiosperms (flowering plants) and gymnosperms (conifers, cycads, and ginkgos) and the ovary that encloses it. A seed consists of a miniature undeveloped plant (the embryo), which, alone or in the company of stored food for its early development after germination, is surrounded by a protective coat (the testa). Seeds are frequently small in size and suited to perform a wide variety of functions, such as multiplication, perennation (surviving seasons of stress such as winter), dormancy (a state of arrested development), and dispersal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seeds"@en .

aat:300400470 a skos:Concept ;
    skos:definition "A registered trademark of Dow Chemical for a fumigant composed of sulfuryl fluoride (SO2F2 ). A colorless, odorless, toxic gas used for fumigation. Vikane is used to kill insects (ants, termites, silverfish, cockroaches, etc.) in homes and buildings. At high humidity and high temperature Vikane® can decompose to form hydrofluoric acid. Sulfuryl fluoride is gaseous at room temperature. It is applied from a compressed cylinder of liquid. The sprayed aerosol quickly becomes a gas and disperses throughout the sealed area. Vikane® is toxic to all life forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vikane (R)"@en .

aat:300400471 a skos:Concept ;
    skos:definition "General term for religions based on obeisance to or reverence of the spirits of the dead, particularly ancestors, who may be considered capable of influencing the physical world or interceding on behalf of the living to the gods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancestor worship"@en .

aat:300400472 a skos:Concept ;
    skos:definition "Works or miscellaneous collections that are created from a diverse range of materials or sources; generally reserved for literary, musical, or visual works, such as sculpture or architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bricolage"@en .

aat:300400473 a skos:Concept ;
    skos:definition "The non-deciduous excrescences, often curved and pointed, consisting of an epidermal sheath growing about a bony core on the head of certain mammals such as cattle, sheep, goats, and antelopes, or formed from matted hair on the rhinoceros. Horns serve as displays and as weapons of offence or defense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "horns"@en .

aat:300400474 a skos:Concept ;
    skos:definition "The component structures of the outer covering and flight surfaces of all modern birds and some dinosaurs, apparently having evolved from the scales of reptilian ancestors. The many different types of feathers are variously specialized for insulation, flight, formation of body contours, display, and sensory reception. The typical feather consists of a central shaft (rachis), with serial paired branches (barbs) forming a flattened, usually curved surface (the vane). The barbs possess further branches, the barbules."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "feathers"@en .

aat:300400475 a skos:Concept ;
    skos:definition "Stiff, projecting oral structures of certain animals, including some invertebrates (e.g., cephalopods and some insects), some fishes and mammals, all birds and turtles, and many dinosaurs. Many beaked animals, including all modern birds and turtles, lack teeth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beaks"@en .

aat:300400476 a skos:Concept ;
    skos:definition "Afro-Asiatic language spoken in the Adamawa state of Nigeria."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ga'anda"@en .

aat:300400477 a skos:Concept ;
    skos:definition "Double-walled vessels designed to regulate the temperature of liquids stored within. Originally invented by Sir James Dewar. Use 'Thermoses (TM)' for the brand name examples of these. With a lowercase initial 'thermoses' is frequently applied loosely to 'vacuum flasks' in general."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacuum flasks"@en .

aat:300400479 a skos:Concept ;
    skos:definition "Outgrowths, usually green and flattened, that extend from the stem of a vascular plant. Botanically, leaves are an integral part of the stem system, and they are initiated in the apical bud along with the tissues of the stem itself. Leaves manufacture food for plants, which in turn ultimately nourish and sustain all land animals, directly or indirectly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaves"@en .

aat:300400480 a skos:Concept ;
    skos:definition "In botany, the parts of a plant normally underground, having the primary functions of anchorage of the plant, absorption of water and dissolved minerals and conduction of these to the stem, and storage of reserve foods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roots"@en .

aat:300400481 a skos:Concept ;
    skos:definition "The representation of the leaves of plants, usually used for decoration or ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foliage"@en .

aat:300400482 a skos:Concept ;
    skos:definition "Genus of fruit-bearing deciduous shrubs or small trees having two extant species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Punica"@en .

aat:300400483 a skos:Concept ;
    skos:definition "Species of bush or small tree of Asia; it is 16 or 23 feet in height, has elliptic to lance-shaped, bright-green leaves, long and handsome axillary orange-red flowers borne toward the ends of the branchlets, and a red fruit, which is a calyx is tubular and persistent and has five to seven lobes.The fruit is the size of a large orange. While the pomegranate is considered indigenous to Iran and neighbouring countries, its cultivation encircled the Mediterranean and extended through the Arabian Peninsula, Afghanistan, and India in ancient times. It is commonly cultivated in the Americas from the warmer parts of the United States to Chile."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Punica granatum"@en .

aat:300400484 a skos:Concept ;
    skos:definition "Paired globular organs of sight in the head of humans and other vertebrates. The term may also refer to any of various visual or light-detecting organs in invertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eyes"@en .

aat:300400485 a skos:Concept ;
    skos:definition "Order of large, flightless birds having only four extant members, three species of cassowary and one species of emu."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Casuariiformes"@en .

aat:300400486 a skos:Concept ;
    skos:definition "Family of large, flightless birds having only one remaining genus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dromaiidae"@en .

aat:300400487 a skos:Concept ;
    skos:definition "Genus of large, flightless birds having only one remaining species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dromaius"@en .

aat:300400488 a skos:Concept ;
    skos:definition "Generic term to refer to either gender, where the relationship to oneself is either the sibling of one's parent, or the spouse of the sibling of one's parent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uncles/aunts"@en .

aat:300400489 a skos:Concept ;
    skos:definition "Generic term to refer to either gender, where the relationship to oneself is the child of one's sibling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nephews/nieces"@en .

aat:300400490 a skos:Concept ;
    skos:definition "Enterprises or organizations, usually commercial, in which two or more parties jointly undertake the enterprise, but otherwise retain their distinct identities. It differs from \"partnerships (companies)\" in that a partnership generally involves an ongoing, long-term business relationship, whereas a joint venture is based on a single business transaction or project."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "joint ventures"@en .

aat:300400491 a skos:Concept ;
    skos:definition "Deciduous hardwood from the fast-growing trees of genus Paulownia. It is dimensionally stable and naturally resistant to termites. Paulownia wood has been used traditionally as material for Japanese 'tansu,' footwear, musical instruments, decorative moldings, and as structural elements in building construction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paulownia"@en .

aat:300400492 a skos:Concept ;
    skos:definition "General designation for people who hold an official position of authority or responsibility over a project, a job, or the work of other people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overseers"@en .

aat:300400493 a skos:Concept ;
    skos:definition "Partners in a relationship of romantic love, including partners of either sex or the same sex, and whether or not sexual relations occur in the relationship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "romantic partners"@en .

aat:300400494 a skos:Concept ;
    skos:definition "Women who have a romantic relationship with a man without being his wife. The term today usually has a negative connotation, and is generally only used in the context of certain historical periods. The mistress may be a powerful person in the household, even bearing children; it is often used when the husband is married to another person. Its usage can overlap with \"concubines,\" although \"mistresses\" is typically preferred in historical periods of Europe and elsewhere in the West."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mistresses"@en .

aat:300400495 a skos:Concept ;
    skos:definition "The principal ministers of a sovereign, ruler, or state. In modern contexts, the head of an elected government who is the chief officer of the executive branch of government in countries which have a parliamentary system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prime ministers"@en .

aat:300400496 a skos:Concept ;
    skos:definition "Knives used to smooth leather during tanning. For tools used to smooth stone, use \"scotches.\" For wooden tools used for smoothing and beating fibers, use \"swingles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scutching knives"@en .

aat:300400497 a skos:Concept ;
    skos:definition "The process of removing rough or unsuitable parts of a material during processing. Examples of use are in reference to processing fibers, tanning of leather, processing bark, or processing stone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scutching"@en .

aat:300400498 a skos:Concept ;
    skos:definition "Family of flowering shrubs and trees native to temperate and tropical regions of both hemispheres, including several ornamental plants, one that is the source of tea. The number of genera belonging to this family is debated, numbering from 7 to 40, depending on the method of circumscription."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Theaceae"@en .

aat:300400499 a skos:Concept ;
    skos:definition "Genus containing aropund 250 species of evergreen shrubs and trees native to East Asia. It is best known for a few ornamental flowering species and for Camellia sinensis, the source of the beverage tea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Camellia"@en .

aat:300400500 a skos:Concept ;
    skos:definition "Clothing made of wool or chiefly of wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "woolens"@en .

aat:300400501 a skos:Concept ;
    skos:definition "Clothing made of silk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silks"@en .

aat:300400503 a skos:Concept ;
    skos:definition "Sexual attraction and sexual behavior, usually also including sexual identity, romantic attractions, and romantic behaviors. It may also include membership in sexual communities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sexual orientation"@en .

aat:300400504 a skos:Concept ;
    skos:definition "State, condition, or behavior in which a person's identity does not conform unambiguously to conventional notions of male or female gender, including transsexualism or transvestism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transgenderism"@en .

aat:300400505 a skos:Concept ;
    skos:definition "State, condition, or behavior having to do with sexual attraction or sexual relations between women."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lesbianism"@en .

aat:300400507 a skos:Concept ;
    skos:definition "State, condition, or behavior having to do with sexual attraction or sexual relations between men."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "male homosexuality"@en .

aat:300400510 a skos:Concept ;
    skos:definition "General term for lesbian, gay, bisexual, or transgender / transsexual / transvestite attractions or behavior."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "LGBTQ+"@en .

aat:300400511 a skos:Concept ;
    skos:definition "Indication in texts, databases, tables, and lists when the topic or element is not relevant to the instance at hand; often represented as an abbreviation. If indexing using the languages hierarchy, prefer \"not applicable (language).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "not applicable"@en .

aat:300400512 a skos:Concept ;
    skos:definition "Indication in texts, databases, tables, and lists when information for the instance at hand is not readily available."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unavailable"@en .

aat:300400513 a skos:Concept ;
    skos:definition "Indication in texts, databases, tables, and lists when the topic or element for the instance at hand is some value beyond the specific values provided."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "other"@en .

aat:300400514 a skos:Concept ;
    skos:definition "Artists who create artworks to be displayed or incorporated into public areas, having the purpose of beautifying and enriching public places, whether or not the works are also functional. The term is often reserved for use in modern contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "public artists"@en .

aat:300400515 a skos:Concept ;
    skos:definition "Art or architectural elements that are associated with urban design, planning, and preservation of a city, town, or district. For art having the purpose of beautifying and enriching public places, but not necessarily located in a city or associated with urban design, use \"public art.\" For art created in urban environments, but not necessarily sanctioned or legally displayed, prefer \"urban art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "municipal art"@en .

aat:300400516 a skos:Concept ;
    skos:definition "Art that is created for and about large cities and city life, often done by artists who live in the city and sometimes having a distinctive rough style. Examples are graffiti and street performances. The art is often, but not always, displayed in or on public spaces; it may be uncommissioned and illegally created. The term is typically reserved for modern contexts; it typically refers to visual arts, but may be applied to other art forms as well. For art or architectural elements that are sanctioned or commissioned by the authorities and associated with urban design, prefer \"municipal art.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "urban art"@en .

aat:300400517 a skos:Concept ;
    skos:definition "Physical extent or area, in two or three dimensions, in the natural world or built environment. Typically used in the context of space being applied to or sufficient for a purpose or action."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space"@en .

aat:300400518 a skos:Concept ;
    skos:definition "Area or linear space in the natural world or built environment that is or in the past has been considered important or revered in a religious or spiritual context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacred space"@en .

aat:300400519 a skos:Concept ;
    skos:definition "The action of saying or doing something over again which one has already said or done. The term may be used in the context of visual images, the spoken or written word, performances, music, and other contexts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repetition"@en .

aat:300400521 a skos:Concept ;
    skos:definition "Reverent petitions composed for presentation to a deity or other spiritual entity, whether orally or mentally expressed. For documents containing prayers, use \"prayers(document genre).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prayers"@en .

aat:300400522 a skos:Concept ;
    skos:definition "Performances including music for voice and optionally instruments, generally relatively brief in duration, containing words."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "songs"@en .

aat:300400531 a skos:Concept ;
    skos:definition "Groups of dancers assembled as a performing unit, inclusive of directors and other business and technical personnel."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dance companies"@en .

aat:300400532 a skos:Concept ;
    skos:definition "The action of making one a knight, which is a title of landholding rank or a title of honor and social distinction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "knighting"@en .

aat:300400533 a skos:Concept ;
    skos:definition "Technique of inpainting using small flicks or dots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puntinato"@en .

aat:300400534 a skos:Concept ;
    skos:definition "Textile fabric having a very long, soft pile, which may imitate fur, made of plant fiber or synthetic fiber. The textile may occur in any color, not necessarily resembling the coat of a mammal, and is typically used for fashion and interior decoration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fake fur fabric"@en .

aat:300400536 a skos:Concept ;
    skos:definition "Species of cottonwood poplar native to southwestern North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Populus fremontii"@en .

aat:300400537 a skos:Concept ;
    skos:definition "People tasked with giving money, clothing, or food to impoverished people or others in need."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almoners"@en .

aat:300400538 a skos:Concept ;
    skos:definition "Charitable relief given to impoverished people or others in need, including money, food, clothing, or other material gifts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alms"@en .

aat:300400539 a skos:Concept ;
    skos:definition "Cupboards intended for the storage of food and other donations for impoverished people or others in need. Primarily used in historical contexts, for such cupboards on the premises of churches, hospitals, guilds, private estates, or other establishments that distributed alms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almoners cupboards"@en .

aat:300400541 a skos:Concept ;
    skos:definition "Jars, sometimes airtight, used for storing food or any other items."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "storage jars"@en .

aat:300400543 a skos:Concept ;
    skos:definition "Powered by electricity, operating by means of electricity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electrical"@en .

aat:300400545 a skos:Concept ;
    skos:definition "Of a device, instrument, information storage, or other applications, operating according to the principles or methods of electronics, such as having a transistor, microchip, or electron tube. For appliances or instruments that are powered by electricity, use \"electric.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "electronic"@en .

aat:300400546 a skos:Concept ;
    skos:definition "Activities comprising the tolling of a church bell or other bell, rung slowly and solemnly, to announce a death or a funeral."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "death knells"@en .

aat:300400547 a skos:Concept ;
    skos:definition "Elaborate orchestral compositions in three or more movements, originally developed from the operative overture similar in form to a sonata, but usually of grander scale and broader style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "symphonies"@en .

aat:300400548 a skos:Concept ;
    skos:definition "Musical compositions for instruments, usually for the pianoforte, in several movements, commonly three or four movements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sonatas"@en .

aat:300400549 a skos:Concept ;
    skos:definition "Items comprising two quadrilateral segments, or later discs, connected to each other by two strings or bands in such a manner that, when the bands rest on the shoulders, the front segment rests before the breast, while the other hangs down an equal distance at the back. The segments may contain various images or symbols. These small scapulars developed from the larger cloak-like scapulars. Small scapulars are worn by various religious orders and laity; they may be worn over clothing or under, against the skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "small scapulars"@en .

aat:300400550 a skos:Concept ;
    skos:definition "Certain solemn ceremonies, rites, or religious acts belonging to the institutions of the Christian church. The number and nature of rites considered sacraments varies by Christian denomination; examples include the even sacraments: baptism, confirmation, the eucharist, penance, last rites, holy orders, and matrimony; other traditions recognize only two sacraments, baptism and the Lord's Supper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacraments"@en .

aat:300400551 a skos:Concept ;
    skos:definition "Tools used for burnishing or polishing that are made of bone, ivory, smooth wood, or in modern contexts, plastic. Examples of usage include the smoothing and burnishing of paper or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burnishing bones"@en .

aat:300400552 a skos:Concept ;
    skos:definition "Crowns that are open, lacking hoops, arches, or an internal covering; typically comprising a ring or band of precious metal, often with jewels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circlet crowns"@en .

aat:300400554 a skos:Concept ;
    skos:definition "Veils of women's costume, worn over the face during times of mourning a death. They are typically black or violet in color and semi-transparent; in some traditions, they are white."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning veils"@en .

aat:300400555 a skos:Concept ;
    skos:definition "The layer of tissue forming the external covering of the body in vertebrates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skin"@en .

aat:300400556 a skos:Concept ;
    skos:definition "Visual works that are derived directly from nature, including formerly living organisms and non-organic objects, and that have been processed, prepared, or altered only in such a way as to preserve or minimally enhance the appearance of the natural object or living organism. For natural materials, see the specific term in the Materials hierarchy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural visual works"@en .

aat:300400557 a skos:Concept ;
    skos:definition "Flowers, often with stems attached, and other plants that are treated so as to remove moisture and in order to preserve them. Methods of drying flowers include hanging to dry, covering with a desiccant such as glycerin and silica, or pressing between paper, a textile, or another absorbent, wicking material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dried flowers"@en .

aat:300400559 a skos:Concept ;
    skos:definition "Figures made of porcelain, wood, ivory, or another material, usually representing a female and only from the waist up. The object typically has a punched hole other feature near the bottom, intended to allow the half doll to be sewn or otherwise attached to a solid base or to a lower body made of a cheaper or softer material. For similar objects attached to a cage-like base, use \"cage dolls.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "half dolls"@en .

aat:300400560 a skos:Concept ;
    skos:definition "Small handbells placed upon the table at meals for summoning attendants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "table bells"@en .

aat:300400561 a skos:Concept ;
    skos:definition "Fiber or fiber-like material made wholly or in part from gold"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gold thread"@en .

aat:300400562 a skos:Concept ;
    skos:definition "Racks used to hold meat during cooking or for storing meat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "meat racks"@en .

aat:300400563 a skos:Concept ;
    skos:definition "Ribbons or strings attached to hats in such a way that they may be tied under the chin, in order to secure the hat on the head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chin ties"@en .

aat:300400564 a skos:Concept ;
    skos:definition "Headwear comprising bands of cloth or another material tied around the top of the head and under the chin. Examples are women's headwear in Medieval Europe and men's headwear in ancient Persia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chin bands"@en .

aat:300400565 a skos:Concept ;
    skos:definition "A natural admixture mineral of zinc carbonate and hydrous zinc silicate. Because the two ores are very similar and often occur together, the name calamine was given to the mixture but also incorrectly used for the separate minerals. To differentiate the minerals, they were given new names of smithsonite (zinc carbonate) and hemimorphite (hydrous zinc silicate). The name was derived from the place name La Calamine (Kelmis), Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calamine"@en .

aat:300400566 a skos:Concept ;
    skos:definition "Wide collars, usually on coats or day wear in the style of coats, that lie around the shoulders, often tapering to the waist, resembling a stole. For wider, capelike collars, use \"berthas.\" For neck liners of ecclesiastical stoles, use \"stole collars (liners).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stole collars"@en .

aat:300400567 a skos:Concept ;
    skos:definition "Small flutes; generally in historical usage, and referring to various types of small flute."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipettes"@en .

aat:300400568 a skos:Concept ;
    skos:definition "Flint tools of the Bronze Age, which may have been used for various purposes such as cutting meat or harvesting grain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sickle blades"@en .

aat:300400570 a skos:Concept ;
    skos:definition "Wooden two-wheeled vehicles with steering mechanisms; propelled by the rider pushing from the ground with each foot. The first two-wheeled rider-propelled machine was the draisienne, invented by Baron Karl von Drais de Sauerbrun of Germany, in 1817. Denis Johnson of London purchased a draisienne and patented his model as a “pedestrian curricle.” Many buyers were members of the nobility, and caricaturists called the devices “dandy horses.”"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dandy horses"@en .

aat:300400571 a skos:Concept ;
    skos:definition "Apparatus designed to manipulate the hand for physical therapy consisting of four clamps that are attached to the fingers, a palm rest and a crank. When cranked, the device moves the fingers in certain positions to increase their flexibility."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ochydactyls"@en .

aat:300400573 a skos:Concept ;
    skos:definition "Instruments of punishment usually consisting of a metal framework that encased the head that included a gag or sharpened bit to restrain speech."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "branks"@en .

aat:300400574 a skos:Concept ;
    skos:definition "Cups or bowls made from the fruit of a calabash tree, or made of other materials to resemble such vessels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jicaras"@en .

aat:300400575 a skos:Concept ;
    skos:definition "Vessels often made of bronze, with dual spouts; one on each side of the reservoir, that were usually suspended within a niche, and used to dispense water by tilting to one side or the other. Used before the advent of running water, most date from the Middle Ages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puisettes"@en .

aat:300400576 a skos:Concept ;
    skos:definition "Metal coffee- or teapots of French origin with straight handles perpendicular to the reservoir."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "verseuses"@en .

aat:300400577 a skos:Concept ;
    skos:definition "French ceramic stew pots with bulbous bodies surmounted by a narrow neck, which slows evaporation during the long cooking process. These have lids with a well that can hold water, which causes condensation within the pot. This type of pot was originally used to prepare a 'daube,' a traditional stew from the Provence-region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daubières"@en .

aat:300400578 a skos:Concept ;
    skos:definition "Bellows may be integral parts of a folding- or view camera that are situated between the lens and the film plane, or separate pieces of equipment that are mounted onto a camera. These are expansible, often with accordion folds in the material. By extending the bellows and moving the lens, the photographer may focus on the film plane, and achieve close-up or macro focusing. Bellows also allow the photographer to correct perspectival aberrations by tilting or raising the lens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bellows"@en .

aat:300400579 a skos:Concept ;
    skos:definition "Components of cameras used as framing devices to compose and focus images. These may be demountable attachments, or integrated into the camera body."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viewfinders"@en .

aat:300400580 a skos:Concept ;
    skos:definition "Interface between the body of a photographic device and an interchangeable lens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lens mounts"@en .

aat:300400581 a skos:Concept ;
    skos:definition "A type of mace made of lead, sometimes with sharp pins on three sides, or having a trefoil shaped head."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plombées"@en .

aat:300400582 a skos:Concept ;
    skos:definition "Bobbin lace produced in Bruges and characterized by its complicated and refined patterns executed with hundreds of bobbins and a very fine thread. This lace was fashionable in Parisian circles during the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Binche bobbin lace"@en .

aat:300400583 a skos:Concept ;
    skos:definition "Lace produced in Russia and characterized by a coiling tape forming elegant patterns in very simple to very elaborate designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Russian bobbin lace"@en .

aat:300400585 a skos:Concept ;
    skos:definition "Figures used to discourage birds from damaging crops, usually in the form of a man dressed in old clothes or rags, placed in fields or gardens."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scarecrows"@en .

aat:300400586 a skos:Concept ;
    skos:definition "Targets meant to resemble birds, or made from stuffed birds, that are fixed to poles of various heights for use in the practice of archery."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "popinjays"@en .

aat:300400587 a skos:Concept ;
    skos:definition "Devices used to detonate explosive or flammable materials or fuel. These may be chemically, mechanically, or electrically initiated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "igniters"@en .

aat:300400589 a skos:Concept ;
    skos:definition "Embriodered lace from the Belgian town of Lier, made with cotton A form of embroidered net lace produced in the northern Belgian town of Lier, dating from the 19th century and later. The tambour hook is used to make the outlines as well as the different fillings on tulle, with the aim of creating a strong contrast between the open and worked areas of the lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lier lace"@en .

aat:300400591 a skos:Concept ;
    skos:definition "Fabric with a stripe-effect in the direction of the warps, obtained by variations in color or weave of various fibers including silk, rayon, cotton, or a combination of these."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pekin"@en .

aat:300400593 a skos:Concept ;
    skos:definition "Fabric, originally of mohair, but now usually silk, with a wavy, watered appearance, which can be obtained either by the finishing technique of calendering, or by running the fabric between engraved copper rollers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moire"@en .

aat:300400594 a skos:Concept ;
    skos:definition "Fabric with a short woolen pile, usually of mohair, and resembling velvet. Used to produce tapestries, upholstery of soft furnishings, and formal dress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mockado"@en .

aat:300400595 a skos:Concept ;
    skos:definition "Weft-faced compound tabby weave with a plain weave and an added weft system."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taqueté"@en .

aat:300400596 a skos:Concept ;
    skos:definition "Textile weaving technique with an added weft system of which the threads run the whole length or width of the fabric, forming a pattern of simple, small decorations such as flowers or dots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lancé"@en .

aat:300400597 a skos:Concept ;
    skos:definition "Resist dyeing technique; the threads are printed before weaving, resulting in vague patterns in the fabric. Similar to the ikat-technique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chiné à la branche"@en .

aat:300400600 a skos:Concept ;
    skos:definition "Domestic shrines found in Roman homes, dedicated to the house gods, the Lares and the Penates. Its form varied greatly, from a simple wooden cabinet to a richly decorated miniature chapel. Found most often in the atrium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lararia"@en .

aat:300400601 a skos:Concept ;
    skos:definition "Large, spherical or cylinder-shaped earthenware vessels with wide necks used for the conservation or transportation of goods, such as wine, oil, or grain, during the Roman Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doliums"@en .

aat:300400602 a skos:Concept ;
    skos:definition "Axes or chisels from the Middle Bronze Age, successors to the flanged axe. They consist of two parts, the blade with sharp cutting edge and the handle, set in a split handle, separated by a transverse rib to keep the handle from splitting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "palstaves"@en .

aat:300400603 a skos:Concept ;
    skos:definition "Sacred stones or pillars generally dedicated to the cult of a particular god as personification or symbol. These may be single pillars or appear in groups, and may be of meteoric stone. As pillars they were sometimes placed before a shrine. These are considered the first stages of what would evolve into altars and iconic statuary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baetyls"@en .

aat:300400604 a skos:Concept ;
    skos:definition "Stone documents used as records of land grants to vassals by the Kassites in Babylonia between the 16th and the 12th century BCE. Akkadian for \"boundary,\" the original stone would be kept in a temple and a clay copy, which was used as a boundary marker."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kudurrus"@en .

aat:300400605 a skos:Concept ;
    skos:definition "Axes of the Late Bronze Age, successors to winged axes, with an eyelet to the side to fasten the blade and a recess at the top to better keep the handle in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "socketed axes"@en .

aat:300400606 a skos:Concept ;
    skos:definition "Earthen burial sites or graves containing two bodies buried at the same time. Evidence suggests that most often one of the dead was killed following the death of the first. This type of burial has been found in many cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double burials"@en .

aat:300400607 a skos:Concept ;
    skos:definition "Ritual mud brick pits or holes dug at points of importance in Ancient Egyptian and Mesopotamian temples or tombs during their construction. Votive offerings were set under the foundation of monumental buildings, or nearby, perhaps to commemorate or sanctify these structures. These may also have been made to identify the craft of a tomb occupant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foundation deposits"@en .

aat:300400608 a skos:Concept ;
    skos:definition "Transverse bars, first made in wood, later in metal, mounted to the shanks of anchors, and used to help aim them when they touch the seabed. Current anchors usually no longer have anchor stocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anchor stocks"@en .

aat:300400609 a skos:Concept ;
    skos:definition "Bipoint Paleolithic flaked tools, elliptical in shape and pointed at both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foliate points"@en .

aat:300400610 a skos:Concept ;
    skos:definition "Prehistoric pebble core tools from the early Palaeolithic period with only one crude, irregular cutting edge formed by unifacial flaking. These were held by the blunt edge. For the later, more evolved tools with a sinuous edge, use \"chopping tools.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "choppers"@en .

aat:300400611 a skos:Concept ;
    skos:definition "Stone tools from the Palaeolithic period, more refined successors to the earlier \"choppers.\" Both sides of the stone were worked to create a sharp edge. The cutting edge was not straight, but had a sinuous appearance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chopping tools"@en .

aat:300400612 a skos:Concept ;
    skos:definition "Circular depressions pecked into a rock's surface by humans in prehistoric times, sometimes surrounded by concentric circles. These functioned as petroglyphs and were also applied to megaliths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cup and ring marks"@en .

aat:300400613 a skos:Concept ;
    skos:definition "Prehistoric shaft-hole axes with symmetric cutting edges at each side of the shaft. Found in stone, copper and bronze. The double axe was a common religious symbol in Minoan Crete and was also used as a votive object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double axes"@en .

aat:300400614 a skos:Concept ;
    skos:definition "Type of waste product from the manufacture of lithic tools, characterized by a typical line of fracture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microburins"@en .

aat:300400615 a skos:Concept ;
    skos:definition "In the context of archaeology, this refers to Upper Paleolithic flint or obsidian tools, often used as projectile points, created by striking a long, narrow flake from a lithic core. Blades are distinguished from flakes in that they are twice as long as they are wide and have parallel sides and at least two ridges on the dorsal side. Blade production serves to define the transition from Middle to Upper Paleolithic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blades"@en .

aat:300400616 a skos:Concept ;
    skos:definition "Terminology used by prehistorians for a class of microlithic blades with one edge blunted by a secondary retouch. It is assumed that this was so that they could be held more easily. Backed blades first appeared in the early Upper Paleolithic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "backed blades"@en .

aat:300400617 a skos:Concept ;
    skos:definition "Strips of hard or soft wood from the Roman era in Egypt. These were 3 to 6 inches in length and 2 to 4 inches wide, rectangular, and pierced with a hole which was strung with a length of papyrus. They carried information, in Greek or demotic, on the identity of the deceased, such as name, age and place of origin, and were probably affixed during transport from one location to another."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummy labels"@en .

aat:300400618 a skos:Concept ;
    skos:definition "Decorative technique for the application of precious materials like gold to the surfaces of objects, or the application of marble or other materials to the surfaces of built works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "encrusting"@en .

aat:300400619 a skos:Concept ;
    skos:definition "Stone knapping technique used in the Palaeolithic period which involved the striking off of flakes from a prepared core to be used as scrapers of knives. This procedure was more sophisticated than earlier techniques. Named after an archaeological site near Paris."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Levallois technique"@en .

aat:300400620 a skos:Concept ;
    skos:definition "Hard, fine-grained siliceous sedimentary rock composed of the remains of radiolarians, single-celled organisms that sink to the seafloor and form this rock, or radiolarian earth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "radiolarite"@en .

aat:300400621 a skos:Concept ;
    skos:definition "Type of trouser that evolved into an undergarment worn by the Celts and Saxon tribes. By the late Middle Ages, they were only used as undergarments. During the 13th century the length of braies varied from ankle length, mid-calf, or to the knees. They generally had full seats and legs, and no waistband, but a tubular hem, through which a girdle was cinched. By the late 15th century, braies had shortened to the length of modern underwear or trunks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braies"@en .

aat:300400623 a skos:Concept ;
    skos:definition "Bronze aerophones of the Celts dating from early second century BCE shaped like long trumpets and held vertically, with a bell styled in the form of an animal head: often a boar's head or a dragon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carnyxes"@en .

aat:300400624 a skos:Concept ;
    skos:definition "Manufacturers or modelers of terracotta, particularly the makers of figurines or architectural detail in ancient Greece."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coroplasts"@en .

aat:300400625 a skos:Concept ;
    skos:definition "Building material comprising masonry in which the outer faces of the wall are ashlar, the space between being filled with broken stone and mortar. Cross layers of stone are interlaid as binders. Introduced by the Ancient Greeks and adopted by the Romans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emplecton"@en .

aat:300400626 a skos:Concept ;
    skos:definition "Tombs embedded into the walls of religious buildings such as churches or cemeteries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burial niches"@en .

aat:300400627 a skos:Concept ;
    skos:definition "Thrusting weapons with a curved cutting edge, similar to the Greek kopis. Because of their shape, falcatas can deliver a blow with the force of an axe while keeping the cutting edge of a sword. Used on the Iberian Peninsula before the arrival of the Romans, who adopted the design later as the 'gladius hispanicus.'"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "falcatas"@en .

aat:300400628 a skos:Concept ;
    skos:definition "Gallo-Roman temples or sanctuaries often built over Celtic religious sites. Their plan was influenced by earlier Celtic sanctuaries. Fanums consisted of a cella and a peripheral gallery with lean-to roof, both square."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fanums"@en .

aat:300400629 a skos:Concept ;
    skos:definition "Flint projectile points of the Upper Paleolithic period. These are distinctive arch-backed points characteristic of the Federmesser culture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Federmesser points"@en .

aat:300400630 a skos:Concept ;
    skos:definition "Prehistoric stone tools; flakes or blades retouched to produce ragged edges probably used mostly to cut meat, but possibly also in woodworking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denticulates"@en .

aat:300400631 a skos:Concept ;
    skos:definition "Natural or artificial caves used as a burial places for one or multiple deceased, often with carved or constructed elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sepulchral caves"@en .

aat:300400632 a skos:Concept ;
    skos:definition "Original, rudimentary plows without mouldboards that are pulled by pack animals. It turns up but does not invert the soil, as opposed to the later turnplow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratch plows"@en .

aat:300400633 a skos:Concept ;
    skos:definition "Iron component of a scratch plow attached to the colter, with a sharp and pointy edge to cut the earth while plowing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scratch plowshares"@en .

aat:300400634 a skos:Concept ;
    skos:definition "Predecessors to horseshoes used in the north-western parts of the Roman Empire from the mid-first century CE. The hoof was enclosed in an oval cup of thick metal, fastened by metallic clips and leather laces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hipposandals"@en .

aat:300400635 a skos:Concept ;
    skos:definition "Altars used at religious sites for liquid offerings, which are poured over it, often through rhytons. These may slope down toward a basin to collect the liquid, or have carved depressions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation tables"@en .

aat:300400636 a skos:Concept ;
    skos:definition "Paleolithic blade tools retouched along both sides of the core to form a slug-shaped object."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "limaces"@en .

aat:300400637 a skos:Concept ;
    skos:definition "Boulders marked with deep, parallel furrows. There is no consensus as to the reason for these grooves, but it is possible that these rocks were used to polish stone tools in prehistoric times, or as timekeeping marks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grooved rocks"@en .

aat:300400638 a skos:Concept ;
    skos:definition "Ancient Greek dining halls where important guests and visitors were invited to take a sacred meal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hestiatoria"@en .

aat:300400640 a skos:Concept ;
    skos:definition "Refers to small objects of prehistoric art, especially of the Upper Palaeolithic, that could be carried from place to place, as opposed to cave art. Examples include small figures, carved tools, or pieces of jewelry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable art"@en .

aat:300400641 a skos:Concept ;
    skos:definition "Megalithic chamber tombs dating back to the Bronze Age and unique to the Balearic island of Minorca. Built from stone blocks assembled in the shape of an upturned boat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "navetas"@en .

aat:300400642 a skos:Concept ;
    skos:definition "Axes of the middle bronze age, with L-shaped handles, and similar to palstave axes but with wider, cast-on flanges. As these flanges evolved they wrapped around the handle to hold it in place. Often these also exhibit cast-on loops to which thongs were tied to secure the blade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "winged axes"@en .

aat:300400643 a skos:Concept ;
    skos:definition "Grain threshing tools of ancient Rome consisting of a heavy wooden board or sledge with iron or stone teeth fixed to the underside that through a rubbing action released the grain from the straw, leaving the chaff to be removed in another process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribula"@en .

aat:300400644 a skos:Concept ;
    skos:definition "Monumental structures built to resemble true geometric pyramids by erecting rectangular layers of diminishing size, each set back from the one below to form terraced structures rising in stages. Use of the term most often refers to mausolea in ancient Egypt, particularly the Step Pyramid of Djoser; but these structures are also found in Central America, where they were used as platforms for altars or temples, occasionally also covering the burial chamber of a ruler."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stepped pyramids"@en .

aat:300400645 a skos:Concept ;
    skos:definition "Roman commercial establishments serving as bars or taverns selling food or drink. These may have been visited exclusively by impoverished people who did not have access to kitchens of their own."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thermopolia"@en .

aat:300400646 a skos:Concept ;
    skos:definition "Capstones of pyramids or obelisks, themselves having a pyramidal form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pyramidions"@en .

aat:300400647 a skos:Concept ;
    skos:definition "Prehistoric pits filled with various artefacts such as pottery, animal bones and flint tools carefully selected and deposited there as part of a ritual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ritual pits"@en .

aat:300400648 a skos:Concept ;
    skos:definition "Simple square or rectangular cloaks made of coarse wool and worn by the Roman military, but also by the ancient Gauls, Germans, and Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saga"@en .

aat:300400649 a skos:Concept ;
    skos:definition "Standing stones with stylized designs of human figures cut into them, sometimes including clothing and weapons. These are mostly found in southern and western France, Italy, and the western Alps, and date from the Late Neolithic period through the Bronze Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "statue menhirs"@en .

aat:300400650 a skos:Concept ;
    skos:definition "Single-edged knives or short swords used by Saxon and Anglo-Saxon people during the Early Middle Ages. The shape and construction of this weapon varies widely; continental versions have a curved blunt edge while those found in England are straight-backed, with an angled point."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saxes"@en .

aat:300400651 a skos:Concept ;
    skos:definition "Bronze age tower-like monumental structures, which may be round, elliptical, or stepped in form, found on the Mediterranean islands of Minorca and Majorca. Their purpose remains unclear, though they are clustered with other funereal structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "talayots"@en .

aat:300400652 a skos:Concept ;
    skos:definition "Bronze Age T-shaped stone monuments, found on Minorca in the Balearic Islands, consisting of a vertical slab with a horizontal slab mounted at the top. These are believed to be places of religious significance, and are usually found in a complex of other structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taulas"@en .

aat:300400653 a skos:Concept ;
    skos:definition "Graves contructed from tiles forming a sloping roof over the deceased. This was a common funerary practice in classical antiquity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tile graves"@en .

aat:300400654 a skos:Concept ;
    skos:definition "Building material comprising uncoursed masonry used in the ancient Mediterranean world. Laid up of large blocks of stone in rough polygonal shapes, often fitted together without mortar. Similar to \"cyclopean masonry,\" but with more precise fitting of stones due to the straight hewn sides."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polygonal masonry"@en .

aat:300400655 a skos:Concept ;
    skos:definition "Built works that measured the water level of the Nile River during the flood season, either by markings on walls of stepped structures, or on vertical columns erected in the river itself or in specially built cisterns. Originated in Ancient Egypt and used until the Aswan dam was built."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nilometers"@en .

aat:300400656 a skos:Concept ;
    skos:definition "Greek archaic rudely carved cult statues, originally of wood, and later copied in stone. Scholarship suggests that only stone or marble copies of originals in wood have survived to the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "xoana"@en .

aat:300400657 a skos:Concept ;
    skos:definition "Earthen burial sites or graves in which a warrior or other personage is buried together with a chariot, often including horses and other possessions. This form of interment has been found in what is now modern Russia, China, and Europe dating from the Iron Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chariot burials"@en .

aat:300400658 a skos:Concept ;
    skos:definition "Patterns created by intertwining three or more strands of material into a plait. This is often achieved with human hair or used as the basis of a hairstyle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braids"@en .

aat:300400660 a skos:Concept ;
    skos:definition "The art, especially in the ancient world, of hammering, engraving, chasing, or embossing ivory or metals such as gold or silver to form reliefs and intaglios."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toreutics"@en .

aat:300400661 a skos:Concept ;
    skos:definition "Archaeological term for the secondary shaping of a stone core or implement after initial manufacture. Small fragments are removed to sharpen, straighten, or thin the core."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "retouch"@en .

aat:300400662 a skos:Concept ;
    skos:definition "Axes of the Early Bronze age, successors to the flat axe. The side edges of both faces are bent out to form flanges that secure the haft in place when the axe is being used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flanged axes"@en .

aat:300400663 a skos:Concept ;
    skos:definition "Tin vessels with compartments used to carry food, originally for field workers. The lids of these vessels could be used as plates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "porte-diners"@en .

aat:300400664 a skos:Concept ;
    skos:definition "Vessels supported by two, three or four small legs, often refers particularly to Middle American archaeological objects and also the European Beaker culture of the Neolithic and Early Bronze Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "polypod vessels"@en .

aat:300400665 a skos:Concept ;
    skos:definition "The large pointed blade components of plows, attached to a colter, with a sharp edge to cut the earth while plowing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plowshares"@en .

aat:300400666 a skos:Concept ;
    skos:definition "Holes in the ground used to hold the foot of post components of fences or other structures. In the context of archaeology, these are recognizable as circular patches of darkened earth, where wood has decayed, or the hole has later been filled with a different material. Postholes are important to archaeologists to plot the layout of former building structures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "postholes"@en .

aat:300400667 a skos:Concept ;
    skos:definition "Thin-walled slipware vessels characterized by small rolled rims and molded decoration on the outside surface. Made from the late first century BCE until the early first century CE. These are named for the craftsman who signed his goods with “Aco”. Cups of the same shape without the Aco signature are also referred to as Aco cups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aco beakers"@en .

aat:300400668 a skos:Concept ;
    skos:definition "Vessels having one end shaped as a hand with fingers holding a cup. Used during the Bronze Age as incense burners or to pour libations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation arms"@en .

aat:300400669 a skos:Concept ;
    skos:definition "Sacred places where one could consult priests or priestesses who had the prophetic gift to transfer messages from the gods."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oracular sanctuaries"@en .

aat:300400670 a skos:Concept ;
    skos:definition "Flint tools with sharp points used to pierce holes through bone, wood or skins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flint borers"@en .

aat:300400671 a skos:Concept ;
    skos:definition "Fortified enclosures constructed on a raised block of land that forms a promontory of some kind projecting out from a hillside or cliff line. The main defenses cut off the neck of the promontory, the remainder of the perimeter having natural defensive capabilities. Most date back to the Iron Age."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "promontory forts"@en .

aat:300400672 a skos:Concept ;
    skos:definition "General denomination for the fossils of certain bivalve molluscs. Distinguished from the family of living cockles comprised of over 200 species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cardiidae"@en .

aat:300400673 a skos:Concept ;
    skos:definition "Chemical element with symbol Ga and atomic number 31. A silvery, soft metallic poor metal, it is used primarily as an agent to make low-melting alloys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallium"@en .

aat:300400674 a skos:Concept ;
    skos:definition "A naturally occurring yellow or greenish glass made of silica found in parts of the Libyan Desert, the Western Desert of west Egypt, and along the Libyan-Egyptian border. Its origins remain a debated issue within the scientific community, but may be the result of a meteor impact fusing desert sand. The glass was used as a gemstone by the ancient Egyptians, and also as a material for paleolithic tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Libyan desert glass"@en .

aat:300400675 a skos:Concept ;
    skos:definition "The process of flavoring and preserving food by exposing it to smoke from burning plant materials, mostly wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "smoking"@en .

aat:300400676 a skos:Concept ;
    skos:definition "The process of preserving and flavoring food with dry salt or brine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salting"@en .

aat:300400677 a skos:Concept ;
    skos:definition "Non-clastic sedimentary rocks with a content of at least 50 percent silicon dioxide, either as quartz or as amorphous silica and cristobalite. Formation is the result of the accumulation of siliceous organic remains. Included are rocks that have formed as chemical precipitates, but not those of detrital or fragmental origin. The most common siliceous rock is chert."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siliceous rock"@en .

aat:300400678 a skos:Concept ;
    skos:definition "The repair or re-equipping of an object. In an archaeological context this refers to identifying flakes and other pieces of broken objects or chipped stones and, if possible, reassembling them on a lithic core in order to learn more about the process of making stone tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "refitting"@en .

aat:300400679 a skos:Concept ;
    skos:definition "Large rectangular pans without lids, slightly deeper than baking pans, intended for roasting meat and poultry in an oven. For enamel pans with lids, use \"roasters (cookware).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roasting pans"@en .

aat:300400680 a skos:Concept ;
    skos:definition "Process by which objects are joined to handles, especially the blades of cutting or piercing tools such as knives or sickles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hafting"@en .

aat:300400681 a skos:Concept ;
    skos:definition "Process by which substances may be crystallized again. The process may be initiated by dissolving crystals in solvent, whereby crystals reappear in the resulting concentrated solution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recrystallization"@en .

aat:300400682 a skos:Concept ;
    skos:definition "Distinctive copper arrowheads with a near-circular blade and long, sharp tang, found in four Chalcolithic tombs in Setdbal, Portugal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Palmela points"@en .

aat:300400684 a skos:Concept ;
    skos:definition "A flint projectile point from the Stone Age, typically of triangular or leaf-shaped form, with a small projection at the base for the secure attachment to a wooden shaft and two kerfs of different depth and length."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tanged points"@en .

aat:300400685 a skos:Concept ;
    skos:definition "A type of bobbin lace originally made with a naturally-colored silk thread, but which now may be white or black. It is a delicate, continuous bobbin lace, often using a heavier thread for the usually floral figuration than the ground. It was made in strips like Spanish lace. As methods for processing the silk evolved, a lighter, softer thread was obtained. Because of this evolution terminology such as \"silk blonde,\" \"white blonde,\" or \"black blonde\" laces may be encountered."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blonde"@en .

aat:300400686 a skos:Concept ;
    skos:definition "A further evolution of 16th and 17th century Old-Flemish lace. The motifs are mostly flowers, vines or animals and often encircled with decorative thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flemish bobbin lace"@en .

aat:300400687 a skos:Concept ;
    skos:definition "Fabric predecessor to needle lace originating during the 15th century. The mesh ground was formed by drawing warps and wefts from fabric at regular intervals, or by cutting out areas of embroidered fabric and introducing stitching to the void."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reticella"@en .

aat:300400688 a skos:Concept ;
    skos:definition "A non-continuous lace named for a town in East Devon, where it is thought to have originated from around the 18th century. Inspired by Brussels lace, typical motifs are roses, thistles and cloverleaves."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Honiton lace"@en .

aat:300400689 a skos:Concept ;
    skos:definition "Flat, parallel embroidery stitches worked on a ground fabric to fill a motif, and that imitates the shiny appearance of satin. It is the simplest of all embroidery stitches, but requires skill in uniformity and keeping the stitches flat and even to imitate the appearance of satin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "satin stitches"@en .

aat:300400690 a skos:Concept ;
    skos:definition "Tight, slanting satin stitches used in embroidery to form monograms and thick stems to flowers, tendrils, and branches in designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stem stitches"@en .

aat:300400692 a skos:Concept ;
    skos:definition "Japanese resist dyeing method in which patterns are applied to a fabric by folding, binding, stitching, twisting, compressing, or capping the fabric before dyeing it. These techniques date back to the 8th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shibori"@en .

aat:300400693 a skos:Concept ;
    skos:definition "Weaving technique with a simple criss-cross checkerboard pattern in which two or more filling yarns, or a single heavier yarn, pass over and under two or more warp yarns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "basket weave"@en .

aat:300400694 a skos:Concept ;
    skos:definition "Type of chordophone with strings and keys, superficially resembling a harpsichord, but functioning like a hurdy-gurdy. The strings are bowed, creating sustained tones, by means of a series of parchment-covered metal wheels that are brought in contact with the strings by pressing the keys. The wheels were powered either by a footpedal or a crank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "geigenwerks"@en .

aat:300400695 a skos:Concept ;
    skos:definition "Valveless brass aerophones with conical bores. These were used mostly in the military to give signals to the infantry. Now chiefly used to refer to trumpet-like instruments of this kind in the Middle Ages and Renaissance, distinguished from modern \"bugles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "clarions"@en .

aat:300400696 a skos:Concept ;
    skos:definition "Trombones that operate with at least three valves rather than a slide mechanism. These may have originated in Vienna ca.1830, but evidence exists of earlier versions. The valves were added to avoid the intricacies of maneuvering the slide, and made playing fast passages easier. The instrument remains in use in orchestras and also in jazz ensembles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valve trombones"@en .

aat:300400697 a skos:Concept ;
    skos:definition "The set of characters used for writing the Arabic language. It is the second most widely used alphabetic system in the world. Distinguished from the scripts used to render the alphabet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabic alphabet"@en .

aat:300400698 a skos:Concept ;
    skos:definition "An alphabet created by the scholar Mesrop Mashtots ca. 405 CE, with 36 original characters, and auxiliary letters added later historically. Used from the fifth century for the preservation of Armenian cultural and literary identity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Armenian alphabet"@en .

aat:300400700 a skos:Concept ;
    skos:definition "Long-handled brooms, often with half-round heads, used to remove cobwebs or other accumulated substances such as dust from high interior spaces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cobweb brooms"@en .

aat:300400701 a skos:Concept ;
    skos:definition "Fortifications consisting of a wooden or stone keep built on a mound of raised earth and a bailey, surrounded by a palisade and ditch. This type of castle was used in Northern Europe from the 10th until the end of the 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motte-and-bailey castles"@en .

aat:300400702 a skos:Concept ;
    skos:definition "Norman keeps, usually on the sites of older structures, and consisting of a stone wall on top of a motte, or steep mound. Within this wall, or shell, other buildings were contructed, using the wall as support, leaving an open courtyard in the center. A successor to the motte-and-bailey castle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shell keeps"@en .

aat:300400703 a skos:Concept ;
    skos:definition "Light, flat pastries with a typical honeycomb pattern, made with a batter of flour, milk and eggs and baked in a waffle iron."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "waffles"@en .

aat:300400705 a skos:Concept ;
    skos:definition "Headgear comprising circular or U-shaped garlands made from the leaves and branches of the laurel tree. An example is as worn by Roman commanders during the triumphal procession after a martial victory."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "laurel wreaths"@en .

aat:300400706 a skos:Concept ;
    skos:definition "Refers to a style of silver-gray to black Roman ware with a gloss exterior made by reduction firing. It was produced in primarily in the Augustan period in northern Gaul (presently Belgium) and distributed as far as Britain into the 1st century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terra nigra"@en .

aat:300400707 a skos:Concept ;
    skos:definition "Refers to a style of Roman red-brown slipped ware made by oxidation firing. It was produced in the Northern Gaul (presently Belgium) from the 1st century BCE to the 1st century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terra rubra"@en .

aat:300400708 a skos:Concept ;
    skos:definition "White Bruges bobbin lace originating in the 19th century, made with a mix of whole stitch and half stitch with no raised work, and that exhibits bold floral forms. The groundwork consists of plaits, picots and decorated mesh grounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bruges flower lace"@en .

aat:300400709 a skos:Concept ;
    skos:definition "Broad category of bobbin lace made in 16th and 17th century Flanders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Old-Flemish lace"@en .

aat:300400710 a skos:Concept ;
    skos:definition "Rosaline lace was originally produced to compete with or imitate 17th century Venetian lace. Floral themed, and made with fine cotton and worked with only a small number of bobbins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rosaline lace"@en .

aat:300400711 a skos:Concept ;
    skos:definition "Rosaline lace with a little pearl in needle lace added to the heart of the rosaline-flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pearled rosaline"@en .

aat:300400712 a skos:Concept ;
    skos:definition "A type of mixed lace of which the closed parts are made from Brussels Duchesse lace and the spaces in between are filled with a light mesh in needle lace. Characteristic of English lace are the refined patterns with natural motifs and elegant decorations such as stars, reliefs, and eyelets, applied in both bobbin and needle lace."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "English needle lace"@en .

aat:300400713 a skos:Concept ;
    skos:definition "Type of bobbin lace made in Paris from the 18th century onwards. This firm lace, not fit for gathering, is characterized by its hexagonal mesh, which is formed by intertwining triangles. The pattern consists mostly of flowers, leaves or vines or occasionally animal figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Paris bobbin lace"@en .

aat:300400714 a skos:Concept ;
    skos:definition "A type of symmetric, thick and sturdy bobbin lace with very dense motifs. It was made in the 17th century in Flanders to be sold on the Dutch market. It is sometimes referred to as \"Brabant lace\" but is not to be mistaken with the lace made in Brussels from the 18th century onwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dutch lace"@en .

aat:300400715 a skos:Concept ;
    skos:definition "Type of lace reuniting elements and motifs from bobbin and needle lace to form a harmonious piece. It can also contain mechanical elements such as tape and tulle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mixed lace"@en .

aat:300400716 a skos:Concept ;
    skos:definition "Mixed lace from Milan with a ground in needle lace on which motifs made from mechanically made tape are applied; these motifs most often depict flowers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Milan lace"@en .

aat:300400717 a skos:Concept ;
    skos:definition "A type of mixed lace consisting of a light ground in mechanically produced tulle on which motifs are applied in bobbin- or needle lace. These motifs may be floral or figural. The technique was common from the mid-18th century and throughout the 19th."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "application lace"@en .

aat:300400718 a skos:Concept ;
    skos:definition "Embroidery technique employing metal threads fixed to a fabric. The threads consist of cotton or silk coated in metals such as imitation gold, silver and copper. The technique originated in Asia some two thousand years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goldwork"@en .

aat:300400719 a skos:Concept ;
    skos:definition "Reliquaries that house of what are believed to be pieces of the \"True Cross\" on which Christ was crucified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "staurothekes"@en .

aat:300400720 a skos:Concept ;
    skos:definition "Miniature figurines or models representing soldiers, varying from simple toys for children to play with to highly detailed models to collect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "toy soldiers"@en .

aat:300400721 a skos:Concept ;
    skos:definition "Staffs culminating in an ornament such as a pine cone and sometimes decorated with ivy or wine leaves. In Greek mythology, the staff belonged to Dionysos and his followers. These were used as sacred instruments during religious rituals and celebrations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thyrsuses"@en .

aat:300400723 a skos:Concept ;
    skos:definition "Lidded, cylindrical containers decorated with engravings; found in graves of the 4th–3rd centuries BCE around the city of Praeneste (Palestrina). Used by the Etruscans to store toiletries and objects such as bronze mirrors, smaller vessels, and jewelry. Made of hammered bronze, cistae have low-profile domed lids with cast handles often in the shape of two or three human figures, feature engraved decoration derived from mythological subjects, and often stand on clawed feet. These are thought to be gifts both for the living and ceremonial offerings for the dead."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cistae"@en .

aat:300400724 a skos:Concept ;
    skos:definition "Prehistoric biface stone tools, usually u-shaped, large and oblong, with transverse cutting edges. Thought to be used for heavy digging, the slaughter of animals, skinning game, and bone breaking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cleavers"@en .

aat:300400725 a skos:Concept ;
    skos:definition "Small seaside cabins that are rented out during the summer months. They are used as changing rooms and to store personal belongings during a visit to the beach, but not as habitations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beach huts"@en .

aat:300400726 a skos:Concept ;
    skos:definition "Specialized arboretums where only, or predominantly, coniferous trees are cultivated, either for scientific or ornamental purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pineta"@en .

aat:300400727 a skos:Concept ;
    skos:definition "Farmhouses typical of the Eiderstedt peninsula in Germany. These have square floor plans and a wooden framework on which rests a pyramid-shaped reed roof. Hay is stacked in the central space of the building, surrounded by the living quarters, stalls and other storage areas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haubargs"@en .

aat:300400729 a skos:Concept ;
    skos:definition "Small, earthwork fortifications in the form of an entrenched earthen rectangle, square, or pentagon that were used mostly in Northern Europe from the late middle ages until the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sconces"@en .

aat:300400730 a skos:Concept ;
    skos:definition "Instruments for corporal punishment consisting of a bundle of supple twigs bound together and used to strike the offender's bare skin."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "birch rods"@en .

aat:300400731 a skos:Concept ;
    skos:definition "Occasional printing, used for advertisements, letters, flyers and visiting cards. The type is reduced and consists of formulas; the production period is very short."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "job work"@en .

aat:300400732 a skos:Concept ;
    skos:definition "Cameras that can be folded into a compact package for storage or transport. The lenses of these cameras are attached to an extendable or collapsible bellows. These can only be focused once they are fully extended."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "folding cameras"@en .

aat:300400733 a skos:Concept ;
    skos:definition "Cameras intended for a single use. These normally are fitted with fixed-focus lenses, and are sold loaded with film, mostly 35mm. Some are also equipped with integrated flash units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disposable cameras"@en .

aat:300400734 a skos:Concept ;
    skos:definition "Cameras that generate developed images by means of chemicals integral to the film medium itself. Invented by Edwin Land and the Polaroid Corporation, which had patents for these processes and became synonymous with them, but instant cameras have been marketed by other brands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "instant cameras"@en .

aat:300400735 a skos:Concept ;
    skos:definition "Manually-powered cinematic apparatuses developed in France by the Lumière brothers at the end of the 19th century, which functioned as motion picture cameras, film projectors, and developers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinematographs"@en .

aat:300400737 a skos:Concept ;
    skos:definition "Stereoscopic cameras that made exposures on glass plates, and that could be transformed into stereo viewers by removing the shutter panel. Introduced in 1904 and used until the 1930s. These were marketed as cheaper alternatives to Verascopes, a similar device made by the same manufacturer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glyphoscopes"@en .

aat:300400738 a skos:Concept ;
    skos:definition "Navigational maps that primarily display traffic roads but also commonly include administrative boundaries, and points of interest for travellers. Since the mid-20th century these have been primarily intended for use by motorists."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "road maps"@en .

aat:300400739 a skos:Concept ;
    skos:definition "Conical, solid pottery funerary sculptures that were placed in the walls at the entrances of Egyptian tombs, almost exclusively at the Theban necropolis. The flat, round bases of the cones were stamped with hieroglyphs stating the name or title of the deceased, or longer texts such as prayers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "funerary cones"@en .

aat:300400740 a skos:Concept ;
    skos:definition "Late-medieval daggers in widespread use by the mid-1300s. These were long, slim needle-pointed blades with cylindrical grips, usually placed between disc-shaped pommels and crossguards, both called rondels. The blade could either be flat, with one or two sharp edges, diamond-shaped, or triangular."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rondel daggers"@en .

aat:300400741 a skos:Concept ;
    skos:definition "Broadsword with a basket-shaped guard consisting of two oval rings perpendicular to the blade enclosing two slightly convex shells with punched holes. In use from the middle of the 17th century The name derives from Wallonia, a region in Belgium."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Walloon swords"@en .

aat:300400742 a skos:Concept ;
    skos:definition "Sixteenth century two-handed swords with undulating blades resembling a flame and with a very long hilt. Used by the so-called Landsknechte, German mercenary soldiers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flambards"@en .

aat:300400743 a skos:Concept ;
    skos:definition "Small and light round shields carried by medieval foot soldiers to protect themselves in battle. The reduced size allowed soldiers to move freely and swiftly."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rondaches"@en .

aat:300400744 a skos:Concept ;
    skos:definition "Curved swords derived from the sabres used historically by Egyptian Mamluk warriors. In the 19th century, several western armies, such as the French and the British, adopted these. The western version had a similar hilt, but the blade resembled that of contemporary western sabres."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mameluke swords"@en .

aat:300400745 a skos:Concept ;
    skos:definition "Short-bladed, slightly curved infantry sabers carried by the soldiers and officers of Napoleon's Imperial Guard. \"Briquet\" refers to a metal blade flint striker for lighting fires, which resembled this infantry short sword. The term for the sword was made official in an instruction of June 1806 by Napoleon's ministry of war. The two-foot blades were mostly used for utilitarian purposes, but could also inflict serious injuries during battle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "briquets"@en .

aat:300400747 a skos:Concept ;
    skos:definition "Vessels made from materials such as stone, glass, or clay used to store ointments and oils. Ancient Egyptian ointment vessels were often lavishly decorated or shaped as delicate animals or young women, symbolizing rebirth or regeneration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ointment vessels"@en .

aat:300400748 a skos:Concept ;
    skos:definition "Services intended for use in serving liquor, generally consisting of a carafe, a number of small glasses and often a matching tray."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liqueur sets"@en .

aat:300400749 a skos:Concept ;
    skos:definition "Old Egyptian protective amulets, usually hung at the back of the neck as a counterpoise part of a necklace with a corresponding front plate, or \"aegis.\" It was frequently made of glazed ware and was often found buried with the dead, and it was a symbol of divine protection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "menats"@en .

aat:300400750 a skos:Concept ;
    skos:definition "Vestments worn in some Eastern Orthodox churches as a sign of authority or rank. These are made from a stiff, lozenge-shaped or rectangular cloth, and hang on the right side of the body, below the waist. These may have a cross or other image embroidered on it, and are suspended at knee height by a ribbon attched to the girdle or shoulder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epigonations"@en .

aat:300400751 a skos:Concept ;
    skos:definition "Metal loops attached to a horse's bit, which guide the reins and prevent them from becoming tangled or snagged on the harness."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrets"@en .

aat:300400752 a skos:Concept ;
    skos:definition "Straps, or pairs of straps, usually of leather, and attached to the bridle or bit of horses or other animals, used by riders to direct their locomotion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reins"@en .

aat:300400753 a skos:Concept ;
    skos:definition "Parts of the tack that attach the backband to a horse's chest, preventing it from sliding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chest straps"@en .

aat:300400755 a skos:Concept ;
    skos:definition "Straps used to fasten stirrups to a saddle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stirrup leathers"@en .

aat:300400756 a skos:Concept ;
    skos:definition "Straps with looped ends that are components of bridles attached to the headpiece. These are mounted on a horse's forehead between eyes and ears so that the bridle remains secure. Brow bands may also be decorative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brow bands"@en .

aat:300400757 a skos:Concept ;
    skos:definition "Long leather reins attached to a bit on both sides, used by drivers to lead their horse drawing a cart or wagon and keep the pace under control."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leading reins"@en .

aat:300400758 a skos:Concept ;
    skos:definition "Parts of a bridle that prevent a horse from opening its mouth wide enough to lay its tongue over the bit. It also keeps the bit stable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nosebands"@en .

aat:300400759 a skos:Concept ;
    skos:definition "Objects that can be attached to bridles, consisting of leather or plastic cups placed on either side of the horse's eyes to limit its range of vision."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blinders"@en .

aat:300400760 a skos:Concept ;
    skos:definition "Large, firm pieces of leather at the side of saddles, used to protect the rest of the saddle from the horse's sweat and also the animal's skin from being pinched by the girth straps and buckles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sweat flaps"@en .

aat:300400761 a skos:Concept ;
    skos:definition "In saddlery, straps that pass under the horse's throat, securing the bridle in position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "throat lashes"@en .

aat:300400762 a skos:Concept ;
    skos:definition "Straps fitted over horses' heads, behind its ears, holding the other parts of the bridle in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "head pieces"@en .

aat:300400763 a skos:Concept ;
    skos:definition "Pairs of ropes, chains, or usually leather straps with which a draught animal is attached to the splinter-bar or swingletree of the vehicle it's pulling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "traces"@en .

aat:300400764 a skos:Concept ;
    skos:definition "Raised back parts of some saddle seats, which provide support and keep the rider in the saddle."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cantles"@en .

aat:300400765 a skos:Concept ;
    skos:definition "Boxes used to house Egyptian funerary ushabti figures in tomb settings. Evolving from miniature coffins, ushabti boxes became larger during the New Kingdom, housing multiple figures, and were decorated with funerary scenes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ushabti boxes"@en .

aat:300400766 a skos:Concept ;
    skos:definition "Disc-shaped objects made from papyrus, stuccoed linen, bronze, gold, wood, clay or resin, placed by ancient Egyptians under the heads of the dead. The disc, which was inscribed with images, symbolized the eye of Ra or Horus, and was related to the idea of resurrection."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypocephali"@en .

aat:300400767 a skos:Concept ;
    skos:definition "Masks painted on stucco, cartonnage, metal, or wood that were placed over the heads of mummies in order to preserve the facial features of the deceased. The painted features were idealized; in the Greek-Roman period they became more realistic. For the later flat Fayum portraits of Rome-occupied Egypt, use \"mummy portraits.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mummy masks"@en .

aat:300400768 a skos:Concept ;
    skos:definition "Knives with curved, spatulate blades, which may be in a half-moon or a crescent shape. These are used to cut heavy leathers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saddler's knives"@en .

aat:300400769 a skos:Concept ;
    skos:definition "The rounded ends of tobacco smoking pipes. These are often found as separate components during archeological excavations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pipe bowls"@en .

aat:300400770 a skos:Concept ;
    skos:definition "Mostly metal parts of a single-reed instrument used to keep the reed in place against the mouthpiece, without obstructing its vibrations when played."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ligatures"@en .

aat:300400771 a skos:Concept ;
    skos:definition "Pipes designed to vaporize and inhale opium, consisting of a long stem and a small ceramic bowl connected by a metal fitting. The opium is heated in the bowl over an opium lamp, causing it to vaporize, after which the smoker inhales the opium through the stem."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opium pipes"@en .

aat:300400773 a skos:Concept ;
    skos:definition "Devices in which photographic film is secured before it is attached to a camera or other image-recording device. Their shape and size depend on the format of the film, and normally includes removable dark-slides to reveal the film before exposure, or to protect the film while removing the film holder from the camera."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film holders"@en .

aat:300400774 a skos:Concept ;
    skos:definition "Devices with which pages of a book or other materials can be turned without the use of hands. With variations in design these may be used to assist reading for the disabled, for musicians reading musical scores, or to photographically duplicate books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "automatic page turners"@en .

aat:300400775 a skos:Concept ;
    skos:definition "Mechanized devices used to increase the quality of textile materials by removing impurities, blending raw materials, and untangling/cleaning textile fibers. These devices are typically fitted with sturdy fabrics embedded with wire teeth or pins, which are used to cover a series of cylinders that rotate at varying speeds. Loose fibers are separated, removed, and/or disentangled as textile materials pass through the devices' rotating cylinders and encounter the sharp wire teeth. These machines alleviated the problem of hand carding, a task that slowed the newly mechanized production of textiles in the 18th century. Several inventors developed machines to perform carding, including John Kay, Oliver Evans, Lewis Paul, R. Arkwright, and Johann Bodmer. Mechanized devices used to increase the quality of textile materials by removing impurities, blending raw materials, and untangling/cleaning textile fibers. These devices are typically fitted with sturdy fabrics embedded with wire teeth or pins, which are used to cover a series of cylinders that rotate at varying speeds. Loose fibers are separated, removed, and/or disentangled as textile materials pass through the devices' rotating cylinders and encounter the sharp wire teeth. Mechanized devices, typically comprising a series of steel rollers, gears, and a rotating steel drum with steel bristles, designed to comb, blend, and align the fibers of raw cotton or wool in preparation for subsequent spinning processes. When passed through the device's rollers, drum, and bristles, raw materials are rid of impurities and transformed into long fleecy rolls of blended sliver. First invented in England by both Daniel Bourne and Lewis Paul in the 1740s, these devices ultimately replaced manul carding due to their speed and efficiency."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carding machines"@en .

aat:300400776 a skos:Concept ;
    skos:definition "Shackles attached to the neck to prevent free motion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "neck shackles"@en .

aat:300400777 a skos:Concept ;
    skos:definition "Flogging instruments made from stretched bull penises that are stretched, twisted, and dried to form whips for corporal punishment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bull's pizzles"@en .

aat:300400778 a skos:Concept ;
    skos:definition "Optical devices invented by Carlo Ponti in 1860, and patented in 1861. These were used to view photographic transparencies or prints. It was claimed that stereoscopic relief was obtained from a single photograph, though the stereo effect was due to the nature of an illusion caused by the single viewing lens of the alethoscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alethoscopes"@en .

aat:300400779 a skos:Concept ;
    skos:definition "Spools used to wind lengths of photographic or motion-picture film for projection, processing, or storage."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "film reels"@en .

aat:300400783 a skos:Concept ;
    skos:definition "Covers worn on the fingernails. Examples include those worn by women on their fingers to protect their fingernailsl, in some cultures also used as a status symbol."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nail protectors"@en .

aat:300400784 a skos:Concept ;
    skos:definition "Lace or ribbon flounces attached to the back of a bonnet to cover a lady's neck for modesty or to prevent sunburn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bavolets"@en .

aat:300400785 a skos:Concept ;
    skos:definition "The undersurfaces of shoes, boots, or other footwear that make contact with the ground; the parts upon which the wearer treads. These are usually made from firm but flexible materials such as rubber or leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "soles"@en .

aat:300400786 a skos:Concept ;
    skos:definition "Devices worn over the shoulder or on the back, made of fabric or other materials including bark, used to support and carry an infant. These have been used throughout human history and into the present day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baby slings"@en .

aat:300400787 a skos:Concept ;
    skos:definition "Auxiliary straps of horse harnesses, with one part attached to the animal's girth and the other attached to the noseband or throat lash. It is intended to prevent the animal from rearing or throwing back its head, or to reinforce the action of the bit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "martingales"@en .

aat:300400788 a skos:Concept ;
    skos:definition "Openwork guards, most often of leather or metal, placed over the snouts of animals, usually dogs, to prevent them from opening their mouths, biting, or eating."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muzzles"@en .

aat:300400790 a skos:Concept ;
    skos:definition "Elastic, ring-shaped rubber or latex loops usually used as temporary binding devices for paper or other objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rubber bands"@en .

aat:300400791 a skos:Concept ;
    skos:definition "Prints in which the image has been printed onto a thin sheet of paper, such as China paper; the thin sheet is then backed by a thicker sheet of paper. These prints usually date from the 19th century. They were prized because thin China paper received the intaglio impression readily, and the product had a richer appearance than a standard print. Over time, the two types of papers age differently, and conservation problems may result."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chine appliqué prints"@en .

aat:300400792 a skos:Concept ;
    skos:definition "A pharmaceutical substance made of zinc oxide with small amount of fenic oxide (to give faint pink color), and containing after ignition, not less than 98% and not more than 100.5% zinc oxide. Commercial calamine may be distributed as a pink lotion, used as a skin protectant and salve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calamine"@en .

aat:300400793 a skos:Concept ;
    skos:definition "A thick, coarse fabric that usually contains a cotton warp woven with coarse animal hair, particularly hair from horses, goats, or camels. Haircloth is stiff, but resilient, and was used as interlining material for tents, clothing, and upholstery. It use has been superseded by synthetic fabrics in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haircloth"@en .

aat:300400794 a skos:Concept ;
    skos:definition "Tops, sometimes decorative, for sealing bottles; they are formed by a shaft to fit into the bottle joined to a top by which to grasp the stopper. Examples include stoppers for decanters, uncorked wine bottles, and perfume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bottle stoppers"@en .

aat:300400795 a skos:Concept ;
    skos:definition "Large rakes fitted with tempered teeth or serrated blades, for use in fighting wildfires. An example of usage is to establish a fire break in the brush."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fire rakes"@en .

aat:300400796 a skos:Concept ;
    skos:definition "Clamps used as temporary fasteners during filmmaking, for example to affix gels or diffusion materials to the barn doors of hot lights. The common \"clothespins (laundry fasteners)\" may be utilized for this purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "C47s"@en .

aat:300400797 a skos:Concept ;
    skos:definition "Smoothing and polishing tools of various designs, often made of ivory or bone, but also of smooth stone or wood. Often used in the context of archaeology, where the style of the tool could indicate the culture that used it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lissoirs"@en .

aat:300400798 a skos:Concept ;
    skos:definition "Annual 15-day festival in China and Chinese communities around the world that begins with the first day of the first lunar month, which occurs sometime between January 21 and February 20 according to Western calendars, and lasts until the following full moon. The festival originated in ancestor and deity worship rituals in the Shang Dynasty (ca. 16th to 11th century BCE); it was firmly established in the Western Han Dynasty (206 BCE-8 CE). Activities associated with the festival include cleaning the home, worship of deities and ancestors, family reunions, preparation of special foods, receiving cash in red envelopes, posting poetry, lighting candles, and setting off firecrackers, symbolizing wishes for a happy new year and a fortuitous future."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese New Year"@en .

aat:300400799 a skos:Concept ;
    skos:definition "Hollows or impressions in a surface, such as are made by a blow with a sharp or edged instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dents"@en .

aat:300400800 a skos:Concept ;
    skos:definition "The process or condition of making or having hollows or impressions in a surface, such as by a blow with a sharp or edged instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "denting"@en .

aat:300400801 a skos:Concept ;
    skos:definition "Small hollows or dents formed in a surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimples"@en .

aat:300400802 a skos:Concept ;
    skos:definition "In a surface, hollows or depressions that are longer than they are broad."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "troughs"@en .

aat:300400803 a skos:Concept ;
    skos:definition "Festival celebrated in China and other Asian countries, and elsewhere by people of Asian descent; it marks the last day of the lunar New Year celebration, on the first full moon night of the 15th day of the first lunar month. The festival has its origin in the religious rituals of the imperial palace, dating to the Han Dynasty (206 BCE-220 CE). In time, the festival merged with other folk customs, such as lighting candles to honor Buddha or to pray for blessings on the holy birthday of Tian Guan. Customs observed in this festival symbolize family reunion and a blissful life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Lantern Festival"@en .

aat:300400804 a skos:Concept ;
    skos:definition "Festivals celebrated in China and other Asian countries, and elsewhere by people of Asian ethnicity or descent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese festivals"@en .

aat:300400805 a skos:Concept ;
    skos:definition "Traditional festival in ancient China, focused on prayers for a good harvest. The date of the festival falls approximately on the fifth Wu day after Li Chun (Beginning of Spring), which is near the vernal equinox. The observance of Spring Sacrifice flourished particularly during the Tang and Song dynasties (618-1279 CE). Differences concerning the date on which to carry out ritual sacrificial ceremonies developed between the official and the civil communities in the Ming Dynasty (1368-1644 CE). From then on, official rituals were held according to the calendar of the Tang Dynasty, while civilians held ceremonies on the second day of the second lunar month. Observances included earth god worship, community feasts, and eating spring rolls. The tradition has waned in modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Spring Sacrifice"@en .

aat:300400806 a skos:Concept ;
    skos:definition "Chinese solar festival focused on honoring ancestors, that starts on the 15th day after the vernal equinox. It originated from the custom of offering sacrifices to ancestors; observances include the veneration of ancestors, honoring their teachings and virtues, sweeping their tombs, having picnics, and placing willow branches on doors. Ancestor worship flourished after the Tang Dynasty (618-907 CE). Because the date of the Qingming Festival was close to the Hanshi Festival (Cold Food Festival) and the Shangsi Festival (Double Third Festival), customs of these two festivals have been adopted in the retained in, Qingming Festival, including the banning of fire, eating raw food, sweeping tombs, and spring outings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Qingming Festival"@en .

aat:300400807 a skos:Concept ;
    skos:definition "Chinese festival celebrated on the fifth day of the fifth lunar month. It is believed to have originated from the customs of warding off epidemics and driving away evil spirits in ancient times, associated with illness since it falls in first month of summer, when epidemics spread quickly. This time of year, when the sun at its strongest at the summer solstice is associated with the Chinese dragon, which traditionally represents masculine energy. Observances include dragon boat races and various folk customs to protect from infectious diseases and other forms of evils, including hanging calamus and mugwort leaves, wearing scented sachets, drinking realgar wine, hanging up pictures of Zhongkui the ghost catcher. Beginning in the Han Dynasty (206 BCE-220 CE), the festival has included references to the legend of Qu Yuan (340-278 BCE), a poet and a high-ranking official who served the State of Chu in the Warring States Period (475-221 BCE). Despairing of the political situation, he drowned himself in the Miluo River on the fifth day of the fifth lunar month. Now in commemoration of him, celebrants organize dragon boat races and make zongzis rice dishes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dragon Boat Festival"@en .

aat:300400808 a skos:Concept ;
    skos:definition "The topmost components of axes, often made of stone or metal, having at least one sharpened edge. Axe heads are attached to the shafts of the axe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ax heads"@en .

aat:300400809 a skos:Concept ;
    skos:definition "Chinese festival celebrated on the seventh day of the seventh lunar month, primarily focused on prayers by women for dexterity in needlework and a happy marriage. The festival has its origin in astronomical rituals of early Chinese people, particularly the Western Han Dynasty (206 BCE-8 CE). The stars Altair and Vega came to represent the legendary lovers Niu Lang (the Cowherd) and Zhi Nu (the Weaver Girl). Observances include offering fruits to the goddess, threading seven-hole needles, watching stars in the sky, and laying clothes to dry in a tower."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Double Seventh Festival"@en .

aat:300400810 a skos:Concept ;
    skos:definition "Harvest festival celebrated by ethnic Chinese and Vietnamese peoples on the 15th day of the eighth lunar month, near the autumnal equinox. The festival has roots in ancient Chinese religious rituals celebrating the harvest. It may also have ties to ancient moon-worshipping rituals. Observances included worshipping Tudi Gong (the earth god) or Tai Yin Jun (the moon god) and references to other myths and legends incorporating the moon. It is customary to have a family reunion during the full moon, to eat moon cakes, and to appreciate the beauty of the full moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mid-Autumn Festival"@en .

aat:300400811 a skos:Concept ;
    skos:definition "Chinese festival observed on the ninth day of the ninth month in the Chinese calendar; it is documented since before the East Han period, before 25 CE. According to the \"I Ching,\" nine is a yang number, which is a traditional Chinese spiritual concept. According to custom, it is held that the double yang of this day is too much yang, and potentially dangerous; to protect against danger, it was customary to climb a high mountain, drink chrysanthemum wine, and wear the cleansing zhuyu plant. Other observances may include visiting the graves of ancestors, cleaning the graves, laying out food offerings, and burning incense."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Double Ninth Festival"@en .

aat:300400813 a skos:Concept ;
    skos:definition "Physical manifestations of messages sent via telex transmissions, printed by teleprinters that recieve messages via public telecommunication lines."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telex printouts"@en .

aat:300400814 a skos:Concept ;
    skos:definition "An international telegraphy system consisting of a network of teleprinters connected by telecommunication lines. Subscribers to a telex service may exchange text and data directly and securely with one another. When a message is sent, it may either be printed immediately or stored for subsequent printing or display on a monitor. Frequently capitalized, 'telex' in ordinary usage is not a proprietary term. 'Telex' is a registered trademark in the United States, but in in most other countries telex systems were operated by government agencies. The names of some specific products (radio equipment, hearing aids, etc.) of the Telex Corporation are registered as trade marks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "telex"@en .

aat:300400815 a skos:Concept ;
    skos:definition "Term used indiscriminately to refer to soft, low quality copal resins, but particularly the resin obtained from the Hymenaea courbaril trees of South America. The name has also been used for the hard, semi-fossilized, high-quality Zanzibar copal, but anime may be distinguished from other copals by being soft, clear, and alcohol-soluble. There are a number of other oleoresinous products also known as 'anime,\" or \"gum anime.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anime"@en .

aat:300400816 a skos:Concept ;
    skos:definition "Species found in Southern Mexico, throughout Central America and the West Indies to northern Brazil, Bolivia, and Peru. The tree's best development is on ridges or slopes and high riverbanks. The wood is used for furniture and tools. The tree exudes a resinous gum used in varnishes and scents."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hymenaea courbaril"@en .

aat:300400817 a skos:Concept ;
    skos:definition "Electrical connections used in telephones, computers, network cabling, and other contexts; characterized by solid copper wires having been punched down into short open-ended slots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "punch blocks"@en .

aat:300400818 a skos:Concept ;
    skos:definition "Holidays associated with a particular culture or ethnicity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural holidays"@en .

aat:300400819 a skos:Concept ;
    skos:definition "General term for numerous marsh or waterside plants characterized chiefly by stiff, pithy, or hollow stems, particularly those in the family Juncaceae. The stems of these plants have been used for weaving since prehistoric times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rushes"@en .

aat:300400821 a skos:Concept ;
    skos:definition "Objects comprising a length of metal, wood, plastic or other material, bent back or otherwise fashioned with a sharp angle, often having a C-shape. Typically hooks form a part of something else, such as a pole, chain, or the like, adapted for catching hold, dragging, sustaining suspended objects, or another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hooks"@en .

aat:300400822 a skos:Concept ;
    skos:definition "People who make or trade in bows."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bowyers"@en .

aat:300400823 a skos:Concept ;
    skos:definition "Boats having a hull that is similar or exactly alike on both ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double-ended boats"@en .

aat:300400824 a skos:Concept ;
    skos:definition "Genus of moth; the caterpillars of several species produce wild silk of commercial importance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Antheraea"@en .

aat:300400825 a skos:Concept ;
    skos:definition "Textile made from silk fibers produced by wild silk worms. Given that the fibers are usually brown in color, the textile, when dyed, is typically dyed dark colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tussah silk"@en .

aat:300400826 a skos:Concept ;
    skos:definition "Protein substance spun by spiders as thin, uniform filaments to make webs, other structures, conveyance, or to capture prey. A strand of spider silk is about 25 micrometers (0.00001 inches) in diameter. It is strong and dimensionally stable. Hummingbirds and other animals use spider silk for nest-building. Spider silk is currently used for crosshairs in optical instruments. Attempts have been made to produce fabric from spider silk, but it took an enormous number of spider webs and work to produce a fabric that was so sheer that it was of little use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "spider silk"@en .

aat:300400827 a skos:Concept ;
    skos:definition "Textile made from untreated silk fibers as reeled from cocoons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raw silk"@en .

aat:300400828 a skos:Concept ;
    skos:definition "Structures having fine, filmy textures spun from excretions by spiders and some caterpillars"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "webs"@en .

aat:300400829 a skos:Concept ;
    skos:definition "Research, study, teaching, publication, and other dissemination of information in the humanities that is mediated through digital technology. It is an evolving area of study, using computing technologies to investigate questions and areas of research that are both traditional and new to the humanities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital humanities"@en .

aat:300400830 a skos:Concept ;
    skos:definition "Research, study, teaching, publication, and other dissemination of information in the field of art history using digital technologies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital art history"@en .

aat:300400831 a skos:Concept ;
    skos:definition "People who write accounts of events they have experienced in their lives. For people who write daily entries of their activities, use \"diarists.\" For people who write accounts of their lives, but as a biography rather than as an episodic account, use \"autobiographers.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memoirists"@en .

aat:300400832 a skos:Concept ;
    skos:definition "Authors who write the history of their own lives. For authors who write episodic accounts of events in their lives, prefer \"memoirists.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "autobiographers"@en .

aat:300400833 a skos:Concept ;
    skos:definition "In Hinduism or Janism, religious ascetics or holy persons who have renounced worldly life. Sadhus may live together in monasteries (mathas) that usually belong to a particular order. They may also wander throughout the country alone or in small groups or isolate themselves in small huts or caves. They generally take vows of poverty and celibacy and depend on the charity of householders for their food. Their dress and ornaments differ according to sectarian allegiances and personal tastes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sadhus"@en .

aat:300400834 a skos:Concept ;
    skos:definition "General term for several spiritual movements that attempt to revive the ancient polytheistic religions of Europe and the Middle East. They strive to revive authentic pantheons and rituals of ancient cultures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Neo-Paganism"@en .

aat:300400835 a skos:Concept ;
    skos:definition "Beliefs of the indigenous ancient Egyptians from predynastic times (4th millennium BCE) to the disappearance of the traditional culture in the first centuries CE. It included a complex system of polytheistic beliefs and rituals, focused on interaction with many deities who were believed to be present in, and in control of, the forces and elements of nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian religion"@en .

aat:300400836 a skos:Concept ;
    skos:definition "Beliefs and practices of the inhabitants of the Italian peninsula from ancient times until the ascendancy of Christianity in the 4th century CE. It is influenced by religions of ancient Italic cultures, especially those of other Latin tribes, of the non–Indo-European Etruscans, as well as by that of the Greek colonizers of Sicily and southern Italy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman religion"@en .

aat:300400837 a skos:Concept ;
    skos:definition "Religious beliefs and practices of the ancient Hellenes. Noted as one of the world's most complex and sophisticated mythologies. Although its origins are very ancient, Greek religion in its developed form lasted around 1,000 years, from the time of Homer (ca. 9th /8th century BCE) to the reign of the emperor Julian (4th century CE)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek religion"@en .

aat:300400838 a skos:Concept ;
    skos:definition "Religion of the ancient Etruscans, involving complex rules regulating a large number of rituals. Heavily based on influences from Greece in its orientalizing period, but the religion of Etruria proclaims a very un-Greek view of the abasement and nonentity of man before the gods and their will. Known from the Mediterranean Iron Age in the second half of the first millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Etruscan religion"@en .

aat:300400839 a skos:Concept ;
    skos:definition "Beliefs and practices of the peoples who inhabited ancient Mesopotamia (now in Iraq) in the millennia before the Christian era, including Sumerians and Akkadians, and their successors, the Babylonians and Assyrians. These religious beliefs and practices form a single stream of tradition that was Sumerian in origin, but augmented and modified by the Akkadians, who were Semites who emigrated into Mesopotamia from the west at the end of the 4th millennium BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mesopotamian religion"@en .

aat:300400841 a skos:Concept ;
    skos:definition "Religious beliefs and practices of the Balts, ancient inhabitants of the Baltic region of eastern Europe who spoke languages belonging to the Baltic family of languages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Baltic religion"@en .

aat:300400842 a skos:Concept ;
    skos:definition "Beliefs of Arabia and the Syrian desert, comprising the polytheistic beliefs and practices that existed before the rise of Islam in the 7th century CE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arabian religion"@en .

aat:300400843 a skos:Concept ;
    skos:definition "Religious beliefs and practices of the ancient Celts, an ancient Indo-European people, peaking during the 4th century BCE, extending across the length of Europe from Britain to Asia Minor. The religion included many male and female deities, some of whom were venerated only in a small, local area, but others whose worship had a wider geographical distribution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic religion"@en .

aat:300400844 a skos:Concept ;
    skos:definition "General term for various systems of beliefs and practices of the eastern Mediterranean peoples under Hellenistic influence from 300 BC to 300 BCE. Characterized by a spiritual revolution in the Greek and Roman empires, when old cults died or were fundamentally transformed and when new religious movements came into being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hellenistic religion"@en .

aat:300400845 a skos:Concept ;
    skos:definition "Beliefs and practices of the ancient peoples and civilizations of what is now Turkey and Armenia, including the Hittites, Hattians, Luwians, Hurrians, Assyrian colonists, Urartians, and Phrygians. Until comparatively recent times, the pre-Christian religions of Anatolia (Asia Minor) were known only through the works of classical writers. For the Greeks and Romans, Asia Minor was above all the home of the religion of Cybele, the Great Mother of the Gods, whose cult was centred in Phrygian Pessinus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anatolian religions"@en .

aat:300400846 a skos:Concept ;
    skos:definition "Widespread indigenous religious movement among North American Indians, entailing the use of peyote, which produces hallucinogenic effects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Peyotism"@en .

aat:300400847 a skos:Concept ;
    skos:definition "Systems of diverse beliefs and practices of the culturally and linguistically related group of ancient peoples who inhabited the Iranian plateau and its borderlands, as well as areas of Central Asia from the Black Sea to Khotan (modern Hotan, China). In religion and culture, both the northern and southern Iranians had much in common with the ancient Indo-Aryan-speaking peoples of the Indian subcontinent, although there was much borrowing from Mesopotamia as well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Iranian religion"@en .

aat:300400848 a skos:Concept ;
    skos:definition "Beliefs and practices of the ancient Slavic peoples of eastern Europe, a large branch of the Indo-European family of peoples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Slavic religion"@en .

aat:300400849 a skos:Concept ;
    skos:definition "Indigenous, traditional religious beliefs and practices of the peoples of Africa south of the Sahara, which are not homogeneous across cultures but share certain commonalities in world view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "African religions"@en .

aat:300400850 a skos:Concept ;
    skos:definition "Ancient Greek practices and philosophy stressing a movement in the world from cosmic order, represented mythologically by an original primordial egg, to a gradually developing disorder. Most scholars agree that by the 5th century BCE the Orphic movement existed, with travelling priests who offered teaching and initiation, based on a body of legend and doctrine said to have been founded by Orpheus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Orphism"@en .

aat:300400851 a skos:Concept ;
    skos:definition "System of beliefs and practices prevalent in ancient Palestine and Syria from the 2nd and 1st millennia BCE forward, focused on the deities El, Baal, and Anath. Occasionally blended with the essential monotheism of the Israelites after they occupied Canaan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Canaanite religion"@en .

aat:300400852 a skos:Concept ;
    skos:definition "Religious tradition of African origin that was developed in Cuba and then spread throughout Latin America and the United States. Santería was brought to Cuba by the people of the Yoruban nations of West Africa, who were enslaved in great numbers in the first decades of the 19th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Santería"@en .

aat:300400853 a skos:Concept ;
    skos:definition "Complex of beliefs concerning the gods and the nature of the cosmos developed by the Germanic-speaking peoples before their conversion to Christianity. Germanic culture extended, at various times, from the Black Sea to Greenland, or even the North American continent. Germanic religion played an important role in shaping the civilization of Europe."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Germanic religion"@en .

aat:300400854 a skos:Concept ;
    skos:definition "Beliefs of the confederacy of tribes that spoke Aramaic (a North Semitic language) between the 11th and 8th century BCE). Aramean mythology was significantly different from neighbors such as the Mesopotamians, the Canaanites, Israelites, or other tribes in the area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aramean religion"@en .

aat:300400855 a skos:Concept ;
    skos:definition "Pre-Christian and pre-Islamic religious beliefs and practices of the Finno-Ugric peoples, who inhabit regions of northern Scandinavia, Siberia, the Baltic area, and central Europe. In modern times the religion of many of these peoples has been an admixture of agrarian and nomadic primitive beliefs and of Christianity and Islam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Finno-Ugric religion"@en .

aat:300400856 a skos:Concept ;
    skos:definition "Religious beliefs and sacramental practices of the indigenous peoples of the United States and Canada, excluding the Eskimos and Aleuts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Native North American religions"@en .

aat:300400857 a skos:Concept ;
    skos:definition "Religious and philosophical system of the Druids, who were members of the learned priestly class among the ancient Celts. Frequented oak forests and acted as priests, teachers, and judges."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Druidism"@en .

aat:300400858 a skos:Concept ;
    skos:definition "As an artistic concept, strokes or marks, long in proportion to breadth, traced upon a surface or implied through imaginary joining of points in a composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lines"@en .

aat:300400859 a skos:Concept ;
    skos:definition "As an artistic compositional concept, the characteristic of a composition that causes the eye to pass from place to place, or from one form or area to another, through the composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movement"@en .

aat:300400860 a skos:Concept ;
    skos:definition "As an artistic concept, the characteristic within a composition that causes one area or quality to stand out among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "emphasis"@en .

aat:300400861 a skos:Concept ;
    skos:definition "As an artistic concept, the characteristic within a composition where a form, line, color, or other compositional element is repeated to cause unity or for another purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repetition"@en .

aat:300400862 a skos:Concept ;
    skos:definition "As an artistic concept, the characteristic of differences between surfaces in a work, or of the appearances of surfaces in two-dimensional works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "texture"@en .

aat:300400863 a skos:Concept ;
    skos:definition "A rare, chemically complex carbonate-bearing silicate. Occasionally used in pigments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerinite"@en .

aat:300400864 a skos:Concept ;
    skos:definition "Inert pigment made primarily of the white crystalline salt, magnesium carbonate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "magnesium carbonate"@en .

aat:300400865 a skos:Concept ;
    skos:definition "Synthetic form of dihydroxyanthraquinone (alizarin) made from anthracene, a coal tar product, in 1868 by Carl Graebe and Carl Lieberman. Prior to that time, alizarin was obtained from the root of the madder plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic alizarin"@en .

aat:300400866 a skos:Concept ;
    skos:definition "Purpurin has been manufactured synthetically by the oxidation of alizarin since the 1920s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "synthetic purpurin"@en .

aat:300400867 a skos:Concept ;
    skos:definition "Genus containing of over 750 species of flowering plants, primarily shrubs, native to tropical and subtropical regions of the world."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Indigofera"@en .

aat:300400868 a skos:Concept ;
    skos:definition "Species of evergreen flowering plant. Formerly cultivated for a red dye, alizarin, that was obtained from the ground-up roots of these plants. Also used for medicinal purposes and as food plant for the larvae of the Hummingbird hawk moth and other species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rubia cordifolia"@en .

aat:300400869 a skos:Concept ;
    skos:definition "Genus of flowering plants native to Europe, North Africa, and parts of Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carthamus"@en .

aat:300400870 a skos:Concept ;
    skos:definition "Species of herbaceous, thistle-like annual plant; commercially cultivated for vegetable oil extracted from the seeds and for red colorant produced from its petals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Carthamus tinctorius"@en .

aat:300400871 a skos:Concept ;
    skos:definition "Genus containing around 30 species of flowering plants native to the Mediterranean region and Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Isatis"@en .

aat:300400872 a skos:Concept ;
    skos:definition "Genus containing around 40 species, primarily herbs, covered with bristly hairs, cultivated in Europe, North Africa, South Africa, Western Asia, and North America."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anchusa"@en .

aat:300400873 a skos:Concept ;
    skos:definition "Species of narrow-leaved plant that grows 60 cm (2 feet) tall and bears purple flowers in coiled sprays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Anchusa officinalis"@en .

aat:300400875 a skos:Concept ;
    skos:definition "Genus containing 400-600 species of annual and perennial herbaceous plants in the temperate zones of both the Northern and Southern Hemispheres."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Galium"@en .

aat:300400876 a skos:Concept ;
    skos:definition "Small berries from various shrubs of the Rhamnus(genus), the buckthorns. The berries of some species are used to yield sap-green and other pigments; the berries of certain species are used as a powerful cathartic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buckthorn berries"@en .

aat:300400877 a skos:Concept ;
    skos:definition "Species of low spiny shrub; the fruit and bark are used to extract dye and for medicinal purposes. On an aluminum mordant, the berries produce a yellow-green colorant. See also the narrower term \"Rhamnus saxatilis ssp infectorius.\" In some classifications, R.infectorius is considered a synonym of R.saxatilis rather than a subspecies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhamnus saxatilis"@en .

aat:300400878 a skos:Concept ;
    skos:definition "Subspecies of buckthorn plant found in Mediterranean European countries. The berries historically have been used as medicine and to produce a yellow-green dye; in export it was often named for a French origin. In some classifications, R.infectoria is considered a synonym of R.saxatilis rather than a subspecies; in other classifications, it has been considered a separate species."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhamnus saxatilis ssp infectorius"@en .

aat:300400879 a skos:Concept ;
    skos:definition "Nonspecific term used for several species of the Rhamnus genus found in Iran and cultivated in several Mediterranean countries, from which the dried immature fruit, and sometimes the bark, was used historically to produce a yellow or yellow-green dye."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Persian berry"@en .

aat:300400880 a skos:Concept ;
    skos:definition "Species of buckthorn shrub indigenous to China; its bark was used to extract a green dye used on wool and silk. It is grown in Europe as an ornamental plant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rhamnus utilis"@en .

aat:300400881 a skos:Concept ;
    skos:definition "Yellow dye produced from the bark of the Chinese buckthorn, historically exported to Europe and elsewhere in small square cakes or crystals. It was also used in medicine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "China green"@en .

aat:300400882 a skos:Concept ;
    skos:definition "The principal yellow colorant contained in extracts from the leaves and twigs of the gambier, cutch and kino resin. Noted as lightfast and washfast; used on wool, silk and cotton to obtain a dark brown color and in tanning leather."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catechin"@en .

aat:300400883 a skos:Concept ;
    skos:definition "Pigment made from the mineral cinnabar, composed of mercuric sulfide. Cinnabar was finely ground for use as an artist pigment since antiquity. Red mercuric sulfide has been made synthetically since at least the 8th century in Europe and possibly earlier in China. Synthetic mercuric sulfide is called vermilion, favored over ground cinnabar as a red pigment because cinnabar, when exposed to ultraviolet light, darkens from its normal red crystalline form to a black isomorph, resulting in splotchy discolorations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cinnabar"@en .

aat:300400884 a skos:Concept ;
    skos:definition "Pigment made from goethite mineral; goethite has been ground and used as a pigment from the earliest times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goethite"@en .

aat:300400885 a skos:Concept ;
    skos:definition "The action of washing or wiping with a sponge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sponging"@en .

aat:300400886 a skos:Concept ;
    skos:definition "Ribbons, strings, or narrow bands of any material used for binding the hair, or worn round the head to keep the headdress in position, or simply for ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fillets"@en .

aat:300400887 a skos:Concept ;
    skos:definition "Sculptures of very large size, usually but not always sculpture in the round, often but not always outdoors. For large sculptures of figures of extraordinary size, use \"colossi.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "monumental sculpture"@en .

aat:300400888 a skos:Concept ;
    skos:definition "Secret society and culture of the Egba group of Yoruba people."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ogboni"@en .

aat:300400889 a skos:Concept ;
    skos:definition "System of beliefs of the Mayans, a Mesoamerican people who flourished between 300 and 900 CE in southern Mexico and Central America; knowledge of the beliefs comes from hieroglyphic writing carved into stone monuments and from codices from the colonial Spanish."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mayan religion"@en .

aat:300400890 a skos:Concept ;
    skos:definition "Any of a class of binary chemical compounds in which oxygen combines with another element or with an organic radical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oxides"@en .

aat:300400892 a skos:Concept ;
    skos:definition "Scale represented by a line or bar subdivided into units."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bar scale"@en .

aat:300400893 a skos:Concept ;
    skos:definition "Scale represented by numbers and text, for example \"3/4 scale,\" \"4 feet to 1 inch,\" \"1:50.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "numeric scale"@en .

aat:300400894 a skos:Concept ;
    skos:definition "Scale converting the units of a bar scale or numeric scale into another set of units, for example \"30 palmi = 114 mm.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "converted scale"@en .

aat:300400895 a skos:Concept ;
    skos:definition "Scale deduced from dimensions indicated on the item, such as dimensions of a door; or a scale otherwise inferred from images on the item, such as the size of a human being indicated on the item."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reconstructed scale"@en .

aat:300400896 a skos:Concept ;
    skos:definition "Scale when one image is drawn to two scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dimetric scale"@en .

aat:300400897 a skos:Concept ;
    skos:definition "Scale when one image is drawn to three scales."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trimetric scale"@en .

aat:300400898 a skos:Concept ;
    skos:definition "Two or more sculptures that are designed to be displayed together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sculpture groups"@en .

aat:300400899 a skos:Concept ;
    skos:definition "Genus of deciduous trees in the Elm family native to southern Europe, southwest and eastern Asia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zelkova"@en .

aat:300400900 a skos:Concept ;
    skos:definition "Ornamental deciduous tree species native to Japan, Korea, China, and Taiwan. In Japan its durability and easy working properties have led to its popularity as a building timber and as a wood for carved objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zelkova serrata"@en .

aat:300400901 a skos:Concept ;
    skos:definition "Painting material in the form of solid, molded sticks, containing pigment, oil (usually linseed oil) for binding, as well as wax."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil sticks"@en .

aat:300400902 a skos:Concept ;
    skos:definition "Process of furnishing, sustaining, or strengthening with a buttress or support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buttressing"@en .

aat:300400903 a skos:Concept ;
    skos:definition "People who commission, order, or request and pay for activities or products, such as art works. For those who finance architecture and other large projects, use patrons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissioners"@en .

aat:300400904 a skos:Concept ;
    skos:definition "Orders, charges, projects, or activities requested and usually financed by one party and ordered or entrusted to an artist or other party to perform or execute, for example a commission may be made for a particular art work. For the process of assigning or granting a commission, use \"commissioning (function).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commissions"@en .

aat:300400905 a skos:Concept ;
    skos:definition "The political phenomenon that occured from ca. 1500, whereby European nations conquered and exploited the peoples in other parts of the world. Often used generally, and in a derogatory manner, referring to a policy of control by one country over another group or area."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "colonialism"@en .

aat:300400906 a skos:Concept ;
    skos:definition "Cultural condition of the coexistence of numerous distinct ethnic and cultural groups within one society. For the cultural movement, use \"multiculturalism.\" For the broader philosophical concept, use \"pluralism.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cultural pluralism"@en .

aat:300400907 a skos:Concept ;
    skos:definition "The Creole-speaking culture and people of Sierra Leone."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Krio"@en .

aat:300400908 a skos:Concept ;
    skos:definition "Visual works, usually paintings or sculptures, that depict the Virgin Mary holding the dead body of Christ, generally on her lap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pietàs"@en .

aat:300400909 a skos:Concept ;
    skos:definition "An unstable copper trihydroxychloride isomer with a green or blue-green hue. Found in Cornwall, England, Austria, Germany, Greece, and the southwest United States. Sometimes used as a green pigment in painting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botallackite"@en .

aat:300400910 a skos:Concept ;
    skos:definition "An unstable copper trihydroxychloride isomer with a green or blue-green hue. Found in Cornwall, England, Austria, Germany, Greece, and the southwest United States."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "botallackite"@en .

aat:300403901 a skos:Concept ;
    skos:definition "Beds of any form, where a person is laid while dying."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deathbeds"@en .

aat:300403902 a skos:Concept ;
    skos:definition "Beds designed with a very high canopy suspended from an ornate horizontal frame, attached to the wall behind the head or to the ceiling, and often supported by columns or posts at the foot of the bed. For beds of similar design, but of lesser height and bulk, without the supporting posts at the foot, use \"lits à la duchesse.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lits à l'impériale"@en .

aat:300403904 a skos:Concept ;
    skos:definition "Papal crowns, now in the form of ornate beehive-shaped headgear, ornamented with precious stones and pearls. It is formed of three diadems, thus also called the \"triregnum.\" The tiara is a non-liturgical ornament indicating rank, therefore it is only worn for non-liturgical ceremonies, such as the coronation of a pope, and in processions. Often seen in the coat of arms of a pope, with the crossed keys of St. Peter. Older forms were less elaborate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "papal tiaras"@en .

aat:300403905 a skos:Concept ;
    skos:definition "Yarn or fabric made from the fine, soft, light wool from the undercoat of the Kashmir goat."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cashmere"@en .

aat:300403906 a skos:Concept ;
    skos:definition "General name for several breeds of various species of goat that produce fine, soft coat used for cashmere wool."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kashmir goats"@en .

aat:300403907 a skos:Concept ;
    skos:definition "Tables of various designs used for displaying and serving food in a dining room. In modern usage, for case furniture used for serving food and displaying dishes, use \"sideboards (furniture).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "serving tables"@en .

aat:300403908 a skos:Concept ;
    skos:definition "Clothing intended to be worn at home, designed to be comfortable, but often fashionable and sometimes worn in front of guests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "loungewear"@en .

aat:300403909 a skos:Concept ;
    skos:definition "Articles of clothing suitable for formal wear during the evening, often as opposed to the more casual styles of day wear. For garments worn to bed, use \"nightwear.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "evening wear"@en .

aat:300403910 a skos:Concept ;
    skos:definition "Articles of clothing suitable for casual wear during the day, in contrast to formal wear suitable for evening events."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "day wear"@en .

aat:300403911 a skos:Concept ;
    skos:definition "Clothing and coverups used while making one's toilet and dressing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dressing garments"@en .

aat:300403912 a skos:Concept ;
    skos:definition "Variety of twill-woven cloth, usually of fine worsted yarn or thread."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gabardine"@en .

aat:300403913 a skos:Concept ;
    skos:definition "Small pockets made in the waistband of breeches, cummerbund, and other clothing, usually men's clothing or clothing made to imitate menswear, used for carrying a watch, money, or other valuables."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fobs"@en .

aat:300403914 a skos:Concept ;
    skos:definition "Small decorative fobs or functional objects attached to a chain or strap that is attached to a watch placed in a pocket. For the chains attached to the fob, use \"fob chains.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "watch fobs"@en .

aat:300403915 a skos:Concept ;
    skos:definition "Tabs or decorative objects attached to a chain or ring supporting one or more keys. In modern usage, it can refer to such tabs incorporating a small electronic device for locking and unlocking a vehicle or performing other tasks remotely."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "key fobs"@en .

aat:300403916 a skos:Concept ;
    skos:definition "Chains, often decorative, attached to a watch or other item which is carried in the fob pocket. They may also be attached to a decorative ornamental object, the fob."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fob chains"@en .

aat:300403917 a skos:Concept ;
    skos:definition "Boards used for recreational snow sports, first developed in the 1960s. These are long narrow boards, most often with upturned ends, and fitted with transverse bindings for boots, on which the rider coasts down slopes of snow in a modified form of snow skiing, but with performance elements that evolved from skateboarding and surfing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snowboards"@en .

aat:300403918 a skos:Concept ;
    skos:definition "Snow sport that is a modified form of snow skiing, but with performance elements that evolved from skateboarding and surfing, first developed in the 1960s. Snowboarders use long narrow boards, most often with upturned ends that are fitted with transverse bindings for boots."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "snowboarding"@en .

aat:300403919 a skos:Concept ;
    skos:definition "Intaglio printing technique that uses a piece of oilcloth rather than a printing plate; the cloth is engraved with a design and inserted into a washing machine wringer or other device to print. Its best known use was by Feliks Jabłczyński (1865-1928); he used a knife and needle for scratching, engraving, and uncovering the underlying canvas; thin oil paint was used as the printing medium. The prints appear similar to drypoint and etching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceratoryt"@en .

aat:300403923 a skos:Concept ;
    skos:definition "National Polish style of art and design, inspired by vernacular folk art forms, techniques, and motifs; based on work of Stanisław Witkiewicz and the Zakopane region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zakopane Style"@en .

aat:300403925 a skos:Concept ;
    skos:definition "A Hungarian variation of Art Nouveau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Szecesszió"@en .

aat:300403927 a skos:Concept ;
    skos:definition "Variation of Art Nouveau in Switzerland, relating to the aesthetic production of the pupils of Charles L’Eplattenier in La-Chaux-de-Fonds ca. 1900/1910. The ornamental expression was based on regional flora of the canton Jura, deriving from pine-tree, Carline thistle, and Alpine gentian."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Style Sapin"@en .

aat:300403928 a skos:Concept ;
    skos:definition "Variation of Art Nouveau found in Slovenia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Secesija"@en .

aat:300403929 a skos:Concept ;
    skos:definition "Variation of Art Nouveau found in Croatia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Secesija"@en .

aat:300403931 a skos:Concept ;
    skos:definition "Styles having elements that anticipated and had a profound influence on Expressionist art, literature, and dramatic arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Expressionist"@en .

aat:300403932 a skos:Concept ;
    skos:definition "English aesthetic style from 1870s/1880s, developing as an off shoot of the Arts and Crafts Movement. It displayed an emphasis on linear and floral decoration, anticipating the continental Art Nouveau movement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Proto-Art Nouveau"@en .

aat:300403933 a skos:Concept ;
    skos:definition "A Polish variation of Art Nouveau."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Modernizm"@en .

aat:300403934 a skos:Concept ;
    skos:definition "Swedish variation of Art Nouveau that emphasized stricter and more geometric designs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kontrajugend"@en .

aat:300403935 a skos:Concept ;
    skos:definition "Finnish variations of Jugend and Art Nouveau, including elements of Finnish nature and national culture, such as folk poetry, folk life, mediaval Finnish ecclesiastical architecture, Carelian folk, architecture, among others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jugend"@en .

aat:300403936 a skos:Concept ;
    skos:definition "Swedish variation of Jugend and Art Nouveau, more restrained than eleswhere in Europe. Characterized by a more naturalistic ornamentation, inspired by the Swedish flora and fauna; in later years, exhibited more geometric design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jugend"@en .

aat:300403937 a skos:Concept ;
    skos:definition "Folk art style of the Hutsul people or styles influenced by the folk art of the Hutsul people, including Art Nouveau styles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hutsul Style"@en .

aat:300403938 a skos:Concept ;
    skos:definition "Culture and ethnicity of the Hutsul people of the Carpathian mountains, primarily in the Ukraine and Romania."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hutsul"@en .

aat:300403940 a skos:Concept ;
    skos:definition "Norwegian national style inspired by 11th-century Norse ornamentation and stave churches in Norway. Mostly used in architecture, furniture design, and silverware. Often used in combination with Jugendstil elements."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Dragestil"@en .

aat:300403941 a skos:Concept ;
    skos:definition "Term for variations of Art Nouveau in the Netherlands; characterized by ornament instead of construction, and function or material as the basis for design. Characteristics are stylized or abstracted motifs from nature and a two-dimensional treatment of surface. The style flourished in The Hague and Delft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Decorative Style"@en .

aat:300403942 a skos:Concept ;
    skos:definition "Dutch style characterized by construction as the basis for the form of an object, with ornament also playing an important role. It is characterized by the use of rare and expensive materials, the mixing of many stylistic elements, and much ornament. This style flourished in Amsterdam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Constructive-Decorative Style"@en .

aat:300403943 a skos:Concept ;
    skos:definition "Dutch variations of Art Nouveau that stress form based on function, construction and material. Characteristics are a division of constructive and functional elements, respect for the material used, and restricted use of ornament that accentuates form. This style flourished in Amsterdam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Constructive Style"@en .

aat:300403944 a skos:Concept ;
    skos:definition "Mural painting technique in which pigments are ground in water and mixed with lime upon freshly laid plaster. As the pigmented lime dries, the calcium hydroxide reacts with carbon dioxide to form a pigmented calcium carbonate layer. Such paintings have survived from the Minoan period (1700 BCE) and Pompeii (79 CE). The technique was widely used from the 13th century in Italy for interior wall decorations, particularly in churches. Noted from ancient times as the preferred method of mural painting, superior to techniques that apply pigment to dry plaster, fresco secco, or partially dry plaster, mezzo fresco."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buon fresco"@en .

aat:300403945 a skos:Concept ;
    skos:definition "The culture and period dating from the beginning of the Stone Age, preceding the Paleolithic and characterized by the earliest crude stone tools."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Eolithic"@en .

aat:300403946 a skos:Concept ;
    skos:definition "Chapels or other room-like spaces, or small freestanding structures, adjacent to or near the tomb in a funerary site. Examples date from ancient Egypt, where offering niches developed over time into rooms, where families of the dead could visit on appropriate days of the year, to eat meals or make offerings in accordance with Egyptian funerary cults. For chapels that hold the remains of the dead, use \"sepulchral chapels.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tomb chapels"@en .

aat:300403947 a skos:Concept ;
    skos:definition "Small cards containing the name and contact information for a person, similar in design to a business card, but used by an individual unaffiliated with a particular commercial concern. For personal cards used when formally visiting a home, particularly among the upper classes in historical usage, prefer \"visiting cards.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "social cards"@en .

aat:300403948 a skos:Concept ;
    skos:definition "Controlled vocabularies in the form of a thesaurus, that are limited in the range of topics covered, but fit within the domain of a larger, broader, or more generic controlled vocabulary. A microthesaurus typically contains highly specialized terms that map to the hierarchical structure of the broader vocabulary at a high level node."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microthesauri"@en .

aat:300403949 a skos:Concept ;
    skos:definition "Objects based on an interior cylinder, usually with flanges attached, around which flexible materials may be wound for storage or supply uptake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reels"@en .

aat:300403950 a skos:Concept ;
    skos:definition "People who specialize in making mirrors, which are objects with a highly polished surface designed to reflect images; often intended for those who make mirrors of glass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mirror makers"@en .

aat:300403951 a skos:Concept ;
    skos:definition "The attribute or quality of an object reflecting light to a significant degree, and either giving back an image or reflection, for example as in mirrors, or more diffusely, for example as in desert sand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reflectivity"@en .

aat:300403952 a skos:Concept ;
    skos:definition "Artists, usually printmakers or painters, who specialize in Ukioyo-e, a genre that developed in the Edo period, Japan, and is characterized by a mixture of the realistic narrative of brothels, kabuki theaters, and other such places, with a distinctive decorative style."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ukiyo-e artists"@en .

aat:300403953 a skos:Concept ;
    skos:definition "One of the largest family of marine bivalve mollusks comprised of over 200 species. The two valves of the shell are symmetrical, and range in colour from brown to red or yellow. The outer shell surface of many species can be smooth; others have ridges that radiate from the hinge area between the shells."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cardiidae"@en .

aat:300403954 a skos:Concept ;
    skos:definition "Houses with the amenities of domestic dwellings that are of very small size, often on less than a 12 x 24 foot footprint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tiny houses"@en .

aat:300403955 a skos:Concept ;
    skos:definition "Apartments that offer all the amenities of a normal domestic apartment but in radically reduced size. These have open space for sleeping, working, cooking, and eating. These are typically part of housing projects that are six stories high with 40 units each."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "micro-units"@en .

aat:300403956 a skos:Concept ;
    skos:definition "General designation for tracts of land set aside for a specific use."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reserves"@en .

aat:300403957 a skos:Concept ;
    skos:definition "Areas set aside for the propagation of game for hunters, specifically for shooting."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "shooting preserves"@en .

aat:300403958 a skos:Concept ;
    skos:definition "Areas set aside for the propagation of game, especially in historical usage. For modern areas set aside for shooting with guns, use \"shooting preserves.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "game reserves"@en .

aat:300403959 a skos:Concept ;
    skos:definition "States that are governed by tribal authority, often physically located within a larger sovereign state."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tribal nations"@en .

aat:300403960 a skos:Concept ;
    skos:definition "In anthropology, geography, and other social sciences, contiguous geographic areas within which most societies share many traits in common."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "culture areas"@en .

aat:300403961 a skos:Concept ;
    skos:definition "Thermoplastic polymer that, in its liquid form, consists of monomers of cyanoacrylate molecules. In the form of an acrylic resin it rapidly polymerises in the presence of water; commonly used as a fast-setting, strong adhesive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyanoacrylate"@en .

aat:300403962 a skos:Concept ;
    skos:definition "Fast-setting, strong adhesive based on ethyl-2-cyanoacrylate polymers. Most commercial formulations also contain stabilizers, thickeners, and catalysts.The first cyanoacrylate adhesive was made in 1941, but not marketed until 1958. The glues set rapidly upon exposure to ultraviolet radiation or moisture. When cured, they form an extremely strong bond that is fairly insoluble. Cyanoacrylate adhesives have been used for gluing glass, ceramics, other hard materials, and in medical and dental applications. Some cyanoacrylate glues may lose adhesive strength with time; ultraviolet light and contact with alkaline materials (glass and some stones) will accelerate the degradation process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cyanoacrylate adhesive"@en .

aat:300403963 a skos:Concept ;
    skos:definition "A very strong, usually quick-setting, adhesive; often based on cyanoacrylates or similar polymers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "superglue"@en .

aat:300403964 a skos:Concept ;
    skos:definition "Brand name for a fast-setting adhesive based on ethyl-2-cyanoacrylate polymers, with stabilizers, thickeners, and catalysts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Super Glue (TM)"@en .

aat:300403965 a skos:Concept ;
    skos:definition "Lightweight, laminated panels, typically made with a polystyrene layer between two coated papers. Acid-free foam boards are used for matting and mounting works of art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "foamboard"@en .

aat:300403966 a skos:Concept ;
    skos:definition "Ceremonial vessels used for holding fresh water during tea ceremonies. The water was used for washing the tea bowls and filling the kettle. Mizusashi are typically made of ceramic or lacquerware, but wooden and glass ones are also used."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mizusashi"@en .

aat:300403967 a skos:Concept ;
    skos:definition "Platforms or booths set up in a town square or other public location, often on market day, to accommodate traveling players or street performers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "street theaters"@en .

aat:300403968 a skos:Concept ;
    skos:definition "To make, arrange, compose, or construct a written work, art work, or other work, by arrangement of materials collected from various sources. It may refer to the arrangement of content only (as in a literary work), or of physical pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compiling"@en .

aat:300403969 a skos:Concept ;
    skos:definition "Arrangements, compositions, or constructions comprising a written work, art work, or other work, by arrangement of materials collected from various sources. It may refer to the arrangement of content only (as in a literary work), or of physical pieces."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compilations"@en .

aat:300403970 a skos:Concept ;
    skos:definition "Manuscript volumes comprising two or more works, whether referring to only the content combined or to the combination of physically separate leafs or gatherings that are sewn or tipped in to form one volume."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "compilation manuscripts"@en .

aat:300403971 a skos:Concept ;
    skos:definition "Camera-ready proofs printed with precision on smooth-surfaced paper stock in order to be photographed for reproduction by offset printing or for engravings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproduction proofs"@en .

aat:300403972 a skos:Concept ;
    skos:definition "Sections cut out of other works or documents; in art, primary examples are illuminations or other sections from a manuscript. For cuttings of newspapers and journals, use \"clippings (information artifacts).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuttings"@en .

aat:300403973 a skos:Concept ;
    skos:definition "Photographs made for the purpose of study and research, often as visual surrogates for the object depicted."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "study photographs"@en .

aat:300403974 a skos:Concept ;
    skos:definition "People or groups of people who make contributions to a whole, for example, items to a collection, records to a database, literary articles to a joint literary work, or money to a larger fund. For those who finance or sponsor, not necessarily as a partial contribution to a larger whole, use \"donors.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contributors"@en .

aat:300403975 a skos:Concept ;
    skos:definition "A thing, writing, moneys, or other contribution added to to a common fund, stock, collection, database, or literary work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contribution"@en .

aat:300403976 a skos:Concept ;
    skos:definition "Portraits of a person on horseback, where the person is the focus of the portrait. For portraits intended primarily to depict a known individual animal, usually named, prefer \"animal portraits.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "equestrian portraits"@en .

aat:300403977 a skos:Concept ;
    skos:definition "Institutions, groups, or other corporate bodies who oversee the finances, management, and maintenance of a park, which is a reserved recreation area, usually with open space or natural features; generally reserved for those managing a large public or private park. For groups with broader authority to oversee and fund multiple parks for an area, prefer \"parks commissions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parks"@en .

aat:300403978 a skos:Concept ;
    skos:definition "Professionals that research, select, adapt, or develop texts, scripts, plays, operas, or films for a theater or other production company. Responsibilities of this position may include liason with authors, preparation of printed matter, or public relations. The role of dramaturge was originally identified in a series of essays by Gotthold Ephraim Lessing, published 1767-1769."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dramaturges"@en .

aat:300403979 a skos:Concept ;
    skos:definition "Describes the discipline of theatrical or dramatic composition, representation, and research. English dramaturgy is derived from German Dramaturgie, a concept developed by the German dramatist and critic Gotthold Lessing in a series of essays entitled 'Hamburgische Dramaturgie,' published 1767 to 1769. The discipline includes researching, selection, adaptation, or development of texts, scripts, plays, operas, or films for a theater or other production company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dramaturgy"@en .

aat:300403980 a skos:Concept ;
    skos:definition "Roman Catholic order of mendicant friars, religious men who lead a monastic life, including the choral recitation of the liturgical office, but do active work. It was founded in 1233 by a group of seven cloth merchants of Florence, known as the Seven Holy Founders; they left their families and occupations to withdraw outside the gates of Florence and live a life of poverty, penance, and fellowship. The order was recognized in 1256 by Pope Alexander IV. Nuns are also included with in the Servite family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Servite"@en .

aat:300403982 a skos:Concept ;
    skos:definition "Fields where wet rice is grown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rice paddies"@en .

aat:300403983 a skos:Concept ;
    skos:definition "Areas of a city in which courtesans are available, separate from the rest of the city, sometimes walled. Primary examples are the pleasure quarters of the Ming dynasty in China and of the Edo era of Japan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pleasure quarters"@en .

aat:300403984 a skos:Concept ;
    skos:definition "Members of a class of military retainers of the daimios in feudal Japan, or any members of the Japanese military caste."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "samurai"@en .

aat:300403985 a skos:Concept ;
    skos:definition "People who climb mountains or other steep terrain, usually for adventure or sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain climbers"@en .

aat:300403986 a skos:Concept ;
    skos:definition "Activity involving ascending mountains or other steep terrain, usually for adventure or sport."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountain climbing"@en .

aat:300403987 a skos:Concept ;
    skos:definition "Activity involving the movement of people, animals, or equipment from one bank of a river to the opposite bank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river crossing"@en .

aat:300403988 a skos:Concept ;
    skos:definition "Places along a river adapted for or used for the movement of people, animals, or equipment from one bank of a river to the opposite bank."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "river crossings"@en .

aat:300403989 a skos:Concept ;
    skos:definition "The corpus of borrowed and adapted Chinese ideographs which forms the principal part of the Japanese writing system. The Japanese affixes for verb tenses, prepositions, and other grammatical markers, which do not exist in Chinese, are indicated by hiragana symbols written beside the kanji. The pronunciation of kanji symbols may be indicated as well by hiragana signs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kanji"@en .

aat:300403990 a skos:Concept ;
    skos:definition "The two parallel modern Japanese syllabaries (katakana and hiragana), each of which independently represents all the sounds of the Japanese language. Although each derives its simple elements from Chinese characters, the two serve different purposes and differ stylistically."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Kana"@en .

aat:300403992 a skos:Concept ;
    skos:definition "In Japanese printing, a large sheet of paper that is half of ō-ōban, around 53 x 39 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ō-ōban"@en .

aat:300403993 a skos:Concept ;
    skos:definition "In Japanese printing, a sheet of paper that is half of ō-ōban, around 39 x 26.5 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ōban"@en .

aat:300403994 a skos:Concept ;
    skos:definition "In Japanese printing, a sheet of paper that is in portrait format (height is greater than width)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tate-e"@en .

aat:300403995 a skos:Concept ;
    skos:definition "In Japanese printing, a sheet of paper that is in landscape format (height is smaller than width)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yoko-e"@en .

aat:300403996 a skos:Concept ;
    skos:definition "In Japanese printing, format comprising strips of paper derived from a large sheet, ō-ōban, around 33 x 15 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hosoban"@en .

aat:300403997 a skos:Concept ;
    skos:definition "In Japanese printing, format derived from a large sheet, ō-ōban, around 26.5 x 19 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chūban"@en .

aat:300403998 a skos:Concept ;
    skos:definition "In Japanese printing, format derived from a large sheet, ō-ōban, around 39 x 17.5 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ōtanzaku"@en .

aat:300403999 a skos:Concept ;
    skos:definition "In Japanese printing, format derived from a large sheet, ō-ōban, around 39 x 12 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chūtanzaku"@en .

aat:300404000 a skos:Concept ;
    skos:definition "In Japanese printing, format having dimensions ca. 33 x 22.7 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aiban"@en .

aat:300404001 a skos:Concept ;
    skos:definition "In Japanese printing, format having dimensions ca. 69/75 x 12/13 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hashira-e"@en .

aat:300404002 a skos:Concept ;
    skos:definition "In Japanese printing, format having dimensions ca. 58.4 x 30.4 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kakemono-e"@en .

aat:300404003 a skos:Concept ;
    skos:definition "In Japanese printing, format having dimensions ca. 52 x 18 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chō-ōban"@en .

aat:300404004 a skos:Concept ;
    skos:definition "In Japanese printing, format having dimensions ca. 23 x 16.5 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koban"@en .

aat:300404006 a skos:Concept ;
    skos:definition "Type of technical pen, having a trademarked brand name of a German company."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rapidograph (TM)"@en .

aat:300404007 a skos:Concept ;
    skos:definition "A technique that is a hybrid of drawing and printmaking. The oil transfer drawing technique is achieved by covering a surface, often a sheet of paper, with oil paint or printing ink, laying a clean sheet of paper over it, and drawing on top with a mark-making tool; the pressure of the tool causes the ink or paint from below to transfer to the back of the top sheet. The technique was used by both Paul Gauguin and Paul Klee, but predates them both."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil transfer drawing"@en .

aat:300404008 a skos:Concept ;
    skos:definition "Drawings that are a hybrid of drawing and printmaking. Oil transfer drawings are achieved by covering a surface, often a sheet of paper, with oil paint or printing ink, laying a clean sheet of paper over it, and drawing on top with a mark-making tool; the pressure of the tool causes the ink or paint from below to transfer to the back of the top sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil transfer drawings"@en .

aat:300404009 a skos:Concept ;
    skos:definition "Complexes built for the purpose of docking ferries, for the embarking or disembarking of passengers, or cargo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ferry terminals"@en .

aat:300404010 a skos:Concept ;
    skos:definition "Villages whose economies are based on agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "farm villages"@en .

aat:300404011 a skos:Concept ;
    skos:definition "Indonesian, asymmetrical daggers with a wavy blade, often made from precious materials such as gold, ivory of rare types of wood. The kris is often associated with power, dignity and mystical powers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "krises"@en .

aat:300404012 a skos:Concept ;
    skos:definition "Numbers or alphanumeric codes that are not repeated within a given environment and used to unambiguously and uniquely identify an object, record, or data element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unique identifiers"@en .

aat:300404013 a skos:Concept ;
    skos:definition "Alphanumeric codes that are traditionally used to uniquely identify a given manuscript within a defined environment. Manuscript designations may be used as titles of manuscripts. An example would be \"Ms. Ludwig II 7.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manuscript designations"@en .

aat:300404014 a skos:Concept ;
    skos:definition "Paper having having a smooth, glossy, glasslike finish. The gloss is obtained by treating the paper with a substance, including starch, glue, wax, or synthetic resins, followed by heat-pressing between rollers. Examples of glazed papers are as used for book covers, pages of books, advertisements, decorative wrapping paper, and bags."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazed paper"@en .

aat:300404015 a skos:Concept ;
    skos:definition "Brief profiles of person's life or work, expressed as a series of actions and occurrences constituting the history of an individual."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitas"@en .

aat:300404016 a skos:Concept ;
    skos:definition "Biographies focusing on a few defining events in the life of the subject, conveying the essence and main milestones of a life."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biographical sketches"@en .

aat:300404017 a skos:Concept ;
    skos:definition "In Christian tradition, prayers or offices appointed to be said at the seven stated canonical hours or times of the day allotted to prayer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hours"@en .

aat:300404018 a skos:Concept ;
    skos:definition "Orally delivered solemn invocations of blessedness pronounced by an ecclesiastical functionary."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "benedictions"@en .

aat:300404019 a skos:Concept ;
    skos:definition "Vessels used during libation rituals: the pouring of a liquid as an offering to a god. These vessels often have a significant shape which set them apart from secular vessels, though libation vessels appear in varied forms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "libation vessels"@en .

aat:300404021 a skos:Concept ;
    skos:definition "Extracts from a larger or previously printed source."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "readings"@en .

aat:300404022 a skos:Concept ;
    skos:definition "Archival groups are aggregates of items that share a common provenance. Archival groups may range in size from several thousand items (e.g., the entire body of drawings, models, and written documents from an architect's office) to just a few items (e.g., a handful of surviving drawings from one architectural project). Group-level cataloging focuses on the description of coherent, collective bodies of works. The description emphasizes the characteristics of the group as a whole, and highlights the unique and distinctive characteristics of the most important works in the group. Groups are usually defined by repositories, and may have several subgroups that are established by archival principles of provenance. The catalog record for a group normally corresponds to a physical group as it currently exists and is stored by the repository; however, historical groups may also be described. Groups may be divided into subgroups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groups"@en .

aat:300404023 a skos:Concept ;
    skos:definition "In archival description, subordinate groups or subdivisions of a group; archival groups that are parts of larger groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subgroups"@en .

aat:300404024 a skos:Concept ;
    skos:definition "Individual objects or works. Most works in museums are cataloged as items. A stand-alone architectural work should generally be cataloged as an item. An item may be composed of multiple parts or components, and it may be desirable to catalog the parts separately, linking the records for the components to the record for the whole. An item differs from a component in that the component cannot stand alone as an independent work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "items"@en .

aat:300404025 a skos:Concept ;
    skos:definition "Gunda Gundé style takes its name from the location of the Stephanite monastery of Dabra Garzen, noted for its manuscript illuminations. It is characterized large, exaggeratedly rounded backs of the figures, almond-shaped eyes, dotted motif employed in their clothing, extreme stylization of the figures, and geometric regularity."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gunda Gundé"@en .

aat:300404026 a skos:Concept ;
    skos:definition "Compilations of separate articles, treatises, studies, or literary compositions of various kinds brought together into one volume. For compilations of brief extracts of works that are considered the best examples of an author, subject matter, or literary form, use \"anthologies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miscellanies"@en .

aat:300404028 a skos:Concept ;
    skos:definition "Works of art, architecture, or other objects that have been taken apart or fragmented, either through damage or intentionally."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disassembled works"@en .

aat:300404029 a skos:Concept ;
    skos:definition "Visual works that are undone, defaced, or otherwise broken into useless or unreadable form, either through accident or intent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "destroyed works"@en .

aat:300404030 a skos:Concept ;
    skos:definition "The process of creating designs by fitting together individually shaped pieces of durable material, usually stone or glass, where each piece forms an element in the design or pattern. It is distinguished from mosaic technique, which involves insetting small, uniform fragments of stone or glass (tesserae) to fill in areas or lines in the design, but each tessera does not itself form a pattern or element."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus sectile"@en .

aat:300404031 a skos:Concept ;
    skos:definition "Process or technique of using individually shaped stones of varying colors used to make a composition, often but not always low-relief rather than flat. Often used for small objects, such as focal pieces in a piece of jewelry. Although usage may overlap, for the process used to make larger works, such as table tops, from shaped stones, prefer \"pietra dura (process).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commesso"@en .

aat:300404032 a skos:Concept ;
    skos:definition "Technique of mosaic making, first seen in ancient Greece and considered the most desired method for many centuries. Characterized by the use of very small cubes of uniform size of stone or glass used to form very detailed images or patterns, and having outlines surrounding elements of the composition. For a similar technique using larger tesserae and not employing outlines, which was considered inferior in ancient times but became standard in the Middle Ages, use \"opus tessellatum.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "opus vermiculatum"@en .

aat:300404033 a skos:Concept ;
    skos:definition "In Christian churches, the lists of dates for liturgical feast days and days of fasting for each year."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fasts and feasts"@en .

aat:300404034 a skos:Concept ;
    skos:definition "Annual Italian festival that took place on the 29th and 30th of June, honoring Sts. Peter and Paul and as a tribute to the Pope. Two days of events, including fireworks, the ritual presentation of a fine white horse (chinea), and some 7000 gold ducats were made as tribute to the incumbent pope by the Kingdom of Naples (later Kingdom of the two Sicilies). Until the hiatus of 1734-1737 (occasioned by political events) the macchine de' fuochi d'artificio were largely allegorical or mythological in nature; after the break they continued thus until 1745 after which they became predominantly architectural."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Festa della Chinea"@en .

aat:300404035 a skos:Concept ;
    skos:definition "Egyptian holiday with ancient origins, celebrating the natural cycle of the Nile; it is held during two weeks annually starting August 15. In Ancient Egypt, the flooding was associated with the tears of Isis for Osiris, her deceased husband. In the Coptic Church the ritual includes ceremonially throwing a martyr's relic into the river. With the construction of High Dam at Aswan, the annual flooding cycle in Egypt came to an end in 1970."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Flooding of the Nile"@en .

aat:300404036 a skos:Concept ;
    skos:definition "Said to have Early Christian origins, today it is an annual Roman Catholic period during which continuous prayer is made for forty hours before the Host, which is displayed in solemn exposition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Forty Hours' Devotion"@en .

aat:300404037 a skos:Concept ;
    skos:definition "The anniversary of the storming of the Bastille on 14 July 1789, celebrated as a national holiday in France."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bastille Day"@en .

aat:300404038 a skos:Concept ;
    skos:definition "Devotees or ascetics who practise the system of yoga, as evolved in India."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yogins"@en .

aat:300404040 a skos:Concept ;
    skos:definition "Periodicals in an electronic format that use the Internet as a publication method."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "webzines"@en .

aat:300404042 a skos:Concept ;
    skos:definition "Features known from historical sources, but for which the exact location is undetermined."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lost physical features"@en .

aat:300404043 a skos:Concept ;
    skos:definition "The event or condition of an office, post, or tenancy, usually a political office, post, or tenancy, being, becoming, or falling vacant. Vacancies occur by the voluntary act of the incumbent, by circumstances such as a death, or by compulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacancies"@en .

aat:300404044 a skos:Concept ;
    skos:definition "In Christian churches, the condition of a vacancy occurring in the leadership of an episcopal see, the papacy, or another office."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sedi vacanti"@en .

aat:300404045 a skos:Concept ;
    skos:definition "The condition or event of no pope being in office, usually the period during which the papal election is taking place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vacancies of the Holy See"@en .

aat:300404046 a skos:Concept ;
    skos:definition "The first photographic positive transparency process utilizing albumen-coated glass plates for making lantern slides. Introduced by Frederick and William Langenheim of Philadelphia in 1849. The process was also used for making large glass transparencies hung in windows as decorative works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hyalotype"@en .

aat:300404047 a skos:Concept ;
    skos:definition "Winged gods associated with love and sex in Greek mythology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "erotes"@en .

aat:300404048 a skos:Concept ;
    skos:definition "The arrangement of works in an installation or display as a specifically spaced sequence of points which the viewer is intended to follow, pausing at each work. An example is the traditional stations of the cross, although the term is most often used for contemporary art installations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stations format"@en .

aat:300404050 a skos:Concept ;
    skos:definition "That which is placed in position number one of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first"@en .

aat:300404051 a skos:Concept ;
    skos:definition "That which is placed in position number two of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second"@en .

aat:300404052 a skos:Concept ;
    skos:definition "That which is placed in position number three of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "third"@en .

aat:300404053 a skos:Concept ;
    skos:definition "That which is placed in position number five of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifth"@en .

aat:300404054 a skos:Concept ;
    skos:definition "That which is placed in position number six of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixth"@en .

aat:300404055 a skos:Concept ;
    skos:definition "That which is placed in position number four of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourth"@en .

aat:300404056 a skos:Concept ;
    skos:definition "That which is placed in position number seven of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seventh"@en .

aat:300404057 a skos:Concept ;
    skos:definition "That which is placed in position number eight of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighth"@en .

aat:300404058 a skos:Concept ;
    skos:definition "That which is placed in position number nine of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ninth"@en .

aat:300404059 a skos:Concept ;
    skos:definition "That which is placed in position number ten of a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenth"@en .

aat:300404060 a skos:Concept ;
    skos:definition "Small portable altars, most often made of terracotta, but also of stone. These usually have a square or rectangular shape with varying dimensions. Arulae are considered too small to have been used for animal sacrifice, and are commonly decorated with moldings at top and bottom and with molded reliefs on one or more sides. Characteristic products of South Italy and Sicily from the the second quarter of the sixth century through the Roman period. They have been found in sanctuaries, near or inside graves, and in habitation sites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arulae"@en .

aat:300404061 a skos:Concept ;
    skos:definition "Buttonhole stitches worked on the edge of a blanket or other material too thick to be hemmed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blanket stitches"@en .

aat:300404062 a skos:Concept ;
    skos:definition "A primary combination of arsenic with another element, for example hydrogen or a metal, or an organic radical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arsenide"@en .

aat:300404063 a skos:Concept ;
    skos:definition "Works of art, architecture, or other objects that have been previously taken apart or fragmented, either through damage or intentionally, and that are subsequently put back together."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reassembled works"@en .

aat:300404064 a skos:Concept ;
    skos:definition "The process of taking apart, whether by damage or intentionally; examples are when folios of manuscripts are cut out of the volume for redistribution separately."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "disassembling"@en .

aat:300404065 a skos:Concept ;
    skos:definition "A registered trademark for a series of acid-free, 100% cotton papers used for watercolor, drawing, and printmaking. Made in the village of Arches Vosges, France, Arches Watercolor paper is moldmade, gelatin-sized, air-dried, and pH neutral. Sheets have two four deckle edges and are watermarked. The brand is noted for its warm white color and durability, available in hot-pressed, cold-pressed, and rough varieties."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Arches paper (R)"@en .

aat:300404066 a skos:Concept ;
    skos:definition "People who are experts on books, and often collect books."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bibliophiles"@en .

aat:300404067 a skos:Concept ;
    skos:definition "Device comprising two buttons, usually decorative, joined to allow its use in closing sleeves or cuffs, which are fitted with button holes or other openings to allow insertion of the sleeve buttons."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleeve buttons"@en .

aat:300404068 a skos:Concept ;
    skos:definition "Formal introductions of a major work into public use with appropriate ceremonies, as the opening of a building or park, the unveiling of a statue, fountain, or other work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inaugurations"@en .

aat:300404069 a skos:Concept ;
    skos:definition "Animal-drawn caravans of the types used by gypsies or Irish travellers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gypsy wagons"@en .

aat:300404070 a skos:Concept ;
    skos:definition "The culture and ethnic group of the traditionally itinerant people who originated in northern India but live in modern times worldwide, principally in Europe. Most Roma speak some form of Romani a language closely related to the modern Indo-European languages of northern India, as well as the major language of the country in which they live. It is generally agreed that Roma groups left India in repeated migrations and that they were in Persia by the 11th century, in southeastern Europe by the beginning of the 14th, and in western Europe by the 15th century. By the second half of the 20th century they had spread to every inhabited continent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Rom"@en .

aat:300404071 a skos:Concept ;
    skos:definition "The culture and ethnic group of the traditionally itinerant people of Ireland. Their language today, Shelta, is based heavily on Hiberno-English with heavy influences from Irish. Scholars dispute the origins of the people, but documentary, linguistic, and DNA evidence indicate that the peoples existed as far back as the 13th century, 300 years before the first Rom populations arrived in the British Isles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Irish Traveller"@en .

aat:300404072 a skos:Concept ;
    skos:definition "The process of making a counterproof, which is printing a mirror-image from an original printed or drawn work, including both art works and printed or handwritten materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "counterproving"@en .

aat:300404073 a skos:Concept ;
    skos:definition "Copies of works that derive from parts of two or more different works or that add new parts to the copied work or works. Examples are a Roman copy of a Greek original sculpture, where a Roman portrait face is substituted for the Greek original face, or a building that incorporates parts copied from multiple other buildings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pastiche copies"@en .

aat:300404074 a skos:Concept ;
    skos:definition "Replacements of one governing administration by another. In later usage, often used as a euphemism for the removal of an illegitimate or hostile government by military force."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "regime changes"@en .

aat:300404075 a skos:Concept ;
    skos:definition "Type of Greek sculpture of a youth tying a fillet around his head, an athlete having won at the games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "diadoumenoi"@en .

aat:300404076 a skos:Concept ;
    skos:definition "Pairs of works that match and are intended to be used together. For works intended to be displayed side by side, prefer \"pendants (companion pieces).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mates"@en .

aat:300404077 a skos:Concept ;
    skos:definition "Works that are designed to be displayed or used together, usually referring to a relatively small number of such works. For larger numbers of works, or works that are often of matching pattern, prefer \"sets (object groupings).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "companion pieces"@en .

aat:300404078 a skos:Concept ;
    skos:definition "Craftsmen and textile workers who specialize in making fringes and other trimmings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fringe makers"@en .

aat:300404079 a skos:Concept ;
    skos:definition "Distinctive performers in Italian comedy, subsequently in French light comedy, and in English pantomime. The character has many attributes of the clown with the addition of mischievous intrigue; he usually wears particoloured bespangled tights and a visor, and carries a light ‘bat’ of lath as a magic wand."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harlequins"@en .

aat:300404080 a skos:Concept ;
    skos:definition "A photographic plate size, usually 5 1/2 x 7 1/8 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "three-quarter plate"@en .

aat:300404081 a skos:Concept ;
    skos:definition "Foot-activated percussion instruments described by the ancient Greeks. The instruments had metal plates that would have made a noise like a modern tap shoe, used in order to create a rhythm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kroupezions"@en .

aat:300404082 a skos:Concept ;
    skos:definition "Positive prints made from the Fox Talbot calotype negative. Although calotype paper could be used to make positive prints from calotype negatives, Talbot's earlier silver chloride paper, commonly called \"salted paper,\" was normally used for that purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calotype prints"@en .

aat:300404083 a skos:Concept ;
    skos:definition "Breed of dog, now extinct, that was introduced to New Zealand by Maori during their migrations from East Polynesia in the late 13th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Polynesian dog"@en .

aat:300404084 a skos:Concept ;
    skos:definition "Assemblies of people with a common interest for conferences or discussions at which all participants are accorded equal status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roundtables"@en .

aat:300404085 a skos:Concept ;
    skos:definition "Small assemblies of people brought together to present, investigate, or decide upon a particular matter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panels"@en .

aat:300404086 a skos:Concept ;
    skos:definition "Involuntary deep inhalation with the mouth open, often accompanied by the act of stretching."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "yawning"@en .

aat:300404087 a skos:Concept ;
    skos:definition "Meetings at which examination or investigation of a topic occurs in order to exchange ideas or to reach a decision or judgement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discussions"@en .

aat:300404088 a skos:Concept ;
    skos:definition "Large condor native to South America, having a wingspan of over 10 feet; only living member of the Vultur genus. The exact taxonomic placement of the Andean condor and the other 6 species of New World vultures remains. The New World and Old World vultures evolved from different ancestors in different parts of the world and are not closely related."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vultur gryphus"@en .

aat:300404089 a skos:Concept ;
    skos:definition "Genus of large condor native to South America, having only one known species. The fossil record of the genus is slight."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Vultur"@en .

aat:300404093 a skos:Concept ;
    skos:definition "Places that formerly were for the landing of non-commercial aircraft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned airfields"@en .

aat:300404094 a skos:Concept ;
    skos:definition "Former man-made watercourses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned canals"@en .

aat:300404095 a skos:Concept ;
    skos:definition "Gently inclined underground tunnels bringing water for irrigation from aquifers near the base of mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "underground irrigation canals"@en .

aat:300404096 a skos:Concept ;
    skos:definition "Areas comprising a portion of a canal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sections of canals"@en .

aat:300404097 a skos:Concept ;
    skos:definition "Facilities used for receiving and transmitting information."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communication centers"@en .

aat:300404099 a skos:Concept ;
    skos:definition "Ditches used to drain agricultural land."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drainage ditches"@en .

aat:300404100 a skos:Concept ;
    skos:definition "Ditches used to distribute water from irrigation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "irrigation ditches"@en .

aat:300404101 a skos:Concept ;
    skos:definition "Facilities used for improving the metal content of ore by concentration."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ore treatment plants"@en .

aat:300404102 a skos:Concept ;
    skos:definition "Facilities where sugar cane is processed into raw sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugar mills"@en .

aat:300404103 a skos:Concept ;
    skos:definition "Places with scenic or wildlife views."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "observation points"@en .

aat:300404104 a skos:Concept ;
    skos:definition "Facilities where crude oil is processed into refined petroleum products."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "oil refineries"@en .

aat:300404105 a skos:Concept ;
    skos:definition "Buildings where police are stationed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "police posts"@en .

aat:300404106 a skos:Concept ;
    skos:definition "Facilities that formerly stationed police."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandoned police posts"@en .

aat:300404108 a skos:Concept ;
    skos:definition "Posts from which patrols are sent."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patrol posts"@en .

aat:300404109 a skos:Concept ;
    skos:definition "Structures used for the shelter or rest of travelers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resthouses"@en .

aat:300404110 a skos:Concept ;
    skos:definition "Signals that govern the movement of trains, typically using flags or lights; generally located at the entrances of sections of railroad tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad signals"@en .

aat:300404111 a skos:Concept ;
    skos:definition "Stations where vehicles and goods are inspected."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inspection stations"@en .

aat:300404112 a skos:Concept ;
    skos:definition "Broad designation for areas of endeavor, physical and mental actions, discrete occurrences, systematic sequences of actions, methods employed toward a certain end, and processes occurring in materials or objects. Activities may include branches of learning and professional fields to specific life events, from mentally executed tasks to processes performed on or with materials and objects, from single physical actions to complex games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "activities"@en .

aat:300404113 a skos:Concept ;
    skos:definition "The function, quality, or activity of having instruction or teaching as a primary or ulterior purpose."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "didacticism"@en .

aat:300404114 a skos:Concept ;
    skos:definition "Depictions that are specifically and primarily of the human form."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "human figures"@en .

aat:300404116 a skos:Concept ;
    skos:definition "State or condition of existing or moving in the air above the earth, usually within the atmosphere of the planet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aerial"@en .

aat:300404117 a skos:Concept ;
    skos:definition "State or condition of existing or moving in the water of a sea or ocean."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "marine"@en .

aat:300404118 a skos:Concept ;
    skos:definition "State or condition of existing or moving in water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquatic"@en .

aat:300404119 a skos:Concept ;
    skos:definition "State or condition of existing in or comprising mountains."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mountainous"@en .

aat:300404120 a skos:Concept ;
    skos:definition "State or condition of existing in or comprising hills."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hilly"@en .

aat:300404121 a skos:Concept ;
    skos:definition "State or condition of existing or moving on the surface of the earth, as contrasted to in the air, heavens, or water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "terrestrial"@en .

aat:300404122 a skos:Concept ;
    skos:definition "State or condition of existing or moving in the heavens, usually meaning above the atmosphere of the planet, but also including the area of heaven, the doctrinal concept."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "celestial"@en .

aat:300404124 a skos:Concept ;
    skos:definition "Facts, processes, conditions, occurrences, or changes caused by the natural physical environment or creatures, in contrast to occurrences created by humans."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural phenomena"@en .

aat:300404125 a skos:Concept ;
    skos:definition "Objects that occur in nature, not made by humans. Used primarily in the context of distinguishing man-made objects from natural objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "natural objects"@en .

aat:300404126 a skos:Concept ;
    skos:definition "In the visual arts, oral works, music, performing arts, and literature, the topics, themes, or other visual, oral, or written content of the work. It includes what the work is of or about."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subjects"@en .

aat:300404128 a skos:Concept ;
    skos:definition "Factory buildings in which ammunition is made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "munitions plants"@en .

aat:300404129 a skos:Concept ;
    skos:definition "Short tracks that are parallel to, and join, main tracks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "railroad sidings"@en .

aat:300404130 a skos:Concept ;
    skos:definition "Places where caravans stop to rest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "halting places"@en .

aat:300404131 a skos:Concept ;
    skos:definition "Refers to a position in the central or middle portion of a whole."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "center"@en .

aat:300404133 a skos:Concept ;
    skos:definition "The right-hand side of a ship or aircraft, as distinguished from the larboard or port side. Traditionally, the side upon which in early types of ships the steering apparatus was worked."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "starboard"@en .

aat:300404134 a skos:Concept ;
    skos:definition "The left-hand side of a ship, that is, the side to the left hand of a person looking from the stern towards the bows; as opposed to starboard."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "larboard"@en .

aat:300404135 a skos:Concept ;
    skos:definition "Flowing floor-length robes with wide sleeves, made of silk or similar material. These are worn by judges while sitting at the bench in courts of law in the United States and elsewhere. Judicial robes in the United States are usually black but may vary in slight detail, as there is no official source or design, in the United Kingdom there exist color variations based on the court in which the judicant sits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "judicial robes"@en .

aat:300404136 a skos:Concept ;
    skos:definition "Robes worn for ceremonial or official occasions, usually with significant details of trim or color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial robes"@en .

aat:300404137 a skos:Concept ;
    skos:definition "Formal or ceremonial robes of varying color and trim meant to convey status in an academic context. These have evolved from what was once everyday attire for scholars and clerics."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "academic robes"@en .

aat:300404138 a skos:Concept ;
    skos:definition "Portraits that portray one sitter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-sitter portraits"@en .

aat:300404139 a skos:Concept ;
    skos:definition "Naturally occuring as tinstone or cassiterite, stannic oxide is the principal ore of tin. It can be artificially obtained as an anhydrous powder when tin is burned in the presence of oxygen, or by igniting stannous hydrate or stannous oxalate. Stannic oxide is used in the manufacture of white glazes and enamels, and as an opacifier. In its pure state is white or light yellow in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stannic oxide"@en .

aat:300404140 a skos:Concept ;
    skos:definition "Persons who tend goats that are grazing at large."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "goatherds"@en .

aat:300404141 a skos:Concept ;
    skos:definition "Actions involving the falling upon with force, and usually with arms; actions involving the commencing of a battle or making another offensive operation. In common military situations, attack is the opposing action to defense. For a personal actions involving falling upon with force or arms, use \"assaults (personal life events).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attacks"@en .

aat:300404142 a skos:Concept ;
    skos:definition "The action of one or more people upon other people with hostile intent, usually physical actions involving blows or weapons. For the falling upon, usually with arms, in a military conflict, prefer \"attacks (armed conflicts),\" although usage may overlap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assaults"@en .

aat:300404143 a skos:Concept ;
    skos:definition "Continuous, unbounded, or unlimited extent in every direction, without reference to any matter that may be present; this is regarded as an attribute of the universe, describable mathematically (in modern science usually conflated with time, time-space)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "space"@en .

aat:300404144 a skos:Concept ;
    skos:definition "Views that derive from the creator's imagination, rather than being made from life to realistically and accurately portray a real landscape, cityscape, or other view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "imaginary views"@en .

aat:300404145 a skos:Concept ;
    skos:definition "Views made from life to realistically and accurately portray a real landscape, cityscape, or other view. For views originating in the creator's imagination, use \"imaginary views.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "real views"@en .

aat:300404146 a skos:Concept ;
    skos:definition "Detached clouds in the form of white, delicate filaments, mostly white patches or narrow bands. They may have a fibrous (hair-like) and/or silky sheen appearance. Cirrus clouds are always composed of ice crystals, and their transparent character depends upon the degree of separation of the crystals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cirrus clouds"@en .

aat:300404147 a skos:Concept ;
    skos:definition "Transparent, whitish veil clouds with a fibrous (hair-like) or smooth appearance. A sheet of cirrostratus which is very extensive, nearly always ends by covering the whole sky. A milky veil of fog (or thin stratus) is distinguished from a veil of cirrostratus of a similar appearance by the halo phenomena which the sun or the moon nearly always produces in a layer of cirrostratus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cirrostratus clouds"@en .

aat:300404148 a skos:Concept ;
    skos:definition "Thin, white patch, sheet, or layered of clouds without shading. They are composed of very small elements in the form of more or less regularly arranged grains or ripples. In general cirrocumulus represents a degraded state of cirrus and cirrostratus both of which may change into it and is an uncommon cloud. There will be a connection with cirrus or cirrostratus and will show some characteristics of ice crystal clouds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cirrocumulus clouds"@en .

aat:300404149 a skos:Concept ;
    skos:definition "Gray or bluish cloud sheets or layers of striated or fibrous clouds that totally or partially covers the sky. They are thin enough to regularly reveal the sun as if seen through ground glass. Altostratus clouds do not produce a halo phenomenon nor are the shadows of objects on the ground visible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altostratus clouds"@en .

aat:300404150 a skos:Concept ;
    skos:definition "White and/or gray patch, sheet or layered clouds, generally composed of laminae (plates), rounded masses or rolls. They may be partly fibrous or diffuse. When the edge or a thin semitransparent patch of altocumulus passes in front of the sun or moon a corona appears. This colored ring has red on the outside and blue inside and occurs within a few degrees of the sun or moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altocumulus clouds"@en .

aat:300404151 a skos:Concept ;
    skos:definition "The continuous rain cloud. Resulting from thickening Altostratus, This is a dark gray cloud layer diffused by falling rain or snow. It is thick enough throughout to blot out the sun. The cloud base lowers into the low level of clouds as precipitation continues. Also, low, ragged clouds frequently occur beneath this cloud which sometimes merges with its base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nimbostratus clouds"@en .

aat:300404152 a skos:Concept ;
    skos:definition "Detached, generally dense clouds and with sharp outlines that develop vertically in the form of rising mounds, domes or towers with bulging upper parts often resembling a cauliflower. The sunlit parts of these clouds are mostly brilliant white while their bases are relatively dark and horizontal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cumulus clouds"@en .

aat:300404153 a skos:Concept ;
    skos:definition "A generally gray cloud layer with a uniform base which may, if thick enough, produce drizzle, ice prisms, or snow grains. When the sun is visible through this cloud, its outline is clearly discernible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stratus clouds"@en .

aat:300404154 a skos:Concept ;
    skos:definition "The thunderstorm clouds; a heavy and dense cloud in the form of a mountain or huge tower. The upper portion is usually smoothed, fibrous or striated and nearly always flattened in the shape of an anvil or vast plume. Under the base of this cloud which is often very dark, there are often low ragged clouds that may or may not merge with the base. They produce precipitation, which sometimes is in the form of virga."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cumulonimbus clouds"@en .

aat:300404155 a skos:Concept ;
    skos:definition "Gray or whitish patch, sheet, or layered clouds which almost always have dark tessellations (honeycomb appearance), rounded masses or rolls. Except for virga they are non-fibrous and may or may not be merged. They also have regularly arranged small elements with an apparent width of more than five degrees (three fingers - at arm's length)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stratocumulus clouds"@en .

aat:300404156 a skos:Concept ;
    skos:definition "Species of sheep of many breeds, descended from the wild mouflon of Europe and Asia. Sheep were among the earliest animals to be domesticated. They are raised for fleece, meat, and milk."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ovis aries"@en .

aat:300404157 a skos:Concept ;
    skos:definition "The office or position of a leader, particularly in a political context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leadership"@en .

aat:300404158 a skos:Concept ;
    skos:definition "Characters, whether fictional or historical, depicted in literary works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "literary characters"@en .

aat:300404159 a skos:Concept ;
    skos:definition "Portions of a whole, including subtances in the context of being combined with other substances, portions of temporal works, or portions of literary or dramatic works. For parts of visual works and other objects, prefer \"components (object parts).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parts"@en .

aat:300404160 a skos:Concept ;
    skos:definition "Patterns or passages intended to be repeated. Examples are a decorative pattern that is repeated uniformly over a surface, or a passage repeated in music."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "repeats"@en .

aat:300404161 a skos:Concept ;
    skos:definition "An historical Italian unit of length, equal to approximately 26/27 inches (66/68 cm), however usage varies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "braccia"@en .

aat:300404162 a skos:Concept ;
    skos:definition "Classes of magnitude or dimensions, typically numbered, into which articles are divided according to how large they are. Examples are in manufactured clothing, such as shoes, dresses, gloves, and hats."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sizes"@en .

aat:300404164 a skos:Concept ;
    skos:definition "The measure or distance of the extent across a surface. For the length of a straight horizontal line extending from one side to the other of a form, prefer \"width,\" although usage overlaps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breadth"@en .

aat:300404165 a skos:Concept ;
    skos:definition "The duration of a dramatic performance, film, musical work, song, or similar activity, excluding any intermissions or interruptions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "running time"@en .

aat:300404167 a skos:Concept ;
    skos:definition "Ceremonial stools common to the Taino culture carved out of wood or stone and are typically made with zoomorphic and anthropomorphic design elements. The stools were used by the higher ranking tribe members during community rituals and activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "duhos"@en .

aat:300404168 a skos:Concept ;
    skos:definition "Place of the afterlife or the world to come, common to most belief systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hereafter"@en .

aat:300404169 a skos:Concept ;
    skos:definition "Large carved monolithic rings of the Taíno people, mostly limited to Puerto Rico. Many are elliptical with a thicker portion with two panels that exhibit decorative carvings. While their exact use is unknown, most archaeologists suggest they were worn on the hips for ceremonial purposes or ball games. They can be classified in at least two types: slender or massive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stone collars"@en .

aat:300404170 a skos:Concept ;
    skos:definition "Angular carved stones of the Taíno culture that are limited to Puerto Rico. The shape consists of a curved thick middle portion and two arms that protrude at a 90 degree angle from each other. Although their use is unknown, most archeologists agree that they are related to stone collars and may have been tied to the waist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elbow stones"@en .

aat:300404171 a skos:Concept ;
    skos:definition "Thin carved tools with decorative handles used by the Taíno people. These are typically made of wood, shell, or bone. They were used to induce vomiting for cleansing purposes related to the cohoba ritual, in which hallucinogenic powder was inhaled."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vomitive spatulas"@en .

aat:300404172 a skos:Concept ;
    skos:definition "Erasers designed to remove typwriter ink from typed pages, sometimes including an attached brush to allow the removal of eraser crumbs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "typewriter erasers"@en .

aat:300404173 a skos:Concept ;
    skos:definition "State, aspiration, or condition of harmony within a community or group having similar goals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fraternity"@en .

aat:300404176 a skos:Concept ;
    skos:definition "Facilities or areas for the cultivation of aquatic animals and plants, especially fish, shellfish, and seaweed, in natural or controlled marine or freshwater environments; underwater agriculture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquaculture facilities"@en .

aat:300404177 a skos:Concept ;
    skos:definition "Facilities for producing fertilizer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phosphate works"@en .

aat:300404178 a skos:Concept ;
    skos:definition "The measurement of altitudes; the distance of a part of the earth's surface in reference to height above or below the level of the sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hypsometry"@en .

aat:300404179 a skos:Concept ;
    skos:definition "A minimally non-destructive technique used to assess in situ the mechanical properties of masonry walls and the local average compressive stress."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flat-jack testing"@en .

aat:300404180 a skos:Concept ;
    skos:definition "The state or process in which events or conditions transpire, a tendency, or a trend evident at a particular time or in a particular sphere, particularly a course or series of actions and endeavours on the part of a group of people working towards a shared goal or to advance a shared political, social, or artistic objective."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "movement"@en .

aat:300404181 a skos:Concept ;
    skos:definition "Facilities for processing copper ore."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copper works"@en .

aat:300404182 a skos:Concept ;
    skos:definition "Measuring stations used by scientists to test bodies of water."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stream gauging stations"@en .

aat:300404183 a skos:Concept ;
    skos:definition "Areas where ditches enter lagoons, lakes, or bays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ditch mouths"@en .

aat:300404187 a skos:Concept ;
    skos:definition "Vases designed for use on an altar, usually to hold cut flowers or other plant matter; found in Christian, Buddhist, and other religious settings. In Christian churches, according to the Cæremoniale Episcoporum, the altar vases should be placed between the candlesticks on the altar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar vases"@en .

aat:300404188 a skos:Concept ;
    skos:definition "Case furniture for storing altar frontals and other antependia, usually located in the sacristy of the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "frontal cupboards"@en .

aat:300404189 a skos:Concept ;
    skos:definition "Frames for altar frontals (antependia), particularly frames that serve to suspend or hold textile antependia in place."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "altar frontal frames"@en .

aat:300404190 a skos:Concept ;
    skos:definition "Wall fixtures in the interior of a consecrated church, used for holding candles at the twelve consecration crosses arranged down the aisle the church."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "consecration candlesticks"@en .

aat:300404191 a skos:Concept ;
    skos:definition "Bands resembling chains, made of linked metal loops with points, usually blunt rather than sharp; the band is tied or otherwise secured on an arm, leg, waist, or other area of the body so that the points are against the skin. Used in some religious traditions to induce some degree of discomfort or pain as a sign of repentance and atonement."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cilice chains"@en .

aat:300404192 a skos:Concept ;
    skos:definition "Temporary structures for protecting the open grave immediately prior to interment or immediately after burial; typically having the form of a canopy, ramada, or tent. For structures of similar form, a ramada or shed but intended to exist for months or years rather than hours or days, prefer \"gravehouses.\" For raised, canopied structures under which the coffin or effigy of a deceased person lies or is carried in state, prefer \"catafalques.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grave shelters"@en .

aat:300404193 a skos:Concept ;
    skos:definition "Combat in and on seas, oceans, or any other major bodies of water, using combatants in boats or ships. The first naval battles date to more than 3,000 years ago."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naval battles"@en .

aat:300404195 a skos:Concept ;
    skos:definition "Originally a trademarked name for a hard and polishable plastic material made from albumen from blood or egg white mixed with hardwood sawdust and coloring. The mixture was steam-heated and poured into molds, where it cooled to form a hard, dense, glossy object. Patented by François Charles Lepage in France and England 1855-1856, the invention was later bought by A. Latry, a manufacturer of desk wares such as inkwells and decorative boxes.The material was also used for combs, pipe stems, inkwells, and plaques, and medallions for furniture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bois durci"@en .

aat:300404196 a skos:Concept ;
    skos:definition "Related to a device, instrument, information storage, work, or other application, operating according to the principles or methods using signals, information, or data represented by a series of discrete values (commonly the numbers 0 and 1), such as for electronic storage or processing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital"@en .

aat:300404198 a skos:Concept ;
    skos:definition "Media containing any content that is represented in digital form, meaning it is encoded in an electronic format that uses a series of discrete values (commonly the numbers 0 and 1) to record data and render it machine-readable. Digital media include, but are not limited to, digital audio and video tape, floppy discs, and portable hard drives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "digital media"@en .

aat:300404199 a skos:Concept ;
    skos:definition "Those whose trade is to process the flesh of animals for sale as food. Butchers may slaughter animals, but in common usage the term denotes someone who deals in meat products in a retail context."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "butchers"@en .

aat:300404200 a skos:Concept ;
    skos:definition "Works of feather mosaic created by Nahua peoples. Objects included cloaks, fans, and shields."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "amantecayotl"@en .

aat:300404202 a skos:Concept ;
    skos:definition "In computing, collections of related records stored in digital form for use by a computer and able to be processed by it."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "files"@en .

aat:300404203 a skos:Concept ;
    skos:definition "A class of pigments where a variety of both inorganic and organic compounds may be present. Historically, comparatively little is known about which materials were used as black pigments, and in treatises on painting technique, the terms black earth, black chalk and black stone were used interchangeably, whether discussing black pigments or drawing materials. In current technical literature, black earth is generally assumed to be a black shale or chalk, but other bituminous materials and minerals have been identified."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black earth"@en .

aat:300404204 a skos:Concept ;
    skos:definition "The wise people of Nahua societies, who were said to be the owners of painted books and possessors of knowledge."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tlamatinimeh"@en .

aat:300404205 a skos:Concept ;
    skos:definition "Pigment made by grinding a black form of slate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mineral black"@en .

aat:300404206 a skos:Concept ;
    skos:definition "Form of poetry that tells a story, often making use of the voices of a narrator and characters as well. The story may be written in metered verse, but not necessarily following rhythmic patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrative poetry"@en .

aat:300404207 a skos:Concept ;
    skos:definition "Literary works in the form of poetry that tells a story, often making use of the voices of a narrator and characters as well. The story may be written in metered verse, but not necessarily following rhythmic patterns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narrative poems"@en .

aat:300404208 a skos:Concept ;
    skos:definition "Form of poetry comprising long narratives celebrating on a grand scale the adventures and deeds of one or more heroic figures, ordinarily concerning a serious subject significant to a culture or nation. Classical epic poetry employs dactylic hexameter and recounts a journey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epic poetry"@en .

aat:300404209 a skos:Concept ;
    skos:definition "In modern usage refers to literary art forms, such as prose, poetry, plays, films, and other works where the story has a theme of grandeur and heroism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epic literature"@en .

aat:300404210 a skos:Concept ;
    skos:definition "Badges worn as identifying insignia by beggars. For example, as found in the early 15th century in Great Britain and Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "beggar's badges"@en .

aat:300404211 a skos:Concept ;
    skos:definition "Copies of works in any media, generally in the same media and of the same scale as the original, that have been authorized for production by the owner or creator. An example of authorized copies of visual works include accurate copies of paintings in art museums that were created as souvenirs for visitors, particularly popular in the 18th and 19th centuries; such paintings may be stamped on the back of the canvas with a seal of authorized copy with the museum's name."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "authorized copies"@en .

aat:300404212 a skos:Concept ;
    skos:definition "Transfer of property from one individual or group to another, made gratuitously to the recipient, bestowed voluntarily and without monitary compensation. In various societies, gift giving is associated with status, ritual, and tradition for various occasions and circumstances. Reciprocal gifts may be expected, resulting in an exchange of gifts rather than unilateral giving."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gift giving"@en .

aat:300404213 a skos:Concept ;
    skos:definition "A method of correspondence developed during World War II that allowed US civilians and military personnel abroad to communicate. The system was based on letter-sheets designed to fold into envelopes, and which allowed only for brief texts. After mailing, V-Mail letters were reviewed by censors, photographically reduced on microfilm, and sent to processing centers overseas where facsimiles were reproduced at one-quarter their original size. These facsimiles were then delivered to the addressee. The system allowed for the reduction of shipping space needed for war materials, and speeded delivery by air rather than by sea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "V-mail"@en .

aat:300404214 a skos:Concept ;
    skos:definition "Buildings in which money or valuable objects are stored or preserved. These usually incorporate security features into their design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "treasuries"@en .

aat:300404215 a skos:Concept ;
    skos:definition "A method of painting with matte, opaque watercolor paint. Gouache painting employs opaque layers of color rather than the transparent washes used in the aquarelle technique, due to the differing pigment densities of the media."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gouache"@en .

aat:300404216 a skos:Concept ;
    skos:definition "Paintings produced by applying washes of thin, transparent watercolor, usually onto paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aquarelles"@en .

aat:300404217 a skos:Concept ;
    skos:definition "Costume accessory worn around the head, comprising a wreath of leaves, or resembling a wreath of leaves but made from other materials, such as gold."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "leaf crowns"@en .

aat:300404218 a skos:Concept ;
    skos:definition "Supports of various design for the baptismal font, particularly for basin-style fonts. Examples include tabletop supports and metal supports mounted on a wall or other church architecture. For holders of baptismal fonts that rest on the floor, use \"baptismal font stands.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal font supports"@en .

aat:300404220 a skos:Concept ;
    skos:definition "Stands of various designs that rest on the floor or ground and support the baptismal font. For tabletop or wall-mounted supports for the baptismal font, use \"baptismal font supports.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal font stands"@en .

aat:300404221 a skos:Concept ;
    skos:definition "Objects designed as a set and used in Christian baptism, including vessels for the sacred oil and holy water, among other possible items. Baptism sets may be portable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptism sets"@en .

aat:300404222 a skos:Concept ;
    skos:definition "Spaces in a church marked by an arch, usually as the entrance to an apse or chapel, coinciding with the part of the building containing a font for the baptismal rite. The open space beneath the arch may be spanned by a gate, grillwork, or door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptistery arches"@en .

aat:300404223 a skos:Concept ;
    skos:definition "Screens separating the baptismal font and area from the rest of the church; may comprise a solid screen, open screen work, or a railing. For separate structures or chapels used for baptisms, use \"baptistries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal screens"@en .

aat:300404224 a skos:Concept ;
    skos:definition "Candles used during the Christian sacrament of baptism; in many customs, the candle is kept by the baptized person as a symbolic momento."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal candles"@en .

aat:300404225 a skos:Concept ;
    skos:definition "Small vessels, such as pitchers, ewers, or cruets, designed and used for pouring water onto the baptized person during baptism in Christian rites."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baptismal ewers"@en .

aat:300404226 a skos:Concept ;
    skos:definition "Infant's caps worn during a baptism or christening ceremony, often of lace, embroidered, or otherwise decorated."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening caps"@en .

aat:300404227 a skos:Concept ;
    skos:definition "White veils, often lace or embroidered, used in the Christian baptism or christening ceremony to cover the head of the baptized or christened adult or child."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "christening veils"@en .

aat:300404228 a skos:Concept ;
    skos:definition "Specialized candlesticks or arrangements of candles used in various Christian traditions on Holy Saturday prior to Easter. The device may comprise a specialized candlestick, three candles tied to a reed or bronze rod, or a candle having three branches. In western tradition, it was largely replaced by the large paschal candle due to liturgical revisions of Pope Pius XII in the 1950s. It is commonly used in eastern Christian traditions. An example of usage is when the three candles of which the device is composed are successively lit as the priest proceeds up the aisle of the church in the \"Lumen Christi\" ritual; the large paschal candle at the front of the church may be lit from the triple candlestick."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triple candlesticks"@en .

aat:300404229 a skos:Concept ;
    skos:definition "Candles used for the Christian feast of the Epiphany on January 6, which celebrates the recognition of Jesus by the three Magi. These candles are used in homes and liturgies. Example of design include a candle terminating in three upper branches (shaped like a trident) and a large candle encircled by three crowns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epiphany candles"@en .

aat:300404230 a skos:Concept ;
    skos:definition "Prints that are published to mark special occasions, often carrying inscriptions that name the event , the date, the participants, and typically depicting the event or a reference to the event."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "commemorative prints"@en .

aat:300404231 a skos:Concept ;
    skos:definition "Pews in a church reserved for the royal family; the pews may be set up on a high platform or otherwise decorated and designated as belonging to the monarch or family."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "royal pews"@en .

aat:300404233 a skos:Concept ;
    skos:definition "Stoles used for the Christian sacrament of confession, purple in color; may be shorter and narrower than stoles that are used with the chasuble and intended for masses, funerals, and other rituals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "confessional stoles"@en .

aat:300404234 a skos:Concept ;
    skos:definition "Banners that are designed for and used in processions and hung in funerary settings; known in various cultures. For coverings and curtains used in funerary settings, prefer \"mourning cloths.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mourning banners"@en .

aat:300404235 a skos:Concept ;
    skos:definition "Small to medium-sized clapper bells, usually mounted in a fixture extending from the wall at the sacristy door of a Christian church, rung to announce the entrance procession of the liturgical celebrants."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sacristy bells"@en .

aat:300404236 a skos:Concept ;
    skos:definition "Device having one or more bells mounted to a wheel, the turning of which rings the bells, usually clapper bells. The devices may be of various sizes and used for various purposes. One use of the device is as a sanctus bell during the Catholic mass."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bell wheels"@en .

aat:300404237 a skos:Concept ;
    skos:definition "Ship models displayed in churches as votive offerings to protect those that went to sea or as showpieces at the altar of a guild. They were particularly popular in port cities in northern Europe, although found elsewhere."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "votive ships"@en .

aat:300404238 a skos:Concept ;
    skos:definition "General term for long capes worn by cardinals, bishops, and other Christian prelates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prelate's mantles"@en .

aat:300404240 a skos:Concept ;
    skos:definition "Small, miniturized, or compact sets of items intended to allow the convenient transport and distribution of the Christian communion to the sick, dying, battlefield, or others outside the church building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "portable communion sets"@en .

aat:300404241 a skos:Concept ;
    skos:definition "Certificates verifying the authenticity of a relic, which is a part of a body or an item that was in contact with a holy person or deity. In Roman Catholic tradition, the certificate for the relic of a saint will attest to the relic's being what it is claimed to be, so far as is known or believed by the signees; it will include the status of the relic as first, second, or third class, defined by the immediacy of association with the saint."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates of authenticity for relics"@en .

aat:300404242 a skos:Concept ;
    skos:definition "Envelopes or other simple coverings for relics, which are the remains of a saint, martyr, deity, or other holy person, or their personal items; known in many cultures. Relic covers are made of materials such as paper, leather, silk or another textile; often inscribed, stamped, embroidered, or otherwise decorated. Relic covers may themselves be considered holy from having been in contact with the relic; relic covers may be swapped out and the used cover distributed to the faithful for veneration or perceived healing properties. For more substantial containers for relics, often made of precious materials, use \"reliquaries.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "relic covers"@en .

aat:300404243 a skos:Concept ;
    skos:definition "Stoles worn by deacons to designate their rank. In the western church, deacon's stoles are worn over the left shoulder; historically hanging straight down, in the modern church worn across the body and tied under the right arm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deacon's stoles"@en .

aat:300404244 a skos:Concept ;
    skos:definition "Altars in Catholic churches installed after the Second Vatican Council (1962-1965) in accordance with new mandates that the altar should be table-like and placed far enough away from the wall so that the celebrant could face the congregation rather than have his back to them. Churches dating before the 1960s may retain the structures of the original high altars that are nearer the wall and having ornate superstructures, although they are no longer used for celebrating the mass. Altars from other periods and other faiths may be similar in design to council altars; the distinction is the context in which the council altar was installed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "council altars"@en .

aat:300404245 a skos:Concept ;
    skos:definition "Sweets, such as a sugared almonds, given to visitors after the birth of a child, particularly in Flanders and some regions of the Netherlands."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "doopsuikers"@en .

aat:300404246 a skos:Concept ;
    skos:definition "Candlestick designed for use on the Epiphany on January 6, intended to hold three candles. A common design includes a central spike to hold a wax candle with two flanking cups to hold tallow candles."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "epiphany candlesticks"@en .

aat:300404247 a skos:Concept ;
    skos:definition "Garment hangers having a scale and shape appropriate for the storage or display of ceremonial robes, for example, for liturgical vestments or royal robes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "robe hangers"@en .

aat:300404250 a skos:Concept ;
    skos:definition "Processional torches or other lamps used by a given guild and marked by the insignia of that guild."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guild torches"@en .

aat:300404251 a skos:Concept ;
    skos:definition "Racks of various designs used for drying towels; may be attached to a wall or other surface, or standing on the floor."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "towel racks"@en .

aat:300404252 a skos:Concept ;
    skos:definition "Coverings of cloth or other material used to decorate or cover the gradine or altar ledge of the altar in Christian churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gradine covers"@en .

aat:300404253 a skos:Concept ;
    skos:definition "Stools or other types of simple seats in the choir of a church, used by acolytes or other assistants of the celebrant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acolyte seats"@en .

aat:300404254 a skos:Concept ;
    skos:definition "Chalices, usually unconsecrated, that are used by Christian seminarians when learning to say mass. The vessels are typically of non-precious materials, such as common metal or wood."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seminarian's chalices"@en .

aat:300404256 a skos:Concept ;
    skos:definition "Christian vestments comprising tunics of the form of a dalmatic, but of silk or another fabric that is lighter weight than a dalmatic. They have been worn by bishops, abbots, and cardinals under their chasubles during pontifical masses. In earlier periods, the garments were of linen and white in color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dalmatics minor"@en .

aat:300404259 a skos:Concept ;
    skos:definition "Chairs of various designs, positioned at the front of certain Protestant churches and used by the preacher during services. For chairs having a tall back surmounted by a lectern and used as a pulpit, use \"preaching chairs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preacher's chairs"@en .

aat:300404260 a skos:Concept ;
    skos:definition "Staffs supporting an open flame at the top, sometimes emitted from a candle, designed to be carried in processions. If the flame is entirely enclosed within a protective glass case in the form of a lantern, or for electric lamps of similar form, use \"processional lanterns.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "processional torches"@en .

aat:300404262 a skos:Concept ;
    skos:definition "The process of removing a mosaic or pavement from its original location to a new support and often to a new location. The process involves temporary facings, lifting or removal of the mortars, stabilization of the tessera or panels, and other issues; for various reasons, lifting is used rather than in situ stabilization treatments."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lifting"@en .

aat:300404263 a skos:Concept ;
    skos:definition "Shifting cultivation plots of the Arawak people that formed a part of their agricultural system. These were selected and controlled by individual families to grow starchy and sugar-rich foods such as tubers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conucos"@en .

aat:300404264 a skos:Concept ;
    skos:definition "Words or phrases indicating the certainty with which art or other creative work can be attributed to a known individual creator or group, used when the attribution is uncertain, is in dispute, when there is more than one creator, when there is a former attribution, or when the attribution otherwise requires explanation. For qualifiers that may be more broadly applied, not only for creator attributions, see \"information handling functions.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attribution qualifiers"@en .

aat:300404269 a skos:Concept ;
    skos:definition "Qualifier used for attributions to express minor to moderate uncertainty regarding the attribution to a known creator, as when the work's provenance, style, or physical characteristics strongly suggest a given creator, but the attribution cannot be validated with absolute certainty (e.g., attributed to Frans Hals (Dutch painter, ca. 1581-1666))."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "attributed to"@en .

aat:300404270 a skos:Concept ;
    skos:definition "Qualifier used to refer to an attribution that had been accepted in the past, but is no longer generally held to be valid (e.g., formerly attributed to Yan Wengui (Chinese, active ca. 970-1030))."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "formerly attributed to"@en .

aat:300404271 a skos:Concept ;
    skos:definition "Qualifier used to express minor uncertainty regarding the attribution, generally indicating a slightly stronger probability than \"attributed to.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "probably by"@en .

aat:300404272 a skos:Concept ;
    skos:definition "Qualifier used to express significant uncertainty regarding attribution, indicating notably greater uncertainty than \"attributed to.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "possibly by"@en .

aat:300404273 a skos:Concept ;
    skos:definition "A term used by Spanish observers of Taino ceremonial rituals. These were gatherings that might include music, song, dance and pantomime applied to religious liturgies, magical rites, and epic narratives of tribal history, but most particularly refers to a type of call-and-response song-poem accompanied by dance."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "areitos"@en .

aat:300404274 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown creator working under a master's name, generally in a system of apprenticeship common from ancient times through the mid-17th century (e.g., workshop of Gislebertus)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "workshop of"@en .

aat:300404275 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown creator working for a named artist in a system common after the 16th century, when master artists took on pupils who were learning to be artists rather than apprentices who were learning a trade."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "studio of"@en .

aat:300404276 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown architect or other creator working for a named architect or other creator in the 18th century through the present, when the group of people working for the architect calls itself an office (e.g., office of ChristopherWren)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "office of"@en .

aat:300404277 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown creator working for a named studio that called itself an atelier, generally reserved for those studios located in France, or in Britain after the 18th century."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atelier of"@en .

aat:300404278 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown creator working as an assistant to a named artist, architect, or other creator whose staff is relatively small in number and do not call themselves a studio or an office. Also use for an assistant who worked in a studio or office, but in a special, close relationship to the named artist or architect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "assistant to"@en .

aat:300404279 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown creator working under a named creator, where the relationship is apparently close, probably a student/teacher relationship; implies the unknown artist is probably younger or less experienced than the named artist; synonymous with student of."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pupil of"@en .

aat:300404280 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown creator working with a named creator, where the relationship is between two peers rather than between a student and teacher."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "associate of"@en .

aat:300404281 a skos:Concept ;
    skos:definition "Qualifier used for attributions of works by an unknown creator working for a named manufactory or factory, which is typically larger than a studio or workshop, and typically produces porcelain, tapestries, furniture, and occasionally fine art."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manufactory of"@en .

aat:300404282 a skos:Concept ;
    skos:definition "Qualifier used for a work by an unknown creator whose style is strongly influenced by the named artist or architect, and who is living at the same time as or shortly after the named artist, but is not necessarily his or her pupil (e.g., follower of Hokusai)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "follower of"@en .

aat:300404283 a skos:Concept ;
    skos:definition "Qualifier used for a work by an unknown creator who appears to be associated with the named artist, he or she is living at the same time as the named artist, and probably had some contact with him or her, but not is necessarily his or her pupil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "circle of"@en .

aat:300404284 a skos:Concept ;
    skos:definition "Qualifier used for a work by an unknown creator whose style is influenced by the named artist or architect or by the associates of the named artist, who is living at the same time or shortly after the named artist, but is not known to be a pupil or direct follower of the named artist (e.g., school of Rembrandt)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "school of"@en .

aat:300404285 a skos:Concept ;
    skos:definition "Qualifier used for a work by an unknown creator whose style is strongly under the influence of the style of the named master (e.g., style of Raphael)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "style of"@en .

aat:300404286 a skos:Concept ;
    skos:definition "Qualifier used for a work by an unknown creator who has created a copy of a known work of the named artist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "after"@en .

aat:300404287 a skos:Concept ;
    skos:definition "Qualifier used for a work by an unknown creator whose style seems to be a deliberate copy of the style of the named artist, but when the work at hand is not a direct copy of a known work by the named artist (e.g., copyist of Rodin)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "copyist of"@en .

aat:300404288 a skos:Concept ;
    skos:definition "Qualifier used for a work by an unknown creator whose style or elements of whose style are somewhat close to the style of the named artist, but whose work does not seem to be a deliberate copy of the named artist, and who generally lived in a period after the named artist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manner of"@en .

aat:300404289 a skos:Concept ;
    skos:definition "The first commercially available acrylic paint. It was prepared from pigments suspended in a solution of n-butyl methacrylate resin and solvent, developed by Leonard Bocour and Sam Golden in the mid-1940s. Magna could be diluted with turpentine or mineral spirits, had a fast drying time. and could be combined with oil paints. It dried to a hard, matte film. Manufacture of this paint ended in the 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Magna"@en .

aat:300404290 a skos:Concept ;
    skos:definition "The state or condition of having as much as one wants or more than is needed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abundance"@en .

aat:300404291 a skos:Concept ;
    skos:definition "Mobile hospitals that treat sick or wounded people. These may be for military personnel in combat zones or for use by health workers in any emergency situation, such as an epidemic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "field hospitals"@en .

aat:300404292 a skos:Concept ;
    skos:definition "Calf-high or knee-high boots or light coverings for the foot and leg, typically made from cloth or leather. May be made of decorated silk or other fine fabric; may fit inside a shoe like a stocking; sometimes forming part of the regalia of a monarch or eccesiastic."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "buskins"@en .

aat:300404293 a skos:Concept ;
    skos:definition "Oval, oil-rich kernels from the tree genus Prunus, having a light brown skin and a hard pitted shell, most varieties of which are edible."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "almonds"@en .

aat:300404294 a skos:Concept ;
    skos:definition "Fruits or pieces of fruits that are preserved by being impregnated with sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candied fruit"@en .

aat:300404295 a skos:Concept ;
    skos:definition "Sweet comprising an almond with a hard coating of sugar or icing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sugared almonds"@en .

aat:300404297 a skos:Concept ;
    skos:definition "Veils worn by brides in wedding ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "wedding veils"@en .

aat:300404298 a skos:Concept ;
    skos:definition "Veils resembling wedding veils that are worn by young females during the Christian first communion or solemn communion ceremonies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "communion veils"@en .

aat:300404300 a skos:Concept ;
    skos:definition "To put to death by nailing or otherwise fastening to a cross; an ancient mode of capital punishment among Asians, Greeks, Romans, and other peoples. In Greek and Roman culture, was considered an especially ignominious means of execution."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crucifixions"@en .

aat:300404301 a skos:Concept ;
    skos:definition "Evening meals, typically light or informal meals. For more formal and substantial evening meals, use \"dinners.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "suppers"@en .

aat:300404302 a skos:Concept ;
    skos:definition "Feast in the calendar of several Christian denominations, observed on August 6. It celebrates an episode in the New Testament in which Jesus is metamorphosed into a radiant in glory upon a mountain."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feast of the Transfiguration"@en .

aat:300404304 a skos:Concept ;
    skos:definition "People who commit adultery, which is the voluntary participation in sexual intercourse when at least one of the parties is married."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "adulterers"@en .

aat:300404305 a skos:Concept ;
    skos:definition "The action of pardoning an act, a fault, or other personal or public activity that has caused pain or offence; the remission of a debt."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "forgiveness"@en .

aat:300404306 a skos:Concept ;
    skos:definition "Feast in the Christian calendar, typically observed on January 1. It celebrates an episode in the New Testament in which Jesus is circumcised according to Jewish tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feast of the Circumcision"@en .

aat:300404307 a skos:Concept ;
    skos:definition "The activity of leaving or escaping an area or situation with stealth or speed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flight"@en .

aat:300404308 a skos:Concept ;
    skos:definition "Christian feast day celebrated on August 15 in the western tradition. The feast honors the corporeal taking up into heaven of the Virgin Mary at her death."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assumption"@en .

aat:300404309 a skos:Concept ;
    skos:definition "Works, especially written or oral works, of unknown or disputed authorship, considered not authentic, spurious, or uncanonical."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "apocrypha"@en .

aat:300404310 a skos:Concept ;
    skos:definition "Christian holiday celebrated on December 8, honoring the status of the Blessed Virgin Mary, who was held to have been born without original sin on her soul."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feast of the Immaculate Conception"@en .

aat:300404311 a skos:Concept ;
    skos:definition "Doctrinal concept in several mythologies and religion, by which a hero or deity was miraculously conceived by a woman still a virgin. An example is in Christianity, where Christ is believed to have been born of the Virgin Mary. For a natural form of asexual reproduction in in plants and animals, see \"parthenogenesis.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "virgin birth"@en .

aat:300404312 a skos:Concept ;
    skos:definition "Events and activities having to do with the natural processes of living organisms."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "biological events"@en .

aat:300404313 a skos:Concept ;
    skos:definition "The production by living organisms of new individuals or offspring by a process or mechanism that is either sexual or asexual in nature."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "reproduction"@en .

aat:300404314 a skos:Concept ;
    skos:definition "In modern usage, reproduction from a gamete without fertilization, occurring most commonly in invertebrates and lower plants, but also occasionally in some vertebrates, such as birds and reptiles, that normally would require sexual reproduction. The term was formerly also used for asexual reproduction, as by fission or budding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parthenogenesis"@en .

aat:300404315 a skos:Concept ;
    skos:definition "The chief priests of a religion or religious group. An example is the chief priest of the ancient Jewish temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "high priests"@en .

aat:300404316 a skos:Concept ;
    skos:definition "Christian holiday celebrated on celebrated on May 31 (earlier on July 2), recognizing the pregnant Blessed Virgin Mary visiting her cousin, Elizabeth, who was pregnant with John the Baptist."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Feast of the Visitation"@en .

aat:300404317 a skos:Concept ;
    skos:definition "The quality of being humble or having a lowly opinion of oneself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "humility"@en .

aat:300404318 a skos:Concept ;
    skos:definition "A high or excessively high opinion of one's own worth or importance, which gives rise to a feeling or attitude of superiority over others."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pride"@en .

aat:300404320 a skos:Concept ;
    skos:definition "Treatment of a subject, in speech or writing, in which the various facts, opinions, and issues relating to it are considered, particularly in order to reach a decision or to exchange ideas with someone else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discussions"@en .

aat:300404321 a skos:Concept ;
    skos:definition "Statements of fact, in speech or writing, in support of a proposition and advanced for the purpose of influencing another person."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arguments"@en .

aat:300404322 a skos:Concept ;
    skos:definition "Christian feast day celebrating the 4th-century Nicholas of Myra, a bishop and saint from Roman Asia Minor. In the western church, his feast is celebrated on December 6, coinciding with the first days of the Christmas season, which begins with Advent. In some traditions, gifts are given to children on the eve of the Saint Nicholas' Day."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Nicholas’ Day"@en .

aat:300404323 a skos:Concept ;
    skos:definition "Religious tenet of the rising of the dead, the restoration to life of a dead person. It is a standard eschatological belief in the Abrahamic religions and in a number of other ancient religions; it is at the core of Christianity, in the belief of the physical resurrection of Jesus."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resurrection"@en .

aat:300404324 a skos:Concept ;
    skos:definition "People who are repentant or contrite, often displaying activities that demonstrate this status."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "penitents"@en .

aat:300404325 a skos:Concept ;
    skos:definition "Events involving testing, tempting, or enticing to certain behavior, especially to illegal or evil activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "temptations"@en .

aat:300404326 a skos:Concept ;
    skos:definition "People or other animals who are in a state of sleep or who tend to sleep frequently."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sleepers"@en .

aat:300404327 a skos:Concept ;
    skos:definition "Funerary custom from Spain and Latin America honoring deceased children. The children's bodies are usually decorated with flowers, dressed up in fine clothes; occasionally paper wings are attached to the body to resemble angel wings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "velorios de angelitos"@en .

aat:300404328 a skos:Concept ;
    skos:definition "Punishments, tortures, or executions by means of whipping."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flagellations"@en .

aat:300404329 a skos:Concept ;
    skos:definition "Actions or verbal expressions of scorn, derision, taunting, imitation, or hurtful mimicry."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mocking"@en .

aat:300404330 a skos:Concept ;
    skos:definition "Ritual washing of the feet, derived from hospitality customs of ancient civilizations in which a host would provide water and often a servant to wash the feet of the visitor. Owing to the general use of sandals in Eastern countries, the washing of the feet was almost everywhere recognized from the earliest times as a duty of courtesy. The principle modern example is the ceremony performed by Christian denominations on Maundy Thursday during Lent, following the example of Jesus in Biblical passages."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maundy"@en .

aat:300404331 a skos:Concept ;
    skos:definition "Mythological beings known in Vedic, Zoroastrian, Hindu, and Buddhist sources. Described in Indian texts as powerful superhuman demigods with good or bad qualities; defined by their opposition to the devas or suras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "asuras"@en .

aat:300404332 a skos:Concept ;
    skos:definition "Deities or good spirits in Hinduism and Buddhism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "devas"@en .

aat:300404333 a skos:Concept ;
    skos:definition "Written versions of oral language or music, or written copies made of other written documents, either in longhand or on a machine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transcriptions"@en .

aat:300404334 a skos:Concept ;
    skos:definition "Transcriptions focusing on the pronunciation of the transcribed words or text. Examples include the use of phonetic symbols as an abbreviation for a phonetic description; some of the allophones may be represented by specific symbols, or some of the phonemes may be designated by the symbols for a more restricted set of categories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phonetic transcriptions"@en .

aat:300404335 a skos:Concept ;
    skos:definition "In the Christian church, a day commemorating all the saints of the church, both known and unknown, celebrated on November 1 in the Western churches and on the 1st Sunday after Pentecost in the Eastern churches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "All Saints' Day"@en .

aat:300404336 a skos:Concept ;
    skos:definition "In the Christian church, a festival observed on the 7th Sunday after Easter, in commemoration of events described in Acts 2 when the Holy Spirit is reported to have descended upon the disciples during the Jewish festival of Pentecost (Shavuot)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Pentecost"@en .

aat:300404337 a skos:Concept ;
    skos:definition "The evening before All Saints’ Day, observed on October 31. It initiates the season of All Saints, which lasts three days and concludes with All Souls' Day. In much of Europe and most of North America, the observance of Halloween is largely nonreligious and has taken on the customs of pre-Christian autumnal festivals, such as the festival of Samhain among the Celts of ancient Britain and Ireland."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Halloween"@en .

aat:300404338 a skos:Concept ;
    skos:definition "In the Christian church, a day for commemoration of all the faithful departed, meaning those baptized Christians who are believed to be in purgatory because they have died with the guilt of only lesser sins on their souls. It is celebrated on November 2. In the early days of Christianity the names of the departed brethren were entered in the diptychs. Later, in the sixth century, it was customary in Benedictine monasteries to hold a commemoration of the deceased members at Whitsuntide. The intention was honored in various ways over the centuries; in 1888 Pope Leo XIII ordered a special Requiem in the Roman Catholic Church; it is celebrated on different days in different Christian sects. Anglicans, Lutherans, and others view All Souls' Day as an extension of the observance of All Saints' Day. In many cultures, the remembrance takes on traditions of pre-Christian ancestor worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "All Souls' Day"@en .

aat:300404339 a skos:Concept ;
    skos:definition "Acts of torture or executions of a person, sometimes of an animal, by stripping or pulling off the skin or hide while the victime is alive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flayings"@en .

aat:300404340 a skos:Concept ;
    skos:definition "Angels conceived as watching over or protecting a particular person, group, or place, common in many belief systems, including the Abrahamic religions. Belief in guardian angels can be traced throughout antiquity, for example in the culture of the Babylonians, Syrians, and Greeks. The concept of tutelary angels and their hierarchy was extensively developed in Christianity in the 5th century by Pseudo-Dionysius the Areopagite."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "guardian angels"@en .

aat:300404341 a skos:Concept ;
    skos:definition "Artists in any medium whose primary subjects concern the armed forces, including uniforms, equipment, and other topics. Such artists may or may not themselves be members of the military. For artists specializing primarily in battles and war, use \"battle artist.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "military artists"@en .

aat:300404342 a skos:Concept ;
    skos:definition "Genre of literature in which the author writes as if the subject was been experienced in dreams, visions, or in ecstasy; often religious or otherwise having a strong moral message. For more whimsical works, use \"fantasies.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "visionary literature"@en .

aat:300404343 a skos:Concept ;
    skos:definition "Devices in the form of a wheel, sometimes spiked, used for torture or execution by breaking the victim's bones or tearing flesh; in use from antiquity into early modern times."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "breaking wheels"@en .

aat:300404345 a skos:Concept ;
    skos:definition "Knives of various forms and materials, designed and used in the skinning of an animal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "skinning knives"@en .

aat:300404346 a skos:Concept ;
    skos:definition "Acts or procedures of putting a person or animal to death by fire or extreme heat, whether as a judicial punishment, sacrifice, or torture. Examples include burning at the stake."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "burning alive"@en .

aat:300404347 a skos:Concept ;
    skos:definition "Acts of bringing of a person from lack of belief or another belief over to a specified religious faith, profession, or party."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conversions"@en .

aat:300404348 a skos:Concept ;
    skos:definition "The process or state of restoration of a person or animal to a healthy or normal condition, or to consciousness, as from the cure or healing of an illness or wound."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "recovery"@en .

aat:300404349 a skos:Concept ;
    skos:definition "Actions causing death or torture by shooting the victim with arrows, as from a bow and arrow."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "executions by arrows"@en .

aat:300404350 a skos:Concept ;
    skos:definition "Acts of pelting with stones as a form of capital punishment or torture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stonings"@en .

aat:300404354 a skos:Concept ;
    skos:definition "Members of the third order of lay members of a Roman Catholic religious order, who are not subject to the strict rule of the regulars, but retain a secular life. The concept was originated by Francis of Assisi and is an established institution among the Franciscans, Dominicans, and other orders."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tertiaries"@en .

aat:300404355 a skos:Concept ;
    skos:definition "Proprietary name for an analog videocassette format developed by Sony in 1969, using 3/4\" tape with a running speed of 3.75 inches per second. The format was popular in semi-professional industrial, educational and broadcast contexts from the 1970s until the advent of digital video technology."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "U-matic (TM)"@en .

aat:300404356 a skos:Concept ;
    skos:definition "Christian sect centered along the Malabar Coast of southwestern India, said to have origins in the Christianization efforts of the apostle St. Thomas. The origins of the sect are uncertain, though they seem to have been in existence before the 6th century and probably derive from the missionary activity of the East Syrian (Nestorian) Church, which held that the two natures of Christ were two persons joined in a moral union. In geographic isolation from Syria, the sect has nonetheless retained the Chaldean liturgy, Syriac language, and fraternal ties with the Babylonian (Baghdad) patriarchate; their devotional practices also include Hindu religious symbolism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Saint Thomas Christian"@en .

aat:300404357 a skos:Concept ;
    skos:definition "Computer storage devices involving no moving parts in which data is stored in non-volatile memory. Information can be written and retrieved to flash drives more quickly than electromechanical hard drives."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash drives"@en .

aat:300404358 a skos:Concept ;
    skos:definition "Computer facility linked to the processor that holds data or program instructions until they are required."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "memory"@en .

aat:300404359 a skos:Concept ;
    skos:definition "Portable, removable computer drives that operate via a type of non-volatile flash memory in which data can be written or erased only in blocks, and that connect to a computer via USB port."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "USB flash drives"@en .

aat:300404360 a skos:Concept ;
    skos:definition "Culture and ethnicity of nomadic, warlike, Asiatic pastoralist people, the Huns, who invaded southeastern Europe ca. 370 CE; through the mid-5th century, they built up an enormous empire reaching into central Europe. Appearing from beyond the Volga River some years after the middle of the 4th century, it is not known whether the Huns were a single people or a confederation of diverse ethnic groups."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hun"@en .

aat:300404361 a skos:Concept ;
    skos:definition "Textile having the characteristic that it can be stretched without permanent alteration of size or shape. Examples include yardage or strips of textile material comprising threads or thin strips of rubber or other another elastic substance covered by a woven material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "elastic"@en .

aat:300404362 a skos:Concept ;
    skos:definition "Niches having a shelf or flat surface, found in churches and used for the placement of vessels used in the Eucharist prior to use and immediately afterwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credence niches"@en .

aat:300404363 a skos:Concept ;
    skos:definition "Shelves found in churches and used for the placement of vessels used in the Eucharist prior to use and immediately afterwards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credence shelves"@en .

aat:300404364 a skos:Concept ;
    skos:definition "A type of non-volatile memory storage that does not require moving parts such as spinning magnetic or optical platters, and that stores data in blocks rather than bytes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flash memory"@en .

aat:300404365 a skos:Concept ;
    skos:definition "Small tables on which vessels and dishes are placed pior to serving in a dining room. They differ from \"credenzas (sideboards)\" in that they are smaller and their form is of a table rather than case furniture. They may be designed so that they back flush against the table or a wall. The term originates in the custom at courts for food to be tasted and proven trustworthy before being served to the monarch. For similar tables used in churches near the altar, prefer \"credence tables (religious building fixtures).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "credences"@en .

aat:300404369 a skos:Concept ;
    skos:definition "Students in a theological seminary, usually in training to become Roman Catholic priests."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seminarians"@en .

aat:300404370 a skos:Concept ;
    skos:definition "Torches used in a ceremonial context, common in many cultures globally. An example is the torch carried prior to the start of the Olympic games."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ceremonial torches"@en .

aat:300404371 a skos:Concept ;
    skos:definition "Structures, usually in cemeteries, designed to temporarily store the bodies of the deceased prior to interment in a permanent grave or tomb. They may include chambers dug into hillsides or free standing structures. Examples are receiving vaults used during winter months in climates where the ground may be frozen. For rooms or structures used for the hygienic temporary storage of corpses, not designed for visitation by mourners, prefer \"morgues.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "receiving vaults"@en .

aat:300404372 a skos:Concept ;
    skos:definition "Structures that are largely open and designed to provide shade, typically comprising four posts with a roof; may be roughly roofed with brush or branches or may have tent-like canvas or roofing of another material. The structure may be temporary or more permanent. For similar small, decorative structures in gardens, prefer \"gazebos\" or \"pergolas.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramadas"@en .

aat:300404374 a skos:Concept ;
    skos:definition "Certificates attesting that a thing or things are of the location of origin, provenance, creator, date, or materials which are claimed; signatures of officials or official seals are often included on the certificate to verify the claim. Examples include certificates of authenticity for art works, artifacts, memorabilia, collectibles, and software."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "certificates of authenticity"@en .

aat:300404375 a skos:Concept ;
    skos:definition "Hurried or negligent and irregular writings, or irregular and unmeaning marks. For casual drawings, use \"doodles.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "scribbles"@en .

aat:300404376 a skos:Concept ;
    skos:definition "Written messages that are transmitted electronically, typically restricted to short, keyed messages sent from one mobile phone to another or via the Internet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "text messages"@en .

aat:300404377 a skos:Concept ;
    skos:definition "Recorders having the lowest note of middle C."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenor recorders"@en .

aat:300404378 a skos:Concept ;
    skos:definition "Recorders that are between the soprano and tenor in size, and correspondingly intermediate in pitch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alto recorders"@en .

aat:300404379 a skos:Concept ;
    skos:definition "Recorders that play an octave lower than the alto recorder, standing between the tenor recorder and C great-bass (or quart-bass) recorder."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bass recorders"@en .

aat:300404380 a skos:Concept ;
    skos:definition "Tiny sweetmeats made of breath-freshening seeds such as caraway, coriander, or anis, or fruit or root, coated and preserved with sugar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "comfits"@en .

aat:300404381 a skos:Concept ;
    skos:definition "The process and technique of cutting architectural works or large sculptures out of living rock rather than assembling the works from processed blocks of stone or other materials."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rock-cut"@en .

aat:300404382 a skos:Concept ;
    skos:definition "Process or technique of constructing architecture or other works using earth, either by digging into the earth or by creating building materials from earth. If the earth has been fired, such as with bricks, prefer \"masonry construction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "earth construction"@en .

aat:300404383 a skos:Concept ;
    skos:definition "Processes or techniques for construction of buildings or engineering works, using primarily individual units of masonry laid in and bound together by mortar Typical materials for masonry construction include stone (including marble, granite, travertine, limestone, etc), brick, cast stone, concrete block, glass block, and cob. For construction techniques using unfired earth, use \"earth construction.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masonry construction"@en .

aat:300404384 a skos:Concept ;
    skos:definition "Units for masonry construction made primarily of concrete; the most common types are concrete bricks and concrete blocks."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "concrete masonry units"@en .

aat:300404385 a skos:Concept ;
    skos:definition "Process or technique of covering a dried painted surface with a thin coat of a different transparent color, usually in order to modify the tone without mixing. To cover with a transparent varnish for protection, use \"varnishing.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glazing"@en .

aat:300404386 a skos:Concept ;
    skos:definition "Events or activities of finding out or becoming aware of something that had been lost, forgotten, or previously unknown. Includes the finding of archaeological objects, lost buildings, places; also includes the action of bringing to light substances, scientific phenoma, and other things that were previously unknown."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "discoveries"@en .

aat:300404387 a skos:Concept ;
    skos:definition "The activities surrounding the production or conception of a work, particularly a work of visual art, literary art, or performing arts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "creating"@en .

aat:300404388 a skos:Concept ;
    skos:definition "Boxes or other containers that hold the relics inside larger reliquaries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lipsanothecas"@en .

aat:300404389 a skos:Concept ;
    skos:definition "Inclusive of all, both physical and conceptual; indication of the inclusion of everything between the extreme points, measured from end to end, or including the whole range of components, features, or aspects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "overall"@en .

aat:300404390 a skos:Concept ;
    skos:definition "In intaglio printmaking, impressions left on the sheet of paper or other support; a platemark marks the edges of the plate and is caused by the pressure applied in the process of printing. Although prints are sometimes trimmed within the platemark, prints having supports with the platemark intact are considered more valuable."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platemarks"@en .

aat:300404391 a skos:Concept ;
    skos:definition "Framing for two-dimensional visual works; picture frames may or many not use glass to protect the work, depending upon the type of work framed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "picture frames"@en .

aat:300404392 a skos:Concept ;
    skos:definition "Areas of visual works having pattern, image, or other elements of primary interest, as distinguished from neutral areas or background."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "designs"@en .

aat:300404393 a skos:Concept ;
    skos:definition "In printing, a printer's unit, which is the full size of a piece paper when printed. The press sheet will be folded to form consecutive pages of a publication, or cut to form smaller units, for example with printing of postage stamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "press sheets"@en .

aat:300404394 a skos:Concept ;
    skos:definition "The standard system of weight in ounces used for precious metals and precious stones; one troy ounce is defined as exactly 31.1034768 g."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "troy ounces"@en .

aat:300404395 a skos:Concept ;
    skos:definition "Units of volume, in which one cubic centimeter corresponds to the volume of a cube that measures 1 cm × 1 cm × 1 cm."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cubic centimeters"@en .

aat:300404396 a skos:Concept ;
    skos:definition "Unit of surface measurements in the French metric system comprising a square of which the side measures ten meters, equal to 119·6 sq. yards."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ares"@en .

aat:300404397 a skos:Concept ;
    skos:definition "Units equal to one foot in a straight line; used to measure the amount of shelf space occupied by archival materials within a specific collection, as well as piping, wiring, and other things that are linear in orientation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear feet"@en .

aat:300404398 a skos:Concept ;
    skos:definition "Units equal to one meter in a straight line; used to measure the amount of shelf space occupied by archival materials within a specific collection, as well as piping, wiring, and other things that are linear in orientation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "linear meters"@en .

aat:300404399 a skos:Concept ;
    skos:definition "Imperial and U.S. customary units of area, defined as the area of a square with sides of one foot (12 inches) in length.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square feet"@en .

aat:300404400 a skos:Concept ;
    skos:definition "Imperial and U.S. customary units of area, defined as the area of a square with sides of one foot (12 inches) in length.."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "square yards"@en .

aat:300404403 a skos:Concept ;
    skos:definition "Extent or distance in measured in linear feet; may refer to a part or to the greater whole. Examples of things for which footage is relevant include pipes, electrical wires, and film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "footage"@en .

aat:300404405 a skos:Concept ;
    skos:definition "Works of art or architecture that are depicted in another work of art. Examples would be a painting depicted in a reproductive print or an architectural work depicted in a drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "works depicted"@en .

aat:300404406 a skos:Concept ;
    skos:definition "Initial or beginning specific conceptual schemes for the organization or appearance of a work or creative endeavor. For preliminary designs expressed in drawings, use \"preliminary drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "preliminary designs"@en .

aat:300404408 a skos:Concept ;
    skos:definition "The last specific conceptual schemes in the creative process, defining the organization or appearance of a work or creative endeavor; final designs are typically expressed in the finished work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "final designs"@en .

aat:300404409 a skos:Concept ;
    skos:definition "Schemes or executed designs that are past or earlier than the present or final design; the concept may be used in reference to a wide range of creative products, including art, architecture, decorative arts, engineering, and software design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "previous designs"@en .

aat:300404410 a skos:Concept ;
    skos:definition "Works that are auxiliary or an accessory to the primary work; the concept may apply to a wide variety of disciplines. An example would be a heating system that is ancillary to the primary architectural work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ancillary works"@en .

aat:300404411 a skos:Concept ;
    skos:definition "Works that are the main focus or most important in a complex work or project; used to distinguish primary works from auxiliary or accessory works; the concept may apply to a wide variety of disciplines. In cataloging, the work is typically assumed to be a primary work, requiring clarification only when there is also an ancillary work. An example would be an office building, which is a primary architectural work having as an ancillary work the heating system. The concept may also refer to the status of separate, independent works, which may be grander or more important than other separate, independent \"secondary works.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary works"@en .

aat:300404412 a skos:Concept ;
    skos:definition "Reference to the status of separate, independent works that are less grand or considered less important than other separate, independent \"primary works.\" An example would be in a country estate, the country house may be considered the primary work, and the surrounding cottages may be considered secondary works. For works that are part of or integrally associated with primary works, use \"ancillary works.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary works"@en .

aat:300404413 a skos:Concept ;
    skos:definition "Having dimensions representing the full or largest applicable size; contrasted to \"life-size\" in that \"full-size\" is preferred for models or other representations that are not associated with users or nature (\"life\"), expecially when the representations also exist in scales other than full-size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "full-size"@en .

aat:300404415 a skos:Concept ;
    skos:definition "Book size having height dimension of approximately 50 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "double elephant folio"@en .

aat:300404416 a skos:Concept ;
    skos:definition "Book size having height dimension of approximately 25 inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "atlas folio"@en .

aat:300404417 a skos:Concept ;
    skos:definition "Consumer-level analog videocassette magnetic tape recording format developed by Sony, released in 1975."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Beta"@en .

aat:300404419 a skos:Concept ;
    skos:definition "General name for a number of computer operating systems for personal computers; several unrelated microcomputer disk operating systems had \"DOS\" in their names. An example was MS-DOS, which dominated the IBM PC-compatible market between 1981 and 1995."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "DOS"@en .

aat:300404420 a skos:Concept ;
    skos:definition "A proprietary name for a motion picture format and a set of cinema projection standards for wide-screen cinematography in which 70mm film is shot and projected in such a way as to produce an image approximately ten times larger than that normally obtained from standard 35mm film. It was created by Canadian company IMAX Corporation and developed by Graeme Ferguson, Roman Kroitor, Robert Kerr, and William C. Shaw."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "IMAX (TM)"@en .

aat:300404421 a skos:Concept ;
    skos:definition "Physical formats and file formats used for motion pictures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "motion picture formats"@en .

aat:300404422 a skos:Concept ;
    skos:definition "Layout feature of texts, printed or manuscript, characterized by lines of text written from side to side across a page, in contrast to texts written in vertical \"columns (layout features).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "long-line format"@en .

aat:300404423 a skos:Concept ;
    skos:definition "Printing format, used especially for newspapers, in which pages are half the size of those of the average broadsheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabloid"@en .

aat:300404424 a skos:Concept ;
    skos:definition "Newspapers or magazines containing sensational or popular stories, originally having the tabloid printing format, in which pages are half the size of those of the average broadsheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tabloids"@en .

aat:300404425 a skos:Concept ;
    skos:definition "Measures of capacity for liquids and grain or other dry substances consisting of small particles equal to 1/8 gallon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pints"@en .

aat:300404426 a skos:Concept ;
    skos:definition "Measures of capacity for liquids and grain or other dry substances consisting of small particles equal to 1/4 gallon or 2 pints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "quarts"@en .

aat:300404427 a skos:Concept ;
    skos:definition "Measures of capacity for liquids and grain or other dry substances consisting of small particles, in Britain equal to 277 1/4 cubic inches and in the United States 231 cubic inches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gallons"@en .

aat:300404428 a skos:Concept ;
    skos:definition "Flat, two-dimensional shape that is situated in or forming a plane or parallel planes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "planar"@en .

aat:300404429 a skos:Concept ;
    skos:definition "Right rectangular prism shape; a shape having all angles that are right angles, and opposite faces that are equal."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rectangular cuboid"@en .

aat:300404430 a skos:Concept ;
    skos:definition "The measure of the possible full content of a vessel or other container, if it were filled with liquid, grain, or other substance. For example, the capacity of a bottle could be one liter. For the measure of the mass of an object, use \"volume.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capacity"@en .

aat:300404431 a skos:Concept ;
    skos:definition "The element serving as the reference point in an equation or ratio of size, dimensions, or other contexts. An example is in an equation of numeric scale, the left side of the equation is the base, 3/4 inch = 1 foot. For the right side of the equation, use \"target (relationship indicator).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "base"@en .

aat:300404432 a skos:Concept ;
    skos:definition "The element to which a calculation is directed in an equation or ratio of size, dimensions, or other contexts. An example is in an equation of numeric scale, the right side of the equation is the target, 3/4 inch = 1 foot. For the left side of the equation, use \"base (relationship indicator).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "target"@en .

aat:300404433 a skos:Concept ;
    skos:definition "Measurement indicating the the sum total or the numerical result of reckoning."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "count"@en .

aat:300404434 a skos:Concept ;
    skos:definition "Units of volume, in which one cubic inch corresponds to the volume of a cube that measures 1 inch × 1 inch × 1 inch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cubic inches"@en .

aat:300404435 a skos:Concept ;
    skos:definition "Units of volume, in which one cubic foot corresponds to the volume of a cube that measures 1 foot × 1 foot × 1 foot."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cubic feet"@en .

aat:300404437 a skos:Concept ;
    skos:definition "Measurement indicator referring to the open space or gap lying between two things or two parts of the same thing. An example of usage is with repeating characteristics, such as pattern repeats in textiles or chain lines in paper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "interval"@en .

aat:300404438 a skos:Concept ;
    skos:definition "Actions and processes surrounding designing something again in order to produce a different design; a design is a specific conceptual scheme for the organization or appearance of a work."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "redesign"@en .

aat:300404439 a skos:Concept ;
    skos:definition "Years, or spans of time, periods, seasons, during which something lasts; the duration or term of existence or during which something happened or is to happen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dates"@en .

aat:300404440 a skos:Concept ;
    skos:definition "Date range of years representing the earliest and latest dates for the most important or principal body of items in the group. There may be multiple sets of bulk dates for any group (e.g., 1914-1918 and 1939-1945 (bulk dates))."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bulk dates"@en .

aat:300404441 a skos:Concept ;
    skos:definition "Span of time including years of the earliest and latest dated works in the group (e.g., for a folder of drawings, 1911-1951 (inclusive dates)). ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "inclusive dates"@en .

aat:300404442 a skos:Concept ;
    skos:definition "Date range including earliest and latest dates of items in a group. For example, dates for the subjects contained in the archival materials, used particularly when the subjects do not correspond to the dates when the group or series was created. For example, a series created in the 1970s about the 1941 attack on Pearl Harbor would have a coverage date of 1941 and inclusive dates of 1970-1979 (e.g., 1941 (coverage), 1970-1979 (inclusive dates))."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coverage dates"@en .

aat:300404443 a skos:Concept ;
    skos:definition "General concept for flat, relatively thin sheets or disks of a rigid material such as metal or glass that have a uniform surface and thickness, used to make a work in multiples. Examples are copper or steel plates that are etched or engraved and used in printmaking, and thin sheets of metal or glass used in photography to make positive or negative images."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plates"@en .

aat:300404444 a skos:Concept ;
    skos:definition "General term for items, people, animals, or other things, typically small or moderate in number, that are gathered or arranged together for some purpose; usually refers to physical relationships. For the intellectual classification of people, as contrasted to a physical gathering, use \"groups (organization)\" or \"groups of people.\" For archival groups, use \"groups (archival divisions).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "groupings"@en .

aat:300404445 a skos:Concept ;
    skos:definition "The compilation of an object or group of objects packed, wrapped up, or tied together, generally restricted to relatively small or medium- sized compilations of objects. May refer to physical objects and also to digital objects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packages"@en .

aat:300404446 a skos:Concept ;
    skos:definition "Small compilations of things that are bound or packed together. For the bag or envelope for packing small compilations of things, use \"packets (containers).\" An example of a packet is the stack of gold called a \"mold\" compiled at one stage of the gold beating process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "packets"@en .

aat:300404448 a skos:Concept ;
    skos:definition "Characteristic of belonging equally to more than one, of being possessed or shared alike by all or most of the people or things in question. An example of usage is in indexing groups of works or complex works, for subject or material terms that apply to all items in the group or all aspects of a work that has multiple aspects."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "common"@en .

aat:300404449 a skos:Concept ;
    skos:definition "Refers to a philosophy of the absurd, or knowledge that eludes rational notions of causation or scientific inquiry. Coinage of the term is attributed to the writer Alfred Jarry to describe a \"science of imaginary solutions.\" The concept, though originally speculative or fictional, has inspired publications, artworks, a literary school, and a society known as the Collège de 'pataphysique."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pataphysics"@en .

aat:300404450 a skos:Concept ;
    skos:definition "Designation indicating something, someone, a characteristic, or an activity is the most important or fundamental, is occurring or existing first in a sequence, belonging to the beginning or earliest stage,is the original, or not subordinate to or derived from anything else."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "primary"@en .

aat:300404451 a skos:Concept ;
    skos:definition "Designation indicating something, someone, a characteristic, or an activity belongs to the second class in respect of importance, is not chief or principal, is of minor importance or subordinate, or is occurring or existing second in a sequence."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "secondary"@en .

aat:300404452 a skos:Concept ;
    skos:definition "For positional attributes of three-dimensional works or the illusionistic space of a composition, referring to the viewer's lower right-hand side of the work or composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper right"@en .

aat:300404453 a skos:Concept ;
    skos:definition "For positional attributes of three-dimensional works or the illusionistic space of a composition, referring to the viewer's upper left-hand side of the work or composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upper left"@en .

aat:300404454 a skos:Concept ;
    skos:definition "For positional attributes of three-dimensional works or the illusionistic space of a composition, referring to the viewer's lower left-hand side of the work or composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lower left"@en .

aat:300404455 a skos:Concept ;
    skos:definition "For positional attributes of three-dimensional works or the illusionistic space of a composition, referring to the viewer's lower right-hand side of the work or composition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lower right"@en .

aat:300404456 a skos:Concept ;
    skos:definition "Indication of a named or generic event that is related to a person, place, or thing. An example of usage is in data modeling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "related events"@en .

aat:300404457 a skos:Concept ;
    skos:definition "Indication of the reason for which something is done or made, for which it exists, the result or effect intended or sought, or the aim to which an object is directed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "purpose"@en .

aat:300404458 a skos:Concept ;
    skos:definition "The position from which something, such as the subject depicted in a visual work, is seen or viewed, or the perspective from which a subject or event is perceived. An example is when the subject of a visual work is seen as a bird's eye view."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "point of view"@en .

aat:300404459 a skos:Concept ;
    skos:definition "The way, model, or view in which something is represented. An example is when an architectural work is represented in an elevation or in a floorplan."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "method of representation"@en .

aat:300404460 a skos:Concept ;
    skos:definition "The status or characteristic of a structure or other thing having been devoted to a saint, deity, patron, or other person or cause, or otherwise officially and ceremonially set apart."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dedication"@en .

aat:300404461 a skos:Concept ;
    skos:definition "Surfaces of an object that is divided into parts, usually two parts. Examples are the front side and back side of thin, flat object, as a board, panel, disc, slice, coin, or sheet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sides"@en .

aat:300404462 a skos:Concept ;
    skos:definition "In reference to visual works, the main or front surface of the work. For the back or secondary surface, use \"side B.\" Examples include extend indications for ancient Greek vessels and other such works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side A"@en .

aat:300404463 a skos:Concept ;
    skos:definition "In reference to visual works, the the secondary or back surface of the work. For the front or main surface, use \"side A.\" Examples include extend indications for ancient Greek vessels and other such works."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "side B"@en .

aat:300404465 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1400 to 1499 (or 1401 to 1500)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifteenth century"@en .

aat:300404466 a skos:Concept ;
    skos:definition "The internationally most widely used civil calendar, named for Pope Gregory XIII, who introduced it in October 1582. It is typically used as a proleptic calendar, which means the dates are extended backward to dates preceding its official introduction in 1582. The Gregorian calendar was a refinement to the Julian calendar, correcting the length of the year by 0.002% through alteration of leap years."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gregorian calendar"@en .

aat:300404468 a skos:Concept ;
    skos:definition "Calendar introduced by Julius Caesar in 46 BCE (708 AUC) as a reform of the Roman calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Julian calendar"@en .

aat:300404469 a skos:Concept ;
    skos:definition "General term for the calendar of ancient Rome, that in fact changed in scheme several times between the founding of Rome and the fall of the Roman Empire."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Roman calendar"@en .

aat:300404470 a skos:Concept ;
    skos:definition "Roman calendars, including works on parchment and also works inscribed in stone and displayed for the public; fasti indicated dates of festivals, games, days allowed for legal business, anniversaries of historical events, and other notable dates."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fasti"@en .

aat:300404471 a skos:Concept ;
    skos:definition "General term for the set of lunisolar calendars used primarily in mainland southeast Asia; based on an older version of the Hindu calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Buddhist calendar"@en .

aat:300404472 a skos:Concept ;
    skos:definition "General term for any of several luni-sidereal calendars traditionally used in Hinduism."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Hindu calendar"@en .

aat:300404473 a skos:Concept ;
    skos:definition "The lunisolar calendar traditional for China and oversees Chinese communities; it reckons years, months, and days according to astronomical phenomena; it lists the dates of traditional Chinese holidays and guides for selecting lucky days for personal activities, such as travel, weddings, funerals, or beginning a business."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Chinese calendar"@en .

aat:300404474 a skos:Concept ;
    skos:definition "The lunisolar calendar used today predominantly for Jewish religious observances, including dates for Jewish holidays and dates for reading from the Torah and other texts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Jewish calendar"@en .

aat:300404475 a skos:Concept ;
    skos:definition "Lunisolar calendar of Assyria and Babylon, having years consisting of 12 lunar months, each beginning a new crescent moon on the western horizon at sunset. It was based on a Sumerian calendar, dated at least to ca. 21st century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Assyro-Babylonian calendar"@en .

aat:300404476 a skos:Concept ;
    skos:definition "Pre-Columbian Andean-Amazonic calendar, for which the new year is still celebrated in Bolivia and other countries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aymara calendar"@en .

aat:300404477 a skos:Concept ;
    skos:definition "Calendar system used by the Aztecs and other Pre-Columbian peoples of central Mexico."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Aztec calendar"@en .

aat:300404478 a skos:Concept ;
    skos:definition "Solar calendar of the Baha'i faith, having years composed of 19 months of 19 days each."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bahai calendar"@en .

aat:300404479 a skos:Concept ;
    skos:definition "General term for calendars used in pre-Columbian Mesoamerica, many modern communities in the Guatemalan highlands, and states of Veracruz, Oaxaca and Chiapas, Mexico. The essentials of the Maya calendar are based upon a system which had been in common use throughout the region, dating back to at least the 5th century BCE."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Maya calendar"@en .

aat:300404480 a skos:Concept ;
    skos:definition "Calendar of the Inca, comprising 12 months of 30 days, with each month having a festival."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Inca calendar"@en .

aat:300404481 a skos:Concept ;
    skos:definition "Ancient Egyptian calendar having a year of 365 days and 12 months of 30 days each, plus five extra days at the end of the year. The months were divided into three decans of ten days each. The Egyptians may have used an earlier luni-solar calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Egyptian calendar"@en .

aat:300404482 a skos:Concept ;
    skos:definition "Gaulish Coligny calendar used by Celtic countries to define the beginning and length of the day, the week, the month, the seasons, quarter days, and festivals."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Celtic calendar"@en .

aat:300404483 a skos:Concept ;
    skos:definition "Calendar enumerating the seasonal round of ceremonies practiced by the Cherokee people, comprising 12 months and 13 cycles or phases of the moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Cherokee calendar"@en .

aat:300404484 a skos:Concept ;
    skos:definition "General term for a number of calendars used in ancient Greece, dividing the year into the 12 lunar months, in many examples having the intercalary month Embolimos. Independent of the division of a month into days, the month was divided into periods according to the waxing and waning of the moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Greek calendar"@en .

aat:300404485 a skos:Concept ;
    skos:definition "Dating system used in much of the Islamic world, based on a year of 12 months, each month beginning approximately at the time of the new moon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Islamic calendar"@en .

aat:300404486 a skos:Concept ;
    skos:definition "Dating system based on a cycle of 60 Tibetan years, each of which usually has 354 days (12 cycles of the phases of the Moon). Adjustment to the solar year of about 365 days is made by intercalation of an extra month every three years. It is based on the Chinese calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Tibetan calendar"@en .

aat:300404487 a skos:Concept ;
    skos:definition "Short-lived dating system that was adopted in 1793 during the French Revolution and which was intended to replace the Gregorian calendar with a more scientific and rational system that would avoid Christian associations."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "French republican calendar"@en .

aat:300404488 a skos:Concept ;
    skos:definition "Reckoning of days, months and years in the calendar used by adherents of the Zoroastrian faith."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Zoroastrian calendar"@en .

aat:300404489 a skos:Concept ;
    skos:definition "Calendar from the holy city of Nippur of the Ur III period, which was adopted by Babylon as their civil calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nippur calendar"@en .

aat:300404490 a skos:Concept ;
    skos:definition "Calendar used by the Coptic Orthodox Church and Egypt; based on the ancient Egyptian calendar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Coptic calendar"@en .

aat:300404491 a skos:Concept ;
    skos:definition "Principal calendar used in Ethiopia, also serving as the liturgical calendar for Christians in Eritrea and Ethiopia."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ethiopian calendar"@en .

aat:300404492 a skos:Concept ;
    skos:definition "Varioius dating systems used regionally by early Germanic peoples; names for the months varied by region and dialect."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Germanic calendar"@en .

aat:300404493 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1 to 99 (or 1 to 100)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first century"@en .

aat:300404494 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 100 to 199 (or 101 to 200)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second century"@en .

aat:300404495 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 200 to 299 (or 201 to 300)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "third century"@en .

aat:300404496 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 300 to 399 (or 301 to 400)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourth century"@en .

aat:300404497 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 400 to 499 (or 401 to 500)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifth century"@en .

aat:300404498 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 500 to 599 (or 501 to 600)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixth century"@en .

aat:300404499 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 600 to 699 (or 601 to 700)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seventh century"@en .

aat:300404500 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 700 to 799 (or 701 to 800)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighth century"@en .

aat:300404501 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 800 to 899 (or 801 to 900)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ninth century"@en .

aat:300404502 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 900 to 999 (or 901 to 1000)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenth century"@en .

aat:300404503 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1000 to 1099 (or 1001 to 1100)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eleventh century"@en .

aat:300404504 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1100 to 1199 (or 1101 to 1200)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twelfth century"@en .

aat:300404505 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1200 to 1299 (or 1201 to 1300)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thirteenth century"@en .

aat:300404506 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1300 to 1399 (or 1301 to 1400)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourteenth century"@en .

aat:300404507 a skos:Concept ;
    skos:definition "Dates or dating offering a choice or another possibility to the primary or originally assigned date."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "alternative dates"@en .

aat:300404508 a skos:Concept ;
    skos:definition "The process or activity of surrendering ownership or physically leaving a building or location."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "abandonment"@en .

aat:300404509 a skos:Concept ;
    skos:definition "Condition or characteristic in which an official body has conferred a special status, usually a legally binding status, upon for a site, structure, environment, species, culture, or other thing or entity in an attempt to secure its continuation or and protect its well-being."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "protected status"@en .

aat:300404510 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1500 to 1599 (or 1501 to 1600)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixteenth century"@en .

aat:300404511 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1600 to 1699 (or 1601 to 1700)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seventeenth century"@en .

aat:300404512 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1700 to 1799 (or 1701 to 1800)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighteenth century"@en .

aat:300404513 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1800 to 1899 (or 1801 to 1900)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nineteenth century"@en .

aat:300404514 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1900 to 1999 (or 1901 to 2000)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twentieth century"@en .

aat:300404515 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2000 to 2099 (or 2001 to 2100)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-first century"@en .

aat:300404516 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2200 to 2299 (or 2201 to 2300)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-third century"@en .

aat:300404517 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2100 to 2199 (or 2101 to 2200)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-second century"@en .

aat:300404518 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 99 to 1 (or 100 to 1) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "first century BCE"@en .

aat:300404519 a skos:Concept ;
    skos:definition "The action or process of conserving for the preservation of existence, state, life, health, safeguarding from destructive influences, natural decay, or waste. May apply to conserving a building, object, environment, species, or other thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "conservation"@en .

aat:300404520 a skos:Concept ;
    skos:definition "The process or activity of hurting, injuring, or otherwise causing damage, often in a way results in the lessening or loss of value of a thing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "damage"@en .

aat:300404521 a skos:Concept ;
    skos:definition "Informal and isolated displays of works of art, motion pictures, or other items; may include displays of works in a gallery. For more formal, organized, usually named, temporary public displays of works, prefer \"exhibitions (events).\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "showings"@en .

aat:300404522 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 199 to 100 (or 200 to 101) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "second century BCE"@en .

aat:300404523 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 299 to 200 (or 300 to 201) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "third century BCE"@en .

aat:300404524 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 399 to 300 (or 400 to 301) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourth century BCE"@en .

aat:300404525 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 499 to 400 (or 500 to 401) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifth century BCE"@en .

aat:300404526 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 599 to 500 (or 600 to 501) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixth century BCE"@en .

aat:300404527 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 699 to 600 (or 700 to 601) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seventh century BCE"@en .

aat:300404528 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 799 to 700 (or 800 to 701) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighth century BCE"@en .

aat:300404529 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 899 to 800 (or 900 to 801) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ninth century BCE"@en .

aat:300404530 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 999 to 900 (or 1000 to 901) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tenth century BCE"@en .

aat:300404531 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1099 to 1000 (or 1100 to 1001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eleventh century BCE"@en .

aat:300404532 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1199 to 1100 (or 1200 to 1101) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twelfth century BCE"@en .

aat:300404533 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1299 to 1200 (or 1300 to 1201) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "thirteenth century BCE"@en .

aat:300404534 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1399 to 1300 (or 1400 to 1301) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fourteenth century BCE"@en .

aat:300404535 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1499 to 1400 (or 1500 to 1401) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "fifteenth century BCE"@en .

aat:300404536 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1599 to 1500 (or 1600 to 1501) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sixteenth century BCE"@en .

aat:300404537 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1699 to 1600 (or 1700 to 1601) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "seventeenth century BCE"@en .

aat:300404538 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1799 to 1700 (or 1800 to 1701) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eighteenth century BCE"@en .

aat:300404539 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1899 to 1800 (or 1900 to 1801) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nineteenth century BCE"@en .

aat:300404540 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 1999 to 1900 (or 2000 to 1901) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twentieth century BCE"@en .

aat:300404541 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2099 to 2000 (or 2100 to 2001) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-first century BCE"@en .

aat:300404542 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2199 to 2100 (or 2200 to 2101) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-second century BCE"@en .

aat:300404543 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2299 to 2200 (or 2300 to 2201) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-third century BCE"@en .

aat:300404544 a skos:Concept ;
    skos:definition "Century in the proleptic Gregorian calendar including the years 2399 to 2300 (or 2400 to 2301) Before Common Era."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "twenty-fourth century BCE"@en .

aat:300404545 a skos:Concept ;
