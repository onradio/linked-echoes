        "kam"@sv .

euf:10851 a skos:Concept ;
    skos:altLabel "Vorhang"@de ;
    skos:definition "Hangings for windows, doorways, or other openings, usually of cloth, plastic, or another such material, that are generally finished with hems, casings, pleats, or ruffles and hung by the top edge; used for privacy, control of light and drafts, or decoration. (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gardine"@de,
        "κουρτίνα"@el,
        "curtain"@en,
        "rideau"@fr,
