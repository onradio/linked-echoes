lev: a void:Dataset,
        dcat:Dataset ;
    dct:created "2026-11-16"^^xsd:date ;
    dct:description "Terms of Getty AAT, MIMO, Europeana Fashion and PBCore, harmonised into a single dataset for the retrieval-augmented type classification of the Linked Echoes workflow. Concepts keep the URIs of their source vocabularies; labels in other languages and alternative labels are included where the source provides them."@en ;
    dct:hasPart lev:aat,
        lev:europeana-fashion,
        lev:mimo,
        lev:pbcore ;
    dct:hasVersion "1.0" ;
    dct:rights "The concepts, labels and definitions remain subject to the terms of their source vocabularies (Getty AAT, MIMO, PBCore, Europeana Fashion), which should be credited when the data are reused."@en ;
    dct:title "Linked Echoes harmonised controlled vocabularies"@en ;
    void:entities 50298 ;
    void:triples 237810 ;
    void:vocabulary skos: ;
    rdfs:seeAlso <https://github.com/onradio/linked-echoes> ;
    prov:wasDerivedFrom <https://github.com/onradio/linked-echoes/blob/main/lechoes/src/vocabularies/all_concepts.csv> .

