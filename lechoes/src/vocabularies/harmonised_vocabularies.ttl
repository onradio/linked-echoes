mimo:6074 a skos:Concept ;
    skos:altLabel "Plectrum"@de ;
    skos:definition "A plectrum is a small flat tool used for plucking or strumming of a stringed instrument. For hand-held instruments such as guitars and mandolins, the plectrum is often called a pick and is held as a separate tool in the player's hand. In harpsichords, the plectra are attached to the jack mechanism."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Plectre"@ca,
        "Plektrum"@de,
        "Plectrum"@en,
        "Plectro"@es,
        "Plectre"@fr,
        "Plettro"@it,
