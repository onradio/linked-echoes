mimo:3633 a skos:Concept ;
    skos:altLabel "Bandoura"@zh,
        "Bango"@zh,
        "Cimbalum"@zh,
        "Cymbalum"@zh ;
    skos:definition "The cimbalom (/ˈsɪmbələm, -ˌlɒm/; Hungarian: [ˈt͡simbɒlom]) or concert cimbalom is a type of chordophone composed of a large, trapezoidal box on legs with metal strings stretched across its top and a damping pedal underneath. It was designed and created by V. Josef Schunda in 1874 in Budapest, based on his modifications to the existing Hammered dulcimer instruments which were already present in Central and Eastern Europe. Today the instrument is mainly played in Hungary, Slovakia, Moravia, Romania, Moldova, and Ukraine."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Cimbalom"@ca,
