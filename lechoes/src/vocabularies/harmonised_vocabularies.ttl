    skos:prefLabel "pradakṣiṇā"@en .

aat:300446385 a skos:Concept ;
    skos:definition "In Indian architecture, a circumambulatory path."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cuttunāḍī"@en .

aat:300446386 a skos:Concept ;
    skos:definition "In Indian architecture, a circumambulatory path; ambulatory; ambulatory passageway."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pradakṣiṇāpatha"@en .

aat:300446387 a skos:Concept ;
    skos:definition "In Indian architecture, city gateways with tall upper storeys."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gōpuraṭṭālakas"@en .

aat:300446388 a skos:Concept ;
