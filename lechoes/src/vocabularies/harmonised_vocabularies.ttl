mimo:2387 a skos:Concept ;
    skos:altLabel "Ekong"@zh,
        "Glockenspiel"@zh ;
    skos:definition "A carillon (US: /ˈkɛrəlɒn/ KERR-ə-lon, UK: /kəˈrɪljən/ kə-RIL-yən) is a pitched percussion instrument that is played with a keyboard and consists of at least 23 cast-bronze bells. The bells are hung in fixed suspension and tuned in chromatic order so that they can be sounded harmoniously together. They are struck with clappers connected to a keyboard of wooden batons played with the hands and pedals played with the feet. Often housed in bell towers, carillons are usually owned by churches, universities, or municipalities. They can include an automatic system through which the time is announced and simple tunes are played throughout the day."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Carilló"@ca,
        "Turmglockenspiel"@de,
        "Carillon"@en,
        "Carillón"@es,
        "Carillon"@fr,
        "Carillon di campane"@it,
        "Beiaard"@nl,
        "Carillon"@pl,
        "Klockspel"@sv,
        "钟琴"@zh .

