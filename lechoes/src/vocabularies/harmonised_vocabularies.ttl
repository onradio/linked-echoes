pbcore:16mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 16mm in width."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "16mm film"@en .

pbcore:1InchAudioTape a skos:Concept ;
    skos:definition "An open reel analog audiotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "1 inch audio tape"@en .

pbcore:1InchVideotape a skos:Concept ;
    skos:definition "An open reel analog videotape format. If desired, format information can be included after a colon, for example: “1 inch videotape: MVC-10.” Types of 1 inch videotape include MVC-10, PI-3V, EV-200, EL-3400, IVC-700, IVC-800, IVC-900, UV-340, EV-210, BVH-1000, HDV-1000, HDD-1000, SMPTE Type A, SMPTE Type B, and SMPTE Type C."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "1 inch videotape"@en .

pbcore:22mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 22mm in width."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "22mm film"@en .

pbcore:28mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 28mm in width."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "28mm film"@en .

pbcore:2InchAudioTape a skos:Concept ;
    skos:definition "An open reel analog audiotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "2 inch audio tape"@en .

pbcore:2InchVideotape a skos:Concept ;
    skos:definition "An open reel analog videotape format. If desired, format information can be included after a colon, for example: “2 inch videotape: Quadruplex.” Types of 2 inch videotape include: Quadruplex, Octaplex, VR-1500, VR-1600, IVC-9000, Helical SV-201, and ACR 25."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "2 inch videotape"@en .

pbcore:35mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 35mm in width. Some 35mm films may be printed on paper."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "35mm film"@en .

pbcore:70mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 70mm in width."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "70mm film"@en .

pbcore:8Track a skos:Concept ;
    skos:definition "A cartridge-based 1/4-inch analog audiotape format. May also be known as Stereo 8."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "8-track"@en .

pbcore:8mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 8mm in width."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "8mm film"@en .

pbcore:9andaHalfmmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 9.5mm in width."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "9.5mm film"@en .

pbcore:Album a skos:Concept ;
    skos:definition "A collection of recordings issued as a single item on CD, record, or another medium."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Album"@en .

pbcore:AluminumDisc a skos:Concept ;
    skos:definition "A grooved aluminum analog disc format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Aluminum disc"@en .

pbcore:Animation a skos:Concept ;
    skos:definition "A moving image production element created from static drawings or objects."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Animation"@en .

pbcore:AudioCD a skos:Concept ;
    skos:definition "An optical disc-based digital audio format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Audio CD"@en .

pbcore:AudioCassette a skos:Concept ;
    skos:definition "A cassette-based 1/8-inch analog audiotape format. If desired, format information can be included after a colon, for example \"Audio cassette: Type I.\" Types of audio cassette include Type I, Type II, Type III and Type IV."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Audio cassette"@en .

pbcore:Betacam a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch analog videotape format. Types of Betacam also include the higher-quality Betacam SP. This information can be included after a colon, as “Betacam: SP.”"@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Betacam"@en .

pbcore:BetacamSX a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch digital videotape format. Betacam SX is a digital version of Betacam SP."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Betacam SX"@en .

pbcore:Betamax a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch analog videotape format. May also be know as Beta. If desired, format information can be included after a colon, for example: “Betamax: ED.” Types of Betamax also include Beta Hi-Fi, ED Betamax and Super Betamax."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Betamax"@en .

pbcore:BluRayDisc a skos:Concept ;
    skos:definition "An optical disc-based digital video format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Blu-ray disc"@en .

pbcore:Catrivision a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch analog videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Catrivision"@en .

pbcore:Clip a skos:Concept ;
    skos:definition "A short excerpt taken from a moving image or audio resource. A clip may not convey a complete intellectual concept."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Clip"@en .

pbcore:Collection a skos:Concept ;
    skos:definition "A group of materials with some unifying characteristic. – 2. Materials assembled by a person, organization, or repository from a variety of sources; an artificial collection."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Collection"@en .

pbcore:Compilation a skos:Concept ;
    skos:definition "A single asset containing multiple different sub-assets; for example, a reel with programs, clips, and raw footage."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Compilation"@en .

pbcore:D1 a skos:Concept ;
    skos:definition "A cassette-based 3/4-inch digital videotape format. Different “D” formats are not necessarily backwards compatible: for example, a D-2 tape cannot be played on a D-1 machine."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "D1"@en .

pbcore:D2 a skos:Concept ;
    skos:definition "A cassette-based 3/4-inch digital videotape format. Different “D” formats are not necessarily backwards compatible: for example, a D-2 tape cannot be played on a D-1 machine."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "D2"@en .

pbcore:D3 a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch digital videotape format. Different “D” formats are not necessarily backwards compatible: for example, a D-2 tape cannot be played on a D-1 machine."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "D3"@en .

pbcore:D5 a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch digital videotape format. Types of D5 also include D5 HD. This information can be included after a colon, as “D5: HD.” Different “D” formats are not necessarily backwards compatible: for example, a D-2 tape cannot be played on a D-1 machine."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "D5"@en .

pbcore:D6 a skos:Concept ;
    skos:definition "A cassette-based 3/4-inch digital videotape format. Different “D” formats are not necessarily backwards compatible: for example, a D-2 tape cannot be played on a D-1 machine."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "D6"@en .

pbcore:D9 a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch digital videotape format. Types of D9 also include D9 HD. This information can be included after a colon, as “D9: HD.” Different “D” formats are not necessarily backwards compatible: for example, a D-2 tape cannot be played on a D-1 machine."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "D9"@en .

pbcore:DAT a skos:Concept ;
    skos:definition "A cassette-based 4mm digital audiotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DAT"@en .

pbcore:DCT a skos:Concept ;
    skos:definition "A cassette-based 3/4-inch digital videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DCT"@en .

pbcore:DDS a skos:Concept ;
    skos:definition "A cassette-based digital data format that can also be used to record audio data."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DDS"@en .

pbcore:DTRS a skos:Concept ;
    skos:definition "A cassette-based 8mm digital audiotape format. May also be known as DARS. Types of DTRS include DA-88. This information can be included after a colon, as “DTRS: DA-88.”"@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DTRS"@en .

pbcore:DV a skos:Concept ;
    skos:definition "A cassette-based 1/4-inch digital videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DV"@en .

pbcore:DVCAM a skos:Concept ;
    skos:definition "A cassette-based 1/4-inch digital videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DVCAM"@en .

pbcore:DVCPRO a skos:Concept ;
    skos:definition "A cassette-based 1/4-inch digital videotape format. If desired, format information can be included after a colon, for example: “DVCPro: 25.” Types of DVCPro include DVCPro 25, DVCPro 50, DVCPro Progressive, and DVCPro HD."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DVCPRO"@en .

pbcore:DVD a skos:Concept ;
    skos:definition "A digital optical disc video format. If desired, format information can be included after a colon, for example: “DVD: DVD-R.” Types of DVD also include DVD+R, DVD+R DL, DVD-R, DVD-RW, and DVD+RW."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "DVD"@en .

pbcore:Digital8 a skos:Concept ;
    skos:definition "A cassette-based 8mm digital videotape format. Digital Betacam is a digital version of Hi8."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Digital8"@en .

pbcore:DigitalBetacam a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch digital videotape format. May also be known as DigiBeta or D-Beta. Digital Betacam is a digital version of Betacam SP."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Digital Betacam"@en .

pbcore:EIAJ a skos:Concept ;
    skos:definition "Cartridge A cartridge-based 1/2-inch analog videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "EIAJ"@en .

pbcore:EVD a skos:Concept ;
    skos:definition "Videodisc A digital optical disc video format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "EVD"@en .

pbcore:Episode a skos:Concept ;
    skos:definition "A single installment of a series, whether linearly relate to other episodes in the series, or simply presented under the same branding."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Episode"@en .

pbcore:Film a skos:Concept ;
    skos:definition "A general term for unknown moving image celluloid formats. If more specific format information is known, please use the appropriate term from the list."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Film"@en .

pbcore:FlexiDisc a skos:Concept ;
    skos:definition "A grooved vinyl analog disc format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Flexi Disc"@en .

pbcore:GroovedAnalogDisc a skos:Concept ;
    skos:definition "A general term for unknown grooved audio formats. If more specific format information is known, please use the appropriate term from the list."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Grooved analog disc"@en .

pbcore:GroovedDictabelt a skos:Concept ;
    skos:definition "A grooved plastic analog format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Grooved Dictabelt"@en .

pbcore:HDCAM a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch digital videotape format. Types of HDCAM also include HDCAM SR. This information can be included after a colon, as “HDCAM: SR.”"@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "HDCAM"@en .

pbcore:HDV a skos:Concept ;
    skos:definition "A cassette-based 1/4-inch digital videotape format. This is a high-definition version of MiniDV."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "HDV"@en .

pbcore:HalfInchAudioTape a skos:Concept ;
    skos:definition "An open reel analog audiotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "1/2 inch audio tape"@en .

pbcore:HalfInchVideotape a skos:Concept ;
    skos:definition "An open reel analog videotape format. May also be known as helical scan tape. If desired, format information can be included after a colon, for example: “1/2 inch videotape: EIAJ Type 1.” Types of 1/2 inch video tape include: CV, EIAJ Type 1, Hawkeye, Recam, V200, and VCR."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "1/2 inch videotape"@en .

pbcore:Hi8 a skos:Concept ;
    skos:definition "A cassette-based 8mm analog videotape format. Hi8 is a high-band version of Video8."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Hi8"@en .

pbcore:LacquerDisc a skos:Concept ;
    skos:definition "A grooved lacquer analog disc format. Types of lacquer discs may include those with aluminum base, glass base, cardboard base, and steel base. More specific format information can be included in an annotation."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Lacquer disc"@en .

pbcore:LaserDisc a skos:Concept ;
    skos:definition "A digital optical disc video format. May also be known as DiscoVision. If desired, format information can be included after a colon, for example: “LaserDisc: CAV.” Types of LaserDisc include CAV, CLV, and CAA."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "LaserDisc"@en .

pbcore:MII a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch analog videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "MII"@en .

pbcore:MagneticDictabelt a skos:Concept ;
    skos:definition "A magnetic plastic analog format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Magnetic Dictabelt"@en .

pbcore:MiniCassette a skos:Concept ;
    skos:definition "A cassette-based 1/8-inch analog audiotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Mini-cassette"@en .

pbcore:MiniDV a skos:Concept ;
    skos:definition "A cassette-based 1/4-inch digital videotape format. May also be known as DVC."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "MiniDV"@en .

pbcore:Miniseries a skos:Concept ;
    skos:definition "A multi-episode resource of limited duration, aired daily or weekly, usually with a total running time of less than 15 hours."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Miniseries"@en .

pbcore:OpenReelAudiotape a skos:Concept ;
    skos:definition "A general term for unknown open reel audio formats. If more specific format information is known, please use the appropriate term from the list."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Open reel audiotape"@en .

pbcore:OpenReelVideoTape a skos:Concept ;
    skos:definition "A general term for unknown open reel video formats. If more specific format information is known, please use the appropriate term from the list below."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Open reel videotape"@en .

pbcore:OpticalVideoDisc a skos:Concept ;
    skos:definition "A general term for unknown optical video formats. If more specific format information is known, please use the appropriate term from the list below."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Optical video disc"@en .

pbcore:PCMBetamax a skos:Concept ;
    skos:definition "A cassette-based digital audiotape format recorded onto Betamax videotape."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "PCM Betamax"@en .

pbcore:PCMUmatic a skos:Concept ;
    skos:definition "A cassette-based digital audiotape format recorded onto U-matic videotape."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "PCM U-matic"@en .

pbcore:PCMVHS a skos:Concept ;
    skos:definition "A cassette-based digital audiotape format recorded onto VHS videotape."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "PCM VHS"@en .

pbcore:PianoRoll a skos:Concept ;
    skos:definition "A paper-based musical storage format used to operate a player piano."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Piano roll"@en .

pbcore:PlasticCylinder a skos:Concept ;
    skos:definition "A grooved plastic analog phonograph cylinder format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Plastic cylinder"@en .

pbcore:Program a skos:Concept ;
    skos:definition "A resource that has been prepared for broadcast/publication and is presented as a single work, with no series branding."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Program"@en .

pbcore:Promo a skos:Concept ;
    skos:definition "An edited piece of audio or video announcing an upcoming work (like a program or series)."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Promo"@en .

pbcore:QuarterInchAudioCassette a skos:Concept ;
    skos:definition "A cassette-based analog audiotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "1/4 inch audio cassette"@en .

pbcore:QuarterInchAudioTape a skos:Concept ;
    skos:definition "An open reel analog audiotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "1/4 inch audio tape"@en .

pbcore:QuarterInchVideotape a skos:Concept ;
    skos:definition "An open reel analog videotape format. May also be known as Akai."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "1/4 inch videotape"@en .

pbcore:RawFootage a skos:Concept ;
    skos:definition "Originally captured footage or other unedited content, not intended for broadcast in its current form."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Raw Footage"@en .

pbcore:Season a skos:Concept ;
    skos:definition "A set of episodes from a series, which were all aired in the same broadcast period."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Season"@en .

pbcore:Segment a skos:Concept ;
    skos:definition "A self-contained portion of a program/episode, which serves its own function, but operates within the larger program/episode."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Segment"@en .

pbcore:Series a skos:Concept ;
    skos:definition "A set of episodes broadcast in sequence, usually conceived without a definte end and aired on a regular schedule. Typically all episodes within a single series follow a specific theme or continuous storyline, or are all broadcast under the same series title and branding."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Series"@en .

pbcore:ShellacDisc a skos:Concept ;
    skos:definition "A grooved shellac analog disc format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Shellac disc"@en .

pbcore:Subseries a skos:Concept ;
    skos:definition "A set of episodes that makes up its own series, which is broadcast under an umbrella series with its own branding."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Subseries"@en .

pbcore:Super16mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 16mm in width, with an expanded picture area."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Super 16mm film"@en .

pbcore:Super8mmFilm a skos:Concept ;
    skos:definition "A gauge of moving image printed on celluloid, 8mm in width, with an expanded picture area."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Super 8mm film"@en .

pbcore:SuperAudioCD a skos:Concept ;
    skos:definition "An optical disc-based digital audio format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Super Audio CD"@en .

pbcore:SuperVideoCD a skos:Concept ;
    skos:definition "A digital optical disc video format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Super Video CD"@en .

pbcore:Umatic a skos:Concept ;
    skos:definition "A cassette-based 3/4-inch analog videotape format. May also be known as 3/4-inch tape. If desired, format information can be included after a colon, for example: “U-matic: S.” Types of U-matic include the smaller U-matic S and the high-quality U-matic SP."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "U-matic"@en .

pbcore:UniversalMediaDisc a skos:Concept ;
    skos:definition "A digital optical disc video format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Universal Media Disc"@en .

pbcore:VHS a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch analog videotape format. If desired, format information can be included after a colon, for example: “VHS: S-VHS.” Types of VHS include S-VHS, W-VHS and VHS-C."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "VHS"@en .

pbcore:VX a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch analog videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "VX"@en .

pbcore:Vcord a skos:Concept ;
    skos:definition "A cassette-based 1/2-inch analog videotape format. If desired, format informatio can be included after a colon, for example: “V-Cord: I.” Types of V-Cord include V-Cord I and V-Cord II."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "V-Cord"@en .

pbcore:Video8 a skos:Concept ;
    skos:definition "A cassette-based 8mm analog videotape format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Video8"@en .

pbcore:Videocassette a skos:Concept ;
    skos:definition "A general term for unknown video cassette formats. If more specific format information is known, please use the appropriate term from the list below."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Videocassette"@en .

pbcore:VinylRecording a skos:Concept ;
    skos:definition "A grooved vinyl analog disc format. If desired, format information can be included after a colon, for example: “Vinyl record: EP.” Types of records may include EP, LP, 45, 78. LP may also be known as 33 1/3."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Vinyl recording"@en .

pbcore:WaxCylinder a skos:Concept ;
    skos:definition "A grooved wax analog phonograph cylinder format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Wax cylinder"@en .

pbcore:WireRecording a skos:Concept ;
    skos:definition "A wire-based magnetic analog audio format."@en ;
    skos:inScheme lev:pbcore ;
    skos:prefLabel "Wire recording"@en .

lev:pbcore a skos:ConceptScheme ;
    dct:source <https://pbcore.org> ;
    dct:title "PBCore controlled vocabularies"@en ;
    rdfs:comment "93 concepts of the PBCore controlled vocabularies, as harmonised for the Linked Echoes workflow."@en .

lev:europeana-fashion a skos:ConceptScheme ;
    dct:source <http://thesaurus.europeanafashion.eu> ;
    dct:title "Europeana Fashion thesaurus"@en ;
    rdfs:comment "1,479 concepts of the Europeana Fashion thesaurus, as harmonised for the Linked Echoes workflow."@en .

lev:mimo a skos:ConceptScheme ;
    dct:source <http://www.mimo-db.eu/InstrumentsKeywords#>,
        <https://vocabulary.mimo-international.com> ;
    dct:title "MIMO (Musical Instrument Museums Online) instrument keywords"@en ;
    rdfs:comment "2,323 concepts of the MIMO (Musical Instrument Museums Online) instrument keywords, as harmonised for the Linked Echoes workflow."@en .

lev:aat a skos:ConceptScheme ;
    dct:source aat:,
        <https://www.getty.edu/research/tools/vocabularies/aat/> ;
    dct:title "Getty Art & Architecture Thesaurus (AAT)"@en ;
    rdfs:comment "46,403 concepts of the Getty Art & Architecture Thesaurus (AAT), as harmonised for the Linked Echoes workflow."@en .
