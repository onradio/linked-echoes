    skos:altLabel "Bandolín"@de,
        "Bandolin"@zh,
        "Begana"@zh ;
    skos:definition "The bandolin is a 15-stringed musical instrument in Ecuador. It is used as a rhythm and melody instrument in the Andean region of Ecuador during festivals where dancing and music are involved. It has a flat back and 15 strings in triple courses."@en ;
