aat:300126225 a skos:Concept ;
    skos:definition "Hue name for one of the three primary additive colors; that portion of the spectrum lying at the lowest frequencies of light discernible by the human eye, with a wavelength range between 630 and 760 nanometers. The term may refer to any of this group of colors that vary in lightness and saturation. Examples of red color in nature are that of blood and ripe cherries."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "red"@en .

aat:300126226 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of red colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vivid red"@en .

aat:300126249 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of red colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strong red"@en .

aat:300126272 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of red colors."@en ;
    skos:inScheme lev:aat ;
