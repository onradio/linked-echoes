aat:300126317 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of red colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark red"@en .

aat:300126335 a skos:Concept ;
    skos:definition "Complexes of shops, restaurants, kiosks, and pushcarts featuring music and other entertainment, generally built downtown to revitalize an urban center; coined in the 1970s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "festival marketplaces"@en .

aat:300126345 a skos:Concept ;
    skos:definition "Refers to a construction technique that employs dry materials such as wallboard, plywood, or other prefabricated materials, without the use of plaster or mortar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "drywall construction"@en .

aat:300126352 a skos:Concept ;
    skos:definition "Devices that include the full display of armorial bearings: the escutcheon plus its adjuncts (helm, crest, mantling, motto, supporters)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "coats of arms"@en .

aat:300126359 a skos:Concept ;
    skos:definition "A type of coated paper having a surface that has been prepared for metalpoint drawing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prepared paper"@en .

aat:300126368 a skos:Concept ;
    skos:definition "Any devices intended to collect solar radiation and convert it into energy."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solar collectors"@en .

aat:300126369 a skos:Concept ;
    skos:definition "Includes spaces in rooms as well as rooms and buildings where blood or blood plasma is collected, processed, stored, and distributed."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "blood banks"@en .

aat:300126370 a skos:Concept ;
    skos:definition "Covered, nonmotorized animal-drawn vehicles equipped as traveling living quarters, particularly those used in the 18th and 19th centuries by small itinerant groups or individuals, such as gypsies, tinkers, or traveling salespeople; for motorized counterparts use \"motor homes.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "caravans"@en .

aat:300126526 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of red colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "very dark red"@en .

aat:300126531 a skos:Concept ;
