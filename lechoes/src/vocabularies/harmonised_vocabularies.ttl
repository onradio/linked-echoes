        "roodgoud"@nl .

euf:11169 a skos:Concept ;
    skos:definition "Materials produced by weaving, felting, knotting, twining, or otherwise processing natural or synthetic fibers so that they cohere into a form or unit; traditionally excludes fiberboard, paper, papier-mâché, and papyrus, which, though also fiber products, are considered as separate types of material. For generic reference to the genre, see textiles (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Textiles Material"@de,
        "υφαντική ύλη"@el,
        "textile material"@en,
        "material textil"@es,
        "matière textile"@fr,
        "חומר טקסטיל"@he,
        "materiale tessile"@it,
        "textiel materiaal"@nl,
        "tecido têxtil"@pt,
        "tekstilni materijal"@sr,
        "textilt material"@sv .

euf:11170 a skos:Concept ;
    skos:definition "Paper used for making photographic prints that consists of a base material with a white or near-white surface that is coated with one or more emulsion layers. It is typically a high grade of paper traditionally made from 100% cotton or linen rags, because lignin and other residues in other paper would react with the photosensitive salts and destroy the image. Photographic paper is strong, uniform, and dimensionally stable when wet and dry. For increased wet-strength, the papers are sized with animal glue, starch, stearic acid, or synthetic resins, such as melamine (used since 1948). One or more fillers, such as barium sulfate, titanium dioxide, clay, starch, or polyacrylamide, are also added for opacity, color, and strength. The papers were calendered to produce a smooth, nonporous surface. Since the late 1960s, most color photographic papers have been made from cellulose fibers coated on both sides with polyethylene (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Fotopapier"@de,
        "photographic paper"@en,
        "papel fotográfico"@es,
        "papier photographique"@fr,
        "carta fotografica"@it,
        "fotopapier"@nl,
        "papel fotográfico"@pt .

euf:11171 a skos:Concept ;
    skos:definition "General term for a solid marking substance in the form of a slender rod, which is then enclosed in a cylinder of wood, metal, or plastic to form a pencil (drawing and writing equipment). Common examples of materials used in pencils (drawing and writing equipment) are graphite, lead, and pigmented wax (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pencil (marking material)"@en,
        "potlood (markeermateriaal)"@nl .

euf:11172 a skos:Concept ;
    skos:definition "Plastic based on polyether or polyester resin (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Polyurethan"@de,
        "Πολυουρεθάνη"@el,
        "polyurethane"@en,
        "poliuretano"@es,
        "polyuréthane"@fr,
        "פוליאוריתן"@he,
        "poliuretano"@it,
        "polyurethaan"@nl,
        "poliuretano"@pt,
        "полиуретан"@sr,
        "Polyuretan"@sv .

euf:11173 a skos:Concept ;
    skos:definition "Colorless, transparent, thermoplastic synthetic resin made by the polymerization of acrylic acid derivatives; used for adhesives, fibers, consolidants, protective coatings, finishes, and as a paint medium (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Acrylharz"@de,
        "Ακρυλική ρητίνη"@el,
        "acrylic (resin)"@en,
        "acrílico"@es,
        "résine acrylique"@fr,
        "resina metarilica"@it,
        "acryl"@nl,
        "resina metarilica"@pt,
        "akrylharts"@sv .

euf:11174 a skos:Concept ;
    skos:altLabel "afzettingsgesteente"@nl ;
    skos:definition "Rock, such as sandstone or limestone, formed from materials deposited as sediments (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Sedimentgestein"@de,
        "Ιζηματογενές πέτρωμα"@el,
        "sedimentary rock"@en,
        "roca sedimentaria"@es,
        "roche sédimentaire"@fr,
        "סלע משקע"@he,
        "roccia sedimentaria"@it,
        "sedimentair gesteente"@nl,
        "rocha sedimentar"@pt,
        "седиментна стена"@sr,
        "sedimentär bergart"@sv .

euf:11175 a skos:Concept ;
    skos:definition "Any of various crystalline or glassy rocks formed by the cooling and solidification of magma or other molten earth material. Igneous rocks comprise one of the three principal classes of rocks, the others being metamorphic and sedimentary (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "magmatisches Gestein"@de,
        "Εκρηξιγενές πέτρωμα"@el,
        "igneous rock"@en,
        "roca ígnea"@es,
        "roche magmatique"@fr,
        "סלע יסוד"@he,
        "roccia magmatica"@it,
        "stollingsgesteente"@nl,
        "rocha ígnea"@pt,
        "магматска стена"@sr,
        "magmatisk bergart"@sv .

euf:11176 a skos:Concept ;
    skos:definition "Rocks that result from the alteration of pre-existing rocks in response to changing environmental conditions, such as variations in temperature, pressure, and mechanical stress, and the addition or subtraction of chemical components. The pre-existing rocks may be igneous, sedimentary, or other metamorphic rocks (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "metamorphes Gestein"@de,
        "Μεταμορφωσιγενές πέτρωμα"@el,
        "metamorphic rock"@en,
        "roca metamórfica"@es,
        "roche métamorphique"@fr,
        "סלע מותמר"@he,
        "roccia metamorfica"@it,
        "metamorf gesteente"@nl,
        "rocha metamórfica"@pt,
        "метаморфна стена"@sr,
        "Metamorf bergart"@sv .

euf:11177 a skos:Concept ;
    skos:definition "Naturally occurring soft white mineral that is commonly used as a retarding agent in portland cement, as a core in sheets of wallboard, as a white pigment, in grounds for paintings, and is the main component of alabaster (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gips"@de,
        "γύψος"@el,
        "gypsum"@en,
        "yeso"@es,
        "gypse"@fr,
        "גבס"@he,
        "gesso"@it,
        "gips"@nl,
        "gipsita"@pt,
        "гипс"@sr,
        "gips"@sv .

euf:11178 a skos:Concept ;
    skos:definition "Fine-grained marblelike variety of gypsum that is easy to carve but is rather fragile; it has been used as a sculpture material, ornamental building work, vases, small decorative carvings, and powdered for use as a paper filler and paint pigment called mineral white or terra alba. Alabaster is usually a translucent white or pink but may also be a muted red, yellow or gray. It is soft and can be scratched slightly with a fingernail. It also dissolves slowly in wet environments (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Alabaster"@de,
        "αλάβαστρο"@el,
        "alabaster"@en,
        "alabastro"@es,
        "albâtre"@fr,
        "אלבסטר"@he,
        "alabastro"@it,
        "albast"@nl,
        "alabastro"@pt,
        "алабастер"@sr,
        "alabaster"@sv .

euf:11179 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pit (fruit component)"@en,
        "pit"@nl .

euf:11180 a skos:Concept ;
    skos:definition "Synthetic fiber produced from long-chain polyamides, suitable for cable, rope, tape, textile, and webbing (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Aramide"@de,
        "aramid"@en,
        "aramida"@es,
        "aramide"@fr,
        "ארמיד"@he,
        "aramide"@nl,
        "Aramidfiber"@sv .

euf:11181 a skos:Concept ;
    skos:altLabel "arduin"@nl ;
