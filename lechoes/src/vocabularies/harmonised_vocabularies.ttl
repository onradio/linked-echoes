    skos:inScheme lev:aat ;
    skos:prefLabel "khura-kumbha"@en .

aat:300446403 a skos:Concept ;
    skos:definition "In Indian art and architecture, a composite fantastic animal; griffin, chimera; mythical fabulous creature; varāla; virāla; viḍāla (Oriyā); griffinic monster."@en ;
