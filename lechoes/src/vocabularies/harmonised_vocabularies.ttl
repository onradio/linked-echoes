    skos:inScheme lev:aat ;
    skos:prefLabel "Viṣṇucchanda śikhara"@en .

aat:300446954 a skos:Concept ;
    skos:definition "In Indian architecture, a octagonal, compound pillar-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miśra-Viṣṇukānta"@en .

