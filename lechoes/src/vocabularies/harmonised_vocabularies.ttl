    skos:prefLabel "āyudhapuruṣas"@en .

aat:300446247 a skos:Concept ;
    skos:definition "In Indian architecture, an appliquéd shrine with false door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghana-dēvakulikā"@en .

aat:300446248 a skos:Concept ;
    skos:definition "In Indian architecture, an attached or appliquéd parapet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arpita-hāra"@en .

aat:300446249 a skos:Concept ;
    skos:definition "In Indian architecture, an apsidal (elephant-backed) śikhara-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gajapṛṣṭha"@en .

aat:300446250 a skos:Concept ;
    skos:definition "In Indian architecture, an apsidal śikhara, vimāna-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cāpākāra"@en .

aat:300446251 a skos:Concept ;
    skos:definition "In Indian architecture, an apsidal-ended structure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gajapṛṣthākāra"@en .

aat:300446252 a skos:Concept ;
    skos:definition "In Indian architecture, an architectural division carrying vertical facias."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "phālanā-yukta"@en .

aat:300446253 a skos:Concept ;
    skos:definition "In Indian architecture, an architrave of the entablature (South India); lintel, beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uttara"@en .

aat:300446254 a skos:Concept ;
    skos:definition "In Indian architecture, an arris moulding on pillar capital or in the pīṭha; knife-edged moulding in a base."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karṇaka"@en .

aat:300446255 a skos:Concept ;
    skos:definition "In Indian architecture, an assembly hall; school or college building."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghaṭikālaya"@en .

aat:300446256 a skos:Concept ;
