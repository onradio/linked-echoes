aat:300128307 a skos:Concept ;
    skos:definition "Hue name for any yellow-green color of low brightness and saturation, resembling the color of an unripe olive, the fruit of the Mediterranean evergreen tree, Olea europaea."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "olive"@en .

aat:300128309 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of yellowish green colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light olive"@en .

aat:300128324 a skos:Concept ;
