    skos:inScheme lev:aat ;
    skos:prefLabel "ratnabandha"@en .

aat:300446749 a skos:Concept ;
    skos:definition "In Indian architecture, a jewelled pendant motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maṇipadaka"@en .

