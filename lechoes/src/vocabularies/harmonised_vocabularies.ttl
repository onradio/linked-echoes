        "ručno oslikavanje"@sr,
        "handmålad"@sv .

euf:10422 a skos:Concept ;
    skos:definition "Technique of resist dyeing in which hanks of thread are bound and dyed before being woven into fabric (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Ikat"@de,
        "ικάτ"@el,
