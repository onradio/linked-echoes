    skos:inScheme lev:aat ;
    skos:prefLabel "Ṛjusūtra-jāla"@en .

aat:300446740 a skos:Concept ;
    skos:definition "In Indian architecture, a jamb bearing diamond pattern; faceted śākhā."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vajraśākhā"@en .

