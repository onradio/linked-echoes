euf:11183 a skos:Concept ;
    skos:altLabel "bricks"@en,
        "bakstenen"@nl ;
    skos:definition "Clay or clay products formed into a rectangular block and hardened by drying in the sun or firing in a kiln (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
