aat:300446274 a skos:Concept ;
    skos:definition "In Indian architecture, a band bearing figures of vidyādhara-angels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vidyādhara-paṭṭikā"@en .

aat:300446275 a skos:Concept ;
    skos:definition "In Indian architecture, a band carved with creeper design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vallipaṭṭā"@en .

aat:300446276 a skos:Concept ;
    skos:definition "In Indian architecture, a band of diamond pattern; maṇipaṭṭa, maṇipaṭṭikā; jewel-band (decorative motif) ."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ratnapaṭṭa"@en .

aat:300446277 a skos:Concept ;
    skos:definition "In Indian architecture, a band of diamond pattern; maṇipaṭṭa, maṇipaṭṭikā; minor jewel-band bay-window projecting from an upper storey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siṁhapañjara"@en .

aat:300446278 a skos:Concept ;
    skos:definition "In Indian architecture, a band of doorframe ornament; doorjamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dvāraśākhā"@en .

aat:300446279 a skos:Concept ;
    skos:definition "In Indian architecture, a band of foliage motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "parṇapaṭṭī"@en .

aat:300446280 a skos:Concept ;
    skos:definition "In Indian architecture, a band of gems, diamonds alternating with stylized rubies as ornate miniature medallions; band of jewels alternating with rosettes as a decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maṇibandha"@en .

aat:300446281 a skos:Concept ;
    skos:definition "In Indian architecture, a band of gems/jewels decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maṇipaṭṭī"@en .

aat:300446282 a skos:Concept ;
    skos:definition "In Indian architecture, a band of gorgon faces in series; band of grāsa motifs; band showing grāsa heads in file."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grāsapaṭṭaka"@en .

aat:300446283 a skos:Concept ;
    skos:definition "In Indian architecture, a band of leaf-and-bangle design; register of kaṅkaṇapatra design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaṅkaṇapatra-paṭṭī"@en .

aat:300446284 a skos:Concept ;
    skos:definition "In Indian architecture, a band of makaras."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "makaramālā"@en .

aat:300446285 a skos:Concept ;
    skos:definition "In Indian art and architecture, a fillet or band depicting cavaliers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aśvapīṭha"@en .

aat:300446286 a skos:Concept ;
    skos:definition "In Indian architecture, a band showing haṁsas and cakravāka birds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "haṁsa-cakravāka-paṭṭī"@en .

aat:300446287 a skos:Concept ;
    skos:definition "In Indian architecture, a band with figures; figural or narrative band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rūpadhārā"@en .

aat:300446288 a skos:Concept ;
    skos:definition "In Indian architecture, a band, register; broad rectangular fillet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paṭṭa"@en .

aat:300446289 a skos:Concept ;
    skos:definition "In Indian architecture, a tall and slender detached pillar in front of a temple."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhvajastambha"@en .

aat:300446290 a skos:Concept ;
    skos:definition "In Indian architecture, a banner-staff; composed of the Ashtamangala, the \"eight auspicious symbols\". This may take the appearance of a high column (dhvaja-stambha) erected in front of temples."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dhvaja"@en .

aat:300446291 a skos:Concept ;
    skos:definition "In Indian architecture, a basal plain moulding of vēdībandha, below kumbha; kumbha proper (in Oriyā)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khura"@en .

aat:300446292 a skos:Concept ;
    skos:definition "In Indian architecture, basal wall-mouldings consisting primarily of khura, kumbha, kalaśa, sometimes antarapaṭṭa, and kapōtapālī/kapōtapālikā (North Indian type); aggregate of five mouldings — khura, kumbha, kalaśa, antarapaṭṭa, and kapōtapālī — in the base or lower section of the wall of North Indian and a few Karṇāṭan temples; pābhāga (Oriyā)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vēdībandha"@en .

aat:300446293 a skos:Concept ;
    skos:definition "In Indian architecture, a basal-band showing frontal posture of elephant figures in file; base-moulding bearing elephant figures in series."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gajapīṭha"@en .

aat:300446294 a skos:Concept ;
    skos:definition "In Indian architecture, a basal-block of pillar."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hōma"@en .

aat:300446295 a skos:Concept ;
    skos:definition "In Indian architecture, a base for Śiva’s phallic emblem; base of liṅga; pīṭhikā."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "liṅgapīṭha"@en .

aat:300446296 a skos:Concept ;
    skos:definition "In Indian architecture, a base of pillar/pilaster, usually smaller than kumbhaka; basal part of stambhaśākhā."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kumbhikā"@en .

aat:300446297 a skos:Concept ;
    skos:definition "In Indian architecture, a basement terrace of stūpa; grīvā-plinth; central platform."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mēḍhī"@en .

aat:300446299 a skos:Concept ;
    skos:definition "In Indian architecture, a bay formed by pillars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aṅkaṇa"@en .

aat:300446300 a skos:Concept ;
    skos:definition "In Indian architecture, a bay of four-pillars; four-pillared structure; four-pillared porch or pavilion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "catuṣkī"@en .

aat:300446301 a skos:Concept ;
    skos:definition "In Indian architecture, a bay-projection; buttress-like division in temple/hall plan; pāga (Oriyā)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rathaka"@en .

aat:300446303 a skos:Concept ;
    skos:definition "In Indian architecture, a type of beam."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhārapaṭṭa"@en .

aat:300446304 a skos:Concept ;
    skos:definition "In Indian architecture, a bell; bell-member of the Saṁvaraṇā-roof; crowning bell of Phāṁsanā/Saṁvaraṇā."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghaṇṭā"@en .

aat:300446305 a skos:Concept ;
    skos:definition "In Indian architecture, a bell-festoon."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kiṅkiṇikājāla"@en .

aat:300446306 a skos:Concept ;
    skos:definition "In Indian architecture, a belonging to Valabhī class of temples/Valabhī temple-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Valabhīcchandaja"@en .

aat:300446308 a skos:Concept ;
    skos:definition "In Indian architecture, a bhitti; or wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuḍya"@en .

aat:300446309 a skos:Concept ;
    skos:definition "In Indian architecture, a bhūta-based column-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhūtapāda"@en .

aat:300446310 a skos:Concept ;
    skos:definition "In Indian architecture, a bhūtamālā, or register of goblins."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhūtavalabhī"@en .

aat:300446311 a skos:Concept ;
    skos:definition "In Indian art or architecture, a bifacial (figure)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ubhayamukhī"@en .

aat:300446312 a skos:Concept ;
    skos:definition "In Indian architecture, a blind railing-enclosure with decorative elephant-fronts."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vēdī-mattavāraṇa"@en .

aat:300446313 a skos:Concept ;
    skos:definition "In Indian architecture, a rectilinear band, such as used in the adhiṣṭhāna (pedestal or base of a structure) or the blocking or finishing course of masonry on a wall, such as above a cornice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "āliṅga"@en .

aat:300446314 a skos:Concept ;
    skos:definition "In Indian architecture, a blossoming creeper (decorative motif); floral creeper."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "puṣpavallī"@en .

aat:300446315 a skos:Concept ;
    skos:definition "In Indian architecture, a blue lotus; water lily motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utpala"@en .

aat:300446317 a skos:Concept ;
    skos:definition "In Indian architecture, a bow-shaped apse."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cāpa"@en .

aat:300446318 a skos:Concept ;
    skos:definition "In Indian architecture, a bowl; large circular ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karōṭaka"@en .

aat:300446319 a skos:Concept ;
    skos:definition "In Indian architecture, a bracket-capital (Early India; South India); Types: citra, taraṅga, puṣpa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pōtikā"@en .

aat:300446322 a skos:Concept ;
    skos:definition "In Indian architecture, a breaking of floor-plan into bays (with or without recesses between)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dala-vibhakti"@en .

aat:300446323 a skos:Concept ;
    skos:definition "In Indian architecture, a broad band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahāpaṭṭa"@en .

aat:300446324 a skos:Concept ;
    skos:definition "In Indian architecture, a broad band carved with floral scroll."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vasantapaṭṭikā"@en .

aat:300446325 a skos:Concept ;
    skos:definition "In Indian architecture, a broad band, a moulding of a base, oversailing fillet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahāvājana"@en .

aat:300446326 a skos:Concept ;
    skos:definition "In Indian architecture, a broad band, especially the projecting topmost band of adhiṣṭhāna; broad fillet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahāpaṭṭī"@en .

aat:300446327 a skos:Concept ;
    skos:definition "A broad fillet; complex of kampa and paṭṭa fillets."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kampa-paṭṭa"@en .

aat:300446328 a skos:Concept ;
    skos:definition "In Indian architecture, a broad ornate fillet as substructure of kakṣāsana or vēdikā fencing (usually decorated with diamond and double volute pattern; also with pramathas and bhāravāhaks in several early Mahā-Maru instances)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rājasēnaka"@en .

aat:300446329 a skos:Concept ;
    skos:definition "In Indian architecture, a broad pent-roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śūrpacchādya"@en .

aat:300446330 a skos:Concept ;
    skos:definition "In Indian architecture, a broad recess between mouldings; generally a taller recess between upper and lower sets of basal mouldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kandhara"@en .

aat:300446331 a skos:Concept ;
    skos:definition "In Indian architecture, a bud (conical decorative motif, usually shown in suspension)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kalikā"@en .

aat:300446333 a skos:Concept ;
    skos:definition "In Indian sculpture or architecture, a Buddhist/Jaina \"wheel of law\" motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dharmacakra"@en .

aat:300446334 a skos:Concept ;
    skos:definition "In Indian architecture, buildings where people live, such as a house, an abode, a dwelling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ālaya"@en .

aat:300446335 a skos:Concept ;
    skos:definition "In Indian architecture, a bull’s head motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vṛṣavaktra"@en .

aat:300446336 a skos:Concept ;
    skos:definition "In Indian architecture, a bull's eye; jāla/jālī design as motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Gōnētra"@en .

aat:300446337 a skos:Concept ;
    skos:definition "In Indian art and architecture, a decorative motif in the form of a bunch of mango fruits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "āmralumbī"@en .

aat:300446338 a skos:Concept ;
    skos:definition "Cakvā-bird, a species of heron as a decorative motif in Indian architecture."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cakravākī"@en .

aat:300446339 a skos:Concept ;
    skos:definition "In Indian art and architecture, a moon-arch decorative motif : candraśālā; candraśālikā; gavākṣa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "induśālikā"@en .

aat:300446340 a skos:Concept ;
    skos:definition "In Indian architecture, a cantoning pilaster."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuḍyalāṅgula"@en .

aat:300446341 a skos:Concept ;
    skos:definition "In Indian architecture, a cap-stone of building’s foundation platform; foundation-capping course."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kharaśilā"@en .

aat:300446342 a skos:Concept ;
    skos:definition "Directions in Hindu tradition."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dik"@en .

aat:300446343 a skos:Concept ;
    skos:definition "In Indian architecture, a carved dais."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ṭaṅkitamañca"@en .

aat:300446344 a skos:Concept ;
    skos:definition "In Indian art or architecture, a casket, box, basket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karaṇḍaka"@en .

aat:300446345 a skos:Concept ;
    skos:definition "In Indian architecture, a caturasra, cubical section in pillar-shaft square; square śikhara-type; cubical section in Citrakhaṇḍa pillars; cubical part of the pillar-shaft; saduram (Tamil); also square configuration (in the context of ground plan)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "saduram"@en .

aat:300446346 a skos:Concept ;
    skos:definition "In Indian architecture, a cavity within moon-window motif; recess/cavity of gavākṣa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gāḍha"@en .

aat:300446347 a skos:Concept ;
    skos:definition "In Indian architecture, a ceiling; Types: Samatala, Padmaśilā, Nābhicchanda, Padmanābha, Padmamandāraka,Sabhāmārga, Sabhāmandāraka, Sabhā-padma-mandāraka, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vitāna"@en .

aat:300446348 a skos:Concept ;
    skos:definition "In Indian architecture, a ceiling showing lotuses or lūmās; adhiṣṭhāna type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padmaka"@en .

aat:300446349 a skos:Concept ;
    skos:definition "In Indian architecture, a ceiling showing the central pendentive surrounded by padma-lūmās."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabhā-padma-mandāraka"@en .

aat:300446350 a skos:Concept ;
    skos:definition "In Indian architecture, a celestial ascetic; saint, seer."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "siddha"@en .

aat:300446351 a skos:Concept ;
    skos:definition "Mythical celestial bird-man and minstrel; celestial musician; celestial birdman playing instrument."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinnara"@en .

aat:300446353 a skos:Concept ;
    skos:definition "A celestial minstrel In Hinduism, Buddhism and Jainism, Gandharva is a class of celestial beings whose males are divine singers and females are divine dancers from Gandhara region."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gandharva"@en .

aat:300446354 a skos:Concept ;
    skos:definition "In Indian art and architecture, figures representing female celestial minstrels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kinnarī"@en .

aat:300446355 a skos:Concept ;
    skos:definition "In Indian architecture, a cella (womb); sanctum sanctorum; sanctuary; womb house."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "garbha"@en .

aat:300446356 a skos:Concept ;
    skos:definition "A Central Asian costume with boots and vest (as in Sūrya images), as a motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "udīcyavēṣa"@en .

aat:300446357 a skos:Concept ;
    skos:definition "In Indian architecture, a central band (at the bhadra) of Latina (North Indian curvilinear superstructure) śikhara; central spine of northern Indian śikharas or of a few Karṇāṭan superstructures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madhyalatā"@en .

aat:300446358 a skos:Concept ;
    skos:definition "In Indian architecture, a central cavity of a nāsī."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nāsīgāḍhas"@en .

aat:300446359 a skos:Concept ;
    skos:definition "In Indian architecture, a central hall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madhyaśālā"@en .

aat:300446360 a skos:Concept ;
    skos:definition "In Indian architecture, a central jamb of the door."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madhyaśākhā"@en .

aat:300446361 a skos:Concept ;
    skos:definition "In Indian architecture, a division of the wall forming a central offset."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhadraratha"@en .

aat:300446363 a skos:Concept ;
    skos:definition "In Indian architecture, a central offset of either ratha (bhadra) or of latā of śikhara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subhadra"@en .

aat:300446364 a skos:Concept ;
    skos:definition "In Indian architecture, a central offset; bhadra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "madhyas-ratha"@en .

aat:300446365 a skos:Concept ;
    skos:definition "In Indian architecture, a central part of door lintel; block of stone at the tutelary position upwards in the centre of a doorframe; lintel-block."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lalāṭa"@en .

aat:300446366 a skos:Concept ;
    skos:definition "In Indian architecture, a central raised platform for dancing in the hall; slightly raised nave-platform in hall, for dancing."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "raṅgabhūmi"@en .

aat:300446367 a skos:Concept ;
    skos:definition "In Indian architecture, a central stamenal tube of a ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padmakēsara"@en .

aat:300446368 a skos:Concept ;
