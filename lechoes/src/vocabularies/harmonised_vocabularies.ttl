        "edelmetaal"@nl,
        "metal precioso"@pt,
        "племенити метал"@sr,
        "ädelmetall"@sv .

euf:11198 a skos:Concept ;
    skos:definition "Textile having the characteristic that it can be stretched without permanent alteration of size or shape. Examples include yardage or strips of textile material comprising threads or thin strips of rubber or other another elastic substance covered by a woven material (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stretch-Gewebe"@de,
        "elastic (textile material)"@en,
        "tejido elástico"@es,
        "tissu extensible"@fr,
        "tessuto elasticizzato"@it,
        "stretchstof"@nl,
        "resårband"@sv .

euf:11199 a skos:Concept ;
    skos:definition "Synthetic yarn that will stretch under tension and contract when released; usually made from thermoplastic filaments, and used especially for hosiery (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "stretch yarn"@en,
        "stretchgaren"@nl .

euf:11200 a skos:Concept ;
    skos:definition "A synthetic polymer with elastic properties similar to natural rubber that can recover its original size after repeated extensions to more than twice its initial length. Examples of elastomers are polybutadiene, styrene-butadiene rubber, nitrile rubber, and butyl rubber (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Elastomer"@de,
        "Ελαστομερές"@el,
        "elastomer"@en,
        "elastómero"@es,
        "élastomère"@fr,
