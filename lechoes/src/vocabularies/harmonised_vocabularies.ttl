    skos:inScheme lev:aat ;
    skos:prefLabel "bahyaśākhā"@en .

aat:300446970 a skos:Concept ;
    skos:definition "In Indian architecture, a oversailing band of rafter-ends; dentils."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vājana-valabhī"@en .

