aat:300126954 a skos:Concept ;
    skos:definition "The ability to bend without breaking or cracking."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "flexibility"@en .

aat:300126959 a skos:Concept ;
    skos:definition "Altars of any faith or culture that are not connected to or supported by a building or other structure. The term typically includes outdoor altars, and altars that are placed within a building but are not architecturally attached to the walls or structure of the building. Note that in some cases, particularly in certain periods of Catholic architecture, it may at first glance appear that an altar is attached to the wall, but it is in fact freestanding in keeping with the ecclesiastical prescription that the high altar must stand free on all sides, although the backs of smaller altars may be built against the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "freestanding altars"@en .

aat:300126963 a skos:Concept ;
    skos:definition "Specially designed structures made to span great lengths."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "large span structures"@en .

aat:300126966 a skos:Concept ;
    skos:definition "Street or highway lanes intended for use primarily by buses but also used by other traffic for such purposes as right turns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bus lanes"@en .

aat:300126968 a skos:Concept ;
    skos:definition "Driving lanes added beside through-traffic lanes to allow vehicles to speed up for merging."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "acceleration lanes"@en .

aat:300126969 a skos:Concept ;
    skos:definition "Self-supporting flooring or roofing units that span between structural members."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "decking"@en .

aat:300126977 a skos:Concept ;
    skos:definition "Composite material consisting of a thermosetting plastic resin reinforced by glass in fibrous form. To refer to the reinforcing agent itself rather than the composite, use \"fiberglass.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "glass reinforced plastic"@en .

aat:300126981 a skos:Concept ;
    skos:definition "Fine, thin cotton or linen cloth, coated on one or both sides with starch or a starch mixture, used especially by architects and designers for making tracings in ink or pencil."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "tracing cloth"@en .

aat:300126989 a skos:Concept ;
    skos:definition "Refers to planned works of architecture that were never physically produced. For works other than architecture, use \"unexecuted designs.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "unbuilt projects"@en .

aat:300126994 a skos:Concept ;
    skos:definition "Designates helicopter takeoff and landing surfaces, usually without commercial facilities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "helipads"@en .

aat:300126995 a skos:Concept ;
    skos:definition "Having the curved form of an arc, which is a closed segment of a differentiable curve in a two-dimensional plane. Examples include architectural arches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "arched"@en .

aat:300127003 a skos:Concept ;
    skos:definition "Organizations which contribute in varying degrees to a community. Community organizations may be non-profit, private-sector, or private for-profit organizations. They may have a broad constituency, such as a neighborhood council, or a more targeted constituency, such as a tenant's association. Organizations which contribute in varying degrees to a community. Community organizations may be non-profit, private-sector, or private for-profit organizations. They may have a broad constituency, such as a neighborhood council, or a more targeted constituency, such as a tenant's association."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "community organizations"@en .

aat:300127035 a skos:Concept ;
    skos:definition "Tibetan stupas, generally characterized by bulbous domes set on square bases and surmounted by a spire of tiered disklike shapes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "chortens"@en .

aat:300127038 a skos:Concept ;
    skos:definition "Ceylonese and Singhalese stupas, generally with a tripartite base and a dome surmounted by a small pavilionlike structure and a spire. Relics are often kept in these Buddhist mounds."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dagobas"@en .

aat:300127068 a skos:Concept ;
    skos:definition "Islamic shrines or shrine mosques."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mashhads"@en .

aat:300127069 a skos:Concept ;
    skos:definition "Mosques, with a mihrab but no minbar, used for daily prayer by individuals or small groups, but not for Friday worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masjids"@en .

aat:300127071 a skos:Concept ;
    skos:definition "Open spaces or areas in Islamic towns used for a variety of activities, such as games, parades, and executions."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "maydans"@en .

aat:300127075 a skos:Concept ;
    skos:definition "Buildings or other roofed structures used for musical performances."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "odea"@en .

aat:300127083 a skos:Concept ;
    skos:definition "In Islamic architecture, monumental gateways or portals, especially ones with a rectangular screen wall rising above the roofline of the building beyond, usually mosques, madrasas, or caravanserais."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pishtaqs"@en .

aat:300127086 a skos:Concept ;
    skos:definition "Wide streets or avenues in ancient Greek and Roman towns."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "plateias"@en .

aat:300127090 a skos:Concept ;
    skos:definition "Siamese stupas tapering from a round base to an attenuated finial."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prachedis"@en .

aat:300127097 a skos:Concept ;
    skos:definition "Public halls in ancient Greek cities where the sacred hearth and official headquarters of the city administration were housed and where official guests were entertained."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prytaneia"@en .

aat:300127104 a skos:Concept ;
    skos:definition "Opaque photographs, usually positive (i.e., reproducing appearances without tonal reversal, otherwise use \"negative prints\"), usually on paper, and generally, but not always, printed from a negative."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic prints"@en .

aat:300127115 a skos:Concept ;
    skos:definition "Commercially-produced photographs mounted on thick card stock, slightly larger than the image. The surrounding card space is usually printed or embossed with the photographer's name or insignia, while the back usually bears the photographer's imprint. They were made by a variety of processes in different standard sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "card photographs"@en .

aat:300127121 a skos:Concept ;
    skos:definition "Photographic prints having albumen as the binder; always black-and-white, though they may be toned to a monochrome hue."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "albumen prints"@en .

aat:300127131 a skos:Concept ;
    skos:definition "Card photographs, generally portraits, which measure 4 1/4 by 6 1/2 inches, including the mount. They were introduced by F. R. Window in 1867 as larger alternatives to the \"cartes-de-visite,\" which measured 3 1/4 x 2 1/4 inches. The larger size was considered more appropriate for display, allowed for group portraits, and permitted the image to be retouched. The size remained popular until World War I."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cabinet photographs"@en .

aat:300127138 a skos:Concept ;
    skos:definition "Photographic prints made by the carbon process, which uses carbon pigment and gelatin to transfer images to a paper support. Carbon prints show a very slight relief and rarely exhibit signs of aging or image deterioration. During the last quarter of the 19th century they were widely used for book illustrations and the commercial reproduction of conventionally made photographs and prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "carbon prints"@en .

aat:300127141 a skos:Concept ;
    skos:definition "Small-format photographs affixed to card stock, popular in the mid-19th century. They went out of fashion in the 1870s. The photographs were typically portraits and the image was a standard size of 3 1/4 x 2 1/4 inches; they were generally produced by a multiple-lens camera that created several images on a single full-sized negative plate. Full-size prints from the plate were cut into sections measuring 4 x 2 1/2 inches, and the pieces were often mounted on cards, which initially served as visitors' cards; it later became the custom to exchange them on birthdays and holidays, and to collect cartes-de-visite of friends, family members, and celebrities in albums. Examples are card photographs patented by the Parisian photographer André-Adolphe-Eugène Disdéri in 1854 and similar items produced by Mathew B. Brady and other photographers."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cartes-de-visite"@en .

aat:300127145 a skos:Concept ;
    skos:definition "Photographic prints made by the platinum process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "platinum prints"@en .

aat:300127149 a skos:Concept ;
    skos:definition "Photographic prints having light-sensitive salts in the fibers of the paper rather than in a binder; the image is positive and is printed out rather than developed out. For positive prints specifically made by Talbot's calotype process, use the more specific \"calotype prints (positive prints).\" For Talbot's printed-out paper negatives, use \"photogenic drawings.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salted paper prints"@en .

aat:300127163 a skos:Concept ;
    skos:definition "Photographic prints made on a gelatin-silver chloride photographic paper introduced commercially in 1867 by the Munich-born chemist Johann Baptist Obernetter. This was considered the first industrial ready-to-use photographic paper print process. Aristotypes are composed of a paper layer, a layer of baryum sulphate in gelatin, and a layer of emulsion containing silver chloride suspended in a binder. The baryta layer made purer whites possible. As this was was a printing-out-paper, aristotypes are exclusively contact prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aristotypes"@en .

aat:300127167 a skos:Concept ;
    skos:definition "Cartes-de-visite which are raised, like medallions, by pressure to the back."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cameo prints"@en .

aat:300127169 a skos:Concept ;
    skos:definition "Photographic prints made by interfacing a negative and a sheet of photographic paper and exposing the paper with raw light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contact prints"@en .

aat:300127173 a skos:Concept ;
    skos:definition "Photographs in which the tones or colors are reversed from their appearance in nature, usually on a transparent support of celluloid, acetate, or on paper, intended for the purpose of producing positive prints. For finished prints in which tones or colors are reversed, see \"negative prints.\" When a glass plate is painted or drawn on and a photographic print made from it, use \"clichés-verre.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "negatives"@en .

aat:300127180 a skos:Concept ;
    skos:definition "Positive-image photographs produced in the camera without the intervening use of a negative, or produced by a positive-to-positive process."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "direct positives"@en .

aat:300127181 a skos:Concept ;
    skos:definition "Photographs made by the process called daguerreotype, which produces a direct positive image on a silver-coated copper plate. They are often mounted in special cases lined with red velvet or leather. They are named for Louis-Jacques-Mandé Daguerre of France, who invented the technique in collaboration with Nicéphore Niépce in the 1830s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daguerreotypes"@en .

aat:300127183 a skos:Concept ;
    skos:definition "Contact prints containing prints from more than one negative, usually from all the negatives on a roll of film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "contact sheets"@en .

aat:300127186 a skos:Concept ;
    skos:definition "Photographs produced by mounting a negative (made by a variant of the wet collodion process) that is on glass with a dark backing, which makes the image appear as a positive. Came into wide use in the United States in the early 1850s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ambrotypes"@en .

aat:300127190 a skos:Concept ;
    skos:definition "Negatives on paper made by William Henry Fox Talbot's patented calotype process, a developing-out process. Distinguished from Talbot's \"photogenic drawings,\" in which the image was printed out. For most prints made from these negatives, use \"calotype prints (positive prints).\" In the mid-20th century, the term was sometimes used incorrectly for all other paper negatives or salted paper prints."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "calotypes"@en .

aat:300127195 a skos:Concept ;
    skos:definition "Small vignette daguerreotypes, sometimes mounted like jewels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cameotypes"@en .

aat:300127197 a skos:Concept ;
    skos:definition "Refers to the most popular and common form of stereoscopic photographs, which are double photographs of the same image taken from two slightly different perspectives. Stereographs are distinctive among other stereoscopic photographs because they are photographic prints mounted on cards, while other types could be daguerreotypes, negatives, or unmounted prints. From 1856 they were produced with twin-lens cameras, creating a three dimensional effect when viewed through a stereoscope. Stereographs were especially popular during the Victorian period."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stereographs"@en .

aat:300127198 a skos:Concept ;
    skos:definition "Stereoscopic photographs in which the two images are in contrasting colors and produce a three-dimensional effect when viewed through colored filters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "anaglyphs"@en .

aat:300127264 a skos:Concept ;
    skos:definition "Use to describe photographs, usually daguerreotypes, ambrotypes, or tintypes, mounted in sturdy, boxlike cases."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cased photographs"@en .

aat:300127269 a skos:Concept ;
    skos:definition "Photographs that have been altered through interference in the optical or chemical procedures, or physically altered, as for example, sewn, marked on, or torn."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "manipulated photographs"@en .

aat:300127280 a skos:Concept ;
    skos:definition "A term for a type of photographic portrait popular in the years before the First World War. Usually oval, finished with liberal airbrushing and colored with pastels."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "crayon enlargements"@en .

aat:300127288 a skos:Concept ;
    skos:definition "Negatives made from positive transparencies or prints (or by reversal from original negatives) for use in printing copies."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "internegatives"@en .

aat:300127290 a skos:Concept ;
    skos:definition "Photographs with images of greatly reduced size, requiring a magnification device to view, including, for example, microfiche. Distinct from \"photomicrographs,\" which are photographs of minute objects, usually taken through a microscope."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "microphotographs"@en .

aat:300127296 a skos:Concept ;
    skos:definition "Photographs produced without a camera, usually by placing an object directly on sensitized paper and exposing it to light. Includes Talbot's first photographs, which he called photogenic drawings. In the early 20th century the term was sometimes used to mean all photographs."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photograms"@en .

aat:300127318 a skos:Concept ;
    skos:definition "Transparencies used in conjunction with a negative or another transparency to alter color or contrast."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "masks"@en .

aat:300127322 a skos:Concept ;
    skos:definition "Photographs of minute objects, usually taken through a microscope. Distinct from \"microphotographs,\" which are images reduced to minute size."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photomicrographs"@en .

aat:300127326 a skos:Concept ;
    skos:definition "Miniature photographs, mounted under a magnifying glass, that might be inserted in jewelry or used for other decorative purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stanhopes"@en .

aat:300127329 a skos:Concept ;
    skos:definition "An invention of George Eastman, a photographic material consisting of a gelatino-bromide emulsion over plain gelatin; first appeared in 1888 on a paper support and later on nitrocellulose film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "American film"@en .

aat:300127330 a skos:Concept ;
    skos:definition "A gelatino-chloride printing-out paper. The original aristo paper was simply a paper prepared with a substratum of barium and coated with a collodio-chloride of silver emulsion; the term was first used in the 1880s."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aristo paper"@en .

aat:300127335 a skos:Concept ;
    skos:definition "Paper with a gelatin/barium sulfate surface preparation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "baryta paper"@en .

aat:300127344 a skos:Concept ;
    skos:definition "Photographic film sensitized only to shades of black and white, lacking the dyes to process color."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "black-and-white film"@en .

aat:300127347 a skos:Concept ;
    skos:definition "Cellulose nitrate in a mixture of 60% ether and 40% alcohol for making fiber and film."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collodion"@en .

aat:300127348 a skos:Concept ;
    skos:definition "Preparation for making sensitive plates which could be used in a dry or wet state (developed by W.B. Bolton in 1876)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "collodion pellicle"@en .

aat:300127350 a skos:Concept ;
    skos:definition "Sensitized flexible film in cut sizes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sheet film"@en .

aat:300127352 a skos:Concept ;
    skos:definition "Photographic paper on which the image is invisible, or latent, until it is brought out by a chemical developer after exposure to light, usually through a negative. Distinguished from 'printing-out paper' where the image is formed and immediately viewable while being exposed to light."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "developing-out paper"@en .

aat:300127358 a skos:Concept ;
    skos:definition "Refers to the class of materials and material products used in the processing of photographs, including the constituent parts of the photograph itself."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic materials"@en .

aat:300127360 a skos:Concept ;
    skos:definition "Materials such as silver, platinum, organic dyes, or pigments, which create a final image."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "final image material"@en .

aat:300127363 a skos:Concept ;
    skos:definition "Thin sheet coated with an adhesive that becomes sticky when heated; used to fasten photographic prints to a mount."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mounting tissue"@en .

aat:300127366 a skos:Concept ;
    skos:definition "Photographic film which is sensitive to all colors of the spectrum."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "panchromatic film"@en .

aat:300127369 a skos:Concept ;
    skos:definition "Sheets of glass, metal, porcelain, or other rigid material coated with a light-sensitive photographic emulsion."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "photographic plates"@en .

aat:300127375 a skos:Concept ;
    skos:definition "Photographic paper coated with silver-chloride emulsions, typically made of gelatin but sometimes of collodion. It was designed for the production of a photographic print from a negative by the action of light alone on light-sensitive material, rather than by development using chemicals. It was in general use, particularly for portraiture, from the 1880s until the late 1920s when developing-out paper became more popular. Because the paper needed to be in contact with the negative until the image was completely visible, a second print could not be started until the first was complete. Photographs made on printing-out paper can have either glossy or matte surfaces and typically have warm image tones."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "printing-out paper"@en .

aat:300127378 a skos:Concept ;
    skos:definition "Photographic paper with a fiber base material coated on both sides with a plastic resin; the plastic resin prevents the base from absorbing processing solutions and wash water. The coating on the emulsion side usually contains white pigment to form a background for the image and the coating on the reverse is usually transparent. The benefits of using resin-coated paper are a short washing time, reduced water use, and a short drying time."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "resin-coated paper"@en .

aat:300127382 a skos:Concept ;
    skos:definition "Photographic film negative that is wound around spools or inside canisters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "roll film"@en .

aat:300127384 a skos:Concept ;
    skos:definition "Photographic film with a base of cellulose acetate, triacetate, or polyester that will not ignite spontaneously."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "safety film"@en .

aat:300127389 a skos:Concept ;
    skos:definition "Photographic paper used in salted paper processes. Paper is impregnated with a solution of salt (sodium chloride) dissolved in water; it is then coated on one side with silver nitrate thus forming light-sensitive silver chloride on the surface."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salted paper"@en .

aat:300127391 a skos:Concept ;
    skos:definition "Photographic paper which has the thinnest base, and is usually the least expensive."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "single-weight paper"@en .

aat:300127393 a skos:Concept ;
    skos:definition "A gelatin-emulsion chloride printing-out paper developed in 1892 by Eastman Kodak Co. for amateur use. It was progressively improved and was the most successful paper of its kind; it was available in some places until the late 1960s, at least two decades after all other such papers had stopped being made."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "solio paper"@en .

aat:300127395 a skos:Concept ;
    skos:definition "Film or photographic paper that allows the image-bearing emulsion to be removed intact from the base material, usually for transfer to another, more substantial or transparent, support. The first major gelatin-emulsion stripping film was Eastman American film, offered in 1885."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stripping film"@en .

aat:300127403 a skos:Concept ;
    skos:definition "The layer of a photograph placed directly on the glass, film, or paper to adhere the binder to the support."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "subbing layer"@en .

aat:300127427 a skos:Concept ;
    skos:definition "Compounds created by combining silver with another material."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver compounds"@en .

aat:300127428 a skos:Concept ;
    skos:definition "A white, crystalline water-soluble, bitter, corrosive, poisonous powder AgNO3, produced by the reaction of silver and dilute nitric acid. It was chiefly used in the manufacture of photographic emulsions and mirrors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "silver nitrate"@en .

aat:300127429 a skos:Concept ;
    skos:definition "Presses for expressing juice from apples; used to make cider."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cider presses"@en .

aat:300127430 a skos:Concept ;
    skos:definition "Supplemental cooling systems in buildings that utilize ice production and storage for the purpose of reducing utility loads."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ice storage systems"@en .

aat:300127431 a skos:Concept ;
    skos:definition "Vaults in which the rows of bricks are laid at a slight inclination, leaning against the previously laid row, thus obviating the need for formwork."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pitched-brick vaults"@en .

aat:300127475 a skos:Concept ;
    skos:definition "Boxlike enclosures having openwork of bars, wires, or the like used to confine or protect its occupant, or to admit light or ventilation. Typically reserved for large or small enclosures of this type used for animals, or for freestanding barred enclosures for humans. For such rooms in prisons, particularly if the room is enclosed within walls and having only a limited area of bars, prefer \"prison cells.\""@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cages"@en .

aat:300127478 a skos:Concept ;
    skos:definition "Images designed for viewing by transmitted light. Most often refers to transparent positive photographs; can also refer to transparent nonphotographic images that are designed for projection viewing or as intermediates for reproduction."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "transparencies"@en .

aat:300127490 a skos:Concept ;
    skos:definition "Hue name for any dull reddish-yellowish or orangish color of low brightness and saturation, resembling the color of wood or earth. Brown is a low luminance color that is typically produced by adding black or their complementary colors to red, orange, or yellow paint. It is considered an earth tone and has an unlimited numbers of shades."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brown"@en .

aat:300127491 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strong brown"@en .

aat:300127501 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep brown"@en .

aat:300127503 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light brown"@en .

aat:300127514 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "moderate brown"@en .

aat:300127526 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark brown"@en .

aat:300127528 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "grayish brown"@en .

aat:300127538 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light grayish brown"@en .

aat:300127544 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dark grayish brown"@en .

aat:300127549 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of gray colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brownish gray"@en .

aat:300127559 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of gray colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "light brownish gray"@en .

aat:300127563 a skos:Concept ;
    skos:definition "Generally includes the HVAC and plumbing of buildings or complexes; in some contexts may also include electrical systems and electricity-based systems, such as protection systems and communication systems."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mechanical systems"@en .

aat:300127573 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of blackish colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "brownish black"@en .

aat:300127576 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "strong reddish brown"@en .

aat:300127588 a skos:Concept ;
    skos:definition "UCL (Universal Color Language) standard color name identifying a range of brown colors."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "deep reddish brown"@en .

