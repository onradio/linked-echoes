        "ebano"@it,
        "ebbenhout"@nl,
        "ébano"@pt,
        "abonos"@sr,
        "ebenholts"@sv .

euf:10803 a skos:Concept ;
    skos:altLabel "birch wood"@en,
        "עץ שחור/ אבוני"@he ;
    skos:definition "Strong, pale yellow-brown wood from trees of the genus Betula, having a close, straight grain and uniform texture that finishes to a smooth surface. It is sometimes dyed to imitate mahogany. Birch is used for tools handles, plywood, hoops, shoe heels, flooring, furniture, cabinetry, turnery, and firewood. The bark is also used for various purposes (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Birkenholz"@de,
