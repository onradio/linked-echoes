    skos:definition "In Indian architecture, a hall for theatrical purposes."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nṛtya-maṇḍapa"@en .

aat:300446687 a skos:Concept ;
    skos:definition "In Indian architecture, a hall for worship."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "āyāgasabhā"@en .

aat:300446689 a skos:Concept ;
