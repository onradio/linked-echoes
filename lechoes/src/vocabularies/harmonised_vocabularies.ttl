        "צילום אופנה"@he,
        "fotografia di moda"@it,
        "modefoto"@nl,
        "fotografia de moda"@pt,
        "modna fotografija"@sr,
        "modefotografi"@sv .

euf:10304 a skos:Concept ;
    skos:altLabel "tableau"@fr ;
    skos:definition "Unique works in which images are formed primarily by the direct application of pigments suspended in oil, water, egg yolk, molten wax, or other liquid, arranged in masses of color, onto a generally two-dimensional surface. (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gemälde"@de,
        "πίνακας ζωγραφικής"@el,
        "painting"@en,
