euf:10849 a skos:Concept ;
    skos:altLabel "Parfumflasche"@de,
        "Parfumfläschchen"@de ;
    skos:definition "Term applied to a wide variety of bottles of different size and shape intended primarily for holding or dispersing perfume. Includes those made for sale to cosmetics manufacturers as well as those often decorative forms meant to be placed on the dressing table and sometimes part of a toilet set. (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Parfumflakon"@de,
        "μπουκάλι αρώματος"@el,
