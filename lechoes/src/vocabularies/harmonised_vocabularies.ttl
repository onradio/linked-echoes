    skos:inScheme lev:aat ;
    skos:prefLabel "grāsamālā"@en .

aat:300446373 a skos:Concept ;
    skos:definition "In Indian architecture, of circular shape."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vṛttākāra"@en .

aat:300446374 a skos:Concept ;
    skos:definition "Circular cyma-shaped architectural members placed between āmalaka/āmalasāraka and crowning kalaśa in Indian architecture; padmacchatra; karparī; khapuri (Oriyā)."@en ;
