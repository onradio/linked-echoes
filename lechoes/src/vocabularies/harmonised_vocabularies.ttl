euf:10477 a skos:Concept ;
    skos:altLabel "Espartogras"@de,
        "alfa"@en,
        "esparto (fiber)"@en ;
    skos:definition "The fiber of the grass species Macrochloa tenacissima, used to make cordage, shoes, and paper. It is sometimes used in combination with the poorer quality with fiber from another species of tall grass, Lygeum spartum. Esparto fibers are used extensively in England and Scotland for the production of paper, but rarely used in the U.S. because wood pulp is plentiful there (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Esperto"@de,
        "σπάρτο"@el,
        "esparto grass"@en,
        "esparto"@es,
