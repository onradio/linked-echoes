        "Theremin"@pl,
        "Theremin"@sv,
        "泰勒明电子琴"@zh .

mimo:2226 a skos:Concept ;
    skos:definition "The Trautonium is an electronic synthesizer invented in 1930 by Friedrich Trautwein in Berlin at the 's music and radio lab, the Rundfunkversuchstelle. Soon afterwards Oskar Sala joined him, continuing development until Sala's death in 2002."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Trautonium"@ca,
