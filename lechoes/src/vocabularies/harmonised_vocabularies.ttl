        "hout"@nl,
        "drvo"@sr,
        "trä"@sv .

euf:10578 a skos:Concept ;
    skos:definition "Material derived from the stem or stalk of the bamboo plant, which is any of 480 species of woody or treelike tropical and semitropical grass (AAT)."@en ;
