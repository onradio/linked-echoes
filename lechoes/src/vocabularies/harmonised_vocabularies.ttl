        "abbigliamento da giorno"@it,
        "dagkleding"@nl,
        "dnevna odeća"@sr,
        "vardagsklädsel"@sv .

euf:10730 a skos:Concept ;
    skos:altLabel "בד מבריק עם אפקט גלי"@he ;
    skos:definition "Refers to an open weave textile made of thread, twine, yarn, or cord, usually of silk, cotton, nylon, or rayon, with fine to coarse meshes of fixed dimension. It is characterized by being a simple mesh joined by knots; it may be made by hand or by machine. It may be used to make various items from veils and trimming on clothing to tennis nets and fishing nets. Fine net that is used in lace, headwear, and other apparel is often referred to as netting rather than as net. For the objects consisting of meshed arrangements of threads, cords, or ropes that have been twisted, knotted, or woven together at regular intervals, use nets (objects) (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Netz"@de,
        "δίχτυ"@el,
        "net"@en,
        "red"@es,
        "filet"@fr,
        "רשת"@he,
        "rete"@it,
        "net"@nl,
        "mreža"@sr,
        "nät"@sv .

euf:10731 a skos:Concept ;
    skos:definition "Very fine plain weave white cotton made in a great variety of qualities; originally from India, it has been extensively produced and used in Europe and North America for costume, and sometimes as an artist's support (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Musselin"@de,
        "μουσελίνα"@el,
        "muslin"@en,
