aat:300446925 a skos:Concept ;
    skos:definition "In Indian architecture, nāsī-front on of a pañjarakōṣṭha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pañjaranāsī"@en .

aat:300446926 a skos:Concept ;
    skos:definition "In Indian architecture, nāsikā; nāsī."@en ;
    skos:inScheme lev:aat ;
