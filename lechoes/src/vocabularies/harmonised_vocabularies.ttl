mimo:2984 a skos:Concept ;
    skos:definition "A tubaphone is a type of metallophone constructed from a series of metal tubes arranged in a keyboard configuration. The tubes are similar in length to that of a xylophone, and sound vaguely like a glockenspiel."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Tubàfon"@ca,
        "Tubaphon"@de,
        "Tubaphone"@en,
        "Tubófono"@es,
