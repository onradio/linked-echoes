        "kaardersbak"@nl .

euf:11322 a skos:Concept ;
    skos:definition "Rectangular wooden block with iron pins to untangle rabbit and hare skins and remove dirt."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "carding brush"@en,
        "kaardersborstel"@nl .

euf:11323 a skos:Concept ;
    skos:definition "Specialized combs, typically made of wood, comprising a flat surface covered by iron nails, wire teeth, or other sharp objects designed to manually disentangible the fibres from textile materials prior to spinning (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "carding comb"@en,
        "peigne à carder"@fr,
        "kaarderskam"@nl .

euf:11324 a skos:Concept ;
    skos:definition "Revolving drum in which the skins are cleaned with a quantity of sand, which gives an abrasive effect, and sat flour, which absorbs the heat released fat from the skins. This makes the stiff, dry sheets supple again."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "degreasing drum"@en,
        "ontvettingstrommel"@nl .

euf:11325 a skos:Concept ;
    skos:definition "A razor-sharp lenticular blade on the foot makes it possible to remove the last wrinkles and any clots of clotted blood or fat from the skin."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "hair cutting blade"@en,
        "overhaler"@nl .

euf:11326 a skos:Concept ;
    skos:altLabel "flaying table"@en ;
    skos:definition "Tool with a large rotary wheel and a long vertical conical pin consisting of two halves lengthwise. The skin is slid over the pin, by turning the wheel one half of the pin moves and the skin becomes taut so that stubborn folds are pulled open and the belly can be cut open easily and safely."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "spin table"@en,
        "pin (rekwerktuig)"@nl .

euf:11327 a skos:Concept ;
    skos:definition "Rectangular brush with a handle with which the ironer rubs the hair of the sheets with 'secretion', a mixture of mercury and nitric acid."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "string brush"@en,
        "strijkersborstel"@nl .

euf:11328 a skos:Concept ;
    skos:definition "Large rectangular stone made of baked earthenware (stoneware) on which the string brushes the sheets with 'secretion', a mixture of mercury and nitric acid."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "smoothing stone"@en,
        "strijksteen"@nl .

euf:11329 a skos:Concept ;
    skos:definition "A machine with which the long, hard wind hair - which is unusable for the hat manufacturer - is pulled out of rabbit skins."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "pulling machine"@en,
        "trekmachine"@nl .

euf:11330 a skos:Concept ;
    skos:definition "Pointed, curved iron hook with handle in line with the hook, is used to move bunches of rabbit skins."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "hand hook"@en,
        "handhaak"@nl .

euf:11331 a skos:Concept ;
    skos:definition "Seat with sawn-off backrest, so that the carder can easily turn and turn in all directions."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "carder's chair"@en,
        "haarsnijdersstoel"@nl .

euf:11332 a skos:Concept ;
