euf:10933 a skos:Concept ;
    skos:altLabel "imitation pearls"@en,
        "imitatieparels"@nl ;
    skos:definition "Material resembling pearls, often inexpensive. Imitation pearls, first made in the 19th century, were constructed by injecting hollow beads of glass with a mixture of aqueous ammonia and fish scales; this deposited a layer of guanine crystals as an iridescent film on the interior surface of the beads. In the 20th century, another process made imitation pearls by coating the exterior of solid glass beads with the fish scale mixture; the nacreous coating was sealed with a protective varnish layer (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kunstperlen"@de,
        "απομίμηση πέρλας"@el,
        "imitation pearl"@en,
        "imitation de perle de culture"@fr,
        "פנינת חיקוי"@he,
        "imitazione di perla"@it,
        "imitatieparel"@nl,
        "imitacija bisera"@sr,
        "konstgjord pärla"@sv .

euf:10934 a skos:Concept ;
    skos:definition "Commercially produced, British acrylic plastic consisting essentially of polymerized methyl methacrylate. Polymethyl methacrylate was discovered in the early 1930s by British chemists at Imperial Chemical Industries in England and trademarked the name Perspex (AAT)."@en ;
