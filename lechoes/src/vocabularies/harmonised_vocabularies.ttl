        "schors"@nl,
        "kora"@sr,
        "bark"@sv .

euf:10580 a skos:Concept ;
    skos:definition "The lightweight, elastic outer bark the cork oak, species Quercus suber native to the Mediterranean region. Cork is elastic, buoyant, and resilient, used to seal wine bottles, for insulation, floats, acoustical wall covering, flooring, shoe soles, gaskets, and handles (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Korken"@de,
        "φελός"@el,
        "cork (bark)"@en,
        "corcho"@es,
        "liège"@fr,
        "שעם"@he,
        "sughero"@it,
        "kurk (schors)"@nl,
        "cortiça"@pt,
        "pluta"@sr,
        "kork"@sv .

euf:10582 a skos:Concept ;
    skos:altLabel "seashell"@en,
        "seashells"@en,
        "shells (animal material)"@en,
        "coquille"@fr,
        "schelpen (dierlijk materiaal)"@nl ;
    skos:definition "Hard outer covering of invertebrate creatures, composed of calcareous or chitinous material (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
