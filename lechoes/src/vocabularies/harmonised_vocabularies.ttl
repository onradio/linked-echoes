        "carta velina"@it,
        "zijdepapier"@nl,
        "toaletni papir"@sr,
        "silkepapper"@sv .

euf:10577 a skos:Concept ;
    skos:definition "The principal tissue of trees and other plants that provides both strength and a means of conducting nutrients. Wood is one of the most versatile materials known (AAT)."@en ;
