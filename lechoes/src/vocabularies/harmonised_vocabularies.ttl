    skos:prefLabel "kṣudrapañjara"@en .

aat:300446985 a skos:Concept ;
    skos:definition "In Indian architecture, a pañjara-pattern on kapōta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kapōtapañjara"@en .

aat:300446986 a skos:Concept ;
    skos:definition "In Indian architecture, patralatā, foliation on a kapōta."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koḍikkaruku"@en .

aat:300446987 a skos:Concept ;
    skos:definition "In Indian architecture, a patralatā, leafy scroll."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "patravallī"@en .

aat:300446988 a skos:Concept ;
    skos:definition "A motif of a pattern of circles (moon-discs) around the edge of the cupola or along the lip of a cornice."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "candramaṇḍala"@en .

aat:300446989 a skos:Concept ;
    skos:definition "In Indian architecture, a pavement (in compound or on platform)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "uttānapaṭṭa"@en .

aat:300446990 a skos:Concept ;
    skos:definition "In Indian architecture, a pavilion for Śiva’s sacred bull, Nandī."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Nandi-maṇḍapa"@en .

aat:300446991 a skos:Concept ;
    skos:definition "In Indian architecture, a pavilion on landing platform in a step-well."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ramaṇaka"@en .

aat:300446992 a skos:Concept ;
    skos:definition "In Indian architecture, a pavilion on the sky storey."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "harmya"@en .

aat:300446993 a skos:Concept ;
    skos:definition "In Indian architecture, a pavilion sheltering an inscribed stele."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śāsana-maṇḍapikā"@en .

aat:300446994 a skos:Concept ;
    skos:definition "In Indian art or architecture, a peacock motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mayūra"@en .

aat:300446995 a skos:Concept ;
    skos:definition "In Indian architecture, a pearl festoon as decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muktādāma"@en .

aat:300446996 a skos:Concept ;
    skos:definition "In Indian architecture, a pearl string as decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muktāvali"@en .

aat:300446997 a skos:Concept ;
    skos:definition "In Indian architecture, a pearl-cable arch."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muktā-tōraṇa"@en .

aat:300446998 a skos:Concept ;
    skos:definition "In Indian architecture, a pearl-cable jamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muktāśākhā"@en .

aat:300446999 a skos:Concept ;
    skos:definition "In Indian architecture, a pearl-festoon motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "muktājāla"@en .

aat:300447000 a skos:Concept ;
    skos:definition "In Indian architecture, a pearl-festoon with half-lotuses within its loops as a decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "padma-muktā-dāma"@en .

aat:300447001 a skos:Concept ;
    skos:definition "In Indian art, a pear-shaped citrus as a motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vījapūraka"@en .

aat:300447002 a skos:Concept ;
    skos:definition "In Indian architecture, a pedestal for Nandī."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vṛṣapīṭhikā"@en .

aat:300447003 a skos:Concept ;
    skos:definition "In Indian art and architecture, a pedestal for oblation."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "balipīṭha"@en .

aat:300447004 a skos:Concept ;
    skos:definition "In Indian architecture, a seat or pedestal which represents the place of the Buddha's enlightenment."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Bōdhimaṇḍa"@en .

aat:300447006 a skos:Concept ;
    skos:definition "In Indian architecture, a pediment made up of a large gavākṣa-window, usually with lateral half-loops; pediment made up of trifoliate dormer patterns; pediment made up of caitya-dormers (candraśālās); bho (Oriyā)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śurasēnaka"@en .

aat:300447007 a skos:Concept ;
    skos:definition "In Indian architecture, a pediment of interconnected gavākṣa-dormers/caitya-dormers (candraśālās); triangular pediment, usually formed by gavākṣa-dormer mesh"@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "udgama"@en .

aat:300447008 a skos:Concept ;
    skos:definition "In Indian architecture, a pendentive made up of kōla courses."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kōlaja-lambana"@en .

aat:300447009 a skos:Concept ;
    skos:definition "In Indian art and architecture, a peopled scroll; inhabited vine motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "pramatha-vallī"@en .

aat:300447010 a skos:Concept ;
    skos:definition "In Indian architecture, a perforated screen with figure(s)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "gulikā-jāla"@en .

aat:300447011 a skos:Concept ;
    skos:definition "In Indian architecture, a perforated screen; gavākṣa-web design of a śikhara; mesh design; grille; grille-pattern: Types: Ṛjusūtra, Gōnētra, Hastinētra/kuñjarākṣa, Gulika, Nāga, Puṣpakaṇṭha/Puṣpakhaṇḍa, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jālaka"@en .

aat:300447012 a skos:Concept ;
    skos:definition "In Indian architecture, a peripheral screen wall with lamps."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "viḷakkumāḍam"@en .

aat:300447014 a skos:Concept ;
    skos:definition "In Indian architecture, a pilaster with pot at base and pañjara motif on top; vṛttasphuṭita variant."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kumbhapañjara"@en .

aat:300447015 a skos:Concept ;
    skos:definition "In Indian architecture, a pilaster with pot motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kumbhastambha"@en .

aat:300447016 a skos:Concept ;
    skos:definition "In Indian architecture, a pilaster; bhittistambha; wall pilaster; engaged column."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuḍyastambha"@en .

aat:300447017 a skos:Concept ;
    skos:definition "In Indian architecture, a pilaster-formed jamb, usually central in doorframe and carved with figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rūpastambha"@en .

aat:300447018 a skos:Concept ;
    skos:definition "In Indian architecture, a pile of tiers on which mūlamañjarī of the Anēkāṇḍaka śikhara sits."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mallacchādya"@en .

aat:300447019 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar base; pot motif on jagatī."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kumbhaka"@en .

aat:300447020 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar bracket."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śīrṣa"@en .

aat:300447021 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar used as wall-ornament; see vṛttaspuṭita."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sphuṭita"@en .

aat:300447022 a skos:Concept ;
    skos:definition "In Indian architecture, pillars or columns, usually monumental, which in the context of Hindu mythology are believed to be a cosmic column that functions as a bond, joining heaven and earth. Types: Rucaka, Bhadraka, Vardhamāna, Brahmakānta, Viṣṇukānta, Īśakānta/Rudrakānta, Indrakānta, etc."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stambhas"@en .

aat:300447023 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar-bracket adorned with wave design."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "taraṅga-pōtikā"@en .

aat:300447024 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar-bracket, a member of the capital-complex."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "stambhaśīrṣa"@en .

aat:300447025 a skos:Concept ;
    skos:definition "In Indian architecture, a pillared room to either side within a pratōlī-gate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "indrakōśa"@en .

aat:300447026 a skos:Concept ;
    skos:definition "In Indian architecture, a pillaret."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daṇḍikā"@en .

aat:300447027 a skos:Concept ;
    skos:definition "In Indian architecture, a pillaret-jamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "daṇḍaśākhā"@en .

aat:300447028 a skos:Concept ;
    skos:definition "In Indian architecture, a pillarette with entwined half-human male/female snake deity (Kaliṅga)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nāginīstambha"@en .

aat:300447029 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar-moulding."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "hīraka"@en .

aat:300447030 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar-part below capital decorated with floral festoons (South India); upper part of column or pilaster with floral design; shaft-portion below the laśuna decorated with pearl-string ornament."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mālāsthāna"@en .

aat:300447031 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar-shaft."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kāla"@en .

aat:300447032 a skos:Concept ;
    skos:definition "In Indian architecture, a pillar-type showing vase-and-foliage member; pūrṇaghaṭa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghaṭapallava"@en .

aat:300447033 a skos:Concept ;
    skos:definition "In Indian architecture, a pinnacle, crest."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śikhā"@en .

aat:300447035 a skos:Concept ;
    skos:definition "In Indian architecture, a pitha-course showing humans engaged in manifold activities."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "narapīṭha"@en .

aat:300447036 a skos:Concept ;
    skos:definition "In Indian architecture, a plain recessed śākhā; deeply carved recessed śākhā; depressed intermediate door-jamb."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khalvaśākhā"@en .

aat:300447037 a skos:Concept ;
    skos:definition "In Indian architecture, a plan/wall with three bays; with three projections."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "triratha"@en .

aat:300447038 a skos:Concept ;
    skos:definition "In Indian architecture, a plank-moulding of the temple base and hāra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prati"@en .

aat:300447039 a skos:Concept ;
    skos:definition "Platform of a building in Drāviḍian architecture; substructure of pīṭha; platform or socle beneath the adhiṣṭhāna; Types: Mañcabhadra, Kapōtabhadra, Kapōtāsana, Vēdībhadra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "upapīṭha"@en .

aat:300447040 a skos:Concept ;
    skos:definition "In Indian architecture, a plinth course; jagatī-plinth."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vapra"@en .

aat:300447042 a skos:Concept ;
    skos:definition "In Indian architecture, a pointed ratha of the jaṅghā section of the wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jaṅghā-pallavī"@en .

aat:300447043 a skos:Concept ;
    skos:definition "In Indian architecture, a pointed star-shaped division at the bhadra position."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhadra-pallavīs"@en .

aat:300447044 a skos:Concept ;
    skos:definition "In Indian architecture, a portion of a vine (decoration)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vallī-khaṇḍa"@en .

aat:300447045 a skos:Concept ;
    skos:definition "In sculpture or architectural figures, the mudra or posture of administering a slap."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "capēṭamudrā"@en .

aat:300447047 a skos:Concept ;
    skos:definition "A posture of sitting on haunches."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "utkuṭikāsana"@en .

aat:300447048 a skos:Concept ;
    skos:definition "In Indian architecture, wall base moldings that have a curved shoulder like an inverted pot; vēdībandha’s second moulding in the sequence of five."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kumbhas"@en .

aat:300447049 a skos:Concept ;
    skos:definition "In Indian architecture, a pōtikā-type with carved or painted central band at its acute-angled soffit."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "citra-pōtikā"@en .

aat:300447050 a skos:Concept ;
    skos:definition "In Indian architecture, a Prakrit form of caitya."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cētiya"@en .

aat:300447051 a skos:Concept ;
    skos:definition "In Indian architecture, a Prakrit form of caityagṛha."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "cētiyaghara"@en .

aat:300447052 a skos:Concept ;
    skos:definition "In Indian architecture, a prati-kaṇṭha of a base bearing end-makaras and vyāla figure(s) between."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mēṣa-makara-mālā"@en .

aat:300447053 a skos:Concept ;
    skos:definition "In Indian architecture, a prati-kaṇṭha of a base bearing end-makaras and vyāla figure(s) between."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mēṣa-makara-paṭṭikā"@en .

aat:300447054 a skos:Concept ;
    skos:definition "In Indian architecture, a prati-kaṇṭha of the temple’s base or of hāra-base bearing makara-figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "nakrapaṭṭikā"@en .

aat:300447055 a skos:Concept ;
    skos:definition "In Indian architecture, a principal gate; main gate."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mahādvāra"@en .

aat:300447056 a skos:Concept ;
    skos:definition "In Indian architecture, the principal horizontal and vertical divisions of a temple structure. Included are karṇa, pratiratha, bhadra, etc. in the plan, and also referencing the adhiṣṭhāna-base, bhitti-wall, uttara-entablature, and tala-stories."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "aṅgas"@en .

aat:300447057 a skos:Concept ;
    skos:definition "In Indian architecture, a principal spire in Śēkharī/Anēkāṇḍaka śikhara; mūlaśṛṅga; principal tower; central spire of an Anēkāṇḍaka (Nāgara) śikhara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mūlamañjarī"@en .

aat:300447058 a skos:Concept ;
    skos:definition "In Indian architecture, a projecting central part of ornate threshold (doorsill), usually round, rarely square."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mandāraka"@en .

aat:300447059 a skos:Concept ;
    skos:definition "In Indian architecture, a projecting upper band (South India)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vājanapaṭṭī"@en .

aat:300447060 a skos:Concept ;
    skos:definition "In Indian architecture, a projecting upper band (South India); above kampa or paṭṭikā; fillet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vājana"@en .

aat:300447061 a skos:Concept ;
    skos:definition "In Indian architecture, a pyramidal roof."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sūcika"@en .

aat:300447062 a skos:Concept ;
    skos:definition "Quarter-spirelet in the composition of Anēkāṇḍaka śikhara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "naṣṭaśṛṅga"@en .

aat:300447063 a skos:Concept ;
    skos:definition "In Indian architecture, a rafter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lupā"@en .

aat:300447064 a skos:Concept ;
    skos:definition "In Indian architecture, a rail or seat-back ornamented with fencing and sometimes with elephant-head design at the base; sometimes vēdī, sometimes kakṣāsana; balustered dado (formed by rājasēna, vēdikā, āsanapaṭṭa, sometimes inclusive of the kakṣāsana above); older examples in a few cases show varana (elephant) figures; (in a restricted sense); vēdikā-enclosure."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "mattavāraṇa"@en .

aat:300447066 a skos:Concept ;
    skos:definition "In Indian architecture, a raised terrace in front of a door; vestibule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "dēhalī"@en .

aat:300447067 a skos:Concept ;
    skos:definition "In Indian architecture, a ram-based column-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Mēṣapāda"@en .

aat:300447068 a skos:Concept ;
    skos:definition "In Indian architecture, a rampart; surrounding wall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kōṭa"@en .

aat:300447069 a skos:Concept ;
    skos:definition "In Indian architecture, the recess between major moldings. Examples are often found between kalaśa and kapōtapālī in pīṭha; also, may be inserted between two courses of kapōtapālī in varaṇḍikā/prahāra below the śikhara. May be decorated with the kuñjarākṣa pattern."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antarapaṭṭa"@en .

aat:300447070 a skos:Concept ;
    skos:definition "In Indian architecture, a recess between moldings."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "antari"@en .

aat:300447071 a skos:Concept ;
    skos:definition "In Indian architecture, a recess between two vertical bays; salilāntara."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "jalāntara"@en .

aat:300447072 a skos:Concept ;
    skos:definition "In Indian architecture, a recess between wall-bays."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "salilāntara"@en .

aat:300447073 a skos:Concept ;
    skos:definition "In Indian architecture, a recess carved with figures in a ceiling."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rūpakaṇṭha"@en .

aat:300447074 a skos:Concept ;
    skos:definition "In Indian architecture, a recessed band; antarapaṭṭa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "galapaṭṭī"@en .

aat:300447075 a skos:Concept ;
    skos:definition "In Indian architecture, a recessed moulding (antarita) with patti-band above; often bearing makara and vyāla figures; kaṇṭha with prati moulding above."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prati-kaṇṭha"@en .

aat:300447076 a skos:Concept ;
    skos:definition "In Indian architecture, a recessed moulding followed by a projecting band."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kaṇṭha-paṭṭikā"@en .

aat:300447078 a skos:Concept ;
    skos:definition "In Indian architecture, a rectangular belt bearing vine design, occurring below kumbha (Kaliṅga); khura."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "khurapaṭṭī"@en .

aat:300447079 a skos:Concept ;
    skos:definition "In Indian architecture, a rectangular chamber, room, or hall; nave; rectangular hall with wagon-vault roof; miniature śālā-shaped aedicula in the hāra; aedicule of wagon-vault vimāna (or hall); oblong hall; rectangular barrel-vaulted aedicule."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "śālā"@en .

aat:300447080 a skos:Concept ;
    skos:definition "In South Indian architecture, a rectangular fillet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kampa"@en .

aat:300447081 a skos:Concept ;
    skos:definition "In Indian architecture, a rectangular hall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabhā"@en .

aat:300447082 a skos:Concept ;
    skos:definition "In Indian architecture, a rectangular miniature shrine."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kūṭāgāraśālā"@en .

aat:300447083 a skos:Concept ;
    skos:definition "In Indian architecture, a rectangular vaulted roof without gables; rectangular, keel-roofed śikhara-type (without gable-ends)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "sabhākāra"@en .

aat:300447084 a skos:Concept ;
    skos:definition "In Indian architecture, a rectangular wagon-vault śikhara; temple type with barrel-vaulted superstructure; temple-type with śālā-śikhara; rafter-ends."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valabhī"@en .

aat:300447085 a skos:Concept ;
    skos:definition "In Hinduism and Buddhism, regents or guardians of one of the four principal quarters."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "lōkapālas"@en .

aat:300447086 a skos:Concept ;
    skos:definition "In Indian architecture, relative unit of measurement for establishing the proportions of the maṇḍapa."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "paṅkti"@en .

aat:300447087 a skos:Concept ;
    skos:definition "In Indian architecture, a register of vyālas."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vyālavarī"@en .

aat:300447088 a skos:Concept ;
    skos:definition "In Indian architecture, a register of vyālas; vyāla frieze; band of vyāla figures."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vyālapaṭṭī"@en .

aat:300447089 a skos:Concept ;
