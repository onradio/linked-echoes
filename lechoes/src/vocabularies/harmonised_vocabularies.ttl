mimo:3666 a skos:Concept ;
    skos:altLabel "Geomungo"@zh,
        "Harfen-zither"@zh,
        "Humle"@zh,
        "Komungo"@zh ;
    skos:definition "The geomungo (also spelled komungo or kŏmun'go) or hyeongeum (literally \"black zither\", also spelled hyongum or hyŏn'gŭm) is a traditional Korean plucked zither with both bridges and frets. Geomungo is a representative stringed instrument made in Goguryeo before the 5th century. Scholars believe that the name refers to Goguryeo and translates to \"Goguryeo zither\" or that it refers to the colour and translates to \"black crane zither\" (hyeonhakgeum, 현학금 / 玄鶴琴)."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Komungo"@ca,
        "Komunko"@de,
        "Komun'go"@en,
        "Komungo"@es,
        "Komun'go"@fr,
        "Komun'go"@it,
        "Komun'go"@nl,
        "Komun'go"@pl,
        "Komun'go"@sv,
        "韩国玄琴"@zh .

mimo:3668 a skos:Concept ;
    skos:altLabel "Gakuso"@zh,
        "Hummel"@zh,
        "Ichi gen kin"@zh,
        "Ichigenkin"@zh,
        "Jushichigen"@zh,
        "Ngyela"@zh,
        "So"@zh,
        "Takigoto"@zh,
        "Tanso"@zh,
        "长扁琴"@zh ;
    skos:definition "The koto (箏) is a Japanese plucked half-tube zither instrument, and the national instrument of Japan. It is derived from the Chinese zheng and se, and similar to the Mongolian yatga, the Korean gayageum and ajaeng, the Vietnamese đàn tranh, the Sundanese kacapi and the Kazakhstan jetigen. Koto are roughly 180 centimetres (71 in) in length, and made from Paulownia wood (Paulownia tomentosa, known as kiri). The most common type uses 13 strings strung over movable bridges used for tuning, different pieces possibly requiring different tuning. 17-string koto are also common, and act as bass in ensembles. Koto strings are generally plucked using three fingerpicks (tsume), worn on the first three fingers of the right hand."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Koto"@ca,
        "Koto"@de,
        "Koto"@en,
        "Koto"@es,
        "Koto"@fr,
        "Koto"@it,
        "Koto"@nl,
        "Koto"@pl,
        "Koto"@sv,
        "日本筝"@zh .

