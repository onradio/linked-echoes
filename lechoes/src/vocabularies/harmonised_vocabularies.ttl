    skos:inScheme lev:aat ;
    skos:prefLabel "kōṣṭha"@en .

aat:300446940 a skos:Concept ;
    skos:definition "In Indian art and architecture, a nimbus, or halo."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prabhāvalī"@en .

aat:300446941 a skos:Concept ;
