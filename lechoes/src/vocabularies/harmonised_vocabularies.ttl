    skos:inScheme lev:mimo ;
    skos:prefLabel "Cheng"@ca,
        "Cheng"@de,
        "Cheng"@en,
        "Cheng"@es,
        "Cheng"@fr,
        "Cheng"@it,
        "Cheng"@nl,
