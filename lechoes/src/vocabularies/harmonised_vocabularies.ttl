euf:11197 a skos:Concept ;
    skos:altLabel "precious metals"@en ;
    skos:definition "Metal considered to have high intrinsic value, such as gold, silver, and platinum; traditionally used to make such objects as jewelry and coins (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Edelmetall"@de,
        "πολύτιμο μέταλλο"@el,
        "precious metal"@en,
