mimo:3063 a skos:Concept ;
    skos:altLabel "Balafón"@es,
        "Bala"@zh,
        "Balafo"@zh,
        "Balafou"@zh,
        "Nkwanga"@zh,
        "Quiaquia"@zh,
        "Shekere"@zh ;
    skos:definition "The balafon (['bæləfɔ̃], [bɑlɑ'fɔ̃]; Bambara: ߓߟߊ bala) is a gourd-resonated xylophone, a type of struck idiophone. It is closely associated with the neighbouring Mandé, Senoufo and Gur peoples of West Africa, particularly the Guinean branch of the Mandinka ethnic group, but is now found across West Africa from Guinea to Mali. Its common name, balafon, is likely a European coinage combining its Mandinka name bala with the word fôn 'to speak' or the Greek root phono."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Balàfon"@ca,
        "Balafon"@de,
        "Balafon"@en,
        "Baláfono"@es,
        "Balafon"@fr,
        "Balafon"@it,
        "Balafoon"@nl,
