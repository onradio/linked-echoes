mimo:2745 a skos:Concept ;
    skos:altLabel "Maegubuk"@zh,
        "Tambourin"@zh ;
    skos:definition "The tambourin is a low-pitched tenor drum of Provence, which has also lent its name to a Provençal dance accompanied by lively duple meter music. The dance is so named because the music imitates the drum (tambour being a generic French term for \"drum\"), usually as a repetitive not-very-melodic figure in the bass."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Tamborí de Provença"@ca,
        "Tambourin de Provence"@de,
        "Tambourin de Provence"@en,
        "Tamboril de Provenza"@es,
        "Tambourin de Provence"@fr,
        "Tambourin de Provence"@it,
        "Tambourin de Provence"@nl,
        "Bęben prowansalski"@pl,
        "Tambourin de Provence"@sv,
        "普罗旺斯长鼓"@zh .

mimo:2746 a skos:Concept ;
    skos:altLabel "Tambour basque"@zh,
        "Tambour de Bearn"@zh,
        "Tambour de Gascogne"@zh,
        "Tambour de basque"@zh,
        "Tambourin de Bearn"@zh,
        "Tamburin"@zh ;
    skos:definition "The tambourine is a musical instrument in the percussion family consisting of a frame, often of wood or plastic, with pairs of small metal jingles, called \"zills\". Classically the term tambourine denotes an instrument with a drumhead, though some variants may not have a head. Tambourines are often used with regular percussion sets. They can be mounted, for example on a stand as part of a drum kit (and played with drum sticks), or they can be held in the hand and played by tapping or hitting the instrument."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Pandereta"@ca,
        "Tamburin"@de,
        "Tambourine"@en,
        "Pandereta"@es,
        "Tambourin"@fr,
        "Tamburello"@it,
        "Tamboerijn"@nl,
        "Tamburyn"@pl,
        "Tamburin"@sv,
        "铃鼓"@zh .

