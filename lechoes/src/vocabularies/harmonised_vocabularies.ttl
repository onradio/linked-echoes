        "Belgisk granit"@sv .

euf:11182 a skos:Concept ;
    skos:altLabel "limestones"@en ;
    skos:definition "General name for a sedimentary rock existing in many varieties, consisting primarily of calcite or dolomite (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
