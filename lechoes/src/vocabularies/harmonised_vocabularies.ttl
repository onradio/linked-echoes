    skos:inScheme lev:aat ;
    skos:prefLabel "ḍimḍima"@en .

aat:300446755 a skos:Concept ;
    skos:definition "In Indian architecture, khura, jagatī."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "kuḍapaḍai"@en .

aat:300446756 a skos:Concept ;
    skos:definition "In Indian architecture, the place for cooking food, the kitchen."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "agraśālā"@en .

aat:300446757 a skos:Concept ;
    skos:definition "In Indian architecture, a knife-edged arris moulding; minor karṇaka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karṇikā"@en .

aat:300446758 a skos:Concept ;
    skos:definition "In Indian architecture, a knife-edged moulding in a base; karṇaka."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "karṇāli"@en .

aat:300446759 a skos:Concept ;
    skos:definition "In Indian architecture, a kumbha moulding with highly concave curve."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vajrakumbha"@en .

aat:300446760 a skos:Concept ;
