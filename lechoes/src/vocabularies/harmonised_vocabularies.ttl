    skos:inScheme lev:aat ;
    skos:prefLabel "vēsara"@en .

aat:300446225 a skos:Concept ;
    skos:definition "In Indian architecture, a aedicula in the form of aṣṭavarga śālā."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "eruśalai"@en .

aat:300446226 a skos:Concept ;
    skos:definition "In Indian architecture, the aedicule of the wagon-vault building, located above the vimāna-wall’s bhadra in the hāra-parapet."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "bhadraśālā"@en .

aat:300446227 a skos:Concept ;
    skos:definition "In Indian architecture, elements providing passage, such as aisles or balconies."@en ;
    skos:inScheme lev:aat ;
