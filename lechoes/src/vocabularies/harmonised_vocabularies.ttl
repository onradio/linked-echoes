euf:10545 a skos:Concept ;
    skos:definition "Any of a large group of substances that typically show a characteristic luster, are good conductors of electricity and heat, are opaque, can be fused, and are usually malleable or ductile (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Metall"@de,
        "μέταλλο"@el,
        "metal"@en,
        "metal"@es,
        "métal"@fr,
        "מתכת"@he,
        "metallo"@it,
        "metaal"@nl,
        "metal"@pt,
        "metal"@sr,
        "metall"@sv .

euf:10546 a skos:Concept ;
    skos:altLabel "Au"@en ;
    skos:definition "Pure metallic element having symbol Au and atomic number 79; a soft, inert, shiny reddish yellow metal that is very malleable and ductile. Gold has been highly valued and found in artifacts dating to before 5000 BCE. Native gold, found in quartz veins (vein gold) and alluvial deposits (placer gold), generally contains some silver and copper. Gold is purified by dissolution in mercury or cyanide solutions, by melting, or by electrodeposition. The purity of commercial gold is expressed in karats which is the number of parts of gold in 24 parts of the alloy. Today gold is primarily used for monetary systems and for jewelry (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gold"@de,
        "χρυσός"@el,
        "gold"@en,
        "oro"@es,
        "or"@fr,
        "זהב"@he,
        "oro"@it,
        "goud"@nl,
        "ouro"@pt,
        "zlato"@sr,
        "guld"@sv .

euf:10547 a skos:Concept ;
    skos:altLabel "Ag"@en ;
    skos:definition "Pure metallic element having symbol Ag and atomic number 47; a malleable, ductile, white metal with characteristic sheen, considered a precious metal. Silver is widely distributed throughout the world, occurring rarely as metallic silver (in Peru, Norway) but more often as silver-gold alloys and silver ore. Today silver is obtained as a byproduct in the refinement of gold, lead, copper, or zinc ores. Silver was smelted from the ore galena as early as 3800 BCE. As a pure metal, silver is second to gold in malleability and ductility, can be polished to a highly reflective surface, and used -- typically in an alloy -- in jewelry, coinage, photography, mirrors, electrical contacts, and tableware (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Silber"@de,
        "ασήμι"@el,
        "silver"@en,
        "plata"@es,
        "argent"@fr,
        "כסף"@he,
        "argento"@it,
        "zilver"@nl,
        "prata"@pt,
        "srebro"@sr,
        "silver"@sv .

euf:10548 a skos:Concept ;
    skos:altLabel "Cu"@en ;
    skos:definition "Pure metallic element having the symbol Cu and atomic number 29; a reddish brown, ductile metal that is present in the earth's crust, occurring as a native metal and as ores of sulfide, sulfate and carbonate (azurite, malachite, etc.). It was the first metal used by humans, probably from about 8000 BCE, in the regions of Mesopotamia and India. By about 3800 BCE copper was made into bronze for weapons and knives. Today, copper is one of the most widely used metals because it has high electrical and thermal conductivity, can be easily fabricated, is ductile and polishes well. In moist air, copper forms a protective green film of basic carbonate. Metallic copper combines well with other metals to form alloys, most commonly brass and bronze. Copper and its alloys are used for wire, electrical devices, pipes, cooking vessels, ammunition, ornamental trim, roofing, grillwork, coins, musical instruments, jewelry, and sculptures (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kupfer"@de,
        "χαλκός"@el,
        "copper"@en,
        "cobre"@es,
        "cuivre"@fr,
        "נחושת"@he,
        "rame"@it,
        "koper"@nl,
        "cobre"@pt,
        "bakar"@sr,
        "koppar"@sv .

euf:10549 a skos:Concept ;
    skos:definition "Any of various hard, strong, durable, malleable alloys of iron and carbon, often with other elements such as manganese, chromium, nickel, molybdenum, copper, tungsten, cobalt, or silicon; widely used as a structural material (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stahl"@de,
        "ατσάλι"@el,
        "steel"@en,
        "acero"@es,
        "acier"@fr,
        "פלדה"@he,
        "acciaio"@it,
        "staal"@nl,
        "aço"@pt,
        "čelik"@sr,
        "stål"@sv .

euf:10550 a skos:Concept ;
    skos:altLabel "Al"@en,
        "aluminum"@en ;
    skos:definition "Pure metallic element having symbol Al and atomic number 13; a hard, strong, silver white metal. This metal is also processed and formed, usually in combination with other substances, to make objects and materials (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Aluminium"@de,
        "αλουμίνιο"@el,
        "aluminium"@en,
        "aluminio"@es,
        "aluminium"@fr,
        "אלומיניום"@he,
        "alluminio"@it,
        "aluminium"@nl,
        "alumínio"@pt,
        "aluminijum"@sr,
        "aluminium"@sv .

euf:10551 a skos:Concept ;
    skos:altLabel "Sn"@en,
        "beli lim"@sr ;
    skos:definition "Pure metallic element having symbol Sn and atomic number 50; a soft, pliable, silvery white metal. Use also for this metal as processed and formed, usually in combination with other substances, to make various objects and materials (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Zinn"@de,
        "τσίγκος"@el,
        "tin"@en,
        "estaño"@es,
        "étain"@fr,
        "בדיל"@he,
        "stagno"@it,
        "tin"@nl,
        "estanho"@pt,
        "kalaj"@sr,
        "tenn"@sv .

euf:10552 a skos:Concept ;
    skos:altLabel "Fe"@en ;
    skos:definition "Pure metallic element having symbol Fe and atomic number 26; metallic iron is silvery in color, lustrous, soft, ductile, malleable, and slightly magnetic; it rusts when exposed to moist air. It is rarely found as a native metal (telluric iron) except in meteorites (meteoric iron). Iron is most often found throughout the world as iron oxides (hematite, magnetite, limonite, and siderite) mixed with other ores (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Eisen"@de,
        "σίδερο"@el,
        "iron"@en,
        "hierro"@es,
        "fer"@fr,
        "מגהץ"@he,
        "ferro"@it,
        "ijzer"@nl,
        "ferro"@pt,
        "gvožđe"@sr,
        "järn"@sv .

euf:10553 a skos:Concept ;
    skos:definition "Pure metallic element having symbol Pb and atomic number 82; soft, dense ductile metal of a dull gray color, shiny when freshly cut, occuring naturally most often as a sulfide in the mineral galena. Other lead minerals include anglesite (lead sulfate) and cerussite (lead carbonate). Native metallic lead was found and used from about 3600-2600 BCE when the technique for obtaining lead from roasting the sulfide ore (galena) was discovered. Lead was used to make small cast items such as coins and statuettes, plumbing pipes, spires, statues, cisterns, gargoyles, pigments (lead white, litharge, orange mineral, etc.), as a component in pottery glazes, for roofing, flashing, stained glass windows, as a soft solder, and as radiation shielding (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Blei"@de,
        "μόλυβδος"@el,
        "lead"@en,
        "plomo"@es,
        "plomb"@fr,
        "עופרת"@he,
        "piombo"@it,
        "lood"@nl,
        "chumbo"@pt,
        "olovo"@sr,
        "bly"@sv .

euf:10554 a skos:Concept ;
    skos:altLabel "Cr"@en,
        "chromium"@en ;
    skos:definition "Pure metallic element having symbol Cr and atomic number 24; an extremely hard, silvery white metal with a bluish tinge. Use also for the metal as processed and formed, usually in combination with other substances, to make various objects and materials, notably stainless steel, heat-resistant alloy, high-strength alloy steel, and for wear-resistant electroplating (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Chrom"@de,
        "χρώμιο"@el,
        "chrome"@en,
        "cromo"@es,
        "chrome"@fr,
        "כרום"@he,
        "cromo"@it,
        "chroom"@nl,
        "cromo"@pt,
        "hrom"@sr,
        "krom"@sv .

euf:10555 a skos:Concept ;
    skos:altLabel "azófar"@es,
        "geelkoper"@nl ;
    skos:definition "Alloy of copper and zinc, usually with copper as the major alloying element and zinc up to 40% by weight. For an alloy consisting mainly of copper, combined most often with tin, but at times also with other metals, use bronze (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Messing"@de,
        "ορείχαλκος"@el,
        "brass"@en,
        "latón"@es,
        "laiton"@fr,
        "פליז"@he,
        "ottone"@it,
        "messing"@nl,
        "latão"@pt,
        "mesing"@sr,
        "mässing"@sv .

euf:10556 a skos:Concept ;
    skos:definition "Refers to a broad range of alloys of copper, specifically any non-ferrous alloy of copper, tin, and zinc or other trace metals. Bronze was made before 3,000 BCE -- possibly as early as 10,000 BCE, although its common use in tools and decorative items is dated only in later artifacts. The proportions of copper and tin vary widely, from 70 to 95 percent copper in surviving ancient artifacts. Because of the copper base, bronze may be very malleable and easy to work. By the Middle Ages in Europe, it was recognized that using the metals in certain proportions could yield specific properties. Some modern bronzes contain no tin at all, substituting other metals such as aluminum, manganese, and even zinc. Historically, the term was used interchangeably with latten. U.S. standard bronze is composed of 90% copper, 7% tin and 3% zinc. Ancient bronze alloys sometimes contained up to 14% tin (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Bronze"@de,
        "μπρούντζος"@el,
        "bronze"@en,
        "bronce"@es,
        "bronze"@fr,
        "ברונזה"@he,
        "bronzo"@it,
        "brons"@nl,
        "bronze"@pt,
        "bronza"@sr,
        "brons"@sv .

euf:10557 a skos:Concept ;
    skos:definition "An amorphous, inorganic substance made by fusing silica (silicon dioxide) with a basic oxide; generally transparent but often translucent or opaque. Its characteristic properties are its hardness and rigidity at ordinary temperatures, its capacity for plastic working at elevated temperatures, and its resistance to weathering and to most chemicals except hydrofluoric acid. Used for both utilitarian and decorative purposes, it can be formed into various shapes, colored or decorated. Glass originated as a glaze in Mesopotamia in about 3500 BCE and the first objects made wholly of glass date to about 2500 BCE (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Glas"@de,
        "γυαλί"@el,
        "glass"@en,
        "vidrio"@es,
        "verre"@fr,
        "זכוכית"@he,
        "vetro"@it,
        "glas"@nl,
        "vidro"@pt,
        "staklo"@sr,
        "glas"@sv .

euf:10558 a skos:Concept ;
    skos:definition "Objects with a highly polished surface, often framed, which are designed to reflect images (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Spiegel (Dekorationsmaterial)"@de,
        "καθρέφτης (Υλικό διακόσμησης)"@el,
        "mirror (decoration material)"@en,
        "espejo (material de decoración)"@es,
        "miroir (matériel de décoration)"@fr,
        "ראי / מראה (חומרי קישוט)"@he,
        "specchio (materiale per decorazioni)"@it,
        "spiegel"@nl,
        "ogledalo (materijal za dekoraciju)"@sr,
        "spegelgals (dekorationsmaterial)"@sv .

euf:10559 a skos:Concept ;
    skos:altLabel "Kautschuk"@de,
        "caucho"@es ;
    skos:definition "A natural hydrocarbon polymer formed from the resinous latex of trees of the Hevea and Parthenium genera. To prepare natural rubber, the latex is collected from a cut in the bark, precipitated with acid, then washed and dried. Rubber is very elastic and was used for bowls, shoe soles, adhesives, and bouncy balls. However, when cooled, rubber becomes brittle and when warmed it becomes sweaty and tacky. Prior to the development of synthetic resins, unvulcanized rubber was used for adhesive tapes and crepe shoe soles. In 1839, Charles Goodyear discovered that rubber can be hardened with the vulcanization process in which sulfur is used to initiate crosslinking of the hydrocarbon strands. Higher sulfur content produces a harder, denser material. Vulcanized rubber is used to make rubber bands, foams, fabric coatings, small objects, combs, pens, and musical instruments. Vulcanized rubber, however, will emit sulfur when exposed to light or heat causing the rubber to degrade and become brittle. Since the 19th century, small amounts of wax have been added to the rubber during vulcanization. The wax slowly migrates to the surface and provides a thin layer of protection from oxidation (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gummi"@de,
        "λάστιχο"@el,
        "rubber"@en,
        "goma"@es,
        "caoutchouc"@fr,
        "גומי"@he,
        "gomma"@it,
        "rubber"@nl,
        "guma"@sr,
        "gummi"@sv .

euf:10560 a skos:Concept ;
    skos:altLabel "Ebonit"@de,
        "Hartkautschuk"@de,
        "vulcanite"@en,
        "hardrubber"@nl,
        "vulcaniet"@nl ;
    skos:definition "Vulcanite is as an old trade name for a dark, brittle, moldable hard rubber that was produced by heating (‘vulcanizing') a preparation of india rubber and sulfur. It was marketed in the U.S. as vulcanite and in England as ebonite. Vulcanite was used for small items such as buttons, brooches, and combs, finishes on camera bodies, and for insulation (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Hartgummi"@de,
        "εβονίτης"@el,
        "ebonite"@en,
        "ebonita"@es,
        "ébonite"@fr,
        "הבנית"@he,
        "ebanite"@it,
        "eboniet"@nl,
        "ebonite"@pt,
        "ebonit"@sr,
        "ebonit"@sv .

euf:10561 a skos:Concept ;
    skos:definition "General term for rock that has been cut, shaped, crushed, or otherwise formed for use in construction or other purposes. Includes the specific archaeological and anthropological sense of individual stones which may be decorated or ornamented and which may be used in ritual contexts. These are usually not carved or dressed, and so differ from sculptures made from stone (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stein"@de,
        "πέτρα"@el,
        "stone"@en,
        "piedra"@es,
        "pierre"@fr,
        "אבן"@he,
        "pietra"@it,
        "steen"@nl,
        "pedra"@pt,
        "kamen"@sr,
        "sten"@sv .

euf:10562 a skos:Concept ;
    skos:altLabel "Aventurin-Quarz"@de,
        "aventurine"@en,
        "aventurijn"@nl ;
    skos:definition "A quartz mineral that contains shiny flecks of mica. Aventurine is usually green but can also be orange or reddish-brown. It is sometimes used as an inexpensive alternative to jade. Most aventurine comes from Russia, India, and Brazil. A synthetic imitation, aventurine glass, is used for costume jewelry under the name goldstone. Aventurine is also sometimes incorrectly called Chinese jade or Indian jade (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Aventurin"@de,
        "αβεντουρίνη"@el,
        "venturine"@en,
        "venturina"@es,
        "aventurine"@fr,
        "אבקת זהב"@he,
        "avventurina"@it,
        "aventurien"@nl,
        "venturin"@sr,
        "aventurin"@sv .

euf:10563 a skos:Concept ;
    skos:altLabel "Jet"@de,
        "Jett"@de,
        "jet"@nl ;
    skos:definition "A dense, black, semiprecious form of lignite that takes a brilliant polish and is used ornamentally, particularly in Victorian mourning jewelry (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gagat"@de,
        "λιγνίτης"@el,
        "jet"@en,
        "azabache"@es,
        "jais"@fr,
        "סילון"@he,
        "giaietto"@it,
        "git"@nl,
        "azeviche"@pt,
        "gagat"@sr,
        "gagat"@sv .

euf:10564 a skos:Concept ;
    skos:altLabel "ג'ייד"@he,
        "pleister"@nl ;
    skos:definition "Refers to a soft, plastic material that can be spread or daubed on a wall, ceiling, or other surface, where it afterwards hardens. In the context of art and architecture, it generally refers specifically to a mixture of water, lime, and sand, often combined with other materials, such as animal hair, to give the resulting material strength, texture, and if the surface is to be painted, porosity (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Gips"@de,
        "γύψος"@el,
        "plaster (composite coating)"@en,
        "escayola"@es,
        "plâtre"@fr,
        "גבס"@he,
        "gesso"@it,
        "gips (composiet coating)"@nl,
        "gesso"@pt,
        "gips"@sr,
        "gips"@sv .

euf:10565 a skos:Concept ;
    skos:altLabel "ceramic material"@en,
        "חרס"@he,
        "keramisch (materiaal)"@nl ;
    skos:definition "Refers to any of various hard, brittle, heat-resistant and corrosion-resistant materials made by shaping and then firing a nonmetallic mineral, such as clay, at a high temperature (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Keramik"@de,
        "κεραμικά"@el,
        "ceramic (material)"@en,
        "cerámica"@es,
        "céramique"@fr,
        "קרמיקה"@he,
        "ceramica"@it,
        "keramiek"@nl,
        "cerâmica"@pt,
        "keramika"@sr,
        "keramik"@sv .

euf:10566 a skos:Concept ;
    skos:definition "A material comprising white clay, or kaolin, and a feldspathic rock, that react when fired so the clay serves to hold the shape of the object and the rock fuses into a natural glass. In China, it includes any such ware that is highly fired enough to produce a ringing sound when struck. In Europe, it is limited to hard-fired ceramic that is translucent (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Porzellan"@de,
        "πορσελάνη"@el,
        "porcelain (material)"@en,
        "porcelana"@es,
        "porcelaine"@fr,
        "חרסינה"@he,
        "porcellana"@it,
        "porselein (materiaal)"@nl,
        "porcelana"@pt,
        "porcelan"@sr,
        "porslin"@sv .

euf:10567 a skos:Concept ;
    skos:altLabel "Speisestärke"@de ;
    skos:definition "Substance made of carbohydrate granules of varying sizes obtained from roots, bulbs, and seeds of most plants. Starch is primarily obtained from rice, wheat, corn, potatoes, cassava (tapioca), sago, and arrowroot. It is a mixture of the soluble straight-chain amylose molecules and the insoluble, branched-chain amylopectin molecules. When starch is heated, the granules swell and form a thick, tacky jelly upon cooling. Starchy adhesives have been used since at least 3500 BCE in Egypt. More recently starch has been used for sizing fabric, canvas, and paper, as an adhesive for paper cartons, bottle labels, gummed tape, and envelopes. Soluble starch has been used for priming canvas and as a binder in watercolor paints. Starch is sensitive to moisture and biodegradation. Starchy paste films become brittle with age (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Stärke"@de,
        "άμυλο"@el,
        "starch"@en,
        "almidón"@es,
        "amidon"@fr,
        "עמילן"@he,
        "amido"@it,
        "stijfsel"@nl,
        "amido"@pt,
        "skrob"@sr,
        "stärkelse"@sv .

euf:10568 a skos:Concept ;
    skos:altLabel "paste"@en,
        "rhinestones"@en,
        "strass"@en,
        "rijnsteen"@nl ;
    skos:definition "A colorless artificial gem of paste or glass, often with facets that sparkle in imitation of a diamond. Also refers to foil-backed or silvered cut glass used to imitate diamonds. Rhinestones were originally quartz pebbles found in the Rhine River, thus the name (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Strass"@de,
        "στρας"@el,
        "rhinestone"@en,
        "estrás"@es,
        "strass"@fr,
        "יהלומים מלאכותיים (ריינסטון)"@he,
        "diamante artificiale"@it,
        "stras"@nl,
        "štras"@sr,
        "strass"@sv .

euf:10569 a skos:Concept ;
    skos:altLabel "Glas"@de,
        "Quarz"@de ;
    skos:definition "A solid body having a characteristic internal structure and enclosed by systematically arranged plane surfaces (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kristall"@de,
        "κρύσταλλο"@el,
        "crystal (material by form)"@en,
        "cristal"@es,
        "cristal"@fr,
        "בדולח"@he,
        "cristallo"@it,
        "kristal (materiaal naar vorm)"@nl,
        "cristal"@pt,
        "kristal"@sr,
        "kristall"@sv .

euf:10570 a skos:Concept ;
    skos:definition "A semi-transparent or opaque vitreous, porcelain-like coating applied by fusion to metal, glass, or ceramic, having a glossy appearance after hardening. Enamel is typically made from powdered fusible glasses (e.g., quartz, feldspar, clay, soda, and borax) and opaque colorants (e.g., cobalt blue, tin oxide) mixed with oil or water, then painted or sprayed on the object and fired up to 800 C. Enamel is used to protect a surface, to decorate objects in various colors and patterns, to form a surface for encaustic painting, and for other purposes (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Emaille"@de,
        "σμάλτο"@el,
        "enamel (fused coating)"@en,
        "esmalte"@es,
        "émail"@fr,
        "אמייל"@he,
        "smalto"@it,
        "email(lak)"@nl,
        "emajl"@sr,
        "emalj"@sv .

euf:10572 a skos:Concept ;
    skos:altLabel "Pappe"@de,
        "kartong"@sv ;
    skos:definition "A type of stiff pasteboard that is thicker than 0.006 inches, typically consisting of good-quality chemical pulp or rag pasteboard, and varying greatly in type and stability. High quality archival cardboard is made from rag pulp and has a low acid content, used for mounting prints, drawings and watercolors. Other grades of cardboard is used for cards, signs, printed materials, and high-quality boxes. Inferior grades of cardboard, such as corrugated board, are made from coarsely ground sulfite treated wood pulp; for this board, use corrugated board. The first carboard box was produced in England in 1817. Corrugated cardboard was patented in 1871 (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Karton"@de,
        "χαρτόνι"@el,
        "cardboard"@en,
        "cartulina"@es,
        "carton"@fr,
        "קרטון"@he,
        "cartone"@it,
        "karton"@nl,
        "karton"@sr,
        "papp"@sv .

euf:10573 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Papier auf Karton"@de,
        "paper on cardboard"@el,
        "paper on cardboard"@en,
        "papel sobre cartón"@es,
        "papier cartonné"@fr,
        "נייר על קרטון"@he,
        "carta su cartone"@it,
        "papier op karton"@nl,
        "papir na kartonu"@sr,
        "kartong"@sv .

euf:10574 a skos:Concept ;
    skos:definition "Refers generally to all types of thin matted or felted sheets or webs of fiber formed and dried on a fine screen from a pulpy water suspension. The fibers may be animal, such as hair, silk or wool, or mineral, such as asbestos, or synthetic. However most paper is made from cellulosic plant fiber, such as from wood pulp, grass, cotton, linen, and straw (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Papier"@de,
        "χαρτί"@el,
        "paper"@en,
        "papel"@es,
        "papier"@fr,
        "נייר"@he,
        "carta"@it,
        "papier"@nl,
        "papel"@pt,
        "papir"@sr,
        "papper"@sv .

euf:10575 a skos:Concept ;
    skos:altLabel "Papiermaché"@de,
        "paper-mache"@en,
        "papier mache"@en,
        "papier mâché"@en ;
    skos:definition "Composite material used for molding objects; made of repulped or pulverized paper and a liquid adhesive binder. May also comprise strips of paper, sometimes reinforced with textiles, stuck together with a wet adhesive, and used to form an object. The object becomes solid when the paste dries; the object may then be sanded, lacquered, and painted. Such objects are very durable; they first developed in Asia and were common in Europe and elsewhere since the 17th century (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Papiermaschee"@de,
        "πεπιεσμένο χαρτί"@el,
        "papier-mâché"@en,
        "papel maché"@es,
        "papier mâché"@fr,
        "עיסת נייר"@he,
        "cartapesta"@it,
        "papier-maché"@nl,
        "papel machê"@pt,
        "papir maše"@sr,
        "papier-maché"@sv .

euf:10576 a skos:Concept ;
    skos:altLabel "papier mousseline"@fr ;
    skos:definition "A thin, translucent paper that may be loosely felted to make it absorbent or it may have a hard, smooth surface making it an excellent wrapping paper. It is primarily used for packing, wrapping, or protecting delicate items (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Seidenpapier"@de,
        "χαρτομάντιλο"@el,
        "tissue paper"@en,
