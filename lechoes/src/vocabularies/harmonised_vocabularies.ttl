euf:10853 a skos:Concept ;
    skos:altLabel "Brücke"@de,
        "Läufer"@de,
        "מרבד"@he ;
    skos:definition "Heavy woven textiles used for a variety of utilitarian purposes essentially in the form in which they left the loom. In Western societies they are used primarily as floor coverings (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Vorleger"@de,
        "χαλί"@el,
        "rug"@en,
        "tapis"@fr,
        "שטיח"@he,
        "tappeto"@it,
        "tapijt"@nl,
        "ćilim"@sr,
        "matta"@sv .

euf:10854 a skos:Concept ;
    skos:altLabel "מרבד"@he,
        "vävtapet"@sv ;
    skos:definition "Heavy, woven textiles used as wall hangings, curtains, upholstery, or to hang from windows or balconies. Tapestries are characterized by decoration that may include ornamental or pictorial subjects; they often have details that are painted or embroidered. They are usually of wool and hand-woven on a tapestry loom by a process that differs from cloth-weaving in that the weft travels only to the warp at the edge of a particular color or pattern in the design, rather traveling from edge to edge of the entire piece of fabric. Various techniques are used in mixing and overlaying colors to create shading and patterns. The term also refers to machine-woven imitations of hand-made hangings (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Wandteppich"@de,
        "ταπετσαρία"@el,
        "tapestry"@en,
        "tapisserie"@fr,
        "שטיח קיר"@he,
        "arazzo"@it,
        "wandtapijt"@nl,
        "tapiserija"@sr,
        "gobeläng"@sv .

euf:10855 a skos:Concept ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "künstliches Schlangenleder"@de,
        "απομίμηση δέρματος φιδιού"@el,
        "synthetic snakeskin"@en,
        "peau de serpent synthétique"@fr,
        "עור נחש סיתטי"@he,
        "pelle di serpente sintetica"@it,
        "imitatieslangenleer"@nl,
        "sintetička zmijska koža"@sr,
        "ormskinnsimitation"@sv .

euf:10856 a skos:Concept ;
    skos:altLabel "Galalith"@de,
        "Milchstein"@de,
        "Erinoid"@en,
        "Galalith"@en,
        "Karolith"@en,
        "casein plastics"@en,
        "galalith"@en,
        "milkstone"@en,
        "פוליוויניל כלוריד"@he,
        "galaliet"@nl,
        "kunsthoorn"@nl ;
    skos:definition "Thermoplastic molding materials prepared from casein, a natural phosphorous-containing protein found in milk. While trying to make a waterproof coating in 1897, Adolph Spitteler and associate W. Krische of Germany discovered that casein becomes hard and insoluble when treated with formaldehyde. Casein plastics were used for small items such as buttons, beads, buckles, combs, fountain pens, umbrella handles, cutlery handles, and knitting needles; they are often pigmented to simulate ivory, horn, or tortoise shell (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Casein-Kunststoff"@de,
        "πλαστικό καζεΐνης"@el,
