euf:11122 a skos:Concept ;
    skos:definition "A fine-grained limestone, or soft, earthy form of calcium carbonate; used chiefly in putty, crayons, paint, rubber products, linoleum, and as a pigment and abrasive (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kreide"@de,
