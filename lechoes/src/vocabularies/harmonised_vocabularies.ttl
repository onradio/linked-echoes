euf:10728 a skos:Concept ;
    skos:definition "Pelts of a distinctive style, usually of sable or marten, commonly mounted with decorated heads and paws of crystal or gold ornamented with gems. Worn either around the neck and shoulders, suspended by a chain from a girdle, or carried in the hand. Popular in Europe during the 16th century; the name refers to the theory, probably erroneous, that the furs were used to attract fleas and lice away from the wearer. (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Pelzkragen"@de,
        "γιακάς γούνινος"@el,
        "fur collar"@en,
        "cuello de piel"@es,
        "col fourrure"@fr,
        "צווארון פרווה"@he,
        "colletto in pelliccia"@it,
        "bontkraag"@nl,
        "krznena kragna"@sr,
        "pälskrage"@sv .

euf:10729 a skos:Concept ;
    skos:altLabel "Tagesbekleidung"@de,
        "קולקצית ריזורט"@he,
        "kleding voor overdag"@nl,
        "streetwear"@sv ;
    skos:definition "Articles of clothing suitable for casual wear during the day, in contrast to formal wear suitable for evening events (AAT)."@en ;
