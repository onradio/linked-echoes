euf:10375 a skos:Concept ;
    skos:altLabel "Nessel"@de,
        "kaliko"@nl,
        "ongebleekt katoen"@nl ;
    skos:definition "Cotton textile, heavier than muslin, plain, dyed, or with patterns printed in one or more colors. In the 18th and 19th centuries, the term referred to printed, colored or plain cloth from India; now it refers generally to cotton prints with small, stylized patterns (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Kattun"@de,
        "τσίτι"@el,
        "calico"@en,
        "calicó"@es,
        "calicot"@fr,
        "כותנה"@he,
        "calicò"@it,
        "calico"@nl,
        "pano crú fino"@pt,
        "kaliko"@sr,
        "kalikå"@sv .

euf:10376 a skos:Concept ;
    skos:altLabel "Leinwand"@de,
        "canvas"@es,
        "canevas"@fr,
        "doek"@nl,
        "kanvas"@nl,
        "duk"@sv ;
    skos:definition "Closely woven textile made in various weights, usually of flax, hemp, jute, or cotton, used especially for sails, tarpaulins, awnings, upholstery, bags, and as a support for oil painting (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Canvas"@de,
        "καμβάς"@el,
        "canvas"@en,
        "lienzo"@es,
        "toile"@fr,
        "קנבס"@he,
        "tela olona"@it,
        "canvas"@nl,
        "tela"@pt,
        "platno"@sr,
        "kanvas"@sv .

euf:10377 a skos:Concept ;
    skos:altLabel "Chiffon"@de ;
    skos:definition "Sheer, lightweight plain-woven textile of fine, tightly-twisted yarn, originally of silk now also of various synthetic fibers, used, for example, for scarves, dresses, blouses, underwear, and veils (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Crêpe"@de,
        "σιφόν"@el,
        "chiffon"@en,
        "chiffon"@es,
        "mousseline de soie"@fr,
        "שיפון"@he,
        "chiffon"@it,
        "chiffon"@nl,
        "chiffon"@pt,
        "šifon"@sr,
        "chiffong"@sv .

euf:10379 a skos:Concept ;
    skos:altLabel "אריג כותנה מודפס בעל גימור מבריק"@he ;
    skos:definition "Lightweight textile made of various types of fiber, having a crinkled surface obtained by using hard twisted thread or yarn, by printing with caustic soda, by weaving with varied tensions, or by embossing (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Krepp"@de,
        "κρεπ"@el,
        "crepe (textile)"@en,
        "crespón"@es,
        "crêpe"@fr,
        "קרפ (בד)"@he,
        "crespo"@it,
        "crêpe (textiel)"@nl,
        "crepe"@pt,
        "krep"@sr,
        "crêpe"@sv .

euf:10380 a skos:Concept ;
    skos:altLabel "serge weave"@en,
        "twill weave"@en,
        "twill"@fr,
        "keper"@nl,
        "tvil"@sr,
        "twill"@sv ;
    skos:definition "Refers to a woven textile characterized by parallel diagonal ridges or ribs, produced by passing the weft threads over one and under two or more threads of the warp, instead of over and under in regular succession, as in plain weaving. Regular twill features a diagonal line that is repeated regularly, usually running from the left to right at a 45-degree angle and upward. The weave may be varied in several ways, including changing the angle or direction of the twill line, as exemplified in herringbone twill (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Köperbindung"@de,
        "δίμιτο"@el,
        "twill"@en,
        "sarga"@es,
        "serge"@fr,
        "אריג עם חיבור מלוכסן"@he,
        "tessuto spigato"@it,
        "keperweefsel"@nl,
        "sarja"@pt,
        "keper"@sr,
        "kypert"@sv .

euf:10381 a skos:Concept ;
    skos:altLabel "atlas (textielmateriaal)"@nl,
        "glanszijde"@nl ;
    skos:definition "Woven textile characterized by a basic binding system or weave with smooth, shiny surface formed by long warp floats. Generally, each warp end passes over four or more adjacent weft picks and under the next one (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Satin"@de,
        "σατέν"@el,
        "satin"@en,
        "raso"@es,
        "satin"@fr,
        "סאטן"@he,
        "raso"@it,
        "satijn"@nl,
        "cetim"@pt,
        "saten"@sr,
        "satin"@sv .

euf:10382 a skos:Concept ;
    skos:altLabel "damasserie (soie)"@fr ;
    skos:definition "Woven figured textile with one warp and one weft in which the pattern is formed by a contrast of binding systems, and appears on the face and the back in reverse positions (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Damast"@de,
        "δαμασκηνό"@el,
        "damask"@en,
        "damasco"@es,
        "damassé"@fr,
        "אריג דמשק"@he,
        "damasco"@it,
        "damast"@nl,
        "damasco"@pt,
        "damast"@sr,
        "sidendammast"@sv .

euf:10383 a skos:Concept ;
    skos:altLabel "Baumwoll-oder Leinendamast"@de,
        "damassé (coton ou lin)"@fr ;
    skos:definition "Figured woven textile having a damask-like appearance, with contrasting luster in the pattern and ground (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Baumwoll- oder Leinendamast"@de,
        "δαμασκηνό (βαμβακερό ή λινό)"@el,
