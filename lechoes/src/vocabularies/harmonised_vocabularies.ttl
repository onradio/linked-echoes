euf:10585 a skos:Concept ;
    skos:altLabel "μπαλένα"@el,
        "whalebone"@en,
        "osso di balena"@it,
        "baleinen"@nl,
        "kitova kost"@sr ;
    skos:definition "A horny keratinous substance that grows in the mouth of whales (AAT)."@en ;
