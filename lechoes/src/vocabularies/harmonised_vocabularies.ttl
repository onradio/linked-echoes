        "kokosovo vlakno"@sr,
        "kokosnötsfiber"@sv .

euf:10482 a skos:Concept ;
    skos:altLabel "piña"@en,
        "piña (fiber)"@en ;
    skos:definition "Long bast fibers obtained from the leaves of the species Ananas comosus, native to tropical America. The fibers are fine, soft, lustrous, and light cream in color. They are resistant to salt water, strong, wear resistant, and easy to clean; used for fabric, rope, twine, and paper (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Ananasfaser"@de,
