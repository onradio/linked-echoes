mimo:3435 a skos:Concept ;
    skos:definition "The sanshin (三線, lit., \"three strings\") is an Okinawan and Amami Islands musical instrument and precursor of the mainland Japanese shamisen (三味線). Often likened to a banjo, it consists of a snakeskin-covered body, neck and three strings."@en ;
    skos:inScheme lev:mimo ;
    skos:prefLabel "Sanshin"@ca,
        "Sanshin"@de,
        "Sanshin"@en,
        "Sanshin"@es,
        "Sanshin"@fr,
