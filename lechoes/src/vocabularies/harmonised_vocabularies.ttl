euf:10830 a skos:Concept ;
    skos:altLabel "Mustertuch"@de,
        "Probelappen"@de,
        "handwerkvoorbeeld"@nl ;
    skos:definition "Textile works, typically fine cloth embroidered by women or girls in various stitches and intended to be framed. They were usually created as demonstrations of a beginner's skill and featured a combination of stitches, motifs, letters, verses, and often the date of completion and the stitcher's name (AAT)"@en ;
