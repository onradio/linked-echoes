aat:300446911 a skos:Concept ;
    skos:definition "In Indian architecture, a type of mṛṇālikā."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "koḍuṅgai"@en .

aat:300446912 a skos:Concept ;
    skos:definition "In Indian architecture, a mukhamaṇḍapa; pillared entry hall."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "trika"@en .

aat:300446913 a skos:Concept ;
    skos:definition "In Indian architecture, works that have multiple spires, in the Nāgara śikhara style."@en ;
    skos:inScheme lev:aat ;
