aat:300446379 a skos:Concept ;
    skos:definition "In Indian architecture, a circular, compound pillar-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "miśra-rudrakānta"@en .

aat:300446380 a skos:Concept ;
    skos:definition "In Indian architecture, a circular/curved rafter."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "valikā"@en .

aat:300446381 a skos:Concept ;
    skos:definition "In Indian architecture, a circular/round śikhara-type."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "rudracchanda"@en .

aat:300446382 a skos:Concept ;
    skos:definition "In Indian architecture, being circular; having a circular shape (kumuda type; śikhara-type)."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "vṛtta"@en .

aat:300446383 a skos:Concept ;
    skos:definition "In Indian architectural contexts, a circularly disposed group of bh01utas."@en ;
    skos:inScheme lev:aat ;
