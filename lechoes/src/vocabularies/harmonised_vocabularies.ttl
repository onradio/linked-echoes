    skos:inScheme lev:aat ;
    skos:prefLabel "mūlaśṛṅga"@en .

aat:300446369 a skos:Concept ;
    skos:definition "In Indian architecture, a central, projecting face of a recessed bhadra."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "prabhadra"@en .

aat:300446370 a skos:Concept ;
    skos:definition "In Indian architecture, a chain of bells or chain interspersed with bells as a decorative motif."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "ghaṇṭāmālā"@en .

aat:300446371 a skos:Concept ;
