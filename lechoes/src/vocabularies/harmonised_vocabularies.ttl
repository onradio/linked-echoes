euf:11104 a skos:Concept ;
    skos:definition "Leather made from skin from deer or deer family animals from which the grain has been removed. Generally treated with animal oils, formaldehyde, or a combination of both. For unprocessed skin, use deerskin (AAT)"@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Wildleder"@de,
        "buckskin"@en,
        "cuir de daim"@fr,
        "hertenleer"@nl,
        "јеленска кожа"@sr,
        "Buckskin"@sv .

euf:11105 a skos:Concept ;
    skos:definition "The skin of an adult female deer, leather made from which was used in early bookbinding. For the soft, suede-like leather made from the flesh split of kidskin, sheepskin, or goatskin, use doeskin (leather). For leather made from doeskin (skin), combine doeskin (skin) + leather (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "doeskin"@en,
        "hertenhuid (vrouwtjeshert)"@nl .

euf:11107 a skos:Concept ;
    skos:definition "Material comprising the fine, small, fluffy, undergrowth feathers that lie next to the body of many adult birds. Commercial down, usually obtained from ducks and waterfowl, is lightweight and resilient. When used as a filling, down provides insulation and loft. It is used in winter coats, sleeping bags, bedding, and pillows. Trade regulation rules allow a garment to be labeled 100% down when it contains a minimum of 80% down. Today, most down is imported from China, Taiwan, Poland, and eastern Europe (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "Daunenfeder"@de,
        "down"@en,
        "plumón"@es,
        "duvet"@fr,
        "piumino"@it,
        "dons"@nl,
        "dun"@sv .

euf:11108 a skos:Concept ;
    skos:definition "Material derived from the shells of certain turtles and tortoises, sometimes utilizing the entire shell. Differs from the material tortoise shell in the way it is prepared and its finished appearance; also often derived from different species than is tortoise shell (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
    skos:prefLabel "turtle shell"@en,
        "schildpadschaal"@nl .

euf:11109 a skos:Concept ;
    skos:definition "Alloy in which gold is the principle element (AAT)."@en ;
    skos:inScheme lev:europeana-fashion ;
