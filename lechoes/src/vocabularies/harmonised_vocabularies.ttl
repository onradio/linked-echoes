    skos:inScheme lev:aat ;
    skos:prefLabel "basadi"@en .

aat:300446738 a skos:Concept ;
    skos:definition "In Indian architecture, a jāla formed by vertical and crossbars."@en ;
    skos:inScheme lev:aat ;
    skos:prefLabel "Ṛjusūtra"@en .

