{% if schema_block.schema_style == 'python' %}
The `record_item_data` tool expects the following Python-style schema:

{% if evaluation.type == 'case_by_case' %}

[START_SCHEMA]
record_items_data(
    items: List[
        record_item_data(
            base_type: str,
            specific_type: str,
            music_genres: List[str],
            music_works: List[str],
            music_albums: List[str],
            music_artists: List[str],
            events: List[str],
            countries: List[str],
            cities: List[str],
            venues: List[str],
            years: List[str],
            colours: List[str],
            cardinality: int,
            materials: List[str],
            item_title: str,
            item_description: str
        )
    ]
)
[END_SCHEMA]

{% elif evaluation.type == 'row_by_row' %}

